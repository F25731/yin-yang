{"id": null, "n": "0744012", "target": "#nkr_note_mod_0744012", "type": "mod", "text": "大【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0744013", "target": "#nkr_note_mod_0744013", "type": "mod", "text": "三藏【大】，三藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0744014", "target": "#nkr_note_mod_0744014", "type": "mod", "text": "伐【大】，筏【宋】【元】【明】【宮】"}
{"id": null, "n": "0744015", "target": "#nkr_note_mod_0744015", "type": "mod", "text": "或【大】，惑【宮】"}
{"id": null, "n": "0744016", "target": "#nkr_note_mod_0744016", "type": "mod", "text": "妄【大】，忘【宋】【元】【明】【宮】"}
{"id": null, "n": "0745001", "target": "#nkr_note_mod_0745001", "type": "mod", "text": "或【大】，或在【宋】【元】【明】【宮】"}
{"id": null, "n": "0744012", "target": "#nkr_note_orig_0744012", "type": "orig", "text": "〔大〕－【三】【宮】"}
{"id": null, "n": "0744013", "target": "#nkr_note_orig_0744013", "type": "orig", "text": "三藏＋（法師）【三】【宮】"}
{"id": null, "n": "0744014", "target": "#nkr_note_orig_0744014", "type": "orig", "text": "伐＝筏【三】【宮】"}
{"id": null, "n": "0744015", "target": "#nkr_note_orig_0744015", "type": "orig", "text": "或＝惑【宮】"}
{"id": null, "n": "0744016", "target": "#nkr_note_orig_0744016", "type": "orig", "text": "妄＝忘【三】【宮】"}
{"id": null, "n": "0745001", "target": "#nkr_note_orig_0745001", "type": "orig", "text": "或＋（在）【三】【宮】"}
