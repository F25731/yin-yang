{"id": null, "n": null, "target": null, "type": "cf1", "text": "K20n0863_p1227a08"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T54n2128_p0690a07"}
{"id": null, "n": "0795011", "target": "#nkr_note_mod_0795011", "type": "mod", "text": "人名【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0795012", "target": "#nkr_note_mod_0795012", "type": "mod", "text": "昔【大】，昔者【宋】【元】【明】【宮】"}
{"id": null, "n": "0795013", "target": "#nkr_note_mod_0795013", "type": "mod", "text": "（憐愍…之）六字【大】，愍之【宮】"}
{"id": null, "n": "0795014", "target": "#nkr_note_mod_0795014", "type": "mod", "text": "王【大】，小王【宋】【元】【明】【宮】"}
{"id": null, "n": "0795015a", "target": "#nkr_note_mod_0795015a", "type": "mod", "text": "（四王…事）十一字【大】，諸小王曰各說所樂悅樂之情一王答言【宋】【元】【明】【宮】"}
{"id": null, "n": "0795015b", "target": "#nkr_note_mod_0795015b", "type": "mod", "text": "一王言【大】，一王答言【宋】【元】【明】【宮】"}
{"id": null, "n": "0795016", "target": "#nkr_note_mod_0795016", "type": "mod", "text": "所樂【大】，之樂【宋】【元】【明】【宮】"}
{"id": null, "n": "0795017", "target": "#nkr_note_mod_0795017", "type": "mod", "text": "我願欲得【大】，我所樂異願我【宋】【元】【明】【宮】"}
{"id": null, "n": "0795018", "target": "#nkr_note_mod_0795018", "type": "mod", "text": "椎【大】＊，搥【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0795019", "target": "#nkr_note_mod_0795019", "type": "mod", "text": "復異願【大】，異願復【宋】【元】【明】【宮】"}
{"id": null, "n": "0795020", "target": "#nkr_note_mod_0795020", "type": "mod", "text": "快意【大】，快樂【宮】"}
{"id": null, "n": "0796001", "target": "#nkr_note_mod_0796001", "type": "mod", "text": "清衣【大】＊，青衣【宋】＊【元】＊【明】＊【宮】"}
{"id": null, "n": "0796002", "target": "#nkr_note_mod_0796002", "type": "mod", "text": "是我之樂【大】，〔－〕【宮】"}
{"id": null, "n": "0796003", "target": "#nkr_note_mod_0796003", "type": "mod", "text": "王【大】，〔－〕【宮】"}
{"id": null, "n": "0796004", "target": "#nkr_note_mod_0796004", "type": "mod", "text": "所樂【大】，不樂【宮】"}
{"id": null, "n": "0796005", "target": "#nkr_note_mod_0796005", "type": "mod", "text": "凋【大】，彫【宋】【元】【明】【宮】"}
{"id": null, "n": "0796006", "target": "#nkr_note_mod_0796006", "type": "mod", "text": "言【大】＊，復言【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0796007", "target": "#nkr_note_mod_0796007", "type": "mod", "text": "鍾【大】，種【元】"}
{"id": null, "n": "0796008", "target": "#nkr_note_mod_0796008", "type": "mod", "text": "闐闐【大】，軫軫【宋】【元】，賑賑【明】【宮】"}
{"id": null, "n": "0796009", "target": "#nkr_note_mod_0796009", "type": "mod", "text": "非是【大】，此非【宋】【元】【明】【宮】"}
{"id": null, "n": "0796010", "target": "#nkr_note_mod_0796010", "type": "mod", "text": "所執【大】，所攝【宮】"}
{"id": null, "n": "0796011", "target": "#nkr_note_mod_0796011", "type": "mod", "text": "何事【大】，云何【宋】【元】【明】【宮】"}
{"id": null, "n": "0796012", "target": "#nkr_note_mod_0796012", "type": "mod", "text": "惱【大】，樂【元】【明】"}
{"id": null, "n": "0796013", "target": "#nkr_note_mod_0796013", "type": "mod", "text": "號【大】，號曰【宋】【元】【明】【宮】"}
{"id": null, "n": "0796014", "target": "#nkr_note_mod_0796014", "type": "mod", "text": "祇桓【大】，祇洹【宋】【元】【明】【宮】"}
{"id": null, "n": "0796015", "target": "#nkr_note_mod_0796015", "type": "mod", "text": "皆【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0796016", "target": "#nkr_note_mod_0796016", "type": "mod", "text": "叉手【大】，合掌【宋】【元】【明】【宮】"}
{"id": null, "n": "0796017", "target": "#nkr_note_mod_0796017", "type": "mod", "text": "鈍闇【大】，闇鈍【宋】【元】【明】【宮】"}
{"id": null, "n": "0796018", "target": "#nkr_note_mod_0796018", "type": "mod", "text": "智【大】，知【宋】【元】【明】【宮】"}
{"id": null, "n": "0796019", "target": "#nkr_note_mod_0796019", "type": "mod", "text": "未得【大】，未知【宮】"}
{"id": null, "n": "0796020", "target": "#nkr_note_mod_0796020", "type": "mod", "text": "日【大】，日中【宋】【元】【明】【宮】"}
{"id": null, "n": "0796021", "target": "#nkr_note_mod_0796021", "type": "mod", "text": "皰【大】，胞【宋】【元】【明】【宮】"}
{"id": null, "n": "0796022", "target": "#nkr_note_mod_0796022", "type": "mod", "text": "迮【大】，逼【宋】【元】【明】【宮】"}
{"id": null, "n": "0796023", "target": "#nkr_note_mod_0796023", "type": "mod", "text": "之時【大】，〔－〕【宮】"}
{"id": null, "n": "0796024", "target": "#nkr_note_mod_0796024", "type": "mod", "text": "向【大】，下向【宋】【元】【明】【宮】"}
{"id": null, "n": "0796025", "target": "#nkr_note_mod_0796025", "type": "mod", "text": "劇【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0796026", "target": "#nkr_note_mod_0796026", "type": "mod", "text": "挾【大】，夾【宋】【元】【明】【宮】"}
{"id": null, "n": "0796027", "target": "#nkr_note_mod_0796027", "type": "mod", "text": "呼【大】，喚【宋】【元】【明】【宮】"}
{"id": null, "n": "0796028", "target": "#nkr_note_mod_0796028", "type": "mod", "text": "此【大】，實【宋】【元】【明】【宮】"}
{"id": null, "n": "0796029", "target": "#nkr_note_mod_0796029", "type": "mod", "text": "𥆨𥆨【大】，茫茫【宋】【元】【明】"}
{"id": null, "n": "0796030", "target": "#nkr_note_mod_0796030", "type": "mod", "text": "痠【大】，痛【宋】【元】【明】【宮】"}
{"id": null, "n": "0796031", "target": "#nkr_note_mod_0796031", "type": "mod", "text": "俱【大】，共【宋】【元】【明】【宮】"}
{"id": null, "n": "0796032", "target": "#nkr_note_mod_0796032", "type": "mod", "text": "沈重【大】，皆痛【宋】【元】【明】【宮】"}
{"id": null, "n": "0796033", "target": "#nkr_note_mod_0796033", "type": "mod", "text": "膖【大】，肨【宋】【元】，胮【明】，皆胖【宮】"}
{"id": null, "n": "0796034", "target": "#nkr_note_mod_0796034", "type": "mod", "text": "坼【大】，拆【宋】【元】【明】【宮】"}
{"id": null, "n": "0796035", "target": "#nkr_note_mod_0796035", "type": "mod", "text": "聲【大】，音【宋】【元】【明】【宮】"}
{"id": null, "n": "0796036", "target": "#nkr_note_mod_0796036", "type": "mod", "text": "看視初不【大】，看侍初無【宋】【元】【明】【宮】"}
{"id": null, "n": "0796037", "target": "#nkr_note_mod_0796037", "type": "mod", "text": "答言【大】，王答曰【宋】【元】【明】【宮】"}
{"id": null, "n": "0796038", "target": "#nkr_note_mod_0796038", "type": "mod", "text": "魂魄【大】，魂神【宋】【元】【明】【宮】"}
{"id": null, "n": "0796039", "target": "#nkr_note_mod_0796039", "type": "mod", "text": "泣【大】，哭【宋】【元】【明】【宮】"}
{"id": null, "n": "0796040", "target": "#nkr_note_mod_0796040", "type": "mod", "text": "侹【大】，𫸔【宋】【宮】，挺【元】【明】"}
{"id": null, "n": "0796041", "target": "#nkr_note_mod_0796041", "type": "mod", "text": "道【大】，近【宋】【元】【明】【宮】"}
{"id": null, "n": "0796042", "target": "#nkr_note_mod_0796042", "type": "mod", "text": "財錢散用【大】，財物散盡【宋】【元】【明】，財物散用【宮】"}
{"id": null, "n": "0796043", "target": "#nkr_note_mod_0796043", "type": "mod", "text": "共諍【大】，爭【宋】【元】【明】【宮】"}
{"id": null, "n": "0796044", "target": "#nkr_note_mod_0796044", "type": "mod", "text": "大怨【大】，大然【宋】"}
{"id": null, "n": "0796045", "target": "#nkr_note_mod_0796045", "type": "mod", "text": "各【大】，〔－〕【宮】"}
{"id": null, "n": "0796046", "target": "#nkr_note_mod_0796046", "type": "mod", "text": "地【大】，處【宋】【元】【明】【宮】"}
{"id": null, "n": "0796047", "target": "#nkr_note_mod_0796047", "type": "mod", "text": "畏【大】，忽【宋】【元】【明】【宮】"}
{"id": null, "n": "0796048", "target": "#nkr_note_mod_0796048", "type": "mod", "text": "迮【大】，狹【宋】【元】【明】【宮】"}
{"id": null, "n": "0796049", "target": "#nkr_note_mod_0796049", "type": "mod", "text": "各自【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0796050", "target": "#nkr_note_mod_0796050", "type": "mod", "text": "㴻【大】，注【宋】【元】【明】，註【宮】"}
{"id": null, "n": "0797001", "target": "#nkr_note_mod_0797001", "type": "mod", "text": "其【大】，斯【宋】【元】【明】【宮】"}
{"id": null, "n": "0797002", "target": "#nkr_note_mod_0797002", "type": "mod", "text": "以【大】，已【宋】【元】【明】【宮】"}
{"id": null, "n": "0797003", "target": "#nkr_note_mod_0797003", "type": "mod", "text": "歲【大】，年【宋】【元】【明】【宮】"}
{"id": null, "n": "0797004", "target": "#nkr_note_mod_0797004", "type": "mod", "text": "十五年【大】，五十年【宮】"}
{"id": null, "n": "0797005", "target": "#nkr_note_mod_0797005", "type": "mod", "text": "中【大】，過【宋】【元】【明】"}
{"id": null, "n": "0797006", "target": "#nkr_note_mod_0797006", "type": "mod", "text": "過【大】，中【宋】【元】【明】"}
{"id": null, "n": "0797007", "target": "#nkr_note_mod_0797007", "type": "mod", "text": "八十【大】，十五年中七十【宮】"}
{"id": null, "n": "0797008", "target": "#nkr_note_mod_0797008", "type": "mod", "text": "鈍【大】，耄【宋】【元】【明】【宮】"}
{"id": null, "n": "0797009", "target": "#nkr_note_mod_0797009", "type": "mod", "text": "智【大】，知【宋】【元】【明】【宮】"}
{"id": null, "n": "0797010", "target": "#nkr_note_mod_0797010", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0797011", "target": "#nkr_note_mod_0797011", "type": "mod", "text": "多諸憂愁【大】，多有諸愁憂【宋】【元】【明】【宮】"}
{"id": null, "n": "0797012", "target": "#nkr_note_mod_0797012", "type": "mod", "text": "不熟【大】，大熱【宋】【元】【明】【宮】"}
{"id": null, "n": "0797013", "target": "#nkr_note_mod_0797013", "type": "mod", "text": "牢獄【大】，在獄【宋】【元】【明】【宮】"}
{"id": null, "n": "0797014", "target": "#nkr_note_mod_0797014", "type": "mod", "text": "悲【大】，愁【宋】【元】【明】【宮】"}
{"id": null, "n": "0797015", "target": "#nkr_note_mod_0797015", "type": "mod", "text": "歡樂【大】，歡喜【宋】【元】【明】【宮】"}
{"id": null, "n": "0797016", "target": "#nkr_note_mod_0797016", "type": "mod", "text": "說【大】，佛說【宋】【元】【明】【宮】"}
{"id": null, "n": "0797017", "target": "#nkr_note_mod_0797017", "type": "mod", "text": "愛【大】，樂【宋】【元】【明】【宮】"}
{"id": null, "n": "0797018", "target": "#nkr_note_mod_0797018", "type": "mod", "text": "不【大】，無【宋】【元】【明】【宮】"}
{"id": null, "n": "0795011", "target": "#nkr_note_orig_0795011", "type": "orig", "text": "〔人名〕－【宋】【元】【宮】"}
{"id": null, "n": "0795012", "target": "#nkr_note_orig_0795012", "type": "orig", "text": "昔＋（者）【三】【宮】"}
{"id": null, "n": "0795013", "target": "#nkr_note_orig_0795013", "type": "orig", "text": "（憐愍…之）六字＝愍之【宮】"}
{"id": null, "n": "0795014", "target": "#nkr_note_orig_0795014", "type": "orig", "text": "王＝小王【三】【宮】"}
{"id": null, "n": "0795015", "target": "#nkr_note_orig_0795015", "type": "orig", "text": "（四王…言）十四字＝諸小王曰各說所樂悅樂之情一王答言【三】【宮】"}
{"id": null, "n": "0795016", "target": "#nkr_note_orig_0795016", "type": "orig", "text": "所樂＝之樂【三】【宮】"}
{"id": null, "n": "0795017", "target": "#nkr_note_orig_0795017", "type": "orig", "text": "我願欲得＝我所樂異願我【三】【宮】"}
{"id": null, "n": "0795018", "target": "#nkr_note_orig_0795018", "type": "orig", "text": "椎＝搥【三】【宮】＊"}
{"id": null, "n": "0795019", "target": "#nkr_note_orig_0795019", "type": "orig", "text": "復異願＝異願復【三】【宮】"}
{"id": null, "n": "0795020", "target": "#nkr_note_orig_0795020", "type": "orig", "text": "快意＝快樂【宮】"}
{"id": null, "n": "0796001", "target": "#nkr_note_orig_0796001", "type": "orig", "text": "清衣＝青衣【三】＊【宮】"}
{"id": null, "n": "0796002", "target": "#nkr_note_orig_0796002", "type": "orig", "text": "〔是我之樂〕－【宮】"}
{"id": null, "n": "0796003", "target": "#nkr_note_orig_0796003", "type": "orig", "text": "〔王〕－【宮】"}
{"id": null, "n": "0796004", "target": "#nkr_note_orig_0796004", "type": "orig", "text": "所樂＝不樂【宮】"}
{"id": null, "n": "0796005", "target": "#nkr_note_orig_0796005", "type": "orig", "text": "凋＝彫【三】【宮】"}
{"id": null, "n": "0796006", "target": "#nkr_note_orig_0796006", "type": "orig", "text": "（復）＋言【三】【宮】＊"}
{"id": null, "n": "0796007", "target": "#nkr_note_orig_0796007", "type": "orig", "text": "鍾＝種【元】"}
{"id": null, "n": "0796008", "target": "#nkr_note_orig_0796008", "type": "orig", "text": "闐闐＝軫軫【宋】【元】，賑賑【明】【宮】"}
{"id": null, "n": "0796009", "target": "#nkr_note_orig_0796009", "type": "orig", "text": "非是＝此非【三】【宮】"}
{"id": null, "n": "0796010", "target": "#nkr_note_orig_0796010", "type": "orig", "text": "所執＝所攝【宮】"}
{"id": null, "n": "0796011", "target": "#nkr_note_orig_0796011", "type": "orig", "text": "何事＝云何【三】【宮】"}
{"id": null, "n": "0796012", "target": "#nkr_note_orig_0796012", "type": "orig", "text": "惱＝樂【元】【明】"}
{"id": null, "n": "0796013", "target": "#nkr_note_orig_0796013", "type": "orig", "text": "號＋（曰）【三】【宮】"}
{"id": null, "n": "0796014", "target": "#nkr_note_orig_0796014", "type": "orig", "text": "祇桓＝祇洹【三】【宮】"}
{"id": null, "n": "0796015", "target": "#nkr_note_orig_0796015", "type": "orig", "text": "〔皆〕－【三】【宮】"}
{"id": null, "n": "0796016", "target": "#nkr_note_orig_0796016", "type": "orig", "text": "叉手＝合掌【三】【宮】"}
{"id": null, "n": "0796017", "target": "#nkr_note_orig_0796017", "type": "orig", "text": "鈍闇＝闇鈍【三】【宮】"}
{"id": null, "n": "0796018", "target": "#nkr_note_orig_0796018", "type": "orig", "text": "智＝知【三】【宮】"}
{"id": null, "n": "0796019", "target": "#nkr_note_orig_0796019", "type": "orig", "text": "未得＝未知【宮】"}
{"id": null, "n": "0796020", "target": "#nkr_note_orig_0796020", "type": "orig", "text": "日＋（中）【三】【宮】"}
{"id": null, "n": "0796021", "target": "#nkr_note_orig_0796021", "type": "orig", "text": "皰＝胞【三】【宮】"}
{"id": null, "n": "0796022", "target": "#nkr_note_orig_0796022", "type": "orig", "text": "迮＝逼【三】【宮】"}
{"id": null, "n": "0796023", "target": "#nkr_note_orig_0796023", "type": "orig", "text": "〔之時〕－【宮】"}
{"id": null, "n": "0796024", "target": "#nkr_note_orig_0796024", "type": "orig", "text": "（下）＋向【三】【宮】"}
{"id": null, "n": "0796025", "target": "#nkr_note_orig_0796025", "type": "orig", "text": "〔劇〕－【三】【宮】"}
{"id": null, "n": "0796026", "target": "#nkr_note_orig_0796026", "type": "orig", "text": "挾＝夾【三】【宮】"}
{"id": null, "n": "0796027", "target": "#nkr_note_orig_0796027", "type": "orig", "text": "呼＝喚【三】【宮】"}
