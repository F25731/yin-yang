{"id": null, "n": null, "target": null, "type": null, "text": "出西山讀書記。并溩道集。\n性學辯"}
{"id": null, "n": null, "target": null, "type": null, "text": "出元城語錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "出列子等"}
{"id": null, "n": null, "target": null, "type": null, "text": "出列子󷘰"}
{"id": null, "n": null, "target": null, "type": null, "text": "出孔子家語"}
{"id": null, "n": null, "target": null, "type": null, "text": "出礼記家語荘列史記󵓕"}
{"id": null, "n": null, "target": null, "type": null, "text": "出󷢷本韓文。有註云。大宋重刊韓文。\n欲去此二通書。謀决扵歐陽文忠公。公曰不可去。故存之。○晦菴校韓文亦存之不去。已後重畨晦菴所校之\n板。則去之不存󷭘。󷯌古畧亦收之"}
{"id": null, "n": null, "target": null, "type": null, "text": "出韓文󷢷板今板皆有之"}
{"id": null, "n": null, "target": null, "type": null, "text": "出韓文󷢷板今板皆有之"}
{"id": null, "n": null, "target": null, "type": null, "text": "出栁文"}
{"id": null, "n": null, "target": null, "type": null, "text": "出大宋三教奏議。并資鑑"}
{"id": null, "n": null, "target": null, "type": null, "text": "出瑩中錄并性學󷚅要"}
{"id": null, "n": null, "target": null, "type": null, "text": "出佛祖通載"}
{"id": null, "n": null, "target": null, "type": null, "text": "出󷢷唐史"}
{"id": null, "n": null, "target": null, "type": null, "text": "出劉三吾細鑑惟通鑑畧之"}
{"id": null, "n": null, "target": null, "type": null, "text": "此𠁅起首\n至扵"}
{"id": null, "n": null, "target": null, "type": null, "text": "出附章氏家譜"}
{"id": null, "n": null, "target": null, "type": null, "text": "出資鍳并佛印語録後䟦"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "出弘益紀聞"}
{"id": null, "n": null, "target": null, "type": null, "text": "劉時中所得東林親筆論易之語又尹氏家塾及󷭖季明筆記詳備并有程子深愛元包\n四徳之語"}
{"id": null, "n": null, "target": null, "type": null, "text": "出性斈󷚅\n要并正易心法"}
{"id": null, "n": null, "target": null, "type": null, "text": "無即所依之空"}
{"id": null, "n": null, "target": null, "type": null, "text": "有即二氣交運"}
{"id": null, "n": null, "target": null, "type": null, "text": "真即一真至理"}
{"id": null, "n": null, "target": null, "type": null, "text": "假即󷭛物化生"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "出松窓雜記"}
{"id": null, "n": null, "target": null, "type": null, "text": "出尹氏家塾并性學󷚅要"}
{"id": null, "n": null, "target": null, "type": null, "text": "出性\n理羣書并靈山寺留衣亭真跡"}
{"id": null, "n": null, "target": null, "type": null, "text": "出鄭谷集"}
{"id": null, "n": null, "target": null, "type": null, "text": "濂溪行状"}
{"id": null, "n": null, "target": null, "type": null, "text": "弘益紀聞"}
{"id": null, "n": null, "target": null, "type": null, "text": "弘益紀聞"}
{"id": null, "n": null, "target": null, "type": null, "text": "瑩中\n録并性斈󷚅要"}
{"id": null, "n": null, "target": null, "type": null, "text": "出後村集"}
{"id": null, "n": null, "target": null, "type": null, "text": "出史畧󵓕"}
{"id": null, "n": null, "target": null, "type": null, "text": "趙󵘸之心學淵源後䟦"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲盖寺碑刻墨蹟"}
{"id": null, "n": null, "target": null, "type": null, "text": "弘益紀聞"}
{"id": null, "n": null, "target": null, "type": null, "text": "出靈源語録。○先󷃪即晦堂心禅󷃪也晦堂𡮢以心法授伊川"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡氏大同論"}
{"id": null, "n": null, "target": null, "type": null, "text": "歐陽記録"}
{"id": null, "n": null, "target": null, "type": null, "text": "伊川所作明道行状"}
{"id": null, "n": null, "target": null, "type": null, "text": "此二句出\n唐清涼國󷃪華嚴𦀇󶳼"}
{"id": null, "n": null, "target": null, "type": null, "text": "此二句出\n華嚴𦀇法界𮗚"}
{"id": null, "n": null, "target": null, "type": null, "text": "此句出唐譯大智度論并禅書"}
{"id": null, "n": null, "target": null, "type": null, "text": "出華嚴󷮝積大集󵓕𦀇"}
{"id": null, "n": null, "target": null, "type": null, "text": "出鐔津集"}
{"id": null, "n": null, "target": null, "type": null, "text": "全是禅語畧畨変之"}
{"id": null, "n": null, "target": null, "type": null, "text": "𣅜是東林口授周子語意"}
{"id": null, "n": null, "target": null, "type": null, "text": "楞嚴𦀇󵓕"}
{"id": null, "n": null, "target": null, "type": null, "text": "𣅜出禅書并諸𦀇"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云出周易附録纂註"}
{"id": null, "n": null, "target": null, "type": null, "text": "出大恵年譜後"}
{"id": null, "n": null, "target": null, "type": null, "text": "出尤焴所作大恵語録序并拱辰集󵓕書"}
{"id": null, "n": null, "target": null, "type": null, "text": "出資鍳拱\n𫝕集性理羣書"}
{"id": null, "n": null, "target": null, "type": null, "text": "出未子大全集并道餘錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "字蹟見󷰅\n本寒山詩後"}
{"id": null, "n": null, "target": null, "type": null, "text": "出事文類聚"}
{"id": null, "n": null, "target": null, "type": null, "text": "出史畧󵓕"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "朱子語錄\n并易觧歐陽玄雜記性理羣書"}
{"id": null, "n": null, "target": null, "type": null, "text": "言語煩者不𭣣鳴道集道餘錄剖過者亦不𭣣惟竹軒誦\n佛𦀇之詩蕳逕亦𭣣扵此"}
{"id": null, "n": null, "target": null, "type": null, "text": "出列子註"}
{"id": null, "n": null, "target": null, "type": null, "text": "詩󷘰序"}
{"id": null, "n": null, "target": null, "type": null, "text": "隂符𦀇註"}
{"id": null, "n": null, "target": null, "type": null, "text": "出詠史詩"}
{"id": null, "n": null, "target": null, "type": null, "text": "出󷮆子"}
{"id": null, "n": null, "target": null, "type": null, "text": "出史記"}
{"id": null, "n": null, "target": null, "type": null, "text": "出法數畧要"}
{"id": null, "n": null, "target": null, "type": null, "text": "出󷢷吴書并宗炳明佛論編年通載󵓕書"}
{"id": null, "n": null, "target": null, "type": null, "text": "出漢書西域󷘰"}
{"id": null, "n": null, "target": null, "type": null, "text": "出魏書佛老志"}
{"id": null, "n": null, "target": null, "type": null, "text": "出丈畧󵓕"}
