{"id": null, "n": "0359085", "target": null, "type": "orig", "text": "〔淨〕－【元】【明】【乙】"}
{"id": null, "n": "0359085", "target": null, "type": "mod", "text": "淨【大】，〔－〕【元】【明】【乙】"}
{"id": null, "n": "0357006", "target": "#nkr_note_mod_0357006", "type": "mod", "text": "最【大】，佛說最【宋】，【原】麗本，【甲】仁和寺藏古寫本，【乙】黃檗版淨嚴等加筆本"}
{"id": null, "n": "0357007", "target": "#nkr_note_mod_0357007", "type": "mod", "text": "呪【大】，〔－〕【宋】【元】【明】【乙】"}
{"id": null, "n": "0357008", "target": "#nkr_note_mod_0357008", "type": "mod", "text": "大唐【大】，唐中【宋】【乙】，唐天后代中【元】"}
{"id": null, "n": "0357009", "target": "#nkr_note_mod_0357009", "type": "mod", "text": "三【大】，沙門三【宋】"}
{"id": null, "n": "0357010", "target": "#nkr_note_mod_0357010", "type": "mod", "text": "羅【大】，羅重【元】【明】【乙】"}
{"id": null, "n": "0357011", "target": "#nkr_note_mod_0357011", "type": "mod", "text": "筍【大】，笋【宋】"}
{"id": null, "n": "0357012", "target": "#nkr_note_mod_0357012", "type": "mod", "text": "誓【大】，逝【宋】【元】【明】【乙】"}
{"id": null, "n": "0357013", "target": "#nkr_note_mod_0357013", "type": "mod", "text": "闥【大】，達【甲】"}
{"id": null, "n": "0357014", "target": "#nkr_note_mod_0357014", "type": "mod", "text": "縛【大】，婆【宋】【元】【明】【乙】"}
{"id": null, "n": "0357015", "target": "#nkr_note_mod_0357015", "type": "mod", "text": "諸【大】，訶【甲】"}
{"id": null, "n": "0357016", "target": "#nkr_note_mod_0357016", "type": "mod", "text": "乏【大】，足【甲】"}
{"id": null, "n": "0357017", "target": "#nkr_note_mod_0357017", "type": "mod", "text": "供【大】，〔－〕【甲】"}
{"id": null, "n": "0357018", "target": "#nkr_note_mod_0357018", "type": "mod", "text": "所【大】＊，〔－〕【甲】＊"}
{"id": null, "n": "0357019", "target": "#nkr_note_mod_0357019", "type": "mod", "text": "受【大】，〔－〕【甲】"}
{"id": null, "n": "0358001", "target": "#nkr_note_mod_0358001", "type": "mod", "text": "惱【大】，總【甲】"}
{"id": null, "n": "0358002", "target": "#nkr_note_mod_0358002", "type": "mod", "text": "七【大】，七遍【考偽-乙】"}
{"id": null, "n": "0358003", "target": "#nkr_note_mod_0358003", "type": "mod", "text": "苦【大】＊，若【甲】＊"}
{"id": null, "n": "0358004", "target": "#nkr_note_mod_0358004", "type": "mod", "text": "何【大】，阿【甲】"}
{"id": null, "n": "0358005", "target": "#nkr_note_mod_0358005", "type": "mod", "text": "問【大】，聞【甲】"}
{"id": null, "n": "0358006", "target": "#nkr_note_mod_0358006", "type": "mod", "text": "香【大】，塗香【考偽-乙】"}
{"id": null, "n": "0358007", "target": "#nkr_note_mod_0358007", "type": "mod", "text": "是【大】，諸【宋】【元】【明】【乙】"}
{"id": null, "n": "0358008", "target": "#nkr_note_mod_0358008", "type": "mod", "text": "已【大】，足【宋】【元】【明】【乙】"}
{"id": null, "n": "0358009", "target": "#nkr_note_mod_0358009", "type": "mod", "text": "法【大】，法法【甲】"}
{"id": null, "n": "0358010", "target": "#nkr_note_mod_0358010", "type": "mod", "text": "佛【大】，佛言【甲】"}
{"id": null, "n": "0358011", "target": "#nkr_note_mod_0358011", "type": "mod", "text": "等【大】，若【甲】"}
{"id": null, "n": "0358012", "target": "#nkr_note_mod_0358012", "type": "mod", "text": "彼【大】，被【宋】"}
{"id": null, "n": "0358013", "target": "#nkr_note_mod_0358013", "type": "mod", "text": "內【大】，中【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0358014", "target": "#nkr_note_mod_0358014", "type": "mod", "text": "黑【大】，〔－〕【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0358015", "target": "#nkr_note_mod_0358015", "type": "mod", "text": "（我母…生）八字【大】，〔－〕【甲】"}
{"id": null, "n": "0358016", "target": "#nkr_note_mod_0358016", "type": "mod", "text": "其【大】，祈【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0358017", "target": "#nkr_note_mod_0358017", "type": "mod", "text": "事【大】，寺【甲】"}
{"id": null, "n": "0358018", "target": "#nkr_note_mod_0358018", "type": "mod", "text": "酥【大】＊，蘇【宋】【甲】＊"}
{"id": null, "n": "0358019", "target": "#nkr_note_mod_0358019", "type": "mod", "text": "尿【大】，噉尿【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0358020", "target": "#nkr_note_mod_0358020", "type": "mod", "text": "常【大】，常受【考偽-乙】"}
{"id": null, "n": "0358021", "target": "#nkr_note_mod_0358021", "type": "mod", "text": "今【大】，令【元】"}
{"id": null, "n": "0358022", "target": "#nkr_note_mod_0358022", "type": "mod", "text": "於【大】，〔－〕【甲】"}
{"id": null, "n": "0358023", "target": "#nkr_note_mod_0358023", "type": "mod", "text": "命【大】，令【宋】【元】【明】"}
{"id": null, "n": "0358024", "target": "#nkr_note_mod_0358024", "type": "mod", "text": "物【大】，總【甲】"}
{"id": null, "n": "0358025", "target": "#nkr_note_mod_0358025", "type": "mod", "text": "汝【大】，〔－〕【甲】"}
{"id": null, "n": "0359001", "target": "#nkr_note_mod_0359001", "type": "mod", "text": "有【大】，在【考偽-乙】"}
{"id": null, "n": "0359002", "target": "#nkr_note_mod_0359002", "type": "mod", "text": "其【大】，〔－〕【明】【甲】【乙】"}
{"id": null, "n": "0359003", "target": "#nkr_note_mod_0359003", "type": "mod", "text": "才【大】，財【甲】"}
{"id": null, "n": "0359004", "target": "#nkr_note_mod_0359004", "type": "mod", "text": "萬【大】，〔－〕【甲】"}
{"id": null, "n": "0359005", "target": "#nkr_note_mod_0359005", "type": "mod", "text": "呪【大】，〔－〕【元】【明】【甲】【乙】"}
{"id": null, "n": "0359006", "target": "#nkr_note_mod_0359006", "type": "mod", "text": "佛【大】，佛所說我今說之此陀羅尼者於諸佛【甲】"}
{"id": null, "n": "0359007", "target": "#nkr_note_mod_0359007", "type": "mod", "text": "國【大】，國生一佛國【甲】"}
{"id": null, "n": "0359008", "target": "#nkr_note_mod_0359008", "type": "mod", "text": "惟【大】，唯【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0359009", "target": "#nkr_note_mod_0359009", "type": "mod", "text": "帝【大】，帝釋【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0359010", "target": "#nkr_note_mod_0359010", "type": "mod", "text": "伐【大】，跋【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0359011", "target": "#nkr_note_mod_0359011", "type": "mod", "text": "曬【大】，隸【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0359012", "target": "#nkr_note_mod_0359012", "type": "mod", "text": "稽耶反【大】，〔－〕【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0359013", "target": "#nkr_note_mod_0359013", "type": "mod", "text": "咤【大】＊，吒【宋】【元】【明】【乙】＊"}
{"id": null, "n": "0359014", "target": "#nkr_note_mod_0359014", "type": "mod", "text": "長聲【大】，引折佉反下同【宋】【元】【甲】，拆去切引下同【明】，拆佉切引下同【乙】"}
{"id": null, "n": "0359015", "target": "#nkr_note_mod_0359015", "type": "mod", "text": "長聲【大】＊，引【宋】【元】【明】【甲】【乙】＊"}
{"id": null, "n": "0359016", "target": "#nkr_note_mod_0359016", "type": "mod", "text": "耶【大】，耶三【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": "0359017", "target": "#nkr_note_mod_0359017", "type": "mod", "text": "伐底三【大】，跋帝四【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0359018", "target": "#nkr_note_mod_0359018", "type": "mod", "text": "四【大】，五【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0359019", "target": "#nkr_note_mod_0359019", "type": "mod", "text": "五【大】，六【宋】【元】【明】【？】【乙】"}
{"id": null, "n": "0359020", "target": "#nkr_note_mod_0359020", "type": "mod", "text": "耶【大】，耶七【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "七"}
{"id": null, "n": "0359021", "target": "#nkr_note_mod_0359021", "type": "mod", "text": "摩【大】，摩那【宋】【元】【明】【乙】，摩耶【甲】"}
{"id": null, "n": "0359022", "target": "#nkr_note_mod_0359022", "type": "mod", "text": "嚩【大】，皤【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0359023", "target": "#nkr_note_mod_0359023", "type": "mod", "text": "縛可反【大】，〔－〕【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0359024", "target": "#nkr_note_mod_0359024", "type": "mod", "text": "長【大】，〔－〕【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0359025", "target": "#nkr_note_mod_0359025", "type": "mod", "text": "上六【大】，八【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "上"}
{"id": null, "n": null, "target": null, "type": null, "text": "六"}
{"id": null, "n": "0359026", "target": "#nkr_note_mod_0359026", "type": "mod", "text": "縛輸第七【大】，皤輸地九【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0359027", "target": "#nkr_note_mod_0359027", "type": "mod", "text": "去長聲【大】，〔－〕【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0359028", "target": "#nkr_note_mod_0359028", "type": "mod", "text": "折【大】，折時說反【宋】【元】，折時說切【明】【乙】，折時說反下同【甲】，折＋（時說反）夾註【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "時說反"}
{"id": null, "n": "0359029", "target": "#nkr_note_mod_0359029", "type": "mod", "text": "八【大】，〔－〕【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0359030", "target": "#nkr_note_mod_0359030", "type": "mod", "text": "𪢗【大】，蜜【宋】【元】【明】【甲】【乙】"}
