{"id": null, "n": null, "target": null, "type": null, "text": "菱印也"}
{"id": null, "n": null, "target": null, "type": null, "text": "向鬼門雷電被打印也"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云，如經說。任理頌羅剎呪也"}
{"id": null, "n": null, "target": null, "type": null, "text": "他本蓮華也"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上呪"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "四"}
{"id": null, "n": "0377003", "target": "#nkr_note_mod_0377003", "type": "mod", "text": "無【大】，無好【校異-原】"}
{"id": null, "n": "0377004", "target": "#nkr_note_mod_0377004", "type": "mod", "text": "𥤦𥤦【大】，〔－〕【校異-原】"}
{"id": null, "n": "0377002", "target": "#nkr_note_orig_0377002", "type": "orig", "text": "【原】享保年間刊豐山大學藏本"}
{"id": null, "n": "0377003", "target": "#nkr_note_orig_0377003", "type": "orig", "text": "無＝無好ィ【原】"}
{"id": null, "n": "0377004", "target": "#nkr_note_orig_0377004", "type": "orig", "text": "〔𥤦𥤦〕ィ－【原】"}
