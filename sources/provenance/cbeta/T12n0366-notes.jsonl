{"id": null, "n": "0346031", "target": "#nkr_note_mod_0346031", "type": "mod", "text": "龜茲三藏【大】，三藏法師【宋】【元】【明】【流布本】"}
{"id": null, "n": "0346032", "target": "#nkr_note_mod_0346032", "type": "mod", "text": "什【大】，什奉詔【流布本】"}
{"id": null, "n": "0346036", "target": "#nkr_note_mod_0346036", "type": "mod", "text": "僧【大】，眾【流布本】"}
{"id": null, "n": "0346038", "target": "#nkr_note_mod_0346038", "type": "mod", "text": "乾【大】，犍【宋】【元】【明】【流布本】"}
{"id": null, "n": "0346039", "target": "#nkr_note_mod_0346039", "type": "mod", "text": "栴【大】，㫋【宋】【元】【流布本】"}
{"id": null, "n": "0346040", "target": "#nkr_note_mod_0346040", "type": "mod", "text": "拘【大】，俱【宋】【元】【明】【流布本】"}
{"id": null, "n": "0346041", "target": "#nkr_note_mod_0346041", "type": "mod", "text": "周梨槃陀迦【大】，周利槃陀伽【宋】【元】【明】【流布本】"}
{"id": null, "n": "0346042", "target": "#nkr_note_mod_0346042", "type": "mod", "text": "俱【大】，拘【宋】【元】【明】【流布本】"}
{"id": null, "n": "0346043", "target": "#nkr_note_mod_0346043", "type": "mod", "text": "1.Mannjuśri-kumārabhūta. 2.Ajita. 3.Gandbahastin. 4.Nityodyukta."}
{"id": null, "n": "0347001", "target": "#nkr_note_mod_0347001", "type": "mod", "text": "頗梨【大】＊，玻瓈【宋】＊【元】＊【明】＊，【流布本】"}
{"id": null, "n": "0347002", "target": "#nkr_note_mod_0347002", "type": "mod", "text": "車𤦲【大】，硨磲【宋】【元】【明】【流布本】"}
{"id": null, "n": "0347003", "target": "#nkr_note_mod_0347003", "type": "mod", "text": "馬瑙【大】，碼碯【宋】【元】【明】【流布本】"}
{"id": null, "n": "0347004", "target": "#nkr_note_mod_0347004", "type": "mod", "text": "天雨【大】，雨天【宋】【元】【明】，而雨【流布本】"}
{"id": null, "n": "0347006", "target": "#nkr_note_mod_0347006", "type": "mod", "text": "國【大】，土【元】【明】"}
{"id": null, "n": "0347007", "target": "#nkr_note_mod_0347007", "type": "mod", "text": "白鵠，Haṃsa。孔雀，Mayura。鸚鵡，Śuka。舍利，Śāri。迦陵頻伽，Kalaviṅka。共命之鳥，Jīvajīvaka。"}
{"id": null, "n": "0347008", "target": "#nkr_note_mod_0347008", "type": "mod", "text": "鵠【大】，鶴【宋】【元】【明】"}
{"id": null, "n": "0347009", "target": "#nkr_note_mod_0347009", "type": "mod", "text": "根，力，菩提分，聖道分。Indriya, Bala. Bodhyaṅga, Ārtamārga."}
{"id": null, "n": "0347010", "target": "#nkr_note_mod_0347010", "type": "mod", "text": "趣【大】，道【宋】【元】【明】"}
{"id": null, "n": "0347011", "target": "#nkr_note_mod_0347011", "type": "mod", "text": "皆自然【大】，自然皆【宋】【元】【明】"}
{"id": null, "n": "0347014", "target": "#nkr_note_mod_0347014", "type": "mod", "text": "薩【大】，薩眾【宋】【元】【明】【流布本】"}
{"id": null, "n": "0347017", "target": "#nkr_note_mod_0347017", "type": "mod", "text": "劫【大】，〔－〕【明】"}
{"id": null, "n": "0347022", "target": "#nkr_note_mod_0347022", "type": "mod", "text": "德【大】，德之利【宋】【元】【明】"}
{"id": null, "n": "0347023", "target": "#nkr_note_mod_0347023", "type": "mod", "text": "1.Akṣobhya. 2.Merudhvaja. 3.Mahāmeru. 4.Meruprabhāsa. 5.Mañjughoṣa."}
{"id": null, "n": "0347025", "target": "#nkr_note_mod_0347025", "type": "mod", "text": "稱讚不可思議功德。Acintya-guṇa-parikīrtana. 一切諸佛所護念。Sarvabuddha-parigraha."}
{"id": null, "n": "0347026", "target": "#nkr_note_mod_0347026", "type": "mod", "text": "1.Candrasūryapradipa. 2.Yaśḥprabha. 3.Mahārciskaṃdha. 4.Merupradipa. 5.Arantavirya."}
{"id": null, "n": "0347027", "target": "#nkr_note_mod_0347027", "type": "mod", "text": "1.Amitāyuṣ. 2.Amitaskṃdha. 3.Amitadhvaja. 4.Mahāprabha. 5.Mahāraśmiprabha. 6.Mahāratnaketu. 7.Śuddharaśmi."}
{"id": null, "n": "0347028", "target": "#nkr_note_mod_0347028", "type": "mod", "text": "1.Mahārcislaṃdha. 2.Duṃdubhisvaranirghoṣa. 3.Duṣpradharṣa. 4.Ādityasaṃbhava. 5.Jaleniprabha."}
{"id": null, "n": "0347029", "target": "#nkr_note_mod_0347029", "type": "mod", "text": "沮【大】，爼【宋】"}
{"id": null, "n": "0347030", "target": "#nkr_note_mod_0347030", "type": "mod", "text": "1.Siṃha. 2.Yaśaṣ. 3.Yaśaḥprabha. 4.Dharma. 5.Dharmadhvaja. 6.Dharmadhara."}
{"id": null, "n": "0347031", "target": "#nkr_note_mod_0347031", "type": "mod", "text": "1.Brahmaghoṣa. 2.Nakṣatrarāja. 3.Gaṃdhottama. 4.Gaṃdhaprabhāsa. 5.Mahārciskaṃdha. 6.Ratnakusumasaṃpuṣpitagātra. 7.Sālendrarāja. 8.Ratnorpalaśri. 9.Sarvārthadarśa. 10.Sumerukalpa."}
{"id": null, "n": "0348001", "target": "#nkr_note_mod_0348001", "type": "mod", "text": "經受持者及聞諸佛【大】，諸佛所說名及經【流布本】"}
{"id": null, "n": "0348002", "target": "#nkr_note_mod_0348002", "type": "mod", "text": "共【大】，之【宋】【元】【明】"}
{"id": null, "n": "0348003", "target": "#nkr_note_mod_0348003", "type": "mod", "text": "說【大】，讚【宋】【元】【明】"}
{"id": null, "n": "0348006", "target": "#nkr_note_mod_0348006", "type": "mod", "text": "5 Kaṣāya.(Kalpakaṣāya, dṛṣṭi-kaṣāya, kleśa-kaṣāya, satta-kaṣāya, āyuṣ-kaṣāya)"}
{"id": null, "n": "0346030", "target": "#nkr_note_orig_0346030", "type": "orig", "text": "Sukhāvatīvyūha.（小）"}
{"id": null, "n": "0346031", "target": "#nkr_note_orig_0346031", "type": "orig", "text": "龜茲三藏＝三藏法師【三】，流布本亦同"}
{"id": null, "n": "0346032", "target": "#nkr_note_orig_0346032", "type": "orig", "text": "流布本什下有奉詔"}
{"id": null, "n": "0346033", "target": "#nkr_note_orig_0346033", "type": "orig", "text": "Śrāvasti."}
{"id": null, "n": "0346034", "target": "#nkr_note_orig_0346034", "type": "orig", "text": "Jetavana."}
{"id": null, "n": "0346035", "target": "#nkr_note_orig_0346035", "type": "orig", "text": "Anāthapiṃḍasya ārama."}
{"id": null, "n": "0346036", "target": "#nkr_note_orig_0346036", "type": "orig", "text": "僧流布本作眾"}
{"id": null, "n": "0346037", "target": "#nkr_note_orig_0346037", "type": "orig", "text": "比丘名梵如次 1.Śāriputra. 2.Mahāmaudgalyāyana. 3.Mahākāśyapa. 4.Mahākātyāyana. 5.Mahākauṣṭhila. 6.Revata. 7.Śuddhipaṃthaka. 8.Nanda. 9.Ānanda. 10.Rāhula. 11.Gavāṃpati. 12.Bharadvāja. 13.Kālodayin. 14.Mahākaphiṇa. 15.Vakkula. 16.Aniruddha."}
{"id": null, "n": "0346038", "target": "#nkr_note_orig_0346038", "type": "orig", "text": "乾＝犍【三】，流布本亦同"}
{"id": null, "n": "0346039", "target": "#nkr_note_orig_0346039", "type": "orig", "text": "栴＝㫋【宋】【元】，流布本亦同"}
{"id": null, "n": "0346040", "target": "#nkr_note_orig_0346040", "type": "orig", "text": "拘＝俱【三】，流布本亦同"}
{"id": null, "n": "0346041", "target": "#nkr_note_orig_0346041", "type": "orig", "text": "周梨槃陀迦＝周利槃陀伽【三】，流布本亦同"}
{"id": null, "n": "0346042", "target": "#nkr_note_orig_0346042", "type": "orig", "text": "俱＝拘【三】，流布本亦同"}
{"id": null, "n": "0346043", "target": "#nkr_note_orig_0346043", "type": "orig", "text": "1.Mannjuśri-kumārabhūta. 2.Ajita. 3.Gandbahastin. 4.Nityodyukta."}
{"id": null, "n": "0346044", "target": "#nkr_note_orig_0346044", "type": "orig", "text": "Sukhāvatī."}
{"id": null, "n": "0346045", "target": "#nkr_note_orig_0346045", "type": "orig", "text": "Amitāyus."}
{"id": null, "n": "0346046", "target": "#nkr_note_orig_0346046", "type": "orig", "text": "Vedika."}
{"id": null, "n": "0346047", "target": "#nkr_note_orig_0346047", "type": "orig", "text": "Kiṃkiṇījāla."}
{"id": null, "n": "0346048", "target": "#nkr_note_orig_0346048", "type": "orig", "text": "Tālapaṃkti."}
{"id": null, "n": "0346049", "target": "#nkr_note_orig_0346049", "type": "orig", "text": "Puṣkariṇi."}
{"id": null, "n": "0347001", "target": "#nkr_note_orig_0347001", "type": "orig", "text": "頗梨＝玻瓈【三】＊，流布本亦同"}
{"id": null, "n": "0347002", "target": "#nkr_note_orig_0347002", "type": "orig", "text": "車𤦲＝硨磲【三】，流布本亦同"}
{"id": null, "n": "0347003", "target": "#nkr_note_orig_0347003", "type": "orig", "text": "馬瑙＝碼碯【三】，流布本亦同"}
{"id": null, "n": "0347004", "target": "#nkr_note_orig_0347004", "type": "orig", "text": "天雨＝雨天【三】，天流布本作而"}
{"id": null, "n": "0347005", "target": "#nkr_note_orig_0347005", "type": "orig", "text": "Māṃdarava."}
{"id": null, "n": "0347006", "target": "#nkr_note_orig_0347006", "type": "orig", "text": "國＝土【元】【明】"}
{"id": null, "n": "0347007", "target": "#nkr_note_orig_0347007", "type": "orig", "text": "白鵠. Haṃsa, 孔雀. Mayura, 鸚鵡. Śuka, 舍利. Śāri, 迦陵頻伽. Kalaviṅka, 共命之鳥. Jīvajīvaka."}
{"id": null, "n": "0347008", "target": "#nkr_note_orig_0347008", "type": "orig", "text": "鵠＝鶴【三】"}
{"id": null, "n": "0347009", "target": "#nkr_note_orig_0347009", "type": "orig", "text": "根，力，菩提分，聖道分。Indriya, Bala. Bodhyaṅga, Ārtamārga."}
{"id": null, "n": "0347010", "target": "#nkr_note_orig_0347010", "type": "orig", "text": "趣＝道【三】"}
{"id": null, "n": "0347011", "target": "#nkr_note_orig_0347011", "type": "orig", "text": "皆自然＝自然皆【三】"}
{"id": null, "n": "0347012", "target": "#nkr_note_orig_0347012", "type": "orig", "text": "Amitābha."}
{"id": null, "n": "0347013", "target": "#nkr_note_orig_0347013", "type": "orig", "text": "Amitāyuṣ."}
{"id": null, "n": "0347014", "target": "#nkr_note_orig_0347014", "type": "orig", "text": "薩＋（眾）【三】，流布本亦同"}
{"id": null, "n": "0347015", "target": "#nkr_note_orig_0347015", "type": "orig", "text": "Avaivartika."}
{"id": null, "n": "0347016", "target": "#nkr_note_orig_0347016", "type": "orig", "text": "Ekajātipratibuddha."}
{"id": null, "n": "0347017", "target": "#nkr_note_orig_0347017", "type": "orig", "text": "〔劫〕－【明】"}
{"id": null, "n": "0347018", "target": "#nkr_note_orig_0347018", "type": "orig", "text": "Nāmadheya."}
{"id": null, "n": "0347019", "target": "#nkr_note_orig_0347019", "type": "orig", "text": "Avikṣptacitta."}
{"id": null, "n": "0347020", "target": "#nkr_note_orig_0347020", "type": "orig", "text": "Aiśparyastacitta."}
{"id": null, "n": "0347021", "target": "#nkr_note_orig_0347021", "type": "orig", "text": "Cittapraṇidhāna."}
{"id": null, "n": "0347022", "target": "#nkr_note_orig_0347022", "type": "orig", "text": "德＋（之利）【三】"}
{"id": null, "n": "0347023", "target": "#nkr_note_orig_0347023", "type": "orig", "text": "1.Akṣobhya. 2.Merudhvaja. 3.Mahāmeru. 4.Meruprabhāsa. 5.Mañjughoṣa."}
{"id": null, "n": "0347024", "target": "#nkr_note_orig_0347024", "type": "orig", "text": "Nirveṭhana."}
{"id": null, "n": "0347025", "target": "#nkr_note_orig_0347025", "type": "orig", "text": "稱讚不可思議功德。Acintya-guṇa-parikīrtana. 一切諸佛所護念。Sarvabuddha-parigraha."}
{"id": null, "n": "0347026", "target": "#nkr_note_orig_0347026", "type": "orig", "text": "1.Candrasūryapradipa. 2.Yaśḥprabha. 3.Mahārciskaṃdha. 4.Merupradipa. 5.Arantavirya."}
{"id": null, "n": "0347027", "target": "#nkr_note_orig_0347027", "type": "orig", "text": "1.Amitāyuṣ. 2.Amitaskṃdha. 3.Amitadhvaja. 4.Mahāprabha. 5.Mahāraśmiprabha. 6.Mahāratnaketu. 7.Śuddharaśmi."}
{"id": null, "n": "0347028", "target": "#nkr_note_orig_0347028", "type": "orig", "text": "1.Mahārcislaṃdha. 2.Duṃdubhisvaranirghoṣa. 3.Duṣpradharṣa. 4.Ādityasaṃbhava. 5.Jaleniprabha."}
{"id": null, "n": "0347029", "target": "#nkr_note_orig_0347029", "type": "orig", "text": "沮＝爼【宋】"}
{"id": null, "n": "0347030", "target": "#nkr_note_orig_0347030", "type": "orig", "text": "1.Siṃha. 2.Yaśaṣ. 3.Yaśaḥprabha. 4.Dharma. 5.Dharmadhvaja. 6.Dharmadhara."}
{"id": null, "n": "0347031", "target": "#nkr_note_orig_0347031", "type": "orig", "text": "1.Brahmaghoṣa. 2.Nakṣatrarāja. 3.Gaṃdhottama. 4.Gaṃdhaprabhāsa. 5.Mahārciskaṃdha. 6.Ratnakusumasaṃpuṣpitagātra. 7.Sālendrarāja. 8.Ratnorpalaśri. 9.Sarvārthadarśa. 10.Sumerukalpa."}
{"id": null, "n": "0348001", "target": "#nkr_note_orig_0348001", "type": "orig", "text": "經受持者及聞諸佛流布本作諸佛所說名及經"}
{"id": null, "n": "0348002", "target": "#nkr_note_orig_0348002", "type": "orig", "text": "共＝之【三】"}
{"id": null, "n": "0348003", "target": "#nkr_note_orig_0348003", "type": "orig", "text": "說＝讚【三】"}
{"id": null, "n": "0348004", "target": "#nkr_note_orig_0348004", "type": "orig", "text": "Paramaduṣkara."}
{"id": null, "n": "0348005", "target": "#nkr_note_orig_0348005", "type": "orig", "text": "Sāhā lokadhātu."}
{"id": null, "n": "0348006", "target": "#nkr_note_orig_0348006", "type": "orig", "text": "5 Kaṣāya.(Kalpakaṣāya, dṛṣṭi-kaṣāya, kleśa-kaṣāya, satta-kaṣāya, āyuṣ-kaṣāya)"}
{"id": null, "n": "0348007", "target": "#nkr_note_orig_0348007", "type": "orig", "text": "已下依燉煌本載之"}
{"id": null, "n": "0348b0401", "target": "#nkr_note_add_0348b0401", "type": "add", "text": "一般流通的往生咒在「悉耽婆毘」及「阿彌唎哆」之間有「阿彌利哆毘迦蘭諦」二句。"}
{"id": null, "n": "0348b0601", "target": "#nkr_note_add_0348b0601", "type": "add", "text": "關於此咒語的分句判斷，CBETA參考自林光明先生的《梵字悉曇入門》p.257-260 及《往生咒研究》二書，其對應的梵字作：\"namo amitābhāya tathāgatāya tadyathā amṛtodhave amṛta-siddhaṃbhave amṛta-vikrānte amṛta-vikrānta gāmine gagana kīrta-kare svāhā\"。不過梵字當中，本經沒有 \"amṛta-vikrānte\" 對應的中文音譯，而 T12n0368_p0351c10 及 T47n1969Ap0163a24 兩經有對應的中文音譯作「阿彌利哆毘迦蘭諦」，T47n1970_p0263c10 也有中文音譯作「阿彌里掇毘加蘭帝」。"}
{"id": null, "n": "0348b1001", "target": "#nkr_note_add_0348b1001", "type": "add", "text": "寺【CB】，等【大】"}
{"id": null, "n": "0348b1201", "target": "#nkr_note_add_0348b1201", "type": "add", "text": "澡【CB】【磧-CB】，藻【大】"}
{"id": null, "n": "0348b1202", "target": "#nkr_note_add_0348b1202", "type": "add", "text": "楊【CB】，揚【大】"}
