{"id": null, "n": "0376001", "target": "#nkr_note_orig_0376001", "type": "orig", "text": "「般」，底本無，據文意補。"}
{"id": null, "n": "0376002", "target": "#nkr_note_orig_0376002", "type": "orig", "text": "「優」，底本作「憂」，據文意改。"}
{"id": null, "n": "0376003", "target": "#nkr_note_orig_0376003", "type": "orig", "text": "「為」，底本作「謂」，據文意改。"}
{"id": null, "n": "0376004", "target": "#nkr_note_orig_0376004", "type": "orig", "text": "「圍」，底本作「違」，據文意改。"}
{"id": null, "n": "0377001", "target": "#nkr_note_orig_0377001", "type": "orig", "text": "「我持」，底本作「持我」，據文意改。"}
{"id": null, "n": "0377002", "target": "#nkr_note_orig_0377002", "type": "orig", "text": "「已」，底本作「以」，據文意改。"}
{"id": null, "n": "0377003", "target": "#nkr_note_orig_0377003", "type": "orig", "text": "「為」，底本作「謂」，據文意改。"}
{"id": null, "n": "0377004", "target": "#nkr_note_orig_0377004", "type": "orig", "text": "「憶」，底本作「億」，據文意改。"}
{"id": null, "n": "0377005", "target": "#nkr_note_orig_0377005", "type": "orig", "text": "「河」，底本作「何」，據文意改。"}
{"id": null, "n": "0377006", "target": "#nkr_note_orig_0377006", "type": "orig", "text": "「復」，底本作「伏」，據文意改。"}
{"id": null, "n": "0377007", "target": "#nkr_note_orig_0377007", "type": "orig", "text": "「母」，底本作「敕」，據文意改。"}
{"id": null, "n": "0378001", "target": "#nkr_note_orig_0378001", "type": "orig", "text": "「猶」，底本作「由」，據文意改。"}
{"id": null, "n": "0378002", "target": "#nkr_note_orig_0378002", "type": "orig", "text": "「雲」，底本作「雲雲」，據文意刪。"}
{"id": null, "n": "0378003", "target": "#nkr_note_orig_0378003", "type": "orig", "text": "「疊」，底本作「牒」，據文意改。"}
{"id": null, "n": "0378004", "target": "#nkr_note_orig_0378004", "type": "orig", "text": "「踴」，底本作「湧」，據文意改。"}
{"id": null, "n": "0378005", "target": "#nkr_note_orig_0378005", "type": "orig", "text": "「紫」，底本作「此」，據文意改。"}
{"id": null, "n": "0379001", "target": "#nkr_note_orig_0379001", "type": "orig", "text": "「相」，底本作「想」，據文意改。"}
{"id": null, "n": "0379002", "target": "#nkr_note_orig_0379002", "type": "orig", "text": "「梵」，底本作「范」，據文意改。"}
{"id": null, "n": "0379003", "target": "#nkr_note_orig_0379003", "type": "orig", "text": "「我」，底本作「汝」，據文意改。"}
{"id": null, "n": "0379004", "target": "#nkr_note_orig_0379004", "type": "orig", "text": "伯2055號有題記一則，謂「為亡過家母寫此經一卷，年周追福。願託影好處，勿落三塗之災。佛弟子馬氏一心供養」。"}
