{"id": null, "n": null, "target": null, "type": null, "text": "祁彪隹　黃端伯"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣刻"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "嘉興府平湖縣東\n皋釋行旦施貲刻"}
{"id": null, "n": null, "target": null, "type": null, "text": "時雪雹大作"}
{"id": null, "n": null, "target": null, "type": null, "text": "此是居士省發因緣"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "嘉興府平湖縣東\n皋釋行旦施貲刻"}
{"id": null, "n": null, "target": null, "type": null, "text": "月曾作雲門侍者及庫頭首眾"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "嘉興府平湖縣\n東皋釋行旦施貲刻"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "嘉興府興善寺比丘明馨施貲貳兩，\n淨見、淨照、智覺、智樂、智達共壹兩，\n淨慧五錢，智瑛、智曇、智源共壹兩，\n淨趣、智常共肆錢，智鑑參錢，\n簷葡林淨月壹兩，智孚貳錢五分"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "松江府華亭縣信士朱爾千捐貲貳兩"}
{"id": null, "n": null, "target": null, "type": null, "text": "嘉興府嘉興縣信士周必成壹兩，\n馮邃昌、周在魯各壹兩，馮球五錢梓"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "嘉興府東塔雨花蘭若\n弟子淨介施貲五兩繡"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "嘉興府東塔雨花蘭若\n弟子淨介施貲五兩繡"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "嘉興府嘉興縣弟子沉淨素、朱行應、\n陳德成，　各壹兩。"}
{"id": null, "n": null, "target": null, "type": null, "text": "天寧寺淨御、智圓各壹兩，仝梓"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "松江府金澤信官趙　　捐貲壹兩，\n頤浩寺弟子淨穆參兩"}
{"id": null, "n": null, "target": null, "type": null, "text": "嘉興府太平庵廣言壹兩，　　仝梓"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "其一"}
{"id": null, "n": null, "target": null, "type": null, "text": "其二"}
{"id": null, "n": null, "target": null, "type": null, "text": "未牧"}
{"id": null, "n": null, "target": null, "type": null, "text": "初調"}
{"id": null, "n": null, "target": null, "type": null, "text": "受制"}
{"id": null, "n": null, "target": null, "type": null, "text": "迴首"}
{"id": null, "n": null, "target": null, "type": null, "text": "馴伏"}
{"id": null, "n": null, "target": null, "type": null, "text": "無礙"}
{"id": null, "n": null, "target": null, "type": null, "text": "任運"}
{"id": null, "n": null, "target": null, "type": null, "text": "相忘"}
{"id": null, "n": null, "target": null, "type": null, "text": "獨照"}
{"id": null, "n": null, "target": null, "type": null, "text": "雙泯"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈曰"}
{"id": null, "n": null, "target": null, "type": null, "text": "頌曰"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "松江府弟子相淨權三兩，\n丁智感、趙淨塵各壹兩"}
{"id": null, "n": null, "target": null, "type": null, "text": "二則"}
{"id": null, "n": null, "target": null, "type": null, "text": "鰲頭手執楊枝瓶"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲端"}
{"id": null, "n": null, "target": null, "type": null, "text": "水月"}
{"id": null, "n": null, "target": null, "type": null, "text": "楊枝淨水"}
{"id": null, "n": null, "target": null, "type": null, "text": "送子"}
{"id": null, "n": null, "target": null, "type": null, "text": "水月"}
{"id": null, "n": null, "target": null, "type": null, "text": "大海中柳枝"}
{"id": null, "n": null, "target": null, "type": null, "text": "魚籃"}
{"id": null, "n": null, "target": null, "type": null, "text": "蓮花"}
{"id": null, "n": null, "target": null, "type": null, "text": "普門細字像，從胸書起，末復至胸，可開，神妙"}
{"id": null, "n": null, "target": null, "type": null, "text": "圓光下像"}
{"id": null, "n": null, "target": null, "type": null, "text": "為法相可公五十壽"}
{"id": null, "n": null, "target": null, "type": null, "text": "鶴凌侍者請"}
{"id": null, "n": null, "target": null, "type": null, "text": "崑石請"}
{"id": null, "n": null, "target": null, "type": null, "text": "為寉陵智超請"}
{"id": null, "n": null, "target": null, "type": null, "text": "寓清流橘\n山，為旦平請"}
{"id": null, "n": null, "target": null, "type": null, "text": "省眉請"}
{"id": null, "n": null, "target": null, "type": null, "text": "印如請"}
{"id": null, "n": null, "target": null, "type": null, "text": "騎牛象"}
{"id": null, "n": null, "target": null, "type": null, "text": "九壁請"}
{"id": null, "n": null, "target": null, "type": null, "text": "道隆請"}
{"id": null, "n": null, "target": null, "type": null, "text": "為日生侍者請，時生將歸寧化之西山菴"}
{"id": null, "n": null, "target": null, "type": null, "text": "淨玉請"}
{"id": null, "n": null, "target": null, "type": null, "text": "傳侍者請"}
{"id": null, "n": null, "target": null, "type": null, "text": "汀州本然請"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲庫頭請"}
{"id": null, "n": null, "target": null, "type": null, "text": "節火頭請"}
{"id": null, "n": null, "target": null, "type": null, "text": "子孫拱立，童子送芝"}
{"id": null, "n": null, "target": null, "type": null, "text": "即曹愚公居士"}
{"id": null, "n": null, "target": null, "type": null, "text": "三首"}
{"id": null, "n": null, "target": null, "type": null, "text": "勵志一經"}
{"id": null, "n": null, "target": null, "type": null, "text": "廉風兩袖"}
{"id": null, "n": null, "target": null, "type": null, "text": "靜夜憂時"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "嘉興府天寧菴比丘明淨施貲一兩，\n信士徐煥淨、璞智萌各五錢，\n廣遠、霞谷、智開各三錢，\n金門智全、湯門智信各三錢，仝梓"}
{"id": null, "n": null, "target": null, "type": null, "text": "有敘"}
{"id": null, "n": null, "target": null, "type": null, "text": "柴林蓋九默別號也"}
{"id": null, "n": null, "target": null, "type": null, "text": "五首"}
{"id": null, "n": null, "target": null, "type": null, "text": "以下五言"}
{"id": null, "n": null, "target": null, "type": null, "text": "六首"}
{"id": null, "n": null, "target": null, "type": null, "text": "有序"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "松江府華亭縣弟子丁智感參兩"}
{"id": null, "n": null, "target": null, "type": null, "text": "嘉興府平湖縣弟子泰智崗、管智韶、\n徐如水、劉智京、喻天桭、袁敏文、\n釋淨津各貳錢，智雷四錢五分"}
{"id": null, "n": null, "target": null, "type": null, "text": "仝捐資壽梓"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "乙酉"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "丙戌春居適園所搆"}
{"id": null, "n": null, "target": null, "type": null, "text": "有引"}
{"id": null, "n": null, "target": null, "type": null, "text": "雪峰作"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "壬午仲春作"}
{"id": null, "n": null, "target": null, "type": null, "text": "癸未春作"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "嘉興府嘉善縣聞子淨覺捐貲貳兩，\n平湖縣弟子陳智谷、王智因、\n陸智元、陳智遠、趙智日各五錢，\n梅智果、陸顓奉各參錢，仝梓"}
{"id": null, "n": null, "target": null, "type": null, "text": "有序"}
{"id": null, "n": null, "target": null, "type": null, "text": "六首"}
{"id": null, "n": null, "target": null, "type": null, "text": "一水"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲徑"}
{"id": null, "n": null, "target": null, "type": null, "text": "鳳岩"}
{"id": null, "n": null, "target": null, "type": null, "text": "豎目"}
{"id": null, "n": null, "target": null, "type": null, "text": "聞空"}
{"id": null, "n": null, "target": null, "type": null, "text": "悟雲"}
{"id": null, "n": null, "target": null, "type": null, "text": "古梵"}
{"id": null, "n": null, "target": null, "type": null, "text": "葵心"}
{"id": null, "n": null, "target": null, "type": null, "text": "法雷"}
{"id": null, "n": null, "target": null, "type": null, "text": "傳度"}
{"id": null, "n": null, "target": null, "type": null, "text": "珠胎"}
{"id": null, "n": null, "target": null, "type": null, "text": "素軒"}
{"id": null, "n": null, "target": null, "type": null, "text": "玄微"}
{"id": null, "n": null, "target": null, "type": null, "text": "非臺"}
{"id": null, "n": null, "target": null, "type": null, "text": "悟曇"}
{"id": null, "n": null, "target": null, "type": null, "text": "是岸"}
{"id": null, "n": null, "target": null, "type": null, "text": "無生"}
{"id": null, "n": null, "target": null, "type": null, "text": "鶴凌"}
{"id": null, "n": null, "target": null, "type": null, "text": "慧田"}
{"id": null, "n": null, "target": null, "type": null, "text": "瑞真"}
{"id": null, "n": null, "target": null, "type": null, "text": "應生"}
{"id": null, "n": null, "target": null, "type": null, "text": "鳴岐"}
{"id": null, "n": null, "target": null, "type": null, "text": "爾賓"}
{"id": null, "n": null, "target": null, "type": null, "text": "寧宇"}
{"id": null, "n": null, "target": null, "type": null, "text": "石淙"}
{"id": null, "n": null, "target": null, "type": null, "text": "仙船岩"}
{"id": null, "n": null, "target": null, "type": null, "text": "虎嘯岩"}
{"id": null, "n": null, "target": null, "type": null, "text": "城高岩"}
{"id": null, "n": null, "target": null, "type": null, "text": "鑄錢岩"}
{"id": null, "n": null, "target": null, "type": null, "text": "龍吟菴"}
{"id": null, "n": null, "target": null, "type": null, "text": "十首"}
{"id": null, "n": null, "target": null, "type": null, "text": "在匡山，葉西塔于此"}
{"id": null, "n": null, "target": null, "type": null, "text": "在古歙，為眉子歸安處"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "有序"}
{"id": null, "n": null, "target": null, "type": null, "text": "靈峰伽藍"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "嘉興府萬壽菴智耕施貲一兩，\n淨行、淨戒各五錢，智古三錢，\n薛鳳岑、成筏、吳佳道、顯道、聞\n淨雯、潤凡、心賢等上，\n比丘尼炤真、慧光、寂空、內音\n各二錢五分，仝梓"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "嘉興府香萃菴等雄捐貲壹兩；\n東塔浮璩、祥符普聞、選勝淨儀、\n法華寂涵、楞嚴海坤，各五錢；\n照內、牲鑑，各參錢；普忍、淨照\n，各貳錢五分。"}
{"id": null, "n": null, "target": null, "type": null, "text": "紹興府天華寺智孝五錢"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "嘉興府梅溪菴通勝助刻資貳兩，\n東塔盛時壹兩，淨朝五錢，\n通識三錢，\n宛在菴行普壹兩，仝壽梓。"}
{"id": null, "n": null, "target": null, "type": null, "text": "附來問"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "克聖淨賢請"}
{"id": null, "n": null, "target": null, "type": null, "text": "曾以賣墨為行腳"}
{"id": null, "n": null, "target": null, "type": null, "text": "時當雷雨乍歇"}
{"id": null, "n": null, "target": null, "type": null, "text": "時雷雨方息"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "即唐祈遠"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "杭州府海寧縣慧力寺比丘淨時等\n助刻資肆兩。\n檇李苾芻弘籥、梁溪苾芻等睿、\n鹽官苾芻智圓，仝勸募刻此。"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛月石雨大和尚法檀二十卷，費銀\n九十五兩"}
{"id": null, "n": null, "target": null, "type": null, "text": "歲在己丑春王正月，鼾關道人識"}
