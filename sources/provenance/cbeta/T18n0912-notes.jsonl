{"id": null, "n": null, "target": null, "type": null, "text": "法全"}
{"id": null, "n": "0929007", "target": null, "type": "orig", "text": "弟＋（子）【甲】"}
{"id": null, "n": "0929007", "target": null, "type": "mod", "text": "弟【大】，弟子【甲】"}
{"id": null, "n": "0929008", "target": null, "type": "orig", "text": "師壇＝壇師【乙】"}
{"id": null, "n": "0929008", "target": null, "type": "mod", "text": "師壇【大】，壇師【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "暗字在於頂欠暗左右耳在額名為惡糝索在兩肩唅鶴作咽心㘕𡀩為臍腰鑁嚩為髀足三處弟師壇"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": null, "target": null, "type": null, "text": "五"}
{"id": null, "n": null, "target": null, "type": null, "text": "或部主加持"}
{"id": null, "n": null, "target": null, "type": null, "text": "圓爐六甬"}
{"id": null, "n": null, "target": null, "type": null, "text": "祕錄云仁錄外"}
{"id": null, "n": "0929002", "target": "#nkr_note_mod_0929002", "type": "mod", "text": "法全【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0929003", "target": "#nkr_note_mod_0929003", "type": "mod", "text": "警【大】＊，驚【乙】＊"}
{"id": null, "n": "0929004", "target": "#nkr_note_mod_0929004", "type": "mod", "text": "伽【大】，祇【甲】【乙】"}
{"id": null, "n": "0929005", "target": "#nkr_note_mod_0929005", "type": "mod", "text": "磨【大】，摩【乙】"}
{"id": null, "n": "0929006", "target": "#nkr_note_mod_0929006", "type": "mod", "text": "暗字在於頂欠暗左右耳在額名為惡糝索在兩肩唅鶴作咽心㘕𡀩為臍腰鑁嚩為髀足三處弟師壇【大】，暗字在於頂欠暗左右耳在額名為惡糝索在兩肩唅鶴作咽心㘕𡀩為臍腰鑁嚩為髀足三處弟師壇【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "暗字在於頂欠暗左右耳在額名為惡糝索在兩肩唅鶴作咽心㘕𡀩為臍腰鑁嚩為髀足三處弟師壇"}
{"id": null, "n": "0929007", "target": "#nkr_note_mod_0929007", "type": "mod", "text": "弟【大】，弟子【甲】"}
{"id": null, "n": "0929008", "target": "#nkr_note_mod_0929008", "type": "mod", "text": "師壇【大】，壇師【乙】"}
{"id": null, "n": "0929009", "target": "#nkr_note_mod_0929009", "type": "mod", "text": "曜【大】，耀【乙】"}
{"id": null, "n": "0929010", "target": "#nkr_note_mod_0929010", "type": "mod", "text": "前【大】，時【校異-乙】"}
{"id": null, "n": "0929011", "target": "#nkr_note_mod_0929011", "type": "mod", "text": "導【大】＊，道【乙】＊"}
{"id": null, "n": "0929012", "target": "#nkr_note_mod_0929012", "type": "mod", "text": "復【大】，後【乙】"}
{"id": null, "n": "0929015", "target": "#nkr_note_mod_0929015", "type": "mod", "text": "遍【大】，反【乙】"}
{"id": null, "n": "0929016", "target": "#nkr_note_mod_0929016", "type": "mod", "text": "慧【大】下同，惠【乙】下同"}
{"id": null, "n": "0929017", "target": "#nkr_note_mod_0929017", "type": "mod", "text": "默【大】，哩【乙】"}
{"id": null, "n": "0929018", "target": "#nkr_note_mod_0929018", "type": "mod", "text": "坐【大】，座【甲】【乙】"}
{"id": null, "n": "0930001", "target": "#nkr_note_mod_0930001", "type": "mod", "text": "作【大】，住【乙】"}
{"id": null, "n": "0930002", "target": "#nkr_note_mod_0930002", "type": "mod", "text": "八【大】，八遍【乙】"}
{"id": null, "n": "0930003", "target": "#nkr_note_mod_0930003", "type": "mod", "text": "土【大】，〔－〕【乙】"}
{"id": null, "n": "0930004", "target": "#nkr_note_mod_0930004", "type": "mod", "text": "和【大】，加【乙】"}
{"id": null, "n": "0930005", "target": "#nkr_note_mod_0930005", "type": "mod", "text": "磨【大】，摩【甲】【乙】"}
{"id": null, "n": "0930006", "target": "#nkr_note_mod_0930006", "type": "mod", "text": "淨【大】，澤【乙】"}
{"id": null, "n": "0930007", "target": "#nkr_note_mod_0930007", "type": "mod", "text": "黎【大】＊，梨【甲】＊"}
{"id": null, "n": "0930008", "target": "#nkr_note_mod_0930008", "type": "mod", "text": "訶【大】，賀【乙】"}
{"id": null, "n": "0930009", "target": "#nkr_note_mod_0930009", "type": "mod", "text": "賀【大】，賀引【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0930010", "target": "#nkr_note_mod_0930010", "type": "mod", "text": "綵【大】，彩【甲】【乙】"}
{"id": null, "n": "0930011", "target": "#nkr_note_mod_0930011", "type": "mod", "text": "道【大】，檀【甲】，檀【乙】"}
{"id": null, "n": "0930012", "target": "#nkr_note_mod_0930012", "type": "mod", "text": "周【大】，同【甲】"}
{"id": null, "n": "0930013", "target": "#nkr_note_mod_0930013", "type": "mod", "text": "蔽【大】＊，弊【乙】＊"}
{"id": null, "n": "0930014", "target": "#nkr_note_mod_0930014", "type": "mod", "text": "子【大】，字【乙】"}
{"id": null, "n": "0930015", "target": "#nkr_note_mod_0930015", "type": "mod", "text": "佛身【大】，身佛【乙】"}
{"id": null, "n": "0930016", "target": "#nkr_note_mod_0930016", "type": "mod", "text": "即【大】，印【甲】"}
{"id": null, "n": "0930017", "target": "#nkr_note_mod_0930017", "type": "mod", "text": "即是【大】，是即【乙】"}
{"id": null, "n": "0930018", "target": "#nkr_note_mod_0930018", "type": "mod", "text": "那【大】，那佛【甲】【乙】"}
{"id": null, "n": "0931001", "target": "#nkr_note_mod_0931001", "type": "mod", "text": "言【大】，言觀以誦密言【乙】"}
{"id": null, "n": "0931002", "target": "#nkr_note_mod_0931002", "type": "mod", "text": "遍【大】，匝【乙】"}
{"id": null, "n": "0931003", "target": "#nkr_note_mod_0931003", "type": "mod", "text": "陀【大】，荼【乙】"}
{"id": null, "n": "0931004", "target": "#nkr_note_mod_0931004", "type": "mod", "text": "燥【大】，󳘘【甲】【乙】"}
{"id": null, "n": "0931005", "target": "#nkr_note_mod_0931005", "type": "mod", "text": "彼修【大】，修彼【乙】"}
{"id": null, "n": "0931006", "target": "#nkr_note_mod_0931006", "type": "mod", "text": "妄【大】，忘【甲】"}
{"id": null, "n": "0931007", "target": "#nkr_note_mod_0931007", "type": "mod", "text": "左【大】，右【乙】"}
{"id": null, "n": "0931008", "target": "#nkr_note_mod_0931008", "type": "mod", "text": "焰【大】，煙【甲】"}
{"id": null, "n": "0931009", "target": "#nkr_note_mod_0931009", "type": "mod", "text": "􈅺【大】，惡【乙】"}
{"id": null, "n": "0931010", "target": "#nkr_note_mod_0931010", "type": "mod", "text": "娜【大】，那【乙】"}
{"id": null, "n": "0931011", "target": "#nkr_note_mod_0931011", "type": "mod", "text": "豁【大】，額【乙】"}
{"id": null, "n": "0931012", "target": "#nkr_note_mod_0931012", "type": "mod", "text": "怒【大】，猛【乙】"}
{"id": null, "n": "0931013", "target": "#nkr_note_mod_0931013", "type": "mod", "text": "麗【大】，灑【乙】"}
{"id": null, "n": "0931014", "target": "#nkr_note_mod_0931014", "type": "mod", "text": "果【大】，菓【甲】【乙】"}
{"id": null, "n": "0932001", "target": "#nkr_note_mod_0932001", "type": "mod", "text": "歡【大】，觀【乙】"}
{"id": null, "n": "0932002", "target": "#nkr_note_mod_0932002", "type": "mod", "text": "子【大】，等【乙】"}
{"id": null, "n": "0932003", "target": "#nkr_note_mod_0932003", "type": "mod", "text": "燒【大】，減【校異-原】，盛【乙】"}
{"id": null, "n": "0932004", "target": "#nkr_note_mod_0932004", "type": "mod", "text": "出【大】，生【乙】"}
{"id": null, "n": "0932005", "target": "#nkr_note_mod_0932005", "type": "mod", "text": "王【大】，至【乙】"}
{"id": null, "n": "0932006", "target": "#nkr_note_mod_0932006", "type": "mod", "text": "加【大】，觸【校異-乙】"}
{"id": null, "n": "0932007", "target": "#nkr_note_mod_0932007", "type": "mod", "text": "崇【大】，宗【乙】"}
{"id": null, "n": "0932008", "target": "#nkr_note_mod_0932008", "type": "mod", "text": "納受【大】，受納【乙】"}
{"id": null, "n": "0932009", "target": "#nkr_note_mod_0932009", "type": "mod", "text": "抳【大】，𭎵【甲】"}
{"id": null, "n": "0932010", "target": "#nkr_note_mod_0932010", "type": "mod", "text": "持【大】，特【乙】"}
{"id": null, "n": "0932011", "target": "#nkr_note_mod_0932011", "type": "mod", "text": "摩【大】，麼【乙】"}
{"id": null, "n": "0932012", "target": "#nkr_note_mod_0932012", "type": "mod", "text": "覩【大】，都【乙】"}
{"id": null, "n": "0932013", "target": "#nkr_note_mod_0932013", "type": "mod", "text": "轉【大】，旋【乙】"}
{"id": null, "n": "0932014", "target": "#nkr_note_mod_0932014", "type": "mod", "text": "漱【大】，嚬【乙】"}
{"id": null, "n": "0932015", "target": "#nkr_note_mod_0932015", "type": "mod", "text": "蜜【大】＊，密【乙】＊"}
{"id": null, "n": "0932016", "target": "#nkr_note_mod_0932016", "type": "mod", "text": "乳【大】，蘇【乙】"}
{"id": null, "n": "0932017", "target": "#nkr_note_mod_0932017", "type": "mod", "text": "乳【大】，酥【校異-原】"}
