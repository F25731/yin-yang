{"id": null, "n": "0826022", "target": null, "type": "orig", "text": "妸＝娿【元】"}
{"id": null, "n": "0826022", "target": null, "type": "mod", "text": "妸【大】＊，娿【元】＊"}
{"id": null, "n": "0826001", "target": "#nkr_note_mod_0826001", "type": "mod", "text": "佛說【大】＊，〔－〕【宋】【宮】＊"}
{"id": null, "n": "0826002", "target": "#nkr_note_mod_0826002", "type": "mod", "text": "劉宋天竺【大】，宋【宋】【宮】，劉宋【元】"}
{"id": null, "n": "0826003", "target": "#nkr_note_mod_0826003", "type": "mod", "text": "乏少【大】，渴欲【宮】"}
{"id": null, "n": "0826004", "target": "#nkr_note_mod_0826004", "type": "mod", "text": "白㲲【大】＊，白疊【宋】【宮】＊"}
{"id": null, "n": "0826005", "target": "#nkr_note_mod_0826005", "type": "mod", "text": "唯【大】，〔－〕【宮】"}
{"id": null, "n": "0826006", "target": "#nkr_note_mod_0826006", "type": "mod", "text": "拭【大】，飾【宋】【元】【宮】"}
{"id": null, "n": "0826007", "target": "#nkr_note_mod_0826007", "type": "mod", "text": "興【大】，與【元】"}
{"id": null, "n": "0826008", "target": "#nkr_note_mod_0826008", "type": "mod", "text": "命【大】，〔－〕【宮】"}
{"id": null, "n": "0826009", "target": "#nkr_note_mod_0826009", "type": "mod", "text": "閤【大】＊，門【宋】＊"}
{"id": null, "n": "0826010", "target": "#nkr_note_mod_0826010", "type": "mod", "text": "即導王前【大】，導前【宮】"}
{"id": null, "n": "0826011", "target": "#nkr_note_mod_0826011", "type": "mod", "text": "（以是…淚出）八字【大】，〔－〕【宮】"}
{"id": null, "n": "0826012", "target": "#nkr_note_mod_0826012", "type": "mod", "text": "蠟【大】，蜜【宮】"}
{"id": null, "n": "0826013", "target": "#nkr_note_mod_0826013", "type": "mod", "text": "神【大】，魂【元】"}
{"id": null, "n": "0826014", "target": "#nkr_note_mod_0826014", "type": "mod", "text": "（王是…耳）十一字【大】，〔－〕【宮】"}
{"id": null, "n": "0826015", "target": "#nkr_note_mod_0826015", "type": "mod", "text": "黯黯【大】＊，󰬶󰬶【宋】【宮】＊"}
{"id": null, "n": "0826016", "target": "#nkr_note_mod_0826016", "type": "mod", "text": "已【大】，以【宋】【宮】"}
{"id": null, "n": "0826017", "target": "#nkr_note_mod_0826017", "type": "mod", "text": "婦女【大】，女婦【宮】"}
{"id": null, "n": "0826018", "target": "#nkr_note_mod_0826018", "type": "mod", "text": "宜可取之【大】，可取【宮】"}
{"id": null, "n": "0826019", "target": "#nkr_note_mod_0826019", "type": "mod", "text": "舍【大】，合【元】【宋】"}
{"id": null, "n": "0826020", "target": "#nkr_note_mod_0826020", "type": "mod", "text": "繚戾【大】＊，撩捩【宋】【宮】＊"}
{"id": null, "n": "0826021", "target": "#nkr_note_mod_0826021", "type": "mod", "text": "腰髖妸婆【大】＊，腰寬跛𨁟【宋】【宮】＊"}
{"id": null, "n": "0826022", "target": "#nkr_note_mod_0826022", "type": "mod", "text": "妸【大】＊，娿【元】＊"}
{"id": null, "n": "0826023", "target": "#nkr_note_mod_0826023", "type": "mod", "text": "頭脚跛𨁟【大】＊，頭崎𧿽𨁟【宋】＊，頭羌叵我【宮】＊"}
{"id": null, "n": "0826024", "target": "#nkr_note_mod_0826024", "type": "mod", "text": "在虛空中【大】，〔－〕【宮】"}
{"id": null, "n": "0826025", "target": "#nkr_note_mod_0826025", "type": "mod", "text": "金杵【大】，金杖【宮】"}
{"id": null, "n": "0826026", "target": "#nkr_note_mod_0826026", "type": "mod", "text": "車【大】，居【宋】"}
