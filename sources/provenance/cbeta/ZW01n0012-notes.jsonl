{"id": null, "n": "0356001", "target": "#nkr_note_orig_0356001", "type": "orig", "text": "「閻羅王問」，底本無，據文意補。"}
{"id": null, "n": "0356002", "target": "#nkr_note_orig_0356002", "type": "orig", "text": "「人」，底本無，據文意補。"}
{"id": null, "n": "0356003", "target": "#nkr_note_orig_0356003", "type": "orig", "text": "「二」，底本作「八」，據文意改。"}
{"id": null, "n": "0357001", "target": "#nkr_note_orig_0357001", "type": "orig", "text": "「大」，底本作「念大」，據文意刪。"}
{"id": null, "n": "0357002", "target": "#nkr_note_orig_0357002", "type": "orig", "text": "「方」，底本無，據文意補。"}
{"id": null, "n": "0357003", "target": "#nkr_note_orig_0357003", "type": "orig", "text": "「佛」，底本無，據文意補。"}
{"id": null, "n": "0357004", "target": "#nkr_note_orig_0357004", "type": "orig", "text": "「使」字不清，或為「付」、「傳」。"}
{"id": null, "n": "0357005", "target": "#nkr_note_orig_0357005", "type": "orig", "text": "「與」字不清，或為「為」。"}
{"id": null, "n": "0358001", "target": "#nkr_note_orig_0358001", "type": "orig", "text": "「大」，底本作「無」，據文意改。"}
{"id": null, "n": "0358002", "target": "#nkr_note_orig_0358002", "type": "orig", "text": "「勸」，底本作「歡」，據文意改。"}
{"id": null, "n": "0358003", "target": "#nkr_note_orig_0358003", "type": "orig", "text": "「虔」，底本作「虎」，據文意改。"}
{"id": null, "n": "0358004", "target": "#nkr_note_orig_0358004", "type": "orig", "text": "「誦贊」，底本無。"}
