{"id": null, "n": null, "target": null, "type": "cf1", "text": "K06n0046_p1304b17"}
{"id": null, "n": "0153023", "target": "#nkr_note_mod_0153023", "type": "mod", "text": "佛說【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0153024", "target": "#nkr_note_mod_0153024", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0153025", "target": "#nkr_note_mod_0153025", "type": "mod", "text": "央【大】下同，鞅【宋】【宮】下同"}
{"id": null, "n": "0153026", "target": "#nkr_note_mod_0153026", "type": "mod", "text": "頰【大】，貌【宋】【元】【明】【宮】"}
{"id": null, "n": "0153027", "target": "#nkr_note_mod_0153027", "type": "mod", "text": "淫泆【大】，婬妷【宋】【宮】，婬泆【元】"}
{"id": null, "n": "0154001", "target": "#nkr_note_mod_0154001", "type": "mod", "text": "佛【大】，是【宋】【元】"}
{"id": null, "n": "0154002", "target": "#nkr_note_mod_0154002", "type": "mod", "text": "受【大】，向【宋】【元】【明】【宮】"}
{"id": null, "n": "0154003", "target": "#nkr_note_mod_0154003", "type": "mod", "text": "正【大】，定【宋】【元】【明】【宮】"}
{"id": null, "n": "0154004", "target": "#nkr_note_mod_0154004", "type": "mod", "text": "問【大】，聞【宋】【元】【明】【宮】"}
{"id": null, "n": "0154005", "target": "#nkr_note_mod_0154005", "type": "mod", "text": "慧【大】，慧法【宋】【元】【明】【宮】"}
{"id": null, "n": "0154006", "target": "#nkr_note_mod_0154006", "type": "mod", "text": "故【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0154007", "target": "#nkr_note_mod_0154007", "type": "mod", "text": "師【大】，即【宋】【元】【明】【宮】"}
{"id": null, "n": "0154008", "target": "#nkr_note_mod_0154008", "type": "mod", "text": "杖【大】，仗【明】"}
{"id": null, "n": "0154009", "target": "#nkr_note_mod_0154009", "type": "mod", "text": "寶【大】，寶富【宋】【元】【明】【宮】"}
{"id": null, "n": "0154010", "target": "#nkr_note_mod_0154010", "type": "mod", "text": "離【大】，難【宋】【元】【明】【宮】"}
{"id": null, "n": "0154011", "target": "#nkr_note_mod_0154011", "type": "mod", "text": "者得【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0154012", "target": "#nkr_note_mod_0154012", "type": "mod", "text": "駱駝【大】，馲駝【宋】【元】【明】【宮】"}
{"id": null, "n": "0154013", "target": "#nkr_note_mod_0154013", "type": "mod", "text": "維【大】，惟【宋】【元】【明】【宮】"}
{"id": null, "n": "0154014", "target": "#nkr_note_mod_0154014", "type": "mod", "text": "預【大】＊，豫【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0154015", "target": "#nkr_note_mod_0154015", "type": "mod", "text": "若【大】，𢜪【宋】【元】【明】【宮】"}
{"id": null, "n": "0155001", "target": "#nkr_note_mod_0155001", "type": "mod", "text": "是【大】，經【宋】【元】【明】【宮】"}
