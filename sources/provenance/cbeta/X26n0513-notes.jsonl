{"id": null, "n": "0133b1901", "target": "#nkr_note_add_0133b1901", "type": "add", "text": "［－］【CB】，一【卍續】"}
{"id": null, "n": "0133b2201", "target": "#nkr_note_add_0133b2201", "type": "add", "text": "［－］【CB】，一【卍續】"}
