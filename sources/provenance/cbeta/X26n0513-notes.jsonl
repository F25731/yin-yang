{"id": null, "n": null, "target": null, "type": null, "text": "即是護體也"}
{"id": null, "n": null, "target": null, "type": null, "text": "相師占"}
{"id": null, "n": null, "target": null, "type": null, "text": "十三法師即為爾別"}
