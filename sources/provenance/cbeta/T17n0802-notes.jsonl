{"id": null, "n": "0747002", "target": "#nkr_note_mod_0747002", "type": "mod", "text": "西【大】，宋西【明】"}
{"id": null, "n": "0747003", "target": "#nkr_note_mod_0747003", "type": "mod", "text": "奉【大】，散【宋】【元】【明】【宮】"}
{"id": null, "n": "0747004", "target": "#nkr_note_mod_0747004", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0748001", "target": "#nkr_note_mod_0748001", "type": "mod", "text": "及所作【大】，所作之【明】"}
{"id": null, "n": "0748002", "target": "#nkr_note_mod_0748002", "type": "mod", "text": "謗諸【大】，毀謗【明】"}
{"id": null, "n": "0748003", "target": "#nkr_note_mod_0748003", "type": "mod", "text": "起於【大】，而復【明】"}
{"id": null, "n": "0748004", "target": "#nkr_note_mod_0748004", "type": "mod", "text": "造【大】，作【明】"}
{"id": null, "n": "0748005", "target": "#nkr_note_mod_0748005", "type": "mod", "text": "法【大】＊，法皆是邪因所起【明】＊"}
{"id": null, "n": "0748006", "target": "#nkr_note_mod_0748006", "type": "mod", "text": "見【大】，〔－〕【明】"}
{"id": null, "n": "0748007", "target": "#nkr_note_mod_0748007", "type": "mod", "text": "人【大】，人如是等法皆如實知如是如來以清淨天眼過於肉眼觀見世間一切眾生生滅好醜貴賤上下善趣惡趣及所作業乃至眾生具身口意諸不善業謗諸賢聖起於邪見造不善業行不善法由此邪見因緣故命終之後墮於惡趣受地獄苦又復眾生以身口意行十善業不謗賢聖起於正見作諸善業行諸善法由此正見因緣故命終之後生於天界而為天人【明】"}
{"id": null, "n": "0748008", "target": "#nkr_note_mod_0748008", "type": "mod", "text": "至【大】，知【宮】"}
{"id": null, "n": "0748009", "target": "#nkr_note_mod_0748009", "type": "mod", "text": "告【大】，等【宮】"}
{"id": null, "n": "0747002", "target": "#nkr_note_orig_0747002", "type": "orig", "text": "（宋）＋西【明】"}
{"id": null, "n": "0747003", "target": "#nkr_note_orig_0747003", "type": "orig", "text": "奉＝散【三】【宮】"}
{"id": null, "n": "0747004", "target": "#nkr_note_orig_0747004", "type": "orig", "text": "〔臣〕－【明】"}
{"id": null, "n": "0748001", "target": "#nkr_note_orig_0748001", "type": "orig", "text": "及所作＝所作之【明】"}
{"id": null, "n": "0748002", "target": "#nkr_note_orig_0748002", "type": "orig", "text": "謗諸＝毀謗【明】"}
{"id": null, "n": "0748003", "target": "#nkr_note_orig_0748003", "type": "orig", "text": "起於＝而復【明】"}
{"id": null, "n": "0748004", "target": "#nkr_note_orig_0748004", "type": "orig", "text": "造＝作【明】"}
{"id": null, "n": "0748005", "target": "#nkr_note_orig_0748005", "type": "orig", "text": "法＋（皆是邪因所起）【明】＊"}
{"id": null, "n": "0748006", "target": "#nkr_note_orig_0748006", "type": "orig", "text": "〔見〕－【明】"}
{"id": null, "n": "0748007", "target": "#nkr_note_orig_0748007", "type": "orig", "text": "人＋（如是等法皆如實知如是如來以清淨天眼過於肉眼觀見世間一切眾生生滅好醜貴賤上下善趣惡趣及所作業乃至眾生具身口意諸不善業謗諸賢聖起於邪見造不善業行不善法由此邪見因緣故命終之後墮於惡趣受地獄苦又復眾生以身口意行十善業不謗賢聖起於正見作諸善業行諸善法由此正見因緣故命終之後生於天界而為天人）【明】"}
{"id": null, "n": "0748008", "target": "#nkr_note_orig_0748008", "type": "orig", "text": "至＝知【宮】"}
{"id": null, "n": "0748009", "target": "#nkr_note_orig_0748009", "type": "orig", "text": "告＝等【宮】"}
