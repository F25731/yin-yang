{"id": null, "n": "0476b2103", "target": "#nkr_note_add_0476b2103", "type": "add", "text": "身【CB】，【房山】"}
{"id": null, "n": "0476b2201", "target": "#nkr_note_add_0476b2201", "type": "add", "text": "已有五相又復【CB】，【房山】"}
{"id": null, "n": "0476b2202", "target": "#nkr_note_add_0476b2202", "type": "add", "text": "所【CB】，【房山】"}
{"id": null, "n": "0476b2203", "target": "#nkr_note_add_0476b2203", "type": "add", "text": "此諸【CB】，【房山】"}
{"id": null, "n": "0476b2204", "target": "#nkr_note_add_0476b2204", "type": "add", "text": "不【CB】，【房山】"}
{"id": null, "n": "0476b2205", "target": "#nkr_note_add_0476b2205", "type": "add", "text": "聞此【CB】，【房山】"}
