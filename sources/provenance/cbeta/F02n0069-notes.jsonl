{"id": null, "n": "0476a0101", "target": "#nkr_note_add_0476a0101", "type": "add", "text": "世尊與諸比丘住於竹林是諸比丘於晨朝時【CB】，【房山】"}
{"id": null, "n": "0476a0201", "target": "#nkr_note_add_0476a0201", "type": "add", "text": "共集欲說何法【CB】，【房山】"}
{"id": null, "n": "0476a0202", "target": "#nkr_note_add_0476a0202", "type": "add", "text": "時諸比丘即白佛言世尊我等食【CB】，【房山】"}
{"id": null, "n": "0476a0203", "target": "#nkr_note_add_0476a0203", "type": "add", "text": "已【CB】，巳【房山】"}
{"id": null, "n": "0476a0204", "target": "#nkr_note_add_0476a0204", "type": "add", "text": "念【CB】，【房山】"}
{"id": null, "n": "0476a0301", "target": "#nkr_note_add_0476a0301", "type": "add", "text": "刧爾時有一【CB】，【房山】"}
{"id": null, "n": "0476a0302", "target": "#nkr_note_add_0476a0302", "type": "add", "text": "名曰善慧淨修梵行求一切種【CB】，【房山】"}
{"id": null, "n": "0476a0303", "target": "#nkr_note_add_0476a0303", "type": "add", "text": "數其【CB】，【房山】"}
{"id": null, "n": "0476a0401", "target": "#nkr_note_add_0476a0401", "type": "add", "text": "當决【CB】，【房山】"}
{"id": null, "n": "0476a0501", "target": "#nkr_note_add_0476a0501", "type": "add", "text": "戒攝毀禁忍辱攝瞋恚精進攝懈怠禪定攝【CB】，【房山】"}
{"id": null, "n": "0476a0601", "target": "#nkr_note_add_0476a0601", "type": "add", "text": "照城名提播【CB】，【房山】"}
{"id": null, "n": "0476a0602", "target": "#nkr_note_add_0476a0602", "type": "add", "text": "底【CB】，【房山】"}
{"id": null, "n": "0476a0603", "target": "#nkr_note_add_0476a0603", "type": "add", "text": "國人民【CB】，【房山】"}
{"id": null, "n": "0476a0604", "target": "#nkr_note_add_0476a0604", "type": "add", "text": "豐【CB】，豊【房山】"}
{"id": null, "n": "0476a0605", "target": "#nkr_note_add_0476a0605", "type": "add", "text": "抂【CB】，【房山】"}
{"id": null, "n": "0476a0701", "target": "#nkr_note_add_0476a0701", "type": "add", "text": "方皆明日月【CB】，【房山】"}
{"id": null, "n": "0476a0702", "target": "#nkr_note_add_0476a0702", "type": "add", "text": "𠮦【CB】，現【房山】"}
{"id": null, "n": "0476a0703", "target": "#nkr_note_add_0476a0703", "type": "add", "text": "而【CB】，【房山】"}
{"id": null, "n": "0476a0801", "target": "#nkr_note_add_0476a0801", "type": "add", "text": "者為天人尊成薩婆【CB】，【房山】"}
{"id": null, "n": "0476a0901", "target": "#nkr_note_add_0476a0901", "type": "add", "text": "二萬九千嵗捨轉輪王位啟其【CB】，【房山】"}
{"id": null, "n": "0476a0902", "target": "#nkr_note_add_0476a0902", "type": "add", "text": "既不聽已【CB】，【房山】"}
{"id": null, "n": "0476a1001", "target": "#nkr_note_add_0476a1001", "type": "add", "text": "微妙一切世間天人魔【CB】，【房山】"}
{"id": null, "n": "0476a1101", "target": "#nkr_note_add_0476a1101", "type": "add", "text": "捨轉輪王位【CB】，【房山】"}
{"id": null, "n": "0476a1102", "target": "#nkr_note_add_0476a1102", "type": "add", "text": "󵖋󳊹【CB】，【房山】"}
{"id": null, "n": "0476a1103", "target": "#nkr_note_add_0476a1103", "type": "add", "text": "已【CB】，巳【房山】"}
{"id": null, "n": "0476a1201", "target": "#nkr_note_add_0476a1201", "type": "add", "text": "人亦得【CB】，【房山】"}
{"id": null, "n": "0476a1202", "target": "#nkr_note_add_0476a1202", "type": "add", "text": "忍【CB】，【房山】"}
{"id": null, "n": "0476a1203", "target": "#nkr_note_add_0476a1203", "type": "add", "text": "聞【CB】，【房山】"}
{"id": null, "n": "0476a1204", "target": "#nkr_note_add_0476a1204", "type": "add", "text": "已【CB】，巳【房山】"}
{"id": null, "n": "0476a1205", "target": "#nkr_note_add_0476a1205", "type": "add", "text": "幡盖【CB】，【房山】"}
{"id": null, "n": "0476a1301", "target": "#nkr_note_add_0476a1301", "type": "add", "text": "鼓【CB】，【房山】"}
{"id": null, "n": "0476a1302", "target": "#nkr_note_add_0476a1302", "type": "add", "text": "𭜧輸【CB】，【房山】"}
{"id": null, "n": "0476a1401", "target": "#nkr_note_add_0476a1401", "type": "add", "text": "日五者夢【CB】，【房山】"}
{"id": null, "n": "0476a1402", "target": "#nkr_note_add_0476a1402", "type": "add", "text": "所【CB】，【房山】"}
{"id": null, "n": "0476a1501", "target": "#nkr_note_add_0476a1501", "type": "add", "text": "之并得觀其所修之業即【CB】，【房山】"}
{"id": null, "n": "0476a1502", "target": "#nkr_note_add_0476a1502", "type": "add", "text": "諸【CB】，【房山】"}
{"id": null, "n": "0476a1503", "target": "#nkr_note_add_0476a1503", "type": "add", "text": "見時【CB】，【房山】"}
{"id": null, "n": "0476a1601", "target": "#nkr_note_add_0476a1601", "type": "add", "text": "興【CB】，【房山】"}
{"id": null, "n": "0476a1602", "target": "#nkr_note_add_0476a1602", "type": "add", "text": "人聞斯語已舉體毛竪心大歡喜踊躍無量【CB】，【房山】"}
{"id": null, "n": "0476a1603", "target": "#nkr_note_add_0476a1603", "type": "add", "text": "今【CB】，【房山】"}
{"id": null, "n": "0476a1701", "target": "#nkr_note_add_0476a1701", "type": "add", "text": "隨【CB】，【房山】"}
{"id": null, "n": "0476a1702", "target": "#nkr_note_add_0476a1702", "type": "add", "text": "戀懊𢙉辭別而歸【CB】，【房山】"}
{"id": null, "n": "0476a1703", "target": "#nkr_note_add_0476a1703", "type": "add", "text": "善慧至前見王家人平治【CB】，【房山】"}
{"id": null, "n": "0476a1704", "target": "#nkr_note_add_0476a1704", "type": "add", "text": "幡【CB】，【房山】"}
{"id": null, "n": "0476a1705", "target": "#nkr_note_add_0476a1705", "type": "add", "text": "興【CB】，【房山】"}
{"id": null, "n": "0476a1801", "target": "#nkr_note_add_0476a1801", "type": "add", "text": "道士燈照大王擊鼓唱令國內名花皆不得【CB】，【房山】"}
{"id": null, "n": "0476a1802", "target": "#nkr_note_add_0476a1802", "type": "add", "text": "中善【CB】，【房山】"}
{"id": null, "n": "0476a1901", "target": "#nkr_note_add_0476a1901", "type": "add", "text": "止此花賣不青衣聞已心大驚愕而自念言藏花甚【CB】，【房山】"}
{"id": null, "n": "0476a1902", "target": "#nkr_note_add_0476a1902", "type": "add", "text": "也善【CB】，【房山】"}
{"id": null, "n": "0476a2001", "target": "#nkr_note_add_0476a2001", "type": "add", "text": "所直不過數錢而今男子乃以銀錢五百求買五莖【CB】，【房山】"}
{"id": null, "n": "0476a2002", "target": "#nkr_note_add_0476a2002", "type": "add", "text": "知諸【CB】，【房山】"}
{"id": null, "n": "0476a2101", "target": "#nkr_note_add_0476a2101", "type": "add", "text": "為求何等善慧答曰為欲成就一切種智度脫無量苦【CB】，【房山】"}
{"id": null, "n": "0476a2102", "target": "#nkr_note_add_0476a2102", "type": "add", "text": "故【CB】，【房山】"}
{"id": null, "n": "0476a2103", "target": "#nkr_note_add_0476a2103", "type": "add", "text": "之曰【CB】，【房山】"}
{"id": null, "n": "0476a2201", "target": "#nkr_note_add_0476a2201", "type": "add", "text": "無為道不得相許生死之緣青衣即言若當不󷚫我此願者花不可【CB】，【房山】"}
{"id": null, "n": "0476a2202", "target": "#nkr_note_add_0476a2202", "type": "add", "text": "目髓腦【CB】，口【房山】"}
