{"id": null, "n": "0953005", "target": "#nkr_note_orig_0953005", "type": "orig", "text": "我ト讀ム󴧛"}
{"id": null, "n": "0953006", "target": "#nkr_note_orig_0953006", "type": "orig", "text": "受ト讀ム󴧛"}
