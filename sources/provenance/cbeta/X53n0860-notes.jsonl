{"id": null, "n": "0953010", "target": "#nkr_note_orig_0953010", "type": "orig", "text": "有ノ下ニ此ノ字アリ󴧚"}
{"id": null, "n": "0953011", "target": "#nkr_note_orig_0953011", "type": "orig", "text": "此ト讀ム󴧚（誤植カ。󴦒）"}
{"id": null, "n": "0953012", "target": "#nkr_note_orig_0953012", "type": "orig", "text": "以下缺損。󴦒"}
