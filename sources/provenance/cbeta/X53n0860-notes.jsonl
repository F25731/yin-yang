{"id": null, "n": "0952018", "target": "#nkr_note_orig_0952018", "type": "orig", "text": "闕ト讀ム󴧛"}
{"id": null, "n": "0952019", "target": "#nkr_note_orig_0952019", "type": "orig", "text": "闕ト讀ム󴧛"}
