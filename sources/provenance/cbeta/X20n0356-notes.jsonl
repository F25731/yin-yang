{"id": null, "n": null, "target": null, "type": null, "text": "平聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "去聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "上皆彼文。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "未詳"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "音撥，舶大船也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音祖組，其小者可以為冠。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音厥。易曰：掘地為臼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音果，苞也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音貪，探取也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音昔，析分也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音員，猨似猴而大，能嘯也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "煜，音\n浴。煜，光盛貌。爚，爍藥二音。爚，光明皃。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音堅，犍獸，似豹，人首，一目。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音始，剏也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音敢，稈槀\n也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音累，耒田噐也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音復。複，重衣也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音獨，犢牛柔謹也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "乎各切，水竭也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音桂，揆度也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音喘，舛相皆也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音衛，緯織絲也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音襯，讖預也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "與枹同，音浮，鼓槌也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音列，\n鬣長須也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音兼，織不篋也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音線，羨貪慕也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音殼，確堅固也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音巡，咨也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "一作彷彿不明也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音罩，取魚棹具也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "音踏，沓重也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音恣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音話。"}
{"id": null, "n": null, "target": null, "type": null, "text": "當作禳，音穰，攘却變異也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音盈，\n柱也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音珍，斟行酌也，取也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "戶間切。白鷴，似雉而尾長四五尺。"}
{"id": null, "n": null, "target": null, "type": null, "text": "侹，音挺。徑侹，直也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音仍\n去聲，芿草芟陳者，新者又生曰。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音田，填塞滿也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "攝，音折。褻，音䐑。攝褻，重衣也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音魁，跬舉一足也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音遂，邃深遠也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音悃，壺居也，廣也，宮中道也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音四，飼食也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "褒，博毛切，進揚美也。貶，音匾，貶減損也。"}
{"id": null, "n": "0054001", "target": "#nkr_note_mod_0054001", "type": "mod", "text": "次釋已下別行記作卷之四"}
{"id": null, "n": "0027001", "target": "#nkr_note_orig_0027001", "type": "orig", "text": "特一作持"}
{"id": null, "n": "0027002", "target": "#nkr_note_orig_0027002", "type": "orig", "text": "我或作理"}
{"id": null, "n": "0028001", "target": "#nkr_note_orig_0028001", "type": "orig", "text": "斲疑斷"}
{"id": null, "n": "0028002", "target": "#nkr_note_orig_0028002", "type": "orig", "text": "雖疑離"}
{"id": null, "n": "0028003", "target": "#nkr_note_orig_0028003", "type": "orig", "text": "諸一作詣"}
{"id": null, "n": "0028004", "target": "#nkr_note_orig_0028004", "type": "orig", "text": "也一作耶"}
{"id": null, "n": "0029001", "target": "#nkr_note_orig_0029001", "type": "orig", "text": "對別一作別對"}
{"id": null, "n": "0029002", "target": "#nkr_note_orig_0029002", "type": "orig", "text": "准一作唯"}
{"id": null, "n": "0029003", "target": "#nkr_note_orig_0029003", "type": "orig", "text": "也下一有今以經王敘教即能詮是中道也十三字"}
{"id": null, "n": "0029004", "target": "#nkr_note_orig_0029004", "type": "orig", "text": "神一作祗"}
{"id": null, "n": "0030001", "target": "#nkr_note_orig_0030001", "type": "orig", "text": "體下一有不唯識體四字"}
{"id": null, "n": "0030002", "target": "#nkr_note_orig_0030002", "type": "orig", "text": "云一作去"}
{"id": null, "n": "0031001", "target": "#nkr_note_orig_0031001", "type": "orig", "text": "施一作設"}
{"id": null, "n": "0031002", "target": "#nkr_note_orig_0031002", "type": "orig", "text": "別一作明"}
{"id": null, "n": "0032001", "target": "#nkr_note_orig_0032001", "type": "orig", "text": "二一作三"}
{"id": null, "n": "0032002", "target": "#nkr_note_orig_0032002", "type": "orig", "text": "二疑一"}
{"id": null, "n": "0032003", "target": "#nkr_note_orig_0032003", "type": "orig", "text": "行下一有人字"}
{"id": null, "n": "0032004", "target": "#nkr_note_orig_0032004", "type": "orig", "text": "名一作明"}
{"id": null, "n": "0033001", "target": "#nkr_note_orig_0033001", "type": "orig", "text": "轉上一有而字"}
{"id": null, "n": "0033002", "target": "#nkr_note_orig_0033002", "type": "orig", "text": "為斯疑寫倒"}
{"id": null, "n": "0035001", "target": "#nkr_note_orig_0035001", "type": "orig", "text": "令疑今"}
{"id": null, "n": "0035002", "target": "#nkr_note_orig_0035002", "type": "orig", "text": "無一作與"}
{"id": null, "n": "0036001", "target": "#nkr_note_orig_0036001", "type": "orig", "text": "名下一有云字"}
{"id": null, "n": "0036002", "target": "#nkr_note_orig_0036002", "type": "orig", "text": "住下一有位字"}
{"id": null, "n": "0037001", "target": "#nkr_note_orig_0037001", "type": "orig", "text": "解上一有識字"}
{"id": null, "n": "0038001", "target": "#nkr_note_orig_0038001", "type": "orig", "text": "具疑且"}
{"id": null, "n": "0038002", "target": "#nkr_note_orig_0038002", "type": "orig", "text": "法疑性"}
{"id": null, "n": "0038003", "target": "#nkr_note_orig_0038003", "type": "orig", "text": "既下一有是字"}
{"id": null, "n": "0038004", "target": "#nkr_note_orig_0038004", "type": "orig", "text": "徧一作偏"}
{"id": null, "n": "0038005", "target": "#nkr_note_orig_0038005", "type": "orig", "text": "法下疑脫身字"}
{"id": null, "n": "0038006", "target": "#nkr_note_orig_0038006", "type": "orig", "text": "當一作常"}
{"id": null, "n": "0039001", "target": "#nkr_note_orig_0039001", "type": "orig", "text": "照疑謂"}
{"id": null, "n": "0040001", "target": "#nkr_note_orig_0040001", "type": "orig", "text": "義下恐脫同字"}
{"id": null, "n": "0040002", "target": "#nkr_note_orig_0040002", "type": "orig", "text": "滅下一有不生不滅四字"}
{"id": null, "n": "0040003", "target": "#nkr_note_orig_0040003", "type": "orig", "text": "則一作即"}
{"id": null, "n": "0040004", "target": "#nkr_note_orig_0040004", "type": "orig", "text": "即下一有是字"}
{"id": null, "n": "0042001", "target": "#nkr_note_orig_0042001", "type": "orig", "text": "三一作二"}
{"id": null, "n": "0042002", "target": "#nkr_note_orig_0042002", "type": "orig", "text": "即下一有是字"}
{"id": null, "n": "0043001", "target": "#nkr_note_orig_0043001", "type": "orig", "text": "三一作二"}
{"id": null, "n": "0043002", "target": "#nkr_note_orig_0043002", "type": "orig", "text": "惡下一有即是性惡四字"}
{"id": null, "n": "0044001", "target": "#nkr_note_orig_0044001", "type": "orig", "text": "身下一有法身二字"}
{"id": null, "n": "0045001", "target": "#nkr_note_orig_0045001", "type": "orig", "text": "智眼一作眼智"}
{"id": null, "n": "0047001", "target": "#nkr_note_orig_0047001", "type": "orig", "text": "身下一有者字"}
{"id": null, "n": "0047002", "target": "#nkr_note_orig_0047002", "type": "orig", "text": "益疑葢"}
{"id": null, "n": "0048001", "target": "#nkr_note_orig_0048001", "type": "orig", "text": "名下一有為字"}
{"id": null, "n": "0050001", "target": "#nkr_note_orig_0050001", "type": "orig", "text": "何下一有得字"}
{"id": null, "n": "0051001", "target": "#nkr_note_orig_0051001", "type": "orig", "text": "實一作寶"}
{"id": null, "n": "0052001", "target": "#nkr_note_orig_0052001", "type": "orig", "text": "一無二字"}
{"id": null, "n": "0052002", "target": "#nkr_note_orig_0052002", "type": "orig", "text": "此一作今"}
{"id": null, "n": "0052003", "target": "#nkr_note_orig_0052003", "type": "orig", "text": "名一作妙"}
{"id": null, "n": "0053001", "target": "#nkr_note_orig_0053001", "type": "orig", "text": "此一作比"}
{"id": null, "n": "0053002", "target": "#nkr_note_orig_0053002", "type": "orig", "text": "偶一作遇"}
{"id": null, "n": "0053003", "target": "#nkr_note_orig_0053003", "type": "orig", "text": "質一作執"}
{"id": null, "n": "0054001", "target": "#nkr_note_orig_0054001", "type": "orig", "text": "次釋巳下別行記作卷之四"}
{"id": null, "n": "0055001", "target": "#nkr_note_orig_0055001", "type": "orig", "text": "今一作令"}
{"id": null, "n": "0056001", "target": "#nkr_note_orig_0056001", "type": "orig", "text": "示一作云"}
{"id": null, "n": "0056002", "target": "#nkr_note_orig_0056002", "type": "orig", "text": "理下疑脫之字"}
{"id": null, "n": "0057001", "target": "#nkr_note_orig_0057001", "type": "orig", "text": "以疑示或是修字"}
{"id": null, "n": "0057002", "target": "#nkr_note_orig_0057002", "type": "orig", "text": "現科文作觀"}
{"id": null, "n": "0057003", "target": "#nkr_note_orig_0057003", "type": "orig", "text": "若疑又"}
{"id": null, "n": "0057004", "target": "#nkr_note_orig_0057004", "type": "orig", "text": "令一作今"}
{"id": null, "n": "0057005", "target": "#nkr_note_orig_0057005", "type": "orig", "text": "雖疑誰"}
{"id": null, "n": "0058001", "target": "#nkr_note_orig_0058001", "type": "orig", "text": "身是恐寫倒"}
{"id": null, "n": "0058002", "target": "#nkr_note_orig_0058002", "type": "orig", "text": "自下一有害字"}
{"id": null, "n": "0059001", "target": "#nkr_note_orig_0059001", "type": "orig", "text": "明一作名"}
{"id": null, "n": "0061001", "target": "#nkr_note_orig_0061001", "type": "orig", "text": "知一作起"}
{"id": null, "n": "0062001", "target": "#nkr_note_orig_0062001", "type": "orig", "text": "今一作下"}
{"id": null, "n": "0062002", "target": "#nkr_note_orig_0062002", "type": "orig", "text": "此上一有以字"}
{"id": null, "n": "0062003", "target": "#nkr_note_orig_0062003", "type": "orig", "text": "不上一有而字"}
{"id": null, "n": "0063001", "target": "#nkr_note_orig_0063001", "type": "orig", "text": "動疑勤"}
{"id": null, "n": "0064001", "target": "#nkr_note_orig_0064001", "type": "orig", "text": "放一作故"}
{"id": null, "n": "0064002", "target": "#nkr_note_orig_0064002", "type": "orig", "text": "愛一作受"}
{"id": null, "n": "0064003", "target": "#nkr_note_orig_0064003", "type": "orig", "text": "不一作沙"}
{"id": null, "n": "0064004", "target": "#nkr_note_orig_0064004", "type": "orig", "text": "病一作識"}
{"id": null, "n": "0064005", "target": "#nkr_note_orig_0064005", "type": "orig", "text": "即一作四"}
{"id": null, "n": "0064006", "target": "#nkr_note_orig_0064006", "type": "orig", "text": "沙一作不"}
{"id": null, "n": "0064007", "target": "#nkr_note_orig_0064007", "type": "orig", "text": "四一作即"}
{"id": null, "n": "0066001", "target": "#nkr_note_orig_0066001", "type": "orig", "text": "識恐滅"}
{"id": null, "n": "0066002", "target": "#nkr_note_orig_0066002", "type": "orig", "text": "便下一有淨字"}
{"id": null, "n": "0068001", "target": "#nkr_note_orig_0068001", "type": "orig", "text": "雖疑故"}
{"id": null, "n": "0069001", "target": "#nkr_note_orig_0069001", "type": "orig", "text": "憎疑增"}
{"id": null, "n": "0070001", "target": "#nkr_note_orig_0070001", "type": "orig", "text": "然下一有其字"}
{"id": null, "n": "0070002", "target": "#nkr_note_orig_0070002", "type": "orig", "text": "是一作事"}
{"id": null, "n": "0070003", "target": "#nkr_note_orig_0070003", "type": "orig", "text": "則一作用"}
{"id": null, "n": "0070004", "target": "#nkr_note_orig_0070004", "type": "orig", "text": "脫一作說"}
{"id": null, "n": "0070005", "target": "#nkr_note_orig_0070005", "type": "orig", "text": "二一作王"}
{"id": null, "n": "0071001", "target": "#nkr_note_orig_0071001", "type": "orig", "text": "法一作發"}
{"id": null, "n": "0072001", "target": "#nkr_note_orig_0072001", "type": "orig", "text": "通下一有達字"}
{"id": null, "n": "0073001", "target": "#nkr_note_orig_0073001", "type": "orig", "text": "是一作同"}
{"id": null, "n": "0074001", "target": "#nkr_note_orig_0074001", "type": "orig", "text": "如一作初"}
{"id": null, "n": "0074002", "target": "#nkr_note_orig_0074002", "type": "orig", "text": "外凡一作凡外"}
{"id": null, "n": "0075001", "target": "#nkr_note_orig_0075001", "type": "orig", "text": "各一作略"}
{"id": null, "n": "0075002", "target": "#nkr_note_orig_0075002", "type": "orig", "text": "三一作正"}
{"id": null, "n": "0075003", "target": "#nkr_note_orig_0075003 #note_star_1", "type": "orig", "text": "克一作剋次同"}
{"id": null, "n": "0076001", "target": "#nkr_note_orig_0076001", "type": "orig", "text": "義一作意"}
{"id": null, "n": "0077001", "target": "#nkr_note_orig_0077001", "type": "orig", "text": "謂一作體"}
{"id": null, "n": "0077002", "target": "#nkr_note_orig_0077002", "type": "orig", "text": "功一作果"}
{"id": null, "n": "0077003", "target": "#nkr_note_orig_0077003", "type": "orig", "text": "邊下一有爾字"}
{"id": null, "n": "0077004", "target": "#nkr_note_orig_0077004", "type": "orig", "text": "若下一有其字"}
{"id": null, "n": "0077005", "target": "#nkr_note_orig_0077005", "type": "orig", "text": "禳一作攘"}
{"id": null, "n": "0080001", "target": "#nkr_note_orig_0080001", "type": "orig", "text": "節一作即"}
