{"id": null, "n": "0189026", "target": "#nkr_note_mod_0189026", "type": "mod", "text": "所得【大】，聽所得即【宋】【元】【明】【宮】"}
{"id": null, "n": "0189027", "target": "#nkr_note_mod_0189027", "type": "mod", "text": "竟【大】，成【宋】【元】【明】【宮】"}
{"id": null, "n": "0189028", "target": "#nkr_note_mod_0189028", "type": "mod", "text": "師【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0189029", "target": "#nkr_note_mod_0189029", "type": "mod", "text": "佷【大】＊，很【宋】【元】【宮】＊，狠【明】＊"}
{"id": null, "n": "0189030", "target": "#nkr_note_mod_0189030", "type": "mod", "text": "生【大】，人多【宋】【元】【明】【宮】"}
{"id": null, "n": "0189031", "target": "#nkr_note_mod_0189031", "type": "mod", "text": "緰【大】，輸【宋】【元】【宮】，輪【明】"}
{"id": null, "n": "0189032", "target": "#nkr_note_mod_0189032", "type": "mod", "text": "顯【大】，頭【宋】【元】【明】【宮】"}
{"id": null, "n": "0189033", "target": "#nkr_note_mod_0189033", "type": "mod", "text": "勤【CB】【宮-CB】【宋】【元】【明】【宮】＊，勒【大】＊"}
{"id": null, "n": "0189034", "target": "#nkr_note_mod_0189034", "type": "mod", "text": "須【大】，各須【宋】【元】【明】【宮】"}
{"id": null, "n": "0189035", "target": "#nkr_note_mod_0189035", "type": "mod", "text": "諸【大】，法【宋】【元】【明】【宮】"}
{"id": null, "n": "0189036", "target": "#nkr_note_mod_0189036", "type": "mod", "text": "法【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0190001", "target": "#nkr_note_mod_0190001", "type": "mod", "text": "在外【大】，不在【宋】【元】【明】【宮】"}
{"id": null, "n": "0190002", "target": "#nkr_note_mod_0190002", "type": "mod", "text": "此【大】下同，其【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0190003", "target": "#nkr_note_mod_0190003", "type": "mod", "text": "義【大】＊，議【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0190004", "target": "#nkr_note_mod_0190004", "type": "mod", "text": "即【大】，〔－〕【宮】"}
{"id": null, "n": "0190005", "target": "#nkr_note_mod_0190005", "type": "mod", "text": "佉【大】＊，伽【明】＊"}
{"id": null, "n": "0190006", "target": "#nkr_note_mod_0190006", "type": "mod", "text": "摧【大】，折【宋】【元】【明】【宮】"}
