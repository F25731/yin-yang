{"id": null, "n": "0190014", "target": "#nkr_note_mod_0190014", "type": "mod", "text": "盡【大】，皆盡【宋】【元】【明】【宮】"}
{"id": null, "n": "0190015", "target": "#nkr_note_mod_0190015", "type": "mod", "text": "訖【大】，足【宋】【元】【明】【宮】"}
