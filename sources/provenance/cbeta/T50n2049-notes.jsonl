{"id": null, "n": "0190021", "target": "#nkr_note_mod_0190021", "type": "mod", "text": "既【大】，先【宋】【元】【明】【宮】"}
{"id": null, "n": "0190022", "target": "#nkr_note_mod_0190022", "type": "mod", "text": "佛所【大】，是佛【宋】【元】【明】【宮】"}
{"id": null, "n": "0190023", "target": "#nkr_note_mod_0190023", "type": "mod", "text": "淺【大】，識【宋】【元】【明】【宮】"}
