{"id": null, "n": "0188004", "target": "#nkr_note_mod_0188004", "type": "mod", "text": "法師【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0188005", "target": "#nkr_note_mod_0188005", "type": "mod", "text": "法師【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0188006", "target": "#nkr_note_mod_0188006", "type": "mod", "text": "出【大】，生【宋】【元】【明】【宮】"}
{"id": null, "n": "0188007", "target": "#nkr_note_mod_0188007", "type": "mod", "text": "修羅【大】，阿修羅【宋】【元】【明】【宮】"}
{"id": null, "n": "0188008", "target": "#nkr_note_mod_0188008", "type": "mod", "text": "知履反【大】，〔－〕【明】"}
{"id": null, "n": "0188009", "target": "#nkr_note_mod_0188009", "type": "mod", "text": "婆【大】，波【宮】"}
{"id": null, "n": "0188010", "target": "#nkr_note_mod_0188010", "type": "mod", "text": "形容【大】，容貌【宋】【元】【明】【宮】"}
{"id": null, "n": "0188011", "target": "#nkr_note_mod_0188011", "type": "mod", "text": "其【大】，冥【宮】"}
{"id": null, "n": "0188012", "target": "#nkr_note_mod_0188012", "type": "mod", "text": "可【大】，汝可【宋】【元】【明】【宮】"}
{"id": null, "n": "0188013", "target": "#nkr_note_mod_0188013", "type": "mod", "text": "我【大】，我是【宋】【元】【明】【宮】"}
{"id": null, "n": "0188014", "target": "#nkr_note_mod_0188014", "type": "mod", "text": "適【大】＊，𡣪【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0188015", "target": "#nkr_note_mod_0188015", "type": "mod", "text": "以【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0188016", "target": "#nkr_note_mod_0188016", "type": "mod", "text": "明【大】，明處【宋】【元】【明】【宮】"}
{"id": null, "n": "0188017", "target": "#nkr_note_mod_0188017", "type": "mod", "text": "妹【大】，姝【宮】"}
{"id": null, "n": "0188018", "target": "#nkr_note_mod_0188018", "type": "mod", "text": "今【大】，〔－〕【宮】"}
{"id": null, "n": "0188019", "target": "#nkr_note_mod_0188019", "type": "mod", "text": "即【大】，頭即【宋】【元】【明】【宮】"}
{"id": null, "n": "0188020", "target": "#nkr_note_mod_0188020", "type": "mod", "text": "即【大】，隨即【宋】【元】【明】【宮】"}
{"id": null, "n": "0188021", "target": "#nkr_note_mod_0188021", "type": "mod", "text": "更【大】，既【宮】"}
{"id": null, "n": "0188022", "target": "#nkr_note_mod_0188022", "type": "mod", "text": "取【大】，即取【宋】【元】【明】【宮】"}
{"id": null, "n": "0188023", "target": "#nkr_note_mod_0188023", "type": "mod", "text": "得【大】，待【宋】【元】【明】【宮】"}
{"id": null, "n": "0188024", "target": "#nkr_note_mod_0188024", "type": "mod", "text": "被【大】，若被【宋】【元】【明】【宮】"}
{"id": null, "n": "0188025", "target": "#nkr_note_mod_0188025", "type": "mod", "text": "便【大】，更【宋】【元】【明】【宮】"}
{"id": null, "n": "0188026", "target": "#nkr_note_mod_0188026", "type": "mod", "text": "憍【大】，嬌【宋】【元】【明】【宮】"}
{"id": null, "n": "0188027", "target": "#nkr_note_mod_0188027", "type": "mod", "text": "定梨反【大】，〔－〕【明】【宮】"}
{"id": null, "n": "0188028", "target": "#nkr_note_mod_0188028", "type": "mod", "text": "紱【大】＊，跋【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0188029", "target": "#nkr_note_mod_0188029", "type": "mod", "text": "羅【大】，盧【宋】【元】【明】【宮】"}
{"id": null, "n": "0188030", "target": "#nkr_note_mod_0188030", "type": "mod", "text": "兜率多【大】下同，兜率陀【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0188031", "target": "#nkr_note_mod_0188031", "type": "mod", "text": "彌勒菩薩【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0188032", "target": "#nkr_note_mod_0188032", "type": "mod", "text": "名【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0188033", "target": "#nkr_note_mod_0188033", "type": "mod", "text": "阿僧伽【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0188034", "target": "#nkr_note_mod_0188034", "type": "mod", "text": "聞【大】＊，皆【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0188035", "target": "#nkr_note_mod_0188035", "type": "mod", "text": "得【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0188036", "target": "#nkr_note_mod_0188036", "type": "mod", "text": "有【大】，昔【宮】"}
{"id": null, "n": "0188037", "target": "#nkr_note_mod_0188037", "type": "mod", "text": "解【大】，未解【宋】【元】【明】【宮】"}
{"id": null, "n": "0188038", "target": "#nkr_note_mod_0188038", "type": "mod", "text": "法師【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0188039", "target": "#nkr_note_mod_0188039", "type": "mod", "text": "波【大】，婆【宋】【元】【明】【宮】"}
{"id": null, "n": "0188040", "target": "#nkr_note_mod_0188040", "type": "mod", "text": "大【大】，大乘【宋】【元】【明】【宮】"}
{"id": null, "n": "0188041", "target": "#nkr_note_mod_0188041", "type": "mod", "text": "第二【大】，第二子【宋】【元】【明】【宮】"}
{"id": null, "n": "0189001", "target": "#nkr_note_mod_0189001", "type": "mod", "text": "名【大】，名說【宋】【元】【明】【宮】"}
{"id": null, "n": "0189002", "target": "#nkr_note_mod_0189002", "type": "mod", "text": "乾度【大】，揵度【宋】【元】【明】【宮】"}
{"id": null, "n": "0189003", "target": "#nkr_note_mod_0189003", "type": "mod", "text": "聞【大】，聞佛【宋】【元】【明】【宮】"}
{"id": null, "n": "0189004", "target": "#nkr_note_mod_0189004", "type": "mod", "text": "是【大】，是若人【宋】【元】【明】【宮】"}
{"id": null, "n": "0189005", "target": "#nkr_note_mod_0189005", "type": "mod", "text": "略若廣【大】，廣若略【宋】【元】【明】【宮】"}
