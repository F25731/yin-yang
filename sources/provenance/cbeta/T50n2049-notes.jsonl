{"id": null, "n": "0190008", "target": "#nkr_note_mod_0190008", "type": "mod", "text": "訖【大】，之【宋】【元】【明】【宮】"}
{"id": null, "n": "0190009", "target": "#nkr_note_mod_0190009", "type": "mod", "text": "悅【大】，快【宋】【元】【明】【宮】"}
