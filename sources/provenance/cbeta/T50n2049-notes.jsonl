{"id": null, "n": "0189021", "target": "#nkr_note_mod_0189021", "type": "mod", "text": "王【大】，王德龍王【宋】【元】【明】【宮】"}
{"id": null, "n": "0189022", "target": "#nkr_note_mod_0189022", "type": "mod", "text": "其隨施所【大】，道其外道隨破隨【宋】【元】【明】【宮】"}
{"id": null, "n": "0189023", "target": "#nkr_note_mod_0189023", "type": "mod", "text": "教【大】，且敕【宋】【元】【明】【宮】"}
{"id": null, "n": "0189024", "target": "#nkr_note_mod_0189024", "type": "mod", "text": "來【大】，成【宋】【元】【明】【宮】"}
