{"id": null, "n": "0189008", "target": "#nkr_note_mod_0189008", "type": "mod", "text": "表【大】＊，製【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0189009", "target": "#nkr_note_mod_0189009", "type": "mod", "text": "子【大】，一【宮】"}
{"id": null, "n": "0189010", "target": "#nkr_note_mod_0189010", "type": "mod", "text": "表【大】，制【宋】【元】【明】【宮】"}
{"id": null, "n": "0189011", "target": "#nkr_note_mod_0189011", "type": "mod", "text": "諸【大】，法【宋】【元】【明】【宮】"}
{"id": null, "n": "0189012", "target": "#nkr_note_mod_0189012", "type": "mod", "text": "緰【大】，踰【宋】【元】【明】【宮】"}
{"id": null, "n": "0189013", "target": "#nkr_note_mod_0189013", "type": "mod", "text": "拔【大】，跋【宋】【元】【明】【宮】"}
{"id": null, "n": "0189014", "target": "#nkr_note_mod_0189014", "type": "mod", "text": "集【大】，大集【宋】【元】【明】【宮】"}
{"id": null, "n": "0189015", "target": "#nkr_note_mod_0189015", "type": "mod", "text": "言語【大】，語言【宋】【元】【明】【宮】"}
{"id": null, "n": "0189016", "target": "#nkr_note_mod_0189016", "type": "mod", "text": "使知聞【大】，便聞知【宋】【元】【明】【宮】"}
{"id": null, "n": "0189017", "target": "#nkr_note_mod_0189017", "type": "mod", "text": "取【大】，取之【宋】【元】【明】【宮】"}
{"id": null, "n": "0189018", "target": "#nkr_note_mod_0189018", "type": "mod", "text": "年【大】，年已【宋】【元】【明】【宮】"}
{"id": null, "n": "0189019", "target": "#nkr_note_mod_0189019", "type": "mod", "text": "有【大】，善【宋】【元】【明】【宮】"}
