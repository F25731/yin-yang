{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "觀今文意，次義則疎"}
{"id": null, "n": null, "target": null, "type": null, "text": "濁土也"}
{"id": null, "n": null, "target": null, "type": null, "text": "異趣也"}
{"id": null, "n": null, "target": null, "type": null, "text": "劉遺民云：傲天宮以長辭"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云水產金蓮曰金池者，非"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云潛神目修觀者，非"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云佛語尊貴，名琅函者，非"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "《易》云：「歷觀\n眾卦。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "《易》曰：「君子\n有攸往，先迷後得。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "《孟子題詞》曰：「今諸解者，往往摭取而說之。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "《書．序》云：「芟夷繁亂，翦截浮\n詞。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "委如《扶新論》辯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "語出《周易》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《書．序》云：「庶幾有補於將來。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "語出《揚子》"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼文"}
{"id": null, "n": null, "target": null, "type": null, "text": "《正因》雖則兩分，不通來難；《輔觀》雖順天台，不曉今意。"}
{"id": null, "n": null, "target": null, "type": null, "text": "語出《孟子》。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘如《扶新》"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘如《扶新》。"}
{"id": null, "n": null, "target": null, "type": null, "text": "或約開顯，強生問答，甚乖教意。"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上彼文"}
{"id": null, "n": null, "target": null, "type": null, "text": "現前\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "當來也"}
{"id": null, "n": null, "target": null, "type": null, "text": "委如《扶新》"}
{"id": null, "n": null, "target": null, "type": null, "text": "師承引孔子曰：「藥酒苦於口而利於病，忠言逆於耳而利於行。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "他謂不取天台，輙生詞訟，委如《扶新》。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘如《扶新》"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "有難：唯心不合屬理，備如《扶新》。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘如《扶新》。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《莊子》云：「今夫子亦有蓬心。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘如《扶新》。"}
{"id": null, "n": null, "target": null, "type": null, "text": "諸記差誤，對之可知。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘如《扶新》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《修證儀》中出十五種，須者看之"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘如《扶新》"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘如《扶新》"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼文"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘如《扶新》具辨"}
{"id": null, "n": null, "target": null, "type": null, "text": "書云：「百姓日用而不知，聖人之道鮮矣。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "螺髻即尸棄大梵，此翻頂\n髻"}
{"id": null, "n": null, "target": null, "type": null, "text": "即同方西\n居土也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上皆彼文"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘如《扶新》"}
{"id": null, "n": null, "target": null, "type": null, "text": "此但略知判位蹊逕，不必備謄\n諸說"}
{"id": null, "n": null, "target": null, "type": null, "text": "委如《扶新》。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘如《扶新》"}
{"id": null, "n": null, "target": null, "type": null, "text": "慧遠、\n慧持、慧永、道生、道昺、曇詵、曇順、道敬、僧叡、曇恒、覺明、覺賢"}
{"id": null, "n": null, "target": null, "type": null, "text": "宗炳、張野、周續之、張詮、劉遺民、\n雷次宗"}
{"id": null, "n": null, "target": null, "type": null, "text": "委如《扶新》"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "《正因》約三界，二死消者非。"}
{"id": null, "n": null, "target": null, "type": null, "text": "見、慢、名字"}
{"id": null, "n": null, "target": null, "type": null, "text": "思惑未盡，猶有慢我"}
{"id": null, "n": null, "target": null, "type": null, "text": "但有名字"}
{"id": null, "n": null, "target": null, "type": null, "text": "根也"}
{"id": null, "n": null, "target": null, "type": null, "text": "境也"}
{"id": null, "n": null, "target": null, "type": null, "text": "心即識也"}
{"id": null, "n": null, "target": null, "type": null, "text": "如《蘭盆記》"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "明事火懺悔法"}
{"id": null, "n": null, "target": null, "type": null, "text": "明布施祠祀法"}
{"id": null, "n": null, "target": null, "type": null, "text": "明外國鬪戰法"}
{"id": null, "n": null, "target": null, "type": null, "text": "明外國鬪戰法"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "委如《扶新》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《正因》引《仁王》五忍，分判位次。又\n云二世皆獲證者，非。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "《正因》云：日午難觀，落時明了者，非也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音流"}
{"id": null, "n": null, "target": null, "type": null, "text": "諸記\n從初至名第三觀為躡前，佛告已下至盡文為結勸者，非。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云不伐遣相者，非"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘如《扶新》"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "此經宋朝始翻廬山，預修\n心想，暗與經合。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "或約天身長短為喻者，非。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《正因》節六十萬億為數量，恒河沙等為非數量\n者，非。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "或改觀作冠字者，非"}
{"id": null, "n": null, "target": null, "type": null, "text": "《正因》云身非一者，誤矣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《正因》云像即當觀者，非也"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘如《扶新》。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘如《扶新》"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "即本生也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即本事也"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "此略消文，餘如《扶新》具辯"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼文"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "「宋高僧傳之校勘與數位化版本」專案（案〈唐蘇州開元寺律和尚墳銘（并序）〉）"}
