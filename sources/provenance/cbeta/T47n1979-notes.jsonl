{"id": null, "n": "0424013", "target": "#nkr_note_mod_0424013", "type": "mod", "text": "明【大】，期【校異-原】"}
{"id": null, "n": "0425001", "target": "#nkr_note_mod_0425001", "type": "mod", "text": "現【大】，視【考偽-原】"}
{"id": null, "n": "0425002", "target": "#nkr_note_mod_0425002", "type": "mod", "text": "以【大】，已【校異-原】"}
{"id": null, "n": "0428001", "target": "#nkr_note_mod_0428001", "type": "mod", "text": "火【大】，尖【校異-原】"}
{"id": null, "n": "0429001", "target": "#nkr_note_mod_0429001", "type": "mod", "text": "四【大】，七【校異-原】"}
{"id": null, "n": "0429002", "target": "#nkr_note_mod_0429002", "type": "mod", "text": "流【大】，涌【校異-原】"}
{"id": null, "n": "0431001", "target": "#nkr_note_mod_0431001", "type": "mod", "text": "與佛【大】，佛與【校異-原】"}
{"id": null, "n": "0438001", "target": "#nkr_note_mod_0438001", "type": "mod", "text": "上【大】，南【校異-原】"}
{"id": null, "n": "0424012", "target": "#nkr_note_orig_0424012", "type": "orig", "text": "【原】德川時代刊宗教大學藏本"}
{"id": null, "n": "0424013", "target": "#nkr_note_orig_0424013", "type": "orig", "text": "明＝期ィ【原】"}
{"id": null, "n": "0425001", "target": "#nkr_note_orig_0425001", "type": "orig", "text": "現＝視ヵ【原】"}
{"id": null, "n": "0425002", "target": "#nkr_note_orig_0425002", "type": "orig", "text": "以＝已ィ【原】"}
{"id": null, "n": "0426001", "target": "#nkr_note_orig_0426001", "type": "orig", "text": "原本註曰退下經有轉字"}
{"id": null, "n": "0426002", "target": "#nkr_note_orig_0426002", "type": "orig", "text": "原本註曰惱上經有煩字"}
{"id": null, "n": "0428001", "target": "#nkr_note_orig_0428001", "type": "orig", "text": "火＝尖ィ【原】"}
{"id": null, "n": "0429001", "target": "#nkr_note_orig_0429001", "type": "orig", "text": "四＝七ィ【原】"}
{"id": null, "n": "0429002", "target": "#nkr_note_orig_0429002", "type": "orig", "text": "流＝涌ィ【原】"}
{"id": null, "n": "0431001", "target": "#nkr_note_orig_0431001", "type": "orig", "text": "與佛＝佛與ィ【原】"}
{"id": null, "n": "0438001", "target": "#nkr_note_orig_0438001", "type": "orig", "text": "上＝南ィ【原】"}
