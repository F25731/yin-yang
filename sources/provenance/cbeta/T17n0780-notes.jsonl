{"id": null, "n": "0715c2401", "target": "#nkr_note_add_0715c2401", "type": "add", "text": "踈【CB】【麗-CB】，疎【大】"}
{"id": null, "n": "0716a1101", "target": "#nkr_note_add_0716a1101", "type": "add", "text": "移【大】，󱡾【麗-CB】"}
{"id": null, "n": "0716a2101", "target": "#nkr_note_add_0716a2101", "type": "add", "text": "勒【大】，勤【麗-CB】"}
{"id": null, "n": "0716b1401", "target": "#nkr_note_add_0716b1401", "type": "add", "text": "峯【CB】【麗-CB】，峰【大】"}
{"id": null, "n": "0716c2301", "target": "#nkr_note_add_0716c2301", "type": "add", "text": "冷冷【大】，泠泠【麗-CB】"}
{"id": null, "n": "0717a1501", "target": "#nkr_note_add_0717a1501", "type": "add", "text": "段【CB】【卍續-CB】，叚【大】"}
{"id": null, "n": "0717a2201", "target": "#nkr_note_add_0717a2201", "type": "add", "text": "段【CB】【卍續-CB】，叚【大】"}
{"id": null, "n": "0717b0701", "target": "#nkr_note_add_0717b0701", "type": "add", "text": "班【CB】【麗-CB】，斑【大】"}
{"id": null, "n": "0717b0901", "target": "#nkr_note_add_0717b0901", "type": "add", "text": "慚【CB】【麗-CB】，漸【大】，慙【麗-CB】"}
