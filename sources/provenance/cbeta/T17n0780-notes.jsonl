{"id": null, "n": null, "target": null, "type": null, "text": "亦云式匿"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦云烏長及烏纏國"}
{"id": null, "n": null, "target": null, "type": null, "text": "平聲呼虐伽反"}
{"id": null, "n": null, "target": null, "type": null, "text": "近信度河也，亦云信圖或云辛頭城"}
{"id": null, "n": null, "target": null, "type": null, "text": "梵音正曰健䭾邏國"}
{"id": null, "n": null, "target": null, "type": null, "text": "地移反平聲呼，\n唐言翻為正智"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐言親教師，安西云和上"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐言闕"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐言軌範師，若至四鎮安西云阿闍梨，訛略耳"}
{"id": null, "n": null, "target": null, "type": null, "text": "巍屈反入聲呼"}
{"id": null, "n": null, "target": null, "type": null, "text": "平聲同上，唐言闕"}
{"id": null, "n": null, "target": null, "type": null, "text": "同上"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐言根本說一切有"}
{"id": null, "n": null, "target": null, "type": null, "text": "免煩反平聲呼"}
{"id": null, "n": null, "target": null, "type": null, "text": "而者反"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦云寶橋"}
{"id": null, "n": null, "target": null, "type": null, "text": "平聲呼虐迦反"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐言日宮寺也"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐言蓮華寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "一名沙勒"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦云于遁或云䛦丹"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐言地乳國"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦云丘茲"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐云蓮花精進"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐言戒法"}
