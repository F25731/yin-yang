{"id": null, "n": "1069c0401", "target": "#nkr_note_add_1069c0401", "type": "add", "text": "傅【CB】，傳【大】"}
{"id": null, "n": "1070c1201", "target": "#nkr_note_add_1070c1201", "type": "add", "text": "仞【CB】，𫢈【大】"}
{"id": null, "n": "1071c1101", "target": "#nkr_note_add_1071c1101", "type": "add", "text": "樁【CB】，椿【大】"}
{"id": null, "n": "1078b1201", "target": "#nkr_note_add_1078b1201", "type": "add", "text": "慄【CB】，慓【大】"}
{"id": null, "n": "1080c1301", "target": "#nkr_note_add_1080c1301", "type": "add", "text": "啼【CB】，󱣞【大】"}
{"id": null, "n": "1083c2201", "target": "#nkr_note_add_1083c2201", "type": "add", "text": "羨【CB】，羡【大】"}
{"id": null, "n": "1083c2202", "target": "#nkr_note_add_1083c2202", "type": "add", "text": "慮【CB】，盧【大】"}
{"id": null, "n": "1084a2201", "target": "#nkr_note_add_1084a2201", "type": "add", "text": "間【CB】，問【大】"}
{"id": null, "n": "1086a2301", "target": "#nkr_note_add_1086a2301", "type": "add", "text": "士【CB】，土【大】"}
{"id": null, "n": "1086b2101", "target": "#nkr_note_add_1086b2101", "type": "add", "text": "斂【CB】，歛【大】"}
{"id": null, "n": "1088a1701", "target": "#nkr_note_add_1088a1701", "type": "add", "text": "于【CB】，干【大】"}
{"id": null, "n": "1088a2001", "target": "#nkr_note_add_1088a2001", "type": "add", "text": "僭【CB】，僣【大】"}
{"id": null, "n": "1088b0201", "target": "#nkr_note_add_1088b0201", "type": "add", "text": "于【CB】，干【大】"}
{"id": null, "n": "1088c1701", "target": "#nkr_note_add_1088c1701", "type": "add", "text": "洒【CB】，酒【大】"}
{"id": null, "n": "1089c1701", "target": "#nkr_note_add_1089c1701", "type": "add", "text": "恩【CB】，思【大】"}
{"id": null, "n": "1090b0201", "target": "#nkr_note_add_1090b0201", "type": "add", "text": "圮【CB】，𡉏【大】"}
{"id": null, "n": "1091b2901", "target": "#nkr_note_add_1091b2901", "type": "add", "text": "倍【CB】，陪【大】"}
