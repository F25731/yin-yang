{"id": null, "n": null, "target": null, "type": null, "text": "孔注南岳衡山也"}
{"id": null, "n": null, "target": null, "type": null, "text": "赤芝即火\n山芝也"}
{"id": null, "n": null, "target": null, "type": null, "text": "青玉即仙人橋也。白璧即光天壇也"}
{"id": null, "n": null, "target": null, "type": null, "text": "可觀日出"}
{"id": null, "n": null, "target": null, "type": null, "text": "多蓄山魈"}
{"id": null, "n": null, "target": null, "type": null, "text": "一云滿谷"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上五峯為祝融之所隷"}
{"id": null, "n": null, "target": null, "type": null, "text": "紫金即寶露瓮也"}
{"id": null, "n": null, "target": null, "type": null, "text": "中主也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即雲母也"}
{"id": null, "n": null, "target": null, "type": null, "text": "琴棊之友即耆闍善女也。棲霞君是桂林北往反二十里"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上二十\n七峯。係屬紫葢所隷"}
{"id": null, "n": null, "target": null, "type": null, "text": "即岳麓也"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上五峯係屬雲密"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上十七\n峯係石廩所隷"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上十三峯係隷天柱"}
{"id": null, "n": null, "target": null, "type": null, "text": "在岳麓第二十"}
{"id": null, "n": null, "target": null, "type": null, "text": "第二十一"}
{"id": null, "n": null, "target": null, "type": null, "text": "第二十二"}
{"id": null, "n": null, "target": null, "type": null, "text": "第二十五"}
{"id": null, "n": null, "target": null, "type": null, "text": "聖謂朱陵宮"}
{"id": null, "n": null, "target": null, "type": null, "text": "靈謂方廣寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "洞天東門"}
{"id": null, "n": null, "target": null, "type": null, "text": "洞天南門"}
{"id": null, "n": null, "target": null, "type": null, "text": "洞天西門"}
{"id": null, "n": null, "target": null, "type": null, "text": "洞天北門"}
{"id": null, "n": null, "target": null, "type": null, "text": "東便門"}
{"id": null, "n": null, "target": null, "type": null, "text": "西便門"}
{"id": null, "n": null, "target": null, "type": null, "text": "又曰寶露"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "又曰鳳凰"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "今壽棋觀是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "景定\n辛酉四月三十夜遭回祿。正殿後宮俱盡。惟存三門散廊而已"}
{"id": null, "n": null, "target": null, "type": null, "text": "玄君即赤帝君事為玄君"}
{"id": null, "n": null, "target": null, "type": null, "text": "今山北有皇想山"}
{"id": null, "n": null, "target": null, "type": null, "text": "以下缺"}
{"id": null, "n": null, "target": null, "type": null, "text": "冲"}
{"id": null, "n": null, "target": null, "type": null, "text": "眾"}
{"id": null, "n": null, "target": null, "type": null, "text": "映"}
{"id": null, "n": null, "target": null, "type": null, "text": "紫陽"}
{"id": null, "n": null, "target": null, "type": null, "text": "初平"}
{"id": null, "n": null, "target": null, "type": null, "text": "隱"}
{"id": null, "n": null, "target": null, "type": null, "text": "傲"}
{"id": null, "n": null, "target": null, "type": null, "text": "華存"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐開元二十年。衡州司馬趙頤真撰。蕭誠書"}
{"id": null, "n": null, "target": null, "type": null, "text": "大觀二年三月。通直郎權潭州通判兼軍州事趙\n岍文并書立"}
{"id": null, "n": null, "target": null, "type": null, "text": "梁湘東王蕭緯撰"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐衡陽太守蘇務廉撰"}
{"id": null, "n": null, "target": null, "type": null, "text": "翰林承旨蕭鄴撰。太子少傅致仕盧璠書"}
{"id": null, "n": null, "target": null, "type": null, "text": "吏部侍郎趙櫓撰"}
{"id": null, "n": null, "target": null, "type": null, "text": "東坡居士蘇軾作記\n并書"}
{"id": null, "n": null, "target": null, "type": null, "text": "聖容即聖像也"}
{"id": null, "n": null, "target": null, "type": null, "text": "又詳見下卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "題後非久白日昇天"}
{"id": null, "n": null, "target": null, "type": null, "text": "今呼前洞者是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "觀對瀟湘門"}
{"id": null, "n": null, "target": null, "type": null, "text": "名犯廟諱"}
{"id": null, "n": null, "target": null, "type": null, "text": "堅白"}
{"id": null, "n": null, "target": null, "type": null, "text": "可作琴材"}
{"id": null, "n": null, "target": null, "type": null, "text": "宜充車甲"}
{"id": null, "n": null, "target": null, "type": null, "text": "春首開花鹽泡充果"}
{"id": null, "n": null, "target": null, "type": null, "text": "山果附"}
{"id": null, "n": null, "target": null, "type": null, "text": "翔集成群。羽毛五色朝陽聚鳴。音似張樂"}
{"id": null, "n": null, "target": null, "type": null, "text": "捕之大難"}
{"id": null, "n": null, "target": null, "type": null, "text": "羽毛錦色"}
{"id": null, "n": null, "target": null, "type": null, "text": "旦暮而鳴如猿啼"}
{"id": null, "n": null, "target": null, "type": null, "text": "隱逸附"}
{"id": null, "n": null, "target": null, "type": null, "text": "出傳奇"}
{"id": null, "n": null, "target": null, "type": null, "text": "此一段與本朝實錄甚異。今亦存之"}
{"id": null, "n": null, "target": null, "type": null, "text": "此一段與陳良卿事類辭殊。\n今兩存之。出洞微志"}
{"id": null, "n": null, "target": null, "type": null, "text": "此一段與張徽言意同辭異。今亦存之"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T51n2097_p1067b03"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "《南岳總勝集》（早稻田大學藏光緒32年刊本卷下第20b頁）"}
{"id": null, "n": "1055001", "target": "#nkr_note_orig_1055001", "type": "orig", "text": "【原】明嘉慶壬戌刊，內閣文庫藏本"}
{"id": null, "n": "1060a0901", "target": "#nkr_note_add_1060a0901", "type": "add", "text": "祛【CB】，袪【大】"}
{"id": null, "n": "1062a0501", "target": "#nkr_note_add_1062a0501", "type": "add", "text": "斂【CB】，歛【大】"}
{"id": null, "n": "1066c0301", "target": "#nkr_note_add_1066c0301", "type": "add", "text": "祛【CB】，袪【大】"}
