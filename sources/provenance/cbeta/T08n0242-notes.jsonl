{"id": null, "n": "0781001", "target": "#nkr_note_mod_0781001", "type": "mod", "text": "西【大】，宋西【明】"}
{"id": null, "n": "0781002", "target": "#nkr_note_mod_0781002", "type": "mod", "text": "譯經【大】，〔－〕【明】"}
{"id": null, "n": "0781003", "target": "#nkr_note_mod_0781003", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0782001", "target": "#nkr_note_mod_0782001", "type": "mod", "text": "場【大】，揚【宮】"}
{"id": null, "n": "0782003", "target": "#nkr_note_mod_0782003", "type": "mod", "text": "當【大】，常【宋】【宮】"}
{"id": null, "n": "0782005", "target": "#nkr_note_mod_0782005", "type": "mod", "text": "怛覽 Traṃ"}
{"id": null, "n": "0782006", "target": "#nkr_note_mod_0782006", "type": "mod", "text": "受【大】，諸【宋】【元】【明】【宮】"}
{"id": null, "n": "0782007", "target": "#nkr_note_mod_0782007", "type": "mod", "text": "得【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0782009", "target": "#nkr_note_mod_0782009", "type": "mod", "text": "若【大】＊，若入【元】【明】＊"}
{"id": null, "n": "0782010", "target": "#nkr_note_mod_0782010", "type": "mod", "text": "入【大】＊，〔－〕【元】【明】＊"}
{"id": null, "n": "0783002", "target": "#nkr_note_mod_0783002", "type": "mod", "text": "紇凌 Hrī."}
{"id": null, "n": "0783003", "target": "#nkr_note_mod_0783003", "type": "mod", "text": "毘焰 Bhyo."}
{"id": null, "n": "0783004", "target": "#nkr_note_mod_0783004", "type": "mod", "text": "𨩻【大】＊，鏓【明】＊，娑𨩻 Svāṃ."}
{"id": null, "n": "0783005", "target": "#nkr_note_mod_0783005", "type": "mod", "text": "一【大】，令【宋】【元】【明】"}
{"id": null, "n": "0783006", "target": "#nkr_note_mod_0783006", "type": "mod", "text": "羅【大】，囉【宋】【元】【明】"}
{"id": null, "n": "0783007", "target": "#nkr_note_mod_0783007", "type": "mod", "text": "囉【大】，羅【明】"}
{"id": null, "n": "0783008", "target": "#nkr_note_mod_0783008", "type": "mod", "text": "切【大】，引【宋】【元】【明】"}
{"id": null, "n": "0783009", "target": "#nkr_note_mod_0783009", "type": "mod", "text": "唵盎【大】，唵引盎【元】【明】"}
{"id": null, "n": "0783010", "target": "#nkr_note_mod_0783010", "type": "mod", "text": "縛【大】，嚩【宋】【元】【明】"}
{"id": null, "n": "0783011", "target": "#nkr_note_mod_0783011", "type": "mod", "text": "吒引音【大】，吒引音【宋】【元】【明】"}
{"id": null, "n": "0784001", "target": "#nkr_note_mod_0784001", "type": "mod", "text": "遍【大】，佛說遍【明】"}
{"id": null, "n": "0781001", "target": "#nkr_note_orig_0781001", "type": "orig", "text": "（宋）＋西【明】"}
{"id": null, "n": "0781002", "target": "#nkr_note_orig_0781002", "type": "orig", "text": "〔譯經〕－【明】"}
{"id": null, "n": "0781003", "target": "#nkr_note_orig_0781003", "type": "orig", "text": "〔臣〕－【明】"}
{"id": null, "n": "0782001", "target": "#nkr_note_orig_0782001", "type": "orig", "text": "場＝揚【宮】"}
{"id": null, "n": "0782002", "target": "#nkr_note_orig_0782002", "type": "orig", "text": "Aṃ."}
{"id": null, "n": "0782003", "target": "#nkr_note_orig_0782003", "type": "orig", "text": "當＝常【宋】【宮】"}
{"id": null, "n": "0782004", "target": "#nkr_note_orig_0782004", "type": "orig", "text": "Hūṃ."}
{"id": null, "n": "0782005", "target": "#nkr_note_orig_0782005", "type": "orig", "text": "怛覽, Traṃ"}
{"id": null, "n": "0782006", "target": "#nkr_note_orig_0782006", "type": "orig", "text": "受＝諸【三】【宮】"}
{"id": null, "n": "0782007", "target": "#nkr_note_orig_0782007", "type": "orig", "text": "〔得〕－【三】【宮】"}
{"id": null, "n": "0782008", "target": "#nkr_note_orig_0782008", "type": "orig", "text": "Aṃ."}
{"id": null, "n": "0782009", "target": "#nkr_note_orig_0782009", "type": "orig", "text": "若＋（入）【元】【明】＊"}
{"id": null, "n": "0782010", "target": "#nkr_note_orig_0782010", "type": "orig", "text": "〔入〕－【元】【明】＊"}
{"id": null, "n": "0782011", "target": "#nkr_note_orig_0782011", "type": "orig", "text": "Raṃ."}
{"id": null, "n": "0782012", "target": "#nkr_note_orig_0782012", "type": "orig", "text": "Oṃ"}
{"id": null, "n": "0783001", "target": "#nkr_note_orig_0783001", "type": "orig", "text": "Ha."}
{"id": null, "n": "0783002", "target": "#nkr_note_orig_0783002", "type": "orig", "text": "紇凌. Hrī."}
{"id": null, "n": "0783003", "target": "#nkr_note_orig_0783003", "type": "orig", "text": "毘焰, Bhyo."}
{"id": null, "n": "0783004", "target": "#nkr_note_orig_0783004", "type": "orig", "text": "娑𨩻＝娑鏓【明】＊，Svāṃ."}
{"id": null, "n": "0783005", "target": "#nkr_note_orig_0783005", "type": "orig", "text": "一＝令【三】"}
{"id": null, "n": "0783006", "target": "#nkr_note_orig_0783006", "type": "orig", "text": "羅＝囉【三】"}
{"id": null, "n": "0783007", "target": "#nkr_note_orig_0783007", "type": "orig", "text": "囉＝羅【明】"}
{"id": null, "n": "0783008", "target": "#nkr_note_orig_0783008", "type": "orig", "text": "切＝引【三】"}
{"id": null, "n": "0783009", "target": "#nkr_note_orig_0783009", "type": "orig", "text": "唵盎＝唵引盎【元】【明】"}
{"id": null, "n": "0783010", "target": "#nkr_note_orig_0783010", "type": "orig", "text": "縛＝嚩【三】"}
{"id": null, "n": "0783011", "target": "#nkr_note_orig_0783011", "type": "orig", "text": "吒引音＝吒引音【三】"}
{"id": null, "n": "0784001", "target": "#nkr_note_orig_0784001", "type": "orig", "text": "（佛說）＋徧【明】"}
