{"id": null, "n": "0024001", "target": "#nkr_note_orig_0024001", "type": "orig", "text": "迦多多疑多迦迦"}
{"id": null, "n": "0024002", "target": "#nkr_note_orig_0024002", "type": "orig", "text": "與疑興"}
{"id": null, "n": "0027001", "target": "#nkr_note_orig_0027001", "type": "orig", "text": "圖下別行本有形像二字．依別行本補入圖及王欽若序"}
{"id": null, "n": "0028001", "target": "#nkr_note_orig_0028001", "type": "orig", "text": "依別行本補入圓等十三行"}
{"id": null, "n": "0029001", "target": "#nkr_note_orig_0029001", "type": "orig", "text": "已下四行依別行本補入"}
