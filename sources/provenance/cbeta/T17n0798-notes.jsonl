{"id": null, "n": "0744006", "target": "#nkr_note_mod_0744006", "type": "mod", "text": "命【大】，念【宋】【元】【明】【宮】"}
{"id": null, "n": "0744007", "target": "#nkr_note_mod_0744007", "type": "mod", "text": "至【大】，天【宮】"}
{"id": null, "n": "0744008", "target": "#nkr_note_mod_0744008", "type": "mod", "text": "心【大】，必【宋】【元】【明】【宮】"}
