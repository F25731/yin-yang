{"id": null, "n": "0744003", "target": "#nkr_note_mod_0744003", "type": "mod", "text": "佛說【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0744004", "target": "#nkr_note_mod_0744004", "type": "mod", "text": "足【大】，之【宋】【元】【明】【宮】"}
