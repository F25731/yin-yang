{"id": null, "n": "0230003", "target": "#nkr_note_mod_0230003", "type": "mod", "text": "（特進…譯）二十二字【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0230004", "target": "#nkr_note_mod_0230004", "type": "mod", "text": "法【大】，諸法【甲】，佛法【乙】"}
{"id": null, "n": "0230005", "target": "#nkr_note_mod_0230005", "type": "mod", "text": "擁【大】，於空中擁【甲】【乙】"}
{"id": null, "n": "0230006", "target": "#nkr_note_mod_0230006", "type": "mod", "text": "左【大】，邊左【甲】【乙】"}
{"id": null, "n": "0230007", "target": "#nkr_note_mod_0230007", "type": "mod", "text": "音【大】，音樂【甲】【乙】"}
{"id": null, "n": "0230008", "target": "#nkr_note_mod_0230008", "type": "mod", "text": "音【大】，音樂【甲】"}
{"id": null, "n": "0230009", "target": "#nkr_note_mod_0230009", "type": "mod", "text": "誦【大】，供養我形像誦【甲】【乙】"}
{"id": null, "n": "0230010", "target": "#nkr_note_mod_0230010", "type": "mod", "text": "供養我形像【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0230011", "target": "#nkr_note_mod_0230011", "type": "mod", "text": "一【大】，於一【甲】【乙】"}
{"id": null, "n": "0230012", "target": "#nkr_note_mod_0230012", "type": "mod", "text": "於【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0230013", "target": "#nkr_note_mod_0230013", "type": "mod", "text": "汝之【大】，之汝【甲】【乙】"}
{"id": null, "n": "0230014", "target": "#nkr_note_mod_0230014", "type": "mod", "text": "汝【大】，〔－〕【甲】"}
{"id": null, "n": "0230015", "target": "#nkr_note_mod_0230015", "type": "mod", "text": "君【大】，群【乙】"}
{"id": null, "n": "0230016", "target": "#nkr_note_mod_0230016", "type": "mod", "text": "藥【大】，夜【乙】"}
{"id": null, "n": "0230017", "target": "#nkr_note_mod_0230017", "type": "mod", "text": "常【大】，當【乙】"}
{"id": null, "n": "0230018", "target": "#nkr_note_mod_0230018", "type": "mod", "text": "所【大】，何【甲】【乙】"}
{"id": null, "n": "0230019", "target": "#nkr_note_mod_0230019", "type": "mod", "text": "當【大】，富者當【乙】"}
{"id": null, "n": "0230020", "target": "#nkr_note_mod_0230020", "type": "mod", "text": "磔【大】＊，欐【甲】＊，榤【乙】＊"}
{"id": null, "n": "0230021", "target": "#nkr_note_mod_0230021", "type": "mod", "text": "箭【大】，炉箭【甲】【乙】"}
{"id": null, "n": "0230022", "target": "#nkr_note_mod_0230022", "type": "mod", "text": "上【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0230023", "target": "#nkr_note_mod_0230023", "type": "mod", "text": "口【大】，流【甲】"}
{"id": null, "n": "0230025", "target": "#nkr_note_mod_0230025", "type": "mod", "text": "里【大】，哩【乙】"}
{"id": null, "n": "0230026", "target": "#nkr_note_mod_0230026", "type": "mod", "text": "二合引【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0230027", "target": "#nkr_note_mod_0230027", "type": "mod", "text": "引【大】＊，〔－〕【甲】【乙】＊"}
{"id": null, "n": "0230028", "target": "#nkr_note_mod_0230028", "type": "mod", "text": "外【大】，〔－〕【乙】"}
{"id": null, "n": "0230029", "target": "#nkr_note_mod_0230029", "type": "mod", "text": "入【大】，出【甲】，〔－〕【乙】"}
{"id": null, "n": "0230030", "target": "#nkr_note_mod_0230030", "type": "mod", "text": "拄【大】，於【乙】"}
{"id": null, "n": "0230031", "target": "#nkr_note_mod_0230031", "type": "mod", "text": "肘【大】，〔－〕【乙】"}
{"id": null, "n": "0230032", "target": "#nkr_note_mod_0230032", "type": "mod", "text": "𤙖【大】＊，吽【甲】【乙】＊"}
{"id": null, "n": "0230033", "target": "#nkr_note_mod_0230033", "type": "mod", "text": "相【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0230034", "target": "#nkr_note_mod_0230034", "type": "mod", "text": "二合【大】＊，〔－〕【甲】【乙】＊"}
{"id": null, "n": "0230035", "target": "#nkr_note_mod_0230035", "type": "mod", "text": "泮【大】＊，發【乙】＊"}
{"id": null, "n": "0230036", "target": "#nkr_note_mod_0230036", "type": "mod", "text": "誦【大】，〔－〕【乙】"}
{"id": null, "n": "0231001", "target": "#nkr_note_mod_0231001", "type": "mod", "text": "即【大】，節【甲】【乙】"}
{"id": null, "n": "0231002", "target": "#nkr_note_mod_0231002", "type": "mod", "text": "指【大】，〔－〕【乙】"}
{"id": null, "n": "0231003", "target": "#nkr_note_mod_0231003", "type": "mod", "text": "二合囉【大】，囉二合【乙】"}
{"id": null, "n": "0231004", "target": "#nkr_note_mod_0231004", "type": "mod", "text": "真言加持【大】，加持真言【甲】【乙】"}
{"id": null, "n": "0231005", "target": "#nkr_note_mod_0231005", "type": "mod", "text": "規【大】，規郭【甲】【乙】"}
{"id": null, "n": "0231006", "target": "#nkr_note_mod_0231006", "type": "mod", "text": "華【大】，華香【甲】【乙】"}
{"id": null, "n": "0231007", "target": "#nkr_note_mod_0231007", "type": "mod", "text": "又【大】，作【甲】【乙】"}
{"id": null, "n": "0231008", "target": "#nkr_note_mod_0231008", "type": "mod", "text": "罐【大】，灌【甲】【乙】"}
{"id": null, "n": "0231009", "target": "#nkr_note_mod_0231009", "type": "mod", "text": "秫粳【大】，秫【甲】【乙】，粳【校異-甲】"}
{"id": null, "n": "0231010", "target": "#nkr_note_mod_0231010", "type": "mod", "text": "佛【大】，諸佛【乙】"}
{"id": null, "n": "0231011", "target": "#nkr_note_mod_0231011", "type": "mod", "text": "口【大】，召【乙】"}
{"id": null, "n": "0231013", "target": "#nkr_note_mod_0231013", "type": "mod", "text": "賀【大】，迦【乙】"}
{"id": null, "n": "0231014", "target": "#nkr_note_mod_0231014", "type": "mod", "text": "處【大】，家【甲】，室【乙】"}
{"id": null, "n": "0231016", "target": "#nkr_note_mod_0231016", "type": "mod", "text": "謨【大】，莫【乙】"}
{"id": null, "n": "0231017", "target": "#nkr_note_mod_0231017", "type": "mod", "text": "羅【大】，跛羅【乙】"}
{"id": null, "n": "0231018", "target": "#nkr_note_mod_0231018", "type": "mod", "text": "惹【大】，悉【乙】"}
{"id": null, "n": "0231019", "target": "#nkr_note_mod_0231019", "type": "mod", "text": "印【大】，〔－〕【乙】"}
{"id": null, "n": "0231020", "target": "#nkr_note_mod_0231020", "type": "mod", "text": "上【大】，中【甲】【乙】"}
{"id": null, "n": "0231021", "target": "#nkr_note_mod_0231021", "type": "mod", "text": "賀【大】＊，賀引【甲】【乙】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0231022", "target": "#nkr_note_mod_0231022", "type": "mod", "text": "去【大】，其【乙】"}
{"id": null, "n": "0231023", "target": "#nkr_note_mod_0231023", "type": "mod", "text": "四天【大】，次四天【甲】，次四大天【乙】"}
{"id": null, "n": "0231024", "target": "#nkr_note_mod_0231024", "type": "mod", "text": "中【大】，〔－〕【乙】"}
{"id": null, "n": "0231025", "target": "#nkr_note_mod_0231025", "type": "mod", "text": "婆【大】，度【考偽-原】"}
{"id": null, "n": "0231026", "target": "#nkr_note_mod_0231026", "type": "mod", "text": "惡魔【大】，惡【甲】【乙】，鬼魔【校異-原】"}
{"id": null, "n": "0231027", "target": "#nkr_note_mod_0231027", "type": "mod", "text": "遠散【大】，散遠【甲】【乙】"}
{"id": null, "n": "0231028", "target": "#nkr_note_mod_0231028", "type": "mod", "text": "結【大】，〔－〕【乙】"}
{"id": null, "n": "0231029", "target": "#nkr_note_mod_0231029", "type": "mod", "text": "諸【大】，者【甲】【乙】"}
{"id": null, "n": "0231030", "target": "#nkr_note_mod_0231030", "type": "mod", "text": "降臨【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0232001", "target": "#nkr_note_mod_0232001", "type": "mod", "text": "皆【大】，者【甲】【乙】"}
{"id": null, "n": "0232002", "target": "#nkr_note_mod_0232002", "type": "mod", "text": "處【大】，身【考偽-原】"}
{"id": null, "n": "0232003", "target": "#nkr_note_mod_0232003", "type": "mod", "text": "謨【大】，謨引【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0232004", "target": "#nkr_note_mod_0232004", "type": "mod", "text": "囉惹引【大】，囉引惹【甲】【乙】"}
{"id": null, "n": "0232005", "target": "#nkr_note_mod_0232005", "type": "mod", "text": "波【大】，婆【甲】【乙】"}
{"id": null, "n": "0232006", "target": "#nkr_note_mod_0232006", "type": "mod", "text": "那【大】，娜【甲】【乙】"}
{"id": null, "n": "0232007", "target": "#nkr_note_mod_0232007", "type": "mod", "text": "十二【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0232008", "target": "#nkr_note_mod_0232008", "type": "mod", "text": "弭【大】，弭十二【甲】【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "十二"}
{"id": null, "n": "0232009", "target": "#nkr_note_mod_0232009", "type": "mod", "text": "薩嚩二合引賀引十八【大】，莎可【甲】，薩嚩賀【乙】"}
{"id": null, "n": "0232010", "target": "#nkr_note_mod_0232010", "type": "mod", "text": "被中【大】，備【甲】【乙】"}
{"id": null, "n": "0232011", "target": "#nkr_note_mod_0232011", "type": "mod", "text": "伏【大】，伏一切【乙】"}
{"id": null, "n": "0232012", "target": "#nkr_note_mod_0232012", "type": "mod", "text": "三十萬遍【大】，〔－〕【乙】"}
{"id": null, "n": "0232014", "target": "#nkr_note_mod_0232014", "type": "mod", "text": "身【大】，心【甲】【乙】，己【校異-乙】"}
{"id": null, "n": "0232015", "target": "#nkr_note_mod_0232015", "type": "mod", "text": "意【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0232016", "target": "#nkr_note_mod_0232016", "type": "mod", "text": "金【大】，現金【甲】【乙】"}
{"id": null, "n": "0232017", "target": "#nkr_note_mod_0232017", "type": "mod", "text": "自【大】，身【甲】【乙】"}
{"id": null, "n": "0232018", "target": "#nkr_note_mod_0232018", "type": "mod", "text": "我【大】，或【甲】【乙】"}
{"id": null, "n": "0232019", "target": "#nkr_note_mod_0232019", "type": "mod", "text": "遠山【大】，他山遠【甲】【乙】"}
{"id": null, "n": "0232020", "target": "#nkr_note_mod_0232020", "type": "mod", "text": "願【大】，願力【甲】【乙】"}
{"id": null, "n": "0232021", "target": "#nkr_note_mod_0232021", "type": "mod", "text": "被【大】，備【甲】【乙】"}
{"id": null, "n": "0232022", "target": "#nkr_note_mod_0232022", "type": "mod", "text": "多【大】，哆【甲】【乙】"}
{"id": null, "n": "0232023", "target": "#nkr_note_mod_0232023", "type": "mod", "text": "藥【大】，藥乞叉【乙】"}
{"id": null, "n": "0232024", "target": "#nkr_note_mod_0232024", "type": "mod", "text": "拏【大】，怛【甲】【乙】"}
{"id": null, "n": "0232025", "target": "#nkr_note_mod_0232025", "type": "mod", "text": "吒【大】，他【乙】"}
{"id": null, "n": "0232026", "target": "#nkr_note_mod_0232026", "type": "mod", "text": "南【大】，南怛儞也他【甲】【乙】"}
{"id": null, "n": "0232027", "target": "#nkr_note_mod_0232027", "type": "mod", "text": "跋捺【大】＊，縛駄【甲】【乙】＊"}
{"id": null, "n": "0232028", "target": "#nkr_note_mod_0232028", "type": "mod", "text": "娑【大】＊，薩【甲】【乙】＊"}
{"id": null, "n": "0232029", "target": "#nkr_note_mod_0232029", "type": "mod", "text": "詑【大】，託【甲】【乙】"}
{"id": null, "n": "0232030", "target": "#nkr_note_mod_0232030", "type": "mod", "text": "室【大】，失【乙】"}
{"id": null, "n": "0232031", "target": "#nkr_note_mod_0232031", "type": "mod", "text": "上【大】，上聲【甲】【乙】"}
{"id": null, "n": "0232033", "target": "#nkr_note_mod_0232033", "type": "mod", "text": "端正男女【大】，男女端政【甲】【乙】"}
{"id": null, "n": "0232034", "target": "#nkr_note_mod_0232034", "type": "mod", "text": "為【大】，替【甲】【乙】"}
{"id": null, "n": "0232035", "target": "#nkr_note_mod_0232035", "type": "mod", "text": "我【大】，〔－〕【甲】"}
{"id": null, "n": "0232036", "target": "#nkr_note_mod_0232036", "type": "mod", "text": "皆【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0232037", "target": "#nkr_note_mod_0232037", "type": "mod", "text": "者【大】，〔－〕【乙】"}
{"id": null, "n": "0232038", "target": "#nkr_note_mod_0232038", "type": "mod", "text": "草【大】，草花【甲】【乙】"}
{"id": null, "n": "0232039", "target": "#nkr_note_mod_0232039", "type": "mod", "text": "酪等粥【大】，粥等酪【甲】【乙】"}
{"id": null, "n": "0232040", "target": "#nkr_note_mod_0232040", "type": "mod", "text": "唄【大】，讚【甲】【乙】"}
{"id": null, "n": "0233001", "target": "#nkr_note_mod_0233001", "type": "mod", "text": "一日十五日【大】，十五日月一日【甲】【乙】"}
{"id": null, "n": "0233002", "target": "#nkr_note_mod_0233002", "type": "mod", "text": "示現身【大】，現身示現【甲】【乙】"}
{"id": null, "n": "0233003", "target": "#nkr_note_mod_0233003", "type": "mod", "text": "去【大】，行【乙】"}
{"id": null, "n": "0233004", "target": "#nkr_note_mod_0233004", "type": "mod", "text": "惡【大】，怨【考偽-原】"}
{"id": null, "n": "0233005", "target": "#nkr_note_mod_0233005", "type": "mod", "text": "自顛自滅【大】，自滅自顛【甲】【乙】"}
{"id": null, "n": "0233006", "target": "#nkr_note_mod_0233006", "type": "mod", "text": "香用【大】，用香【甲】【乙】"}
{"id": null, "n": "0233007", "target": "#nkr_note_mod_0233007", "type": "mod", "text": "白【大】，〔－〕【乙】"}
{"id": null, "n": "0233008", "target": "#nkr_note_mod_0233008", "type": "mod", "text": "琉璃合子【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0233009", "target": "#nkr_note_mod_0233009", "type": "mod", "text": "盛和合香【大】，和合香度【甲】【乙】"}
{"id": null, "n": "0233010", "target": "#nkr_note_mod_0233010", "type": "mod", "text": "（北方…儀軌）二十字【大】，北方多聞天王別行儀軌【甲】，多聞天王別行儀軌【乙】"}
{"id": null, "n": "0230002", "target": "#nkr_note_orig_0230002", "type": "orig", "text": "【原】大日本續藏經，【甲】平安時代寫仁和寺藏本，【乙】延久六年寫本"}
{"id": null, "n": "0230003", "target": "#nkr_note_orig_0230003", "type": "orig", "text": "〔特進…譯〕二十二字－【甲】【乙】"}
{"id": null, "n": "0230004", "target": "#nkr_note_orig_0230004", "type": "orig", "text": "法＝諸法【甲】，佛法【乙】"}
{"id": null, "n": "0230005", "target": "#nkr_note_orig_0230005", "type": "orig", "text": "（於空中）＋擁【甲】【乙】"}
