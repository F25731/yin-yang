{"id": null, "n": "0059001", "target": "#nkr_note_orig_0059001", "type": "orig", "text": "「忍心如幻夢，嗔境若龜毛。常能作此觀，逢」，底本殘，據伯2039號背補。"}
{"id": null, "n": "0059002", "target": "#nkr_note_orig_0059002", "type": "orig", "text": "「非亦無是，無下亦無高。若滅貪嗔賊，須行智惠刀」，底本殘，據伯2039號背補。"}
{"id": null, "n": "0059003", "target": "#nkr_note_orig_0059003", "type": "orig", "text": "「二智心中遣，三空境上祛。無明念念滅，隨眠漸漸除。觀心」，底本殘，據伯2039號背補。"}
{"id": null, "n": "0059004", "target": "#nkr_note_orig_0059004", "type": "orig", "text": "「河」，底本作「何」，據伯2039號背改。"}
{"id": null, "n": "0059005", "target": "#nkr_note_orig_0059005", "type": "orig", "text": "「隨浪淨，定水逐波清。澄神生覺性，志慮滅迷」，底本殘，據伯2039號背補。"}
{"id": null, "n": "0059006", "target": "#nkr_note_orig_0059006", "type": "orig", "text": "「名」，底本無，據伯2039號背補。"}
{"id": null, "n": "0059007", "target": "#nkr_note_orig_0059007", "type": "orig", "text": "「他起，無別有圓成」，底本殘，據伯2039號背補。"}
{"id": null, "n": "0060001", "target": "#nkr_note_orig_0060001", "type": "orig", "text": "「惠燈如朗日，蘊界若乾」，底本殘，據石本補。"}
{"id": null, "n": "0060002", "target": "#nkr_note_orig_0060002", "type": "orig", "text": "「便」，底本作「更」，據伯2039號背改。"}
{"id": null, "n": "0060003", "target": "#nkr_note_orig_0060003", "type": "orig", "text": "「猶未滅，仍見我人形。妙」，底本殘，據伯2039號背補。"}
{"id": null, "n": "0060004", "target": "#nkr_note_orig_0060004", "type": "orig", "text": "「一虛名」，底本殘，據伯2039號背補。"}
{"id": null, "n": "0060005", "target": "#nkr_note_orig_0060005", "type": "orig", "text": "「聲色勿相干。二邊純」，底本殘，據伯2039號背補。"}
{"id": null, "n": "0060006", "target": "#nkr_note_orig_0060006", "type": "orig", "text": "「安。欲覓」，底本殘，據伯2039號背補。"}
{"id": null, "n": "0060007", "target": "#nkr_note_orig_0060007", "type": "orig", "text": "「不相忘」，底本作「勿承堅」，據伯2039號背改。"}
{"id": null, "n": "0061001", "target": "#nkr_note_orig_0061001", "type": "orig", "text": "「非」，底本作「悲」，據伯2039號背改。"}
{"id": null, "n": "0061002", "target": "#nkr_note_orig_0061002", "type": "orig", "text": "「密」，底本作「蜜」，據石本改。"}
{"id": null, "n": "0061003", "target": "#nkr_note_orig_0061003", "type": "orig", "text": "「聞」，底本作「文」，據石本改。"}
{"id": null, "n": "0061004", "target": "#nkr_note_orig_0061004", "type": "orig", "text": "「大」，底本作「僧」，據石本改。"}
{"id": null, "n": "0061005", "target": "#nkr_note_orig_0061005", "type": "orig", "text": "「礙」，底本作「尋」，據伯2039號背改。"}
{"id": null, "n": "0062001", "target": "#nkr_note_orig_0062001", "type": "orig", "text": "「渡」，底本作「濟」，據伯2039號背改。"}
{"id": null, "n": "0062002", "target": "#nkr_note_orig_0062002", "type": "orig", "text": "「執」，底本作「報」，據伯2039號背改。"}
{"id": null, "n": "0063001", "target": "#nkr_note_orig_0063001", "type": "orig", "text": "「因」，底本作「猶」，據伯2039號背改。"}
{"id": null, "n": "0064001", "target": "#nkr_note_orig_0064001", "type": "orig", "text": "「相」，底本作「果」，據伯2039號背改。"}
{"id": null, "n": "0064002", "target": "#nkr_note_orig_0064002", "type": "orig", "text": "「感」，底本作「阿」，據伯2039號背改。"}
{"id": null, "n": "0064003", "target": "#nkr_note_orig_0064003", "type": "orig", "text": "「如」，底本作「智」，據伯2039號背改。"}
{"id": null, "n": "0065001", "target": "#nkr_note_orig_0065001", "type": "orig", "text": "「獼」，底本作「彌」，據文意改。"}
{"id": null, "n": "0065002", "target": "#nkr_note_orig_0065002", "type": "orig", "text": "「愛」，底本作「受」，據伯2039號背改。"}
{"id": null, "n": "0065003", "target": "#nkr_note_orig_0065003", "type": "orig", "text": "「境亡」，底本作「謗心」，據伯2039號背改。"}
{"id": null, "n": "0065004", "target": "#nkr_note_orig_0065004", "type": "orig", "text": "「妙理」，底本作「理妙」，據伯2039號背改。"}
{"id": null, "n": "0066001", "target": "#nkr_note_orig_0066001", "type": "orig", "text": "「第」，底本作「希」，據文意改。"}
{"id": null, "n": "0067001", "target": "#nkr_note_orig_0067001", "type": "orig", "text": "「如能發心者……唯當識本源」贊與「第十二住處」的相比，只相差兩句，其餘基本相同，似抄寫之衍。"}
{"id": null, "n": "0067002", "target": "#nkr_note_orig_0067002", "type": "orig", "text": "「色」，底本作「至」，據文意改。"}
{"id": null, "n": "0067003", "target": "#nkr_note_orig_0067003", "type": "orig", "text": "「布」，底本作「希」，據文意改。"}
{"id": null, "n": "0067004", "target": "#nkr_note_orig_0067004", "type": "orig", "text": "「何」，底本作「阿」，據伯2039號背改。"}
{"id": null, "n": "0068001", "target": "#nkr_note_orig_0068001", "type": "orig", "text": "「癒」，底本作「逾」，據文意改。"}
{"id": null, "n": "0068002", "target": "#nkr_note_orig_0068002", "type": "orig", "text": "「我執」，底本作「無我」，據伯2039號背改。"}
{"id": null, "n": "0068003", "target": "#nkr_note_orig_0068003", "type": "orig", "text": "「悲」，底本無，據伯2039號背補。"}
{"id": null, "n": "0068004", "target": "#nkr_note_orig_0068004", "type": "orig", "text": "「大」，底本無，據伯2039號背補。"}
{"id": null, "n": "0068005", "target": "#nkr_note_orig_0068005", "type": "orig", "text": "「用智智」，底本無，據伯2039號背補。"}
{"id": null, "n": "0069001", "target": "#nkr_note_orig_0069001", "type": "orig", "text": "「坦」，底本作「怛」，據石本改。"}
