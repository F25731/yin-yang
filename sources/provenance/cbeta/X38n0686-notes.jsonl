{"id": null, "n": "0417002", "target": "#nkr_note_orig_0417002", "type": "orig", "text": "𣩦恐殑"}
{"id": null, "n": "0417003", "target": "#nkr_note_orig_0417003", "type": "orig", "text": "但恐佉字"}
{"id": null, "n": "0417004", "target": "#nkr_note_orig_0417004", "type": "orig", "text": "興下恐脫渠字"}
{"id": null, "n": "0417005", "target": "#nkr_note_orig_0417005", "type": "orig", "text": "𮏧恐臺字"}
{"id": null, "n": "0417006", "target": "#nkr_note_orig_0417006", "type": "orig", "text": "與恐興"}
{"id": null, "n": "0417007", "target": "#nkr_note_orig_0417007", "type": "orig", "text": "第下恐脫一字"}
{"id": null, "n": "0417008", "target": "#nkr_note_orig_0417008", "type": "orig", "text": "異恐必"}
{"id": null, "n": "0417009", "target": "#nkr_note_orig_0417009", "type": "orig", "text": "名是疑寫倒"}
{"id": null, "n": "0417010", "target": "#nkr_note_orig_0417010", "type": "orig", "text": "此下論有中字"}
{"id": null, "n": "0417011", "target": "#nkr_note_orig_0417011", "type": "orig", "text": "戒作或"}
{"id": null, "n": "0417012", "target": "#nkr_note_orig_0417012", "type": "orig", "text": "蒭下論有律儀二字"}
{"id": null, "n": "0417013", "target": "#nkr_note_orig_0417013", "type": "orig", "text": "說上論有善字"}
{"id": null, "n": "0417014", "target": "#nkr_note_orig_0417014", "type": "orig", "text": "緣論作勝"}
{"id": null, "n": "0417015", "target": "#nkr_note_orig_0417015", "type": "orig", "text": "近下恐脫住字"}
{"id": null, "n": "0418001", "target": "#nkr_note_orig_0418001", "type": "orig", "text": "妄論作妾妻"}
{"id": null, "n": "0418002", "target": "#nkr_note_orig_0418002", "type": "orig", "text": "三恐二"}
{"id": null, "n": "0418003", "target": "#nkr_note_orig_0418003", "type": "orig", "text": "畢竟論作暴惡"}
{"id": null, "n": "0418004", "target": "#nkr_note_orig_0418004", "type": "orig", "text": "後應下恐有寫誤"}
{"id": null, "n": "0418005", "target": "#nkr_note_orig_0418005", "type": "orig", "text": "通義恐義通"}
{"id": null, "n": "0418006", "target": "#nkr_note_orig_0418006", "type": "orig", "text": "菩薩恐煩惱"}
{"id": null, "n": "0418007", "target": "#nkr_note_orig_0418007", "type": "orig", "text": "第三下未詳"}
{"id": null, "n": "0419001", "target": "#nkr_note_orig_0419001", "type": "orig", "text": "毗恐訛"}
{"id": null, "n": "0419002", "target": "#nkr_note_orig_0419002", "type": "orig", "text": "更論作虛"}
{"id": null, "n": "0419003", "target": "#nkr_note_orig_0419003", "type": "orig", "text": "懷疑壞"}
{"id": null, "n": "0419004", "target": "#nkr_note_orig_0419004", "type": "orig", "text": "越下恐脫是染違犯四字"}
{"id": null, "n": "0419005", "target": "#nkr_note_orig_0419005", "type": "orig", "text": "聞論作間"}
{"id": null, "n": "0420001", "target": "#nkr_note_orig_0420001", "type": "orig", "text": "引字恐寫誤"}
{"id": null, "n": "0420002", "target": "#nkr_note_orig_0420002", "type": "orig", "text": "論無聞字"}
{"id": null, "n": "0420003", "target": "#nkr_note_orig_0420003", "type": "orig", "text": "時上有久字"}
{"id": null, "n": "0420004", "target": "#nkr_note_orig_0420004", "type": "orig", "text": "即離下恐有寫誤"}
{"id": null, "n": "0421001", "target": "#nkr_note_orig_0421001", "type": "orig", "text": "耶經作也"}
{"id": null, "n": "0421002", "target": "#nkr_note_orig_0421002", "type": "orig", "text": "所論作其慧鈍"}
{"id": null, "n": "0421003", "target": "#nkr_note_orig_0421003", "type": "orig", "text": "論無無字"}
{"id": null, "n": "0421004", "target": "#nkr_note_orig_0421004", "type": "orig", "text": "他作餘"}
{"id": null, "n": "0421005", "target": "#nkr_note_orig_0421005", "type": "orig", "text": "羅下經有罥字"}
{"id": null, "n": "0421006", "target": "#nkr_note_orig_0421006", "type": "orig", "text": "開經作明"}
{"id": null, "n": "0421007", "target": "#nkr_note_orig_0421007", "type": "orig", "text": "杖經作材"}
{"id": null, "n": "0422001", "target": "#nkr_note_orig_0422001", "type": "orig", "text": "若欲下文亂當作若欲方便調彼伏彼廣說如前或為令其未淨信者發生淨信巳淨信者轉復增長法師師僧國王父母皆是有恩毀壞有恩故得罪也"}
{"id": null, "n": "0422002", "target": "#nkr_note_orig_0422002", "type": "orig", "text": "者下恐脫六親釋"}
{"id": null, "n": "0422003", "target": "#nkr_note_orig_0422003", "type": "orig", "text": "有上恐脫為字"}
{"id": null, "n": "0422004", "target": "#nkr_note_orig_0422004", "type": "orig", "text": "陰經作險下皆同"}
{"id": null, "n": "0422005", "target": "#nkr_note_orig_0422005", "type": "orig", "text": "故下脫第十釋"}
{"id": null, "n": "0423001", "target": "#nkr_note_orig_0423001", "type": "orig", "text": "提論作薩"}
{"id": null, "n": "0423002", "target": "#nkr_note_orig_0423002", "type": "orig", "text": "言十心等此下記主所釋經與現流經有異讀者可知定上恐脫不字"}
{"id": null, "n": "0424001", "target": "#nkr_note_orig_0424001", "type": "orig", "text": "初字恐誤"}
{"id": null, "n": "0424002", "target": "#nkr_note_orig_0424002", "type": "orig", "text": "有誤恐自誑"}
{"id": null, "n": "0424003", "target": "#nkr_note_orig_0424003", "type": "orig", "text": "離字疑剩"}
{"id": null, "n": "0425001", "target": "#nkr_note_orig_0425001", "type": "orig", "text": "怒論作恕"}
{"id": null, "n": "0425002", "target": "#nkr_note_orig_0425002", "type": "orig", "text": "進論作唯"}
{"id": null, "n": "0425003", "target": "#nkr_note_orig_0425003", "type": "orig", "text": "郡論作羣"}
{"id": null, "n": "0425004", "target": "#nkr_note_orig_0425004", "type": "orig", "text": "恩論作惠"}
{"id": null, "n": "0425005", "target": "#nkr_note_orig_0425005", "type": "orig", "text": "經無見字"}
{"id": null, "n": "0425006", "target": "#nkr_note_orig_0425006", "type": "orig", "text": "論無欲字"}
{"id": null, "n": "0425007", "target": "#nkr_note_orig_0425007", "type": "orig", "text": "多論作而"}
{"id": null, "n": "0426001", "target": "#nkr_note_orig_0426001", "type": "orig", "text": "插入尾題并次首題"}
{"id": null, "n": "0426002", "target": "#nkr_note_orig_0426002", "type": "orig", "text": "十戒恐當云十一戒"}
{"id": null, "n": "0426003", "target": "#nkr_note_orig_0426003", "type": "orig", "text": "報下恐脫故字"}
{"id": null, "n": "0426004", "target": "#nkr_note_orig_0426004", "type": "orig", "text": "眾字疑剩"}
{"id": null, "n": "0426005", "target": "#nkr_note_orig_0426005", "type": "orig", "text": "次恐以"}
{"id": null, "n": "0426006", "target": "#nkr_note_orig_0426006", "type": "orig", "text": "悲恐非"}
{"id": null, "n": "0426007", "target": "#nkr_note_orig_0426007", "type": "orig", "text": "二恐一"}
{"id": null, "n": "0426008", "target": "#nkr_note_orig_0426008", "type": "orig", "text": "若出牒文與經有異"}
{"id": null, "n": "0426009", "target": "#nkr_note_orig_0426009", "type": "orig", "text": "智恐知"}
{"id": null, "n": "0427001", "target": "#nkr_note_orig_0427001", "type": "orig", "text": "應云音義作正言此下與音義文有異"}
{"id": null, "n": "0427002", "target": "#nkr_note_orig_0427002", "type": "orig", "text": "又恐刃"}
{"id": null, "n": "0427003", "target": "#nkr_note_orig_0427003", "type": "orig", "text": "到恐致"}
{"id": null, "n": "0427004", "target": "#nkr_note_orig_0427004", "type": "orig", "text": "身恐自"}
{"id": null, "n": "0427005", "target": "#nkr_note_orig_0427005", "type": "orig", "text": "瞋恐衍"}
{"id": null, "n": "0427006", "target": "#nkr_note_orig_0427006", "type": "orig", "text": "經下恐脫若字"}
{"id": null, "n": "0427007", "target": "#nkr_note_orig_0427007", "type": "orig", "text": "智恐知"}
{"id": null, "n": "0427008", "target": "#nkr_note_orig_0427008", "type": "orig", "text": "此下坐禪及教化釋雜亂"}
{"id": null, "n": "0427009", "target": "#nkr_note_orig_0427009", "type": "orig", "text": "對當恐倒"}
{"id": null, "n": "0427010", "target": "#nkr_note_orig_0427010", "type": "orig", "text": "三下恐脫中字"}
{"id": null, "n": "0428001", "target": "#nkr_note_orig_0428001", "type": "orig", "text": "浂用下未詳"}
{"id": null, "n": "0428002", "target": "#nkr_note_orig_0428002", "type": "orig", "text": "罪上恐脫結字"}
{"id": null, "n": "0428003", "target": "#nkr_note_orig_0428003", "type": "orig", "text": "次下恐脫第字"}
{"id": null, "n": "0428004", "target": "#nkr_note_orig_0428004", "type": "orig", "text": "一者下恐有寫誤"}
{"id": null, "n": "0428005", "target": "#nkr_note_orig_0428005", "type": "orig", "text": "如疑及"}
{"id": null, "n": "0428006", "target": "#nkr_note_orig_0428006", "type": "orig", "text": "幸恐事"}
{"id": null, "n": "0428007", "target": "#nkr_note_orig_0428007", "type": "orig", "text": "人恐入"}
{"id": null, "n": "0428008", "target": "#nkr_note_orig_0428008", "type": "orig", "text": "𮛕恐疏"}
{"id": null, "n": "0428009", "target": "#nkr_note_orig_0428009", "type": "orig", "text": "兩釋巳下恐有寫誤"}
{"id": null, "n": "0428010", "target": "#nkr_note_orig_0428010", "type": "orig", "text": "問巳下恐有寫誤"}
{"id": null, "n": "0428011", "target": "#nkr_note_orig_0428011", "type": "orig", "text": "外上恐脫與界二字"}
{"id": null, "n": "0428012", "target": "#nkr_note_orig_0428012", "type": "orig", "text": "問巳下恐有脫文"}
{"id": null, "n": "0428013", "target": "#nkr_note_orig_0428013", "type": "orig", "text": "癩論作疾"}
{"id": null, "n": "0429001", "target": "#nkr_note_orig_0429001", "type": "orig", "text": "佛下恐有脫字"}
{"id": null, "n": "0429002", "target": "#nkr_note_orig_0429002", "type": "orig", "text": "智論與現本文有異"}
{"id": null, "n": "0430001", "target": "#nkr_note_orig_0430001", "type": "orig", "text": "家字疑剩"}
{"id": null, "n": "0430002", "target": "#nkr_note_orig_0430002", "type": "orig", "text": "五下恐脫月三二字"}
{"id": null, "n": "0430003", "target": "#nkr_note_orig_0430003", "type": "orig", "text": "說字疑剩"}
{"id": null, "n": "0430004", "target": "#nkr_note_orig_0430004", "type": "orig", "text": "明字當在六戒下"}
{"id": null, "n": "0430005", "target": "#nkr_note_orig_0430005", "type": "orig", "text": "應下恐脫行字"}
{"id": null, "n": "0430006", "target": "#nkr_note_orig_0430006", "type": "orig", "text": "并恐𦬇寫誤"}
{"id": null, "n": "0431001", "target": "#nkr_note_orig_0431001", "type": "orig", "text": "莖恐筮"}
{"id": null, "n": "0431002", "target": "#nkr_note_orig_0431002", "type": "orig", "text": "成上恐脫行字當作行城爪鏡"}
{"id": null, "n": "0431003", "target": "#nkr_note_orig_0431003", "type": "orig", "text": "鏡下恐有脫文"}
{"id": null, "n": "0431004A", "target": "#nkr_note_orig_0431004A", "type": "orig", "text": "發字疑剩好得恐倒"}
{"id": null, "n": "0431004B", "target": "#nkr_note_orig_0431004B", "type": "orig", "text": "發字疑剩好得恐倒"}
{"id": null, "n": "0431005", "target": "#nkr_note_orig_0431005", "type": "orig", "text": "戒恐我"}
{"id": null, "n": "0432001", "target": "#nkr_note_orig_0432001", "type": "orig", "text": "心字疑剩"}
{"id": null, "n": "0432002", "target": "#nkr_note_orig_0432002", "type": "orig", "text": "遇疑過"}
{"id": null, "n": "0432003", "target": "#nkr_note_orig_0432003", "type": "orig", "text": "十里經作二十五里"}
{"id": null, "n": "0432004", "target": "#nkr_note_orig_0432004", "type": "orig", "text": "逕於作經由"}
{"id": null, "n": "0432005", "target": "#nkr_note_orig_0432005", "type": "orig", "text": "逕作經"}
{"id": null, "n": "0432006", "target": "#nkr_note_orig_0432006", "type": "orig", "text": "所作邪"}
{"id": null, "n": "0432007", "target": "#nkr_note_orig_0432007", "type": "orig", "text": "戒行等恐有寫誤"}
{"id": null, "n": "0432008", "target": "#nkr_note_orig_0432008", "type": "orig", "text": "蔘經作澡"}
{"id": null, "n": "0432009", "target": "#nkr_note_orig_0432009", "type": "orig", "text": "此下音義有一字"}
{"id": null, "n": "0432010", "target": "#nkr_note_orig_0432010", "type": "orig", "text": "分字作多則二字"}
{"id": null, "n": "0432011", "target": "#nkr_note_orig_0432011", "type": "orig", "text": "成下有若聖辨部大眾部等則割截之若不割者直案帖角及以鈎紐而巳二十六字"}
{"id": null, "n": "0432012", "target": "#nkr_note_orig_0432012", "type": "orig", "text": "優作漚"}
{"id": null, "n": "0433001", "target": "#nkr_note_orig_0433001", "type": "orig", "text": "宿上音義有中字"}
{"id": null, "n": "0433002", "target": "#nkr_note_orig_0433002", "type": "orig", "text": "近下有身住也三"}
{"id": null, "n": "0433003", "target": "#nkr_note_orig_0433003", "type": "orig", "text": "辛作草"}
{"id": null, "n": "0433004", "target": "#nkr_note_orig_0433004", "type": "orig", "text": "本上音義有梵字"}
{"id": null, "n": "0433005", "target": "#nkr_note_orig_0433005", "type": "orig", "text": "義下音義有云字"}
{"id": null, "n": "0433006", "target": "#nkr_note_orig_0433006", "type": "orig", "text": "黑上音義有青字"}
{"id": null, "n": "0433007", "target": "#nkr_note_orig_0433007", "type": "orig", "text": "眾下恐有脫文"}
{"id": null, "n": "0434001", "target": "#nkr_note_orig_0434001", "type": "orig", "text": "云恐亡"}
{"id": null, "n": "0434002", "target": "#nkr_note_orig_0434002", "type": "orig", "text": "持經作治"}
{"id": null, "n": "0434003", "target": "#nkr_note_orig_0434003", "type": "orig", "text": "勝將可疑恐是種字"}
{"id": null, "n": "0434004", "target": "#nkr_note_orig_0434004", "type": "orig", "text": "諸上恐脫欲界二字"}
{"id": null, "n": "0434005", "target": "#nkr_note_orig_0434005", "type": "orig", "text": "此下似記主經與現流經不同"}
{"id": null, "n": "0435001", "target": "#nkr_note_orig_0435001", "type": "orig", "text": "落疑語"}
{"id": null, "n": "0435002", "target": "#nkr_note_orig_0435002", "type": "orig", "text": "客疑容"}
{"id": null, "n": "0435003", "target": "#nkr_note_orig_0435003", "type": "orig", "text": "堪上恐脫有字"}
{"id": null, "n": "0435004", "target": "#nkr_note_orig_0435004 #note_star_3", "type": "orig", "text": "愍恐慇"}
