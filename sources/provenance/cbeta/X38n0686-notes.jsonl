{"id": null, "n": "0436002", "target": "#nkr_note_orig_0436002", "type": "orig", "text": "巳作時"}
{"id": null, "n": "0436003", "target": "#nkr_note_orig_0436003", "type": "orig", "text": "叉字恐剩"}
{"id": null, "n": "0436004", "target": "#nkr_note_orig_0436004", "type": "orig", "text": "當慧下恐有寫誤"}
{"id": null, "n": "0436005", "target": "#nkr_note_orig_0436005", "type": "orig", "text": "聞下恐脫慧字"}
{"id": null, "n": "0436006", "target": "#nkr_note_orig_0436006", "type": "orig", "text": "命恐今"}
{"id": null, "n": "0436007", "target": "#nkr_note_orig_0436007", "type": "orig", "text": "決上恐脫不字"}
{"id": null, "n": "0436008", "target": "#nkr_note_orig_0436008", "type": "orig", "text": "一恐二"}
{"id": null, "n": "0436009", "target": "#nkr_note_orig_0436009", "type": "orig", "text": "亦恐不"}
