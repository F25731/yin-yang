{"id": null, "n": "0437004", "target": "#nkr_note_orig_0437004", "type": "orig", "text": "論無中字"}
{"id": null, "n": "0437005", "target": "#nkr_note_orig_0437005", "type": "orig", "text": "佛論作行"}
{"id": null, "n": "0438001", "target": "#nkr_note_orig_0438001", "type": "orig", "text": "自疑因"}
{"id": null, "n": "0438002", "target": "#nkr_note_orig_0438002", "type": "orig", "text": "說疑訖次同"}
{"id": null, "n": "0439001", "target": "#nkr_note_orig_0439001", "type": "orig", "text": "三下恐脫千字"}
