{"id": null, "n": "0754029", "target": "#nkr_note_mod_0754029", "type": "mod", "text": "月氏【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0754030", "target": "#nkr_note_mod_0754030", "type": "mod", "text": "三藏【大】，三藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0754031", "target": "#nkr_note_mod_0754031", "type": "mod", "text": "譯【大】，第二譯【元】【明】"}
{"id": null, "n": "0754032", "target": "#nkr_note_mod_0754032", "type": "mod", "text": "鬼【大】，〔－〕【宮】"}
{"id": null, "n": "0754033", "target": "#nkr_note_mod_0754033", "type": "mod", "text": "須【大】，得【宋】【元】【明】【宮】"}
{"id": null, "n": "0754034", "target": "#nkr_note_mod_0754034", "type": "mod", "text": "湩【大】＊，𡦢【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0754035", "target": "#nkr_note_mod_0754035", "type": "mod", "text": "這【大】，適【宋】【元】【明】【宮】"}
{"id": null, "n": "0754036", "target": "#nkr_note_mod_0754036", "type": "mod", "text": "惟【大】＊，唯【宋】【宮】＊"}
{"id": null, "n": "0754037", "target": "#nkr_note_mod_0754037", "type": "mod", "text": "捉【大】，𣪬【宋】【元】【明】【宮】"}
{"id": null, "n": "0754038", "target": "#nkr_note_mod_0754038", "type": "mod", "text": "曰【大】，言【宋】【元】【明】【宮】"}
{"id": null, "n": "0754039", "target": "#nkr_note_mod_0754039", "type": "mod", "text": "乳【大】，𡦢【宮】"}
{"id": null, "n": "0754040", "target": "#nkr_note_mod_0754040", "type": "mod", "text": "勿得【大】，得勿【元】【明】"}
{"id": null, "n": "0755001", "target": "#nkr_note_mod_0755001", "type": "mod", "text": "復【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0755002", "target": "#nkr_note_mod_0755002", "type": "mod", "text": "以【大】，法【宋】【元】【明】【宮】"}
{"id": null, "n": "0755003", "target": "#nkr_note_mod_0755003", "type": "mod", "text": "常【大】，尚【宋】【元】【明】【宮】"}
{"id": null, "n": "0755004", "target": "#nkr_note_mod_0755004", "type": "mod", "text": "患【大】，惡悉【宋】【元】【明】【宮】"}
{"id": null, "n": "0755005", "target": "#nkr_note_mod_0755005", "type": "mod", "text": "徒【大】，從【宮】"}
{"id": null, "n": "0755006", "target": "#nkr_note_mod_0755006", "type": "mod", "text": "乳【大】＊，𡦢【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0755007", "target": "#nkr_note_mod_0755007", "type": "mod", "text": "得【大】，復【宋】【元】【明】【宮】"}
{"id": null, "n": "0755008", "target": "#nkr_note_mod_0755008", "type": "mod", "text": "自【大】，思【宋】【元】【明】"}
{"id": null, "n": "0755009", "target": "#nkr_note_mod_0755009", "type": "mod", "text": "來【大】，共【宋】【元】【明】【宮】"}
{"id": null, "n": "0755010", "target": "#nkr_note_mod_0755010", "type": "mod", "text": "令【大】，全為【宋】【元】【明】【宮】"}
{"id": null, "n": "0755011", "target": "#nkr_note_mod_0755011", "type": "mod", "text": "說【大】，而說【宋】【元】【明】"}
{"id": null, "n": "0755012", "target": "#nkr_note_mod_0755012", "type": "mod", "text": "於是犢子便為母說【大】，爾時犢子即為天帝釋而說【宋】【元】【明】【宮】"}
{"id": null, "n": "0755013", "target": "#nkr_note_mod_0755013", "type": "mod", "text": "多【大】，大【宋】【元】【明】【宮】"}
{"id": null, "n": "0755014", "target": "#nkr_note_mod_0755014", "type": "mod", "text": "佛【大】，作【宋】【元】【明】【宮】"}
{"id": null, "n": "0755015", "target": "#nkr_note_mod_0755015", "type": "mod", "text": "困【大】，因【宋】【元】【明】【宮】"}
{"id": null, "n": "0755016", "target": "#nkr_note_mod_0755016", "type": "mod", "text": "令【大】，今【明】"}
{"id": null, "n": "0755017", "target": "#nkr_note_mod_0755017", "type": "mod", "text": "而【大】，為【宋】【元】【明】【宮】"}
{"id": null, "n": "0755018", "target": "#nkr_note_mod_0755018", "type": "mod", "text": "乳【大】，𡦢【宮】"}
{"id": null, "n": "0755019", "target": "#nkr_note_mod_0755019", "type": "mod", "text": "帝【大】，帝釋【元】【明】"}
{"id": null, "n": "0756001", "target": "#nkr_note_mod_0756001", "type": "mod", "text": "坐【大】，生【元】"}
{"id": null, "n": "0756002", "target": "#nkr_note_mod_0756002", "type": "mod", "text": "觝【大】，抵【宋】【元】【明】【宮】"}
{"id": null, "n": "0756003", "target": "#nkr_note_mod_0756003", "type": "mod", "text": "外【大】，在外【宋】【元】【明】【宮】"}
{"id": null, "n": "0756004", "target": "#nkr_note_mod_0756004", "type": "mod", "text": "債【大】，責【宮】"}
{"id": null, "n": "0756005", "target": "#nkr_note_mod_0756005", "type": "mod", "text": "術【大】，率【明】"}
{"id": null, "n": "0756006", "target": "#nkr_note_mod_0756006", "type": "mod", "text": "繒【大】，憎【宋】，𢅋【元】"}
{"id": null, "n": "0756007", "target": "#nkr_note_mod_0756007", "type": "mod", "text": "蓋【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0756008", "target": "#nkr_note_mod_0756008", "type": "mod", "text": "是【大】，是故【宋】【元】【明】【宮】"}
{"id": null, "n": "0756009", "target": "#nkr_note_mod_0756009", "type": "mod", "text": "說【大】，佛說【宋】【元】【明】【宮】"}
{"id": null, "n": "0754029", "target": "#nkr_note_orig_0754029", "type": "orig", "text": "〔月氏〕－【三】【宮】"}
{"id": null, "n": "0754030", "target": "#nkr_note_orig_0754030", "type": "orig", "text": "三藏＋（法師）【三】【宮】"}
{"id": null, "n": "0754031", "target": "#nkr_note_orig_0754031", "type": "orig", "text": "（第二）＋譯【元】【明】"}
{"id": null, "n": "0754032", "target": "#nkr_note_orig_0754032", "type": "orig", "text": "〔鬼〕－【宮】"}
{"id": null, "n": "0754033", "target": "#nkr_note_orig_0754033", "type": "orig", "text": "須＝得【三】【宮】"}
{"id": null, "n": "0754034", "target": "#nkr_note_orig_0754034", "type": "orig", "text": "湩＝𡦢【三】【宮】＊"}
{"id": null, "n": "0754035", "target": "#nkr_note_orig_0754035", "type": "orig", "text": "這＝適【三】【宮】"}
{"id": null, "n": "0754036", "target": "#nkr_note_orig_0754036", "type": "orig", "text": "惟＝唯【宋】【宮】＊"}
{"id": null, "n": "0754037", "target": "#nkr_note_orig_0754037", "type": "orig", "text": "捉＝𣪬【三】【宮】"}
{"id": null, "n": "0754038", "target": "#nkr_note_orig_0754038", "type": "orig", "text": "曰＝言【三】【宮】"}
{"id": null, "n": "0754039", "target": "#nkr_note_orig_0754039", "type": "orig", "text": "乳＝𡦢【宮】"}
{"id": null, "n": "0754040", "target": "#nkr_note_orig_0754040", "type": "orig", "text": "勿得＝得勿【元】【明】"}
{"id": null, "n": "0755001", "target": "#nkr_note_orig_0755001", "type": "orig", "text": "〔復〕－【三】【宮】"}
{"id": null, "n": "0755002", "target": "#nkr_note_orig_0755002", "type": "orig", "text": "以＝法【三】【宮】"}
{"id": null, "n": "0755003", "target": "#nkr_note_orig_0755003", "type": "orig", "text": "常＝尚【三】【宮】"}
{"id": null, "n": "0755004", "target": "#nkr_note_orig_0755004", "type": "orig", "text": "患＝惡悉【三】【宮】"}
{"id": null, "n": "0755005", "target": "#nkr_note_orig_0755005", "type": "orig", "text": "徒＝從【宮】"}
{"id": null, "n": "0755006", "target": "#nkr_note_orig_0755006", "type": "orig", "text": "乳＝𡦢【三】【宮】＊"}
{"id": null, "n": "0755007", "target": "#nkr_note_orig_0755007", "type": "orig", "text": "得＝復【三】【宮】"}
{"id": null, "n": "0755008", "target": "#nkr_note_orig_0755008", "type": "orig", "text": "自＝思【三】"}
{"id": null, "n": "0755009", "target": "#nkr_note_orig_0755009", "type": "orig", "text": "來＝共【三】【宮】"}
{"id": null, "n": "0755010", "target": "#nkr_note_orig_0755010", "type": "orig", "text": "令＝全為【三】【宮】"}
{"id": null, "n": "0755011", "target": "#nkr_note_orig_0755011", "type": "orig", "text": "（而）＋說【三】"}
{"id": null, "n": "0755012", "target": "#nkr_note_orig_0755012", "type": "orig", "text": "於是犢子便為母說＝爾時犢子即為天帝釋而說【三】【宮】"}
{"id": null, "n": "0755013", "target": "#nkr_note_orig_0755013", "type": "orig", "text": "多＝大【三】【宮】"}
{"id": null, "n": "0755014", "target": "#nkr_note_orig_0755014", "type": "orig", "text": "佛＝作【三】【宮】"}
{"id": null, "n": "0755015", "target": "#nkr_note_orig_0755015", "type": "orig", "text": "困＝因【三】【宮】"}
{"id": null, "n": "0755016", "target": "#nkr_note_orig_0755016", "type": "orig", "text": "令＝今【明】"}
{"id": null, "n": "0755017", "target": "#nkr_note_orig_0755017", "type": "orig", "text": "而＝為【三】【宮】"}
{"id": null, "n": "0755018", "target": "#nkr_note_orig_0755018", "type": "orig", "text": "乳＝𡦢【宮】"}
{"id": null, "n": "0755019", "target": "#nkr_note_orig_0755019", "type": "orig", "text": "帝＋（釋）【元】【明】"}
{"id": null, "n": "0756001", "target": "#nkr_note_orig_0756001", "type": "orig", "text": "坐＝生【元】"}
{"id": null, "n": "0756002", "target": "#nkr_note_orig_0756002", "type": "orig", "text": "觝＝抵【三】【宮】"}
{"id": null, "n": "0756003", "target": "#nkr_note_orig_0756003", "type": "orig", "text": "（在）＋外【三】【宮】"}
{"id": null, "n": "0756004", "target": "#nkr_note_orig_0756004", "type": "orig", "text": "債＝責【宮】"}
{"id": null, "n": "0756005", "target": "#nkr_note_orig_0756005", "type": "orig", "text": "術＝率【明】"}
{"id": null, "n": "0756006", "target": "#nkr_note_orig_0756006", "type": "orig", "text": "繒＝憎【宋】，𢅋【元】"}
{"id": null, "n": "0756007", "target": "#nkr_note_orig_0756007", "type": "orig", "text": "〔蓋〕－【三】"}
{"id": null, "n": "0756008", "target": "#nkr_note_orig_0756008", "type": "orig", "text": "是＋（故）【三】【宮】"}
{"id": null, "n": "0756009", "target": "#nkr_note_orig_0756009", "type": "orig", "text": "（佛）＋說【三】【宮】"}
