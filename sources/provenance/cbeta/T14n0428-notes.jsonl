{"id": null, "n": "0073006", "target": "#nkr_note_mod_0073006", "type": "mod", "text": "月氏【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0073007", "target": "#nkr_note_mod_0073007", "type": "mod", "text": "鳥【大】，鷲【明】"}
{"id": null, "n": "0073008", "target": "#nkr_note_mod_0073008", "type": "mod", "text": "土【大】，王【元】"}
{"id": null, "n": "0073009", "target": "#nkr_note_mod_0073009", "type": "mod", "text": "蓮【大】，光【元】"}
{"id": null, "n": "0073010", "target": "#nkr_note_mod_0073010", "type": "mod", "text": "正【大】，整【宋】【元】【明】【宮】"}
{"id": null, "n": "0073011", "target": "#nkr_note_mod_0073011", "type": "mod", "text": "土【大】，本【宮】"}
{"id": null, "n": "0074001", "target": "#nkr_note_mod_0074001", "type": "mod", "text": "幸【大】，逢【宋】【元】【明】【宮】"}
{"id": null, "n": "0074002", "target": "#nkr_note_mod_0074002", "type": "mod", "text": "併【大】，并【宋】【元】【明】【宮】"}
{"id": null, "n": "0074003", "target": "#nkr_note_mod_0074003", "type": "mod", "text": "病【大】，〔－〕【宮】"}
{"id": null, "n": "0074004", "target": "#nkr_note_mod_0074004", "type": "mod", "text": "去＋（呪曰唵啊咖唎曼哩曼哩曼哆哩莎訶）十五字【明】"}
{"id": null, "n": "0074005", "target": "#nkr_note_mod_0074005", "type": "mod", "text": "（八菩薩…快也）百五十八字【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0073006", "target": "#nkr_note_orig_0073006", "type": "orig", "text": "〔月氏〕－【三】【宮】"}
{"id": null, "n": "0073007", "target": "#nkr_note_orig_0073007", "type": "orig", "text": "鳥＝鷲【明】"}
{"id": null, "n": "0073008", "target": "#nkr_note_orig_0073008", "type": "orig", "text": "土＝王【元】"}
{"id": null, "n": "0073009", "target": "#nkr_note_orig_0073009", "type": "orig", "text": "蓮＝光【元】"}
{"id": null, "n": "0073010", "target": "#nkr_note_orig_0073010", "type": "orig", "text": "正＝整【三】【宮】"}
{"id": null, "n": "0073011", "target": "#nkr_note_orig_0073011", "type": "orig", "text": "土＝本【宮】"}
{"id": null, "n": "0074001", "target": "#nkr_note_orig_0074001", "type": "orig", "text": "幸＝逢【三】【宮】"}
{"id": null, "n": "0074002", "target": "#nkr_note_orig_0074002", "type": "orig", "text": "併＝并【三】【宮】"}
{"id": null, "n": "0074003", "target": "#nkr_note_orig_0074003", "type": "orig", "text": "〔病〕－【宮】"}
{"id": null, "n": "0074004", "target": "#nkr_note_orig_0074004", "type": "orig", "text": "去＋（呪曰唵啊咖唎曼哩曼哩曼哆哩莎訶）十五字【明】"}
{"id": null, "n": "0074005", "target": "#nkr_note_orig_0074005", "type": "orig", "text": "〔八菩薩…快也〕百五十八字－【三】【宮】"}
{"id": null, "n": "0074a2001", "target": "#nkr_note_add_0074a2001", "type": "add", "text": "曰【CB】，日【大】"}
