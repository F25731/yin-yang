{"id": null, "n": "0074a2001", "target": null, "type": "add", "text": "曰【CB】，日【大】"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K34n1257_p0695a05"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "K34n1257_p0858c06"}
