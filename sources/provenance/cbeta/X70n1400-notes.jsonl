{"id": null, "n": null, "target": null, "type": null, "text": "一人齒不壞"}
{"id": null, "n": null, "target": null, "type": null, "text": "吳士"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "地名西馬塍"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "丘蓋切，音慨。貪也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "倚兩切，鴦上聲。情不滿足也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "無約切，音却。行見中外曰慤。"}
{"id": null, "n": null, "target": null, "type": null, "text": "昌中切，音充。行不絕貌。"}
{"id": null, "n": null, "target": null, "type": null, "text": "苦洽切，嵌入聲。爪刺。"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡八切，閑入聲。車軸頭鐵。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音駝。里行貌。又連接也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "莫補切，音母。老母也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "子淺切，音翦。淺也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "悉合切，音靸。谿\n名。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音成。田中畦埒也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "涓熒切，音駉。外閉之關也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "居月切，音決。環有舌者。"}
{"id": null, "n": null, "target": null, "type": null, "text": "於刀切，奧平聲。鏖戰盡死。殺人曰鏖。"}
{"id": null, "n": null, "target": null, "type": null, "text": "居御切，音踞。革履。"}
{"id": null, "n": null, "target": null, "type": null, "text": "求於切，音渠。瘦也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "丑鳩\n切，音抽。病瘉也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "即涉切，音接。目旁毛也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "都艱切，音單。盡也，竭也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "苦猥切，窺上聲。\n半步也。"}
