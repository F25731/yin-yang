{"id": null, "n": "0120003", "target": "#nkr_note_mod_0120003", "type": "mod", "text": "無【大】＊，〔－〕【考偽-大】＊"}
{"id": null, "n": "0120004", "target": "#nkr_note_mod_0120004", "type": "mod", "text": "從【大】，從此【考偽-大】"}
{"id": null, "n": "0120005", "target": "#nkr_note_mod_0120005", "type": "mod", "text": "陀【大】，阿【考偽-大】"}
{"id": null, "n": "0121001", "target": "#nkr_note_mod_0121001", "type": "mod", "text": "佛【大】，文【考偽-大】"}
{"id": null, "n": "0121002", "target": "#nkr_note_mod_0121002", "type": "mod", "text": "初【大】，〔－〕【考偽-大】"}
{"id": null, "n": "0123001", "target": "#nkr_note_mod_0123001", "type": "mod", "text": "不應住色生心【大】，〔－〕【考偽-大】"}
{"id": null, "n": "0124002", "target": "#nkr_note_mod_0124002", "type": "mod", "text": "卷【大】，下卷【考偽-大】"}
{"id": null, "n": "0126001", "target": "#nkr_note_mod_0126001", "type": "mod", "text": "境【大】，境界【考偽-大】"}
{"id": null, "n": "0127001", "target": "#nkr_note_mod_0127001", "type": "mod", "text": "即【大】，印【考偽-大】"}
{"id": null, "n": "0127002", "target": "#nkr_note_mod_0127002", "type": "mod", "text": "阿【大】，呵【考偽-大】"}
{"id": null, "n": "0127003", "target": "#nkr_note_mod_0127003", "type": "mod", "text": "相【大】＊，於【考偽-大】＊"}
{"id": null, "n": "0128001", "target": "#nkr_note_mod_0128001", "type": "mod", "text": "識【大】，熾【考偽-大】"}
{"id": null, "n": "0129001", "target": "#nkr_note_mod_0129001", "type": "mod", "text": "奴子【大】，孥【考偽-大】"}
{"id": null, "n": "0120001", "target": "#nkr_note_orig_0120001", "type": "orig", "text": "【原】大英博物館藏燉煌本, S. 2047, 首題新加"}
{"id": null, "n": "0120002", "target": "#nkr_note_orig_0120002", "type": "orig", "text": "首缺"}
{"id": null, "n": "0120003", "target": "#nkr_note_orig_0120003", "type": "orig", "text": "〔無〕－？＊"}
{"id": null, "n": "0120004", "target": "#nkr_note_orig_0120004", "type": "orig", "text": "從＋（此）？"}
{"id": null, "n": "0120005", "target": "#nkr_note_orig_0120005", "type": "orig", "text": "陀＝阿？"}
{"id": null, "n": "0121001", "target": "#nkr_note_orig_0121001", "type": "orig", "text": "佛＝文？"}
{"id": null, "n": "0121002", "target": "#nkr_note_orig_0121002", "type": "orig", "text": "〔初〕－？"}
{"id": null, "n": "0122001", "target": "#nkr_note_orig_0122001", "type": "orig", "text": "校者曰者下及相下疑有脫字"}
{"id": null, "n": "0123001", "target": "#nkr_note_orig_0123001", "type": "orig", "text": "〔不應住色生心〕－？"}
{"id": null, "n": "0124001", "target": "#nkr_note_orig_0124001", "type": "orig", "text": "校者曰三上恐有脫字"}
{"id": null, "n": "0124002", "target": "#nkr_note_orig_0124002", "type": "orig", "text": "（下）＋卷？"}
{"id": null, "n": "0126001", "target": "#nkr_note_orig_0126001", "type": "orig", "text": "境＋（界）？"}
{"id": null, "n": "0127001", "target": "#nkr_note_orig_0127001", "type": "orig", "text": "即＝印？"}
{"id": null, "n": "0127002", "target": "#nkr_note_orig_0127002", "type": "orig", "text": "阿＝呵？"}
{"id": null, "n": "0127003", "target": "#nkr_note_orig_0127003", "type": "orig", "text": "相＝於？＊"}
{"id": null, "n": "0128001", "target": "#nkr_note_orig_0128001", "type": "orig", "text": "識＝熾？"}
{"id": null, "n": "0129001", "target": "#nkr_note_orig_0129001", "type": "orig", "text": "奴子＝孥？"}
