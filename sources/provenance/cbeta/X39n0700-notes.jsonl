{"id": null, "n": null, "target": null, "type": null, "text": "出周書異記"}
{"id": null, "n": null, "target": null, "type": null, "text": "即等覺位菩薩"}
{"id": null, "n": null, "target": null, "type": null, "text": "後皆准此"}
{"id": null, "n": null, "target": null, "type": null, "text": "九十五種道兼\n小乘教，故成九十六"}
{"id": null, "n": null, "target": null, "type": null, "text": "初津卷六"}
{"id": null, "n": null, "target": null, "type": null, "text": "此云寂靜處"}
{"id": null, "n": null, "target": null, "type": null, "text": "離懈怠故"}
{"id": null, "n": null, "target": null, "type": null, "text": "即糞掃衣"}
{"id": null, "n": null, "target": null, "type": null, "text": "日惟一食"}
{"id": null, "n": null, "target": null, "type": null, "text": "稱量而受"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂果汁也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此三對治煩惱"}
{"id": null, "n": null, "target": null, "type": null, "text": "禪觀增進"}
{"id": null, "n": null, "target": null, "type": null, "text": "不揀貧富"}
{"id": null, "n": null, "target": null, "type": null, "text": "不畜長物"}
{"id": null, "n": null, "target": null, "type": null, "text": "此五種利出地持經"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
