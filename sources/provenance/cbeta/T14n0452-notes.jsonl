{"id": null, "n": "0420008", "target": "#nkr_note_orig_0420008", "type": "orig", "text": "授＝受【三】【宮】"}
{"id": null, "n": "0420009", "target": "#nkr_note_orig_0420009", "type": "orig", "text": "見＝坐【明】"}
{"id": null, "n": "0420010", "target": "#nkr_note_orig_0420010", "type": "orig", "text": "敬禮＝禮敬【宮】"}
