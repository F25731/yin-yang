{"id": null, "n": "0419004", "target": "#nkr_note_orig_0419004", "type": "orig", "text": "光＝珠【元】【明】【宮】"}
{"id": null, "n": "0419005", "target": "#nkr_note_orig_0419005", "type": "orig", "text": "園＝垣【明】"}
{"id": null, "n": "0419006", "target": "#nkr_note_orig_0419006", "type": "orig", "text": "游＝遶【三】【宮】"}
{"id": null, "n": "0419007", "target": "#nkr_note_orig_0419007", "type": "orig", "text": "絞＝交【三】【宮】"}
{"id": null, "n": "0419008", "target": "#nkr_note_orig_0419008", "type": "orig", "text": "〔往〕－【三】【宮】"}
{"id": null, "n": "0419009", "target": "#nkr_note_orig_0419009", "type": "orig", "text": "意＝音【三】【宮】"}
{"id": null, "n": "0419010", "target": "#nkr_note_orig_0419010", "type": "orig", "text": "〔戒〕－【宮】"}
{"id": null, "n": "0419011", "target": "#nkr_note_orig_0419011", "type": "orig", "text": "〔彌勒先…生〕二十一字－【三】【宮】"}
{"id": null, "n": "0419012", "target": "#nkr_note_orig_0419012", "type": "orig", "text": "後＝從【三】【宮】"}
{"id": null, "n": "0419013", "target": "#nkr_note_orig_0419013", "type": "orig", "text": "日＋（於波羅㮈國劫波利村波婆利大婆羅門）【三】"}
