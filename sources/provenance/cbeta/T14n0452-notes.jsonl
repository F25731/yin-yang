{"id": null, "n": "0419001", "target": "#nkr_note_orig_0419001", "type": "orig", "text": "婉＝宛【元】【明】"}
{"id": null, "n": "0419002", "target": "#nkr_note_orig_0419002", "type": "orig", "text": "〔五〕－【三】【宮】"}
