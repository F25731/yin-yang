{"id": null, "n": "0418006", "target": "#nkr_note_mod_0418006", "type": "mod", "text": "佛說【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0418007", "target": "#nkr_note_mod_0418007", "type": "mod", "text": "率【大】，率陀【宋】【元】【明】【宮】"}
{"id": null, "n": "0418008", "target": "#nkr_note_mod_0418008", "type": "mod", "text": "宋【大】，劉宋【元】【明】"}
{"id": null, "n": "0418009", "target": "#nkr_note_mod_0418009", "type": "mod", "text": "聲【大】，聲先於高昌郡單【元】，聲先于高昌郡單【明】"}
{"id": null, "n": "0418010", "target": "#nkr_note_mod_0418010", "type": "mod", "text": "礙【大】，閡【宮】"}
{"id": null, "n": "0418011", "target": "#nkr_note_mod_0418011", "type": "mod", "text": "陀【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0418012", "target": "#nkr_note_mod_0418012", "type": "mod", "text": "萬【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0418013", "target": "#nkr_note_mod_0418013", "type": "mod", "text": "此【大】，是【宋】【元】【明】【宮】"}
{"id": null, "n": "0419001", "target": "#nkr_note_mod_0419001", "type": "mod", "text": "婉【大】，宛【元】【明】"}
{"id": null, "n": "0419002", "target": "#nkr_note_mod_0419002", "type": "mod", "text": "五【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0419003", "target": "#nkr_note_mod_0419003", "type": "mod", "text": "五【大】，〔－〕【宮】"}
{"id": null, "n": "0419004", "target": "#nkr_note_mod_0419004", "type": "mod", "text": "光【大】，珠【元】【明】【宮】"}
{"id": null, "n": "0419005", "target": "#nkr_note_mod_0419005", "type": "mod", "text": "園【大】，垣【明】"}
{"id": null, "n": "0419006", "target": "#nkr_note_mod_0419006", "type": "mod", "text": "游【大】，遶【宋】【元】【明】【宮】"}
{"id": null, "n": "0419007", "target": "#nkr_note_mod_0419007", "type": "mod", "text": "絞【大】，交【宋】【元】【明】【宮】"}
{"id": null, "n": "0419008", "target": "#nkr_note_mod_0419008", "type": "mod", "text": "往【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0419009", "target": "#nkr_note_mod_0419009", "type": "mod", "text": "意【大】，音【宋】【元】【明】【宮】"}
{"id": null, "n": "0419010", "target": "#nkr_note_mod_0419010", "type": "mod", "text": "戒【大】，〔－〕【宮】"}
{"id": null, "n": "0419011", "target": "#nkr_note_mod_0419011", "type": "mod", "text": "（彌勒先…生）二十一字【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0419012", "target": "#nkr_note_mod_0419012", "type": "mod", "text": "後【大】，從【宋】【元】【明】【宮】"}
{"id": null, "n": "0419013", "target": "#nkr_note_mod_0419013", "type": "mod", "text": "日【大】，日於波羅㮈國劫波利村波婆利大婆羅門【宋】【元】【明】"}
{"id": null, "n": "0419014", "target": "#nkr_note_mod_0419014", "type": "mod", "text": "還本生【大】，家本所生【宋】【元】【明】【宮】"}
{"id": null, "n": "0419015", "target": "#nkr_note_mod_0419015", "type": "mod", "text": "人天【大】，天人【宋】【元】【明】【宮】"}
{"id": null, "n": "0420001", "target": "#nkr_note_mod_0420001", "type": "mod", "text": "有【大】，〔－〕【宮】"}
{"id": null, "n": "0420002", "target": "#nkr_note_mod_0420002", "type": "mod", "text": "好【大】，好中【宋】【元】【明】【宮】"}
{"id": null, "n": "0420003", "target": "#nkr_note_mod_0420003", "type": "mod", "text": "轉【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0420004", "target": "#nkr_note_mod_0420004", "type": "mod", "text": "法【大】，不退轉法輪【宋】【元】【明】【宮】"}
{"id": null, "n": "0420005", "target": "#nkr_note_mod_0420005", "type": "mod", "text": "於【大】，當為【宋】【元】【明】【宮】"}
{"id": null, "n": "0420006", "target": "#nkr_note_mod_0420006", "type": "mod", "text": "當為【大】，一切【宋】【元】【明】【宮】"}
{"id": null, "n": "0420007", "target": "#nkr_note_mod_0420007", "type": "mod", "text": "者【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0420008", "target": "#nkr_note_mod_0420008", "type": "mod", "text": "授【大】，受【宋】【元】【明】【宮】"}
{"id": null, "n": "0420009", "target": "#nkr_note_mod_0420009", "type": "mod", "text": "見【大】，坐【明】"}
{"id": null, "n": "0420010", "target": "#nkr_note_mod_0420010", "type": "mod", "text": "敬禮【大】，禮敬【宮】"}
{"id": null, "n": "0420011", "target": "#nkr_note_mod_0420011", "type": "mod", "text": "心【大】，道心【宋】【元】【明】【宮】"}
{"id": null, "n": "0420012", "target": "#nkr_note_mod_0420012", "type": "mod", "text": "生【大】，上生【宋】【元】【明】【宮】"}
