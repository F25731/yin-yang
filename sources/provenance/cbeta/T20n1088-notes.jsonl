{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": null, "target": null, "type": null, "text": "歸命義"}
{"id": null, "n": null, "target": null, "type": null, "text": "寶義"}
{"id": null, "n": null, "target": null, "type": null, "text": "三義所謂歸命三寶敬"}
{"id": null, "n": null, "target": null, "type": null, "text": "稽首義"}
{"id": null, "n": null, "target": null, "type": null, "text": "聖觀自在"}
{"id": null, "n": null, "target": null, "type": null, "text": "菩薩"}
{"id": null, "n": null, "target": null, "type": null, "text": "大菩薩"}
{"id": null, "n": null, "target": null, "type": null, "text": "大慈悲者"}
{"id": null, "n": null, "target": null, "type": null, "text": "所謂開如來藏說真言"}
{"id": null, "n": null, "target": null, "type": null, "text": "能轉無上法輪義，亦摧破義"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合，大蓮華也，表淨諸非法，染本不染故"}
{"id": null, "n": null, "target": null, "type": null, "text": "一切法流注義，無所得以為方便，覺不可得"}
{"id": null, "n": null, "target": null, "type": null, "text": "一切法超越之義，言語道斷不可得"}
{"id": null, "n": null, "target": null, "type": null, "text": "一切法離塵義，了亦不可得"}
{"id": null, "n": null, "target": null, "type": null, "text": "一切法施義，畢竟無所得"}
{"id": null, "n": null, "target": null, "type": null, "text": "一切法勝義，性相不可得"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": null, "target": null, "type": null, "text": "一切法離我，取孰義不可得"}
{"id": null, "n": null, "target": null, "type": null, "text": "一切諸法了義亦不可得"}
{"id": null, "n": null, "target": null, "type": null, "text": "四十八歲"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "SS25_10_0080a18"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "X02n0080_p0406b22"}
{"id": null, "n": "0216003", "target": null, "type": "orig", "text": "盡＝畫ィ【原】"}
{"id": null, "n": "0216003", "target": null, "type": "mod", "text": "盡【大】，畫【校異-原】"}
{"id": null, "n": "0216a1401", "target": null, "type": "add", "text": "嚩【CB】【卍續-CB】，囉【大】"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "SS25_10_0080a18"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "X02n0080_p0406b22"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0216025", "target": null, "type": "orig", "text": "〔之中得〕－ヵ【原】"}
{"id": null, "n": "0216025", "target": null, "type": "mod", "text": "之中得【大】，〔－〕【考偽-原】"}
{"id": null, "n": "0216c1501", "target": null, "type": "add", "text": "己【CB】，已【大】"}
{"id": null, "n": "0216001", "target": "#nkr_note_mod_0216001", "type": "mod", "text": "不可【大】，無所【甲】"}
{"id": null, "n": "0216002", "target": "#nkr_note_mod_0216002", "type": "mod", "text": "（右如…注義）一百七十九字【大】，〔－〕【甲】"}
{"id": null, "n": "0216003", "target": "#nkr_note_mod_0216003", "type": "mod", "text": "盡【大】，畫【校異-原】"}
{"id": null, "n": "0216004", "target": "#nkr_note_mod_0216004", "type": "mod", "text": "寶【大】，三寶【甲】"}
{"id": null, "n": "0216005", "target": "#nkr_note_mod_0216005", "type": "mod", "text": "（三義…敬）九字【大】，所謂歸敬三寶【甲】"}
{"id": null, "n": "0216006", "target": "#nkr_note_mod_0216006", "type": "mod", "text": "大菩薩【大】，大勇猛道心者【甲】"}
{"id": null, "n": "0216007", "target": "#nkr_note_mod_0216007", "type": "mod", "text": "其字成於【大】，〔－〕【甲】"}
{"id": null, "n": "0216008", "target": "#nkr_note_mod_0216008", "type": "mod", "text": "唵之一字所謂【大】，含三字義【甲】"}
{"id": null, "n": "0216009", "target": "#nkr_note_mod_0216009", "type": "mod", "text": "者【大】＊，〔－〕【甲】＊"}
{"id": null, "n": "0216010", "target": "#nkr_note_mod_0216010", "type": "mod", "text": "輪【大】，〔－〕【甲】"}
{"id": null, "n": "0216011", "target": "#nkr_note_mod_0216011", "type": "mod", "text": "破【大】，碾【甲】"}
{"id": null, "n": "0216012", "target": "#nkr_note_mod_0216012", "type": "mod", "text": "義【大】，寶義【甲】"}
{"id": null, "n": "0216013", "target": "#nkr_note_mod_0216013", "type": "mod", "text": "合【大】，〔－〕【甲】"}
{"id": null, "n": "0216014", "target": "#nkr_note_mod_0216014", "type": "mod", "text": "也表【大】，〔－〕【甲】"}
{"id": null, "n": "0216015", "target": "#nkr_note_mod_0216015", "type": "mod", "text": "染【大】，〔－〕【甲】"}
{"id": null, "n": "0216016", "target": "#nkr_note_mod_0216016", "type": "mod", "text": "內【大】，外【甲】"}
{"id": null, "n": "0216017", "target": "#nkr_note_mod_0216017", "type": "mod", "text": "外【大】，內【甲】"}
{"id": null, "n": "0216018", "target": "#nkr_note_mod_0216018", "type": "mod", "text": "死【大】，死不住涅槃【甲】"}
{"id": null, "n": "0216019", "target": "#nkr_note_mod_0216019", "type": "mod", "text": "持【大】，護【甲】"}
{"id": null, "n": "0216020", "target": "#nkr_note_mod_0216020", "type": "mod", "text": "雲【大】，皆運【甲】"}
{"id": null, "n": "0216021", "target": "#nkr_note_mod_0216021", "type": "mod", "text": "時【大】，則【校異-原】"}
{"id": null, "n": "0216022", "target": "#nkr_note_mod_0216022", "type": "mod", "text": "婆【大】，波【甲】"}
{"id": null, "n": "0216023", "target": "#nkr_note_mod_0216023", "type": "mod", "text": "（四魔…淨）六十三字【大】，〔－〕【甲】"}
{"id": null, "n": "0216024", "target": "#nkr_note_mod_0216024", "type": "mod", "text": "（亦云…也）七十字【大】，〔－〕【甲】"}
{"id": null, "n": "0216025", "target": "#nkr_note_mod_0216025", "type": "mod", "text": "之中得【大】，〔－〕【考偽-原】"}
{"id": null, "n": "0216026", "target": "#nkr_note_mod_0216026", "type": "mod", "text": "（其吒…故）三十一字【大】，〔－〕【甲】"}
{"id": null, "n": "0216027", "target": "#nkr_note_mod_0216027", "type": "mod", "text": "等【大】，字平等【甲】"}
{"id": null, "n": "0216028", "target": "#nkr_note_mod_0216028", "type": "mod", "text": "（即成…義）十六字【大】，〔－〕【甲】"}
{"id": null, "n": "0216029", "target": "#nkr_note_mod_0216029", "type": "mod", "text": "以下至卷末甲本無"}
{"id": null, "n": "0215011", "target": "#nkr_note_orig_0215011", "type": "orig", "text": "【原】黃檗版淨嚴等校訂加筆本塚本賢曉氏藏，【甲】三十帖策子第二十七"}
{"id": null, "n": "0215012", "target": "#nkr_note_orig_0215012", "type": "orig", "text": "梵字依甲本載之下同"}
{"id": null, "n": "0216001", "target": "#nkr_note_orig_0216001", "type": "orig", "text": "不可＝無所【甲】"}
{"id": null, "n": "0216002", "target": "#nkr_note_orig_0216002", "type": "orig", "text": "〔右如…注義〕一百七十九字－【甲】"}
{"id": null, "n": "0216003", "target": "#nkr_note_orig_0216003", "type": "orig", "text": "盡＝畫ィ【原】"}
{"id": null, "n": "0216004", "target": "#nkr_note_orig_0216004", "type": "orig", "text": "（三）＋寶【甲】"}
{"id": null, "n": "0216005", "target": "#nkr_note_orig_0216005", "type": "orig", "text": "（三義…敬）九字＝（所謂歸敬三寶）六字【甲】"}
{"id": null, "n": "0216006", "target": "#nkr_note_orig_0216006", "type": "orig", "text": "大菩薩＝大勇猛道心者【甲】"}
{"id": null, "n": "0216007", "target": "#nkr_note_orig_0216007", "type": "orig", "text": "〔其字成於〕－【甲】"}
{"id": null, "n": "0216008", "target": "#nkr_note_orig_0216008", "type": "orig", "text": "唵之一字所謂＝含三字義【甲】"}
{"id": null, "n": "0216009", "target": "#nkr_note_orig_0216009", "type": "orig", "text": "〔者〕－【甲】＊"}
{"id": null, "n": "0216010", "target": "#nkr_note_orig_0216010", "type": "orig", "text": "〔輪〕－【甲】"}
{"id": null, "n": "0216011", "target": "#nkr_note_orig_0216011", "type": "orig", "text": "破＝碾【甲】"}
{"id": null, "n": "0216012", "target": "#nkr_note_orig_0216012", "type": "orig", "text": "（寶）＋義【甲】"}
{"id": null, "n": "0216013", "target": "#nkr_note_orig_0216013", "type": "orig", "text": "〔合〕－【甲】"}
{"id": null, "n": "0216014", "target": "#nkr_note_orig_0216014", "type": "orig", "text": "〔也表〕－【甲】"}
{"id": null, "n": "0216015", "target": "#nkr_note_orig_0216015", "type": "orig", "text": "〔染〕－【甲】"}
{"id": null, "n": "0216016", "target": "#nkr_note_orig_0216016", "type": "orig", "text": "內＝外【甲】"}
{"id": null, "n": "0216017", "target": "#nkr_note_orig_0216017", "type": "orig", "text": "外＝內【甲】"}
{"id": null, "n": "0216018", "target": "#nkr_note_orig_0216018", "type": "orig", "text": "死＋（不住涅槃）【甲】"}
{"id": null, "n": "0216019", "target": "#nkr_note_orig_0216019", "type": "orig", "text": "持＝護【甲】"}
{"id": null, "n": "0216020", "target": "#nkr_note_orig_0216020", "type": "orig", "text": "雲＝皆運【甲】"}
{"id": null, "n": "0216021", "target": "#nkr_note_orig_0216021", "type": "orig", "text": "時＝則ィ【原】"}
{"id": null, "n": "0216022", "target": "#nkr_note_orig_0216022", "type": "orig", "text": "婆＝波【甲】"}
{"id": null, "n": "0216023", "target": "#nkr_note_orig_0216023", "type": "orig", "text": "〔四魔…淨〕六十三字－【甲】"}
{"id": null, "n": "0216024", "target": "#nkr_note_orig_0216024", "type": "orig", "text": "〔亦云…也〕七十字－【甲】"}
{"id": null, "n": "0216025", "target": "#nkr_note_orig_0216025", "type": "orig", "text": "〔之中得〕－ヵ【原】"}
{"id": null, "n": "0216026", "target": "#nkr_note_orig_0216026", "type": "orig", "text": "〔其吒…故〕三十一字－【甲】"}
{"id": null, "n": "0216027", "target": "#nkr_note_orig_0216027", "type": "orig", "text": "（字平）＋等【甲】"}
{"id": null, "n": "0216028", "target": "#nkr_note_orig_0216028", "type": "orig", "text": "〔即成…義〕十六字－【甲】"}
{"id": null, "n": "0216029", "target": "#nkr_note_orig_0216029", "type": "orig", "text": "以下至卷末甲本無"}
{"id": null, "n": "0216a1401", "target": "#nkr_note_add_0216a1401", "type": "add", "text": "嚩【CB】【卍續-CB】，囉【大】"}
{"id": null, "n": "0216c1501", "target": "#nkr_note_add_0216c1501", "type": "add", "text": "己【CB】，已【大】"}
