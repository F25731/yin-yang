{"id": null, "n": "0094004", "target": "#nkr_note_orig_0094004", "type": "orig", "text": "「實」，底本作「寶」，據甲本改。"}
{"id": null, "n": "0094005", "target": "#nkr_note_orig_0094005", "type": "orig", "text": "「實」，底本作「寶」，據甲本改。"}
{"id": null, "n": "0094006", "target": "#nkr_note_orig_0094006", "type": "orig", "text": "「於……不」二十字，底本不清，據甲本補。"}
{"id": null, "n": "0094007", "target": "#nkr_note_orig_0094007", "type": "orig", "text": "「是……身」六字，甲本無。「身」，底本不清，據《宣演》卷下補。"}
{"id": null, "n": "0095001", "target": "#nkr_note_orig_0095001", "type": "orig", "text": "「具……切」四十二字，底本不清，據甲本補。"}
{"id": null, "n": "0095002", "target": "#nkr_note_orig_0095002", "type": "orig", "text": "「豈」，底本無，據甲本補。"}
{"id": null, "n": "0095003", "target": "#nkr_note_orig_0095003", "type": "orig", "text": "「具……足」十五字，底本不清，據甲本補。"}
{"id": null, "n": "0095004", "target": "#nkr_note_orig_0095004", "type": "orig", "text": "「法」，甲本無。"}
{"id": null, "n": "0095005", "target": "#nkr_note_orig_0095005", "type": "orig", "text": "「惟」，底本作「唯」，據甲本改。"}
{"id": null, "n": "0095006", "target": "#nkr_note_orig_0095006", "type": "orig", "text": "「法……爾」四字，底本不清，據甲本補。"}
{"id": null, "n": "0096001", "target": "#nkr_note_orig_0096001", "type": "orig", "text": "「忘」，底本作「妄」，據甲本改。"}
{"id": null, "n": "0096002", "target": "#nkr_note_orig_0096002", "type": "orig", "text": "「法不名」三字，底本不清，據甲本補。"}
{"id": null, "n": "0096003", "target": "#nkr_note_orig_0096003", "type": "orig", "text": "「滅」，甲本作「泯」。"}
{"id": null, "n": "0096004", "target": "#nkr_note_orig_0096004", "type": "orig", "text": "「義」，底本不清，據甲本補。"}
{"id": null, "n": "0097001", "target": "#nkr_note_orig_0097001", "type": "orig", "text": "「稱……中」四字，底本不清，據甲本補。"}
{"id": null, "n": "0097002", "target": "#nkr_note_orig_0097002", "type": "orig", "text": "「故」，甲本無。"}
{"id": null, "n": "0097003", "target": "#nkr_note_orig_0097003", "type": "orig", "text": "「重」，《大正藏》本作「自」。"}
{"id": null, "n": "0097004", "target": "#nkr_note_orig_0097004", "type": "orig", "text": "「平等」二字，底本不清，據甲本補。"}
{"id": null, "n": "0097005", "target": "#nkr_note_orig_0097005", "type": "orig", "text": "「耳」，甲本作「爾」。"}
{"id": null, "n": "0098001", "target": "#nkr_note_orig_0098001", "type": "orig", "text": "「惟」，底本作「唯」，據甲本改。"}
{"id": null, "n": "0098002", "target": "#nkr_note_orig_0098002", "type": "orig", "text": "「本空」二字，底本不清，據甲本補。"}
{"id": null, "n": "0098003", "target": "#nkr_note_orig_0098003", "type": "orig", "text": "「說有我」三字，底本不清，據甲本補。"}
{"id": null, "n": "0099001", "target": "#nkr_note_orig_0099001", "type": "orig", "text": "「正」，甲本作「證」。"}
{"id": null, "n": "0099002", "target": "#nkr_note_orig_0099002", "type": "orig", "text": "「觀」，底本不清，據甲本補。"}
{"id": null, "n": "0099003", "target": "#nkr_note_orig_0099003", "type": "orig", "text": "「知」，甲、戊本脫。"}
{"id": null, "n": "0099004", "target": "#nkr_note_orig_0099004", "type": "orig", "text": "「應以」二字，底本不清，據甲本補。"}
{"id": null, "n": "0099005", "target": "#nkr_note_orig_0099005", "type": "orig", "text": "「此」，甲本作「以」。"}
{"id": null, "n": "0100001", "target": "#nkr_note_orig_0100001", "type": "orig", "text": "「邪」，底本作「耶」，據甲本改。"}
{"id": null, "n": "0100002", "target": "#nkr_note_orig_0100002", "type": "orig", "text": "「見如」二字，底本不清，據甲本補。"}
{"id": null, "n": "0100003", "target": "#nkr_note_orig_0100003", "type": "orig", "text": "「俓」字，《大正藏》本作「住」。此語本《老子》：「大道甚夷而民好俓。」《御注道德真經》作「民甚好俓」。"}
{"id": null, "n": "0100004", "target": "#nkr_note_orig_0100004", "type": "orig", "text": "「焉」字，《大正藏》本作「烏」。"}
{"id": null, "n": "0100005", "target": "#nkr_note_orig_0100005", "type": "orig", "text": "「有」下，底本原空三格。"}
{"id": null, "n": "0100006", "target": "#nkr_note_orig_0100006", "type": "orig", "text": "「不……二」七字，底本不清，據甲本補。"}
{"id": null, "n": "0100007", "target": "#nkr_note_orig_0100007", "type": "orig", "text": "「菩提」二字，底本不清，據甲本補。"}
{"id": null, "n": "0101001", "target": "#nkr_note_orig_0101001", "type": "orig", "text": "「道」，底本不清，戊本作「有」，據甲本補。"}
{"id": null, "n": "0101002", "target": "#nkr_note_orig_0101002", "type": "orig", "text": "「一切行」，底本不清，據甲本補。"}
{"id": null, "n": "0101003", "target": "#nkr_note_orig_0101003", "type": "orig", "text": "「故」，甲本作「是故」。"}
{"id": null, "n": "0101004", "target": "#nkr_note_orig_0101004", "type": "orig", "text": "「作是念」，底本不清，據甲本補。"}
{"id": null, "n": "0101005", "target": "#nkr_note_orig_0101005", "type": "orig", "text": "「何……發」四字，底本不清，據甲本補。"}
{"id": null, "n": "0101006", "target": "#nkr_note_orig_0101006", "type": "orig", "text": "「多羅」，底本不清，據甲本補。"}
{"id": null, "n": "0101007", "target": "#nkr_note_orig_0101007", "type": "orig", "text": "「恆……等」四字，底本不清，據甲本補。"}
{"id": null, "n": "0101008", "target": "#nkr_note_orig_0101008", "type": "orig", "text": "「彼」字，《大正藏》本作「居」。"}
{"id": null, "n": "0101009", "target": "#nkr_note_orig_0101009", "type": "orig", "text": "「忍」，甲本無。"}
{"id": null, "n": "0101010", "target": "#nkr_note_orig_0101010", "type": "orig", "text": "「施」，甲本無。"}
{"id": null, "n": "0101011", "target": "#nkr_note_orig_0101011", "type": "orig", "text": "「所」，甲本無。"}
{"id": null, "n": "0101012", "target": "#nkr_note_orig_0101012", "type": "orig", "text": "「知無有我」，底本作「知有我」，甲本左殘，《大正藏》本作「□無一我」，據諸本及文意改。"}
{"id": null, "n": "0102001", "target": "#nkr_note_orig_0102001", "type": "orig", "text": "「又遣」，甲本作「有遣」。"}
{"id": null, "n": "0102002", "target": "#nkr_note_orig_0102002", "type": "orig", "text": "甲本至此止。"}
{"id": null, "n": "0102003", "target": "#nkr_note_orig_0102003", "type": "orig", "text": "「□」，底本不清，疑為「云」。"}
{"id": null, "n": "0103001", "target": "#nkr_note_orig_0103001", "type": "orig", "text": "「□……□」四字，底本不清，疑為「來而無不」。"}
{"id": null, "n": "0103002", "target": "#nkr_note_orig_0103002", "type": "orig", "text": "「□」，底本不清，疑為「如」。"}
{"id": null, "n": "0103003", "target": "#nkr_note_orig_0103003", "type": "orig", "text": "「則……眾」五字，底本無，據《大正藏》及大谷餘乙二六補。"}
{"id": null, "n": "0104001", "target": "#nkr_note_orig_0104001", "type": "orig", "text": "「非」，底本不清，據己本補。"}
{"id": null, "n": "0105001", "target": "#nkr_note_orig_0105001", "type": "orig", "text": "「□」，己本作「見」。"}
{"id": null, "n": "0105002", "target": "#nkr_note_orig_0105002", "type": "orig", "text": "「勸」，戊本作「勤」。"}
{"id": null, "n": "0105003", "target": "#nkr_note_orig_0105003", "type": "orig", "text": "「定」，底本不清，據戊本補。"}
{"id": null, "n": "0105004", "target": "#nkr_note_orig_0105004", "type": "orig", "text": "「令」，戊本作「今」。"}
{"id": null, "n": "0105005", "target": "#nkr_note_orig_0105005", "type": "orig", "text": "「校」，戊本作「較」。"}
{"id": null, "n": "0106001", "target": "#nkr_note_orig_0106001", "type": "orig", "text": "「□□」，底本不清，疑為「甚深」。"}
{"id": null, "n": "0106002", "target": "#nkr_note_orig_0106002", "type": "orig", "text": "「□」，底本不清，疑為「行」。"}
{"id": null, "n": "0106003", "target": "#nkr_note_orig_0106003", "type": "orig", "text": "「開」，戊本作「開元」。"}
{"id": null, "n": "0107001", "target": "#nkr_note_orig_0107001", "type": "orig", "text": "「匠」，戊本及《房山石經題記彙編》作「近」。"}
{"id": null, "n": "0107002", "target": "#nkr_note_orig_0107002", "type": "orig", "text": "「正……夫」四字，底本不清，據戊本補。"}
{"id": null, "n": "0107003", "target": "#nkr_note_orig_0107003", "type": "orig", "text": "「戴」字，底本不清，戊本及《彙編》作「載」，據《舊唐書》卷六十四補。"}
{"id": null, "n": "0107004", "target": "#nkr_note_orig_0107004", "type": "orig", "text": "「□」，疑為「邃」。李道邃，中興初封戴國公，見《舊唐書》卷六十四。"}
{"id": null, "n": "0107005", "target": "#nkr_note_orig_0107005", "type": "orig", "text": "「揔淳」，即汝陽王璡，初名嗣恭，又名淳。不言揔淳之名，應據補史乘之闕。"}
{"id": null, "n": "0107006", "target": "#nkr_note_orig_0107006", "type": "orig", "text": "刻石第一面有捐刻題記如下：「順義郡市令李大師、母高、弟小師合家每年造經三條。天寶□…□。」"}
{"id": null, "n": "0096a1901", "target": "#nkr_note_add_0096a1901", "type": "add", "text": "己【CB】，已【藏外】"}
