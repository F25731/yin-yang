{"id": null, "n": "0040001", "target": "#nkr_note_orig_0040001", "type": "orig", "text": "吳夢麟：《房山石經本〈唐玄宗御注金剛經〉整理記》，載《世界宗教研究》，1982年第2期。"}
{"id": null, "n": "0040002", "target": "#nkr_note_orig_0040002", "type": "orig", "text": "吳夢麟：《房山石經本〈唐玄宗御注金剛經〉整理記》，載《世界宗教研究》，1982年第2期。"}
{"id": null, "n": "0041001", "target": "#nkr_note_orig_0041001", "type": "orig", "text": "《房山石經研究（二）》，中國佛教文化出版有限公司（香港），1999。"}
{"id": null, "n": "0041002", "target": "#nkr_note_orig_0041002", "type": "orig", "text": "《房山石經題記彙編》，北京，書目文獻出版社，1987。"}
{"id": null, "n": "0041003", "target": "#nkr_note_orig_0041003", "type": "orig", "text": "氣賀澤保規編：《房山石經山洞窟所藏隋唐石經一覽表》，載《中國佛教石經研究——以房山雲居寺石經為中心》，京都大學學術出版會，1996。"}
{"id": null, "n": "0044001", "target": "#nkr_note_orig_0044001", "type": "orig", "text": "「家」，戊本作「象」，據己本改。"}
{"id": null, "n": "0045001", "target": "#nkr_note_orig_0045001", "type": "orig", "text": "「□」，戊本作「意」。"}
{"id": null, "n": "0045002", "target": "#nkr_note_orig_0045002", "type": "orig", "text": "「□」，底本不清。可辨認出草字頭，戊本作「若」。"}
{"id": null, "n": "0045003", "target": "#nkr_note_orig_0045003", "type": "orig", "text": "「理」，乙本自此始。"}
{"id": null, "n": "0045004", "target": "#nkr_note_orig_0045004", "type": "orig", "text": "「金……煩惱」十六字，底本不清，據乙本及道氤《御注金剛般若波羅蜜經宣演敘》錄文。"}
{"id": null, "n": "0045005", "target": "#nkr_note_orig_0045005", "type": "orig", "text": "「而……降」十六字，底本不清，據乙本及道氤《御注金剛般若波羅蜜經宣演敘》補。"}
{"id": null, "n": "0046001", "target": "#nkr_note_orig_0046001", "type": "orig", "text": "「衛……食」五字，底本不清，據乙本補。"}
{"id": null, "n": "0046002", "target": "#nkr_note_orig_0046002", "type": "orig", "text": "「齋……求」七字，底本不清，據乙本補。"}
{"id": null, "n": "0046003", "target": "#nkr_note_orig_0046003", "type": "orig", "text": "「以……鉢」七字，底本不清，據乙本補。"}
{"id": null, "n": "0046004", "target": "#nkr_note_orig_0046004", "type": "orig", "text": "「其」，乙本至此至。"}
{"id": null, "n": "0046005", "target": "#nkr_note_orig_0046005", "type": "orig", "text": "「□」，底本不清，戊本作「起」。"}
{"id": null, "n": "0046006", "target": "#nkr_note_orig_0046006", "type": "orig", "text": "「熟」，底本作「孰」，據文意改。"}
{"id": null, "n": "0048001", "target": "#nkr_note_orig_0048001", "type": "orig", "text": "「檀」，底本作「壇」，據文意改。"}
{"id": null, "n": "0050001", "target": "#nkr_note_orig_0050001", "type": "orig", "text": "「因」，底本不清，據己本補。"}
{"id": null, "n": "0050002", "target": "#nkr_note_orig_0050002", "type": "orig", "text": "「疑」，當作「凝」。"}
{"id": null, "n": "0050003", "target": "#nkr_note_orig_0050003", "type": "orig", "text": "「見諸」，底本不清，據甲本補。甲本自此始。"}
{"id": null, "n": "0050004", "target": "#nkr_note_orig_0050004", "type": "orig", "text": "「矣」，甲本作「矣也」。此類異同，以下不再出校。"}
{"id": null, "n": "0050005", "target": "#nkr_note_orig_0050005", "type": "orig", "text": "「□」，底本不清。戊本作「相」。"}
{"id": null, "n": "0050006", "target": "#nkr_note_orig_0050006", "type": "orig", "text": "「□」，底本不清。己本作「理」。"}
{"id": null, "n": "0051001", "target": "#nkr_note_orig_0051001", "type": "orig", "text": "「般若深宗」，底本不清，戊本作「河谷深空」，據甲本補。"}
{"id": null, "n": "0051002", "target": "#nkr_note_orig_0051002", "type": "orig", "text": "「即」，底本不清，據甲本補。"}
{"id": null, "n": "0051003", "target": "#nkr_note_orig_0051003", "type": "orig", "text": "「應」，底本不清，據甲本補。"}
{"id": null, "n": "0052001", "target": "#nkr_note_orig_0052001", "type": "orig", "text": "「具……故」五字，底本不清，據甲本補。"}
{"id": null, "n": "0052002", "target": "#nkr_note_orig_0052002", "type": "orig", "text": "「悉見知」三字，底本不清，據甲本補。"}
{"id": null, "n": "0052003", "target": "#nkr_note_orig_0052003", "type": "orig", "text": "「淨……兩」九字，底本不清，據甲本補。"}
{"id": null, "n": "0052004", "target": "#nkr_note_orig_0052004", "type": "orig", "text": "「信」，甲本無。"}
{"id": null, "n": "0052005", "target": "#nkr_note_orig_0052005", "type": "orig", "text": "「則……眾」六字，底本不清，據甲本補。"}
{"id": null, "n": "0052006", "target": "#nkr_note_orig_0052006", "type": "orig", "text": "「何以」，底本不清，據甲本補。"}
{"id": null, "n": "0052007", "target": "#nkr_note_orig_0052007", "type": "orig", "text": "「故」，底本不清，據文意補。"}
{"id": null, "n": "0053001", "target": "#nkr_note_orig_0053001", "type": "orig", "text": "「不應取法」，底本無，甲本作「法」，據《大正藏》本補。"}
{"id": null, "n": "0053002", "target": "#nkr_note_orig_0053002", "type": "orig", "text": "「滯」，底本不清，據甲本補。"}
{"id": null, "n": "0053003", "target": "#nkr_note_orig_0053003", "type": "orig", "text": "「著」，底本不清，據甲本補。"}
{"id": null, "n": "0053004", "target": "#nkr_note_orig_0053004", "type": "orig", "text": "「忘」字，底本作「妄」，據甲本改。"}
{"id": null, "n": "0053005", "target": "#nkr_note_orig_0053005", "type": "orig", "text": "丙本自此始。較小殘片，不註結尾。"}
{"id": null, "n": "0053006", "target": "#nkr_note_orig_0053006", "type": "orig", "text": "「見」，底本作「法」，據甲、丙本改。"}
{"id": null, "n": "0053007", "target": "#nkr_note_orig_0053007", "type": "orig", "text": "「□」，底本不清，戊本作「留」。"}
{"id": null, "n": "0053008", "target": "#nkr_note_orig_0053008", "type": "orig", "text": "「何……多」七字，底本不清，據甲、丙本補。"}
{"id": null, "n": "0054001", "target": "#nkr_note_orig_0054001", "type": "orig", "text": "「正道」，底本不清，據甲本補。"}
{"id": null, "n": "0054002", "target": "#nkr_note_orig_0054002", "type": "orig", "text": "「□…□」，己本作「□默□…□」。"}
{"id": null, "n": "0054003", "target": "#nkr_note_orig_0054003", "type": "orig", "text": "「悟……佛」十字，底本不清，據甲本補。"}
{"id": null, "n": "0054004", "target": "#nkr_note_orig_0054004", "type": "orig", "text": "「嘗」，甲本作「當」。"}
{"id": null, "n": "0054005", "target": "#nkr_note_orig_0054005", "type": "orig", "text": "「無……乘」十字，底本不清，據甲本補。"}
{"id": null, "n": "0055001", "target": "#nkr_note_orig_0055001", "type": "orig", "text": "「則……已」十字，底本不清，據甲本補。"}
{"id": null, "n": "0055002", "target": "#nkr_note_orig_0055002", "type": "orig", "text": "「珍……滿」六字，底本不清，據甲本補。"}
{"id": null, "n": "0055003", "target": "#nkr_note_orig_0055003", "type": "orig", "text": "「之……多」六字，底本不清，據甲本補。"}
{"id": null, "n": "0056001", "target": "#nkr_note_orig_0056001", "type": "orig", "text": "「福……功」十二字，底本不清，據甲本補。"}
{"id": null, "n": "0056002", "target": "#nkr_note_orig_0056002", "type": "orig", "text": "「生……於」十二字，底本不清，據甲本補。"}
{"id": null, "n": "0056003", "target": "#nkr_note_orig_0056003", "type": "orig", "text": "明朱棣《金剛經集注》引玄宗皇帝注作「三千七寶雖多，用盡還歸正滅；四句經文雖少，悟之直至菩提」。"}
{"id": null, "n": "0056004", "target": "#nkr_note_orig_0056004", "type": "orig", "text": "「佛」，丁本自此始。較小殘片，不註結尾。"}
{"id": null, "n": "0056005", "target": "#nkr_note_orig_0056005", "type": "orig", "text": "「者」，甲本無。"}
{"id": null, "n": "0056006", "target": "#nkr_note_orig_0056006", "type": "orig", "text": "「空……法」五字，底本不清，據甲本補。"}
{"id": null, "n": "0056007", "target": "#nkr_note_orig_0056007", "type": "orig", "text": "「空」，底本不清，甲本無，據丁本補。"}
{"id": null, "n": "0056008", "target": "#nkr_note_orig_0056008", "type": "orig", "text": "「由」，底本不清，據甲、丁本補。"}
{"id": null, "n": "0056009", "target": "#nkr_note_orig_0056009", "type": "orig", "text": "「非……法」七字，底本不清，據甲本補。"}
{"id": null, "n": "0057001", "target": "#nkr_note_orig_0057001", "type": "orig", "text": "「香……名」六字，底本不清，據甲本補。"}
{"id": null, "n": "0057002", "target": "#nkr_note_orig_0057002", "type": "orig", "text": "「流」，底本作「流故」，據甲本刪。"}
{"id": null, "n": "0057003", "target": "#nkr_note_orig_0057003", "type": "orig", "text": "「之」，戊本脫。"}
{"id": null, "n": "0058001", "target": "#nkr_note_orig_0058001", "type": "orig", "text": "「人……念」七字，底本不清，據甲本補。"}
{"id": null, "n": "0058002", "target": "#nkr_note_orig_0058002", "type": "orig", "text": "「何……含」六字，底本不清，據甲本補。"}
{"id": null, "n": "0059001", "target": "#nkr_note_orig_0059001", "type": "orig", "text": "「是……念」八字，底本不清，戊本缺，據甲本補。"}
{"id": null, "n": "0059002", "target": "#nkr_note_orig_0059002", "type": "orig", "text": "「何……實」四字，底本不清，據甲本補。"}
{"id": null, "n": "0059003", "target": "#nkr_note_orig_0059003", "type": "orig", "text": "「有」，底本無，據甲本補。"}
{"id": null, "n": "0059004", "target": "#nkr_note_orig_0059004", "type": "orig", "text": "「漢……者」十九字，底本不清，據甲本補。"}
{"id": null, "n": "0059005", "target": "#nkr_note_orig_0059005", "type": "orig", "text": "「若……漢」三十一字，底本不清，戊本缺，據甲本。"}
{"id": null, "n": "0059006", "target": "#nkr_note_orig_0059006", "type": "orig", "text": "「世……三」九字，底本不清，據甲本補。"}
{"id": null, "n": "0059007", "target": "#nkr_note_orig_0059007", "type": "orig", "text": "「觀」下，原空一字。"}
{"id": null, "n": "0059008", "target": "#nkr_note_orig_0059008", "type": "orig", "text": "「善……故」二十五字，底本不清，據甲本補。"}
{"id": null, "n": "0059009", "target": "#nkr_note_orig_0059009", "type": "orig", "text": "「受」，底本作「愛」，據文意改。"}
{"id": null, "n": "0059010", "target": "#nkr_note_orig_0059010", "type": "orig", "text": "「一……為」十二字，底本不清，據甲本補。"}
{"id": null, "n": "0060001", "target": "#nkr_note_orig_0060001", "type": "orig", "text": "「我……羅」十一字，底本不清，戊本缺，據甲本補。"}
{"id": null, "n": "0060002", "target": "#nkr_note_orig_0060002", "type": "orig", "text": "「我……得」十七字，底本不清，戊本缺，據甲本補。"}
{"id": null, "n": "0060003", "target": "#nkr_note_orig_0060003", "type": "orig", "text": "「世……不」十七字，底本不清，據甲本補。"}
{"id": null, "n": "0060004", "target": "#nkr_note_orig_0060004", "type": "orig", "text": "「道……著」四字，底本不清，據甲本補。"}
{"id": null, "n": "0060005", "target": "#nkr_note_orig_0060005", "type": "orig", "text": "「諍」，底本作「淨」，據甲本改。"}
{"id": null, "n": "0060006", "target": "#nkr_note_orig_0060006", "type": "orig", "text": "「行……相」九字，底本不清，據甲本補。"}
{"id": null, "n": "0060007", "target": "#nkr_note_orig_0060007", "type": "orig", "text": "「佛……所」二十一字，底本不清，據甲本補。"}
{"id": null, "n": "0060008", "target": "#nkr_note_orig_0060008", "type": "orig", "text": "「故」，底本不清，據甲本補。"}
{"id": null, "n": "0061001", "target": "#nkr_note_orig_0061001", "type": "orig", "text": "「記」，底本不清，據甲本補。"}
{"id": null, "n": "0061002", "target": "#nkr_note_orig_0061002", "type": "orig", "text": "「性」，底本作「心」，據甲本改。"}
{"id": null, "n": "0061003", "target": "#nkr_note_orig_0061003", "type": "orig", "text": "「云……莊」五字，底本不清，據甲本補。"}
{"id": null, "n": "0061004", "target": "#nkr_note_orig_0061004", "type": "orig", "text": "「土」底本不清，據甲本補。"}
{"id": null, "n": "0061005", "target": "#nkr_note_orig_0061005", "type": "orig", "text": "「菩……土」十二字，底本不清，據甲本補。"}
{"id": null, "n": "0061006", "target": "#nkr_note_orig_0061006", "type": "orig", "text": "「尊……嚴」六字，底本不清，據甲本補。"}
{"id": null, "n": "0061007", "target": "#nkr_note_orig_0061007", "type": "orig", "text": "「非」字，底本不清，據甲本補。"}
{"id": null, "n": "0061008", "target": "#nkr_note_orig_0061008", "type": "orig", "text": "「示」字，《大正藏》本誤作「亦」。"}
{"id": null, "n": "0062001", "target": "#nkr_note_orig_0062001", "type": "orig", "text": "「住」，底本不清，據甲本。"}
{"id": null, "n": "0062002", "target": "#nkr_note_orig_0062002", "type": "orig", "text": "「住……香」三字，底本不清，據甲本補。"}
{"id": null, "n": "0062003", "target": "#nkr_note_orig_0062003", "type": "orig", "text": "「修……應」十一字，底本不清，據甲本補。"}
{"id": null, "n": "0062004", "target": "#nkr_note_orig_0062004", "type": "orig", "text": "「竟」，甲本作「境」，下同。"}
{"id": null, "n": "0062005", "target": "#nkr_note_orig_0062005", "type": "orig", "text": "「故……等」九字，底本不清，據甲本補。"}
{"id": null, "n": "0062006", "target": "#nkr_note_orig_0062006", "type": "orig", "text": "「清」，底本不清，據甲本補。"}
{"id": null, "n": "0062007", "target": "#nkr_note_orig_0062007", "type": "orig", "text": "「果」，底本作「累」，據甲本改。"}
{"id": null, "n": "0062008", "target": "#nkr_note_orig_0062008", "type": "orig", "text": "「故於無所住」，底本無，據甲本補。"}
{"id": null, "n": "0062009", "target": "#nkr_note_orig_0062009", "type": "orig", "text": "「身相」，底本不清，據甲本補。"}
{"id": null, "n": "0062010", "target": "#nkr_note_orig_0062010", "type": "orig", "text": "「不……相」六字，底本不清，據甲本補。"}
{"id": null, "n": "0063001", "target": "#nkr_note_orig_0063001", "type": "orig", "text": "「之問」，底本不清，據甲本補。"}
{"id": null, "n": "0063002", "target": "#nkr_note_orig_0063002", "type": "orig", "text": "「須」，底本不清，據甲本補。"}
{"id": null, "n": "0063003", "target": "#nkr_note_orig_0063003", "type": "orig", "text": "「材」，底本作「林」，據甲本改。"}
{"id": null, "n": "0063004", "target": "#nkr_note_orig_0063004", "type": "orig", "text": "「多不」，底本不清，據甲本補。"}
{"id": null, "n": "0063005", "target": "#nkr_note_orig_0063005", "type": "orig", "text": "「以」，底本不清，據甲本補。"}
{"id": null, "n": "0063006", "target": "#nkr_note_orig_0063006", "type": "orig", "text": "「數於河河」，底本不清，據甲本補。"}
{"id": null, "n": "0063007", "target": "#nkr_note_orig_0063007", "type": "orig", "text": "「數為多」，底本不清，據甲本補。"}
{"id": null, "n": "0064001", "target": "#nkr_note_orig_0064001", "type": "orig", "text": "「章……少」四字，底本不清，據甲本補。"}
{"id": null, "n": "0064002", "target": "#nkr_note_orig_0064002", "type": "orig", "text": "「量……級」五字，底本不清，據甲本補。"}
{"id": null, "n": "0064003", "target": "#nkr_note_orig_0064003", "type": "orig", "text": "「等……皆」三字，底本不清，據甲本補。"}
{"id": null, "n": "0065001", "target": "#nkr_note_orig_0065001", "type": "orig", "text": "「此……處」八字，底本不清，據甲本補。"}
{"id": null, "n": "0065002", "target": "#nkr_note_orig_0065002", "type": "orig", "text": "「法……少」八字，底本不清，據甲本補。"}
{"id": null, "n": "0065003", "target": "#nkr_note_orig_0065003", "type": "orig", "text": "「猶」字，底本作「由」，據甲本改。"}
{"id": null, "n": "0065004", "target": "#nkr_note_orig_0065004", "type": "orig", "text": "「世」，底本不清，據甲本補。"}
{"id": null, "n": "0065005", "target": "#nkr_note_orig_0065005", "type": "orig", "text": "「欲……義」四字，底本不清，據甲本補。"}
{"id": null, "n": "0065006", "target": "#nkr_note_orig_0065006", "type": "orig", "text": "「正……障」十字，底本不清，據甲本補。"}
{"id": null, "n": "0065007", "target": "#nkr_note_orig_0065007", "type": "orig", "text": "「故……量」七字，底本不清，據甲本補。"}
{"id": null, "n": "0065008", "target": "#nkr_note_orig_0065008", "type": "orig", "text": "「循」，底本作「脩」，據甲本改。"}
{"id": null, "n": "0065009", "target": "#nkr_note_orig_0065009", "type": "orig", "text": "「須……佛」四字，底本不清，據甲本補。"}
{"id": null, "n": "0066001", "target": "#nkr_note_orig_0066001", "type": "orig", "text": "「般……惱」九字，底本不清，據甲本補。"}
{"id": null, "n": "0066002", "target": "#nkr_note_orig_0066002", "type": "orig", "text": "「不……成」十字，底本不清，據甲本補。"}
{"id": null, "n": "0066003", "target": "#nkr_note_orig_0066003", "type": "orig", "text": "「前……明」八字，底本不清，據甲本補。"}
{"id": null, "n": "0066004", "target": "#nkr_note_orig_0066004", "type": "orig", "text": "「非……義」十字，底本不清，據甲本補。"}
{"id": null, "n": "0066005", "target": "#nkr_note_orig_0066005", "type": "orig", "text": "「如……所」四字，底本不清，據甲本。"}
{"id": null, "n": "0066006", "target": "#nkr_note_orig_0066006", "type": "orig", "text": "「知」，甲本先作「如」，後改「知」。《大正藏》本誤作「如」。"}
{"id": null, "n": "0066007", "target": "#nkr_note_orig_0066007", "type": "orig", "text": "「昧……道」四字，底本不清，據甲本補。"}
{"id": null, "n": "0066008", "target": "#nkr_note_orig_0066008", "type": "orig", "text": "「夜」下殘缺一字，疑當為「間」字。《楞伽經》偈：「我某夜成道，至某夜涅槃，於此二中間，我都無所說。」"}
{"id": null, "n": "0066009", "target": "#nkr_note_orig_0066009", "type": "orig", "text": "「故……說」十一字，底本不清，據甲本補。"}
{"id": null, "n": "0067001", "target": "#nkr_note_orig_0067001", "type": "orig", "text": "「須……意」五字，底本不清，據甲本補。"}
{"id": null, "n": "0067002", "target": "#nkr_note_orig_0067002", "type": "orig", "text": "「世尊」，底本不清，據甲本補。"}
{"id": null, "n": "0067003", "target": "#nkr_note_orig_0067003", "type": "orig", "text": "「前……空」十二字，底本不清，據甲本補。"}
{"id": null, "n": "0067004", "target": "#nkr_note_orig_0067004", "type": "orig", "text": "「須……名」十四字，底本不清，據甲本補。"}
{"id": null, "n": "0067005", "target": "#nkr_note_orig_0067005", "type": "orig", "text": "「散……本」十三字，底本不清，據甲本補。"}
{"id": null, "n": "0067006", "target": "#nkr_note_orig_0067006", "type": "orig", "text": "「於……界」二十四字，底本不清，據甲本補。"}
{"id": null, "n": "0067007", "target": "#nkr_note_orig_0067007", "type": "orig", "text": "「不……尊」五字，底本不清，據甲本補。"}
{"id": null, "n": "0067008", "target": "#nkr_note_orig_0067008", "type": "orig", "text": "「不……來」十一字，底、甲本無，據《大正藏》本及大谷餘乙二六補。"}
{"id": null, "n": "0067009", "target": "#nkr_note_orig_0067009", "type": "orig", "text": "「法……佛」四十字，底本不清，據甲本補。"}
