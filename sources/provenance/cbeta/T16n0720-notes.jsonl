{"id": null, "n": "0856025", "target": "#nkr_note_orig_0856025", "type": "orig", "text": "㾽＝贅【元】【明】，癰【宮】"}
{"id": null, "n": "0856026", "target": "#nkr_note_orig_0856026", "type": "orig", "text": "十八＝依止【宮】"}
{"id": null, "n": "0856027", "target": "#nkr_note_orig_0856027", "type": "orig", "text": "〔欲〕－【三】【宮】"}
{"id": null, "n": "0857001", "target": "#nkr_note_orig_0857001", "type": "orig", "text": "以＝已【三】【宮】"}
{"id": null, "n": "0857002", "target": "#nkr_note_orig_0857002", "type": "orig", "text": "焚＝炎【明】"}
{"id": null, "n": "0857003", "target": "#nkr_note_orig_0857003", "type": "orig", "text": "宣＝揎【宋】【元】，捋【明】"}
{"id": null, "n": "0857004", "target": "#nkr_note_orig_0857004", "type": "orig", "text": "毘紐＝毘沙紐【宋】【明】【宮】，毘沙細【元】"}
{"id": null, "n": "0857005", "target": "#nkr_note_orig_0857005", "type": "orig", "text": "制控＝控制【三】【宮】"}
{"id": null, "n": "0857006", "target": "#nkr_note_orig_0857006", "type": "orig", "text": "耗＝㧌【三】【宮】"}
{"id": null, "n": "0857007", "target": "#nkr_note_orig_0857007", "type": "orig", "text": "發起＝起發【三】【宮】"}
{"id": null, "n": "0857008", "target": "#nkr_note_orig_0857008", "type": "orig", "text": "欻＝熾【三】"}
{"id": null, "n": "0857009", "target": "#nkr_note_orig_0857009", "type": "orig", "text": "摩＝魔【三】【宮】"}
{"id": null, "n": "0857010", "target": "#nkr_note_orig_0857010", "type": "orig", "text": "葉＝業【三】【宮】"}
{"id": null, "n": "0857011", "target": "#nkr_note_orig_0857011", "type": "orig", "text": "空中＝室中【三】【宮】＊"}
{"id": null, "n": "0857012", "target": "#nkr_note_orig_0857012", "type": "orig", "text": "迴覆＝洄覆【三】＊，洄𭳱【宮】＊"}
{"id": null, "n": "0857013", "target": "#nkr_note_orig_0857013", "type": "orig", "text": "糧米＝粳米【宮】"}
{"id": null, "n": "0857014", "target": "#nkr_note_orig_0857014", "type": "orig", "text": "此＝是【三】【宮】"}
{"id": null, "n": "0857015", "target": "#nkr_note_orig_0857015", "type": "orig", "text": "拔＝跋【三】【宮】"}
{"id": null, "n": "0857016", "target": "#nkr_note_orig_0857016", "type": "orig", "text": "無明羅剎集卷下＝佛說無明羅剎經卷下【宋】【元】，無日羅剎經卷下【明】，佛說無明羅剎經下卷【宮】"}
{"id": null, "n": "0857017", "target": "#nkr_note_orig_0857017", "type": "orig", "text": "下＋（目錄二卷此併一卷）夾註【宋】【元】"}
{"id": null, "n": "0850b1101", "target": "#nkr_note_add_0850b1101", "type": "add", "text": "瞖【CB】【麗-CB】，翳【大】"}
{"id": null, "n": "0850c2101", "target": "#nkr_note_add_0850c2101", "type": "add", "text": "刺【CB】，剌【大】"}
{"id": null, "n": "0851c2901", "target": "#nkr_note_add_0851c2901", "type": "add", "text": "燒【CB】【麗-CB】，繞【大】"}
{"id": null, "n": "0854a0601", "target": "#nkr_note_add_0854a0601", "type": "add", "text": "受【大】【磧-CB】，愛【麗-CB】"}
{"id": null, "n": "0855a1901", "target": "#nkr_note_add_0855a1901", "type": "add", "text": "己【CB】，已【大】"}
{"id": null, "n": "0856a2401", "target": "#nkr_note_add_0856a2401", "type": "add", "text": "繞【CB】【麗-CB】，遶【大】"}
{"id": null, "n": "0856b1701", "target": "#nkr_note_add_0856b1701", "type": "add", "text": "于【CB】，干【大】"}
{"id": null, "n": "0856c2901", "target": "#nkr_note_add_0856c2901", "type": "add", "text": "軟【大】【磧-CB】，懦【麗-CB】"}
{"id": null, "n": "0857a0901", "target": "#nkr_note_add_0857a0901", "type": "add", "text": "摩【CB】【麗-CB】，魔【大】"}
