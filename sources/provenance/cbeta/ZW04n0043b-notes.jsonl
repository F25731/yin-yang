{"id": null, "n": "0378004", "target": "#nkr_note_orig_0378004", "type": "orig", "text": "「一卷」，底、乙本缺，據甲本補。"}
{"id": null, "n": "0378005", "target": "#nkr_note_orig_0378005", "type": "orig", "text": "「新……中」十二字，甲本無。"}
{"id": null, "n": "0378006", "target": "#nkr_note_orig_0378006", "type": "orig", "text": "「佛」，底本無，據乙本補。"}
{"id": null, "n": "0378007", "target": "#nkr_note_orig_0378007", "type": "orig", "text": "乙本至此止。"}
{"id": null, "n": "0379001", "target": "#nkr_note_orig_0379001", "type": "orig", "text": "「之」，底本作「之之」，據文意刪。"}
{"id": null, "n": "0379002", "target": "#nkr_note_orig_0379002", "type": "orig", "text": "「之時」，甲本無。"}
{"id": null, "n": "0379003", "target": "#nkr_note_orig_0379003", "type": "orig", "text": "「子」，底本作「女」，據甲本改。"}
{"id": null, "n": "0379004", "target": "#nkr_note_orig_0379004", "type": "orig", "text": "「言」，甲本作「白佛言」。"}
{"id": null, "n": "0379005", "target": "#nkr_note_orig_0379005", "type": "orig", "text": "「得」，底本作「莫」，據甲本改。"}
{"id": null, "n": "0379006", "target": "#nkr_note_orig_0379006", "type": "orig", "text": "「經」，甲本無。"}
{"id": null, "n": "0380001", "target": "#nkr_note_orig_0380001", "type": "orig", "text": "「比」，底本作「比比」，據文意刪。"}
{"id": null, "n": "0380002", "target": "#nkr_note_orig_0380002", "type": "orig", "text": "「廂」，底、甲本作「葙」，據文意改。"}
{"id": null, "n": "0380003", "target": "#nkr_note_orig_0380003", "type": "orig", "text": "「匠」，甲本作「師匠」。"}
{"id": null, "n": "0380004", "target": "#nkr_note_orig_0380004", "type": "orig", "text": "「不」，底本缺，據甲本補。"}
{"id": null, "n": "0380005", "target": "#nkr_note_orig_0380005", "type": "orig", "text": "「如」，甲本作「而」。"}
{"id": null, "n": "0380006", "target": "#nkr_note_orig_0380006", "type": "orig", "text": "「功少」，《諸經要集》卷八、《法苑珠林》卷三三引此經均作「少功」，見《大正藏》第54卷第75頁下、第53卷第540頁上。"}
{"id": null, "n": "0380007", "target": "#nkr_note_orig_0380007", "type": "orig", "text": "「坐」，《諸經要集》卷八、《法苑珠林》卷三三引此經作「罪」，見《大正藏》第54卷第75頁下、第53卷第540頁上。"}
{"id": null, "n": "0381001", "target": "#nkr_note_orig_0381001", "type": "orig", "text": "「造」，甲本作「寫」。"}
{"id": null, "n": "0381002", "target": "#nkr_note_orig_0381002", "type": "orig", "text": "「其」，底本無，據甲本補。"}
{"id": null, "n": "0381003", "target": "#nkr_note_orig_0381003", "type": "orig", "text": "「德」，底本無，據甲本補。"}
{"id": null, "n": "0381004", "target": "#nkr_note_orig_0381004", "type": "orig", "text": "「子」，底本無，據甲本補。"}
{"id": null, "n": "0381005", "target": "#nkr_note_orig_0381005", "type": "orig", "text": "「以」，底本作「已」，據甲本改。"}
{"id": null, "n": "0382001", "target": "#nkr_note_orig_0382001", "type": "orig", "text": "「於」，底本作「余」，甲本作「餘」，據文意改。"}
{"id": null, "n": "0382002", "target": "#nkr_note_orig_0382002", "type": "orig", "text": "「訖」，底本作「說」，据甲本改。"}
{"id": null, "n": "0382003", "target": "#nkr_note_orig_0382003", "type": "orig", "text": "「又」，底本作「有」，據甲本改。"}
{"id": null, "n": "0382004", "target": "#nkr_note_orig_0382004", "type": "orig", "text": "「假」，甲本作「用」。"}
{"id": null, "n": "0382005", "target": "#nkr_note_orig_0382005", "type": "orig", "text": "「實」，底、甲本作「寶」，據文意改。"}
{"id": null, "n": "0382006", "target": "#nkr_note_orig_0382006", "type": "orig", "text": "「物」，底本缺，據文意補。"}
{"id": null, "n": "0382007", "target": "#nkr_note_orig_0382007", "type": "orig", "text": "「無」，底本作「望」，據甲本改。"}
{"id": null, "n": "0382008", "target": "#nkr_note_orig_0382008", "type": "orig", "text": "「飢」，甲本作「在飢」。"}
{"id": null, "n": "0383001", "target": "#nkr_note_orig_0383001", "type": "orig", "text": "「又」，底本作「有」，據文意改。"}
{"id": null, "n": "0383002", "target": "#nkr_note_orig_0383002", "type": "orig", "text": "「以」，底本作「已」，據文意改。"}
{"id": null, "n": "0383003", "target": "#nkr_note_orig_0383003", "type": "orig", "text": "「祝」，底本作「況」，據文意改。"}
{"id": null, "n": "0383004", "target": "#nkr_note_orig_0383004", "type": "orig", "text": "「合□□相□□就，不遠地獄」，底本缺，據甲本補。"}
{"id": null, "n": "0383005", "target": "#nkr_note_orig_0383005", "type": "orig", "text": "「五」前，甲本有「□□字顛□重字著點」。"}
{"id": null, "n": "0383006", "target": "#nkr_note_orig_0383006", "type": "orig", "text": "「萬」，據甲本補。"}
{"id": null, "n": "0383007", "target": "#nkr_note_orig_0383007", "type": "orig", "text": "「迷惑道」，甲本作「地獄」。"}
{"id": null, "n": "0383008", "target": "#nkr_note_orig_0383008", "type": "orig", "text": "「善男子，經生之法……正法」二十八字，底本缺，據《諸經要集》卷二、《法苑珠林》卷一七引此經補，「乙」或作「二」、「一」，見《大正藏》第54卷第15頁中、第53卷第415頁下。"}
{"id": null, "n": "0383009", "target": "#nkr_note_orig_0383009", "type": "orig", "text": "「若……者」九字，底本缺，據《諸經要集》卷八、《法苑琳林》卷三三引此經補，見《大正藏》第54卷第75頁下、第53卷第540頁上。"}
{"id": null, "n": "0384001", "target": "#nkr_note_orig_0384001", "type": "orig", "text": "「中」，底本缺，據《諸經要集》卷八、《法苑珠林》卷三三引此經補，見《大正藏》第54卷第75頁上、第53卷第540頁上。"}
{"id": null, "n": "0384002", "target": "#nkr_note_orig_0384002", "type": "orig", "text": "「昇」下甲本有「善男子、經主、象主師□…□」，底本無。"}
{"id": null, "n": "0384003", "target": "#nkr_note_orig_0384003", "type": "orig", "text": "「大」，底本缺，據隋開皇九年碑刻本《囑累經》補。"}
{"id": null, "n": "0386001", "target": "#nkr_note_orig_0386001", "type": "orig", "text": "見《諸經要集》序，《大正藏》第54卷第1頁上。"}
{"id": null, "n": "0387001", "target": "#nkr_note_orig_0387001", "type": "orig", "text": "《眾經目錄》卷七，《大正藏》第55卷第149頁上。"}
{"id": null, "n": "0387002", "target": "#nkr_note_orig_0387002", "type": "orig", "text": "《法經錄》卷二，《大正藏》第55卷第126頁中、第127頁上。"}
{"id": null, "n": "0387003", "target": "#nkr_note_orig_0387003", "type": "orig", "text": "智昇整理諸錄疑偽經時，列出《法經錄》首見的八十部一百四十一卷，殆是此類，《敬福經》亦在其中，見《開元釋教錄》卷十八，《大正藏》第55卷第676頁上～677頁上。"}
{"id": null, "n": "0388001", "target": "#nkr_note_orig_0388001", "type": "orig", "text": "《法經錄》卷二，《大正藏》第55卷第126頁下、第126頁中。"}
{"id": null, "n": "0388002", "target": "#nkr_note_orig_0388002", "type": "orig", "text": "《法經錄》卷四，《大正藏》第55卷第138頁中～下。"}
{"id": null, "n": "0388003", "target": "#nkr_note_orig_0388003", "type": "orig", "text": "小野玄妙：《佛教經典總論》第457頁上，《佛書解說大辭典》別卷。"}
{"id": null, "n": "0390001", "target": "#nkr_note_orig_0390001", "type": "orig", "text": "見《大正藏》第55卷第475頁上～476頁上。"}
{"id": null, "n": "0390001", "target": "#nkr_note_mod_0390001", "type": "mod", "text": "見《大正藏》第55卷第475頁上【藏外】，～476頁上。"}
{"id": null, "n": "0390002", "target": "#nkr_note_orig_0390002", "type": "orig", "text": "如佛授記寺、福先寺、長壽寺、太平寺、大雲寺均見《唐兩京城坊考》卷五東京，天宮寺、白馬寺見《唐兩京城坊考校補記》卷五東京下。"}
{"id": null, "n": "0390003", "target": "#nkr_note_orig_0390003", "type": "orig", "text": "見方廣錩：《八～十世紀佛教大藏經史》附錄一，第392頁、第402頁，中國社會科學出版社，1991年。"}
{"id": null, "n": "0390004", "target": "#nkr_note_orig_0390004", "type": "orig", "text": "見《大正藏》第54卷第288頁上一中；第49卷第323頁上。"}
{"id": null, "n": "0391001", "target": "#nkr_note_orig_0391001", "type": "orig", "text": "《昭和法寶總目》第1卷第1016頁中。"}
{"id": null, "n": "0391002", "target": "#nkr_note_orig_0391002", "type": "orig", "text": "參拙著《五六世紀北方民眾佛教信仰——以造像記為中心的考察》下篇二之（三），中國社會科學出版社，1998年。"}
{"id": null, "n": "0391003", "target": "#nkr_note_orig_0391003", "type": "orig", "text": "見《廣弘明集》卷二六，《大正藏》第52卷第294頁中～303頁下，《辨正論》卷三，《大正藏》第52卷第507頁下。"}
{"id": null, "n": "0392001", "target": "#nkr_note_orig_0392001", "type": "orig", "text": "《大正藏》第85卷第1331頁下～1332頁上，第1337頁下～1338頁上，《藏外佛教文獻》第一輯，第360～368頁，宗教文化出版社，1995年。"}
{"id": null, "n": "0392002", "target": "#nkr_note_orig_0392002", "type": "orig", "text": "李靜傑：《六世紀的偽經與僧團整頓》《敦煌學輯刊》1997年第1期，第89頁。"}
