{"id": null, "n": "0720007", "target": "#nkr_note_mod_0720007", "type": "mod", "text": "佛說【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "0720008", "target": "#nkr_note_mod_0720008", "type": "mod", "text": "大【大】，〔－〕【宋】【明】【宮】"}
