{"id": null, "n": null, "target": null, "type": null, "text": "按俊錄亦亡名東域云可義斌疏"}
{"id": null, "n": null, "target": null, "type": null, "text": "按東域云元曉"}
{"id": null, "n": null, "target": null, "type": null, "text": "按東域俊錄並不出障恐性字東域云三性章一卷太法師撰待勘"}
{"id": null, "n": null, "target": null, "type": null, "text": "按東域俊錄並云慧沼"}
{"id": null, "n": null, "target": null, "type": null, "text": "按一本無地字"}
{"id": null, "n": "1138005", "target": "#nkr_note_mod_1138005", "type": "mod", "text": "述【大】，述按東域云善珠唯識肝心記云玄記者基師所記無著金剛般若論疏是也今行於世云云准此可入下論部中【甲】"}
{"id": null, "n": "1138006", "target": "#nkr_note_mod_1138006", "type": "mod", "text": "述【大】，述述東域云亦云贊述【甲】"}
{"id": null, "n": "1138007", "target": "#nkr_note_mod_1138007", "type": "mod", "text": "述【大】，述按亦云青龍疏【甲】"}
{"id": null, "n": "1138008", "target": "#nkr_note_mod_1138008", "type": "mod", "text": "述【大】，述按幽一本作述【甲】"}
{"id": null, "n": "1138009", "target": "#nkr_note_mod_1138009", "type": "mod", "text": "述【大】，述按俊錄云述讚【甲】"}
{"id": null, "n": "1138010", "target": "#nkr_note_mod_1138010", "type": "mod", "text": "述【大】，述按東域云或目錄令印師疏一部七卷可尋【甲】"}
{"id": null, "n": "1139001", "target": "#nkr_note_mod_1139001", "type": "mod", "text": "述【大】，述按或云讚【甲】"}
{"id": null, "n": "1139002", "target": "#nkr_note_mod_1139002", "type": "mod", "text": "述【大】，述按東域云略贊【甲】"}
{"id": null, "n": "1139003", "target": "#nkr_note_mod_1139003", "type": "mod", "text": "述【大】，述按俊錄云百法顯幽鈔十卷今分本末為十九卷【甲】"}
{"id": null, "n": "1139004", "target": "#nkr_note_mod_1139004", "type": "mod", "text": "述【大】，述按東域云沼或作招【甲】"}
{"id": null, "n": "1139005", "target": "#nkr_note_mod_1139005", "type": "mod", "text": "述【大】，述按東域云分為十六卷【甲】"}
{"id": null, "n": "1139006", "target": "#nkr_note_mod_1139006", "type": "mod", "text": "述【大】，述按東域云披此疏似未見成唯識論學者可知【甲】"}
{"id": null, "n": "1139007", "target": "#nkr_note_mod_1139007", "type": "mod", "text": "述【大】，述按東域同此一本跋字作跛未詳傳記【甲】"}
{"id": null, "n": "1139008", "target": "#nkr_note_mod_1139008", "type": "mod", "text": "卷【大】，卷按東域云道基【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "按東域云道基"}
{"id": null, "n": "1139009", "target": "#nkr_note_mod_1139009", "type": "mod", "text": "卷【大】，卷按東域亦亡名【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "按東域亦亡名"}
{"id": null, "n": "1139010", "target": "#nkr_note_mod_1139010", "type": "mod", "text": "述【大】＊，述按亦云述記【甲】＊"}
{"id": null, "n": "1139011", "target": "#nkr_note_mod_1139011", "type": "mod", "text": "述【大】，述按亦云述記分為二十卷【甲】"}
{"id": null, "n": "1139012", "target": "#nkr_note_mod_1139012", "type": "mod", "text": "述【大】，述按東域云亦云文義記【甲】"}
{"id": null, "n": "1139013", "target": "#nkr_note_mod_1139013", "type": "mod", "text": "述【大】，述按東域俊錄並無要字海東云綱要【甲】"}
{"id": null, "n": "1139014", "target": "#nkr_note_mod_1139014", "type": "mod", "text": "述【大】，述一本云二卷東域俊錄並云五卷十字恐衍【甲】"}
{"id": null, "n": "1139015", "target": "#nkr_note_mod_1139015", "type": "mod", "text": "卷【大】，卷按東域俊錄並云平備【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "按東域俊錄並云平備"}
{"id": null, "n": "1139016", "target": "#nkr_note_mod_1139016", "type": "mod", "text": "卷【大】，卷按東域俊錄並云靈泰【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "按東域俊錄並云靈泰"}
{"id": null, "n": "1139017", "target": "#nkr_note_mod_1139017", "type": "mod", "text": "卷【大】，卷按東域俊錄並云東京鈔彼亦亡名【甲】"}
