{"id": null, "n": "0518006", "target": "#nkr_note_mod_0518006", "type": "mod", "text": "佛說【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0518007", "target": "#nkr_note_mod_0518007", "type": "mod", "text": "天竺【大】＊，西域【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0518008", "target": "#nkr_note_mod_0518008", "type": "mod", "text": "般【大】，敗【宋】【元】【明】【宮】"}
{"id": null, "n": "0518009", "target": "#nkr_note_mod_0518009", "type": "mod", "text": "種【大】，色【宋】【元】【明】【宮】"}
{"id": null, "n": "0518010", "target": "#nkr_note_mod_0518010", "type": "mod", "text": "各【大】，色【宋】【元】【明】【宮】"}
{"id": null, "n": "0518011", "target": "#nkr_note_mod_0518011", "type": "mod", "text": "交絡【大】，珓珞【宋】【元】【明】【宮】"}
{"id": null, "n": "0518012", "target": "#nkr_note_mod_0518012", "type": "mod", "text": "眾生【大】，畜生【宋】【元】【明】【宮】"}
{"id": null, "n": "0518013", "target": "#nkr_note_mod_0518013", "type": "mod", "text": "提【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0518014", "target": "#nkr_note_mod_0518014", "type": "mod", "text": "佛【大】，剎佛【宋】【元】【宮】，佛剎【明】"}
{"id": null, "n": "0518015", "target": "#nkr_note_mod_0518015", "type": "mod", "text": "無數【大】，無極【宮】"}
{"id": null, "n": "0519001", "target": "#nkr_note_mod_0519001", "type": "mod", "text": "立【大】，以【宮】"}
{"id": null, "n": "0519002", "target": "#nkr_note_mod_0519002", "type": "mod", "text": "各【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0519003", "target": "#nkr_note_mod_0519003", "type": "mod", "text": "生死生死【大】，生生死死【宋】【元】【明】【宮】"}
{"id": null, "n": "0519004", "target": "#nkr_note_mod_0519004", "type": "mod", "text": "懷【大】，壞【宋】【元】【明】【宮】"}
{"id": null, "n": "0519005", "target": "#nkr_note_mod_0519005", "type": "mod", "text": "令【大】，今【宋】【元】【明】【宮】"}
{"id": null, "n": "0519006", "target": "#nkr_note_mod_0519006", "type": "mod", "text": "實如來【大】，寶如來【宋】【元】【明】【宮】"}
{"id": null, "n": "0519007", "target": "#nkr_note_mod_0519007", "type": "mod", "text": "云【大】＊，芸【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0519008", "target": "#nkr_note_mod_0519008", "type": "mod", "text": "戲【大】，虧【宋】【元】【明】【宮】"}
{"id": null, "n": "0520001", "target": "#nkr_note_mod_0520001", "type": "mod", "text": "受【大】，授【宋】【元】【明】【宮】"}
{"id": null, "n": "0520002", "target": "#nkr_note_mod_0520002", "type": "mod", "text": "見【大】，直見【元】【明】"}
{"id": null, "n": "0520003", "target": "#nkr_note_mod_0520003", "type": "mod", "text": "直【大】，〔－〕【元】【明】"}
{"id": null, "n": "0520004", "target": "#nkr_note_mod_0520004", "type": "mod", "text": "諸【大】，是【宋】【元】【明】【宮】"}
{"id": null, "n": "0520005", "target": "#nkr_note_mod_0520005", "type": "mod", "text": "問【大】，門【宋】【元】【明】【宮】"}
{"id": null, "n": "0520006", "target": "#nkr_note_mod_0520006", "type": "mod", "text": "與【大】，異【宮】"}
{"id": null, "n": "0520007", "target": "#nkr_note_mod_0520007", "type": "mod", "text": "止【大】，正【宋】【元】【明】【宮】"}
{"id": null, "n": "0520008", "target": "#nkr_note_mod_0520008", "type": "mod", "text": "常【大】，當【元】【明】"}
{"id": null, "n": "0520009", "target": "#nkr_note_mod_0520009", "type": "mod", "text": "是【大】，是為【宋】【元】【明】【宮】"}
{"id": null, "n": "0520010", "target": "#nkr_note_mod_0520010", "type": "mod", "text": "外【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0520011", "target": "#nkr_note_mod_0520011", "type": "mod", "text": "是為以解萬萬三昧【大】，為已解六萬三昧【宋】【元】【明】【宮】"}
{"id": null, "n": "0520012", "target": "#nkr_note_mod_0520012", "type": "mod", "text": "亂【大】，辭【宋】【元】【明】【宮】"}
{"id": null, "n": "0520013", "target": "#nkr_note_mod_0520013", "type": "mod", "text": "雖【大】，惟【宋】【宮】"}
{"id": null, "n": "0520014", "target": "#nkr_note_mod_0520014", "type": "mod", "text": "三彌【大】＊，三彌勒【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0520015", "target": "#nkr_note_mod_0520015", "type": "mod", "text": "形【大】，無【宋】【元】【明】【宮】"}
{"id": null, "n": "0520016", "target": "#nkr_note_mod_0520016", "type": "mod", "text": "間【大】，聞【宋】【元】【明】【宮】"}
{"id": null, "n": "0521001", "target": "#nkr_note_mod_0521001", "type": "mod", "text": "但【大】，但是【宋】【元】【明】，此【宮】"}
{"id": null, "n": "0521002", "target": "#nkr_note_mod_0521002", "type": "mod", "text": "法住【大】，法忍【宋】【元】【明】【宮】"}
{"id": null, "n": "0521003", "target": "#nkr_note_mod_0521003", "type": "mod", "text": "法【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0521004", "target": "#nkr_note_mod_0521004", "type": "mod", "text": "悉【大】，悉當【宋】【元】【明】【宮】"}
{"id": null, "n": "0521005", "target": "#nkr_note_mod_0521005", "type": "mod", "text": "幅【大】，信福【宋】【元】【明】【宮】"}
{"id": null, "n": "0521006", "target": "#nkr_note_mod_0521006", "type": "mod", "text": "雖【大】，惟【宋】【元】【明】【宮】"}
{"id": null, "n": "0521007", "target": "#nkr_note_mod_0521007", "type": "mod", "text": "所【大】，生【宋】【元】【明】【宮】"}
{"id": null, "n": "0521008", "target": "#nkr_note_mod_0521008", "type": "mod", "text": "二昧【大】，三昧【宋】【元】【明】【宮】"}
{"id": null, "n": "0521009", "target": "#nkr_note_mod_0521009", "type": "mod", "text": "荷【大】＊，苛【元】【明】【宮】＊"}
{"id": null, "n": "0521010", "target": "#nkr_note_mod_0521010", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0521011", "target": "#nkr_note_mod_0521011", "type": "mod", "text": "意【大】，意意【宋】【元】【明】【宮】"}
{"id": null, "n": "0522001", "target": "#nkr_note_mod_0522001", "type": "mod", "text": "入【大】，八【明】"}
{"id": null, "n": "0522002", "target": "#nkr_note_mod_0522002", "type": "mod", "text": "輕已【大】，輒已【宋】，輒以【元】【明】【宮】"}
{"id": null, "n": "0522003", "target": "#nkr_note_mod_0522003", "type": "mod", "text": "其【大】，是【宋】【元】【明】【宮】"}
{"id": null, "n": "0522004", "target": "#nkr_note_mod_0522004", "type": "mod", "text": "極【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0522005", "target": "#nkr_note_mod_0522005", "type": "mod", "text": "擊【大】，繫【明】【宮】"}
{"id": null, "n": "0522006", "target": "#nkr_note_mod_0522006", "type": "mod", "text": "之【大】，其【元】【明】"}
{"id": null, "n": "0523001", "target": "#nkr_note_mod_0523001", "type": "mod", "text": "出於眾侯中【大】，出眾侯中【宋】【宮】，出眾病中【元】【明】"}
{"id": null, "n": "0523002", "target": "#nkr_note_mod_0523002", "type": "mod", "text": "為【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0523003", "target": "#nkr_note_mod_0523003", "type": "mod", "text": "想【大】＊，相【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0523004", "target": "#nkr_note_mod_0523004", "type": "mod", "text": "相欲切【大】，欲入相初【元】【明】"}
{"id": null, "n": "0523005", "target": "#nkr_note_mod_0523005", "type": "mod", "text": "是即【大】，即是【明】"}
{"id": null, "n": "0523006", "target": "#nkr_note_mod_0523006", "type": "mod", "text": "不與【大】，不異【宋】【元】【明】【宮】"}
{"id": null, "n": "0523007", "target": "#nkr_note_mod_0523007", "type": "mod", "text": "口【大】，舌【宋】【元】【明】【宮】"}
{"id": null, "n": "0523008", "target": "#nkr_note_mod_0523008", "type": "mod", "text": "識【大】，諸【宋】【元】【明】【宮】"}
{"id": null, "n": "0523009", "target": "#nkr_note_mod_0523009", "type": "mod", "text": "知【大】，如【宋】【元】【明】【宮】"}
{"id": null, "n": "0523010", "target": "#nkr_note_mod_0523010", "type": "mod", "text": "音【大】，意【宋】【元】【明】【宮】"}
{"id": null, "n": "0523011", "target": "#nkr_note_mod_0523011", "type": "mod", "text": "滅【大】，戒【宋】【元】【明】【宮】"}
{"id": null, "n": "0523012", "target": "#nkr_note_mod_0523012", "type": "mod", "text": "已【大】＊，以【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0523013", "target": "#nkr_note_mod_0523013", "type": "mod", "text": "都無所著【大】，都教無所有【宋】【元】【明】【宮】"}
{"id": null, "n": "0523014", "target": "#nkr_note_mod_0523014", "type": "mod", "text": "化【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0523015", "target": "#nkr_note_mod_0523015", "type": "mod", "text": "化【大】，化化【宋】【元】【明】【宮】"}
{"id": null, "n": "0523016", "target": "#nkr_note_mod_0523016", "type": "mod", "text": "合【大】＊，念【宋】＊【元】＊【明】＊【宮】"}
{"id": null, "n": "0524001", "target": "#nkr_note_mod_0524001", "type": "mod", "text": "本無【大】，大無【宮】"}
{"id": null, "n": "0524002", "target": "#nkr_note_mod_0524002", "type": "mod", "text": "見諦【大】，見識【宋】【元】【明】"}
{"id": null, "n": "0524003", "target": "#nkr_note_mod_0524003", "type": "mod", "text": "志【大】，悉【宋】【元】【明】【宮】"}
{"id": null, "n": "0524004", "target": "#nkr_note_mod_0524004", "type": "mod", "text": "法【大】，經【宋】【元】【明】【宮】"}
{"id": null, "n": "0524005", "target": "#nkr_note_mod_0524005", "type": "mod", "text": "實【大】，寶【宋】【元】【明】【宮】"}
{"id": null, "n": "0524006", "target": "#nkr_note_mod_0524006", "type": "mod", "text": "銚銚鐄鐄【CB】，銚銚󰭻󰭻【大】，銚鐄銚鐄【宋】【元】【明】【宮】"}
{"id": null, "n": "0524007", "target": "#nkr_note_mod_0524007", "type": "mod", "text": "皆【大】，想【宋】【元】【明】"}
{"id": null, "n": "0524008", "target": "#nkr_note_mod_0524008", "type": "mod", "text": "者【大】，耆【元】【明】【宮】"}
{"id": null, "n": "0524009", "target": "#nkr_note_mod_0524009", "type": "mod", "text": "識【大】，諸【宋】【元】【明】【宮】"}
{"id": null, "n": "0524010", "target": "#nkr_note_mod_0524010", "type": "mod", "text": "何等【大】，何事【宮】"}
{"id": null, "n": "0524011", "target": "#nkr_note_mod_0524011", "type": "mod", "text": "見【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0524012", "target": "#nkr_note_mod_0524012", "type": "mod", "text": "言【大】，當【宋】【元】【明】【宮】"}
{"id": null, "n": "0524013", "target": "#nkr_note_mod_0524013", "type": "mod", "text": "已【大】，以【宋】【元】【明】，〔－〕【宮】"}
{"id": null, "n": "0525001", "target": "#nkr_note_mod_0525001", "type": "mod", "text": "覩【大】，都【宋】【元】【明】【宮】"}
{"id": null, "n": "0525002", "target": "#nkr_note_mod_0525002", "type": "mod", "text": "法【大】，〔－〕【明】"}
{"id": null, "n": "0525003", "target": "#nkr_note_mod_0525003", "type": "mod", "text": "沒【大】，從【宋】【元】【明】【宮】"}
{"id": null, "n": "0525004", "target": "#nkr_note_mod_0525004", "type": "mod", "text": "便【大】，使【宋】【元】【明】【宮】"}
{"id": null, "n": "0525005", "target": "#nkr_note_mod_0525005", "type": "mod", "text": "後【大】，復後【宋】【元】【明】【宮】"}
{"id": null, "n": "0525006", "target": "#nkr_note_mod_0525006", "type": "mod", "text": "今【大】，令【宋】【元】【明】【宮】"}
{"id": null, "n": "0525007", "target": "#nkr_note_mod_0525007", "type": "mod", "text": "相【大】＊，想【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0525008", "target": "#nkr_note_mod_0525008", "type": "mod", "text": "清【大】，清淨【宋】【元】【明】【宮】"}
{"id": null, "n": "0525009", "target": "#nkr_note_mod_0525009", "type": "mod", "text": "有【大】，者【宋】【元】【明】【宮】"}
{"id": null, "n": "0525010", "target": "#nkr_note_mod_0525010", "type": "mod", "text": "是【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0526001", "target": "#nkr_note_mod_0526001", "type": "mod", "text": "想【大】＊，相【宋】＊【元】＊【明】＊【宮】"}
{"id": null, "n": "0526002", "target": "#nkr_note_mod_0526002", "type": "mod", "text": "即是【大】，是即【宋】【元】【明】【宮】"}
{"id": null, "n": "0526003", "target": "#nkr_note_mod_0526003", "type": "mod", "text": "人【大】，入【宋】【元】【明】【宮】"}
{"id": null, "n": "0526004", "target": "#nkr_note_mod_0526004", "type": "mod", "text": "以【大】＊，已【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0526005", "target": "#nkr_note_mod_0526005", "type": "mod", "text": "到【大】，倒【宋】【元】【明】【宮】"}
{"id": null, "n": "0526006", "target": "#nkr_note_mod_0526006", "type": "mod", "text": "受【大】，授【宋】【元】【明】【宮】"}
{"id": null, "n": "0526007", "target": "#nkr_note_mod_0526007", "type": "mod", "text": "青本自白【大】，青白本白【宮】"}
{"id": null, "n": "0526008", "target": "#nkr_note_mod_0526008", "type": "mod", "text": "已【大】，以【宋】【元】【明】【宮】"}
{"id": null, "n": "0526009", "target": "#nkr_note_mod_0526009", "type": "mod", "text": "入【大】，八【宮】"}
{"id": null, "n": "0526010", "target": "#nkr_note_mod_0526010", "type": "mod", "text": "取【大】，不取【宋】【元】【明】【宮】"}
{"id": null, "n": "0526011", "target": "#nkr_note_mod_0526011", "type": "mod", "text": "煮【大】，者【宋】【元】【明】【宮】"}
{"id": null, "n": "0526012", "target": "#nkr_note_mod_0526012", "type": "mod", "text": "故【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0526013", "target": "#nkr_note_mod_0526013", "type": "mod", "text": "持住【大】，住持【宮】"}
{"id": null, "n": "0526014", "target": "#nkr_note_mod_0526014", "type": "mod", "text": "轉不退輪【大】，不輪轉【宮】"}
{"id": null, "n": "0526015", "target": "#nkr_note_mod_0526015", "type": "mod", "text": "荷【大】＊，苛【元】【明】【宮】＊"}
{"id": null, "n": "0526016", "target": "#nkr_note_mod_0526016", "type": "mod", "text": "起煩荷想【大】，起想煩荷【宋】，起想煩苛【元】【明】【宮】"}
{"id": null, "n": "0526017", "target": "#nkr_note_mod_0526017", "type": "mod", "text": "𭸷𤥿經【大】，祇夜經【宋】【元】【明】【宮】"}
{"id": null, "n": "0526018", "target": "#nkr_note_mod_0526018", "type": "mod", "text": "珍寶【大】，珠寶【宋】【元】【明】【宮】"}
{"id": null, "n": "0526019", "target": "#nkr_note_mod_0526019", "type": "mod", "text": "香華【大】，華香【宋】【元】【明】【宮】"}
{"id": null, "n": "0526020", "target": "#nkr_note_mod_0526020", "type": "mod", "text": "干【大】，千【明】"}
{"id": null, "n": "0527001", "target": "#nkr_note_mod_0527001", "type": "mod", "text": "已【大】＊，以【元】【明】【宮】＊"}
{"id": null, "n": "0527002", "target": "#nkr_note_mod_0527002", "type": "mod", "text": "但【大】，則【宋】【元】【明】【宮】"}
{"id": null, "n": "0527003", "target": "#nkr_note_mod_0527003", "type": "mod", "text": "俠【大】＊，挾【元】【明】＊，夾【宮】＊"}
{"id": null, "n": "0527004", "target": "#nkr_note_mod_0527004", "type": "mod", "text": "語【大】，諸【宋】【元】【明】【宮】"}
