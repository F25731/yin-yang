{"id": null, "n": "0527011", "target": "#nkr_note_mod_0527011", "type": "mod", "text": "功【大】，劫【宋】【元】【明】【宮】"}
{"id": null, "n": "0527012", "target": "#nkr_note_mod_0527012", "type": "mod", "text": "嫉【大】，疾【宋】【元】【明】"}
{"id": null, "n": "0527013", "target": "#nkr_note_mod_0527013", "type": "mod", "text": "乃【大】，及【宋】【元】【明】【宮】"}
{"id": null, "n": "0527014", "target": "#nkr_note_mod_0527014", "type": "mod", "text": "生【大】，至【宋】【元】【明】【宮】"}
{"id": null, "n": "0527015", "target": "#nkr_note_mod_0527015", "type": "mod", "text": "無常海【大】，無常處【宋】【元】【明】【宮】"}
{"id": null, "n": "0527016", "target": "#nkr_note_mod_0527016", "type": "mod", "text": "卌【CB】【麗-CB】，冊【大】，四十【宋】【元】【明】【宮】（CBETA 按：本文原字作「冊」，其校註標示原字作「卌」。）"}
{"id": null, "n": "0527017", "target": "#nkr_note_mod_0527017", "type": "mod", "text": "別【大】，莂【宋】【元】【明】【宮】"}
{"id": null, "n": "0528001", "target": "#nkr_note_mod_0528001", "type": "mod", "text": "小池【大】，水池【宋】【元】【明】【宮】"}
{"id": null, "n": "0528002", "target": "#nkr_note_mod_0528002", "type": "mod", "text": "佛【大】，神【宮】"}
{"id": null, "n": "0528003", "target": "#nkr_note_mod_0528003", "type": "mod", "text": "者【大】，音【宋】【元】【明】【宮】"}
{"id": null, "n": "0528004", "target": "#nkr_note_mod_0528004", "type": "mod", "text": "所有【大】，所見【宋】【元】【明】【宮】"}
{"id": null, "n": "0528005", "target": "#nkr_note_mod_0528005", "type": "mod", "text": "煩荷【大】，煩芳【元】【明】，煩惱【宮】"}
{"id": null, "n": "0528006", "target": "#nkr_note_mod_0528006", "type": "mod", "text": "主【大】＊，生【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0528007", "target": "#nkr_note_mod_0528007", "type": "mod", "text": "幅【大】，福【宮】"}
{"id": null, "n": "0528008", "target": "#nkr_note_mod_0528008", "type": "mod", "text": "實【大】，寶【宋】【元】【明】【宮】"}
{"id": null, "n": "0528009", "target": "#nkr_note_mod_0528009", "type": "mod", "text": "為最大【大】，最為大【明】"}
{"id": null, "n": "0528010", "target": "#nkr_note_mod_0528010", "type": "mod", "text": "因【大】，同【宋】【元】【明】【宮】"}
{"id": null, "n": "0528011", "target": "#nkr_note_mod_0528011", "type": "mod", "text": "眾法【大】，眾生【宮】"}
{"id": null, "n": "0528012", "target": "#nkr_note_mod_0528012", "type": "mod", "text": "所離【大】，不離【宋】【元】【明】【宮】"}
