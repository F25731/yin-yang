{"id": null, "n": "0528015", "target": "#nkr_note_mod_0528015", "type": "mod", "text": "退【大】，是【宋】【元】【明】【宮】"}
{"id": null, "n": "0528016", "target": "#nkr_note_mod_0528016", "type": "mod", "text": "念無【大】，無念【宋】【元】【明】【宮】"}
{"id": null, "n": "0528017", "target": "#nkr_note_mod_0528017", "type": "mod", "text": "答【大】，告【宋】【元】【明】【宮】"}
