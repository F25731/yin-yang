{"id": null, "n": "0529006", "target": "#nkr_note_mod_0529006", "type": "mod", "text": "無【大】，〔－〕【宮】"}
{"id": null, "n": "0529007", "target": "#nkr_note_mod_0529007", "type": "mod", "text": "樂之具【大】，謂之真【宋】【元】【明】"}
{"id": null, "n": "0529008", "target": "#nkr_note_mod_0529008", "type": "mod", "text": "脫【大】，服【宋】【元】【明】【宮】"}
{"id": null, "n": "0529009", "target": "#nkr_note_mod_0529009", "type": "mod", "text": "虛【大】，處【宋】【元】【明】【宮】"}
{"id": null, "n": "0530001", "target": "#nkr_note_mod_0530001", "type": "mod", "text": "未脫【大】，不脫【宋】【元】【明】，衣服【宮】"}
{"id": null, "n": "0530002", "target": "#nkr_note_mod_0530002", "type": "mod", "text": "道【大】，導【元】【明】"}
{"id": null, "n": "0530003", "target": "#nkr_note_mod_0530003", "type": "mod", "text": "施【大】，於【宋】【元】【明】【宮】"}
{"id": null, "n": "0530004", "target": "#nkr_note_mod_0530004", "type": "mod", "text": "天人【大】，天子【宋】【元】【明】【宮】"}
{"id": null, "n": "0530005", "target": "#nkr_note_mod_0530005", "type": "mod", "text": "道者不具見【大】，尊者不真見【宋】【元】【明】【宮】"}
