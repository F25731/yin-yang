{"id": null, "n": "0530007", "target": "#nkr_note_mod_0530007", "type": "mod", "text": "處【大】，起【宋】【元】【明】【宮】"}
{"id": null, "n": "0530008", "target": "#nkr_note_mod_0530008", "type": "mod", "text": "本【大】，大【宮】"}
{"id": null, "n": "0530009", "target": "#nkr_note_mod_0530009", "type": "mod", "text": "正覺者【大】，正覺身【宋】【元】【明】【宮】"}
{"id": null, "n": "0530010", "target": "#nkr_note_mod_0530010", "type": "mod", "text": "園【大】，國【宋】【元】【明】【宮】"}
{"id": null, "n": "0530011", "target": "#nkr_note_mod_0530011", "type": "mod", "text": "見【大】，是【宋】【元】【明】"}
