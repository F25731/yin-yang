{"id": null, "n": "0054001", "target": "#nkr_note_mod_0054001", "type": "mod", "text": "有【大】＊，〔－〕【考偽-原】＊"}
{"id": null, "n": "0054002", "target": "#nkr_note_mod_0054002", "type": "mod", "text": "故【大】＊，〔－〕【考偽-原】＊"}
{"id": null, "n": "0054003", "target": "#nkr_note_mod_0054003", "type": "mod", "text": "生【大】＊，生故【考偽-原】＊"}
{"id": null, "n": "0054004", "target": "#nkr_note_mod_0054004", "type": "mod", "text": "緣【大】，緣有等無間緣【考偽-原】"}
{"id": null, "n": "0055001", "target": "#nkr_note_mod_0055001", "type": "mod", "text": "闢【大】＊，避【考偽-原】＊，導【考偽-原】＊"}
{"id": null, "n": "0055002", "target": "#nkr_note_mod_0055002", "type": "mod", "text": "外緣【大】，緣外【考偽-原】"}
{"id": null, "n": "0055003", "target": "#nkr_note_mod_0055003", "type": "mod", "text": "過【大】，緣過【考偽-原】"}
{"id": null, "n": "0055004", "target": "#nkr_note_mod_0055004", "type": "mod", "text": "緣【大】，〔－〕【考偽-原】"}
{"id": null, "n": "0056001", "target": "#nkr_note_mod_0056001", "type": "mod", "text": "教【大】，數【考偽-原】"}
{"id": null, "n": "0056002", "target": "#nkr_note_mod_0056002", "type": "mod", "text": "執【大】，執見【考偽-原】"}
{"id": null, "n": "0057001", "target": "#nkr_note_mod_0057001", "type": "mod", "text": "惱【大】，惱等【考偽-大】"}
{"id": null, "n": "0058001", "target": "#nkr_note_mod_0058001", "type": "mod", "text": "生【大】，正【考偽-原】"}
{"id": null, "n": "0058002", "target": "#nkr_note_mod_0058002", "type": "mod", "text": "所【大】，是【考偽-原】"}
{"id": null, "n": "0058003", "target": "#nkr_note_mod_0058003", "type": "mod", "text": "廢立六位【大】，六位廢立【考偽-原】"}
{"id": null, "n": "0058004", "target": "#nkr_note_mod_0058004", "type": "mod", "text": "得【大】，將【考偽-原】"}
{"id": null, "n": "0060001", "target": "#nkr_note_mod_0060001", "type": "mod", "text": "（此即…故）十一字【大】，或有似七意思為似事故示【校異-原】"}
{"id": null, "n": "0052003", "target": "#nkr_note_orig_0052003", "type": "orig", "text": "【原】寬政五年刊大谷大學藏本"}
{"id": null, "n": "0054001", "target": "#nkr_note_orig_0054001", "type": "orig", "text": "〔有〕－ヵ【原】＊"}
{"id": null, "n": "0054002", "target": "#nkr_note_orig_0054002", "type": "orig", "text": "〔故〕－ヵ【原】＊"}
{"id": null, "n": "0054003", "target": "#nkr_note_orig_0054003", "type": "orig", "text": "生＋（故）ヵ【原】＊"}
{"id": null, "n": "0054004", "target": "#nkr_note_orig_0054004", "type": "orig", "text": "緣＋（有等無間緣）ヵ【原】"}
{"id": null, "n": "0055001", "target": "#nkr_note_orig_0055001", "type": "orig", "text": "闢＝避ヵ【原】＊，導ヵ【原】＊"}
{"id": null, "n": "0055002", "target": "#nkr_note_orig_0055002", "type": "orig", "text": "外緣＝緣外ヵ【原】"}
{"id": null, "n": "0055003", "target": "#nkr_note_orig_0055003", "type": "orig", "text": "（緣）ヵ＋過【原】"}
{"id": null, "n": "0055004", "target": "#nkr_note_orig_0055004", "type": "orig", "text": "〔緣〕－ヵ【原】"}
{"id": null, "n": "0056001", "target": "#nkr_note_orig_0056001", "type": "orig", "text": "教＝數ヵ【原】"}
{"id": null, "n": "0056002", "target": "#nkr_note_orig_0056002", "type": "orig", "text": "執＋（見）ヵ【原】"}
{"id": null, "n": "0057001", "target": "#nkr_note_orig_0057001", "type": "orig", "text": "惱＋（等）？"}
{"id": null, "n": "0058001", "target": "#nkr_note_orig_0058001", "type": "orig", "text": "生＝正ヵ【原】"}
{"id": null, "n": "0058002", "target": "#nkr_note_orig_0058002", "type": "orig", "text": "所＝是ヵ【原】"}
{"id": null, "n": "0058003", "target": "#nkr_note_orig_0058003", "type": "orig", "text": "廢立六位＝六位廢立ヵ【原】"}
{"id": null, "n": "0058004", "target": "#nkr_note_orig_0058004", "type": "orig", "text": "得＝將ヵ【原】"}
{"id": null, "n": "0060001", "target": "#nkr_note_orig_0060001", "type": "orig", "text": "（（此即…故））十一字＝（（或有似七意思為似事故示））ィ十一字【原】"}
