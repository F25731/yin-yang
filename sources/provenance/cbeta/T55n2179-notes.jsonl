{"id": null, "n": "1137015", "target": "#nkr_note_mod_1137015", "type": "mod", "text": "述【大】，述按東域云諸錄云二卷而見行本有上中下三卷【甲】"}
{"id": null, "n": "1137016", "target": "#nkr_note_mod_1137016", "type": "mod", "text": "述【大】，述按義記二字東域云疏【甲】"}
{"id": null, "n": "1137017", "target": "#nkr_note_mod_1137017", "type": "mod", "text": "述【大】，述按古本有朱書紙數今加之下皆倣此【甲】"}
{"id": null, "n": "1138001", "target": "#nkr_note_mod_1138001", "type": "mod", "text": "述【大】，述按東域云亦云無依無得大乘四論玄義【甲】"}
{"id": null, "n": "1138002", "target": "#nkr_note_mod_1138002", "type": "mod", "text": "述【大】，述按宗輪作部執異論東域作部異宗論【甲】"}
{"id": null, "n": "1138003", "target": "#nkr_note_mod_1138003", "type": "mod", "text": "述【大】，述按或云略述【甲】"}
{"id": null, "n": "1137014", "target": "#nkr_note_orig_1137014", "type": "orig", "text": "【甲】寬政二年刊諸宗章疏錄"}
