{"id": null, "n": "0399001", "target": "#nkr_note_mod_0399001", "type": "mod", "text": "不【大】＊，佛說不【明】＊，【原】麗本"}
{"id": null, "n": "0399002", "target": "#nkr_note_mod_0399002", "type": "mod", "text": "藏【大】，藏法師【宋】【元】【明】"}
{"id": null, "n": "0399003", "target": "#nkr_note_mod_0399003", "type": "mod", "text": "譯【大】，等譯【宋】【元】【明】"}
{"id": null, "n": "0399004", "target": "#nkr_note_mod_0399004", "type": "mod", "text": "於【大】，我【宋】【元】【明】"}
{"id": null, "n": "0399005", "target": "#nkr_note_mod_0399005", "type": "mod", "text": "佛世尊所【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0399006", "target": "#nkr_note_mod_0399006", "type": "mod", "text": "梵天【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0399007", "target": "#nkr_note_mod_0399007", "type": "mod", "text": "未【大】，於未【宋】【元】【明】"}
{"id": null, "n": "0399008", "target": "#nkr_note_mod_0399008", "type": "mod", "text": "野【大】，蠱【宋】【元】【明】"}
{"id": null, "n": "0399009", "target": "#nkr_note_mod_0399009", "type": "mod", "text": "設【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0399010", "target": "#nkr_note_mod_0399010", "type": "mod", "text": "若【大】，若有【宋】【元】【明】"}
{"id": null, "n": "0399011", "target": "#nkr_note_mod_0399011", "type": "mod", "text": "訖【大】，說【宋】【元】【明】"}
{"id": null, "n": "0399012", "target": "#nkr_note_mod_0399012", "type": "mod", "text": "他【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0400001", "target": "#nkr_note_mod_0400001", "type": "mod", "text": "惡【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0400002", "target": "#nkr_note_mod_0400002", "type": "mod", "text": "詛【大】，咀【宋】"}
{"id": null, "n": "0400003", "target": "#nkr_note_mod_0400003", "type": "mod", "text": "眾【大】，眾眾【宋】【元】【明】"}
{"id": null, "n": "0400004", "target": "#nkr_note_mod_0400004", "type": "mod", "text": "復覆面而【大】，覆面【宋】【元】【明】"}
{"id": null, "n": "0400005", "target": "#nkr_note_mod_0400005", "type": "mod", "text": "故【大】，為【宋】【元】【明】"}
{"id": null, "n": "0400006", "target": "#nkr_note_mod_0400006", "type": "mod", "text": "悋【大】，法【宋】【元】【明】"}
{"id": null, "n": "0400007", "target": "#nkr_note_mod_0400007", "type": "mod", "text": "汝【大】，汝說【宋】【元】【明】"}
{"id": null, "n": "0400008", "target": "#nkr_note_mod_0400008", "type": "mod", "text": "姪【大】，絰【宋】【元】【明】"}
{"id": null, "n": "0400009", "target": "#nkr_note_mod_0400009", "type": "mod", "text": "吽【大】，〔－〕【宋】【元】【明】"}
