{"id": null, "n": "0077001", "target": "#nkr_note_orig_0077001", "type": "orig", "text": "呾＝咀【元】【明】【宮】"}
{"id": null, "n": "0077002", "target": "#nkr_note_orig_0077002", "type": "orig", "text": "咤＝宅【三】【宮】＊"}
