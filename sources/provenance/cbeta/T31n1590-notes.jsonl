{"id": null, "n": "0074011", "target": "#nkr_note_mod_0074011", "type": "mod", "text": "一卷【大】，〔－〕【明】"}
{"id": null, "n": "0074012", "target": "#nkr_note_mod_0074012", "type": "mod", "text": "大唐【大】，〔－〕【宋】【元】【宮】，唐【明】"}
{"id": null, "n": "0074013", "target": "#nkr_note_mod_0074013", "type": "mod", "text": "因諸【大】，諸因【元】"}
{"id": null, "n": "0074014", "target": "#nkr_note_mod_0074014", "type": "mod", "text": "等用【大】，用等【元】【明】"}
{"id": null, "n": "0074015", "target": "#nkr_note_mod_0074015", "type": "mod", "text": "酥【大】＊，蘇【宋】【元】【宮】＊"}
{"id": null, "n": "0074016", "target": "#nkr_note_mod_0074016", "type": "mod", "text": "膿【大】，濃【明】"}
{"id": null, "n": "0075001", "target": "#nkr_note_mod_0075001", "type": "mod", "text": "那【大】，捺【宋】【元】【明】【宮】"}
{"id": null, "n": "0075002", "target": "#nkr_note_mod_0075002", "type": "mod", "text": "但【大】，〔－〕【宮】"}
{"id": null, "n": "0075003", "target": "#nkr_note_mod_0075003", "type": "mod", "text": "實【CB】【麗-CB】【宋】【元】【明】【宮】，害【大】"}
{"id": null, "n": "0076001", "target": "#nkr_note_mod_0076001", "type": "mod", "text": "加【大】，迦【宋】【元】【明】【宮】"}
{"id": null, "n": "0076002", "target": "#nkr_note_mod_0076002", "type": "mod", "text": "且【大】，日【元】"}
{"id": null, "n": "0076003", "target": "#nkr_note_mod_0076003", "type": "mod", "text": "為【大】，色【宋】【元】【明】"}
{"id": null, "n": "0076004", "target": "#nkr_note_mod_0076004", "type": "mod", "text": "如【大】，知【宋】【元】【明】"}
{"id": null, "n": "0076005", "target": "#nkr_note_mod_0076005", "type": "mod", "text": "惛【大】，昏【宋】【元】【明】【宮】"}
{"id": null, "n": "0076006", "target": "#nkr_note_mod_0076006", "type": "mod", "text": "（展轉…決定）十字【大】，定展轉增上力二識成決【元】"}
{"id": null, "n": "0076007", "target": "#nkr_note_mod_0076007", "type": "mod", "text": "令【大】，於【宋】【元】"}
{"id": null, "n": "0077001", "target": "#nkr_note_mod_0077001", "type": "mod", "text": "呾【大】，咀【元】【明】【宮】"}
{"id": null, "n": "0077002", "target": "#nkr_note_mod_0077002", "type": "mod", "text": "咤【大】＊，宅【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0077003", "target": "#nkr_note_mod_0077003", "type": "mod", "text": "陵【大】，淩【宋】【元】【明】【宮】"}
{"id": null, "n": "0077004", "target": "#nkr_note_mod_0077004", "type": "mod", "text": "境【大】，境及一切種智無礙故【明】"}
{"id": null, "n": "0077005", "target": "#nkr_note_mod_0077005", "type": "mod", "text": "及一切種智無礙故【大】，〔－〕【明】"}
{"id": null, "n": "0077006", "target": "#nkr_note_mod_0077006", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】"}
