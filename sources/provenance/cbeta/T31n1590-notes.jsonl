{"id": null, "n": "0075003", "target": "#nkr_note_orig_0075003", "type": "orig", "text": "害＝實【三】【宮】"}
{"id": null, "n": "0076001", "target": "#nkr_note_orig_0076001", "type": "orig", "text": "加＝迦【三】【宮】"}
{"id": null, "n": "0076002", "target": "#nkr_note_orig_0076002", "type": "orig", "text": "且＝日【元】"}
