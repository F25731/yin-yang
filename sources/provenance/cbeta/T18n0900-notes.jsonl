{"id": null, "n": null, "target": null, "type": null, "text": "不空譯末有十八道頸次第"}
{"id": null, "n": null, "target": null, "type": null, "text": "就生起意"}
{"id": null, "n": null, "target": null, "type": null, "text": "去"}
{"id": null, "n": null, "target": null, "type": null, "text": "半音"}
{"id": null, "n": "0781006", "target": "#nkr_note_mod_0781006", "type": "mod", "text": "就【大】，〔－〕【甲】"}
{"id": null, "n": "0782001", "target": "#nkr_note_mod_0782001", "type": "mod", "text": "垂【大】，承【甲】"}
{"id": null, "n": "0782002", "target": "#nkr_note_mod_0782002", "type": "mod", "text": "磨【大】，麼【甲】"}
{"id": null, "n": "0782003", "target": "#nkr_note_mod_0782003", "type": "mod", "text": "次【大】，次結【甲】"}
{"id": null, "n": "0782004", "target": "#nkr_note_mod_0782004", "type": "mod", "text": "華【大】，華者一切菩薩蓮花【甲】"}
{"id": null, "n": "0782005", "target": "#nkr_note_mod_0782005", "type": "mod", "text": "掌【大】，當【甲】"}
{"id": null, "n": "0782006", "target": "#nkr_note_mod_0782006", "type": "mod", "text": "病【大】，〔－〕【甲】"}
{"id": null, "n": "0782007", "target": "#nkr_note_mod_0782007", "type": "mod", "text": "是【大】，〔－〕【甲】"}
{"id": null, "n": "0782008", "target": "#nkr_note_mod_0782008", "type": "mod", "text": "在【大】，〔－〕【甲】"}
{"id": null, "n": "0782009", "target": "#nkr_note_mod_0782009", "type": "mod", "text": "之【大】，是【甲】"}
{"id": null, "n": "0782010", "target": "#nkr_note_mod_0782010", "type": "mod", "text": "印【大】，〔－〕【甲】"}
{"id": null, "n": "0782011", "target": "#nkr_note_mod_0782011", "type": "mod", "text": "婆去【大】，婆去嚩日囉𧣈【甲】"}
{"id": null, "n": "0782012", "target": "#nkr_note_mod_0782012", "type": "mod", "text": "至【大】，〔－〕【甲】"}
{"id": null, "n": "0782013", "target": "#nkr_note_mod_0782013", "type": "mod", "text": "極樂【大】，〔－〕【甲】"}
{"id": null, "n": "0783001", "target": "#nkr_note_mod_0783001", "type": "mod", "text": "半音【大】，〔－〕【甲】"}
{"id": null, "n": "0783002", "target": "#nkr_note_mod_0783002", "type": "mod", "text": "結【大】，〔－〕【甲】"}
{"id": null, "n": "0783003", "target": "#nkr_note_mod_0783003", "type": "mod", "text": "南【大】，喃【甲】"}
{"id": null, "n": "0783004", "target": "#nkr_note_mod_0783004", "type": "mod", "text": "莽【大】，忙【甲】"}
{"id": null, "n": "0783005", "target": "#nkr_note_mod_0783005", "type": "mod", "text": "等【大】，〔－〕【甲】"}
{"id": null, "n": "0783006", "target": "#nkr_note_mod_0783006", "type": "mod", "text": "蘖【大】，蘖二合【甲】"}
{"id": null, "n": "0783007", "target": "#nkr_note_mod_0783007", "type": "mod", "text": "呬【大】，呬二合【甲】"}
{"id": null, "n": "0781005", "target": "#nkr_note_orig_0781005", "type": "orig", "text": "【原】豐山版，【甲】高山寺藏古寫本"}
{"id": null, "n": "0781006", "target": "#nkr_note_orig_0781006", "type": "orig", "text": "〔就〕－【甲】"}
{"id": null, "n": "0782001", "target": "#nkr_note_orig_0782001", "type": "orig", "text": "垂＝承【甲】"}
{"id": null, "n": "0782002", "target": "#nkr_note_orig_0782002", "type": "orig", "text": "磨＝麼【甲】"}
{"id": null, "n": "0782003", "target": "#nkr_note_orig_0782003", "type": "orig", "text": "次＋（結）【甲】"}
{"id": null, "n": "0782004", "target": "#nkr_note_orig_0782004", "type": "orig", "text": "華＋（者一切菩薩蓮花）【甲】"}
{"id": null, "n": "0782005", "target": "#nkr_note_orig_0782005", "type": "orig", "text": "掌＝當【甲】"}
{"id": null, "n": "0782006", "target": "#nkr_note_orig_0782006", "type": "orig", "text": "〔病〕－【甲】"}
{"id": null, "n": "0782007", "target": "#nkr_note_orig_0782007", "type": "orig", "text": "〔是〕－【甲】"}
{"id": null, "n": "0782008", "target": "#nkr_note_orig_0782008", "type": "orig", "text": "〔在〕－【甲】"}
{"id": null, "n": "0782009", "target": "#nkr_note_orig_0782009", "type": "orig", "text": "之＝是【甲】"}
{"id": null, "n": "0782010", "target": "#nkr_note_orig_0782010", "type": "orig", "text": "〔印〕－【甲】"}
{"id": null, "n": "0782011", "target": "#nkr_note_orig_0782011", "type": "orig", "text": "婆去＋（嚩日囉𧣈）【甲】"}
{"id": null, "n": "0782012", "target": "#nkr_note_orig_0782012", "type": "orig", "text": "〔至〕－【甲】"}
{"id": null, "n": "0782013", "target": "#nkr_note_orig_0782013", "type": "orig", "text": "〔極樂〕－【甲】"}
{"id": null, "n": "0783001", "target": "#nkr_note_orig_0783001", "type": "orig", "text": "〔半音〕－【甲】"}
{"id": null, "n": "0783002", "target": "#nkr_note_orig_0783002", "type": "orig", "text": "〔結〕－【甲】"}
{"id": null, "n": "0783003", "target": "#nkr_note_orig_0783003", "type": "orig", "text": "南＝喃【甲】"}
{"id": null, "n": "0783004", "target": "#nkr_note_orig_0783004", "type": "orig", "text": "莾＝忙【甲】"}
{"id": null, "n": "0783005", "target": "#nkr_note_orig_0783005", "type": "orig", "text": "〔等〕－【甲】"}
{"id": null, "n": "0783006", "target": "#nkr_note_orig_0783006", "type": "orig", "text": "蘖＋（二合）【甲】"}
{"id": null, "n": "0783007", "target": "#nkr_note_orig_0783007", "type": "orig", "text": "呬＋（二合）【甲】"}
