{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": "0591001", "target": "#nkr_note_orig_0591001", "type": "orig", "text": "像下應有像字歟"}
{"id": null, "n": "0591002", "target": "#nkr_note_orig_0591002", "type": "orig", "text": "通下文作空"}
{"id": null, "n": "0591003", "target": "#nkr_note_orig_0591003", "type": "orig", "text": "乘下應有所觀之三字"}
{"id": null, "n": "0592001", "target": "#nkr_note_orig_0592001", "type": "orig", "text": "聚疑藂"}
