{"id": null, "n": null, "target": null, "type": null, "text": "上克盍切音𨍰酒噐也下私盍切三入聲枯𣜂也"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃里切音你如\n禪未見也"}
{"id": null, "n": null, "target": null, "type": null, "text": "救角切音連刺也"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒲登切音朋大鵬鳥也"}
{"id": null, "n": null, "target": null, "type": null, "text": "薄邁切音敗梵音也"}
{"id": null, "n": null, "target": null, "type": null, "text": "薄沒切音孛"}
{"id": null, "n": null, "target": null, "type": null, "text": "側入切音札纏束也"}
{"id": null, "n": null, "target": null, "type": null, "text": "希恔\n切音爆似虎"}
{"id": null, "n": null, "target": null, "type": null, "text": "上乙角切音渥下測角切音娖"}
{"id": null, "n": null, "target": null, "type": null, "text": "寫曩切音顙"}
{"id": null, "n": null, "target": null, "type": null, "text": "於琰切音厭禾\n稻也"}
{"id": null, "n": null, "target": null, "type": null, "text": "許救切同嗅以鼻就氣也"}
{"id": null, "n": null, "target": null, "type": null, "text": "杜歷切音狄見也"}
{"id": null, "n": null, "target": null, "type": null, "text": "直列切音徹"}
{"id": null, "n": null, "target": null, "type": null, "text": "盧官切音鑾登石巒以遠望"}
{"id": null, "n": null, "target": null, "type": null, "text": "子余切音苴"}
{"id": null, "n": null, "target": null, "type": null, "text": "烏果切音駊揚米去糠也"}
{"id": null, "n": null, "target": null, "type": null, "text": "如乘切音仍玉噐"}
{"id": null, "n": null, "target": null, "type": null, "text": "危坐\n念佛"}
{"id": null, "n": null, "target": null, "type": null, "text": "倚杖\n思惟"}
{"id": null, "n": null, "target": null, "type": null, "text": "如意\n燒香"}
{"id": null, "n": null, "target": null, "type": null, "text": "靜坐\n摸索"}
{"id": null, "n": null, "target": null, "type": null, "text": "賣弄\n\n神通"}
{"id": null, "n": null, "target": null, "type": null, "text": "着靴\n坐受花果"}
{"id": null, "n": null, "target": null, "type": null, "text": "𮖐頭\n開卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "枯木\n立禪"}
{"id": null, "n": null, "target": null, "type": null, "text": "坦臂\n操藥"}
{"id": null, "n": null, "target": null, "type": null, "text": "長眉\n搸經"}
{"id": null, "n": null, "target": null, "type": null, "text": "倚杖\n閒生"}
{"id": null, "n": null, "target": null, "type": null, "text": "捧爐\n默念"}
{"id": null, "n": null, "target": null, "type": null, "text": "橫身\n石頭"}
{"id": null, "n": null, "target": null, "type": null, "text": "伏虎\n撥毛"}
{"id": null, "n": null, "target": null, "type": null, "text": "隆龍\n展鉢"}
{"id": null, "n": null, "target": null, "type": null, "text": "渡水\n捺童子頭毛"}
{"id": null, "n": null, "target": null, "type": null, "text": "像藏匡山獅子峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "像藏徑山"}
{"id": null, "n": null, "target": null, "type": null, "text": "像藏雲門"}
{"id": null, "n": null, "target": null, "type": null, "text": "偃風璞請"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒲官切音槃瘡㾗也"}
{"id": null, "n": null, "target": null, "type": null, "text": "伊鳥切遙去聲抒臼也"}
{"id": null, "n": null, "target": null, "type": null, "text": "呼骨切音勿公及士\n所搢也"}
{"id": null, "n": null, "target": null, "type": null, "text": "力智切音麗荔枝樹高五六丈青花朱實實大如鷄子果名"}
{"id": null, "n": null, "target": null, "type": null, "text": "女久切音紐手轉貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "丁括切音掇補裰破衣也"}
{"id": null, "n": null, "target": null, "type": null, "text": "墮落深坑裏"}
{"id": null, "n": null, "target": null, "type": null, "text": "秤鎚鐵打的"}
{"id": null, "n": null, "target": null, "type": null, "text": "切莫錯認著"}
{"id": null, "n": null, "target": null, "type": null, "text": "猶是第二義"}
{"id": null, "n": null, "target": null, "type": null, "text": "只道得一半"}
{"id": null, "n": null, "target": null, "type": null, "text": "無人識得渠"}
{"id": null, "n": null, "target": null, "type": null, "text": "冬瓜茄子不生耳躲"}
{"id": null, "n": null, "target": null, "type": null, "text": "少賣弄"}
{"id": null, "n": null, "target": null, "type": null, "text": "之六切音竹以竹曲為五絃之樂也"}
{"id": null, "n": null, "target": null, "type": null, "text": "平秘切音備巨鼇贔屓首冠靈山力\n壯貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "寫曩切音顙柱下石"}
{"id": null, "n": null, "target": null, "type": null, "text": "徂尊切音存踞也"}
{"id": null, "n": null, "target": null, "type": null, "text": "桑才切音鰓頰顋"}
{"id": null, "n": null, "target": null, "type": null, "text": "郎丁切音靈與羚同羚羊似羊而大角有圓繞蹙文夜則懸角木上以防患"}
{"id": null, "n": "0684b0101", "target": "#nkr_note_add_0684b0101", "type": "add", "text": "掐【CB】，搯【龍】"}
{"id": null, "n": "0687a0201", "target": "#nkr_note_add_0687a0201", "type": "add", "text": "斂【CB】，歛【龍】"}
