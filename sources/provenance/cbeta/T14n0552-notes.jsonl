{"id": null, "n": null, "target": null, "type": "cf1", "text": "K19n0762_p0737b03"}
{"id": null, "n": "0895011", "target": "#nkr_note_mod_0895011", "type": "mod", "text": "佛說【大】＊，〔－〕【元】【明】【宮】＊，cf. Śārdulakarṇa-avadāna. 摩登伽經，舍頭諫太子二十八宿經參照"}
{"id": null, "n": "0895012", "target": "#nkr_note_mod_0895012", "type": "mod", "text": "附【大】，今附【元】【宮】，人名今附【明】"}
{"id": null, "n": "0895013", "target": "#nkr_note_mod_0895013", "type": "mod", "text": "東【大】，西【明】"}
{"id": null, "n": "0896001", "target": "#nkr_note_mod_0896001", "type": "mod", "text": "日【大】，明【元】【明】【宮】"}
{"id": null, "n": "0896002", "target": "#nkr_note_mod_0896002", "type": "mod", "text": "中【大】，此中【元】【明】【宮】"}
{"id": null, "n": "0896003", "target": "#nkr_note_mod_0896003", "type": "mod", "text": "念【大】，命【宮】"}
{"id": null, "n": "0896004", "target": "#nkr_note_mod_0896004", "type": "mod", "text": "汝【大】，我【明】"}
{"id": null, "n": "0896005", "target": "#nkr_note_mod_0896005", "type": "mod", "text": "涕【大】，洟【元】【明】【宮】"}
{"id": null, "n": "0896006", "target": "#nkr_note_mod_0896006", "type": "mod", "text": "有【大】，〔－〕【元】【明】【宮】"}
{"id": null, "n": "0896007", "target": "#nkr_note_mod_0896007", "type": "mod", "text": "有【大】，有惡露【明】"}
{"id": null, "n": "0896008", "target": "#nkr_note_mod_0896008", "type": "mod", "text": "處【大】，露【元】【明】【宮】"}
{"id": null, "n": "0896009", "target": "#nkr_note_mod_0896009", "type": "mod", "text": "㴃【大】，泣【元】【明】"}
{"id": null, "n": "0896010", "target": "#nkr_note_mod_0896010", "type": "mod", "text": "令【大】，今【元】【明】【宮】"}
{"id": null, "n": "0895011", "target": "#nkr_note_orig_0895011", "type": "orig", "text": "〔佛說〕－【元】【明】【宮】＊，cf. Śārdulakarṇa-avadāna. 摩登伽經，舍頭諫太子二十八宿經參照"}
{"id": null, "n": "0895012", "target": "#nkr_note_orig_0895012", "type": "orig", "text": "（今）＋附【元】【宮】，（人名今）＋附【明】"}
{"id": null, "n": "0895013", "target": "#nkr_note_orig_0895013", "type": "orig", "text": "東＝西【明】"}
{"id": null, "n": "0896001", "target": "#nkr_note_orig_0896001", "type": "orig", "text": "日＝明【元】【明】【宮】"}
{"id": null, "n": "0896002", "target": "#nkr_note_orig_0896002", "type": "orig", "text": "（此）＋中【元】【明】【宮】"}
{"id": null, "n": "0896003", "target": "#nkr_note_orig_0896003", "type": "orig", "text": "念＝命【宮】"}
{"id": null, "n": "0896004", "target": "#nkr_note_orig_0896004", "type": "orig", "text": "汝＝我【明】"}
{"id": null, "n": "0896005", "target": "#nkr_note_orig_0896005", "type": "orig", "text": "涕＝洟【元】【明】【宮】"}
{"id": null, "n": "0896006", "target": "#nkr_note_orig_0896006", "type": "orig", "text": "〔有〕－【元】【明】【宮】"}
{"id": null, "n": "0896007", "target": "#nkr_note_orig_0896007", "type": "orig", "text": "有＋（惡露）【明】"}
{"id": null, "n": "0896008", "target": "#nkr_note_orig_0896008", "type": "orig", "text": "處＝露【元】【明】【宮】"}
{"id": null, "n": "0896009", "target": "#nkr_note_orig_0896009", "type": "orig", "text": "㴃＝泣【元】【明】"}
{"id": null, "n": "0896010", "target": "#nkr_note_orig_0896010", "type": "orig", "text": "令＝今【元】【明】【宮】"}
{"id": null, "n": "0895c2101", "target": "#nkr_note_add_0895c2101", "type": "add", "text": "祇【CB】【麗-CB】，祗【大】"}
{"id": null, "n": "0896a1501", "target": "#nkr_note_add_0896a1501", "type": "add", "text": "昨【CB】，作【大】"}
{"id": null, "n": "0895011", "target": "#nkr_note_cf._0895011", "type": "cf.", "text": "cf. Śārdulakarṇa-avadāna. 摩登伽經，舍頭諫太子二十八宿經參照"}
