{"id": null, "n": null, "target": null, "type": "cf1", "text": "K11n0259_p0570b10"}
{"id": null, "n": "0827008", "target": "#nkr_note_mod_0827008", "type": "mod", "text": "緣起【大】，佛說緣起【元】【明】"}
{"id": null, "n": "0827009", "target": "#nkr_note_mod_0827009", "type": "mod", "text": "大【大】，〔－〕【宋】【明】【宮】"}
{"id": null, "n": "0827010", "target": "#nkr_note_mod_0827010", "type": "mod", "text": "國【大】，城國【宮】"}
{"id": null, "n": "0828001", "target": "#nkr_note_mod_0828001", "type": "mod", "text": "由【大】，有【宋】【元】【明】【宮】"}
{"id": null, "n": "0828002", "target": "#nkr_note_mod_0828002", "type": "mod", "text": "惟【大】，唯【宋】【元】【明】【宮】"}
{"id": null, "n": "0828003", "target": "#nkr_note_mod_0828003", "type": "mod", "text": "正修【大】，修正【宋】【元】【明】【宮】"}
{"id": null, "n": "0828004", "target": "#nkr_note_mod_0828004", "type": "mod", "text": "苾芻【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0828005", "target": "#nkr_note_mod_0828005", "type": "mod", "text": "緣起聖道經【大】，前卷終【元】，佛說緣起聖道經【明】"}
{"id": null, "n": "0827008", "target": "#nkr_note_orig_0827008", "type": "orig", "text": "（佛說）＋緣起【元】【明】"}
{"id": null, "n": "0827009", "target": "#nkr_note_orig_0827009", "type": "orig", "text": "〔大〕－【宋】【明】【宮】"}
{"id": null, "n": "0827010", "target": "#nkr_note_orig_0827010", "type": "orig", "text": "（城）＋國【宮】"}
{"id": null, "n": "0828001", "target": "#nkr_note_orig_0828001", "type": "orig", "text": "由＝有【三】【宮】"}
{"id": null, "n": "0828002", "target": "#nkr_note_orig_0828002", "type": "orig", "text": "惟＝唯【三】【宮】"}
{"id": null, "n": "0828003", "target": "#nkr_note_orig_0828003", "type": "orig", "text": "正修＝修正【三】【宮】"}
{"id": null, "n": "0828004", "target": "#nkr_note_orig_0828004", "type": "orig", "text": "〔苾芻〕－【三】"}
{"id": null, "n": "0828005", "target": "#nkr_note_orig_0828005", "type": "orig", "text": "（佛說）＋緣起【明】，緣起聖道經＝前卷終【元】"}
{"id": null, "n": "0828b2101", "target": "#nkr_note_add_0828b2101", "type": "add", "text": "思【CB】【麗-CB】，［－］【大】"}
