{"id": null, "n": null, "target": null, "type": null, "text": "彼既曲折故當直辨"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "即問教有分齊等文"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "且約今宗"}
{"id": null, "n": null, "target": null, "type": null, "text": "依律立法之意"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "梵網\n斥二乘為邪見亦是要令入大之意"}
{"id": null, "n": null, "target": null, "type": null, "text": "當知即是大乘及諸此字畢竟指誰"}
{"id": null, "n": null, "target": null, "type": null, "text": "仍分修性"}
{"id": null, "n": null, "target": null, "type": null, "text": "與天台五略暗合"}
{"id": null, "n": null, "target": null, "type": null, "text": "真如愚人作教發心誓注釋"}
{"id": null, "n": null, "target": null, "type": null, "text": "以上皆為自行"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼文"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼文"}
{"id": null, "n": null, "target": null, "type": null, "text": "所以如前"}
{"id": null, "n": null, "target": null, "type": null, "text": "有十境十乘"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": "0069001", "target": "#nkr_note_orig_0069001", "type": "orig", "text": "題疑顯下同"}
{"id": null, "n": "0069002", "target": "#nkr_note_orig_0069002", "type": "orig", "text": "＊明疑中（＊印ノ字ハ本文ト異ナル。󴦒）"}
{"id": null, "n": "0069003", "target": "#nkr_note_orig_0069003", "type": "orig", "text": "法一作附"}
{"id": null, "n": "0069004", "target": "#nkr_note_orig_0069004", "type": "orig", "text": "在一作至"}
{"id": null, "n": "0069005", "target": "#nkr_note_orig_0069005", "type": "orig", "text": "明作各"}
{"id": null, "n": "0069006", "target": "#nkr_note_orig_0069006", "type": "orig", "text": "由下一有猶字"}
{"id": null, "n": "0071001", "target": "#nkr_note_orig_0071001", "type": "orig", "text": "亦疑示"}
{"id": null, "n": "0072001", "target": "#nkr_note_orig_0072001", "type": "orig", "text": "插入因字"}
{"id": null, "n": "0072002", "target": "#nkr_note_orig_0072002", "type": "orig", "text": "期疑斯"}
{"id": null, "n": "0072003", "target": "#nkr_note_orig_0072003", "type": "orig", "text": "題疑顯下同"}
{"id": null, "n": "0072004", "target": "#nkr_note_orig_0072004", "type": "orig", "text": "為一作已"}
{"id": null, "n": "0073001", "target": "#nkr_note_orig_0073001", "type": "orig", "text": "穿字疑剩"}
{"id": null, "n": "0074001", "target": "#nkr_note_orig_0074001", "type": "orig", "text": "起疑赴"}
{"id": null, "n": "0074002", "target": "#nkr_note_orig_0074002", "type": "orig", "text": "書等一作說話穿鑿祖乘"}
{"id": null, "n": "0075001", "target": "#nkr_note_orig_0075001", "type": "orig", "text": "因一作固"}
{"id": null, "n": "0075002", "target": "#nkr_note_orig_0075002", "type": "orig", "text": "弘一作專"}
{"id": null, "n": "0078001", "target": "#nkr_note_orig_0078001", "type": "orig", "text": "於字更勘"}
{"id": null, "n": "0078002", "target": "#nkr_note_orig_0078002", "type": "orig", "text": "讟或讀"}
{"id": null, "n": "0079001", "target": "#nkr_note_orig_0079001", "type": "orig", "text": "無箴作元"}
{"id": null, "n": "0079002", "target": "#nkr_note_orig_0079002", "type": "orig", "text": "曀箴作脛"}
{"id": null, "n": "0079003", "target": "#nkr_note_orig_0079003", "type": "orig", "text": "或箴作惑"}
