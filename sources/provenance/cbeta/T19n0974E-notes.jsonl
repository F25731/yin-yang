{"id": null, "n": "0389019", "target": "#nkr_note_mod_0389019", "type": "mod", "text": "詳【大】，評【甲】"}
{"id": null, "n": "0389020", "target": "#nkr_note_mod_0389020", "type": "mod", "text": "聲【大】，紐聲【甲】"}
{"id": null, "n": "0389021", "target": "#nkr_note_mod_0389021", "type": "mod", "text": "准【大】，准之【甲】"}
{"id": null, "n": "0389022", "target": "#nkr_note_mod_0389022", "type": "mod", "text": "旨【大】，梵音大旨【甲】"}
