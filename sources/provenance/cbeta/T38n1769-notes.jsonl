{"id": null, "n": "0253001", "target": "#nkr_note_mod_0253001", "type": "mod", "text": "（九地…是）二十字【大】，〔－〕【考偽-大】"}
{"id": null, "n": "0239001", "target": "#nkr_note_orig_0239001", "type": "orig", "text": "【原】天治元年寫日光輪王寺藏本"}
{"id": null, "n": "0253001", "target": "#nkr_note_orig_0253001", "type": "orig", "text": "〔九地…是〕二十字－？"}
{"id": null, "n": "0239c2501", "target": "#nkr_note_add_0239c2501", "type": "add", "text": "竟【CB】，意【大】"}
{"id": null, "n": "0240b2001", "target": "#nkr_note_add_0240b2001", "type": "add", "text": "當入【CB】，入當【大】"}
{"id": null, "n": "0240c2101", "target": "#nkr_note_add_0240c2101", "type": "add", "text": "胡【CB】，故【大】"}
{"id": null, "n": "0242b2901", "target": "#nkr_note_add_0242b2901", "type": "add", "text": "般【CB】，槃【大】"}
{"id": null, "n": "0243a0901", "target": "#nkr_note_add_0243a0901", "type": "add", "text": "皆【CB】，音【大】"}
{"id": null, "n": "0243b0501", "target": "#nkr_note_add_0243b0501", "type": "add", "text": "人【CB】，入【大】"}
{"id": null, "n": "0243c0401", "target": "#nkr_note_add_0243c0401", "type": "add", "text": "大【CB】，太【大】"}
{"id": null, "n": "0244a1301", "target": "#nkr_note_add_0244a1301", "type": "add", "text": "［－］【CB】，答【大】"}
{"id": null, "n": "0244a1302", "target": "#nkr_note_add_0244a1302", "type": "add", "text": "答【CB】，［－］【大】"}
{"id": null, "n": "0244c2201", "target": "#nkr_note_add_0244c2201", "type": "add", "text": "惑【CB】，感【大】"}
{"id": null, "n": "0245c2201", "target": "#nkr_note_add_0245c2201", "type": "add", "text": "者【CB】，是【大】"}
{"id": null, "n": "0245c2301", "target": "#nkr_note_add_0245c2301", "type": "add", "text": "法【CB】，［－］【大】"}
{"id": null, "n": "0246b0801", "target": "#nkr_note_add_0246b0801", "type": "add", "text": "住【CB】，倒【大】"}
{"id": null, "n": "0246c0201", "target": "#nkr_note_add_0246c0201", "type": "add", "text": "末【CB】，未來【大】"}
{"id": null, "n": "0247c1801", "target": "#nkr_note_add_0247c1801", "type": "add", "text": "字【CB】，定【大】"}
{"id": null, "n": "0249a2001", "target": "#nkr_note_add_0249a2001", "type": "add", "text": "旻【CB】，是【大】"}
{"id": null, "n": "0249a2501", "target": "#nkr_note_add_0249a2501", "type": "add", "text": "不【CB】，下【大】"}
{"id": null, "n": "0250a1401", "target": "#nkr_note_add_0250a1401", "type": "add", "text": "法【CB】，怯【大】"}
{"id": null, "n": "0250a1701", "target": "#nkr_note_add_0250a1701", "type": "add", "text": "寶【CB】，實【大】"}
{"id": null, "n": "0250a2201", "target": "#nkr_note_add_0250a2201", "type": "add", "text": "兩【CB】，雨【大】"}
{"id": null, "n": "0250a2301", "target": "#nkr_note_add_0250a2301", "type": "add", "text": "裹【CB】，裏【大】"}
{"id": null, "n": "0250a2501", "target": "#nkr_note_add_0250a2501", "type": "add", "text": "懷【CB】，壞【大】"}
{"id": null, "n": "0253a2601", "target": "#nkr_note_add_0253a2601", "type": "add", "text": "時【CB】，［－］【大】"}
{"id": null, "n": "0254c2101", "target": "#nkr_note_add_0254c2101", "type": "add", "text": "濫【CB】，監【大】"}
{"id": null, "n": "0255a1201", "target": "#nkr_note_add_0255a1201", "type": "add", "text": "六【CB】，□【大】"}
{"id": null, "n": "0255a1601", "target": "#nkr_note_add_0255a1601", "type": "add", "text": "劉【CB】，㔁【大】"}
