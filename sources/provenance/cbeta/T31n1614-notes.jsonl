{"id": null, "n": "0855004", "target": "#nkr_note_mod_0855004", "type": "mod", "text": "本事分中略錄名數【大】，本事分中略錄名數【宋】【元】【明】【宮】"}
{"id": null, "n": null, "target": null, "type": null, "text": "本事分中略錄名數"}
{"id": null, "n": "0855005", "target": "#nkr_note_mod_0855005", "type": "mod", "text": "大【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0855006", "target": "#nkr_note_mod_0855006", "type": "mod", "text": "譯【大】，奉詔譯【宋】【元】【明】【宮】"}
{"id": null, "n": "0855007", "target": "#nkr_note_mod_0855007", "type": "mod", "text": "（（一切…故））二十五字宋元明宮四本俱作五言五句偈文"}
{"id": null, "n": "0855008", "target": "#nkr_note_mod_0855008", "type": "mod", "text": "分【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0855009", "target": "#nkr_note_mod_0855009", "type": "mod", "text": "如是次第【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0855010", "target": "#nkr_note_mod_0855010", "type": "mod", "text": "末【大】，未【明】"}
{"id": null, "n": "0855011", "target": "#nkr_note_mod_0855011", "type": "mod", "text": "耶【大】，〔－〕【明】"}
{"id": null, "n": "0855012", "target": "#nkr_note_mod_0855012", "type": "mod", "text": "行【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0855013", "target": "#nkr_note_mod_0855013", "type": "mod", "text": "忿【大】，念【宋】【元】"}
{"id": null, "n": "0855014", "target": "#nkr_note_mod_0855014", "type": "mod", "text": "失【大】，先【宋】"}
{"id": null, "n": "0855015", "target": "#nkr_note_mod_0855015", "type": "mod", "text": "方【大】，時【元】【明】"}
{"id": null, "n": "0855016", "target": "#nkr_note_mod_0855016", "type": "mod", "text": "時【大】，方【元】【明】"}
{"id": null, "n": "0855017", "target": "#nkr_note_mod_0855017", "type": "mod", "text": "和【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0855004", "target": "#nkr_note_orig_0855004", "type": "orig", "text": "本事分中略錄名數宋元明宮四本俱作夾註"}
{"id": null, "n": "0855005", "target": "#nkr_note_orig_0855005", "type": "orig", "text": "〔大〕－【三】【宮】"}
{"id": null, "n": "0855006", "target": "#nkr_note_orig_0855006", "type": "orig", "text": "（奉詔）＋譯【三】【宮】"}
