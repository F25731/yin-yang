{"id": null, "n": null, "target": null, "type": null, "text": "總相別相同相異相成相壞相"}
{"id": null, "n": null, "target": null, "type": null, "text": "一同時具足相應門如海\n之一滴具百川味二廣狹自在無礙門如一尺之鏡見千里影三一多相容不同門如一\n室千燈光光涉入四諸法相即自在門如金與金色不相捨離五祕密隱顯俱成門如秋\n空片月晦明相並六微細相容安立門如琉璃之瓶盛多芥子七因陀羅網境界門如兩\n鏡互明傳耀相寫八託事顯法生解門如擎拳豎臂觸目皆道九十世隔法異成門如一\n夕之夢翱翔百年十主伴圓明具德門如北辰所居眾星皆拱此十玄門一一皆具十法\n同時具足一教義二理事三境智四行位五因果六依正七體用八人法九逆順十感應"}
{"id": null, "n": null, "target": null, "type": null, "text": "莫本切門上聲煩懣"}
{"id": null, "n": null, "target": null, "type": null, "text": "居月切音厥"}
{"id": null, "n": null, "target": null, "type": null, "text": "生上聲目病生翳"}
{"id": null, "n": null, "target": null, "type": null, "text": "音題\n兔網"}
{"id": null, "n": null, "target": null, "type": null, "text": "刻鏤刀"}
{"id": null, "n": null, "target": null, "type": null, "text": "音集橈名"}
{"id": null, "n": null, "target": null, "type": null, "text": "音䲭笑也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音頗不可也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音𦌾罔也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音钁驚視"}
{"id": null, "n": null, "target": null, "type": null, "text": "上音旋下音服水回流"}
{"id": null, "n": null, "target": null, "type": null, "text": "大計切音\n第"}
{"id": null, "n": null, "target": null, "type": null, "text": "音窗撞也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音區遣也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音命辨別物名"}
{"id": null, "n": null, "target": null, "type": null, "text": "法身報身化身"}
{"id": null, "n": null, "target": null, "type": null, "text": "菩提身願身化身力身莊嚴身威勢身意\n生身福身法身智身"}
{"id": null, "n": null, "target": null, "type": null, "text": "世間\n苦出世間苦"}
{"id": null, "n": null, "target": null, "type": null, "text": "世間樂出世間樂"}
{"id": null, "n": null, "target": null, "type": null, "text": "施戒忍進禪慧方願力智"}
{"id": null, "n": null, "target": null, "type": null, "text": "聖行梵行嬰兒行病行天行"}
{"id": null, "n": null, "target": null, "type": null, "text": "頓漸秘密不定藏通別圓"}
{"id": null, "n": null, "target": null, "type": null, "text": "篇入聲暫見也"}
{"id": null, "n": null, "target": null, "type": null, "text": "縈定切玉色潔也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音贊"}
{"id": null, "n": null, "target": null, "type": null, "text": "同剋"}
{"id": null, "n": null, "target": null, "type": null, "text": "音莫渺也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音坳凸之對也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音𥥛高起也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即天台止觀"}
{"id": null, "n": null, "target": null, "type": null, "text": "自生性他生性共生性無因生性"}
{"id": null, "n": null, "target": null, "type": null, "text": "理即名字即觀\n行即相似即分證即究竟即"}
{"id": null, "n": null, "target": null, "type": null, "text": "常樂我淨"}
{"id": null, "n": null, "target": null, "type": null, "text": "色受想行識"}
{"id": null, "n": null, "target": null, "type": null, "text": "緣覺聲聞菩薩不定闡提"}
{"id": null, "n": null, "target": null, "type": null, "text": "威去聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "咸去聲沒也"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃計切"}
{"id": null, "n": null, "target": null, "type": null, "text": "音離狐貍"}
{"id": null, "n": null, "target": null, "type": null, "text": "辰上聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "上音延下音鴟好醜也"}
{"id": null, "n": null, "target": null, "type": null, "text": "則到切慍也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音垢取牛乳也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音谷車轂"}
{"id": null, "n": null, "target": null, "type": null, "text": "質涉切"}
{"id": null, "n": null, "target": null, "type": null, "text": "歌上\n聲大船也"}
{"id": null, "n": null, "target": null, "type": null, "text": "他達切"}
{"id": null, "n": null, "target": null, "type": null, "text": "身無失口無失意無失"}
{"id": null, "n": null, "target": null, "type": null, "text": "意不護身不護口不護"}
{"id": null, "n": null, "target": null, "type": null, "text": "身業輪口業輪\n意業輪"}
{"id": null, "n": null, "target": null, "type": null, "text": "身放光口說法意入定"}
{"id": null, "n": null, "target": null, "type": null, "text": "資成軌觀照軌真性軌"}
{"id": null, "n": null, "target": null, "type": null, "text": "法身報身化身"}
{"id": null, "n": null, "target": null, "type": null, "text": "住自佛性引出佛性至得佛性"}
{"id": null, "n": null, "target": null, "type": null, "text": "文字\n般若觀照般若實相般若"}
{"id": null, "n": null, "target": null, "type": null, "text": "性淨涅槃方便淨涅槃圓淨涅槃"}
{"id": null, "n": null, "target": null, "type": null, "text": "一切智道種智一切種智"}
{"id": null, "n": null, "target": null, "type": null, "text": "法身德般若德解脫德"}
{"id": null, "n": null, "target": null, "type": null, "text": "八微者即地水火風色香味觸八法"}
{"id": null, "n": null, "target": null, "type": null, "text": "空觀假觀中觀"}
{"id": null, "n": null, "target": null, "type": null, "text": "欲愛住地色愛住地無色愛住地見一切住地\n無明住地"}
{"id": null, "n": null, "target": null, "type": null, "text": "真諦俗諦第一義諦"}
{"id": null, "n": null, "target": null, "type": null, "text": "音符水鳥"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡桂切香草"}
{"id": null, "n": null, "target": null, "type": null, "text": "音彭大鵬"}
{"id": null, "n": null, "target": null, "type": null, "text": "陟盧切飛舉也"}
{"id": null, "n": null, "target": null, "type": null, "text": "烏員\n切"}
{"id": null, "n": null, "target": null, "type": null, "text": "形去聲脚脛"}
{"id": null, "n": null, "target": null, "type": null, "text": "伏忍信忍\n柔順忍無生忍寂滅忍"}
{"id": null, "n": null, "target": null, "type": null, "text": "理即名字即觀行即相似即分\n證即究竟即"}
{"id": null, "n": null, "target": null, "type": null, "text": "八相者即主住異滅本四相隨四相合成八相"}
{"id": null, "n": null, "target": null, "type": null, "text": "古釋華嚴教所被機五簡\n非器一違真二背正三乖寶四狹劣五守權"}
{"id": null, "n": null, "target": null, "type": null, "text": "身受心法四念\n處"}
{"id": null, "n": null, "target": null, "type": null, "text": "作管切"}
{"id": null, "n": null, "target": null, "type": null, "text": "音雍塞也"}
{"id": null, "n": null, "target": null, "type": null, "text": "㫖而切音支"}
{"id": null, "n": null, "target": null, "type": null, "text": "尚朱切音殊"}
{"id": null, "n": null, "target": null, "type": null, "text": "音卻\n堅也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音希日光也"}
{"id": null, "n": null, "target": null, "type": null, "text": "見一切住地欲愛住地色愛住\n地無色愛住地"}
{"id": null, "n": null, "target": null, "type": null, "text": "五法者清淨法界兼四智"}
{"id": null, "n": null, "target": null, "type": null, "text": "大圓鏡智平等性智妙觀\n察智成所作智"}
{"id": null, "n": null, "target": null, "type": null, "text": "先上聲少也"}
{"id": null, "n": null, "target": null, "type": null, "text": "諸深切"}
{"id": null, "n": null, "target": null, "type": null, "text": "音接目旁毛也"}
{"id": null, "n": null, "target": null, "type": null, "text": "古猛切"}
{"id": null, "n": null, "target": null, "type": null, "text": "上音儔下音除猶豫也"}
{"id": null, "n": null, "target": null, "type": null, "text": "悉檀此云徧施四者\n\n一世界悉檀二為八悉檀三對治悉檀四第一義悉檀"}
{"id": null, "n": null, "target": null, "type": null, "text": "音炎"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡嵒切鹽味"}
{"id": null, "n": null, "target": null, "type": null, "text": "音由󵚺也"}
{"id": null, "n": null, "target": null, "type": null, "text": "保平聲褒貶"}
{"id": null, "n": null, "target": null, "type": null, "text": "音󵚷靜也"}
{"id": null, "n": null, "target": null, "type": null, "text": "見思惑塵沙惑無明\n惑"}
{"id": null, "n": null, "target": null, "type": null, "text": "法身德般若德解脫\n德"}
{"id": null, "n": null, "target": null, "type": null, "text": "三量者現量比量非量"}
{"id": null, "n": null, "target": null, "type": null, "text": "四分者相分見分自證分證自證分"}
{"id": null, "n": null, "target": null, "type": null, "text": "隨說觀待牽引攝受生起引𤼵定異同事相違不相違十因"}
{"id": null, "n": null, "target": null, "type": null, "text": "因緣次第緣所\n緣緣增上緣"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂現報生報後報"}
{"id": null, "n": null, "target": null, "type": null, "text": "異熟等流離繫士用增上五果"}
{"id": null, "n": null, "target": null, "type": null, "text": "煩惱魔五陰魔死魔天魔"}
{"id": null, "n": null, "target": null, "type": null, "text": "音藥鎻鑰"}
{"id": null, "n": null, "target": null, "type": null, "text": "空胡切音枯判也"}
{"id": null, "n": null, "target": null, "type": null, "text": "鰕去聲孔〡也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音捻登也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音帝"}
{"id": null, "n": null, "target": null, "type": null, "text": "羽敏切音允歿也"}
{"id": null, "n": null, "target": null, "type": null, "text": "五忽切不動貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "音慈引鐵石"}
{"id": null, "n": null, "target": null, "type": null, "text": "於計切蔽也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音昏"}
{"id": null, "n": null, "target": null, "type": null, "text": "音善\n自專也"}
{"id": null, "n": null, "target": null, "type": null, "text": "息恣切"}
{"id": null, "n": null, "target": null, "type": null, "text": "業相轉相現相"}
{"id": null, "n": null, "target": null, "type": null, "text": "智相相續\n相執取相計名字相起業相業繫苦相"}
{"id": null, "n": null, "target": null, "type": null, "text": "第七識具我癡我見我慢我愛\n四惑"}
{"id": null, "n": null, "target": null, "type": null, "text": "即是四流謂欲流有流見流無明流"}
{"id": null, "n": null, "target": null, "type": null, "text": "慢過慢慢過慢我慢邪慢增上慢卑劣慢"}
{"id": null, "n": null, "target": null, "type": null, "text": "即十二因緣中惑業苦三道"}
{"id": null, "n": null, "target": null, "type": null, "text": "一得謂於\n諸法成就不失二命根謂第八識種連持色心三眾同分謂一類有情自體相似四異生\n性謂由二障種趣類各別五無想定謂想等不行令身安和六滅盡定謂六七心聚皆悉\n滅盡七無想報謂修無想定感彼天果八名身能詮諸法自性九句身能詮諸法差別十\n文身能為上二所依十一生謂先無今有十二住謂有位暫停十三老謂住別前後亦名\n為異十四無常謂今有後無十五流轉謂因果相續十六定異謂因果差別十七相應謂\n因果事業和合而起十八勢速謂諸有為法流轉迅疾十九次第謂編列有敘令不紊亂\n二十時謂時節分限二十一方謂色處分劑二十二數謂諸法數量二十三和合謂諸行\n\n緣會二十四不和合謂諸行緣乖"}
{"id": null, "n": null, "target": null, "type": null, "text": "於計切眼疾也"}
{"id": null, "n": null, "target": null, "type": null, "text": "休去聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "音忽風吹起也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音𮌎"}
{"id": null, "n": null, "target": null, "type": null, "text": "古忽切沒\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音雞係也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音釋蟲行毒也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即三性之相對上體言故稱為相"}
{"id": null, "n": null, "target": null, "type": null, "text": "即六塵"}
{"id": null, "n": null, "target": null, "type": null, "text": "自生他生共生無因生名四執性破此四執名四實性"}
{"id": null, "n": null, "target": null, "type": null, "text": "五忽切音兀"}
{"id": null, "n": null, "target": null, "type": null, "text": "音捉治玉"}
{"id": null, "n": null, "target": null, "type": null, "text": "與咨同"}
{"id": null, "n": null, "target": null, "type": null, "text": "乞約切音却堅也"}
{"id": null, "n": null, "target": null, "type": null, "text": "之人切音真陶也"}
{"id": null, "n": null, "target": null, "type": null, "text": "身見邊見邪見見取見戒禁取見"}
{"id": null, "n": null, "target": null, "type": null, "text": "二乘所修無常苦無我向下所說大乘真\n實之法超三修曰勝"}
{"id": null, "n": null, "target": null, "type": null, "text": "三權者言權巧說三乘之法"}
{"id": null, "n": null, "target": null, "type": null, "text": "音斤骨絡"}
{"id": null, "n": null, "target": null, "type": null, "text": "乙甲切"}
{"id": null, "n": null, "target": null, "type": null, "text": "音勉思也"}
{"id": null, "n": null, "target": null, "type": null, "text": "于眷切音衒"}
{"id": null, "n": null, "target": null, "type": null, "text": "上筭\n平聲下森入聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "茲即切受賄也"}
{"id": null, "n": null, "target": null, "type": null, "text": "一自性妄想二差別妄想三攝受積聚妄想四我見\n妄想五我所妄想六有念妄想七不念妄想八俱相違妄想"}
{"id": null, "n": null, "target": null, "type": null, "text": "一相應縛二所緣縛三貪縛四瞋縛五見取縛六戒\n取縛"}
{"id": null, "n": null, "target": null, "type": null, "text": "上音旋下音服水回流也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音遂禾󲏗"}
{"id": null, "n": null, "target": null, "type": null, "text": "音恣漚也"}
{"id": null, "n": null, "target": null, "type": null, "text": "古猛\n切國上聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "音允"}
{"id": null, "n": null, "target": null, "type": null, "text": "一能殺二所殺三殺相"}
{"id": null, "n": null, "target": null, "type": null, "text": "正因緣因了因"}
{"id": null, "n": null, "target": null, "type": null, "text": "上音央下音倔尊者名"}
{"id": null, "n": null, "target": null, "type": null, "text": "音踏"}
{"id": null, "n": null, "target": null, "type": null, "text": "先結切"}
{"id": null, "n": null, "target": null, "type": null, "text": "堅堯切不孝鳥"}
{"id": null, "n": null, "target": null, "type": null, "text": "音敬食父獸"}
{"id": null, "n": null, "target": null, "type": null, "text": "方問切音糞"}
{"id": null, "n": null, "target": null, "type": null, "text": "音偷鍮石"}
{"id": null, "n": null, "target": null, "type": null, "text": "輕入聲空閒也"}
{"id": null, "n": null, "target": null, "type": null, "text": "蘭上聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "楚委\n切"}
{"id": null, "n": null, "target": null, "type": null, "text": "東持國南增長西廣目北多聞"}
{"id": null, "n": null, "target": null, "type": null, "text": "古活切"}
{"id": null, "n": null, "target": null, "type": null, "text": "音牒重也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音掩睡中魘也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音藝寐言"}
{"id": null, "n": null, "target": null, "type": null, "text": "音嚴相著\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音單"}
{"id": null, "n": null, "target": null, "type": null, "text": "一八切音揖盛光也"}
{"id": null, "n": null, "target": null, "type": null, "text": "二十五諦者初立冥性從冥生覺覺生我心心生五塵塵生五大大生十\n一根後復有神我為二十五諦"}
{"id": null, "n": null, "target": null, "type": null, "text": "烏谷切"}
{"id": null, "n": null, "target": null, "type": null, "text": "蘊入聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "音孛"}
{"id": null, "n": null, "target": null, "type": null, "text": "羊進切"}
{"id": null, "n": null, "target": null, "type": null, "text": "坐平聲身短"}
{"id": null, "n": null, "target": null, "type": null, "text": "音使"}
{"id": null, "n": null, "target": null, "type": null, "text": "音埀擊也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音良"}
{"id": null, "n": null, "target": null, "type": null, "text": "居月切音厥"}
