{"id": null, "n": null, "target": null, "type": null, "text": "時占反"}
{"id": null, "n": "0868004", "target": null, "type": "orig", "text": "卷字次行聖本有歸命大智海毘盧遮那佛十字"}
{"id": null, "n": "0868006", "target": null, "type": "orig", "text": "〔天竺〕－【三】"}
{"id": null, "n": "0868006", "target": null, "type": "mod", "text": "天竺【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0868007", "target": null, "type": "orig", "text": "藏＋（法師）【三】"}
{"id": null, "n": "0868007", "target": null, "type": "mod", "text": "藏【大】，藏法師【宋】【元】【明】"}
{"id": null, "n": "0868008", "target": null, "type": "orig", "text": "〔等〕－【三】"}
{"id": null, "n": "0868008", "target": null, "type": "mod", "text": "等【大】，〔－〕【宋】【元】【明】"}
