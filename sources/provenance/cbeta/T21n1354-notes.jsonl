{"id": null, "n": "0868001", "target": "#nkr_note_mod_0868001", "type": "mod", "text": "（我闍…佛）十五字【大】，〔－〕【明】，【原】麗本"}
{"id": null, "n": "0868002", "target": "#nkr_note_mod_0868002", "type": "mod", "text": "來【大】，來遣二菩薩送呪奉釋迦如來護持世間【宋】，來助護持世間【元】，來助護持世間神呪【明】，來遣二菩薩送呪奉釋迦如來助護持世間【聖】"}
{"id": null, "n": "0868003", "target": "#nkr_note_mod_0868003", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0868005", "target": "#nkr_note_mod_0868005", "type": "mod", "text": "（隋天…譯）十一字【大】，〔－〕【聖】"}
{"id": null, "n": "0868006", "target": "#nkr_note_mod_0868006", "type": "mod", "text": "天竺【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0868007", "target": "#nkr_note_mod_0868007", "type": "mod", "text": "藏【大】，藏法師【宋】【元】【明】"}
{"id": null, "n": "0868008", "target": "#nkr_note_mod_0868008", "type": "mod", "text": "等【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0868009", "target": "#nkr_note_mod_0868009", "type": "mod", "text": "城【大】，國【宋】【元】【明】"}
{"id": null, "n": "0868010", "target": "#nkr_note_mod_0868010", "type": "mod", "text": "叉【大】，〔－〕【聖】"}
{"id": null, "n": "0868011", "target": "#nkr_note_mod_0868011", "type": "mod", "text": "耶【大】，祁【宋】【元】【明】"}
{"id": null, "n": "0868012", "target": "#nkr_note_mod_0868012", "type": "mod", "text": "燈【大】＊，燈王【元】【明】＊"}
{"id": null, "n": "0868013", "target": "#nkr_note_mod_0868013", "type": "mod", "text": "他【大】＊，蛇【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0868014", "target": "#nkr_note_mod_0868014", "type": "mod", "text": "上【大】＊，上聲【明】＊"}
{"id": null, "n": "0868015", "target": "#nkr_note_mod_0868015", "type": "mod", "text": "地【大】，他【宋】【元】【明】"}
{"id": null, "n": "0868016", "target": "#nkr_note_mod_0868016", "type": "mod", "text": "反【大】，切【明】"}
{"id": null, "n": "0868017", "target": "#nkr_note_mod_0868017", "type": "mod", "text": "娑【大】，婆【宋】"}
{"id": null, "n": "0868018", "target": "#nkr_note_mod_0868018", "type": "mod", "text": "弟【大】，第【宋】【元】【明】"}
{"id": null, "n": "0868019", "target": "#nkr_note_mod_0868019", "type": "mod", "text": "囉【大】，羅【宋】【元】【明】"}
{"id": null, "n": "0868020", "target": "#nkr_note_mod_0868020", "type": "mod", "text": "如是【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0868021", "target": "#nkr_note_mod_0868021", "type": "mod", "text": "燈【大】＊，燈王【元】【明】＊，登【聖】＊"}
{"id": null, "n": "0868022", "target": "#nkr_note_mod_0868022", "type": "mod", "text": "燈【大】，燈王【元】【明】"}
{"id": null, "n": "0868023", "target": "#nkr_note_mod_0868023", "type": "mod", "text": "盤【大】＊，槃【宋】【元】【明】【聖】＊"}
{"id": null, "n": "0868024", "target": "#nkr_note_mod_0868024", "type": "mod", "text": "羅【大】，伽【聖】"}
{"id": null, "n": "0868025", "target": "#nkr_note_mod_0868025", "type": "mod", "text": "痟【大】，消【宋】【元】【明】【聖】"}
{"id": null, "n": "0869001", "target": "#nkr_note_mod_0869001", "type": "mod", "text": "縣【大】，懸【聖】"}
{"id": null, "n": "0869002", "target": "#nkr_note_mod_0869002", "type": "mod", "text": "陀【大】，阿【明】"}
{"id": null, "n": "0869003", "target": "#nkr_note_mod_0869003", "type": "mod", "text": "時【大】，是【聖】"}
{"id": null, "n": "0869004", "target": "#nkr_note_mod_0869004", "type": "mod", "text": "菩【大】，婆【明】"}
{"id": null, "n": "0869005", "target": "#nkr_note_mod_0869005", "type": "mod", "text": "上【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0869006", "target": "#nkr_note_mod_0869006", "type": "mod", "text": "上【大】＊，上聲【明】＊"}
{"id": null, "n": "0869007", "target": "#nkr_note_mod_0869007", "type": "mod", "text": "上【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0869008", "target": "#nkr_note_mod_0869008", "type": "mod", "text": "上【大】，上聲【明】"}
{"id": null, "n": "0869009", "target": "#nkr_note_mod_0869009", "type": "mod", "text": "細【大】，紐【聖】"}
{"id": null, "n": "0869010", "target": "#nkr_note_mod_0869010", "type": "mod", "text": "茶【大】＊，荼【聖】＊"}
{"id": null, "n": "0869011", "target": "#nkr_note_mod_0869011", "type": "mod", "text": "常【大】，當【明】"}
{"id": null, "n": "0869012", "target": "#nkr_note_mod_0869012", "type": "mod", "text": "復倍【大】，亦復【宋】【元】【明】"}
{"id": null, "n": "0869013", "target": "#nkr_note_mod_0869013", "type": "mod", "text": "上【大】＊，上聲【明】＊"}
{"id": null, "n": "0869014", "target": "#nkr_note_mod_0869014", "type": "mod", "text": "囉【大】，羅【宋】【元】【明】【聖】"}
{"id": null, "n": "0869015", "target": "#nkr_note_mod_0869015", "type": "mod", "text": "跋【大】＊，㕹【宋】＊，吠【元】【明】＊"}
{"id": null, "n": "0869016", "target": "#nkr_note_mod_0869016", "type": "mod", "text": "上【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0869017", "target": "#nkr_note_mod_0869017", "type": "mod", "text": "羅【大】，囉【宋】【元】【明】"}
{"id": null, "n": "0869018", "target": "#nkr_note_mod_0869018", "type": "mod", "text": "阿難【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0869019", "target": "#nkr_note_mod_0869019", "type": "mod", "text": "已【大】，〔－〕【聖】"}
{"id": null, "n": "0869020", "target": "#nkr_note_mod_0869020", "type": "mod", "text": "上【大】下同，上聲【明】下同"}
{"id": null, "n": "0869021", "target": "#nkr_note_mod_0869021", "type": "mod", "text": "虛【大】，盧【明】"}
{"id": null, "n": "0869022", "target": "#nkr_note_mod_0869022", "type": "mod", "text": "反【大】＊，切【明】＊"}
{"id": null, "n": "0869023", "target": "#nkr_note_mod_0869023", "type": "mod", "text": "波【大】，波上【宋】【元】【明】，婆上【聖】"}
{"id": null, "n": "0870001", "target": "#nkr_note_mod_0870001", "type": "mod", "text": "乾【大】，于【聖】"}
{"id": null, "n": "0870002", "target": "#nkr_note_mod_0870002", "type": "mod", "text": "界【大】＊，戒【聖】＊"}
{"id": null, "n": "0870003", "target": "#nkr_note_mod_0870003", "type": "mod", "text": "波【大】，婆【宋】【元】【明】，【聖】＊"}
{"id": null, "n": "0870004", "target": "#nkr_note_mod_0870004", "type": "mod", "text": "呵【大】＊，訶【聖】＊"}
{"id": null, "n": "0870005", "target": "#nkr_note_mod_0870005", "type": "mod", "text": "阿【大】，呵【明】"}
{"id": null, "n": "0870006", "target": "#nkr_note_mod_0870006", "type": "mod", "text": "婁【大】，樓【宋】【元】【明】"}
{"id": null, "n": "0870007", "target": "#nkr_note_mod_0870007", "type": "mod", "text": "傷【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0870008", "target": "#nkr_note_mod_0870008", "type": "mod", "text": "日【大】，〔－〕【聖】"}
{"id": null, "n": "0870009", "target": "#nkr_note_mod_0870009", "type": "mod", "text": "癩【大】，癘【宋】【元】【明】"}
{"id": null, "n": "0870010", "target": "#nkr_note_mod_0870010", "type": "mod", "text": "創【大】，瘡【宋】【元】【明】"}
{"id": null, "n": "0870011", "target": "#nkr_note_mod_0870011", "type": "mod", "text": "佯【大】＊，羊【宋】【元】【明】【聖】＊"}
{"id": null, "n": "0870012", "target": "#nkr_note_mod_0870012", "type": "mod", "text": "口脣患齒患【大】，患口脣牙齒【明】"}
{"id": null, "n": "0870013", "target": "#nkr_note_mod_0870013", "type": "mod", "text": "嘖【大】，嘖上【宋】【元】，嘖上聲【明】"}
