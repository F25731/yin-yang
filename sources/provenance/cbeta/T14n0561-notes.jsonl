{"id": null, "n": "0912038", "target": "#nkr_note_mod_0912038", "type": "mod", "text": "（僧祐…錄）十二字【大】，失譯附宋錄【宋】【宮】，失譯人名附劉宋錄第二出【元】【明】"}
{"id": null, "n": "0912039", "target": "#nkr_note_mod_0912039", "type": "mod", "text": "舌【大】＊，口【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0913001", "target": "#nkr_note_mod_0913001", "type": "mod", "text": "言【大】，言善哉是問大快【宋】【元】【明】【宮】"}
{"id": null, "n": "0913002", "target": "#nkr_note_mod_0913002", "type": "mod", "text": "想行【大】，癢思想生死【宋】【元】【明】【宮】"}
{"id": null, "n": "0913003", "target": "#nkr_note_mod_0913003", "type": "mod", "text": "好【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0913004", "target": "#nkr_note_mod_0913004", "type": "mod", "text": "捶【大】，打【宋】【元】【明】【宮】"}
{"id": null, "n": "0913005", "target": "#nkr_note_mod_0913005", "type": "mod", "text": "亦【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0913006", "target": "#nkr_note_mod_0913006", "type": "mod", "text": "木革桴【大】，皮亦不從𣞙亦不從桴及【宋】【元】【明】【宮】"}
{"id": null, "n": "0913007", "target": "#nkr_note_mod_0913007", "type": "mod", "text": "便【大】，自【宋】【元】【明】【宮】"}
{"id": null, "n": "0913008", "target": "#nkr_note_mod_0913008", "type": "mod", "text": "正【大】，整【明】"}
{"id": null, "n": "0913009", "target": "#nkr_note_mod_0913009", "type": "mod", "text": "世【大】，世世【宋】【元】【明】【宮】"}
{"id": null, "n": "0913010", "target": "#nkr_note_mod_0913010", "type": "mod", "text": "健【大】，揵【宋】【元】【明】【宮】"}
{"id": null, "n": "0912038", "target": "#nkr_note_orig_0912038", "type": "orig", "text": "（僧祐…錄）十二字＝失譯附宋錄【宋】【宮】，失譯人名附劉宋錄第二出【元】【明】"}
{"id": null, "n": "0912039", "target": "#nkr_note_orig_0912039", "type": "orig", "text": "舌＝口【三】【宮】＊"}
{"id": null, "n": "0913001", "target": "#nkr_note_orig_0913001", "type": "orig", "text": "言＋（善哉是問大快）【三】【宮】"}
{"id": null, "n": "0913002", "target": "#nkr_note_orig_0913002", "type": "orig", "text": "想行＝癢思想生死【三】【宮】"}
{"id": null, "n": "0913003", "target": "#nkr_note_orig_0913003", "type": "orig", "text": "〔好〕－【三】【宮】"}
{"id": null, "n": "0913004", "target": "#nkr_note_orig_0913004", "type": "orig", "text": "捶＝打【三】【宮】"}
{"id": null, "n": "0913005", "target": "#nkr_note_orig_0913005", "type": "orig", "text": "〔亦〕－【三】【宮】"}
{"id": null, "n": "0913006", "target": "#nkr_note_orig_0913006", "type": "orig", "text": "木革桴＝（皮亦不從𣞙亦不從桴及）十字【三】【宮】"}
{"id": null, "n": "0913007", "target": "#nkr_note_orig_0913007", "type": "orig", "text": "便＝自【三】【宮】"}
{"id": null, "n": "0913008", "target": "#nkr_note_orig_0913008", "type": "orig", "text": "正＝整【明】"}
{"id": null, "n": "0913009", "target": "#nkr_note_orig_0913009", "type": "orig", "text": "世＋（世）【三】【宮】"}
{"id": null, "n": "0913010", "target": "#nkr_note_orig_0913010", "type": "orig", "text": "健＝揵【三】【宮】"}
