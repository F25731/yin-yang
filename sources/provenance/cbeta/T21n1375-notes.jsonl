{"id": null, "n": null, "target": null, "type": null, "text": "但是口邊作字者皆可彈舌道之"}
{"id": null, "n": "0894007", "target": "#nkr_note_mod_0894007", "type": "mod", "text": "佛說【大】，〔－〕【宋】【元】【明】，【原】麗本"}
{"id": null, "n": "0894008", "target": "#nkr_note_mod_0894008", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0894009", "target": "#nkr_note_mod_0894009", "type": "mod", "text": "三【大】，唐三【宋】【元】【明】"}
{"id": null, "n": "0894010", "target": "#nkr_note_mod_0894010", "type": "mod", "text": "咸【大】，我【元】【明】"}
{"id": null, "n": "0895001", "target": "#nkr_note_mod_0895001", "type": "mod", "text": "往【大】，彼【宋】【元】【明】"}
{"id": null, "n": "0895002", "target": "#nkr_note_mod_0895002", "type": "mod", "text": "復【大】，復彼人【宋】【元】【明】"}
{"id": null, "n": "0895003", "target": "#nkr_note_mod_0895003", "type": "mod", "text": "授【大】，受【宋】【元】"}
{"id": null, "n": "0895004", "target": "#nkr_note_mod_0895004", "type": "mod", "text": "但【大】，呾【宋】"}
{"id": null, "n": "0895005", "target": "#nkr_note_mod_0895005", "type": "mod", "text": "呾【大】，怛【宋】【元】【明】"}
{"id": null, "n": "0895006", "target": "#nkr_note_mod_0895006", "type": "mod", "text": "去【大】＊，去聲【明】＊"}
{"id": null, "n": "0895007", "target": "#nkr_note_mod_0895007", "type": "mod", "text": "耶【大】，邪【宋】【元】【明】"}
{"id": null, "n": "0895008", "target": "#nkr_note_mod_0895008", "type": "mod", "text": "佛說【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0894007", "target": "#nkr_note_orig_0894007", "type": "orig", "text": "【原】麗本，〔佛說〕－【三】"}
{"id": null, "n": "0894008", "target": "#nkr_note_orig_0894008", "type": "orig", "text": "〔一卷〕－【三】"}
{"id": null, "n": "0894009", "target": "#nkr_note_orig_0894009", "type": "orig", "text": "（唐）＋三【三】"}
{"id": null, "n": "0894010", "target": "#nkr_note_orig_0894010", "type": "orig", "text": "咸＝我【元】【明】"}
{"id": null, "n": "0895001", "target": "#nkr_note_orig_0895001", "type": "orig", "text": "往＝彼【三】"}
{"id": null, "n": "0895002", "target": "#nkr_note_orig_0895002", "type": "orig", "text": "復＋（彼人）【三】"}
{"id": null, "n": "0895003", "target": "#nkr_note_orig_0895003", "type": "orig", "text": "授＝受【宋】【元】"}
{"id": null, "n": "0895004", "target": "#nkr_note_orig_0895004", "type": "orig", "text": "但＝呾【宋】"}
{"id": null, "n": "0895005", "target": "#nkr_note_orig_0895005", "type": "orig", "text": "呾＝怛【三】"}
{"id": null, "n": "0895006", "target": "#nkr_note_orig_0895006", "type": "orig", "text": "去＋（聲）【明】＊"}
{"id": null, "n": "0895007", "target": "#nkr_note_orig_0895007", "type": "orig", "text": "耶＝邪【三】"}
{"id": null, "n": "0895008", "target": "#nkr_note_orig_0895008", "type": "orig", "text": "〔佛說〕－【三】"}
{"id": null, "n": "0894007", "target": "#nkr_note_rest_0894007", "type": "rest", "text": "【原】麗本"}
