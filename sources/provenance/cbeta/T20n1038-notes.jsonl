{"id": null, "n": "0021022", "target": "#nkr_note_mod_0021022", "type": "mod", "text": "音【大】，音菩薩【宋】【元】【明】【甲】"}
{"id": null, "n": "0021023", "target": "#nkr_note_mod_0021023", "type": "mod", "text": "經【大】，經一卷【甲】"}
{"id": null, "n": "0021024", "target": "#nkr_note_mod_0021024", "type": "mod", "text": "大【大】，〔－〕【明】"}
{"id": null, "n": "0021025", "target": "#nkr_note_mod_0021025", "type": "mod", "text": "寺【大】，〔－〕【宋】"}
{"id": null, "n": "0021026", "target": "#nkr_note_mod_0021026", "type": "mod", "text": "釋【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0021027", "target": "#nkr_note_mod_0021027", "type": "mod", "text": "山【大】，山中【宋】【元】【明】"}
{"id": null, "n": "0021028", "target": "#nkr_note_mod_0021028", "type": "mod", "text": "胝【大】，知【甲】"}
{"id": null, "n": "0021029", "target": "#nkr_note_mod_0021029", "type": "mod", "text": "從【大】，時從【宋】【元】【明】"}
{"id": null, "n": "0021030", "target": "#nkr_note_mod_0021030", "type": "mod", "text": "遏【大】＊，〔－〕【宋】【元】【明】【甲】＊"}
{"id": null, "n": "0021031", "target": "#nkr_note_mod_0021031", "type": "mod", "text": "上【大】下同，上聲【明】下同"}
{"id": null, "n": "0021032", "target": "#nkr_note_mod_0021032", "type": "mod", "text": "那【大】，那上【宋】【元】【甲】，那上聲【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "上"}
{"id": null, "n": "0021033", "target": "#nkr_note_mod_0021033", "type": "mod", "text": "利【大】，𠼝【宋】【元】【明】【甲】"}
{"id": null, "n": "0021034", "target": "#nkr_note_mod_0021034", "type": "mod", "text": "二【大】＊，上二【宋】【元】【甲】＊，上聲二【明】＊"}
{"id": null, "n": "0021035", "target": "#nkr_note_mod_0021035", "type": "mod", "text": "去【大】下同，去聲【明】下同"}
{"id": null, "n": "0021036", "target": "#nkr_note_mod_0021036", "type": "mod", "text": "菩【大】，菩去【宋】【元】，菩去聲【明】"}
{"id": null, "n": "0021037", "target": "#nkr_note_mod_0021037", "type": "mod", "text": "埵【大】，埵去【宋】【元】【甲】，埵去聲【明】"}
{"id": null, "n": "0021038", "target": "#nkr_note_mod_0021038", "type": "mod", "text": "去【大】＊，〔－〕【宋】【元】【明】【甲】＊"}
{"id": null, "n": "0021039", "target": "#nkr_note_mod_0021039", "type": "mod", "text": "佉【大】＊，佉上【宋】【元】【甲】＊，佉上聲【明】＊"}
{"id": null, "n": "0021040", "target": "#nkr_note_mod_0021040", "type": "mod", "text": "伽羅【大】，紇囉【宋】【元】【明】【甲】"}
{"id": null, "n": "0021041", "target": "#nkr_note_mod_0021041", "type": "mod", "text": "摩【大】，麼【甲】"}
{"id": null, "n": "0021042", "target": "#nkr_note_mod_0021042", "type": "mod", "text": "麼【大】，摩【宋】【元】"}
{"id": null, "n": "0021043", "target": "#nkr_note_mod_0021043", "type": "mod", "text": "若【大】，苦【甲】"}
{"id": null, "n": "0021044", "target": "#nkr_note_mod_0021044", "type": "mod", "text": "音【大】，〔－〕【宋】【元】【甲】"}
{"id": null, "n": "0021045", "target": "#nkr_note_mod_0021045", "type": "mod", "text": "陀【大】，陀去【宋】【元】【甲】，陀去聲【明】"}
{"id": null, "n": "0021046", "target": "#nkr_note_mod_0021046", "type": "mod", "text": "去【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0021047", "target": "#nkr_note_mod_0021047", "type": "mod", "text": "娑【大】，娑上【宋】【元】，娑上聲【明】"}
{"id": null, "n": "0021048", "target": "#nkr_note_mod_0021048", "type": "mod", "text": "摩【大】，麼【宋】【元】【明】【甲】"}
{"id": null, "n": "0021049", "target": "#nkr_note_mod_0021049", "type": "mod", "text": "波【大】，波去【宋】【元】【甲】，波去聲【明】"}
