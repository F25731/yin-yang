{"id": null, "n": null, "target": null, "type": null, "text": "姚登反"}
{"id": null, "n": "0477009", "target": "#nkr_note_mod_0477009", "type": "mod", "text": "大金色孔雀王呪經【大】，大孔雀神呪經【元】，佛說大金色孔雀王呪經【明】，【原】麗本"}
{"id": null, "n": "0477010", "target": "#nkr_note_mod_0477010", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0477011", "target": "#nkr_note_mod_0477011", "type": "mod", "text": "（失譯…錄）八字【大】，失譯年附秦錄拾遺編入【宋】，東晉西域沙門帛尸𥟦蜜多羅譯【元】【明】"}
{"id": null, "n": "0477012", "target": "#nkr_note_mod_0477012", "type": "mod", "text": "梨【大】＊，𥟦【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0477013", "target": "#nkr_note_mod_0477013", "type": "mod", "text": "夜【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0477014", "target": "#nkr_note_mod_0477014", "type": "mod", "text": "𡾄【大】＊，藪【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0477015", "target": "#nkr_note_mod_0477015", "type": "mod", "text": "妬【大】＊，垢【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0477016", "target": "#nkr_note_mod_0477016", "type": "mod", "text": "斗【大】＊，升【元】【明】＊"}
{"id": null, "n": "0477017", "target": "#nkr_note_mod_0477017", "type": "mod", "text": "帝【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0478001", "target": "#nkr_note_mod_0478001", "type": "mod", "text": "訶【大】＊，阿【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0478002", "target": "#nkr_note_mod_0478002", "type": "mod", "text": "（賒婆…膩）十三字【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0478003", "target": "#nkr_note_mod_0478003", "type": "mod", "text": "即說【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0478004", "target": "#nkr_note_mod_0478004", "type": "mod", "text": "婆【大】，娑【宋】【元】【明】"}
{"id": null, "n": "0478005", "target": "#nkr_note_mod_0478005", "type": "mod", "text": "日【大】，白【宋】【元】【明】"}
{"id": null, "n": "0478006", "target": "#nkr_note_mod_0478006", "type": "mod", "text": "分【大】，爾【宋】【元】【明】"}
{"id": null, "n": "0478007", "target": "#nkr_note_mod_0478007", "type": "mod", "text": "乎【大】，呼【元】【明】"}
{"id": null, "n": "0478008", "target": "#nkr_note_mod_0478008", "type": "mod", "text": "赤【大】，亦【宋】"}
{"id": null, "n": "0478009", "target": "#nkr_note_mod_0478009", "type": "mod", "text": "諍【大】，〔－〕【元】【明】"}
{"id": null, "n": "0478010", "target": "#nkr_note_mod_0478010", "type": "mod", "text": "仙角【大】，仙覺【宋】【元】，名覺【明】"}
{"id": null, "n": "0478011", "target": "#nkr_note_mod_0478011", "type": "mod", "text": "吉【大】，名仙吉【宋】【元】【明】"}
{"id": null, "n": "0478012", "target": "#nkr_note_mod_0478012", "type": "mod", "text": "受【大】，壽【宋】【元】【明】"}
{"id": null, "n": "0478013", "target": "#nkr_note_mod_0478013", "type": "mod", "text": "膩【大】，膩伽多膩【宋】【元】【明】"}
{"id": null, "n": "0478014", "target": "#nkr_note_mod_0478014", "type": "mod", "text": "摸【大】，摩【宋】【元】【明】"}
{"id": null, "n": "0478015", "target": "#nkr_note_mod_0478015", "type": "mod", "text": "反【大】下同，切【明】下同"}
{"id": null, "n": "0478016", "target": "#nkr_note_mod_0478016", "type": "mod", "text": "阿【大】，陀【宋】【元】【明】"}
{"id": null, "n": "0478017", "target": "#nkr_note_mod_0478017", "type": "mod", "text": "奈【大】＊，茶【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0478018", "target": "#nkr_note_mod_0478018", "type": "mod", "text": "𡃙【大】，伐【宋】【元】【明】"}
{"id": null, "n": "0478019", "target": "#nkr_note_mod_0478019", "type": "mod", "text": "伺【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0478020", "target": "#nkr_note_mod_0478020", "type": "mod", "text": "皆【大】，皆悉【宋】【元】【明】"}
{"id": null, "n": "0478021", "target": "#nkr_note_mod_0478021", "type": "mod", "text": "豆【大】，豆豆豆豆【元】【明】"}
{"id": null, "n": "0478022", "target": "#nkr_note_mod_0478022", "type": "mod", "text": "某【大】，其【宋】【元】【明】"}
{"id": null, "n": "0478023", "target": "#nkr_note_mod_0478023", "type": "mod", "text": "訶【大】，訶訶訶【元】【明】"}
{"id": null, "n": "0478024", "target": "#nkr_note_mod_0478024", "type": "mod", "text": "婁【大】下同，數【元】【明】下同"}
{"id": null, "n": "0478025", "target": "#nkr_note_mod_0478025", "type": "mod", "text": "普【大】，善【元】【明】"}
{"id": null, "n": "0478026", "target": "#nkr_note_mod_0478026", "type": "mod", "text": "德杜【大】，得杜【宋】，備社【元】【明】"}
{"id": null, "n": "0478027", "target": "#nkr_note_mod_0478027", "type": "mod", "text": "德【大】，備【元】【明】"}
{"id": null, "n": "0478028", "target": "#nkr_note_mod_0478028", "type": "mod", "text": "（大金…經）八字【大】，大孔雀王神呪經【元】，佛說大孔雀王神呪經【明】"}
{"id": null, "n": "0478029", "target": "#nkr_note_mod_0478029", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0477009", "target": "#nkr_note_orig_0477009", "type": "orig", "text": "【原】麗本，大金色孔雀王呪經＝大孔雀神呪經【元】，（佛說）＋大【明】"}
