{"id": null, "n": "1023004", "target": "#nkr_note_mod_1023004", "type": "mod", "text": "僧【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "1023005", "target": "#nkr_note_mod_1023005", "type": "mod", "text": "本【大】，本三【宋】，本卷下【明】，明本以前本四分律比丘戒本為上卷以此本為下卷即以二本為一本上下二卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": "1023006", "target": "#nkr_note_mod_1023006", "type": "mod", "text": "曇無德出【大】，出曇無德部【明】"}
{"id": null, "n": "1023007", "target": "#nkr_note_mod_1023007", "type": "mod", "text": "後秦世罽賓三藏【大】，姚秦【宋】【元】【明】【宮】"}
{"id": null, "n": "1023008", "target": "#nkr_note_mod_1023008", "type": "mod", "text": "崖【大】，涯【宋】【元】【明】【宮】"}
{"id": null, "n": "1023009", "target": "#nkr_note_mod_1023009", "type": "mod", "text": "最【大】，尊【宋】【元】【明】【宮】"}
{"id": null, "n": "1023010", "target": "#nkr_note_mod_1023010", "type": "mod", "text": "僧【大】，諸大德僧【宋】【元】【明】【宮】"}
{"id": null, "n": "1023011", "target": "#nkr_note_mod_1023011", "type": "mod", "text": "與比丘【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1023012", "target": "#nkr_note_mod_1023012", "type": "mod", "text": "王【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "1024001", "target": "#nkr_note_mod_1024001", "type": "mod", "text": "頃【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1024002", "target": "#nkr_note_mod_1024002", "type": "mod", "text": "磔【大】＊，搩【宋】【元】【明】【宮】＊"}
{"id": null, "n": "1024003", "target": "#nkr_note_mod_1024003", "type": "mod", "text": "以【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1024004", "target": "#nkr_note_mod_1024004", "type": "mod", "text": "比丘【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1024005", "target": "#nkr_note_mod_1024005", "type": "mod", "text": "語是比丘【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1024006", "target": "#nkr_note_mod_1024006", "type": "mod", "text": "語【大】，諸【明】"}
{"id": null, "n": "1024007", "target": "#nkr_note_mod_1024007", "type": "mod", "text": "應【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1024008", "target": "#nkr_note_mod_1024008", "type": "mod", "text": "治【大】，法治【宮】"}
{"id": null, "n": "1025001", "target": "#nkr_note_mod_1025001", "type": "mod", "text": "夜【大】，宿【宋】【元】【明】【宮】"}
{"id": null, "n": "1025002", "target": "#nkr_note_mod_1025002", "type": "mod", "text": "那【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1025003", "target": "#nkr_note_mod_1025003", "type": "mod", "text": "衣【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1025004", "target": "#nkr_note_mod_1025004", "type": "mod", "text": "今【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1025005", "target": "#nkr_note_mod_1025005", "type": "mod", "text": "是【大】，〔－〕【宋】【明】【宮】"}
{"id": null, "n": "1025006", "target": "#nkr_note_mod_1025006", "type": "mod", "text": "具【大】，臥【明】"}
{"id": null, "n": "1025007", "target": "#nkr_note_mod_1025007", "type": "mod", "text": "帖【大】＊，褋【宋】【元】【明】【宮】＊"}
{"id": null, "n": "1025008", "target": "#nkr_note_mod_1025008", "type": "mod", "text": "破【大】，破應持【元】【明】"}
{"id": null, "n": "1026001", "target": "#nkr_note_mod_1026001", "type": "mod", "text": "自【大】，目【宋】"}
{"id": null, "n": "1026002", "target": "#nkr_note_mod_1026002", "type": "mod", "text": "來【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1026003", "target": "#nkr_note_mod_1026003", "type": "mod", "text": "酥【大】＊，蘇【宋】＊"}
{"id": null, "n": "1026004", "target": "#nkr_note_mod_1026004", "type": "mod", "text": "知【大】，智【明】"}
{"id": null, "n": "1026005", "target": "#nkr_note_mod_1026005", "type": "mod", "text": "一十【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1026006", "target": "#nkr_note_mod_1026006", "type": "mod", "text": "者【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "1026007", "target": "#nkr_note_mod_1026007", "type": "mod", "text": "蟲【大】＊，虫【宋】【元】【宮】＊"}
{"id": null, "n": "1026008", "target": "#nkr_note_mod_1026008", "type": "mod", "text": "期【大】，〔－〕【宮】"}
{"id": null, "n": "1026009", "target": "#nkr_note_mod_1026009", "type": "mod", "text": "若【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1026010", "target": "#nkr_note_mod_1026010", "type": "mod", "text": "足【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1027001", "target": "#nkr_note_mod_1027001", "type": "mod", "text": "舉【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1027002", "target": "#nkr_note_mod_1027002", "type": "mod", "text": "乃至聚落【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1027003", "target": "#nkr_note_mod_1027003", "type": "mod", "text": "去【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1027004", "target": "#nkr_note_mod_1027004", "type": "mod", "text": "遊【大】，旋【宋】【元】【明】【宮】"}
{"id": null, "n": "1027005", "target": "#nkr_note_mod_1027005", "type": "mod", "text": "以指【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1027006", "target": "#nkr_note_mod_1027006", "type": "mod", "text": "攊【大】，歷【宮】"}
{"id": null, "n": "1027007", "target": "#nkr_note_mod_1027007", "type": "mod", "text": "若【大】，若自然若【宋】【元】【明】"}
{"id": null, "n": "1027008", "target": "#nkr_note_mod_1027008", "type": "mod", "text": "六十【大】，〔－〕【明】"}
{"id": null, "n": "1027009", "target": "#nkr_note_mod_1027009", "type": "mod", "text": "有【大】，若有【宋】【元】【明】【宮】"}
{"id": null, "n": "1027010", "target": "#nkr_note_mod_1027010", "type": "mod", "text": "如是諫【大】，諫是比丘【宋】【元】【明】【宮】"}
{"id": null, "n": "1027011", "target": "#nkr_note_mod_1027011", "type": "mod", "text": "畜【大】，當【宋】【宮】，共【元】【明】"}
{"id": null, "n": "1027012", "target": "#nkr_note_mod_1027012", "type": "mod", "text": "同【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1027013", "target": "#nkr_note_mod_1027013", "type": "mod", "text": "彼比丘【大】，是沙彌【宋】【元】【明】"}
{"id": null, "n": "1027014", "target": "#nkr_note_mod_1027014", "type": "mod", "text": "三【大】，三呵【宋】【元】【明】【宮】"}
{"id": null, "n": "1027015", "target": "#nkr_note_mod_1027015", "type": "mod", "text": "後【大】，去【宋】【元】【明】【宮】"}
{"id": null, "n": "1027016", "target": "#nkr_note_mod_1027016", "type": "mod", "text": "行【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1028001", "target": "#nkr_note_mod_1028001", "type": "mod", "text": "厚【大】，友【宋】【元】【明】【宮】"}
{"id": null, "n": "1028002", "target": "#nkr_note_mod_1028002", "type": "mod", "text": "時【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1028003", "target": "#nkr_note_mod_1028003", "type": "mod", "text": "知他【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1028004", "target": "#nkr_note_mod_1028004", "type": "mod", "text": "已【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1028005", "target": "#nkr_note_mod_1028005", "type": "mod", "text": "法【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1028006", "target": "#nkr_note_mod_1028006", "type": "mod", "text": "如是【大】，作如是【宋】【元】【明】【宮】"}
{"id": null, "n": "1028007", "target": "#nkr_note_mod_1028007", "type": "mod", "text": "檀【大】，壇【宋】【元】【明】【宮】"}
{"id": null, "n": "1028008", "target": "#nkr_note_mod_1028008", "type": "mod", "text": "如是【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1028009", "target": "#nkr_note_mod_1028009", "type": "mod", "text": "是【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1028010", "target": "#nkr_note_mod_1028010", "type": "mod", "text": "是【大】，此【宋】【元】【明】【宮】"}
{"id": null, "n": "1028011", "target": "#nkr_note_mod_1028011", "type": "mod", "text": "多學【大】，學戒【宋】【元】【明】【宮】"}
{"id": null, "n": "1028012", "target": "#nkr_note_mod_1028012", "type": "mod", "text": "〔－〕【CB】【磧-CB】【宋】【元】【明】【宮】，坐【大】，坐【大】【麗-CB】"}
{"id": null, "n": "1028013", "target": "#nkr_note_mod_1028013", "type": "mod", "text": "一十【大】，〔－〕【元】"}
{"id": null, "n": "1028014", "target": "#nkr_note_mod_1028014", "type": "mod", "text": "身【大】＊，衣【明】＊"}
{"id": null, "n": "1029001", "target": "#nkr_note_mod_1029001", "type": "mod", "text": "慊【大】，嫌【宋】【元】【明】【宮】"}
{"id": null, "n": "1029002", "target": "#nkr_note_mod_1029002", "type": "mod", "text": "五十【大】，〔－〕【元】"}
{"id": null, "n": "1029003", "target": "#nkr_note_mod_1029003", "type": "mod", "text": "叉【大】，扠【宋】【元】【明】【宮】"}
{"id": null, "n": "1029004", "target": "#nkr_note_mod_1029004", "type": "mod", "text": "視【大】，護【宋】【元】【明】【宮】"}
{"id": null, "n": "1029005", "target": "#nkr_note_mod_1029005", "type": "mod", "text": "七十【大】，〔－〕【宮】"}
{"id": null, "n": "1029006", "target": "#nkr_note_mod_1029006", "type": "mod", "text": "從【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1029007", "target": "#nkr_note_mod_1029007", "type": "mod", "text": "薰【大】，勳【宋】【明】"}
{"id": null, "n": "1029008", "target": "#nkr_note_mod_1029008", "type": "mod", "text": "像【大】，塔【宋】【元】【明】【宮】"}
{"id": null, "n": "1029009", "target": "#nkr_note_mod_1029009", "type": "mod", "text": "一百【大】，〔－〕【宮】，百【宋】【元】【明】"}
{"id": null, "n": "1029010", "target": "#nkr_note_mod_1029010", "type": "mod", "text": "法【大】，戒法【宋】【元】【明】【宮】"}
{"id": null, "n": "1029011", "target": "#nkr_note_mod_1029011", "type": "mod", "text": "如是【CB】【麗-CB】【宮】，是【大】"}
{"id": null, "n": "1030001", "target": "#nkr_note_mod_1030001", "type": "mod", "text": "諸【大】，眾【宋】【元】【明】【宮】"}
{"id": null, "n": "1030002", "target": "#nkr_note_mod_1030002", "type": "mod", "text": "常【大】，當【宋】【元】【明】【宮】"}
{"id": null, "n": "1030003", "target": "#nkr_note_mod_1030003", "type": "mod", "text": "名【大】，多【元】"}
{"id": null, "n": "1030004", "target": "#nkr_note_mod_1030004", "type": "mod", "text": "得【大】，則【宋】【元】【明】【宮】"}
{"id": null, "n": "1030005", "target": "#nkr_note_mod_1030005", "type": "mod", "text": "誡【大】，戒【宋】【元】【明】【宮】"}
{"id": null, "n": "1030006", "target": "#nkr_note_mod_1030006", "type": "mod", "text": "𤛆【大】，𤚐【宮】"}
{"id": null, "n": "1030007", "target": "#nkr_note_mod_1030007", "type": "mod", "text": "本【大】，本一卷【元】，本一卷三【宋】【宮】，本卷下【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": "1023004", "target": "#nkr_note_orig_1023004", "type": "orig", "text": "〔僧〕－【三】【宮】＊"}
{"id": null, "n": "1023005", "target": "#nkr_note_orig_1023005", "type": "orig", "text": "本＋（三）細註【宋】，（卷下）【明】，明本以前本四分律比丘戒本為上卷以此本為下卷即以二本為一本上下二卷"}
{"id": null, "n": "1023006", "target": "#nkr_note_orig_1023006", "type": "orig", "text": "曇無德出＝出曇無德部【明】"}
