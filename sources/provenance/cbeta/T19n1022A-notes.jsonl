{"id": null, "n": "0710002", "target": "#nkr_note_mod_0710002", "type": "mod", "text": "（開府…號）三十字【大】，〔－〕【宋】【元】【明】，（開府…號）三十字＝（特進試鴻臚卿）六字【甲】"}
{"id": null, "n": "0710003", "target": "#nkr_note_mod_0710003", "type": "mod", "text": "大廣智大興善寺三藏沙門【大】，大興善寺三藏沙門大廣智【宋】【元】【甲】，唐三藏沙門大廣智【明】【乙】"}
{"id": null, "n": "0710004", "target": "#nkr_note_mod_0710004", "type": "mod", "text": "奉詔【大】，〔－〕【明】【乙】"}
{"id": null, "n": "0710005", "target": "#nkr_note_mod_0710005", "type": "mod", "text": "常【大】，常恒【校異-乙】"}
{"id": null, "n": "0710006", "target": "#nkr_note_mod_0710006", "type": "mod", "text": "相應【大】，圓滿【校異-乙】"}
{"id": null, "n": "0710007", "target": "#nkr_note_mod_0710007", "type": "mod", "text": "唯【大】＊，惟【宋】【元】【明】【乙】＊"}
{"id": null, "n": "0710008", "target": "#nkr_note_mod_0710008", "type": "mod", "text": "尊【大】，尊軟語【校異-乙】"}
{"id": null, "n": "0710009", "target": "#nkr_note_mod_0710009", "type": "mod", "text": "光【大】，光言【宋】【元】【明】【甲】"}
{"id": null, "n": "0710010", "target": "#nkr_note_mod_0710010", "type": "mod", "text": "已【大】，〔－〕【校異-乙】"}
{"id": null, "n": "0710011", "target": "#nkr_note_mod_0710011", "type": "mod", "text": "一切如來既警覺【大】，〔－〕【甲】"}
{"id": null, "n": "0710012", "target": "#nkr_note_mod_0710012", "type": "mod", "text": "妙【大】，以【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0710013", "target": "#nkr_note_mod_0710013", "type": "mod", "text": "止【大】，至【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0710014", "target": "#nkr_note_mod_0710014", "type": "mod", "text": "所【大】，所于【乙】"}
{"id": null, "n": "0710015", "target": "#nkr_note_mod_0710015", "type": "mod", "text": "朽【大】，〔－〕【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0710016", "target": "#nkr_note_mod_0710016", "type": "mod", "text": "善哉【大】，〔－〕【校異-乙】"}
{"id": null, "n": "0710017", "target": "#nkr_note_mod_0710017", "type": "mod", "text": "泗【大】，血【甲】【乙】"}
{"id": null, "n": "0710018", "target": "#nkr_note_mod_0710018", "type": "mod", "text": "泣【大】，流【校異-乙】"}
{"id": null, "n": "0710019", "target": "#nkr_note_mod_0710019", "type": "mod", "text": "故於【大】，〔－〕【校異-乙】，於【宋】【元】【明】【甲】"}
{"id": null, "n": "0710020", "target": "#nkr_note_mod_0710020", "type": "mod", "text": "利【大】，利積【校異-乙】"}
{"id": null, "n": "0710021", "target": "#nkr_note_mod_0710021", "type": "mod", "text": "來【大】，來寶【校異-乙】"}
{"id": null, "n": "0710022", "target": "#nkr_note_mod_0710022", "type": "mod", "text": "來【大】，來無量【校異-乙】"}
{"id": null, "n": "0710023", "target": "#nkr_note_mod_0710023", "type": "mod", "text": "如胡麻【大】，〔－〕【校異-乙】"}
{"id": null, "n": "0710024", "target": "#nkr_note_mod_0710024", "type": "mod", "text": "尼【大】，尼密【乙】"}
{"id": null, "n": "0710025", "target": "#nkr_note_mod_0710025", "type": "mod", "text": "是【大】＊，〔－〕【宋】【元】【明】【甲】【乙】＊"}
{"id": null, "n": "0710026", "target": "#nkr_note_mod_0710026", "type": "mod", "text": "即【大】，即變【校異-乙】"}
{"id": null, "n": "0710027", "target": "#nkr_note_mod_0710027", "type": "mod", "text": "麻【大】＊，麻子【校異-乙】＊"}
{"id": null, "n": "0710028", "target": "#nkr_note_mod_0710028", "type": "mod", "text": "利【大】，利之【校異-乙】"}
{"id": null, "n": "0710029", "target": "#nkr_note_mod_0710029", "type": "mod", "text": "及隨【大】，斷諸【乙】"}
{"id": null, "n": "0710030", "target": "#nkr_note_mod_0710030", "type": "mod", "text": "鞞【大】，毘【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0710031", "target": "#nkr_note_mod_0710031", "type": "mod", "text": "殖【大】＊，植【宋】【元】【明】【甲】【乙】＊"}
{"id": null, "n": "0710032", "target": "#nkr_note_mod_0710032", "type": "mod", "text": "手【大】，手菩薩【甲】"}
{"id": null, "n": "0710033", "target": "#nkr_note_mod_0710033", "type": "mod", "text": "如胡麻【大】＊，〔－〕【甲】＊"}
{"id": null, "n": "0710034", "target": "#nkr_note_mod_0710034", "type": "mod", "text": "十方【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0710035", "target": "#nkr_note_mod_0710035", "type": "mod", "text": "切【大】，一【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0710036", "target": "#nkr_note_mod_0710036", "type": "mod", "text": "花香【大】，香花【宋】【元】【明】【甲】"}
{"id": null, "n": "0711001", "target": "#nkr_note_mod_0711001", "type": "mod", "text": "妙【大】，〔－〕【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0711002", "target": "#nkr_note_mod_0711002", "type": "mod", "text": "時【大】，爾時【宋】【元】【明】，之時【校異-乙】"}
{"id": null, "n": "0711003", "target": "#nkr_note_mod_0711003", "type": "mod", "text": "故【大】，〔－〕【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0711004", "target": "#nkr_note_mod_0711004", "type": "mod", "text": "若【大】，若有【甲】"}
{"id": null, "n": "0711005", "target": "#nkr_note_mod_0711005", "type": "mod", "text": "槃【大】，盤【校異-乙】"}
{"id": null, "n": "0711006", "target": "#nkr_note_mod_0711006", "type": "mod", "text": "得【大】，〔－〕【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0711007", "target": "#nkr_note_mod_0711007", "type": "mod", "text": "獄【大】，獄者【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0711008", "target": "#nkr_note_mod_0711008", "type": "mod", "text": "鴝【大】，鸜【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0711009", "target": "#nkr_note_mod_0711009", "type": "mod", "text": "夜【大】，藥【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0711010", "target": "#nkr_note_mod_0711010", "type": "mod", "text": "詛【大】，禱【宋】【元】【明】【乙】"}
{"id": null, "n": "0711011", "target": "#nkr_note_mod_0711011", "type": "mod", "text": "便【大】，〔－〕【甲】"}
{"id": null, "n": "0711012", "target": "#nkr_note_mod_0711012", "type": "mod", "text": "護【大】，〔－〕【甲】"}
{"id": null, "n": "0711013", "target": "#nkr_note_mod_0711013", "type": "mod", "text": "𧘂暈【大】，憧雲【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0711014", "target": "#nkr_note_mod_0711014", "type": "mod", "text": "槃【大】，盤【甲】"}
{"id": null, "n": "0711015", "target": "#nkr_note_mod_0711015", "type": "mod", "text": "像【大】，相【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0711016", "target": "#nkr_note_mod_0711016", "type": "mod", "text": "（亦復…持）十三字【大】，〔－〕【校異-乙】"}
{"id": null, "n": "0711017", "target": "#nkr_note_mod_0711017", "type": "mod", "text": "大【大】，〔－〕【校異-乙】"}
{"id": null, "n": "0711018", "target": "#nkr_note_mod_0711018", "type": "mod", "text": "利【大】，利之妙寶【校異-乙】"}
{"id": null, "n": "0711019", "target": "#nkr_note_mod_0711019", "type": "mod", "text": "宮【大】，宮之中【校異-乙】"}
{"id": null, "n": "0711020", "target": "#nkr_note_mod_0711020", "type": "mod", "text": "一切如來【大】，〔－〕【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0711021", "target": "#nkr_note_mod_0711021", "type": "mod", "text": "篋【大】，篋印【校異-乙】"}
{"id": null, "n": "0711023", "target": "#nkr_note_mod_0711023", "type": "mod", "text": "野【大】，也【宋】【元】【明】【乙】"}
{"id": null, "n": "0711024", "target": "#nkr_note_mod_0711024", "type": "mod", "text": "者【大】，嚩【乙】"}
{"id": null, "n": "0711025", "target": "#nkr_note_mod_0711025", "type": "mod", "text": "六知皆反【大】，知皆切六【明】【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "六"}
{"id": null, "n": null, "target": null, "type": null, "text": "知皆反"}
{"id": null, "n": "0711026", "target": "#nkr_note_mod_0711026", "type": "mod", "text": "馱囉【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0711027", "target": "#nkr_note_mod_0711027", "type": "mod", "text": "蹋【大】，娜【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0711028", "target": "#nkr_note_mod_0711028", "type": "mod", "text": "祖【大】，怛【乙】"}
{"id": null, "n": "0711029", "target": "#nkr_note_mod_0711029", "type": "mod", "text": "迦【大】，訖【宋】【元】【明】【乙】"}
{"id": null, "n": "0711030", "target": "#nkr_note_mod_0711030", "type": "mod", "text": "鉢囉二合【大】，〔－〕【甲】"}
{"id": null, "n": "0711031", "target": "#nkr_note_mod_0711031", "type": "mod", "text": "哩【大】，囉【宋】【元】【明】"}
{"id": null, "n": "0711032", "target": "#nkr_note_mod_0711032", "type": "mod", "text": "他【大】，他引【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0711033", "target": "#nkr_note_mod_0711033", "type": "mod", "text": "耶【大】，儞【元】【明】【甲】【乙】"}
{"id": null, "n": "0711034", "target": "#nkr_note_mod_0711034", "type": "mod", "text": "嚩【大】，縛【宋】【元】"}
{"id": null, "n": "0711035", "target": "#nkr_note_mod_0711035", "type": "mod", "text": "哩【大】，囉【乙】"}
{"id": null, "n": "0711036", "target": "#nkr_note_mod_0711036", "type": "mod", "text": "參婆囉參【CB】【宋】【元】【明】【甲】【乙】，參【大】"}
