{"id": null, "n": null, "target": null, "type": "cf1", "text": "K19n0773_p0799a21"}
{"id": null, "n": "0542020", "target": "#nkr_note_mod_0542020", "type": "mod", "text": "佛說【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0542021", "target": "#nkr_note_mod_0542021", "type": "mod", "text": "沙門【大】，三藏釋【宋】【元】【明】【宮】"}
{"id": null, "n": "0542022", "target": "#nkr_note_mod_0542022", "type": "mod", "text": "告【大】，語【宋】【元】【明】，說【宮】"}
{"id": null, "n": "0542023", "target": "#nkr_note_mod_0542023", "type": "mod", "text": "以後便富貴【大】，已便有富貴不衰者【宋】【元】【明】【宮】"}
{"id": null, "n": "0542024", "target": "#nkr_note_mod_0542024", "type": "mod", "text": "以【大】，之【宋】【元】【明】【宮】"}
{"id": null, "n": "0542025", "target": "#nkr_note_mod_0542025", "type": "mod", "text": "問【大】，驚問【宋】【元】【明】【宮】"}
{"id": null, "n": "0542026", "target": "#nkr_note_mod_0542026", "type": "mod", "text": "其【大】，法【宋】【元】【明】【宮】"}
{"id": null, "n": "0542027", "target": "#nkr_note_mod_0542027", "type": "mod", "text": "侍【大】，所侍【宋】【元】【明】【宮】"}
{"id": null, "n": "0542028", "target": "#nkr_note_mod_0542028", "type": "mod", "text": "利【大】，利耶【宋】【元】【明】【宮】"}
{"id": null, "n": "0542029", "target": "#nkr_note_mod_0542029", "type": "mod", "text": "子【大】，子也【宋】【元】【明】【宮】"}
{"id": null, "n": "0542030", "target": "#nkr_note_mod_0542030", "type": "mod", "text": "又復不【大】，復無【宋】【元】【明】【宮】"}
{"id": null, "n": "0542031", "target": "#nkr_note_mod_0542031", "type": "mod", "text": "教【大】，效【宋】【元】【明】【宮】"}
{"id": null, "n": "0542032", "target": "#nkr_note_mod_0542032", "type": "mod", "text": "蒙【大】，朦【宋】【元】【明】【宮】"}
{"id": null, "n": "0542033", "target": "#nkr_note_mod_0542033", "type": "mod", "text": "不【大】，亦不【宋】【元】【明】【宮】"}
{"id": null, "n": "0542034", "target": "#nkr_note_mod_0542034", "type": "mod", "text": "嚾【大】，喚【宋】【元】【明】【宮】"}
{"id": null, "n": "0542035", "target": "#nkr_note_mod_0542035", "type": "mod", "text": "咀【大】，詛【明】"}
{"id": null, "n": "0543001", "target": "#nkr_note_mod_0543001", "type": "mod", "text": "眼【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0543002", "target": "#nkr_note_mod_0543002", "type": "mod", "text": "外【大】，凡【宋】【元】【明】【宮】"}
{"id": null, "n": "0543003", "target": "#nkr_note_mod_0543003", "type": "mod", "text": "不置【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0543004", "target": "#nkr_note_mod_0543004", "type": "mod", "text": "病【大】，疾【宋】【元】【明】【宮】"}
{"id": null, "n": "0543005", "target": "#nkr_note_mod_0543005", "type": "mod", "text": "也【大】，耶【宋】【元】【明】【宮】"}
{"id": null, "n": "0543006", "target": "#nkr_note_mod_0543006", "type": "mod", "text": "至醫師醫【大】，巫媚之【宋】【元】【明】【宮】"}
{"id": null, "n": "0543007", "target": "#nkr_note_mod_0543007", "type": "mod", "text": "罪辜【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0543008", "target": "#nkr_note_mod_0543008", "type": "mod", "text": "殃【大】，凶【宋】【元】【明】【宮】"}
{"id": null, "n": "0543009", "target": "#nkr_note_mod_0543009", "type": "mod", "text": "耗【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0543010", "target": "#nkr_note_mod_0543010", "type": "mod", "text": "專行惡【大】，意【宋】【元】【明】【宮】"}
{"id": null, "n": "0543011", "target": "#nkr_note_mod_0543011", "type": "mod", "text": "便頭面【大】，便更頭腦【宋】【元】【明】【宮】"}
{"id": null, "n": "0543012", "target": "#nkr_note_mod_0543012", "type": "mod", "text": "歡喜奉行【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0542020", "target": "#nkr_note_orig_0542020", "type": "orig", "text": "〔佛說〕－【三】【宮】＊"}
{"id": null, "n": "0542021", "target": "#nkr_note_orig_0542021", "type": "orig", "text": "沙門＝三藏釋【三】【宮】"}
{"id": null, "n": "0542022", "target": "#nkr_note_orig_0542022", "type": "orig", "text": "告＝語【三】，說【宮】"}
{"id": null, "n": "0542023", "target": "#nkr_note_orig_0542023", "type": "orig", "text": "以後便富貴＝已便有富貴不衰者【三】【宮】"}
{"id": null, "n": "0542024", "target": "#nkr_note_orig_0542024", "type": "orig", "text": "以＝之【三】【宮】"}
{"id": null, "n": "0542025", "target": "#nkr_note_orig_0542025", "type": "orig", "text": "（驚）＋問【三】【宮】"}
{"id": null, "n": "0542026", "target": "#nkr_note_orig_0542026", "type": "orig", "text": "其＝法【三】【宮】"}
{"id": null, "n": "0542027", "target": "#nkr_note_orig_0542027", "type": "orig", "text": "（所）＋侍【三】【宮】"}
{"id": null, "n": "0542028", "target": "#nkr_note_orig_0542028", "type": "orig", "text": "利＋（耶）【三】【宮】"}
{"id": null, "n": "0542029", "target": "#nkr_note_orig_0542029", "type": "orig", "text": "子＋（也）【三】【宮】"}
{"id": null, "n": "0542030", "target": "#nkr_note_orig_0542030", "type": "orig", "text": "又復不＝復無【三】【宮】"}
{"id": null, "n": "0542031", "target": "#nkr_note_orig_0542031", "type": "orig", "text": "教＝效【三】【宮】"}
{"id": null, "n": "0542032", "target": "#nkr_note_orig_0542032", "type": "orig", "text": "蒙＝朦【三】【宮】"}
{"id": null, "n": "0542033", "target": "#nkr_note_orig_0542033", "type": "orig", "text": "（亦）＋不【三】【宮】"}
{"id": null, "n": "0542034", "target": "#nkr_note_orig_0542034", "type": "orig", "text": "嚾＝喚【三】【宮】"}
{"id": null, "n": "0542035", "target": "#nkr_note_orig_0542035", "type": "orig", "text": "咀＝詛【明】"}
{"id": null, "n": "0543001", "target": "#nkr_note_orig_0543001", "type": "orig", "text": "〔眼〕－【三】【宮】"}
{"id": null, "n": "0543002", "target": "#nkr_note_orig_0543002", "type": "orig", "text": "外＝凡【三】【宮】"}
{"id": null, "n": "0543003", "target": "#nkr_note_orig_0543003", "type": "orig", "text": "〔不置〕－【三】【宮】"}
{"id": null, "n": "0543004", "target": "#nkr_note_orig_0543004", "type": "orig", "text": "病＝疾【三】【宮】"}
{"id": null, "n": "0543005", "target": "#nkr_note_orig_0543005", "type": "orig", "text": "也＝耶【三】【宮】"}
{"id": null, "n": "0543006", "target": "#nkr_note_orig_0543006", "type": "orig", "text": "至醫師醫＝巫媚之【三】【宮】"}
{"id": null, "n": "0543007", "target": "#nkr_note_orig_0543007", "type": "orig", "text": "〔罪辜〕－【三】【宮】"}
{"id": null, "n": "0543008", "target": "#nkr_note_orig_0543008", "type": "orig", "text": "殃＝凶【三】【宮】"}
{"id": null, "n": "0543009", "target": "#nkr_note_orig_0543009", "type": "orig", "text": "〔耗〕－【三】【宮】"}
{"id": null, "n": "0543010", "target": "#nkr_note_orig_0543010", "type": "orig", "text": "專行惡＝意【三】【宮】"}
{"id": null, "n": "0543011", "target": "#nkr_note_orig_0543011", "type": "orig", "text": "便頭面＝便更頭腦【三】【宮】"}
{"id": null, "n": "0543012", "target": "#nkr_note_orig_0543012", "type": "orig", "text": "〔歡喜奉行〕－【三】【宮】"}
{"id": null, "n": "0543a0301", "target": "#nkr_note_add_0543a0301", "type": "add", "text": "筐【CB】【麗-CB】，篋【大】"}
