{"id": null, "n": "0298002", "target": "#nkr_note_orig_0298002", "type": "orig", "text": "「誠」，底本作「成」，通「誠」。"}
{"id": null, "n": "0298003", "target": "#nkr_note_orig_0298003", "type": "orig", "text": "「慧自在，方便自在……朗然如日」，共32字，底本無，據十六卷本卷二補，參見七寺本第326行到328行。"}
{"id": null, "n": "0299001", "target": "#nkr_note_orig_0299001", "type": "orig", "text": "「烔」，底本作「同」，據三十卷本《佛名經》卷三改，參見《大正藏》第14卷第198頁下欄。"}
{"id": null, "n": "0299002", "target": "#nkr_note_orig_0299002", "type": "orig", "text": "「棒」，底本作「𫒩」，據文意改。"}
{"id": null, "n": "0301001", "target": "#nkr_note_orig_0301001", "type": "orig", "text": "「佛」，底、甲本自此始。"}
{"id": null, "n": "0301002", "target": "#nkr_note_orig_0301002", "type": "orig", "text": "「如來」，底本作「諸佛」，據甲本改。《大正藏》本作「佛應知」，參見《大正藏》第14卷第125頁下欄。"}
{"id": null, "n": "0301003", "target": "#nkr_note_orig_0301003", "type": "orig", "text": "「南」，丙本自此始。"}
{"id": null, "n": "0302001", "target": "#nkr_note_orig_0302001", "type": "orig", "text": "「南無無王王世界勝如來。南無種種成就世界功德微如來」《大正藏》本作「南無光王世界智勝佛。南無普畏世界月佛。南無種種成就世界功德微佛」，參見《大正藏》第14卷第125頁下欄。"}
{"id": null, "n": "0303001", "target": "#nkr_note_orig_0303001", "type": "orig", "text": "「南」，丁本自此始。"}
{"id": null, "n": "0303002", "target": "#nkr_note_orig_0303002", "type": "orig", "text": "「南」，戊本自此始。"}
{"id": null, "n": "0303003", "target": "#nkr_note_orig_0303003", "type": "orig", "text": "「世」，甲本自此止。"}
{"id": null, "n": "0303004", "target": "#nkr_note_orig_0303004", "type": "orig", "text": "「惱」，底、丁、戊本同，丙本無。"}
{"id": null, "n": "0303005", "target": "#nkr_note_orig_0303005", "type": "orig", "text": "「十方」，底、丁、戊本同，丙本作「十方世」。"}
{"id": null, "n": "0304001", "target": "#nkr_note_orig_0304001", "type": "orig", "text": "「無」，底、丙、丁本同，戊本作「無無」。"}
{"id": null, "n": "0304002", "target": "#nkr_note_orig_0304002", "type": "orig", "text": "「固」，底、丙、戊本同，丁本無。"}
{"id": null, "n": "0304003", "target": "#nkr_note_orig_0304003", "type": "orig", "text": "「世界」，底、丁、戊本同，丙本無。"}
{"id": null, "n": "0305001", "target": "#nkr_note_orig_0305001", "type": "orig", "text": "「功」，底、丁、戊本同，丙本作「如」。"}
{"id": null, "n": "0305002", "target": "#nkr_note_orig_0305002", "type": "orig", "text": "「一千八百」，底、丙本無，據丁、戊本補。"}
{"id": null, "n": "0305003", "target": "#nkr_note_orig_0305003", "type": "orig", "text": "「王王」，底、丙、丁本同，戊本作「王」。"}
{"id": null, "n": "0305004", "target": "#nkr_note_orig_0305004", "type": "orig", "text": "「積」，底本作「稱」，據丙、丁、戊本改。"}
{"id": null, "n": "0306001", "target": "#nkr_note_orig_0306001", "type": "orig", "text": "「一千七百」，底、丙、戊本同，丁本無。"}
{"id": null, "n": "0306002", "target": "#nkr_note_orig_0306002", "type": "orig", "text": "「作」，底、丙、戊本同，丁本作「住」。"}
{"id": null, "n": "0306003", "target": "#nkr_note_orig_0306003", "type": "orig", "text": "「南無十方光明世界勝力王佛……歸命如是等無量無邊諸佛」，此段文字見《大正藏》本卷二，參見《大正藏》第14卷第125中欄～126頁中欄。"}
{"id": null, "n": "0306004", "target": "#nkr_note_orig_0306004", "type": "orig", "text": "「發修」，底、丁、戊本作「發」，據丙本補。"}
{"id": null, "n": "0306005", "target": "#nkr_note_orig_0306005", "type": "orig", "text": "「舍」，底、丁、戊本作「合」，據丙本改。"}
{"id": null, "n": "0307001", "target": "#nkr_note_orig_0307001", "type": "orig", "text": "「南無」，底、丁、戊本同，丙本作「歸命」。"}
{"id": null, "n": "0307002", "target": "#nkr_note_orig_0307002", "type": "orig", "text": "「眼」，底、丁、戊本同，丙本作「明」。"}
{"id": null, "n": "0307003", "target": "#nkr_note_orig_0307003", "type": "orig", "text": "「昧」，底、戊本作「味」，據丙、丁本改。"}
{"id": null, "n": "0308001", "target": "#nkr_note_orig_0308001", "type": "orig", "text": "「華」，底、丁、戊本無，據丙本補。"}
{"id": null, "n": "0308002", "target": "#nkr_note_orig_0308002", "type": "orig", "text": "「境」，底、丙、戊本同，丁本無。"}
{"id": null, "n": "0308003", "target": "#nkr_note_orig_0308003", "type": "orig", "text": "「佛」，底、丙本同，丁、戊本作「佛。一千九百」。"}
{"id": null, "n": "0308004", "target": "#nkr_note_orig_0308004", "type": "orig", "text": "「南無大將佛」，底、丙、戊、《大正藏》本同，丁本無。"}
{"id": null, "n": "0310001", "target": "#nkr_note_orig_0310001", "type": "orig", "text": "「南」，乙本自此始。"}
{"id": null, "n": "0311001", "target": "#nkr_note_orig_0311001", "type": "orig", "text": "「眼」，底、丙、丁、戊本同，乙本作「明」。"}
{"id": null, "n": "0311002", "target": "#nkr_note_orig_0311002", "type": "orig", "text": "「佛」，底、乙、丙、戊、乙本同，丁本作「佛。二千」。"}
{"id": null, "n": "0311003", "target": "#nkr_note_orig_0311003", "type": "orig", "text": "「一千九百」，底、丙、戊本同，丁、乙本無。"}
{"id": null, "n": "0312001", "target": "#nkr_note_orig_0312001", "type": "orig", "text": "「脫」，底、丙、丁、戊本同，乙本作「勝」。"}
{"id": null, "n": "0312002", "target": "#nkr_note_orig_0312002", "type": "orig", "text": "「自」，底、丁、戊本無，據丙、乙本補。"}
{"id": null, "n": "0312003", "target": "#nkr_note_orig_0312003", "type": "orig", "text": "「善」，底、丙、丁、戊本同，乙本作「善住」。"}
{"id": null, "n": "0313001", "target": "#nkr_note_orig_0313001", "type": "orig", "text": "「莎」，底、丁、戊、乙本同，丙本作「娑」。"}
{"id": null, "n": "0313002", "target": "#nkr_note_orig_0313002", "type": "orig", "text": "「自」，底、丙、丁、戊本同，乙本作「目」。"}
{"id": null, "n": "0313003", "target": "#nkr_note_orig_0313003", "type": "orig", "text": "「佛」，底、丙、戊、乙本同，丁本作「佛。二千一百」。"}
{"id": null, "n": "0314001", "target": "#nkr_note_orig_0314001", "type": "orig", "text": "「空」，底、丁、戊、乙本同，丙本作「定」。"}
{"id": null, "n": "0314002", "target": "#nkr_note_orig_0314002", "type": "orig", "text": "「南無稱光明佛。南無善高佛。南無著蓋佛。南無明彌留佛。南無光明輪佛」，《大正藏》本作「南無光明彌留佛。南無光明輪佛。南無稱光明佛。南無高蓋佛。南無香蓋佛」，參見《大正藏》第14卷第128頁中欄。"}
{"id": null, "n": "0315001", "target": "#nkr_note_orig_0315001", "type": "orig", "text": "「南無因王佛。南無東南方觀一切佛形鏡如來以為上首」，《大正藏》本作「南無目王佛。南無日月淨明德佛。南無東南方觀一切佛形鏡如來以為上首。南無火然燈佛。南無空過佛」，參見《大正藏》第14卷第128頁中欄。"}
{"id": null, "n": "0315002", "target": "#nkr_note_orig_0315002", "type": "orig", "text": "「心」，底本無，據丙、丁、戊、乙本補。"}
{"id": null, "n": "0315003", "target": "#nkr_note_orig_0315003", "type": "orig", "text": "「轉」，底、丁、戊本作「車」，據丙、乙本改。"}
{"id": null, "n": "0316001", "target": "#nkr_note_orig_0316001", "type": "orig", "text": "「南無炎佛」，乙本作「南無炎佛」。《大正藏》本作「南無成就焰佛，南無成就義勝佛，南無善焰佛」，參見《大正藏》第14卷第128頁中欄。"}
{"id": null, "n": "0316002", "target": "#nkr_note_orig_0316002", "type": "orig", "text": "「曼」，丙、丁、戊、乙本作「蔓」。"}
{"id": null, "n": "0316003", "target": "#nkr_note_orig_0316003", "type": "orig", "text": "「二千一百」，底、丙本同，丁、戊本作「二千二百」，乙本無。"}
{"id": null, "n": "0316004", "target": "#nkr_note_orig_0316004", "type": "orig", "text": "「二」，底、丁、戊、乙本同，丙本作「無」。"}
{"id": null, "n": "0317001", "target": "#nkr_note_orig_0317001", "type": "orig", "text": "「明」，底、丁、戊本作「相」，據丙、乙本改。"}
{"id": null, "n": "0317002", "target": "#nkr_note_orig_0317002", "type": "orig", "text": "「勝」，底、丙、丁、戊本同，乙本作「輪」。"}
{"id": null, "n": "0317003", "target": "#nkr_note_orig_0317003", "type": "orig", "text": "「光王」，底、丙、丁、戊本同，乙本作「光明王」。"}
{"id": null, "n": "0317004", "target": "#nkr_note_orig_0317004", "type": "orig", "text": "「華」，底本無，據丙、丁、戊、乙本補。"}
{"id": null, "n": "0317005", "target": "#nkr_note_orig_0317005", "type": "orig", "text": "「導」，底、丙、丁、戊本作「道」，據乙本補。"}
{"id": null, "n": "0317006", "target": "#nkr_note_orig_0317006", "type": "orig", "text": "「南無勝一切眾生佛。南無轉一切念佛」，戊本無，疑圖版漏拍所致。參見《敦煌寶藏》第2冊第400頁、第401頁。"}
{"id": null, "n": "0318001", "target": "#nkr_note_orig_0318001", "type": "orig", "text": "「南」，丙本至此止。"}
{"id": null, "n": "0318002", "target": "#nkr_note_orig_0318002", "type": "orig", "text": "「無」，底、戊本無，據丁本補。"}
{"id": null, "n": "0319001", "target": "#nkr_note_orig_0319001", "type": "orig", "text": "「二千二百」，丁、戊本作「二千三百」，乙本無。"}
{"id": null, "n": "0319002", "target": "#nkr_note_orig_0319002", "type": "orig", "text": "「南無轉一切念佛……南無稱佛」等442字，乙本無。"}
{"id": null, "n": "0319003", "target": "#nkr_note_orig_0319003", "type": "orig", "text": "「南無稱佛。南無十二部經般若海藏」，《大正藏》本作「南無大稱佛」，參見《大正藏》第14卷第129頁上欄。「南無上王佛……南無稱佛」，此段文字見《大正藏》本卷三，參見《大正藏》第14卷第126頁下欄～第129頁上欄。"}
{"id": null, "n": "0320001", "target": "#nkr_note_orig_0320001", "type": "orig", "text": "「薩」，乙本至此止。"}
{"id": null, "n": "0320002", "target": "#nkr_note_orig_0320002", "type": "orig", "text": "「南無福德辟支佛……南無香辟支佛」，此段文字見《大正藏》本卷六，參見《大正藏》第14卷第145頁下欄。"}
{"id": null, "n": "0321001", "target": "#nkr_note_orig_0321001", "type": "orig", "text": "「何以」，底本殘，據丁、戊本補。"}
{"id": null, "n": "0321002", "target": "#nkr_note_orig_0321002", "type": "orig", "text": "「之者」，底本殘，據丁本補。"}
{"id": null, "n": "0321003", "target": "#nkr_note_orig_0321003", "type": "orig", "text": "「諧」，底、戊本同，丁本無。"}
{"id": null, "n": "0321004", "target": "#nkr_note_orig_0321004", "type": "orig", "text": "「計者」，底本殘，據丁、戊本補。"}
{"id": null, "n": "0321005", "target": "#nkr_note_orig_0321005", "type": "orig", "text": "「業理」，底本殘，據丁、戊本補。"}
{"id": null, "n": "0321006", "target": "#nkr_note_orig_0321006", "type": "orig", "text": "「報」，底本無，據丁、戊本補。"}
{"id": null, "n": "0322001", "target": "#nkr_note_orig_0322001", "type": "orig", "text": "「造」，底、戊本同，丁本無。"}
{"id": null, "n": "0323001", "target": "#nkr_note_orig_0323001", "type": "orig", "text": "「不」，底、戊本同，丁本無。"}
{"id": null, "n": "0323002", "target": "#nkr_note_orig_0323002", "type": "orig", "text": "「渡」，底、丁、戊本作「度」，通「渡」。"}
{"id": null, "n": "0323003", "target": "#nkr_note_orig_0323003", "type": "orig", "text": "「匝」，底、丁本同，戊本作「還」。"}
{"id": null, "n": "0324001", "target": "#nkr_note_orig_0324001", "type": "orig", "text": "「大」，丁、戊本作「火」。"}
{"id": null, "n": "0324002", "target": "#nkr_note_orig_0324002", "type": "orig", "text": "「搥」，底、戊本同，丁本作「鎚」。"}
{"id": null, "n": "0324003", "target": "#nkr_note_orig_0324003", "type": "orig", "text": "「箕」，底本作「萁」，戊本作「其」，據丁本改。"}
{"id": null, "n": "0324004", "target": "#nkr_note_orig_0324004", "type": "orig", "text": "「焰」，底、戊本同，丁本作「火」。"}
{"id": null, "n": "0324005", "target": "#nkr_note_orig_0324005", "type": "orig", "text": "「已」，底、丁、戊本作「以」，通「已」。"}
{"id": null, "n": "0325001", "target": "#nkr_note_orig_0325001", "type": "orig", "text": "「四」，底、丁、戊本至此止。"}
{"id": null, "n": "0214a0801", "target": "#nkr_note_add_0214a0801", "type": "add", "text": "幢【CB】，憧【藏外】"}
{"id": null, "n": "0216a0501", "target": "#nkr_note_add_0216a0501", "type": "add", "text": "幢【CB】，憧【藏外】"}
{"id": null, "n": "0298a1201", "target": "#nkr_note_add_0298a1201", "type": "add", "text": "頃【CB】，項【藏外】"}
