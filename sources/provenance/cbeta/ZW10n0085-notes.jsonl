{"id": null, "n": "0236002", "target": "#nkr_note_orig_0236002", "type": "orig", "text": "引文參見《妙法蓮華經》卷二，參見《大正藏》第9卷第18頁下欄。"}
{"id": null, "n": "0237001", "target": "#nkr_note_orig_0237001", "type": "orig", "text": "「同」，底本無，據文意補。"}
{"id": null, "n": "0237002", "target": "#nkr_note_orig_0237002", "type": "orig", "text": "「壤」，底本作「壞」，據三十卷本《佛名經》改。"}
{"id": null, "n": "0238001", "target": "#nkr_note_orig_0238001", "type": "orig", "text": "「此」，底本作「心」，據《大佛略懺》改。"}
{"id": null, "n": "0240001", "target": "#nkr_note_orig_0240001", "type": "orig", "text": "「慚」，底本作「暫」，據文意改。"}
{"id": null, "n": "0240002", "target": "#nkr_note_orig_0240002", "type": "orig", "text": "「蓋」，底本無，據文意補。"}
{"id": null, "n": "0240003", "target": "#nkr_note_orig_0240003", "type": "orig", "text": "「惑」，底本作「或」，據文意改。"}
{"id": null, "n": "0241001", "target": "#nkr_note_orig_0241001", "type": "orig", "text": "「座」，底本作「坐」，據文意改。"}
{"id": null, "n": "0241002", "target": "#nkr_note_orig_0241002", "type": "orig", "text": "「問」，底本作「門」，據文意改。"}
{"id": null, "n": "0242001", "target": "#nkr_note_orig_0242001", "type": "orig", "text": "「夾」，底本作「俠」，據文意改。"}
{"id": null, "n": "0242002", "target": "#nkr_note_orig_0242002", "type": "orig", "text": "「地獄」，底本作「獄地」，據文意改。"}
{"id": null, "n": "0243001", "target": "#nkr_note_orig_0243001", "type": "orig", "text": "「白」，底本原文如此。「白」前疑有脫漏。"}
{"id": null, "n": "0243002", "target": "#nkr_note_orig_0243002", "type": "orig", "text": "「地獄」，底本無，據三十卷本《佛名經》補。參見《大正藏》第14卷第190頁下欄。"}
{"id": null, "n": "0243003", "target": "#nkr_note_orig_0243003", "type": "orig", "text": "「烊」，底本作「洋」，據文意改。"}
{"id": null, "n": "0243004", "target": "#nkr_note_orig_0243004", "type": "orig", "text": "「耕」，底本作「𫒝」，據文意改。"}
{"id": null, "n": "0243005", "target": "#nkr_note_orig_0243005", "type": "orig", "text": "「珠」，底本作「銖」，據文意改。"}
{"id": null, "n": "0243006", "target": "#nkr_note_orig_0243006", "type": "orig", "text": "「鐵屋地獄」，底本無，據三十卷本《佛名經》補。參見《大正藏》第14卷第190頁下欄。"}
{"id": null, "n": "0245001", "target": "#nkr_note_orig_0245001", "type": "orig", "text": "「佛」，底本自此始。"}
{"id": null, "n": "0246001", "target": "#nkr_note_orig_0246001", "type": "orig", "text": "「南」，甲本自此始。"}
{"id": null, "n": "0246002", "target": "#nkr_note_orig_0246002", "type": "orig", "text": "「從此已上六百佛」，底本無，據甲本補。"}
{"id": null, "n": "0247001", "target": "#nkr_note_orig_0247001", "type": "orig", "text": "「南無量發行佛」，《大正藏》本作「南無無量發行佛，南無發行難勝佛，南無無所發行佛」，參見《大正藏》第14卷第117頁中欄。"}
{"id": null, "n": "0247002", "target": "#nkr_note_orig_0247002", "type": "orig", "text": "「無」，甲本無。"}
{"id": null, "n": "0248001", "target": "#nkr_note_orig_0248001", "type": "orig", "text": "「南」，乙本自此始。"}
{"id": null, "n": "0248002", "target": "#nkr_note_orig_0248002", "type": "orig", "text": "「無」，甲本無。"}
{"id": null, "n": "0248003", "target": "#nkr_note_orig_0248003", "type": "orig", "text": "「南無寶佛。南無種種樂說莊嚴佛。南無無量藥王成就勝王佛。南無發行難佛。南無無所發行佛」，《大正藏》本作「南無寶山佛」，參見《大正藏》第14卷第117頁中欄。"}
{"id": null, "n": "0248004", "target": "#nkr_note_orig_0248004", "type": "orig", "text": "「曼」，底、甲、乙本作「夢」，據十二卷本《佛名經》卷一改，參見《大正藏》第14卷第117頁下欄。"}
{"id": null, "n": "0249001", "target": "#nkr_note_orig_0249001", "type": "orig", "text": "「從此……賢聖」，甲本作「七百」；乙本作「從此已上七百佛」。《大正藏》本無，參見《大正藏》第14卷第117頁中欄。"}
{"id": null, "n": "0250001", "target": "#nkr_note_orig_0250001", "type": "orig", "text": "「華」，底本無，據甲、乙本補。"}
{"id": null, "n": "0250002", "target": "#nkr_note_orig_0250002", "type": "orig", "text": "「妙」，底本無，據甲、乙本補。"}
{"id": null, "n": "0252001", "target": "#nkr_note_orig_0252001", "type": "orig", "text": "「從此……賢聖」，甲本作「八百」；乙本作「從此已上八百佛」。《大正藏》本無，參見《大正藏》第14卷第118頁上欄。"}
{"id": null, "n": "0252002", "target": "#nkr_note_orig_0252002", "type": "orig", "text": "「南無碎金剛佛。南無金剛齊佛」，底、乙本同；甲本作「南無金剛齊佛。南無碎金剛佛」。"}
{"id": null, "n": "0252003", "target": "#nkr_note_orig_0252003", "type": "orig", "text": "「南無碎金剛佛。南無金剛齊佛。南無破金剛堅佛」，《大正藏》本作「南無金剛齊佛。南無碎金剛佛。南無碎金剛堅佛」，參見《大正藏》第14卷第118頁中欄。"}
{"id": null, "n": "0254001", "target": "#nkr_note_orig_0254001", "type": "orig", "text": "「南無大作佛」，《大正藏》本作「南無火作佛」，參見《大正藏》第14卷第118頁下欄。底本此佛名下有雜寫「南無日天佛」。"}
{"id": null, "n": "0254002", "target": "#nkr_note_orig_0254002", "type": "orig", "text": "「從此……賢聖」，甲本作「九百」；乙本作「從此已上九百佛」。《大正藏》本無，參見《大正藏》第14卷第117頁中欄。"}
{"id": null, "n": "0255001", "target": "#nkr_note_orig_0255001", "type": "orig", "text": "「南無香勝藏佛」，底、乙本同；甲本作「南無香勝藏佛。南無香勝藏佛」。《大正藏》本無，參見《大正藏》第14卷第118頁下欄。"}
{"id": null, "n": "0255002", "target": "#nkr_note_orig_0255002", "type": "orig", "text": "「南無香勝藏佛」，底、乙本同；甲本無。"}
{"id": null, "n": "0255003", "target": "#nkr_note_orig_0255003", "type": "orig", "text": "「寶」，甲、乙本作「實」。"}
{"id": null, "n": "0256001", "target": "#nkr_note_orig_0256001", "type": "orig", "text": "「南無勝威德香光明佛。南無寶光明佛。南無寶照佛」，《大正藏》本作「南無寶照佛。南無寶光明佛。南無勝威德香光明佛」，參見《大正藏》第14卷第119頁上欄。"}
{"id": null, "n": "0256002", "target": "#nkr_note_orig_0256002", "type": "orig", "text": "「光」，底、乙本同；甲本作「光光」。"}
{"id": null, "n": "0257001", "target": "#nkr_note_orig_0257001", "type": "orig", "text": "「從此……賢聖」，甲本作「一千」；乙本作「已上一千佛」。《大正藏》本無，參見《大正藏》第14卷第119頁上欄。"}
{"id": null, "n": "0257002", "target": "#nkr_note_orig_0257002", "type": "orig", "text": "「鼓」，底本無，據甲、乙本補。"}
{"id": null, "n": "0258001", "target": "#nkr_note_orig_0258001", "type": "orig", "text": "「南無無量功德莊嚴佛。南無無量功德莊嚴行佛。南無離劫佛。南無勝功德王莊嚴威德王劫佛」，《大正藏》本作「南無無量樂功德莊嚴行慧佛。南無無量功德莊嚴佛。南無勝功德王莊嚴威德王劫佛。南無離劫佛」，參見《大正藏》第14卷第119頁中欄。"}
{"id": null, "n": "0259001", "target": "#nkr_note_orig_0259001", "type": "orig", "text": "「南無天上佛。南無波頭摩上佛。南無香上佛。南無放香佛」，底本作「南無波頭摩上佛。南無天上佛。南無放香佛。南無香上佛」，據甲、乙本改。"}
{"id": null, "n": "0259002", "target": "#nkr_note_orig_0259002", "type": "orig", "text": "「薰」，底、乙本作「董」，據甲本改。"}
{"id": null, "n": "0259003", "target": "#nkr_note_orig_0259003", "type": "orig", "text": "「南無聖護佛。南無功德護佛」，底本無，據甲、乙、《大正藏》本本補。參見《大正藏》第14卷第119頁下欄。"}
{"id": null, "n": "0260001", "target": "#nkr_note_orig_0260001", "type": "orig", "text": "「從此……賢聖」，甲、乙本作「一千一百」。《大正藏》本無，參見《大正藏》第14卷第119頁下欄。"}
{"id": null, "n": "0260002", "target": "#nkr_note_orig_0260002", "type": "orig", "text": "「南無善寂靜去佛。南無大勢佛」，底本作「南無大勢佛。南無善寂靜去佛」，據甲、乙本改。"}
{"id": null, "n": "0260003", "target": "#nkr_note_orig_0260003", "type": "orig", "text": "「慧」，底本無，據甲、乙本補。"}
{"id": null, "n": "0261001", "target": "#nkr_note_orig_0261001", "type": "orig", "text": "「快」，底本作「決」，據甲、乙本改。"}
{"id": null, "n": "0261002", "target": "#nkr_note_orig_0261002", "type": "orig", "text": "「南無功德髻佛。南無天髻佛。南無龍髻佛」，《大正藏》本作「南無龍髻佛。南無功德髻佛。南無天髻佛」，參見《大正藏》第14卷第120頁上欄。"}
{"id": null, "n": "0261003", "target": "#nkr_note_orig_0261003", "type": "orig", "text": "「大」，底、甲、乙本同，十二卷本《佛名經》卷一作「火」。參見《大正藏》第14卷第120頁上欄。"}
{"id": null, "n": "0262001", "target": "#nkr_note_orig_0262001", "type": "orig", "text": "「南無寶念佛。南無寶力佛」，底本無，據甲、乙本補。"}
{"id": null, "n": "0262002", "target": "#nkr_note_orig_0262002", "type": "orig", "text": "「南無虛空寂佛……南無無量寶杖佛」（第5行到第357行下），此段文字見《大正藏》本卷一，參見《大正藏》第14卷第117頁上欄～第120頁上欄。"}
{"id": null, "n": "0262003", "target": "#nkr_note_orig_0262003", "type": "orig", "text": "「南無無垢杖佛。南無無邊杖佛」，底本作「南無無邊杖佛。南無垢杖佛」，據甲、乙、《大正藏》本改。參見《大正藏》第14卷第20頁上欄。"}
{"id": null, "n": "0262004", "target": "#nkr_note_orig_0262004", "type": "orig", "text": "「南無淨燃燈佛」，底本無，據甲、乙《大正藏》本補。參見《大正藏》第14卷第120頁上欄。"}
{"id": null, "n": "0263001", "target": "#nkr_note_orig_0263001", "type": "orig", "text": "「從此……賢聖」，甲、乙本作「一千二百」。《大正藏》本無，參見《大正藏》第14卷第120頁上欄。"}
{"id": null, "n": "0263002", "target": "#nkr_note_orig_0263002", "type": "orig", "text": "「南無無垢杖佛……南無普燃燈佛」（第358行上到第370行），此段文字見《大正藏》本卷二，參見《大正藏》第14卷第120頁上欄。"}
{"id": null, "n": "0264001", "target": "#nkr_note_orig_0264001", "type": "orig", "text": "「南無解脫月菩薩……南無日藏菩薩」（第383行上到第387行上），此段文字見《大正藏》本卷六，參見《大正藏》第14卷第145頁中欄。"}
{"id": null, "n": "0264002", "target": "#nkr_note_orig_0264002", "type": "orig", "text": "「先」，底、乙本無；據甲本補。"}
{"id": null, "n": "0265001", "target": "#nkr_note_orig_0265001", "type": "orig", "text": "「滋」，底、甲、乙本作「兹」，據文意改。"}
{"id": null, "n": "0265002", "target": "#nkr_note_orig_0265002", "type": "orig", "text": "「敬」，底本無，據甲、乙本補。"}
{"id": null, "n": "0265003", "target": "#nkr_note_orig_0265003", "type": "orig", "text": "「心」，底、乙本無，據甲本補。"}
{"id": null, "n": "0265004", "target": "#nkr_note_orig_0265004", "type": "orig", "text": "「弟子」，底、乙本無，據甲本補。"}
{"id": null, "n": "0265005", "target": "#nkr_note_orig_0265005", "type": "orig", "text": "「然」，底、甲、乙本無，據十六卷本《佛名經》卷一補。"}
{"id": null, "n": "0265006", "target": "#nkr_note_orig_0265006", "type": "orig", "text": "「甚」，底、乙本作「其」，據甲本改。"}
{"id": null, "n": "0265007", "target": "#nkr_note_orig_0265007", "type": "orig", "text": "「大」，底、乙本同；甲本作「大地」。"}
{"id": null, "n": "0265008", "target": "#nkr_note_orig_0265008", "type": "orig", "text": "「惡」，底本無，據甲、乙本補。"}
{"id": null, "n": "0266001", "target": "#nkr_note_orig_0266001", "type": "orig", "text": "「心」，底、乙本同；甲本無。"}
{"id": null, "n": "0266002", "target": "#nkr_note_orig_0266002", "type": "orig", "text": "「切」，底、乙本同；甲本無。"}
{"id": null, "n": "0267001", "target": "#nkr_note_orig_0267001", "type": "orig", "text": "「閉」，底、乙本同；甲本無。"}
{"id": null, "n": "0267002", "target": "#nkr_note_orig_0267002", "type": "orig", "text": "「隨」，底本作「隨順」，據甲、乙本刪。"}
{"id": null, "n": "0267003", "target": "#nkr_note_orig_0267003", "type": "orig", "text": "「或」，底、乙本同；甲本作「惑」，通「或」。"}
{"id": null, "n": "0267004", "target": "#nkr_note_orig_0267004", "type": "orig", "text": "「惰」，底、乙本作「墮」，據甲本改。"}
{"id": null, "n": "0267005", "target": "#nkr_note_orig_0267005", "type": "orig", "text": "「覺」，底本作「學」，據甲、乙本改。"}
{"id": null, "n": "0267006", "target": "#nkr_note_orig_0267006", "type": "orig", "text": "「狠」，底、甲、乙本作「佷」，「佷」、「狠」通，今正作「狠」。"}
{"id": null, "n": "0267007", "target": "#nkr_note_orig_0267007", "type": "orig", "text": "「惱」，底、乙本同，甲本作「惱惱」。"}
{"id": null, "n": "0268001", "target": "#nkr_note_orig_0268001", "type": "orig", "text": "「尾」，底本無，據甲、乙本補。"}
{"id": null, "n": "0268002", "target": "#nkr_note_orig_0268002", "type": "orig", "text": "「繚」，底、甲本作「尞」，古「燎」字。據文意改。"}
{"id": null, "n": "0268003", "target": "#nkr_note_orig_0268003", "type": "orig", "text": "「中」，底、乙本同；甲本無。"}
{"id": null, "n": "0269001", "target": "#nkr_note_orig_0269001", "type": "orig", "text": "「繼」，底、甲、乙本同，疑為「繫」。"}
{"id": null, "n": "0269002", "target": "#nkr_note_orig_0269002", "type": "orig", "text": "「地」，底、乙本同；甲本無。"}
{"id": null, "n": "0269003", "target": "#nkr_note_orig_0269003", "type": "orig", "text": "「刨」，底、甲、乙本作「抱」，據文意改。"}
{"id": null, "n": "0269004", "target": "#nkr_note_orig_0269004", "type": "orig", "text": "「叉」，底、甲本同；乙本作「又」。"}
{"id": null, "n": "0269005", "target": "#nkr_note_orig_0269005", "type": "orig", "text": "「牛」，底、乙本無，據甲本補。"}
{"id": null, "n": "0269006", "target": "#nkr_note_orig_0269006", "type": "orig", "text": "「生」，底、乙本無，據甲本補。"}
{"id": null, "n": "0270001", "target": "#nkr_note_orig_0270001", "type": "orig", "text": "「二」，底、甲、乙本至此止。"}
{"id": null, "n": "0271001", "target": "#nkr_note_orig_0271001", "type": "orig", "text": "「佛說佛名經卷第三」，底、甲本殘，據文意補。"}
{"id": null, "n": "0272001", "target": "#nkr_note_orig_0272001", "type": "orig", "text": "「南無月燃燈佛……南無大聲佛」，底、甲本殘，據《大正藏》本補。參見《大正藏》第14卷第120頁中欄。"}
{"id": null, "n": "0272002", "target": "#nkr_note_orig_0272002", "type": "orig", "text": "「南」，底本自此始。"}
{"id": null, "n": "0272003", "target": "#nkr_note_orig_0272003", "type": "orig", "text": "「南無安隱聲佛」，底本殘，據《大正藏》本補。參見《大正藏》第14卷第120頁中欄。"}
{"id": null, "n": "0272004", "target": "#nkr_note_orig_0272004", "type": "orig", "text": "「南無妙鼓聲佛」，底本殘，據《大正藏》本補。參見《大正藏》第14卷第120頁中欄。"}
{"id": null, "n": "0272005", "target": "#nkr_note_orig_0272005", "type": "orig", "text": "「南無月聲佛」，底本殘，據《大正藏》本補。參見《大正藏》第14卷第120頁中欄。"}
{"id": null, "n": "0272006", "target": "#nkr_note_orig_0272006", "type": "orig", "text": "「南無波頭摩聲佛。南無師子聲佛」，《大正藏》本作「南無師子聲佛。南無波頭摩聲佛」，參見《大正藏》第14卷第120頁中欄。"}
{"id": null, "n": "0273001", "target": "#nkr_note_orig_0273001", "type": "orig", "text": "「南無護法佛。南無曇無竭佛」，《大正藏》本作「南無曇無竭佛。南無護法佛」，參見《大正藏》第14卷第120頁中欄。"}
{"id": null, "n": "0273002", "target": "#nkr_note_orig_0273002", "type": "orig", "text": "「燃」，《大正藏》本作「然」，參見《大正藏》第14卷第120頁下欄。"}
{"id": null, "n": "0274001", "target": "#nkr_note_orig_0274001", "type": "orig", "text": "「稱」，《大正藏》本作「稱王」，參見《大正藏》第14卷第120頁下欄。"}
{"id": null, "n": "0275001", "target": "#nkr_note_orig_0275001", "type": "orig", "text": "「佛」，《大正藏》本作「佛。南無名教化菩薩佛」，參見《大正藏》第14卷第121頁上欄。"}
