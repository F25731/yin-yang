{"id": null, "n": null, "target": null, "type": null, "text": "皈敬儀引"}
{"id": null, "n": null, "target": null, "type": null, "text": "空觀"}
{"id": null, "n": null, "target": null, "type": null, "text": "真諦"}
{"id": null, "n": null, "target": null, "type": null, "text": "假觀"}
{"id": null, "n": null, "target": null, "type": null, "text": "俗諦"}
{"id": null, "n": null, "target": null, "type": null, "text": "上顯真、俗相即為空諦，空、假不二為中觀。"}
{"id": null, "n": null, "target": null, "type": null, "text": "在所為三諦，在能為三觀。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上明觀訖。"}
{"id": null, "n": null, "target": null, "type": null, "text": "下引戒法處，即指於教也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "觀妙。"}
{"id": null, "n": null, "target": null, "type": null, "text": "教妙。"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃至。"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "守一"}
{"id": null, "n": null, "target": null, "type": null, "text": "懺篇"}
{"id": null, "n": null, "target": null, "type": null, "text": "事鈔沙彌篇、業疏受戒篇"}
{"id": null, "n": null, "target": null, "type": null, "text": "業疏云：觀事是空等。"}
{"id": null, "n": null, "target": null, "type": null, "text": "懺篇"}
{"id": null, "n": null, "target": null, "type": null, "text": "淨心誡觀、歸敬儀廣明理觀，故不盡錄。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上示境竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "決異傳中又略釋之"}
{"id": null, "n": null, "target": null, "type": null, "text": "即空觀成"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃假觀成"}
{"id": null, "n": null, "target": null, "type": null, "text": "即中觀成"}
{"id": null, "n": null, "target": null, "type": null, "text": "敬儀中引"}
{"id": null, "n": null, "target": null, "type": null, "text": "真即真諦，\n知無即是空觀。"}
{"id": null, "n": null, "target": null, "type": null, "text": "俗即俗諦，知識即是假觀。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上謂通達真時，必先達俗是空。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上謂通達俗時，必先通真即俗。"}
{"id": null, "n": null, "target": null, "type": null, "text": "有約他宗但中釋此中義者，葢不究論文，不達\n祖意故也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "分別、依他、真實三性。"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "十解即十住也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "意言"}
{"id": null, "n": null, "target": null, "type": null, "text": "此指十住名聖，十信已前名凡。"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼文"}
{"id": null, "n": null, "target": null, "type": null, "text": "上示理竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "疏見受戒"}
{"id": null, "n": null, "target": null, "type": null, "text": "上示人竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "納體"}
{"id": null, "n": null, "target": null, "type": null, "text": "持奉"}
{"id": null, "n": null, "target": null, "type": null, "text": "即篇聚小行也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即大\n乘圓行也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此指已受篇聚戒法"}
{"id": null, "n": null, "target": null, "type": null, "text": "以一實妙理為指皈之處。"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "如前所列"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "上資持文"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "虗空藏經文也"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃至"}
{"id": null, "n": null, "target": null, "type": null, "text": "上依經示，下彼\n自決。"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃至"}
{"id": null, "n": null, "target": null, "type": null, "text": "上並荊谿決作法懺不滅制罪之文。"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上是荊谿決取相滅制\n罪也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上是荊谿決無生滅制罪也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "作法、取相、無生"}
{"id": null, "n": null, "target": null, "type": null, "text": "理、事"}
{"id": null, "n": null, "target": null, "type": null, "text": "見百錄文"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上斥初二句文竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "決初失意"}
{"id": null, "n": null, "target": null, "type": null, "text": "決次失竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上決輔行文"}
{"id": null, "n": null, "target": null, "type": null, "text": "凡一切諸行，須以妙觀為主，此佛祖之意"}
{"id": null, "n": null, "target": null, "type": null, "text": "如新疏云：\n故諸行者，先開智解，通達無礙，然後晨夕念念繫想彼方"}
{"id": null, "n": null, "target": null, "type": null, "text": "諸經正宗行相，各各不同，如新疏以五例精簡，使無通濫"}
{"id": null, "n": null, "target": null, "type": null, "text": "天台作也"}
{"id": null, "n": null, "target": null, "type": null, "text": "並彼全文"}
{"id": null, "n": null, "target": null, "type": null, "text": "上慈雲文，靈芝準顯"}
{"id": null, "n": null, "target": null, "type": null, "text": "上並疏文。疏中\n\n義廣，請自觀之。"}
{"id": null, "n": null, "target": null, "type": null, "text": "占察、輔行二觀之義，並見下引。"}
{"id": null, "n": null, "target": null, "type": null, "text": "即唯識妙理也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "一實境界亦即唯識妙理"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃至"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "四位修觀，信解即初位，論名信樂，又名願樂，收信、住、行、向\n四十心人"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃至"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃至"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃至"}
{"id": null, "n": null, "target": null, "type": null, "text": "上示觀體。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上明利鈍二修，與前祖義經文是同。"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "本"}
{"id": null, "n": null, "target": null, "type": null, "text": "末"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "如沓婆等"}
{"id": null, "n": null, "target": null, "type": null, "text": "如捨財、識見等"}
{"id": null, "n": null, "target": null, "type": null, "text": "如相召佛子、施\n生成佛等"}
{"id": null, "n": null, "target": null, "type": null, "text": "五義如後"}
{"id": null, "n": null, "target": null, "type": null, "text": "文見第十卷聖行品"}
{"id": null, "n": null, "target": null, "type": null, "text": "即十誦等律"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼律無還主義"}
{"id": null, "n": null, "target": null, "type": null, "text": "僧用\n不犯，違教吉羅"}
{"id": null, "n": null, "target": null, "type": null, "text": "四分因〔賊〕餓比丘故聽，十誦僧祗因外俗譏故閇"}
{"id": null, "n": null, "target": null, "type": null, "text": "此問古來異諍，未見其善。\n今重設問端，願聞一徹。請不俟再斫，細為明判。"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼文"}
{"id": null, "n": null, "target": null, "type": null, "text": "此即教之"}
{"id": null, "n": null, "target": null, "type": null, "text": "此即行也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上明律儀"}
{"id": null, "n": null, "target": null, "type": null, "text": "上出難意，下為決通。"}
{"id": null, "n": null, "target": null, "type": null, "text": "但引彼證小受大，不依彼次第受義"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼文"}
{"id": null, "n": null, "target": null, "type": null, "text": "下更釋通彼疑。"}
{"id": null, "n": null, "target": null, "type": null, "text": "十解，即十住也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "見敬\n儀真俗篇撫掌大笑等文"}
{"id": null, "n": null, "target": null, "type": null, "text": "論云：大乘\n中五百定等名〔奢摩他〕，如理、如量二智名〔毗鉢舍那〕"}
{"id": null, "n": null, "target": null, "type": null, "text": "煖、頂、忍、世第一"}
{"id": null, "n": null, "target": null, "type": null, "text": "無分別智并的得智"}
{"id": null, "n": null, "target": null, "type": null, "text": "聞、思、修也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上且約次第。若論圓修，初後皆妙，如\n上已示矣"}
{"id": null, "n": null, "target": null, "type": null, "text": "末"}
{"id": null, "n": null, "target": null, "type": null, "text": "本"}
{"id": null, "n": null, "target": null, "type": null, "text": "中一"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "此云眾鎧"}
{"id": null, "n": null, "target": null, "type": null, "text": "此執無也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "無學"}
{"id": null, "n": null, "target": null, "type": null, "text": "初、二、三果"}
{"id": null, "n": null, "target": null, "type": null, "text": "通內外也"}
{"id": null, "n": null, "target": null, "type": null, "text": "薄地"}
{"id": null, "n": null, "target": null, "type": null, "text": "此執有也"}
{"id": null, "n": null, "target": null, "type": null, "text": "細色決有，分通決空，圓通空有，正顯分大。"}
{"id": null, "n": null, "target": null, "type": null, "text": "體是心業，故云心道。如雜心論召無作為思，顯道亦\n名業道等是也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼文"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "前標分云二陳體狀是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "記文"}
{"id": null, "n": null, "target": null, "type": null, "text": "記云：唯決四分，與我意別。"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "瞥爾有犯等義，釋五門及答芿師文已明。"}
{"id": null, "n": null, "target": null, "type": null, "text": "準記，應云自在心也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上略決法、藥、滅三種，下詳示分品用藥及生事諍"}
{"id": null, "n": null, "target": null, "type": null, "text": "上明分品，下示隨品用藥。"}
{"id": null, "n": null, "target": null, "type": null, "text": "人現"}
{"id": null, "n": null, "target": null, "type": null, "text": "法現"}
{"id": null, "n": null, "target": null, "type": null, "text": "毗尼現也"}
{"id": null, "n": null, "target": null, "type": null, "text": "人現"}
{"id": null, "n": null, "target": null, "type": null, "text": "并上單白，并法現也"}
{"id": null, "n": null, "target": null, "type": null, "text": "毗尼現也"}
{"id": null, "n": null, "target": null, "type": null, "text": "僧現"}
{"id": null, "n": null, "target": null, "type": null, "text": "界現"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "僧現前也"}
{"id": null, "n": null, "target": null, "type": null, "text": "人現"}
{"id": null, "n": null, "target": null, "type": null, "text": "法現"}
{"id": null, "n": null, "target": null, "type": null, "text": "此多人語藥也"}
{"id": null, "n": null, "target": null, "type": null, "text": "毗尼現前，界現可知"}
{"id": null, "n": null, "target": null, "type": null, "text": "準此，應更作一單白，滅方究竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "人現"}
{"id": null, "n": null, "target": null, "type": null, "text": "法現"}
{"id": null, "n": null, "target": null, "type": null, "text": "藥也"}
{"id": null, "n": null, "target": null, "type": null, "text": "毗尼\n現也，僧界可見"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "人現"}
{"id": null, "n": null, "target": null, "type": null, "text": "法現也，亦藥也"}
{"id": null, "n": null, "target": null, "type": null, "text": "毗尼"}
{"id": null, "n": null, "target": null, "type": null, "text": "僧現"}
{"id": null, "n": null, "target": null, "type": null, "text": "人現"}
{"id": null, "n": null, "target": null, "type": null, "text": "法現"}
{"id": null, "n": null, "target": null, "type": null, "text": "藥也"}
{"id": null, "n": null, "target": null, "type": null, "text": "毗尼"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上決三單諍，已下決三事諍。"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "治人則四羯磨，舉罪則三舉也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上通決三事，下別決\n三事"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "本"}
{"id": null, "n": null, "target": null, "type": null, "text": "末"}
{"id": null, "n": null, "target": null, "type": null, "text": "戒疏同此。"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "諸文如下引之。"}
{"id": null, "n": null, "target": null, "type": null, "text": "約人肘，一肘長一尺八寸"}
{"id": null, "n": null, "target": null, "type": null, "text": "毗奈自註"}
{"id": null, "n": null, "target": null, "type": null, "text": "此一制也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此二制也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此三制也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "遠即到也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上並傳文。"}
{"id": null, "n": null, "target": null, "type": null, "text": "疏文"}
{"id": null, "n": null, "target": null, "type": null, "text": "有圖別行。"}
{"id": null, "n": null, "target": null, "type": null, "text": "別文有云：諸天白告上座迦葉，法將頹滅，\n速興結集"}
{"id": null, "n": null, "target": null, "type": null, "text": "三上九紙"}
{"id": null, "n": null, "target": null, "type": null, "text": "上二六紙"}
{"id": null, "n": null, "target": null, "type": null, "text": "一上"}
{"id": null, "n": null, "target": null, "type": null, "text": "即上人假"}
{"id": null, "n": null, "target": null, "type": null, "text": "六根、六識及心數法並境界對"}
{"id": null, "n": null, "target": null, "type": null, "text": "五根、五塵障礙對也"}
{"id": null, "n": null, "target": null, "type": null, "text": "六識、意根為七心及一分心數法並緣對"}
{"id": null, "n": null, "target": null, "type": null, "text": "法界一分，四十六心所也"}
{"id": null, "n": null, "target": null, "type": null, "text": "初念屬根，次念屬識"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼文"}
{"id": null, "n": null, "target": null, "type": null, "text": "據標師所引，未知何論。"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦據他文\n所引，未知何論文也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂依善戒，為後方便，一重關也。立圓受具，習後受大，兩重關也。特與\n註決。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上三受戒篇"}
{"id": null, "n": null, "target": null, "type": null, "text": "將欲受戒，先標所期，\n為求成道。此云求道，即小乘四果也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "小乘\n唯專自利。此云救生，語似利他。然護彼命，意在全己，使無損他，還是自利。但諸行中，護生為要，故先標之。"}
{"id": null, "n": null, "target": null, "type": null, "text": "志非堅利，心無節操。"}
{"id": null, "n": null, "target": null, "type": null, "text": "立志決徹，絕無他念，故云正心。此云向道，望前為勝，望後為劣，如記可見。"}
{"id": null, "n": null, "target": null, "type": null, "text": "解疑之言，非究竟度。中品之相，於茲可見。"}
{"id": null, "n": null, "target": null, "type": null, "text": "菩薩利他，有深有淺。諸經論中，各有教量。"}
{"id": null, "n": null, "target": null, "type": null, "text": "發心\n所期，戒隨心感。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上品發心，期在白四納三聚也。後於正羯磨前，又云：今受此戒，成就三聚戒，此名上品心。\n妄執者言：今白四受，為後方便好。細詳此文"}
{"id": null, "n": null, "target": null, "type": null, "text": "即斷\n惡、修善二誓也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即度生誓也"}
{"id": null, "n": null, "target": null, "type": null, "text": "行已、度生、護法，此三出家本務，三中度生㝡要。所以此文及羯磨經，並引多論，起慈悲心，專在\n救攝眾生。後第三羯磨之前，又囑云：心緣救攝眾生，并護佛法。是知度生、護法，為僧己任，庶使正法久住於世。\n\n今欲受戒，若不先建此心，何能納法亘周？何能起行彌博？白四雖是小法，發大故，即納三聚。此本宗通大之義\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上卷受戒篇正授戒體前"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃至"}
{"id": null, "n": null, "target": null, "type": null, "text": "細詳此文，引論起慈，正為白四受具，是為上品心，而納上品戒。此經\n立法，與鈔一同。鈔敘發心，而列三品。上品一受，直納三聚。此經不列中、下，唯明上品。引論起慈，乃菩薩大心，意\n令即納菩薩大戒。文中即無起慈為後方便之義。世中妄言之人，皆考文之不細也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "三下，釋前經文"}
{"id": null, "n": null, "target": null, "type": null, "text": "此文贊美經中引論起慈，正合機教。教即此宗，義當大乘。鈔中上品一受，\n正本此義。凡大乘明行，度生為先。機即假宗知權，不滯小果，直趣菩提。然成佛果，先須度生。據斯機教，建立受\n儀，所以先令起慈。若不預起慈悲大心，何以納菩薩大戒？正合出家本志，故云深有由矣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此釋經起慈受具，唯在攝生也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "引經證顯比丘受具，即納菩薩\n大戒。七眾既許受菩薩戒，今比丘受具，受菩薩戒，決無疑矣。此三句文，即是引證之語。世人不曉，妄謂祖師令\n依善戒次第而受。今之受具，為後方便。余將經疏參合鈔文，從前至後，子細詳考，即無此義。且如鈔中三品發\n心，皆為受具，豈上品一受，反為後大方便？又依律立法，為成受具，而發心起慈，反成後大。若謂記中有此義者，\n然今所立，唯以祖師之文考定祖師立意。記文或得或失，未可一槩輙便依用。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此即前素非懷大等義。以正受望發心，故云向也；發心望正受，故云\n後也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此問正決上品大受。"}
{"id": null, "n": null, "target": null, "type": null, "text": "三聚法相，如前答芿師文可見"}
{"id": null, "n": null, "target": null, "type": null, "text": "文在前引"}
{"id": null, "n": null, "target": null, "type": null, "text": "末"}
{"id": null, "n": null, "target": null, "type": null, "text": "本"}
{"id": null, "n": null, "target": null, "type": null, "text": "一上"}
{"id": null, "n": null, "target": null, "type": null, "text": "疏文"}
{"id": null, "n": null, "target": null, "type": null, "text": "記文"}
{"id": null, "n": null, "target": null, "type": null, "text": "二上"}
{"id": null, "n": null, "target": null, "type": null, "text": "疏文"}
{"id": null, "n": null, "target": null, "type": null, "text": "同上"}
{"id": null, "n": null, "target": null, "type": null, "text": "此指慈悲少欲等為\n不犯法也"}
{"id": null, "n": null, "target": null, "type": null, "text": "不犯行也"}
{"id": null, "n": null, "target": null, "type": null, "text": "疏文"}
{"id": null, "n": null, "target": null, "type": null, "text": "同上"}
{"id": null, "n": null, "target": null, "type": null, "text": "疏文"}
{"id": null, "n": null, "target": null, "type": null, "text": "記文"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼文"}
{"id": null, "n": null, "target": null, "type": null, "text": "教制即律中制令攝念之文也"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼文"}
{"id": null, "n": null, "target": null, "type": null, "text": "疏文"}
{"id": null, "n": null, "target": null, "type": null, "text": "此止犯，即教行雙持\n犯中止犯也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "去呼"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "十六及八罪，且舉枝，不說根本。此九句中，自〔含〕根、條並列。尋圖，\n可見也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此即\n違教罪也"}
{"id": null, "n": null, "target": null, "type": null, "text": "疏云\n疑有十句"}
{"id": null, "n": null, "target": null, "type": null, "text": "疏云一夷、九蘭"}
{"id": null, "n": null, "target": null, "type": null, "text": "舊答云盜戒但出本境者非"}
{"id": null, "n": null, "target": null, "type": null, "text": "本"}
{"id": null, "n": null, "target": null, "type": null, "text": "末"}
{"id": null, "n": null, "target": null, "type": null, "text": "近有同輩，指上一節之文，是明心用持犯。以下\n若據教行等文，方明教行。此無稽之論，不足可道。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此二記文，並是釋上同答等文之末。"}
{"id": null, "n": null, "target": null, "type": null, "text": "夢庵謂：此中明三衣等者，乃是預出離衣戒，持護離\n失之義。今有隨流之者，猶以為是，豈為識達耶？"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上示通義，此下問\n答及㭊彼義中用別義也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云\n云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "前註云夢庵約持護論者，文見此也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼文"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼文"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼文"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼文"}
{"id": null, "n": null, "target": null, "type": null, "text": "與行宗同"}
{"id": null, "n": null, "target": null, "type": null, "text": "與行宗別"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "此謂不乞屬作"}
{"id": null, "n": null, "target": null, "type": null, "text": "反顯不乞犯殘"}
{"id": null, "n": null, "target": null, "type": null, "text": "鈔中止門，文亦同此。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云\n云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "音逗"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云\n云"}
{"id": null, "n": null, "target": null, "type": null, "text": "三下二紙"}
{"id": null, "n": null, "target": null, "type": null, "text": "十二紙"}
{"id": null, "n": null, "target": null, "type": null, "text": "兩宗即上成實二義。"}
{"id": null, "n": null, "target": null, "type": null, "text": "中一"}
{"id": null, "n": null, "target": null, "type": null, "text": "一上五紙"}
{"id": null, "n": null, "target": null, "type": null, "text": "一上十一"}
{"id": null, "n": null, "target": null, "type": null, "text": "疏文"}
{"id": null, "n": null, "target": null, "type": null, "text": "此謂能呵，情見異也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此謂眾僧執法為是，聞呵\n不止也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "今更因簡前六濫非濫別"}
{"id": null, "n": null, "target": null, "type": null, "text": "一下十八"}
{"id": null, "n": null, "target": null, "type": null, "text": "不貪、不嗔、不癡"}
{"id": null, "n": null, "target": null, "type": null, "text": "據疏所定，犯吉羅也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "四下"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "己丑"}
{"id": null, "n": "0721001", "target": "#nkr_note_orig_0721001", "type": "orig", "text": "不疑於"}
