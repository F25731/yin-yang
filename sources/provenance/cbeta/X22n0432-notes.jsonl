{"id": null, "n": null, "target": null, "type": null, "text": "實報、方便、同居"}
{"id": null, "n": null, "target": null, "type": null, "text": "學川"}
{"id": null, "n": null, "target": null, "type": null, "text": "學烺"}
{"id": null, "n": null, "target": null, "type": null, "text": "三稱三拜"}
{"id": null, "n": null, "target": null, "type": null, "text": "祇音其"}
{"id": null, "n": null, "target": null, "type": null, "text": "犍音尖"}
{"id": null, "n": null, "target": null, "type": null, "text": "葉音攝"}
{"id": null, "n": null, "target": null, "type": null, "text": "絺音郗"}
{"id": null, "n": null, "target": null, "type": null, "text": "伽音茄"}
{"id": null, "n": null, "target": null, "type": null, "text": "憍音交"}
{"id": null, "n": null, "target": null, "type": null, "text": "那，奴何切"}
{"id": null, "n": null, "target": null, "type": null, "text": "㝹，奴侯切"}
{"id": null, "n": null, "target": null, "type": null, "text": "裓音革。"}
{"id": null, "n": null, "target": null, "type": null, "text": "數，上聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "鞞音皮"}
{"id": null, "n": null, "target": null, "type": null, "text": "閦音促"}
{"id": null, "n": null, "target": null, "type": null, "text": "哆音\n多。他音拖。伽音茄。毗音皮。躭音丹。膩，女利切。那，奴何切。枳音紙。隷音利。"}
