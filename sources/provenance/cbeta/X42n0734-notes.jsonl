{"id": null, "n": null, "target": null, "type": null, "text": "〔草書滅法深染傳者須得真〕"}
{"id": null, "n": null, "target": null, "type": null, "text": "若見亦爾到邊犯提"}
{"id": null, "n": null, "target": null, "type": null, "text": "此一段文出吳蜀地。新本畏人疑恠。故注源由"}
{"id": null, "n": null, "target": null, "type": null, "text": "思畏斷故"}
{"id": null, "n": null, "target": null, "type": null, "text": "義言淨法應爾"}
{"id": null, "n": null, "target": null, "type": null, "text": "義言尼□□說略□\n誡。及尼來自恣。無羯磨。而說欲者。應類此"}
{"id": null, "n": null, "target": null, "type": null, "text": "從雨浴衣戒至輙教誡尼戒竟"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T40n1804_p0077a21"}
{"id": null, "n": "0311001", "target": "#nkr_note_orig_0311001", "type": "orig", "text": "草等十一字應在書目若撰者下"}
{"id": null, "n": "0311002", "target": "#nkr_note_orig_0311002", "type": "orig", "text": "得疑淨"}
{"id": null, "n": "0311003", "target": "#nkr_note_orig_0311003", "type": "orig", "text": "歡下疑脫憘字"}
{"id": null, "n": "0312001", "target": "#nkr_note_orig_0312001", "type": "orig", "text": "犬疑伏"}
{"id": null, "n": "0312002", "target": "#nkr_note_orig_0312002", "type": "orig", "text": "對一作討"}
{"id": null, "n": "0312003", "target": "#nkr_note_orig_0312003", "type": "orig", "text": "安上疑脫居字若安字剩"}
{"id": null, "n": "0312004", "target": "#nkr_note_orig_0312004", "type": "orig", "text": "施一作征"}
{"id": null, "n": "0313001", "target": "#nkr_note_orig_0313001", "type": "orig", "text": "為是疑是為"}
{"id": null, "n": "0313002", "target": "#nkr_note_orig_0313002", "type": "orig", "text": "前字疑剩"}
{"id": null, "n": "0314001", "target": "#nkr_note_orig_0314001", "type": "orig", "text": "與＊請疑丘請（＊印ノ字ハ本文ト異ナル。󴦒）"}
{"id": null, "n": "0315001", "target": "#nkr_note_orig_0315001", "type": "orig", "text": "中下疑脫品字"}
{"id": null, "n": "0316001", "target": "#nkr_note_orig_0316001", "type": "orig", "text": "以疑品"}
{"id": null, "n": "0316002", "target": "#nkr_note_orig_0316002", "type": "orig", "text": "清疑請"}
{"id": null, "n": "0317001", "target": "#nkr_note_orig_0317001", "type": "orig", "text": "復疑後"}
{"id": null, "n": "0318001", "target": "#nkr_note_orig_0318001", "type": "orig", "text": "平疑互"}
{"id": null, "n": "0321001", "target": "#nkr_note_orig_0321001", "type": "orig", "text": "褁疑畏"}
{"id": null, "n": "0322001", "target": "#nkr_note_orig_0322001", "type": "orig", "text": "羅疑罪"}
{"id": null, "n": "0322002", "target": "#nkr_note_orig_0322002", "type": "orig", "text": "遂疑然下同"}
{"id": null, "n": "0322003", "target": "#nkr_note_orig_0322003", "type": "orig", "text": "然一作眾"}
{"id": null, "n": "0323001", "target": "#nkr_note_orig_0323001", "type": "orig", "text": "午疑手"}
{"id": null, "n": "0324001", "target": "#nkr_note_orig_0324001", "type": "orig", "text": "立疑土下同"}
{"id": null, "n": "0325001", "target": "#nkr_note_orig_0325001", "type": "orig", "text": "大疑火"}
{"id": null, "n": "0326001", "target": "#nkr_note_orig_0326001", "type": "orig", "text": "千疑于"}
{"id": null, "n": "0327001", "target": "#nkr_note_orig_0327001", "type": "orig", "text": "□疑并"}
{"id": null, "n": "0329001", "target": "#nkr_note_orig_0329001", "type": "orig", "text": "鬼疑兄"}
{"id": null, "n": "0330001", "target": "#nkr_note_orig_0330001", "type": "orig", "text": "和疑知"}
{"id": null, "n": "0330002", "target": "#nkr_note_orig_0330002", "type": "orig", "text": "五疑問"}
{"id": null, "n": "0331001", "target": "#nkr_note_orig_0331001", "type": "orig", "text": "法字疑衍"}
{"id": null, "n": "0332001", "target": "#nkr_note_orig_0332001", "type": "orig", "text": "陀疑隨"}
