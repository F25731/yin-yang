{"id": null, "n": "0096005", "target": "#nkr_note_orig_0096005", "type": "orig", "text": "「昔過去久遠有一比丘……總持第一」，疑出自《付法藏因緣傳》卷二，參見《大正藏》第50卷第301頁。"}
{"id": null, "n": "0096006", "target": "#nkr_note_orig_0096006", "type": "orig", "text": "「能自開智」、「如睡覺智」二條，見《大正藏》第33卷第438頁上。"}
{"id": null, "n": "0097001", "target": "#nkr_note_orig_0097001", "type": "orig", "text": "引自三十六卷本《大般涅槃經》（當時可能是三十八卷本），見《大正藏》第12卷第791上。"}
{"id": null, "n": "0097002", "target": "#nkr_note_orig_0097002", "type": "orig", "text": "「寫瓶有寄故囑傳燈」、「菩薩形異處疎」二條，見《大正藏》第33卷第437頁上。"}
{"id": null, "n": "0097003", "target": "#nkr_note_orig_0097003", "type": "orig", "text": "「毗娑」，底本作「婆」，據良賁《仁王經疏》改。"}
{"id": null, "n": "0097004", "target": "#nkr_note_orig_0097004", "type": "orig", "text": "「囑」，此字不清，疑為「囑」。"}
{"id": null, "n": "0097005", "target": "#nkr_note_orig_0097005", "type": "orig", "text": "「羯尼迦樹」至「邊侯聞命」十條，見《大正藏》第33卷第438頁下。"}
{"id": null, "n": "0098001", "target": "#nkr_note_orig_0098001", "type": "orig", "text": "引文見《大正藏》第33卷第439頁上。"}
{"id": null, "n": "0098002", "target": "#nkr_note_orig_0098002", "type": "orig", "text": "「基」至「二謂退凡」十一條，見《大正藏》第33卷第439頁上。"}
{"id": null, "n": "0098003", "target": "#nkr_note_orig_0098003", "type": "orig", "text": "引文見《大正藏》第33卷第439頁上。"}
{"id": null, "n": "0098004", "target": "#nkr_note_orig_0098004", "type": "orig", "text": "「大軍」，見《大正藏》第33卷第439頁中。"}
{"id": null, "n": "0098005", "target": "#nkr_note_orig_0098005", "type": "orig", "text": "「如共一船，憂喜同故」，見《大正藏》第33卷第442頁上。"}
{"id": null, "n": "0098006", "target": "#nkr_note_orig_0098006", "type": "orig", "text": "「印璽」，見《大正藏》第33卷第443頁中。"}
{"id": null, "n": "0098007", "target": "#nkr_note_orig_0098007", "type": "orig", "text": "「法謂軌持」，見《大正藏》第33卷第443頁下。"}
{"id": null, "n": "0099001", "target": "#nkr_note_orig_0099001", "type": "orig", "text": "「待眾緣故」，見《大正藏》第33卷第446頁中。"}
{"id": null, "n": "0099002", "target": "#nkr_note_orig_0099002", "type": "orig", "text": "「四十」，底本作「三十」，據文意改。"}
{"id": null, "n": "0099003", "target": "#nkr_note_orig_0099003", "type": "orig", "text": "「大蟒」、「田蛗」、「慳儉」三條，見《大正藏》第33卷第448頁上。"}
{"id": null, "n": "0099004", "target": "#nkr_note_orig_0099004", "type": "orig", "text": "眉批「《維摩經》云」。"}
{"id": null, "n": "0099005", "target": "#nkr_note_orig_0099005", "type": "orig", "text": "「一」，底本作「二」，據文意改。"}
{"id": null, "n": "0099006", "target": "#nkr_note_orig_0099006", "type": "orig", "text": "紙背墨書：「白色是眾色之本，表三乘皈一乘故。」"}
{"id": null, "n": "0099007", "target": "#nkr_note_orig_0099007", "type": "orig", "text": "「爾時佛放眉間白毫相光……所說經法」，出自《妙法蓮華經．序品》，字略有異，見《大正藏》第9卷第2頁中。"}
{"id": null, "n": "0099008", "target": "#nkr_note_orig_0099008", "type": "orig", "text": "「爾時毗耶離大城……大千世界」，出自《維摩詰所說經．佛國品第一》，見《大正藏》第14卷第537頁中。"}
{"id": null, "n": "0099009", "target": "#nkr_note_orig_0099009", "type": "orig", "text": "「標」，底本無，據良賁《仁王經疏》補。"}
{"id": null, "n": "0099010", "target": "#nkr_note_orig_0099010", "type": "orig", "text": "「或眉間流照表示一乘」至「即同往古建子為正，黑半標元」，見《大正藏》第33卷第448頁下。"}
{"id": null, "n": "0100001", "target": "#nkr_note_orig_0100001", "type": "orig", "text": "「間錯」，見《大正藏》第33卷第449頁中。"}
{"id": null, "n": "0100002", "target": "#nkr_note_orig_0100002", "type": "orig", "text": "「為經之主」、「明其報得」二條，見《大正藏》第33卷第451頁上。"}
{"id": null, "n": "0100003", "target": "#nkr_note_orig_0100003", "type": "orig", "text": "文見《大正藏》第8卷第840頁中。"}
{"id": null, "n": "0100004", "target": "#nkr_note_orig_0100004", "type": "orig", "text": "引文見《大正藏》第8卷第840頁下。"}
{"id": null, "n": "0100005", "target": "#nkr_note_orig_0100005", "type": "orig", "text": "「此兼人法云觀如來」，見《大正藏》第33卷第451頁中。"}
{"id": null, "n": "0100006", "target": "#nkr_note_orig_0100006", "type": "orig", "text": "引文見《大正藏》第8卷第835頁中。"}
{"id": null, "n": "0100007", "target": "#nkr_note_orig_0100007", "type": "orig", "text": "「初一善哉」至「讚起悲深」，見《大正藏》第33卷第452頁上。"}
{"id": null, "n": "0100008", "target": "#nkr_note_orig_0100008", "type": "orig", "text": "引文見《大正藏》第8卷第835頁中。"}
{"id": null, "n": "0101001", "target": "#nkr_note_orig_0101001", "type": "orig", "text": "「涉有未始迷空」，見《大正藏》第33卷第458頁中。"}
{"id": null, "n": "0101002", "target": "#nkr_note_orig_0101002", "type": "orig", "text": "「阿羅漢受變易身」，出自《大正藏》第33卷第461頁上。良賁《仁王經疏》文作「一者阿羅漢，二者獨覺，三者已得自在菩薩受變易身」。"}
{"id": null, "n": "0101003", "target": "#nkr_note_orig_0101003", "type": "orig", "text": "「唯願」，底本不清，據文意補。"}
{"id": null, "n": "0102001", "target": "#nkr_note_orig_0102001", "type": "orig", "text": "出自《大智度論》卷二，參見《大正藏》第25卷第67頁下至69頁上。"}
{"id": null, "n": "0102002", "target": "#nkr_note_orig_0102002", "type": "orig", "text": "《付法藏因緣傳》中有關阿難承命傳法，因示教感嘆的記述，不如《大唐西域記》詳細，參見《大正藏》第50卷第301頁上；第51卷第909頁下。"}
{"id": null, "n": "0102003", "target": "#nkr_note_orig_0102003", "type": "orig", "text": "「七」底本作「十七」，據文意改。"}
{"id": null, "n": "0102004", "target": "#nkr_note_orig_0102004", "type": "orig", "text": "「阿難到殑伽河……與吠舍釐王」，出自《大唐西域記》卷七，文句略異，見《大正藏》第51卷第909頁下。"}
{"id": null, "n": "0102005", "target": "#nkr_note_orig_0102005", "type": "orig", "text": "「十」，底本作「千」，據良賁《仁王經疏》改。"}
{"id": null, "n": "0102006", "target": "#nkr_note_orig_0102006", "type": "orig", "text": "「帝釋往昔有三十二人……如餘處說」，見《大正藏》第33卷第446頁下，字略有異。"}
{"id": null, "n": "0103001", "target": "#nkr_note_orig_0103001", "type": "orig", "text": "「繭」，底本作「璽」，據良賁《仁王經疏》改。"}
{"id": null, "n": "0103002", "target": "#nkr_note_orig_0103002", "type": "orig", "text": "「曹主艱貧，令其……遂放從良」，紙本正面文字無，據紙背墨書文字補。"}
{"id": null, "n": "0103003", "target": "#nkr_note_orig_0103003", "type": "orig", "text": "「云」，底本作「三介處云」，據文意刪。"}
{"id": null, "n": "0104001", "target": "#nkr_note_orig_0104001", "type": "orig", "text": "「若持戒時，心生念言，我若…生於何處」，紙本正面文字無，據紙背墨書文字補。"}
{"id": null, "n": "0104002", "target": "#nkr_note_orig_0104002", "type": "orig", "text": "「言修羅亦云執日」，見《大正藏》第33卷第447頁下。"}
{"id": null, "n": "0104003", "target": "#nkr_note_orig_0104003", "type": "orig", "text": "「焦」，此字不清，疑為「焦」。"}
{"id": null, "n": "0104004", "target": "#nkr_note_orig_0104004", "type": "orig", "text": "「阿難結集」，見《大正藏》第33卷第435頁下。"}
{"id": null, "n": "0104005", "target": "#nkr_note_orig_0104005", "type": "orig", "text": "「□」，此處當脫一字。"}
{"id": null, "n": "0105001", "target": "#nkr_note_orig_0105001", "type": "orig", "text": "「先自年」三字中，應衍一字。"}
{"id": null, "n": "0105002", "target": "#nkr_note_orig_0105002", "type": "orig", "text": "「人」，應為「仁」之誤。"}
{"id": null, "n": "0105003", "target": "#nkr_note_orig_0105003", "type": "orig", "text": "紙背墨書：「《司南》：阿闍世，此云未生怨。」"}
{"id": null, "n": "0105004", "target": "#nkr_note_orig_0105004", "type": "orig", "text": "「摩竭陀國古先君王……四十里」，出自《大唐西域記》卷九，文句有異，見《大正藏》第51卷第920頁下；並參見良賁《仁王經疏》所引文字，見《大正藏》第33卷第438頁下。"}
{"id": null, "n": "0106001", "target": "#nkr_note_orig_0106001", "type": "orig", "text": "「城北門外行……造斯石室」，出自《大唐西域記》卷九，文句有異，見《大正藏》第51卷第922頁中。"}
{"id": null, "n": "0106002", "target": "#nkr_note_orig_0106002", "type": "orig", "text": "「至」，底本作「至問」，據文意刪。"}
{"id": null, "n": "0106003", "target": "#nkr_note_orig_0106003", "type": "orig", "text": "「迦葉受請為結集故……還至石室」，出自《大智度論》卷二，見《大正藏》第25卷第67頁下至69頁上。"}
{"id": null, "n": "0106004", "target": "#nkr_note_orig_0106004", "type": "orig", "text": "「來」，疑為「眾」之誤。"}
{"id": null, "n": "0107001", "target": "#nkr_note_orig_0107001", "type": "orig", "text": "「言我」，底本作「我言」，據文意改。"}
{"id": null, "n": "0107002", "target": "#nkr_note_orig_0107002", "type": "orig", "text": "「五見」，《大智度論》卷二作「可恥」。"}
{"id": null, "n": "0107003", "target": "#nkr_note_orig_0107003", "type": "orig", "text": "「由慶喜先住學地……集修多羅藏」，參見《大正藏》第25卷第68頁上至69頁上。"}
{"id": null, "n": "0107004", "target": "#nkr_note_orig_0107004", "type": "orig", "text": "「優」，底本無，據文意補。"}
{"id": null, "n": "0107005", "target": "#nkr_note_orig_0107005", "type": "orig", "text": "「為」，此字不清，疑為「為」。"}
{"id": null, "n": "0107006", "target": "#nkr_note_orig_0107006", "type": "orig", "text": "關於三阿難及結集聲聞、緣覺、菩薩藏藏之說，參見《大正藏》第33卷第437頁上。"}
{"id": null, "n": "0108001", "target": "#nkr_note_orig_0108001", "type": "orig", "text": "「瘡疣」，見《大正藏》第33卷第491頁上。"}
{"id": null, "n": "0108002", "target": "#nkr_note_orig_0108002", "type": "orig", "text": "「顯隱詞」，底本作「詞」，據文意補。"}
{"id": null, "n": "0108003", "target": "#nkr_note_orig_0108003", "type": "orig", "text": "「就命時到」、「因緣俱勝」，見《大正藏》第33卷第491頁下。"}
{"id": null, "n": "0108004", "target": "#nkr_note_orig_0108004", "type": "orig", "text": "「出家為道」，見《大正藏》第33卷第492頁上。"}
{"id": null, "n": "0108005", "target": "#nkr_note_orig_0108005", "type": "orig", "text": "「如法華經彼龍女故」，見《大正藏》第33卷第494頁中。"}
{"id": null, "n": "0109001", "target": "#nkr_note_orig_0109001", "type": "orig", "text": "「者」，底本無，據文意補。"}
{"id": null, "n": "0109002", "target": "#nkr_note_orig_0109002", "type": "orig", "text": "「眾」，底本無，據《妙法蓮華經．提婆達多品》補。"}
{"id": null, "n": "0109003", "target": "#nkr_note_orig_0109003", "type": "orig", "text": "「文殊師利言……一切眾生演說妙法」，出自《妙法蓮華經．提婆達多品》，文句略異，見《大正藏》第9卷第35頁中下。"}
{"id": null, "n": "0109004", "target": "#nkr_note_orig_0109004", "type": "orig", "text": "「違前二科三等無咎」，見《大正藏》第33卷第494頁下。"}
{"id": null, "n": "0109005", "target": "#nkr_note_orig_0109005", "type": "orig", "text": "「內」，底本無，據文意補。"}
{"id": null, "n": "0109006", "target": "#nkr_note_orig_0109006", "type": "orig", "text": "「如二」，底本作「二如」，據良賁《仁王經疏》改。"}
{"id": null, "n": "0109007", "target": "#nkr_note_orig_0109007", "type": "orig", "text": "「思議，後總彰前具明二護」，底本無，據良賁《仁王經疏》補。"}
{"id": null, "n": "0109008", "target": "#nkr_note_orig_0109008", "type": "orig", "text": "「王等」，底本作「主」，據良賁《仁王經疏》改。"}
{"id": null, "n": "0109009", "target": "#nkr_note_orig_0109009", "type": "orig", "text": "「無」，底本無，據文意補。"}
{"id": null, "n": "0109010", "target": "#nkr_note_orig_0109010", "type": "orig", "text": "「又科為二……彰內外故」，出自良賁《仁王經疏》，文句略異，見《大正藏》第33卷第451頁上。"}
{"id": null, "n": "0110001", "target": "#nkr_note_orig_0110001", "type": "orig", "text": "「加行資糧二乘異生見有異也」、「我今盧舍那」，見《大正藏》第33卷第495頁上。"}
{"id": null, "n": "0110002", "target": "#nkr_note_orig_0110002", "type": "orig", "text": "「那」，底本無，據法藏《梵網經菩薩戒本疏》補。"}
{"id": null, "n": "0110003", "target": "#nkr_note_orig_0110003", "type": "orig", "text": "「則」，底本作「即」，據法藏《梵網經菩薩戒本疏》改。"}
{"id": null, "n": "0110004", "target": "#nkr_note_orig_0110004", "type": "orig", "text": "「有」，底本無，據法藏《梵網經菩薩戒本疏》補。"}
{"id": null, "n": "0110005", "target": "#nkr_note_orig_0110005", "type": "orig", "text": "「釋迦」，底本作「釋迦故」，據法藏《梵網經菩薩戒本疏》刪。"}
{"id": null, "n": "0110006", "target": "#nkr_note_orig_0110006", "type": "orig", "text": "引文見《大正藏》第40卷第605頁下。"}
{"id": null, "n": "0110007", "target": "#nkr_note_orig_0110007", "type": "orig", "text": "「自」，底本無，據良賁《仁王經疏》補。"}
{"id": null, "n": "0110008", "target": "#nkr_note_orig_0110008", "type": "orig", "text": "「自受用身」，見《大正藏》第33卷第494頁下。"}
{"id": null, "n": "0110009", "target": "#nkr_note_orig_0110009", "type": "orig", "text": "「住解脫位」，見《大正藏》第33卷第497頁中。"}
{"id": null, "n": "0110010", "target": "#nkr_note_orig_0110010", "type": "orig", "text": "引文見《大正藏》第33卷第497頁中。"}
{"id": null, "n": "0110011", "target": "#nkr_note_orig_0110011", "type": "orig", "text": "「行」，底本作「八」，據不空《仁王經》改。"}
{"id": null, "n": "0110012", "target": "#nkr_note_orig_0110012", "type": "orig", "text": "「仗忍聖胎三十人……無不由此仗忍生」，出自不空譯《仁王經》，見《大正藏》第8卷第837頁中。"}
{"id": null, "n": "0111001", "target": "#nkr_note_orig_0111001", "type": "orig", "text": "「習種銅輪二天下」，見《大正藏》第33卷第472頁中。"}
{"id": null, "n": "0111002", "target": "#nkr_note_orig_0111002", "type": "orig", "text": "「三」，應為「云」之誤。"}
{"id": null, "n": "0111003", "target": "#nkr_note_orig_0111003", "type": "orig", "text": "「三練磨心」、「性種性菩薩」，見《大正藏》第33卷第497頁下。"}
{"id": null, "n": "0111004", "target": "#nkr_note_orig_0111004", "type": "orig", "text": "出自不空譯《仁王經》，見《大正藏》第8卷第837頁中。"}
{"id": null, "n": "0111005", "target": "#nkr_note_orig_0111005", "type": "orig", "text": "「行」，底本無，據良賁《仁王經疏》補。"}
{"id": null, "n": "0111006", "target": "#nkr_note_orig_0111006", "type": "orig", "text": "引文見《大正藏》第33卷第498頁中。"}
{"id": null, "n": "0111007", "target": "#nkr_note_orig_0111007", "type": "orig", "text": "「虛誑」至「雜穢」四條，見《大正藏》第33卷第503頁上。"}
{"id": null, "n": "0112001", "target": "#nkr_note_orig_0112001", "type": "orig", "text": "「由多荊確」、「果多辛辣」，見《大正藏》第33卷第503頁中。"}
{"id": null, "n": "0112002", "target": "#nkr_note_orig_0112002", "type": "orig", "text": "「滅盡定」，見《大正藏》第33卷第507頁上。"}
{"id": null, "n": "0112003", "target": "#nkr_note_orig_0112003", "type": "orig", "text": "「轉依義別略有四種」，見《大正藏》第33卷第510頁上。"}
{"id": null, "n": "0112004", "target": "#nkr_note_orig_0112004", "type": "orig", "text": "引文見《大正藏》第33卷第510頁上。"}
{"id": null, "n": "0112005", "target": "#nkr_note_orig_0112005", "type": "orig", "text": "「十三法師奉持（文）」，見《大正藏》第33卷第495頁中（513頁上）。"}
{"id": null, "n": "0112006", "target": "#nkr_note_orig_0112006", "type": "orig", "text": "引文見《大正藏》第8卷第842頁中。"}
{"id": null, "n": "0112007", "target": "#nkr_note_orig_0112007", "type": "orig", "text": "「十六國王奉持」，見《大正藏》第33卷第495頁中。"}
{"id": null, "n": "0112008", "target": "#nkr_note_orig_0112008", "type": "orig", "text": "引文見《大正藏》第8卷第843頁上至845頁上。"}
{"id": null, "n": "0112009", "target": "#nkr_note_orig_0112009", "type": "orig", "text": "「對翻」，底本無，據《大正藏》第33卷第517頁上補。"}
{"id": null, "n": "0112010", "target": "#nkr_note_orig_0112010", "type": "orig", "text": "「火字二現喻一現業種」，底本作「火字二現在喻一現在業種子」，據良賁《仁王經疏》刪，見《大正藏》第33卷第446頁中。"}
{"id": null, "n": "0112011", "target": "#nkr_note_orig_0112011", "type": "orig", "text": "「此生」，底本作「生此」，據文意改。"}
{"id": null, "n": "0113001", "target": "#nkr_note_orig_0113001", "type": "orig", "text": "「三」，底本作「四」，據上下文改。下同。"}
{"id": null, "n": "0113002", "target": "#nkr_note_orig_0113002", "type": "orig", "text": "「熟。一者」，底本殘，據上下文補。"}
{"id": null, "n": "0113003", "target": "#nkr_note_orig_0113003", "type": "orig", "text": "「熟。二者有」，底本殘，據上下文補。"}
{"id": null, "n": "0113004", "target": "#nkr_note_orig_0113004", "type": "orig", "text": "底本「熟」字後有「保安八年佛弟子比丘釋道常奉舉七代先亡寫疏一卷」的題記。"}
{"id": null, "n": "0088a0601", "target": "#nkr_note_add_0088a0601", "type": "add", "text": "剌【CB】，刺【藏外】"}
{"id": null, "n": "0099a1001", "target": "#nkr_note_add_0099a1001", "type": "add", "text": "吒【CB】，乇【藏外】"}
{"id": null, "n": "0111a0901", "target": "#nkr_note_add_0111a0901", "type": "add", "text": "己【CB】，已【藏外】"}
