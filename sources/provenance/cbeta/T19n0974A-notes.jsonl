{"id": null, "n": "0383024", "target": "#nkr_note_mod_0383024", "type": "mod", "text": "西【大】，宋西【明】"}
{"id": null, "n": "0383025", "target": "#nkr_note_mod_0383025", "type": "mod", "text": "譯【大】，奉詔譯【宋】【元】【明】"}
{"id": null, "n": "0383026", "target": "#nkr_note_mod_0383026", "type": "mod", "text": "反【大】下同，切【明】下同"}
{"id": null, "n": "0383027", "target": "#nkr_note_mod_0383027", "type": "mod", "text": "句【大】，一句【宋】【元】【明】"}
{"id": null, "n": "0383028", "target": "#nkr_note_mod_0383028", "type": "mod", "text": "無可反【大】，〔－〕【明】"}
{"id": null, "n": "0383029", "target": "#nkr_note_mod_0383029", "type": "mod", "text": "反【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0383030", "target": "#nkr_note_mod_0383030", "type": "mod", "text": "嚨【大】，龍【宋】"}
{"id": null, "n": "0383031", "target": "#nkr_note_mod_0383031", "type": "mod", "text": "去【大】，上【宋】【元】【明】"}
{"id": null, "n": "0383032", "target": "#nkr_note_mod_0383032", "type": "mod", "text": "合【大】，句【明】"}
{"id": null, "n": "0383033", "target": "#nkr_note_mod_0383033", "type": "mod", "text": "丁以反【大】＊，〔－〕【明】＊"}
{"id": null, "n": "0383034", "target": "#nkr_note_mod_0383034", "type": "mod", "text": "又【大】，叉【宋】【元】【明】"}
{"id": null, "n": "0383035", "target": "#nkr_note_mod_0383035", "type": "mod", "text": "合【大】，句【宋】【元】"}
{"id": null, "n": "0383036", "target": "#nkr_note_mod_0383036", "type": "mod", "text": "羊主反【大】，〔－〕【明】"}
{"id": null, "n": "0383037", "target": "#nkr_note_mod_0383037", "type": "mod", "text": "仁拶反【大】，〔－〕【明】"}
{"id": null, "n": "0383038", "target": "#nkr_note_mod_0383038", "type": "mod", "text": "泥以反【大】，〔－〕【明】"}
{"id": null, "n": "0383039", "target": "#nkr_note_mod_0383039", "type": "mod", "text": "舌【大】＊，舌呼【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0384001", "target": "#nkr_note_mod_0384001", "type": "mod", "text": "地【大】，他【元】"}
{"id": null, "n": "0384002", "target": "#nkr_note_mod_0384002", "type": "mod", "text": "嚩【大】，縛【明】"}
{"id": null, "n": "0384003", "target": "#nkr_note_mod_0384003", "type": "mod", "text": "句【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0384004", "target": "#nkr_note_mod_0384004", "type": "mod", "text": "去【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0384005", "target": "#nkr_note_mod_0384005", "type": "mod", "text": "句【大】＊，〔－〕【明】＊"}
{"id": null, "n": "0384006", "target": "#nkr_note_mod_0384006", "type": "mod", "text": "𥟦【大】，󳛇【宋】【元】【明】"}
{"id": null, "n": "0384007", "target": "#nkr_note_mod_0384007", "type": "mod", "text": "哆【大】，多【明】"}
{"id": null, "n": "0383023", "target": "#nkr_note_orig_0383023", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0383024", "target": "#nkr_note_orig_0383024", "type": "orig", "text": "（宋）＋西【明】"}
{"id": null, "n": "0383025", "target": "#nkr_note_orig_0383025", "type": "orig", "text": "（奉詔）＋譯【三】"}
{"id": null, "n": "0383026", "target": "#nkr_note_orig_0383026", "type": "orig", "text": "反＝切【明】下同"}
{"id": null, "n": "0383027", "target": "#nkr_note_orig_0383027", "type": "orig", "text": "（一）＋句【三】"}
{"id": null, "n": "0383028", "target": "#nkr_note_orig_0383028", "type": "orig", "text": "〔無可反〕－【明】"}
{"id": null, "n": "0383029", "target": "#nkr_note_orig_0383029", "type": "orig", "text": "〔反〕－【三】"}
{"id": null, "n": "0383030", "target": "#nkr_note_orig_0383030", "type": "orig", "text": "嚨＝龍【宋】"}
{"id": null, "n": "0383031", "target": "#nkr_note_orig_0383031", "type": "orig", "text": "去＝上【三】"}
{"id": null, "n": "0383032", "target": "#nkr_note_orig_0383032", "type": "orig", "text": "合＝句【明】"}
{"id": null, "n": "0383033", "target": "#nkr_note_orig_0383033", "type": "orig", "text": "〔丁以反〕－【明】＊"}
{"id": null, "n": "0383034", "target": "#nkr_note_orig_0383034", "type": "orig", "text": "又＝叉【三】"}
{"id": null, "n": "0383035", "target": "#nkr_note_orig_0383035", "type": "orig", "text": "合＝句【宋】【元】"}
{"id": null, "n": "0383036", "target": "#nkr_note_orig_0383036", "type": "orig", "text": "〔羊主反〕－【明】"}
{"id": null, "n": "0383037", "target": "#nkr_note_orig_0383037", "type": "orig", "text": "〔仁拶反〕－【明】"}
{"id": null, "n": "0383038", "target": "#nkr_note_orig_0383038", "type": "orig", "text": "〔泥以反〕－【明】"}
{"id": null, "n": "0383039", "target": "#nkr_note_orig_0383039", "type": "orig", "text": "舌＋（呼）【三】＊"}
{"id": null, "n": "0384001", "target": "#nkr_note_orig_0384001", "type": "orig", "text": "地＝他【元】"}
{"id": null, "n": "0384002", "target": "#nkr_note_orig_0384002", "type": "orig", "text": "嚩＝縛【明】"}
{"id": null, "n": "0384003", "target": "#nkr_note_orig_0384003", "type": "orig", "text": "〔句〕－【三】"}
{"id": null, "n": "0384004", "target": "#nkr_note_orig_0384004", "type": "orig", "text": "〔去〕－【三】"}
{"id": null, "n": "0384005", "target": "#nkr_note_orig_0384005", "type": "orig", "text": "〔句〕－【明】＊"}
