{"id": null, "n": "0834006", "target": "#nkr_note_mod_0834006", "type": "mod", "text": "大唐【大】，〔－〕【明】"}
{"id": null, "n": "0834007", "target": "#nkr_note_mod_0834007", "type": "mod", "text": "乂【大】，又【宋】"}
{"id": null, "n": "0834008", "target": "#nkr_note_mod_0834008", "type": "mod", "text": "乎【大】，于【宋】【元】"}
{"id": null, "n": "0834009", "target": "#nkr_note_mod_0834009", "type": "mod", "text": "朕【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0834010", "target": "#nkr_note_mod_0834010", "type": "mod", "text": "道祕【大】，秘道【宋】【元】【明】"}
{"id": null, "n": "0834011", "target": "#nkr_note_mod_0834011", "type": "mod", "text": "側【大】，惻【宋】【元】【明】"}
{"id": null, "n": "0834012", "target": "#nkr_note_mod_0834012", "type": "mod", "text": "寔【大】，實【明】"}
{"id": null, "n": "0834013", "target": "#nkr_note_mod_0834013", "type": "mod", "text": "油【大】，紬【宋】【元】【明】"}
{"id": null, "n": "0834014", "target": "#nkr_note_mod_0834014", "type": "mod", "text": "缺【大】，缺缺【宋】"}
{"id": null, "n": "0834015", "target": "#nkr_note_mod_0834015", "type": "mod", "text": "于【大】，於【明】"}
{"id": null, "n": "0834016", "target": "#nkr_note_mod_0834016", "type": "mod", "text": "槿【大】，菫【宋】【元】【明】"}
{"id": null, "n": "0834017", "target": "#nkr_note_mod_0834017", "type": "mod", "text": "（開府…沙門）四十一字【大】，三藏沙門大廣智【宋】【元】，唐三藏沙門大廣智【明】"}
{"id": null, "n": "0834018", "target": "#nkr_note_mod_0834018", "type": "mod", "text": "奉詔【大】，〔－〕【宋】【明】"}
{"id": null, "n": "0834019", "target": "#nkr_note_mod_0834019", "type": "mod", "text": "力【大】，方【明】"}
{"id": null, "n": "0835001", "target": "#nkr_note_mod_0835001", "type": "mod", "text": "大【大】，天【明】"}
{"id": null, "n": "0835002", "target": "#nkr_note_mod_0835002", "type": "mod", "text": "（仁王…多經）十一字【大】＊，〔－〕【明】＊"}
{"id": null, "n": "0835003", "target": "#nkr_note_mod_0835003", "type": "mod", "text": "淨倒【大】，我淨【宋】【元】【明】"}
{"id": null, "n": "0836001", "target": "#nkr_note_mod_0836001", "type": "mod", "text": "不離三際【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0836002", "target": "#nkr_note_mod_0836002", "type": "mod", "text": "量【大】，量心【宋】【元】【明】"}
{"id": null, "n": "0836003", "target": "#nkr_note_mod_0836003", "type": "mod", "text": "難【大】，離【宋】"}
{"id": null, "n": "0837001", "target": "#nkr_note_mod_0837001", "type": "mod", "text": "本【大】，亦【明】"}
{"id": null, "n": "0837002", "target": "#nkr_note_mod_0837002", "type": "mod", "text": "王【大】，主【宋】【元】【明】"}
{"id": null, "n": "0837003", "target": "#nkr_note_mod_0837003", "type": "mod", "text": "原【大】＊，源【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0837004", "target": "#nkr_note_mod_0837004", "type": "mod", "text": "權【大】，摧【宋】"}
{"id": null, "n": "0837005", "target": "#nkr_note_mod_0837005", "type": "mod", "text": "而【大】，義【宋】【元】【明】"}
{"id": null, "n": "0837006", "target": "#nkr_note_mod_0837006", "type": "mod", "text": "下【大】，不【明】"}
{"id": null, "n": "0837007", "target": "#nkr_note_mod_0837007", "type": "mod", "text": "除【大】，際【宋】"}
{"id": null, "n": "0837008", "target": "#nkr_note_mod_0837008", "type": "mod", "text": "應【大】，廣【明】"}
{"id": null, "n": "0838001", "target": "#nkr_note_mod_0838001", "type": "mod", "text": "無化利【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0839001", "target": "#nkr_note_mod_0839001", "type": "mod", "text": "情【大】，性【宋】【元】【明】"}
{"id": null, "n": "0840001", "target": "#nkr_note_mod_0840001", "type": "mod", "text": "大【大】，太【宋】【元】【明】"}
{"id": null, "n": "0840002", "target": "#nkr_note_mod_0840002", "type": "mod", "text": "說【大】，讀【宋】【元】【明】"}
{"id": null, "n": "0840003", "target": "#nkr_note_mod_0840003", "type": "mod", "text": "主【大】，王【宋】【元】【明】"}
{"id": null, "n": "0840004", "target": "#nkr_note_mod_0840004", "type": "mod", "text": "明【大】，明王【宋】【元】【明】"}
{"id": null, "n": "0841001", "target": "#nkr_note_mod_0841001", "type": "mod", "text": "愍【大】，憫【宋】【元】【明】"}
{"id": null, "n": "0841002", "target": "#nkr_note_mod_0841002", "type": "mod", "text": "〔－〕【CB】【麗-CB】【宋】【元】【明】，諸【大】"}
{"id": null, "n": "0841003", "target": "#nkr_note_mod_0841003", "type": "mod", "text": "三阿【大】，於三阿【宋】【元】【明】"}
{"id": null, "n": "0841004", "target": "#nkr_note_mod_0841004", "type": "mod", "text": "直【大】，真【宋】【元】【明】"}
{"id": null, "n": "0841005", "target": "#nkr_note_mod_0841005", "type": "mod", "text": "滅【大】，減【宋】【元】"}
{"id": null, "n": "0843001", "target": "#nkr_note_mod_0843001", "type": "mod", "text": "界【大】，戒【明】"}
{"id": null, "n": "0843002", "target": "#nkr_note_mod_0843002", "type": "mod", "text": "土【大】，止【宋】"}
{"id": null, "n": "0843003", "target": "#nkr_note_mod_0843003", "type": "mod", "text": "香【大】，燈【宋】【元】【明】"}
{"id": null, "n": "0843004", "target": "#nkr_note_mod_0843004", "type": "mod", "text": "王【大】，主【宋】【元】【明】"}
{"id": null, "n": "0843005", "target": "#nkr_note_mod_0843005", "type": "mod", "text": "等【大】，我【宋】"}
{"id": null, "n": "0843006", "target": "#nkr_note_mod_0843006", "type": "mod", "text": "反【大】，切【明】"}
{"id": null, "n": "0843007", "target": "#nkr_note_mod_0843007", "type": "mod", "text": "夜【大】，夜阿【明】"}
{"id": null, "n": "0843008", "target": "#nkr_note_mod_0843008", "type": "mod", "text": "訶【大】，賀【？】"}
{"id": null, "n": "0843009", "target": "#nkr_note_mod_0843009", "type": "mod", "text": "二合【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0843010", "target": "#nkr_note_mod_0843010", "type": "mod", "text": "瑜【大】，喻【宋】【元】【明】"}
{"id": null, "n": "0843011", "target": "#nkr_note_mod_0843011", "type": "mod", "text": "澁【大】，濕【宋】【元】【明】"}
{"id": null, "n": "0843012", "target": "#nkr_note_mod_0843012", "type": "mod", "text": "三【大】，二【宋】【元】【明】"}
{"id": null, "n": "0844001", "target": "#nkr_note_mod_0844001", "type": "mod", "text": "毘引【大】，引毗【宋】【元】【明】"}
{"id": null, "n": "0844002", "target": "#nkr_note_mod_0844002", "type": "mod", "text": "慕【大】，暮【宋】【元】【明】"}
{"id": null, "n": "0844003", "target": "#nkr_note_mod_0844003", "type": "mod", "text": "二合【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0844004", "target": "#nkr_note_mod_0844004", "type": "mod", "text": "三【大】，二【宋】【元】【明】"}
{"id": null, "n": "0844005", "target": "#nkr_note_mod_0844005", "type": "mod", "text": "反【大】，切【明】"}
{"id": null, "n": "0844006", "target": "#nkr_note_mod_0844006", "type": "mod", "text": "上同【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0844007", "target": "#nkr_note_mod_0844007", "type": "mod", "text": "神鬼【大】，鬼神【宋】【元】【明】"}
{"id": null, "n": "0844008", "target": "#nkr_note_mod_0844008", "type": "mod", "text": "󰍑【大】，跛【宋】【元】【明】"}
{"id": null, "n": "0844009", "target": "#nkr_note_mod_0844009", "type": "mod", "text": "天人大【大】，人天【宋】【元】【明】"}
{"id": null, "n": "0844010", "target": "#nkr_note_mod_0844010", "type": "mod", "text": "如是【CB】【麗-CB】【宋】【元】【明】，如【大】"}
{"id": null, "n": "0844011", "target": "#nkr_note_mod_0844011", "type": "mod", "text": "吼【大】，月【宋】【元】【明】"}
