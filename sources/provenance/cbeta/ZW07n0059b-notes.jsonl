{"id": null, "n": "0061001", "target": "#nkr_note_orig_0061001", "type": "orig", "text": "底本在「金剛五禮」前有「已後是」三字，據甲本刪。"}
{"id": null, "n": "0061002", "target": "#nkr_note_orig_0061002", "type": "orig", "text": "「敬」，甲本作「滿敬」。"}
{"id": null, "n": "0061003", "target": "#nkr_note_orig_0061003", "type": "orig", "text": "「寂」，底本作「湛」，據甲本改。"}
{"id": null, "n": "0061004", "target": "#nkr_note_orig_0061004", "type": "orig", "text": "「坦」，甲本無。"}
{"id": null, "n": "0061005", "target": "#nkr_note_orig_0061005", "type": "orig", "text": "「矣」，甲本作「意」。"}
{"id": null, "n": "0061006", "target": "#nkr_note_orig_0061006", "type": "orig", "text": "「遵」，甲本作「尊」。"}
{"id": null, "n": "0061007", "target": "#nkr_note_orig_0061007", "type": "orig", "text": "「非色非心」，底本無，據甲本補。"}
{"id": null, "n": "0061008", "target": "#nkr_note_orig_0061008", "type": "orig", "text": "「光」，甲本作「廣」。"}
{"id": null, "n": "0061009", "target": "#nkr_note_orig_0061009", "type": "orig", "text": "「充」，甲本作「超」。"}
{"id": null, "n": "0061010", "target": "#nkr_note_orig_0061010", "type": "orig", "text": "「之」，甲本作「至」。"}
{"id": null, "n": "0061011", "target": "#nkr_note_orig_0061011", "type": "orig", "text": "「姓」，底本作「性」，甲本無，據伯3664號改。"}
{"id": null, "n": "0061012", "target": "#nkr_note_orig_0061012", "type": "orig", "text": "「釋迦氏」，甲本無。"}
{"id": null, "n": "0061013", "target": "#nkr_note_orig_0061013", "type": "orig", "text": "「曰」，甲本作「號」。"}
{"id": null, "n": "0061014", "target": "#nkr_note_orig_0061014", "type": "orig", "text": "「三十」，底本作「卅」，據甲本改。"}
{"id": null, "n": "0061015", "target": "#nkr_note_orig_0061015", "type": "orig", "text": "「釋」，甲本作「同名釋」。"}
{"id": null, "n": "0061016", "target": "#nkr_note_orig_0061016", "type": "orig", "text": "「甚深微妙，金剛般若」，甲本作「金剛般若，微妙甚深」。「甚」，底本作「深」，據文意改。"}
{"id": null, "n": "0062001", "target": "#nkr_note_orig_0062001", "type": "orig", "text": "「不可思議」，甲本無。「議」，底本作「儀」，據伯3664號改。"}
{"id": null, "n": "0062002", "target": "#nkr_note_orig_0062002", "type": "orig", "text": "「此」，甲本作「茲」。"}
{"id": null, "n": "0062003", "target": "#nkr_note_orig_0062003", "type": "orig", "text": "「寂」，底本作「息」，據甲本改。"}
{"id": null, "n": "0062004", "target": "#nkr_note_orig_0062004", "type": "orig", "text": "「般」，甲本作「金剛般」。"}
{"id": null, "n": "0062005", "target": "#nkr_note_orig_0062005", "type": "orig", "text": "「甚」，底本作「深」，據甲本改。"}
{"id": null, "n": "0062006", "target": "#nkr_note_orig_0062006", "type": "orig", "text": "「舍衛城南」，底本作「如來精舍」，據甲本改。"}
{"id": null, "n": "0062007", "target": "#nkr_note_orig_0062007", "type": "orig", "text": "「精舍」，底本作「說法」，據甲本改。"}
{"id": null, "n": "0062008", "target": "#nkr_note_orig_0062008", "type": "orig", "text": "「彼」，甲本作「此」。"}
{"id": null, "n": "0062009", "target": "#nkr_note_orig_0062009", "type": "orig", "text": "「伽藍」，甲本無。"}
{"id": null, "n": "0062010", "target": "#nkr_note_orig_0062010", "type": "orig", "text": "「斯」，底本作「思」，據甲本改。"}
{"id": null, "n": "0062011", "target": "#nkr_note_orig_0062011", "type": "orig", "text": "「恭」，底本作「共」，據甲本改。"}
{"id": null, "n": "0062012", "target": "#nkr_note_orig_0062012", "type": "orig", "text": "「追」，甲本作「憶」。"}
{"id": null, "n": "0062013", "target": "#nkr_note_orig_0062013", "type": "orig", "text": "「般」，甲本作「金剛般」。"}
{"id": null, "n": "0062014", "target": "#nkr_note_orig_0062014", "type": "orig", "text": "「甚」，底本作「深」，據甲本改。"}
{"id": null, "n": "0062015", "target": "#nkr_note_orig_0062015", "type": "orig", "text": "「藏」，甲本於此後有「竟」字。"}
