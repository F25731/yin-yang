{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "上去"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘如法華抄"}
{"id": null, "n": null, "target": null, "type": null, "text": "開元十三年十二月十一日於\n聖佛寺寫了此功德，讀者早悟於宗指，速得成佛也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "論一二處"}
{"id": null, "n": "0051001", "target": "#nkr_note_orig_0051001", "type": "orig", "text": "恬字原本不明"}
{"id": null, "n": "0051002", "target": "#nkr_note_orig_0051002", "type": "orig", "text": "釋字更勘"}
{"id": null, "n": "0051003", "target": "#nkr_note_orig_0051003", "type": "orig", "text": "加等七字更勘"}
{"id": null, "n": "0051004", "target": "#nkr_note_orig_0051004", "type": "orig", "text": "若字疑剩"}
{"id": null, "n": "0051005", "target": "#nkr_note_orig_0051005", "type": "orig", "text": "之疑二"}
{"id": null, "n": "0051006", "target": "#nkr_note_orig_0051006", "type": "orig", "text": "及疑反"}
{"id": null, "n": "0051007", "target": "#nkr_note_orig_0051007", "type": "orig", "text": "欲疑次"}
{"id": null, "n": "0052001", "target": "#nkr_note_orig_0052001", "type": "orig", "text": "或字更勘"}
{"id": null, "n": "0052002", "target": "#nkr_note_orig_0052002", "type": "orig", "text": "本文無至字"}
{"id": null, "n": "0053001", "target": "#nkr_note_orig_0053001", "type": "orig", "text": "有字更勘"}
{"id": null, "n": "0053002", "target": "#nkr_note_orig_0053002", "type": "orig", "text": "故故二字更勘"}
{"id": null, "n": "0053003", "target": "#nkr_note_orig_0053003", "type": "orig", "text": "典疑曲"}
{"id": null, "n": "0053004", "target": "#nkr_note_orig_0053004", "type": "orig", "text": "下疑上"}
{"id": null, "n": "0053005", "target": "#nkr_note_orig_0053005", "type": "orig", "text": "中超疑超中"}
{"id": null, "n": "0053006", "target": "#nkr_note_orig_0053006", "type": "orig", "text": "合疑各"}
{"id": null, "n": "0054001", "target": "#nkr_note_orig_0054001", "type": "orig", "text": "來字更勘"}
{"id": null, "n": "0055001", "target": "#nkr_note_orig_0055001", "type": "orig", "text": "剎那二字疑衍"}
{"id": null, "n": "0055002", "target": "#nkr_note_orig_0055002", "type": "orig", "text": "為字疑衍"}
{"id": null, "n": "0055003", "target": "#nkr_note_orig_0055003", "type": "orig", "text": "然疑煞"}
{"id": null, "n": "0055004", "target": "#nkr_note_orig_0055004", "type": "orig", "text": "何字疑剩"}
{"id": null, "n": "0055005", "target": "#nkr_note_orig_0055005", "type": "orig", "text": "一無語字"}
{"id": null, "n": "0055006", "target": "#nkr_note_orig_0055006", "type": "orig", "text": "極字疑剩"}
{"id": null, "n": "0056001", "target": "#nkr_note_orig_0056001", "type": "orig", "text": "既疑兔"}
{"id": null, "n": "0056002", "target": "#nkr_note_orig_0056002", "type": "orig", "text": "山疑小"}
{"id": null, "n": "0056003", "target": "#nkr_note_orig_0056003", "type": "orig", "text": "問疑門"}
{"id": null, "n": "0056004", "target": "#nkr_note_orig_0056004", "type": "orig", "text": "門字更勘"}
{"id": null, "n": "0057001", "target": "#nkr_note_orig_0057001", "type": "orig", "text": "異疑易"}
