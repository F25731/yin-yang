{"id": null, "n": null, "target": null, "type": null, "text": "出廣濟眾生經第四卷中"}
{"id": null, "n": null, "target": null, "type": null, "text": "七"}
{"id": null, "n": null, "target": null, "type": null, "text": "六"}
{"id": null, "n": "0884012", "target": "#nkr_note_mod_0884012", "type": "mod", "text": "經【大】，經出廣濟眾生經第四卷中【元】"}
{"id": null, "n": null, "target": null, "type": null, "text": "出廣濟眾生經第四卷中"}
{"id": null, "n": "0884013", "target": "#nkr_note_mod_0884013", "type": "mod", "text": "失【大】，舊失【元】【明】"}
{"id": null, "n": "0884014", "target": "#nkr_note_mod_0884014", "type": "mod", "text": "人名今附梁錄【大】，〔－〕【宋】，師名開元附梁錄【元】【明】"}
{"id": null, "n": "0884015", "target": "#nkr_note_mod_0884015", "type": "mod", "text": "茶【大】＊，荼【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0885001", "target": "#nkr_note_mod_0885001", "type": "mod", "text": "仇【大】，仇諸怨【宋】【元】【明】"}
{"id": null, "n": "0885002", "target": "#nkr_note_mod_0885002", "type": "mod", "text": "魔【大】，摩【明】"}
{"id": null, "n": "0885003", "target": "#nkr_note_mod_0885003", "type": "mod", "text": "未【大】，末【宋】【元】【明】"}
{"id": null, "n": "0885004", "target": "#nkr_note_mod_0885004", "type": "mod", "text": "哹【大】，呼【宋】【元】【明】"}
{"id": null, "n": "0885005", "target": "#nkr_note_mod_0885005", "type": "mod", "text": "七【大】，〔－〕【宋】"}
{"id": null, "n": "0885006", "target": "#nkr_note_mod_0885006", "type": "mod", "text": "置【大】，置毘【元】【明】"}
{"id": null, "n": "0885007", "target": "#nkr_note_mod_0885007", "type": "mod", "text": "毘【大】，置毘【元】【明】"}
{"id": null, "n": "0885008", "target": "#nkr_note_mod_0885008", "type": "mod", "text": "六【大】，〔－〕【宋】"}
{"id": null, "n": "0885009", "target": "#nkr_note_mod_0885009", "type": "mod", "text": "坐【大】，〔－〕【宋】"}
{"id": null, "n": "0885010", "target": "#nkr_note_mod_0885010", "type": "mod", "text": "外【大】，外呪【宋】【元】【明】"}
{"id": null, "n": "0885011", "target": "#nkr_note_mod_0885011", "type": "mod", "text": "慕【大】，暮【宋】【元】【明】"}
{"id": null, "n": "0885012", "target": "#nkr_note_mod_0885012", "type": "mod", "text": "吒【大】，咤【宋】【元】【明】"}
{"id": null, "n": "0884011", "target": "#nkr_note_orig_0884011", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0884012", "target": "#nkr_note_orig_0884012", "type": "orig", "text": "經＋（出廣濟眾生經第四卷中）夾註【元】"}
{"id": null, "n": "0884013", "target": "#nkr_note_orig_0884013", "type": "orig", "text": "（舊）＋失【元】【明】"}
{"id": null, "n": "0884014", "target": "#nkr_note_orig_0884014", "type": "orig", "text": "〔人名今附梁錄〕－【宋】，人名今＝師名開元【元】【明】"}
{"id": null, "n": "0884015", "target": "#nkr_note_orig_0884015", "type": "orig", "text": "茶＝荼【三】＊"}
{"id": null, "n": "0885001", "target": "#nkr_note_orig_0885001", "type": "orig", "text": "仇＋（諸怨）【三】"}
{"id": null, "n": "0885002", "target": "#nkr_note_orig_0885002", "type": "orig", "text": "魔＝摩【明】"}
{"id": null, "n": "0885003", "target": "#nkr_note_orig_0885003", "type": "orig", "text": "未＝末【三】"}
{"id": null, "n": "0885004", "target": "#nkr_note_orig_0885004", "type": "orig", "text": "哹＝呼【三】"}
{"id": null, "n": "0885005", "target": "#nkr_note_orig_0885005", "type": "orig", "text": "〔七〕－【宋】"}
{"id": null, "n": "0885006", "target": "#nkr_note_orig_0885006", "type": "orig", "text": "置＋（毘）【元】【明】"}
{"id": null, "n": "0885007", "target": "#nkr_note_orig_0885007", "type": "orig", "text": "（置）＋毘【元】【明】"}
{"id": null, "n": "0885008", "target": "#nkr_note_orig_0885008", "type": "orig", "text": "〔六〕－【宋】"}
{"id": null, "n": "0885009", "target": "#nkr_note_orig_0885009", "type": "orig", "text": "〔坐〕－【宋】"}
{"id": null, "n": "0885010", "target": "#nkr_note_orig_0885010", "type": "orig", "text": "外＋（呪）【三】"}
{"id": null, "n": "0885011", "target": "#nkr_note_orig_0885011", "type": "orig", "text": "慕＝暮【三】"}
