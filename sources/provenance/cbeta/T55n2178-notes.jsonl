{"id": null, "n": null, "target": null, "type": null, "text": "按一本亦亡名"}
{"id": null, "n": null, "target": null, "type": null, "text": "按教觀云智者說"}
{"id": null, "n": null, "target": null, "type": null, "text": "按東域亦亡名教觀統紀並云始終心要一卷荊谿述恐是"}
{"id": null, "n": null, "target": null, "type": null, "text": "按東域亦亡名珍錄云妙樂撰二卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "按一本亦亡名有錄云韋虛舟"}
{"id": null, "n": null, "target": null, "type": null, "text": "按一本亦亡名"}
{"id": null, "n": null, "target": null, "type": null, "text": "按珍錄云依丹丘疏彼亦亡名"}
{"id": null, "n": null, "target": null, "type": null, "text": "按東域云杜順出澄珍二錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "按東域云行滿"}
{"id": null, "n": null, "target": null, "type": null, "text": "按東域云大乘義章三卷亦云大乘大義章羅什造"}
{"id": null, "n": null, "target": null, "type": null, "text": "按一本亦亡名"}
{"id": null, "n": null, "target": null, "type": null, "text": "按一本亦亡名"}
{"id": null, "n": null, "target": null, "type": null, "text": "按澄錄東域並亡名"}
{"id": null, "n": null, "target": null, "type": null, "text": "按澄錄亦亡名"}
{"id": null, "n": "1135005", "target": "#nkr_note_mod_1135005", "type": "mod", "text": "卷【大】，卷按一本亦亡名【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "按一本亦亡名"}
{"id": null, "n": "1135006", "target": "#nkr_note_mod_1135006", "type": "mod", "text": "說【大】，說按亦名別行玄義【甲】"}
{"id": null, "n": "1135007", "target": "#nkr_note_mod_1135007", "type": "mod", "text": "說【大】，說按亦名別行義疏【甲】"}
{"id": null, "n": "1135008", "target": "#nkr_note_mod_1135008", "type": "mod", "text": "述【大】，述按教觀統紀並不出東域云明曠【甲】"}
{"id": null, "n": "1135009", "target": "#nkr_note_mod_1135009", "type": "mod", "text": "述【大】，述按教觀統紀並不出東域云亦云大綱灌頂撰【甲】"}
{"id": null, "n": "1135010", "target": "#nkr_note_mod_1135010", "type": "mod", "text": "述【大】，述按出珍錄【甲】"}
{"id": null, "n": "1135011", "target": "#nkr_note_mod_1135011", "type": "mod", "text": "說【大】，說按教觀統紀並云法華三昧儀【甲】"}
{"id": null, "n": "1135012", "target": "#nkr_note_mod_1135012", "type": "mod", "text": "述【大】，述按亦云義讚亦云東春定林謂智度師【甲】"}
{"id": null, "n": "1135013", "target": "#nkr_note_mod_1135013", "type": "mod", "text": "述【大】，述按東域同此教觀統紀並不出【甲】"}
{"id": null, "n": "1135014", "target": "#nkr_note_mod_1135014", "type": "mod", "text": "述【大】，述按謂道邃統紀珍錄云湛然【甲】"}
{"id": null, "n": "1135015", "target": "#nkr_note_mod_1135015", "type": "mod", "text": "卷【大】，卷按教觀云智者說【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "按教觀云智者說"}
{"id": null, "n": "1135016", "target": "#nkr_note_mod_1135016", "type": "mod", "text": "說【大】，說按雙出上二部東域亦同教觀隨函統紀並唯出摩訶止觀【甲】"}
{"id": null, "n": "1135017", "target": "#nkr_note_mod_1135017", "type": "mod", "text": "卷【大】，卷按東域亦亡名教觀統紀並云始終心要一卷荊谿述恐是【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "按東域亦亡名教觀統紀並云始終心要一卷荊谿述恐是"}
{"id": null, "n": "1135018", "target": "#nkr_note_mod_1135018", "type": "mod", "text": "述【大】，述按東域同此教觀統紀並云灌頂【甲】"}
{"id": null, "n": "1135019", "target": "#nkr_note_mod_1135019", "type": "mod", "text": "卷【大】，卷按東域亦亡名珍錄云妙樂撰二卷【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "按東域亦亡名珍錄云妙樂撰二卷"}
{"id": null, "n": "1135020", "target": "#nkr_note_mod_1135020", "type": "mod", "text": "說【大】，說按統紀云禪波羅蜜十卷名漸次止觀【甲】"}
{"id": null, "n": "1136001", "target": "#nkr_note_mod_1136001", "type": "mod", "text": "說【大】，說按統紀云名不定止觀【甲】"}
{"id": null, "n": "1136002", "target": "#nkr_note_mod_1136002", "type": "mod", "text": "說【大】，說按教觀隨函統紀東域等不出恐餘師撰【甲】"}
{"id": null, "n": "1136003", "target": "#nkr_note_mod_1136003", "type": "mod", "text": "說【大】，說按教觀統紀並云禪門口決【甲】"}
{"id": null, "n": "1136004", "target": "#nkr_note_mod_1136004", "type": "mod", "text": "述【大】，述按出珍錄教觀統紀並不出【甲】"}
{"id": null, "n": "1136005", "target": "#nkr_note_mod_1136005", "type": "mod", "text": "述【大】，述按出仁錄教觀統紀並不出【甲】"}
{"id": null, "n": "1136006", "target": "#nkr_note_mod_1136006", "type": "mod", "text": "述【大】，述按教觀隨函統紀並云廣疏記【甲】"}
{"id": null, "n": "1136007", "target": "#nkr_note_mod_1136007", "type": "mod", "text": "說【大】，說按統紀云維摩玄疏離出文【甲】"}
{"id": null, "n": "1136008", "target": "#nkr_note_mod_1136008", "type": "mod", "text": "說【大】，說按教觀隨函東域同此統紀云荊谿恐誤【甲】"}
{"id": null, "n": "1136009", "target": "#nkr_note_mod_1136009", "type": "mod", "text": "卷【大】，卷按一本亦亡名有錄云韋虛舟【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "按一本亦亡名有錄云韋虛舟"}
{"id": null, "n": "1136010", "target": "#nkr_note_mod_1136010", "type": "mod", "text": "卷【大】，卷按一本亦亡名【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "按一本亦亡名"}
{"id": null, "n": "1136011", "target": "#nkr_note_mod_1136011", "type": "mod", "text": "述【大】，述按雙出上二部珍錄東域並同教觀統紀隨函唯出灌頂疏【甲】"}
{"id": null, "n": "1136012", "target": "#nkr_note_mod_1136012", "type": "mod", "text": "述【大】，述按東域無百字【甲】"}
{"id": null, "n": "1136013", "target": "#nkr_note_mod_1136013", "type": "mod", "text": "述【大】，述按教觀統紀並云二卷【甲】"}
{"id": null, "n": "1136014", "target": "#nkr_note_mod_1136014", "type": "mod", "text": "卷【大】，卷按珍錄云依丹丘疏彼亦亡名【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "按珍錄云依丹丘疏彼亦亡名"}
{"id": null, "n": "1136015", "target": "#nkr_note_mod_1136015", "type": "mod", "text": "述【大】，述按珍錄東域同此教觀統紀云涅槃後分疏一卷恐是【甲】"}
{"id": null, "n": "1136016", "target": "#nkr_note_mod_1136016", "type": "mod", "text": "說【大】，說按此恐誤也教觀隨函統紀珍錄東域五錄唯出文句玄義部可為證也然倫法師云光明疏四卷遵式法師云別行疏四卷合文句三卷玄義一卷言耳【甲】"}
{"id": null, "n": "1136017", "target": "#nkr_note_mod_1136017", "type": "mod", "text": "卷【大】，卷按東域云杜順出澄珍二錄【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "按東域云杜順出澄珍二錄"}
{"id": null, "n": "1136018", "target": "#nkr_note_mod_1136018", "type": "mod", "text": "說【大】，說按教觀統紀並云菩薩戒疏【甲】"}
{"id": null, "n": "1136019", "target": "#nkr_note_mod_1136019", "type": "mod", "text": "說【大】，說按教觀云小彌陀義記【甲】"}
{"id": null, "n": "1136020", "target": "#nkr_note_mod_1136020", "type": "mod", "text": "述【大】，述按東域云天台又教觀統紀並云淨土十疑論一卷天台今云湛然恐誤【甲】"}
{"id": null, "n": "1136021", "target": "#nkr_note_mod_1136021", "type": "mod", "text": "述【大】，述按此恐誤也教觀智者撰述下仁王般若疏二卷今在日本國統紀東域並云智者說一本無撰名思之【甲】"}
{"id": null, "n": "1136022", "target": "#nkr_note_mod_1136022", "type": "mod", "text": "述【大】，述按東域同此教觀統紀並不出【甲】"}
{"id": null, "n": "1136023", "target": "#nkr_note_mod_1136023", "type": "mod", "text": "述【大】，述按此恐誤也東域云合疏私記可為四卷如合光明玄義并文句云疏四卷一本無撰名思之【甲】"}
{"id": null, "n": "1136024", "target": "#nkr_note_mod_1136024", "type": "mod", "text": "說【大】，說按教觀統紀覺作學【甲】"}
{"id": null, "n": "1136025", "target": "#nkr_note_mod_1136025", "type": "mod", "text": "說【大】，說教觀統紀同此仁珍二錄並云灌頂【甲】"}
{"id": null, "n": "1137001", "target": "#nkr_note_mod_1137001", "type": "mod", "text": "述【大】，述按出仁錄但亡名【甲】"}
{"id": null, "n": "1137002", "target": "#nkr_note_mod_1137002", "type": "mod", "text": "述【大】，述按東域同此教觀統紀並不出【甲】"}
{"id": null, "n": "1137003", "target": "#nkr_note_mod_1137003", "type": "mod", "text": "述【大】，述按亦云大勇金剛慈覺大師登壇散華之號【甲】"}
{"id": null, "n": "1137004", "target": "#nkr_note_mod_1137004", "type": "mod", "text": "卷【大】，卷按東域云元康【甲】"}
{"id": null, "n": "1137005", "target": "#nkr_note_mod_1137005", "type": "mod", "text": "述【大】，述按東域記字作鈔註云釋上宮疏惟楊法雲寺僧明空撰唐土人師釋倭州疏現本糅為六卷【甲】"}
{"id": null, "n": "1137006", "target": "#nkr_note_mod_1137006", "type": "mod", "text": "卷【大】，卷按東域云行滿【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "按東域云行滿"}
{"id": null, "n": "1137007", "target": "#nkr_note_mod_1137007", "type": "mod", "text": "述【大】，述按東域云大乘菩薩入道三種觀【甲】"}
{"id": null, "n": "1137008", "target": "#nkr_note_mod_1137008", "type": "mod", "text": "卷【大】，卷按東域云大乘義章三卷亦云大乘大義章羅什造【甲】"}
