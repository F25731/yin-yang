{"id": null, "n": "0462a1701", "target": "#nkr_note_add_0462a1701", "type": "add", "text": "竟【CB】，意【卍續】"}
{"id": null, "n": "0462b0501", "target": "#nkr_note_add_0462b0501", "type": "add", "text": "已【CB】，巳【卍續】"}
{"id": null, "n": "0463a2101", "target": "#nkr_note_add_0463a2101", "type": "add", "text": "刺【CB】，剌【卍續】"}
