{"id": null, "n": null, "target": null, "type": null, "text": "大訢"}
{"id": null, "n": null, "target": null, "type": null, "text": "最初一著，覿面相呈，又云甚處去也"}
{"id": null, "n": null, "target": null, "type": null, "text": "元來只在者裏"}
{"id": null, "n": null, "target": null, "type": null, "text": "且\n信一半"}
{"id": null, "n": null, "target": null, "type": null, "text": "依稀越國"}
{"id": null, "n": null, "target": null, "type": null, "text": "彷彿揚州"}
{"id": null, "n": null, "target": null, "type": null, "text": "喚作一物即不\n中"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛之一字，吾不喜聞"}
{"id": null, "n": null, "target": null, "type": null, "text": "平地起土堆"}
{"id": null, "n": null, "target": null, "type": null, "text": "虗空裏\n揣骨"}
{"id": null, "n": null, "target": null, "type": null, "text": "虗空喫鐵棒"}
{"id": null, "n": null, "target": null, "type": null, "text": "王宮生悉陀"}
{"id": null, "n": null, "target": null, "type": null, "text": "甚處得消息來"}
{"id": null, "n": null, "target": null, "type": null, "text": "著甚\n死急"}
{"id": null, "n": null, "target": null, "type": null, "text": "林深藏猛虎，艸淺露羣蛇"}
{"id": null, "n": null, "target": null, "type": null, "text": "猶是鈍漢"}
{"id": null, "n": null, "target": null, "type": null, "text": "誰為安名"}
{"id": null, "n": null, "target": null, "type": null, "text": "可知禮也，又云為蛇畵足"}
{"id": null, "n": null, "target": null, "type": null, "text": "又有這箇在"}
{"id": null, "n": null, "target": null, "type": null, "text": "猶較些子"}
{"id": null, "n": null, "target": null, "type": null, "text": "風吹不入"}
{"id": null, "n": null, "target": null, "type": null, "text": "雨打不溼"}
{"id": null, "n": null, "target": null, "type": null, "text": "天晴依舊日頭出"}
{"id": null, "n": null, "target": null, "type": null, "text": "平地起\n干戈"}
{"id": null, "n": null, "target": null, "type": null, "text": "試舉似看"}
{"id": null, "n": null, "target": null, "type": null, "text": "空中掣\n閃電"}
{"id": null, "n": null, "target": null, "type": null, "text": "古路鐵蛇橫"}
{"id": null, "n": null, "target": null, "type": null, "text": "將逐\n符行"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈主丈便打"}
{"id": null, "n": null, "target": null, "type": null, "text": "再犯不容"}
{"id": null, "n": null, "target": null, "type": null, "text": "休揑怪"}
{"id": null, "n": null, "target": null, "type": null, "text": "總是錯"}
{"id": null, "n": null, "target": null, "type": null, "text": "五色麒麟一隻角"}
{"id": null, "n": null, "target": null, "type": null, "text": "爺死哭麼"}
{"id": null, "n": null, "target": null, "type": null, "text": "白日青天星斗落"}
{"id": null, "n": null, "target": null, "type": null, "text": "炎天飛片雪"}
{"id": null, "n": null, "target": null, "type": null, "text": "鼻直眼橫"}
{"id": null, "n": null, "target": null, "type": null, "text": "用肯作麼"}
{"id": null, "n": null, "target": null, "type": null, "text": "直得分疎不下"}
{"id": null, "n": null, "target": null, "type": null, "text": "一舉四十九"}
{"id": null, "n": null, "target": null, "type": null, "text": "蹉過了也"}
{"id": null, "n": null, "target": null, "type": null, "text": "元來只在者裏"}
{"id": null, "n": null, "target": null, "type": null, "text": "銀山只\n是銀山"}
{"id": null, "n": null, "target": null, "type": null, "text": "鐵壁只是鐵壁"}
{"id": null, "n": null, "target": null, "type": null, "text": "東家點燈"}
{"id": null, "n": null, "target": null, "type": null, "text": "西家暗坐"}
{"id": null, "n": null, "target": null, "type": null, "text": "人平不語，水平不流"}
{"id": null, "n": null, "target": null, "type": null, "text": "切忌\n動著"}
{"id": null, "n": null, "target": null, "type": null, "text": "弄光影漢"}
{"id": null, "n": null, "target": null, "type": null, "text": "眼上兩眉橫"}
{"id": null, "n": null, "target": null, "type": null, "text": "脚底通霄路"}
{"id": null, "n": null, "target": null, "type": null, "text": "且道路頭在什麼處"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲居尊者"}
{"id": null, "n": null, "target": null, "type": null, "text": "方有少分相應"}
{"id": null, "n": null, "target": null, "type": null, "text": "主人翁"}
{"id": null, "n": null, "target": null, "type": null, "text": "惺惺著"}
{"id": null, "n": null, "target": null, "type": null, "text": "他時異日莫被人瞞"}
{"id": null, "n": null, "target": null, "type": null, "text": "左眼半斤"}
{"id": null, "n": null, "target": null, "type": null, "text": "右眼八兩"}
{"id": null, "n": null, "target": null, "type": null, "text": "重言不當吃"}
{"id": null, "n": null, "target": null, "type": null, "text": "若有盡又堪作什麼"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿\n誰無者一坐具地"}
{"id": null, "n": null, "target": null, "type": null, "text": "正中偏"}
{"id": null, "n": null, "target": null, "type": null, "text": "偏中正"}
{"id": null, "n": null, "target": null, "type": null, "text": "本不增一\n絲毫"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦不減一絲毫"}
{"id": null, "n": null, "target": null, "type": null, "text": "修證即不無"}
{"id": null, "n": null, "target": null, "type": null, "text": "染汙即不\n得"}
{"id": null, "n": null, "target": null, "type": null, "text": "泥人喫鐵棒"}
{"id": null, "n": null, "target": null, "type": null, "text": "魚目混明珠"}
{"id": null, "n": null, "target": null, "type": null, "text": "誣人之罪，以罪罪之"}
{"id": null, "n": null, "target": null, "type": null, "text": "早自落他圈圚了也"}
{"id": null, "n": null, "target": null, "type": null, "text": "救得一半"}
{"id": null, "n": null, "target": null, "type": null, "text": "金不博金"}
{"id": null, "n": null, "target": null, "type": null, "text": "水不洗水"}
{"id": null, "n": null, "target": null, "type": null, "text": "上大人丘乙己"}
{"id": null, "n": null, "target": null, "type": null, "text": "重疊關山\n路"}
{"id": null, "n": null, "target": null, "type": null, "text": "一箭中青霄"}
{"id": null, "n": null, "target": null, "type": null, "text": "虗空開大口"}
{"id": null, "n": null, "target": null, "type": null, "text": "萬竅翻一舌"}
{"id": null, "n": null, "target": null, "type": null, "text": "紅爐焰上飛片雪"}
{"id": null, "n": null, "target": null, "type": null, "text": "非\n其境界"}
{"id": null, "n": null, "target": null, "type": null, "text": "猶帶識在"}
{"id": null, "n": null, "target": null, "type": null, "text": "亂走作麼"}
{"id": null, "n": null, "target": null, "type": null, "text": "還我艸鞋錢來"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿誰欠少"}
{"id": null, "n": null, "target": null, "type": null, "text": "試拈將來\n看"}
{"id": null, "n": null, "target": null, "type": null, "text": "不許夜行，投明須到"}
{"id": null, "n": null, "target": null, "type": null, "text": "也是徐六擔板"}
{"id": null, "n": null, "target": null, "type": null, "text": "又隔\n一重關"}
{"id": null, "n": null, "target": null, "type": null, "text": "癩兒牽伴"}
{"id": null, "n": null, "target": null, "type": null, "text": "擘破卻團圓，又云劒去久矣"}
{"id": null, "n": null, "target": null, "type": null, "text": "一不成隻"}
{"id": null, "n": null, "target": null, "type": null, "text": "二不成雙"}
{"id": null, "n": null, "target": null, "type": null, "text": "二由一有，一亦莫守"}
{"id": null, "n": null, "target": null, "type": null, "text": "既是\n無生，又作麼生了"}
{"id": null, "n": null, "target": null, "type": null, "text": "有智無智，較\n三十里"}
{"id": null, "n": null, "target": null, "type": null, "text": "魚行水濁"}
{"id": null, "n": null, "target": null, "type": null, "text": "鳥飛毛落"}
{"id": null, "n": null, "target": null, "type": null, "text": "天地一指，萬物一馬"}
{"id": null, "n": null, "target": null, "type": null, "text": "百鳥\n不銜花"}
{"id": null, "n": null, "target": null, "type": null, "text": "沒可把，又云今古歷然"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲開月皎"}
{"id": null, "n": null, "target": null, "type": null, "text": "虎嘯生風"}
{"id": null, "n": null, "target": null, "type": null, "text": "梁寶元來是誌公"}
{"id": null, "n": null, "target": null, "type": null, "text": "寰中天\n子敕"}
{"id": null, "n": null, "target": null, "type": null, "text": "塞外將軍令"}
{"id": null, "n": null, "target": null, "type": null, "text": "人貧\n智短"}
{"id": null, "n": null, "target": null, "type": null, "text": "馬瘦毛長"}
{"id": null, "n": null, "target": null, "type": null, "text": "夜行莫\n踏白，不是水便是石"}
{"id": null, "n": null, "target": null, "type": null, "text": "彈指云：從\n這裏入"}
{"id": null, "n": null, "target": null, "type": null, "text": "且喜到家"}
{"id": null, "n": null, "target": null, "type": null, "text": "車不橫行"}
{"id": null, "n": null, "target": null, "type": null, "text": "理無曲斷"}
{"id": null, "n": null, "target": null, "type": null, "text": "眼觀東南，意在西北"}
{"id": null, "n": null, "target": null, "type": null, "text": "相逢\n不拈出，舉意便知有"}
{"id": null, "n": null, "target": null, "type": null, "text": "是我家裏\n人，方說家裏話"}
{"id": null, "n": null, "target": null, "type": null, "text": "井底蝦蟆跳"}
{"id": null, "n": null, "target": null, "type": null, "text": "鵓鳩樹上啼"}
{"id": null, "n": null, "target": null, "type": null, "text": "作賊人心虗"}
{"id": null, "n": null, "target": null, "type": null, "text": "不勞懸\n古鏡"}
{"id": null, "n": null, "target": null, "type": null, "text": "天曉自分明"}
{"id": null, "n": null, "target": null, "type": null, "text": "黑似漆"}
{"id": null, "n": null, "target": null, "type": null, "text": "明如日"}
{"id": null, "n": null, "target": null, "type": null, "text": "上下四維無等匹"}
{"id": null, "n": null, "target": null, "type": null, "text": "達磨十萬里西來，卻對梁王道不識"}
{"id": null, "n": null, "target": null, "type": null, "text": "湘之南"}
{"id": null, "n": null, "target": null, "type": null, "text": "潭之北"}
{"id": null, "n": null, "target": null, "type": null, "text": "中有黃金充一國"}
{"id": null, "n": null, "target": null, "type": null, "text": "無影樹下合同船，琉璃殿上無知識"}
{"id": null, "n": null, "target": null, "type": null, "text": "靈光洞耀。"}
{"id": null, "n": null, "target": null, "type": null, "text": "迥脫根塵。"}
{"id": null, "n": null, "target": null, "type": null, "text": "體露真常，不拘文字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "心性\n無染，本自圓成。"}
{"id": null, "n": null, "target": null, "type": null, "text": "但離妄緣，即如\n如佛。"}
{"id": null, "n": null, "target": null, "type": null, "text": "不可放過"}
{"id": null, "n": null, "target": null, "type": null, "text": "放過不可"}
{"id": null, "n": null, "target": null, "type": null, "text": "打殺有甚麼罪過"}
{"id": null, "n": null, "target": null, "type": null, "text": "打著南\n邊動北邊"}
{"id": null, "n": null, "target": null, "type": null, "text": "看脚下"}
{"id": null, "n": null, "target": null, "type": null, "text": "海底摸鍼"}
{"id": null, "n": null, "target": null, "type": null, "text": "空中索縫"}
{"id": null, "n": null, "target": null, "type": null, "text": "差之毫釐，失之千里"}
{"id": null, "n": null, "target": null, "type": null, "text": "病眼\n見空花"}
{"id": null, "n": null, "target": null, "type": null, "text": "空花結空菓"}
{"id": null, "n": null, "target": null, "type": null, "text": "家鬼入來"}
{"id": null, "n": null, "target": null, "type": null, "text": "著賊了也"}
{"id": null, "n": null, "target": null, "type": null, "text": "春風滿地成狼藉"}
{"id": null, "n": null, "target": null, "type": null, "text": "了了了\n時無可了"}
{"id": null, "n": null, "target": null, "type": null, "text": "玄玄玄處亦須呵"}
{"id": null, "n": null, "target": null, "type": null, "text": "露"}
{"id": null, "n": null, "target": null, "type": null, "text": "險"}
{"id": null, "n": null, "target": null, "type": null, "text": "交"}
{"id": null, "n": null, "target": null, "type": null, "text": "破也，破也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "墮也，墮也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上來所供，竝皆詣實。"}
{"id": null, "n": null, "target": null, "type": null, "text": "兩頭俱坐斷，一劒倚天寒"}
{"id": null, "n": null, "target": null, "type": null, "text": "心不負人，面無慚色"}
{"id": null, "n": null, "target": null, "type": null, "text": "壺中別有天"}
{"id": null, "n": null, "target": null, "type": null, "text": "劒去久矣，汝方刻\n舟"}
{"id": null, "n": null, "target": null, "type": null, "text": "晝見日"}
{"id": null, "n": null, "target": null, "type": null, "text": "夜見星"}
{"id": null, "n": null, "target": null, "type": null, "text": "人平不語，水平不流。又云切"}
{"id": null, "n": null, "target": null, "type": null, "text": "上是天"}
{"id": null, "n": null, "target": null, "type": null, "text": "下是地"}
{"id": null, "n": null, "target": null, "type": null, "text": "天傾西北，地陷東南"}
{"id": null, "n": null, "target": null, "type": null, "text": "日高樹影\n重"}
{"id": null, "n": null, "target": null, "type": null, "text": "雨落地下溼"}
{"id": null, "n": null, "target": null, "type": null, "text": "識得不為冤"}
{"id": null, "n": null, "target": null, "type": null, "text": "賊是小人，智過\n君子"}
{"id": null, "n": null, "target": null, "type": null, "text": "不風流處也風流"}
{"id": null, "n": null, "target": null, "type": null, "text": "要識一貫，兩个五佰"}
{"id": null, "n": null, "target": null, "type": null, "text": "咄！"}
{"id": null, "n": null, "target": null, "type": null, "text": "好肉剜瘡"}
{"id": null, "n": null, "target": null, "type": null, "text": "敲骨取髓"}
{"id": null, "n": null, "target": null, "type": null, "text": "且道是个什麼"}
{"id": null, "n": null, "target": null, "type": null, "text": "謝三郎不\n識四字，罪頭元來是你"}
{"id": null, "n": null, "target": null, "type": null, "text": "相隨來\n也，又云遞相鈍置"}
{"id": null, "n": null, "target": null, "type": null, "text": "禍胎生也"}
{"id": null, "n": null, "target": null, "type": null, "text": "猛虎當路"}
{"id": null, "n": null, "target": null, "type": null, "text": "珊瑚枝上走玉兔"}
{"id": null, "n": null, "target": null, "type": null, "text": "聞名不\n如見面"}
{"id": null, "n": null, "target": null, "type": null, "text": "甜瓜徹蔕甜，苦瓠連根苦"}
{"id": null, "n": null, "target": null, "type": null, "text": "天晴日頭出"}
{"id": null, "n": null, "target": null, "type": null, "text": "日高花影重"}
{"id": null, "n": null, "target": null, "type": null, "text": "頂門隻眼亞雙瞳"}
{"id": null, "n": null, "target": null, "type": null, "text": "虗\n空放出遼天鶴"}
{"id": null, "n": null, "target": null, "type": null, "text": "閩蜀同風"}
{"id": null, "n": null, "target": null, "type": null, "text": "一翳在眼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "空華亂墜。"}
{"id": null, "n": null, "target": null, "type": null, "text": "打破鏡來，卻許相見。"}
{"id": null, "n": null, "target": null, "type": null, "text": "一心\n不生，萬法俱息。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此去漢陽不遠。"}
{"id": null, "n": null, "target": null, "type": null, "text": "闊八尺，長丈二。"}
{"id": null, "n": null, "target": null, "type": null, "text": "真不掩偽。"}
{"id": null, "n": null, "target": null, "type": null, "text": "海枯終見底，人死不\n知心。"}
{"id": null, "n": null, "target": null, "type": null, "text": "腦后見腮，莫與往來。"}
{"id": null, "n": null, "target": null, "type": null, "text": "成者自成。"}
{"id": null, "n": null, "target": null, "type": null, "text": "壞者自\n壞。"}
{"id": null, "n": null, "target": null, "type": null, "text": "多喜少瞋。"}
{"id": null, "n": null, "target": null, "type": null, "text": "少喜多瞋。"}
{"id": null, "n": null, "target": null, "type": null, "text": "眼底無筋一世貧。"}
{"id": null, "n": null, "target": null, "type": null, "text": "識法\n者懼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "無雲生嶺上，有月落波心。"}
{"id": null, "n": null, "target": null, "type": null, "text": "舉一不得舉二"}
{"id": null, "n": null, "target": null, "type": null, "text": "放過一著，落在第\n\n二"}
{"id": null, "n": null, "target": null, "type": null, "text": "手把夜明符，幾个知天曉"}
{"id": null, "n": null, "target": null, "type": null, "text": "行人更在青山外"}
{"id": null, "n": null, "target": null, "type": null, "text": "萬里望鄉關"}
{"id": null, "n": null, "target": null, "type": null, "text": "出窟了也"}
{"id": null, "n": null, "target": null, "type": null, "text": "捕影追踪"}
{"id": null, "n": null, "target": null, "type": null, "text": "不許夜行，投明須到"}
{"id": null, "n": null, "target": null, "type": null, "text": "字經\n三寫"}
{"id": null, "n": null, "target": null, "type": null, "text": "烏焉成馬"}
{"id": null, "n": null, "target": null, "type": null, "text": "相逢不拈出，舉意便知有"}
{"id": null, "n": null, "target": null, "type": null, "text": "眼生三\n角，頭峭五岳"}
{"id": null, "n": null, "target": null, "type": null, "text": "返蟻難尋穴，歸禽\n易見窠"}
{"id": null, "n": null, "target": null, "type": null, "text": "我喚作火，汝不得喚作\n火"}
{"id": null, "n": null, "target": null, "type": null, "text": "海上陣雲橫"}
{"id": null, "n": null, "target": null, "type": null, "text": "古之今\n之"}
{"id": null, "n": null, "target": null, "type": null, "text": "今之古之"}
{"id": null, "n": null, "target": null, "type": null, "text": "猛虎入閙\n市"}
{"id": null, "n": null, "target": null, "type": null, "text": "無雲生嶺上"}
{"id": null, "n": null, "target": null, "type": null, "text": "有月落波心"}
{"id": null, "n": null, "target": null, "type": null, "text": "貧人思舊債"}
{"id": null, "n": null, "target": null, "type": null, "text": "不是苦心人不知"}
{"id": null, "n": null, "target": null, "type": null, "text": "愁人莫向愁\n人說"}
{"id": null, "n": null, "target": null, "type": null, "text": "說向愁人轉見愁"}
{"id": null, "n": null, "target": null, "type": null, "text": "一狀領過"}
{"id": null, "n": null, "target": null, "type": null, "text": "死欵難翻"}
{"id": null, "n": null, "target": null, "type": null, "text": "脚下點地"}
{"id": null, "n": null, "target": null, "type": null, "text": "要\n知山下路，但問去來人"}
{"id": null, "n": null, "target": null, "type": null, "text": "病眼見空華"}
{"id": null, "n": null, "target": null, "type": null, "text": "空華結空菓"}
{"id": null, "n": null, "target": null, "type": null, "text": "常憶江南三月裏，鷓鴣啼處百花香"}
{"id": null, "n": null, "target": null, "type": null, "text": "人貧智短"}
{"id": null, "n": null, "target": null, "type": null, "text": "馬瘦\n毛長"}
{"id": null, "n": null, "target": null, "type": null, "text": "同坑無異土"}
{"id": null, "n": null, "target": null, "type": null, "text": "好掘虗空一窖埋"}
{"id": null, "n": null, "target": null, "type": null, "text": "捕影追風"}
{"id": null, "n": null, "target": null, "type": null, "text": "自買自賣"}
{"id": null, "n": null, "target": null, "type": null, "text": "蚌\n含明月，玉兔懷胎"}
{"id": null, "n": null, "target": null, "type": null, "text": "兩彩一賽"}
{"id": null, "n": null, "target": null, "type": null, "text": "了"}
{"id": null, "n": null, "target": null, "type": null, "text": "敗"}
{"id": null, "n": null, "target": null, "type": null, "text": "師子咬人，韓盧逐塊"}
{"id": null, "n": null, "target": null, "type": null, "text": "三九二十七"}
{"id": null, "n": null, "target": null, "type": null, "text": "他家自有通人愛"}
{"id": null, "n": null, "target": null, "type": null, "text": "溪邊楊柳影，不礙釣舟行"}
{"id": null, "n": null, "target": null, "type": null, "text": "雪嶺泥牛走"}
{"id": null, "n": null, "target": null, "type": null, "text": "虗空咬著舌"}
{"id": null, "n": null, "target": null, "type": null, "text": "聾人爭得聞"}
{"id": null, "n": null, "target": null, "type": null, "text": "貪觀天\n上月"}
{"id": null, "n": null, "target": null, "type": null, "text": "失卻手中橈"}
{"id": null, "n": null, "target": null, "type": null, "text": "黑牛臥死水"}
{"id": null, "n": null, "target": null, "type": null, "text": "癩馬繫枯樁"}
{"id": null, "n": null, "target": null, "type": null, "text": "八十翁翁入\n場屋，真誠不是小兒戲"}
{"id": null, "n": null, "target": null, "type": null, "text": "一點水墨，兩處成龍"}
{"id": null, "n": null, "target": null, "type": null, "text": "寸不如尺"}
{"id": null, "n": null, "target": null, "type": null, "text": "有甚畢羅䭔子，\n快下將來"}
{"id": null, "n": null, "target": null, "type": null, "text": "獨掌不浪嗚，兩手鳴\n摑摑"}
{"id": null, "n": null, "target": null, "type": null, "text": "沒來由處有來由"}
{"id": null, "n": null, "target": null, "type": null, "text": "帀地清風有何極"}
{"id": null, "n": null, "target": null, "type": null, "text": "咄"}
{"id": null, "n": null, "target": null, "type": null, "text": "頭頂天"}
{"id": null, "n": null, "target": null, "type": null, "text": "脚踏地"}
{"id": null, "n": null, "target": null, "type": null, "text": "千聞不如一見。又云：也是無風起浪"}
{"id": null, "n": null, "target": null, "type": null, "text": "虗空包不住，大地載不起"}
{"id": null, "n": null, "target": null, "type": null, "text": "日面佛，月面佛。"}
{"id": null, "n": null, "target": null, "type": null, "text": "東\n涌西沒，南涌北沒。"}
{"id": null, "n": null, "target": null, "type": null, "text": "一箭落雙鵰。"}
{"id": null, "n": null, "target": null, "type": null, "text": "蹉過了也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡\n孫上樹尾連天。"}
{"id": null, "n": null, "target": null, "type": null, "text": "埀手過膝。"}
{"id": null, "n": null, "target": null, "type": null, "text": "眼底無筋，皮下有血"}
{"id": null, "n": null, "target": null, "type": null, "text": "一口無兩舌"}
{"id": null, "n": null, "target": null, "type": null, "text": "兵隨印轉，將\n逐符行"}
{"id": null, "n": null, "target": null, "type": null, "text": "掉棒打月"}
{"id": null, "n": null, "target": null, "type": null, "text": "聽取號令"}
{"id": null, "n": null, "target": null, "type": null, "text": "臨濟、德山只得\n一橛"}
{"id": null, "n": null, "target": null, "type": null, "text": "釣魚船上謝三郎"}
{"id": null, "n": null, "target": null, "type": null, "text": "千里萬里一條鐵"}
{"id": null, "n": null, "target": null, "type": null, "text": "永盛"}
{"id": null, "n": null, "target": null, "type": null, "text": "宁心"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T48n2014_p0396c16"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T47n1998Ap0845b14"}
