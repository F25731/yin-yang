{"id": null, "n": "0061001", "target": "#nkr_note_orig_0061001", "type": "orig", "text": "石梁菴、五龍山、南山洞"}
{"id": null, "n": "0062001", "target": "#nkr_note_orig_0062001", "type": "orig", "text": "宝冠岩、高峯、寶冠寺"}
{"id": null, "n": "0063001", "target": "#nkr_note_orig_0063001", "type": "orig", "text": "飛泉、火焰峯"}
{"id": null, "n": "0064001", "target": "#nkr_note_orig_0064001", "type": "orig", "text": "能仁寺、曇花菴、四十九盤嶺"}
{"id": null, "n": "0065001", "target": "#nkr_note_orig_0065001", "type": "orig", "text": "石龜岩、谷口岩"}
{"id": null, "n": "0066001", "target": "#nkr_note_orig_0066001", "type": "orig", "text": "古塔寺"}
{"id": null, "n": "0067001", "target": "#nkr_note_orig_0067001", "type": "orig", "text": "飛泉寺"}
{"id": null, "n": "0068001", "target": "#nkr_note_orig_0068001", "type": "orig", "text": "筆架山、對雲峯、能仁寺"}
{"id": null, "n": "0069001", "target": "#nkr_note_orig_0069001", "type": "orig", "text": "普門寺"}
{"id": null, "n": "0070001", "target": "#nkr_note_orig_0070001", "type": "orig", "text": "焦岩、凌溪口"}
{"id": null, "n": "0071001", "target": "#nkr_note_orig_0071001", "type": "orig", "text": "羅漢寺、按山塔、石泉塔"}
{"id": null, "n": "0072001", "target": "#nkr_note_orig_0072001", "type": "orig", "text": "石羅漢"}
{"id": null, "n": "0073001", "target": "#nkr_note_orig_0073001", "type": "orig", "text": "石門寺、石柱峯、天王岩"}
{"id": null, "n": "0074001", "target": "#nkr_note_orig_0074001", "type": "orig", "text": "石門山、猴孫峯、贗岩"}
{"id": null, "n": "0075001", "target": "#nkr_note_orig_0075001", "type": "orig", "text": "樹岩、寺基、道松洞"}
{"id": null, "n": "0076001", "target": "#nkr_note_orig_0076001", "type": "orig", "text": "朝陽峯"}
{"id": null, "n": "0077001", "target": "#nkr_note_orig_0077001", "type": "orig", "text": "華嚴寺"}
{"id": null, "n": "0078001", "target": "#nkr_note_orig_0078001", "type": "orig", "text": "火焰"}
{"id": null, "n": "0079001", "target": "#nkr_note_orig_0079001", "type": "orig", "text": "觀音巖"}
{"id": null, "n": "0080001", "target": "#nkr_note_orig_0080001", "type": "orig", "text": "天柱峯、天柱寺"}
{"id": null, "n": "0081001", "target": "#nkr_note_orig_0081001", "type": "orig", "text": "獅子峯、獨秀峯、仙掌峯、雷巖、風潭、雙笋岩"}
{"id": null, "n": "0082001", "target": "#nkr_note_orig_0082001", "type": "orig", "text": "靈峯寺、靈峯洞、缽盂巖"}
{"id": null, "n": "0083001", "target": "#nkr_note_orig_0083001", "type": "orig", "text": "真濟寺"}
{"id": null, "n": "0084001", "target": "#nkr_note_orig_0084001", "type": "orig", "text": "靈峯岩、白云嶺"}
{"id": null, "n": "0085001", "target": "#nkr_note_orig_0085001", "type": "orig", "text": "蟾蜍峯、屏霞障、剪棋峯、天聰峯、安禪谷、石屏風、天聰井"}
{"id": null, "n": "0086001", "target": "#nkr_note_orig_0086001", "type": "orig", "text": "龍鼻水、卓筆峯、天柱山峯、靈岩寺、僧抱石、雙鸞峯"}
{"id": null, "n": "0087001", "target": "#nkr_note_orig_0087001", "type": "orig", "text": "誦經岩、星橋"}
{"id": null, "n": "0088001", "target": "#nkr_note_orig_0088001", "type": "orig", "text": "淨明寺、白溪口"}
{"id": null, "n": "0089001", "target": "#nkr_note_orig_0089001", "type": "orig", "text": "石梁橋、大佛岩"}
{"id": null, "n": "0090001", "target": "#nkr_note_orig_0090001", "type": "orig", "text": "石梁洞、石梁寺"}
{"id": null, "n": "0091001", "target": "#nkr_note_orig_0091001", "type": "orig", "text": "雙峯寺、東高峯"}
{"id": null, "n": "0092001", "target": "#nkr_note_orig_0092001", "type": "orig", "text": "西高峯"}
{"id": null, "n": "0095001", "target": "#nkr_note_orig_0095001", "type": "orig", "text": "白雲菴、閻王鼻、大龍湫"}
{"id": null, "n": "0156001", "target": "#nkr_note_orig_0156001", "type": "orig", "text": "「寺亭俱佛境」字底本不清，茲依「樂清維科」網站（，2013.09.23）補入。以下本偈之補字，參考來源皆同此。"}
{"id": null, "n": "0192001", "target": "#nkr_note_orig_0192001", "type": "orig", "text": "「會看」字底本不清，茲依「雁蕩山詩選」網站（，2013.10.29）補入。"}
{"id": null, "n": "0225001", "target": "#nkr_note_orig_0225001", "type": "orig", "text": "「淮」字底本不清，茲依「世界溫州人」網站（，2013.10.29）補入。以下本偈之補刊字，參考來源皆同此。"}
{"id": null, "n": "0228001", "target": "#nkr_note_orig_0228001", "type": "orig", "text": "「巖天」底本不清，茲依《文淵閣四庫全書電子版．集部．總集類．石倉歷代詩選．卷四百八十三》p. 21 補入。（香港：迪志文化出版有限公司，1999）。以下本偈之補刊字，參考來源皆同此。"}
{"id": null, "n": "0240001", "target": "#nkr_note_orig_0240001", "type": "orig", "text": "「清」字底本不清，茲依「樂清維科」網站（，2013.10.29）補入。"}
{"id": null, "n": "0270001", "target": "#nkr_note_orig_0270001", "type": "orig", "text": "「蟫」為底本「蟬」的勘誤。此據《文淵閣四庫全書電子版．集部．總集類．元詩選．二集卷十二》p. 19 更正。（香港：迪志文化出版有限公司，1999）"}
