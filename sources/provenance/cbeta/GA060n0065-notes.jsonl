{"id": null, "n": null, "target": null, "type": null, "text": "十八刹建置沿革　東外谷四寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "藥品附"}
{"id": null, "n": null, "target": null, "type": null, "text": "鱗介附"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "有跋"}
{"id": null, "n": null, "target": null, "type": null, "text": "號際眀，郡守，前御史"}
{"id": null, "n": null, "target": null, "type": null, "text": "號他山，知縣，黃岩人"}
{"id": null, "n": null, "target": null, "type": null, "text": "教諭，號西崖，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號斗溟，給事，台州人"}
{"id": null, "n": null, "target": null, "type": null, "text": "岩名"}
{"id": null, "n": null, "target": null, "type": null, "text": "老僧岩"}
{"id": null, "n": null, "target": null, "type": null, "text": "石梁"}
{"id": null, "n": null, "target": null, "type": null, "text": "寺名"}
{"id": null, "n": null, "target": null, "type": null, "text": "將軍岩"}
{"id": null, "n": null, "target": null, "type": null, "text": "峰名"}
{"id": null, "n": null, "target": null, "type": null, "text": "潭名"}
{"id": null, "n": null, "target": null, "type": null, "text": "三峰名"}
{"id": null, "n": null, "target": null, "type": null, "text": "灵峯\n洞"}
{"id": null, "n": null, "target": null, "type": null, "text": "石名"}
{"id": null, "n": null, "target": null, "type": null, "text": "峯名"}
{"id": null, "n": null, "target": null, "type": null, "text": "峯名"}
{"id": null, "n": null, "target": null, "type": null, "text": "龍𮮰水"}
{"id": null, "n": null, "target": null, "type": null, "text": "峰名"}
{"id": null, "n": null, "target": null, "type": null, "text": "岩名"}
{"id": null, "n": null, "target": null, "type": null, "text": "展旗峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "含珠峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓筆峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "峯名"}
{"id": null, "n": null, "target": null, "type": null, "text": "洞名"}
{"id": null, "n": null, "target": null, "type": null, "text": "谷名"}
{"id": null, "n": null, "target": null, "type": null, "text": "峯名"}
{"id": null, "n": null, "target": null, "type": null, "text": "淨瓶峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "二峯名"}
{"id": null, "n": null, "target": null, "type": null, "text": "峯名"}
{"id": null, "n": null, "target": null, "type": null, "text": "觀音峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "廢寺名"}
{"id": null, "n": null, "target": null, "type": null, "text": "剪刀峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "大龍湫"}
{"id": null, "n": null, "target": null, "type": null, "text": "泉名"}
{"id": null, "n": null, "target": null, "type": null, "text": "山名"}
{"id": null, "n": null, "target": null, "type": null, "text": "能仁寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "澗名"}
{"id": null, "n": null, "target": null, "type": null, "text": "號生洲，副使，全椒人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號武莪，節推，宜興人"}
{"id": null, "n": null, "target": null, "type": null, "text": "現任溫處分守道，湖廣人"}
{"id": null, "n": null, "target": null, "type": null, "text": "見任溫處兵巡道，湖廣人"}
{"id": null, "n": null, "target": null, "type": null, "text": "見任樂清知縣，廣東人"}
{"id": null, "n": null, "target": null, "type": null, "text": "見任杭州府推官，賛皇人"}
{"id": null, "n": null, "target": null, "type": null, "text": "並用東冬兩韻"}
{"id": null, "n": null, "target": null, "type": null, "text": "驛屬樂清前即石門潭"}
{"id": null, "n": null, "target": null, "type": null, "text": "潭前里許有老僧巖小童巖最肖"}
{"id": null, "n": null, "target": null, "type": null, "text": "石梁寺今廢"}
{"id": null, "n": null, "target": null, "type": null, "text": "上有石梁洞亦奇"}
{"id": null, "n": null, "target": null, "type": null, "text": "次為謝公嶺"}
{"id": null, "n": null, "target": null, "type": null, "text": "次為寳冠巖為鳳凰峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "次為碧月丹桂逼霄諸峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "凌峯寺亦廢有凌峯洞最佳"}
{"id": null, "n": null, "target": null, "type": null, "text": "洞旁有五老臺前有雙鸞峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "左有靈芝峯右有獨秀峯山上有石鷹"}
{"id": null, "n": null, "target": null, "type": null, "text": "洞口有棋盤石"}
{"id": null, "n": null, "target": null, "type": null, "text": "有火小幞頭峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "次為響巖又次為靈巖寺新建"}
{"id": null, "n": null, "target": null, "type": null, "text": "寺後為霞屏嶂前為天柱中有龍鼻水"}
{"id": null, "n": null, "target": null, "type": null, "text": "有玉女峯禮石僧"}
{"id": null, "n": null, "target": null, "type": null, "text": "有展旗峯卓筆峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "兩峯並峙亦曰雙鸞又有劍峯泉"}
{"id": null, "n": null, "target": null, "type": null, "text": "有蟾蜍峯靈龜峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "有頂珠峯鉢孟峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "次為剪刀峯石屏山觀音大士巖"}
{"id": null, "n": null, "target": null, "type": null, "text": "次為筆架峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "次為馬鞍嶺頗峻"}
{"id": null, "n": null, "target": null, "type": null, "text": "次乃鴈蕩為龍湫飛瀑数百丈絕勝"}
{"id": null, "n": null, "target": null, "type": null, "text": "飛練水積為潭絕頂日照如錦"}
{"id": null, "n": null, "target": null, "type": null, "text": "右山開口如龍吟左山雙目類虎嘯"}
{"id": null, "n": null, "target": null, "type": null, "text": "周圍為連雲障洞口為芙蓉峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "能仁寺前有火熖山"}
{"id": null, "n": null, "target": null, "type": null, "text": "前為四十九盤嶺"}
{"id": null, "n": null, "target": null, "type": null, "text": "亭在潭側皷響則瀑迅寺在山下官至則撞鐘"}
{"id": null, "n": null, "target": null, "type": null, "text": "浮名好是閑真不若僧矣"}
{"id": null, "n": null, "target": null, "type": null, "text": "宕同"}
{"id": null, "n": null, "target": null, "type": null, "text": "在永嘉縣，南溪寒坑外二十里，即蒼坡山\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "一名溫嶠，其地常煖，冬月不寒，舊為溫之\n\n南界，溫州所以得名也。原屬樂清，今分隷\n台之太平縣"}
{"id": null, "n": null, "target": null, "type": null, "text": "在東外谷北閤蕩隂，今有白巖寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "在海中"}
{"id": null, "n": null, "target": null, "type": null, "text": "有渡䈥竹澗詩"}
{"id": null, "n": null, "target": null, "type": null, "text": "即諾詎羅"}
{"id": null, "n": null, "target": null, "type": null, "text": "每\n\n一羅漢西域書內有一讃，大略言其出處道塲事"}
{"id": null, "n": null, "target": null, "type": null, "text": "即今能仁寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "即\n今靈峰寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "即今嶺店驛"}
{"id": null, "n": null, "target": null, "type": null, "text": "沿澗皆小徑"}
{"id": null, "n": null, "target": null, "type": null, "text": "靈運自永嘉渡江至海涯登岸，循澗路入山，度今之\n謝公嶺，嶺在馬鞍嶺北"}
{"id": null, "n": null, "target": null, "type": null, "text": "即四十九\n盤嶺"}
{"id": null, "n": null, "target": null, "type": null, "text": "陌西在驛路白峯嶺邊，當窰奧嶺店\n二驛折中處"}
{"id": null, "n": null, "target": null, "type": null, "text": "古塔、靈雲、寳冠、石門、本覺"}
{"id": null, "n": null, "target": null, "type": null, "text": "能仁、羅漢、飛泉、普明、天柱、華嚴、瑞鹿"}
{"id": null, "n": null, "target": null, "type": null, "text": "石梁、雙峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "靈岩、\n淨名、靈峯、真濟"}
{"id": null, "n": null, "target": null, "type": null, "text": "一名童子"}
{"id": null, "n": null, "target": null, "type": null, "text": "下有小石屏"}
{"id": null, "n": null, "target": null, "type": null, "text": "一名\n逍遙嶠形如轎"}
{"id": null, "n": null, "target": null, "type": null, "text": "下有\n連雲障"}
{"id": null, "n": null, "target": null, "type": null, "text": "一名\n獨秀"}
{"id": null, "n": null, "target": null, "type": null, "text": "西谷\n\n办有朝陽"}
{"id": null, "n": null, "target": null, "type": null, "text": "志無，見《梅溪集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "一名紫薇屏"}
{"id": null, "n": null, "target": null, "type": null, "text": "西內谷、東谷各有獅子峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "狀如童子，常聞有誦經聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "宋胡侍郎讀書所"}
{"id": null, "n": null, "target": null, "type": null, "text": "状圓，孤立溪中，行人語其側則随聲相應"}
{"id": null, "n": null, "target": null, "type": null, "text": "陳覺說法處"}
{"id": null, "n": null, "target": null, "type": null, "text": "章恭毅公\n讀書所"}
{"id": null, "n": null, "target": null, "type": null, "text": "在鴈山東趾溫嶺內，二謝先生所居"}
{"id": null, "n": null, "target": null, "type": null, "text": "二石對立\n如柱"}
{"id": null, "n": null, "target": null, "type": null, "text": "一名僧寶石"}
{"id": null, "n": null, "target": null, "type": null, "text": "在龍鼻水下，元時有一監司持去，渡江逢惡浪，投諸水後復得於故處，詳\n紀異"}
{"id": null, "n": null, "target": null, "type": null, "text": "中空底平，如室可居"}
{"id": null, "n": null, "target": null, "type": null, "text": "鴈山西趾　公洞石廊尤為勝絕"}
{"id": null, "n": null, "target": null, "type": null, "text": "見紀異"}
{"id": null, "n": null, "target": null, "type": null, "text": "袁采記"}
{"id": null, "n": null, "target": null, "type": null, "text": "見文詞"}
{"id": null, "n": null, "target": null, "type": null, "text": "康樂梅溪詩俱見文詞下"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "十八剎建置沿革"}
{"id": null, "n": null, "target": null, "type": null, "text": "即四十九盤嶺"}
{"id": null, "n": null, "target": null, "type": null, "text": "詳開山下"}
{"id": null, "n": null, "target": null, "type": null, "text": "即神朗"}
{"id": null, "n": null, "target": null, "type": null, "text": "凡千卷皆金字"}
{"id": null, "n": null, "target": null, "type": null, "text": "詳紀異"}
{"id": null, "n": null, "target": null, "type": null, "text": "詳紀異"}
{"id": null, "n": null, "target": null, "type": null, "text": "頂平有泉，四面峯巒"}
{"id": null, "n": null, "target": null, "type": null, "text": "今岩在東谷"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘見開山祖下"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘詳開山下"}
{"id": null, "n": null, "target": null, "type": null, "text": "洞見前"}
{"id": null, "n": null, "target": null, "type": null, "text": "祭酒，號愚齋，四明奉化人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號梅溪，宋状元"}
{"id": null, "n": null, "target": null, "type": null, "text": "尚書，黃岩人，號久庵"}
{"id": null, "n": null, "target": null, "type": null, "text": "台州人"}
{"id": null, "n": null, "target": null, "type": null, "text": "叅政，嘉興人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號五松，應天判，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號二谷，布政，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號󸋯隅，侍郎，江西萬安人"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂長老顔公"}
{"id": null, "n": null, "target": null, "type": null, "text": "新月洞"}
{"id": null, "n": null, "target": null, "type": null, "text": "水簾谷"}
{"id": null, "n": null, "target": null, "type": null, "text": "首尾吟"}
{"id": null, "n": null, "target": null, "type": null, "text": "號五峯，著作郎，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "郎中，福建人，號少谷"}
{"id": null, "n": null, "target": null, "type": null, "text": "樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號桂洲，少師兼太子太師，江西貴溪人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號右山，御史，山西人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號東雩，叅政，湖廣人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號湛臺，御史，徽州人"}
{"id": null, "n": null, "target": null, "type": null, "text": "尚書，諡恭毅，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號鶴泉，少卿，永嘉人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號靈谷，知州，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號石洲，提學，潮陽人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號濱岩，叅政，處州人"}
{"id": null, "n": null, "target": null, "type": null, "text": "余往游嵩山少室上，達摩洞見立石向壁，儼然一僧也。余鄉括\n蒼山，有石僧立江，于今又見此石，豈處處示人習靜耶？"}
{"id": null, "n": null, "target": null, "type": null, "text": "號疊巖，大理寺副，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號西華，憲副，永嘉人"}
{"id": null, "n": null, "target": null, "type": null, "text": "樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號両皋，山隂人"}
{"id": null, "n": null, "target": null, "type": null, "text": "安吉人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號󸋯隅，侍郎，江西萬安人"}
{"id": null, "n": null, "target": null, "type": null, "text": "余廿年游宦過家僅三遇立節"}
{"id": null, "n": null, "target": null, "type": null, "text": "甲戌曾逰此山過老僧岩遇雨\n而止"}
{"id": null, "n": null, "target": null, "type": null, "text": "即今石門寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "號石屏，黃岩人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號委羽，黃岩人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號雲松，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "中書，永嘉人"}
{"id": null, "n": null, "target": null, "type": null, "text": "主事，福建人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號文谷，提斈，山西人"}
{"id": null, "n": null, "target": null, "type": null, "text": "副使"}
{"id": null, "n": null, "target": null, "type": null, "text": "號赤城，評書，臨海人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號臺南，副都御史，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號鶴洞，序班，黃嵓人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號芝南，御史，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號白泉，都御史，湖廣崇陽人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號蕩南，知府，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號宗梅，舉人，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號后溪，署丞，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號五山教諭，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號中方，提學，直隸人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號豹山，進士，直隸人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號南衡，進士，台州人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號文溪，舉人，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號小田，御史"}
{"id": null, "n": null, "target": null, "type": null, "text": "雁山人"}
{"id": null, "n": null, "target": null, "type": null, "text": "序班，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "郡守"}
{"id": null, "n": null, "target": null, "type": null, "text": "太子少師，謚清獻，衢州人"}
{"id": null, "n": null, "target": null, "type": null, "text": "名維禎"}
{"id": null, "n": null, "target": null, "type": null, "text": "名志淳，四明人"}
{"id": null, "n": null, "target": null, "type": null, "text": "少保，永嘉人"}
{"id": null, "n": null, "target": null, "type": null, "text": "提學，吳江人"}
{"id": null, "n": null, "target": null, "type": null, "text": "提學"}
{"id": null, "n": null, "target": null, "type": null, "text": "左叅政，蘇州人，號東橋"}
{"id": null, "n": null, "target": null, "type": null, "text": "副使蘇州人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號蔓亭，布政，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號羅峯，大學士，兼少師，永嘉人"}
{"id": null, "n": null, "target": null, "type": null, "text": "員外，太平人，號台南逸老"}
{"id": null, "n": null, "target": null, "type": null, "text": "叅政，松江人"}
{"id": null, "n": null, "target": null, "type": null, "text": "密菴昇上人曾在白鶴寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "提學副使，黃岩人"}
{"id": null, "n": null, "target": null, "type": null, "text": "知縣，樂清，南閤人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號草庭，黃岩人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號省齋，刑部侍郎，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號午渠，刑部郎中，南昌人"}
{"id": null, "n": null, "target": null, "type": null, "text": "副使，山東人"}
{"id": null, "n": null, "target": null, "type": null, "text": "推官，南直隸人"}
{"id": null, "n": null, "target": null, "type": null, "text": "舉人，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號薛峯，知縣，山東人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號石山，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號木庵，推官，常州人"}
{"id": null, "n": null, "target": null, "type": null, "text": "郎中，贈詹事，兼學士，黃岩人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號海峯，郎中，太平人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號天逰子，庠生，布政長子"}
{"id": null, "n": null, "target": null, "type": null, "text": "號少崖，同知，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號兩溪，知縣，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號雁樵，舉人，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "舉人，台州人"}
{"id": null, "n": null, "target": null, "type": null, "text": "國子生，黃岩人"}
{"id": null, "n": null, "target": null, "type": null, "text": "庠生，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號墨溪，知縣，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號東岡，国子生，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號方山，提斈，武進人"}
{"id": null, "n": null, "target": null, "type": null, "text": "副使，湖廣人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號瑶湖，南昌人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號文峯，郎中，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號晹谷，叅政，永嘉人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號後橋，署丞，永嘉人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號敬所，侍郎，台州人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號鴈州，舉人，臨海人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號雲橋，知洲，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "教諭，號瑞岩，安吉人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號鑑湖，新昌人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號鳴峯，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "樂清人，貢士"}
{"id": null, "n": null, "target": null, "type": null, "text": "給舍，臨海人"}
{"id": null, "n": null, "target": null, "type": null, "text": "参議，南直隸人"}
{"id": null, "n": null, "target": null, "type": null, "text": "平霞障"}
{"id": null, "n": null, "target": null, "type": null, "text": "展旗峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓筆峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "天聰洞"}
{"id": null, "n": null, "target": null, "type": null, "text": "大小二龍湫"}
{"id": null, "n": null, "target": null, "type": null, "text": "天柱峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "煽鞴爐峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "雙鸞峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "石室洞"}
{"id": null, "n": null, "target": null, "type": null, "text": "號玉峯，黃岩人"}
{"id": null, "n": null, "target": null, "type": null, "text": "靈岩有看不足亭"}
{"id": null, "n": null, "target": null, "type": null, "text": "敏行自西来歷諸名山謂無如鴈蕩山之勝"}
{"id": null, "n": null, "target": null, "type": null, "text": "峯有卓筆"}
{"id": null, "n": null, "target": null, "type": null, "text": "字公潛，平陽人，號潛齋"}
{"id": null, "n": null, "target": null, "type": null, "text": "喚一作嗅"}
{"id": null, "n": null, "target": null, "type": null, "text": "永一作水"}
{"id": null, "n": null, "target": null, "type": null, "text": "󲉞一作"}
{"id": null, "n": null, "target": null, "type": null, "text": "少保文簡公致任\n宣宗皇帝御製詩以送之米云鴈蕩峯高清不極中有\n謝公舊逰迹採芝斵苓可長年應在天南憶天北"}
{"id": null, "n": null, "target": null, "type": null, "text": "號少谷，郎中，閩縣人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號俟齋，副使，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "推官，吳縣人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號南岡，叅議，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "貢士太平人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號南石，貢士，黃嵓人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號蕩雲，貢士，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號丹霞樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號崑巖，縉雲人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號慎所，雁山人"}
{"id": null, "n": null, "target": null, "type": null, "text": "少卿，永嘉人，文簡公子"}
{"id": null, "n": null, "target": null, "type": null, "text": "教諭，號東崖，樂清人"}
{"id": null, "n": null, "target": null, "type": null, "text": "萬安人，知縣"}
{"id": null, "n": null, "target": null, "type": null, "text": "俱峯障岩洞名"}
{"id": null, "n": null, "target": null, "type": null, "text": "號兩峯，黃岩人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號甬川，尚書，四明人"}
{"id": null, "n": null, "target": null, "type": null, "text": "縣令"}
{"id": null, "n": null, "target": null, "type": null, "text": "一行按，輿圖分天下山川為南北二戒，以黃河為中"}
{"id": null, "n": null, "target": null, "type": null, "text": "驛舊在嶺南白\n溪，今徙于白若嶺比大荊，曰嶺店驛"}
{"id": null, "n": null, "target": null, "type": null, "text": "侍郎，太平人"}
{"id": null, "n": null, "target": null, "type": null, "text": "嘉靖進士"}
{"id": null, "n": null, "target": null, "type": null, "text": "祭酒，號愚齋，四明奉化人"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "見筆談"}
{"id": null, "n": null, "target": null, "type": null, "text": "字存中，湖州人"}
{"id": null, "n": null, "target": null, "type": null, "text": "太宗時"}
{"id": null, "n": null, "target": null, "type": null, "text": "驛今改于嶺南曰窰奧驛"}
{"id": null, "n": null, "target": null, "type": null, "text": "音曹"}
{"id": null, "n": null, "target": null, "type": null, "text": "太宗時"}
{"id": null, "n": null, "target": null, "type": null, "text": "止溫嶺"}
{"id": null, "n": null, "target": null, "type": null, "text": "在蕩隂北閤底，今有白岩寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "在海中"}
{"id": null, "n": null, "target": null, "type": null, "text": "在永嘉南溪"}
{"id": null, "n": null, "target": null, "type": null, "text": "俱永嘉界，大溪即南溪"}
{"id": null, "n": null, "target": null, "type": null, "text": "經甌江入海"}
{"id": null, "n": null, "target": null, "type": null, "text": "自芙蓉溪入海"}
{"id": null, "n": null, "target": null, "type": null, "text": "崖，鳥名，似鷹而稍大，\n生於海崖中，每秋末波海，海邊居人謂之曰崖。其色蒼白色，亦謂之白崖。又曰搗崖，以其勢能攫物，自上\n而下，有如搗也"}
{"id": null, "n": null, "target": null, "type": null, "text": "郡守"}
{"id": null, "n": null, "target": null, "type": null, "text": "通判"}
{"id": null, "n": null, "target": null, "type": null, "text": "太宗時"}
{"id": null, "n": null, "target": null, "type": null, "text": "今為瑞鹿寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "祭酒號，愚齋，四明奉化人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號崑巖，縉雲人，都御史"}
{"id": null, "n": null, "target": null, "type": null, "text": "號光璧，叅議，莆田人"}
{"id": null, "n": null, "target": null, "type": null, "text": "睊"}
{"id": null, "n": null, "target": null, "type": null, "text": "有跋"}
{"id": null, "n": null, "target": null, "type": null, "text": "嘉靖進士"}
{"id": null, "n": "0055001", "target": "#nkr_note_orig_0055001", "type": "orig", "text": "瑞鹿寺、大龍湫、鴈湖、石門寺、宝冠寺、羅漢寺、凌雲寺、普門寺、古塔寺、能仁寺、本斍寺、火焰峯"}
{"id": null, "n": "0056001", "target": "#nkr_note_orig_0056001", "type": "orig", "text": "真濟寺、灵峯寺、灵岩寺、天柱寺、飛泉寺、淨明寺、双峯寺"}
{"id": null, "n": "0057001", "target": "#nkr_note_orig_0057001", "type": "orig", "text": "本覺寺"}
{"id": null, "n": "0058001", "target": "#nkr_note_orig_0058001", "type": "orig", "text": "白雲寨"}
{"id": null, "n": "0059001", "target": "#nkr_note_orig_0059001", "type": "orig", "text": "石柱峯"}
