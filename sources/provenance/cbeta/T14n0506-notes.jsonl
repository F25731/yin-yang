{"id": null, "n": "0774001", "target": "#nkr_note_mod_0774001", "type": "mod", "text": "犍【大】＊，揵【宋】【元】＊，佛說犍【宮】＊"}
{"id": null, "n": "0774002", "target": "#nkr_note_mod_0774002", "type": "mod", "text": "安息國三藏【大】，〔－〕【宋】【元】，三藏法師【明】，沙門【宮】"}
{"id": null, "n": "0774003", "target": "#nkr_note_mod_0774003", "type": "mod", "text": "捶【大】，捶之【宋】【元】【明】"}
{"id": null, "n": "0774004", "target": "#nkr_note_mod_0774004", "type": "mod", "text": "攘【大】，穰【宋】，禳【元】【明】，壤【宮】"}
{"id": null, "n": "0774005", "target": "#nkr_note_mod_0774005", "type": "mod", "text": "德【大】，福【宋】【元】【明】"}
{"id": null, "n": "0774006", "target": "#nkr_note_mod_0774006", "type": "mod", "text": "上【大】，生【宋】【元】【明】【宮】"}
{"id": null, "n": "0774007", "target": "#nkr_note_mod_0774007", "type": "mod", "text": "意【大】，〔－〕【宮】"}
{"id": null, "n": "0774008", "target": "#nkr_note_mod_0774008", "type": "mod", "text": "正【大】，整【宋】【元】【明】"}
{"id": null, "n": "0774009", "target": "#nkr_note_mod_0774009", "type": "mod", "text": "意【大】，王意【宋】【元】【明】"}
{"id": null, "n": "0774010", "target": "#nkr_note_mod_0774010", "type": "mod", "text": "法【大】，〔－〕【宮】"}
{"id": null, "n": "0774011", "target": "#nkr_note_mod_0774011", "type": "mod", "text": "經【大】，經一卷【宋】【元】"}
{"id": null, "n": "0774001", "target": "#nkr_note_orig_0774001", "type": "orig", "text": "犍＝揵【宋】【元】＊，（佛說）＋犍【宮】＊"}
{"id": null, "n": "0774002", "target": "#nkr_note_orig_0774002", "type": "orig", "text": "〔安息國三藏〕－【宋】【元】，安息國三藏＝三藏法師【明】，沙門【宮】"}
{"id": null, "n": "0774003", "target": "#nkr_note_orig_0774003", "type": "orig", "text": "捶＋（之）【三】"}
{"id": null, "n": "0774004", "target": "#nkr_note_orig_0774004", "type": "orig", "text": "攘＝穰【宋】，禳【元】【明】，壤【宮】"}
{"id": null, "n": "0774005", "target": "#nkr_note_orig_0774005", "type": "orig", "text": "德＝福【三】"}
{"id": null, "n": "0774006", "target": "#nkr_note_orig_0774006", "type": "orig", "text": "上＝生【三】【宮】"}
{"id": null, "n": "0774007", "target": "#nkr_note_orig_0774007", "type": "orig", "text": "〔意〕－【宮】"}
{"id": null, "n": "0774008", "target": "#nkr_note_orig_0774008", "type": "orig", "text": "正＝整【三】"}
{"id": null, "n": "0774009", "target": "#nkr_note_orig_0774009", "type": "orig", "text": "（王）＋意【三】"}
{"id": null, "n": "0774010", "target": "#nkr_note_orig_0774010", "type": "orig", "text": "〔法〕－【宮】"}
{"id": null, "n": "0774011", "target": "#nkr_note_orig_0774011", "type": "orig", "text": "經＋（一卷）【宋】【元】"}
