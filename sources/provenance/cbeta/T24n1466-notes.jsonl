{"id": null, "n": null, "target": null, "type": "cf1", "text": "K23n0921_p0968c20"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "Q22_p0541c05"}
{"id": null, "n": null, "target": null, "type": null, "text": "五十五"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K23n0921_p0968c20"}
{"id": null, "n": "0903004", "target": "#nkr_note_mod_0903004", "type": "mod", "text": "佛【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0903005", "target": "#nkr_note_mod_0903005", "type": "mod", "text": "宋元嘉年求那跋摩譯【大】，失譯今附漢錄【宮】，（劉）＋宋【元】【明】"}
{"id": null, "n": "0903006", "target": "#nkr_note_mod_0903006", "type": "mod", "text": "元嘉年【大】，〔－〕【明】"}
{"id": null, "n": "0903007", "target": "#nkr_note_mod_0903007", "type": "mod", "text": "倩【大】＊，請【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0903008", "target": "#nkr_note_mod_0903008", "type": "mod", "text": "不【大】，非不【宋】【元】【明】【宮】"}
{"id": null, "n": "0903009", "target": "#nkr_note_mod_0903009", "type": "mod", "text": "（優波…止）十六字【大】，〔－〕【宮】"}
{"id": null, "n": "0903010", "target": "#nkr_note_mod_0903010", "type": "mod", "text": "掁【大】，張【宋】【元】【明】【宮】"}
{"id": null, "n": "0903011", "target": "#nkr_note_mod_0903011", "type": "mod", "text": "餓【大】，饑【宋】【元】【明】【宮】"}
{"id": null, "n": "0903012", "target": "#nkr_note_mod_0903012", "type": "mod", "text": "母【大】＊，女【宮】＊"}
{"id": null, "n": "0903013", "target": "#nkr_note_mod_0903013", "type": "mod", "text": "僧【大】，優【宮】"}
{"id": null, "n": "0904001", "target": "#nkr_note_mod_0904001", "type": "mod", "text": "塼【大】，摶【宋】【元】【明】【宮】"}
{"id": null, "n": "0904002", "target": "#nkr_note_mod_0904002", "type": "mod", "text": "軀【大】，驅【元】【明】"}
{"id": null, "n": "0904003", "target": "#nkr_note_mod_0904003", "type": "mod", "text": "殯【大】＊，擯【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0904004", "target": "#nkr_note_mod_0904004", "type": "mod", "text": "往【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0904005", "target": "#nkr_note_mod_0904005", "type": "mod", "text": "牻【大】＊，尨【宮】＊"}
{"id": null, "n": "0904006", "target": "#nkr_note_mod_0904006", "type": "mod", "text": "具【大】，其【元】"}
{"id": null, "n": "0904007", "target": "#nkr_note_mod_0904007", "type": "mod", "text": "事【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0904008", "target": "#nkr_note_mod_0904008", "type": "mod", "text": "帳【大】，作帳【宋】【元】【明】【宮】"}
{"id": null, "n": "0905001", "target": "#nkr_note_mod_0905001", "type": "mod", "text": "漉【大】，灑【宋】【元】【明】【宮】"}
{"id": null, "n": "0905002", "target": "#nkr_note_mod_0905002", "type": "mod", "text": "伽【CB】【磧-CB】【宋】【元】【明】【宮】，迦【大】【麗-CB】"}
{"id": null, "n": "0905003", "target": "#nkr_note_mod_0905003", "type": "mod", "text": "五【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0905004", "target": "#nkr_note_mod_0905004", "type": "mod", "text": "犯【大】，狂【宋】【元】【宮】"}
{"id": null, "n": "0905005", "target": "#nkr_note_mod_0905005", "type": "mod", "text": "狀【CB】【麗-CB】【宮】＊，床【大】＊，牀【磧-CB】＊"}
{"id": null, "n": "0905006", "target": "#nkr_note_mod_0905006", "type": "mod", "text": "犯【大】，犯者【宋】【元】【明】【宮】"}
{"id": null, "n": "0905007", "target": "#nkr_note_mod_0905007", "type": "mod", "text": "梵【大】＊，胡【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0905008", "target": "#nkr_note_mod_0905008", "type": "mod", "text": "呰【大】＊，訾【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0905009", "target": "#nkr_note_mod_0905009", "type": "mod", "text": "曇【大】，是【元】"}
{"id": null, "n": "0905010", "target": "#nkr_note_mod_0905010", "type": "mod", "text": "二【大】，犯二【明】"}
{"id": null, "n": "0905011", "target": "#nkr_note_mod_0905011", "type": "mod", "text": "斫【大】，作【明】"}
{"id": null, "n": "0905012", "target": "#nkr_note_mod_0905012", "type": "mod", "text": "姓【大】，性【元】【明】"}
{"id": null, "n": "0905013", "target": "#nkr_note_mod_0905013", "type": "mod", "text": "疾【大】，病【宋】【元】【明】【宮】"}
{"id": null, "n": "0905014", "target": "#nkr_note_mod_0905014", "type": "mod", "text": "土【大】＊，去【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0905015", "target": "#nkr_note_mod_0905015", "type": "mod", "text": "暫【大】，慚【宋】【元】【明】【宮】"}
{"id": null, "n": "0906001", "target": "#nkr_note_mod_0906001", "type": "mod", "text": "治【大】＊，苫【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0906002", "target": "#nkr_note_mod_0906002", "type": "mod", "text": "度【大】，渡【元】【明】"}
{"id": null, "n": "0906003", "target": "#nkr_note_mod_0906003", "type": "mod", "text": "要【大】，惡【宮】"}
{"id": null, "n": "0906004", "target": "#nkr_note_mod_0906004", "type": "mod", "text": "縫【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0906005", "target": "#nkr_note_mod_0906005", "type": "mod", "text": "異【大】＊，異意【明】＊"}
{"id": null, "n": "0906006", "target": "#nkr_note_mod_0906006", "type": "mod", "text": "飯【大】，餅【明】"}
{"id": null, "n": "0906007", "target": "#nkr_note_mod_0906007", "type": "mod", "text": "煮【大】，蝫【宮】"}
{"id": null, "n": "0906008", "target": "#nkr_note_mod_0906008", "type": "mod", "text": "不【大】，所【宋】【元】【明】【宮】"}
{"id": null, "n": "0906009", "target": "#nkr_note_mod_0906009", "type": "mod", "text": "或【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0906010", "target": "#nkr_note_mod_0906010", "type": "mod", "text": "也【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0906011", "target": "#nkr_note_mod_0906011", "type": "mod", "text": "食【大】，食食【宋】【元】【明】【宮】"}
{"id": null, "n": "0906012", "target": "#nkr_note_mod_0906012", "type": "mod", "text": "而【大】，而飲【宋】【元】【明】【宮】"}
{"id": null, "n": "0907001", "target": "#nkr_note_mod_0907001", "type": "mod", "text": "故【大】，放【元】"}
{"id": null, "n": "0907002", "target": "#nkr_note_mod_0907002", "type": "mod", "text": "違【大】＊，遣【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0907003", "target": "#nkr_note_mod_0907003", "type": "mod", "text": "五十五【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0907004", "target": "#nkr_note_mod_0907004", "type": "mod", "text": "語【大】，訶【宮】"}
{"id": null, "n": "0907005", "target": "#nkr_note_mod_0907005", "type": "mod", "text": "擯捨【大】，捨擯【宋】【元】【明】【宮】"}
{"id": null, "n": "0907006", "target": "#nkr_note_mod_0907006", "type": "mod", "text": "新【大】，親【宋】【元】【明】【宮】"}
{"id": null, "n": "0907007", "target": "#nkr_note_mod_0907007", "type": "mod", "text": "滅【大】，減【宋】【元】【明】"}
{"id": null, "n": "0907008", "target": "#nkr_note_mod_0907008", "type": "mod", "text": "牒【大】，褋【宋】【元】【明】【宮】"}
{"id": null, "n": "0908001", "target": "#nkr_note_mod_0908001", "type": "mod", "text": "過障【大】，發過【宋】【元】【明】【宮】"}
{"id": null, "n": "0908002", "target": "#nkr_note_mod_0908002", "type": "mod", "text": "返【大】，反【宋】【元】【明】"}
{"id": null, "n": "0908003", "target": "#nkr_note_mod_0908003", "type": "mod", "text": "匕【大】＊，七【明】＊"}
{"id": null, "n": "0908004", "target": "#nkr_note_mod_0908004", "type": "mod", "text": "梵【大】，胡【宋】【宮】"}
{"id": null, "n": "0908005", "target": "#nkr_note_mod_0908005", "type": "mod", "text": "柿【大】，抄【宋】【元】【明】【宮】"}
{"id": null, "n": "0908006", "target": "#nkr_note_mod_0908006", "type": "mod", "text": "也【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0908007", "target": "#nkr_note_mod_0908007", "type": "mod", "text": "枕【大】，笐【宋】【元】【明】【宮】"}
{"id": null, "n": "0908008", "target": "#nkr_note_mod_0908008", "type": "mod", "text": "知【大】，如【宋】【元】【明】【宮】"}
{"id": null, "n": "0908009", "target": "#nkr_note_mod_0908009", "type": "mod", "text": "七【大】，十【元】"}
{"id": null, "n": "0908010", "target": "#nkr_note_mod_0908010", "type": "mod", "text": "差【大】，瘥【宋】【元】【明】【宮】"}
{"id": null, "n": "0909001", "target": "#nkr_note_mod_0909001", "type": "mod", "text": "披【大】，被【宋】【元】【明】【宮】"}
{"id": null, "n": "0909002", "target": "#nkr_note_mod_0909002", "type": "mod", "text": "事【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0909003", "target": "#nkr_note_mod_0909003", "type": "mod", "text": "摶【大】，團【宋】【元】【明】"}
{"id": null, "n": "0909004", "target": "#nkr_note_mod_0909004", "type": "mod", "text": "味【大】，上【明】【宮】"}
{"id": null, "n": "0909005", "target": "#nkr_note_mod_0909005", "type": "mod", "text": "瀉【大】＊，寫【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0910001", "target": "#nkr_note_mod_0910001", "type": "mod", "text": "不念【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0910002", "target": "#nkr_note_mod_0910002", "type": "mod", "text": "屐【大】，屣【宋】【元】【明】【宮】"}
{"id": null, "n": "0910003", "target": "#nkr_note_mod_0910003", "type": "mod", "text": "仗【大】，杖【宋】【元】【明】【宮】"}
{"id": null, "n": "0910004", "target": "#nkr_note_mod_0910004", "type": "mod", "text": "仗【大】，杖【宋】【元】【宮】"}
{"id": null, "n": "0910005", "target": "#nkr_note_mod_0910005", "type": "mod", "text": "佛【大】，〔－〕【明】"}
{"id": null, "n": "0903004", "target": "#nkr_note_orig_0903004", "type": "orig", "text": "〔佛〕－【三】【宮】"}
{"id": null, "n": "0903005", "target": "#nkr_note_orig_0903005", "type": "orig", "text": "（劉）＋宋【元】【明】，（（宋元…譯））九字＝（（失譯今附漢錄））六字【宮】"}
{"id": null, "n": "0903006", "target": "#nkr_note_orig_0903006", "type": "orig", "text": "〔元嘉年〕－【明】"}
{"id": null, "n": "0903007", "target": "#nkr_note_orig_0903007", "type": "orig", "text": "倩＝請【三】【宮】＊"}
{"id": null, "n": "0903008", "target": "#nkr_note_orig_0903008", "type": "orig", "text": "（非）＋不【三】【宮】"}
{"id": null, "n": "0903009", "target": "#nkr_note_orig_0903009", "type": "orig", "text": "〔優波…止〕十六字－【宮】"}
{"id": null, "n": "0903010", "target": "#nkr_note_orig_0903010", "type": "orig", "text": "掁＝張【三】【宮】"}
{"id": null, "n": "0903011", "target": "#nkr_note_orig_0903011", "type": "orig", "text": "餓＝饑【三】【宮】"}
{"id": null, "n": "0903012", "target": "#nkr_note_orig_0903012", "type": "orig", "text": "母＝女【宮】＊"}
{"id": null, "n": "0903013", "target": "#nkr_note_orig_0903013", "type": "orig", "text": "僧＝優【宮】"}
{"id": null, "n": "0904001", "target": "#nkr_note_orig_0904001", "type": "orig", "text": "塼＝摶【三】【宮】"}
{"id": null, "n": "0904002", "target": "#nkr_note_orig_0904002", "type": "orig", "text": "軀＝驅【元】【明】"}
{"id": null, "n": "0904003", "target": "#nkr_note_orig_0904003", "type": "orig", "text": "殯＝擯【三】【宮】＊"}
{"id": null, "n": "0904004", "target": "#nkr_note_orig_0904004", "type": "orig", "text": "〔往〕－【三】【宮】"}
{"id": null, "n": "0904005", "target": "#nkr_note_orig_0904005", "type": "orig", "text": "牻＝尨【宮】＊"}
{"id": null, "n": "0904006", "target": "#nkr_note_orig_0904006", "type": "orig", "text": "具＝其【元】"}
{"id": null, "n": "0904007", "target": "#nkr_note_orig_0904007", "type": "orig", "text": "〔事〕－【宋】【元】【宮】"}
