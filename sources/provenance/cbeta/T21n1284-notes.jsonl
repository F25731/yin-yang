{"id": null, "n": "0349004", "target": "#nkr_note_mod_0349004", "type": "mod", "text": "西【大】＊，宋西【明】＊"}
{"id": null, "n": "0349005", "target": "#nkr_note_mod_0349005", "type": "mod", "text": "譯經【大】＊，〔－〕【明】＊"}
{"id": null, "n": "0349006", "target": "#nkr_note_mod_0349006", "type": "mod", "text": "臣【大】＊，〔－〕【明】＊"}
{"id": null, "n": "0349007", "target": "#nkr_note_mod_0349007", "type": "mod", "text": "志【大】，至【元】【明】"}
{"id": null, "n": "0349008", "target": "#nkr_note_mod_0349008", "type": "mod", "text": "求【大】，來【明】"}
{"id": null, "n": "0349009", "target": "#nkr_note_mod_0349009", "type": "mod", "text": "辰【大】，晨【明】"}
{"id": null, "n": "0349010", "target": "#nkr_note_mod_0349010", "type": "mod", "text": "反【大】下同，切【明】下同"}
{"id": null, "n": "0349011", "target": "#nkr_note_mod_0349011", "type": "mod", "text": "引【大】＊，〔－〕【明】＊"}
{"id": null, "n": "0349012", "target": "#nkr_note_mod_0349012", "type": "mod", "text": "惹敢反【大】，同前【明】"}
{"id": null, "n": "0349013", "target": "#nkr_note_mod_0349013", "type": "mod", "text": "言【大】，言曰【元】【明】"}
{"id": null, "n": "0349014", "target": "#nkr_note_mod_0349014", "type": "mod", "text": "囉【大】，嚕【明】"}
{"id": null, "n": "0350001", "target": "#nkr_note_mod_0350001", "type": "mod", "text": "必【大】，咇【明】"}
{"id": null, "n": "0350002", "target": "#nkr_note_mod_0350002", "type": "mod", "text": "婆【大】，娑【宋】【元】"}
{"id": null, "n": "0350003", "target": "#nkr_note_mod_0350003", "type": "mod", "text": "味【大】，昧【宋】【元】【明】"}
{"id": null, "n": "0350004", "target": "#nkr_note_mod_0350004", "type": "mod", "text": "合【大】，合引【宋】【元】【明】"}
{"id": null, "n": "0350005", "target": "#nkr_note_mod_0350005", "type": "mod", "text": "振【大】，震【宋】【元】【明】"}
{"id": null, "n": "0351001", "target": "#nkr_note_mod_0351001", "type": "mod", "text": "菉【大】，綠【明】"}
{"id": null, "n": "0351002", "target": "#nkr_note_mod_0351002", "type": "mod", "text": "拏【大】，拏羅【明】"}
{"id": null, "n": "0352001", "target": "#nkr_note_mod_0352001", "type": "mod", "text": "賀【大】，賀引【宋】【元】"}
{"id": null, "n": "0352002", "target": "#nkr_note_mod_0352002", "type": "mod", "text": "酥【大】，穌【宋】【元】"}
{"id": null, "n": "0352003", "target": "#nkr_note_mod_0352003", "type": "mod", "text": "大【大】，太【明】"}
{"id": null, "n": "0352004", "target": "#nkr_note_mod_0352004", "type": "mod", "text": "南【大】，喃【宋】【元】【明】"}
{"id": null, "n": "0353001", "target": "#nkr_note_mod_0353001", "type": "mod", "text": "引【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0349003", "target": "#nkr_note_orig_0349003", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0349004", "target": "#nkr_note_orig_0349004", "type": "orig", "text": "（宋）＋西【明】＊"}
{"id": null, "n": "0349005", "target": "#nkr_note_orig_0349005", "type": "orig", "text": "〔譯經〕－【明】＊"}
