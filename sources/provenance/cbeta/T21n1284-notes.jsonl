{"id": null, "n": "0350002", "target": "#nkr_note_orig_0350002", "type": "orig", "text": "婆＝娑【宋】【元】"}
{"id": null, "n": "0350003", "target": "#nkr_note_orig_0350003", "type": "orig", "text": "味＝昧【三】"}
{"id": null, "n": "0350004", "target": "#nkr_note_orig_0350004", "type": "orig", "text": "合＋（引）【三】"}
