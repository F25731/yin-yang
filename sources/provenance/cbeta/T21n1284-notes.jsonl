{"id": null, "n": "0349008", "target": "#nkr_note_orig_0349008", "type": "orig", "text": "求＝來【明】"}
{"id": null, "n": "0349009", "target": "#nkr_note_orig_0349009", "type": "orig", "text": "辰＝晨【明】"}
{"id": null, "n": "0349010", "target": "#nkr_note_orig_0349010", "type": "orig", "text": "反＝切【明】下同"}
{"id": null, "n": "0349011", "target": "#nkr_note_orig_0349011", "type": "orig", "text": "〔引〕－【明】＊"}
{"id": null, "n": "0349012", "target": "#nkr_note_orig_0349012", "type": "orig", "text": "惹敢反＝同前【明】"}
{"id": null, "n": "0349013", "target": "#nkr_note_orig_0349013", "type": "orig", "text": "言＋（曰）【元】【明】"}
{"id": null, "n": "0349014", "target": "#nkr_note_orig_0349014", "type": "orig", "text": "囉＝嚕【明】"}
