{"id": null, "n": "0572021", "target": "#nkr_note_mod_0572021", "type": "mod", "text": "經【大】，經安公關中異經【宋】【元】【宮】，經安公云關中異經【明】"}
{"id": null, "n": "0572022", "target": "#nkr_note_mod_0572022", "type": "mod", "text": "失譯附三秦錄【大】，後漢三藏安世高譯【宋】【宮】，失譯人名【明】，〔－〕【元】"}
{"id": null, "n": "0572023", "target": "#nkr_note_mod_0572023", "type": "mod", "text": "能至【大】，所能【宋】【元】【明】【宮】"}
{"id": null, "n": "0572024", "target": "#nkr_note_mod_0572024", "type": "mod", "text": "曾【大】，嘗【宋】【元】【明】【宮】"}
{"id": null, "n": "0572025", "target": "#nkr_note_mod_0572025", "type": "mod", "text": "以【大】，已【宋】【元】【明】【宮】"}
{"id": null, "n": "0572026", "target": "#nkr_note_mod_0572026", "type": "mod", "text": "家【大】，處【宮】"}
{"id": null, "n": "0572027", "target": "#nkr_note_mod_0572027", "type": "mod", "text": "復死【大】，死後【宋】【元】【明】【宮】"}
{"id": null, "n": "0572028", "target": "#nkr_note_mod_0572028", "type": "mod", "text": "咽【大】，噎【宋】【元】【明】【宮】"}
{"id": null, "n": "0572029", "target": "#nkr_note_mod_0572029", "type": "mod", "text": "虛空【大】，空虛【宋】【元】【明】【宮】"}
{"id": null, "n": "0572021", "target": "#nkr_note_orig_0572021", "type": "orig", "text": "經＋（安公關中異經）【宋】【元】【宮】，（安公云關中異經）【明】"}
{"id": null, "n": "0572022", "target": "#nkr_note_orig_0572022", "type": "orig", "text": "失譯附三秦錄＝後漢三藏安世高譯【宋】【宮】，失譯人名【明】，〔失譯附三秦錄〕－【元】"}
{"id": null, "n": "0572023", "target": "#nkr_note_orig_0572023", "type": "orig", "text": "能至＝所能【三】【宮】"}
{"id": null, "n": "0572024", "target": "#nkr_note_orig_0572024", "type": "orig", "text": "曾＝嘗【三】【宮】"}
{"id": null, "n": "0572025", "target": "#nkr_note_orig_0572025", "type": "orig", "text": "以＝已【三】【宮】"}
{"id": null, "n": "0572026", "target": "#nkr_note_orig_0572026", "type": "orig", "text": "家＝處【宮】"}
{"id": null, "n": "0572027", "target": "#nkr_note_orig_0572027", "type": "orig", "text": "復死＝死後【三】【宮】"}
{"id": null, "n": "0572028", "target": "#nkr_note_orig_0572028", "type": "orig", "text": "咽＝噎【三】【宮】"}
{"id": null, "n": "0572029", "target": "#nkr_note_orig_0572029", "type": "orig", "text": "虛空＝空虛【三】【宮】"}
