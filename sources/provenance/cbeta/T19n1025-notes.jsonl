{"id": null, "n": "0723007", "target": "#nkr_note_mod_0723007", "type": "mod", "text": "西天北印度烏填曩國帝釋宮寺三藏傳法大師賜紫沙門臣【大】，宋西天譯經三藏朝散大夫試鴻臚少卿傳法大師【明】，三藏傳法大師賜紫沙門臣【宋】【元】"}
{"id": null, "n": "0724001", "target": "#nkr_note_mod_0724001", "type": "mod", "text": "哆【大】，多【明】"}
{"id": null, "n": "0724002", "target": "#nkr_note_mod_0724002", "type": "mod", "text": "短【大】，終【明】"}
{"id": null, "n": "0724003", "target": "#nkr_note_mod_0724003", "type": "mod", "text": "由【大】下同，猶【元】【明】下同"}
{"id": null, "n": "0724004", "target": "#nkr_note_mod_0724004", "type": "mod", "text": "鬒【大】，鬚【宋】【元】【明】"}
{"id": null, "n": "0724005", "target": "#nkr_note_mod_0724005", "type": "mod", "text": "詣【大】，詢【元】"}
{"id": null, "n": "0725001", "target": "#nkr_note_mod_0725001", "type": "mod", "text": "障【大】，意【元】【明】"}
{"id": null, "n": "0725002", "target": "#nkr_note_mod_0725002", "type": "mod", "text": "魔【大】，摩【明】"}
{"id": null, "n": "0725003", "target": "#nkr_note_mod_0725003", "type": "mod", "text": "大【大】，天【元】【明】"}
{"id": null, "n": "0721014", "target": "#nkr_note_orig_0721014", "type": "orig", "text": "【原】麗本"}
