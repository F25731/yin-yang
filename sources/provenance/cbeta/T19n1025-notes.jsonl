{"id": null, "n": "0723002", "target": "#nkr_note_mod_0723002", "type": "mod", "text": "羅【大】，囉【宋】【元】【明】"}
{"id": null, "n": "0723003", "target": "#nkr_note_mod_0723003", "type": "mod", "text": "怖【大】，普【明】"}
