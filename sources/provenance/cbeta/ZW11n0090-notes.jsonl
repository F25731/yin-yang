{"id": null, "n": null, "target": null, "type": "cf1", "text": "方廣錩先生提供之電子檔"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "方廣錩先生提供之電子檔"}
{"id": null, "n": "0013001", "target": "#nkr_note_orig_0013001", "type": "orig", "text": "參見《大正藏》第8卷，第757頁上欄。"}
{"id": null, "n": "0014001", "target": "#nkr_note_orig_0014001", "type": "orig", "text": "「受」，甲本作「七」。"}
{"id": null, "n": "0014002", "target": "#nkr_note_orig_0014002", "type": "orig", "text": "「喻」，底、甲本均無，據文意補。"}
{"id": null, "n": "0014003", "target": "#nkr_note_orig_0014003", "type": "orig", "text": "「決」，甲本無。"}
{"id": null, "n": "0014004", "target": "#nkr_note_orig_0014004", "type": "orig", "text": "「◇」，底本此字難辨，或為「土」，甲本錄為「正」。"}
{"id": null, "n": "0015001", "target": "#nkr_note_orig_0015001", "type": "orig", "text": "「是」，甲本作「實」。"}
{"id": null, "n": "0015002", "target": "#nkr_note_orig_0015002", "type": "orig", "text": "「泫」，甲本作「泣」。"}
{"id": null, "n": "0015003", "target": "#nkr_note_orig_0015003", "type": "orig", "text": "「暫」，底、甲本同。「暫」下應缺漏一字。"}
{"id": null, "n": "0015004", "target": "#nkr_note_orig_0015004", "type": "orig", "text": "「死」，甲本作「鬼」。"}
{"id": null, "n": "0015005", "target": "#nkr_note_orig_0015005", "type": "orig", "text": "「成」，甲本無。"}
{"id": null, "n": "0015006", "target": "#nkr_note_orig_0015006", "type": "orig", "text": "「此……也」四字，底、甲本均無，據文意補。"}
{"id": null, "n": "0015007", "target": "#nkr_note_orig_0015007", "type": "orig", "text": "「爾」，底、甲本作「而」，據文意改。"}
{"id": null, "n": "0015008", "target": "#nkr_note_orig_0015008", "type": "orig", "text": "「纔」，甲本作「讒」。"}
{"id": null, "n": "0015009", "target": "#nkr_note_orig_0015009", "type": "orig", "text": "「在」，甲本無。"}
{"id": null, "n": "0016001", "target": "#nkr_note_orig_0016001", "type": "orig", "text": "「法印」，甲本作「污即」。"}
{"id": null, "n": "0013a1801", "target": "#nkr_note_add_0013a1801", "type": "add", "text": "等【CB】，〔－〕【藏外】"}
{"id": null, "n": "0013a2101", "target": "#nkr_note_add_0013a2101", "type": "add", "text": "等【CB】，〔－〕【藏外】"}
{"id": null, "n": "0014a0101", "target": "#nkr_note_add_0014a0101", "type": "add", "text": "繫【CB】，係【藏外】"}
