{"id": null, "n": "0583002", "target": "#nkr_note_orig_0583002", "type": "orig", "text": "述疑迷"}
{"id": null, "n": "0584001", "target": "#nkr_note_orig_0584001", "type": "orig", "text": "麥字可疑"}
{"id": null, "n": "0588001", "target": "#nkr_note_orig_0588001", "type": "orig", "text": "往疑住"}
{"id": null, "n": "0592001", "target": "#nkr_note_orig_0592001", "type": "orig", "text": "菩疑若或著"}
{"id": null, "n": "0592002", "target": "#nkr_note_orig_0592002", "type": "orig", "text": "又疑人"}
{"id": null, "n": "0594001", "target": "#nkr_note_orig_0594001", "type": "orig", "text": "故疑次"}
