{"id": null, "n": "0449001", "target": "#nkr_note_mod_0449001", "type": "mod", "text": "經【大】，經是普超經別品殊譯【宋】【宮】，經是普超經第三品別譯【元】，經即普超經第二品別譯【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "是普超經別品殊譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "即普超經第二品別譯"}
{"id": null, "n": "0449002", "target": "#nkr_note_mod_0449002", "type": "mod", "text": "安公云元闕譯人今附西晉錄【大】，安公云失譯【宋】，安公錄失譯人開元附西晉初出【元】，安公錄失譯人名開元附西晉錄【明】，安公失譯【宮】"}
{"id": null, "n": "0449003", "target": "#nkr_note_mod_0449003", "type": "mod", "text": "如【CB】【磧-CB】【宋】【元】【明】【宮】，知【大】"}
{"id": null, "n": "0449004", "target": "#nkr_note_mod_0449004", "type": "mod", "text": "剎【大】，利【明】"}
{"id": null, "n": "0449005", "target": "#nkr_note_mod_0449005", "type": "mod", "text": "剎【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0449006", "target": "#nkr_note_mod_0449006", "type": "mod", "text": "字【大】，號【宋】【元】【明】【宮】"}
{"id": null, "n": "0449007", "target": "#nkr_note_mod_0449007", "type": "mod", "text": "我【大】，吾【明】"}
{"id": null, "n": "0449008", "target": "#nkr_note_mod_0449008", "type": "mod", "text": "佛【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0449009", "target": "#nkr_note_mod_0449009", "type": "mod", "text": "大【大】，火【宋】"}
{"id": null, "n": "0449010", "target": "#nkr_note_mod_0449010", "type": "mod", "text": "火【大】，大【宋】【元】【明】【宮】"}
{"id": null, "n": "0449011", "target": "#nkr_note_mod_0449011", "type": "mod", "text": "妷【大】，泆【元】【明】"}
{"id": null, "n": "0449012", "target": "#nkr_note_mod_0449012", "type": "mod", "text": "易【CB】【磧-CB】【宋】【元】【明】【宮】，是【大】"}
{"id": null, "n": "0449013", "target": "#nkr_note_mod_0449013", "type": "mod", "text": "加【大】，知【宋】【宮】"}
{"id": null, "n": "0450001", "target": "#nkr_note_mod_0450001", "type": "mod", "text": "行【大】，有【宮】"}
{"id": null, "n": "0450002", "target": "#nkr_note_mod_0450002", "type": "mod", "text": "涕【大】，洟【宮】"}
{"id": null, "n": "0450003", "target": "#nkr_note_mod_0450003", "type": "mod", "text": "唾【大】，吐【明】"}
{"id": null, "n": "0450004", "target": "#nkr_note_mod_0450004", "type": "mod", "text": "殃【大】，惡【宮】"}
{"id": null, "n": "0450005", "target": "#nkr_note_mod_0450005", "type": "mod", "text": "憂愁【CB】【麗-CB】【磧-CB】【宮】，愁憂【大】"}
{"id": null, "n": "0450006", "target": "#nkr_note_mod_0450006", "type": "mod", "text": "辱【大】，受【宋】【元】【明】【宮】"}
{"id": null, "n": "0450007", "target": "#nkr_note_mod_0450007", "type": "mod", "text": "出【大】，坐【宋】【元】【明】【宮】"}
{"id": null, "n": "0450008", "target": "#nkr_note_mod_0450008", "type": "mod", "text": "之【大】，之殃【宋】【元】【明】【宮】"}
{"id": null, "n": "0450009", "target": "#nkr_note_mod_0450009", "type": "mod", "text": "悔【大】，誨【明】"}
{"id": null, "n": "0450010", "target": "#nkr_note_mod_0450010", "type": "mod", "text": "過【大】，過一日一夜各三時經戒不復作惡【宋】【元】【明】【宮】"}
{"id": null, "n": "0450011", "target": "#nkr_note_mod_0450011", "type": "mod", "text": "今以【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0450012", "target": "#nkr_note_mod_0450012", "type": "mod", "text": "惟【大】，維【明】"}
{"id": null, "n": "0450013", "target": "#nkr_note_mod_0450013", "type": "mod", "text": "見【CB】【磧-CB】【宋】【元】【明】【宮】，息【大】"}
{"id": null, "n": "0451001", "target": "#nkr_note_mod_0451001", "type": "mod", "text": "顧【CB】【磧-CB】【宋】【元】【明】【宮】，故【大】"}
{"id": null, "n": "0451002", "target": "#nkr_note_mod_0451002", "type": "mod", "text": "取授【大】，即受【宋】【元】【明】【宮】"}
{"id": null, "n": "0451003", "target": "#nkr_note_mod_0451003", "type": "mod", "text": "也【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0451004", "target": "#nkr_note_mod_0451004", "type": "mod", "text": "諸【大】，諸大【明】"}
{"id": null, "n": "0451005", "target": "#nkr_note_mod_0451005", "type": "mod", "text": "須【大】，修【明】"}
{"id": null, "n": "0449001", "target": "#nkr_note_orig_0449001", "type": "orig", "text": "經＋（是普超經別品殊譯）夾註【宋】【宮】，（是普超經第三品別譯）【元】，（即普超經第二品別譯）夾註【明】"}
{"id": null, "n": "0449002", "target": "#nkr_note_orig_0449002", "type": "orig", "text": "安公…錄（十二字）＝安公云失譯【宋】，安公錄失譯人開元附西晉初出【元】，安公錄失譯人名開元附西晉錄【明】，安公失譯【宮】"}
{"id": null, "n": "0449003", "target": "#nkr_note_orig_0449003", "type": "orig", "text": "知＝如【三】【宮】"}
{"id": null, "n": "0449004", "target": "#nkr_note_orig_0449004", "type": "orig", "text": "剎＝利【明】"}
{"id": null, "n": "0449005", "target": "#nkr_note_orig_0449005", "type": "orig", "text": "〔剎〕－【三】【宮】"}
{"id": null, "n": "0449006", "target": "#nkr_note_orig_0449006", "type": "orig", "text": "字＝號【三】【宮】"}
{"id": null, "n": "0449007", "target": "#nkr_note_orig_0449007", "type": "orig", "text": "我＝吾【明】"}
{"id": null, "n": "0449008", "target": "#nkr_note_orig_0449008", "type": "orig", "text": "〔佛〕－【三】【宮】"}
{"id": null, "n": "0449009", "target": "#nkr_note_orig_0449009", "type": "orig", "text": "大＝火【宋】"}
{"id": null, "n": "0449010", "target": "#nkr_note_orig_0449010", "type": "orig", "text": "火＝大【三】【宮】"}
{"id": null, "n": "0449011", "target": "#nkr_note_orig_0449011", "type": "orig", "text": "妷＝泆【元】【明】"}
{"id": null, "n": "0449012", "target": "#nkr_note_orig_0449012", "type": "orig", "text": "是＝易【三】【宮】"}
{"id": null, "n": "0449013", "target": "#nkr_note_orig_0449013", "type": "orig", "text": "加＝知【宋】【宮】"}
{"id": null, "n": "0450001", "target": "#nkr_note_orig_0450001", "type": "orig", "text": "行＝有【宮】"}
{"id": null, "n": "0450002", "target": "#nkr_note_orig_0450002", "type": "orig", "text": "涕＝洟【宮】"}
{"id": null, "n": "0450003", "target": "#nkr_note_orig_0450003", "type": "orig", "text": "唾＝吐【明】"}
{"id": null, "n": "0450004", "target": "#nkr_note_orig_0450004", "type": "orig", "text": "殃＝惡【宮】"}
{"id": null, "n": "0450005", "target": "#nkr_note_orig_0450005", "type": "orig", "text": "愁憂＝憂愁【宮】"}
{"id": null, "n": "0450006", "target": "#nkr_note_orig_0450006", "type": "orig", "text": "辱＝受【三】【宮】"}
{"id": null, "n": "0450007", "target": "#nkr_note_orig_0450007", "type": "orig", "text": "出＝坐【三】【宮】"}
{"id": null, "n": "0450008", "target": "#nkr_note_orig_0450008", "type": "orig", "text": "之＋（殃）【三】【宮】"}
{"id": null, "n": "0450009", "target": "#nkr_note_orig_0450009", "type": "orig", "text": "悔＝誨【明】"}
{"id": null, "n": "0450010", "target": "#nkr_note_orig_0450010", "type": "orig", "text": "過＋（一日一夜各三時經戒不復作惡）【三】【宮】"}
{"id": null, "n": "0450011", "target": "#nkr_note_orig_0450011", "type": "orig", "text": "〔今以〕－【三】【宮】"}
{"id": null, "n": "0450012", "target": "#nkr_note_orig_0450012", "type": "orig", "text": "惟＝維【明】"}
{"id": null, "n": "0450013", "target": "#nkr_note_orig_0450013", "type": "orig", "text": "息＝見【三】【宮】"}
{"id": null, "n": "0451001", "target": "#nkr_note_orig_0451001", "type": "orig", "text": "故＝顧【三】【宮】"}
{"id": null, "n": "0451002", "target": "#nkr_note_orig_0451002", "type": "orig", "text": "取授＝即受【三】【宮】"}
{"id": null, "n": "0451003", "target": "#nkr_note_orig_0451003", "type": "orig", "text": "〔也〕－【三】【宮】"}
{"id": null, "n": "0451004", "target": "#nkr_note_orig_0451004", "type": "orig", "text": "諸＋（大）【明】"}
{"id": null, "n": "0451005", "target": "#nkr_note_orig_0451005", "type": "orig", "text": "須＝修【明】"}
