{"id": null, "n": null, "target": null, "type": null, "text": "恒安"}
{"id": null, "n": null, "target": null, "type": null, "text": "內續新經目一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "其於委細\n并重單合譯並在貞元釋教錄三十卷中具述"}
{"id": null, "n": null, "target": null, "type": null, "text": "智昇"}
{"id": null, "n": null, "target": null, "type": null, "text": "圓照"}
{"id": null, "n": null, "target": null, "type": null, "text": "并千鉢經在內"}
{"id": null, "n": null, "target": null, "type": null, "text": "零卷散在諸帙內兼其舊本新譯請細詳譯人前後"}
{"id": null, "n": null, "target": null, "type": null, "text": "在貞元藏外"}
{"id": null, "n": null, "target": null, "type": null, "text": "新編入藏"}
{"id": null, "n": null, "target": null, "type": null, "text": "在續\n開元錄同帙"}
{"id": null, "n": null, "target": null, "type": null, "text": "新經目在內兼其佛名經十六卷收今十八卷成故大數外長有二卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "每紙二十八行成"}
{"id": null, "n": null, "target": null, "type": null, "text": "每紙二十五行成目錄每紙或二十\n二行成"}
{"id": null, "n": null, "target": null, "type": null, "text": "紙數在外"}
{"id": null, "n": null, "target": null, "type": null, "text": "義淨所譯開元目中遺編者"}
{"id": null, "n": null, "target": null, "type": null, "text": "內三卷元訪本未獲"}
{"id": null, "n": null, "target": null, "type": null, "text": "貞元十年甲戌歲西京西明寺沙門圓照奉勅集"}
{"id": null, "n": null, "target": null, "type": null, "text": "貞元十五年己卯歲西明寺沙門圓\n照奉勅集"}
{"id": null, "n": null, "target": null, "type": null, "text": "趙郡業律沙門從梵自大中九年乙\n亥歲止咸通元年庚辰歲依貞元入藏錄集"}
{"id": null, "n": null, "target": null, "type": null, "text": "抄寫日亦計數抄寫流行訖二部一十九卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "在傳集中收"}
{"id": null, "n": null, "target": null, "type": null, "text": "或十八卷附梁錄未詳作者"}
{"id": null, "n": null, "target": null, "type": null, "text": "沙門彥悰集"}
{"id": null, "n": null, "target": null, "type": null, "text": "三藏金剛智開元二十八年於\n長安薦福寺譯拾遺新編入目錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "李通玄長者撰僧勉昌於昇元二年進奉勅編入藏\n內"}
{"id": null, "n": null, "target": null, "type": null, "text": "今若除華嚴論外都計參佰柒拾參卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序取其進經年代致先於此有行狀一卷或在論\n初卷後故不別列"}
{"id": null, "n": null, "target": null, "type": null, "text": "或三卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐言無能勝將"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐言法月"}
{"id": null, "n": null, "target": null, "type": null, "text": "此序安三經首"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐言金剛智"}
{"id": null, "n": null, "target": null, "type": null, "text": "恒安"}
{"id": null, "n": null, "target": null, "type": null, "text": "況金剛智三藏於開元貞元二目中甚有所譯經文已計流行目錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "并經新序"}
{"id": null, "n": null, "target": null, "type": null, "text": "并\n序"}
{"id": null, "n": null, "target": null, "type": null, "text": "已廣流行見轉讀者"}
{"id": null, "n": null, "target": null, "type": null, "text": "并梵字"}
{"id": null, "n": null, "target": null, "type": null, "text": "題云文殊問字母品第十四"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序譯經沙門惠靈述"}
{"id": null, "n": null, "target": null, "type": null, "text": "大乘律"}
{"id": null, "n": null, "target": null, "type": null, "text": "大乘論"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "已久流行"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "元進一百一卷仁王經疏三卷移在後并失經目今計九十七卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "出吉祥勝初瑜伽經"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦云呵利底母法"}
{"id": null, "n": null, "target": null, "type": null, "text": "出不\n\n空羂索經二十八卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名五支略念誦法"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名文殊五字念誦法"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦云瑜伽總持教門說菩提心觀行修持義"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名成就大悲觀自在"}
{"id": null, "n": null, "target": null, "type": null, "text": "最勝立印聖無動尊大威怒王念誦儀軌法品"}
{"id": null, "n": null, "target": null, "type": null, "text": "內大乘律寄在花嚴入法界品四十二字觀門同帙\n收大乘論二部二卷一卷與大乘律同帙一卷大日略念誦法同帙"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐云不空金剛"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "第四譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "并經新序"}
{"id": null, "n": null, "target": null, "type": null, "text": "貞元六年庚午歲與牟尼室利等同譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "貞元六年庚午歲譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "內云入不思義解脫境界普賢行願品"}
{"id": null, "n": null, "target": null, "type": null, "text": "其經雖曾見其文辭理多前後移易故計寫到"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序記"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐言蓮花\n精進"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐言戒法"}
{"id": null, "n": null, "target": null, "type": null, "text": "大曆中進經數花嚴入法界品四十二字觀門同帙"}
{"id": null, "n": null, "target": null, "type": null, "text": "聖者鬱楞伽造在大曆七年進經數與大乘律同帙"}
{"id": null, "n": null, "target": null, "type": null, "text": "大曆中大日略經同帙"}
{"id": null, "n": null, "target": null, "type": null, "text": "重標於此"}
{"id": null, "n": null, "target": null, "type": null, "text": "開元目中遺編者"}
{"id": null, "n": null, "target": null, "type": null, "text": "內元欠二卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "內元欠一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "內元欠一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "內元欠三卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "即元欠三卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "然慮誤為別生故於本部中亦重收於彼耳"}
{"id": null, "n": null, "target": null, "type": null, "text": "與法琳別傳同帙續貞元錄在內"}
{"id": null, "n": null, "target": null, "type": null, "text": "元二十六行成紙"}
{"id": null, "n": null, "target": null, "type": null, "text": "內除千鉢經一部十卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "元二十五行成紙在貞元藏外"}
{"id": null, "n": null, "target": null, "type": null, "text": "若施主開藏時緣文字稍多可計六\n帙數"}
{"id": null, "n": null, "target": null, "type": null, "text": "內千鉢經一部十卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "抄寫\n月亦已計數抄寫流行訖"}
{"id": null, "n": null, "target": null, "type": null, "text": "或十八卷附梁錄未詳作者"}
{"id": null, "n": null, "target": null, "type": null, "text": "貞觀年中僧彥悰集"}
{"id": null, "n": null, "target": null, "type": null, "text": "貞元錄中具述委細"}
{"id": null, "n": null, "target": null, "type": null, "text": "恒安"}
{"id": null, "n": null, "target": null, "type": null, "text": "切慮文繁故不別出\n排藏錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "內一部一\n卷經新目"}
{"id": null, "n": null, "target": null, "type": null, "text": "零卷散收諸部帙中故致增減內華嚴論一部四十卷經新目一部一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "五百一十帙准貞元錄排即品次錄華嚴論在外"}
{"id": null, "n": null, "target": null, "type": null, "text": "恒安"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "恒安"}
{"id": null, "n": null, "target": null, "type": null, "text": "恒安"}
