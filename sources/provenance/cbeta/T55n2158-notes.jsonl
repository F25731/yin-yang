{"id": null, "n": "1049a2702", "target": "#nkr_note_add_1049a2702", "type": "add", "text": "參【CB】【麗-CB】，三【大】"}
{"id": null, "n": "1049b1101", "target": "#nkr_note_add_1049b1101", "type": "add", "text": "墜【CB】【麗-CB】，墮【大】"}
{"id": null, "n": "1049c1501", "target": "#nkr_note_add_1049c1501", "type": "add", "text": "諡【CB】，謚【大】"}
