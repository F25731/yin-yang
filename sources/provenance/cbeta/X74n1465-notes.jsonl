{"id": null, "n": null, "target": null, "type": null, "text": "法師揚鈴宣念各讚後，大眾和佛號五聲。"}
{"id": null, "n": null, "target": null, "type": null, "text": "大眾跪念"}
{"id": null, "n": null, "target": null, "type": null, "text": "某"}
{"id": null, "n": null, "target": null, "type": null, "text": "某"}
{"id": null, "n": null, "target": null, "type": null, "text": "某"}
{"id": null, "n": null, "target": null, "type": null, "text": "某"}
{"id": null, "n": null, "target": null, "type": null, "text": "某"}
{"id": null, "n": null, "target": null, "type": null, "text": "懺悔已，歸命禮阿彌陀佛及一切三寶"}
{"id": null, "n": null, "target": null, "type": null, "text": "一拜"}
{"id": null, "n": null, "target": null, "type": null, "text": "一拜"}
