{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "在列子第二莊子第三"}
{"id": null, "n": null, "target": null, "type": null, "text": "在景德傳\n燈錄第三"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "此字本是雷風卦名予避廟諱權改"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "此樂音落"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "闕"}
{"id": null, "n": null, "target": null, "type": null, "text": "力量是二事"}
{"id": null, "n": null, "target": null, "type": null, "text": "闕"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "先淨三業"}
{"id": null, "n": null, "target": null, "type": null, "text": "真宗廟諱權改為常"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂董生也"}
{"id": null, "n": null, "target": null, "type": null, "text": "俗語云畏虎不畏佛倣此"}
{"id": null, "n": null, "target": null, "type": null, "text": "子光字不耀元和姓纂有姓仲長"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "立名\n曰禪門簡要圓成偈"}
{"id": null, "n": null, "target": null, "type": null, "text": "言澤少殺氣多"}
{"id": null, "n": null, "target": null, "type": null, "text": "淺短狹小之貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "有以佛書為寶書道書為玉書"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
