{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "四首"}
{"id": null, "n": null, "target": null, "type": null, "text": "為龔岸齋居士題"}
{"id": null, "n": null, "target": null, "type": null, "text": "松下趺坐"}
{"id": null, "n": null, "target": null, "type": null, "text": "二獸相隨"}
{"id": null, "n": null, "target": null, "type": null, "text": "說法獻珠"}
{"id": null, "n": null, "target": null, "type": null, "text": "二人偶語"}
{"id": null, "n": null, "target": null, "type": null, "text": "跨獸出山"}
{"id": null, "n": null, "target": null, "type": null, "text": "四人聚論"}
{"id": null, "n": null, "target": null, "type": null, "text": "騎獸欲返"}
{"id": null, "n": null, "target": null, "type": null, "text": "三人度海"}
{"id": null, "n": null, "target": null, "type": null, "text": "海中騎龍"}
{"id": null, "n": null, "target": null, "type": null, "text": "巖前伏虎"}
{"id": null, "n": null, "target": null, "type": null, "text": "跨獸遨遊"}
{"id": null, "n": null, "target": null, "type": null, "text": "有敘"}
{"id": null, "n": null, "target": null, "type": null, "text": "序"}
{"id": null, "n": "0657001", "target": "#nkr_note_orig_0657001", "type": "orig", "text": "宵疑霄"}
