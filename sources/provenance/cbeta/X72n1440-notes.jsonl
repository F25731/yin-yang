{"id": null, "n": null, "target": null, "type": null, "text": "著語云：從空拋直釣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "反釣釣漁人。"}
{"id": null, "n": null, "target": null, "type": null, "text": "不向外邊求。"}
{"id": null, "n": null, "target": null, "type": null, "text": "意在鈎頭。"}
{"id": null, "n": null, "target": null, "type": null, "text": "山中無歷\n日。"}
{"id": null, "n": null, "target": null, "type": null, "text": "且道山與和尚是同是別？"}
{"id": null, "n": null, "target": null, "type": null, "text": "一椎粉碎"}
{"id": null, "n": null, "target": null, "type": null, "text": "入海窮到底"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦不從佛位來"}
{"id": null, "n": null, "target": null, "type": null, "text": "敲骨\n打髓"}
{"id": null, "n": null, "target": null, "type": null, "text": "家破人亡後，徧界絕行蹤。"}
{"id": null, "n": null, "target": null, "type": null, "text": "豈不見洞山後來道：青山白雲父，白雲青山兒。白雲終日\n倚，青山總不知。"}
{"id": null, "n": null, "target": null, "type": null, "text": "從來\n一雙足，曾不到人間。"}
{"id": null, "n": null, "target": null, "type": null, "text": "是一是二"}
{"id": null, "n": null, "target": null, "type": null, "text": "木人方歌，石女起舞。"}
{"id": null, "n": null, "target": null, "type": null, "text": "空中樓閣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "心外無法，滿目青山。"}
{"id": null, "n": null, "target": null, "type": null, "text": "龜毛縛太虛。"}
{"id": null, "n": null, "target": null, "type": null, "text": "徒勞心力。"}
{"id": null, "n": null, "target": null, "type": null, "text": "也是虛空安耳朵。"}
{"id": null, "n": null, "target": null, "type": null, "text": "師云：貧兒思舊債"}
{"id": null, "n": null, "target": null, "type": null, "text": "敲空作響"}
{"id": null, "n": null, "target": null, "type": null, "text": "仁義道中"}
{"id": null, "n": null, "target": null, "type": null, "text": "理合如是"}
{"id": null, "n": null, "target": null, "type": null, "text": "這一疑疑殺天下不疑者"}
{"id": null, "n": null, "target": null, "type": null, "text": "全身拋擲"}
{"id": null, "n": null, "target": null, "type": null, "text": "似水投水，更無異味"}
{"id": null, "n": null, "target": null, "type": null, "text": "勾賊破家"}
{"id": null, "n": null, "target": null, "type": null, "text": "一狀領過"}
{"id": null, "n": null, "target": null, "type": null, "text": "憐兒不覺醜"}
{"id": null, "n": null, "target": null, "type": null, "text": "五則"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "有引"}
{"id": null, "n": null, "target": null, "type": null, "text": "四首"}
{"id": null, "n": null, "target": null, "type": null, "text": "娑婆，此云堪忍。"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉劉遺民．\n雷次宗入廬山蓮社。遺民先生淨土遠公終時，見遺民侍阿彌陀佛來迎，曰：師先我發心，來何遲耶？"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
