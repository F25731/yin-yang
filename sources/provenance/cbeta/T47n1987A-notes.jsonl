{"id": null, "n": null, "target": null, "type": null, "text": "音導"}
{"id": null, "n": null, "target": null, "type": null, "text": "非我"}
{"id": null, "n": null, "target": null, "type": null, "text": "非渠"}
{"id": null, "n": null, "target": null, "type": null, "text": "仰汝取活"}
{"id": null, "n": null, "target": null, "type": null, "text": "不別有"}
{"id": null, "n": null, "target": null, "type": null, "text": "要且不是佛"}
{"id": null, "n": null, "target": null, "type": null, "text": "二俱不立"}
{"id": null, "n": null, "target": null, "type": null, "text": "若遇御飯直須吐却"}
{"id": null, "n": null, "target": null, "type": null, "text": "不通信"}
{"id": null, "n": null, "target": null, "type": null, "text": "為信唱"}
{"id": null, "n": null, "target": null, "type": null, "text": "不與\n爾相似"}
{"id": null, "n": null, "target": null, "type": null, "text": "將謂是白雪"}
{"id": null, "n": null, "target": null, "type": null, "text": "傳此句無註"}
{"id": null, "n": null, "target": null, "type": null, "text": "諸揀統會"}
{"id": null, "n": null, "target": null, "type": null, "text": "音障"}
{"id": null, "n": null, "target": null, "type": null, "text": "音貴"}
{"id": null, "n": null, "target": null, "type": null, "text": "句"}
{"id": null, "n": null, "target": null, "type": null, "text": "句"}
{"id": null, "n": null, "target": null, "type": null, "text": "是云正"}
{"id": null, "n": null, "target": null, "type": null, "text": "是云中"}
{"id": null, "n": null, "target": null, "type": null, "text": "是云偏"}
{"id": null, "n": null, "target": null, "type": null, "text": "今案"}
{"id": null, "n": null, "target": null, "type": null, "text": "須看取四種異類中"}
{"id": null, "n": null, "target": null, "type": null, "text": "法身白牛"}
{"id": null, "n": null, "target": null, "type": null, "text": "須看異類開示"}
{"id": null, "n": null, "target": null, "type": null, "text": "荷玉向自道取答古人語，\n奈何"}
{"id": null, "n": null, "target": null, "type": null, "text": "下云同中異類是同"}
{"id": null, "n": null, "target": null, "type": null, "text": "後云披毛截角"}
{"id": null, "n": null, "target": null, "type": null, "text": "吉祥宗祖手澤中不云長"}
{"id": null, "n": null, "target": null, "type": null, "text": "自下問答皆以無舌\n語為中下道，取上四異類"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼此文別，宗豈有異"}
{"id": null, "n": null, "target": null, "type": null, "text": "菩薩"}
{"id": null, "n": null, "target": null, "type": null, "text": "沙門"}
{"id": null, "n": null, "target": null, "type": null, "text": "當也"}
{"id": null, "n": null, "target": null, "type": null, "text": "新古兩本無有別異"}
{"id": null, "n": null, "target": null, "type": null, "text": "至下益詳"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本作後舉問師，一\n本連上猶為雲居話"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本迄此雲居山話"}
{"id": null, "n": null, "target": null, "type": null, "text": "披毛戴角"}
{"id": null, "n": null, "target": null, "type": null, "text": "蓋去聲音異"}
{"id": null, "n": null, "target": null, "type": null, "text": "前後正三"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T47n1987Bp0538a25"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "X66n1297_p0659c10"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X69n1332_p0066b10"}
{"id": null, "n": "0528001", "target": "#nkr_note_mod_0528001", "type": "mod", "text": "好【大】，愛【校異-原】"}
{"id": null, "n": "0529003", "target": "#nkr_note_mod_0529003", "type": "mod", "text": "余【大】，餘【考偽-原】"}
{"id": null, "n": "0531004", "target": "#nkr_note_mod_0531004", "type": "mod", "text": "觀【大】，官【校異-原】"}
{"id": null, "n": "0533001", "target": "#nkr_note_mod_0533001", "type": "mod", "text": "歸【大】，來【校異-原】"}
{"id": null, "n": "0534001", "target": "#nkr_note_mod_0534001", "type": "mod", "text": "聖【大】，勝【校異-原】"}
{"id": null, "n": "0534002", "target": "#nkr_note_mod_0534002", "type": "mod", "text": "他【大】，也【校異-原】"}
{"id": null, "n": "0534003", "target": "#nkr_note_mod_0534003", "type": "mod", "text": "故云子細子細【大】，〔－〕【校異-原】"}
{"id": null, "n": "0534004", "target": "#nkr_note_mod_0534004", "type": "mod", "text": "老【大】，〔－〕【校異-原】"}
{"id": null, "n": "0534005", "target": "#nkr_note_mod_0534005", "type": "mod", "text": "又【大】，余【校異-原】"}
{"id": null, "n": "0534006", "target": "#nkr_note_mod_0534006", "type": "mod", "text": "西東【大】，東西【校異-原】"}
{"id": null, "n": "0534007", "target": "#nkr_note_mod_0534007", "type": "mod", "text": "謂【大】＊，者【校異-原】＊"}
{"id": null, "n": "0534009", "target": "#nkr_note_mod_0534009", "type": "mod", "text": "父【大】，又【校異-原】"}
{"id": null, "n": "0534010", "target": "#nkr_note_mod_0534010", "type": "mod", "text": "我【大】，〔－〕【校異-原】"}
{"id": null, "n": "0534011", "target": "#nkr_note_mod_0534011", "type": "mod", "text": "行持【大】，誓願【校異-原】"}
{"id": null, "n": "0534012", "target": "#nkr_note_mod_0534012", "type": "mod", "text": "勝【大】，聖【校異-原】"}
{"id": null, "n": "0534013", "target": "#nkr_note_mod_0534013", "type": "mod", "text": "曹山【大】，余【校異-原】"}
{"id": null, "n": "0534014", "target": "#nkr_note_mod_0534014", "type": "mod", "text": "類【大】，〔－〕【校異-甲】"}
{"id": null, "n": "0534015", "target": "#nkr_note_mod_0534015", "type": "mod", "text": "麼【大】，否【校異-原】"}
{"id": null, "n": "0534016", "target": "#nkr_note_mod_0534016", "type": "mod", "text": "和尚【大】，〔－〕【校異-原】"}
{"id": null, "n": "0534018", "target": "#nkr_note_mod_0534018", "type": "mod", "text": "余【大】，師【校異-原】"}
{"id": null, "n": "0534019", "target": "#nkr_note_mod_0534019", "type": "mod", "text": "研【大】，斫【校異-原】"}
{"id": null, "n": "0535001", "target": "#nkr_note_mod_0535001", "type": "mod", "text": "究【大】，穴【校異-原】"}
{"id": null, "n": "0535002", "target": "#nkr_note_mod_0535002", "type": "mod", "text": "語【大】，邊語【校異-原】"}
{"id": null, "n": "0535003", "target": "#nkr_note_mod_0535003", "type": "mod", "text": "本來【大】，〔－〕【校異-原】"}
{"id": null, "n": "0535004", "target": "#nkr_note_mod_0535004", "type": "mod", "text": "如【大】，問如【校異-原】"}
{"id": null, "n": "0535005", "target": "#nkr_note_mod_0535005", "type": "mod", "text": "稠又舉【大】，〔－〕【校異-原】"}
{"id": null, "n": "0535006", "target": "#nkr_note_mod_0535006", "type": "mod", "text": "洞山古佛【大】，先師【校異-原】"}
{"id": null, "n": "0535007", "target": "#nkr_note_mod_0535007", "type": "mod", "text": "得【大】，〔－〕【校異-原】"}
{"id": null, "n": "0535008", "target": "#nkr_note_mod_0535008", "type": "mod", "text": "直至如今不奈何【大】，〔－〕【校異-原】"}
{"id": null, "n": "0535009", "target": "#nkr_note_mod_0535009", "type": "mod", "text": "自少【大】，〔－〕【校異-原】"}
{"id": null, "n": "0535010", "target": "#nkr_note_mod_0535010", "type": "mod", "text": "位【大】，〔－〕【校異-原】"}
{"id": null, "n": "0535011", "target": "#nkr_note_mod_0535011", "type": "mod", "text": "也【大】，〔－〕【校異-原】"}
{"id": null, "n": "0535012", "target": "#nkr_note_mod_0535012", "type": "mod", "text": "又曰【大】，〔－〕【校異-原】，師曰【校異-原】"}
{"id": null, "n": "0526001", "target": "#nkr_note_orig_0526001", "type": "orig", "text": "【原】明和三年刊駒澤大學藏本"}
{"id": null, "n": "0527001", "target": "#nkr_note_orig_0527001", "type": "orig", "text": "原本註曰是君臣五相頌等雖可編末抄隨舊刻耳"}
{"id": null, "n": "0527002", "target": "#nkr_note_orig_0527002", "type": "orig", "text": "原本註曰此話已出洞山錄中"}
{"id": null, "n": "0528001", "target": "#nkr_note_orig_0528001", "type": "orig", "text": "好＝愛ィ【原】"}
{"id": null, "n": "0529001", "target": "#nkr_note_orig_0529001", "type": "orig", "text": "原本註曰曹上類聚存三十年前四字"}
{"id": null, "n": "0529002", "target": "#nkr_note_orig_0529002", "type": "orig", "text": "原本註曰此是話頭偶爾似清谿語"}
{"id": null, "n": "0529003", "target": "#nkr_note_orig_0529003", "type": "orig", "text": "余＝餘ヵ【原】"}
{"id": null, "n": "0531001", "target": "#nkr_note_orig_0531001", "type": "orig", "text": "原本註曰劄當作札音軋揠省拔也云云"}
{"id": null, "n": "0531002", "target": "#nkr_note_orig_0531002", "type": "orig", "text": "原本註曰自下師拈洞山古則既載新豊錄故不載于此"}
{"id": null, "n": "0531003", "target": "#nkr_note_orig_0531003", "type": "orig", "text": "原本註曰頑廣輝釋本作顧"}
{"id": null, "n": "0531004", "target": "#nkr_note_orig_0531004", "type": "orig", "text": "觀＝官ィ【原】"}
{"id": null, "n": "0532001", "target": "#nkr_note_orig_0532001", "type": "orig", "text": "原本註曰天真長老揀語今略不載"}
{"id": null, "n": "0533001", "target": "#nkr_note_orig_0533001", "type": "orig", "text": "歸＝來ィ【原】"}
{"id": null, "n": "0534001", "target": "#nkr_note_orig_0534001", "type": "orig", "text": "聖＝勝ィ【原】"}
{"id": null, "n": "0534002", "target": "#nkr_note_orig_0534002", "type": "orig", "text": "他＝也ィ【原】"}
{"id": null, "n": "0534003", "target": "#nkr_note_orig_0534003", "type": "orig", "text": "〔故云子細子細〕ィ－【原】"}
{"id": null, "n": "0534004", "target": "#nkr_note_orig_0534004", "type": "orig", "text": "〔老〕ィ－【原】"}
{"id": null, "n": "0534005", "target": "#nkr_note_orig_0534005", "type": "orig", "text": "又＝余ィ【原】"}
{"id": null, "n": "0534006", "target": "#nkr_note_orig_0534006", "type": "orig", "text": "西東＝東西ィ【原】"}
{"id": null, "n": "0534007", "target": "#nkr_note_orig_0534007", "type": "orig", "text": "謂＝者ィ【原】＊"}
{"id": null, "n": "0534008", "target": "#nkr_note_orig_0534008", "type": "orig", "text": "原本註曰皆字諸本作背古老口訣當作皆"}
{"id": null, "n": "0534009", "target": "#nkr_note_orig_0534009", "type": "orig", "text": "父＝又ィ【原】"}
{"id": null, "n": "0534010", "target": "#nkr_note_orig_0534010", "type": "orig", "text": "〔我〕ィ－【原】"}
{"id": null, "n": "0534011", "target": "#nkr_note_orig_0534011", "type": "orig", "text": "行持＝誓願ィ【原】"}
{"id": null, "n": "0534012", "target": "#nkr_note_orig_0534012", "type": "orig", "text": "勝＝聖ィ【原】"}
{"id": null, "n": "0534013", "target": "#nkr_note_orig_0534013", "type": "orig", "text": "曹山＝余ィ【原】"}
{"id": null, "n": "0534014", "target": "#nkr_note_orig_0534014", "type": "orig", "text": "〔類〕ィ－【甲】"}
{"id": null, "n": "0534015", "target": "#nkr_note_orig_0534015", "type": "orig", "text": "麼＝否ィ【原】"}
{"id": null, "n": "0534016", "target": "#nkr_note_orig_0534016", "type": "orig", "text": "〔和尚〕ィ－【原】"}
{"id": null, "n": "0534017", "target": "#nkr_note_orig_0534017", "type": "orig", "text": "原本註曰三墮中此有我向字"}
{"id": null, "n": "0534018", "target": "#nkr_note_orig_0534018", "type": "orig", "text": "余＝師ィ【原】"}
{"id": null, "n": "0534019", "target": "#nkr_note_orig_0534019", "type": "orig", "text": "研＝斫ィ【原】"}
{"id": null, "n": "0535001", "target": "#nkr_note_orig_0535001", "type": "orig", "text": "究＝穴ィ【原】"}
{"id": null, "n": "0535002", "target": "#nkr_note_orig_0535002", "type": "orig", "text": "（邊）ィ＋語【原】"}
{"id": null, "n": "0535003", "target": "#nkr_note_orig_0535003", "type": "orig", "text": "〔本來〕ィ－【原】"}
{"id": null, "n": "0535004", "target": "#nkr_note_orig_0535004", "type": "orig", "text": "（問）ィ＋如【原】"}
{"id": null, "n": "0535005", "target": "#nkr_note_orig_0535005", "type": "orig", "text": "〔稠又舉〕ィ－【原】"}
{"id": null, "n": "0535006", "target": "#nkr_note_orig_0535006", "type": "orig", "text": "洞山古佛＝先師ィ【原】"}
{"id": null, "n": "0535007", "target": "#nkr_note_orig_0535007", "type": "orig", "text": "〔得〕ィ－【原】"}
{"id": null, "n": "0535008", "target": "#nkr_note_orig_0535008", "type": "orig", "text": "〔直至如今不奈何〕ィ－【原】"}
{"id": null, "n": "0535009", "target": "#nkr_note_orig_0535009", "type": "orig", "text": "〔自少〕ィ－【原】"}
{"id": null, "n": "0535010", "target": "#nkr_note_orig_0535010", "type": "orig", "text": "〔位〕ィ－【原】"}
{"id": null, "n": "0535011", "target": "#nkr_note_orig_0535011", "type": "orig", "text": "〔也〕ィ－【原】"}
{"id": null, "n": "0535012", "target": "#nkr_note_orig_0535012", "type": "orig", "text": "又＝師ィ【原】，〔又曰〕ィ－【原】"}
