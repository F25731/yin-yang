{"id": null, "n": null, "target": null, "type": null, "text": "謂身、口、意也"}
{"id": null, "n": null, "target": null, "type": null, "text": "障礙者非福也，對治\n者福及不動也"}
{"id": null, "n": null, "target": null, "type": null, "text": "依亦有二，合為四種"}
{"id": null, "n": null, "target": null, "type": null, "text": "依謂身也"}
{"id": null, "n": null, "target": null, "type": null, "text": "泥梨賀翻為不動，而是空義以空故無所動作"}
{"id": null, "n": null, "target": null, "type": null, "text": "舊名次第緣"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名生緣"}
{"id": null, "n": null, "target": null, "type": null, "text": "識與名色相著\n作緣，梵本亦無此句"}
{"id": null, "n": null, "target": null, "type": null, "text": "舊名使"}
{"id": null, "n": null, "target": null, "type": null, "text": "舊名縛亦名上心"}
{"id": null, "n": null, "target": null, "type": null, "text": "共因果者，染則因果共染、淨則因果共淨，故名共也"}
{"id": null, "n": null, "target": null, "type": null, "text": "病謂苦、由謂集、脫謂滅、藥謂道"}
{"id": null, "n": null, "target": null, "type": null, "text": "道理亦名因緣亦名方便"}
{"id": null, "n": null, "target": null, "type": null, "text": "舊名天竺者訛也"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K10n0157_p0762b19"}
{"id": null, "n": null, "target": null, "type": null, "text": "義翻為生"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K10n0157_p0767b05"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K10n0157_p0761a07"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K10n0157_p0761a08"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T32n1652_p0482a11"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K10n0157_p0761a10"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T16n0716_p0837b05"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K10n0157_p0761a17"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K10n0157_p0761a22"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T32n1652_p0482a23"}
{"id": null, "n": "0830003", "target": "#nkr_note_mod_0830003", "type": "mod", "text": "緣【大】＊，佛說緣【明】＊"}
{"id": null, "n": "0830004", "target": "#nkr_note_mod_0830004", "type": "mod", "text": "藏【大】＊，藏法師【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0830005", "target": "#nkr_note_mod_0830005", "type": "mod", "text": "相【大】，類【宋】【元】【明】【宮】"}
{"id": null, "n": "0830006", "target": "#nkr_note_mod_0830006", "type": "mod", "text": "髆【大】，膊【宋】【元】【明】【宮】"}
{"id": null, "n": "0831001", "target": "#nkr_note_mod_0831001", "type": "mod", "text": "後【大】，彼【宋】【元】【明】【宮】"}
{"id": null, "n": "0831002", "target": "#nkr_note_mod_0831002", "type": "mod", "text": "生【大】，在【宮】"}
{"id": null, "n": "0831003", "target": "#nkr_note_mod_0831003", "type": "mod", "text": "未【大】，不【元】【明】"}
{"id": null, "n": "0831004", "target": "#nkr_note_mod_0831004", "type": "mod", "text": "彼【大】，後【元】【明】【宮】"}
{"id": null, "n": "0832001", "target": "#nkr_note_mod_0832001", "type": "mod", "text": "界【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0832002", "target": "#nkr_note_mod_0832002", "type": "mod", "text": "及【大】，又【宮】"}
{"id": null, "n": "0832003", "target": "#nkr_note_mod_0832003", "type": "mod", "text": "義翻為生【大】，義翻為生【元】【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "義翻為生"}
{"id": null, "n": "0833001", "target": "#nkr_note_mod_0833001", "type": "mod", "text": "而【大】，即【明】"}
{"id": null, "n": "0833002", "target": "#nkr_note_mod_0833002", "type": "mod", "text": "第【大】，事【宮】"}
{"id": null, "n": "0833003", "target": "#nkr_note_mod_0833003", "type": "mod", "text": "此句【大】，〔－〕【明】"}
{"id": null, "n": "0833004", "target": "#nkr_note_mod_0833004", "type": "mod", "text": "譯【大】，初譯【元】"}
{"id": null, "n": "0833005", "target": "#nkr_note_mod_0833005", "type": "mod", "text": "牙【大】，芽【宋】【元】【明】【宮】"}
{"id": null, "n": "0834001", "target": "#nkr_note_mod_0834001", "type": "mod", "text": "生【大】，者【宮】"}
{"id": null, "n": "0834002", "target": "#nkr_note_mod_0834002", "type": "mod", "text": "修【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0834003", "target": "#nkr_note_mod_0834003", "type": "mod", "text": "縛【大】，纏【宋】【元】【明】【宮】"}
{"id": null, "n": "0834004", "target": "#nkr_note_mod_0834004", "type": "mod", "text": "減【大】，滅【明】"}
{"id": null, "n": "0836001", "target": "#nkr_note_mod_0836001", "type": "mod", "text": "正信【大】，止信【宮】"}
{"id": null, "n": "0837001", "target": "#nkr_note_mod_0837001", "type": "mod", "text": "說【大】，諦【宋】【元】【明】【宮】"}
{"id": null, "n": "0837002", "target": "#nkr_note_mod_0837002", "type": "mod", "text": "非【大】，皆【元】【明】"}
{"id": null, "n": "0830003", "target": "#nkr_note_orig_0830003", "type": "orig", "text": "（佛說）＋緣【明】＊"}
{"id": null, "n": "0830004", "target": "#nkr_note_orig_0830004", "type": "orig", "text": "藏＋（法師）【三】【宮】＊"}
{"id": null, "n": "0830005", "target": "#nkr_note_orig_0830005", "type": "orig", "text": "相＝類【三】【宮】"}
{"id": null, "n": "0830006", "target": "#nkr_note_orig_0830006", "type": "orig", "text": "髆＝膊【三】【宮】"}
{"id": null, "n": "0831001", "target": "#nkr_note_orig_0831001", "type": "orig", "text": "後＝彼【三】【宮】"}
{"id": null, "n": "0831002", "target": "#nkr_note_orig_0831002", "type": "orig", "text": "生＝在【宮】"}
{"id": null, "n": "0831003", "target": "#nkr_note_orig_0831003", "type": "orig", "text": "未＝不【元】【明】"}
{"id": null, "n": "0831004", "target": "#nkr_note_orig_0831004", "type": "orig", "text": "彼＝後【元】【明】【宮】"}
{"id": null, "n": "0832001", "target": "#nkr_note_orig_0832001", "type": "orig", "text": "〔界〕－【三】【宮】"}
{"id": null, "n": "0832002", "target": "#nkr_note_orig_0832002", "type": "orig", "text": "及＝又【宮】"}
{"id": null, "n": "0832003", "target": "#nkr_note_orig_0832003", "type": "orig", "text": "義翻為生作夾註【元】【明】"}
{"id": null, "n": "0833001", "target": "#nkr_note_orig_0833001", "type": "orig", "text": "而＝即【明】"}
{"id": null, "n": "0833002", "target": "#nkr_note_orig_0833002", "type": "orig", "text": "第＝事【宮】"}
{"id": null, "n": "0833003", "target": "#nkr_note_orig_0833003", "type": "orig", "text": "〔此句〕－【明】"}
{"id": null, "n": "0833004", "target": "#nkr_note_orig_0833004", "type": "orig", "text": "（初）＋譯【元】"}
{"id": null, "n": "0833005", "target": "#nkr_note_orig_0833005", "type": "orig", "text": "牙＝芽【三】【宮】"}
{"id": null, "n": "0834001", "target": "#nkr_note_orig_0834001", "type": "orig", "text": "生＝者【宮】"}
{"id": null, "n": "0834002", "target": "#nkr_note_orig_0834002", "type": "orig", "text": "〔修〕－【三】【宮】"}
{"id": null, "n": "0834003", "target": "#nkr_note_orig_0834003", "type": "orig", "text": "縛＝纏【三】【宮】"}
{"id": null, "n": "0834004", "target": "#nkr_note_orig_0834004", "type": "orig", "text": "減＝滅【明】"}
{"id": null, "n": "0836001", "target": "#nkr_note_orig_0836001", "type": "orig", "text": "正信＝止信【宮】"}
{"id": null, "n": "0837001", "target": "#nkr_note_orig_0837001", "type": "orig", "text": "說＝諦【三】【宮】"}
{"id": null, "n": "0837002", "target": "#nkr_note_orig_0837002", "type": "orig", "text": "非＝皆【元】【明】"}
{"id": null, "n": "0831b0201", "target": "#nkr_note_add_0831b0201", "type": "add", "text": "貪【CB】【麗-CB】，貧【大】"}
{"id": null, "n": "0834b2201", "target": "#nkr_note_add_0834b2201", "type": "add", "text": "住【CB】【麗-CB】，往【大】"}
{"id": null, "n": "0837b0201", "target": "#nkr_note_add_0837b0201", "type": "add", "text": "渡【CB】【麗-CB】，度【大】"}
{"id": null, "n": "0837b0301", "target": "#nkr_note_add_0837b0301", "type": "add", "text": "城【CB】【麗-CB】，域【大】"}
{"id": null, "n": "0837b0501", "target": "#nkr_note_add_0837b0501", "type": "add", "text": "門【CB】【麗-CB】，問【大】"}
{"id": null, "n": "0837b1101", "target": "#nkr_note_add_0837b1101", "type": "add", "text": "彥【CB】【麗-CB】，產【大】"}
{"id": null, "n": "0837b1501", "target": "#nkr_note_add_0837b1501", "type": "add", "text": "扣【CB】【麗-CB】，控【大】"}
