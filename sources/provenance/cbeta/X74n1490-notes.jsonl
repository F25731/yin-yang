{"id": null, "n": null, "target": null, "type": null, "text": "六"}
{"id": null, "n": null, "target": null, "type": null, "text": "七"}
{"id": null, "n": null, "target": null, "type": null, "text": "上"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": null, "target": null, "type": null, "text": "八"}
{"id": null, "n": null, "target": null, "type": null, "text": "九"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": null, "target": null, "type": null, "text": "十"}
{"id": null, "n": null, "target": null, "type": null, "text": "十一"}
{"id": null, "n": null, "target": null, "type": null, "text": "十二"}
{"id": null, "n": null, "target": null, "type": null, "text": "十三"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": null, "target": null, "type": null, "text": "十四"}
{"id": null, "n": null, "target": null, "type": null, "text": "十五"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": null, "target": null, "type": null, "text": "上"}
{"id": null, "n": null, "target": null, "type": null, "text": "十六"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": null, "target": null, "type": null, "text": "十七"}
{"id": null, "n": null, "target": null, "type": null, "text": "或一百八徧，或四十九徧"}
{"id": null, "n": null, "target": null, "type": null, "text": "遶壇畢，首者白云："}
{"id": null, "n": null, "target": null, "type": null, "text": "一拜"}
{"id": null, "n": null, "target": null, "type": null, "text": "眾跪唱云"}
{"id": null, "n": null, "target": null, "type": null, "text": "某甲"}
{"id": null, "n": null, "target": null, "type": null, "text": "一拜"}
{"id": null, "n": null, "target": null, "type": null, "text": "起立寧神，整衣添香，首者作梵眾和云："}
{"id": null, "n": null, "target": null, "type": null, "text": "執爐問訊徐行遶壇"}
{"id": null, "n": null, "target": null, "type": null, "text": "遶畢，歸位，復舉"}
{"id": null, "n": null, "target": null, "type": null, "text": "復稱南無本師釋迦牟尼佛，出壇入觀堂，觀時一心誦呪，香完自便。"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
