{"id": null, "n": "0800004", "target": "#nkr_note_mod_0800004", "type": "mod", "text": "効【大】＊，斅【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0800005", "target": "#nkr_note_mod_0800005", "type": "mod", "text": "邪【大】，常懷邪【元】【明】"}
{"id": null, "n": "0800006", "target": "#nkr_note_mod_0800006", "type": "mod", "text": "申【大】＊，伸【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0800007", "target": "#nkr_note_mod_0800007", "type": "mod", "text": "食飲【大】，飲食【明】"}
{"id": null, "n": "0800008", "target": "#nkr_note_mod_0800008", "type": "mod", "text": "便【大】，使【宋】【元】【明】"}
{"id": null, "n": "0800009", "target": "#nkr_note_mod_0800009", "type": "mod", "text": "修【大】，是【宋】【元】【明】"}
{"id": null, "n": "0800004", "target": "#nkr_note_orig_0800004", "type": "orig", "text": "効＝斅【三】＊"}
{"id": null, "n": "0800005", "target": "#nkr_note_orig_0800005", "type": "orig", "text": "（常懷）＋邪【元】【明】"}
{"id": null, "n": "0800006", "target": "#nkr_note_orig_0800006", "type": "orig", "text": "申＝伸【三】＊"}
{"id": null, "n": "0800007", "target": "#nkr_note_orig_0800007", "type": "orig", "text": "食飲＝飲食【明】"}
{"id": null, "n": "0800008", "target": "#nkr_note_orig_0800008", "type": "orig", "text": "便＝使【三】"}
{"id": null, "n": "0800009", "target": "#nkr_note_orig_0800009", "type": "orig", "text": "修＝是【三】"}
