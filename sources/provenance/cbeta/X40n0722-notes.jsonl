{"id": null, "n": null, "target": null, "type": null, "text": "答云：僧已集。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答云：和合。"}
{"id": null, "n": null, "target": null, "type": null, "text": "若有，\n即遣出。答云：未受具戒者已出。若無，即云：此無未受具戒者。"}
{"id": null, "n": null, "target": null, "type": null, "text": "若有人說欲，即云：說欲及清淨已。若無，即云：此無說欲及清淨者。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答云：說戒羯磨。"}
{"id": null, "n": null, "target": null, "type": null, "text": "或黑月，或十四\n日，隨時改之。"}
{"id": null, "n": null, "target": null, "type": null, "text": "問云：作法成否？答：成。"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "檀越施財，為僧造說戒堂，諸尼回作五衣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "檀越施財，為安隱尼作食，舊住尼以財、貨、衣共分。"}
{"id": null, "n": null, "target": null, "type": null, "text": "檀越施財與安隱尼造，造房自迴作五衣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "眾尼求乞房財，後共分作五衣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "即墳塔也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "不入戒本"}
{"id": null, "n": null, "target": null, "type": null, "text": "去呼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "乎本。"}
{"id": null, "n": null, "target": null, "type": null, "text": "愍。"}
{"id": null, "n": null, "target": null, "type": null, "text": "奚音。"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡頰。"}
{"id": null, "n": null, "target": null, "type": null, "text": "漏。"}
{"id": null, "n": null, "target": null, "type": null, "text": "亡胡"}
{"id": null, "n": null, "target": null, "type": null, "text": "崖音亦通牙。"}
{"id": null, "n": null, "target": null, "type": null, "text": "戶瞎。"}
{"id": null, "n": null, "target": null, "type": null, "text": "去劫。"}
{"id": null, "n": null, "target": null, "type": null, "text": "連下三說，下同。"}
{"id": null, "n": null, "target": null, "type": null, "text": "力為。"}
{"id": null, "n": null, "target": null, "type": null, "text": "預。"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦。"}
{"id": null, "n": null, "target": null, "type": null, "text": "悉。"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡怪。"}
{"id": null, "n": null, "target": null, "type": null, "text": "奴過又奴帶。"}
{"id": null, "n": null, "target": null, "type": null, "text": "朔"}
{"id": null, "n": null, "target": null, "type": null, "text": "丑。飢。"}
{"id": null, "n": null, "target": null, "type": null, "text": "丑六。"}
{"id": null, "n": null, "target": null, "type": null, "text": "方願。"}
{"id": null, "n": null, "target": null, "type": null, "text": "陟衛。"}
{"id": null, "n": null, "target": null, "type": null, "text": "力主。"}
{"id": null, "n": null, "target": null, "type": null, "text": "直利。"}
{"id": null, "n": null, "target": null, "type": null, "text": "去呼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "哉"}
{"id": null, "n": null, "target": null, "type": null, "text": "牒"}
{"id": null, "n": null, "target": null, "type": null, "text": "紫。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上怪。"}
{"id": null, "n": null, "target": null, "type": null, "text": "側格。"}
{"id": null, "n": null, "target": null, "type": null, "text": "毗義。"}
{"id": null, "n": null, "target": null, "type": null, "text": "失簾。"}
{"id": null, "n": null, "target": null, "type": null, "text": "尺沼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上張\n略。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上去呼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "郎擊。"}
{"id": null, "n": null, "target": null, "type": null, "text": "隻。"}
{"id": null, "n": null, "target": null, "type": null, "text": "必刃。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上丁貫。"}
{"id": null, "n": null, "target": null, "type": null, "text": "補各。"}
{"id": null, "n": null, "target": null, "type": null, "text": "雨逼泥逼二音。"}
{"id": null, "n": null, "target": null, "type": null, "text": "傍禮。"}
{"id": null, "n": null, "target": null, "type": null, "text": "當侯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "丁呂。"}
{"id": null, "n": null, "target": null, "type": null, "text": "算。"}
{"id": null, "n": null, "target": null, "type": null, "text": "下去\n呼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "普伯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "渠綺。"}
{"id": null, "n": null, "target": null, "type": null, "text": "莊助。"}
{"id": null, "n": null, "target": null, "type": null, "text": "直追。"}
{"id": null, "n": null, "target": null, "type": null, "text": "陟格。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上妃兩，下則力。"}
{"id": null, "n": null, "target": null, "type": null, "text": "汝鴆，又壬音。"}
{"id": null, "n": null, "target": null, "type": null, "text": "於容。"}
{"id": null, "n": null, "target": null, "type": null, "text": "壯里。"}
{"id": null, "n": null, "target": null, "type": null, "text": "苦化。"}
{"id": null, "n": null, "target": null, "type": null, "text": "所綺。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上平下去。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上他計，下湯臥。"}
{"id": null, "n": null, "target": null, "type": null, "text": "桑姑。"}
{"id": null, "n": null, "target": null, "type": null, "text": "洛"}
{"id": null, "n": null, "target": null, "type": null, "text": "楚交初教二音。"}
{"id": null, "n": null, "target": null, "type": null, "text": "直連。"}
{"id": null, "n": null, "target": null, "type": null, "text": "居郎。"}
{"id": null, "n": null, "target": null, "type": null, "text": "條。"}
{"id": null, "n": null, "target": null, "type": null, "text": "存。"}
{"id": null, "n": null, "target": null, "type": null, "text": "徒吊。"}
{"id": null, "n": null, "target": null, "type": null, "text": "吐調"}
{"id": null, "n": null, "target": null, "type": null, "text": "上毗。"}
{"id": null, "n": null, "target": null, "type": null, "text": "古恊。"}
{"id": null, "n": null, "target": null, "type": null, "text": "許及。"}
{"id": null, "n": null, "target": null, "type": null, "text": "神紙。"}
{"id": null, "n": null, "target": null, "type": null, "text": "愽下。"}
{"id": null, "n": null, "target": null, "type": null, "text": "奇逆。"}
{"id": null, "n": null, "target": null, "type": null, "text": "謀。"}
{"id": null, "n": null, "target": null, "type": null, "text": "直略。"}
{"id": null, "n": null, "target": null, "type": null, "text": "郎計。"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒀交。"}
{"id": null, "n": null, "target": null, "type": null, "text": "平呼"}
{"id": null, "n": null, "target": null, "type": null, "text": "教光"}
{"id": null, "n": null, "target": null, "type": null, "text": "教光"}
{"id": null, "n": null, "target": null, "type": null, "text": "教光"}
