{"id": null, "n": "0490004", "target": "#nkr_note_mod_0490004", "type": "mod", "text": "大英博物館藏燉煌本 S. 1358【敦】，同別本 S. 246.2【聖乙】"}
{"id": null, "n": "0490005", "target": "#nkr_note_mod_0490005", "type": "mod", "text": "言【大】，曰【聖乙】"}
{"id": null, "n": "0490006", "target": "#nkr_note_mod_0490006", "type": "mod", "text": "轉【大】，〔－〕【聖乙】"}
{"id": null, "n": "0490007", "target": "#nkr_note_mod_0490007", "type": "mod", "text": "流【大】，輪【聖乙】"}
{"id": null, "n": "0491001", "target": "#nkr_note_mod_0491001", "type": "mod", "text": "如是【大】，〔－〕【聖乙】"}
{"id": null, "n": "0491002", "target": "#nkr_note_mod_0491002", "type": "mod", "text": "燈【大】，燈像【聖乙】"}
{"id": null, "n": "0491003", "target": "#nkr_note_mod_0491003", "type": "mod", "text": "想【CB】【聖乙】，相【大】"}
{"id": null, "n": "0491004", "target": "#nkr_note_mod_0491004", "type": "mod", "text": "彼【大】，滅【聖乙】"}
{"id": null, "n": "0491005", "target": "#nkr_note_mod_0491005", "type": "mod", "text": "相【大】，於【聖乙】"}
{"id": null, "n": "0491006", "target": "#nkr_note_mod_0491006", "type": "mod", "text": "頌【CB】【聖乙】，訟【大】"}
{"id": null, "n": "0491007", "target": "#nkr_note_mod_0491007", "type": "mod", "text": "見【大】，遣【聖乙】"}
{"id": null, "n": "0491008", "target": "#nkr_note_mod_0491008", "type": "mod", "text": "如【大】，而【聖乙】"}
{"id": null, "n": "0490004", "target": "#nkr_note_orig_0490004", "type": "orig", "text": "大英博物館藏燉煌本 S. 1358【敦】，同別本 S. 246.2【聖乙】"}
{"id": null, "n": "0490005", "target": "#nkr_note_orig_0490005", "type": "orig", "text": "言＝曰【聖乙】"}
{"id": null, "n": "0490006", "target": "#nkr_note_orig_0490006", "type": "orig", "text": "〔轉〕－【聖乙】"}
{"id": null, "n": "0490007", "target": "#nkr_note_orig_0490007", "type": "orig", "text": "流＝輪【聖乙】"}
{"id": null, "n": "0491001", "target": "#nkr_note_orig_0491001", "type": "orig", "text": "〔如是〕－【聖乙】"}
{"id": null, "n": "0491002", "target": "#nkr_note_orig_0491002", "type": "orig", "text": "燈＋（像）【聖乙】"}
{"id": null, "n": "0491003", "target": "#nkr_note_orig_0491003", "type": "orig", "text": "相＝想【聖乙】"}
{"id": null, "n": "0491004", "target": "#nkr_note_orig_0491004", "type": "orig", "text": "彼＝滅【聖乙】"}
{"id": null, "n": "0491005", "target": "#nkr_note_orig_0491005", "type": "orig", "text": "相＝於【聖乙】"}
{"id": null, "n": "0491006", "target": "#nkr_note_orig_0491006", "type": "orig", "text": "訟＝頌【聖乙】"}
{"id": null, "n": "0491007", "target": "#nkr_note_orig_0491007", "type": "orig", "text": "見＝遣【聖乙】"}
{"id": null, "n": "0491008", "target": "#nkr_note_orig_0491008", "type": "orig", "text": "如＝而【聖乙】"}
{"id": null, "n": "0490b0201", "target": "#nkr_note_add_0490b0201", "type": "add", "text": "皆【CB】，習【大】"}
{"id": null, "n": "0491a2001", "target": "#nkr_note_add_0491a2001", "type": "add", "text": "愚【CB】，遇【大】"}
