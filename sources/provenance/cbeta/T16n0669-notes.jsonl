{"id": null, "n": "0469014", "target": "#nkr_note_mod_0469014", "type": "mod", "text": "不【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0469015", "target": "#nkr_note_mod_0469015", "type": "mod", "text": "相【大】，不相【宋】【元】【明】【宮】"}
{"id": null, "n": "0470001", "target": "#nkr_note_mod_0470001", "type": "mod", "text": "等【大】，等悉無罣礙【元】【明】"}
{"id": null, "n": "0470002", "target": "#nkr_note_mod_0470002", "type": "mod", "text": "過一異【大】∞過覺觀境界【宋】【元】【明】【宮】"}
{"id": null, "n": "0470003", "target": "#nkr_note_mod_0470003", "type": "mod", "text": "過覺觀境界【大】∞過一異【宋】【元】【明】【宮】"}
{"id": null, "n": "0470004", "target": "#nkr_note_mod_0470004", "type": "mod", "text": "有【大】，育【宮】"}
