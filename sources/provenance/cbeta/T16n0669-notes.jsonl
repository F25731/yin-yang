{"id": null, "n": "0475005", "target": "#nkr_note_mod_0475005", "type": "mod", "text": "妙【大】，如【宋】【元】【明】【宮】"}
{"id": null, "n": "0475006", "target": "#nkr_note_mod_0475006", "type": "mod", "text": "者【大】，〔－〕【宮】"}
