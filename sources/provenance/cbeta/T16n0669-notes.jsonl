{"id": null, "n": "0475011", "target": "#nkr_note_mod_0475011", "type": "mod", "text": "非【大】，非圓【宋】【元】【明】，非員【宮】"}
{"id": null, "n": "0475012", "target": "#nkr_note_mod_0475012", "type": "mod", "text": "解脫【大】＊，無解脫【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0475013", "target": "#nkr_note_mod_0475013", "type": "mod", "text": "減【大】＊，減失【宋】【元】【明】【宮】＊"}
