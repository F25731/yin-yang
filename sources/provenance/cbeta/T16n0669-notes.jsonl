{"id": null, "n": "0477005", "target": "#nkr_note_mod_0477005", "type": "mod", "text": "負【大】，貧【元】【明】"}
{"id": null, "n": "0477006", "target": "#nkr_note_mod_0477006", "type": "mod", "text": "厚【大】，友【元】【明】"}
{"id": null, "n": "0477007", "target": "#nkr_note_mod_0477007", "type": "mod", "text": "埳【大】，坑【元】【明】，坎【宮】"}
{"id": null, "n": "0477008", "target": "#nkr_note_mod_0477008", "type": "mod", "text": "囑累【大】，付囑【宋】【元】【明】【宮】"}
{"id": null, "n": "0477009", "target": "#nkr_note_mod_0477009", "type": "mod", "text": "王【大】，玉【宮】"}
