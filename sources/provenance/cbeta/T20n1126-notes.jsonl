{"id": null, "n": "0539016", "target": "#nkr_note_mod_0539016", "type": "mod", "text": "西【大】，宋西【明】"}
{"id": null, "n": "0539017", "target": "#nkr_note_mod_0539017", "type": "mod", "text": "譯經【大】，〔－〕【明】"}
{"id": null, "n": "0539018", "target": "#nkr_note_mod_0539018", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0539019", "target": "#nkr_note_mod_0539019", "type": "mod", "text": "普【大】，答【宋】"}
{"id": null, "n": "0539020", "target": "#nkr_note_mod_0539020", "type": "mod", "text": "現【大】，見【宋】【元】【明】"}
{"id": null, "n": "0539021", "target": "#nkr_note_mod_0539021", "type": "mod", "text": "已【大】，以【明】"}
{"id": null, "n": "0540001", "target": "#nkr_note_mod_0540001", "type": "mod", "text": "振【大】＊，震【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0540002", "target": "#nkr_note_mod_0540002", "type": "mod", "text": "縛【大】，嚩【元】【明】"}
{"id": null, "n": "0540003", "target": "#nkr_note_mod_0540003", "type": "mod", "text": "曰【大】，〔－〕【明】"}
{"id": null, "n": "0541001", "target": "#nkr_note_mod_0541001", "type": "mod", "text": "剎【大】，利【元】【明】"}
{"id": null, "n": "0541002", "target": "#nkr_note_mod_0541002", "type": "mod", "text": "即【大】，〔－〕【明】"}
{"id": null, "n": "0539015", "target": "#nkr_note_orig_0539015", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0539016", "target": "#nkr_note_orig_0539016", "type": "orig", "text": "（宋）＋西【明】"}
{"id": null, "n": "0539017", "target": "#nkr_note_orig_0539017", "type": "orig", "text": "〔譯經〕－【明】"}
{"id": null, "n": "0539018", "target": "#nkr_note_orig_0539018", "type": "orig", "text": "〔臣〕－【明】"}
{"id": null, "n": "0539019", "target": "#nkr_note_orig_0539019", "type": "orig", "text": "普＝答【宋】"}
{"id": null, "n": "0539020", "target": "#nkr_note_orig_0539020", "type": "orig", "text": "現＝見【三】"}
{"id": null, "n": "0539021", "target": "#nkr_note_orig_0539021", "type": "orig", "text": "已＝以【明】"}
{"id": null, "n": "0540001", "target": "#nkr_note_orig_0540001", "type": "orig", "text": "振＝震【三】＊"}
{"id": null, "n": "0540002", "target": "#nkr_note_orig_0540002", "type": "orig", "text": "縛＝嚩【元】【明】"}
{"id": null, "n": "0540003", "target": "#nkr_note_orig_0540003", "type": "orig", "text": "〔曰〕－【明】"}
{"id": null, "n": "0541001", "target": "#nkr_note_orig_0541001", "type": "orig", "text": "剎＝利【元】【明】"}
{"id": null, "n": "0541002", "target": "#nkr_note_orig_0541002", "type": "orig", "text": "〔即〕－【明】"}
