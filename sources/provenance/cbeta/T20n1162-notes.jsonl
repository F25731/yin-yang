{"id": null, "n": null, "target": null, "type": null, "text": "去聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "去聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "與唐不空雨寶經及趙宋法天吉祥持世經同"}
{"id": null, "n": "0666005", "target": "#nkr_note_mod_0666005", "type": "mod", "text": "持【大】，佛說持【元】【明】，【原】麗本，題名 Vasudhāra-dhāraṇī. 東京帝國大學所藏梵本 No. 261. Mo. 272. 梵本與漢譯不合致"}
{"id": null, "n": "0666006", "target": "#nkr_note_mod_0666006", "type": "mod", "text": "經【大】，經與唐不空雨寶經及趙宋法天吉祥持世經同【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "與唐不空雨寶經及趙宋法天吉祥持世經同"}
{"id": null, "n": "0666007", "target": "#nkr_note_mod_0666007", "type": "mod", "text": "大【大】，〔－〕【宋】【明】"}
{"id": null, "n": "0666010", "target": "#nkr_note_mod_0666010", "type": "mod", "text": "礫【大】，磔【宋】【元】【明】"}
{"id": null, "n": "0666011", "target": "#nkr_note_mod_0666011", "type": "mod", "text": "薩【大】，薩過【宋】【元】【明】"}
{"id": null, "n": "0666013", "target": "#nkr_note_mod_0666013", "type": "mod", "text": "韻【大】，願【宋】【元】【明】"}
{"id": null, "n": "0666014", "target": "#nkr_note_mod_0666014", "type": "mod", "text": "令【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0666015", "target": "#nkr_note_mod_0666015", "type": "mod", "text": "請【大】，說【宋】【元】【明】"}
{"id": null, "n": "0667002", "target": "#nkr_note_mod_0667002", "type": "mod", "text": "神呪【大】，呪神【宋】【元】【明】"}
{"id": null, "n": "0667003", "target": "#nkr_note_mod_0667003", "type": "mod", "text": "呾姪他【大】，〔－〕【宋】【元】【明】，梵字真言 cf. P. 669a [01]"}
{"id": null, "n": "0667004", "target": "#nkr_note_mod_0667004", "type": "mod", "text": "喝【大】＊，嗢【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0667005", "target": "#nkr_note_mod_0667005", "type": "mod", "text": "呾他揭多薩點【大】∞娑揭洛昵懼衫呾他揭耽頞奴颯沫洛【宋】【元】【明】"}
{"id": null, "n": "0667006", "target": "#nkr_note_mod_0667006", "type": "mod", "text": "娑揭洛昵懼衫呾他揭耽頞奴颯沫洛【大】∞呾他揭多薩點【宋】【元】【明】"}
{"id": null, "n": "0667007", "target": "#nkr_note_mod_0667007", "type": "mod", "text": "制【大】，刺【宋】【元】【明】"}
{"id": null, "n": "0667008", "target": "#nkr_note_mod_0667008", "type": "mod", "text": "絰【大】，經【宋】"}
{"id": null, "n": "0667009", "target": "#nkr_note_mod_0667009", "type": "mod", "text": "沫【大】，沫洛【宋】【元】【明】"}
{"id": null, "n": "0667010", "target": "#nkr_note_mod_0667010", "type": "mod", "text": "末【大】，來【宋】【元】【明】"}
{"id": null, "n": "0667011", "target": "#nkr_note_mod_0667011", "type": "mod", "text": "雨【大】，護【宋】【明】"}
{"id": null, "n": "0667012", "target": "#nkr_note_mod_0667012", "type": "mod", "text": "覺【大】，等【宋】【元】【明】"}
{"id": null, "n": "0667013", "target": "#nkr_note_mod_0667013", "type": "mod", "text": "陀【大】，他【宋】【元】【明】"}
{"id": null, "n": "0667014", "target": "#nkr_note_mod_0667014", "type": "mod", "text": "行【大】，持【宋】【元】【明】"}
{"id": null, "n": "0666005", "target": "#nkr_note_orig_0666005", "type": "orig", "text": "【原】麗本，題名 Vasudhāra-dhāraṇī. 東京帝國大學所藏梵本 No. 261. Mo. 272. 梵本與漢譯不合致，（佛說）＋持【元】【明】"}
{"id": null, "n": "0666006", "target": "#nkr_note_orig_0666006", "type": "orig", "text": "經＋（與唐不空雨寶經及趙宋法天吉祥持世經同）十八字細註【明】"}
{"id": null, "n": "0666007", "target": "#nkr_note_orig_0666007", "type": "orig", "text": "〔大〕－【宋】【明】"}
{"id": null, "n": "0666008", "target": "#nkr_note_orig_0666008", "type": "orig", "text": "Kauśambī."}
{"id": null, "n": "0666009", "target": "#nkr_note_orig_0666009", "type": "orig", "text": "Kaṇṭaka."}
{"id": null, "n": "0666010", "target": "#nkr_note_orig_0666010", "type": "orig", "text": "礫＝磔【三】"}
{"id": null, "n": "0666011", "target": "#nkr_note_orig_0666011", "type": "orig", "text": "薩＋（過）【三】"}
{"id": null, "n": "0666012", "target": "#nkr_note_orig_0666012", "type": "orig", "text": "妙月 Sucandra."}
{"id": null, "n": "0666013", "target": "#nkr_note_orig_0666013", "type": "orig", "text": "韻＝願【三】"}
{"id": null, "n": "0666014", "target": "#nkr_note_orig_0666014", "type": "orig", "text": "〔令〕－【三】"}
{"id": null, "n": "0666015", "target": "#nkr_note_orig_0666015", "type": "orig", "text": "請＝說【三】"}
{"id": null, "n": "0667001", "target": "#nkr_note_orig_0667001", "type": "orig", "text": "金剛海音如來 Śrī-vajra-dhara-sāgara-nirghosa."}
{"id": null, "n": "0667002", "target": "#nkr_note_orig_0667002", "type": "orig", "text": "神呪＝呪神【三】"}
{"id": null, "n": "0667003", "target": "#nkr_note_orig_0667003", "type": "orig", "text": "梵字真言 cf. P. 669a [01]，〔呾姪他〕－【三】"}
{"id": null, "n": "0667004", "target": "#nkr_note_orig_0667004", "type": "orig", "text": "喝＝嗢【三】＊"}
{"id": null, "n": "0667005", "target": "#nkr_note_orig_0667005", "type": "orig", "text": "（咀他…點）六字∞（娑揭…洛）十五字【三】"}
{"id": null, "n": "0667006", "target": "#nkr_note_orig_0667006", "type": "orig", "text": "（咀他…點）六字∞（娑揭…洛）十五字【三】"}
{"id": null, "n": "0667007", "target": "#nkr_note_orig_0667007", "type": "orig", "text": "制＝刺【三】"}
{"id": null, "n": "0667008", "target": "#nkr_note_orig_0667008", "type": "orig", "text": "絰＝經【宋】"}
{"id": null, "n": "0667009", "target": "#nkr_note_orig_0667009", "type": "orig", "text": "沫＋（洛）【三】"}
{"id": null, "n": "0667010", "target": "#nkr_note_orig_0667010", "type": "orig", "text": "末＝來【三】"}
{"id": null, "n": "0667011", "target": "#nkr_note_orig_0667011", "type": "orig", "text": "雨＝護【宋】【明】"}
{"id": null, "n": "0667012", "target": "#nkr_note_orig_0667012", "type": "orig", "text": "覺＝等【三】"}
{"id": null, "n": "0667013", "target": "#nkr_note_orig_0667013", "type": "orig", "text": "陀＝他【三】"}
{"id": null, "n": "0667014", "target": "#nkr_note_orig_0667014", "type": "orig", "text": "行＝持【三】"}
