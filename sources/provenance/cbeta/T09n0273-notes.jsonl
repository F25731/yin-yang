{"id": null, "n": null, "target": null, "type": "cf1", "text": "《福州藏》（日本宮內廳書陵部藏本第2155號第8葉第14行）"}
{"id": null, "n": "0365017", "target": "#nkr_note_mod_0365017", "type": "mod", "text": "序品第一【大】，卷上【宋】【元】【明】【宮】"}
{"id": null, "n": "0365018", "target": "#nkr_note_mod_0365018", "type": "mod", "text": "北涼失譯人名【大】，北涼失譯【宋】【宮】，出北涼錄失譯師名【元】【明】"}
{"id": null, "n": "0365019", "target": "#nkr_note_mod_0365019", "type": "mod", "text": "如【大】，序品第一如【宋】【元】【明】【宮】"}
{"id": null, "n": "0366001", "target": "#nkr_note_mod_0366001", "type": "mod", "text": "行【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0366002", "target": "#nkr_note_mod_0366002", "type": "mod", "text": "尊者大眾【大】，世尊四眾【元】【明】"}
{"id": null, "n": "0366003", "target": "#nkr_note_mod_0366003", "type": "mod", "text": "加【大】下同，跏【宋】【明】【宮】下同"}
{"id": null, "n": "0366004", "target": "#nkr_note_mod_0366004", "type": "mod", "text": "䠒【大】下同，胡【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0366005", "target": "#nkr_note_mod_0366005", "type": "mod", "text": "重【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0366006", "target": "#nkr_note_mod_0366006", "type": "mod", "text": "佛諸【大】，諸佛【宋】【元】【明】【宮】"}
{"id": null, "n": "0366007", "target": "#nkr_note_mod_0366007", "type": "mod", "text": "芽【大】，牙【宋】【宮】"}
{"id": null, "n": "0366008", "target": "#nkr_note_mod_0366008", "type": "mod", "text": "味【大】，昧【宋】【元】【明】【宮】"}
{"id": null, "n": "0366009", "target": "#nkr_note_mod_0366009", "type": "mod", "text": "金剛三昧經【大】＊，〔－〕【明】＊"}
{"id": null, "n": "0366010", "target": "#nkr_note_mod_0366010", "type": "mod", "text": "尊者【大】，世尊【元】【明】"}
{"id": null, "n": "0366011", "target": "#nkr_note_mod_0366011", "type": "mod", "text": "世【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0366012", "target": "#nkr_note_mod_0366012", "type": "mod", "text": "諦聽【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0366013", "target": "#nkr_note_mod_0366013", "type": "mod", "text": "滅【大】，生【元】【明】"}
{"id": null, "n": "0366014", "target": "#nkr_note_mod_0366014", "type": "mod", "text": "生【大】，滅【明】"}
{"id": null, "n": "0366015", "target": "#nkr_note_mod_0366015", "type": "mod", "text": "諸法【大】，法相【宋】【元】【明】【宮】"}
{"id": null, "n": "0366016", "target": "#nkr_note_mod_0366016", "type": "mod", "text": "（見法滅…見）八字【大】，〔－〕【宮】"}
{"id": null, "n": "0366017", "target": "#nkr_note_mod_0366017", "type": "mod", "text": "真【大】，真源【宋】【元】【明】【宮】"}
{"id": null, "n": "0366018", "target": "#nkr_note_mod_0366018", "type": "mod", "text": "性【大】，寂【宋】【元】【明】【宮】"}
{"id": null, "n": "0366019", "target": "#nkr_note_mod_0366019", "type": "mod", "text": "也【大】＊，耶【元】【明】＊"}
{"id": null, "n": "0367001", "target": "#nkr_note_mod_0367001", "type": "mod", "text": "止【大】，比【宋】"}
{"id": null, "n": "0367002", "target": "#nkr_note_mod_0367002", "type": "mod", "text": "相【大】，想【元】【明】"}
{"id": null, "n": "0367003", "target": "#nkr_note_mod_0367003", "type": "mod", "text": "身【大】，心【元】【明】"}
{"id": null, "n": "0367004", "target": "#nkr_note_mod_0367004", "type": "mod", "text": "若人【大】，善入【宋】【元】【明】【宮】"}
{"id": null, "n": "0367005", "target": "#nkr_note_mod_0367005", "type": "mod", "text": "志【大】，至【宋】【元】【明】【宮】"}
{"id": null, "n": "0367006", "target": "#nkr_note_mod_0367006", "type": "mod", "text": "俱【大】，具【宋】【元】【明】【宮】"}
{"id": null, "n": "0367007", "target": "#nkr_note_mod_0367007", "type": "mod", "text": "太【大】，大【宮】"}
{"id": null, "n": "0367008", "target": "#nkr_note_mod_0367008", "type": "mod", "text": "忍【大】，住【宮】"}
{"id": null, "n": "0367009", "target": "#nkr_note_mod_0367009", "type": "mod", "text": "不【大】，〔－〕【宮】"}
{"id": null, "n": "0367010", "target": "#nkr_note_mod_0367010", "type": "mod", "text": "所【大】，處所【宋】【元】【明】"}
{"id": null, "n": "0367011", "target": "#nkr_note_mod_0367011", "type": "mod", "text": "般若【大】，〔－〕【元】【明】"}
{"id": null, "n": "0367012", "target": "#nkr_note_mod_0367012", "type": "mod", "text": "無生無行【大】，是無生行【宋】【元】【明】，無生行【宮】"}
{"id": null, "n": "0367013", "target": "#nkr_note_mod_0367013", "type": "mod", "text": "也【大】，〔－〕【宮】"}
{"id": null, "n": "0368001", "target": "#nkr_note_mod_0368001", "type": "mod", "text": "可【大】，所【宋】【元】【明】"}
{"id": null, "n": "0368002", "target": "#nkr_note_mod_0368002", "type": "mod", "text": "諸識【大】，識諸【宮】"}
{"id": null, "n": "0368003", "target": "#nkr_note_mod_0368003", "type": "mod", "text": "識【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0368004", "target": "#nkr_note_mod_0368004", "type": "mod", "text": "之【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0368005", "target": "#nkr_note_mod_0368005", "type": "mod", "text": "行菩薩【大】，菩薩行【宋】，行【元】【明】【宮】"}
{"id": null, "n": "0368006", "target": "#nkr_note_mod_0368006", "type": "mod", "text": "已【大】，以【宋】，〔－〕【元】【明】【宮】"}
{"id": null, "n": "0368007", "target": "#nkr_note_mod_0368007", "type": "mod", "text": "則【大】，即【宋】【元】【明】【宮】"}
{"id": null, "n": "0368008", "target": "#nkr_note_mod_0368008", "type": "mod", "text": "三行三戒【大】，三受等三【宋】【元】【明】，等三受【宮】"}
{"id": null, "n": "0368009", "target": "#nkr_note_mod_0368009", "type": "mod", "text": "住【大】，行【宋】【元】【明】【宮】"}
{"id": null, "n": "0368010", "target": "#nkr_note_mod_0368010", "type": "mod", "text": "本【大】，亦【宋】【元】【明】【宮】"}
{"id": null, "n": "0368011", "target": "#nkr_note_mod_0368011", "type": "mod", "text": "千界【大】，大千界【宋】【元】【明】【宮】"}
{"id": null, "n": "0368012", "target": "#nkr_note_mod_0368012", "type": "mod", "text": "庵【大】下同，唵【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0368013", "target": "#nkr_note_mod_0368013", "type": "mod", "text": "八【大】，切【元】【明】"}
{"id": null, "n": "0368014", "target": "#nkr_note_mod_0368014", "type": "mod", "text": "有【大】，言【宋】【元】【明】【宮】"}
{"id": null, "n": "0368015", "target": "#nkr_note_mod_0368015", "type": "mod", "text": "有【大】，言【宋】【宮】"}
{"id": null, "n": "0368016", "target": "#nkr_note_mod_0368016", "type": "mod", "text": "可【大】，〔－〕【宮】"}
{"id": null, "n": "0368017", "target": "#nkr_note_mod_0368017", "type": "mod", "text": "清淨【大】，〔－〕【宮】"}
{"id": null, "n": "0368018", "target": "#nkr_note_mod_0368018", "type": "mod", "text": "處【大】，處所【宋】【元】【明】【宮】"}
{"id": null, "n": "0368019", "target": "#nkr_note_mod_0368019", "type": "mod", "text": "止【大】，上【宋】【宮】"}
{"id": null, "n": "0368020", "target": "#nkr_note_mod_0368020", "type": "mod", "text": "利本覺【大】，覺利本【宋】【元】【明】【宮】"}
{"id": null, "n": "0368021", "target": "#nkr_note_mod_0368021", "type": "mod", "text": "本【CB】【房山-CB】【金藏乙-CB】【宋】【元】【明】【宮】，覺本無異【大】"}
{"id": null, "n": "0369001", "target": "#nkr_note_mod_0369001", "type": "mod", "text": "無【大】，無生【元】【明】"}
{"id": null, "n": "0369002", "target": "#nkr_note_mod_0369002", "type": "mod", "text": "無着【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0369003", "target": "#nkr_note_mod_0369003", "type": "mod", "text": "說【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0369004", "target": "#nkr_note_mod_0369004", "type": "mod", "text": "但【大】，俱【宋】【元】【明】【宮】"}
{"id": null, "n": "0369005", "target": "#nkr_note_mod_0369005", "type": "mod", "text": "神乳【大】，神孔【宮】"}
{"id": null, "n": "0369006", "target": "#nkr_note_mod_0369006", "type": "mod", "text": "性非有無【大】，法相非無【宮】"}
{"id": null, "n": "0369007", "target": "#nkr_note_mod_0369007", "type": "mod", "text": "測【大】，惻【宋】【元】【明】【宮】"}
{"id": null, "n": "0369008", "target": "#nkr_note_mod_0369008", "type": "mod", "text": "空相【大】，住相【宮】"}
{"id": null, "n": "0369009", "target": "#nkr_note_mod_0369009", "type": "mod", "text": "有不住有【大】，〔－〕【宮】"}
{"id": null, "n": "0369010", "target": "#nkr_note_mod_0369010", "type": "mod", "text": "不無不有【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0369011", "target": "#nkr_note_mod_0369011", "type": "mod", "text": "如相【大】，〔－〕【宮】"}
{"id": null, "n": "0369012", "target": "#nkr_note_mod_0369012", "type": "mod", "text": "如相【大】，如如相【宮】"}
{"id": null, "n": "0369013", "target": "#nkr_note_mod_0369013", "type": "mod", "text": "菩【大】，善【宋】"}
{"id": null, "n": "0369014", "target": "#nkr_note_mod_0369014", "type": "mod", "text": "有為【大】，〔－〕【宮】"}
{"id": null, "n": "0369015", "target": "#nkr_note_mod_0369015", "type": "mod", "text": "是【大】，〔－〕【宮】"}
{"id": null, "n": "0369016", "target": "#nkr_note_mod_0369016", "type": "mod", "text": "義無【大】，〔－〕【宮】"}
{"id": null, "n": "0369017", "target": "#nkr_note_mod_0369017", "type": "mod", "text": "無如【大】，有如【宮】"}
{"id": null, "n": "0369018", "target": "#nkr_note_mod_0369018", "type": "mod", "text": "住【大】，相【宋】【元】【明】【宮】"}
{"id": null, "n": "0370001", "target": "#nkr_note_mod_0370001", "type": "mod", "text": "如是心法【大】，如心之性【宮】"}
{"id": null, "n": "0370002", "target": "#nkr_note_mod_0370002", "type": "mod", "text": "乘【大】，〔－〕【宮】"}
{"id": null, "n": "0370003", "target": "#nkr_note_mod_0370003", "type": "mod", "text": "知【大】，如【宮】"}
{"id": null, "n": "0370004", "target": "#nkr_note_mod_0370004", "type": "mod", "text": "令【大】，今【宮】"}
{"id": null, "n": "0370005", "target": "#nkr_note_mod_0370005", "type": "mod", "text": "淨【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0370006", "target": "#nkr_note_mod_0370006", "type": "mod", "text": "心【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0370007", "target": "#nkr_note_mod_0370007", "type": "mod", "text": "觀【大】，觀心【宋】【元】【明】【宮】"}
{"id": null, "n": "0370008", "target": "#nkr_note_mod_0370008", "type": "mod", "text": "在【大】，住【宋】【元】【明】"}
{"id": null, "n": "0370009", "target": "#nkr_note_mod_0370009", "type": "mod", "text": "家【大】，家故【宋】【元】【明】【宮】"}
{"id": null, "n": "0370010", "target": "#nkr_note_mod_0370010", "type": "mod", "text": "〔－〕【CB】【磧乙-CB】【宋】【元】【明】【宮】，而【大】"}
{"id": null, "n": "0370011", "target": "#nkr_note_mod_0370011", "type": "mod", "text": "一地【CB】【磧乙-CB】【宋】【元】【明】【宮】，地【大】"}
{"id": null, "n": "0370012", "target": "#nkr_note_mod_0370012", "type": "mod", "text": "我【大】，乘【宋】【元】【明】"}
{"id": null, "n": "0370013", "target": "#nkr_note_mod_0370013", "type": "mod", "text": "六【大】，八【宮】"}
{"id": null, "n": "0370014", "target": "#nkr_note_mod_0370014", "type": "mod", "text": "於果足滿【大】，果滿於足【宋】【元】【明】，於果滿足【宮】"}
{"id": null, "n": "0370015", "target": "#nkr_note_mod_0370015", "type": "mod", "text": "發【大】，而發【宋】【元】【明】【宮】"}
{"id": null, "n": "0370016", "target": "#nkr_note_mod_0370016", "type": "mod", "text": "界【大】，有【宋】【元】【明】【宮】"}
{"id": null, "n": "0370017", "target": "#nkr_note_mod_0370017", "type": "mod", "text": "波【大】，般【宋】【元】【明】【宮】"}
{"id": null, "n": "0370018", "target": "#nkr_note_mod_0370018", "type": "mod", "text": "苦【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0370019", "target": "#nkr_note_mod_0370019", "type": "mod", "text": "卷上終【宋】【元】【明】【宮】"}
{"id": null, "n": "0370020", "target": "#nkr_note_mod_0370020", "type": "mod", "text": "金剛三昧經【大】，〔－〕【宋】【元】【明】【宮】，卷下首"}
{"id": null, "n": "0371001", "target": "#nkr_note_mod_0371001", "type": "mod", "text": "議【大】，說【宋】【元】【明】【宮】"}
{"id": null, "n": "0371002", "target": "#nkr_note_mod_0371002", "type": "mod", "text": "如【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0371003", "target": "#nkr_note_mod_0371003", "type": "mod", "text": "說【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0371004", "target": "#nkr_note_mod_0371004", "type": "mod", "text": "起修同時【大】，起同時故【宮】"}
{"id": null, "n": "0371005", "target": "#nkr_note_mod_0371005", "type": "mod", "text": "義非有無【大】，非有非無【宋】【元】【明】【宮】"}
{"id": null, "n": "0371006", "target": "#nkr_note_mod_0371006", "type": "mod", "text": "相【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0371007", "target": "#nkr_note_mod_0371007", "type": "mod", "text": "利【大】，義【宋】【元】【明】【宮】"}
{"id": null, "n": "0371008", "target": "#nkr_note_mod_0371008", "type": "mod", "text": "四【大】，〔－〕【宮】"}
{"id": null, "n": "0371009", "target": "#nkr_note_mod_0371009", "type": "mod", "text": "金剛三昧經【大】＊，〔－〕【明】＊"}
{"id": null, "n": "0371010", "target": "#nkr_note_mod_0371010", "type": "mod", "text": "導【大】，道【宋】【宮】"}
{"id": null, "n": "0372001", "target": "#nkr_note_mod_0372001", "type": "mod", "text": "破病【大】，摧破【宋】【元】【明】【宮】"}
{"id": null, "n": "0372002", "target": "#nkr_note_mod_0372002", "type": "mod", "text": "除電覺際【大】，慧除電覺【宋】【元】【明】，除電覺【宮】"}
{"id": null, "n": "0372003", "target": "#nkr_note_mod_0372003", "type": "mod", "text": "佛【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0372004", "target": "#nkr_note_mod_0372004", "type": "mod", "text": "定【大】，如定【宋】【元】【明】【宮】"}
{"id": null, "n": "0372005", "target": "#nkr_note_mod_0372005", "type": "mod", "text": "海【大】，〔－〕【宮】"}
{"id": null, "n": "0372006", "target": "#nkr_note_mod_0372006", "type": "mod", "text": "無相【大】，無作【宮】"}
{"id": null, "n": "0372007", "target": "#nkr_note_mod_0372007", "type": "mod", "text": "無作【大】，無相【宮】"}
