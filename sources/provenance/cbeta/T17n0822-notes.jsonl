{"id": null, "n": "0847002", "target": "#nkr_note_mod_0847002", "type": "mod", "text": "即【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0847003", "target": "#nkr_note_mod_0847003", "type": "mod", "text": "臂【大】，肩【宮】"}
{"id": null, "n": "0847004", "target": "#nkr_note_mod_0847004", "type": "mod", "text": "白【大】，而白【宋】【元】【明】【宮】"}
{"id": null, "n": "0847005", "target": "#nkr_note_mod_0847005", "type": "mod", "text": "放【大】，故【宮】"}
{"id": null, "n": "0847006", "target": "#nkr_note_mod_0847006", "type": "mod", "text": "大【大】，天【宋】【元】【明】【宮】"}
{"id": null, "n": "0847007", "target": "#nkr_note_mod_0847007", "type": "mod", "text": "淨【大】，清【宮】"}
{"id": null, "n": "0847008", "target": "#nkr_note_mod_0847008", "type": "mod", "text": "菩提【大】，菩薩【宋】【元】【明】【宮】"}
