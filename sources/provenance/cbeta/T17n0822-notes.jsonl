{"id": null, "n": "0846001", "target": "#nkr_note_mod_0846001", "type": "mod", "text": "佛說【大】＊，〔－〕【宋】【元】【宮】＊"}
{"id": null, "n": "0846002", "target": "#nkr_note_mod_0846002", "type": "mod", "text": "宋【大】，劉宋【元】【明】"}
