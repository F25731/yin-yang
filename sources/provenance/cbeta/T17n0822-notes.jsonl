{"id": null, "n": "0847010", "target": "#nkr_note_mod_0847010", "type": "mod", "text": "車𤦲馬瑙【大】，硨磲碼碯【宋】【元】【明】【宮】"}
{"id": null, "n": "0847011", "target": "#nkr_note_mod_0847011", "type": "mod", "text": "兜率天子【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0847012", "target": "#nkr_note_mod_0847012", "type": "mod", "text": "皆【大】，生【宋】【元】【明】【宮】"}
{"id": null, "n": "0847013", "target": "#nkr_note_mod_0847013", "type": "mod", "text": "當得【大】，得作【宋】【元】【明】【宮】"}
