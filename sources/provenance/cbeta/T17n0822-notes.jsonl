{"id": null, "n": "0846005", "target": "#nkr_note_mod_0846005", "type": "mod", "text": "提【大】，崛【宋】【元】【明】【宮】"}
{"id": null, "n": "0846006", "target": "#nkr_note_mod_0846006", "type": "mod", "text": "唯【大】下同，惟【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0846007", "target": "#nkr_note_mod_0846007", "type": "mod", "text": "加【大】，跏【宋】【元】【明】【宮】"}
