{"id": null, "n": "0848003", "target": "#nkr_note_mod_0848003", "type": "mod", "text": "于【大】下同，於【明】下同"}
{"id": null, "n": "0848004", "target": "#nkr_note_mod_0848004", "type": "mod", "text": "體【大】＊，永【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0848005", "target": "#nkr_note_mod_0848005", "type": "mod", "text": "為【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0848006", "target": "#nkr_note_mod_0848006", "type": "mod", "text": "同事【大】，同利【宋】【宮】"}
{"id": null, "n": "0848007", "target": "#nkr_note_mod_0848007", "type": "mod", "text": "授【大】＊，受【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0848008", "target": "#nkr_note_mod_0848008", "type": "mod", "text": "慈心故【大】，慈悲心【宋】【元】【明】【宮】"}
{"id": null, "n": "0848009", "target": "#nkr_note_mod_0848009", "type": "mod", "text": "萬億【大】，億萬【宋】【元】【明】【宮】"}
{"id": null, "n": "0848010", "target": "#nkr_note_mod_0848010", "type": "mod", "text": "方【大】，方便【宋】【元】【明】【宮】"}
