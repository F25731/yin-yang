{"id": null, "n": null, "target": null, "type": null, "text": "上"}
{"id": null, "n": null, "target": null, "type": null, "text": "蘇合香稀者是"}
{"id": null, "n": null, "target": null, "type": null, "text": "出集經第六卷內與文殊根本經中呪同"}
{"id": null, "n": "0779018", "target": "#nkr_note_mod_0779018", "type": "mod", "text": "經【大】，經出集經第六卷內與文殊根本經中呪同【元】【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "出集經第六卷內與文殊根本經中呪同"}
{"id": null, "n": "0779019", "target": "#nkr_note_mod_0779019", "type": "mod", "text": "（南天…譯）十三字【大】，唐三藏菩提流支譯【宋】，大唐三藏法師菩提流支譯【元】，唐三藏法師菩提流支譯【明】"}
{"id": null, "n": "0779020", "target": "#nkr_note_mod_0779020", "type": "mod", "text": "能【大】＊，德【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0779021", "target": "#nkr_note_mod_0779021", "type": "mod", "text": "跏【大】＊，加【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0779022", "target": "#nkr_note_mod_0779022", "type": "mod", "text": "廂【大】＊，相【宋】＊"}
{"id": null, "n": "0779023", "target": "#nkr_note_mod_0779023", "type": "mod", "text": "洒【大】，洗【元】【明】"}
{"id": null, "n": "0779024", "target": "#nkr_note_mod_0779024", "type": "mod", "text": "佉【大】，佉陀【元】【明】"}
{"id": null, "n": "0780001", "target": "#nkr_note_mod_0780001", "type": "mod", "text": "此跋文宋元明三本俱無之"}
{"id": null, "n": "0779017", "target": "#nkr_note_orig_0779017", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0779018", "target": "#nkr_note_orig_0779018", "type": "orig", "text": "經＋（出集經第六卷內與文殊根本經中呪同）細註【元】【明】"}
{"id": null, "n": "0779019", "target": "#nkr_note_orig_0779019", "type": "orig", "text": "（南天…譯）十三字＝（唐三藏菩提流支譯）八字【宋】，（大唐三藏法師菩提流支譯）十一字【元】，（唐三藏法師菩提流支譯）十字【明】"}
{"id": null, "n": "0779020", "target": "#nkr_note_orig_0779020", "type": "orig", "text": "能＝德【三】＊"}
{"id": null, "n": "0779021", "target": "#nkr_note_orig_0779021", "type": "orig", "text": "跏＝加【三】＊"}
{"id": null, "n": "0779022", "target": "#nkr_note_orig_0779022", "type": "orig", "text": "廂＝相【宋】＊"}
{"id": null, "n": "0779023", "target": "#nkr_note_orig_0779023", "type": "orig", "text": "洒＝洗【元】【明】"}
{"id": null, "n": "0779024", "target": "#nkr_note_orig_0779024", "type": "orig", "text": "佉＋（陀）【元】【明】"}
{"id": null, "n": "0780001", "target": "#nkr_note_orig_0780001", "type": "orig", "text": "此跋文宋元明三本俱無之"}
