{"id": null, "n": "0535007", "target": "#nkr_note_orig_0535007", "type": "orig", "text": "〔國〕－【元】【明】"}
{"id": null, "n": "0535008", "target": "#nkr_note_orig_0535008", "type": "orig", "text": "禪定起＝禪覺【宋】【宮】，復覺【元】【明】"}
{"id": null, "n": "0535009", "target": "#nkr_note_orig_0535009", "type": "orig", "text": "以＝已【元】【明】"}
{"id": null, "n": "0535010", "target": "#nkr_note_orig_0535010", "type": "orig", "text": "一鬼＝又一鬼【三】【宮】下同"}
{"id": null, "n": "0535011", "target": "#nkr_note_orig_0535011", "type": "orig", "text": "已＝以【宋】【宮】下同"}
{"id": null, "n": "0535012", "target": "#nkr_note_orig_0535012", "type": "orig", "text": "在＝入【三】【宮】＊"}
{"id": null, "n": "0535013", "target": "#nkr_note_orig_0535013", "type": "orig", "text": "客止方＝止客方【宋】【宮】，止客亦【元】【明】"}
{"id": null, "n": "0535014", "target": "#nkr_note_orig_0535014", "type": "orig", "text": "〔生〕－【三】【宮】"}
{"id": null, "n": "0535015", "target": "#nkr_note_orig_0535015", "type": "orig", "text": "盡便持去＝肉盡便去【三】，肉盡【宮】"}
{"id": null, "n": "0535016", "target": "#nkr_note_orig_0535016", "type": "orig", "text": "尋＝復【三】【宮】"}
{"id": null, "n": "0535017", "target": "#nkr_note_orig_0535017", "type": "orig", "text": "已＝以【宋】【元】【宮】"}
{"id": null, "n": "0536001", "target": "#nkr_note_orig_0536001", "type": "orig", "text": "〔能〕－【三】【宮】"}
{"id": null, "n": "0536002", "target": "#nkr_note_orig_0536002", "type": "orig", "text": "〔與〕－【三】【宮】"}
{"id": null, "n": "0536003", "target": "#nkr_note_orig_0536003", "type": "orig", "text": "〔中〕－【三】【宮】＊"}
{"id": null, "n": "0536004", "target": "#nkr_note_orig_0536004", "type": "orig", "text": "捉銅杓以＝提瓶以杓【三】【宮】"}
{"id": null, "n": "0536005", "target": "#nkr_note_orig_0536005", "type": "orig", "text": "（客）＋僧【三】【宮】"}
