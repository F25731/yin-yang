{"id": null, "n": "0535005", "target": "#nkr_note_mod_0535005", "type": "mod", "text": "佛說【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0535006", "target": "#nkr_note_mod_0535006", "type": "mod", "text": "安息國三藏【大】，三藏法師【宋】【宮】"}
{"id": null, "n": "0535007", "target": "#nkr_note_mod_0535007", "type": "mod", "text": "國【大】，〔－〕【元】【明】"}
{"id": null, "n": "0535008", "target": "#nkr_note_mod_0535008", "type": "mod", "text": "禪定起【大】，禪覺【宋】【宮】，復覺【元】【明】"}
{"id": null, "n": "0535009", "target": "#nkr_note_mod_0535009", "type": "mod", "text": "以【大】，已【元】【明】"}
{"id": null, "n": "0535010", "target": "#nkr_note_mod_0535010", "type": "mod", "text": "一鬼【大】下同，又一鬼【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0535011", "target": "#nkr_note_mod_0535011", "type": "mod", "text": "已【大】下同，以【宋】【宮】下同"}
{"id": null, "n": "0535012", "target": "#nkr_note_mod_0535012", "type": "mod", "text": "在【大】＊，入【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0535013", "target": "#nkr_note_mod_0535013", "type": "mod", "text": "止客亦【CB】【普寧-CB】【元】【明】，客止方【大】，止客方【宋】【宮】"}
{"id": null, "n": "0535014", "target": "#nkr_note_mod_0535014", "type": "mod", "text": "生【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0535015", "target": "#nkr_note_mod_0535015", "type": "mod", "text": "盡便持去【大】，肉盡便去【宋】【元】【明】，肉盡【宮】"}
{"id": null, "n": "0535016", "target": "#nkr_note_mod_0535016", "type": "mod", "text": "尋【大】，復【宋】【元】【明】【宮】"}
{"id": null, "n": "0535017", "target": "#nkr_note_mod_0535017", "type": "mod", "text": "已【大】，以【宋】【元】【宮】"}
{"id": null, "n": "0536001", "target": "#nkr_note_mod_0536001", "type": "mod", "text": "能【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0536002", "target": "#nkr_note_mod_0536002", "type": "mod", "text": "與【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0536003", "target": "#nkr_note_mod_0536003", "type": "mod", "text": "中【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0536004", "target": "#nkr_note_mod_0536004", "type": "mod", "text": "捉銅杓以【大】，提瓶以杓【宋】【元】【明】【宮】"}
{"id": null, "n": "0536005", "target": "#nkr_note_mod_0536005", "type": "mod", "text": "僧【大】，客僧【宋】【元】【明】【宮】"}
{"id": null, "n": "0536006", "target": "#nkr_note_mod_0536006", "type": "mod", "text": "復【大】，〔－〕【宮】"}
{"id": null, "n": "0536007", "target": "#nkr_note_mod_0536007", "type": "mod", "text": "祠【大】，祀【宋】【元】【宮】"}
{"id": null, "n": "0536008", "target": "#nkr_note_mod_0536008", "type": "mod", "text": "語【大】，師汝【宋】【元】【明】【宮】"}
{"id": null, "n": "0536009", "target": "#nkr_note_mod_0536009", "type": "mod", "text": "以【大】，已【宋】【元】【明】【宮】"}
{"id": null, "n": "0536010", "target": "#nkr_note_mod_0536010", "type": "mod", "text": "世【大】，世世【宋】【元】【明】【宮】"}
{"id": null, "n": "0535005", "target": "#nkr_note_orig_0535005", "type": "orig", "text": "〔佛說〕－【三】【宮】＊"}
