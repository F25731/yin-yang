{"id": null, "n": "0164012", "target": "#nkr_note_mod_0164012", "type": "mod", "text": "非【大】，作【元】【明】"}
{"id": null, "n": "0164013", "target": "#nkr_note_mod_0164013", "type": "mod", "text": "明【大】，眼【宋】【元】【明】【宮】"}
