{"id": null, "n": "0158009", "target": "#nkr_note_mod_0158009", "type": "mod", "text": "論中解十六諦【大】，〔－〕【宮】"}
{"id": null, "n": "0158010", "target": "#nkr_note_mod_0158010", "type": "mod", "text": "防夷反【大】，〔－〕【明】"}
