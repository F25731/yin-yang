{"id": null, "n": "0160002", "target": "#nkr_note_mod_0160002", "type": "mod", "text": "若【大】，苦【明】"}
{"id": null, "n": "0160003", "target": "#nkr_note_mod_0160003", "type": "mod", "text": "名【大】，各【宋】【元】【明】【宮】"}
