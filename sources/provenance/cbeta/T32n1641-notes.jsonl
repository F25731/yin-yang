{"id": null, "n": "0158013", "target": "#nkr_note_mod_0158013", "type": "mod", "text": "迦【大】，大迦【宋】【元】【明】【宮】"}
{"id": null, "n": "0158014", "target": "#nkr_note_mod_0158014", "type": "mod", "text": "牙【大】下同，芽【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0158015", "target": "#nkr_note_mod_0158015", "type": "mod", "text": "眼人【大】，人眼【宋】【元】【明】【宮】"}
{"id": null, "n": "0158016", "target": "#nkr_note_mod_0158016", "type": "mod", "text": "苦【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0158017", "target": "#nkr_note_mod_0158017", "type": "mod", "text": "義【大】，義而生老病死等恒相逼惱故苦三藏譬云【宋】【元】【明】【宮】"}
