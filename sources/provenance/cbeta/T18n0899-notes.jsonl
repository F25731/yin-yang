{"id": null, "n": "0777001", "target": "#nkr_note_mod_0777001", "type": "mod", "text": "主【大】，生【甲】"}
{"id": null, "n": "0777002", "target": "#nkr_note_mod_0777002", "type": "mod", "text": "切【大】，心【考偽-原】"}
