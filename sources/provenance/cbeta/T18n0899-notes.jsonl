{"id": null, "n": "0777006", "target": "#nkr_note_mod_0777006", "type": "mod", "text": "作【大】，何【甲】"}
{"id": null, "n": "0777005", "target": "#nkr_note_mod_0777005", "type": "mod", "text": "我白言【大】，言我言【甲】"}
{"id": null, "n": "0777004", "target": "#nkr_note_mod_0777004", "type": "mod", "text": "則【大】，即【考偽-原】"}
{"id": null, "n": "0778001", "target": "#nkr_note_mod_0778001", "type": "mod", "text": "及【CB】【甲】，反【大】"}
