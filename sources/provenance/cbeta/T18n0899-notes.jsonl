{"id": null, "n": "0779006", "target": "#nkr_note_mod_0779006", "type": "mod", "text": "身【大】，是【考偽-原】"}
{"id": null, "n": "0779007", "target": "#nkr_note_mod_0779007", "type": "mod", "text": "不【大】，不可具說【考偽-原】"}
