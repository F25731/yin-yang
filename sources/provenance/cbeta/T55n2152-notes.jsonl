{"id": null, "n": null, "target": null, "type": "cf1", "text": "K31n1060_p0956c12"}
{"id": null, "n": "0367014", "target": "#nkr_note_mod_0367014", "type": "mod", "text": "開元庚午歲【大】，唐【明】"}
{"id": null, "n": "0368001", "target": "#nkr_note_mod_0368001", "type": "mod", "text": "轉【大】，囀【宋】【元】"}
{"id": null, "n": "0368002", "target": "#nkr_note_mod_0368002", "type": "mod", "text": "譯【大】，出【宋】【元】【明】"}
{"id": null, "n": "0368003", "target": "#nkr_note_mod_0368003", "type": "mod", "text": "英【大】，菜【宋】"}
{"id": null, "n": "0368004", "target": "#nkr_note_mod_0368004", "type": "mod", "text": "烏【大】，焉【宋】【元】【明】"}
{"id": null, "n": "0368005", "target": "#nkr_note_mod_0368005", "type": "mod", "text": "涉【大】，妙【宋】【元】【明】"}
{"id": null, "n": "0368006", "target": "#nkr_note_mod_0368006", "type": "mod", "text": "遊【大】，達【宋】【元】【明】"}
{"id": null, "n": "0368007", "target": "#nkr_note_mod_0368007", "type": "mod", "text": "諸【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0368008", "target": "#nkr_note_mod_0368008", "type": "mod", "text": "茶【大】，荼【明】"}
{"id": null, "n": "0368009", "target": "#nkr_note_mod_0368009", "type": "mod", "text": "淩【大】＊，陵【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0368010", "target": "#nkr_note_mod_0368010", "type": "mod", "text": "故【大】，欲【宋】【元】【明】"}
{"id": null, "n": "0368011", "target": "#nkr_note_mod_0368011", "type": "mod", "text": "茶【大】，荼【宋】【元】【明】"}
{"id": null, "n": "0368012", "target": "#nkr_note_mod_0368012", "type": "mod", "text": "京【大】，〔－〕【明】"}
{"id": null, "n": "0368013", "target": "#nkr_note_mod_0368013", "type": "mod", "text": "二【大】，一【宋】【元】【明】"}
{"id": null, "n": "0368014", "target": "#nkr_note_mod_0368014", "type": "mod", "text": "譯【大】，譯語【宋】【元】【明】"}
{"id": null, "n": "0368015", "target": "#nkr_note_mod_0368015", "type": "mod", "text": "杜【大】，杜顗【宋】【元】【明】"}
{"id": null, "n": "0368016", "target": "#nkr_note_mod_0368016", "type": "mod", "text": "上皇【大】，皇上【宋】【元】【明】"}
{"id": null, "n": "0369001", "target": "#nkr_note_mod_0369001", "type": "mod", "text": "唐【大】＊，此【明】＊"}
{"id": null, "n": "0369002", "target": "#nkr_note_mod_0369002", "type": "mod", "text": "景【大】＊，丙【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0369003", "target": "#nkr_note_mod_0369003", "type": "mod", "text": "有【大】，所【宋】【元】【明】"}
{"id": null, "n": "0369004", "target": "#nkr_note_mod_0369004", "type": "mod", "text": "儭【大】，襯【元】【明】"}
{"id": null, "n": "0369005", "target": "#nkr_note_mod_0369005", "type": "mod", "text": "對【大】，對其【宋】【元】【明】"}
