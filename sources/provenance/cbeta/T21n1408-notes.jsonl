{"id": null, "n": "0922018", "target": null, "type": "orig", "text": "〔譯經〕－【明】"}
{"id": null, "n": "0922018", "target": null, "type": "mod", "text": "譯經【大】，〔－〕【明】"}
{"id": null, "n": "0922019", "target": null, "type": "orig", "text": "法＝教【明】"}
{"id": null, "n": "0922019", "target": null, "type": "mod", "text": "法【大】，教【明】"}
{"id": null, "n": "0922020", "target": null, "type": "orig", "text": "〔臣〕－【明】"}
{"id": null, "n": "0922020", "target": null, "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K34n1169_p0093b08"}
{"id": null, "n": "0922017", "target": "#nkr_note_mod_0922017", "type": "mod", "text": "西天譯經三藏朝散大夫試鴻臚少卿傳法大師臣【大】，三藏法師【宋】【元】，宋西天譯經三藏朝散大夫試鴻臚少卿傳法大師臣【明】"}
{"id": null, "n": "0922018", "target": "#nkr_note_mod_0922018", "type": "mod", "text": "譯經【大】，〔－〕【明】"}
{"id": null, "n": "0922019", "target": "#nkr_note_mod_0922019", "type": "mod", "text": "法【大】，教【明】"}
{"id": null, "n": "0922020", "target": "#nkr_note_mod_0922020", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0922021", "target": "#nkr_note_mod_0922021", "type": "mod", "text": "地【大】，他【宋】"}
{"id": null, "n": "0923001", "target": "#nkr_note_mod_0923001", "type": "mod", "text": "已【大】，以【元】【明】"}
{"id": null, "n": "0923002", "target": "#nkr_note_mod_0923002", "type": "mod", "text": "辰【大】，宿【明】"}
{"id": null, "n": "0923003", "target": "#nkr_note_mod_0923003", "type": "mod", "text": "志【大】，至【元】【明】"}
{"id": null, "n": "0923004", "target": "#nkr_note_mod_0923004", "type": "mod", "text": "振【大】，震【宋】【元】【明】"}
{"id": null, "n": "0923005", "target": "#nkr_note_mod_0923005", "type": "mod", "text": "二【大】，三【宋】【元】【明】"}
{"id": null, "n": "0923006", "target": "#nkr_note_mod_0923006", "type": "mod", "text": "茶【大】＊，荼【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0923007", "target": "#nkr_note_mod_0923007", "type": "mod", "text": "入【大】，引【明】"}
{"id": null, "n": "0923008", "target": "#nkr_note_mod_0923008", "type": "mod", "text": "里【大】，哩【明】"}
{"id": null, "n": "0923009", "target": "#nkr_note_mod_0923009", "type": "mod", "text": "𢜩【大】，憾【宋】【元】【明】"}
{"id": null, "n": "0923010", "target": "#nkr_note_mod_0923010", "type": "mod", "text": "努【大】，拏【宋】【元】【明】"}
{"id": null, "n": "0924001", "target": "#nkr_note_mod_0924001", "type": "mod", "text": "獲【大】，復【明】"}
{"id": null, "n": "0924002", "target": "#nkr_note_mod_0924002", "type": "mod", "text": "往【大】，住【宋】【元】【明】"}
{"id": null, "n": "0922016", "target": "#nkr_note_orig_0922016", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0922017", "target": "#nkr_note_orig_0922017", "type": "orig", "text": "（（西天…臣））二十字＝（（三藏法師））四字【宋】【元】，（宋）＋西【明】"}
