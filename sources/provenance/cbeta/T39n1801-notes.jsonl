{"id": null, "n": "0978001", "target": "#nkr_note_mod_0978001", "type": "mod", "text": "遍【大】，編【甲】"}
{"id": null, "n": "0983001", "target": "#nkr_note_mod_0983001", "type": "mod", "text": "意【大】，音【甲】"}
{"id": null, "n": "0987001", "target": "#nkr_note_mod_0987001", "type": "mod", "text": "叚【大】，假【甲】"}
{"id": null, "n": "0987002", "target": "#nkr_note_mod_0987002", "type": "mod", "text": "他【大】，地【甲】"}
{"id": null, "n": "0987003", "target": "#nkr_note_mod_0987003", "type": "mod", "text": "實【大】，寶【甲】"}
{"id": null, "n": "0988001", "target": "#nkr_note_mod_0988001", "type": "mod", "text": "又【大】，叉【甲】"}
{"id": null, "n": "0989001", "target": "#nkr_note_mod_0989001", "type": "mod", "text": "二十【大】，〔－〕【甲】"}
{"id": null, "n": "0996001", "target": "#nkr_note_mod_0996001", "type": "mod", "text": "并【大】，前【甲】"}
{"id": null, "n": "0996002", "target": "#nkr_note_mod_0996002", "type": "mod", "text": "即【大】，既【甲】"}
{"id": null, "n": "1001001", "target": "#nkr_note_mod_1001001", "type": "mod", "text": "審【大】，番【甲】"}
{"id": null, "n": "1002001", "target": "#nkr_note_mod_1002001", "type": "mod", "text": "若【大】，苦【甲】"}
{"id": null, "n": "0977001", "target": "#nkr_note_orig_0977001", "type": "orig", "text": "【原】清康熙三年八月刊增上寺報恩藏本，【甲】延寶五年刊大谷大學藏本"}
{"id": null, "n": "0978001", "target": "#nkr_note_orig_0978001", "type": "orig", "text": "遍＝編【甲】"}
{"id": null, "n": "0983001", "target": "#nkr_note_orig_0983001", "type": "orig", "text": "意＝音【甲】"}
{"id": null, "n": "0987001", "target": "#nkr_note_orig_0987001", "type": "orig", "text": "叚＝假【甲】"}
{"id": null, "n": "0987002", "target": "#nkr_note_orig_0987002", "type": "orig", "text": "他＝地【甲】"}
{"id": null, "n": "0987003", "target": "#nkr_note_orig_0987003", "type": "orig", "text": "實＝寶【甲】"}
{"id": null, "n": "0988001", "target": "#nkr_note_orig_0988001", "type": "orig", "text": "又＝叉【甲】"}
{"id": null, "n": "0989001", "target": "#nkr_note_orig_0989001", "type": "orig", "text": "〔二十〕－【甲】"}
{"id": null, "n": "0996001", "target": "#nkr_note_orig_0996001", "type": "orig", "text": "并＝前【甲】"}
{"id": null, "n": "0996002", "target": "#nkr_note_orig_0996002", "type": "orig", "text": "即＝既【甲】"}
{"id": null, "n": "1001001", "target": "#nkr_note_orig_1001001", "type": "orig", "text": "審＝番【甲】"}
{"id": null, "n": "1002001", "target": "#nkr_note_orig_1002001", "type": "orig", "text": "若＝苦【甲】"}
{"id": null, "n": "0984b0301", "target": "#nkr_note_add_0984b0301", "type": "add", "text": "己【CB】，巳【大】"}
{"id": null, "n": "0985b2501", "target": "#nkr_note_add_0985b2501", "type": "add", "text": "練【CB】，鍊【大】"}
{"id": null, "n": "0985c1001", "target": "#nkr_note_add_0985c1001", "type": "add", "text": "〔－〕【CB】，等【大】"}
{"id": null, "n": "0985c1501", "target": "#nkr_note_add_0985c1501", "type": "add", "text": "弗【CB】，佛【大】"}
{"id": null, "n": "0987a2101", "target": "#nkr_note_add_0987a2101", "type": "add", "text": "CBETA 按：「放」古通「倣」。"}
{"id": null, "n": "0988a1101", "target": "#nkr_note_add_0988a1101", "type": "add", "text": "巨【CB】，叵【大】"}
{"id": null, "n": "0991a0901", "target": "#nkr_note_add_0991a0901", "type": "add", "text": "此【CB】【洪武-CB】【北藏-CB】，比【大】"}
{"id": null, "n": "0992b0301", "target": "#nkr_note_add_0992b0301", "type": "add", "text": "CBETA 按：「失」疑為「去」，與「今」對應。"}
{"id": null, "n": "0996b2901", "target": "#nkr_note_add_0996b2901", "type": "add", "text": "遷【CB】【洪武-CB】【北藏-CB】，還【大】"}
{"id": null, "n": "0996c0201", "target": "#nkr_note_add_0996c0201", "type": "add", "text": "苦【CB】【洪武-CB】，若【大】"}
{"id": null, "n": "0997b1401", "target": "#nkr_note_add_0997b1401", "type": "add", "text": "墮【CB】【洪武-CB】【北藏-CB】，隋【大】"}
{"id": null, "n": "0997c1701", "target": "#nkr_note_add_0997c1701", "type": "add", "text": "音酉【CB】【洪武-CB】【北藏-CB】，䤃【大】"}
{"id": null, "n": null, "target": null, "type": null, "text": "音酉"}
{"id": null, "n": "0998a0701", "target": "#nkr_note_add_0998a0701", "type": "add", "text": "歎【CB】【洪武-CB】【北藏-CB】，歡【大】"}
{"id": null, "n": "1001a0101", "target": "#nkr_note_add_1001a0101", "type": "add", "text": "數【CB】【洪武-CB】【北藏-CB】，歎【大】"}
{"id": null, "n": "1001b0101", "target": "#nkr_note_add_1001b0101", "type": "add", "text": "謂【CB】【洪武-CB】【北藏-CB】，之【大】"}
{"id": null, "n": "1002a2601", "target": "#nkr_note_add_1002a2601", "type": "add", "text": "已【CB】，巳【大】"}
