{"id": null, "n": null, "target": null, "type": null, "text": "音秀"}
{"id": null, "n": null, "target": null, "type": null, "text": "音夙"}
{"id": null, "n": null, "target": null, "type": null, "text": "去聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上《禪門》文"}
{"id": null, "n": null, "target": null, "type": null, "text": "丑加切"}
{"id": null, "n": null, "target": null, "type": null, "text": "埤，避私切"}
{"id": null, "n": null, "target": null, "type": null, "text": "鞮，音低"}
{"id": null, "n": null, "target": null, "type": null, "text": "蹬，音鄧"}
{"id": null, "n": null, "target": null, "type": null, "text": "一百一字"}
{"id": null, "n": null, "target": null, "type": null, "text": "哆，都我切"}
{"id": null, "n": null, "target": null, "type": null, "text": "般，補槃切"}
{"id": null, "n": null, "target": null, "type": null, "text": "鞞，部迷切"}
{"id": null, "n": null, "target": null, "type": null, "text": "矧，詩引切"}
{"id": null, "n": null, "target": null, "type": null, "text": "跈，徐殄切"}
{"id": null, "n": null, "target": null, "type": null, "text": "𠷐，其柯切"}
{"id": null, "n": null, "target": null, "type": null, "text": "凡九十九字"}
{"id": null, "n": null, "target": null, "type": null, "text": "藏"}
{"id": null, "n": null, "target": null, "type": null, "text": "通"}
{"id": null, "n": null, "target": null, "type": null, "text": "別"}
{"id": null, "n": null, "target": null, "type": null, "text": "圓"}
{"id": null, "n": null, "target": null, "type": null, "text": "是亦切"}
{"id": null, "n": null, "target": null, "type": null, "text": "音酉"}
{"id": null, "n": null, "target": null, "type": null, "text": "羶，式禪切"}
{"id": null, "n": null, "target": null, "type": null, "text": "之引切"}
