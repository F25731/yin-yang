{"id": null, "n": null, "target": null, "type": null, "text": "漢言法華"}
{"id": null, "n": null, "target": null, "type": null, "text": "漢言大寶"}
{"id": null, "n": null, "target": null, "type": null, "text": "漢言天王佛"}
{"id": null, "n": null, "target": null, "type": null, "text": "漢言天地國"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "《普寧藏》（日本增上寺藏元版大藏經第65函第3冊第3圖第6行）"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "《嘉興藏》（日本東京大學綜合圖書館藏正編第45帙第3冊第41圖左欄第1行）"}
{"id": null, "n": null, "target": null, "type": "cf3", "text": "T09n0263_p0103a12"}
{"id": null, "n": "0197001", "target": "#nkr_note_mod_0197001", "type": "mod", "text": "分【大】下同，芬【明】下同"}
{"id": null, "n": "0197002", "target": "#nkr_note_mod_0197002", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0197003", "target": "#nkr_note_mod_0197003", "type": "mod", "text": "失譯人名今附西晉錄【大】，僧祐錄中安公失譯【宋】【宮】，僧祐錄云安公失譯附西晉錄【元】，僧祐錄云安公失譯人名附西晉錄【明】"}
{"id": null, "n": "0197004", "target": "#nkr_note_mod_0197004", "type": "mod", "text": "佛【大】，佛佛【宋】【元】【明】【宮】"}
{"id": null, "n": "0197005", "target": "#nkr_note_mod_0197005", "type": "mod", "text": "抱【大】，袍【元】【明】"}
{"id": null, "n": "0197006", "target": "#nkr_note_mod_0197006", "type": "mod", "text": "已【大】，以【宋】【元】【明】【宮】"}
{"id": null, "n": "0197007", "target": "#nkr_note_mod_0197007", "type": "mod", "text": "可【CB】【普寧-CB】【嘉興乙-CB】【宋】【元】【明】，不【大】"}
{"id": null, "n": "0197008", "target": "#nkr_note_mod_0197008", "type": "mod", "text": "花【大】，葉【宮】"}
{"id": null, "n": "0197009", "target": "#nkr_note_mod_0197009", "type": "mod", "text": "息【大】，怠【明】"}
{"id": null, "n": "0197010", "target": "#nkr_note_mod_0197010", "type": "mod", "text": "佛三本宮本作本文"}
{"id": null, "n": "0197011", "target": "#nkr_note_mod_0197011", "type": "mod", "text": "人【大】，人得【宋】【元】【明】【宮】"}
{"id": null, "n": "0197012", "target": "#nkr_note_mod_0197012", "type": "mod", "text": "沙曷【大】下同，娑竭【宋】下同【元】下同【明】下同"}
{"id": null, "n": "0197013", "target": "#nkr_note_mod_0197013", "type": "mod", "text": "白【大】，自【宮】"}
{"id": null, "n": "0197014", "target": "#nkr_note_mod_0197014", "type": "mod", "text": "未【大】，來【宋】【元】【宮】"}
{"id": null, "n": "0198001", "target": "#nkr_note_mod_0198001", "type": "mod", "text": "相【大】，三十二相【宋】【元】【明】"}
{"id": null, "n": "0198002", "target": "#nkr_note_mod_0198002", "type": "mod", "text": "種【大】，八十種【宋】【元】【明】【宮】"}
{"id": null, "n": "0198003", "target": "#nkr_note_mod_0198003", "type": "mod", "text": "一卷【大】，〔－〕【元】【宮】"}
{"id": null, "n": "0197001", "target": "#nkr_note_orig_0197001", "type": "orig", "text": "分＝芬【明】下同"}
{"id": null, "n": "0197002", "target": "#nkr_note_orig_0197002", "type": "orig", "text": "〔一卷〕－【三】【宮】"}
{"id": null, "n": "0197003", "target": "#nkr_note_orig_0197003", "type": "orig", "text": "失譯人名今附西晉錄＝僧祐錄中安公失譯【宋】【宮】，僧祐錄云安公失譯附西晉錄【元】，僧祐錄云安公失譯人名附西晉錄【明】"}
{"id": null, "n": "0197004", "target": "#nkr_note_orig_0197004", "type": "orig", "text": "佛＋（佛）【三】【宮】"}
{"id": null, "n": "0197005", "target": "#nkr_note_orig_0197005", "type": "orig", "text": "抱＝袍【元】【明】"}
{"id": null, "n": "0197006", "target": "#nkr_note_orig_0197006", "type": "orig", "text": "已＝以【三】【宮】"}
{"id": null, "n": "0197007", "target": "#nkr_note_orig_0197007", "type": "orig", "text": "不＝可【三】"}
{"id": null, "n": "0197008", "target": "#nkr_note_orig_0197008", "type": "orig", "text": "花＝葉【宮】"}
{"id": null, "n": "0197009", "target": "#nkr_note_orig_0197009", "type": "orig", "text": "息＝怠【明】"}
{"id": null, "n": "0197010", "target": "#nkr_note_orig_0197010", "type": "orig", "text": "佛三本宮本作本文"}
{"id": null, "n": "0197011", "target": "#nkr_note_orig_0197011", "type": "orig", "text": "人＋（得）【三】【宮】"}
{"id": null, "n": "0197012", "target": "#nkr_note_orig_0197012", "type": "orig", "text": "沙曷＝娑竭【三】下同"}
{"id": null, "n": "0197013", "target": "#nkr_note_orig_0197013", "type": "orig", "text": "白＝自【宮】"}
{"id": null, "n": "0197014", "target": "#nkr_note_orig_0197014", "type": "orig", "text": "未＝來【宋】【元】【宮】"}
{"id": null, "n": "0198001", "target": "#nkr_note_orig_0198001", "type": "orig", "text": "（三十二）＋相【三】"}
{"id": null, "n": "0198002", "target": "#nkr_note_orig_0198002", "type": "orig", "text": "（八十）＋種【三】【宮】"}
{"id": null, "n": "0198003", "target": "#nkr_note_orig_0198003", "type": "orig", "text": "〔一卷〕－【元】【宮】"}
