{"id": null, "n": "0472003", "target": "#nkr_note_mod_0472003", "type": "mod", "text": "（西天…卿）十五字【大】，三藏【宋】【元】，宋三藏【明】"}
{"id": null, "n": "0472004", "target": "#nkr_note_mod_0472004", "type": "mod", "text": "大師臣【大】，法師【明】"}
{"id": null, "n": "0472005", "target": "#nkr_note_mod_0472005", "type": "mod", "text": "合【大】，〔－〕【宋】【元】"}
{"id": null, "n": "0472006", "target": "#nkr_note_mod_0472006", "type": "mod", "text": "野【大】，野三十三【宋】【元】，野三十四【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "三十三"}
{"id": null, "n": null, "target": null, "type": null, "text": "三十四"}
{"id": null, "n": "0472007", "target": "#nkr_note_mod_0472007", "type": "mod", "text": "三十四【大】，三十五【明】，以下順次至七十五記數明本違一數"}
{"id": null, "n": "0472008", "target": "#nkr_note_mod_0472008", "type": "mod", "text": "示【大】，視【明】"}
{"id": null, "n": "0472009", "target": "#nkr_note_mod_0472009", "type": "mod", "text": "焰【大】，炎【宋】【元】【明】"}
{"id": null, "n": "0473001", "target": "#nkr_note_mod_0473001", "type": "mod", "text": "囉【大】＊，羅【元】【明】＊"}
{"id": null, "n": "0473002", "target": "#nkr_note_mod_0473002", "type": "mod", "text": "末【大】，未【宋】【明】"}
{"id": null, "n": "0473003", "target": "#nkr_note_mod_0473003", "type": "mod", "text": "舍【大】，二合【明】"}
{"id": null, "n": "0473004", "target": "#nkr_note_mod_0473004", "type": "mod", "text": "合【大】，合引【明】"}
{"id": null, "n": "0473005", "target": "#nkr_note_mod_0473005", "type": "mod", "text": "誐【大】，議【元】【明】"}
{"id": null, "n": "0473006", "target": "#nkr_note_mod_0473006", "type": "mod", "text": "入【大】，入聲【明】"}
{"id": null, "n": "0473007", "target": "#nkr_note_mod_0473007", "type": "mod", "text": "杲【大】，泉【宋】"}
{"id": null, "n": "0473008", "target": "#nkr_note_mod_0473008", "type": "mod", "text": "引【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0473009", "target": "#nkr_note_mod_0473009", "type": "mod", "text": "𡀩【大】，𠸪【明】"}
{"id": null, "n": "0473010", "target": "#nkr_note_mod_0473010", "type": "mod", "text": "曩【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0473011", "target": "#nkr_note_mod_0473011", "type": "mod", "text": "三【大】，二【明】"}
{"id": null, "n": "0473012", "target": "#nkr_note_mod_0473012", "type": "mod", "text": "二【大】，三【元】"}
{"id": null, "n": "0473013", "target": "#nkr_note_mod_0473013", "type": "mod", "text": "引【大】，二合【宋】【元】【明】"}
{"id": null, "n": "0473014", "target": "#nkr_note_mod_0473014", "type": "mod", "text": "二【大】，三【宋】【元】"}
{"id": null, "n": "0473015", "target": "#nkr_note_mod_0473015", "type": "mod", "text": "囉【大】，羅【明】"}
{"id": null, "n": "0473016", "target": "#nkr_note_mod_0473016", "type": "mod", "text": "麼【大】，摩【宋】【元】【明】"}
{"id": null, "n": "0474001", "target": "#nkr_note_mod_0474001", "type": "mod", "text": "二【大】，三【宋】【元】【明】"}
{"id": null, "n": "0474002", "target": "#nkr_note_mod_0474002", "type": "mod", "text": "未【大】，末【宋】【元】【明】"}
{"id": null, "n": "0474003", "target": "#nkr_note_mod_0474003", "type": "mod", "text": "是【大】，爾【明】"}
{"id": null, "n": "0474004", "target": "#nkr_note_mod_0474004", "type": "mod", "text": "志【大】，至【元】【明】"}
{"id": null, "n": "0474005", "target": "#nkr_note_mod_0474005", "type": "mod", "text": "盤【大】，槃【宋】【元】【明】"}
{"id": null, "n": "0474006", "target": "#nkr_note_mod_0474006", "type": "mod", "text": "又【大】，人【元】【明】"}
{"id": null, "n": "0472002", "target": "#nkr_note_orig_0472002", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0472003", "target": "#nkr_note_orig_0472003", "type": "orig", "text": "（西天…卿）十五字＝（三藏）二字【宋】【元】，（宋三藏）三字【明】"}
{"id": null, "n": "0472004", "target": "#nkr_note_orig_0472004", "type": "orig", "text": "大師臣＝法師【明】"}
{"id": null, "n": "0472005", "target": "#nkr_note_orig_0472005", "type": "orig", "text": "〔合〕－【宋】【元】"}
{"id": null, "n": "0472006", "target": "#nkr_note_orig_0472006", "type": "orig", "text": "野＋（三十三）細註【宋】【元】，（三十四）細註【明】"}
{"id": null, "n": "0472007", "target": "#nkr_note_orig_0472007", "type": "orig", "text": "三十四＝三十五【明】，以下順次至七十五記數明本違一數"}
{"id": null, "n": "0472008", "target": "#nkr_note_orig_0472008", "type": "orig", "text": "示＝視【明】"}
{"id": null, "n": "0472009", "target": "#nkr_note_orig_0472009", "type": "orig", "text": "焰＝炎【三】"}
{"id": null, "n": "0473001", "target": "#nkr_note_orig_0473001", "type": "orig", "text": "囉＝羅【元】【明】＊"}
{"id": null, "n": "0473002", "target": "#nkr_note_orig_0473002", "type": "orig", "text": "末＝未【宋】【明】"}
{"id": null, "n": "0473003", "target": "#nkr_note_orig_0473003", "type": "orig", "text": "舍＝二合【明】"}
{"id": null, "n": "0473004", "target": "#nkr_note_orig_0473004", "type": "orig", "text": "合＋（引）【明】"}
{"id": null, "n": "0473005", "target": "#nkr_note_orig_0473005", "type": "orig", "text": "誐＝議【元】【明】"}
{"id": null, "n": "0473006", "target": "#nkr_note_orig_0473006", "type": "orig", "text": "入＋（聲）【明】"}
