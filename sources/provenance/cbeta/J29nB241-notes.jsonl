{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "公前身係安樂寺碓房行僧"}
{"id": null, "n": null, "target": null, "type": null, "text": "有序"}
{"id": null, "n": null, "target": null, "type": null, "text": "來偈附"}
{"id": null, "n": null, "target": null, "type": null, "text": "請鳳超來韻附"}
{"id": null, "n": null, "target": null, "type": null, "text": "附復偈"}
{"id": null, "n": null, "target": null, "type": null, "text": "因除夕橘燈"}
{"id": null, "n": null, "target": null, "type": null, "text": "居典龍時，請聚雲陞座，舉揚大慧一脈宗旨，代四眾等作"}
{"id": null, "n": null, "target": null, "type": null, "text": "普陀嗣法孫性統重刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈、別評、徵代"}
{"id": null, "n": null, "target": null, "type": null, "text": "即洛浦也"}
{"id": null, "n": null, "target": null, "type": null, "text": "有云：王宙欲娶倩娘為妻，倩父\n母不許，倩遂臥病在家。王宙將欲遠行，月下見倩來，同舟而去。三年後，遂生一子。倩還歸，父母纔到門，家\n中有一倩娘出來相見，兩人遂合成一身。"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣法門人燈映重刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈、別、評、徵、代"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣法門人燈映重刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈，別評，徵代"}
{"id": null, "n": null, "target": null, "type": null, "text": "侍者性遠捐貲重刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈、別、評、徵、代"}
{"id": null, "n": null, "target": null, "type": null, "text": "共一百零一相，除去重出五相，九十六種正"}
{"id": null, "n": null, "target": null, "type": null, "text": "著云：本色底道人"}
{"id": null, "n": null, "target": null, "type": null, "text": "光邋遢"}
{"id": null, "n": null, "target": null, "type": null, "text": "是甚麼乾屎橛"}
{"id": null, "n": null, "target": null, "type": null, "text": "大處大圓，小處小圓"}
{"id": null, "n": null, "target": null, "type": null, "text": "買草鞋，走梁朝，問碧眼僧始得"}
{"id": null, "n": null, "target": null, "type": null, "text": "也須要嘗過"}
{"id": null, "n": null, "target": null, "type": null, "text": "塗乳苦"}
{"id": null, "n": null, "target": null, "type": null, "text": "不道無眼，只為不善觀"}
{"id": null, "n": null, "target": null, "type": null, "text": "和尚遠歸，恐勞神用"}
{"id": null, "n": null, "target": null, "type": null, "text": "玉沙\n雖異，瞖目是同"}
{"id": null, "n": null, "target": null, "type": null, "text": "說底何多"}
{"id": null, "n": null, "target": null, "type": null, "text": "禍胎從新起了"}
{"id": null, "n": null, "target": null, "type": null, "text": "一拳拳倒黃鶴樓，一腳踢翻鸚鵡洲"}
{"id": null, "n": null, "target": null, "type": null, "text": "應以面然身，得\n度者即現面然身，面為說法"}
{"id": null, "n": null, "target": null, "type": null, "text": "只在一毛孔裏"}
{"id": null, "n": null, "target": null, "type": null, "text": "切莫\n弄巧成拙"}
{"id": null, "n": null, "target": null, "type": null, "text": "莫是搬柴運水麼"}
{"id": null, "n": null, "target": null, "type": null, "text": "喚甚麼作道"}
{"id": null, "n": null, "target": null, "type": null, "text": "刀山劍樹上轉大法輪"}
{"id": null, "n": null, "target": null, "type": null, "text": "且信一半"}
{"id": null, "n": null, "target": null, "type": null, "text": "用者惡燒慧作麼"}
{"id": null, "n": null, "target": null, "type": null, "text": "絲來線去"}
{"id": null, "n": null, "target": null, "type": null, "text": "似則卻似，是則未是"}
{"id": null, "n": null, "target": null, "type": null, "text": "且莫造次"}
{"id": null, "n": null, "target": null, "type": null, "text": "自入塔來，\n香燈不昧"}
{"id": null, "n": null, "target": null, "type": null, "text": "檻外低秦嶺"}
{"id": null, "n": null, "target": null, "type": null, "text": "窗中小渭川"}
{"id": null, "n": null, "target": null, "type": null, "text": "欲窮千里目，更上一層樓"}
{"id": null, "n": null, "target": null, "type": null, "text": "切忌動著"}
{"id": null, "n": null, "target": null, "type": null, "text": "只因當頭錯，到底費心勤"}
{"id": null, "n": null, "target": null, "type": null, "text": "大費手腳生"}
{"id": null, "n": null, "target": null, "type": null, "text": "只要起腳穩"}
{"id": null, "n": null, "target": null, "type": null, "text": "官不容針，私通車馬"}
{"id": null, "n": null, "target": null, "type": null, "text": "豈是分外"}
{"id": null, "n": null, "target": null, "type": null, "text": "我手何似佛手"}
{"id": null, "n": null, "target": null, "type": null, "text": "有尊是者金"}
{"id": null, "n": null, "target": null, "type": null, "text": "黃葉止啼"}
{"id": null, "n": null, "target": null, "type": null, "text": "但向十五看"}
{"id": null, "n": null, "target": null, "type": null, "text": "覓去了不可得，來自何來"}
{"id": null, "n": null, "target": null, "type": null, "text": "瞞頇多少\n入"}
{"id": null, "n": null, "target": null, "type": null, "text": "和盤托出"}
{"id": null, "n": null, "target": null, "type": null, "text": "守罰百姓"}
{"id": null, "n": null, "target": null, "type": null, "text": "知而故已"}
{"id": null, "n": null, "target": null, "type": null, "text": "有上什不護乎下"}
{"id": null, "n": null, "target": null, "type": null, "text": "賊是小人，智過君子"}
{"id": null, "n": null, "target": null, "type": null, "text": "你無我不得"}
{"id": null, "n": null, "target": null, "type": null, "text": "我無你不成"}
{"id": null, "n": null, "target": null, "type": null, "text": "送為賓主"}
{"id": null, "n": null, "target": null, "type": null, "text": "換工插禾"}
{"id": null, "n": null, "target": null, "type": null, "text": "受恩深處宜先退"}
{"id": null, "n": null, "target": null, "type": null, "text": "得意濃時正好休"}
{"id": null, "n": null, "target": null, "type": null, "text": "喫飯動口，禮佛合手"}
{"id": null, "n": null, "target": null, "type": null, "text": "禍福無門，\n為人自招"}
{"id": null, "n": null, "target": null, "type": null, "text": "時師住平都地藏寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "熾盛之世"}
