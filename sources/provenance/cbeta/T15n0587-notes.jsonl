{"id": null, "n": null, "target": null, "type": null, "text": "蘇弗反"}
{"id": null, "n": "0062006", "target": "#nkr_note_mod_0062006", "type": "mod", "text": "三藏【大】＊，沙門統大乘論師【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0062007", "target": "#nkr_note_mod_0062007", "type": "mod", "text": "流【大】＊，留【元】【明】＊"}
{"id": null, "n": "0062008", "target": "#nkr_note_mod_0062008", "type": "mod", "text": "譯【大】＊，第三譯【元】＊"}
{"id": null, "n": "0062009", "target": "#nkr_note_mod_0062009", "type": "mod", "text": "（歸命…薩）八字【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0062010", "target": "#nkr_note_mod_0062010", "type": "mod", "text": "坐【大】＊，座【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0062011", "target": "#nkr_note_mod_0062011", "type": "mod", "text": "思惟【大】，惟念【宋】【元】【明】【宮】"}
{"id": null, "n": "0063001", "target": "#nkr_note_mod_0063001", "type": "mod", "text": "忘【大】，妄【元】【明】【宮】"}
{"id": null, "n": "0063002", "target": "#nkr_note_mod_0063002", "type": "mod", "text": "垢【大】，姤【宋】，始【元】【明】【宮】"}
{"id": null, "n": "0063003", "target": "#nkr_note_mod_0063003", "type": "mod", "text": "菩薩【大】，眾生【宋】【元】【明】【宮】"}
{"id": null, "n": "0063004", "target": "#nkr_note_mod_0063004", "type": "mod", "text": "惟【大】＊，唯【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0063005", "target": "#nkr_note_mod_0063005", "type": "mod", "text": "輪【大】，轉【宋】【元】【明】【宮】"}
{"id": null, "n": "0063006", "target": "#nkr_note_mod_0063006", "type": "mod", "text": "諮【大】，請【宋】【宮】"}
{"id": null, "n": "0063007", "target": "#nkr_note_mod_0063007", "type": "mod", "text": "（不見…故）九字【大】，於他闕失不見其過故【元】，依明校異，南藏亦然"}
{"id": null, "n": "0064001", "target": "#nkr_note_mod_0064001", "type": "mod", "text": "佛名智無減【大】，佛智無減少【宮】"}
{"id": null, "n": "0064002", "target": "#nkr_note_mod_0064002", "type": "mod", "text": "天四【大】，四天【宋】【元】【明】【宮】"}
{"id": null, "n": "0064003", "target": "#nkr_note_mod_0064003", "type": "mod", "text": "惓【大】＊，倦【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0064004", "target": "#nkr_note_mod_0064004", "type": "mod", "text": "往【大】＊，住【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0065001", "target": "#nkr_note_mod_0065001", "type": "mod", "text": "者【大】，著【元】【明】"}
{"id": null, "n": "0065002", "target": "#nkr_note_mod_0065002", "type": "mod", "text": "憶【大】，億【明】"}
{"id": null, "n": "0065003", "target": "#nkr_note_mod_0065003", "type": "mod", "text": "歎【大】，歡【元】"}
{"id": null, "n": "0065004", "target": "#nkr_note_mod_0065004", "type": "mod", "text": "心【大】，心念【宋】【元】【明】【宮】"}
{"id": null, "n": "0065005", "target": "#nkr_note_mod_0065005", "type": "mod", "text": "達解【大】，解達【宮】"}
{"id": null, "n": "0065006", "target": "#nkr_note_mod_0065006", "type": "mod", "text": "實【大】，說【宋】【元】【明】【宮】"}
{"id": null, "n": "0066001", "target": "#nkr_note_mod_0066001", "type": "mod", "text": "諸【大】，說【宮】"}
{"id": null, "n": "0066002", "target": "#nkr_note_mod_0066002", "type": "mod", "text": "辦【大】，辯【宮】"}
{"id": null, "n": "0066003", "target": "#nkr_note_mod_0066003", "type": "mod", "text": "問【大】，謂【元】【明】"}
{"id": null, "n": "0067001", "target": "#nkr_note_mod_0067001", "type": "mod", "text": "故【大】，者【宋】【元】【明】【宮】"}
{"id": null, "n": "0067002", "target": "#nkr_note_mod_0067002", "type": "mod", "text": "知無為【大】，無為名【宋】【元】【明】【宮】"}
{"id": null, "n": "0068001", "target": "#nkr_note_mod_0068001", "type": "mod", "text": "法【大】，間【宋】【元】【明】【宮】"}
{"id": null, "n": "0068002", "target": "#nkr_note_mod_0068002", "type": "mod", "text": "佛【大】，實【宋】【元】【明】【宮】"}
{"id": null, "n": "0068003", "target": "#nkr_note_mod_0068003", "type": "mod", "text": "間【大】，聞【明】【宮】"}
{"id": null, "n": "0068004", "target": "#nkr_note_mod_0068004", "type": "mod", "text": "知【大】，智【宋】【元】【明】【宮】"}
{"id": null, "n": "0068005", "target": "#nkr_note_mod_0068005", "type": "mod", "text": "聖【大】，〔－〕【明】"}
{"id": null, "n": "0068006", "target": "#nkr_note_mod_0068006", "type": "mod", "text": "滅【大】，〔－〕【元】【明】"}
{"id": null, "n": "0069001", "target": "#nkr_note_mod_0069001", "type": "mod", "text": "苦【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0069002", "target": "#nkr_note_mod_0069002", "type": "mod", "text": "〔－〕【CB】【宮-CB】【宋】【元】【明】【宮】，不【大】"}
{"id": null, "n": "0069003", "target": "#nkr_note_mod_0069003", "type": "mod", "text": "隨【大】，墮【宋】【元】【明】【宮】"}
{"id": null, "n": "0069004", "target": "#nkr_note_mod_0069004", "type": "mod", "text": "義【大】，議【明】"}
{"id": null, "n": "0069005", "target": "#nkr_note_mod_0069005", "type": "mod", "text": "不【大】，無【明】"}
{"id": null, "n": "0071001", "target": "#nkr_note_mod_0071001", "type": "mod", "text": "歸【大】，貴【宋】【元】【明】【宮】"}
{"id": null, "n": "0071002", "target": "#nkr_note_mod_0071002", "type": "mod", "text": "得【大】，德【宋】【元】【明】【宮】"}
{"id": null, "n": "0071003", "target": "#nkr_note_mod_0071003", "type": "mod", "text": "佛智【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0071004", "target": "#nkr_note_mod_0071004", "type": "mod", "text": "力【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0071005", "target": "#nkr_note_mod_0071005", "type": "mod", "text": "不【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0071006", "target": "#nkr_note_mod_0071006", "type": "mod", "text": "諸【大】，語【宮】"}
{"id": null, "n": "0072001", "target": "#nkr_note_mod_0072001", "type": "mod", "text": "亦【大】，亦能【宋】【元】【明】【宮】"}
{"id": null, "n": "0072002", "target": "#nkr_note_mod_0072002", "type": "mod", "text": "慧【大】，智慧【元】【明】"}
{"id": null, "n": "0072003", "target": "#nkr_note_mod_0072003", "type": "mod", "text": "陀【大】，他【宋】【元】【明】【宮】"}
{"id": null, "n": "0072004", "target": "#nkr_note_mod_0072004", "type": "mod", "text": "苦【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0072005", "target": "#nkr_note_mod_0072005", "type": "mod", "text": "樂果【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0073001", "target": "#nkr_note_mod_0073001", "type": "mod", "text": "諍鬪【大】，鬪諍【宋】【元】【明】【宮】"}
{"id": null, "n": "0073002", "target": "#nkr_note_mod_0073002", "type": "mod", "text": "相【大】，想【宋】【元】【明】【宮】"}
{"id": null, "n": "0073003", "target": "#nkr_note_mod_0073003", "type": "mod", "text": "業【大】，若【宋】【元】【明】，苦【宮】"}
{"id": null, "n": "0073004", "target": "#nkr_note_mod_0073004", "type": "mod", "text": "夫【大】，法【宋】【元】"}
{"id": null, "n": "0073005", "target": "#nkr_note_mod_0073005", "type": "mod", "text": "善哉【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "0074001", "target": "#nkr_note_mod_0074001", "type": "mod", "text": "于【大】，於【明】"}
{"id": null, "n": "0075001", "target": "#nkr_note_mod_0075001", "type": "mod", "text": "白赤【大】，赤白【宋】【元】【明】【宮】"}
{"id": null, "n": "0075002", "target": "#nkr_note_mod_0075002", "type": "mod", "text": "恚【大】，瞋恚【宋】【元】【明】【宮】"}
{"id": null, "n": "0075003", "target": "#nkr_note_mod_0075003", "type": "mod", "text": "踊【大】，涌【宋】【元】【明】【宮】"}
{"id": null, "n": "0075004", "target": "#nkr_note_mod_0075004", "type": "mod", "text": "今【大】，令【宋】【元】【宮】"}
{"id": null, "n": "0075005", "target": "#nkr_note_mod_0075005", "type": "mod", "text": "作【大】，得【宋】【元】【明】【宮】"}
{"id": null, "n": "0075006", "target": "#nkr_note_mod_0075006", "type": "mod", "text": "葉【大】，葉等【宋】【元】【明】【宮】"}
{"id": null, "n": "0075007", "target": "#nkr_note_mod_0075007", "type": "mod", "text": "土【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0075008", "target": "#nkr_note_mod_0075008", "type": "mod", "text": "云【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0076001", "target": "#nkr_note_mod_0076001", "type": "mod", "text": "生【大】，具【宋】【元】【明】【宮】"}
{"id": null, "n": "0076002", "target": "#nkr_note_mod_0076002", "type": "mod", "text": "加【大】，跏【明】"}
