{"id": null, "n": null, "target": null, "type": null, "text": "歸命"}
{"id": null, "n": "0170006", "target": "#nkr_note_mod_0170006", "type": "mod", "text": "褺【大】，縶【甲】【乙】【丙】"}
{"id": null, "n": "0170007", "target": "#nkr_note_mod_0170007", "type": "mod", "text": "與【大】，乞【甲】【乙】【丙】"}
{"id": null, "n": "0170008", "target": "#nkr_note_mod_0170008", "type": "mod", "text": "受【大】，授【丙】"}
{"id": null, "n": "0170009", "target": "#nkr_note_mod_0170009", "type": "mod", "text": "其【大】，其菩薩【甲】【乙】，〔－〕【丙】"}
{"id": null, "n": "0170010", "target": "#nkr_note_mod_0170010", "type": "mod", "text": "微【大】，使【校異-原】"}
{"id": null, "n": "0170011", "target": "#nkr_note_mod_0170011", "type": "mod", "text": "精【大】，睛【校異-原】"}
{"id": null, "n": "0170012", "target": "#nkr_note_mod_0170012", "type": "mod", "text": "手【大】，印手【甲】"}
{"id": null, "n": "0170013", "target": "#nkr_note_mod_0170013", "type": "mod", "text": "腕【大】，捖【甲】【乙】"}
{"id": null, "n": "0170014", "target": "#nkr_note_mod_0170014", "type": "mod", "text": "三【大】，〔－〕【丙】"}
{"id": null, "n": "0170015", "target": "#nkr_note_mod_0170015", "type": "mod", "text": "娑【大】，婆【甲】【乙】【丙】"}
{"id": null, "n": "0170016", "target": "#nkr_note_mod_0170016", "type": "mod", "text": "大【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0170017", "target": "#nkr_note_mod_0170017", "type": "mod", "text": "圍【大】，其光圍【甲】【乙】【丙】"}
{"id": null, "n": "0171001", "target": "#nkr_note_mod_0171001", "type": "mod", "text": "之【大】，此【甲】【乙】【丙】"}
{"id": null, "n": "0171002", "target": "#nkr_note_mod_0171002", "type": "mod", "text": "陀【大】，〔－〕【丙】"}
{"id": null, "n": "0171003", "target": "#nkr_note_mod_0171003", "type": "mod", "text": "人【大】，〔－〕【丙】"}
{"id": null, "n": "0171004", "target": "#nkr_note_mod_0171004", "type": "mod", "text": "若【大】，〔－〕【甲】【乙】【丙】"}
{"id": null, "n": "0171005", "target": "#nkr_note_mod_0171005", "type": "mod", "text": "娑【大】，婆【甲】，〔－〕【丙】"}
{"id": null, "n": "0171006", "target": "#nkr_note_mod_0171006", "type": "mod", "text": "丸【大】，〔－〕【甲】【乙】【丙】"}
{"id": null, "n": "0171007", "target": "#nkr_note_mod_0171007", "type": "mod", "text": "惹【大】＊，若【甲】【乙】【丙】＊"}
{"id": null, "n": "0171008", "target": "#nkr_note_mod_0171008", "type": "mod", "text": "與牛【大】，〔－〕【甲】【乙】【丙】"}
{"id": null, "n": "0171009", "target": "#nkr_note_mod_0171009", "type": "mod", "text": "糞【大】，〔－〕【甲】【乙】【丙】"}
{"id": null, "n": "0171010", "target": "#nkr_note_mod_0171010", "type": "mod", "text": "磧【大】，碃【甲】【乙】【丙】"}
{"id": null, "n": "0171011", "target": "#nkr_note_mod_0171011", "type": "mod", "text": "此蛇【大】，蛇此【甲】【乙】【丙】"}
{"id": null, "n": "0171012", "target": "#nkr_note_mod_0171012", "type": "mod", "text": "見即【大】，即人【丙】"}
{"id": null, "n": "0171013", "target": "#nkr_note_mod_0171013", "type": "mod", "text": "指【大】，〔－〕【甲】【乙】【丙】"}
{"id": null, "n": "0171014", "target": "#nkr_note_mod_0171014", "type": "mod", "text": "皆【大】，〔－〕【甲】【乙】【丙】"}
{"id": null, "n": "0171015", "target": "#nkr_note_mod_0171015", "type": "mod", "text": "唵【大】，唵一【甲】【乙】【丙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": "0171016", "target": "#nkr_note_mod_0171016", "type": "mod", "text": "嚧【大】，嚧二【甲】【乙】【丙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": "0171017", "target": "#nkr_note_mod_0171017", "type": "mod", "text": "娑嚩賀【大】，莎去訶五【甲】【乙】，莎訶五【丙】"}
{"id": null, "n": "0171018", "target": "#nkr_note_mod_0171018", "type": "mod", "text": "賀【大】，何【丙】"}
{"id": null, "n": "0171019", "target": "#nkr_note_mod_0171019", "type": "mod", "text": "指【大】，指大指【甲】【乙】【丙】"}
{"id": null, "n": "0171020", "target": "#nkr_note_mod_0171020", "type": "mod", "text": "各【大】，〔－〕【甲】【乙】【丙】"}
{"id": null, "n": "0171021", "target": "#nkr_note_mod_0171021", "type": "mod", "text": "著【大】，〔－〕【丙】"}
{"id": null, "n": "0171022", "target": "#nkr_note_mod_0171022", "type": "mod", "text": "已上二印可在解禁刀印之次【大】，已上二印可在解禁刀印之次【甲】【乙】【丙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上二印可在解禁刀印之次"}
{"id": null, "n": "0171023", "target": "#nkr_note_mod_0171023", "type": "mod", "text": "後【大】，蕤【校異-原】，俊【甲】，蕤【乙】【丙】"}
{"id": null, "n": "0171024", "target": "#nkr_note_mod_0171024", "type": "mod", "text": "嚕【大】＊，魯【甲】＊"}
{"id": null, "n": "0171025", "target": "#nkr_note_mod_0171025", "type": "mod", "text": "主【大】，毘主【甲】【乙】【丙】"}
{"id": null, "n": "0171026", "target": "#nkr_note_mod_0171026", "type": "mod", "text": "四【大】，上音四【甲】【乙】【丙】"}
{"id": null, "n": "0171027", "target": "#nkr_note_mod_0171027", "type": "mod", "text": "知【大】，〔－〕【乙】"}
{"id": null, "n": "0171028", "target": "#nkr_note_mod_0171028", "type": "mod", "text": "那【大】，耶【甲】，那二合【丙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0171029", "target": "#nkr_note_mod_0171029", "type": "mod", "text": "歸命【大】，歸命【丙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "歸命"}
{"id": null, "n": "0171030", "target": "#nkr_note_mod_0171030", "type": "mod", "text": "婆【大】，波【甲】【乙】"}
{"id": null, "n": "0171031", "target": "#nkr_note_mod_0171031", "type": "mod", "text": "㘓【大】，󳟁【甲】【乙】【丙】"}
{"id": null, "n": "0171032", "target": "#nkr_note_mod_0171032", "type": "mod", "text": "了【大】，可【甲】【乙】【丙】"}
{"id": null, "n": "0171033", "target": "#nkr_note_mod_0171033", "type": "mod", "text": "賀耶揭哩婆【大】，馬頭明王【甲】"}
{"id": null, "n": "0170005", "target": "#nkr_note_orig_0170005", "type": "orig", "text": "【原】享和年間刊豐山大學藏本，【甲】天永五年寫東寺三密藏本，【乙】天永四年寫東寺三密藏本，【丙】平安時代寫仁和寺藏本"}
{"id": null, "n": "0170006", "target": "#nkr_note_orig_0170006", "type": "orig", "text": "褺＝縶【甲】【乙】【丙】"}
{"id": null, "n": "0170007", "target": "#nkr_note_orig_0170007", "type": "orig", "text": "與＝乞【甲】【乙】【丙】"}
{"id": null, "n": "0170008", "target": "#nkr_note_orig_0170008", "type": "orig", "text": "受＝授【丙】"}
{"id": null, "n": "0170009", "target": "#nkr_note_orig_0170009", "type": "orig", "text": "其＋（菩薩）【甲】【乙】，〔其〕－【丙】"}
{"id": null, "n": "0170010", "target": "#nkr_note_orig_0170010", "type": "orig", "text": "微＝使ィ【原】"}
{"id": null, "n": "0170011", "target": "#nkr_note_orig_0170011", "type": "orig", "text": "精＝睛ィ【原】"}
{"id": null, "n": "0170012", "target": "#nkr_note_orig_0170012", "type": "orig", "text": "（印）＋手【甲】"}
{"id": null, "n": "0170013", "target": "#nkr_note_orig_0170013", "type": "orig", "text": "腕＝捖【甲】【乙】"}
{"id": null, "n": "0170014", "target": "#nkr_note_orig_0170014", "type": "orig", "text": "〔三〕－【丙】"}
{"id": null, "n": "0170015", "target": "#nkr_note_orig_0170015", "type": "orig", "text": "娑＝婆【甲】【乙】【丙】"}
{"id": null, "n": "0170016", "target": "#nkr_note_orig_0170016", "type": "orig", "text": "〔大〕－【甲】【乙】"}
{"id": null, "n": "0170017", "target": "#nkr_note_orig_0170017", "type": "orig", "text": "（其光）＋圍【甲】【乙】【丙】"}
{"id": null, "n": "0171001", "target": "#nkr_note_orig_0171001", "type": "orig", "text": "之＝此【甲】【乙】【丙】"}
{"id": null, "n": "0171002", "target": "#nkr_note_orig_0171002", "type": "orig", "text": "〔陀〕－【丙】"}
{"id": null, "n": "0171003", "target": "#nkr_note_orig_0171003", "type": "orig", "text": "〔人〕－【丙】"}
{"id": null, "n": "0171004", "target": "#nkr_note_orig_0171004", "type": "orig", "text": "〔若〕－【甲】【乙】【丙】"}
{"id": null, "n": "0171005", "target": "#nkr_note_orig_0171005", "type": "orig", "text": "娑＝婆【甲】，〔娑〕－【丙】"}
{"id": null, "n": "0171006", "target": "#nkr_note_orig_0171006", "type": "orig", "text": "〔丸〕－【甲】【乙】【丙】"}
{"id": null, "n": "0171007", "target": "#nkr_note_orig_0171007", "type": "orig", "text": "惹＝若【甲】【乙】【丙】＊"}
{"id": null, "n": "0171008", "target": "#nkr_note_orig_0171008", "type": "orig", "text": "〔與牛〕－【甲】【乙】【丙】"}
{"id": null, "n": "0171009", "target": "#nkr_note_orig_0171009", "type": "orig", "text": "〔糞〕－【甲】【乙】【丙】"}
{"id": null, "n": "0171010", "target": "#nkr_note_orig_0171010", "type": "orig", "text": "磧＝碃【甲】【乙】【丙】"}
{"id": null, "n": "0171011", "target": "#nkr_note_orig_0171011", "type": "orig", "text": "此蛇＝蛇此【甲】【乙】【丙】"}
{"id": null, "n": "0171012", "target": "#nkr_note_orig_0171012", "type": "orig", "text": "見即＝即人【丙】"}
{"id": null, "n": "0171013", "target": "#nkr_note_orig_0171013", "type": "orig", "text": "〔指〕－【甲】【乙】【丙】"}
{"id": null, "n": "0171014", "target": "#nkr_note_orig_0171014", "type": "orig", "text": "〔皆〕－【甲】【乙】【丙】"}
{"id": null, "n": "0171015", "target": "#nkr_note_orig_0171015", "type": "orig", "text": "唵＋（一）細註【甲】【乙】【丙】"}
{"id": null, "n": "0171016", "target": "#nkr_note_orig_0171016", "type": "orig", "text": "嚧＋（二）細註【甲】【乙】【丙】"}
{"id": null, "n": "0171017", "target": "#nkr_note_orig_0171017", "type": "orig", "text": "娑嚩賀＝莎去訶五【甲】【乙】，莎訶五【丙】"}
{"id": null, "n": "0171018", "target": "#nkr_note_orig_0171018", "type": "orig", "text": "賀＝何【丙】"}
{"id": null, "n": "0171019", "target": "#nkr_note_orig_0171019", "type": "orig", "text": "指＋（大指）【甲】【乙】【丙】"}
{"id": null, "n": "0171020", "target": "#nkr_note_orig_0171020", "type": "orig", "text": "〔各〕－【甲】【乙】【丙】"}
{"id": null, "n": "0171021", "target": "#nkr_note_orig_0171021", "type": "orig", "text": "〔著〕－【丙】"}
{"id": null, "n": "0171022", "target": "#nkr_note_orig_0171022", "type": "orig", "text": "甲乙丙三本已上乃至次十二字作夾註"}
{"id": null, "n": "0171023", "target": "#nkr_note_orig_0171023", "type": "orig", "text": "後＝蕤ィ【原】，俊【甲】，蕤【乙】【丙】"}
{"id": null, "n": "0171024", "target": "#nkr_note_orig_0171024", "type": "orig", "text": "嚕＝魯【甲】＊"}
{"id": null, "n": "0171025", "target": "#nkr_note_orig_0171025", "type": "orig", "text": "（毘）＋主【甲】【乙】【丙】"}
{"id": null, "n": "0171026", "target": "#nkr_note_orig_0171026", "type": "orig", "text": "（上音）＋四【甲】【乙】【丙】"}
{"id": null, "n": "0171027", "target": "#nkr_note_orig_0171027", "type": "orig", "text": "〔知〕－【乙】"}
{"id": null, "n": "0171028", "target": "#nkr_note_orig_0171028", "type": "orig", "text": "那＝耶【甲】，那＋（二合）細註【丙】"}
{"id": null, "n": "0171029", "target": "#nkr_note_orig_0171029", "type": "orig", "text": "丙本歸命二字作細字"}
