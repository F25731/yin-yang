{"id": null, "n": "0360001", "target": "#nkr_note_orig_0360001", "type": "orig", "text": "「品」，甲本無。"}
{"id": null, "n": "0360002", "target": "#nkr_note_orig_0360002", "type": "orig", "text": "「為」，底本作「謂」，據甲本改。"}
{"id": null, "n": "0360003", "target": "#nkr_note_orig_0360003", "type": "orig", "text": "「告」，底本作「造」，據文意改。"}
{"id": null, "n": "0360004", "target": "#nkr_note_orig_0360004", "type": "orig", "text": "「諸」，甲本作「切」，「切」前殘，疑作「一切」。"}
{"id": null, "n": "0360005", "target": "#nkr_note_orig_0360005", "type": "orig", "text": "「告」，底本作「造」，據甲本改。"}
{"id": null, "n": "0360006", "target": "#nkr_note_orig_0360006", "type": "orig", "text": "乙本自此始。"}
{"id": null, "n": "0360007", "target": "#nkr_note_orig_0360007", "type": "orig", "text": "「譬如有人繫在獄中，枷杻著身」，底本無，據甲本補。"}
{"id": null, "n": "0360008", "target": "#nkr_note_orig_0360008", "type": "orig", "text": "「心念大乘，常」，底本無，據文意補。"}
{"id": null, "n": "0360009", "target": "#nkr_note_orig_0360009", "type": "orig", "text": "「不放捨」，底本無，據甲本補。"}
{"id": null, "n": "0360010", "target": "#nkr_note_orig_0360010", "type": "orig", "text": "丁本自此始。"}
{"id": null, "n": "0361001", "target": "#nkr_note_orig_0361001", "type": "orig", "text": "「瑪」，底、甲、乙、丁本作「馬」，據文意改。"}
{"id": null, "n": "0361002", "target": "#nkr_note_orig_0361002", "type": "orig", "text": "「琥」，底、甲、乙、丁本作「虎」，據文意改。"}
{"id": null, "n": "0361003", "target": "#nkr_note_orig_0361003", "type": "orig", "text": "「布疋」，甲、乙本作「疋布」。"}
{"id": null, "n": "0361004", "target": "#nkr_note_orig_0361004", "type": "orig", "text": "「復」，底本無，據丁本補。"}
{"id": null, "n": "0361005", "target": "#nkr_note_orig_0361005", "type": "orig", "text": "丙本自此始。"}
{"id": null, "n": "0361006", "target": "#nkr_note_orig_0361006", "type": "orig", "text": "戊本自此始。"}
{"id": null, "n": "0361007", "target": "#nkr_note_orig_0361007", "type": "orig", "text": "「或子不識父，或父不識子」，丁本作「或父不識子，或子不識父」。"}
{"id": null, "n": "0361008", "target": "#nkr_note_orig_0361008", "type": "orig", "text": "「或弟不識兄，或兄不識弟」，丁、戊本作「或兄不識弟，或弟不識兄」。"}
{"id": null, "n": "0361009", "target": "#nkr_note_orig_0361009", "type": "orig", "text": "「或妻不識夫，或夫不識妻」，丁、戊本作「或夫不識妻，或妻不識夫」。"}
{"id": null, "n": "0361010", "target": "#nkr_note_orig_0361010", "type": "orig", "text": "「發」，甲、乙、丙本無。"}
{"id": null, "n": "0362001", "target": "#nkr_note_orig_0362001", "type": "orig", "text": "「好」，戊本無。"}
{"id": null, "n": "0362002", "target": "#nkr_note_orig_0362002", "type": "orig", "text": "「諦聽」，底本無，據甲、乙、丙、丁、戊本補。"}
{"id": null, "n": "0362003", "target": "#nkr_note_orig_0362003", "type": "orig", "text": "「沽」，底本作「酤」，據甲、乙、丙、丁、戊本改。"}
{"id": null, "n": "0362004", "target": "#nkr_note_orig_0362004", "type": "orig", "text": "「沽」，底本作「酤」，據甲、乙、丙、丁、戊本改。"}
{"id": null, "n": "0362005", "target": "#nkr_note_orig_0362005", "type": "orig", "text": "「汝今見我，汝生恐心」，丁本作「吾今見汝生恐懼心」，戊本為「汝今見我，生恐懼心」。"}
{"id": null, "n": "0362006", "target": "#nkr_note_orig_0362006", "type": "orig", "text": "「竟，身長三尺，顏色青黑，頭上無毛，兩耳」，乙、丙本無。"}
{"id": null, "n": "0362007", "target": "#nkr_note_orig_0362007", "type": "orig", "text": "「亦」，戊本作「又」。"}
{"id": null, "n": "0362008", "target": "#nkr_note_orig_0362008", "type": "orig", "text": "「無」，底本無，據甲、乙、丙、丁、戊本補。"}
{"id": null, "n": "0362009", "target": "#nkr_note_orig_0362009", "type": "orig", "text": "「沽」，底、戊本作「酤」，據甲、乙、丙、丁本改。"}
{"id": null, "n": "0362010", "target": "#nkr_note_orig_0362010", "type": "orig", "text": "「酒之人」，丁、戊本作「之」。"}
{"id": null, "n": "0362011", "target": "#nkr_note_orig_0362011", "type": "orig", "text": "「露」，甲、乙、丙本作「路」。"}
{"id": null, "n": "0362012", "target": "#nkr_note_orig_0362012", "type": "orig", "text": "「瘥」，底、甲、乙、丙、丁、戊本作「差」，據文意改。"}
{"id": null, "n": "0363001", "target": "#nkr_note_orig_0363001", "type": "orig", "text": "「飲」，底本作「作」，據戊本改。"}
{"id": null, "n": "0363002", "target": "#nkr_note_orig_0363002", "type": "orig", "text": "「發」，底、丁、戊本無，據甲、乙、丙本補。"}
{"id": null, "n": "0363003", "target": "#nkr_note_orig_0363003", "type": "orig", "text": "「心」，甲、乙、丙本無。"}
{"id": null, "n": "0363004", "target": "#nkr_note_orig_0363004", "type": "orig", "text": "「言」，底、丁、戊本無，據甲、乙、丙本補。"}
{"id": null, "n": "0363005", "target": "#nkr_note_orig_0363005", "type": "orig", "text": "「若」，戊本作「若又」。"}
{"id": null, "n": "0363006", "target": "#nkr_note_orig_0363006", "type": "orig", "text": "「戒」，甲、乙、丙本無。"}
{"id": null, "n": "0363007", "target": "#nkr_note_orig_0363007", "type": "orig", "text": "「飲酒」，甲、乙、丙本無。"}
{"id": null, "n": "0363008", "target": "#nkr_note_orig_0363008", "type": "orig", "text": "「罪」，甲本作「羅」。"}
{"id": null, "n": "0363009", "target": "#nkr_note_orig_0363009", "type": "orig", "text": "「罪」，甲、乙、丙本無。"}
{"id": null, "n": "0363010", "target": "#nkr_note_orig_0363010", "type": "orig", "text": "「鴦崛魔羅」，甲、乙、丙本作「央崛摩羅」。"}
{"id": null, "n": "0363011", "target": "#nkr_note_orig_0363011", "type": "orig", "text": "「其」，底、甲、乙、丙本無，據丁、戊本補。"}
{"id": null, "n": "0363012", "target": "#nkr_note_orig_0363012", "type": "orig", "text": "「共」，戊本作「供」。"}
{"id": null, "n": "0363013", "target": "#nkr_note_orig_0363013", "type": "orig", "text": "「釀」，戊本作「釀酒」。"}
{"id": null, "n": "0363014", "target": "#nkr_note_orig_0363014", "type": "orig", "text": "「耳」，乙、丙本作「取」。"}
{"id": null, "n": "0363015", "target": "#nkr_note_orig_0363015", "type": "orig", "text": "「聲句」，甲、乙、丙、丁、戊本作「勿聲」。"}
{"id": null, "n": "0364001", "target": "#nkr_note_orig_0364001", "type": "orig", "text": "「旬」，底本作「巡」，據甲、乙、丙、丁、戊本改。下同。"}
{"id": null, "n": "0364002", "target": "#nkr_note_orig_0364002", "type": "orig", "text": "「子」，丁本作「之子」。"}
{"id": null, "n": "0364003", "target": "#nkr_note_orig_0364003", "type": "orig", "text": "「若」，底、丁、戊本無，據甲、乙、丙本補。"}
{"id": null, "n": "0364004", "target": "#nkr_note_orig_0364004", "type": "orig", "text": "「食肉者，即食父母、眷屬肉」，丁、戊本無。"}
{"id": null, "n": "0364005", "target": "#nkr_note_orig_0364005", "type": "orig", "text": "「迦葉菩薩白佛言」，丁、戊本無。"}
{"id": null, "n": "0364006", "target": "#nkr_note_orig_0364006", "type": "orig", "text": "「過徹地」，丁本作「通徹地」，甲、乙、丙本作「過通徹」。"}
{"id": null, "n": "0364007", "target": "#nkr_note_orig_0364007", "type": "orig", "text": "「鏟」，戊本作「銕」。"}
{"id": null, "n": "0364008", "target": "#nkr_note_orig_0364008", "type": "orig", "text": "「彌覆，其地赤鐵，上火徹下，下火徹上；鐵枷、鐵鈕、鐵𬫑、鐵鏟，持火燒之」，甲、乙、丙本作「鐵枷、鐵鈕、鐵𬫑、鐵械，上火徹下，下火徹上，彌覆其地赤鐵」。"}
{"id": null, "n": "0364009", "target": "#nkr_note_orig_0364009", "type": "orig", "text": "「猶」，甲、乙、丙本作「由」。下同。"}
{"id": null, "n": "0364010", "target": "#nkr_note_orig_0364010", "type": "orig", "text": "甲本至此止。"}
{"id": null, "n": "0364011", "target": "#nkr_note_orig_0364011", "type": "orig", "text": "「百」，底本無，據乙、丙、丁、戊本補。"}
{"id": null, "n": "0365001", "target": "#nkr_note_orig_0365001", "type": "orig", "text": "「旬」，底本作「巡」，據乙、丙、丁、戊本改。下同。"}
{"id": null, "n": "0365002", "target": "#nkr_note_orig_0365002", "type": "orig", "text": "「炙」，乙、丙本作「鐵」。"}
{"id": null, "n": "0365003", "target": "#nkr_note_orig_0365003", "type": "orig", "text": "「縱廣八萬由旬」，乙、丙本無。"}
{"id": null, "n": "0365004", "target": "#nkr_note_orig_0365004", "type": "orig", "text": "「有」，底、丁、戊本無，據乙、丙本補。"}
{"id": null, "n": "0365005", "target": "#nkr_note_orig_0365005", "type": "orig", "text": "「持火燒之」，乙、丙本無。"}
{"id": null, "n": "0365006", "target": "#nkr_note_orig_0365006", "type": "orig", "text": "「肉乾燋爛」，乙、丙本無。"}
{"id": null, "n": "0365007", "target": "#nkr_note_orig_0365007", "type": "orig", "text": "「即」，丙本無。"}
{"id": null, "n": "0365008", "target": "#nkr_note_orig_0365008", "type": "orig", "text": "「受形，即還斬之」，丁本無。"}
{"id": null, "n": "0365009", "target": "#nkr_note_orig_0365009", "type": "orig", "text": "「若」，丁、戊本無。"}
{"id": null, "n": "0365010", "target": "#nkr_note_orig_0365010", "type": "orig", "text": "「或臣食君肉，或君食臣肉」，底、乙、丙、丁本作「或君食臣肉，或臣食君肉」，據戊本改。"}
{"id": null, "n": "0365011", "target": "#nkr_note_orig_0365011", "type": "orig", "text": "「或妹食姊肉，或姊食妹肉」，乙、丙本作「或姊食妹肉，或妹食姊肉」。"}
{"id": null, "n": "0365012", "target": "#nkr_note_orig_0365012", "type": "orig", "text": "「或食內、外眷屬肉」，底、乙、丙、丁本無，據戊本補。"}
{"id": null, "n": "0366001", "target": "#nkr_note_orig_0366001", "type": "orig", "text": "「猶」，乙、丙本作「由」。"}
{"id": null, "n": "0366002", "target": "#nkr_note_orig_0366002", "type": "orig", "text": "「爭骨，各各貪多。食肉之人亦復如是」，底本作「各各爭骨。食肉之人，各各貪多」，乙、丙本作「各爭骨。食肉之人，各各貪多」，據丁、戊本改。"}
{"id": null, "n": "0366003", "target": "#nkr_note_orig_0366003", "type": "orig", "text": "「割」，丁本作「割父肉、割害」。"}
{"id": null, "n": "0366004", "target": "#nkr_note_orig_0366004", "type": "orig", "text": "「父」，乙、丙本作「母」。"}
{"id": null, "n": "0366005", "target": "#nkr_note_orig_0366005", "type": "orig", "text": "「者」，底、乙、丙本無，據丁、戊本補。"}
{"id": null, "n": "0366006", "target": "#nkr_note_orig_0366006", "type": "orig", "text": "「能」，乙、丙本作「乃」。"}
{"id": null, "n": "0366007", "target": "#nkr_note_orig_0366007", "type": "orig", "text": "「爪」，乙、丙、丁、戊本作「抓」。"}
{"id": null, "n": "0366008", "target": "#nkr_note_orig_0366008", "type": "orig", "text": "「暮」，乙、丙本作「慕」。"}
{"id": null, "n": "0366009", "target": "#nkr_note_orig_0366009", "type": "orig", "text": "己本自此始。"}
{"id": null, "n": "0366010", "target": "#nkr_note_orig_0366010", "type": "orig", "text": "「苦」，底本作「苦復離此地獄，受其大苦」，據乙、丙、丁、戊、己本刪。"}
{"id": null, "n": "0367001", "target": "#nkr_note_orig_0367001", "type": "orig", "text": "「猶如須彌，持火燒之」，丁本無。"}
{"id": null, "n": "0367002", "target": "#nkr_note_orig_0367002", "type": "orig", "text": "「齋」，乙、丙、己本作「齋食」。"}
{"id": null, "n": "0367003", "target": "#nkr_note_orig_0367003", "type": "orig", "text": "「服」，丁、戊本無。"}
{"id": null, "n": "0367004", "target": "#nkr_note_orig_0367004", "type": "orig", "text": "「食」，底、丁、戊本作「食者」，據乙、丙、己本改。"}
{"id": null, "n": "0367005", "target": "#nkr_note_orig_0367005", "type": "orig", "text": "「入」，乙、丙、己本無。"}
{"id": null, "n": "0367006", "target": "#nkr_note_orig_0367006", "type": "orig", "text": "「出」，底、乙、丙、己本無，據丁、戊本補。"}
{"id": null, "n": "0367007", "target": "#nkr_note_orig_0367007", "type": "orig", "text": "「者」，戊本無。"}
{"id": null, "n": "0367008", "target": "#nkr_note_orig_0367008", "type": "orig", "text": "「迦葉菩薩白佛言：世尊」，乙、丙、己本無。"}
{"id": null, "n": "0367009", "target": "#nkr_note_orig_0367009", "type": "orig", "text": "「琉璃、珍寶」，乙、丙本無。"}
{"id": null, "n": "0367010", "target": "#nkr_note_orig_0367010", "type": "orig", "text": "「人」，底本無，據乙、丙、丁、戊、己本補。"}
{"id": null, "n": "0367011", "target": "#nkr_note_orig_0367011", "type": "orig", "text": "「人」，丁、戊本無。"}
{"id": null, "n": "0367012", "target": "#nkr_note_orig_0367012", "type": "orig", "text": "「能」，乙、丙、己本無。"}
{"id": null, "n": "0367013", "target": "#nkr_note_orig_0367013", "type": "orig", "text": "「華」，己本作「花」。"}
{"id": null, "n": "0368001", "target": "#nkr_note_orig_0368001", "type": "orig", "text": "「簷簷」，底本作「簷」，乙、丙本作「擔擔」，據丁、戊、己本改。"}
{"id": null, "n": "0368002", "target": "#nkr_note_orig_0368002", "type": "orig", "text": "「者」，乙、丙、己本作「之人」。"}
{"id": null, "n": "0368003", "target": "#nkr_note_orig_0368003", "type": "orig", "text": "「想」，乙、丙本作「相」。"}
{"id": null, "n": "0368004", "target": "#nkr_note_orig_0368004", "type": "orig", "text": "「已」，底、戊本作「以」，據乙、丙、己本改。"}
{"id": null, "n": "0368005", "target": "#nkr_note_orig_0368005", "type": "orig", "text": "「見」，戊本作「現」。"}
{"id": null, "n": "0368006", "target": "#nkr_note_orig_0368006", "type": "orig", "text": "「即生肉想，見而生害」，底、戊本作「食肉之人見而生害，即生肉想」，丁本作「見而生害，即生肉想」，據乙、丙、己本改。"}
{"id": null, "n": "0368007", "target": "#nkr_note_orig_0368007", "type": "orig", "text": "「告」，底本作「生」，據乙、丙、丁、戊、己本改。"}
{"id": null, "n": "0368008", "target": "#nkr_note_orig_0368008", "type": "orig", "text": "「貧」，底本作「分」，據乙、丙、戊、己本改。"}
{"id": null, "n": "0368009", "target": "#nkr_note_orig_0368009", "type": "orig", "text": "「團」，底、乙、丙、己本作「摶」，據丁、戊本改。"}
{"id": null, "n": "0368010", "target": "#nkr_note_orig_0368010", "type": "orig", "text": "「授」，己本作「受」。"}
{"id": null, "n": "0368011", "target": "#nkr_note_orig_0368011", "type": "orig", "text": "「受」，底、丁、戊本作「授」，據乙、丙、己本改。"}
{"id": null, "n": "0368012", "target": "#nkr_note_orig_0368012", "type": "orig", "text": "「華」，己本作「花」。"}
{"id": null, "n": "0368013", "target": "#nkr_note_orig_0368013", "type": "orig", "text": "「品」，乙、丙、己本無。"}
