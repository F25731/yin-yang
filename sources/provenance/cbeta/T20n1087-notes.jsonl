{"id": null, "n": "0211009", "target": "#nkr_note_mod_0211009", "type": "mod", "text": "要【大】，要出大部【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "出大部"}
{"id": null, "n": "0211010", "target": "#nkr_note_mod_0211010", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0211011", "target": "#nkr_note_mod_0211011", "type": "mod", "text": "大【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0211012", "target": "#nkr_note_mod_0211012", "type": "mod", "text": "藏【大】，藏法師【宋】【元】【明】"}
{"id": null, "n": "0211013", "target": "#nkr_note_mod_0211013", "type": "mod", "text": "生【大】，罪【宋】【元】【明】"}
{"id": null, "n": "0211014", "target": "#nkr_note_mod_0211014", "type": "mod", "text": "願【大】，敬【宋】"}
{"id": null, "n": "0212001", "target": "#nkr_note_mod_0212001", "type": "mod", "text": "想【大】，頂【宋】【元】【明】"}
{"id": null, "n": "0212002", "target": "#nkr_note_mod_0212002", "type": "mod", "text": "入【大】＊，入聲【明】＊"}
{"id": null, "n": "0212003", "target": "#nkr_note_mod_0212003", "type": "mod", "text": "吉【大】，害【明】"}
{"id": null, "n": "0212004", "target": "#nkr_note_mod_0212004", "type": "mod", "text": "竪【大】，堅【宋】"}
{"id": null, "n": "0212005", "target": "#nkr_note_mod_0212005", "type": "mod", "text": "二合【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0212006", "target": "#nkr_note_mod_0212006", "type": "mod", "text": "磨【大】，麼【宋】【元】【明】"}
{"id": null, "n": "0212007", "target": "#nkr_note_mod_0212007", "type": "mod", "text": "由【大】＊，猶【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0212008", "target": "#nkr_note_mod_0212008", "type": "mod", "text": "去【大】＊，去聲【明】＊"}
{"id": null, "n": "0212009", "target": "#nkr_note_mod_0212009", "type": "mod", "text": "上【大】＊，上聲【明】＊"}
{"id": null, "n": "0212010", "target": "#nkr_note_mod_0212010", "type": "mod", "text": "施【大】，方【宋】【元】【明】"}
{"id": null, "n": "0212011", "target": "#nkr_note_mod_0212011", "type": "mod", "text": "破【大】，碎【宋】【元】【明】"}
{"id": null, "n": "0212012", "target": "#nkr_note_mod_0212012", "type": "mod", "text": "丁以反【大】，〔－〕【明】"}
{"id": null, "n": "0212013", "target": "#nkr_note_mod_0212013", "type": "mod", "text": "無繁反【大】，〔－〕【明】，無反【元】"}
{"id": null, "n": "0212014", "target": "#nkr_note_mod_0212014", "type": "mod", "text": "薩【大】，凡薩【元】【明】"}
{"id": null, "n": "0212015", "target": "#nkr_note_mod_0212015", "type": "mod", "text": "妙【大】，密【宋】【元】【明】"}
{"id": null, "n": "0212016", "target": "#nkr_note_mod_0212016", "type": "mod", "text": "葉【大】，華【宋】【元】【明】"}
{"id": null, "n": "0212017", "target": "#nkr_note_mod_0212017", "type": "mod", "text": "麼地【大】，磨他【宋】【元】【明】"}
{"id": null, "n": "0213001", "target": "#nkr_note_mod_0213001", "type": "mod", "text": "慜【大】，愍【宋】【元】【明】"}
{"id": null, "n": "0213002", "target": "#nkr_note_mod_0213002", "type": "mod", "text": "輪【大】＊，轉【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0213003", "target": "#nkr_note_mod_0213003", "type": "mod", "text": "麼【大】，〔－〕【宋】【元】"}
{"id": null, "n": "0213004", "target": "#nkr_note_mod_0213004", "type": "mod", "text": "茶【大】，荼【宋】【元】"}
{"id": null, "n": "0213005", "target": "#nkr_note_mod_0213005", "type": "mod", "text": "怛【大】，恒【明】"}
{"id": null, "n": "0213006", "target": "#nkr_note_mod_0213006", "type": "mod", "text": "麼【大】，摩【宋】【元】【明】"}
{"id": null, "n": "0213007", "target": "#nkr_note_mod_0213007", "type": "mod", "text": "摩【大】，麼【宋】【元】【明】"}
{"id": null, "n": "0213008", "target": "#nkr_note_mod_0213008", "type": "mod", "text": "蘗【大】，𮒶【宋】【元】【明】"}
{"id": null, "n": "0213009", "target": "#nkr_note_mod_0213009", "type": "mod", "text": "囉【大】，囉囉【元】【明】"}
{"id": null, "n": "0213010", "target": "#nkr_note_mod_0213010", "type": "mod", "text": "灌【大】，囉【宋】【元】【明】"}
{"id": null, "n": "0213011", "target": "#nkr_note_mod_0213011", "type": "mod", "text": "𤚥【大】，󳟑【元】【明】"}
{"id": null, "n": "0213012", "target": "#nkr_note_mod_0213012", "type": "mod", "text": "𠸪【大】，洛【宋】【元】"}
