{"id": null, "n": null, "target": null, "type": null, "text": "幻身之"}
{"id": null, "n": null, "target": null, "type": null, "text": "實相之"}
{"id": null, "n": null, "target": null, "type": null, "text": "一切\n\n事物之"}
{"id": null, "n": null, "target": null, "type": null, "text": "到底"}
{"id": null, "n": null, "target": null, "type": null, "text": "此事物之"}
{"id": null, "n": null, "target": null, "type": null, "text": "實相之真"}
{"id": null, "n": null, "target": null, "type": null, "text": "幻有之有有形，名為常有。實相之"}
{"id": null, "n": null, "target": null, "type": null, "text": "無質，乃是"}
{"id": null, "n": null, "target": null, "type": null, "text": "曰"}
{"id": null, "n": null, "target": null, "type": null, "text": "虗空之空無質，名為\n斷空。真空之"}
{"id": null, "n": null, "target": null, "type": null, "text": "有象，乃是"}
{"id": null, "n": null, "target": null, "type": null, "text": "曰"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": "0820001", "target": "#nkr_note_orig_0820001", "type": "orig", "text": "知疑智"}
{"id": null, "n": "0821001", "target": "#nkr_note_orig_0821001", "type": "orig", "text": "悉原本似作迷"}
{"id": null, "n": "0821002", "target": "#nkr_note_orig_0821002", "type": "orig", "text": "聲疑多"}
{"id": null, "n": "0821003", "target": "#nkr_note_orig_0821003", "type": "orig", "text": "看原本似作着"}
{"id": null, "n": "0825001", "target": "#nkr_note_orig_0825001", "type": "orig", "text": "兌疑脫"}
{"id": null, "n": "0825002", "target": "#nkr_note_orig_0825002", "type": "orig", "text": "王疑門"}
