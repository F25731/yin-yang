{"id": null, "n": "0604043", "target": "#nkr_note_mod_0604043", "type": "mod", "text": "西【大】，宋西【明】"}
{"id": null, "n": "0604044", "target": "#nkr_note_mod_0604044", "type": "mod", "text": "那爛陀寺【大】，〔－〕【明】"}
{"id": null, "n": "0604045", "target": "#nkr_note_mod_0604045", "type": "mod", "text": "沙門【大】，〔－〕【明】"}
{"id": null, "n": "0604046", "target": "#nkr_note_mod_0604046", "type": "mod", "text": "臣【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0605001", "target": "#nkr_note_mod_0605001", "type": "mod", "text": "祛【大】＊，袪【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0605002", "target": "#nkr_note_mod_0605002", "type": "mod", "text": "仁【大】，七【元】【明】"}
{"id": null, "n": "0605003", "target": "#nkr_note_mod_0605003", "type": "mod", "text": "反【大】，切【明】，以下真言皆同"}
{"id": null, "n": "0605004", "target": "#nkr_note_mod_0605004", "type": "mod", "text": "莫【大】，謨【明】"}
{"id": null, "n": "0605005", "target": "#nkr_note_mod_0605005", "type": "mod", "text": "羅【大】，囉【宋】【元】【明】"}
{"id": null, "n": "0605007", "target": "#nkr_note_mod_0605007", "type": "mod", "text": "誦持【大】，持誦【明】"}
