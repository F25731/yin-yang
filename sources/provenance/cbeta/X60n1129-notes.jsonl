{"id": null, "n": "0680001", "target": "#nkr_note_orig_0680001", "type": "orig", "text": "祜疑祐"}
{"id": null, "n": "0695001", "target": "#nkr_note_orig_0695001", "type": "orig", "text": "平下疑脫等字"}
{"id": null, "n": "0695002", "target": "#nkr_note_orig_0695002", "type": "orig", "text": "與疑興"}
