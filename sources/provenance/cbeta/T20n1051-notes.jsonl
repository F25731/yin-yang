{"id": null, "n": "0064002", "target": "#nkr_note_mod_0064002", "type": "mod", "text": "一卷【大】，經【宋】【元】【明】"}
{"id": null, "n": "0064003", "target": "#nkr_note_mod_0064003", "type": "mod", "text": "西【大】，宋西【明】"}
{"id": null, "n": "0064004", "target": "#nkr_note_mod_0064004", "type": "mod", "text": "譯經【大】，〔－〕【明】"}
{"id": null, "n": "0064005", "target": "#nkr_note_mod_0064005", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0064006", "target": "#nkr_note_mod_0064006", "type": "mod", "text": "呼【大】，乎【明】"}
{"id": null, "n": "0064007", "target": "#nkr_note_mod_0064007", "type": "mod", "text": "陀【大】，陀羅【明】"}
{"id": null, "n": "0064008", "target": "#nkr_note_mod_0064008", "type": "mod", "text": "一【大】＊，一句【明】＊"}
{"id": null, "n": "0064009", "target": "#nkr_note_mod_0064009", "type": "mod", "text": "慾【大】，欲【明】"}
{"id": null, "n": "0065001", "target": "#nkr_note_mod_0065001", "type": "mod", "text": "冤【大】＊，怨【明】＊"}
{"id": null, "n": "0065002", "target": "#nkr_note_mod_0065002", "type": "mod", "text": "銷【大】，消【宋】【元】【明】"}
{"id": null, "n": "0065003", "target": "#nkr_note_mod_0065003", "type": "mod", "text": "能【大】，得【明】"}
{"id": null, "n": "0065004", "target": "#nkr_note_mod_0065004", "type": "mod", "text": "異【大】，畏【宋】【元】【明】"}
{"id": null, "n": "0065005", "target": "#nkr_note_mod_0065005", "type": "mod", "text": "二【大】，一【宋】"}
{"id": null, "n": "0065006", "target": "#nkr_note_mod_0065006", "type": "mod", "text": "一【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0066001", "target": "#nkr_note_mod_0066001", "type": "mod", "text": "降【大】，〔－〕【明】"}
{"id": null, "n": "0066002", "target": "#nkr_note_mod_0066002", "type": "mod", "text": "合【大】，合引【元】【明】"}
{"id": null, "n": "0066003", "target": "#nkr_note_mod_0066003", "type": "mod", "text": "引【大】，引一【宋】【元】，引一句【明】"}
{"id": null, "n": "0066004", "target": "#nkr_note_mod_0066004", "type": "mod", "text": "薩【大】，提【明】"}
{"id": null, "n": "0066005", "target": "#nkr_note_mod_0066005", "type": "mod", "text": "二【大】，一【元】"}
{"id": null, "n": "0066006", "target": "#nkr_note_mod_0066006", "type": "mod", "text": "瓈【大】，𭹳【宋】【元】"}
{"id": null, "n": "0067001", "target": "#nkr_note_mod_0067001", "type": "mod", "text": "梨【大】＊，𪏭【明】＊"}
{"id": null, "n": "0067002", "target": "#nkr_note_mod_0067002", "type": "mod", "text": "一卷【大】，經【明】"}
{"id": null, "n": "0067003", "target": "#nkr_note_mod_0067003", "type": "mod", "text": "乙巳歲高麗國大藏都監奉勅雕造【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0064001", "target": "#nkr_note_orig_0064001", "type": "orig", "text": "【原】麗本"}
