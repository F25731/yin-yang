{"id": null, "n": "0280003", "target": "#nkr_note_orig_0280003", "type": "orig", "text": "「磣」，甲本作「慘」。"}
{"id": null, "n": "0280004", "target": "#nkr_note_orig_0280004", "type": "orig", "text": "「等」，甲本作「等等」。"}
{"id": null, "n": "0280005", "target": "#nkr_note_orig_0280005", "type": "orig", "text": "「弟子等從無始以來，至於今日」，甲本無。"}
{"id": null, "n": "0280006", "target": "#nkr_note_orig_0280006", "type": "orig", "text": "「供」，底、甲本作「拱」，據文意改。"}
{"id": null, "n": "0280007", "target": "#nkr_note_orig_0280007", "type": "orig", "text": "「但」，甲本作「俱」。"}
{"id": null, "n": "0280008", "target": "#nkr_note_orig_0280008", "type": "orig", "text": "「之」，底本無，據甲本補。"}
{"id": null, "n": "0280009", "target": "#nkr_note_orig_0280009", "type": "orig", "text": "「口」，底本作「口不過三寸舌根」，據甲本刪。"}
{"id": null, "n": "0281001", "target": "#nkr_note_orig_0281001", "type": "orig", "text": "「者」，甲本無。"}
{"id": null, "n": "0281002", "target": "#nkr_note_orig_0281002", "type": "orig", "text": "「不過三寸舌根而已」，底本無，據甲本補。"}
{"id": null, "n": "0281003", "target": "#nkr_note_orig_0281003", "type": "orig", "text": "「鱠」，甲本作「鱠賃為形」。"}
{"id": null, "n": "0281004", "target": "#nkr_note_orig_0281004", "type": "orig", "text": "「烹」，甲本作「亨」。"}
{"id": null, "n": "0281005", "target": "#nkr_note_orig_0281005", "type": "orig", "text": "「至於今日」，甲本無。"}
{"id": null, "n": "0281006", "target": "#nkr_note_orig_0281006", "type": "orig", "text": "「牙」，甲本作「噉」。"}
{"id": null, "n": "0281007", "target": "#nkr_note_orig_0281007", "type": "orig", "text": "「樵」，甲本作「燋」。"}
{"id": null, "n": "0281008", "target": "#nkr_note_orig_0281008", "type": "orig", "text": "「燭」，甲本無。"}
{"id": null, "n": "0281009", "target": "#nkr_note_orig_0281009", "type": "orig", "text": "「瀉」，底、甲本作「寫」，據文意改。"}
{"id": null, "n": "0282001", "target": "#nkr_note_orig_0282001", "type": "orig", "text": "「常」，底本作「常常」，據甲本刪。"}
{"id": null, "n": "0282002", "target": "#nkr_note_orig_0282002", "type": "orig", "text": "「約」，底本作「的」，據甲本改。"}
{"id": null, "n": "0282003", "target": "#nkr_note_orig_0282003", "type": "orig", "text": "「難」，底本殘缺，據甲本補。"}
{"id": null, "n": "0282004", "target": "#nkr_note_orig_0282004", "type": "orig", "text": "「令」，甲本作「今」。"}
{"id": null, "n": "0282005", "target": "#nkr_note_orig_0282005", "type": "orig", "text": "「菩薩」，甲本無。"}
{"id": null, "n": "0282006", "target": "#nkr_note_orig_0282006", "type": "orig", "text": "「寶」，底本殘，據甲本補。"}
{"id": null, "n": "0282007", "target": "#nkr_note_orig_0282007", "type": "orig", "text": "「火地」，底本殘，據甲本補。"}
{"id": null, "n": "0282008", "target": "#nkr_note_orig_0282008", "type": "orig", "text": "「鐵網覆」，底本殘，據甲本補。"}
{"id": null, "n": "0283001", "target": "#nkr_note_orig_0283001", "type": "orig", "text": "「盛」，甲本作「熾」。"}
{"id": null, "n": "0283002", "target": "#nkr_note_orig_0283002", "type": "orig", "text": "「洞」，甲本作「同」。"}
{"id": null, "n": "0283003", "target": "#nkr_note_orig_0283003", "type": "orig", "text": "「遍」，底本至此止。"}
{"id": null, "n": "0283004", "target": "#nkr_note_orig_0283004", "type": "orig", "text": "「布」，以下以甲本斯581號為底本。"}
{"id": null, "n": "0283005", "target": "#nkr_note_orig_0283005", "type": "orig", "text": "「湯」，底本無，據文意補。"}
{"id": null, "n": "0283006", "target": "#nkr_note_orig_0283006", "type": "orig", "text": "「流」，底本無，據文意補。"}
{"id": null, "n": "0284001", "target": "#nkr_note_orig_0284001", "type": "orig", "text": "「六」，甲本至此止。"}
{"id": null, "n": "0285001", "target": "#nkr_note_orig_0285001", "type": "orig", "text": "「佛」，底本自此始。"}
{"id": null, "n": "0285002", "target": "#nkr_note_orig_0285002", "type": "orig", "text": "「佛」，《大正藏》本作「佛。南無那羅延藏佛。南無常決定智佛」，參見《大正藏》第14卷第135頁中欄～下欄。"}
{"id": null, "n": "0285003", "target": "#nkr_note_orig_0285003", "type": "orig", "text": "「南無常決定智佛。南無福德光明佛。南無波頭摩藏佛。南無那羅延藏佛」，《大正藏》本作「南無福德光明佛」，參見《大正藏》第14卷第135頁下欄。"}
{"id": null, "n": "0285004", "target": "#nkr_note_orig_0285004", "type": "orig", "text": "「三千九百」，《大正藏》本無。參見《大正藏》第14卷第135頁下欄。"}
{"id": null, "n": "0286001", "target": "#nkr_note_orig_0286001", "type": "orig", "text": "「佛」，甲本自此始。"}
{"id": null, "n": "0287001", "target": "#nkr_note_orig_0287001", "type": "orig", "text": "「露」，底、甲本作「密」，據《大正藏》本改。參見《大正藏》第14卷第136頁上欄。"}
{"id": null, "n": "0287002", "target": "#nkr_note_orig_0287002", "type": "orig", "text": "「破」，甲本作「礙」。"}
{"id": null, "n": "0287003", "target": "#nkr_note_orig_0287003", "type": "orig", "text": "「佛」，《大正藏》本作「種種日佛」，參見《大正藏》第14卷第136頁上欄。"}
{"id": null, "n": "0288001", "target": "#nkr_note_orig_0288001", "type": "orig", "text": "「千」，甲作「千。從此已上四千佛」。《大正藏》本無，參見《大正藏》第14卷第136頁上欄。"}
{"id": null, "n": "0289001", "target": "#nkr_note_orig_0289001", "type": "orig", "text": "「佛」，甲、《大正藏》本作「佛。南無聖化佛。南無大功德佛」。參見《大正藏》第14卷第136頁中欄。"}
{"id": null, "n": "0290001", "target": "#nkr_note_orig_0290001", "type": "orig", "text": "「南無聖化佛。南無大功德佛」，甲、《大正藏》本本無。參見《大正藏》第14卷第136頁中欄。"}
{"id": null, "n": "0290002", "target": "#nkr_note_orig_0290002", "type": "orig", "text": "「南」，乙本自此始。"}
{"id": null, "n": "0290003", "target": "#nkr_note_orig_0290003", "type": "orig", "text": "「四千一百」，底、乙本同，乙本此行後有雜寫「南無十方之佛」。甲本作「從此已上四千一百佛」。「南無大燈佛……四千一百」三十二字，《大正藏》本無。"}
{"id": null, "n": "0291001", "target": "#nkr_note_orig_0291001", "type": "orig", "text": "「天」，丙本自此始。"}
{"id": null, "n": "0291002", "target": "#nkr_note_orig_0291002", "type": "orig", "text": "「南無喜喜佛」《大正藏》本作「南無善力佛。南無喜菩提佛」，參見《大正藏》第14卷第136頁中欄。"}
{"id": null, "n": "0292001", "target": "#nkr_note_orig_0292001", "type": "orig", "text": "「寶幢」，底、乙本同；甲本作「實幢」；丙本作「實」。"}
{"id": null, "n": "0292002", "target": "#nkr_note_orig_0292002", "type": "orig", "text": "「電」，底、乙、丙本作「雷」，據甲本及文意改。"}
{"id": null, "n": "0293001", "target": "#nkr_note_orig_0293001", "type": "orig", "text": "「四千二百」，底、乙本同；甲本作「從此已上四千二百佛」；丙本作「從此已上四千二百佛、十二部經、一切賢聖」。《大正藏》本無。參見《大正藏》第14卷第137頁上欄。"}
{"id": null, "n": "0294001", "target": "#nkr_note_orig_0294001", "type": "orig", "text": "「聚」，底、乙、丙本同；甲本作「聖」。"}
{"id": null, "n": "0294002", "target": "#nkr_note_orig_0294002", "type": "orig", "text": "「南無常釋智慧佛……南無功德聚佛」此段文字見《大正藏》本第14卷第135頁中欄～第137頁上欄。"}
{"id": null, "n": "0295001", "target": "#nkr_note_orig_0295001", "type": "orig", "text": "「歡」，底、乙、丙同；甲本作「觀」。"}
{"id": null, "n": "0295002", "target": "#nkr_note_orig_0295002", "type": "orig", "text": "「四千三百」，底、乙本同；甲本作「從此已上四千三百佛」；丙本作「從此已上四千三百佛、/十二部經、一切賢聖」。《大正藏》本無，參見《大正藏》第14卷第137頁下欄。"}
{"id": null, "n": "0296001", "target": "#nkr_note_orig_0296001", "type": "orig", "text": "「如」，底、甲、乙本同；丙本無。"}
{"id": null, "n": "0296002", "target": "#nkr_note_orig_0296002", "type": "orig", "text": "「功」，甲、乙、丙本無。"}
{"id": null, "n": "0297001", "target": "#nkr_note_orig_0297001", "type": "orig", "text": "「迅」，底、甲、丙本同；乙本無。"}
{"id": null, "n": "0298001", "target": "#nkr_note_orig_0298001", "type": "orig", "text": "「四千四百」，底、乙本同；甲本作「從此已上四千五百佛」；丙本作「從此已上四千四百佛、十二部經、一切賢聖」。《大正藏》本無，參見《大正藏》第14卷第138頁上欄。"}
{"id": null, "n": "0300001", "target": "#nkr_note_orig_0300001", "type": "orig", "text": "「南無見信佛……南無捨重擔佛」三十六字，甲本重復。"}
{"id": null, "n": "0300002", "target": "#nkr_note_orig_0300002", "type": "orig", "text": "「四千五百」，底、乙本同；甲本作「從此已上四千五百佛」；丙本作「從此已上四千五百佛、十二部經、一切賢聖」。《大正藏》本無，參見《大正藏》第14卷第138頁中欄。"}
{"id": null, "n": "0301001", "target": "#nkr_note_orig_0301001", "type": "orig", "text": "「菩」，底、甲、乙、丙本作「善」，據《大正藏》本改，參見《大正藏》第14卷第138頁中欄。"}
{"id": null, "n": "0302001", "target": "#nkr_note_orig_0302001", "type": "orig", "text": "「南無攝慧佛……南無甘露光明佛」，此段文字見《大正藏》本第14卷第137頁中欄～第138頁下欄。"}
{"id": null, "n": "0303001", "target": "#nkr_note_orig_0303001", "type": "orig", "text": "「眾」，底、甲、丙本無，據乙本補。"}
{"id": null, "n": "0303002", "target": "#nkr_note_orig_0303002", "type": "orig", "text": "「四千六百」，底、乙本同；甲本作「從此已上四千六百佛」；丙本作「從此已上四千六百佛、十二部經、一切賢聖」。"}
{"id": null, "n": "0303003", "target": "#nkr_note_orig_0303003", "type": "orig", "text": "「南無大勢辟支佛……南無不可比辟支佛」，此段文字見《大正藏》本第14卷第145頁下欄。"}
{"id": null, "n": "0304001", "target": "#nkr_note_orig_0304001", "type": "orig", "text": "「有愛則生，愛盡則滅」，可見於《成實論》卷二，參見《大正藏》第32卷第248頁下欄。"}
{"id": null, "n": "0304002", "target": "#nkr_note_orig_0304002", "type": "orig", "text": "「眷」，底、甲、丙本同；乙本作「卷」。"}
{"id": null, "n": "0304003", "target": "#nkr_note_orig_0304003", "type": "orig", "text": "「子」，底、甲、丙本無，據乙本補。"}
{"id": null, "n": "0304004", "target": "#nkr_note_orig_0304004", "type": "orig", "text": "「得」，底、甲、丙本同；乙本作「德」。"}
{"id": null, "n": "0305001", "target": "#nkr_note_orig_0305001", "type": "orig", "text": "「朱」，底、甲、丙本同；乙本作「珠」。"}
{"id": null, "n": "0305002", "target": "#nkr_note_orig_0305002", "type": "orig", "text": "「縠」，底、甲、乙、丙本作「穀」，據文意改。"}
{"id": null, "n": "0305003", "target": "#nkr_note_orig_0305003", "type": "orig", "text": "「慇」，底、甲、丙本同，乙本作「殷」。"}
{"id": null, "n": "0305004", "target": "#nkr_note_orig_0305004", "type": "orig", "text": "「恩」，底、甲、乙、丙本作「思」，據文意改。"}
{"id": null, "n": "0305005", "target": "#nkr_note_orig_0305005", "type": "orig", "text": "「想」，底、甲、乙本同；丙本作「相」。"}
{"id": null, "n": "0306001", "target": "#nkr_note_orig_0306001", "type": "orig", "text": "「相」，底、甲、乙本同；丙本作「想」。"}
{"id": null, "n": "0306002", "target": "#nkr_note_orig_0306002", "type": "orig", "text": "「臭」，乙、丙本同；底、甲本作「鼻」。"}
{"id": null, "n": "0306003", "target": "#nkr_note_orig_0306003", "type": "orig", "text": "「肉」，底、甲、乙本同；丙本作「內」。"}
{"id": null, "n": "0306004", "target": "#nkr_note_orig_0306004", "type": "orig", "text": "「坐」，底、甲、丙本同；乙本無。"}
{"id": null, "n": "0306005", "target": "#nkr_note_orig_0306005", "type": "orig", "text": "「座」，底、甲、乙、丙本作「坐」，據文意改。"}
{"id": null, "n": "0306006", "target": "#nkr_note_orig_0306006", "type": "orig", "text": "「壁」，底、乙、丙本同；甲本作「避」。"}
{"id": null, "n": "0307001", "target": "#nkr_note_orig_0307001", "type": "orig", "text": "「馬頭」，底本無，據甲、乙、丙本補。"}
{"id": null, "n": "0307002", "target": "#nkr_note_orig_0307002", "type": "orig", "text": "底、甲、乙、丙本至此止。乙本此後有雜寫「佛名經卷第七，庚」。"}
