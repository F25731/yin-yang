{"id": null, "n": "0451045", "target": "#nkr_note_mod_0451045", "type": "mod", "text": "（八萬…過犯）六十四字【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0451046", "target": "#nkr_note_mod_0451046", "type": "mod", "text": "疲【大】，皮【宮】"}
{"id": null, "n": "0451047", "target": "#nkr_note_mod_0451047", "type": "mod", "text": "立【大】，步【宋】【元】【明】【宮】"}
{"id": null, "n": "0451048", "target": "#nkr_note_mod_0451048", "type": "mod", "text": "呰他財囂【大】，辱他物矯【宋】【元】【明】【宮】"}
