{"id": null, "n": "0451007", "target": "#nkr_note_mod_0451007", "type": "mod", "text": "吏【大】，里【宋】【元】【明】【宮】"}
{"id": null, "n": "0451008", "target": "#nkr_note_mod_0451008", "type": "mod", "text": "吁【大】，呼【宋】【元】【明】【宮】"}
{"id": null, "n": "0451009", "target": "#nkr_note_mod_0451009", "type": "mod", "text": "墮【大】，陷【宋】【元】【明】【宮】"}
