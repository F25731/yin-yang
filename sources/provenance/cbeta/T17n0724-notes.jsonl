{"id": null, "n": "0450010", "target": "#nkr_note_mod_0450010", "type": "mod", "text": "大【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0450011", "target": "#nkr_note_mod_0450011", "type": "mod", "text": "世尊【大】，〔－〕【宋】【元】【明】【宮】"}
