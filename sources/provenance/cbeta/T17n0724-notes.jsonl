{"id": null, "n": "0451011", "target": "#nkr_note_mod_0451011", "type": "mod", "text": "頸【大】，項【宋】【元】【明】【宮】"}
{"id": null, "n": "0451012", "target": "#nkr_note_mod_0451012", "type": "mod", "text": "為【大】，成【宋】【元】【明】【宮】"}
{"id": null, "n": "0451013", "target": "#nkr_note_mod_0451013", "type": "mod", "text": "常【大】，心常【宋】【元】【明】【宮】"}
{"id": null, "n": "0451014", "target": "#nkr_note_mod_0451014", "type": "mod", "text": "心【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0451015", "target": "#nkr_note_mod_0451015", "type": "mod", "text": "熱燒【大】，燒熱【宋】【元】【明】【宮】"}
{"id": null, "n": "0451016", "target": "#nkr_note_mod_0451016", "type": "mod", "text": "人【大】，入【明】"}
{"id": null, "n": "0451017", "target": "#nkr_note_mod_0451017", "type": "mod", "text": "身體【大】，其身【宋】【元】【明】【宮】"}
{"id": null, "n": "0451018", "target": "#nkr_note_mod_0451018", "type": "mod", "text": "誑他取財徒【大】，枉取他物使【宋】【元】【明】【宮】"}
{"id": null, "n": "0451019", "target": "#nkr_note_mod_0451019", "type": "mod", "text": "叉人【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0451020", "target": "#nkr_note_mod_0451020", "type": "mod", "text": "湯【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0451021", "target": "#nkr_note_mod_0451021", "type": "mod", "text": "搣【大】＊，滅【宮】＊"}
{"id": null, "n": "0451022", "target": "#nkr_note_mod_0451022", "type": "mod", "text": "煎煮【大】，煮之【宋】【元】【明】【宮】"}
{"id": null, "n": "0451023", "target": "#nkr_note_mod_0451023", "type": "mod", "text": "閉之【大】，自閉【宋】【元】【明】【宮】"}
