{"id": null, "n": "0452003", "target": "#nkr_note_mod_0452003", "type": "mod", "text": "羅【大】＊，罹【明】＊"}
{"id": null, "n": "0452004", "target": "#nkr_note_mod_0452004", "type": "mod", "text": "捕【大】，〔－〕【宮】"}
