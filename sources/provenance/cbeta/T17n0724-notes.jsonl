{"id": null, "n": "0450014", "target": "#nkr_note_mod_0450014", "type": "mod", "text": "巧【大】，旋【宋】【元】【明】【宮】"}
{"id": null, "n": "0450015", "target": "#nkr_note_mod_0450015", "type": "mod", "text": "世【大】，身【宋】【元】【明】【宮】"}
