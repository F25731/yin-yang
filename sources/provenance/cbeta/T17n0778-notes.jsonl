{"id": null, "n": "0714006", "target": "#nkr_note_mod_0714006", "type": "mod", "text": "佛說【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0714007", "target": "#nkr_note_mod_0714007", "type": "mod", "text": "臨淮【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0714008", "target": "#nkr_note_mod_0714008", "type": "mod", "text": "一【大】，謂一【宋】【元】【明】"}
{"id": null, "n": "0714009", "target": "#nkr_note_mod_0714009", "type": "mod", "text": "令【大】，今【宮】"}
{"id": null, "n": "0714010", "target": "#nkr_note_mod_0714010", "type": "mod", "text": "一【大】，〔－〕【宮】"}
{"id": null, "n": "0714011", "target": "#nkr_note_mod_0714011", "type": "mod", "text": "為【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0714012", "target": "#nkr_note_mod_0714012", "type": "mod", "text": "用【大】，若【元】【明】"}
{"id": null, "n": "0715001", "target": "#nkr_note_mod_0715001", "type": "mod", "text": "意【大】，曰意【宋】【元】【明】【宮】"}
{"id": null, "n": "0715002", "target": "#nkr_note_mod_0715002", "type": "mod", "text": "不【大】，〔－〕【宮】"}
{"id": null, "n": "0715003", "target": "#nkr_note_mod_0715003", "type": "mod", "text": "正【大】，政【宋】【宮】"}
{"id": null, "n": "0715004", "target": "#nkr_note_mod_0715004", "type": "mod", "text": "倚【大】，猗【宋】【宮】"}
{"id": null, "n": "0714006", "target": "#nkr_note_orig_0714006", "type": "orig", "text": "〔佛說〕－【三】【宮】＊"}
{"id": null, "n": "0714007", "target": "#nkr_note_orig_0714007", "type": "orig", "text": "〔臨淮〕－【三】【宮】"}
{"id": null, "n": "0714008", "target": "#nkr_note_orig_0714008", "type": "orig", "text": "（謂）＋一【三】"}
{"id": null, "n": "0714009", "target": "#nkr_note_orig_0714009", "type": "orig", "text": "令＝今【宮】"}
{"id": null, "n": "0714010", "target": "#nkr_note_orig_0714010", "type": "orig", "text": "〔一〕－【宮】"}
{"id": null, "n": "0714011", "target": "#nkr_note_orig_0714011", "type": "orig", "text": "〔為〕－【三】【宮】＊"}
{"id": null, "n": "0714012", "target": "#nkr_note_orig_0714012", "type": "orig", "text": "用＝若【元】【明】"}
{"id": null, "n": "0715001", "target": "#nkr_note_orig_0715001", "type": "orig", "text": "（曰）＋意【三】【宮】"}
{"id": null, "n": "0715002", "target": "#nkr_note_orig_0715002", "type": "orig", "text": "〔不〕－【宮】"}
{"id": null, "n": "0715003", "target": "#nkr_note_orig_0715003", "type": "orig", "text": "正＝政【宋】【宮】"}
{"id": null, "n": "0715004", "target": "#nkr_note_orig_0715004", "type": "orig", "text": "倚＝猗【宋】【宮】"}
