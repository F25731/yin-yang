{"id": null, "n": "0678010", "target": "#nkr_note_orig_0678010", "type": "orig", "text": "而字更勘"}
{"id": null, "n": "0678011", "target": "#nkr_note_orig_0678011", "type": "orig", "text": "澄疑證"}
