{"id": null, "n": "0679007", "target": "#nkr_note_orig_0679007", "type": "orig", "text": "云現流本作言"}
{"id": null, "n": "0679008", "target": "#nkr_note_orig_0679008", "type": "orig", "text": "覺字更勘"}
