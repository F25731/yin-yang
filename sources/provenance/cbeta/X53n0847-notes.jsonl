{"id": null, "n": "0678013", "target": "#nkr_note_orig_0678013", "type": "orig", "text": "因疑自"}
{"id": null, "n": "0679001", "target": "#nkr_note_orig_0679001", "type": "orig", "text": "雖上現流本有由是二字"}
{"id": null, "n": "0679002", "target": "#nkr_note_orig_0679002", "type": "orig", "text": "處作對"}
