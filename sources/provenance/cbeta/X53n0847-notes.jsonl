{"id": null, "n": "0679010", "target": "#nkr_note_orig_0679010", "type": "orig", "text": "至疑其"}
{"id": null, "n": "0679011", "target": "#nkr_note_orig_0679011", "type": "orig", "text": "示疑除"}
