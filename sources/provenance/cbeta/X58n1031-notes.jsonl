{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "源"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "詩亷切，亦草類"}
{"id": null, "n": null, "target": null, "type": null, "text": "音句，驚悲也"}
{"id": null, "n": null, "target": null, "type": null, "text": "裴休述也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即荊南張禪師"}
{"id": null, "n": null, "target": null, "type": null, "text": "即道圓也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音戶"}
{"id": null, "n": null, "target": null, "type": null, "text": "先儒注疏，皆謂之章句"}
{"id": null, "n": null, "target": null, "type": null, "text": "鹽鉄論云：荊山之人，以玉抵鵲。言其玉多而不寶之也。抵，擊也"}
{"id": null, "n": null, "target": null, "type": null, "text": "行路之人得之，乃傳之為寶。喻吾師已到寶所，凡出言指事，無非妙門，人自寶\n惜之耳"}
{"id": null, "n": null, "target": null, "type": null, "text": "吾師之教，圓頓明微，入其\n戶牖，即無迷執之憂，故言高枕"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼序法集，非序原人"}
{"id": null, "n": null, "target": null, "type": null, "text": "音淵，蛻也"}
{"id": null, "n": null, "target": null, "type": null, "text": "老子\n經注：芸芸，眾多義也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "天才"}
{"id": null, "n": null, "target": null, "type": null, "text": "地才"}
{"id": null, "n": null, "target": null, "type": null, "text": "搏，手擊也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "起下文斥\n迷執一篇。"}
{"id": null, "n": null, "target": null, "type": null, "text": "起下文人天教"}
{"id": null, "n": null, "target": null, "type": null, "text": "起下文小乘教"}
{"id": null, "n": null, "target": null, "type": null, "text": "起下\n文法相教"}
{"id": null, "n": null, "target": null, "type": null, "text": "老子即摩訶迦\n葉，仲尼即淨光童子"}
{"id": null, "n": null, "target": null, "type": null, "text": "始修六度為因，終證萬德為果"}
{"id": null, "n": null, "target": null, "type": null, "text": "始覆一簣為因，終成九仞為果"}
{"id": null, "n": null, "target": null, "type": null, "text": "始舉一步為因，終行千里為果"}
{"id": null, "n": null, "target": null, "type": null, "text": "天地雷風\n水火山澤，是謂八卦"}
{"id": null, "n": null, "target": null, "type": null, "text": "末則天地人物"}
{"id": null, "n": null, "target": null, "type": null, "text": "習儒道者"}
{"id": null, "n": null, "target": null, "type": null, "text": "習佛不了義教者"}
{"id": null, "n": null, "target": null, "type": null, "text": "習了義實教"}
{"id": null, "n": null, "target": null, "type": null, "text": "會前所斥，同歸一源，皆為正義"}
{"id": null, "n": null, "target": null, "type": null, "text": "餓鬼、修羅、地獄"}
{"id": null, "n": null, "target": null, "type": null, "text": "一氣二儀通為三也，\n亦可天地人為三"}
{"id": null, "n": null, "target": null, "type": null, "text": "出禪詮序"}
{"id": null, "n": null, "target": null, "type": null, "text": "大抄即云是無端也"}
{"id": null, "n": null, "target": null, "type": null, "text": "虎狼雖惡獸，而為師子所噉。爾雅云：狻猊如彪貓，食虎豹。狼者，徵祥記云：狼頭一角，黃色馬足。"}
{"id": null, "n": null, "target": null, "type": null, "text": "諡法\n曰：賊民多殺曰桀，殘義損善曰紂。上二句明長惡，下二句明棄善也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音戶"}
{"id": null, "n": null, "target": null, "type": null, "text": "音徑，近也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音淨"}
{"id": null, "n": null, "target": null, "type": null, "text": "出〔別〕\n異傳。"}
{"id": null, "n": null, "target": null, "type": null, "text": "嬖，音閉，愛也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "姓端木，名賜，字子貢"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦如禮記有祭法、祭統、祭義等文"}
{"id": null, "n": null, "target": null, "type": null, "text": "蘇，息也，死而更生也"}
{"id": null, "n": null, "target": null, "type": null, "text": "猗，音倚"}
{"id": null, "n": null, "target": null, "type": null, "text": "音輟，疲也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上感動妻，下感妻子"}
{"id": null, "n": null, "target": null, "type": null, "text": "普木切，打也"}
{"id": null, "n": null, "target": null, "type": null, "text": "丑栗切，打也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音憤"}
{"id": null, "n": null, "target": null, "type": null, "text": "音厰"}
{"id": null, "n": null, "target": null, "type": null, "text": "操，執\n也。釋名：戟，格也。傍有支格也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音工。說文云：車轂中鐵也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音翰，禦也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上音無，下\n音檄。男曰巫，女曰覡，即事鬼之徒也"}
{"id": null, "n": null, "target": null, "type": null, "text": "鈔意似以一人則田蚡，兩人則竇嬰、灌夫。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此言仁義\n本於性，性本於天也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "謙受益也"}
{"id": null, "n": null, "target": null, "type": null, "text": "人道惡盈，則鬼害於盈也"}
{"id": null, "n": null, "target": null, "type": null, "text": "三王謂夏、殷、周。"}
{"id": null, "n": null, "target": null, "type": null, "text": "玄宗注云：禮所以正君臣父子之別，明男女長幼之序，故可以安上化下\n也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "注云：風俗\n移易，先入樂聲，變隨人心，正由君德，正之與變，因樂而彰，故曰莫善於樂。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔上〕四在此篇中"}
{"id": null, "n": null, "target": null, "type": null, "text": "在第\n三篇中"}
{"id": null, "n": null, "target": null, "type": null, "text": "過去"}
{"id": null, "n": null, "target": null, "type": null, "text": "現在"}
{"id": null, "n": null, "target": null, "type": null, "text": "一、約境，於父母造殺業為上品；二、約心，則瞋心\n增勝，死墮地獄"}
{"id": null, "n": null, "target": null, "type": null, "text": "一、約境，於餘人造殺業為中品；二、約心，則慳貪增勝，死墮餓鬼"}
{"id": null, "n": null, "target": null, "type": null, "text": "一、約境，於蚊蚋等起殺業為下品；二、約心，則愚癡增勝，死墮畜生"}
{"id": null, "n": null, "target": null, "type": null, "text": "仁有博愛之德"}
{"id": null, "n": null, "target": null, "type": null, "text": "義有合宜之德"}
{"id": null, "n": null, "target": null, "type": null, "text": "禮有尊𢍉\n敬讓之德"}
{"id": null, "n": null, "target": null, "type": null, "text": "信有無虗妄之德"}
{"id": null, "n": null, "target": null, "type": null, "text": "智有照了之德"}
{"id": null, "n": null, "target": null, "type": null, "text": "塗，道也。地獄名火塗道，餓鬼名刀塗道，畜生名血塗道也"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注"}
{"id": null, "n": null, "target": null, "type": null, "text": "貪瞋猛盛者，即造十惡業"}
{"id": null, "n": null, "target": null, "type": null, "text": "貪來\n生富樂之報者，造諸善業"}
{"id": null, "n": null, "target": null, "type": null, "text": "厭下苦麤障，欣上淨妙離者，修四禪八定"}
{"id": null, "n": null, "target": null, "type": null, "text": "現世作善惡，即現身受苦樂報"}
{"id": null, "n": null, "target": null, "type": null, "text": "今生作善惡，次一生受報"}
{"id": null, "n": null, "target": null, "type": null, "text": "次二三生，乃至未來\n多生受報，名順後報"}
{"id": null, "n": null, "target": null, "type": null, "text": "心脾肝肺\n腎"}
{"id": null, "n": null, "target": null, "type": null, "text": "惑即煩惱障體，\n是第六識。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上皆序文"}
{"id": null, "n": null, "target": null, "type": null, "text": "貪名利以榮身"}
{"id": null, "n": null, "target": null, "type": null, "text": "瞋違\n情境，恐侵害身"}
{"id": null, "n": null, "target": null, "type": null, "text": "非理計挍"}
{"id": null, "n": null, "target": null, "type": null, "text": "俱生"}
{"id": null, "n": null, "target": null, "type": null, "text": "別業所感"}
{"id": null, "n": null, "target": null, "type": null, "text": "共業所感"}
{"id": null, "n": null, "target": null, "type": null, "text": "宜將瑜伽二節之文，對此論五道苦樂等身，三界\n\n勝劣等處，皆符合也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此二句即共造依報，同注文共業所感也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此二句即別造正報，同注云別業所感也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此翻和悅"}
{"id": null, "n": null, "target": null, "type": null, "text": "句此中引頌皆七字也"}
{"id": null, "n": null, "target": null, "type": null, "text": "一雙持，二持軸，三〔木〕，四善見，五馬耳，六象鼻，七〔魚〕"}
{"id": null, "n": null, "target": null, "type": null, "text": "東勝身，南瞻部，西牛貨，北俱盧"}
{"id": null, "n": null, "target": null, "type": null, "text": "自然粳米長半寸，不因耕種"}
{"id": null, "n": null, "target": null, "type": null, "text": "伏羲、神農、黃帝"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注"}
{"id": null, "n": null, "target": null, "type": null, "text": "能領納好惡之事"}
{"id": null, "n": null, "target": null, "type": null, "text": "能取像者"}
{"id": null, "n": null, "target": null, "type": null, "text": "能造作者念念遷流"}
{"id": null, "n": null, "target": null, "type": null, "text": "能了別者"}
{"id": null, "n": null, "target": null, "type": null, "text": "皮不是毛等"}
{"id": null, "n": null, "target": null, "type": null, "text": "知苦諦也"}
{"id": null, "n": null, "target": null, "type": null, "text": "斷集\n諦也"}
{"id": null, "n": null, "target": null, "type": null, "text": "道諦"}
{"id": null, "n": null, "target": null, "type": null, "text": "滅諦"}
{"id": null, "n": null, "target": null, "type": null, "text": "根、境等為緣"}
{"id": null, "n": null, "target": null, "type": null, "text": "悶絕、睡眠、滅盡定、無\n想定、無想天"}
{"id": null, "n": null, "target": null, "type": null, "text": "即二\n乘無漏定"}
{"id": null, "n": null, "target": null, "type": null, "text": "即外道有漏定"}
{"id": null, "n": null, "target": null, "type": null, "text": "即色界中一天"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "相見二分。"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼二我法，離此二分，無所依故。"}
{"id": null, "n": null, "target": null, "type": null, "text": "有本云：○執為實有，即實有我法也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "重病心惛，見異色人物也"}
{"id": null, "n": null, "target": null, "type": null, "text": "夢想所見可知"}
{"id": null, "n": null, "target": null, "type": null, "text": "廣如前說"}
{"id": null, "n": null, "target": null, "type": null, "text": "自註"}
{"id": null, "n": null, "target": null, "type": null, "text": "約篇即直顯真源，約教即一乘顯性"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注"}
{"id": null, "n": null, "target": null, "type": null, "text": "此下却將彼喻破之"}
{"id": null, "n": null, "target": null, "type": null, "text": "如此等文，徧大乘藏。"}
{"id": null, "n": null, "target": null, "type": null, "text": "有餘者，餘義未了也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "大乘法相\n在生滅門，極於三細；大乘破相在真如門，密顯空義，皆偏淺耳。"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋上文義，多依禪詮，兼取賢首教義章。"}
{"id": null, "n": null, "target": null, "type": null, "text": "喻佛智慧"}
{"id": null, "n": null, "target": null, "type": null, "text": "智體無邊廓周法界"}
{"id": null, "n": null, "target": null, "type": null, "text": "喻體上本有恒沙功德恒沙妙用也"}
{"id": null, "n": null, "target": null, "type": null, "text": "喻佛智全在眾生身中圓滿具足也"}
{"id": null, "n": null, "target": null, "type": null, "text": "舉一眾生為例"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注"}
{"id": null, "n": null, "target": null, "type": null, "text": "會前所斥同歸一源皆為正義"}
{"id": null, "n": null, "target": null, "type": null, "text": "初唯第五性教所說，從後段已去節級，方\n同諸教，各如注記。"}
{"id": null, "n": null, "target": null, "type": null, "text": "即同此文一真靈性"}
{"id": null, "n": null, "target": null, "type": null, "text": "上但攝引論文，或引禪詮序為證。"}
{"id": null, "n": null, "target": null, "type": null, "text": "自此方是第四教，亦同破此已生滅諸相"}
{"id": null, "n": null, "target": null, "type": null, "text": "此下方是第三法相，教中亦同所說"}
{"id": null, "n": null, "target": null, "type": null, "text": "此下\n方是第二，小乘教中亦同所說"}
{"id": null, "n": null, "target": null, "type": null, "text": "此下方是第一人，天教中亦同所說"}
{"id": null, "n": null, "target": null, "type": null, "text": "善惡二業，其善業在次文。"}
{"id": null, "n": null, "target": null, "type": null, "text": "苦樂二報，樂報亦在次文。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此下方是儒道二教，亦同所說"}
{"id": null, "n": null, "target": null, "type": null, "text": "會彼所說，以氣為本"}
{"id": null, "n": null, "target": null, "type": null, "text": "會彼所說自然為本"}
{"id": null, "n": null, "target": null, "type": null, "text": "會彼所說，皆由天命"}
{"id": null, "n": null, "target": null, "type": null, "text": "二氣不接，萬物塞矣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "二氣交感，\n萬物乃通。"}
{"id": null, "n": null, "target": null, "type": null, "text": "如前敘列"}
{"id": null, "n": null, "target": null, "type": null, "text": "即此文云天地國邑"}
{"id": null, "n": null, "target": null, "type": null, "text": "即此文云和合成人"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "戊戌"}
{"id": null, "n": null, "target": null, "type": null, "text": "生五十三"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T45n1884_p0684a06"}
{"id": null, "n": "0723001", "target": "#nkr_note_mod_0723001", "type": "mod", "text": "秊"}
{"id": null, "n": "0718k01", "target": "#nkr_note_orig_0718k01", "type": "orig", "text": "發微錄序文分二初題號二初題目二撰號"}
{"id": null, "n": "0718k02", "target": "#nkr_note_orig_0718k02", "type": "orig", "text": "二本文明今述作興懷作錄"}
{"id": null, "n": "0719k01", "target": "#nkr_note_orig_0719k01", "type": "orig", "text": "大文分三初題目二初總標論題"}
{"id": null, "n": "0719k02", "target": "#nkr_note_orig_0719k02", "type": "orig", "text": "二述人嘉號"}
{"id": null, "n": "0719001", "target": "#nkr_note_orig_0719001", "type": "orig", "text": "此一作北"}
{"id": null, "n": "0719k03", "target": "#nkr_note_orig_0719k03", "type": "orig", "text": "二序"}
{"id": null, "n": "0720k01", "target": "#nkr_note_orig_0720k01", "type": "orig", "text": "二別況人道"}
{"id": null, "n": "0720k02", "target": "#nkr_note_orig_0720k02", "type": "orig", "text": "二辨愚智分迷悟三初述知迷派"}
{"id": null, "n": "0720k03", "target": "#nkr_note_orig_0720k03", "type": "orig", "text": "二務師悟宗"}
{"id": null, "n": "0720k04", "target": "#nkr_note_orig_0720k04", "type": "orig", "text": "三別示所習三初習儒道二初明近"}
{"id": null, "n": "0720k05", "target": "#nkr_note_orig_0720k05", "type": "orig", "text": "二推遠"}
{"id": null, "n": "0720k06", "target": "#nkr_note_orig_0720k06", "type": "orig", "text": "二習偏淺二初明近"}
{"id": null, "n": "0720k07", "target": "#nkr_note_orig_0720k07", "type": "orig", "text": "二推遠"}
{"id": null, "n": "0720k08", "target": "#nkr_note_orig_0720k08", "type": "orig", "text": "三雙斥非"}
{"id": null, "n": "0720k09", "target": "#nkr_note_orig_0720k09", "type": "orig", "text": "三推內外益群品四初三教更濟"}
{"id": null, "n": "0720001", "target": "#nkr_note_orig_0720001", "type": "orig", "text": "吏一作史"}
{"id": null, "n": "0720002", "target": "#nkr_note_orig_0720002", "type": "orig", "text": "朴一作樸"}
{"id": null, "n": "0720k10", "target": "#nkr_note_orig_0720k10", "type": "orig", "text": "二辨折權實"}
