{"id": null, "n": "0002a0401", "target": "#nkr_note_add_0002a0401", "type": "add", "text": "已【CB】，己【國圖】"}
{"id": null, "n": "0002a0501", "target": "#nkr_note_add_0002a0501", "type": "add", "text": "弟【CB】，苐【國圖】"}
{"id": null, "n": "0003a0201", "target": "#nkr_note_add_0003a0201", "type": "add", "text": "已【CB】，己【國圖】"}
{"id": null, "n": "0003a1001", "target": "#nkr_note_add_0003a1001", "type": "add", "text": "二者僧【CB】，【國圖】"}
{"id": null, "n": "0005a1301", "target": "#nkr_note_add_0005a1301", "type": "add", "text": "一名安陀會【CB】，［－］【國圖】"}
{"id": null, "n": "0006a0401", "target": "#nkr_note_add_0006a0401", "type": "add", "text": "佉【CB】，【國圖】"}
{"id": null, "n": "0006a0601", "target": "#nkr_note_add_0006a0601", "type": "add", "text": "［－］【CB】，三非時藥仏言蘇油生蘇蜜石蜜有病因緣應加授法【國圖】"}
{"id": null, "n": null, "target": null, "type": null, "text": "仏言蘇油生蘇蜜石蜜有病因緣應加授法"}
{"id": null, "n": "0006a0701", "target": "#nkr_note_add_0006a0701", "type": "add", "text": "藥【CB】，［－］【國圖】"}
{"id": null, "n": "0006a0702", "target": "#nkr_note_add_0006a0702", "type": "add", "text": "无【CB】，元【國圖】"}
{"id": null, "n": "0007a0801", "target": "#nkr_note_add_0007a0801", "type": "add", "text": "己【CB】，已【國圖】"}
{"id": null, "n": "0007a1101", "target": "#nkr_note_add_0007a1101", "type": "add", "text": "檀【CB】，擅【國圖】"}
{"id": null, "n": "0007a1201", "target": "#nkr_note_add_0007a1201", "type": "add", "text": "俗【CB】，佫【國圖】"}
{"id": null, "n": "0007a1202", "target": "#nkr_note_add_0007a1202", "type": "add", "text": "己【CB】，已【國圖】"}
{"id": null, "n": "0008a0501", "target": "#nkr_note_add_0008a0501", "type": "add", "text": "明【CB】，朋【國圖】"}
{"id": null, "n": "0008a0801", "target": "#nkr_note_add_0008a0801", "type": "add", "text": "已【CB】，巳【國圖】"}
{"id": null, "n": "0009a1201", "target": "#nkr_note_add_0009a1201", "type": "add", "text": "檀【CB】，擅【國圖】"}
{"id": null, "n": "0010a0101", "target": "#nkr_note_add_0010a0101", "type": "add", "text": "己【CB】，巳【國圖】"}
{"id": null, "n": "0010a0901", "target": "#nkr_note_add_0010a0901", "type": "add", "text": "儀【CB】，【國圖】"}
{"id": null, "n": "0010a1001", "target": "#nkr_note_add_0010a1001", "type": "add", "text": "別【CB】，〃【國圖】"}
{"id": null, "n": "0011a1401", "target": "#nkr_note_add_0011a1401", "type": "add", "text": "汗【CB】，汙【國圖】"}
