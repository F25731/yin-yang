{"id": null, "n": null, "target": null, "type": null, "text": "敘謝不錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "師著語云：因行掉臂"}
{"id": null, "n": null, "target": null, "type": null, "text": "平地起骨堆"}
{"id": null, "n": null, "target": null, "type": null, "text": "綿包特石"}
{"id": null, "n": null, "target": null, "type": null, "text": "伸手元在縮手裏"}
{"id": null, "n": null, "target": null, "type": null, "text": "三十棒自領出去"}
{"id": null, "n": null, "target": null, "type": null, "text": "楚國亡猿，禍及林木"}
{"id": null, "n": null, "target": null, "type": null, "text": "前箭猶輕後箭深"}
{"id": null, "n": null, "target": null, "type": null, "text": "一語傷人六月寒"}
{"id": null, "n": null, "target": null, "type": null, "text": "賺殺"}
{"id": null, "n": null, "target": null, "type": null, "text": "不因紫陌花開早，怎見黃鸝下柳條"}
{"id": null, "n": null, "target": null, "type": null, "text": "賣弄不少"}
{"id": null, "n": null, "target": null, "type": null, "text": "纔收安南，又憂塞北"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "在"}
{"id": null, "n": null, "target": null, "type": null, "text": "碑載唐玄\n宗曾幸此"}
{"id": null, "n": null, "target": null, "type": null, "text": "在"}
{"id": null, "n": null, "target": null, "type": null, "text": "在"}
{"id": null, "n": null, "target": null, "type": null, "text": "因古春與報恩諍論師有息諍說"}
