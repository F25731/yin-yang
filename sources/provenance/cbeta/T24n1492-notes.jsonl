{"id": null, "n": "1091007", "target": "#nkr_note_mod_1091007", "type": "mod", "text": "某【大】，其【元】"}
{"id": null, "n": "1091008", "target": "#nkr_note_mod_1091008", "type": "mod", "text": "少【大】，少分【宋】【元】【明】【宮】"}
