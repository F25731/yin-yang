{"id": null, "n": "1090005", "target": "#nkr_note_mod_1090005", "type": "mod", "text": "禮【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1090006", "target": "#nkr_note_mod_1090006", "type": "mod", "text": "以【大】＊，已【宋】【元】【明】【宮】＊"}
