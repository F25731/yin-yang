{"id": null, "n": null, "target": null, "type": null, "text": "古猛切"}
{"id": null, "n": null, "target": null, "type": null, "text": "先彫切"}
{"id": null, "n": null, "target": null, "type": null, "text": "音榮火䖝腐草所化一名夜光一名宵燭"}
{"id": null, "n": null, "target": null, "type": null, "text": "都艱切同盡也竭也"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒲糜切土藏也"}
{"id": null, "n": null, "target": null, "type": null, "text": "苦弔切穴也"}
{"id": null, "n": null, "target": null, "type": null, "text": "職日切"}
{"id": null, "n": null, "target": null, "type": null, "text": "初委切度也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上音盈下音孛"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒲沒切塺也"}
{"id": null, "n": null, "target": null, "type": null, "text": "乙減切深󵚾色"}
{"id": null, "n": null, "target": null, "type": null, "text": "許里切"}
{"id": null, "n": null, "target": null, "type": null, "text": "虛宜切念也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上音瞻下步黑切"}
{"id": null, "n": null, "target": null, "type": null, "text": "與瞬同目搖也"}
{"id": null, "n": null, "target": null, "type": null, "text": "息恣\n切盡也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上莫候切同矛下乳允切同盾"}
{"id": null, "n": null, "target": null, "type": null, "text": "於計切隂而風也"}
{"id": null, "n": null, "target": null, "type": null, "text": "村歷對也"}
{"id": null, "n": null, "target": null, "type": null, "text": "布󴈐切陂陀不平也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音咸\n鹽味"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃計切肥膩也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音釋婦人謂嫁曰𡣪"}
{"id": null, "n": null, "target": null, "type": null, "text": "同鎻"}
{"id": null, "n": null, "target": null, "type": null, "text": "音銀齗辨諍貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "上音蒙無知貌下音遯頑也"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡瓜切"}
{"id": null, "n": null, "target": null, "type": null, "text": "渠京切"}
{"id": null, "n": null, "target": null, "type": null, "text": "章移切"}
{"id": null, "n": null, "target": null, "type": null, "text": "音初"}
{"id": null, "n": null, "target": null, "type": null, "text": "古猛切"}
{"id": null, "n": null, "target": null, "type": null, "text": "古緩切以盆水洗手\n曰盥"}
{"id": null, "n": null, "target": null, "type": null, "text": "作管切鋌也"}
{"id": null, "n": null, "target": null, "type": null, "text": "同瞚"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒲沒切煙起貌又尉㶿𤇏𤍠"}
{"id": null, "n": null, "target": null, "type": null, "text": "音使疾也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音弗小風也一曰疾風"}
{"id": null, "n": null, "target": null, "type": null, "text": "上音巴下音焦"}
{"id": null, "n": null, "target": null, "type": null, "text": "郎刀切堅也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音池疾驅也"}
{"id": null, "n": null, "target": null, "type": null, "text": "郎佐切"}
{"id": null, "n": null, "target": null, "type": null, "text": "無販切蔓延也"}
{"id": null, "n": null, "target": null, "type": null, "text": "徂兖切欶也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上息委切骨中脂下奴老切頂髓"}
{"id": null, "n": null, "target": null, "type": null, "text": "音宙"}
{"id": null, "n": null, "target": null, "type": null, "text": "焚上聲塵塕也"}
{"id": null, "n": null, "target": null, "type": null, "text": "徒回切下墜也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音忽風有所吹起也"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡夾切隘陜不廣也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音胃\n利也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上音融下音任"}
{"id": null, "n": null, "target": null, "type": null, "text": "弋灼切鎖鑰"}
{"id": null, "n": null, "target": null, "type": null, "text": "可海切甲也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上都槁切舂也下山皆切竹器"}
{"id": null, "n": null, "target": null, "type": null, "text": "上音悲下音詣埤堄城上女牆也"}
{"id": null, "n": null, "target": null, "type": null, "text": "梵書伊字"}
{"id": null, "n": null, "target": null, "type": null, "text": "鋪坯切音丕未\n燒陶瓦"}
{"id": null, "n": null, "target": null, "type": null, "text": "丘縛切匡入聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "竹角切音𤥨"}
{"id": null, "n": null, "target": null, "type": null, "text": "夷益切音弋"}
{"id": null, "n": null, "target": null, "type": null, "text": "初銜切插入聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "恥格切音䇿"}
{"id": null, "n": null, "target": null, "type": null, "text": "盧含切音藍"}
{"id": null, "n": null, "target": null, "type": null, "text": "而至切音二截\n耳也"}
{"id": null, "n": null, "target": null, "type": null, "text": "以智切音異截鼻也"}
{"id": null, "n": null, "target": null, "type": null, "text": "楚懈切差去聲病瘳也"}
{"id": null, "n": null, "target": null, "type": null, "text": "居大切音蓋取也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上陳知切音篪\n下五郢切稱上聲馳騁走也"}
{"id": null, "n": null, "target": null, "type": null, "text": "居候切音遘取牛乳也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上抽知切音癡下居肴切音交黐膠所以\n黏鳥也"}
{"id": null, "n": null, "target": null, "type": null, "text": "居效切音教酒酵也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上龍都切音盧下步黑切音匐蘆菔藥名"}
{"id": null, "n": null, "target": null, "type": null, "text": "凌如切音閭毛布也"}
{"id": null, "n": null, "target": null, "type": null, "text": "責辛切音臻樹高丈許子如小栗"}
{"id": null, "n": null, "target": null, "type": null, "text": "方鹽切音廉鍥也"}
{"id": null, "n": null, "target": null, "type": null, "text": "古犬切涓上聲罟也"}
{"id": null, "n": null, "target": null, "type": null, "text": "陳知切音池"}
{"id": null, "n": null, "target": null, "type": null, "text": "休居切音虛"}
{"id": null, "n": null, "target": null, "type": null, "text": "之膳切音\n戰四支寒掉也"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T14n0475_p0549b09"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "X57n0970_p0420b23"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T16n0670_p0501c23"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T12n0374_p0449b24"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T44n1851_p0582c26"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X20n0361_p0525a19"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "X44n0744_p0581c14"}
{"id": null, "n": null, "target": null, "type": "cf3", "text": "福峰版龍藏、世樺版龍藏均作「膳」。"}
