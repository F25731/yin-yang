{"id": null, "n": "0868013", "target": "#nkr_note_orig_0868013", "type": "orig", "text": "恩＝因【宋】【宮】"}
{"id": null, "n": "0868014", "target": "#nkr_note_orig_0868014", "type": "orig", "text": "耶＝也【三】【宮】＊"}
{"id": null, "n": "0869001", "target": "#nkr_note_orig_0869001", "type": "orig", "text": "連＝速【宋】【宮】"}
{"id": null, "n": "0869002", "target": "#nkr_note_orig_0869002", "type": "orig", "text": "投＝教【宋】【宮】，救【元】【明】"}
{"id": null, "n": "0869003", "target": "#nkr_note_orig_0869003", "type": "orig", "text": "升＝斗【三】【宮】＊"}
{"id": null, "n": "0869004", "target": "#nkr_note_orig_0869004", "type": "orig", "text": "〔不〕－【三】【宮】"}
{"id": null, "n": "0869005", "target": "#nkr_note_orig_0869005", "type": "orig", "text": "〔法〕－【三】【宮】"}
{"id": null, "n": "0869006", "target": "#nkr_note_orig_0869006", "type": "orig", "text": "〔力〕－【三】【宮】"}
{"id": null, "n": "0869007", "target": "#nkr_note_orig_0869007", "type": "orig", "text": "以＝如【三】【宮】"}
{"id": null, "n": "0869008", "target": "#nkr_note_orig_0869008", "type": "orig", "text": "大＝天【元】【明】"}
{"id": null, "n": "0869009", "target": "#nkr_note_orig_0869009", "type": "orig", "text": "而＝如【三】【宮】"}
{"id": null, "n": "0869010", "target": "#nkr_note_orig_0869010", "type": "orig", "text": "之其以所＝其所以【三】【宮】"}
{"id": null, "n": "0869011", "target": "#nkr_note_orig_0869011", "type": "orig", "text": "佛＝為眾僧【三】【宮】"}
{"id": null, "n": "0869012", "target": "#nkr_note_orig_0869012", "type": "orig", "text": "間＝聞【三】【宮】"}
{"id": null, "n": "0869013", "target": "#nkr_note_orig_0869013", "type": "orig", "text": "罔＝誷【元】【明】"}
{"id": null, "n": "0869014", "target": "#nkr_note_orig_0869014", "type": "orig", "text": "以強＝強良【宋】，強梁【元】【明】【宮】"}
