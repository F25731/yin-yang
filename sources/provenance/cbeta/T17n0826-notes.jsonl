{"id": null, "n": "0869017", "target": "#nkr_note_orig_0869017", "type": "orig", "text": "騾驢＝驢騾【三】【宮】"}
{"id": null, "n": "0869018", "target": "#nkr_note_orig_0869018", "type": "orig", "text": "痾＝瘂【三】【宮】"}
{"id": null, "n": "0869019", "target": "#nkr_note_orig_0869019", "type": "orig", "text": "維＝惟【三】【宮】"}
{"id": null, "n": "0870001", "target": "#nkr_note_orig_0870001", "type": "orig", "text": "惡＝要【元】【明】"}
