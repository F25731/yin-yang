{"id": null, "n": "0868006", "target": "#nkr_note_orig_0868006", "type": "orig", "text": "斂＝殮【三】【宮】＊"}
{"id": null, "n": "0868007", "target": "#nkr_note_orig_0868007", "type": "orig", "text": "眠眠＝昏昏【宋】【宮】，瞑瞑【元】【明】"}
{"id": null, "n": "0868008", "target": "#nkr_note_orig_0868008", "type": "orig", "text": "已＝以【宋】【元】【宮】"}
{"id": null, "n": "0868009", "target": "#nkr_note_orig_0868009", "type": "orig", "text": "十＝九【三】【宮】"}
{"id": null, "n": "0868010", "target": "#nkr_note_orig_0868010", "type": "orig", "text": "往＝徑【明】，俓【宮】"}
