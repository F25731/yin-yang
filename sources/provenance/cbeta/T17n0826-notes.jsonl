{"id": null, "n": null, "target": null, "type": "cf1", "text": "K20n0842_p1183c22"}
{"id": null, "n": "0868004", "target": "#nkr_note_mod_0868004", "type": "mod", "text": "弟子【大】＊，佛說弟子【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0868005", "target": "#nkr_note_mod_0868005", "type": "mod", "text": "笮【大】，作【宋】【元】【明】【宮】"}
{"id": null, "n": "0868006", "target": "#nkr_note_mod_0868006", "type": "mod", "text": "斂【大】＊，殮【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0868007", "target": "#nkr_note_mod_0868007", "type": "mod", "text": "眠眠【大】，昏昏【宋】【宮】，瞑瞑【元】【明】"}
{"id": null, "n": "0868008", "target": "#nkr_note_mod_0868008", "type": "mod", "text": "已【大】，以【宋】【元】【宮】"}
{"id": null, "n": "0868009", "target": "#nkr_note_mod_0868009", "type": "mod", "text": "十【大】，九【宋】【元】【明】【宮】"}
{"id": null, "n": "0868010", "target": "#nkr_note_mod_0868010", "type": "mod", "text": "往【大】，徑【明】，俓【宮】"}
{"id": null, "n": "0868011", "target": "#nkr_note_mod_0868011", "type": "mod", "text": "裏【大】，𢌅【宋】【元】【明】【宮】"}
{"id": null, "n": "0868012", "target": "#nkr_note_mod_0868012", "type": "mod", "text": "尺【大】，赤【宮】"}
{"id": null, "n": "0868013", "target": "#nkr_note_mod_0868013", "type": "mod", "text": "恩【大】，因【宋】【宮】"}
{"id": null, "n": "0868014", "target": "#nkr_note_mod_0868014", "type": "mod", "text": "耶【大】＊，也【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0869001", "target": "#nkr_note_mod_0869001", "type": "mod", "text": "連【大】，速【宋】【宮】"}
{"id": null, "n": "0869002", "target": "#nkr_note_mod_0869002", "type": "mod", "text": "投【大】，教【宋】【宮】，救【元】【明】"}
{"id": null, "n": "0869003", "target": "#nkr_note_mod_0869003", "type": "mod", "text": "升【大】＊，斗【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0869004", "target": "#nkr_note_mod_0869004", "type": "mod", "text": "不【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0869005", "target": "#nkr_note_mod_0869005", "type": "mod", "text": "法【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0869006", "target": "#nkr_note_mod_0869006", "type": "mod", "text": "力【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0869007", "target": "#nkr_note_mod_0869007", "type": "mod", "text": "以【大】，如【宋】【元】【明】【宮】"}
{"id": null, "n": "0869008", "target": "#nkr_note_mod_0869008", "type": "mod", "text": "大【大】，天【元】【明】"}
{"id": null, "n": "0869009", "target": "#nkr_note_mod_0869009", "type": "mod", "text": "而【大】，如【宋】【元】【明】【宮】"}
{"id": null, "n": "0869010", "target": "#nkr_note_mod_0869010", "type": "mod", "text": "之其以所【大】，其所以【宋】【元】【明】【宮】"}
{"id": null, "n": "0869011", "target": "#nkr_note_mod_0869011", "type": "mod", "text": "佛【大】，為眾僧【宋】【元】【明】【宮】"}
{"id": null, "n": "0869012", "target": "#nkr_note_mod_0869012", "type": "mod", "text": "間【大】，聞【宋】【元】【明】【宮】"}
{"id": null, "n": "0869013", "target": "#nkr_note_mod_0869013", "type": "mod", "text": "罔【大】，誷【元】【明】"}
{"id": null, "n": "0869014", "target": "#nkr_note_mod_0869014", "type": "mod", "text": "以強【大】，強良【宋】，強梁【元】【明】【宮】"}
{"id": null, "n": "0869015", "target": "#nkr_note_mod_0869015", "type": "mod", "text": "司【大】，伺【宋】【元】【明】"}
{"id": null, "n": "0869016", "target": "#nkr_note_mod_0869016", "type": "mod", "text": "微【大】，微微【元】【明】【宮】"}
{"id": null, "n": "0869017", "target": "#nkr_note_mod_0869017", "type": "mod", "text": "騾驢【大】，驢騾【宋】【元】【明】【宮】"}
{"id": null, "n": "0869018", "target": "#nkr_note_mod_0869018", "type": "mod", "text": "痾【大】，瘂【宋】【元】【明】【宮】"}
{"id": null, "n": "0869019", "target": "#nkr_note_mod_0869019", "type": "mod", "text": "維【大】，惟【宋】【元】【明】【宮】"}
{"id": null, "n": "0870001", "target": "#nkr_note_mod_0870001", "type": "mod", "text": "惡【大】，要【元】【明】"}
{"id": null, "n": "0870002", "target": "#nkr_note_mod_0870002", "type": "mod", "text": "天【大】＊，天人【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0870003", "target": "#nkr_note_mod_0870003", "type": "mod", "text": "所【大】，形【宋】【元】【明】【宮】"}
{"id": null, "n": "0870004", "target": "#nkr_note_mod_0870004", "type": "mod", "text": "世【大】，出【明】"}
{"id": null, "n": "0870005", "target": "#nkr_note_mod_0870005", "type": "mod", "text": "已【大】，以【宋】【元】【明】"}
{"id": null, "n": "0870006", "target": "#nkr_note_mod_0870006", "type": "mod", "text": "勤加【大】，加勤【宋】【元】【明】【宮】"}
{"id": null, "n": "0868004", "target": "#nkr_note_orig_0868004", "type": "orig", "text": "（佛說）＋弟子【三】【宮】＊"}
