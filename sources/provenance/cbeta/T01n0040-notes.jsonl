{"id": null, "n": "0824002", "target": "#nkr_note_mod_0824002", "type": "mod", "text": "藏【大】，藏法師【宋】【元】【明】"}
{"id": null, "n": "0824003", "target": "#nkr_note_mod_0824003", "type": "mod", "text": "使【大】，便【宋】【元】【明】"}
{"id": null, "n": "0824004", "target": "#nkr_note_mod_0824004", "type": "mod", "text": "令【大】，今【宋】【元】【明】"}
{"id": null, "n": "0824005", "target": "#nkr_note_mod_0824005", "type": "mod", "text": "見是【大】，是見【明】"}
{"id": null, "n": "0824006", "target": "#nkr_note_mod_0824006", "type": "mod", "text": "取【大】，聚【元】【明】"}
{"id": null, "n": "0825001", "target": "#nkr_note_mod_0825001", "type": "mod", "text": "賚【大】，徠【明】"}
{"id": null, "n": "0825002", "target": "#nkr_note_mod_0825002", "type": "mod", "text": "尚【大】，座【宋】【元】【明】"}
{"id": null, "n": "0825003", "target": "#nkr_note_mod_0825003", "type": "mod", "text": "阿【大】，陀【元】"}
