{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "此觀世音菩薩本身"}
{"id": null, "n": null, "target": null, "type": null, "text": "此如\n意輪菩薩本身"}
{"id": null, "n": null, "target": null, "type": null, "text": "此持鉢觀世音菩薩本身"}
{"id": null, "n": null, "target": null, "type": null, "text": "此不空羂索菩薩押大兵"}
{"id": null, "n": null, "target": null, "type": null, "text": "此菩薩種子。誦呪本身"}
{"id": null, "n": null, "target": null, "type": null, "text": "此馬鳴菩薩本身。手把鈸折羅"}
{"id": null, "n": null, "target": null, "type": null, "text": "此諸鬼神合掌聽誦呪"}
{"id": null, "n": null, "target": null, "type": null, "text": "此四大天王本身降魔"}
{"id": null, "n": null, "target": null, "type": null, "text": "此四大天王部落鬼神名字"}
{"id": null, "n": null, "target": null, "type": null, "text": "此龍樹菩薩本身"}
{"id": null, "n": null, "target": null, "type": null, "text": "此圓滿報身盧舍那佛"}
{"id": null, "n": null, "target": null, "type": null, "text": "此清淨法身毗盧遮那佛本身"}
{"id": null, "n": null, "target": null, "type": null, "text": "此羊頭神王。共諸天魔為眷屬"}
{"id": null, "n": null, "target": null, "type": null, "text": "此甘露菩薩。觀音眷屬"}
{"id": null, "n": null, "target": null, "type": null, "text": "此飛騰夜叉天王。巡歷四方。察其是非"}
{"id": null, "n": null, "target": null, "type": null, "text": "此婆加帝神王。其形黑大。以豹皮為裩。手把鐵义"}
{"id": null, "n": null, "target": null, "type": null, "text": "此軍吒利菩薩本身。把鐵輪。并把索。面有三眼"}
{"id": null, "n": null, "target": null, "type": null, "text": "此劒語"}
{"id": null, "n": null, "target": null, "type": null, "text": "此大梵天王本身。神仙為部落"}
{"id": null, "n": null, "target": null, "type": null, "text": "此帝神。長大黑色"}
{"id": null, "n": null, "target": null, "type": null, "text": "此三十三天。摩醯首羅天神領天兵。青色"}
{"id": null, "n": null, "target": null, "type": null, "text": "此實心。更無雜\n\n亂心。即名薩埵"}
{"id": null, "n": null, "target": null, "type": null, "text": "此香積菩薩。押五方鬼兵為侍從"}
{"id": null, "n": null, "target": null, "type": null, "text": "此菩薩相\n罰語。即為齊也"}
{"id": null, "n": null, "target": null, "type": null, "text": "同前"}
{"id": null, "n": null, "target": null, "type": null, "text": "此空身菩薩。押\n天大將軍。領二十萬億天兵"}
{"id": null, "n": null, "target": null, "type": null, "text": "此嚴峻菩薩。押孔雀王蠻兵"}
{"id": null, "n": null, "target": null, "type": null, "text": "同前"}
{"id": null, "n": null, "target": null, "type": null, "text": "此觀音菩薩大丈夫身"}
{"id": null, "n": null, "target": null, "type": null, "text": "此師\n子王兵驗讀誦"}
{"id": null, "n": null, "target": null, "type": null, "text": "此霹靂菩薩。降伏諸魔眷屬"}
{"id": null, "n": null, "target": null, "type": null, "text": "此摧碎菩薩本\n身。手把金輪"}
{"id": null, "n": null, "target": null, "type": null, "text": "某甲受持"}
{"id": null, "n": null, "target": null, "type": null, "text": "此大降魔金剛本身。把金輪"}
{"id": null, "n": null, "target": null, "type": null, "text": "此諸\n佛合掌聽誦真言"}
{"id": null, "n": null, "target": null, "type": null, "text": "此魔醯首羅天王"}
{"id": null, "n": null, "target": null, "type": null, "text": "同前"}
{"id": null, "n": null, "target": null, "type": null, "text": "此觀音菩薩。把牌弩弓箭"}
{"id": null, "n": null, "target": null, "type": null, "text": "同前"}
{"id": null, "n": null, "target": null, "type": null, "text": "此阿彌陀\n佛本身。觀世音菩薩師主"}
{"id": null, "n": null, "target": null, "type": null, "text": "此八部鬼神王"}
{"id": null, "n": null, "target": null, "type": null, "text": "同前"}
{"id": null, "n": null, "target": null, "type": null, "text": "此五濁惡世"}
{"id": null, "n": null, "target": null, "type": null, "text": "此觀音菩薩利益一切眾生"}
{"id": null, "n": null, "target": null, "type": null, "text": "此諸佛樹葉落聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "此觀音菩薩結緣眾生"}
{"id": null, "n": null, "target": null, "type": null, "text": "此阿難本身"}
{"id": null, "n": null, "target": null, "type": null, "text": "此大車菩薩。手把金刀"}
{"id": null, "n": null, "target": null, "type": null, "text": "此龍\n樹菩薩。手把金刀"}
{"id": null, "n": null, "target": null, "type": null, "text": "此寶幢菩薩。手持鐵叉"}
{"id": null, "n": null, "target": null, "type": null, "text": "此寶金光\n幢菩薩鈸折羅杵"}
{"id": null, "n": null, "target": null, "type": null, "text": "去聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "此達一切法門"}
{"id": null, "n": null, "target": null, "type": null, "text": "此放光菩薩。手把赤幡"}
{"id": null, "n": null, "target": null, "type": null, "text": "此諸天菩薩盡悉以集。手把金\n刀"}
{"id": null, "n": null, "target": null, "type": null, "text": "此安息香"}
{"id": null, "n": null, "target": null, "type": null, "text": "此山海惠菩薩本身。手把金劒"}
{"id": null, "n": null, "target": null, "type": null, "text": "此寶即王菩薩。手把金斧"}
{"id": null, "n": null, "target": null, "type": null, "text": "此藥王菩薩本身。行療諸病"}
{"id": null, "n": null, "target": null, "type": null, "text": "此藥\n上菩薩本身。行療諸病"}
{"id": null, "n": null, "target": null, "type": null, "text": "此八字念三遍"}
{"id": null, "n": null, "target": null, "type": null, "text": "喝音阿。囉音拉。怛音搭。哆音多。羯音揭。鑠音少。埵音朵。迦音吉。咄音拙"}
{"id": null, "n": null, "target": null, "type": null, "text": "某"}
{"id": null, "n": null, "target": null, "type": null, "text": "居士改身\n苦塵緣。心多散亂"}
{"id": null, "n": null, "target": null, "type": null, "text": "居士改徒得人身"}
{"id": null, "n": null, "target": null, "type": null, "text": "某"}
{"id": null, "n": null, "target": null, "type": null, "text": "三稱三拜"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "B17n0089_p0200a11"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "B17n0089_p0200a11"}
{"id": null, "n": "0091001", "target": "#nkr_note_orig_0091001", "type": "orig", "text": "最疑勗"}
{"id": null, "n": "0091002", "target": "#nkr_note_orig_0091002", "type": "orig", "text": "大悲陀羅尼前明續藏本載普門品"}
{"id": null, "n": "0096001", "target": "#nkr_note_orig_0096001", "type": "orig", "text": "宣祥疑冥祥或宣驗歟"}
{"id": null, "n": "0097001", "target": "#nkr_note_orig_0097001", "type": "orig", "text": "還疑遷"}
