{"id": null, "n": "0442001", "target": "#nkr_note_mod_0442001", "type": "mod", "text": "Sāma-jātaka(540)，明本，以元本對校"}
{"id": null, "n": "0442002", "target": "#nkr_note_mod_0442002", "type": "mod", "text": "孝順【大】，相養【元】"}
{"id": null, "n": "0442003", "target": "#nkr_note_mod_0442003", "type": "mod", "text": "常【大】，不常【元】"}
{"id": null, "n": "0442004", "target": "#nkr_note_mod_0442004", "type": "mod", "text": "天【大】，夭【元】"}
{"id": null, "n": "0442005", "target": "#nkr_note_mod_0442005", "type": "mod", "text": "至【大】，睒【元】"}
{"id": null, "n": "0442006", "target": "#nkr_note_mod_0442006", "type": "mod", "text": "言子之【大】，子言【元】"}
{"id": null, "n": "0442007", "target": "#nkr_note_mod_0442007", "type": "mod", "text": "蒲【大】，柴【元】"}
{"id": null, "n": "0442008", "target": "#nkr_note_mod_0442008", "type": "mod", "text": "無毛【大】，〔－〕【元】"}
{"id": null, "n": "0442009", "target": "#nkr_note_mod_0442009", "type": "mod", "text": "羆【大】，態【元】"}
{"id": null, "n": "0442010", "target": "#nkr_note_mod_0442010", "type": "mod", "text": "號【大】，嘷【元】"}
{"id": null, "n": "0443001", "target": "#nkr_note_mod_0443001", "type": "mod", "text": "住【大】，行【元】"}
{"id": null, "n": "0443002", "target": "#nkr_note_mod_0443002", "type": "mod", "text": "駛【大】，使【元】"}
{"id": null, "n": "0443003", "target": "#nkr_note_mod_0443003", "type": "mod", "text": "便【大】，使【元】"}
{"id": null, "n": "0443004", "target": "#nkr_note_mod_0443004", "type": "mod", "text": "著【大】，著與【元】"}
{"id": null, "n": "0443005", "target": "#nkr_note_mod_0443005", "type": "mod", "text": "已【大】，以【元】"}
{"id": null, "n": "0443006", "target": "#nkr_note_mod_0443006", "type": "mod", "text": "更【大】，已【元】"}
