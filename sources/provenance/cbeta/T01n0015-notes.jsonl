{"id": null, "n": "0246014", "target": "#nkr_note_mod_0246014", "type": "mod", "text": "西天譯經三藏朝奉大夫試光祿卿明教大師臣法賢奉詔譯【大】，三藏法師法賢奉詔譯【宋】【元】，宋三藏法師法賢奉詔譯【明】"}
{"id": null, "n": "0246015", "target": "#nkr_note_mod_0246015", "type": "mod", "text": "詣【大】，諸【元】"}
{"id": null, "n": "0247001", "target": "#nkr_note_mod_0247001", "type": "mod", "text": "子【大】，子而乃【宋】【元】【明】"}
{"id": null, "n": "0248001", "target": "#nkr_note_mod_0248001", "type": "mod", "text": "間【CB】【宋】【元】【明】，聞【大】"}
{"id": null, "n": "0248002", "target": "#nkr_note_mod_0248002", "type": "mod", "text": "請【大】，謂【元】"}
{"id": null, "n": "0249001", "target": "#nkr_note_mod_0249001", "type": "mod", "text": "主【大】，王【元】"}
{"id": null, "n": "0246014", "target": "#nkr_note_orig_0246014", "type": "orig", "text": "譯號（西…譯）＝三藏法師法賢奉詔譯【三】，但（宋）＋三藏【明】"}
{"id": null, "n": "0246015", "target": "#nkr_note_orig_0246015", "type": "orig", "text": "詣＝諸【元】"}
{"id": null, "n": "0247001", "target": "#nkr_note_orig_0247001", "type": "orig", "text": "子＋（而乃）【三】"}
{"id": null, "n": "0248001", "target": "#nkr_note_orig_0248001", "type": "orig", "text": "聞＝間【三】"}
{"id": null, "n": "0248002", "target": "#nkr_note_orig_0248002", "type": "orig", "text": "請＝謂【元】"}
{"id": null, "n": "0249001", "target": "#nkr_note_orig_0249001", "type": "orig", "text": "主＝王【元】"}
{"id": null, "n": "0246c0701", "target": "#nkr_note_add_0246c0701", "type": "add", "text": "汝【CB】【麗-CB】，如【大】"}
{"id": null, "n": "0246c0801", "target": "#nkr_note_add_0246c0801", "type": "add", "text": "汝【CB】【麗-CB】，如【大】"}
{"id": null, "n": "0247a0801", "target": "#nkr_note_add_0247a0801", "type": "add", "text": "闥婆【CB】【麗-CB】，婆闥【大】"}
{"id": null, "n": "0248b1401", "target": "#nkr_note_add_0248b1401", "type": "add", "text": "憎【CB】【麗-CB】，僧【大】"}
{"id": null, "n": "0248c2201", "target": "#nkr_note_add_0248c2201", "type": "add", "text": "齅【CB】，󰩩【大】"}
{"id": null, "n": "0249c2801", "target": "#nkr_note_add_0249c2801", "type": "add", "text": "愛【CB】【麗-CB】，受【大】"}
