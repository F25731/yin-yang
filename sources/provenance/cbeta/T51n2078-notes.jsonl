{"id": null, "n": "0715001", "target": "#nkr_note_mod_0715001", "type": "mod", "text": "傳法正宗記【大】，〔－〕【宮】，【原】增上寺報恩藏明本，【宮】宮內省圖書寮藏宋本"}
{"id": null, "n": "0715002", "target": "#nkr_note_mod_0715002", "type": "mod", "text": "為【大】，先為【宮】"}
{"id": null, "n": "0715003", "target": "#nkr_note_mod_0715003", "type": "mod", "text": "顱【大】，臚【宮】"}
{"id": null, "n": "0715004", "target": "#nkr_note_mod_0715004", "type": "mod", "text": "偕【大】，〔－〕【宮】"}
{"id": null, "n": "0715005", "target": "#nkr_note_mod_0715005", "type": "mod", "text": "皆【大】，偕【宮】"}
{"id": null, "n": "0715006", "target": "#nkr_note_mod_0715006", "type": "mod", "text": "瀆【大】，黷【宮】"}
{"id": null, "n": "0716001", "target": "#nkr_note_mod_0716001", "type": "mod", "text": "慧【大】，惠【宮】"}
{"id": null, "n": "0716002", "target": "#nkr_note_mod_0716002", "type": "mod", "text": "（正言比率同志刊正宗記輔教編佛燈禪師欣然作跋預示副本工未意而師歸寂今書其後成師志隆興甲申六月中澣太平禪寺住持嗣祖比丘正言謹題）六十二字＋教【宮】"}
{"id": null, "n": "0716003", "target": "#nkr_note_mod_0716003", "type": "mod", "text": "正【大】，正西禪長慶禪寺住持嗣祖比丘惠舜勤緣開元禪寺住持嗣祖解空大師慧明都勸緣【宮】"}
{"id": null, "n": "0716004", "target": "#nkr_note_mod_0716004", "type": "mod", "text": "湜籍【大】，籍湜【宮】"}
{"id": null, "n": "0716005", "target": "#nkr_note_mod_0716005", "type": "mod", "text": "傳法正宗記卷第一【大】，〔－〕【宮】"}
{"id": null, "n": "0716006", "target": "#nkr_note_mod_0716006", "type": "mod", "text": "宋【大】＊，〔－〕【宮】＊"}
{"id": null, "n": "0716007", "target": "#nkr_note_mod_0716007", "type": "mod", "text": "師摩【大】，摩師【宮】"}
{"id": null, "n": "0716008", "target": "#nkr_note_mod_0716008", "type": "mod", "text": "令【大】，今【宮】"}
{"id": null, "n": "0716009", "target": "#nkr_note_mod_0716009", "type": "mod", "text": "潔【大】，絜【宮】"}
{"id": null, "n": "0716010", "target": "#nkr_note_mod_0716010", "type": "mod", "text": "樹【大】＊，木【宮】＊，樹本字避御名下倣之【宮】"}
{"id": null, "n": null, "target": null, "type": null, "text": "本字避御名下倣之"}
{"id": null, "n": "0717001", "target": "#nkr_note_mod_0717001", "type": "mod", "text": "阻【大】，沮【宮】"}
{"id": null, "n": "0717002", "target": "#nkr_note_mod_0717002", "type": "mod", "text": "旃【大】，檀【宮】"}
{"id": null, "n": "0717003", "target": "#nkr_note_mod_0717003", "type": "mod", "text": "讓【大】，遜正字避國諱他倣之【宮】"}
{"id": null, "n": null, "target": null, "type": null, "text": "正字避國諱他倣之"}
