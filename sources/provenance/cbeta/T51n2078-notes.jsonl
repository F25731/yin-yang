{"id": null, "n": "0724001", "target": "#nkr_note_mod_0724001", "type": "mod", "text": "涌【大】，渭【宮】"}
{"id": null, "n": "0724002", "target": "#nkr_note_mod_0724002", "type": "mod", "text": "許【大】，受【宮】"}
