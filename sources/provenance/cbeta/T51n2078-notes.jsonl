{"id": null, "n": null, "target": null, "type": null, "text": "避字"}
{"id": null, "n": "0724004", "target": "#nkr_note_mod_0724004", "type": "mod", "text": "從何【大】，何所【宮】"}
{"id": null, "n": "0724005", "target": "#nkr_note_mod_0724005", "type": "mod", "text": "因【大】，再【宮】"}
