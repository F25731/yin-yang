{"id": null, "n": "0346010", "target": "#nkr_note_orig_0346010", "type": "orig", "text": "〔阿彌陀〕－【敦】"}
{"id": null, "n": "0346011", "target": "#nkr_note_orig_0346011", "type": "orig", "text": "時＝後【敦】"}
{"id": null, "n": "0346012", "target": "#nkr_note_orig_0346012", "type": "orig", "text": "往＝生【宋】"}
{"id": null, "n": "0346013", "target": "#nkr_note_orig_0346013", "type": "orig", "text": "開＝聞【元】"}
{"id": null, "n": "0346014", "target": "#nkr_note_orig_0346014", "type": "orig", "text": "〔當花敷〕－【宋】，〔當花敷時〕－【元】【明】【敦】，流布本亦同"}
{"id": null, "n": "0346015", "target": "#nkr_note_orig_0346015", "type": "orig", "text": "即為其人廣說＝為其廣說諸法【元】【明】【敦】，流布本亦同"}
{"id": null, "n": "0346016", "target": "#nkr_note_orig_0346016", "type": "orig", "text": "〔爾時世尊〕－【三】【敦】，流布本亦同"}
{"id": null, "n": "0346017", "target": "#nkr_note_orig_0346017", "type": "orig", "text": "豁＝廓【敦】，流布本亦同"}
{"id": null, "n": "0346018", "target": "#nkr_note_orig_0346018", "type": "orig", "text": "得＝逮【三】【敦】"}
{"id": null, "n": "0346019", "target": "#nkr_note_orig_0346019", "type": "orig", "text": "〔獲〕－【敦】，流布本亦同"}
{"id": null, "n": "0346020", "target": "#nkr_note_orig_0346020", "type": "orig", "text": "〔前〕－【三】"}
{"id": null, "n": "0346021", "target": "#nkr_note_orig_0346021", "type": "orig", "text": "〔及〕－【敦】，流布本亦同"}
{"id": null, "n": "0346022", "target": "#nkr_note_orig_0346022", "type": "orig", "text": "流布本無即"}
{"id": null, "n": "0346023", "target": "#nkr_note_orig_0346023", "type": "orig", "text": "芬＝分【三】【敦】，流布本亦同"}
{"id": null, "n": "0346024", "target": "#nkr_note_orig_0346024", "type": "orig", "text": "目連＝目犍連【三】【敦】，流布本亦同"}
{"id": null, "n": "0346025", "target": "#nkr_note_orig_0346025", "type": "orig", "text": "〔尊者〕－【敦】，流布本亦同"}
{"id": null, "n": "0346026", "target": "#nkr_note_orig_0346026", "type": "orig", "text": "人天＝諸天【元】【明】【敦】，流布本亦同"}
{"id": null, "n": "0346027", "target": "#nkr_note_orig_0346027", "type": "orig", "text": "龍神＝龍【元】【明】【敦】，流布本作及龍"}
{"id": null, "n": "0346028", "target": "#nkr_note_orig_0346028", "type": "orig", "text": "流布本無佛之字"}
{"id": null, "n": "0346029", "target": "#nkr_note_orig_0346029", "type": "orig", "text": "經＋（一卷，蓋骨筆傳經遠求甘露之味剪皮寫偈深種般若之因沙門曇晈普化有緣敬寫此經千部冀使一聞一見俱得上品往生一念一稱同入彌陀之國逮霑有資此妙因）六十四字【敦】"}
{"id": null, "n": "0342a1201", "target": "#nkr_note_add_0342a1201", "type": "add", "text": "一【CB】【麗-CB】，［－］【大】"}
{"id": null, "n": "0342c1901", "target": "#nkr_note_add_0342c1901", "type": "add", "text": "可【CB】【麗-CB】，得【大】"}
{"id": null, "n": "0343a2901", "target": "#nkr_note_add_0343a2901", "type": "add", "text": "在【CB】【麗-CB】，左【大】"}
{"id": null, "n": "0344a1001", "target": "#nkr_note_add_0344a1001", "type": "add", "text": "相【CB】【麗-CB】，想【大】"}
{"id": null, "n": "0346b0901", "target": "#nkr_note_add_0346b0901", "type": "add", "text": "當【CB】【麗-CB】，等【大】"}
