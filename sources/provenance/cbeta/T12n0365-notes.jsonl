{"id": null, "n": "0342010", "target": "#nkr_note_mod_0342010", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】【流布本】"}
{"id": null, "n": "0342011", "target": "#nkr_note_mod_0342011", "type": "mod", "text": "寶【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0342012", "target": "#nkr_note_mod_0342012", "type": "mod", "text": "樹【大】，林【宋】"}
