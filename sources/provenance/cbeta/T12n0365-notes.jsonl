{"id": null, "n": "0343011", "target": "#nkr_note_mod_0343011", "type": "mod", "text": "樹【大】，其【宋】【元】【明】【流布本】"}
{"id": null, "n": "0343012", "target": "#nkr_note_mod_0343012", "type": "mod", "text": "放金光【大】，作金色【宋】【元】【明】"}
