{"id": null, "n": "0344017", "target": "#nkr_note_mod_0344017", "type": "mod", "text": "及【大】，〔－〕【宋】【元】【明】【敦】【流布本】"}
{"id": null, "n": "0344018a", "target": "#nkr_note_mod_0344018a", "type": "mod", "text": "（作是…邪觀）十六字【大】，〔－〕【宋】【元】【明】【敦】【流布本】"}
{"id": null, "n": "0344018b", "target": "#nkr_note_mod_0344018b", "type": "mod", "text": "（佛告…韋提希）八字【大】，〔－〕【宋】【元】【明】【敦】【流布本】"}
{"id": null, "n": "0344019", "target": "#nkr_note_mod_0344019", "type": "mod", "text": "想作心自見【大】＊，自心【宋】【元】【明】【敦】＊，【流布本】"}
{"id": null, "n": "0344020", "target": "#nkr_note_mod_0344020", "type": "mod", "text": "跏【大】，加【宋】【元】【明】"}
{"id": null, "n": "0344021", "target": "#nkr_note_mod_0344021", "type": "mod", "text": "若【大】，〔－〕【敦】【流布本】"}
{"id": null, "n": "0344022", "target": "#nkr_note_mod_0344022", "type": "mod", "text": "定【大】，定之【元】【明】【敦】【流布本】"}
{"id": null, "n": "0344023", "target": "#nkr_note_mod_0344023", "type": "mod", "text": "想【大】，相【敦】"}
{"id": null, "n": "0344024", "target": "#nkr_note_mod_0344024", "type": "mod", "text": "及【大】，〔－〕【敦】【流布本】"}
{"id": null, "n": "0344025", "target": "#nkr_note_mod_0344025", "type": "mod", "text": "（作是…邪觀）十六字【大】＊，〔－〕【宋】【元】【明】【敦】＊，【流布本】"}
{"id": null, "n": "0344026", "target": "#nkr_note_mod_0344026", "type": "mod", "text": "況復【大】，何況【流布本】"}
{"id": null, "n": "0344027", "target": "#nkr_note_mod_0344027", "type": "mod", "text": "相【大】，想【宋】"}
{"id": null, "n": "0344028", "target": "#nkr_note_mod_0344028", "type": "mod", "text": "首【大】，手【敦】"}
{"id": null, "n": "0344029", "target": "#nkr_note_mod_0344029", "type": "mod", "text": "音【大】，音菩薩【敦】"}
{"id": null, "n": "0344030", "target": "#nkr_note_mod_0344030", "type": "mod", "text": "佛【大】，〔－〕【敦】"}
{"id": null, "n": "0344031", "target": "#nkr_note_mod_0344031", "type": "mod", "text": "雜想觀【大】，雜觀相【敦】"}
{"id": null, "n": "0344032", "target": "#nkr_note_mod_0344032", "type": "mod", "text": "佛【大】，佛佛【元】"}
{"id": null, "n": "0344033", "target": "#nkr_note_mod_0344033", "type": "mod", "text": "凡生西方有九品人【大】，〔－〕【宋】【元】【明】【敦】【流布本】"}
{"id": null, "n": "0344034", "target": "#nkr_note_mod_0344034", "type": "mod", "text": "願【大】，願願【元】【明】【敦】【流布本】"}
{"id": null, "n": "0344035", "target": "#nkr_note_mod_0344035", "type": "mod", "text": "佛【大】，〔－〕【元】【明】【敦】【流布本】"}
{"id": null, "n": "0344036", "target": "#nkr_note_mod_0344036", "type": "mod", "text": "猛【大】，猛力【宋】"}
{"id": null, "n": "0344037", "target": "#nkr_note_mod_0344037", "type": "mod", "text": "及【大】，〔－〕【元】【明】【敦】，【流布本】＊"}
{"id": null, "n": "0344038", "target": "#nkr_note_mod_0344038", "type": "mod", "text": "量【大】，數【流布本】"}
{"id": null, "n": "0345001", "target": "#nkr_note_mod_0345001", "type": "mod", "text": "至【大】，到【流布本】"}
{"id": null, "n": "0345002", "target": "#nkr_note_mod_0345002", "type": "mod", "text": "信【大】，信信【敦】"}
{"id": null, "n": "0345003", "target": "#nkr_note_mod_0345003", "type": "mod", "text": "即【大】，則【宋】【元】【明】【流布本】"}
{"id": null, "n": "0345004", "target": "#nkr_note_mod_0345004", "type": "mod", "text": "俱放【大】，俱時【宋】【元】【明】，俱時放【敦】【流布本】"}
{"id": null, "n": "0345005", "target": "#nkr_note_mod_0345005", "type": "mod", "text": "飛【大】，飛行遍【宋】【元】【明】【流布本】"}
{"id": null, "n": "0345006", "target": "#nkr_note_mod_0345006", "type": "mod", "text": "法【大】，〔－〕【宋】【元】【明】【敦】【流布本】"}
{"id": null, "n": "0345007", "target": "#nkr_note_mod_0345007", "type": "mod", "text": "彼【大】，〔－〕【宋】【元】【明】【敦】【流布本】"}
{"id": null, "n": "0345008", "target": "#nkr_note_mod_0345008", "type": "mod", "text": "并【大】，〔－〕【元】【明】【敦】【流布本】"}
{"id": null, "n": "0345009", "target": "#nkr_note_mod_0345009", "type": "mod", "text": "眷屬【大】，菩薩【宋】【元】【明】"}
{"id": null, "n": "0345010", "target": "#nkr_note_mod_0345010", "type": "mod", "text": "化【大】，〔－〕【元】【明】"}
{"id": null, "n": "0345011", "target": "#nkr_note_mod_0345011", "type": "mod", "text": "化【大】，〔－〕【敦】"}
{"id": null, "n": "0345012", "target": "#nkr_note_mod_0345012", "type": "mod", "text": "佛告【大】＊，復次【敦】＊"}
{"id": null, "n": "0345013", "target": "#nkr_note_mod_0345013", "type": "mod", "text": "惡【大】，患【宋】【元】【明】【流布本】"}
{"id": null, "n": "0345014", "target": "#nkr_note_mod_0345014", "type": "mod", "text": "行者【大】，〔－〕【宋】【元】【明】【敦】【流布本】"}
{"id": null, "n": "0345015", "target": "#nkr_note_mod_0345015", "type": "mod", "text": "持【大】，受持【敦】【流布本】"}
{"id": null, "n": "0345016", "target": "#nkr_note_mod_0345016", "type": "mod", "text": "聞【大】，見【敦】"}
{"id": null, "n": "0345017", "target": "#nkr_note_mod_0345017", "type": "mod", "text": "乃【大】，開【敦】"}
{"id": null, "n": "0345018", "target": "#nkr_note_mod_0345018", "type": "mod", "text": "義【大】，慈【宋】【元】【明】【敦】【流布本】"}
{"id": null, "n": "0345019", "target": "#nkr_note_mod_0345019", "type": "mod", "text": "大【大】，〔－〕【元】【明】【流布本】"}
{"id": null, "n": "0345020", "target": "#nkr_note_mod_0345020", "type": "mod", "text": "生【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0345021", "target": "#nkr_note_mod_0345021", "type": "mod", "text": "遇【大】，已遇【宋】【元】【明】"}
{"id": null, "n": "0345022", "target": "#nkr_note_mod_0345022", "type": "mod", "text": "得須陀洹【大】，〔－〕【敦】【流布本】"}
{"id": null, "n": "0345023", "target": "#nkr_note_mod_0345023", "type": "mod", "text": "過【大】，經【流布本】"}
{"id": null, "n": "0345024", "target": "#nkr_note_mod_0345024", "type": "mod", "text": "惡法【大】，眾惡【敦】【流布本】"}
{"id": null, "n": "0345025", "target": "#nkr_note_mod_0345025", "type": "mod", "text": "讚【大】，說【宋】【元】【明】"}
{"id": null, "n": "0345026", "target": "#nkr_note_mod_0345026", "type": "mod", "text": "化佛【大】，〔－〕【敦】"}
{"id": null, "n": "0345027", "target": "#nkr_note_mod_0345027", "type": "mod", "text": "善哉【大】，〔－〕【宋】【元】【明】【敦】【流布本】"}
{"id": null, "n": "0345028", "target": "#nkr_note_mod_0345028", "type": "mod", "text": "汝【大】，以汝【宋】【元】【明】"}
{"id": null, "n": "0345029", "target": "#nkr_note_mod_0345029", "type": "mod", "text": "已【大】，日【明】"}
{"id": null, "n": "0345030", "target": "#nkr_note_mod_0345030", "type": "mod", "text": "及大勢至菩薩【大】，〔－〕【敦】"}
{"id": null, "n": "0345031", "target": "#nkr_note_mod_0345031", "type": "mod", "text": "（得聞…往生）十八字【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0346001", "target": "#nkr_note_mod_0346001", "type": "mod", "text": "法【大】，業【宋】【元】【明】【敦】【流布本】"}
{"id": null, "n": "0346002", "target": "#nkr_note_mod_0346002", "type": "mod", "text": "即為讚【大】，為【敦】【流布本】"}
{"id": null, "n": "0346003", "target": "#nkr_note_mod_0346003", "type": "mod", "text": "讚【大】，為【敦】，說【流布本】"}
{"id": null, "n": "0346004", "target": "#nkr_note_mod_0346004", "type": "mod", "text": "涼【大】，清涼【元】【明】【敦】【流布本】"}
{"id": null, "n": "0346005", "target": "#nkr_note_mod_0346005", "type": "mod", "text": "當華敷時【大】，〔－〕【宋】【元】【明】【敦】"}
{"id": null, "n": "0346006", "target": "#nkr_note_mod_0346006", "type": "mod", "text": "此【大】，以【敦】"}
{"id": null, "n": "0346007", "target": "#nkr_note_mod_0346007", "type": "mod", "text": "彼【大】，此【流布本】"}
{"id": null, "n": "0346008", "target": "#nkr_note_mod_0346008", "type": "mod", "text": "彼佛【大】，〔－〕【敦】【流布本】"}
{"id": null, "n": "0346009", "target": "#nkr_note_mod_0346009", "type": "mod", "text": "歸命【大】，〔－〕【元】【明】【敦】【流布本】"}
{"id": null, "n": "0346010", "target": "#nkr_note_mod_0346010", "type": "mod", "text": "阿彌陀【大】，〔－〕【敦】"}
{"id": null, "n": "0346011", "target": "#nkr_note_mod_0346011", "type": "mod", "text": "時【大】，後【敦】"}
{"id": null, "n": "0346012", "target": "#nkr_note_mod_0346012", "type": "mod", "text": "往【大】，生【宋】"}
{"id": null, "n": "0346013", "target": "#nkr_note_mod_0346013", "type": "mod", "text": "開【大】，聞【元】"}
{"id": null, "n": "0346014", "target": "#nkr_note_mod_0346014", "type": "mod", "text": "當花敷時【大】，〔－〕【元】【明】【敦】【流布本】，時【宋】"}
{"id": null, "n": "0346015", "target": "#nkr_note_mod_0346015", "type": "mod", "text": "即為其人廣說【大】，為其廣說諸法【元】【明】【敦】【流布本】"}
{"id": null, "n": "0346016", "target": "#nkr_note_mod_0346016", "type": "mod", "text": "爾時世尊【大】，〔－〕【宋】【元】【明】【敦】【流布本】"}
{"id": null, "n": "0346017", "target": "#nkr_note_mod_0346017", "type": "mod", "text": "豁【大】，廓【敦】【流布本】"}
{"id": null, "n": "0346018", "target": "#nkr_note_mod_0346018", "type": "mod", "text": "得【大】，逮【宋】【元】【明】【敦】"}
{"id": null, "n": "0346019", "target": "#nkr_note_mod_0346019", "type": "mod", "text": "獲【大】，〔－〕【敦】【流布本】"}
{"id": null, "n": "0346020", "target": "#nkr_note_mod_0346020", "type": "mod", "text": "前【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0346021", "target": "#nkr_note_mod_0346021", "type": "mod", "text": "及【大】，〔－〕【敦】【流布本】"}
{"id": null, "n": "0346022", "target": "#nkr_note_mod_0346022", "type": "mod", "text": "即【大】，〔－〕【流布本】"}
{"id": null, "n": "0346023", "target": "#nkr_note_mod_0346023", "type": "mod", "text": "芬【大】，分【宋】【元】【明】【敦】【流布本】"}
{"id": null, "n": "0346024", "target": "#nkr_note_mod_0346024", "type": "mod", "text": "目連【大】，目犍連【宋】【元】【明】【敦】【流布本】"}
{"id": null, "n": "0346025", "target": "#nkr_note_mod_0346025", "type": "mod", "text": "尊者【大】，〔－〕【敦】【流布本】"}
{"id": null, "n": "0346026", "target": "#nkr_note_mod_0346026", "type": "mod", "text": "人天【大】，諸天【元】【明】【敦】【流布本】"}
{"id": null, "n": "0346027", "target": "#nkr_note_mod_0346027", "type": "mod", "text": "龍神【大】，龍【元】【明】【敦】，及龍【流布本】"}
{"id": null, "n": "0346028", "target": "#nkr_note_mod_0346028", "type": "mod", "text": "佛【大】，〔－〕【流布本】"}
{"id": null, "n": "0346029", "target": "#nkr_note_mod_0346029", "type": "mod", "text": "經【大】，經一卷蓋骨筆傳經遠求甘露之味剪皮寫偈深種般若之因沙門曇晈普化有緣敬寫此經千部冀使一聞一見俱得上品往生一念一稱同入彌陀之國逮霑有資此妙因【敦】"}
{"id": null, "n": "0340001", "target": "#nkr_note_orig_0340001", "type": "orig", "text": "流布本無佛字"}
{"id": null, "n": "0340002", "target": "#nkr_note_orig_0340002", "type": "orig", "text": "（劉）＋宋【宋】【元】"}
{"id": null, "n": "0340003", "target": "#nkr_note_orig_0340003", "type": "orig", "text": "西域三藏流布本作元嘉中"}
{"id": null, "n": "0340004", "target": "#nkr_note_orig_0340004", "type": "orig", "text": "三藏＋（法師）【三】"}
{"id": null, "n": "0341001", "target": "#nkr_note_orig_0341001", "type": "orig", "text": "葡萄＝蒲桃【宋】【元】，流布本亦同，蒲萄【明】"}
{"id": null, "n": "0341002", "target": "#nkr_note_orig_0341002", "type": "orig", "text": "目乾連＝目犍連【三】＊，流布本亦同"}
{"id": null, "n": "0341003", "target": "#nkr_note_orig_0341003", "type": "orig", "text": "人＝者【三】，流布本亦同"}
{"id": null, "n": "0341004", "target": "#nkr_note_orig_0341004", "type": "orig", "text": "者＝人【三】，流布本亦同"}
{"id": null, "n": "0341005", "target": "#nkr_note_orig_0341005", "type": "orig", "text": "我等不宜復住於此流布本作不宜住此"}
{"id": null, "n": "0341006", "target": "#nkr_note_orig_0341006", "type": "orig", "text": "目揵連流布本作目犍連"}
{"id": null, "n": "0341007", "target": "#nkr_note_orig_0341007", "type": "orig", "text": "在＝侍【三】"}
{"id": null, "n": "0341008", "target": "#nkr_note_orig_0341008", "type": "orig", "text": "餓＝饑【明】"}
{"id": null, "n": "0341009", "target": "#nkr_note_orig_0341009", "type": "orig", "text": "頗梨＝玻𭹳【三】＊，流布本亦同"}
{"id": null, "n": "0341010", "target": "#nkr_note_orig_0341010", "type": "orig", "text": "流布本無王字"}
{"id": null, "n": "0341011", "target": "#nkr_note_orig_0341011", "type": "orig", "text": "流布本無乃是二字"}
{"id": null, "n": "0342001", "target": "#nkr_note_orig_0342001", "type": "orig", "text": "日＋（欲沒之處）【三】"}
{"id": null, "n": "0342002", "target": "#nkr_note_orig_0342002", "type": "orig", "text": "〔作是觀…成已〕二十八字－【三】，流布本亦同"}
{"id": null, "n": "0342003", "target": "#nkr_note_orig_0342003", "type": "orig", "text": "〔想見西方一切皆是大水〕－【三】，流布本亦同"}
{"id": null, "n": "0342004", "target": "#nkr_note_orig_0342004", "type": "orig", "text": "澄流布本作澂"}
{"id": null, "n": "0342005", "target": "#nkr_note_orig_0342005", "type": "orig", "text": "食＝睡【明】，流布本亦同"}
{"id": null, "n": "0342006", "target": "#nkr_note_orig_0342006", "type": "orig", "text": "（（作此觀…成已））二十八字＝（（如此想者））四字【三】，流布本亦同"}
{"id": null, "n": "0342007", "target": "#nkr_note_orig_0342007", "type": "orig", "text": "粗＝󱍮【明】＊"}
{"id": null, "n": "0342008", "target": "#nkr_note_orig_0342008", "type": "orig", "text": "馬腦＝碼碯【三】，流布本亦同"}
{"id": null, "n": "0342009", "target": "#nkr_note_orig_0342009", "type": "orig", "text": "車𤦲＝硨磲【三】＊，流布本亦同"}
{"id": null, "n": "0342010", "target": "#nkr_note_orig_0342010", "type": "orig", "text": "〔有〕－【三】，流布本亦同"}
{"id": null, "n": "0342011", "target": "#nkr_note_orig_0342011", "type": "orig", "text": "〔寶〕－【三】"}
{"id": null, "n": "0342012", "target": "#nkr_note_orig_0342012", "type": "orig", "text": "樹＝林【宋】"}
{"id": null, "n": "0342013", "target": "#nkr_note_orig_0342013", "type": "orig", "text": "纓＝瓔【三】，流布本亦同"}
{"id": null, "n": "0342014", "target": "#nkr_note_orig_0342014", "type": "orig", "text": "宛＝婉【宋】＊，流布本亦同"}
{"id": null, "n": "0342015", "target": "#nkr_note_orig_0342015", "type": "orig", "text": "踊＝涌【三】＊，流布本亦同"}
{"id": null, "n": "0342016", "target": "#nkr_note_orig_0342016", "type": "orig", "text": "〔作是觀…成已〕二十八字－【三】，流布本亦同"}
{"id": null, "n": "0342017", "target": "#nkr_note_orig_0342017", "type": "orig", "text": "明註曰水宋藏作池＊"}
{"id": null, "n": "0342018", "target": "#nkr_note_orig_0342018", "type": "orig", "text": "流布本無欲字"}
{"id": null, "n": "0342019", "target": "#nkr_note_orig_0342019", "type": "orig", "text": "（妙）＋色【三】"}
{"id": null, "n": "0342020", "target": "#nkr_note_orig_0342020", "type": "orig", "text": "〔從〕－【三】，流布本亦同"}
{"id": null, "n": "0342021", "target": "#nkr_note_orig_0342021", "type": "orig", "text": "〔作是觀…韋提希〕二十四字－【三】，流布本亦同"}
