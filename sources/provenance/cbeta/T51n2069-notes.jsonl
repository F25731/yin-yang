{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "上舉兩切。下音保。小兒衣也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上子宋切。下郎殿切"}
{"id": null, "n": null, "target": null, "type": null, "text": "上音緇。下音殊"}
{"id": null, "n": null, "target": null, "type": null, "text": "乙結切"}
{"id": null, "n": null, "target": null, "type": null, "text": "音嚥"}
{"id": null, "n": null, "target": null, "type": null, "text": "上音謀。建於兵車。長二丈。下音朔。丈八曰矟"}
{"id": null, "n": null, "target": null, "type": null, "text": "莫結切。侮也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音皎。纏也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音稅"}
{"id": null, "n": null, "target": null, "type": null, "text": "德行未見本傳"}
{"id": null, "n": null, "target": null, "type": null, "text": "齊是\n國號。高謂高祖渤海人也。姓高氏。齊大夫高奚之後。高歡次洋方受魏禪。都鄴在相州。即北齊也"}
{"id": null, "n": null, "target": null, "type": null, "text": "無競化者。故云河北。淮謂南。行化於世"}
{"id": null, "n": null, "target": null, "type": null, "text": "明所證既深。\n非餘所知"}
{"id": null, "n": null, "target": null, "type": null, "text": "尊者法行於世。如履地不知地之厚。戴天不知天\n之高"}
{"id": null, "n": null, "target": null, "type": null, "text": "音例。疫病"}
{"id": null, "n": null, "target": null, "type": null, "text": "公回切。大也"}
{"id": null, "n": null, "target": null, "type": null, "text": "達合切"}
{"id": null, "n": null, "target": null, "type": null, "text": "音儔。算也"}
{"id": null, "n": null, "target": null, "type": null, "text": "口概切。太息也"}
{"id": null, "n": null, "target": null, "type": null, "text": "忽郭切。揮霍也"}
{"id": null, "n": null, "target": null, "type": null, "text": "直禁切。以毛歷飲食能殺人"}
{"id": null, "n": null, "target": null, "type": null, "text": "上音峯。烽燧候表也。邊有警則舉火。晝曰燧。夜曰烽"}
{"id": null, "n": null, "target": null, "type": null, "text": "於罽切。埋也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上音杳"}
{"id": null, "n": null, "target": null, "type": null, "text": "並的切。甎也"}
{"id": null, "n": null, "target": null, "type": null, "text": "高明之地曰爽塏。左傳曰。請更諸爽塏。文選曰。處高泉而爽塏"}
{"id": null, "n": null, "target": null, "type": null, "text": "居例切。狂犬。宋書曰。張收甞為猘犬所傷。食蝦蟆鱠而愈"}
{"id": null, "n": null, "target": null, "type": null, "text": "音杲"}
{"id": null, "n": null, "target": null, "type": null, "text": "居奄切。書檢印窠封題也"}
{"id": null, "n": null, "target": null, "type": null, "text": "本朝翰林學士扈蒙序云。大師梁大同四年戊午秋七月生"}
{"id": null, "n": null, "target": null, "type": null, "text": "徒敢切"}
{"id": null, "n": null, "target": null, "type": null, "text": "魚稼切"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "直又切"}
{"id": null, "n": null, "target": null, "type": null, "text": "大王入朝也"}
{"id": null, "n": null, "target": null, "type": null, "text": "郎計切。來也"}
{"id": null, "n": null, "target": null, "type": null, "text": "邗音寒。邗溝水名。在廣陵"}
{"id": null, "n": null, "target": null, "type": null, "text": "古公切"}
{"id": null, "n": null, "target": null, "type": null, "text": "於蟻切。天子所居也"}
{"id": null, "n": null, "target": null, "type": null, "text": "保驗切。下棺也"}
{"id": null, "n": null, "target": null, "type": null, "text": "章涉\n切。怯也"}
{"id": null, "n": null, "target": null, "type": null, "text": "說文曰。列分解也"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡板切。小笑貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "音角。揚搉大舉"}
{"id": null, "n": null, "target": null, "type": null, "text": "上初謹切。毀齒也。下亡卓切。遠也"}
{"id": null, "n": null, "target": null, "type": null, "text": "白各切。\n揚雅草玄曰。自守泊如也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音附"}
{"id": null, "n": null, "target": null, "type": null, "text": "恥離切。舒也"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "惟椿"}
{"id": null, "n": null, "target": null, "type": null, "text": "至顓"}
{"id": null, "n": null, "target": null, "type": null, "text": "有朋"}
{"id": null, "n": null, "target": null, "type": null, "text": "附"}
{"id": null, "n": null, "target": null, "type": null, "text": "又作行業記"}
{"id": null, "n": null, "target": null, "type": null, "text": "原本無學字。龍城沙門忍鎧。依內證血脈譜正之"}
{"id": null, "n": null, "target": null, "type": null, "text": "本按集字當作習字"}
{"id": null, "n": null, "target": null, "type": null, "text": "本按陸字恐剩"}
{"id": null, "n": "0098001", "target": "#nkr_note_mod_0098001", "type": "mod", "text": "河【大】，獨步河謂【考偽-原】"}
{"id": null, "n": "0099001", "target": "#nkr_note_mod_0099001", "type": "mod", "text": "色【大】，顏色【考偽-原】"}
{"id": null, "n": "0101001", "target": "#nkr_note_mod_0101001", "type": "mod", "text": "華【大】，法華【考偽-原】"}
{"id": null, "n": "0097004", "target": "#nkr_note_orig_0097004", "type": "orig", "text": "【原】大日本續藏經"}
{"id": null, "n": "0098001", "target": "#nkr_note_orig_0098001", "type": "orig", "text": "河＝獨步河謂ヵ【原】"}
{"id": null, "n": "0099001", "target": "#nkr_note_orig_0099001", "type": "orig", "text": "（顏）＋色ヵ【原】"}
{"id": null, "n": "0101001", "target": "#nkr_note_orig_0101001", "type": "orig", "text": "（法）＋華ヵ【原】"}
{"id": null, "n": "0099c1201", "target": "#nkr_note_add_0099c1201", "type": "add", "text": "斂【CB】，歛【大】"}
{"id": null, "n": "0101a1901", "target": "#nkr_note_add_0101a1901", "type": "add", "text": "采【CB】，釆【大】"}
