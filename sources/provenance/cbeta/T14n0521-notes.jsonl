{"id": null, "n": null, "target": null, "type": null, "text": "准品次錄二紙八行，諸本皆闕"}
{"id": null, "n": null, "target": null, "type": null, "text": "准品次錄二紙八行，諸本皆闕"}
{"id": null, "n": "0794004", "target": "#nkr_note_mod_0794004", "type": "mod", "text": "人名今附西晉錄【大】，〔－〕【宮】，附西晉錄【宋】【元】"}
{"id": null, "n": "0794005", "target": "#nkr_note_mod_0794005", "type": "mod", "text": "從【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0794006", "target": "#nkr_note_mod_0794006", "type": "mod", "text": "蔬【大】，󰡾【宋】【元】【宮】，疎【明】"}
{"id": null, "n": "0794007", "target": "#nkr_note_mod_0794007", "type": "mod", "text": "便【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0794008", "target": "#nkr_note_mod_0794008", "type": "mod", "text": "（准…闕）十二字【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0794004", "target": "#nkr_note_orig_0794004", "type": "orig", "text": "〔人名今〕－【宋】【元】，〔人名…錄〕－【宮】"}
{"id": null, "n": "0794005", "target": "#nkr_note_orig_0794005", "type": "orig", "text": "〔從〕－【三】【宮】"}
{"id": null, "n": "0794006", "target": "#nkr_note_orig_0794006", "type": "orig", "text": "蔬＝󰡾【宋】【元】【宮】，疎【明】"}
{"id": null, "n": "0794007", "target": "#nkr_note_orig_0794007", "type": "orig", "text": "〔便〕－【三】【宮】"}
{"id": null, "n": "0794008", "target": "#nkr_note_orig_0794008", "type": "orig", "text": "〔准…闕〕十二字－【三】【宮】"}
