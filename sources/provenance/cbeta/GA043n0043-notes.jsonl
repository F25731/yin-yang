{"id": null, "n": null, "target": null, "type": null, "text": "昌熾"}
{"id": null, "n": null, "target": null, "type": null, "text": "昌熾"}
{"id": null, "n": null, "target": null, "type": null, "text": "昌熾"}
{"id": null, "n": null, "target": null, "type": null, "text": "昌熾"}
{"id": null, "n": null, "target": null, "type": null, "text": "昌熾"}
{"id": null, "n": null, "target": null, "type": null, "text": "弟"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "《吳都文粹》作「晚泊」"}
{"id": null, "n": null, "target": null, "type": null, "text": "《吳郡志》"}
{"id": null, "n": null, "target": null, "type": null, "text": "乾隆《蘇州府志》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《姑蘇志》、乾隆《府志》合纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "同上"}
{"id": null, "n": null, "target": null, "type": null, "text": "乾隆《府志》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《長洲縣志》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《吳門補乘》，參《百城煙水》"}
{"id": null, "n": null, "target": null, "type": null, "text": "盧熊《蘇州府志》。按：封橋寺藏經，明李日華《六研齋筆記》、國朝張燕昌\n《金粟箋說》亦載其事。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《吳郡志》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《姑蘇志》"}
{"id": null, "n": null, "target": null, "type": null, "text": "詳後〈志僧〉篇《百城煙水》。"}
{"id": null, "n": null, "target": null, "type": null, "text": "乾隆《蘇州府志》"}
{"id": null, "n": null, "target": null, "type": null, "text": "題名\n碑殘石。按：宣統三年當事募工重建，從土中得殘石，記助緣姓氏，前題歲月詳，但無文字，故〈志碑〉篇未錄。又\n按：曰「續建」，曰「前軒」，其先必有建大殿者，惜文獻闕如，不可攷矣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "俞樾〈記〉，詳下\n〈志碑〉篇"}
{"id": null, "n": null, "target": null, "type": null, "text": "鄒福保〈記〉，詳後〈志碑〉篇"}
{"id": null, "n": null, "target": null, "type": null, "text": "《吳郡\n志》，汲古、守山兩本皆有誤字，以《吳都文粹》、《姑蘇志》參校"}
{"id": null, "n": null, "target": null, "type": null, "text": "《法因集》；《王百榖全集》之一"}
{"id": null, "n": null, "target": null, "type": null, "text": "《仰蕭樓集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《行素齋詩集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《海虞詩苑》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《素修堂集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "按：\n竹橋先生此詩，亦詠寒山舊象，牽連錄之。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《百城煙水》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《功甫小集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "右二石象互見〈志碑〉篇"}
{"id": null, "n": null, "target": null, "type": null, "text": "《無夢園集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "一作絕筆"}
{"id": null, "n": null, "target": null, "type": null, "text": "《山谷詩集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "下有白文「明綱」、「宗朗」二印"}
{"id": null, "n": null, "target": null, "type": null, "text": "下有白文「淨範」、朱文「為則」兩印"}
{"id": null, "n": null, "target": null, "type": null, "text": "右題字三叚，皆見《穰棃館過眼錄》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《百城煙水》"}
{"id": null, "n": null, "target": null, "type": null, "text": "按：唐鐘未詳\n何時燬，寺鐘年月可攷者始此。"}
{"id": null, "n": null, "target": null, "type": null, "text": "詩互見上〈志象〉篇"}
{"id": null, "n": null, "target": null, "type": null, "text": "《行素齋詩集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "字穀廉"}
{"id": null, "n": null, "target": null, "type": null, "text": "《邃懷堂詩集後編》"}
{"id": null, "n": null, "target": null, "type": null, "text": "按：此條見今本《石林詩話》卷中。"}
{"id": null, "n": null, "target": null, "type": null, "text": "今湖海樓本《學林》無「新編」二字，此條見卷八"}
{"id": null, "n": null, "target": null, "type": null, "text": "以上四則並見宋胡仔《苕\n溪漁隱叢話》卷二十三"}
{"id": null, "n": null, "target": null, "type": null, "text": "《漁隱叢話續編》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《中吳紀聞》"}
{"id": null, "n": null, "target": null, "type": null, "text": "「恨」他書皆作「限」字"}
{"id": null, "n": null, "target": null, "type": null, "text": "《吳郡志．攷證門》"}
{"id": null, "n": null, "target": null, "type": null, "text": "吳聿《觀林詩話》"}
{"id": null, "n": null, "target": null, "type": null, "text": "馬位\n《秋窗隨筆》　按：位字石亭，西安人。《隨筆》刻入《昭代叢書》。"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "佚"}
{"id": null, "n": null, "target": null, "type": null, "text": "毛刻有此二字，不可解，疑是「在吳」之誤"}
{"id": null, "n": null, "target": null, "type": null, "text": "「憂」下無「任其」二字，應是厲太鴻以其不可解而刪之。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《鷗陂漁話．寒山寺王\n郇公書張繼詩石刻》一則"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "三百五十五"}
{"id": null, "n": null, "target": null, "type": null, "text": "五十七"}
{"id": null, "n": null, "target": null, "type": null, "text": "見《長編．三百四十一》"}
{"id": null, "n": null, "target": null, "type": null, "text": "六十二"}
{"id": null, "n": null, "target": null, "type": null, "text": "宋本有「之」字，近刻刪去"}
{"id": null, "n": null, "target": null, "type": null, "text": "按《本紀》，事在六年閏六月"}
{"id": null, "n": null, "target": null, "type": null, "text": "同上〈王郇公封國年月〉一則"}
{"id": null, "n": null, "target": null, "type": null, "text": "《郡志》亦采\n入〈藝文〉"}
{"id": null, "n": null, "target": null, "type": null, "text": "佚"}
{"id": null, "n": null, "target": null, "type": null, "text": "無年月，十行，行二十四至二十九字不等，行書。"}
{"id": null, "n": null, "target": null, "type": null, "text": "無年月，四行，行字不等，大草書。"}
{"id": null, "n": null, "target": null, "type": null, "text": "一字一行，橫列。年月題款，左右小字，分行如門額式，皆正書。"}
{"id": null, "n": null, "target": null, "type": null, "text": "無年月，共三段。第一段，五行，草書。第二、三段，皆七行，行書。行字不等。前題名，八分書。"}
{"id": null, "n": null, "target": null, "type": null, "text": "印"}
{"id": null, "n": null, "target": null, "type": null, "text": "下缺"}
{"id": null, "n": null, "target": null, "type": null, "text": "下缺"}
{"id": null, "n": null, "target": null, "type": null, "text": "按：「黃乾」下，諦視似「初者」二字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "廣承力守此寺。見《百城煙水》。"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "殘字十七行。跋，前二行，後四行，行字皆不等，行書。"}
{"id": null, "n": null, "target": null, "type": null, "text": "自「人之財產」起上缺。未錄。"}
{"id": null, "n": null, "target": null, "type": null, "text": "佚"}
{"id": null, "n": null, "target": null, "type": null, "text": "詩次〈志象〉篇。"}
{"id": null, "n": null, "target": null, "type": null, "text": "詩三行，行十字。跋三行，行十八字。草書。有陰、側。"}
{"id": null, "n": null, "target": null, "type": null, "text": "見前"}
{"id": null, "n": null, "target": null, "type": null, "text": "八行，行二十字，行書。"}
{"id": null, "n": null, "target": null, "type": null, "text": "一面。\n五行，行三十二字，真書。"}
{"id": null, "n": null, "target": null, "type": null, "text": "詩三十六首，分四石刻。每石三十行，三行為一首。末一石，附跋十二行，行十七八九字不等，均行書。"}
{"id": null, "n": null, "target": null, "type": null, "text": "未錄。"}
{"id": null, "n": null, "target": null, "type": null, "text": "石本未見。"}
{"id": null, "n": null, "target": null, "type": null, "text": "錄〈志寺〉篇。"}
{"id": null, "n": null, "target": null, "type": null, "text": "分兩石刻，每石三十行，行自十四至十七字不等，正書。"}
{"id": null, "n": null, "target": null, "type": null, "text": "錄〈志寺〉篇。"}
{"id": null, "n": null, "target": null, "type": null, "text": "三十二行，行二十二字，正書。"}
{"id": null, "n": null, "target": null, "type": null, "text": "錄〈志寺〉篇。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《鷗天閣集》，並見《蛻翁所見詩錄》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《吳都文粹》並《吳郡志》合纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "字晞郗，錢唐人"}
{"id": null, "n": null, "target": null, "type": null, "text": "錄下〈志詩〉\n篇"}
{"id": null, "n": null, "target": null, "type": null, "text": "按：顯，字仲微，錢唐人，洪武初，官廣西藤縣令"}
{"id": null, "n": null, "target": null, "type": null, "text": "據《松雨軒集》纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "據《胥臺集》纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "《百城煙水》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《百城\n煙水》，參金文通〈法華禪院碑〉"}
{"id": null, "n": null, "target": null, "type": null, "text": "按：法華庵在寒山寺隔岸，聽鐘橋之西。性能圓寂，新構精廬尚未落成，是終於寒山\n寺也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《已畦集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《百城煙水》"}
{"id": null, "n": null, "target": null, "type": null, "text": "按：《百城煙水．寒山寺》錄此兩詩，次在昔詩後。觀臞庵詩，\n既稱寒山為寓齋，又有「一杖來吳苑」之句，以梁鴻廡下\n為況，則梵公之於此寺，不過閒雲來往，偶然駐錫，在宗\n門中為流寓，非如在昔之為住山僧也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "又按：鴻慶居士所稱「沼公」、「悟上人」之類，一住虎邱，一住\n能仁寺，同為游客，薢茩相逢，更非梵公之比，故不列此\n寺，別詳下〈志游〉篇。"}
{"id": null, "n": null, "target": null, "type": null, "text": "詳〈志碑〉篇"}
{"id": null, "n": null, "target": null, "type": null, "text": "闕"}
{"id": null, "n": null, "target": null, "type": null, "text": "布字貳伯叁號"}
{"id": null, "n": null, "target": null, "type": null, "text": "秋巖、蓉塘"}
{"id": null, "n": null, "target": null, "type": null, "text": "布字貳伯肆\n號"}
{"id": null, "n": null, "target": null, "type": null, "text": "布字貳\n伯伍號"}
{"id": null, "n": null, "target": null, "type": null, "text": "南，□□寺。北，官街。東，□屋。西，許屋。"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注：「韓吏部詩云：\n『有窮者孟郊。』郊〈聞雞〉詩云：『似聞孤月口，能說落星心。』」"}
{"id": null, "n": null, "target": null, "type": null, "text": "據文\n嘉《和州詩》、文元發《蘭雪齋詩》纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "據《精華錄箋注》、戴延年《秋鐙叢話》合纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "殳、徐詩，見《百城煙水》。"}
{"id": null, "n": null, "target": null, "type": null, "text": "按：斐仲名\n\n麗，《百城煙水》采其〈楓橋〉詩一首。徐崧有〈斐仲招飲寒山〉詩，即其人也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《已畦集》，參《百城煙水》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《春融\n堂集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《潛研堂集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《梅葉\n閣文鈔》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《知止堂集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "原注：\n立齋詞名〈楓江漁唱〉。《翠薇花館詞集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "按：順卿又有〈喜遷鶯詞．題惠磐卿冷香別館圖〉，序云：「磐\n卿之高祖半農先生，家於葑門冷香溪，後遷滸墅。今磐\n卿卜宅楓江，與僕結鄰而居，名其室以誌先澤。」詞未錄。"}
{"id": null, "n": null, "target": null, "type": null, "text": "原注：時君客淮浦。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《翠薇花館詞．題辭》"}
{"id": null, "n": null, "target": null, "type": null, "text": "小蓮名宙襄，著有《半\n樹齋集》；其子即順卿先生，名載，工填詞"}
{"id": null, "n": null, "target": null, "type": null, "text": "損之"}
{"id": null, "n": null, "target": null, "type": null, "text": "紫貴"}
{"id": null, "n": null, "target": null, "type": null, "text": "卷三"}
{"id": null, "n": null, "target": null, "type": null, "text": "《仰蕭樓文集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "右〈楓橋月落〉"}
{"id": null, "n": null, "target": null, "type": null, "text": "右〈寒寺鯨音〉，據《倪文僖詩集》纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "據《穰棃館過眼錄》、《石渠隨筆》合纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "張大復《梅花草堂筆談》"}
{"id": null, "n": null, "target": null, "type": null, "text": "吳翊鳳《遜志堂雜鈔．乙集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "據《南州草堂集》、《小蓬海遺\n詩》合纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注：「指公於五十年前，與\n周安期、翁仲謙、吳茂申、俞無殊、家介白為方外交。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "據《南州草堂集》纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "據《懷\n舊續集》、《素脩堂詩集》纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "薛福成《庸盦筆記》"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注：「津門海光寺，舊藏\n純皇所賜玉鉢，余有長歌。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注：「張繼詩有『江\n楓』作『江村』，『漁火』作『漁父』者，余撫蘇時，特請俞曲園先生書\n\n碑紀事。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注：「寺中櫻花，乃日本白須領事\n手植。丁未春仲，曾讌飲花下。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "禧身"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "《吳郡志》題據《吳都文粹》補"}
{"id": null, "n": null, "target": null, "type": null, "text": "《吳郡志》"}
{"id": null, "n": null, "target": null, "type": null, "text": "按：胡埕，《郡志》無傳。《吳都文粹》作「胡理」，又錄其〈滄浪詠〉一\n首。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《吳郡志》"}
{"id": null, "n": null, "target": null, "type": null, "text": "按盧熊《蘇州府志》：郭附，字明仲，嘉祐八年進士。熙甯中，\n以大理寺丞權知崑山縣，官至朝奉大夫致仕。幅巾策\n\n杖，窮山林詩酒之適。東南高士，皆樂與之游。卒年八十\n四。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《長洲縣志》引「楓」上有「經」字"}
{"id": null, "n": null, "target": null, "type": null, "text": "《范石湖詩集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "同上"}
{"id": null, "n": null, "target": null, "type": null, "text": "《陸劍南集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《長洲縣志》引作「暮」"}
{"id": null, "n": null, "target": null, "type": null, "text": "《浪語集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《白雲集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "按：釋英，字實存，宋末錢唐詩僧，著有《白雲集》。此詩《長洲\n縣志》題張羽作，當從《靜居集》錄出，其題祇「泊楓橋」三字，\n亦與英《集》不同。按：《四庫提要》稱〈贈趙孟若〉七律一首，\n亦兩集重出，斷為《靜居集》誤收。觀此篇「憶舊游」句，作「重\n到」為是。《白雲》傳本甚尠，豈《靜居》一集，猶蘇過之於《龍\n\n洲》耶？"}
{"id": null, "n": null, "target": null, "type": null, "text": "《玉山草堂集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《長洲縣志》"}
{"id": null, "n": null, "target": null, "type": null, "text": "原注：舊有塔，今廢。"}
{"id": null, "n": null, "target": null, "type": null, "text": "以上七首皆據《高青邱集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "上三首謝孔昭《蘭庭集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "按：《瓜涇集》此詩之前有〈郡守林思紹邀陪太傅屠朝宗餞於石湖〉一首，太傅即朝宗。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《瓜涇集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《沈石田稿》，據王迺昭鈔本"}
{"id": null, "n": null, "target": null, "type": null, "text": "〈楓橋〉一首"}
{"id": null, "n": null, "target": null, "type": null, "text": "《皇甫司勳集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《蘭雪齋詩選》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《文錄事詩》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《鯤溟先生集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《曝書亭集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "上四首《百城煙水》"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "《歸愚詩鈔》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《素脩堂集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "字勉百，長洲舉人，有《葑田》、《剡東》諸集。"}
{"id": null, "n": null, "target": null, "type": null, "text": "字赤玉，杭州仁和人，諸生，有《圭齋稿》。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上二首，王西莊《江浙十二家詩\n選》"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注：橋邊有米市。"}
{"id": null, "n": null, "target": null, "type": null, "text": "字誕敷，號篔谷，長洲諸生，有《蔭茅居詩稿》。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上二首，吳枚庵《懷舊續集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "字漢賢，長洲人，有《虹橋詩鈔》。"}
{"id": null, "n": null, "target": null, "type": null, "text": "吳枚庵《卬須集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "上二首《行素齋詩集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "字睪曾，吳江人。此詩見《北溪旅稾》第一種《往來集》。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《北溪詩集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "字穀廉，寶山人，厯官江西知縣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《邃懷堂集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "雨中由楓橋至齊門。"}
{"id": null, "n": null, "target": null, "type": null, "text": "楓橋夜泊，用湘瑟詞〈楓溪〉原韻。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上兩闋《陳檢討集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "「游」，一本作「宿」。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《韋蘇州集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《姑蘇志》「卻憶」作「卻算」，「重游」作「游程」，「因」作「今」。"}
{"id": null, "n": null, "target": null, "type": null, "text": "按：「巖扉」，《姑\n蘇志》作「寺扉」。"}
{"id": null, "n": null, "target": null, "type": null, "text": "原注：今禹偁王內翰丁太夫人憂，任其親寫是詩，故不題名。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《吳郡志》「楓橋寺」下附詩，惟張繼〈晚泊〉一首，覿〈與溫老〉一首不全\n載題，其餘但有姓名而已，此據《宋詩鈔》補。"}
{"id": null, "n": null, "target": null, "type": null, "text": "承爵"}
{"id": null, "n": null, "target": null, "type": null, "text": "《姑蘇志》沿其誤"}
{"id": null, "n": null, "target": null, "type": null, "text": "上即誤析張師中詩之下半首，題為\n程師孟。"}
{"id": null, "n": null, "target": null, "type": null, "text": "「窣堵波」，《吳都文粹》作「宰渚波」，殊誤。"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐張祜以下七首，據《吳郡志》。"}
{"id": null, "n": null, "target": null, "type": null, "text": "字唏郗，南宋末錢唐人。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《漁溪詩稾》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《姑蘇志》"}
{"id": null, "n": null, "target": null, "type": null, "text": "按：此詩，王文恪與張繼詩皆附「楓橋」下，繹其詞意，實游\n寒山寺而作也。盧熊《志》：湯仲友，字端夫，先名益，學詩於\n周弼。浪跡湖海，晚復歸吳，自號西樓，有《北游詩集》。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《青邱詩集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "乾隆《蘇州府志》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《姑蘇八詠》之第六首"}
{"id": null, "n": null, "target": null, "type": null, "text": "《六如居士集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《金昌集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "〈斷塔遺基〉"}
{"id": null, "n": null, "target": null, "type": null, "text": "〈龍函新綠〉"}
{"id": null, "n": null, "target": null, "type": null, "text": "〈古木啼鳥〉"}
{"id": null, "n": null, "target": null, "type": null, "text": "殳丹生以下五首《百城煙水》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《梅葉閣詩鈔》"}
{"id": null, "n": null, "target": null, "type": null, "text": "字協文，號雲湄，元和人，有《雪鴻軒詩鈔》。"}
{"id": null, "n": null, "target": null, "type": null, "text": "吳翊鳳《懷舊又續集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "字遇溪，吳縣人。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《萬壑雲樓集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《行素齋詩集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "徐崧以下七首《百城煙水》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《臨川集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "此詩在《補遺》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《貞居先生集》二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "《義門集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《賞詩閣集續編》"}
{"id": null, "n": null, "target": null, "type": null, "text": "此詩亦效寒山子"}
{"id": null, "n": null, "target": null, "type": null, "text": "朱子〈偶摘寒山〉詩云：「煞有好詩，人未易到此。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "《南盷先生詩錄》"}
{"id": null, "n": null, "target": null, "type": null, "text": "原注：字僧鑒，名曉青。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《寒山子詩集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《太平廣記》"}
{"id": null, "n": null, "target": null, "type": null, "text": "趙州代曰：「文殊！文殊！」"}
{"id": null, "n": null, "target": null, "type": null, "text": "趙州因沙彌舉此，州代干云：「文殊！文殊！」"}
{"id": null, "n": null, "target": null, "type": null, "text": "《無夢園集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "此篇陸文節公錄示，不知所從出。雖釋子語，難以我\n法論，亦不似唐以前緇流筆墨。重在文節遺言，姑錄之。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《遂初堂集．台蕩游草》"}
{"id": null, "n": null, "target": null, "type": null, "text": "旁有石象、石犀"}
{"id": null, "n": null, "target": null, "type": null, "text": "原注：朱夫子謂：「寒山詩，有唐人道不到處。」《歸愚集．台山游草》。"}
{"id": null, "n": null, "target": null, "type": null, "text": "原本草書，下陸〈帖〉同。提行悉依原刻。"}
{"id": null, "n": null, "target": null, "type": null, "text": "「子」下疑脫「張」字"}
{"id": null, "n": null, "target": null, "type": null, "text": "翁注：據本書「絹」當作「卷」"}
{"id": null, "n": null, "target": null, "type": null, "text": "此引何屺瞻校語"}
{"id": null, "n": null, "target": null, "type": null, "text": "疑「識」之譌"}
{"id": null, "n": null, "target": null, "type": null, "text": "一記、一跋、一詩，據日本仿宋刻《寒山\n子詩集》錄出。"}
{"id": null, "n": null, "target": null, "type": null, "text": "按：「本公全書為《天目中峯和尚廣錄》。《擬寒山詩》，其中\n之一種也。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "徐大章《始豐稿》"}
{"id": null, "n": null, "target": null, "type": null, "text": "按：白珽，字廷玉，元錢唐人。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《瞿冏卿集》"}
{"id": null, "n": null, "target": null, "type": null, "text": "按：𤊹，字惟起，號興公，明季閩人，藏書極富。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《紅雨樓題跋》"}
{"id": null, "n": null, "target": null, "type": null, "text": "浙江巡撫採進本"}
{"id": null, "n": null, "target": null, "type": null, "text": "原案：此明江盈科《雪濤評語》，士禎引之。寒山子即唐人，盈科以為有唐調，葢偶未攷其時代。謹附訂於此。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《別集類》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《別集類》"}
{"id": null, "n": null, "target": null, "type": null, "text": "當作「胡」"}
{"id": null, "n": null, "target": null, "type": null, "text": "節錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "劍南希晝、金華\n\n保暹、南越文兆、天台行肇、沃州𥳑長、青城惟鳳、江東宇昭、峩眉懷古、淮南惠崇九人"}
{"id": null, "n": "a010001", "target": "#nkr_note_orig_a010001", "type": "orig", "text": "東漢末年經學大師鄭玄針對何休所寫〈公羊墨守〉、〈左氏膏肓〉、〈谷梁廢疾〉三文，提出他的觀點，而著〈發墨守〉、〈針膏肓〉、〈起廢疾〉以駁斥之。（百度百科：鄭玄，2012.12.30）"}
{"id": null, "n": "a025001", "target": "#nkr_note_orig_a025001", "type": "orig", "text": "《全唐詩》中，收錄有張繼〈楓橋夜泊〉詩（第242卷019號）、張祜〈楓橋〉詩（第511卷163號）。據此，「張祐」當為「張祜」之誤。"}
{"id": null, "n": "a028001", "target": "#nkr_note_orig_a028001", "type": "orig", "text": "汲古即「毛氏汲古閣」，明末藏書家毛晉（1599-1659）建。守山即「錢氏守山閣」，清藏書家錢熙祚建。（維基百科：毛晉、錢熙祚，2012.12.30）"}
{"id": null, "n": "a040001", "target": "#nkr_note_orig_a040001", "type": "orig", "text": "《續記》，即《吳郡圖經續記》，宋朱長文（1041-1100）撰。"}
{"id": null, "n": "a040002", "target": "#nkr_note_orig_a040002", "type": "orig", "text": "《長編》，即《續資治通鑑長編》，共九百八十卷，南宋李燾（1115-1184）編撰。"}
{"id": null, "n": "a051001", "target": "#nkr_note_orig_a051001", "type": "orig", "text": "編按：此段按語似為編者葉昌熾所加，故此詩出處《山谷詩集》當應移至詩末為宜。)"}
{"id": null, "n": "a069001", "target": "#nkr_note_orig_a069001", "type": "orig", "text": "「木鐸徇于道路周官所以警其頑」十三字底本闕漏，茲依底本 p. 54 唐寅〈姑蘇寒山寺化鐘疏〉一文補入。本篇補缺字所據同此。"}
{"id": null, "n": "a070001", "target": "#nkr_note_orig_a070001", "type": "orig", "text": "「月」字底本闕漏，茲依底本 p. 15 張繼〈楓橋夜泊〉詩補入。本篇補缺字所據同此。"}
{"id": null, "n": "a082001", "target": "#nkr_note_orig_a082001", "type": "orig", "text": "編按：此一「云」字，似是前後頁間重出者。"}
{"id": null, "n": "a155001", "target": "#nkr_note_orig_a155001", "type": "orig", "text": "編按：《補遺》即指《貞居先生詩集補遺》。)"}
{"id": null, "n": "a178001", "target": "#nkr_note_orig_a178001", "type": "orig", "text": "編按：葉珠紅《寒山資料類編》所收錄之〈朱晦庵與南老帖〉，與本文字句略有差異，詳見該書 p. 5。（台北：秀威資訊科技，2005）"}
{"id": null, "n": "a194001", "target": "#nkr_note_orig_a194001", "type": "orig", "text": "「屠維」、「赤奮若」乃太歲紀年的名稱，搭配天干地支，分別代表「己」、「丑」，即己丑年。（維基百科：太歲紀年，2012.12.30）陬月：農曆正月的別稱。（百度百科：陬月，2012.12.30）上澣：指上旬。（百度百科：上澣，2012.12.30）"}
{"id": null, "n": "a204001", "target": "#nkr_note_orig_a204001", "type": "orig", "text": "編按：應為「郭宅經鋪」，其為杭州著名印刷作坊之一。（中國科普博覽_印刷博物館網站：書坊的刻版印刷，2012.12.30）"}
{"id": null, "n": "a205001", "target": "#nkr_note_orig_a205001", "type": "orig", "text": "「谿」字底本闕漏，茲依陸心源〈儀顧堂題跋〉補入。（葉珠紅，寒山資料補編，p. 17，台北：秀威資訊科技，2005）。本篇補缺字所據同此。"}
{"id": null, "n": "a002a0101", "target": "#nkr_note_add_a002a0101", "type": "add", "text": "此「版本說明」一文原為書本開頭無頁碼之插頁，今為標記架構上之需要移到此處，且以 pa002a 為虛擬頁欄碼。"}
{"id": null, "n": "a003a0501", "target": "#nkr_note_add_a003a0501", "type": "add", "text": "間【CB】，問【志彙】"}
{"id": null, "n": "a020a0801", "target": "#nkr_note_add_a020a0801", "type": "add", "text": "郎【CB】，朗【志彙】"}
{"id": null, "n": "a021a0601", "target": "#nkr_note_add_a021a0601", "type": "add", "text": "汛【CB】，汎【志彙】"}
{"id": null, "n": "a035a0601", "target": "#nkr_note_add_a035a0601", "type": "add", "text": "頑【CB】，項【志彙】"}
{"id": null, "n": "a035a0701", "target": "#nkr_note_add_a035a0701", "type": "add", "text": "悶【CB】，門【志彙】"}
{"id": null, "n": "a043a0301", "target": "#nkr_note_add_a043a0301", "type": "add", "text": "間【CB】，閒【志彙】"}
{"id": null, "n": "a046a0601", "target": "#nkr_note_add_a046a0601", "type": "add", "text": "燕【CB】，贋【志彙】"}
{"id": null, "n": "a046a1001", "target": "#nkr_note_add_a046a1001", "type": "add", "text": "間【CB】，閒【志彙】"}
{"id": null, "n": "a049a0201", "target": "#nkr_note_add_a049a0201", "type": "add", "text": "間【CB】，閒【志彙】"}
