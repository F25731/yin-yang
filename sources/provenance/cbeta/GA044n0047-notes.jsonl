{"id": null, "n": null, "target": null, "type": null, "text": "監院空忍募造"}
{"id": null, "n": null, "target": null, "type": null, "text": "遵化州蔡家樓庄房，大悲會眾姓捐造。"}
{"id": null, "n": null, "target": null, "type": null, "text": "俱大悲會眾姓捐貲建"}
{"id": null, "n": null, "target": null, "type": null, "text": "舍利墖、金剛延壽墖、佛墖俱在寺內"}
{"id": null, "n": null, "target": null, "type": null, "text": "天眷時建"}
{"id": null, "n": null, "target": null, "type": null, "text": "大定十五年建"}
{"id": null, "n": null, "target": null, "type": null, "text": "大定二十八年建"}
{"id": null, "n": null, "target": null, "type": null, "text": "泰和四年建"}
