{"id": null, "n": "0253007", "target": "#nkr_note_mod_0253007", "type": "mod", "text": "大【大】，佛說大【宋】【元】【明】【甲】，【原】麗本，【甲】黃檗版淨嚴等加筆本"}
{"id": null, "n": "0253008", "target": "#nkr_note_mod_0253008", "type": "mod", "text": "（開府…寺）三十七字【大】，師子國【宋】【元】，唐【明】【甲】"}
{"id": null, "n": "0253009", "target": "#nkr_note_mod_0253009", "type": "mod", "text": "沙門【大】，廣智【宋】【元】"}
{"id": null, "n": "0253010", "target": "#nkr_note_mod_0253010", "type": "mod", "text": "門【大】，門大廣智【明】【甲】"}
{"id": null, "n": "0253011", "target": "#nkr_note_mod_0253011", "type": "mod", "text": "奉詔【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0253012", "target": "#nkr_note_mod_0253012", "type": "mod", "text": "詣【CB】【宋】【元】【明】【甲】，諸【大】"}
{"id": null, "n": "0253013", "target": "#nkr_note_mod_0253013", "type": "mod", "text": "圍繞【大】∞無量百千匝【宋】【元】【明】【甲】"}
{"id": null, "n": "0253014", "target": "#nkr_note_mod_0253014", "type": "mod", "text": "無量百千匝【大】∞圍繞【宋】【元】【明】【甲】"}
{"id": null, "n": "0253015", "target": "#nkr_note_mod_0253015", "type": "mod", "text": "消【大】，息【宋】【元】【明】【甲】"}
{"id": null, "n": "0253016", "target": "#nkr_note_mod_0253016", "type": "mod", "text": "曾【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0253017", "target": "#nkr_note_mod_0253017", "type": "mod", "text": "琉【大】，瑠【宋】【元】【明】【甲】"}
{"id": null, "n": "0253018", "target": "#nkr_note_mod_0253018", "type": "mod", "text": "睺【CB】，𬑠【大】，呼【宋】【元】【明】【甲】"}
{"id": null, "n": "0253019", "target": "#nkr_note_mod_0253019", "type": "mod", "text": "南無【大】下同，曩謨【宋】【元】【明】【甲】下同"}
{"id": null, "n": "0253020", "target": "#nkr_note_mod_0253020", "type": "mod", "text": "來【大】，來曩謨寶華功德海吠瑠璃金山光明吉祥如來【宋】【元】【明】，＋（曩謨寶華功德海吠瑠璃金山金光明吉祥如來）十八字【甲】"}
{"id": null, "n": "0253021", "target": "#nkr_note_mod_0253021", "type": "mod", "text": "威【大】，威德【宋】【元】【明】【甲】"}
{"id": null, "n": "0253022", "target": "#nkr_note_mod_0253022", "type": "mod", "text": "茶【大】，荼【宋】【元】【明】【甲】"}
{"id": null, "n": "0253023", "target": "#nkr_note_mod_0253023", "type": "mod", "text": "海【大】，海光【宋】【元】【明】【甲】"}
{"id": null, "n": "0254001", "target": "#nkr_note_mod_0254001", "type": "mod", "text": "嚴【大】，莊嚴【宋】【元】【明】【甲】"}
{"id": null, "n": "0254002", "target": "#nkr_note_mod_0254002", "type": "mod", "text": "山【大】，山王【宋】【元】【明】【甲】"}
{"id": null, "n": "0254003", "target": "#nkr_note_mod_0254003", "type": "mod", "text": "進【大】，精進【宋】【元】【明】【甲】"}
{"id": null, "n": "0254004", "target": "#nkr_note_mod_0254004", "type": "mod", "text": "念【大】，金【甲】"}
{"id": null, "n": "0254005", "target": "#nkr_note_mod_0254005", "type": "mod", "text": "讀【大】，讚【宋】【元】【明】【甲】"}
{"id": null, "n": "0254006", "target": "#nkr_note_mod_0254006", "type": "mod", "text": "音聲【大】，聲音【宋】【元】【明】"}
{"id": null, "n": "0254007", "target": "#nkr_note_mod_0254007", "type": "mod", "text": "王【CB】【考偽-甲】，五【大】"}
{"id": null, "n": "0254008", "target": "#nkr_note_mod_0254008", "type": "mod", "text": "尾【大】，尼【宋】【元】【明】【甲】"}
{"id": null, "n": "0254009", "target": "#nkr_note_mod_0254009", "type": "mod", "text": "摩【大】，麼【宋】【元】【明】【甲】"}
{"id": null, "n": "0254010", "target": "#nkr_note_mod_0254010", "type": "mod", "text": "去【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0254011", "target": "#nkr_note_mod_0254011", "type": "mod", "text": "蓮華【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0254012", "target": "#nkr_note_mod_0254012", "type": "mod", "text": "春【大】，眷【校異-甲】"}
{"id": null, "n": "0254013", "target": "#nkr_note_mod_0254013", "type": "mod", "text": "吉【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0254014", "target": "#nkr_note_mod_0254014", "type": "mod", "text": "音【大】，意【宋】【元】【明】【甲】"}
{"id": null, "n": "0255001", "target": "#nkr_note_mod_0255001", "type": "mod", "text": "得【大】，皆【宋】【元】【明】【甲】"}
{"id": null, "n": "0255002", "target": "#nkr_note_mod_0255002", "type": "mod", "text": "行【大】，（行天阿蘇羅藥叉等，來聽法者應至心，擁護佛法使長存，各各勤行世尊教，諸有聽徒來至此，或在地上或居空，常於人世起慈心，晝夜自身依法住，願諸世界常安隱，無邊福智益群生，所有罪障並消除，遠離眾苦歸圓寂，恒用戒香塗瑩體，常持定服以資身，菩提妙華遍莊嚴，隨所住處常安樂）【元】【明】【甲】，（行天阿蘇羅藥叉等，來聽法者應志心，擁護佛法使長存，各各勤行世尊教，諸有聽徒來志此，或在地上或居空，常於人世起慈心，晝夜自身依法住，願諸世界常安隱，無邊福智益群生，所有罪障並消除，遠離眾苦歸圓寂，恒用戒香塗瑩體，常持定服以資身，菩提妙華遍莊嚴，隨所住處常安樂）【宋】"}
{"id": null, "n": "0255003", "target": "#nkr_note_mod_0255003", "type": "mod", "text": "大【大】，佛說大【明】【甲】"}
{"id": null, "n": "0255005", "target": "#nkr_note_mod_0255005", "type": "mod", "text": "唵一【大】，〔－〕【校異-甲】，此真言依明本載之與宋元甲本對校 cf. P. 254c [15]"}
{"id": null, "n": "0255006", "target": "#nkr_note_mod_0255006", "type": "mod", "text": "他【大】，他唵一【校異-甲】"}
{"id": null, "n": "0255007", "target": "#nkr_note_mod_0255007", "type": "mod", "text": "聲【大】＊，〔－〕【宋】【元】＊"}
{"id": null, "n": "0255008", "target": "#nkr_note_mod_0255008", "type": "mod", "text": "引七【大】，七引【宋】【元】"}
{"id": null, "n": "0255009", "target": "#nkr_note_mod_0255009", "type": "mod", "text": "底【大】，底㗚【校異-甲】"}
{"id": null, "n": "0255010", "target": "#nkr_note_mod_0255010", "type": "mod", "text": "丁逸切十【大】，十丁逸反【宋】【元】"}
{"id": null, "n": "0255011", "target": "#nkr_note_mod_0255011", "type": "mod", "text": "引十一【大】，十一引【宋】【元】"}
{"id": null, "n": "0255012", "target": "#nkr_note_mod_0255012", "type": "mod", "text": "引十三【大】，十三引【宋】【元】"}
{"id": null, "n": "0255013", "target": "#nkr_note_mod_0255013", "type": "mod", "text": "合【大】＊，合引【甲】＊"}
{"id": null, "n": "0255014", "target": "#nkr_note_mod_0255014", "type": "mod", "text": "十【大】＊，引十【甲】＊"}
{"id": null, "n": "0255015", "target": "#nkr_note_mod_0255015", "type": "mod", "text": "慕帶曳【大】，母㗚低【甲】"}
{"id": null, "n": "0255016", "target": "#nkr_note_mod_0255016", "type": "mod", "text": "二【大】＊，引二【甲】＊"}
{"id": null, "n": "0255017", "target": "#nkr_note_mod_0255017", "type": "mod", "text": "儗里二合寧【大】，室哩二合抳【校異-甲】"}
{"id": null, "n": "0255018", "target": "#nkr_note_mod_0255018", "type": "mod", "text": "切【大】＊，反【宋】【元】＊"}
{"id": null, "n": "0255019", "target": "#nkr_note_mod_0255019", "type": "mod", "text": "三【大】＊，四【考偽-甲】＊"}
{"id": null, "n": "0255020", "target": "#nkr_note_mod_0255020", "type": "mod", "text": "茗【大】，〔－〕【考偽-甲】"}
{"id": null, "n": "0255021", "target": "#nkr_note_mod_0255021", "type": "mod", "text": "曩捨寧【大】，奢末尼【校異-甲】"}
{"id": null, "n": "0255022", "target": "#nkr_note_mod_0255022", "type": "mod", "text": "囉【大】，攞【宋】【元】"}
{"id": null, "n": "0255023", "target": "#nkr_note_mod_0255023", "type": "mod", "text": "屈引【大】，區開口重呼㗚【校異-甲】"}
{"id": null, "n": "0253007", "target": "#nkr_note_orig_0253007", "type": "orig", "text": "【原】麗本，【甲】黃檗版淨嚴等加筆本（佛說）＋大【三】【甲】"}
{"id": null, "n": "0253008", "target": "#nkr_note_orig_0253008", "type": "orig", "text": "（（開府…寺））三十七字＝（（師子國））三字【宋】【元】，（（唐））一字【明】【甲】"}
{"id": null, "n": "0253009", "target": "#nkr_note_orig_0253009", "type": "orig", "text": "沙門＝廣智【宋】【元】"}
{"id": null, "n": "0253010", "target": "#nkr_note_orig_0253010", "type": "orig", "text": "門＋（大廣智）【明】【甲】"}
{"id": null, "n": "0253011", "target": "#nkr_note_orig_0253011", "type": "orig", "text": "〔奉詔〕－【三】【甲】"}
{"id": null, "n": "0253012", "target": "#nkr_note_orig_0253012", "type": "orig", "text": "諸＝詣【三】【甲】"}
{"id": null, "n": "0253013", "target": "#nkr_note_orig_0253013", "type": "orig", "text": "圍繞∞無量百千匝【三】【甲】"}
{"id": null, "n": "0253014", "target": "#nkr_note_orig_0253014", "type": "orig", "text": "圍繞∞無量百千匝【三】【甲】"}
{"id": null, "n": "0253015", "target": "#nkr_note_orig_0253015", "type": "orig", "text": "消＝息【三】【甲】"}
{"id": null, "n": "0253016", "target": "#nkr_note_orig_0253016", "type": "orig", "text": "〔曾〕－【三】"}
{"id": null, "n": "0253017", "target": "#nkr_note_orig_0253017", "type": "orig", "text": "琉＝瑠【三】【甲】"}
{"id": null, "n": "0253018", "target": "#nkr_note_orig_0253018", "type": "orig", "text": "𬑠＝呼【三】【甲】"}
{"id": null, "n": "0253019", "target": "#nkr_note_orig_0253019", "type": "orig", "text": "南無＝曩謨【三】【甲】下同"}
{"id": null, "n": "0253020", "target": "#nkr_note_orig_0253020", "type": "orig", "text": "來＋（曩謨寶華功德海吠瑠璃金山光明吉祥如來）十八字【三】【甲】上記中光上甲本有金字"}
{"id": null, "n": "0253021", "target": "#nkr_note_orig_0253021", "type": "orig", "text": "威＋（德）【三】【甲】"}
{"id": null, "n": "0253022", "target": "#nkr_note_orig_0253022", "type": "orig", "text": "茶＝荼【三】【甲】"}
{"id": null, "n": "0253023", "target": "#nkr_note_orig_0253023", "type": "orig", "text": "海＋（光）【三】【甲】"}
{"id": null, "n": "0254001", "target": "#nkr_note_orig_0254001", "type": "orig", "text": "（莊）＋嚴【三】【甲】"}
{"id": null, "n": "0254002", "target": "#nkr_note_orig_0254002", "type": "orig", "text": "山＋（王）【三】【甲】"}
