{"id": null, "n": null, "target": null, "type": null, "text": "上"}
{"id": null, "n": null, "target": null, "type": null, "text": "下"}
{"id": null, "n": null, "target": null, "type": null, "text": "附"}
{"id": null, "n": null, "target": null, "type": null, "text": "上"}
{"id": null, "n": null, "target": null, "type": null, "text": "上莫紅切音蒙下多動切音董懵懂心亂貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "魚開切艾平聲\n癡獃"}
{"id": null, "n": null, "target": null, "type": null, "text": "奴登切"}
{"id": null, "n": null, "target": null, "type": null, "text": "古華切音瓜"}
{"id": null, "n": null, "target": null, "type": null, "text": "居曷切音葛"}
{"id": null, "n": null, "target": null, "type": null, "text": "于求切"}
{"id": null, "n": null, "target": null, "type": null, "text": "轄覺切音學"}
{"id": null, "n": null, "target": null, "type": null, "text": "上於盖切音愛下似嗟切音邪聲也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上彌列切音滅下母總切蒙上聲蠛蠓小飛󲈀"}
{"id": null, "n": null, "target": null, "type": null, "text": "下"}
{"id": null, "n": null, "target": null, "type": null, "text": "落蓋切音頼"}
{"id": null, "n": null, "target": null, "type": null, "text": "匹亦切"}
{"id": null, "n": null, "target": null, "type": null, "text": "魚音切音吟"}
{"id": null, "n": null, "target": null, "type": null, "text": "同都切"}
{"id": null, "n": null, "target": null, "type": null, "text": "徒紅切音同皷聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "古祿切音谷"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒲巴切音杷"}
{"id": null, "n": null, "target": null, "type": null, "text": "縈定切"}
{"id": null, "n": null, "target": null, "type": null, "text": "居肴切"}
{"id": null, "n": null, "target": null, "type": null, "text": "倪製切音𮒸割也"}
{"id": null, "n": null, "target": null, "type": null, "text": "典禮切音邸訶也"}
{"id": null, "n": null, "target": null, "type": null, "text": "呼宏\n切音轟薨薨羣飛聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒲平切音平"}
{"id": null, "n": null, "target": null, "type": null, "text": "弋灼切音藥"}
{"id": null, "n": null, "target": null, "type": null, "text": "𮗎刀切"}
{"id": null, "n": null, "target": null, "type": null, "text": "伊昔切音抑哽咽也"}
{"id": null, "n": null, "target": null, "type": null, "text": "所嫁切沙去聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "輸慎切音舜"}
{"id": null, "n": null, "target": null, "type": null, "text": "居月\n切"}
{"id": null, "n": null, "target": null, "type": null, "text": "而宜切輭平聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "彌鄰切音民石之美者"}
{"id": null, "n": null, "target": null, "type": null, "text": "上烏賄切\n音委下部比切皮上聲骩骳屈曲也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上紙切時上聲以舌取食物也"}
{"id": null, "n": null, "target": null, "type": null, "text": "之石切音職"}
{"id": null, "n": null, "target": null, "type": null, "text": "伊鳥切音杳"}
{"id": null, "n": null, "target": null, "type": null, "text": "神六切音孰"}
{"id": null, "n": null, "target": null, "type": null, "text": "林直切音力鳥\n似鳬而小"}
{"id": null, "n": null, "target": null, "type": null, "text": "徒協切甜入聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "老祖常住請題"}
{"id": null, "n": null, "target": null, "type": null, "text": "梅源德首座請"}
{"id": null, "n": null, "target": null, "type": null, "text": "超同請"}
{"id": null, "n": null, "target": null, "type": null, "text": "謨杯切音枚"}
{"id": null, "n": null, "target": null, "type": null, "text": "伯各切音愽"}
{"id": null, "n": null, "target": null, "type": null, "text": "渠為切音逵"}
{"id": null, "n": null, "target": null, "type": null, "text": "與舞同"}
{"id": null, "n": null, "target": null, "type": null, "text": "規雲切音均鹿屬"}
{"id": null, "n": null, "target": null, "type": null, "text": "徒協切音叠"}
{"id": null, "n": null, "target": null, "type": null, "text": "七接切音妾"}
{"id": null, "n": null, "target": null, "type": null, "text": "鋤林\n切音岑"}
{"id": null, "n": null, "target": null, "type": null, "text": "符咸切音凡渢渢中庸之聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "古咸切音兼"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X11n0270_p0804b16"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X68n1319_p0551c15"}
