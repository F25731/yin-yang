{"id": null, "n": null, "target": null, "type": null, "text": "或三十卷三帙"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名大品般若經或三十卷四\n帙"}
{"id": null, "n": null, "target": null, "type": null, "text": "或十五卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "龍樹菩薩造智度論釋大品經"}
{"id": null, "n": null, "target": null, "type": null, "text": "一名須菩提品亦名長安品"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名般若道行品或八卷一帙"}
{"id": null, "n": null, "target": null, "type": null, "text": "或七卷或八卷一帙"}
{"id": null, "n": null, "target": null, "type": null, "text": "第一譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "第二譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "一名决了諸法如幻\n化三昧經"}
{"id": null, "n": null, "target": null, "type": null, "text": "第一譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "第二譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "第三譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "第四譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "第五譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "三師造論同釋此經"}
{"id": null, "n": null, "target": null, "type": null, "text": "或一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "出經題第一譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "第二譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "仁王般若等三經大\n義雖通大部全本大部中無是支𣲖攝非從彼出"}
{"id": null, "n": null, "target": null, "type": null, "text": "出三藏法師傳"}
