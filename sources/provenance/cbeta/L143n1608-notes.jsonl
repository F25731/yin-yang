{"id": null, "n": null, "target": null, "type": null, "text": "八至十"}
{"id": null, "n": null, "target": null, "type": null, "text": "十一"}
{"id": null, "n": null, "target": null, "type": null, "text": "解在發字號"}
{"id": null, "n": null, "target": null, "type": null, "text": "十二至十九"}
{"id": null, "n": null, "target": null, "type": null, "text": "二十"}
{"id": null, "n": null, "target": null, "type": null, "text": "二十二至二十四"}
{"id": null, "n": null, "target": null, "type": null, "text": "二十五至二十六"}
{"id": null, "n": null, "target": null, "type": null, "text": "二十七至三十"}
{"id": null, "n": null, "target": null, "type": null, "text": "日密分文中稍略此中稍廣"}
{"id": null, "n": null, "target": null, "type": null, "text": "此後不開卷數者並是一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "前後七譯四譯本闕"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉曰無盡意"}
{"id": null, "n": null, "target": null, "type": null, "text": "卷初至第五卷半"}
{"id": null, "n": null, "target": null, "type": null, "text": "出第五卷半後至第七卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上清涼䟽"}
{"id": null, "n": null, "target": null, "type": null, "text": "新經在第十六卷略\n無偈"}
{"id": null, "n": null, "target": null, "type": null, "text": "天親菩薩造釋論二十二\n卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "此羅摩伽經比於本品文闕不\n同於其中間譯出少分爾"}
{"id": null, "n": null, "target": null, "type": null, "text": "或有經本續入大部之中在第五十\n七卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "出涅槃後分"}
{"id": null, "n": null, "target": null, "type": null, "text": "出靈感傳"}
{"id": null, "n": null, "target": null, "type": null, "text": "莫班切"}
{"id": null, "n": null, "target": null, "type": null, "text": "輸閏切"}
{"id": null, "n": null, "target": null, "type": null, "text": "鋪杯切未燒瓦器也"}
{"id": null, "n": null, "target": null, "type": null, "text": "莫耕切目不明也"}
{"id": null, "n": null, "target": null, "type": null, "text": "古玩切澡于也"}
{"id": null, "n": null, "target": null, "type": null, "text": "楚讚切"}
{"id": null, "n": null, "target": null, "type": null, "text": "徒含切甒屬甒音武"}
{"id": null, "n": null, "target": null, "type": null, "text": "生肇融𠮉四法師注解天台智者略䟽十卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "華嚴十地品第二同"}
{"id": null, "n": null, "target": null, "type": null, "text": "苦吉切"}
{"id": null, "n": null, "target": null, "type": null, "text": "瘖於金切瘂烏下切瘖瘂疾不能言也"}
{"id": null, "n": null, "target": null, "type": null, "text": "陟𤓰切擊\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "巨偃切戶鑰也"}
{"id": null, "n": null, "target": null, "type": null, "text": "失冉切"}
{"id": null, "n": null, "target": null, "type": null, "text": "第三卷末"}
{"id": null, "n": null, "target": null, "type": null, "text": "杜行顗等譯三十五句"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛陀波利譯三十四句"}
{"id": null, "n": null, "target": null, "type": null, "text": "三藏地婆訶羅譯三十六\n句"}
{"id": null, "n": null, "target": null, "type": null, "text": "四十八句"}
{"id": null, "n": null, "target": null, "type": null, "text": "與寶積經第二十七善順菩薩會同本異譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "一名佛升忉利天為母說法經"}
{"id": null, "n": null, "target": null, "type": null, "text": "第九卷說中陰生滅甚詳"}
{"id": null, "n": null, "target": null, "type": null, "text": "第六卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "第三卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "第五卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "抗苦浪切拒其吕切抗拒抵禦也"}
{"id": null, "n": null, "target": null, "type": null, "text": "苦洽切爪刺也"}
{"id": null, "n": null, "target": null, "type": null, "text": "施隻切蟲\n行毒也"}
{"id": null, "n": null, "target": null, "type": null, "text": "魚豈切"}
{"id": null, "n": null, "target": null, "type": null, "text": "昨宗切"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃代切"}
{"id": null, "n": null, "target": null, "type": null, "text": "果五切毒也"}
{"id": null, "n": null, "target": null, "type": null, "text": "出地持戒品中慈氏菩薩說"}
{"id": null, "n": null, "target": null, "type": null, "text": "出瑜伽論本地分中彌勒菩薩說"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡對切與繪同𦘚也"}
{"id": null, "n": null, "target": null, "type": null, "text": "與專切黑錫也"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒲撥切"}
{"id": null, "n": null, "target": null, "type": null, "text": "尋謂尋求伺謂\n伺察或思或慧於境推求麤外名尋即以二種於境審細位名伺舊名覺觀出諸經\n音義"}
{"id": null, "n": null, "target": null, "type": null, "text": "出肇法師序"}
{"id": null, "n": null, "target": null, "type": null, "text": "出寶唱錄云"}
{"id": null, "n": null, "target": null, "type": null, "text": "出四分律第五十四"}
{"id": null, "n": null, "target": null, "type": null, "text": "出五分律第三十"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛般泥洹下諸經並是四含中別經異譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上三經出長阿含經第十八至二十二卷與記世經同\n本異譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "從佛般泥洹下十三經並出長\n阿含中別經異譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉言依次"}
{"id": null, "n": null, "target": null, "type": null, "text": "錯七各切綜子宋切"}
{"id": null, "n": null, "target": null, "type": null, "text": "房吻切懣也"}
{"id": null, "n": null, "target": null, "type": null, "text": "去魚切開散也"}
{"id": null, "n": null, "target": null, "type": null, "text": "陟駕\n切"}
{"id": null, "n": null, "target": null, "type": null, "text": "必刃切斥也"}
{"id": null, "n": null, "target": null, "type": null, "text": "出說一切有部毗柰耶雜事第三十\n九卷同本"}
