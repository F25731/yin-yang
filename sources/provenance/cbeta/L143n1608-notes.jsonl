{"id": null, "n": null, "target": null, "type": null, "text": "第十一譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "第二譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "第四十一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "四十七"}
{"id": null, "n": null, "target": null, "type": null, "text": "四十八"}
{"id": null, "n": null, "target": null, "type": null, "text": "此入胎藏會本名佛為難陀說出家入胎經在根本說一切有部毗柰耶雜事第十\n一十二卷三藏義淨析出別行"}
{"id": null, "n": null, "target": null, "type": null, "text": "七十三至七十六"}
{"id": null, "n": null, "target": null, "type": null, "text": "新說三經互為廣略"}
{"id": null, "n": null, "target": null, "type": null, "text": "兼後一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "與前同卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "佚弋質切安佚不勞也"}
{"id": null, "n": null, "target": null, "type": null, "text": "雛綰切造也"}
{"id": null, "n": null, "target": null, "type": null, "text": "於力切胷臆也"}
{"id": null, "n": null, "target": null, "type": null, "text": "翾正切遠也"}
{"id": null, "n": null, "target": null, "type": null, "text": "渠立切負書箱也"}
{"id": null, "n": null, "target": null, "type": null, "text": "古活切包括也"}
{"id": null, "n": null, "target": null, "type": null, "text": "居六切兩手捧\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "力幺切明也"}
{"id": null, "n": null, "target": null, "type": null, "text": "直陵切戒也"}
{"id": null, "n": null, "target": null, "type": null, "text": "士革切深也"}
{"id": null, "n": null, "target": null, "type": null, "text": "赤脂切醜\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即涉切舟櫂也"}
{"id": null, "n": null, "target": null, "type": null, "text": "丁鄧切陛級也道也"}
{"id": null, "n": null, "target": null, "type": null, "text": "莫侯切勾兵也"}
{"id": null, "n": null, "target": null, "type": null, "text": "祖稽\n切碎也"}
{"id": null, "n": null, "target": null, "type": null, "text": "徒含切及也"}
{"id": null, "n": null, "target": null, "type": null, "text": "都寒切極盡也"}
{"id": null, "n": null, "target": null, "type": null, "text": "古岳切校也"}
{"id": null, "n": null, "target": null, "type": null, "text": "七羊\n切矟也"}
{"id": null, "n": null, "target": null, "type": null, "text": "與前同卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "兼後三卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "兼後三會同卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "此八\n法會有釋論五卷其要慧經文少略耳"}
{"id": null, "n": null, "target": null, "type": null, "text": "此舊寶積經有釋論四卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "兼後二卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "此寶髻會有釋論一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "兩卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云郁伽長者經或二卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云仁賢幻士經"}
{"id": null, "n": null, "target": null, "type": null, "text": "一名破壞一切心識"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦直云須摩經"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云無垢女經一名論義辯才法門"}
{"id": null, "n": null, "target": null, "type": null, "text": "第一譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "第二唐譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名遺日說般若經"}
{"id": null, "n": null, "target": null, "type": null, "text": "一名大迦葉品"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦直云勝\n鬘經"}
