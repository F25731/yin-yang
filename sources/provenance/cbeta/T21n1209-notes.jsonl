{"id": null, "n": "0041013", "target": null, "type": "orig", "text": "甲本奧書曰延久六年三月十八日書了高野末葉金剛弟子淨秀本也，乙本奧書曰時貞享四年盂春三十日一校了淨嚴四十九，元祿十六年正月十九日以淨嚴和上之本再校了尊教，寶永五年十月八日一校了性寂"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": "0039001", "target": "#nkr_note_mod_0039001", "type": "mod", "text": "金【大】，降三世金【甲】，【原】麗本，【甲】延久六年寫高山寺藏本，【乙】黃檗版淨嚴等加筆本，【丙】東寺三密藏古寫本"}
{"id": null, "n": "0039002", "target": "#nkr_note_mod_0039002", "type": "mod", "text": "頂【大】，〔－〕【甲】"}
{"id": null, "n": "0039003", "target": "#nkr_note_mod_0039003", "type": "mod", "text": "降三世【大】，〔－〕【甲】"}
{"id": null, "n": "0039004", "target": "#nkr_note_mod_0039004", "type": "mod", "text": "門【大】，門法【甲】"}
{"id": null, "n": "0039005", "target": "#nkr_note_mod_0039005", "type": "mod", "text": "一卷【大】，〔－〕【明】【甲】【乙】"}
{"id": null, "n": "0039006", "target": "#nkr_note_mod_0039006", "type": "mod", "text": "（開府…空）四十三字【大】，唐特進試鴻臚卿大廣智不空三藏與淨行婆羅門遍智奉詔譯【明】【乙】【丙】，遍智阿闍梨指授【甲】"}
{"id": null, "n": "0039007", "target": "#nkr_note_mod_0039007", "type": "mod", "text": "囉【大】，羅【甲】【丙】"}
{"id": null, "n": "0039008", "target": "#nkr_note_mod_0039008", "type": "mod", "text": "摧【大】，推【明】"}
{"id": null, "n": "0039009", "target": "#nkr_note_mod_0039009", "type": "mod", "text": "王【大】，主【明】【乙】【丙】"}
{"id": null, "n": "0039010", "target": "#nkr_note_mod_0039010", "type": "mod", "text": "合【大】，令【校異-丙】"}
{"id": null, "n": "0039011", "target": "#nkr_note_mod_0039011", "type": "mod", "text": "訶【大】，賀引【甲】【丙】"}
{"id": null, "n": "0039012", "target": "#nkr_note_mod_0039012", "type": "mod", "text": "嚩【大】，舞【校異-丙】"}
{"id": null, "n": "0039013", "target": "#nkr_note_mod_0039013", "type": "mod", "text": "二合無保反【大】，無保切二合【明】【乙】【丙】"}
{"id": null, "n": "0039014", "target": "#nkr_note_mod_0039014", "type": "mod", "text": "無保反【大】，〔－〕【甲】"}
{"id": null, "n": "0039015", "target": "#nkr_note_mod_0039015", "type": "mod", "text": "唅【大】，憾【甲】【丙】"}
{"id": null, "n": "0039016", "target": "#nkr_note_mod_0039016", "type": "mod", "text": "成【大】，或【甲】【丙】"}
{"id": null, "n": "0039017", "target": "#nkr_note_mod_0039017", "type": "mod", "text": "已【大】，以【明】【乙】"}
{"id": null, "n": "0039018", "target": "#nkr_note_mod_0039018", "type": "mod", "text": "又【大】，及【明】【乙】"}
{"id": null, "n": "0039019", "target": "#nkr_note_mod_0039019", "type": "mod", "text": "本【大】，大【丙】"}
{"id": null, "n": "0039020", "target": "#nkr_note_mod_0039020", "type": "mod", "text": "四印【大】，印四【甲】"}
{"id": null, "n": "0039021", "target": "#nkr_note_mod_0039021", "type": "mod", "text": "囉【大】，羅【明】【甲】【乙】【丙】"}
{"id": null, "n": "0039022", "target": "#nkr_note_mod_0039022", "type": "mod", "text": "吽【大】＊，唵吽短【明】【丙】＊"}
{"id": null, "n": "0039023", "target": "#nkr_note_mod_0039023", "type": "mod", "text": "𮧬【大】＊，嚩【甲】【丙】＊"}
{"id": null, "n": "0039024", "target": "#nkr_note_mod_0039024", "type": "mod", "text": "惹【大】，入【丙】"}
{"id": null, "n": "0039025", "target": "#nkr_note_mod_0039025", "type": "mod", "text": "合【大】＊，合引【甲】【丙】＊"}
{"id": null, "n": "0039026", "target": "#nkr_note_mod_0039026", "type": "mod", "text": "羅【大】，羅引【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0039027", "target": "#nkr_note_mod_0039027", "type": "mod", "text": "麼【大】，麼引【甲】【丙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0039028", "target": "#nkr_note_mod_0039028", "type": "mod", "text": "拘【大】，阿【明】，句【丙】"}
{"id": null, "n": "0039029", "target": "#nkr_note_mod_0039029", "type": "mod", "text": "吽【大】，吽引【甲】【丙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0039030", "target": "#nkr_note_mod_0039030", "type": "mod", "text": "半聲【大】，〔－〕【甲】【丙】"}
{"id": null, "n": "0039031", "target": "#nkr_note_mod_0039031", "type": "mod", "text": "咤【大】，吒【明】，姹【甲】【丙】"}
{"id": null, "n": "0039032", "target": "#nkr_note_mod_0039032", "type": "mod", "text": "餘准此【大】，〔－〕【明】【甲】【乙】"}
{"id": null, "n": "0040001", "target": "#nkr_note_mod_0040001", "type": "mod", "text": "嚩【大】，縛【明】【乙】"}
{"id": null, "n": "0040002", "target": "#nkr_note_mod_0040002", "type": "mod", "text": "攞【大】，〔－〕【明】【丙】，攞始【甲】"}
{"id": null, "n": "0040003", "target": "#nkr_note_mod_0040003", "type": "mod", "text": "合【大】，合棯【甲】"}
{"id": null, "n": "0040004", "target": "#nkr_note_mod_0040004", "type": "mod", "text": "多【大】，哆【甲】"}
{"id": null, "n": "0040005", "target": "#nkr_note_mod_0040005", "type": "mod", "text": "羯【大】，迦哩【甲】，迦羅【丙】"}
{"id": null, "n": "0040006", "target": "#nkr_note_mod_0040006", "type": "mod", "text": "灑【大】，灑二合【甲】【丙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0040007", "target": "#nkr_note_mod_0040007", "type": "mod", "text": "也【大】，野【甲】【丙】"}
{"id": null, "n": "0040008", "target": "#nkr_note_mod_0040008", "type": "mod", "text": "他【大】，他去引【甲】【丙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "去引"}
{"id": null, "n": "0040009", "target": "#nkr_note_mod_0040009", "type": "mod", "text": "蘖【大】，誐【甲】【丙】"}
{"id": null, "n": "0040010", "target": "#nkr_note_mod_0040010", "type": "mod", "text": "摩【大】，麼【明】，怛麼二合【甲】"}
{"id": null, "n": "0040011", "target": "#nkr_note_mod_0040011", "type": "mod", "text": "賀【大】，〔－〕【甲】"}
{"id": null, "n": "0040012", "target": "#nkr_note_mod_0040012", "type": "mod", "text": "三【大】，三去【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "去"}
{"id": null, "n": "0040013", "target": "#nkr_note_mod_0040013", "type": "mod", "text": "麼【大】，摩【甲】"}
{"id": null, "n": "0040014", "target": "#nkr_note_mod_0040014", "type": "mod", "text": "耶【大】，野【甲】【丙】"}
{"id": null, "n": "0040015", "target": "#nkr_note_mod_0040015", "type": "mod", "text": "吽【大】，吽引【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0040016", "target": "#nkr_note_mod_0040016", "type": "mod", "text": "哩【大】，羅【甲】【丙】"}
{"id": null, "n": "0040017", "target": "#nkr_note_mod_0040017", "type": "mod", "text": "惹【大】，入【甲】【丙】"}
{"id": null, "n": "0040018", "target": "#nkr_note_mod_0040018", "type": "mod", "text": "邏末羅拘【大】，囉引麼囉引句【甲】【丙】"}
{"id": null, "n": "0040019", "target": "#nkr_note_mod_0040019", "type": "mod", "text": "引【大】，〔－〕【甲】【丙】"}
{"id": null, "n": "0040020", "target": "#nkr_note_mod_0040020", "type": "mod", "text": "半音【大】，〔－〕【甲】"}
{"id": null, "n": "0040021", "target": "#nkr_note_mod_0040021", "type": "mod", "text": "去【大】＊，去聲【明】【乙】＊"}
{"id": null, "n": "0040022", "target": "#nkr_note_mod_0040022", "type": "mod", "text": "餘三准此【大】，〔－〕【明】【甲】"}
{"id": null, "n": "0040023", "target": "#nkr_note_mod_0040023", "type": "mod", "text": "莽㘑儞【大】，摩引隸涅【甲】【丙】"}
{"id": null, "n": "0040024", "target": "#nkr_note_mod_0040024", "type": "mod", "text": "茶【大】＊，荼【明】【甲】【乙】＊"}
{"id": null, "n": "0040025", "target": "#nkr_note_mod_0040025", "type": "mod", "text": "被甲誦此明【大】，被甲誦此明【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "被甲誦此明"}
{"id": null, "n": "0040026", "target": "#nkr_note_mod_0040026", "type": "mod", "text": "𠸪乞叉【大】，摩引隸羅乞灑【甲】"}
{"id": null, "n": "0040027", "target": "#nkr_note_mod_0040027", "type": "mod", "text": "三【大】，二【明】【甲】【乙】"}
{"id": null, "n": "0040028", "target": "#nkr_note_mod_0040028", "type": "mod", "text": "儞【大】，涅【甲】"}
{"id": null, "n": "0040029", "target": "#nkr_note_mod_0040029", "type": "mod", "text": "去【大】，去聲【明】【乙】，〔－〕【甲】"}
{"id": null, "n": "0040030", "target": "#nkr_note_mod_0040030", "type": "mod", "text": "唯【大】，惟【明】【乙】"}
{"id": null, "n": "0040031", "target": "#nkr_note_mod_0040031", "type": "mod", "text": "叱【大】，吒【明】【乙】"}
{"id": null, "n": "0040032", "target": "#nkr_note_mod_0040032", "type": "mod", "text": "𠻴【大】，朗【甲】【丙】"}
