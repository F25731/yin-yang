{"id": null, "n": "1403001", "target": "#nkr_note_mod_1403001", "type": "mod", "text": "【原】大英博物館藏燉煌本, S. 2084, 【甲】大英博物館藏燉煌本, S. 1907, 【乙】中村不折氏藏本，乙本首缺（CBETA 按：大正藏原校讎注「大英博物館藏燉煌本, S. 2034」、「大英博物館藏燉煌本, S. 190」。據學者研究（新井慧誉〈敦煌本『父母恩重経』について〉《印度學佛教學研究》第五十巻第二号（2002），第153頁、157頁注4），應正為「大英博物館藏燉煌本, S. 2084」、「大英博物館藏燉煌本, S. 1907」。）"}
{"id": null, "n": "1403002", "target": "#nkr_note_mod_1403002", "type": "mod", "text": "聲【大】，聲聞【甲】"}
{"id": null, "n": "1403003", "target": "#nkr_note_mod_1403003", "type": "mod", "text": "何【大】，何可報【甲】"}
{"id": null, "n": "1403005", "target": "#nkr_note_mod_1403005", "type": "mod", "text": "恩【大】，〔－〕【乙】"}
{"id": null, "n": "1403006", "target": "#nkr_note_mod_1403006", "type": "mod", "text": "復【大】，復過此【甲】，復過【乙】"}
{"id": null, "n": "1403007", "target": "#nkr_note_mod_1403007", "type": "mod", "text": "其【大】，家【甲】，〔－〕【乙】"}
{"id": null, "n": "1403008", "target": "#nkr_note_mod_1403008", "type": "mod", "text": "必有【大】，又必【甲】，又有【乙】"}
{"id": null, "n": "1403009", "target": "#nkr_note_mod_1403009", "type": "mod", "text": "懷【大】，憍【甲】【乙】"}
{"id": null, "n": "1404001", "target": "#nkr_note_mod_1404001", "type": "mod", "text": "惑【大】，或【甲】"}
{"id": null, "n": "1404002", "target": "#nkr_note_mod_1404002", "type": "mod", "text": "寡【大】，置【甲】"}
{"id": null, "n": "1404003", "target": "#nkr_note_mod_1404003", "type": "mod", "text": "呼【大】，吁【甲】【乙】"}
{"id": null, "n": "1404004", "target": "#nkr_note_mod_1404004", "type": "mod", "text": "得【大】，〔－〕【乙】"}
{"id": null, "n": "1404005", "target": "#nkr_note_mod_1404005", "type": "mod", "text": "重【大】，〔－〕【甲】"}
{"id": null, "n": "1404006", "target": "#nkr_note_mod_1404006", "type": "mod", "text": "佛說【大】，〔－〕【甲】"}
{"id": null, "n": "1404007", "target": "#nkr_note_mod_1404007", "type": "mod", "text": "經【大】，經一卷【乙】"}
{"id": null, "n": "1403001", "target": "#nkr_note_orig_1403001", "type": "orig", "text": "【原】大英博物館藏燉煌本, S. 2034, 【甲】大英博物館藏燉煌本, S. 190, 【乙】中村不折氏藏本，乙本首缺"}
{"id": null, "n": "1403002", "target": "#nkr_note_orig_1403002", "type": "orig", "text": "聲＋（聞）【甲】"}
{"id": null, "n": "1403003", "target": "#nkr_note_orig_1403003", "type": "orig", "text": "何＋（可報）【甲】"}
{"id": null, "n": "1403004", "target": "#nkr_note_orig_1403004", "type": "orig", "text": "以上乙本缺"}
{"id": null, "n": "1403005", "target": "#nkr_note_orig_1403005", "type": "orig", "text": "〔恩〕－【乙】"}
{"id": null, "n": "1403006", "target": "#nkr_note_orig_1403006", "type": "orig", "text": "復＋（過此）【甲】，（過）【乙】"}
{"id": null, "n": "1403007", "target": "#nkr_note_orig_1403007", "type": "orig", "text": "其＝家【甲】，〔其〕－【乙】"}
{"id": null, "n": "1403008", "target": "#nkr_note_orig_1403008", "type": "orig", "text": "必有＝又必【甲】，又有【乙】"}
{"id": null, "n": "1403009", "target": "#nkr_note_orig_1403009", "type": "orig", "text": "懷＝憍【甲】【乙】"}
{"id": null, "n": "1404001", "target": "#nkr_note_orig_1404001", "type": "orig", "text": "惑＝或【甲】"}
{"id": null, "n": "1404002", "target": "#nkr_note_orig_1404002", "type": "orig", "text": "寡＝置【甲】"}
{"id": null, "n": "1404003", "target": "#nkr_note_orig_1404003", "type": "orig", "text": "呼＝吁【甲】【乙】"}
{"id": null, "n": "1404004", "target": "#nkr_note_orig_1404004", "type": "orig", "text": "〔得〕－【乙】"}
{"id": null, "n": "1404005", "target": "#nkr_note_orig_1404005", "type": "orig", "text": "〔重〕－【甲】"}
{"id": null, "n": "1404006", "target": "#nkr_note_orig_1404006", "type": "orig", "text": "〔佛說〕－【甲】"}
{"id": null, "n": "1404007", "target": "#nkr_note_orig_1404007", "type": "orig", "text": "經＋（一卷）【乙】"}
