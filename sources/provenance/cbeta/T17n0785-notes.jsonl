{"id": null, "n": "0724052", "target": "#nkr_note_orig_0724052", "type": "orig", "text": "楞＝鈷【宋】【宮】，股【明】"}
{"id": null, "n": "0724053", "target": "#nkr_note_orig_0724053", "type": "orig", "text": "鬲＝高【三】【宮】"}
{"id": null, "n": "0724054", "target": "#nkr_note_orig_0724054", "type": "orig", "text": "輪迴＝迴輪【三】【宮】"}
{"id": null, "n": "0725001", "target": "#nkr_note_orig_0725001", "type": "orig", "text": "令＝念【三】【宮】"}
{"id": null, "n": "0725002", "target": "#nkr_note_orig_0725002", "type": "orig", "text": "楞＝鈷【元】，股【明】，樓【宮】"}
{"id": null, "n": "0725003", "target": "#nkr_note_orig_0725003", "type": "orig", "text": "善＋（聽受）【三】【宮】"}
{"id": null, "n": "0725004", "target": "#nkr_note_orig_0725004", "type": "orig", "text": "佛＋（言）【三】【宮】"}
{"id": null, "n": "0725005", "target": "#nkr_note_orig_0725005", "type": "orig", "text": "〔如是〕－【宮】"}
{"id": null, "n": "0725006", "target": "#nkr_note_orig_0725006", "type": "orig", "text": "四＝二【三】【宮】"}
{"id": null, "n": "0725007", "target": "#nkr_note_orig_0725007", "type": "orig", "text": "鈷＝股【明】＊"}
{"id": null, "n": "0725008", "target": "#nkr_note_orig_0725008", "type": "orig", "text": "二＝四【三】【宮】"}
{"id": null, "n": "0725009", "target": "#nkr_note_orig_0725009", "type": "orig", "text": "之所制立＝所制立也【三】【宮】"}
{"id": null, "n": "0725010", "target": "#nkr_note_orig_0725010", "type": "orig", "text": "〔以立其義〕－【宮】"}
{"id": null, "n": "0725011", "target": "#nkr_note_orig_0725011", "type": "orig", "text": "於此分經【元】【明】，得道梯隥錫杖經（經末題）【元】，佛說得道梯隥錫杖經（經末題）【明】，佛說持錫杖法（經首題）【元】，持錫杖法（經首題）【明】"}
{"id": null, "n": "0725012", "target": "#nkr_note_orig_0725012", "type": "orig", "text": "於此分經【元】【明】，得道梯隥錫杖經（經末題）【元】，佛說得道梯隥錫杖經（經末題）【明】，佛說持錫杖法（經首題）【元】，持錫杖法（經首題）【明】。凡體…正覺三百六十五字∞持錫…奉行三百五十五字【三】"}
{"id": null, "n": "0725013", "target": "#nkr_note_orig_0725013", "type": "orig", "text": "支＝枝【三】【宮】"}
{"id": null, "n": "0725014", "target": "#nkr_note_orig_0725014", "type": "orig", "text": "包＝苞【宮】"}
{"id": null, "n": "0725015", "target": "#nkr_note_orig_0725015", "type": "orig", "text": "慈＋（心）【三】【宮】"}
{"id": null, "n": "0725016", "target": "#nkr_note_orig_0725016", "type": "orig", "text": "物＝勿【三】【宮】"}
{"id": null, "n": "0725017", "target": "#nkr_note_orig_0725017", "type": "orig", "text": "此杖法＝杖法此【三】【宮】"}
{"id": null, "n": "0725018", "target": "#nkr_note_orig_0725018", "type": "orig", "text": "挾＝俠【宋】【元】【宮】"}
{"id": null, "n": "0725019", "target": "#nkr_note_orig_0725019", "type": "orig", "text": "句＝拘【三】【宮】"}
{"id": null, "n": "0725020", "target": "#nkr_note_orig_0725020", "type": "orig", "text": "〔其聲〕－【三】【宮】"}
{"id": null, "n": "0725021", "target": "#nkr_note_orig_0725021", "type": "orig", "text": "使＝令【三】【宮】"}
{"id": null, "n": "0725022", "target": "#nkr_note_orig_0725022", "type": "orig", "text": "置＝著【三】【宮】＊"}
{"id": null, "n": "0725023", "target": "#nkr_note_orig_0725023", "type": "orig", "text": "足＋（上）【三】【宮】"}
{"id": null, "n": "0725024", "target": "#nkr_note_orig_0725024", "type": "orig", "text": "〔不〕－【三】【宮】"}
{"id": null, "n": "0725025", "target": "#nkr_note_orig_0725025", "type": "orig", "text": "就地平處一＝平處【三】【宮】"}
{"id": null, "n": "0725026", "target": "#nkr_note_orig_0725026", "type": "orig", "text": "〔一〕－【宮】"}
{"id": null, "n": "0725027", "target": "#nkr_note_orig_0725027", "type": "orig", "text": "〔安〕－【三】【宮】"}
{"id": null, "n": "0725028", "target": "#nkr_note_orig_0725028", "type": "orig", "text": "身＋（亦護）【三】【宮】"}
{"id": null, "n": "0725029", "target": "#nkr_note_orig_0725029", "type": "orig", "text": "順＝慎【三】【宮】"}
{"id": null, "n": "0725030", "target": "#nkr_note_orig_0725030", "type": "orig", "text": "利＋（矣）【三】【宮】"}
{"id": null, "n": "0725031", "target": "#nkr_note_orig_0725031", "type": "orig", "text": "〔如〕－【三】【宮】"}
{"id": null, "n": "0725032", "target": "#nkr_note_orig_0725032", "type": "orig", "text": "〔出〕－【三】【宮】"}
{"id": null, "n": "0725033", "target": "#nkr_note_orig_0725033", "type": "orig", "text": "凡體…正覺三百六十五字∞持錫…奉行三百五十五字【三】，〔持錫…奉行〕三百五十五字－【宮】"}
{"id": null, "n": "0725034", "target": "#nkr_note_orig_0725034", "type": "orig", "text": "〔上〕－【三】"}
{"id": null, "n": "0725035", "target": "#nkr_note_orig_0725035", "type": "orig", "text": "杖過中不＝不得持杖過中【三】"}
{"id": null, "n": "0725036", "target": "#nkr_note_orig_0725036", "type": "orig", "text": "惺𥧝＝醒悟【元】【明】，𥨕𥧝【宋】"}
{"id": null, "n": "0725037", "target": "#nkr_note_orig_0725037", "type": "orig", "text": "〔得道梯橙錫杖經〕－【元】【明】，〔得道梯橙〕－【宮】"}
{"id": null, "n": "0725038", "target": "#nkr_note_orig_0725038", "type": "orig", "text": "又持錫杖法麗本宋本宮本無今依明本採錄與元本對挍，又＝佛說【元】"}
{"id": null, "n": "0726001", "target": "#nkr_note_orig_0726001", "type": "orig", "text": "〔持錫杖法〕－【元】"}
{"id": null, "n": "0725038", "target": "#nkr_note_rest_0725038", "type": "rest", "text": "又持錫杖法麗本宋本宮本無今依明本採錄與元本對挍"}
