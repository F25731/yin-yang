{"id": null, "n": null, "target": null, "type": null, "text": "依天竺藏經重出，使後人看閱，知其源流也"}
{"id": null, "n": "0724010", "target": null, "type": "orig", "text": "橙＝隥【三】"}
{"id": null, "n": "0724010", "target": null, "type": "mod", "text": "橙【大】，隥【宋】【元】【明】"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K19n0793_p0906c20"}
{"id": null, "n": "0725026", "target": null, "type": "orig", "text": "〔一〕－【宮】"}
{"id": null, "n": "0725026", "target": null, "type": "mod", "text": "一【大】，〔－〕【宮】"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K19n0793_p0907c22"}
{"id": null, "n": "0724009", "target": "#nkr_note_mod_0724009", "type": "mod", "text": "得道梯橙【大】，〔－〕【宮】，佛說得道梯橙【明】"}
{"id": null, "n": "0724010", "target": "#nkr_note_mod_0724010", "type": "mod", "text": "橙【大】，隥【宋】【元】【明】"}
{"id": null, "n": "0724011", "target": "#nkr_note_mod_0724011", "type": "mod", "text": "人名【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0724012", "target": "#nkr_note_mod_0724012", "type": "mod", "text": "是【大】，持錫【宋】【元】【明】【宮】"}
{"id": null, "n": "0724013", "target": "#nkr_note_mod_0724013", "type": "mod", "text": "執【大】＊，執持【宮】＊"}
{"id": null, "n": "0724014", "target": "#nkr_note_mod_0724014", "type": "mod", "text": "名【大】，故曰【宋】【元】【明】【宮】"}
{"id": null, "n": "0724015", "target": "#nkr_note_mod_0724015", "type": "mod", "text": "式【大】＊，幟【元】【明】＊"}
{"id": null, "n": "0724016", "target": "#nkr_note_mod_0724016", "type": "mod", "text": "䠒【大】，胡【明】"}
{"id": null, "n": "0724017", "target": "#nkr_note_mod_0724017", "type": "mod", "text": "敷【大】，開【宋】【元】【明】【宮】"}
{"id": null, "n": "0724018", "target": "#nkr_note_mod_0724018", "type": "mod", "text": "等奉【大】，一一【宋】【元】【明】【宮】"}
{"id": null, "n": "0724019", "target": "#nkr_note_mod_0724019", "type": "mod", "text": "思【大】，思念【宋】【元】【明】【宮】"}
{"id": null, "n": "0724020", "target": "#nkr_note_mod_0724020", "type": "mod", "text": "汝說【大】，說之【宋】【元】【明】【宮】"}
{"id": null, "n": "0724021", "target": "#nkr_note_mod_0724021", "type": "mod", "text": "有【大】，界【宋】【元】【明】【宮】"}
{"id": null, "n": "0724022", "target": "#nkr_note_mod_0724022", "type": "mod", "text": "惺【大】＊，醒【元】【明】＊"}
{"id": null, "n": "0724023", "target": "#nkr_note_mod_0724023", "type": "mod", "text": "𡩺【大】，悟【元】【明】"}
{"id": null, "n": "0724024", "target": "#nkr_note_mod_0724024", "type": "mod", "text": "除斷【大】，斷除煩惱【宋】【元】【明】【宮】"}
{"id": null, "n": "0724025", "target": "#nkr_note_mod_0724025", "type": "mod", "text": "此【大】＊，是【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0724026", "target": "#nkr_note_mod_0724026", "type": "mod", "text": "諸陰【大】，五陰【宋】【元】【明】，諸五陰【宮】"}
{"id": null, "n": "0724027", "target": "#nkr_note_mod_0724027", "type": "mod", "text": "遠【大】，〔－〕【宮】"}
{"id": null, "n": "0724028", "target": "#nkr_note_mod_0724028", "type": "mod", "text": "蓋【大】，苦【宮】"}
{"id": null, "n": "0724029", "target": "#nkr_note_mod_0724029", "type": "mod", "text": "有【大】，者【宋】【元】【明】【宮】"}
{"id": null, "n": "0724030", "target": "#nkr_note_mod_0724030", "type": "mod", "text": "悉具成就【大】，〔－〕【宮】"}
{"id": null, "n": "0724031", "target": "#nkr_note_mod_0724031", "type": "mod", "text": "且當【大】，當知【宋】【元】【明】"}
{"id": null, "n": "0724032", "target": "#nkr_note_mod_0724032", "type": "mod", "text": "佛【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0724033", "target": "#nkr_note_mod_0724033", "type": "mod", "text": "如是云何【大】，云何如是【宮】"}
{"id": null, "n": "0724034", "target": "#nkr_note_mod_0724034", "type": "mod", "text": "為敷演【大】，敷演說【宋】【元】【明】【宮】"}
{"id": null, "n": "0724035", "target": "#nkr_note_mod_0724035", "type": "mod", "text": "智【大】，知【宋】【元】【明】【宮】"}
{"id": null, "n": "0724036", "target": "#nkr_note_mod_0724036", "type": "mod", "text": "怠【大】，息【宮】"}
{"id": null, "n": "0724037", "target": "#nkr_note_mod_0724037", "type": "mod", "text": "救【大】，杖【宮】"}
{"id": null, "n": "0724038", "target": "#nkr_note_mod_0724038", "type": "mod", "text": "自身【大】，身自【宋】【元】【明】【宮】"}
{"id": null, "n": "0724039", "target": "#nkr_note_mod_0724039", "type": "mod", "text": "遨【大】，遊【宋】【元】【明】【宮】"}
{"id": null, "n": "0724040", "target": "#nkr_note_mod_0724040", "type": "mod", "text": "為【大】，曰【宋】【元】【明】【宮】"}
{"id": null, "n": "0724041", "target": "#nkr_note_mod_0724041", "type": "mod", "text": "定忍【大】，忍定【宋】【元】【明】【宮】"}
{"id": null, "n": "0724042", "target": "#nkr_note_mod_0724042", "type": "mod", "text": "式【大】，識【宋】【宮】，幟【元】【明】"}
{"id": null, "n": "0724043", "target": "#nkr_note_mod_0724043", "type": "mod", "text": "故【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0724044", "target": "#nkr_note_mod_0724044", "type": "mod", "text": "進【大】，精進【宋】【元】【明】【宮】"}
{"id": null, "n": "0724045", "target": "#nkr_note_mod_0724045", "type": "mod", "text": "心【大】，法【宋】【元】【明】【宮】"}
{"id": null, "n": "0724046", "target": "#nkr_note_mod_0724046", "type": "mod", "text": "鬲【大】＊，停【宋】，錞【元】【明】【宮】＊"}
{"id": null, "n": "0724047", "target": "#nkr_note_mod_0724047", "type": "mod", "text": "欲【大】，故【宮】"}
{"id": null, "n": "0724048", "target": "#nkr_note_mod_0724048", "type": "mod", "text": "三【大】，〔－〕【宮】"}
{"id": null, "n": "0724049", "target": "#nkr_note_mod_0724049", "type": "mod", "text": "脫【大】，脫也【宋】【元】【明】【宮】"}
{"id": null, "n": "0724050", "target": "#nkr_note_mod_0724050", "type": "mod", "text": "鈷【CB】【麗-CB】，鉆【大】，楞【宋】，股【明】"}
{"id": null, "n": "0724051", "target": "#nkr_note_mod_0724051", "type": "mod", "text": "四【大】，〔－〕【宮】"}
{"id": null, "n": "0724052", "target": "#nkr_note_mod_0724052", "type": "mod", "text": "楞【大】，鈷【宋】【宮】，股【明】"}
{"id": null, "n": "0724053", "target": "#nkr_note_mod_0724053", "type": "mod", "text": "鬲【大】，高【宋】【元】【明】【宮】"}
{"id": null, "n": "0724054", "target": "#nkr_note_mod_0724054", "type": "mod", "text": "輪迴【大】，迴輪【宋】【元】【明】【宮】"}
{"id": null, "n": "0725001", "target": "#nkr_note_mod_0725001", "type": "mod", "text": "令【大】，念【宋】【元】【明】【宮】"}
{"id": null, "n": "0725002", "target": "#nkr_note_mod_0725002", "type": "mod", "text": "楞【大】，鈷【元】，股【明】，樓【宮】"}
{"id": null, "n": "0725003", "target": "#nkr_note_mod_0725003", "type": "mod", "text": "善【大】，善聽受【宋】【元】【明】【宮】"}
{"id": null, "n": "0725004", "target": "#nkr_note_mod_0725004", "type": "mod", "text": "佛【大】，佛言【宋】【元】【明】【宮】"}
{"id": null, "n": "0725005", "target": "#nkr_note_mod_0725005", "type": "mod", "text": "如是【大】，〔－〕【宮】"}
{"id": null, "n": "0725006", "target": "#nkr_note_mod_0725006", "type": "mod", "text": "四【大】，二【宋】【元】【明】【宮】"}
{"id": null, "n": "0725007", "target": "#nkr_note_mod_0725007", "type": "mod", "text": "鈷【大】＊，股【明】＊"}
{"id": null, "n": "0725008", "target": "#nkr_note_mod_0725008", "type": "mod", "text": "二【大】，四【宋】【元】【明】【宮】"}
{"id": null, "n": "0725009", "target": "#nkr_note_mod_0725009", "type": "mod", "text": "之所制立【大】，所制立也【宋】【元】【明】【宮】"}
{"id": null, "n": "0725010", "target": "#nkr_note_mod_0725010", "type": "mod", "text": "以立其義【大】，〔－〕【宮】"}
{"id": null, "n": "0725011", "target": "#nkr_note_mod_0725011", "type": "mod", "text": "於此分經【元】【明】，得道梯隥錫杖經（經末題）【元】，佛說得道梯隥錫杖經（經末題）【明】，佛說持錫杖法（經首題）【元】，持錫杖法（經首題）【明】"}
{"id": null, "n": "0725012", "target": "#nkr_note_mod_0725012", "type": "mod", "text": "於此分經【元】【明】，得道梯隥錫杖經（經末題）【元】，佛說得道梯隥錫杖經（經末題）【明】，佛說持錫杖法（經首題）【元】，持錫杖法（經首題）【明】。凡體…正覺三百六十五字【大】∞持錫…奉行三百五十五字【宋】【元】【明】"}
{"id": null, "n": "0725013", "target": "#nkr_note_mod_0725013", "type": "mod", "text": "支【大】，枝【宋】【元】【明】【宮】"}
{"id": null, "n": "0725014", "target": "#nkr_note_mod_0725014", "type": "mod", "text": "包【大】，苞【宮】"}
{"id": null, "n": "0725015", "target": "#nkr_note_mod_0725015", "type": "mod", "text": "慈【大】，慈心【宋】【元】【明】【宮】"}
{"id": null, "n": "0725016", "target": "#nkr_note_mod_0725016", "type": "mod", "text": "物【大】，勿【宋】【元】【明】【宮】"}
{"id": null, "n": "0725017", "target": "#nkr_note_mod_0725017", "type": "mod", "text": "此杖法【大】，杖法此【宋】【元】【明】【宮】"}
{"id": null, "n": "0725018", "target": "#nkr_note_mod_0725018", "type": "mod", "text": "挾【大】＊，俠【宋】【元】【宮】＊"}
{"id": null, "n": "0725019", "target": "#nkr_note_mod_0725019", "type": "mod", "text": "句【大】，拘【宋】【元】【明】【宮】"}
{"id": null, "n": "0725020", "target": "#nkr_note_mod_0725020", "type": "mod", "text": "其聲【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0725021", "target": "#nkr_note_mod_0725021", "type": "mod", "text": "使【大】，令【宋】【元】【明】【宮】"}
{"id": null, "n": "0725022", "target": "#nkr_note_mod_0725022", "type": "mod", "text": "置【大】＊，著【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0725023", "target": "#nkr_note_mod_0725023", "type": "mod", "text": "足【大】，足上【宋】【元】【明】【宮】"}
{"id": null, "n": "0725024", "target": "#nkr_note_mod_0725024", "type": "mod", "text": "不【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0725025", "target": "#nkr_note_mod_0725025", "type": "mod", "text": "就地平處一【大】，平處【宋】【元】【明】【宮】"}
{"id": null, "n": "0725026", "target": "#nkr_note_mod_0725026", "type": "mod", "text": "一【大】，〔－〕【宮】"}
{"id": null, "n": "0725027", "target": "#nkr_note_mod_0725027", "type": "mod", "text": "安【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0725028", "target": "#nkr_note_mod_0725028", "type": "mod", "text": "身【大】，身亦護【宋】【元】【明】【宮】"}
{"id": null, "n": "0725029", "target": "#nkr_note_mod_0725029", "type": "mod", "text": "順【大】，慎【宋】【元】【明】【宮】"}
{"id": null, "n": "0725030", "target": "#nkr_note_mod_0725030", "type": "mod", "text": "利【大】，利矣【宋】【元】【明】【宮】"}
{"id": null, "n": "0725031", "target": "#nkr_note_mod_0725031", "type": "mod", "text": "如【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0725032", "target": "#nkr_note_mod_0725032", "type": "mod", "text": "出【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0725033", "target": "#nkr_note_mod_0725033", "type": "mod", "text": "凡體…正覺三百六十五字【大】∞持錫…奉行三百五十五字【宋】【元】【明】，〔持錫…奉行〕三百五十五字－【宮】"}
{"id": null, "n": "0725034", "target": "#nkr_note_mod_0725034", "type": "mod", "text": "上【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0725035", "target": "#nkr_note_mod_0725035", "type": "mod", "text": "杖過中不【大】，不得持杖過中【宋】【元】【明】"}
{"id": null, "n": "0725036", "target": "#nkr_note_mod_0725036", "type": "mod", "text": "惺𡩺【CB】【麗-CB】，惺𥧝【大】，醒悟【元】【明】，𥨕𥧝【宋】"}
{"id": null, "n": "0725037", "target": "#nkr_note_mod_0725037", "type": "mod", "text": "得道梯橙錫杖經【大】，〔－〕【元】【明】，錫杖經【宮】"}
{"id": null, "n": "0725038", "target": "#nkr_note_mod_0725038", "type": "mod", "text": "又【大】，佛說【元】，又持錫杖法麗本宋本宮本無今依明本採錄與元本對挍"}
{"id": null, "n": "0726001", "target": "#nkr_note_mod_0726001", "type": "mod", "text": "持錫杖法【大】，〔－〕【元】"}
{"id": null, "n": "0724009", "target": "#nkr_note_orig_0724009", "type": "orig", "text": "（佛說）＋得【明】，〔得道梯橙〕－【宮】"}
{"id": null, "n": "0724010", "target": "#nkr_note_orig_0724010", "type": "orig", "text": "橙＝隥【三】"}
{"id": null, "n": "0724011", "target": "#nkr_note_orig_0724011", "type": "orig", "text": "〔人名〕－【宋】【元】【宮】"}
{"id": null, "n": "0724012", "target": "#nkr_note_orig_0724012", "type": "orig", "text": "是＝持錫【三】【宮】"}
{"id": null, "n": "0724013", "target": "#nkr_note_orig_0724013", "type": "orig", "text": "執＋（持）【宮】＊"}
{"id": null, "n": "0724014", "target": "#nkr_note_orig_0724014", "type": "orig", "text": "名＝故曰【三】【宮】"}
{"id": null, "n": "0724015", "target": "#nkr_note_orig_0724015", "type": "orig", "text": "式＝幟【元】【明】＊"}
{"id": null, "n": "0724016", "target": "#nkr_note_orig_0724016", "type": "orig", "text": "䠒＝胡【明】"}
{"id": null, "n": "0724017", "target": "#nkr_note_orig_0724017", "type": "orig", "text": "敷＝開【三】【宮】"}
{"id": null, "n": "0724018", "target": "#nkr_note_orig_0724018", "type": "orig", "text": "等奉＝一一【三】【宮】"}
{"id": null, "n": "0724019", "target": "#nkr_note_orig_0724019", "type": "orig", "text": "思＋（念）【三】【宮】"}
{"id": null, "n": "0724020", "target": "#nkr_note_orig_0724020", "type": "orig", "text": "汝說＝說之【三】【宮】"}
{"id": null, "n": "0724021", "target": "#nkr_note_orig_0724021", "type": "orig", "text": "有＝界【三】【宮】"}
{"id": null, "n": "0724022", "target": "#nkr_note_orig_0724022", "type": "orig", "text": "惺＝醒【元】【明】＊"}
{"id": null, "n": "0724023", "target": "#nkr_note_orig_0724023", "type": "orig", "text": "𡩺＝悟【元】【明】"}
{"id": null, "n": "0724024", "target": "#nkr_note_orig_0724024", "type": "orig", "text": "除斷＝斷除煩惱【三】【宮】"}
{"id": null, "n": "0724025", "target": "#nkr_note_orig_0724025", "type": "orig", "text": "此＝是【三】【宮】＊"}
{"id": null, "n": "0724026", "target": "#nkr_note_orig_0724026", "type": "orig", "text": "諸陰＝五陰【三】，諸五陰【宮】"}
{"id": null, "n": "0724027", "target": "#nkr_note_orig_0724027", "type": "orig", "text": "〔遠〕－【宮】"}
{"id": null, "n": "0724028", "target": "#nkr_note_orig_0724028", "type": "orig", "text": "蓋＝苦【宮】"}
{"id": null, "n": "0724029", "target": "#nkr_note_orig_0724029", "type": "orig", "text": "有＝者【三】【宮】"}
{"id": null, "n": "0724030", "target": "#nkr_note_orig_0724030", "type": "orig", "text": "〔悉具成就〕－【宮】"}
{"id": null, "n": "0724031", "target": "#nkr_note_orig_0724031", "type": "orig", "text": "且當＝當知【三】"}
{"id": null, "n": "0724032", "target": "#nkr_note_orig_0724032", "type": "orig", "text": "〔佛〕－【三】【宮】"}
{"id": null, "n": "0724033", "target": "#nkr_note_orig_0724033", "type": "orig", "text": "如是云何＝云何如是【宮】"}
{"id": null, "n": "0724034", "target": "#nkr_note_orig_0724034", "type": "orig", "text": "為敷演＝敷演說【三】【宮】"}
{"id": null, "n": "0724035", "target": "#nkr_note_orig_0724035", "type": "orig", "text": "智＝知【三】【宮】"}
{"id": null, "n": "0724036", "target": "#nkr_note_orig_0724036", "type": "orig", "text": "怠＝息【宮】"}
{"id": null, "n": "0724037", "target": "#nkr_note_orig_0724037", "type": "orig", "text": "救＝杖【宮】"}
{"id": null, "n": "0724038", "target": "#nkr_note_orig_0724038", "type": "orig", "text": "自身＝身自【三】【宮】"}
{"id": null, "n": "0724039", "target": "#nkr_note_orig_0724039", "type": "orig", "text": "遨＝遊【三】【宮】"}
{"id": null, "n": "0724040", "target": "#nkr_note_orig_0724040", "type": "orig", "text": "為＝曰【三】【宮】"}
{"id": null, "n": "0724041", "target": "#nkr_note_orig_0724041", "type": "orig", "text": "定忍＝忍定【三】【宮】"}
{"id": null, "n": "0724042", "target": "#nkr_note_orig_0724042", "type": "orig", "text": "式＝識【宋】【宮】，幟【元】【明】"}
{"id": null, "n": "0724043", "target": "#nkr_note_orig_0724043", "type": "orig", "text": "〔故〕－【三】【宮】"}
{"id": null, "n": "0724044", "target": "#nkr_note_orig_0724044", "type": "orig", "text": "（精）＋進【三】【宮】"}
{"id": null, "n": "0724045", "target": "#nkr_note_orig_0724045", "type": "orig", "text": "心＝法【三】【宮】"}
{"id": null, "n": "0724046", "target": "#nkr_note_orig_0724046", "type": "orig", "text": "鬲＝停【宋】，錞【元】【明】【宮】＊"}
{"id": null, "n": "0724047", "target": "#nkr_note_orig_0724047", "type": "orig", "text": "欲＝故【宮】"}
{"id": null, "n": "0724048", "target": "#nkr_note_orig_0724048", "type": "orig", "text": "〔三〕－【宮】"}
{"id": null, "n": "0724049", "target": "#nkr_note_orig_0724049", "type": "orig", "text": "脫＋（也）【三】【宮】"}
{"id": null, "n": "0724050", "target": "#nkr_note_orig_0724050", "type": "orig", "text": "鉆＝楞【宋】，股【明】"}
