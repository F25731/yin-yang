{"id": null, "n": null, "target": null, "type": null, "text": "此中律儀文鈔《對法》，餘二戒文鈔《瑜伽》七十五卷。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此四是初禪天"}
{"id": null, "n": null, "target": null, "type": null, "text": "此四是二禪天"}
{"id": null, "n": null, "target": null, "type": null, "text": "此四是三禪天"}
{"id": null, "n": null, "target": null, "type": null, "text": "此六是四禪天"}
{"id": null, "n": null, "target": null, "type": null, "text": "如律所云人非人想"}
{"id": null, "n": null, "target": null, "type": null, "text": "非人人想"}
{"id": null, "n": null, "target": null, "type": null, "text": "人作人想"}
{"id": null, "n": null, "target": null, "type": null, "text": "非人非人想"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "之本"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "第二十八也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "是二十六也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "是二十七也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "之本"}
{"id": null, "n": null, "target": null, "type": null, "text": "之末"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦可名頭陀避難戒"}
{"id": null, "n": null, "target": null, "type": null, "text": "更詳彼文"}
{"id": null, "n": null, "target": null, "type": null, "text": "更詳本文"}
{"id": null, "n": null, "target": null, "type": null, "text": "之末終"}
{"id": null, "n": null, "target": null, "type": null, "text": "妙辨"}
