{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": null, "target": null, "type": null, "text": "耆那蜜多羅．"}
{"id": null, "n": null, "target": null, "type": null, "text": "尸棱特羅菩提．"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "B10n0065_p0493b05"}
{"id": null, "n": "0147001", "target": "#nkr_note_orig_0147001", "type": "orig", "text": "原文作 byan-chub-sems-dpah．係梵語菩提薩埵之意譯。"}
{"id": null, "n": "0147002", "target": "#nkr_note_orig_0147002", "type": "orig", "text": "原文作 bchon-ldan-hdas．係梵語薄伽梵之意譯。"}
{"id": null, "n": "0147003", "target": "#nkr_note_orig_0147003", "type": "orig", "text": "原文作 sans-rgyas．係梵語佛陀之意譯。"}
{"id": null, "n": "0147004", "target": "#nkr_note_orig_0147004", "type": "orig", "text": "原文句末俱有及字 dan．唐譯每句區別一者二者等．或係潤文所加。"}
{"id": null, "n": "0148005", "target": "#nkr_note_orig_0148005", "type": "orig", "text": "原文作 tshig．謂諸字所成．名語．唐譯作句。"}
{"id": null, "n": "0148006", "target": "#nkr_note_orig_0148006", "type": "orig", "text": "原文作 kun-gshi．為梵語阿賴耶意譯．意云一切依處．魏譯作家．今旁翻為藏。"}
{"id": null, "n": "0148007", "target": "#nkr_note_orig_0148007", "type": "orig", "text": "三性依原文翻應如此．舊譯大同．又參考內學第一輯一九〇、一九一頁。"}
{"id": null, "n": "0148008", "target": "#nkr_note_orig_0148008", "type": "orig", "text": "原文作 mya-nan-las-hdas．為梵語般湼槃之意譯。"}
{"id": null, "n": "0148009", "target": "#nkr_note_orig_0148009", "type": "orig", "text": "原文作 rnam-pa 意云種類．唐譯作行相．或行．或相．或種．極不一律。"}
{"id": null, "n": "0149010", "target": "#nkr_note_orig_0149010", "type": "orig", "text": "原文作 byan-chub 係梵語菩提之意譯。"}
{"id": null, "n": "0149011", "target": "#nkr_note_orig_0149011", "type": "orig", "text": "原文舉頌皆不標數．唐譯云二頌．或係潤文所加．以下例知。又原文譯頌有九韵一句者．有七韵一句者．今倣舊例．以七言或五言別之。"}
{"id": null, "n": "0149012", "target": "#nkr_note_orig_0149012", "type": "orig", "text": "原文作 bskal-pa 係梵語刧波之音譯．今省為刧。"}
{"id": null, "n": "0150013", "target": "#nkr_note_orig_0150013", "type": "orig", "text": "唐譯此下題所知依分第二．藏本無此分判。"}
{"id": null, "n": "0150014", "target": "#nkr_note_orig_0150014", "type": "orig", "text": "唐譯為諸法等．等是多數．非謂平等．舊解穿鑿。"}
{"id": null, "n": "0150015", "target": "#nkr_note_orig_0150015", "type": "orig", "text": "識字屬上．意云一切種識為諸法依處也。唐譯云由攝藏諸法一切種子識．此以依為攝藏。"}
{"id": null, "n": "0150016", "target": "#nkr_note_orig_0150016", "type": "orig", "text": "原文作 lun．為梵語阿笈摩之意譯。"}
{"id": null, "n": "0150017", "target": "#nkr_note_orig_0150017", "type": "orig", "text": "原文作 sbyor-ba．有連結．合一等意。今旁譯為攝依。唐譯仍作攝藏。"}
{"id": null, "n": "0150018", "target": "#nkr_note_orig_0150018", "type": "orig", "text": "原文作 len-pa 為梵語阿陀那之意譯。"}
{"id": null, "n": "0150019", "target": "#nkr_note_orig_0150019", "type": "orig", "text": "原文與上同．唐譯為執受．則與下執受五根之執無別。"}
{"id": null, "n": "0151020", "target": "#nkr_note_orig_0151020", "type": "orig", "text": "原文作 bzud-ba 意云執受．與上執持字別。"}
{"id": null, "n": "0151021", "target": "#nkr_note_orig_0151021", "type": "orig", "text": "原文作 sbyor-ba-sbrel-ba 意云結合．唐譯作結生。"}
{"id": null, "n": "0151022", "target": "#nkr_note_orig_0151022", "type": "orig", "text": "此彼字意指相續．唐譯作彼生．則與上結生之生相混。"}
{"id": null, "n": "0151023", "target": "#nkr_note_orig_0151023", "type": "orig", "text": "原文作 de-ma-thag-pa 但云彼無間．唐譯作等無間。"}
{"id": null, "n": "0151024", "target": "#nkr_note_orig_0151024", "type": "orig", "text": "原文以無間滅屬意．唐譯作無間滅識。"}
{"id": null, "n": "0151025", "target": "#nkr_note_orig_0151025", "type": "orig", "text": "魏隋唐三譯皆作意識．疑有誤．無間滅意不止是意識之緣也。"}
{"id": null, "n": "0151026", "target": "#nkr_note_orig_0151026", "type": "orig", "text": "唐譯此句連下讀．文段有誤。"}
{"id": null, "n": "0152027", "target": "#nkr_note_orig_0152027", "type": "orig", "text": "唐譯作非字．與此造句相反。"}
{"id": null, "n": "0152028", "target": "#nkr_note_orig_0152028", "type": "orig", "text": "依成唯識論卷五所釋．此意字疑是煩惱之誤。"}
{"id": null, "n": "0152029", "target": "#nkr_note_orig_0152029", "type": "orig", "text": "唐譯作微細隨逐。"}
{"id": null, "n": "0153030", "target": "#nkr_note_orig_0153030", "type": "orig", "text": "諸本均無此上座部教一叚．惟無性釋中見有此意。"}
{"id": null, "n": "0153031", "target": "#nkr_note_orig_0153031", "type": "orig", "text": "此識字疑衍寫。"}
{"id": null, "n": "0154032", "target": "#nkr_note_orig_0154032", "type": "orig", "text": "原文作 hjag-pa 意云施設．與前安立 gshag-pa 有別．唐譯兩處俱作安立。"}
{"id": null, "n": "0155033", "target": "#nkr_note_orig_0155033", "type": "orig", "text": "原文上句用故 nas 是第五轉聲．此句用由 pas 是第三轉聲．仍當作第五轉解．即是與攝持種子相應故。"}
{"id": null, "n": "0155034", "target": "#nkr_note_orig_0155034", "type": "orig", "text": "此指各雜染法之自種．唐譯以一切種連賴耶識．未顯此意。"}
{"id": null, "n": "0155035", "target": "#nkr_note_orig_0155035", "type": "orig", "text": "原文作 bsgos-pa 與熏習 bag-chags 字有別．唐譯並作熏習．蓋以外種為有熏習也。"}
{"id": null, "n": "0156036", "target": "#nkr_note_orig_0156036", "type": "orig", "text": "唐譯此二字．見下文總結句中。"}
{"id": null, "n": "0156037", "target": "#nkr_note_orig_0156037", "type": "orig", "text": "此句但與安立雜染為因相貫．唐譯別出唯就如是安立因緣八字遂成總結上文。"}
{"id": null, "n": "0156038", "target": "#nkr_note_orig_0156038", "type": "orig", "text": "原文作 gis 第三轉聲．唐譯作與字．更洽。"}
{"id": null, "n": "0156039", "target": "#nkr_note_orig_0156039", "type": "orig", "text": "此染衣所用。"}
{"id": null, "n": "0156040", "target": "#nkr_note_orig_0156040", "type": "orig", "text": "唐譯作入後．但入時即顯現時．實無先後之別。"}
{"id": null, "n": "0157041", "target": "#nkr_note_orig_0157041", "type": "orig", "text": "唐譯作眾緣．藏本無眾字。"}
{"id": null, "n": "0157042", "target": "#nkr_note_orig_0157042", "type": "orig", "text": "唐譯作所熏非異此．語意相反．待勘。"}
{"id": null, "n": "0157043", "target": "#nkr_note_orig_0157043", "type": "orig", "text": "此是如任運後滅之意．見無性釋論。藏譯此論盖每取無性說改文也。"}
{"id": null, "n": "0157044", "target": "#nkr_note_orig_0157044", "type": "orig", "text": "魏譯無此二頌。"}
{"id": null, "n": "0158045", "target": "#nkr_note_orig_0158045", "type": "orig", "text": "原文作 de-ni 是第一轉聲。唐譯作依彼熏習．彼字則成第六轉聲。"}
{"id": null, "n": "0158046", "target": "#nkr_note_orig_0158046", "type": "orig", "text": "原文作 hkhor-ba 意云輪轉．唐譯依前文仍作自性。"}
{"id": null, "n": "0159047", "target": "#nkr_note_orig_0159047", "type": "orig", "text": "唐譯取意．作不堅故。"}
{"id": null, "n": "0160048", "target": "#nkr_note_orig_0160048", "type": "orig", "text": "原文作 nur-nur-po 意云卵．指胎中一二週間之形體。唐譯作羯羅藍。"}
{"id": null, "n": "0161049", "target": "#nkr_note_orig_0161049", "type": "orig", "text": "唐譯無此二字。"}
{"id": null, "n": "0162050", "target": "#nkr_note_orig_0162050", "type": "orig", "text": "唐譯無此句。"}
{"id": null, "n": "0162051", "target": "#nkr_note_orig_0162051", "type": "orig", "text": "唐譯此下有如是一切離欲地中如應當知一句。"}
{"id": null, "n": "0162052", "target": "#nkr_note_orig_0162052", "type": "orig", "text": "此出字疑衍。"}
{"id": null, "n": "0163053", "target": "#nkr_note_orig_0163053", "type": "orig", "text": "唐譯以此數句屬下．並為問語。"}
{"id": null, "n": "0163054", "target": "#nkr_note_orig_0163054", "type": "orig", "text": "唐譯作寄．疑是意翻。"}
{"id": null, "n": "0164055", "target": "#nkr_note_orig_0164055", "type": "orig", "text": "原文作 rnam-pa 意云種類．唐譯為種．則與上種子之種相混。"}
{"id": null, "n": "0164056", "target": "#nkr_note_orig_0164056", "type": "orig", "text": "唐譯下更有非阿賴耶一切種增一句。"}
{"id": null, "n": "0164057", "target": "#nkr_note_orig_0164057", "type": "orig", "text": "唐譯此句作又非出定此識復生。"}
{"id": null, "n": "0164058", "target": "#nkr_note_orig_0164058", "type": "orig", "text": "唐譯此句與上句顛倒．且多應有想受現行過故等五句．合前後共十二因也。"}
{"id": null, "n": "0164059", "target": "#nkr_note_orig_0164059", "type": "orig", "text": "唐譯此句作如非遍行此不有故．與藏本造句相反。"}
{"id": null, "n": "0165060", "target": "#nkr_note_orig_0165060", "type": "orig", "text": "原文作 dgra-bcom-pa 為梵語阿羅漢之意譯。"}
{"id": null, "n": "0165061", "target": "#nkr_note_orig_0165061", "type": "orig", "text": "唐譯作無餘心轉依云何汝能作．以心轉依相連解。"}
{"id": null, "n": "0165062", "target": "#nkr_note_orig_0165062", "type": "orig", "text": "唐譯此句在後云於永斷成過。"}
{"id": null, "n": "0165063", "target": "#nkr_note_orig_0165063", "type": "orig", "text": "唐譯作無彼二無故．以二無連上解．與藏本造句相反。"}
{"id": null, "n": "0165064", "target": "#nkr_note_orig_0165064", "type": "orig", "text": "唐譯作緣相。"}
{"id": null, "n": "0165065", "target": "#nkr_note_orig_0165065", "type": "orig", "text": "唐譯無此二字。"}
{"id": null, "n": "0165066", "target": "#nkr_note_orig_0165066", "type": "orig", "text": "唐譯作異熟差別。"}
{"id": null, "n": "0166067", "target": "#nkr_note_orig_0166067", "type": "orig", "text": "唐譯作下有不共相即是有受生種子一句．此係下文前出於此。"}
{"id": null, "n": "0166068", "target": "#nkr_note_orig_0166068", "type": "orig", "text": "唐譯下有二別頌諸瑜伽師云云。"}
{"id": null, "n": "0166069", "target": "#nkr_note_orig_0166069", "type": "orig", "text": "唐譯此句在前出。"}
{"id": null, "n": "0166070", "target": "#nkr_note_orig_0166070", "type": "orig", "text": "唐譯作有受盡相無受盡相．疑是意翻。"}
{"id": null, "n": "0166071", "target": "#nkr_note_orig_0166071", "type": "orig", "text": "唐譯作成熟異熟果。"}
{"id": null, "n": "0143a0501", "target": "#nkr_note_add_0143a0501", "type": "add", "text": "珠【CB】，殊【補編】"}
{"id": null, "n": "0147a0101", "target": "#nkr_note_add_0147a0101", "type": "add", "text": "已【CB】，巳【補編】"}
{"id": null, "n": "0156a0301", "target": "#nkr_note_add_0156a0301", "type": "add", "text": "束【CB】，朿【補編】"}
{"id": null, "n": "0161a0401", "target": "#nkr_note_add_0161a0401", "type": "add", "text": "束【CB】，朿【補編】"}
{"id": null, "n": "0161a0501", "target": "#nkr_note_add_0161a0501", "type": "add", "text": "已【CB】，己【補編】"}
{"id": null, "n": "0161a0601", "target": "#nkr_note_add_0161a0601", "type": "add", "text": "已【CB】，己【補編】"}
{"id": null, "n": "0161a0701", "target": "#nkr_note_add_0161a0701", "type": "add", "text": "已【CB】，己【補編】"}
{"id": null, "n": "0162a0901", "target": "#nkr_note_add_0162a0901", "type": "add", "text": "淨【CB】，凈【補編】"}
{"id": null, "n": "0166a0501", "target": "#nkr_note_add_0166a0501", "type": "add", "text": "淨【CB】，凈【補編】"}
{"id": null, "n": "0166a1401", "target": "#nkr_note_add_0166a1401", "type": "add", "text": "己【CB】，已【補編】"}
