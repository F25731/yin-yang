{"id": null, "n": "0131001", "target": "#nkr_note_orig_0131001", "type": "orig", "text": "【原】元祿十二年刊宗教大學藏本"}
{"id": null, "n": "0132001", "target": "#nkr_note_orig_0132001", "type": "orig", "text": "冠註曰有下蓋有脫字"}
{"id": null, "n": "0134001", "target": "#nkr_note_orig_0134001", "type": "orig", "text": "國＝益？"}
{"id": null, "n": "0134002", "target": "#nkr_note_orig_0134002", "type": "orig", "text": "（此功）＋即？"}
{"id": null, "n": "0134003", "target": "#nkr_note_orig_0134003", "type": "orig", "text": "（德）＋圓？"}
{"id": null, "n": "0135001", "target": "#nkr_note_orig_0135001", "type": "orig", "text": "心＝必？"}
{"id": null, "n": "0136001", "target": "#nkr_note_orig_0136001", "type": "orig", "text": "使＝便？"}
{"id": null, "n": "0137001", "target": "#nkr_note_orig_0137001", "type": "orig", "text": "門＝間？"}
{"id": null, "n": "0137002", "target": "#nkr_note_orig_0137002", "type": "orig", "text": "樂＝渠？"}
{"id": null, "n": "0138001", "target": "#nkr_note_orig_0138001", "type": "orig", "text": "西＝面？"}
{"id": null, "n": "0138002", "target": "#nkr_note_orig_0138002", "type": "orig", "text": "正＝止？"}
{"id": null, "n": "0138003", "target": "#nkr_note_orig_0138003", "type": "orig", "text": "後＝復？"}
{"id": null, "n": "0139001", "target": "#nkr_note_orig_0139001", "type": "orig", "text": "受欲＝愛敬？"}
{"id": null, "n": "0139002", "target": "#nkr_note_orig_0139002", "type": "orig", "text": "微＝徵？"}
{"id": null, "n": "0139003", "target": "#nkr_note_orig_0139003", "type": "orig", "text": "冠註曰聖教下恐有脫誤"}
{"id": null, "n": "0139004", "target": "#nkr_note_orig_0139004", "type": "orig", "text": "羅＝門？"}
{"id": null, "n": "0140001", "target": "#nkr_note_orig_0140001", "type": "orig", "text": "寂＝最？"}
{"id": null, "n": "0140002", "target": "#nkr_note_orig_0140002", "type": "orig", "text": "利＋（益）？"}
{"id": null, "n": "0141001", "target": "#nkr_note_orig_0141001", "type": "orig", "text": "請＝詣？"}
{"id": null, "n": "0141002", "target": "#nkr_note_orig_0141002", "type": "orig", "text": "池＝地？"}
{"id": null, "n": "0141003", "target": "#nkr_note_orig_0141003", "type": "orig", "text": "五文＝吾父？"}
{"id": null, "n": "0142001", "target": "#nkr_note_orig_0142001", "type": "orig", "text": "飲＝欽？"}
{"id": null, "n": "0142002", "target": "#nkr_note_orig_0142002", "type": "orig", "text": "感＝慼？"}
{"id": null, "n": "0142003", "target": "#nkr_note_orig_0142003", "type": "orig", "text": "原本冠註曰足踰口裂也有脫誤乎"}
{"id": null, "n": "0142004", "target": "#nkr_note_orig_0142004", "type": "orig", "text": "傍＝謗？"}
{"id": null, "n": "0143001", "target": "#nkr_note_orig_0143001", "type": "orig", "text": "難＝歎？"}
{"id": null, "n": "0143002", "target": "#nkr_note_orig_0143002", "type": "orig", "text": "示＝亦？"}
{"id": null, "n": "0146001", "target": "#nkr_note_orig_0146001", "type": "orig", "text": "冠註曰施諸黎庶上蓋有脫文"}
{"id": null, "n": "0146002", "target": "#nkr_note_orig_0146002", "type": "orig", "text": "唱＝彰？＊"}
{"id": null, "n": "0147001", "target": "#nkr_note_orig_0147001", "type": "orig", "text": "慧＝惠？＊"}
{"id": null, "n": "0150001", "target": "#nkr_note_orig_0150001", "type": "orig", "text": "土＝主？"}
{"id": null, "n": "0152001", "target": "#nkr_note_orig_0152001", "type": "orig", "text": "辨＝辯？"}
{"id": null, "n": "0152002", "target": "#nkr_note_orig_0152002", "type": "orig", "text": "□□□□＝慧辯無量？"}
{"id": null, "n": "0154001", "target": "#nkr_note_orig_0154001", "type": "orig", "text": "損＝捐？"}
{"id": null, "n": "0154002", "target": "#nkr_note_orig_0154002", "type": "orig", "text": "劫＝功？"}
{"id": null, "n": "0156001", "target": "#nkr_note_orig_0156001", "type": "orig", "text": "在＝依？"}
{"id": null, "n": "0157001", "target": "#nkr_note_orig_0157001", "type": "orig", "text": "意＝音？"}
{"id": null, "n": "0157002", "target": "#nkr_note_orig_0157002", "type": "orig", "text": "過＝溫？"}
{"id": null, "n": "0158001", "target": "#nkr_note_orig_0158001", "type": "orig", "text": "化＝花？"}
{"id": null, "n": "0158002", "target": "#nkr_note_orig_0158002", "type": "orig", "text": "乘＝聚？＊"}
{"id": null, "n": "0158003", "target": "#nkr_note_orig_0158003", "type": "orig", "text": "孤＝狐？"}
{"id": null, "n": "0160001", "target": "#nkr_note_orig_0160001", "type": "orig", "text": "濡＝軟？"}
{"id": null, "n": "0161001", "target": "#nkr_note_orig_0161001", "type": "orig", "text": "冠註曰此下疑有脫文"}
{"id": null, "n": "0162001", "target": "#nkr_note_orig_0162001", "type": "orig", "text": "增＝憎？"}
{"id": null, "n": "0165001", "target": "#nkr_note_orig_0165001", "type": "orig", "text": "若＝苦？"}
{"id": null, "n": "0166001", "target": "#nkr_note_orig_0166001", "type": "orig", "text": "生＝名？"}
{"id": null, "n": "0166002", "target": "#nkr_note_orig_0166002", "type": "orig", "text": "定＝免？"}
{"id": null, "n": "0166003", "target": "#nkr_note_orig_0166003", "type": "orig", "text": "諭＝諛？"}
{"id": null, "n": "0167001", "target": "#nkr_note_orig_0167001", "type": "orig", "text": "冠註曰處者天天者性疑有脫文"}
{"id": null, "n": "0167002", "target": "#nkr_note_orig_0167002", "type": "orig", "text": "冠註曰貞罪直突更詳"}
{"id": null, "n": "0167003", "target": "#nkr_note_orig_0167003", "type": "orig", "text": "冠註曰方言何也今按方言曰曾何也等非是釋魯字更詳"}
{"id": null, "n": "0168001", "target": "#nkr_note_orig_0168001", "type": "orig", "text": "臣＝巨？"}
{"id": null, "n": "0168002", "target": "#nkr_note_orig_0168002", "type": "orig", "text": "彼＝得？"}
{"id": null, "n": "0169001", "target": "#nkr_note_orig_0169001", "type": "orig", "text": "唯總別違理疑此下次上有闕文更勘"}
{"id": null, "n": "0136c1001", "target": "#nkr_note_add_0136c1001", "type": "add", "text": "娉【CB】，嫂【大】"}
{"id": null, "n": "0136c2401", "target": "#nkr_note_add_0136c2401", "type": "add", "text": "坑【CB】，抗【大】"}
{"id": null, "n": "0136c2501", "target": "#nkr_note_add_0136c2501", "type": "add", "text": "坑【CB】，抗【大】"}
{"id": null, "n": "0138b0301", "target": "#nkr_note_add_0138b0301", "type": "add", "text": "已【CB】，如如也【大】"}
{"id": null, "n": "0138b0401", "target": "#nkr_note_add_0138b0401", "type": "add", "text": "［－］【CB】，如【大】"}
{"id": null, "n": "0138b0402", "target": "#nkr_note_add_0138b0402", "type": "add", "text": "如【CB】，［－］【大】"}
{"id": null, "n": "0138b0403", "target": "#nkr_note_add_0138b0403", "type": "add", "text": "如如【CB】，［－］【大】"}
{"id": null, "n": "0138b0404", "target": "#nkr_note_add_0138b0404", "type": "add", "text": "如是【CB】，［－］【大】"}
{"id": null, "n": "0139a1901", "target": "#nkr_note_add_0139a1901", "type": "add", "text": "彼【CB】，［－］【大】"}
{"id": null, "n": "0139c1601", "target": "#nkr_note_add_0139c1601", "type": "add", "text": "起必【CB】，必起【大】"}
{"id": null, "n": "0144b0801", "target": "#nkr_note_add_0144b0801", "type": "add", "text": "離【CB】【卍續-CB】，雖【大】"}
{"id": null, "n": "0147c2201", "target": "#nkr_note_add_0147c2201", "type": "add", "text": "靼【CB】，靻【大】"}
{"id": null, "n": "0150b2401", "target": "#nkr_note_add_0150b2401", "type": "add", "text": "設【CB】，說【大】"}
{"id": null, "n": "0151a2101", "target": "#nkr_note_add_0151a2101", "type": "add", "text": "CBETA 按：「也」下疑脫「經曰設我得佛至不取正覺者述云此第四願得他心樂也」。參見前文（T37n1748_p0151a17）應「有六」項與所釋《佛說無量壽經》（T12n0360_p0268a03-05）此處有得他心智之內容。"}
{"id": null, "n": "0159c1101", "target": "#nkr_note_add_0159c1101", "type": "add", "text": "經云【CB】，［－］【大】"}
{"id": null, "n": "0161b1701", "target": "#nkr_note_add_0161b1701", "type": "add", "text": "經曰【CB】，［－］【大】"}
{"id": null, "n": "0164c2801", "target": "#nkr_note_add_0164c2801", "type": "add", "text": "盧紅反【CB】，盧江反【大】"}
{"id": null, "n": null, "target": null, "type": null, "text": "盧紅反"}
{"id": null, "n": "0167a0801", "target": "#nkr_note_add_0167a0801", "type": "add", "text": "述云【CB】【卍續-CB】，云述【大】"}
{"id": null, "n": "0170c1401", "target": "#nkr_note_add_0170c1401", "type": "add", "text": "［－］【CB】，是【大】"}
