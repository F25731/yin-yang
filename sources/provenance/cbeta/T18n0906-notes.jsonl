{"id": null, "n": null, "target": null, "type": null, "text": "阿字作地觀、金剛座觀，形四角色黃，大圓鏡智，又名金剛智"}
{"id": null, "n": null, "target": null, "type": null, "text": "鑁字作水觀、蓮華觀，形如滿月色白，妙觀察智，又名蓮華智亦轉法輪智"}
{"id": null, "n": null, "target": null, "type": null, "text": "覽字作日觀，形三角色赤，平等性智，亦名灌頂智"}
{"id": null, "n": null, "target": null, "type": null, "text": "唅字作月觀，形如半月色黑，成所作智，亦名羯磨智也"}
{"id": null, "n": null, "target": null, "type": null, "text": "欠字作空觀，形如滿月色，種種法界性智"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": null, "target": null, "type": null, "text": "上品悉地"}
{"id": null, "n": null, "target": null, "type": null, "text": "根莖從足至腰化身"}
{"id": null, "n": null, "target": null, "type": null, "text": "枝葉從臍至心報身"}
{"id": null, "n": null, "target": null, "type": null, "text": "從心至頂法身佛果"}
{"id": null, "n": null, "target": null, "type": null, "text": "東方阿閦佛"}
{"id": null, "n": null, "target": null, "type": null, "text": "西方無量壽佛"}
{"id": null, "n": null, "target": null, "type": null, "text": "南方寶生佛"}
{"id": null, "n": null, "target": null, "type": null, "text": "北方釋迦牟尼佛"}
{"id": null, "n": null, "target": null, "type": null, "text": "中央大日如來"}
{"id": null, "n": null, "target": null, "type": null, "text": "吽"}
{"id": null, "n": null, "target": null, "type": null, "text": "成東方阿閦尊供養"}
{"id": null, "n": null, "target": null, "type": null, "text": "成南方寶生尊供養"}
{"id": null, "n": null, "target": null, "type": null, "text": "成西方無量壽尊供養"}
{"id": null, "n": null, "target": null, "type": null, "text": "成北方不空成就尊供養"}
{"id": null, "n": null, "target": null, "type": null, "text": "成自受法樂率都婆供養"}
{"id": null, "n": null, "target": null, "type": null, "text": "目所住自耳"}
{"id": null, "n": null, "target": null, "type": null, "text": "所住\n額"}
{"id": null, "n": null, "target": null, "type": null, "text": "所住喉"}
{"id": null, "n": null, "target": null, "type": null, "text": "舌"}
{"id": null, "n": null, "target": null, "type": null, "text": "十方放光照一切剎\n土如來"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T18n0907_p0915b28"}
{"id": null, "n": "0913001", "target": "#nkr_note_mod_0913001", "type": "mod", "text": "祥【大】，〔－〕【考偽-原】"}
{"id": null, "n": "0913002", "target": "#nkr_note_mod_0913002", "type": "mod", "text": "華【大】，峯【校異-原】"}
{"id": null, "n": "0913003", "target": "#nkr_note_mod_0913003", "type": "mod", "text": "唎【大】，吉唎【考偽-原】"}
{"id": null, "n": "0913004", "target": "#nkr_note_mod_0913004", "type": "mod", "text": "穀【大】，縠【校異-原】"}
{"id": null, "n": "0913005", "target": "#nkr_note_mod_0913005", "type": "mod", "text": "心【大】，身【校異-原】"}
{"id": null, "n": "0913006", "target": "#nkr_note_mod_0913006", "type": "mod", "text": "在【大】＊，有【考偽-原】＊"}
{"id": null, "n": "0914001", "target": "#nkr_note_mod_0914001", "type": "mod", "text": "常【大】，常覺【考偽-原】，常照【考偽-原】"}
{"id": null, "n": "0912005", "target": "#nkr_note_orig_0912005", "type": "orig", "text": "【原】享和元年刊長谷寺藏本"}
{"id": null, "n": "0913001", "target": "#nkr_note_orig_0913001", "type": "orig", "text": "〔祥〕－ヵ【原】"}
{"id": null, "n": "0913002", "target": "#nkr_note_orig_0913002", "type": "orig", "text": "華＝峯ィ【原】"}
{"id": null, "n": "0913003", "target": "#nkr_note_orig_0913003", "type": "orig", "text": "（吉）ヵ＋唎【原】"}
{"id": null, "n": "0913004", "target": "#nkr_note_orig_0913004", "type": "orig", "text": "穀＝縠ィ【原】"}
{"id": null, "n": "0913005", "target": "#nkr_note_orig_0913005", "type": "orig", "text": "心＝身ィ【原】"}
{"id": null, "n": "0913006", "target": "#nkr_note_orig_0913006", "type": "orig", "text": "在＝有ヵ【原】＊"}
{"id": null, "n": "0914001", "target": "#nkr_note_orig_0914001", "type": "orig", "text": "常＋（覺）ヵ【原】，（照）ヵ【原】"}
{"id": null, "n": "0914002", "target": "#nkr_note_orig_0914002", "type": "orig", "text": "原本冠註曰五臟配當有一本終今加附之"}
{"id": null, "n": "0912c1601", "target": "#nkr_note_add_0912c1601", "type": "add", "text": "大【CB】，不【大】"}
{"id": null, "n": "0912c1602", "target": "#nkr_note_add_0912c1602", "type": "add", "text": "不【CB】，大【大】"}
{"id": null, "n": "0913c0301", "target": "#nkr_note_add_0913c0301", "type": "add", "text": "毘【CB】，尾【大】"}
