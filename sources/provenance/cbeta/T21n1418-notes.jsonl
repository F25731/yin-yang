{"id": null, "n": "0933002", "target": "#nkr_note_mod_0933002", "type": "mod", "text": "西【大】，宋西【明】"}
{"id": null, "n": "0933003", "target": "#nkr_note_mod_0933003", "type": "mod", "text": "譯經【大】，〔－〕【明】"}
{"id": null, "n": "0933004", "target": "#nkr_note_mod_0933004", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0933005", "target": "#nkr_note_mod_0933005", "type": "mod", "text": "在【大】，若【明】"}
{"id": null, "n": "0933006", "target": "#nkr_note_mod_0933006", "type": "mod", "text": "三摩野薩怛鑁【大】，〔－〕【明】"}
{"id": null, "n": "0933007", "target": "#nkr_note_mod_0933007", "type": "mod", "text": "邪【大】，耶【宋】【元】【明】"}
{"id": null, "n": "0933008", "target": "#nkr_note_mod_0933008", "type": "mod", "text": "藏【大】，臟【明】"}
{"id": null, "n": "0934001", "target": "#nkr_note_mod_0934001", "type": "mod", "text": "引【大】，〔－〕【元】"}
{"id": null, "n": "0934002", "target": "#nkr_note_mod_0934002", "type": "mod", "text": "寫【大】，瀉【明】"}
{"id": null, "n": "0934003", "target": "#nkr_note_mod_0934003", "type": "mod", "text": "賀【大】，賀引【宋】【元】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0934004", "target": "#nkr_note_mod_0934004", "type": "mod", "text": "羅【大】＊，囉【明】＊"}
{"id": null, "n": "0934005", "target": "#nkr_note_mod_0934005", "type": "mod", "text": "面東【大】，而樂【明】"}
{"id": null, "n": "0934006", "target": "#nkr_note_mod_0934006", "type": "mod", "text": "志【大】＊，至【元】＊"}
{"id": null, "n": "0934007", "target": "#nkr_note_mod_0934007", "type": "mod", "text": "哆【大】，多【明】"}
{"id": null, "n": "0934008", "target": "#nkr_note_mod_0934008", "type": "mod", "text": "𭕺【大】，𭕳【明】"}
{"id": null, "n": "0934009", "target": "#nkr_note_mod_0934009", "type": "mod", "text": "𭕟【大】，𭕗【明】"}
{"id": null, "n": "0934010", "target": "#nkr_note_mod_0934010", "type": "mod", "text": "三【大】，唵三【宋】【元】"}
{"id": null, "n": "0935001", "target": "#nkr_note_mod_0935001", "type": "mod", "text": "姹【大】，吒【明】"}
{"id": null, "n": "0935002", "target": "#nkr_note_mod_0935002", "type": "mod", "text": "往【大】，住【明】"}
{"id": null, "n": "0935003", "target": "#nkr_note_mod_0935003", "type": "mod", "text": "第【大】，〔－〕【明】"}
{"id": null, "n": "0935004", "target": "#nkr_note_mod_0935004", "type": "mod", "text": "一【大】，佛說一【明】"}
{"id": null, "n": "0933001", "target": "#nkr_note_orig_0933001", "type": "orig", "text": "【原】麗本"}
