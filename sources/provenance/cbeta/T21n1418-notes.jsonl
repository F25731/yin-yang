{"id": null, "n": "0934002", "target": "#nkr_note_orig_0934002", "type": "orig", "text": "寫＝瀉【明】"}
{"id": null, "n": "0934003", "target": "#nkr_note_orig_0934003", "type": "orig", "text": "賀＋（引）夾註【宋】【元】"}
{"id": null, "n": "0934004", "target": "#nkr_note_orig_0934004", "type": "orig", "text": "羅＝囉【明】＊"}
{"id": null, "n": "0934005", "target": "#nkr_note_orig_0934005", "type": "orig", "text": "面東＝而樂【明】"}
{"id": null, "n": "0934006", "target": "#nkr_note_orig_0934006", "type": "orig", "text": "志＝至【元】＊"}
{"id": null, "n": "0934007", "target": "#nkr_note_orig_0934007", "type": "orig", "text": "哆＝多【明】"}
{"id": null, "n": "0934008", "target": "#nkr_note_orig_0934008", "type": "orig", "text": "󳤡＝𭕳【明】"}
{"id": null, "n": "0934009", "target": "#nkr_note_orig_0934009", "type": "orig", "text": "𭕟＝𭕗【明】"}
