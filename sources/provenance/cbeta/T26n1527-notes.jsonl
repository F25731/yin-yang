{"id": null, "n": "0278004", "target": "#nkr_note_mod_0278004", "type": "mod", "text": "得【大】，故【宋】【元】【明】"}
{"id": null, "n": "0278005", "target": "#nkr_note_mod_0278005", "type": "mod", "text": "聞【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0278006", "target": "#nkr_note_mod_0278006", "type": "mod", "text": "已【大】，以【宋】【元】【明】"}
