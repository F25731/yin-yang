{"id": null, "n": "0757005", "target": "#nkr_note_mod_0757005", "type": "mod", "text": "金剛【大】，佛說金剛【宮】"}
{"id": null, "n": "0759001", "target": "#nkr_note_mod_0759001", "type": "mod", "text": "此【大】，中【宮】"}
{"id": null, "n": "0757005", "target": "#nkr_note_orig_0757005", "type": "orig", "text": "（佛說）＋金剛【宮】"}
{"id": null, "n": "0759001", "target": "#nkr_note_orig_0759001", "type": "orig", "text": "此＝中【宮】"}
{"id": null, "n": "0757a2401", "target": "#nkr_note_add_0757a2401", "type": "add", "text": "此經疑為真諦譯本。"}
{"id": null, "n": "0757b2201", "target": "#nkr_note_add_0757b2201", "type": "add", "text": "想【CB】，相【大】"}
{"id": null, "n": "0757b2801", "target": "#nkr_note_add_0757b2801", "type": "add", "text": "薩【CB】，提【大】"}
{"id": null, "n": "0760a0901", "target": "#nkr_note_add_0760a0901", "type": "add", "text": "般【CB】，槃【大】"}
