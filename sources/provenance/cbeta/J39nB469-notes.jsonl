{"id": null, "n": "0921a0201", "target": "#nkr_note_add_0921a0201", "type": "add", "text": "臨濟孤迥只餘一【CB】，【嘉興】"}
{"id": null, "n": "0921a0301", "target": "#nkr_note_add_0921a0301", "type": "add", "text": "單傳直指獨顯大【CB】，【嘉興】"}
{"id": null, "n": "0921a0401", "target": "#nkr_note_add_0921a0401", "type": "add", "text": "眾流函蓋【CB】，【嘉興】"}
{"id": null, "n": "0921a0501", "target": "#nkr_note_add_0921a0501", "type": "add", "text": "器以符航海【CB】，【嘉興】"}
{"id": null, "n": "0921a0801", "target": "#nkr_note_add_0921a0801", "type": "add", "text": "騷雅貴圖熱【CB】，【嘉興】"}
{"id": null, "n": "0921a0901", "target": "#nkr_note_add_0921a0901", "type": "add", "text": "陵遲惟【CB】，【嘉興】"}
{"id": null, "n": "0921a1001", "target": "#nkr_note_add_0921a1001", "type": "add", "text": "行解【CB】，【嘉興】"}
{"id": null, "n": "0921a1101", "target": "#nkr_note_add_0921a1101", "type": "add", "text": "月幢老【CB】，【嘉興】"}
{"id": null, "n": "0921a1201", "target": "#nkr_note_add_0921a1201", "type": "add", "text": "兼貲或【CB】，【嘉興】"}
{"id": null, "n": "0921a1401", "target": "#nkr_note_add_0921a1401", "type": "add", "text": "應病【CB】，麼【嘉興】"}
{"id": null, "n": "0921a1501", "target": "#nkr_note_add_0921a1501", "type": "add", "text": "信【CB】，【嘉興】"}
{"id": null, "n": "0921a1601", "target": "#nkr_note_add_0921a1601", "type": "add", "text": "代中興【CB】，【嘉興】"}
{"id": null, "n": "0921a1701", "target": "#nkr_note_add_0921a1701", "type": "add", "text": "也惜乎天【CB】，【嘉興】"}
