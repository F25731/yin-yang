{"id": null, "n": null, "target": null, "type": "cf2", "text": "T01n0043_p0828c16"}
{"id": null, "n": "0828010", "target": "#nkr_note_mod_0828010", "type": "mod", "text": "沙門【大】，三藏法師【宋】【元】【明】"}
{"id": null, "n": "0828011", "target": "#nkr_note_mod_0828011", "type": "mod", "text": "凡【大】，也【宋】【元】【明】"}
{"id": null, "n": "0828012", "target": "#nkr_note_mod_0828012", "type": "mod", "text": "用【大】，因【宋】【元】【明】"}
{"id": null, "n": "0828013", "target": "#nkr_note_mod_0828013", "type": "mod", "text": "唯【大】，惟【宋】【元】【明】"}
{"id": null, "n": "0828014", "target": "#nkr_note_mod_0828014", "type": "mod", "text": "𡱁𡱤【大】，屎尿【宋】【元】【明】"}
{"id": null, "n": "0828015", "target": "#nkr_note_mod_0828015", "type": "mod", "text": "拄【大】，柱【宋】【元】"}
{"id": null, "n": "0828016", "target": "#nkr_note_mod_0828016", "type": "mod", "text": "人【大】＊，耶人【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0829001", "target": "#nkr_note_mod_0829001", "type": "mod", "text": "軀【大】，驅【宋】"}
{"id": null, "n": "0829002", "target": "#nkr_note_mod_0829002", "type": "mod", "text": "已【大】，以【宋】【元】【明】"}
{"id": null, "n": "0829003", "target": "#nkr_note_mod_0829003", "type": "mod", "text": "常【大】，常當【宋】【元】【明】"}
{"id": null, "n": "0829004", "target": "#nkr_note_mod_0829004", "type": "mod", "text": "裹蘊【大】，衰褞【宋】"}
{"id": null, "n": "0829005", "target": "#nkr_note_mod_0829005", "type": "mod", "text": "參【大】，慘【明】"}
{"id": null, "n": "0829006", "target": "#nkr_note_mod_0829006", "type": "mod", "text": "耶【CB】【麗-CB】，邪【大】，唯【宋】【元】【明】"}
{"id": null, "n": "0829007", "target": "#nkr_note_mod_0829007", "type": "mod", "text": "誡【大】，戒【宋】【元】【明】"}
{"id": null, "n": "0829008", "target": "#nkr_note_mod_0829008", "type": "mod", "text": "佛說【大】，〔－〕【宋】【元】"}
{"id": null, "n": "0828010", "target": "#nkr_note_orig_0828010", "type": "orig", "text": "沙門＝三藏法師【三】"}
{"id": null, "n": "0828011", "target": "#nkr_note_orig_0828011", "type": "orig", "text": "凡＝也【三】"}
{"id": null, "n": "0828012", "target": "#nkr_note_orig_0828012", "type": "orig", "text": "用＝因【三】"}
{"id": null, "n": "0828013", "target": "#nkr_note_orig_0828013", "type": "orig", "text": "唯＝惟【三】"}
{"id": null, "n": "0828014", "target": "#nkr_note_orig_0828014", "type": "orig", "text": "𡱁𡱤＝屎尿【三】"}
{"id": null, "n": "0828015", "target": "#nkr_note_orig_0828015", "type": "orig", "text": "拄＝柱【宋】【元】"}
{"id": null, "n": "0828016", "target": "#nkr_note_orig_0828016", "type": "orig", "text": "（耶）＋人【三】＊"}
{"id": null, "n": "0829001", "target": "#nkr_note_orig_0829001", "type": "orig", "text": "軀＝驅【宋】"}
{"id": null, "n": "0829002", "target": "#nkr_note_orig_0829002", "type": "orig", "text": "已＝以【三】"}
{"id": null, "n": "0829003", "target": "#nkr_note_orig_0829003", "type": "orig", "text": "常＋（當）【三】"}
{"id": null, "n": "0829004", "target": "#nkr_note_orig_0829004", "type": "orig", "text": "裹蘊＝衰褞【宋】"}
{"id": null, "n": "0829005", "target": "#nkr_note_orig_0829005", "type": "orig", "text": "參＝慘【明】"}
{"id": null, "n": "0829006", "target": "#nkr_note_orig_0829006", "type": "orig", "text": "邪＝唯【三】"}
{"id": null, "n": "0829007", "target": "#nkr_note_orig_0829007", "type": "orig", "text": "誡＝戒【三】"}
{"id": null, "n": "0829008", "target": "#nkr_note_orig_0829008", "type": "orig", "text": "〔佛說〕－【宋】【元】"}
