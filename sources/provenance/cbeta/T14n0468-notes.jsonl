{"id": null, "n": null, "target": null, "type": null, "text": "此言已知，陳如姓也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此言羅茯根，其父好噉此物因以為名"}
{"id": null, "n": null, "target": null, "type": null, "text": "此言常作\n聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "此言善脾"}
{"id": null, "n": null, "target": null, "type": null, "text": "此言大歡喜"}
{"id": null, "n": null, "target": null, "type": null, "text": "此言如是"}
{"id": null, "n": null, "target": null, "type": null, "text": "此言無我無我"}
{"id": null, "n": null, "target": null, "type": null, "text": "此言無壽命無壽命"}
{"id": null, "n": null, "target": null, "type": null, "text": "此言失失"}
{"id": null, "n": null, "target": null, "type": null, "text": "此言燒燒"}
{"id": null, "n": null, "target": null, "type": null, "text": "此言破破"}
{"id": null, "n": null, "target": null, "type": null, "text": "此言有為"}
{"id": null, "n": null, "target": null, "type": null, "text": "此言除殺去"}
{"id": null, "n": null, "target": null, "type": null, "text": "末者莫義，陀摩者中義，莫著中此謂末陀摩"}
{"id": null, "n": null, "target": null, "type": null, "text": "僧炎是逆守義，加陀尼是令不生義"}
{"id": null, "n": null, "target": null, "type": null, "text": "此言大眾，老少同會共集律部也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此言老宿，淳老宿人同會共出律部也"}
{"id": null, "n": null, "target": null, "type": null, "text": "所執與僧祇同，故云一也"}
{"id": null, "n": null, "target": null, "type": null, "text": "稱讚辭也"}
{"id": null, "n": null, "target": null, "type": null, "text": "是出\n律主姓也"}
{"id": null, "n": null, "target": null, "type": null, "text": "出律主有多聞智也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此山名，出律主居之也"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦律主居也"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦律主居也"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主執三\n世有故，一切可厝語言也"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦律主居也"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主姓也"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主名也"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主名也"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主為通人所重也"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主居也"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主初生母棄之於井，父\n追尋之，雖墜不死，故云不可棄也；又名能射"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主名也"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主姓也"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主執修妬路義也"}
