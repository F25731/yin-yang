{"id": null, "n": "0864009", "target": "#nkr_note_mod_0864009", "type": "mod", "text": "經【大】，經亦云陀羅尼句【宋】【元】【明】"}
{"id": null, "n": "0864010", "target": "#nkr_note_mod_0864010", "type": "mod", "text": "謙【大】，謙拾遺編入第一【宋】"}
{"id": null, "n": "0864011", "target": "#nkr_note_mod_0864011", "type": "mod", "text": "百千【大】＊，千百【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0864012", "target": "#nkr_note_mod_0864012", "type": "mod", "text": "名【大】＊，名曰【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0864013", "target": "#nkr_note_mod_0864013", "type": "mod", "text": "鄧【大】＊，燈【明】＊"}
{"id": null, "n": "0864014", "target": "#nkr_note_mod_0864014", "type": "mod", "text": "彼【大】，時彼【宋】【元】【明】"}
{"id": null, "n": "0864015", "target": "#nkr_note_mod_0864015", "type": "mod", "text": "前【大】，〔－〕【宋】"}
{"id": null, "n": "0864016", "target": "#nkr_note_mod_0864016", "type": "mod", "text": "是【大】，此【宋】【元】【明】"}
{"id": null, "n": "0864017", "target": "#nkr_note_mod_0864017", "type": "mod", "text": "世【大】，如何世【宋】"}
{"id": null, "n": "0864018", "target": "#nkr_note_mod_0864018", "type": "mod", "text": "常【大】，平常【宋】【元】【明】"}
{"id": null, "n": "0864019", "target": "#nkr_note_mod_0864019", "type": "mod", "text": "女鬼鳩桓【大】，鳩洹鬼【宋】【元】【明】"}
{"id": null, "n": "0864020", "target": "#nkr_note_mod_0864020", "type": "mod", "text": "獸【大】，狩【宋】"}
{"id": null, "n": "0864021", "target": "#nkr_note_mod_0864021", "type": "mod", "text": "佛【大】，彼佛【宋】【元】【明】"}
{"id": null, "n": "0864022", "target": "#nkr_note_mod_0864022", "type": "mod", "text": "令【大】，全【宋】【元】【明】"}
{"id": null, "n": "0864023", "target": "#nkr_note_mod_0864023", "type": "mod", "text": "得【大】，德【宋】"}
{"id": null, "n": "0864024", "target": "#nkr_note_mod_0864024", "type": "mod", "text": "波【大】＊，婆【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0864025", "target": "#nkr_note_mod_0864025", "type": "mod", "text": "遇【大】，遇佛語阿難若【宋】【元】【明】"}
{"id": null, "n": "0864026", "target": "#nkr_note_mod_0864026", "type": "mod", "text": "是持【大】，持是【宋】【元】【明】"}
{"id": null, "n": "0865001", "target": "#nkr_note_mod_0865001", "type": "mod", "text": "人非【大】，非人【明】"}
{"id": null, "n": "0865002", "target": "#nkr_note_mod_0865002", "type": "mod", "text": "敢【大】，能【宋】【元】【明】"}
{"id": null, "n": "0865003", "target": "#nkr_note_mod_0865003", "type": "mod", "text": "不【大】，不能【宋】【元】【明】"}
{"id": null, "n": "0865004", "target": "#nkr_note_mod_0865004", "type": "mod", "text": "持【大】，受持【宋】【元】【明】"}
{"id": null, "n": "0865005", "target": "#nkr_note_mod_0865005", "type": "mod", "text": "安【大】，其【宋】"}
{"id": null, "n": "0865006", "target": "#nkr_note_mod_0865006", "type": "mod", "text": "持【大】，治【宋】"}
{"id": null, "n": "0865007", "target": "#nkr_note_mod_0865007", "type": "mod", "text": "敢【大】，能【明】"}
{"id": null, "n": "0865008", "target": "#nkr_note_mod_0865008", "type": "mod", "text": "葉【大】，草【宋】【元】"}
{"id": null, "n": "0865009", "target": "#nkr_note_mod_0865009", "type": "mod", "text": "吉【大】，吉善【元】【明】"}
{"id": null, "n": "0865010", "target": "#nkr_note_mod_0865010", "type": "mod", "text": "皆【大】，比【宋】，所【元】【明】"}
