{"id": null, "n": "0821009", "target": "#nkr_note_mod_0821009", "type": "mod", "text": "鋡【大】＊，含【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0821010", "target": "#nkr_note_mod_0821010", "type": "mod", "text": "天竺三藏【大】，西域沙門【宋】【元】【明】【宮】"}
{"id": null, "n": "0821011", "target": "#nkr_note_mod_0821011", "type": "mod", "text": "恒【大】，園【宋】【元】【明】【宮】"}
{"id": null, "n": "0821012", "target": "#nkr_note_mod_0821012", "type": "mod", "text": "從【大】，侍【宋】【元】【明】【宮】"}
{"id": null, "n": "0821013", "target": "#nkr_note_mod_0821013", "type": "mod", "text": "瞻【大】，占【宋】【元】【明】【宮】"}
{"id": null, "n": "0821014", "target": "#nkr_note_mod_0821014", "type": "mod", "text": "舍【大】，含【明】"}
{"id": null, "n": "0821015", "target": "#nkr_note_mod_0821015", "type": "mod", "text": "客【大】，容【聖】"}
{"id": null, "n": "0821016", "target": "#nkr_note_mod_0821016", "type": "mod", "text": "持【大】，侍【聖】"}
{"id": null, "n": "0821017", "target": "#nkr_note_mod_0821017", "type": "mod", "text": "戒【大】＊，誡【聖】＊"}
{"id": null, "n": "0821018", "target": "#nkr_note_mod_0821018", "type": "mod", "text": "坐【大】，正【宮】"}
{"id": null, "n": "0821019", "target": "#nkr_note_mod_0821019", "type": "mod", "text": "四天【大】，天四【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0821020", "target": "#nkr_note_mod_0821020", "type": "mod", "text": "有【大】，〔－〕【聖】"}
{"id": null, "n": "0821021", "target": "#nkr_note_mod_0821021", "type": "mod", "text": "耶【CB】【麗-CB】【宋】【元】【明】【宮】，那【大】，邪【聖】"}
{"id": null, "n": "0821022", "target": "#nkr_note_mod_0821022", "type": "mod", "text": "以【大】，於【明】"}
{"id": null, "n": "0821023", "target": "#nkr_note_mod_0821023", "type": "mod", "text": "飯【大】，飲【宋】【元】【明】【宮】"}
{"id": null, "n": "0821025", "target": "#nkr_note_mod_0821025", "type": "mod", "text": "佛說【大】，〔－〕【聖】"}
{"id": null, "n": "0821026", "target": "#nkr_note_mod_0821026", "type": "mod", "text": "經【大】，經一卷【聖】"}
