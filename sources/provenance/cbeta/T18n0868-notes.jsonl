{"id": null, "n": "0271001", "target": "#nkr_note_orig_0271001", "type": "orig", "text": "殊檗本作珠＊"}
{"id": null, "n": "0271002", "target": "#nkr_note_orig_0271002", "type": "orig", "text": "諸佛境界攝真實經八字檗本闕之乙本以朱加之"}
{"id": null, "n": "0271003", "target": "#nkr_note_orig_0271003", "type": "orig", "text": "滿＝具【甲】"}
