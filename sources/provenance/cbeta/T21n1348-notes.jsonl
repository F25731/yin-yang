{"id": null, "n": "0860018", "target": "#nkr_note_mod_0860018", "type": "mod", "text": "佛說【大】＊，〔－〕【元】【明】＊，【原】麗本"}
{"id": null, "n": "0860019", "target": "#nkr_note_mod_0860019", "type": "mod", "text": "天竺【大】，〔－〕【宋】"}
{"id": null, "n": "0860020", "target": "#nkr_note_mod_0860020", "type": "mod", "text": "譯【大】，初譯【元】【明】"}
{"id": null, "n": "0861001", "target": "#nkr_note_mod_0861001", "type": "mod", "text": "現【大】，見【宋】【元】【明】"}
{"id": null, "n": "0861002", "target": "#nkr_note_mod_0861002", "type": "mod", "text": "豪【大】，毫【宋】【元】【明】"}
{"id": null, "n": "0861003", "target": "#nkr_note_mod_0861003", "type": "mod", "text": "華【大】，焰【明】"}
{"id": null, "n": "0861004", "target": "#nkr_note_mod_0861004", "type": "mod", "text": "曼【大】，漫【宋】【元】【明】"}
{"id": null, "n": "0861005", "target": "#nkr_note_mod_0861005", "type": "mod", "text": "吉【大】，王【宋】【元】【明】"}
{"id": null, "n": "0861006", "target": "#nkr_note_mod_0861006", "type": "mod", "text": "吉【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0861007", "target": "#nkr_note_mod_0861007", "type": "mod", "text": "喃【大】，南【宋】【元】【明】"}
{"id": null, "n": "0861008", "target": "#nkr_note_mod_0861008", "type": "mod", "text": "逾【大】，愈【宋】【元】【明】"}
{"id": null, "n": "0861009", "target": "#nkr_note_mod_0861009", "type": "mod", "text": "陀【大】，池【宋】【元】【明】"}
{"id": null, "n": "0861010", "target": "#nkr_note_mod_0861010", "type": "mod", "text": "十【大】，下【元】"}
{"id": null, "n": "0861011", "target": "#nkr_note_mod_0861011", "type": "mod", "text": "願【大】，須【宋】【元】【明】"}
{"id": null, "n": "0862001", "target": "#nkr_note_mod_0862001", "type": "mod", "text": "已【大】，國【宋】"}
{"id": null, "n": "0862002", "target": "#nkr_note_mod_0862002", "type": "mod", "text": "至【大】，志【宋】"}
{"id": null, "n": "0862003", "target": "#nkr_note_mod_0862003", "type": "mod", "text": "問【大】，聞【宋】【元】【明】"}
{"id": null, "n": "0860018", "target": "#nkr_note_orig_0860018", "type": "orig", "text": "【原】麗本，〔佛說〕－【元】【明】＊"}
{"id": null, "n": "0860019", "target": "#nkr_note_orig_0860019", "type": "orig", "text": "〔天竺〕－【宋】"}
{"id": null, "n": "0860020", "target": "#nkr_note_orig_0860020", "type": "orig", "text": "（初）＋譯【元】【明】"}
{"id": null, "n": "0860021", "target": "#nkr_note_orig_0860021", "type": "orig", "text": "如是前行宋元明三本俱有我闍那崛多敬禮常住體遍滿於法界毘盧遮那佛四句"}
{"id": null, "n": "0861001", "target": "#nkr_note_orig_0861001", "type": "orig", "text": "現＝見【三】"}
{"id": null, "n": "0861002", "target": "#nkr_note_orig_0861002", "type": "orig", "text": "豪＝毫【三】"}
{"id": null, "n": "0861003", "target": "#nkr_note_orig_0861003", "type": "orig", "text": "華＝焰【明】"}
{"id": null, "n": "0861004", "target": "#nkr_note_orig_0861004", "type": "orig", "text": "曼＝漫【三】"}
{"id": null, "n": "0861005", "target": "#nkr_note_orig_0861005", "type": "orig", "text": "吉＝王【三】"}
{"id": null, "n": "0861006", "target": "#nkr_note_orig_0861006", "type": "orig", "text": "〔吉〕－【三】"}
{"id": null, "n": "0861007", "target": "#nkr_note_orig_0861007", "type": "orig", "text": "喃＝南【三】"}
{"id": null, "n": "0861008", "target": "#nkr_note_orig_0861008", "type": "orig", "text": "逾＝愈【三】"}
{"id": null, "n": "0861009", "target": "#nkr_note_orig_0861009", "type": "orig", "text": "陀＝池【三】"}
{"id": null, "n": "0861010", "target": "#nkr_note_orig_0861010", "type": "orig", "text": "十＝下【元】"}
{"id": null, "n": "0861011", "target": "#nkr_note_orig_0861011", "type": "orig", "text": "願＝須【三】"}
{"id": null, "n": "0862001", "target": "#nkr_note_orig_0862001", "type": "orig", "text": "已＝國【宋】"}
{"id": null, "n": "0862002", "target": "#nkr_note_orig_0862002", "type": "orig", "text": "至＝志【宋】"}
{"id": null, "n": "0862003", "target": "#nkr_note_orig_0862003", "type": "orig", "text": "問＝聞【三】"}
{"id": null, "n": "0860018", "target": "#nkr_note_rest_0860018", "type": "rest", "text": "【原】麗本"}
