{"id": null, "n": null, "target": null, "type": "cf1", "text": "K11n0220_p0403c08"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T53n2121_p0190b10"}
{"id": null, "n": "0819001", "target": "#nkr_note_mod_0819001", "type": "mod", "text": "申【大】，佛說申【明】"}
{"id": null, "n": "0819002", "target": "#nkr_note_mod_0819002", "type": "mod", "text": "兒【大】＊，兜【宋】【宮】＊"}
{"id": null, "n": "0819003", "target": "#nkr_note_mod_0819003", "type": "mod", "text": "經【大】，經兒或作兜或無本字【元】，經申日是長者之名兒即長者之子也【明】"}
{"id": null, "n": "0819004", "target": "#nkr_note_mod_0819004", "type": "mod", "text": "宋【大】，劉宋【元】【明】"}
{"id": null, "n": "0819005", "target": "#nkr_note_mod_0819005", "type": "mod", "text": "藏【大】，藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0819006", "target": "#nkr_note_mod_0819006", "type": "mod", "text": "求那【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "0819007", "target": "#nkr_note_mod_0819007", "type": "mod", "text": "譯【大】，第三譯【元】【明】"}
{"id": null, "n": "0819008", "target": "#nkr_note_mod_0819008", "type": "mod", "text": "鷂【大】，鷄【明】"}
{"id": null, "n": "0819009", "target": "#nkr_note_mod_0819009", "type": "mod", "text": "是【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0819010", "target": "#nkr_note_mod_0819010", "type": "mod", "text": "受【大】，愛【宋】【宮】"}
{"id": null, "n": "0819011", "target": "#nkr_note_mod_0819011", "type": "mod", "text": "信【大】，知【宮】"}
{"id": null, "n": "0819012", "target": "#nkr_note_mod_0819012", "type": "mod", "text": "奪【大】，盜【宋】【元】【明】【宮】"}
{"id": null, "n": "0819013", "target": "#nkr_note_mod_0819013", "type": "mod", "text": "請【大】，諸【明】"}
{"id": null, "n": "0819014", "target": "#nkr_note_mod_0819014", "type": "mod", "text": "中土【大】，中上【宋】，中草【元】【明】，其中【宮】"}
{"id": null, "n": "0819015", "target": "#nkr_note_mod_0819015", "type": "mod", "text": "嘉【大】，佳【宋】【元】【明】【宮】"}
{"id": null, "n": "0819016", "target": "#nkr_note_mod_0819016", "type": "mod", "text": "過【大】，通【宋】【元】【明】【宮】"}
{"id": null, "n": "0820001", "target": "#nkr_note_mod_0820001", "type": "mod", "text": "佛行【大】，行佛【宋】【宮】"}
{"id": null, "n": "0820002", "target": "#nkr_note_mod_0820002", "type": "mod", "text": "騷【大】，路【宋】，驚【宮】"}
{"id": null, "n": "0820003", "target": "#nkr_note_mod_0820003", "type": "mod", "text": "從【大】，行【宮】"}
{"id": null, "n": "0820004", "target": "#nkr_note_mod_0820004", "type": "mod", "text": "門【大】，聞【宮】"}
{"id": null, "n": "0820005", "target": "#nkr_note_mod_0820005", "type": "mod", "text": "影【大】，景【宋】【元】【明】"}
{"id": null, "n": "0820006", "target": "#nkr_note_mod_0820006", "type": "mod", "text": "央【大】，鞅【宮】"}
{"id": null, "n": "0820007", "target": "#nkr_note_mod_0820007", "type": "mod", "text": "試【大】，請【宮】"}
{"id": null, "n": "0820008", "target": "#nkr_note_mod_0820008", "type": "mod", "text": "者【大】，者皆【宋】【元】【明】【宮】"}
{"id": null, "n": "0820009", "target": "#nkr_note_mod_0820009", "type": "mod", "text": "以【大】＊，已【元】【明】【宮】＊"}
{"id": null, "n": "0820010", "target": "#nkr_note_mod_0820010", "type": "mod", "text": "坑【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0820011", "target": "#nkr_note_mod_0820011", "type": "mod", "text": "收更【大】，更炊【宋】【元】【明】【宮】"}
{"id": null, "n": "0820012", "target": "#nkr_note_mod_0820012", "type": "mod", "text": "我【大】，大【宋】【元】【明】【宮】"}
{"id": null, "n": "0820013", "target": "#nkr_note_mod_0820013", "type": "mod", "text": "佛作【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0819001", "target": "#nkr_note_orig_0819001", "type": "orig", "text": "（佛說）＋申【明】"}
{"id": null, "n": "0819002", "target": "#nkr_note_orig_0819002", "type": "orig", "text": "兒＝兜【宋】【宮】＊"}
{"id": null, "n": "0819003", "target": "#nkr_note_orig_0819003", "type": "orig", "text": "經＋（兒或作兜或無本字）【元】，（申日是長者之名兒即長者之子也）【明】"}
{"id": null, "n": "0819004", "target": "#nkr_note_orig_0819004", "type": "orig", "text": "（劉）＋宋【元】【明】"}
{"id": null, "n": "0819005", "target": "#nkr_note_orig_0819005", "type": "orig", "text": "藏＋（法師）【三】【宮】"}
{"id": null, "n": "0819006", "target": "#nkr_note_orig_0819006", "type": "orig", "text": "〔求那〕－【宋】【宮】"}
{"id": null, "n": "0819007", "target": "#nkr_note_orig_0819007", "type": "orig", "text": "（第三）＋譯【元】【明】"}
{"id": null, "n": "0819008", "target": "#nkr_note_orig_0819008", "type": "orig", "text": "鷂＝鷄【明】"}
{"id": null, "n": "0819009", "target": "#nkr_note_orig_0819009", "type": "orig", "text": "〔是〕－【三】【宮】"}
{"id": null, "n": "0819010", "target": "#nkr_note_orig_0819010", "type": "orig", "text": "受＝愛【宋】【宮】"}
{"id": null, "n": "0819011", "target": "#nkr_note_orig_0819011", "type": "orig", "text": "信＝知【宮】"}
{"id": null, "n": "0819012", "target": "#nkr_note_orig_0819012", "type": "orig", "text": "奪＝盜【三】【宮】"}
{"id": null, "n": "0819013", "target": "#nkr_note_orig_0819013", "type": "orig", "text": "請＝諸【明】"}
{"id": null, "n": "0819014", "target": "#nkr_note_orig_0819014", "type": "orig", "text": "中土＝中上【宋】，中草【元】【明】，其中【宮】"}
{"id": null, "n": "0819015", "target": "#nkr_note_orig_0819015", "type": "orig", "text": "嘉＝佳【三】【宮】"}
{"id": null, "n": "0819016", "target": "#nkr_note_orig_0819016", "type": "orig", "text": "過＝通【三】【宮】"}
{"id": null, "n": "0820001", "target": "#nkr_note_orig_0820001", "type": "orig", "text": "佛行＝行佛【宋】【宮】"}
{"id": null, "n": "0820002", "target": "#nkr_note_orig_0820002", "type": "orig", "text": "騷＝路【宋】，驚【宮】"}
{"id": null, "n": "0820003", "target": "#nkr_note_orig_0820003", "type": "orig", "text": "從＝行【宮】"}
{"id": null, "n": "0820004", "target": "#nkr_note_orig_0820004", "type": "orig", "text": "門＝聞【宮】"}
{"id": null, "n": "0820005", "target": "#nkr_note_orig_0820005", "type": "orig", "text": "影＝景【三】"}
{"id": null, "n": "0820006", "target": "#nkr_note_orig_0820006", "type": "orig", "text": "央＝鞅【宮】"}
{"id": null, "n": "0820007", "target": "#nkr_note_orig_0820007", "type": "orig", "text": "試＝請【宮】"}
{"id": null, "n": "0820008", "target": "#nkr_note_orig_0820008", "type": "orig", "text": "者＋（皆）【三】【宮】"}
{"id": null, "n": "0820009", "target": "#nkr_note_orig_0820009", "type": "orig", "text": "以＝已【元】【明】【宮】＊"}
{"id": null, "n": "0820010", "target": "#nkr_note_orig_0820010", "type": "orig", "text": "〔坑〕－【三】【宮】"}
{"id": null, "n": "0820011", "target": "#nkr_note_orig_0820011", "type": "orig", "text": "收更＝更炊【三】【宮】"}
{"id": null, "n": "0820012", "target": "#nkr_note_orig_0820012", "type": "orig", "text": "我＝大【三】【宮】"}
{"id": null, "n": "0820013", "target": "#nkr_note_orig_0820013", "type": "orig", "text": "〔佛作〕－【三】【宮】"}
{"id": null, "n": "0820a1301", "target": "#nkr_note_add_0820a1301", "type": "add", "text": "蹈【CB】【麗-CB】，踏【大】"}
