{"id": null, "n": "0024017", "target": "#nkr_note_mod_0024017", "type": "mod", "text": "中門門【大】，門中【宋】【元】【明】"}
{"id": null, "n": "0024018", "target": "#nkr_note_mod_0024018", "type": "mod", "text": "畫【大】，盡【甲】"}
{"id": null, "n": "0024019", "target": "#nkr_note_mod_0024019", "type": "mod", "text": "杉【大】，杇【甲】"}
{"id": null, "n": "0024020", "target": "#nkr_note_mod_0024020", "type": "mod", "text": "拘【大】，狗【宋】【元】，枸【明】"}
{"id": null, "n": "0024021", "target": "#nkr_note_mod_0024021", "type": "mod", "text": "鳥污【大】，阿【宋】【元】【明】【甲】"}
{"id": null, "n": "0024022", "target": "#nkr_note_mod_0024022", "type": "mod", "text": "臍【大】，齊【甲】"}
