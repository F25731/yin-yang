{"id": null, "n": "0023017", "target": "#nkr_note_mod_0023017", "type": "mod", "text": "經【大】，品【宋】【元】"}
{"id": null, "n": "0023018", "target": "#nkr_note_mod_0023018", "type": "mod", "text": "開府儀同三司【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0023019", "target": "#nkr_note_mod_0023019", "type": "mod", "text": "（肅國…智）二十一字【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0023020", "target": "#nkr_note_mod_0023020", "type": "mod", "text": "沙門【大】，大廣智【宋】【元】【明】"}
{"id": null, "n": "0023021", "target": "#nkr_note_mod_0023021", "type": "mod", "text": "跋【大】，拔【甲】"}
{"id": null, "n": "0023022", "target": "#nkr_note_mod_0023022", "type": "mod", "text": "俱【大】，〔－〕【甲】"}
{"id": null, "n": "0023023", "target": "#nkr_note_mod_0023023", "type": "mod", "text": "右肩【大】，〔－〕【甲】"}
{"id": null, "n": "0023024", "target": "#nkr_note_mod_0023024", "type": "mod", "text": "唯【大】，惟【宋】【元】【明】【甲】"}
{"id": null, "n": "0023025", "target": "#nkr_note_mod_0023025", "type": "mod", "text": "遍【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0023026", "target": "#nkr_note_mod_0023026", "type": "mod", "text": "難事【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0023027", "target": "#nkr_note_mod_0023027", "type": "mod", "text": "泥【大】＊，埿【甲】＊"}
{"id": null, "n": "0024001", "target": "#nkr_note_mod_0024001", "type": "mod", "text": "法師云大小如牛皮【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0024002", "target": "#nkr_note_mod_0024002", "type": "mod", "text": "酥【大】＊，蘇【甲】＊"}
{"id": null, "n": "0024003", "target": "#nkr_note_mod_0024003", "type": "mod", "text": "一洛叉【大】，多少【宋】【元】【明】【甲】"}
{"id": null, "n": "0024004", "target": "#nkr_note_mod_0024004", "type": "mod", "text": "速得【大】，乃至【宋】【元】【明】【甲】"}
{"id": null, "n": "0024005", "target": "#nkr_note_mod_0024005", "type": "mod", "text": "又【大】，又如【宋】【元】【明】【甲】"}
{"id": null, "n": "0024006", "target": "#nkr_note_mod_0024006", "type": "mod", "text": "落【大】，洛【宋】【元】【明】"}
{"id": null, "n": "0024007", "target": "#nkr_note_mod_0024007", "type": "mod", "text": "字【大】，了【宋】【元】【明】"}
{"id": null, "n": "0024008", "target": "#nkr_note_mod_0024008", "type": "mod", "text": "愛【大】，念【宋】【元】【明】【甲】"}
{"id": null, "n": "0024009", "target": "#nkr_note_mod_0024009", "type": "mod", "text": "面【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0024010", "target": "#nkr_note_mod_0024010", "type": "mod", "text": "酥【大】＊，蘇【宋】【元】【甲】＊"}
{"id": null, "n": "0024011", "target": "#nkr_note_mod_0024011", "type": "mod", "text": "隨為何人除厄【大】∞難及惡事皆【甲】"}
{"id": null, "n": "0024012", "target": "#nkr_note_mod_0024012", "type": "mod", "text": "難及惡事皆【大】∞隨為何人除厄【甲】"}
{"id": null, "n": "0024013", "target": "#nkr_note_mod_0024013", "type": "mod", "text": "成熟【大】，熟成【甲】"}
{"id": null, "n": "0024014", "target": "#nkr_note_mod_0024014", "type": "mod", "text": "患【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0024015", "target": "#nkr_note_mod_0024015", "type": "mod", "text": "上及【大】，亦【宋】【元】【明】【甲】"}
