{"id": null, "n": "0025010", "target": "#nkr_note_mod_0025010", "type": "mod", "text": "提【大】，薩【甲】"}
{"id": null, "n": "0025011", "target": "#nkr_note_mod_0025011", "type": "mod", "text": "󰉓【大】，抄【宋】，炒【元】【明】，赻【甲】"}
