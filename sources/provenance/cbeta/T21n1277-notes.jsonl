{"id": null, "n": null, "target": null, "type": null, "text": "阿尾奢法"}
{"id": null, "n": "0331002", "target": null, "type": "orig", "text": "〔一卷〕－【丙】"}
{"id": null, "n": "0331002", "target": null, "type": "mod", "text": "一卷【大】，〔－〕【丙】"}
{"id": null, "n": "0329011", "target": "#nkr_note_mod_0329011", "type": "mod", "text": "魔【大】＊，摩【明】【乙】【丙】＊"}
{"id": null, "n": "0329012", "target": "#nkr_note_mod_0329012", "type": "mod", "text": "說【大】，說迦樓羅【甲】【乙】"}
{"id": null, "n": "0329013", "target": "#nkr_note_mod_0329013", "type": "mod", "text": "一卷【大】，〔－〕【明】【乙】【丙】"}
{"id": null, "n": "0329014", "target": "#nkr_note_mod_0329014", "type": "mod", "text": "開府儀同三司特進試鴻臚卿肅國公食邑三千戶賜紫贈司空諡大鑒正號大廣智大興善寺三藏沙門【大】，大興善寺三藏沙門大廣智【甲】【乙】，（開府儀同三司特進試鴻臚卿肅國公食邑三千戶賜紫贈司空諡大鑒正號大廣智大興善寺）三十七字＝（唐北天竺）四字【明】【丙】"}
{"id": null, "n": "0329015", "target": "#nkr_note_mod_0329015", "type": "mod", "text": "門【大】，門大廣智【明】【丙】"}
{"id": null, "n": "0329016", "target": "#nkr_note_mod_0329016", "type": "mod", "text": "在【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0329017", "target": "#nkr_note_mod_0329017", "type": "mod", "text": "且【大】，但【丙】"}
{"id": null, "n": "0329018", "target": "#nkr_note_mod_0329018", "type": "mod", "text": "唯【大】，惟【明】【丙】"}
{"id": null, "n": "0329019", "target": "#nkr_note_mod_0329019", "type": "mod", "text": "法【大】，法爾【丙】"}
{"id": null, "n": "0329020", "target": "#nkr_note_mod_0329020", "type": "mod", "text": "摩【大】，摩天【校異-乙】"}
{"id": null, "n": "0329021", "target": "#nkr_note_mod_0329021", "type": "mod", "text": "𭼩【大】，靨【明】【乙】，黶【丙】"}
{"id": null, "n": "0329022", "target": "#nkr_note_mod_0329022", "type": "mod", "text": "直【大】，〔－〕【明】【甲】【乙】"}
{"id": null, "n": "0329023", "target": "#nkr_note_mod_0329023", "type": "mod", "text": "淨【大】，新淨【甲】【乙】【丙】"}
{"id": null, "n": "0329024", "target": "#nkr_note_mod_0329024", "type": "mod", "text": "爐【大】，嚴【明】，器【甲】【乙】【丙】"}
{"id": null, "n": "0329025", "target": "#nkr_note_mod_0329025", "type": "mod", "text": "香【大】，〔－〕【明】"}
{"id": null, "n": "0329026", "target": "#nkr_note_mod_0329026", "type": "mod", "text": "二【大】，以二【丙】"}
{"id": null, "n": "0329027", "target": "#nkr_note_mod_0329027", "type": "mod", "text": "曩謨【大】，娜莫【明】【丙】"}
{"id": null, "n": "0329028", "target": "#nkr_note_mod_0329028", "type": "mod", "text": "底【大】，底一【明】【丙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": "0329029", "target": "#nkr_note_mod_0329029", "type": "mod", "text": "摩【大】，麼【明】【丙】"}
{"id": null, "n": "0329030", "target": "#nkr_note_mod_0329030", "type": "mod", "text": "㘈【大】，㘑【明】【甲】【乙】【丙】"}
{"id": null, "n": "0329031", "target": "#nkr_note_mod_0329031", "type": "mod", "text": "合【大】，合二【明】【丙】"}
{"id": null, "n": "0329032", "target": "#nkr_note_mod_0329032", "type": "mod", "text": "㘈【大】，㘑三【明】【丙】"}
{"id": null, "n": "0329033", "target": "#nkr_note_mod_0329033", "type": "mod", "text": "儞【大】，儞四【明】【丙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "四"}
{"id": null, "n": "0329034", "target": "#nkr_note_mod_0329034", "type": "mod", "text": "跛【大】，跋【明】"}
{"id": null, "n": "0329035", "target": "#nkr_note_mod_0329035", "type": "mod", "text": "娑【大】＊，薩【甲】＊"}
{"id": null, "n": "0329036", "target": "#nkr_note_mod_0329036", "type": "mod", "text": "引【大】，五【明】【丙】"}
{"id": null, "n": "0329037", "target": "#nkr_note_mod_0329037", "type": "mod", "text": "光【大】，輝光【甲】【乙】"}
{"id": null, "n": "0329038", "target": "#nkr_note_mod_0329038", "type": "mod", "text": "唵【大】＊，唵一【明】【丙】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": "0329039", "target": "#nkr_note_mod_0329039", "type": "mod", "text": "賀【大】，賀引二【明】【乙】【丙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引二"}
{"id": null, "n": "0329040", "target": "#nkr_note_mod_0329040", "type": "mod", "text": "賀【大】＊，賀引【甲】【乙】＊"}
{"id": null, "n": "0329041", "target": "#nkr_note_mod_0329041", "type": "mod", "text": "賀【大】，訶引【明】【丙】，賀引【甲】【乙】"}
{"id": null, "n": "0329042", "target": "#nkr_note_mod_0329042", "type": "mod", "text": "攞【大】，囉【明】【丙】"}
{"id": null, "n": "0329043", "target": "#nkr_note_mod_0329043", "type": "mod", "text": "風【大】，〔－〕【明】"}
{"id": null, "n": "0329044", "target": "#nkr_note_mod_0329044", "type": "mod", "text": "引【大】＊，引二【明】【丙】＊"}
{"id": null, "n": "0329045", "target": "#nkr_note_mod_0329045", "type": "mod", "text": "真【大】，七遍真【甲】【丙】"}
{"id": null, "n": "0329046", "target": "#nkr_note_mod_0329046", "type": "mod", "text": "引【大】，引三【明】【丙】"}
{"id": null, "n": "0330001", "target": "#nkr_note_mod_0330001", "type": "mod", "text": "摩【大】，摩賀【甲】【乙】，摩賀引【丙】"}
{"id": null, "n": "0330002", "target": "#nkr_note_mod_0330002", "type": "mod", "text": "引【大】，〔－〕【甲】"}
{"id": null, "n": "0330003", "target": "#nkr_note_mod_0330003", "type": "mod", "text": "賀【大】，賀引【乙】"}
{"id": null, "n": "0330004", "target": "#nkr_note_mod_0330004", "type": "mod", "text": "項【大】，頂【丙】"}
{"id": null, "n": "0330005", "target": "#nkr_note_mod_0330005", "type": "mod", "text": "紳【大】，神【明】【甲】【乙】【丙】"}
{"id": null, "n": "0330006", "target": "#nkr_note_mod_0330006", "type": "mod", "text": "彼【大】，披【明】【甲】【乙】【丙】"}
{"id": null, "n": "0330007", "target": "#nkr_note_mod_0330007", "type": "mod", "text": "寫及【大】，象皮【明】【乙】【丙】，寫皮【甲】"}
{"id": null, "n": "0330008", "target": "#nkr_note_mod_0330008", "type": "mod", "text": "蜜【大】，密【明】【甲】【乙】【丙】"}
{"id": null, "n": "0330009", "target": "#nkr_note_mod_0330009", "type": "mod", "text": "野【大】＊，也【甲】＊"}
{"id": null, "n": "0330010", "target": "#nkr_note_mod_0330010", "type": "mod", "text": "二【大】＊，二合二【明】＊"}
{"id": null, "n": "0330011", "target": "#nkr_note_mod_0330011", "type": "mod", "text": "縛【大】，嚩【明】【甲】【乙】"}
{"id": null, "n": "0330012", "target": "#nkr_note_mod_0330012", "type": "mod", "text": "揄【大】，榆【明】【乙】"}
{"id": null, "n": "0330013", "target": "#nkr_note_mod_0330013", "type": "mod", "text": "苫【大】，苦三【明】"}
{"id": null, "n": "0330014", "target": "#nkr_note_mod_0330014", "type": "mod", "text": "一百【大】，〔－〕【明】"}
{"id": null, "n": "0330015", "target": "#nkr_note_mod_0330015", "type": "mod", "text": "次【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0330016", "target": "#nkr_note_mod_0330016", "type": "mod", "text": "跛【大】＊，跋【明】＊"}
{"id": null, "n": "0330017", "target": "#nkr_note_mod_0330017", "type": "mod", "text": "羅【大】＊，囉【明】【丙】＊"}
{"id": null, "n": "0330018", "target": "#nkr_note_mod_0330018", "type": "mod", "text": "里【大】＊，哩【明】【丙】＊"}
