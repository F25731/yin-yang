{"id": null, "n": null, "target": null, "type": null, "text": "出《中阿含》"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K19n0690_p0562c06"}
{"id": null, "n": "0837008", "target": "#nkr_note_mod_0837008", "type": "mod", "text": "出中阿含【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0837009", "target": "#nkr_note_mod_0837009", "type": "mod", "text": "三藏【大】，沙門【宋】【元】【明】"}
{"id": null, "n": "0838001", "target": "#nkr_note_mod_0838001", "type": "mod", "text": "法說【大】，說法【宋】【元】【明】"}
{"id": null, "n": "0838002", "target": "#nkr_note_mod_0838002", "type": "mod", "text": "如【大】，知【宋】【元】【明】"}
{"id": null, "n": "0838003", "target": "#nkr_note_mod_0838003", "type": "mod", "text": "從【大】，行【宋】【元】【明】"}
{"id": null, "n": "0838004", "target": "#nkr_note_mod_0838004", "type": "mod", "text": "從【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0838005", "target": "#nkr_note_mod_0838005", "type": "mod", "text": "得【大】，得譽得【宋】【元】【明】"}
{"id": null, "n": "0838006", "target": "#nkr_note_mod_0838006", "type": "mod", "text": "後【大】，後不【宋】【元】【明】"}
{"id": null, "n": "0838007", "target": "#nkr_note_mod_0838007", "type": "mod", "text": "澤【大】，澤塚【宋】【元】【明】"}
{"id": null, "n": "0838008", "target": "#nkr_note_mod_0838008", "type": "mod", "text": "德【大】＊，得【宋】【明】＊"}
{"id": null, "n": "0838009", "target": "#nkr_note_mod_0838009", "type": "mod", "text": "德如【大】，得如【宋】【元】【明】"}
{"id": null, "n": "0838010", "target": "#nkr_note_mod_0838010", "type": "mod", "text": "意行【大】，行意【宋】【元】【明】"}
{"id": null, "n": "0838011", "target": "#nkr_note_mod_0838011", "type": "mod", "text": "亦無【大】，行亦【宋】【元】【明】"}
{"id": null, "n": "0838012", "target": "#nkr_note_mod_0838012", "type": "mod", "text": "說【大】，語【宋】【元】【明】"}
{"id": null, "n": "0837008", "target": "#nkr_note_orig_0837008", "type": "orig", "text": "〔出中阿含〕－【三】"}
{"id": null, "n": "0837009", "target": "#nkr_note_orig_0837009", "type": "orig", "text": "三藏＝沙門【三】"}
{"id": null, "n": "0838001", "target": "#nkr_note_orig_0838001", "type": "orig", "text": "法說＝說法【三】"}
{"id": null, "n": "0838002", "target": "#nkr_note_orig_0838002", "type": "orig", "text": "如＝知【三】"}
{"id": null, "n": "0838003", "target": "#nkr_note_orig_0838003", "type": "orig", "text": "從＝行【三】"}
{"id": null, "n": "0838004", "target": "#nkr_note_orig_0838004", "type": "orig", "text": "〔從〕－【三】"}
{"id": null, "n": "0838005", "target": "#nkr_note_orig_0838005", "type": "orig", "text": "得＋（譽得）【三】"}
{"id": null, "n": "0838006", "target": "#nkr_note_orig_0838006", "type": "orig", "text": "後＋（不）【三】"}
{"id": null, "n": "0838007", "target": "#nkr_note_orig_0838007", "type": "orig", "text": "澤＋（塚）【三】"}
{"id": null, "n": "0838008", "target": "#nkr_note_orig_0838008", "type": "orig", "text": "德＝得【宋】【明】＊"}
{"id": null, "n": "0838009", "target": "#nkr_note_orig_0838009", "type": "orig", "text": "德如＝得如【三】"}
{"id": null, "n": "0838010", "target": "#nkr_note_orig_0838010", "type": "orig", "text": "意行＝行意【三】"}
{"id": null, "n": "0838011", "target": "#nkr_note_orig_0838011", "type": "orig", "text": "亦無＝行亦【三】"}
{"id": null, "n": "0838012", "target": "#nkr_note_orig_0838012", "type": "orig", "text": "說＝語【三】"}
{"id": null, "n": "0837c2901", "target": "#nkr_note_add_0837c2901", "type": "add", "text": "憙【CB】，熹【大】"}
{"id": null, "n": "0838b0701", "target": "#nkr_note_add_0838b0701", "type": "add", "text": "者【CB】【麗-CB】，故【大】"}
