{"id": null, "n": null, "target": null, "type": null, "text": "并"}
{"id": null, "n": null, "target": null, "type": null, "text": "源"}
{"id": null, "n": null, "target": null, "type": null, "text": "并"}
{"id": null, "n": null, "target": null, "type": null, "text": "宗密"}
{"id": null, "n": null, "target": null, "type": null, "text": "淨源"}
{"id": null, "n": null, "target": null, "type": null, "text": "詩廉切亦草類"}
{"id": null, "n": null, "target": null, "type": null, "text": "音句驚悲也"}
{"id": null, "n": null, "target": null, "type": null, "text": "裴休述也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即荊南張禪師"}
{"id": null, "n": null, "target": null, "type": null, "text": "即道圎也"}
{"id": null, "n": null, "target": null, "type": null, "text": "矣"}
{"id": null, "n": null, "target": null, "type": null, "text": "音戶"}
{"id": null, "n": null, "target": null, "type": null, "text": "先儒注䟽。皆謂之章句"}
{"id": null, "n": null, "target": null, "type": null, "text": "𥂁鉄論云。荊山之人。以玉抵鵲。言其玉多而不寳之也。抵擊也"}
{"id": null, "n": null, "target": null, "type": null, "text": "行路之人得之。乃傳之為寳。喻吾師已到寳所。凡出言指㕝。無非妙門。人自寳\n惜之耳。"}
{"id": null, "n": null, "target": null, "type": null, "text": "吾師之教。圎頓明徹。入其\n戶牖。即無迷執之憂。故言高枕。"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼序法集。非序原人"}
{"id": null, "n": null, "target": null, "type": null, "text": "音渕󲯏也"}
{"id": null, "n": null, "target": null, "type": null, "text": "老子經注芸󷓗眾多義也"}
{"id": null, "n": null, "target": null, "type": null, "text": "天才"}
{"id": null, "n": null, "target": null, "type": null, "text": "地才"}
{"id": null, "n": null, "target": null, "type": null, "text": "󶬒手擊也"}
{"id": null, "n": null, "target": null, "type": null, "text": "起下文󱧐迷執下篇"}
{"id": null, "n": null, "target": null, "type": null, "text": "起下文人天教"}
{"id": null, "n": null, "target": null, "type": null, "text": "起下文小乗教"}
{"id": null, "n": null, "target": null, "type": null, "text": "起下文法相教"}
{"id": null, "n": null, "target": null, "type": null, "text": "老子即摩訶迦𰱒。仲𡰱即淨光童子。"}
{"id": null, "n": null, "target": null, "type": null, "text": "始修六度為因終證万德為果"}
{"id": null, "n": null, "target": null, "type": null, "text": "始覆一簣為因。終成\n九仞為果"}
{"id": null, "n": null, "target": null, "type": null, "text": "始挙一步為因。終行千里為果。"}
{"id": null, "n": null, "target": null, "type": null, "text": "天。地。雷。風。水。火。山。沢。是謂八卦。"}
{"id": null, "n": null, "target": null, "type": null, "text": "未即天地人物"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。習儒道者"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。習佛不了義教者"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。習了義實教"}
{"id": null, "n": null, "target": null, "type": null, "text": "會前所斥。同皈一源。\n\n皆為正義"}
{"id": null, "n": null, "target": null, "type": null, "text": "習儒道者。"}
{"id": null, "n": null, "target": null, "type": null, "text": "餓鬼。修羅。地獄。"}
{"id": null, "n": null, "target": null, "type": null, "text": "一氣二儀通為三也亦可天地人為三"}
{"id": null, "n": null, "target": null, "type": null, "text": "出禪詮序"}
{"id": null, "n": null, "target": null, "type": null, "text": "大抄。即云是無端也"}
{"id": null, "n": null, "target": null, "type": null, "text": "虎狼𢙣獸。而為師子所敢。尒雅云。狻猊如彪貓。\n食虎豹狼者。徵祥記云。狼頭一角。黃色馬足"}
{"id": null, "n": null, "target": null, "type": null, "text": "諡法\n\n曰。賊民多殺曰𱣎。殘義󰡷善曰紂。上二句明長𢙣。下二句明棄善也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音戶"}
{"id": null, "n": null, "target": null, "type": null, "text": "音徑近也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音淨"}
{"id": null, "n": null, "target": null, "type": null, "text": "出別異傳"}
{"id": null, "n": null, "target": null, "type": null, "text": "嬖音閉愛也"}
{"id": null, "n": null, "target": null, "type": null, "text": "姓端木名賜字子貢"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦如礼記。有祭法祭統祭義󵓕文"}
{"id": null, "n": null, "target": null, "type": null, "text": "蘇息死而\n更生也"}
{"id": null, "n": null, "target": null, "type": null, "text": "𭸟音𠋣"}
{"id": null, "n": null, "target": null, "type": null, "text": "音輟疲也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上感動妻下感妻子"}
{"id": null, "n": null, "target": null, "type": null, "text": "普才切打也"}
{"id": null, "n": null, "target": null, "type": null, "text": "丑粟切。打也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音憤"}
{"id": null, "n": null, "target": null, "type": null, "text": "句"}
{"id": null, "n": null, "target": null, "type": null, "text": "音廠"}
{"id": null, "n": null, "target": null, "type": null, "text": "操執也釋名戟挌也傍有支格也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音工󵘸文云。車轂中鐵也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音翰禦也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上音無。下音檄。男曰巫女曰󶹻。即事鬼之徒也"}
{"id": null, "n": null, "target": null, "type": null, "text": "鈔意。似以一人則田蚡。兩人則竇嬰灌夫。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此言仁義本於性性本於天也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謙受益也"}
{"id": null, "n": null, "target": null, "type": null, "text": "人道𢙣盈。則󷑮害於盈也"}
{"id": null, "n": null, "target": null, "type": null, "text": "三王謂夏殷周"}
{"id": null, "n": null, "target": null, "type": null, "text": "玄宗注云。禮所\n以正君臣父子之別。明男女長㓜之序。故可以安上化下也"}
{"id": null, "n": null, "target": null, "type": null, "text": "注云。風俗移易。先入樂聲。變随人心。正由\n君德。正之與變。因樂而彰。故曰莫善於樂"}
{"id": null, "n": null, "target": null, "type": null, "text": "習佛不了義教者"}
{"id": null, "n": null, "target": null, "type": null, "text": "不󵘸別教一乗。故云略也"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。上四在此篇中"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。在第三篇中"}
{"id": null, "n": null, "target": null, "type": null, "text": "即賢首愚法攝。𭃡人天教"}
{"id": null, "n": null, "target": null, "type": null, "text": "即賢首分\n教"}
{"id": null, "n": null, "target": null, "type": null, "text": "即賢首始教"}
{"id": null, "n": null, "target": null, "type": null, "text": "即終頓圎同教一乗"}
{"id": null, "n": null, "target": null, "type": null, "text": "過去"}
{"id": null, "n": null, "target": null, "type": null, "text": "現在"}
{"id": null, "n": null, "target": null, "type": null, "text": "一約境。於父󳌤造殺業。為上品。二約心。則瞋心增勝。\n死墮地獄"}
{"id": null, "n": null, "target": null, "type": null, "text": "一約境。於餘人造殺業。為中品。二約心。則慳貪增勝。死墮餓鬼"}
{"id": null, "n": null, "target": null, "type": null, "text": "一約境。於蚊蚋等起殺業。為下品。二約心。則愚癡增勝。死墮畜生"}
{"id": null, "n": null, "target": null, "type": null, "text": "源云。仁有博愛之德。下同"}
{"id": null, "n": null, "target": null, "type": null, "text": "義有合冝之德"}
{"id": null, "n": null, "target": null, "type": null, "text": "禮有尊𤰞敬讓之德"}
{"id": null, "n": null, "target": null, "type": null, "text": "信有無虚妄之德"}
{"id": null, "n": null, "target": null, "type": null, "text": "智有照了\n\n之德"}
{"id": null, "n": null, "target": null, "type": null, "text": "塗道也。地獄名火塗道。餓鬼名刀塗。畜生名血塗道也"}
{"id": null, "n": null, "target": null, "type": null, "text": "貪瞋猛盛者。即造十𢙣業"}
{"id": null, "n": null, "target": null, "type": null, "text": "貪來生富樂之報者。造諸善業"}
{"id": null, "n": null, "target": null, "type": null, "text": "厭下苦麤障。欣上淨妙離者。修四禪八定"}
{"id": null, "n": null, "target": null, "type": null, "text": "現世作善𢙣。即現身受苦樂報"}
{"id": null, "n": null, "target": null, "type": null, "text": "今生作善𢙣。次一生受報"}
{"id": null, "n": null, "target": null, "type": null, "text": "次二三生。乃至未來多生受報。名順後報"}
{"id": null, "n": null, "target": null, "type": null, "text": "心脾肝肺腎"}
{"id": null, "n": null, "target": null, "type": null, "text": "惑即煩惱障。體是第八識"}
{"id": null, "n": null, "target": null, "type": null, "text": "上皆序文"}
{"id": null, "n": null, "target": null, "type": null, "text": "俱生"}
{"id": null, "n": null, "target": null, "type": null, "text": "分別"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。貪名利以榮身"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。瞋違情境。恐侵害身"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。非理計校"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。別業所感"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。共業所感"}
{"id": null, "n": null, "target": null, "type": null, "text": "冝將瑜伽二節之文。對此論五道苦樂等身。三界勝\n劣等處。皆符合也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此二句。即共造依報。同注文。共業所感也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此二句即別造正報。同注云。別業所感"}
{"id": null, "n": null, "target": null, "type": null, "text": "此󷘓和恱"}
{"id": null, "n": null, "target": null, "type": null, "text": "句此中引\n頌皆七字也"}
{"id": null, "n": null, "target": null, "type": null, "text": "一雙持。二持軸。三木。四善見。五\n馬耳。六象鼻。七魚"}
{"id": null, "n": null, "target": null, "type": null, "text": "東勝身。南贍部。西牛貨。北俱盧"}
{"id": null, "n": null, "target": null, "type": null, "text": "然自\n粳米。長半寸。不因耕種"}
{"id": null, "n": null, "target": null, "type": null, "text": "伏義。神農。黃帝"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。能領納好𢙣之事。下同"}
{"id": null, "n": null, "target": null, "type": null, "text": "能取像者"}
{"id": null, "n": null, "target": null, "type": null, "text": "能造作者。念念遷流"}
{"id": null, "n": null, "target": null, "type": null, "text": "能了別者"}
{"id": null, "n": null, "target": null, "type": null, "text": "皮不是毛等"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。知苦諦也"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。断集諦也"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。道諦"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。󷓟諦"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。根境等為緣"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。悶絕睡\n眠󷓟𥁞定。無想定。無想天"}
{"id": null, "n": null, "target": null, "type": null, "text": "即二乗無漏定"}
{"id": null, "n": null, "target": null, "type": null, "text": "即外道有漏定"}
{"id": null, "n": null, "target": null, "type": null, "text": "即色界中一天"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "相見二分"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼二我法。離此二分。無所依故"}
{"id": null, "n": null, "target": null, "type": null, "text": "有本云。執為實有。即實有我法也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。重病心惛。見異色人物也"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。夢想所見可知"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。廣如前󵘸"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。不了之義。如後所破"}
{"id": null, "n": null, "target": null, "type": null, "text": "約萹。即直顯真源。約教。即一乗顯性"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。此下却將彼喻破之"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。如此等文。徧大乗蔵"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。有餘者。餘義未了也"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛了義實教"}
{"id": null, "n": null, "target": null, "type": null, "text": "大乗法相在生󷓟門。極於三細。大乗破相。在真如門。密顯空義。皆偏淺耳"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋上文義。多依禪詮兼取\n賢首教義章"}
{"id": null, "n": null, "target": null, "type": null, "text": "喻佛智慧"}
{"id": null, "n": null, "target": null, "type": null, "text": "智体無邊廓周法界"}
{"id": null, "n": null, "target": null, "type": null, "text": "喻體上本\n有恒沙功德。恒沙妙用也"}
{"id": null, "n": null, "target": null, "type": null, "text": "喻佛智全在眾生身中圎滿具足也"}
{"id": null, "n": null, "target": null, "type": null, "text": "举一眾生\n為例"}
{"id": null, "n": null, "target": null, "type": null, "text": "即同此文一真靈性"}
{"id": null, "n": null, "target": null, "type": null, "text": "上但攝引論文。或引禪詮序為證"}
{"id": null, "n": null, "target": null, "type": null, "text": "善𢙣\n二業其善業在次文"}
{"id": null, "n": null, "target": null, "type": null, "text": "苦樂二報。樂報亦在次文"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注云。會彼所󵘸。以氣為本"}
{"id": null, "n": null, "target": null, "type": null, "text": "二氣不接。万物\n\n塞矣"}
{"id": null, "n": null, "target": null, "type": null, "text": "二氣交感。万物乃通"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "即此文云。天地国邑"}
{"id": null, "n": null, "target": null, "type": null, "text": "即此文云。和合成人"}
{"id": null, "n": null, "target": null, "type": null, "text": "遷師注金師子章"}
{"id": null, "n": null, "target": null, "type": null, "text": "晋嚴觀一法師同譯六十卷。唐實叉難𨹔譯八十卷。又唐烏茶進本澄觀法\n\n師譯四十卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "以此寺奉金書經。故俗稱高麗寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "己亥"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X58n1031_p0719b13"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T45n1886_p0709b10"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T45n1884_p0684a06"}
{"id": null, "n": "0001b0301", "target": "#nkr_note_add_0001b0301", "type": "add", "text": "杭【CB】，󷳌【國圖】"}
{"id": null, "n": "0003b0401", "target": "#nkr_note_add_0003b0401", "type": "add", "text": "博【CB】，慱【國圖】"}
{"id": null, "n": "0004b0101", "target": "#nkr_note_add_0004b0101", "type": "add", "text": "夏【CB】，复【國圖】"}
{"id": null, "n": "0005a0101", "target": "#nkr_note_add_0005a0101", "type": "add", "text": "負【CB】，屓【國圖】"}
{"id": null, "n": "0005b0701", "target": "#nkr_note_add_0005b0701", "type": "add", "text": "已【CB】，巳【國圖】"}
{"id": null, "n": "0006b0501", "target": "#nkr_note_add_0006b0501", "type": "add", "text": "但【CB】，伹【國圖】"}
{"id": null, "n": "0007b0401", "target": "#nkr_note_add_0007b0401", "type": "add", "text": "博【CB】，慱【國圖】"}
{"id": null, "n": "0007b0402", "target": "#nkr_note_add_0007b0402", "type": "add", "text": "已【CB】，巳【國圖】"}
{"id": null, "n": "0007b0403", "target": "#nkr_note_add_0007b0403", "type": "add", "text": "博【CB】，慱【國圖】"}
{"id": null, "n": "0007b0601", "target": "#nkr_note_add_0007b0601", "type": "add", "text": "已【CB】，巳【國圖】"}
{"id": null, "n": "0008b0101", "target": "#nkr_note_add_0008b0101", "type": "add", "text": "但【CB】，伹【國圖】"}
{"id": null, "n": "0008b0201", "target": "#nkr_note_add_0008b0201", "type": "add", "text": "但【CB】，伹【國圖】"}
{"id": null, "n": "0008b1001", "target": "#nkr_note_add_0008b1001", "type": "add", "text": "已【CB】，巳【國圖】"}
{"id": null, "n": "0009a0101", "target": "#nkr_note_add_0009a0101", "type": "add", "text": "但【CB】，伹【國圖】"}
