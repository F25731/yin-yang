{"id": null, "n": "0022008", "target": null, "type": "orig", "text": "印＝故【乙】"}
{"id": null, "n": "0022008", "target": null, "type": "mod", "text": "印【大】，故【乙】"}
{"id": null, "n": "0022009", "target": null, "type": "orig", "text": "故＋（念本尊真言捻一珠過已）【乙】"}
{"id": null, "n": "0022009", "target": null, "type": "mod", "text": "故【大】，故念本尊真言捻一珠過已【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T19n0922_p0021c14"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T18n0893bp0634b15"}
{"id": null, "n": null, "target": null, "type": "cf3", "text": "T18n0893cp0664a01"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T19n0922_p0021a26"}
{"id": null, "n": "0020023", "target": "#nkr_note_mod_0020023", "type": "mod", "text": "軌【大】，軌一行阿闍梨撰集【校異-原】，軌一行阿闍梨詮集【乙】"}
{"id": null, "n": "0020024", "target": "#nkr_note_mod_0020024", "type": "mod", "text": "密【大】，蜜【丙】"}
{"id": null, "n": "0020025", "target": "#nkr_note_mod_0020025", "type": "mod", "text": "像【大】，形【校異-原】"}
{"id": null, "n": "0020026", "target": "#nkr_note_mod_0020026", "type": "mod", "text": "昧【大】，摩【甲】"}
{"id": null, "n": "0020027", "target": "#nkr_note_mod_0020027", "type": "mod", "text": "下【大】，十【甲】【乙】【丙】"}
{"id": null, "n": "0020028", "target": "#nkr_note_mod_0020028", "type": "mod", "text": "密【大】，蜜【乙】"}
{"id": null, "n": "0020029", "target": "#nkr_note_mod_0020029", "type": "mod", "text": "人【大】，者【校異-甲】"}
{"id": null, "n": "0020030", "target": "#nkr_note_mod_0020030", "type": "mod", "text": "娑嚩【大】，莎【乙】"}
{"id": null, "n": "0020031", "target": "#nkr_note_mod_0020031", "type": "mod", "text": "引【大】，〔－〕【乙】"}
{"id": null, "n": "0021001", "target": "#nkr_note_mod_0021001", "type": "mod", "text": "陵【大】，淩【甲】【丙】"}
{"id": null, "n": "0021002", "target": "#nkr_note_mod_0021002", "type": "mod", "text": "時【大】，事【校異-原】，等【乙】"}
{"id": null, "n": "0021003", "target": "#nkr_note_mod_0021003", "type": "mod", "text": "樂【大】，穩【乙】"}
{"id": null, "n": "0021004a", "target": "#nkr_note_mod_0021004a", "type": "mod", "text": "舒奢摩他輪毘鉢含那持印地念真言加持滿七遍【大】，〔－〕【乙】"}
{"id": null, "n": "0021005", "target": "#nkr_note_mod_0021005", "type": "mod", "text": "含【大】，舍【甲】【丙】"}
{"id": null, "n": "0021004b", "target": "#nkr_note_mod_0021004b", "type": "mod", "text": "轉此雜染所【大】，〔－〕【乙】"}
{"id": null, "n": "0021006", "target": "#nkr_note_mod_0021006", "type": "mod", "text": "引【大】＊，〔－〕【甲】＊"}
{"id": null, "n": "0021007", "target": "#nkr_note_mod_0021007", "type": "mod", "text": "大【大】，本【丙】"}
{"id": null, "n": "0021008", "target": "#nkr_note_mod_0021008", "type": "mod", "text": "攞【大】＊，羅【乙】＊"}
{"id": null, "n": "0021009", "target": "#nkr_note_mod_0021009", "type": "mod", "text": "心【大】，印【乙】"}
{"id": null, "n": "0021010", "target": "#nkr_note_mod_0021010", "type": "mod", "text": "烏瑟【CB】【乙】，瑟【大】"}
{"id": null, "n": "0021011", "target": "#nkr_note_mod_0021011", "type": "mod", "text": "滿【大】＊，曼【乙】＊"}
{"id": null, "n": "0021012", "target": "#nkr_note_mod_0021012", "type": "mod", "text": "麼【大】＊，麼引【考偽-原】，摩【乙】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0021013", "target": "#nkr_note_mod_0021013", "type": "mod", "text": "真言印【大】，印真言【甲】【乙】【丙】"}
{"id": null, "n": "0021014", "target": "#nkr_note_mod_0021014", "type": "mod", "text": "燈明【大】，明燈【乙】【丙】"}
{"id": null, "n": "0021015", "target": "#nkr_note_mod_0021015", "type": "mod", "text": "雲海【大】，海雲【丙】"}
{"id": null, "n": "0021016", "target": "#nkr_note_mod_0021016", "type": "mod", "text": "聖眾【大】，眾聖【乙】【丙】"}
{"id": null, "n": "0021017", "target": "#nkr_note_mod_0021017", "type": "mod", "text": "帝【大】，諦【乙】"}
{"id": null, "n": "0021018", "target": "#nkr_note_mod_0021018", "type": "mod", "text": "以三等力【大】，力以三等【甲】"}
{"id": null, "n": "0021019", "target": "#nkr_note_mod_0021019", "type": "mod", "text": "皆成就【大】，滿功德【乙】"}
{"id": null, "n": "0021020", "target": "#nkr_note_mod_0021020", "type": "mod", "text": "後【大】，次【校異-原】"}
{"id": null, "n": "0021021", "target": "#nkr_note_mod_0021021", "type": "mod", "text": "軌儀【大】，軌則【校異-原】，儀軌【乙】"}
{"id": null, "n": "0021022", "target": "#nkr_note_mod_0021022", "type": "mod", "text": "勝【大】，彼【甲】【乙】【丙】"}
{"id": null, "n": "0021023", "target": "#nkr_note_mod_0021023", "type": "mod", "text": "二合唅【大】＊，〔－〕【丙】，唅【甲】【乙】＊"}
{"id": null, "n": "0021024", "target": "#nkr_note_mod_0021024", "type": "mod", "text": "相【大】，想【乙】【丙】"}
{"id": null, "n": "0021025", "target": "#nkr_note_mod_0021025", "type": "mod", "text": "（曩謨…引）五十二字【大】，如前【乙】"}
{"id": null, "n": "0021026", "target": "#nkr_note_mod_0021026", "type": "mod", "text": "烏【大】，〔－〕【丙】"}
{"id": null, "n": "0021027", "target": "#nkr_note_mod_0021027", "type": "mod", "text": "度諸【大】，願度【甲】【乙】【丙】"}
{"id": null, "n": "0021028", "target": "#nkr_note_mod_0021028", "type": "mod", "text": "大【大】，彼【甲】【乙】【丙】"}
{"id": null, "n": "0022001", "target": "#nkr_note_mod_0022001", "type": "mod", "text": "去【大】，〔－〕【甲】【乙】【丙】"}
{"id": null, "n": "0022002", "target": "#nkr_note_mod_0022002", "type": "mod", "text": "一以下記數甲乙丙三本俱無次同"}
{"id": null, "n": "0022003", "target": "#nkr_note_mod_0022003", "type": "mod", "text": "百八【大】，八百【丙】"}
{"id": null, "n": "0022004", "target": "#nkr_note_mod_0022004", "type": "mod", "text": "矚【大】，屬【甲】【乙】【丙】"}
{"id": null, "n": "0022005", "target": "#nkr_note_mod_0022005", "type": "mod", "text": "內【大】，內當心念真言【甲】【乙】【丙】"}
{"id": null, "n": "0022006", "target": "#nkr_note_mod_0022006", "type": "mod", "text": "遍【大】，寶【乙】"}
{"id": null, "n": "0022007", "target": "#nkr_note_mod_0022007", "type": "mod", "text": "（由此…故）十字【大】，〔－〕【丙】"}
{"id": null, "n": "0022008", "target": "#nkr_note_mod_0022008", "type": "mod", "text": "印【大】，故【乙】"}
{"id": null, "n": "0022009", "target": "#nkr_note_mod_0022009", "type": "mod", "text": "故【大】，故念本尊真言捻一珠過已【乙】"}
{"id": null, "n": "0022010", "target": "#nkr_note_mod_0022010", "type": "mod", "text": "驀【大】，過驀【乙】"}
{"id": null, "n": "0022011", "target": "#nkr_note_mod_0022011", "type": "mod", "text": "八【大】，〔－〕【乙】"}
{"id": null, "n": "0022012", "target": "#nkr_note_mod_0022012", "type": "mod", "text": "祈求事【大】，求事祈【乙】"}
{"id": null, "n": "0022013", "target": "#nkr_note_mod_0022013", "type": "mod", "text": "善【大】，若【甲】"}
{"id": null, "n": "0022014", "target": "#nkr_note_mod_0022014", "type": "mod", "text": "月【大】，有【乙】"}
{"id": null, "n": "0022015", "target": "#nkr_note_mod_0022015", "type": "mod", "text": "燈【大】，燃【乙】"}
{"id": null, "n": "0022016", "target": "#nkr_note_mod_0022016", "type": "mod", "text": "菓子【大】，〔－〕【乙】"}
{"id": null, "n": "0022017", "target": "#nkr_note_mod_0022017", "type": "mod", "text": "囉【大】，〔－〕【乙】"}
{"id": null, "n": "0022018", "target": "#nkr_note_mod_0022018", "type": "mod", "text": "羅婆【大】，波【乙】"}
{"id": null, "n": "0022019", "target": "#nkr_note_mod_0022019", "type": "mod", "text": "持【大】，特【校異-原】"}
{"id": null, "n": "0022020", "target": "#nkr_note_mod_0022020", "type": "mod", "text": "流【大】，留【校異-原】"}
{"id": null, "n": "0022021", "target": "#nkr_note_mod_0022021", "type": "mod", "text": "施【大】，是【校異-原】"}
{"id": null, "n": "0022022", "target": "#nkr_note_mod_0022022", "type": "mod", "text": "娑【大】，娑娑【丙】"}
{"id": null, "n": "0022023", "target": "#nkr_note_mod_0022023", "type": "mod", "text": "復【大】，後【乙】"}
{"id": null, "n": "0022024", "target": "#nkr_note_mod_0022024", "type": "mod", "text": "殿【大】，殿真言曰【乙】【丙】"}
{"id": null, "n": "0022025", "target": "#nkr_note_mod_0022025", "type": "mod", "text": "野【大】，〔－〕【甲】"}
{"id": null, "n": "0022026", "target": "#nkr_note_mod_0022026", "type": "mod", "text": "契【大】，印【乙】"}
{"id": null, "n": "0022027", "target": "#nkr_note_mod_0022027", "type": "mod", "text": "加持印四處【大】，〔－〕【乙】"}
{"id": null, "n": "0022028", "target": "#nkr_note_mod_0022028", "type": "mod", "text": "復【大】，〔－〕【乙】"}
{"id": null, "n": "0022029", "target": "#nkr_note_mod_0022029", "type": "mod", "text": "印【大】，之印【乙】"}
{"id": null, "n": "0022030", "target": "#nkr_note_mod_0022030", "type": "mod", "text": "如來【大】，〔－〕【丙】"}
{"id": null, "n": "0022031", "target": "#nkr_note_mod_0022031", "type": "mod", "text": "消災除難念誦【大】，〔－〕【乙】"}
{"id": null, "n": "0020022", "target": "#nkr_note_orig_0020022", "type": "orig", "text": "【原】享保十九年刊豐山大學藏本，【甲】永久四年寫高山寺藏本，【乙】高山寺藏古寫本，【丙】端拱二年寫仁和寺藏本"}
{"id": null, "n": "0020023", "target": "#nkr_note_orig_0020023", "type": "orig", "text": "軌＋（一行阿闍梨撰集）ィ【原】，（一行阿闍梨詮集）【乙】"}
