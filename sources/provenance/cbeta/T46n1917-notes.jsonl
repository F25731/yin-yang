{"id": null, "n": "0549001", "target": "#nkr_note_orig_0549001", "type": "orig", "text": "【原】縮刷大藏經"}
{"id": null, "n": "0549b1401", "target": "#nkr_note_add_0549b1401", "type": "add", "text": "受【CB】【金藏乙-CB】，爰【大】"}
{"id": null, "n": "0549b1801", "target": "#nkr_note_add_0549b1801", "type": "add", "text": "想【CB】【金藏乙-CB】，常【大】"}
{"id": null, "n": "0550c0201", "target": "#nkr_note_add_0550c0201", "type": "add", "text": "止【CB】【金藏乙-CB】，心【大】"}
