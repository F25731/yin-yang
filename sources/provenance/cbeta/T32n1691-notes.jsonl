{"id": null, "n": "0787014", "target": "#nkr_note_mod_0787014", "type": "mod", "text": "憂【大】，優【宋】【元】【明】"}
{"id": null, "n": "0787015", "target": "#nkr_note_mod_0787015", "type": "mod", "text": "䔖【大】，菱【宋】【元】【明】"}
{"id": null, "n": "0787016", "target": "#nkr_note_mod_0787016", "type": "mod", "text": "粖【大】下同，末【宋】下同【元】下同【明】下同"}
{"id": null, "n": "0787017", "target": "#nkr_note_mod_0787017", "type": "mod", "text": "憂【大】＊，優【明】＊"}
{"id": null, "n": "0788001", "target": "#nkr_note_mod_0788001", "type": "mod", "text": "叱【大】，吒【宋】【元】【明】"}
