{"id": null, "n": "0450001", "target": "#nkr_note_mod_0450001", "type": "mod", "text": "銀【大】＊，佛說銀【元】【明】＊"}
{"id": null, "n": "0450002", "target": "#nkr_note_mod_0450002", "type": "mod", "text": "三藏【大】，三藏法師【宋】【元】【明】"}
{"id": null, "n": "0450003", "target": "#nkr_note_mod_0450003", "type": "mod", "text": "譯【大】，第二譯【元】【明】"}
{"id": null, "n": "0450004", "target": "#nkr_note_mod_0450004", "type": "mod", "text": "果【大】，界【元】"}
{"id": null, "n": "0450005", "target": "#nkr_note_mod_0450005", "type": "mod", "text": "殊【大】＊，姝【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0450006", "target": "#nkr_note_mod_0450006", "type": "mod", "text": "垢【大】，妬【宋】【元】【明】"}
{"id": null, "n": "0450007", "target": "#nkr_note_mod_0450007", "type": "mod", "text": "戰【大】，顫【宋】【元】【明】"}
{"id": null, "n": "0450008", "target": "#nkr_note_mod_0450008", "type": "mod", "text": "爾【大】，爾時【宋】【元】【明】"}
{"id": null, "n": "0450009", "target": "#nkr_note_mod_0450009", "type": "mod", "text": "女【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0451001", "target": "#nkr_note_mod_0451001", "type": "mod", "text": "髮【大】，鬚【宋】【元】【明】"}
{"id": null, "n": "0451002", "target": "#nkr_note_mod_0451002", "type": "mod", "text": "則【大】，即【宋】【元】【明】"}
{"id": null, "n": "0451003", "target": "#nkr_note_mod_0451003", "type": "mod", "text": "言【大】，云【宋】【元】【明】"}
{"id": null, "n": "0451004", "target": "#nkr_note_mod_0451004", "type": "mod", "text": "唯【大】，惟【宋】【元】【明】"}
{"id": null, "n": "0451005", "target": "#nkr_note_mod_0451005", "type": "mod", "text": "言【大】，曰【宋】【元】【明】"}
{"id": null, "n": "0452001", "target": "#nkr_note_mod_0452001", "type": "mod", "text": "異【大】，餘【宋】【元】【明】"}
