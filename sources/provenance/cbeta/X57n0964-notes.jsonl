{"id": null, "n": "0132002", "target": "#nkr_note_orig_0132002", "type": "orig", "text": "句上佚失十九行行二十字"}
{"id": null, "n": "0133001", "target": "#nkr_note_orig_0133001", "type": "orig", "text": "別約二字疑可作麤書"}
