{"id": null, "n": null, "target": null, "type": null, "text": "五、八、九、十七、二十二、四十一"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "文出九下云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "恐義難曉，更以圖示之如後。"}
{"id": null, "n": null, "target": null, "type": null, "text": "三十五、三十六、三十七、三十八"}
