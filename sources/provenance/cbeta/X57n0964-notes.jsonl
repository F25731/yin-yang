{"id": null, "n": "0161002", "target": "#nkr_note_orig_0161002", "type": "orig", "text": "今疑令"}
{"id": null, "n": "0161003", "target": "#nkr_note_orig_0161003", "type": "orig", "text": "也下佚失四十行行二十字"}
{"id": null, "n": "0163001", "target": "#nkr_note_orig_0163001", "type": "orig", "text": "此下佚失"}
{"id": null, "n": "0176001", "target": "#nkr_note_orig_0176001", "type": "orig", "text": "通疑道"}
