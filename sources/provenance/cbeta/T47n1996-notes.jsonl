{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "善應殊宗吾不知也思之"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "是則俱行，非則擒下"}
{"id": null, "n": null, "target": null, "type": null, "text": "不慚問者為我留之"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "咄"}
{"id": null, "n": null, "target": null, "type": null, "text": "鼎禪之句"}
{"id": null, "n": null, "target": null, "type": null, "text": "使君早製圓明鑑圖冠之序引，或聞或見令人曠達"}
{"id": null, "n": null, "target": null, "type": null, "text": "黃中"}
{"id": null, "n": null, "target": null, "type": null, "text": "楊"}
{"id": null, "n": null, "target": null, "type": null, "text": "千理之外應之，非此則殊待者也"}
{"id": null, "n": null, "target": null, "type": null, "text": "理出情謂宜撫掌爾"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
