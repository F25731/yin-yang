{"id": null, "n": null, "target": null, "type": null, "text": "云：「國無二君。」又云：「知麼？」"}
{"id": null, "n": null, "target": null, "type": null, "text": "云：「風行草偃。」又云：\n「直與。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "云：「四顧匪絕。」又云：「看。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "云：「獨露相倚。」又云：「嶮。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "云：「一西一東。」又云：「大難。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "云：「自南自北。」又云：\n「會也。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "云：「聞莫舉頭。」又云：「呵呵。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "云：「見應合眼。」又云：\n「撫掌。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "云：「豈可徒然。」又云：「吁。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "云：「事非草草。」又云：「苦。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "云：「去去誰同。」又云：「好住。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "云：「須到如此。」又云：\n「努力。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "斯句乃宗禪者離山日有作"}
{"id": null, "n": null, "target": null, "type": null, "text": "誰是能舉"}
{"id": null, "n": null, "target": null, "type": null, "text": "惜取眉毛"}
{"id": null, "n": null, "target": null, "type": null, "text": "作麼生"}
{"id": null, "n": null, "target": null, "type": null, "text": "且欵欵"}
{"id": null, "n": null, "target": null, "type": null, "text": "撫掌呵呵"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦未相許"}
{"id": null, "n": null, "target": null, "type": null, "text": "展開兩手"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈却了也"}
{"id": null, "n": null, "target": null, "type": null, "text": "捨短從長"}
{"id": null, "n": null, "target": null, "type": null, "text": "以頭換尾"}
{"id": null, "n": null, "target": null, "type": null, "text": "這箇\n是拄杖子"}
{"id": null, "n": null, "target": null, "type": null, "text": "莫錯認定盤星"}
{"id": null, "n": null, "target": null, "type": null, "text": "豈辨開眸"}
{"id": null, "n": null, "target": null, "type": null, "text": "還同掩耳"}
{"id": null, "n": null, "target": null, "type": null, "text": "心不負人"}
{"id": null, "n": null, "target": null, "type": null, "text": "口宜掛壁"}
{"id": null, "n": null, "target": null, "type": null, "text": "隨所依"}
{"id": null, "n": null, "target": null, "type": null, "text": "可知也"}
{"id": null, "n": null, "target": null, "type": null, "text": "春水自消"}
{"id": null, "n": null, "target": null, "type": null, "text": "從旦至暮"}
{"id": null, "n": null, "target": null, "type": null, "text": "海晏河清"}
{"id": null, "n": null, "target": null, "type": null, "text": "可憑可據"}
{"id": null, "n": null, "target": null, "type": null, "text": "重報君"}
{"id": null, "n": null, "target": null, "type": null, "text": "好明取"}
{"id": null, "n": null, "target": null, "type": null, "text": "惟我能知"}
{"id": null, "n": null, "target": null, "type": null, "text": "不犯之令"}
{"id": null, "n": null, "target": null, "type": null, "text": "闇必\n可明"}
{"id": null, "n": null, "target": null, "type": null, "text": "明還非覩"}
{"id": null, "n": null, "target": null, "type": null, "text": "一見三"}
{"id": null, "n": null, "target": null, "type": null, "text": "無異說"}
{"id": null, "n": null, "target": null, "type": null, "text": "若為分"}
{"id": null, "n": null, "target": null, "type": null, "text": "不如此"}
{"id": null, "n": null, "target": null, "type": null, "text": "旨爾寧止"}
{"id": null, "n": null, "target": null, "type": null, "text": "縱橫十字"}
{"id": null, "n": null, "target": null, "type": null, "text": "子細看"}
{"id": null, "n": null, "target": null, "type": null, "text": "莫教錯"}
{"id": null, "n": null, "target": null, "type": null, "text": "未兆非明"}
{"id": null, "n": null, "target": null, "type": null, "text": "突出難辨"}
{"id": null, "n": null, "target": null, "type": null, "text": "又何妨"}
{"id": null, "n": null, "target": null, "type": null, "text": "也不惡"}
{"id": null, "n": null, "target": null, "type": null, "text": "唱彌高"}
{"id": null, "n": null, "target": null, "type": null, "text": "和彌寡"}
{"id": null, "n": null, "target": null, "type": null, "text": "聞必同歸"}
{"id": null, "n": null, "target": null, "type": null, "text": "誠哉是言也"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "因矚白雲無󰊊"}
{"id": null, "n": null, "target": null, "type": null, "text": "觀氣分枝，非獨古有，\n誠之言也"}
{"id": null, "n": null, "target": null, "type": null, "text": "咄"}
{"id": null, "n": null, "target": null, "type": null, "text": "五首"}
{"id": null, "n": null, "target": null, "type": null, "text": "三首"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
