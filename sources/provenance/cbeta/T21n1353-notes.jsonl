{"id": null, "n": "0866002", "target": "#nkr_note_orig_0866002", "type": "orig", "text": "【原】麗本，此經宋元明三本俱缺"}
{"id": null, "n": "0866a2201", "target": "#nkr_note_add_0866a2201", "type": "add", "text": "今【CB】【麗-CB】，本【大】"}
{"id": null, "n": "0866c1801", "target": "#nkr_note_add_0866c1801", "type": "add", "text": "譽【CB】【麗-CB】，警【大】"}
