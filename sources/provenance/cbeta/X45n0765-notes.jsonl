{"id": null, "n": null, "target": null, "type": null, "text": "約前\n四相，此當滅相、異相"}
{"id": null, "n": null, "target": null, "type": null, "text": "此下至九地當住相"}
{"id": null, "n": null, "target": null, "type": null, "text": "此當生相"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃因緣"}
{"id": null, "n": null, "target": null, "type": null, "text": "約熏變"}
{"id": null, "n": null, "target": null, "type": null, "text": "前三染盡"}
{"id": null, "n": null, "target": null, "type": null, "text": "後三染盡"}
{"id": null, "n": null, "target": null, "type": null, "text": "丁未"}
{"id": null, "n": null, "target": null, "type": null, "text": "梓行"}
{"id": null, "n": null, "target": null, "type": null, "text": "四卷"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T32n1666_p0581c24"}
{"id": null, "n": "0467004", "target": "#nkr_note_mod_0467004", "type": "mod", "text": "減【CB】，滅【卍續】，滅ハ減ニツクル。󴦞44．273中。󴦒"}
{"id": null, "n": "0445001", "target": "#nkr_note_orig_0445001", "type": "orig", "text": "大正藏経第44卷所収，「大乘起信論義記」ニオケル法藏依用ノ起信論本文ト照合ス。已下ソノ異同ヲ註ス。心ノ字ナシ。󴦞44．249中。󴦒"}
{"id": null, "n": "0447001", "target": "#nkr_note_orig_0447001", "type": "orig", "text": "法ハ發ニツクル。󴦞44．251中。󴦒"}
{"id": null, "n": "0449001", "target": "#nkr_note_orig_0449001", "type": "orig", "text": "如實ノ二字ナツ。󴦞44．253下。󴦒"}
{"id": null, "n": "0454001", "target": "#nkr_note_orig_0454001", "type": "orig", "text": "𢙼ハ惱ニツクル。󴦞44．261下。󴦒"}
{"id": null, "n": "0455001", "target": "#nkr_note_orig_0455001", "type": "orig", "text": "不離ノ間ニ相ノ字アリ。󴦞44．262中。󴦒"}
{"id": null, "n": "0455002", "target": "#nkr_note_orig_0455002 #note_star_1", "type": "orig", "text": "即ハ則ニツクル。󴦞44．262中。󴦒"}
{"id": null, "n": "0456001", "target": "#nkr_note_orig_0456001", "type": "orig", "text": "果ハ報ニツクル。󴦞44．263中。󴦒"}
{"id": null, "n": "0456002", "target": "#nkr_note_orig_0456002", "type": "orig", "text": "言ノ字ナシ。󴦞44．263下。󴦒"}
{"id": null, "n": "0456003", "target": "#nkr_note_orig_0456003", "type": "orig", "text": "故ノ字ナシ。󴦞44．263下。󴦒"}
{"id": null, "n": "0458001", "target": "#nkr_note_orig_0458001", "type": "orig", "text": "妄心ノ間ニ以ノ字アリ。󴦞44．266上。󴦒"}
{"id": null, "n": "0461001", "target": "#nkr_note_orig_0461001", "type": "orig", "text": "依ノ字ナシ。󴦞44．267下。󴦒"}
{"id": null, "n": "0461002", "target": "#nkr_note_orig_0461002", "type": "orig", "text": "地盡ハ盡地ニツクル。󴦞44．267下。󴦒"}
{"id": null, "n": "0461003", "target": "#nkr_note_orig_0461003", "type": "orig", "text": "（拝ハ并カ。󴦒）"}
{"id": null, "n": "0463001", "target": "#nkr_note_orig_0463001", "type": "orig", "text": "而ハ者則ニツクル。󴦞44．270上。󴦒"}
{"id": null, "n": "0464001", "target": "#nkr_note_orig_0464001", "type": "orig", "text": "心即ノ間ニ以有妄心ノ四字アリ。󴦞44．270中。󴦒"}
{"id": null, "n": "0466001", "target": "#nkr_note_orig_0466001", "type": "orig", "text": "熟則ノ間ニ故ノ字アリ。󴦞44．272中。󴦒"}
{"id": null, "n": "0466002", "target": "#nkr_note_orig_0466002", "type": "orig", "text": "（拝ハ并カ。󴦒）"}
{"id": null, "n": "0467001", "target": "#nkr_note_orig_0467001", "type": "orig", "text": "恒常ハ常恒ニツクル。󴦞44．272下。󴦒"}
{"id": null, "n": "0467002", "target": "#nkr_note_orig_0467002", "type": "orig", "text": "佛智ノ間ニ自體相應得自在業與諸佛ノ十一字アリ。󴦞44．273上。󴦒"}
{"id": null, "n": "0467003", "target": "#nkr_note_orig_0467003", "type": "orig", "text": "差別ノ二字ナシ。󴦞44．273中。󴦒"}
{"id": null, "n": "0467004", "target": "#nkr_note_orig_0467004", "type": "orig", "text": "滅ハ減ニツクル。󴦞44．273中。󴦒"}
{"id": null, "n": "0470001", "target": "#nkr_note_orig_0470001", "type": "orig", "text": "無去無來ハ無來無去ニツクル。󴦞44．275下。󴦒"}
{"id": null, "n": "0471001", "target": "#nkr_note_orig_0471001", "type": "orig", "text": "空本來ハ空從本已來ニツクル。󴦞44．277上。󴦒"}
{"id": null, "n": "0472001", "target": "#nkr_note_orig_0472001", "type": "orig", "text": "者無ノ間ニ則ノ字アリ。󴦞44．277中。󴦒"}
{"id": null, "n": "0472002", "target": "#nkr_note_orig_0472002", "type": "orig", "text": "即外ノ間ニ是ノ字アリ。󴦞44．277下。󴦒"}
{"id": null, "n": "0472003", "target": "#nkr_note_orig_0472003", "type": "orig", "text": "槃ノ下，故ノ字アリ。󴦞44．277下。󴦒"}
{"id": null, "n": "0473001", "target": "#nkr_note_orig_0473001", "type": "orig", "text": "法ハ發ニツクル。󴦞44．278上。󴦒"}
{"id": null, "n": "0474001", "target": "#nkr_note_orig_0474001", "type": "orig", "text": "垢染ハ染垢ニツクル。󴦞44．279上。󴦒"}
{"id": null, "n": "0474002", "target": "#nkr_note_orig_0474002", "type": "orig", "text": "量徧ノ間ニ無邊ノ二字アリ。󴦞44．279上。󴦒"}
{"id": null, "n": "0475001", "target": "#nkr_note_orig_0475001", "type": "orig", "text": "祗當ノ間ニ劫ノ字アリ。󴦞44．280下。󴦒"}
{"id": null, "n": "0476001", "target": "#nkr_note_orig_0476001", "type": "orig", "text": "能了ノ間ニ決ノ字アリ。󴦞44．281中。󴦒"}
{"id": null, "n": "0477001", "target": "#nkr_note_orig_0477001", "type": "orig", "text": "故說ノ間ニ而ノ字アリ。󴦞44．281中。󴦒"}
{"id": null, "n": "0477002", "target": "#nkr_note_orig_0477002", "type": "orig", "text": "聚ノ字ナシ。󴦞44．281下。󴦒"}
{"id": null, "n": "0477003", "target": "#nkr_note_orig_0477003", "type": "orig", "text": "哀ハ衰ニツクル。󴦞44．282中。󴦒"}
{"id": null, "n": "0478001", "target": "#nkr_note_orig_0478001", "type": "orig", "text": "修信ノ間ニ行ノ字アリ。󴦞44．282中。󴦒"}
{"id": null, "n": "0478002", "target": "#nkr_note_orig_0478002", "type": "orig", "text": "想ハ相ニツクル。󴦞44．283中。󴦒"}
{"id": null, "n": "0478003", "target": "#nkr_note_orig_0478003", "type": "orig", "text": "亦不ノ間ニ常ノ字アリ。󴦞44．283下。󴦒"}
{"id": null, "n": "0479001", "target": "#nkr_note_orig_0479001", "type": "orig", "text": "若ハ或ニツクル。󴦞44．284中。󴦒"}
{"id": null, "n": "0479002", "target": "#nkr_note_orig_0479002", "type": "orig", "text": "也ノ字ナシ。󴦞44．284中。󴦒"}
{"id": null, "n": "0479003", "target": "#nkr_note_orig_0479003", "type": "orig", "text": "更ハ便ニツクル。󴦞44．284下。󴦒"}
{"id": null, "n": "0479004", "target": "#nkr_note_orig_0479004", "type": "orig", "text": "饑ハ飢ニツクル。󴦞44．284下。󴦒"}
{"id": null, "n": "0480001", "target": "#nkr_note_orig_0480001", "type": "orig", "text": "或令ノ間ニ亦ノ字アリ。󴦞44．284下。󴦒"}
{"id": null, "n": "0480002", "target": "#nkr_note_orig_0480002", "type": "orig", "text": "三ハ二ニツクル。󴦞44．285中。󴦒"}
{"id": null, "n": "0481001", "target": "#nkr_note_orig_0481001", "type": "orig", "text": "起ハ坐ニツクル。󴦞44．286上。󴦒"}
{"id": null, "n": "0481002", "target": "#nkr_note_orig_0481002", "type": "orig", "text": "臥皆ノ間ニ若起ノ二字アリ。󴦞44．286上。󴦒"}
{"id": null, "n": "0482001", "target": "#nkr_note_orig_0482001", "type": "orig", "text": "觀門ノ間ニ二ノ字アリ。󴦞44．286中。󴦒"}
{"id": null, "n": "0482002", "target": "#nkr_note_orig_0482002", "type": "orig", "text": "世ハ深ニツクル。󴦞44．286下。󴦒"}
{"id": null, "n": "0482003", "target": "#nkr_note_orig_0482003", "type": "orig", "text": "得ノ字ナシ。󴦞44．287上。󴦒"}
{"id": null, "n": "0484001", "target": "#nkr_note_orig_0484001", "type": "orig", "text": "旧版ハ起信論疏略ヲ略シテ省ク。今之ヲ出スコト前ノ如シ。󴦒"}
