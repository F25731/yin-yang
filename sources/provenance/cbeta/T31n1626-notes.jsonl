{"id": null, "n": null, "target": null, "type": "cf1", "text": "K17n0640_p0797a09"}
{"id": null, "n": "0892004", "target": "#nkr_note_mod_0892004", "type": "mod", "text": "大唐于闐三藏【大】，唐三藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0892005", "target": "#nkr_note_mod_0892005", "type": "mod", "text": "譯【大】，奉制譯【宋】【元】【明】【宮】"}
{"id": null, "n": "0892006", "target": "#nkr_note_mod_0892006", "type": "mod", "text": "住【大】，位【宋】【元】【明】【宮】"}
{"id": null, "n": "0892007", "target": "#nkr_note_mod_0892007", "type": "mod", "text": "即【大】，則【宋】【元】【明】【宮】"}
{"id": null, "n": "0892008", "target": "#nkr_note_mod_0892008", "type": "mod", "text": "為【大】，〔－〕【明】"}
{"id": null, "n": "0892009", "target": "#nkr_note_mod_0892009", "type": "mod", "text": "涅盤【大】下同，涅槃【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0892010", "target": "#nkr_note_mod_0892010", "type": "mod", "text": "於【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0892011", "target": "#nkr_note_mod_0892011", "type": "mod", "text": "如【大】，因【宋】【元】【明】【宮】"}
{"id": null, "n": "0892012", "target": "#nkr_note_mod_0892012", "type": "mod", "text": "立【大】，〔－〕【宮】"}
{"id": null, "n": "0892013", "target": "#nkr_note_mod_0892013", "type": "mod", "text": "火【大】＊，大【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0892014", "target": "#nkr_note_mod_0892014", "type": "mod", "text": "猶【大】＊，由【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0892015", "target": "#nkr_note_mod_0892015", "type": "mod", "text": "法【大】，性【宋】【元】【明】【宮】"}
{"id": null, "n": "0893001", "target": "#nkr_note_mod_0893001", "type": "mod", "text": "益【大】，為【宮】"}
{"id": null, "n": "0893002", "target": "#nkr_note_mod_0893002", "type": "mod", "text": "即【大】，既【宋】【元】【明】【宮】"}
{"id": null, "n": "0893003", "target": "#nkr_note_mod_0893003", "type": "mod", "text": "癡愚【大】，愚癡【宋】【元】【明】【宮】"}
{"id": null, "n": "0893004", "target": "#nkr_note_mod_0893004", "type": "mod", "text": "真【大】，好【宋】【元】【明】【宮】"}
{"id": null, "n": "0894001", "target": "#nkr_note_mod_0894001", "type": "mod", "text": "曰【大】，言【宋】【元】【明】【宮】"}
{"id": null, "n": "0894002", "target": "#nkr_note_mod_0894002", "type": "mod", "text": "有【大】，言【元】【明】"}
{"id": null, "n": "0894003", "target": "#nkr_note_mod_0894003", "type": "mod", "text": "見【大】，知見【宋】【元】【明】【宮】"}
{"id": null, "n": "0892004", "target": "#nkr_note_orig_0892004", "type": "orig", "text": "大唐于闐三藏＝唐三藏法師【三】【宮】"}
{"id": null, "n": "0892005", "target": "#nkr_note_orig_0892005", "type": "orig", "text": "（奉制）＋譯【三】【宮】"}
{"id": null, "n": "0892006", "target": "#nkr_note_orig_0892006", "type": "orig", "text": "住＝位【三】【宮】"}
{"id": null, "n": "0892007", "target": "#nkr_note_orig_0892007", "type": "orig", "text": "即＝則【三】【宮】"}
{"id": null, "n": "0892008", "target": "#nkr_note_orig_0892008", "type": "orig", "text": "〔為〕－【明】"}
{"id": null, "n": "0892009", "target": "#nkr_note_orig_0892009", "type": "orig", "text": "涅盤＝涅槃【三】【宮】下同"}
{"id": null, "n": "0892010", "target": "#nkr_note_orig_0892010", "type": "orig", "text": "〔於〕－【三】【宮】"}
{"id": null, "n": "0892011", "target": "#nkr_note_orig_0892011", "type": "orig", "text": "如＝因【三】【宮】"}
{"id": null, "n": "0892012", "target": "#nkr_note_orig_0892012", "type": "orig", "text": "〔立〕－【宮】"}
{"id": null, "n": "0892013", "target": "#nkr_note_orig_0892013", "type": "orig", "text": "火＝大【三】【宮】＊"}
{"id": null, "n": "0892014", "target": "#nkr_note_orig_0892014", "type": "orig", "text": "猶＝由【三】【宮】＊"}
{"id": null, "n": "0892015", "target": "#nkr_note_orig_0892015", "type": "orig", "text": "法＝性【三】【宮】"}
{"id": null, "n": "0893001", "target": "#nkr_note_orig_0893001", "type": "orig", "text": "益＝為【宮】"}
{"id": null, "n": "0893002", "target": "#nkr_note_orig_0893002", "type": "orig", "text": "即＝既【三】【宮】"}
{"id": null, "n": "0893003", "target": "#nkr_note_orig_0893003", "type": "orig", "text": "癡愚＝愚癡【三】【宮】"}
{"id": null, "n": "0893004", "target": "#nkr_note_orig_0893004", "type": "orig", "text": "真＝好【三】【宮】"}
{"id": null, "n": "0894001", "target": "#nkr_note_orig_0894001", "type": "orig", "text": "曰＝言【三】【宮】"}
{"id": null, "n": "0894002", "target": "#nkr_note_orig_0894002", "type": "orig", "text": "有＝言【元】【明】"}
{"id": null, "n": "0894003", "target": "#nkr_note_orig_0894003", "type": "orig", "text": "（知）＋見【三】【宮】"}
{"id": null, "n": "0894004", "target": "#nkr_note_orig_0894004", "type": "orig", "text": "此記宋元明宮四本俱無"}
