{"id": null, "n": null, "target": null, "type": "cf1", "text": "K06n0050_p1337a22"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T04n0202_p0359b07"}
{"id": null, "n": "0186008", "target": "#nkr_note_mod_0186008", "type": "mod", "text": "國【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0186009", "target": "#nkr_note_mod_0186009", "type": "mod", "text": "所問者乃敢陳之【大】，敢有所問【宋】【元】【明】【宮】"}
{"id": null, "n": "0186010", "target": "#nkr_note_mod_0186010", "type": "mod", "text": "並【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0186011", "target": "#nkr_note_mod_0186011", "type": "mod", "text": "根之相【大】，相之根【宋】【元】【明】【宮】"}
{"id": null, "n": "0186012", "target": "#nkr_note_mod_0186012", "type": "mod", "text": "智【大】，智地【宋】【元】【明】【宮】"}
{"id": null, "n": "0186013", "target": "#nkr_note_mod_0186013", "type": "mod", "text": "諸眾會【CB】【麗-CB】，諸會【大】，眾會【宋】【元】【明】【宮】"}
{"id": null, "n": "0186014", "target": "#nkr_note_mod_0186014", "type": "mod", "text": "大【大】，佛說大【宋】【元】【明】【宮】"}
{"id": null, "n": "0186008", "target": "#nkr_note_orig_0186008", "type": "orig", "text": "〔國〕－【三】【宮】"}
{"id": null, "n": "0186009", "target": "#nkr_note_orig_0186009", "type": "orig", "text": "所問者乃敢陳之＝敢有所問【三】【宮】"}
{"id": null, "n": "0186010", "target": "#nkr_note_orig_0186010", "type": "orig", "text": "〔並〕－【三】【宮】"}
{"id": null, "n": "0186011", "target": "#nkr_note_orig_0186011", "type": "orig", "text": "根之相＝相之根【三】【宮】"}
{"id": null, "n": "0186012", "target": "#nkr_note_orig_0186012", "type": "orig", "text": "智＋（地）【三】【宮】"}
{"id": null, "n": "0186013", "target": "#nkr_note_orig_0186013", "type": "orig", "text": "諸會＝眾會【三】【宮】"}
{"id": null, "n": "0186014", "target": "#nkr_note_orig_0186014", "type": "orig", "text": "（佛說）＋大【三】【宮】"}
