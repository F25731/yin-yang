{"id": null, "n": null, "target": null, "type": null, "text": "竪拂子"}
{"id": null, "n": null, "target": null, "type": null, "text": "良久，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "以拂子擊禪床左邊，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "擊右邊，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "中間劃一劃，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "東林有此二扁。"}
{"id": null, "n": null, "target": null, "type": null, "text": "咄！"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈一下，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "拈主丈"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓一下"}
