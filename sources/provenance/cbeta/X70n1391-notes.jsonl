{"id": null, "n": null, "target": null, "type": null, "text": "拈主丈卓一下，云"}
{"id": null, "n": null, "target": null, "type": null, "text": "師拈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈一下，\n云："}
{"id": null, "n": null, "target": null, "type": null, "text": "師拈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈主丈"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓一下"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈\n一下"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈\n主丈卓一下，云"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈主丈卓一下"}
{"id": null, "n": null, "target": null, "type": null, "text": "又卓一下，云"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈主丈畫一畫"}
{"id": null, "n": null, "target": null, "type": null, "text": "下座，移步，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "拈主丈，召大眾，云"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓一下，云"}
{"id": null, "n": null, "target": null, "type": null, "text": "竪拂子云"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈主丈召大眾云"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓\n一下云"}
{"id": null, "n": null, "target": null, "type": null, "text": "以拂子\n指屋角，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "驀拈主丈卓一下，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "驀拈主丈卓\n一下，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "遂\n咳𠻳一聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈主丈顧視云"}
{"id": null, "n": null, "target": null, "type": null, "text": "靠主丈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈主丈卓一下，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "又卓一下，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "舉起主丈，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "卓一下，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "拈主丈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓一下云"}
{"id": null, "n": null, "target": null, "type": null, "text": "良久，云"}
{"id": null, "n": null, "target": null, "type": null, "text": "顧視左右，云"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈主丈卓一下，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "卓一下"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈主丈召大眾"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓一下云"}
{"id": null, "n": null, "target": null, "type": null, "text": "畫一畫云"}
{"id": null, "n": null, "target": null, "type": null, "text": "靠主丈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "驀拈主丈"}
{"id": null, "n": null, "target": null, "type": null, "text": "遂靠丈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "良久，云"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈主丈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "擲下主丈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "伸出手，云"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈主丈召大眾，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "肩主丈下座，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "拈主丈召大眾，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "卓一下，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣石田"}
{"id": null, "n": null, "target": null, "type": null, "text": "號海山"}
{"id": null, "n": null, "target": null, "type": null, "text": "良久"}
{"id": null, "n": null, "target": null, "type": null, "text": "召大眾，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "良久，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "時寓磨院"}
{"id": null, "n": null, "target": null, "type": null, "text": "拍禪\n床"}
{"id": null, "n": null, "target": null, "type": null, "text": "竪拂，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "擊禪床，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "拈主丈，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "擲下主丈，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "拈主丈，云"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓一下"}
{"id": null, "n": null, "target": null, "type": null, "text": "驀拈主\n丈召大眾，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "劃一劃"}
{"id": null, "n": null, "target": null, "type": null, "text": "驀拈主丈擲下，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "召大眾云"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈主丈召大眾云："}
{"id": null, "n": null, "target": null, "type": null, "text": "擲下云："}
{"id": null, "n": null, "target": null, "type": null, "text": "驀拈主丈卓一下，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "拈主丈召大眾云"}
{"id": null, "n": null, "target": null, "type": null, "text": "竪拂子，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "拈主\n丈"}
{"id": null, "n": null, "target": null, "type": null, "text": "竪起云"}
{"id": null, "n": null, "target": null, "type": null, "text": "擲下云"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈主丈卓一下，\n云"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈主丈召大眾"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓一下"}
{"id": null, "n": null, "target": null, "type": null, "text": "擲下，主\n丈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "善別寶"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "自徑山來"}
{"id": null, "n": null, "target": null, "type": null, "text": "白楊順語龍門三自省語"}
{"id": null, "n": null, "target": null, "type": null, "text": "自平江來"}
{"id": null, "n": null, "target": null, "type": null, "text": "在鴈山"}
{"id": null, "n": null, "target": null, "type": null, "text": "長靈和尚小師"}
{"id": null, "n": null, "target": null, "type": null, "text": "新建栽松採樵局扁"}
{"id": null, "n": null, "target": null, "type": null, "text": "舊為書雪寄鰲店接待一扁"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "骨撒金山江中"}
{"id": null, "n": null, "target": null, "type": null, "text": "踏蘆"}
{"id": null, "n": null, "target": null, "type": null, "text": "躡蓮書觀經當衣文"}
{"id": null, "n": null, "target": null, "type": null, "text": "坐吉祥草"}
{"id": null, "n": null, "target": null, "type": null, "text": "海中有一龍擎頭"}
{"id": null, "n": null, "target": null, "type": null, "text": "抱膝坐巖淨瓶有柳"}
{"id": null, "n": null, "target": null, "type": null, "text": "提籃"}
{"id": null, "n": null, "target": null, "type": null, "text": "坐獅子"}
{"id": null, "n": null, "target": null, "type": null, "text": "看經"}
{"id": null, "n": null, "target": null, "type": null, "text": "半身仰視橫杖"}
{"id": null, "n": null, "target": null, "type": null, "text": "指空中佛"}
{"id": null, "n": null, "target": null, "type": null, "text": "挑布袋回頭"}
{"id": null, "n": null, "target": null, "type": null, "text": "回頭拽布袋"}
{"id": null, "n": null, "target": null, "type": null, "text": "倚丈看經"}
{"id": null, "n": null, "target": null, "type": null, "text": "手執蓮經"}
{"id": null, "n": null, "target": null, "type": null, "text": "有水"}
{"id": null, "n": null, "target": null, "type": null, "text": "作一團眠地有苕帚"}
{"id": null, "n": null, "target": null, "type": null, "text": "題崖"}
{"id": null, "n": null, "target": null, "type": null, "text": "磨墨"}
{"id": null, "n": null, "target": null, "type": null, "text": "持荷葉"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "破衲橫肩作穿針勢"}
{"id": null, "n": null, "target": null, "type": null, "text": "開卷掩面"}
{"id": null, "n": null, "target": null, "type": null, "text": "柳樹下放猪頭在地手把扇子"}
{"id": null, "n": null, "target": null, "type": null, "text": "扇置地"}
{"id": null, "n": null, "target": null, "type": null, "text": "以手書空"}
{"id": null, "n": null, "target": null, "type": null, "text": "把數珠"}
{"id": null, "n": null, "target": null, "type": null, "text": "枯樹下"}
{"id": null, "n": null, "target": null, "type": null, "text": "擲錫一人在旁仰視笑"}
{"id": null, "n": null, "target": null, "type": null, "text": "無船脇橈合掌立"}
{"id": null, "n": null, "target": null, "type": null, "text": "舟中把釣"}
{"id": null, "n": null, "target": null, "type": null, "text": "政黃牛船子"}
{"id": null, "n": null, "target": null, "type": null, "text": "泉大道繫虵嚴陽尊者虎"}
{"id": null, "n": null, "target": null, "type": null, "text": "趙州指牛跡平田婆子"}
{"id": null, "n": null, "target": null, "type": null, "text": "政黃牛圖澤"}
{"id": null, "n": null, "target": null, "type": null, "text": "側有交椅"}
{"id": null, "n": null, "target": null, "type": null, "text": "吉祥嗣法大宗師請"}
{"id": null, "n": null, "target": null, "type": null, "text": "為源靈叟贊"}
{"id": null, "n": null, "target": null, "type": null, "text": "前清凉"}
{"id": null, "n": null, "target": null, "type": null, "text": "寫師像并自真同憩松下乞贊"}
{"id": null, "n": null, "target": null, "type": null, "text": "携竹杖"}
{"id": null, "n": null, "target": null, "type": null, "text": "擲火"}
{"id": null, "n": null, "target": null, "type": null, "text": "以火把打圓相"}
{"id": null, "n": null, "target": null, "type": null, "text": "又打圓相"}
{"id": null, "n": null, "target": null, "type": null, "text": "外國人"}
{"id": null, "n": null, "target": null, "type": null, "text": "撫一下"}
{"id": null, "n": null, "target": null, "type": null, "text": "患癩死"}
{"id": null, "n": null, "target": null, "type": null, "text": "某人撫棺一下"}
{"id": null, "n": null, "target": null, "type": null, "text": "厶人"}
{"id": null, "n": null, "target": null, "type": null, "text": "竪火把"}
{"id": null, "n": null, "target": null, "type": null, "text": "十月初三"}
{"id": null, "n": null, "target": null, "type": null, "text": "擲火把"}
{"id": null, "n": null, "target": null, "type": null, "text": "擲下火"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "日本東福聖一國師年譜載"}
{"id": null, "n": null, "target": null, "type": null, "text": "聖一年譜云：建長七年，師五十四歲。三月，藤丞相實經親書法華等四經，總三十二卷。師勸捨\n徑山正續院。時惠西巖住天童，便作日本國丞相藤原公捨經之記，以刻于石。"}
