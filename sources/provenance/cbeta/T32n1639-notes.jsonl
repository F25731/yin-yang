{"id": null, "n": null, "target": null, "type": "cf1", "text": "K17n0645_p0809a02"}
{"id": null, "n": "0155002", "target": "#nkr_note_mod_0155002", "type": "mod", "text": "提婆菩薩造【CB】【麗-CB】，提波菩薩造【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0155003", "target": "#nkr_note_mod_0155003", "type": "mod", "text": "後魏北印度三藏【大】，元魏三藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0155004", "target": "#nkr_note_mod_0155004", "type": "mod", "text": "流【大】，留【宋】【元】【宮】"}
{"id": null, "n": "0155005", "target": "#nkr_note_mod_0155005", "type": "mod", "text": "犍【大】＊，揵【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0155006", "target": "#nkr_note_mod_0155006", "type": "mod", "text": "疊【大】下同，㲲【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0155007", "target": "#nkr_note_mod_0155007", "type": "mod", "text": "曰【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0155008", "target": "#nkr_note_mod_0155008", "type": "mod", "text": "非【大】，作【元】【明】"}
{"id": null, "n": "0155009", "target": "#nkr_note_mod_0155009", "type": "mod", "text": "得【大】，得言【宋】【元】【明】【宮】"}
{"id": null, "n": "0155010", "target": "#nkr_note_mod_0155010", "type": "mod", "text": "憂【大】，優【宋】【元】【明】【宮】"}
{"id": null, "n": "0155011", "target": "#nkr_note_mod_0155011", "type": "mod", "text": "爪【大】＊，抓【宋】【元】【宮】＊"}
{"id": null, "n": "0155012", "target": "#nkr_note_mod_0155012", "type": "mod", "text": "名【大】，多【元】【明】"}
{"id": null, "n": "0156001", "target": "#nkr_note_mod_0156001", "type": "mod", "text": "豆【大】，荳【宋】【元】【明】【宮】"}
{"id": null, "n": "0156002", "target": "#nkr_note_mod_0156002", "type": "mod", "text": "我【大】，譬【宋】【元】【明】"}
{"id": null, "n": "0155002", "target": "#nkr_note_orig_0155002", "type": "orig", "text": "〔提波菩薩造〕－【三】【宮】"}
{"id": null, "n": "0155003", "target": "#nkr_note_orig_0155003", "type": "orig", "text": "後魏北印度三藏＝元魏三藏法師【三】【宮】"}
{"id": null, "n": "0155004", "target": "#nkr_note_orig_0155004", "type": "orig", "text": "流＝留【宋】【元】【宮】"}
{"id": null, "n": "0155005", "target": "#nkr_note_orig_0155005", "type": "orig", "text": "犍＝揵【三】【宮】＊"}
{"id": null, "n": "0155006", "target": "#nkr_note_orig_0155006", "type": "orig", "text": "疊＝㲲【三】【宮】下同"}
{"id": null, "n": "0155007", "target": "#nkr_note_orig_0155007", "type": "orig", "text": "〔曰〕－【三】【宮】"}
{"id": null, "n": "0155008", "target": "#nkr_note_orig_0155008", "type": "orig", "text": "非＝作【元】【明】"}
{"id": null, "n": "0155009", "target": "#nkr_note_orig_0155009", "type": "orig", "text": "得＋（言）【三】【宮】"}
{"id": null, "n": "0155010", "target": "#nkr_note_orig_0155010", "type": "orig", "text": "憂＝優【三】【宮】"}
{"id": null, "n": "0155011", "target": "#nkr_note_orig_0155011", "type": "orig", "text": "爪＝抓【宋】【元】【宮】＊"}
{"id": null, "n": "0155012", "target": "#nkr_note_orig_0155012", "type": "orig", "text": "名＝多【元】【明】"}
{"id": null, "n": "0156001", "target": "#nkr_note_orig_0156001", "type": "orig", "text": "豆＝荳【三】【宮】"}
{"id": null, "n": "0156002", "target": "#nkr_note_orig_0156002", "type": "orig", "text": "我＝譬【三】"}
