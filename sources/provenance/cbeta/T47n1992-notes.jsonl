{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "素潔條然"}
{"id": null, "n": null, "target": null, "type": null, "text": "運機非面目"}
{"id": null, "n": null, "target": null, "type": null, "text": "蕩盡玲瓏性"}
{"id": null, "n": null, "target": null, "type": null, "text": "塵泥自異"}
{"id": null, "n": null, "target": null, "type": null, "text": "玅智理圓容"}
{"id": null, "n": null, "target": null, "type": null, "text": "無間功不立"}
{"id": null, "n": null, "target": null, "type": null, "text": "傍觀審騰距爭功不自傷"}
{"id": null, "n": null, "target": null, "type": null, "text": "全力能負不露頭角"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上是馬祖宗派"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上是洞山宗派"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上是石霜宗派"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上是溈仰宗派"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上是石頭藥山宗派"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上是地藏至雪峯宗派"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上是雲門宗派"}
