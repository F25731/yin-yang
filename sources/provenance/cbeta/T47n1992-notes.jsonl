{"id": null, "n": "0597001", "target": "#nkr_note_mod_0597001", "type": "mod", "text": "將【大】，將莫【考偽-原】"}
{"id": null, "n": "0597002", "target": "#nkr_note_mod_0597002", "type": "mod", "text": "地【大】，他【考偽-原】"}
{"id": null, "n": "0597003", "target": "#nkr_note_mod_0597003", "type": "mod", "text": "決【大】，訣【校異-原】"}
{"id": null, "n": "0599001", "target": "#nkr_note_mod_0599001", "type": "mod", "text": "盡【大】＊，畫【考偽-原】＊"}
{"id": null, "n": "0603001", "target": "#nkr_note_mod_0603001", "type": "mod", "text": "□□【大】，師曰【考偽-原】"}
{"id": null, "n": "0604001", "target": "#nkr_note_mod_0604001", "type": "mod", "text": "數【大】，類【考偽-原】"}
{"id": null, "n": "0605001", "target": "#nkr_note_mod_0605001", "type": "mod", "text": "王【大】，玉【考偽-原】"}
{"id": null, "n": "0605002", "target": "#nkr_note_mod_0605002", "type": "mod", "text": "百【大】，白【考偽-原】"}
{"id": null, "n": "0608001", "target": "#nkr_note_mod_0608001", "type": "mod", "text": "此【大】，不【？】"}
{"id": null, "n": "0609001", "target": "#nkr_note_mod_0609001", "type": "mod", "text": "著【大】，普【考偽-大】"}
{"id": null, "n": "0613001", "target": "#nkr_note_mod_0613001", "type": "mod", "text": "□【大】，魚【考偽-大】"}
{"id": null, "n": "0613002", "target": "#nkr_note_mod_0613002", "type": "mod", "text": "清【大】，青【考偽-原】"}
{"id": null, "n": "0621001", "target": "#nkr_note_mod_0621001", "type": "mod", "text": "矢【大】，失【考偽-原】"}
{"id": null, "n": "0623001", "target": "#nkr_note_mod_0623001", "type": "mod", "text": "垣【大】，坦【考偽-原】"}
{"id": null, "n": "0594001", "target": "#nkr_note_orig_0594001", "type": "orig", "text": "【原】大日本續藏經"}
