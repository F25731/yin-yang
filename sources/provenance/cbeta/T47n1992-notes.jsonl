{"id": null, "n": "0608001", "target": "#nkr_note_orig_0608001", "type": "orig", "text": "此＝不"}
{"id": null, "n": "0609001", "target": "#nkr_note_orig_0609001", "type": "orig", "text": "著＝普？"}
{"id": null, "n": "0613001", "target": "#nkr_note_orig_0613001", "type": "orig", "text": "□＝魚？"}
{"id": null, "n": "0613002", "target": "#nkr_note_orig_0613002", "type": "orig", "text": "清＝青ヵ【原】"}
{"id": null, "n": "0621001", "target": "#nkr_note_orig_0621001", "type": "orig", "text": "矢＝失ヵ【原】"}
{"id": null, "n": "0623001", "target": "#nkr_note_orig_0623001", "type": "orig", "text": "垣＝坦ヵ【原】"}
