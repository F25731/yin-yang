{"id": null, "n": "0597002", "target": "#nkr_note_orig_0597002", "type": "orig", "text": "地＝他ヵ【原】"}
{"id": null, "n": "0597003", "target": "#nkr_note_orig_0597003", "type": "orig", "text": "決＝訣ィ【原】"}
{"id": null, "n": "0599001", "target": "#nkr_note_orig_0599001", "type": "orig", "text": "盡＝畫ヵ【原】＊"}
{"id": null, "n": "0603001", "target": "#nkr_note_orig_0603001", "type": "orig", "text": "□□＝師曰ヵ【原】"}
{"id": null, "n": "0604001", "target": "#nkr_note_orig_0604001", "type": "orig", "text": "數＝類ヵ【原】"}
{"id": null, "n": "0605001", "target": "#nkr_note_orig_0605001", "type": "orig", "text": "王＝玉ヵ【原】"}
