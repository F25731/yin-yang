{"id": null, "n": null, "target": null, "type": "cf1", "text": "《嘉興藏》（日本東京大學綜合圖書館藏正編第58帙第2冊第57圖右欄第10行）"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K11n0272_p0608a03"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "QC033n0276_p0478b01"}
{"id": null, "n": "0816019", "target": "#nkr_note_mod_0816019", "type": "mod", "text": "稻芉【CB】【麗-CB】【磧乙-CB】【宋】【宮】，稻芋【大】下同，稻稈【元】【明】下同"}
{"id": null, "n": "0816020", "target": "#nkr_note_mod_0816020", "type": "mod", "text": "闕譯【大】，失譯【宋】【宮】，失譯人名【元】【明】"}
{"id": null, "n": "0816021", "target": "#nkr_note_mod_0816021", "type": "mod", "text": "彌【大】，其彌【宋】【元】【明】【宮】"}
{"id": null, "n": "0816022", "target": "#nkr_note_mod_0816022", "type": "mod", "text": "汝【大】，佛言汝【宮】"}
{"id": null, "n": "0816023", "target": "#nkr_note_mod_0816023", "type": "mod", "text": "法【大】，法見法【元】【明】"}
{"id": null, "n": "0816024", "target": "#nkr_note_mod_0816024", "type": "mod", "text": "住【大】，住舍利弗言【明】"}
{"id": null, "n": "0816025", "target": "#nkr_note_mod_0816025", "type": "mod", "text": "彌勒【大】，彌勒言【元】"}
{"id": null, "n": "0817001", "target": "#nkr_note_mod_0817001", "type": "mod", "text": "因【大】，因緣【宋】【元】【明】【宮】"}
{"id": null, "n": "0817002", "target": "#nkr_note_mod_0817002", "type": "mod", "text": "入【大】，八【宋】【元】【明】【宮】"}
{"id": null, "n": "0817003", "target": "#nkr_note_mod_0817003", "type": "mod", "text": "見【大】，云何見【宋】【元】【明】【宮】"}
{"id": null, "n": "0817004", "target": "#nkr_note_mod_0817004", "type": "mod", "text": "種【大】＊，種子【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0817005", "target": "#nkr_note_mod_0817005", "type": "mod", "text": "生【大】，生於【宋】【元】【明】"}
{"id": null, "n": "0817006", "target": "#nkr_note_mod_0817006", "type": "mod", "text": "牙【大】下同，芽【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0817007", "target": "#nkr_note_mod_0817007", "type": "mod", "text": "作【大】，作是【宋】【元】【明】【宮】"}
{"id": null, "n": "0817008", "target": "#nkr_note_mod_0817008", "type": "mod", "text": "生【大】，生於【宋】【元】【明】【宮】"}
{"id": null, "n": "0817009", "target": "#nkr_note_mod_0817009", "type": "mod", "text": "得【大】，得生【宋】【元】【明】【宮】"}
{"id": null, "n": "0817010", "target": "#nkr_note_mod_0817010", "type": "mod", "text": "從【大】＊，從爾【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0817012", "target": "#nkr_note_mod_0817012", "type": "mod", "text": "不【大】，不從【宋】【元】【明】【宮】"}
{"id": null, "n": "0817013", "target": "#nkr_note_mod_0817013", "type": "mod", "text": "異【大】，別【宮】"}
{"id": null, "n": "0818001", "target": "#nkr_note_mod_0818001", "type": "mod", "text": "慼【大】，感【宋】【元】【明】【宮】"}
{"id": null, "n": "0818002", "target": "#nkr_note_mod_0818002", "type": "mod", "text": "是名【大】，名為【宋】【元】【明】【宮】"}
{"id": null, "n": "0818003", "target": "#nkr_note_mod_0818003", "type": "mod", "text": "駛【CB】【嘉興乙-CB】【元】【明】＊，駃【大】＊"}
{"id": null, "n": "0818004", "target": "#nkr_note_mod_0818004", "type": "mod", "text": "田【大】，因【宮】"}
{"id": null, "n": "0818005", "target": "#nkr_note_mod_0818005", "type": "mod", "text": "所【大】，數【宋】【元】【明】【宮】"}
{"id": null, "n": "0818006", "target": "#nkr_note_mod_0818006", "type": "mod", "text": "緣【大】，緣生【宋】【元】【明】【宮】"}
{"id": null, "n": "0818007", "target": "#nkr_note_mod_0818007", "type": "mod", "text": "色【大】，名色【宋】【元】【明】【宮】"}
{"id": null, "n": "0818008", "target": "#nkr_note_mod_0818008", "type": "mod", "text": "想【大】，相【宋】【元】【明】【宮】"}
{"id": null, "n": "0818009", "target": "#nkr_note_mod_0818009", "type": "mod", "text": "此【大】，此世【宋】【元】【明】"}
{"id": null, "n": "0818010", "target": "#nkr_note_mod_0818010", "type": "mod", "text": "十【大】，十十【宋】【元】【明】【宮】"}
{"id": null, "n": "0818011", "target": "#nkr_note_mod_0818011", "type": "mod", "text": "忍【大】，思【宋】【元】【明】【宮】"}
{"id": null, "n": "0816019", "target": "#nkr_note_orig_0816019", "type": "orig", "text": "稻芋＝稻芉【宋】【宮】，稻稈【元】【明】下同"}
{"id": null, "n": "0816020", "target": "#nkr_note_orig_0816020", "type": "orig", "text": "闕譯＝失譯【宋】【宮】，失譯人名【元】【明】"}
{"id": null, "n": "0816021", "target": "#nkr_note_orig_0816021", "type": "orig", "text": "（其）＋彌【三】【宮】"}
{"id": null, "n": "0816022", "target": "#nkr_note_orig_0816022", "type": "orig", "text": "（佛言）＋汝【宮】"}
{"id": null, "n": "0816023", "target": "#nkr_note_orig_0816023", "type": "orig", "text": "法＋（見法）【元】【明】"}
{"id": null, "n": "0816024", "target": "#nkr_note_orig_0816024", "type": "orig", "text": "住＋（舍利弗言）【明】"}
{"id": null, "n": "0816025", "target": "#nkr_note_orig_0816025", "type": "orig", "text": "彌勒＋（言）【元】"}
{"id": null, "n": "0817001", "target": "#nkr_note_orig_0817001", "type": "orig", "text": "因＋（緣）【三】【宮】"}
{"id": null, "n": "0817002", "target": "#nkr_note_orig_0817002", "type": "orig", "text": "入＝八【三】【宮】"}
{"id": null, "n": "0817003", "target": "#nkr_note_orig_0817003", "type": "orig", "text": "（云何）＋見【三】【宮】"}
{"id": null, "n": "0817004", "target": "#nkr_note_orig_0817004", "type": "orig", "text": "種＋（子）【三】【宮】＊"}
{"id": null, "n": "0817005", "target": "#nkr_note_orig_0817005", "type": "orig", "text": "生＋（於）【三】"}
{"id": null, "n": "0817006", "target": "#nkr_note_orig_0817006", "type": "orig", "text": "牙＝芽【三】【宮】下同"}
{"id": null, "n": "0817007", "target": "#nkr_note_orig_0817007", "type": "orig", "text": "作＋（是）【三】【宮】"}
{"id": null, "n": "0817008", "target": "#nkr_note_orig_0817008", "type": "orig", "text": "生＋（於）【三】【宮】"}
{"id": null, "n": "0817009", "target": "#nkr_note_orig_0817009", "type": "orig", "text": "得＋（生）【三】【宮】"}
{"id": null, "n": "0817010", "target": "#nkr_note_orig_0817010", "type": "orig", "text": "從＋（爾）【三】【宮】＊"}
{"id": null, "n": "0817011", "target": "#nkr_note_orig_0817011", "type": "orig", "text": "明註曰方南藏作節"}
{"id": null, "n": "0817012", "target": "#nkr_note_orig_0817012", "type": "orig", "text": "不＋（從）【三】【宮】"}
{"id": null, "n": "0817013", "target": "#nkr_note_orig_0817013", "type": "orig", "text": "異＝別【宮】"}
{"id": null, "n": "0818001", "target": "#nkr_note_orig_0818001", "type": "orig", "text": "慼＝感【三】【宮】"}
{"id": null, "n": "0818002", "target": "#nkr_note_orig_0818002", "type": "orig", "text": "是名＝名為【三】【宮】"}
{"id": null, "n": "0818003", "target": "#nkr_note_orig_0818003", "type": "orig", "text": "駃＝駛【元】【明】＊"}
{"id": null, "n": "0818004", "target": "#nkr_note_orig_0818004", "type": "orig", "text": "田＝因【宮】"}
{"id": null, "n": "0818005", "target": "#nkr_note_orig_0818005", "type": "orig", "text": "所＝數【三】【宮】"}
{"id": null, "n": "0818006", "target": "#nkr_note_orig_0818006", "type": "orig", "text": "緣＋（生）【三】【宮】"}
{"id": null, "n": "0818007", "target": "#nkr_note_orig_0818007", "type": "orig", "text": "（名）＋色【三】【宮】"}
{"id": null, "n": "0818008", "target": "#nkr_note_orig_0818008", "type": "orig", "text": "想＝相【三】【宮】"}
{"id": null, "n": "0818009", "target": "#nkr_note_orig_0818009", "type": "orig", "text": "此＋（世）【三】"}
{"id": null, "n": "0818010", "target": "#nkr_note_orig_0818010", "type": "orig", "text": "（十）＋十【三】【宮】"}
{"id": null, "n": "0818011", "target": "#nkr_note_orig_0818011", "type": "orig", "text": "忍＝思【三】【宮】"}
