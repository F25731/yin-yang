{"id": null, "n": null, "target": null, "type": null, "text": "七言四句"}
{"id": null, "n": null, "target": null, "type": null, "text": "七言四句"}
{"id": null, "n": null, "target": null, "type": null, "text": "七言四句　五言四句"}
{"id": null, "n": null, "target": null, "type": null, "text": "七言八句　五言八句"}
{"id": null, "n": null, "target": null, "type": null, "text": "附"}
{"id": null, "n": null, "target": null, "type": null, "text": "附"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣法門人蜀渝州治平寺照衣敬刻\n破山和尚語錄第一卷　玉陽堆藍弘禮禪人對\n　秀水謝禎仙書　嘉興倪天章刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "康熙庚申歲孟春月嘉禾楞嚴寺般若坊藏板"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣法門人蜀渝州治平寺照衣敬刻\n　破山和尚語錄第二卷　堆藍弘禮禪人對\n　秀水謝穎仙書　嘉興倪天章刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "康熙庚申歲孟春月，嘉禾楞嚴寺般若坊藏板"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣法門人　蜀北果州真如寺海液　蜀東巴\n州清涼硐印嵩同刻\n破山和尚語錄第三卷　堆藍弘禮禪人對\n　秀水謝穎仙書　嘉興倪天章刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "康熙庚申歲孟春月，嘉禾楞嚴寺般若坊藏板"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣法門人果州印豁　合州龍游山寂壽同刻\n破山和尚語錄第四卷　堆藍弘禮禪人對\n　秀水謝穎仙書　嘉興倪天章刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "康熙庚申歲孟春月，嘉禾楞嚴寺般若坊識"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣法門人　蜀東渝州華嚴德玉　蜀北州\n報恩印國　渠州白衣禪院通葦　大林禪院\n慶曆　蓬溪蓮蓬山八闈禪院海奎同刻\n破山和尚語錄第五卷　堆藍弘禮禪人對\n　秀水謝穎仙書　嘉興倪天章刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "康熙庚申孟春月吉，嘉禾楞嚴寺般若坊藏板"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣法門人蜀東渝州印萬　鐵鳳山印純同刻\n破山和尚語錄第六卷　堆藍弘禮禪人對\n　秀水謝文英書　嘉興倪天章刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "康熙庚申歲孟春月，嘉郡楞嚴般若坊藏板"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣法門人　蜀北果州東寺性定　蜀東古梁\n州水月禪院性毓　蜀北閬州南部當陽寺惟\n朗　間州寶峰洪慧　射洪金鼇山清果禪院\n通法同刻\n破山和尚語錄第七卷　堆藍弘禮禪人對\n　秀水謝文英書　嘉興倪天章刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "康熙庚申孟春月吉旦，嘉禾楞嚴寺般若坊藏板"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣法門人　蜀龍安府獅子院性道　古果州\n盛山佛巖印顯甲同刻\n破山和尚語錄第八卷　堆藍弘禮禪人對\n　秀水謝文英書　倪君亮子天章刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "康熙庚申年孟春月，禾郡楞嚴寺般若坊附疏"}
{"id": null, "n": null, "target": null, "type": null, "text": "三世法孫　楚武攸　金城山合梅　雪濟峰\n合敏同刻\n破山和尚語錄第九卷　堆藍弘禮禪人對\n　秀水謝文英書　倪君亮子天章刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "康熙庚申年孟春月，嘉禾楞嚴寺般若坊附藏"}
{"id": null, "n": null, "target": null, "type": null, "text": "襄州洞山三世孫發海　辰州黔陽廣福山三\n世孫發傳同刻\n破山和尚語錄第十卷　堆藍弘禮禪人對\n　秀水謝文英書　嘉興倪天章刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "康熙庚申年孟春月吉旦，禾郡楞嚴寺般若坊藏板"}
{"id": null, "n": null, "target": null, "type": null, "text": "三世孫楚鼎州中邑發徹　武攸蟠龍合選\n　蜀芙蓉草堂滄水　夔州開元印尚　內江發通同刻\n破山和尚語錄第十一卷　堆藍弘禮禪人對\n　秀水謝文英書　倪君亮子倪天章刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "康熙庚申歲仲春月吉旦，禾郡楞嚴般若坊藏板"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱射斗"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱錫燦"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱泰來"}
{"id": null, "n": null, "target": null, "type": null, "text": "三世孫蜀梁州石笏山性容　南浦烏龍山清\n亮　後池埧崇聖菴發聖　楚武攸雲山合賢\n　荊門圭山燈毓　宜都紫芝山發香同刻\n破山和尚語錄第十二卷　堆藍弘禮禪人對\n　秀水謝文英書　倪君亮子天章刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "康熙庚申年仲春月吉旦，禾郡楞嚴般若坊藏板"}
{"id": null, "n": null, "target": null, "type": null, "text": "康熙庚申年仲春月吉旦禾郡楞嚴寺般若堂藏\n板　　　嘉興倪君亮子天章刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "時師住龍門"}
{"id": null, "n": null, "target": null, "type": null, "text": "師示眾說偈，命眾續後句，凡有續者，師復聯而示之，此紀其七。"}
{"id": null, "n": null, "target": null, "type": null, "text": "辰州浦峰四世法孫性炅　沅州明山四世法\n孫惟梁同刻\n破山和尚語錄第十四卷　堆藍弘禮禪人對\n　秀水謝文英書　倪君亮子天章刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "康熙庚申年仲春日，嘉禾楞嚴般若坊附藏流通"}
{"id": null, "n": null, "target": null, "type": null, "text": "道號六解"}
{"id": null, "n": null, "target": null, "type": null, "text": "持在雙桂剎變"}
{"id": null, "n": null, "target": null, "type": null, "text": "四世法孫　潭州白鹿寺性慧　辰州龍山常\n杲　峿寺海藏　雲棲山海定　曲州磚鏡\n堂憨石修觀同刻\n破山和尚語錄第十五卷　堆藍弘禮禪人對\n　秀水謝文英書　倪君亮子天章刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "康熙庚申年仲春月吉旦，禾郡楞嚴般若坊藏板"}
{"id": null, "n": null, "target": null, "type": null, "text": "時師目語嵩語錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "四世孫　楚澧州　龍潭明初　慈利道林明\n善　鼎州大龍光膺　蜀新寧牛山真櫺　萬\n州百福山天圓寺廣徹　潭州西峰益聞同刻\n破山和尚語錄第十六卷　堆藍弘禮禪人對\n　秀水謝文英書　倪君亮子天章刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "康熙庚申年季春月，嘉禾楞嚴般若坊附藏流通"}
{"id": null, "n": null, "target": null, "type": null, "text": "荊州善信　姚君之　詹洪耀　王元海　熊\n洪璧　樊發仁　胡養讓　于發修同刻\n破山和尚語錄第十七卷　堆藍性同禪人對\n　秀水謝文英穎仙書　倪君亮子天章刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "康熙庚申年季春月，嘉禾楞嚴般若坊附藏流通"}
{"id": null, "n": null, "target": null, "type": null, "text": "時師寓三臺"}
{"id": null, "n": null, "target": null, "type": null, "text": "芙蓉信官彭應舉　楊應龍　州信官王聯\n芳　艾奇英　武昌信官馬海山　蘄水黑里\n盆信善李超浚同刻\n破山和尚語錄第十八卷　堆藍發悟對\n　秀水謝文英書　倪君亮子天章刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "康熙庚申年季春月，嘉禾楞嚴般若坊附藏流通"}
{"id": null, "n": null, "target": null, "type": null, "text": "呂相國請題"}
{"id": null, "n": null, "target": null, "type": null, "text": "中州信善符雲臺　韓慧深　劉發清　蔡應\n龍　江陵信善陳明性　朱妙圓　馮發德同\n刻\n破山和尚語錄第十九卷　清谿發泰禪人對\n　秀水謝文英書　倪君亮子天章雲望刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "康熙庚申年季春月，嘉禾楞嚴般若坊附藏流通"}
{"id": null, "n": null, "target": null, "type": null, "text": "白山布公集成請序"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "三世法孫　宜都善谿道束　江陵福昌發宗\n　堆藍發慧　竹園通聞　襄州道乾　沔州克\n誨同刻\n破山和尚語錄第二十卷　堆藍沙彌光對\n　秀水謝穎仙文英書　倪君亮子天章雲望刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "康熙庚申年季春月，嘉禾楞嚴般若坊附藏流通"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "浙江湖州府尹副"}
{"id": null, "n": null, "target": null, "type": null, "text": "曹溪正脈三十七世法孫徹巖\n捐貲敬刊"}
{"id": null, "n": null, "target": null, "type": null, "text": "破山老人年譜補入語錄流通\n海宇"}
{"id": null, "n": null, "target": null, "type": null, "text": "法孫　正生對　常奇書"}
{"id": null, "n": null, "target": null, "type": null, "text": "康熙庚戌冬日，嘉禾楞嚴寺識"}
