{"id": null, "n": null, "target": null, "type": null, "text": "念佛、願文、禮拜、三歸，俱同夕課。"}
{"id": null, "n": null, "target": null, "type": null, "text": "禮拜三歸"}
{"id": null, "n": null, "target": null, "type": null, "text": "以上正因"}
{"id": null, "n": null, "target": null, "type": null, "text": "以上助修"}
{"id": null, "n": null, "target": null, "type": null, "text": "如二顏丙文○無着○身有真假○齊生死○用形骸得失"}
{"id": null, "n": null, "target": null, "type": null, "text": "輪𢌞根本○蛇喻○對境○真空○四窮民○今日方間○出家後出家\n○悟後有修"}
{"id": null, "n": null, "target": null, "type": null, "text": "獄喻○防死○勾當自家事○醉生夢死○徹悟○生死根本"}
{"id": null, "n": null, "target": null, "type": null, "text": "六根○五蘊皆空○真性○廢心用心"}
{"id": null, "n": null, "target": null, "type": null, "text": "附寄庫○念經"}
{"id": null, "n": null, "target": null, "type": null, "text": "慧遠○慧永○曇順○僧叡○曇恒○道昞○道敬○慧恭○慧䖍○曇鑒○\n慧光。○道珍○曇鸞○智者大師○道喻○善導和尚○法照○少康○懷玉○道綽○惟岸○僧\n衒附啟芳圓果○懷感○辨才○大行○明瞻○智覺禪師○志通○悟恩○省常○遵式懺主○\n宗坦疏主○子元○法持○基法師○若愚○宗賾○知禮○有巖○智廉○懷義○宗本○元照\n○慧亨○智圓○可久○明本○善住○瑩珂○惟則○普度○楚琦○祖香○蓮大師○黃州僧\n○海寶"}
{"id": null, "n": null, "target": null, "type": null, "text": "劉程之○張野○王仲回○馬子雲○白居易○張迪○王龍舒○葛蘻○胡\n闕○楊傑○文彥博○馬玗○鍾離瑾○閻邦榮○咎定國○馮楫○王敏仲○吳子才○蘇軾○\n朱綱○顧寶幢○朱元正○丁明登○唐時○附辨融覺浪余大成"}
{"id": null, "n": null, "target": null, "type": null, "text": "門公則○周續之○孫良○庾銑○宋滿○王闐○范儼○孫忠○沉銓○計\n公○金奭○劉通志○唐廷任○楊嘉禕○郭熙載○戈以安○孫大玗"}
{"id": null, "n": null, "target": null, "type": null, "text": "大明○淨真○悟性○能奉○法藏"}
{"id": null, "n": null, "target": null, "type": null, "text": "隋后○葛濟之妻○姚婆○溫諍文妻○鄭氏○王氏夫人○馮氏夫人○陸\n氏宜人○樓氏○秦氏○鄭氏○于媼○方氏○薛氏○張母○孫氏母○徐氏○楊選一妻○湯\n公甫母"}
{"id": null, "n": null, "target": null, "type": null, "text": "張善和○雄俊○仲明○吳瓊○陳企○附俘囚"}
{"id": null, "n": null, "target": null, "type": null, "text": "鸚鵡○鴝鵒○雞○蛇○又雞"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "三稱"}
{"id": null, "n": null, "target": null, "type": null, "text": "上品上生章"}
{"id": null, "n": null, "target": null, "type": null, "text": "三稱"}
{"id": null, "n": null, "target": null, "type": null, "text": "出《小無量壽經》"}
{"id": null, "n": null, "target": null, "type": null, "text": "三遍"}
{"id": null, "n": null, "target": null, "type": null, "text": "課千聲或五百聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "各十稱畢，舉蓮大師西方願文"}
{"id": null, "n": null, "target": null, "type": null, "text": "某甲眾等"}
{"id": null, "n": null, "target": null, "type": null, "text": "禮願九拜作九品往生觀"}
{"id": null, "n": null, "target": null, "type": null, "text": "各禮一拜，次稱三皈。"}
{"id": null, "n": null, "target": null, "type": null, "text": "各禮一拜"}
{"id": null, "n": null, "target": null, "type": null, "text": "不能誦前願文者用此亦可"}
{"id": null, "n": null, "target": null, "type": null, "text": "正念入觀而寢，不得雜想，但久遠專志，必如所願。"}
{"id": null, "n": null, "target": null, "type": null, "text": "即阿彌陀佛"}
{"id": null, "n": null, "target": null, "type": null, "text": "具載本經"}
{"id": null, "n": null, "target": null, "type": null, "text": "念佛、法、僧、天、施、戒為六念"}
{"id": null, "n": null, "target": null, "type": null, "text": "《龍舒淨土文》"}
{"id": null, "n": null, "target": null, "type": null, "text": "纂龍舒文"}
{"id": null, "n": null, "target": null, "type": null, "text": "常即法身德，寂即解\n脫德，光即般若德。"}
{"id": null, "n": null, "target": null, "type": null, "text": "究竟如來所證，乃上品寂光。圓教人所證，名中品寂光。別教則證下品寂光耳。"}
{"id": null, "n": null, "target": null, "type": null, "text": "行真實法，感得勝報，色心不相妨礙，故言無障礙。"}
{"id": null, "n": null, "target": null, "type": null, "text": "次第者，別教菩\n薩。頓入者，圓教菩薩。"}
{"id": null, "n": null, "target": null, "type": null, "text": "修方\n便道，斷四住惑，故曰方便。無明未盡，故曰有餘。"}
{"id": null, "n": null, "target": null, "type": null, "text": "體觀\n感淨，拙觀感穢。"}
{"id": null, "n": null, "target": null, "type": null, "text": "生安養者，煩惱調伏，近於\n涅槃，故名為次。聚有三，如此土博地凡夫屬邪定聚，發心修行未不退者屬不定聚，不退轉者稱正定聚。"}
{"id": null, "n": null, "target": null, "type": null, "text": "極樂雖有\n天人之殊，既無婬欲，故無欲界。生彼者，次于泥洹，皆正定聚，則不隨禪而受生，故無色界、無無色界，可即同居，\n而證入上三土耳。"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上克復纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "以上龍舒文"}
{"id": null, "n": null, "target": null, "type": null, "text": "《蓮宗寶鑑》"}
{"id": null, "n": null, "target": null, "type": null, "text": "鄭清之《勸修淨土文》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《淨土或問》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《天如或問》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《蓮池疏鈔》"}
{"id": null, "n": null, "target": null, "type": null, "text": "丁蓮侶"}
{"id": null, "n": null, "target": null, "type": null, "text": "克復附述"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上纂龍舒文"}
{"id": null, "n": null, "target": null, "type": null, "text": "蓮池大師"}
{"id": null, "n": null, "target": null, "type": null, "text": "時國王出獵，問獸所在。佛念：「若\n實告之，則害獸。不實告之，則妄語。」沈吟未對。王怒，斫去一臂。再問未對，又斫去一臂。"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上纂龍舒文。"}
{"id": null, "n": null, "target": null, "type": null, "text": "以上蓮池大師"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上附述"}
{"id": null, "n": null, "target": null, "type": null, "text": "龍舒文"}
{"id": null, "n": null, "target": null, "type": null, "text": "慈雲懺主"}
{"id": null, "n": null, "target": null, "type": null, "text": "合纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上《蓮宗寶鑑》"}
{"id": null, "n": null, "target": null, "type": null, "text": "草堂禪師《寶王論》"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上《蓮宗寶鑑》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《疏鈔》"}
{"id": null, "n": null, "target": null, "type": null, "text": "合纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "《疏鈔》"}
{"id": null, "n": null, "target": null, "type": null, "text": "合纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "龍舒文"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐宜之"}
{"id": null, "n": null, "target": null, "type": null, "text": "《蓮宗寶鑑》"}
{"id": null, "n": null, "target": null, "type": null, "text": "五陰：色、受、想、行、識也"}
{"id": null, "n": null, "target": null, "type": null, "text": "境即是假"}
{"id": null, "n": null, "target": null, "type": null, "text": "空即是觀，是為雙照空假"}
{"id": null, "n": null, "target": null, "type": null, "text": "不為智所\n淨，亡空也"}
{"id": null, "n": null, "target": null, "type": null, "text": "不為境所染，亡假也"}
{"id": null, "n": null, "target": null, "type": null, "text": "雙亡二邊，\n是為中道"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上纂懷則大師《境觀要門》"}
{"id": null, "n": null, "target": null, "type": null, "text": "纂無盡《淨土圖說》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《竹窓三筆》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《蓮宗寶鑑》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《感應疏案》"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂不見殺、不聞殺、不疑為己疑"}
{"id": null, "n": null, "target": null, "type": null, "text": "纂龍舒文"}
{"id": null, "n": null, "target": null, "type": null, "text": "合纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上合纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "五辛謂葱、蒜、韮、\n薤、興渠。興渠，西域有之。"}
{"id": null, "n": null, "target": null, "type": null, "text": "纂丁蓮侶芥火"}
{"id": null, "n": null, "target": null, "type": null, "text": "龍纂文"}
{"id": null, "n": null, "target": null, "type": null, "text": "合纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "正因尚有深信因果，勸信行者等項，已見前，此不重列。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《淨土資糧》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《蓮池遺稿》"}
{"id": null, "n": null, "target": null, "type": null, "text": "六度即布施、持戒、忍辱、精進、禪定、智慧六波羅蜜，萬行即六度內所修所積而統括言之"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上《蓮宗寶鑑》"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上二則以《觀經》三福九品例推之，故得斷為正因。"}
{"id": null, "n": null, "target": null, "type": null, "text": "合纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "布施居六度之首，以屬正因無疑。"}
{"id": null, "n": null, "target": null, "type": null, "text": "合纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上纂龍舒文"}
{"id": null, "n": null, "target": null, "type": null, "text": "《蓮池三筆》"}
{"id": null, "n": null, "target": null, "type": null, "text": "龍舒文"}
{"id": null, "n": null, "target": null, "type": null, "text": "合纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上纂龍舒文"}
{"id": null, "n": null, "target": null, "type": null, "text": "先世即漢袁盎"}
{"id": null, "n": null, "target": null, "type": null, "text": "師沒後有五色舍利"}
{"id": null, "n": null, "target": null, "type": null, "text": "下蓮侶出世芥火"}
{"id": null, "n": null, "target": null, "type": null, "text": "纂丁蓮侶"}
{"id": null, "n": null, "target": null, "type": null, "text": "合纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "即上文九字梵書，難容筆誤。摹\n此書木上，桐油油過，沉水中。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此呪試有奇驗，幸䖍誦之"}
{"id": null, "n": null, "target": null, "type": null, "text": "宜䖍，宜多，宜默"}
{"id": null, "n": null, "target": null, "type": null, "text": "丁蓮侶《故鄉消息》"}
{"id": null, "n": null, "target": null, "type": null, "text": "陳皇士"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上纂《故鄉消息》"}
{"id": null, "n": null, "target": null, "type": null, "text": "合纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "《蓮宗寶鑑》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《淨土或問》"}
{"id": null, "n": null, "target": null, "type": null, "text": "寂室"}
{"id": null, "n": null, "target": null, "type": null, "text": "櫨菴法師有嚴"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上附纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "慈雲懺主"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上《蓮池遺稿》"}
{"id": null, "n": null, "target": null, "type": null, "text": "蓮池"}
{"id": null, "n": null, "target": null, "type": null, "text": "蓮池\n自警"}
{"id": null, "n": null, "target": null, "type": null, "text": "此蓮師現身說法語也。借自警以警人，句句嘔心，言\n言針頂，謂是彼說自家話，與我輩無與，可乎？覽此而不悚然易慮者，必非真學道人。"}
{"id": null, "n": null, "target": null, "type": null, "text": "蓮池警眾"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上遺稿"}
{"id": null, "n": null, "target": null, "type": null, "text": "老堂警策"}
{"id": null, "n": null, "target": null, "type": null, "text": "病堂警策"}
{"id": null, "n": null, "target": null, "type": null, "text": "蓮池遺稿"}
{"id": null, "n": null, "target": null, "type": null, "text": "合纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "善導和尚"}
{"id": null, "n": null, "target": null, "type": null, "text": "蓮池遺稿"}
{"id": null, "n": null, "target": null, "type": null, "text": "纂《蓮宗寶鑑》"}
{"id": null, "n": null, "target": null, "type": null, "text": "智者《十疑論》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《疏鈔》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《勸孝文》"}
{"id": null, "n": null, "target": null, "type": null, "text": "纂《故鄉消息》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《無盡燈》"}
{"id": null, "n": null, "target": null, "type": null, "text": "纂丁蓮侶"}
{"id": null, "n": null, "target": null, "type": null, "text": "纂龍舒文"}
{"id": null, "n": null, "target": null, "type": null, "text": "纂《樂邦文類》"}
{"id": null, "n": null, "target": null, "type": null, "text": "天如\n師《淨土或問》"}
{"id": null, "n": null, "target": null, "type": null, "text": "天台智者"}
{"id": null, "n": null, "target": null, "type": null, "text": "永明壽禪師"}
{"id": null, "n": null, "target": null, "type": null, "text": "長蘆賾禪師"}
{"id": null, "n": null, "target": null, "type": null, "text": "蓮池師《淨土疑辨》"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上纂蓮池《竹窓》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《觀經義疏》"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上\n蓮池《竹窓》"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上蓮池《淨土問》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《疏鈔》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《寶王論》"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上《西方合論》"}
{"id": null, "n": null, "target": null, "type": null, "text": "天如《或問》"}
{"id": null, "n": null, "target": null, "type": null, "text": "侈字函第七卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "《疏鈔》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《疏鈔》"}
{"id": null, "n": null, "target": null, "type": null, "text": "雪峯頌：「一盞孤燈照夜臺，上牀\n脫了韈和鞋。三魂七魄夢中去，未委明朝來不來。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "長魁詩云：「紅紅白白莫相瞞，無位真人赤肉團。敗壞不如豬狗相，只今便作死屍看。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "淨土文：「皮包血肉骨纏筋，顛倒凡夫認作身。到死始知非是我，從前金玉付他人。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "古頌：「父母恩深終有別，夫妻義重也分離。人情似鳥同林宿，大限來時各自飛。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "延光集：「鑊湯鑪炭諠幽壞，劒樹刀山聳太清。受罪要終八萬劫，獄卒\n牛頭始放行。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "寒山頌：「胭脂畫面嬌千樣，龍麝熏衣稍百般。今日風流都不見，綠楊芳草髑髏\n寒。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "寒山云：「雀󲣅鴉飡皮肉盡，風吹日炙\n髑髏乾。目前試問傍觀者，自把形骸仔細看。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "寒山云：「百骸潰散離塵泥，一物長靈復是誰？不\n得此時通線路，髑髏若地幾人知？」此文乃師子峯如如顏丙《勤修淨業文》。"}
{"id": null, "n": null, "target": null, "type": null, "text": "無着"}
{"id": null, "n": null, "target": null, "type": null, "text": "身有真假○已上合纂。"}
{"id": null, "n": null, "target": null, "type": null, "text": "齊生死"}
{"id": null, "n": null, "target": null, "type": null, "text": "用形骸得失，已上龍舒文。"}
{"id": null, "n": null, "target": null, "type": null, "text": "輪迴根本"}
{"id": null, "n": null, "target": null, "type": null, "text": "蛇喻"}
{"id": null, "n": null, "target": null, "type": null, "text": "對境。○已上蓮池。"}
{"id": null, "n": null, "target": null, "type": null, "text": "真空○合纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "四窮民○纂程鸞淡話"}
{"id": null, "n": null, "target": null, "type": null, "text": "今日方閑"}
{"id": null, "n": null, "target": null, "type": null, "text": "出家後出家○已上纂蓮池"}
{"id": null, "n": null, "target": null, "type": null, "text": "悟後有修○合纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "合纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "合纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "獄喻"}
{"id": null, "n": null, "target": null, "type": null, "text": "防死"}
{"id": null, "n": null, "target": null, "type": null, "text": "勾當自家事○已上合纂"}
{"id": null, "n": null, "target": null, "type": null, "text": "醉生夢死"}
{"id": null, "n": null, "target": null, "type": null, "text": "徹悟"}
{"id": null, "n": null, "target": null, "type": null, "text": "生死根○已上蓮化"}
{"id": null, "n": null, "target": null, "type": null, "text": "六根"}
{"id": null, "n": null, "target": null, "type": null, "text": "五蘊皆空"}
{"id": null, "n": null, "target": null, "type": null, "text": "真性"}
{"id": null, "n": null, "target": null, "type": null, "text": "廢心用形○已上龍舒文"}
{"id": null, "n": null, "target": null, "type": null, "text": "放下○纂丁蓮侶淡話"}
{"id": null, "n": null, "target": null, "type": null, "text": "應入宋楊傑後"}
{"id": null, "n": null, "target": null, "type": null, "text": "應在王日休前"}
{"id": null, "n": null, "target": null, "type": null, "text": "應入後宋"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
