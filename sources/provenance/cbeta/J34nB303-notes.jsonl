{"id": null, "n": null, "target": null, "type": null, "text": "酖毒砒霜"}
{"id": null, "n": null, "target": null, "type": null, "text": "放去較危，收來太速"}
{"id": null, "n": null, "target": null, "type": null, "text": "干戈競起"}
{"id": null, "n": null, "target": null, "type": null, "text": "特地一場愁"}
{"id": null, "n": null, "target": null, "type": null, "text": "看破了也"}
{"id": null, "n": null, "target": null, "type": null, "text": "熟處難忘"}
{"id": null, "n": null, "target": null, "type": null, "text": "從前汗馬無人識，祗要重論蓋代功"}
{"id": null, "n": null, "target": null, "type": null, "text": "將錯就錯"}
{"id": null, "n": null, "target": null, "type": null, "text": "少賣弄"}
{"id": null, "n": null, "target": null, "type": null, "text": "過得荊棘林是好手"}
{"id": null, "n": null, "target": null, "type": null, "text": "殺人可恕，情理難容"}
{"id": null, "n": null, "target": null, "type": null, "text": "明破即不\n堪"}
{"id": null, "n": null, "target": null, "type": null, "text": "險"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿誰恁麼道"}
{"id": null, "n": null, "target": null, "type": null, "text": "有敘"}
{"id": null, "n": null, "target": null, "type": null, "text": "有敘"}
{"id": null, "n": null, "target": null, "type": null, "text": "有敘"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "兩序請"}
{"id": null, "n": null, "target": null, "type": null, "text": "祥符監院請"}
{"id": null, "n": null, "target": null, "type": null, "text": "能仁監院請"}
{"id": null, "n": null, "target": null, "type": null, "text": "通州大悲院請"}
{"id": null, "n": null, "target": null, "type": null, "text": "峻明淵寺請半身"}
{"id": null, "n": null, "target": null, "type": null, "text": "化士請"}
{"id": null, "n": null, "target": null, "type": null, "text": "八首"}
{"id": null, "n": null, "target": null, "type": null, "text": "有敘"}
{"id": null, "n": null, "target": null, "type": null, "text": "共十一則自乙酉出山，錢塘絕渡，皆間道上者"}
{"id": null, "n": null, "target": null, "type": null, "text": "乙酉夏寄玄墓"}
{"id": null, "n": null, "target": null, "type": null, "text": "冬寄祥符"}
{"id": null, "n": null, "target": null, "type": null, "text": "丙戌春寄通州"}
{"id": null, "n": null, "target": null, "type": null, "text": "丙戌春同寄"}
{"id": null, "n": null, "target": null, "type": null, "text": "秋寄靈巖"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上三書，丙戌冬寄婁東。"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上三書，丁亥春寄祥符。"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上二則，因讀《國清語錄》"}
{"id": null, "n": null, "target": null, "type": null, "text": "病中見和尚半身像"}
{"id": null, "n": null, "target": null, "type": null, "text": "因讀和尚自題像讚"}
