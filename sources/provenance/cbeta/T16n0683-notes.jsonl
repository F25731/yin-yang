{"id": null, "n": "0777001", "target": "#nkr_note_mod_0777001", "type": "mod", "text": "佛說【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0777002", "target": "#nkr_note_mod_0777002", "type": "mod", "text": "法立【大】，釋法立【宋】【元】【明】【宮】"}
{"id": null, "n": "0777003", "target": "#nkr_note_mod_0777003", "type": "mod", "text": "法炬共譯【大】，共法炬譯【元】，法炬同譯【明】"}
{"id": null, "n": "0777004", "target": "#nkr_note_mod_0777004", "type": "mod", "text": "比丘【大】，比丘眾【宋】【元】【明】【宮】"}
{"id": null, "n": "0777005", "target": "#nkr_note_mod_0777005", "type": "mod", "text": "爾【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0777006", "target": "#nkr_note_mod_0777006", "type": "mod", "text": "帝【大】，帝釋【宋】【元】【明】【宮】"}
{"id": null, "n": "0777007", "target": "#nkr_note_mod_0777007", "type": "mod", "text": "坐而起【大】，座而興【宋】【元】【明】【宮】"}
{"id": null, "n": "0777008", "target": "#nkr_note_mod_0777008", "type": "mod", "text": "服【大】，衣服【宋】【元】【明】【宮】"}
{"id": null, "n": "0777009", "target": "#nkr_note_mod_0777009", "type": "mod", "text": "影【大】，景【宋】【元】【明】【宮】"}
{"id": null, "n": "0777010", "target": "#nkr_note_mod_0777010", "type": "mod", "text": "惠【大】，慧【宋】【元】【明】【宮】"}
{"id": null, "n": "0777011", "target": "#nkr_note_mod_0777011", "type": "mod", "text": "曚【大】，矇【宋】【宮】，蒙【元】【明】"}
{"id": null, "n": "0777012", "target": "#nkr_note_mod_0777012", "type": "mod", "text": "快【大】，善【宋】【元】【明】【宮】"}
{"id": null, "n": "0777013", "target": "#nkr_note_mod_0777013", "type": "mod", "text": "之中【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0777014", "target": "#nkr_note_mod_0777014", "type": "mod", "text": "眾善【大】，崇道【宋】【元】【明】【宮】"}
{"id": null, "n": "0777015", "target": "#nkr_note_mod_0777015", "type": "mod", "text": "德【大】，福【宋】【元】，事【明】【宮】"}
{"id": null, "n": "0777016", "target": "#nkr_note_mod_0777016", "type": "mod", "text": "早【大】，旱【宋】【元】【明】【宮】"}
{"id": null, "n": "0777017", "target": "#nkr_note_mod_0777017", "type": "mod", "text": "牢堅【大】，堅牢【宋】【元】【明】【宮】"}
{"id": null, "n": "0777018", "target": "#nkr_note_mod_0777018", "type": "mod", "text": "安寧【大】，康寧【宋】【元】【明】【宮】"}
{"id": null, "n": "0777019", "target": "#nkr_note_mod_0777019", "type": "mod", "text": "穢惡【大】，惡穢【宋】【元】【明】【宮】"}
{"id": null, "n": "0777020", "target": "#nkr_note_mod_0777020", "type": "mod", "text": "斯【大】，是【宋】【元】【明】【宮】"}
{"id": null, "n": "0777021", "target": "#nkr_note_mod_0777021", "type": "mod", "text": "生【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0777022", "target": "#nkr_note_mod_0777022", "type": "mod", "text": "糧【大】，𤄜【宋】【宮】，糒【元】【明】"}
{"id": null, "n": "0777023", "target": "#nkr_note_mod_0777023", "type": "mod", "text": "反【大】，返【宋】【元】【明】【宮】"}
{"id": null, "n": "0777024", "target": "#nkr_note_mod_0777024", "type": "mod", "text": "惟【大】，唯【宋】【明】"}
{"id": null, "n": "0777025", "target": "#nkr_note_mod_0777025", "type": "mod", "text": "情【大】，消【宋】【元】【明】【宮】"}
{"id": null, "n": "0777026", "target": "#nkr_note_mod_0777026", "type": "mod", "text": "時【大】，是【宋】【元】【明】【宮】"}
{"id": null, "n": "0777027", "target": "#nkr_note_mod_0777027", "type": "mod", "text": "曰【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0777028", "target": "#nkr_note_mod_0777028", "type": "mod", "text": "從【大】，即從【宋】【元】【明】【宮】"}
{"id": null, "n": "0777029", "target": "#nkr_note_mod_0777029", "type": "mod", "text": "呵梨勒【大】，阿梨勒【明】"}
{"id": null, "n": "0777030", "target": "#nkr_note_mod_0777030", "type": "mod", "text": "昇【大】，生【宋】【元】【明】【宮】"}
{"id": null, "n": "0777031", "target": "#nkr_note_mod_0777031", "type": "mod", "text": "有【大】，疾【宋】【元】【明】【宮】"}
{"id": null, "n": "0777032", "target": "#nkr_note_mod_0777032", "type": "mod", "text": "患【大】，勤【宮】"}
{"id": null, "n": "0777033", "target": "#nkr_note_mod_0777033", "type": "mod", "text": "惟【大】下同，唯【明】下同"}
{"id": null, "n": "0777034", "target": "#nkr_note_mod_0777034", "type": "mod", "text": "家【大】，民家作【宋】【元】【明】【宮】"}
{"id": null, "n": "0777035", "target": "#nkr_note_mod_0777035", "type": "mod", "text": "行【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0777036", "target": "#nkr_note_mod_0777036", "type": "mod", "text": "之【大】，則【宋】【元】【明】【宮】"}
{"id": null, "n": "0777037", "target": "#nkr_note_mod_0777037", "type": "mod", "text": "踊【大】＊，勇【宮】＊"}
{"id": null, "n": "0777038", "target": "#nkr_note_mod_0777038", "type": "mod", "text": "報【大】，德【宮】"}
{"id": null, "n": "0777039", "target": "#nkr_note_mod_0777039", "type": "mod", "text": "壽終生天【大】，終生天上【宋】【元】【明】【宮】"}
{"id": null, "n": "0777040", "target": "#nkr_note_mod_0777040", "type": "mod", "text": "生【大】，在【宋】【元】【明】【宮】"}
{"id": null, "n": "0777041", "target": "#nkr_note_mod_0777041", "type": "mod", "text": "豪尊榮貴【大】，豪貴尊榮【宋】【元】【明】【宮】"}
{"id": null, "n": "0778001", "target": "#nkr_note_mod_0778001", "type": "mod", "text": "阿【大】，〔－〕【宮】"}
{"id": null, "n": "0778002", "target": "#nkr_note_mod_0778002", "type": "mod", "text": "國【大】，〔－〕【宮】"}
{"id": null, "n": "0778003", "target": "#nkr_note_mod_0778003", "type": "mod", "text": "洗【大】＊，洒【宮】＊"}
{"id": null, "n": "0778004", "target": "#nkr_note_mod_0778004", "type": "mod", "text": "除【大】，得【宋】【元】【明】【宮】"}
{"id": null, "n": "0778005", "target": "#nkr_note_mod_0778005", "type": "mod", "text": "洗【大】，洒【宋】【元】【宮】"}
{"id": null, "n": "0778006", "target": "#nkr_note_mod_0778006", "type": "mod", "text": "復【大】，得【宋】【元】【明】【宮】"}
{"id": null, "n": "0778007", "target": "#nkr_note_mod_0778007", "type": "mod", "text": "醫【大】，藥【宮】"}
{"id": null, "n": "0778008", "target": "#nkr_note_mod_0778008", "type": "mod", "text": "德【大】，得【宋】【元】【明】【宮】"}
{"id": null, "n": "0778009", "target": "#nkr_note_mod_0778009", "type": "mod", "text": "崖【大】，涯【元】【明】"}
{"id": null, "n": "0778010", "target": "#nkr_note_mod_0778010", "type": "mod", "text": "阿難【大】，於時阿難【元】【明】，難【宮】"}
{"id": null, "n": "0778011", "target": "#nkr_note_mod_0778011", "type": "mod", "text": "我【大】，我自【宮】"}
{"id": null, "n": "0778012", "target": "#nkr_note_mod_0778012", "type": "mod", "text": "蓏【大】，菜【宋】【元】【明】【宮】"}
{"id": null, "n": "0778013", "target": "#nkr_note_mod_0778013", "type": "mod", "text": "盂【大】，鉢【宋】【明】【宮】"}
{"id": null, "n": "0778014", "target": "#nkr_note_mod_0778014", "type": "mod", "text": "祚【大】，德【宋】【元】【明】【宮】"}
