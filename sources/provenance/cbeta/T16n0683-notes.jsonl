{"id": null, "n": "0778034", "target": "#nkr_note_mod_0778034", "type": "mod", "text": "開【大】，間【宋】【元】【明】【宮】"}
{"id": null, "n": "0778035", "target": "#nkr_note_mod_0778035", "type": "mod", "text": "道【大】，道也【宋】【元】【明】【宮】"}
{"id": null, "n": "0778036", "target": "#nkr_note_mod_0778036", "type": "mod", "text": "佛【大】，世尊【宋】【元】【明】【宮】"}
