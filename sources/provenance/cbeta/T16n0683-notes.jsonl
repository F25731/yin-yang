{"id": null, "n": "0778019", "target": "#nkr_note_mod_0778019", "type": "mod", "text": "元【大】，原【宋】【元】【明】【宮】"}
{"id": null, "n": "0778020", "target": "#nkr_note_mod_0778020", "type": "mod", "text": "定【大】，足【宋】【元】【明】【宮】"}
{"id": null, "n": "0778021", "target": "#nkr_note_mod_0778021", "type": "mod", "text": "世最厚【大】，聖眾祐【元】【明】"}
{"id": null, "n": "0778022", "target": "#nkr_note_mod_0778022", "type": "mod", "text": "所【大】，自【宋】【元】【明】【宮】"}
