{"id": null, "n": "0778028", "target": "#nkr_note_mod_0778028", "type": "mod", "text": "穢【大】，辱【宋】【元】"}
{"id": null, "n": "0778029", "target": "#nkr_note_mod_0778029", "type": "mod", "text": "登【大】，發【宋】【元】【明】【宮】"}
{"id": null, "n": "0778030", "target": "#nkr_note_mod_0778030", "type": "mod", "text": "佛【大】，以佛【宋】【元】【明】【宮】"}
{"id": null, "n": "0778031", "target": "#nkr_note_mod_0778031", "type": "mod", "text": "照【大】，昭【宋】【宮】"}
{"id": null, "n": "0778032", "target": "#nkr_note_mod_0778032", "type": "mod", "text": "發一【大】，一發【宋】【元】【明】【宮】"}
