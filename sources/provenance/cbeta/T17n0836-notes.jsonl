{"id": null, "n": "0890002", "target": "#nkr_note_mod_0890002", "type": "mod", "text": "大【大】，佛說大【明】"}
{"id": null, "n": "0890003", "target": "#nkr_note_mod_0890003", "type": "mod", "text": "大唐天竺三藏地婆訶羅譯【大】，唐中天竺國沙門地婆訶羅等奉勅於東都東太原寺譯【宋】【宮】，唐中天竺沙門地婆訶羅等奉勅於東都東太原寺譯【元】【明】"}
{"id": null, "n": "0890004", "target": "#nkr_note_mod_0890004", "type": "mod", "text": "華【大】，葉【宮】"}
{"id": null, "n": "0890005", "target": "#nkr_note_mod_0890005", "type": "mod", "text": "頻【大】，嚬【宋】【元】【明】【宮】"}
{"id": null, "n": "0890006", "target": "#nkr_note_mod_0890006", "type": "mod", "text": "視【大】，現【宮】"}
{"id": null, "n": "0890007", "target": "#nkr_note_mod_0890007", "type": "mod", "text": "華【大】，蓮【宋】【元】【明】【宮】"}
{"id": null, "n": "0890008", "target": "#nkr_note_mod_0890008", "type": "mod", "text": "惟【大】下同，唯【宋】【宮】下同"}
{"id": null, "n": "0890009", "target": "#nkr_note_mod_0890009", "type": "mod", "text": "請【大】，讚【宮】"}
{"id": null, "n": "0890010", "target": "#nkr_note_mod_0890010", "type": "mod", "text": "惟【大】下同，唯【宋】下同【元】下同【明】下同"}
{"id": null, "n": "0891001", "target": "#nkr_note_mod_0891001", "type": "mod", "text": "法【大】，〔－〕【宋】"}
{"id": null, "n": "0891002", "target": "#nkr_note_mod_0891002", "type": "mod", "text": "法【大】，入法【宋】【元】【明】"}
{"id": null, "n": "0891003", "target": "#nkr_note_mod_0891003", "type": "mod", "text": "末香【大】，粖香【宋】【元】【宮】"}
{"id": null, "n": "0891004", "target": "#nkr_note_mod_0891004", "type": "mod", "text": "眷【大】，攝【元】【明】"}
{"id": null, "n": "0891005", "target": "#nkr_note_mod_0891005", "type": "mod", "text": "死【大】，〔－〕【宮】"}
{"id": null, "n": "0891006", "target": "#nkr_note_mod_0891006", "type": "mod", "text": "大方廣師子吼經【大】，〔－〕【元】，佛說大方廣師子吼經【明】"}
{"id": null, "n": "0890002", "target": "#nkr_note_orig_0890002", "type": "orig", "text": "（佛說）＋大【明】"}
{"id": null, "n": "0890003", "target": "#nkr_note_orig_0890003", "type": "orig", "text": "（（大唐天竺三藏地婆訶羅譯））十一字＝（（唐中天竺國沙門地婆訶羅等奉勅於東都東太原寺譯））二十二字【三】【宮】，上記中第五字元明兩本無"}
{"id": null, "n": "0890004", "target": "#nkr_note_orig_0890004", "type": "orig", "text": "華＝葉【宮】"}
{"id": null, "n": "0890005", "target": "#nkr_note_orig_0890005", "type": "orig", "text": "頻＝嚬【三】【宮】"}
{"id": null, "n": "0890006", "target": "#nkr_note_orig_0890006", "type": "orig", "text": "視＝現【宮】"}
{"id": null, "n": "0890007", "target": "#nkr_note_orig_0890007", "type": "orig", "text": "華＝蓮【三】【宮】"}
{"id": null, "n": "0890008", "target": "#nkr_note_orig_0890008", "type": "orig", "text": "惟＝唯【宋】【宮】下同"}
{"id": null, "n": "0890009", "target": "#nkr_note_orig_0890009", "type": "orig", "text": "請＝讚【宮】"}
{"id": null, "n": "0890010", "target": "#nkr_note_orig_0890010", "type": "orig", "text": "惟＝唯【三】下同"}
{"id": null, "n": "0891001", "target": "#nkr_note_orig_0891001", "type": "orig", "text": "〔法〕－【宋】"}
{"id": null, "n": "0891002", "target": "#nkr_note_orig_0891002", "type": "orig", "text": "（入）＋法【三】"}
{"id": null, "n": "0891003", "target": "#nkr_note_orig_0891003", "type": "orig", "text": "末香＝粖香【宋】【元】【宮】"}
{"id": null, "n": "0891004", "target": "#nkr_note_orig_0891004", "type": "orig", "text": "眷＝攝【元】【明】"}
{"id": null, "n": "0891005", "target": "#nkr_note_orig_0891005", "type": "orig", "text": "〔死〕－【宮】"}
{"id": null, "n": "0891006", "target": "#nkr_note_orig_0891006", "type": "orig", "text": "〔大方廣師子吼經〕－【元】，（佛說）＋大【明】"}
