{"id": null, "n": "0126010", "target": "#nkr_note_mod_0126010", "type": "mod", "text": "雉【大】，羽【宋】【元】【明】【宮】"}
{"id": null, "n": "0126011", "target": "#nkr_note_mod_0126011", "type": "mod", "text": "分判斷【大】，業分判【宋】【元】【明】【宮】"}
{"id": null, "n": "0126012", "target": "#nkr_note_mod_0126012", "type": "mod", "text": "椎【CB】【宋】【元】【明】【宮】，推【大】，推【麗-CB】"}
