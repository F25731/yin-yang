{"id": null, "n": "0125010", "target": "#nkr_note_mod_0125010", "type": "mod", "text": "某【大】，其【宋】【元】【明】【宮】"}
{"id": null, "n": "0125011", "target": "#nkr_note_mod_0125011", "type": "mod", "text": "常【大】，當【明】"}
