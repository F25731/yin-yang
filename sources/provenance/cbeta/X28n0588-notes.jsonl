{"id": null, "n": null, "target": null, "type": null, "text": "欽慕"}
{"id": null, "n": null, "target": null, "type": null, "text": "非根"}
{"id": null, "n": null, "target": null, "type": null, "text": "設復持戒，非常住本"}
{"id": null, "n": null, "target": null, "type": null, "text": "人天\n陰果"}
{"id": null, "n": null, "target": null, "type": null, "text": "無定慧方便，名\n不知鑽搖。似道尚無，况復真常"}
{"id": null, "n": null, "target": null, "type": null, "text": "起見"}
{"id": null, "n": null, "target": null, "type": null, "text": "起見墮惡，失人天果"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘六聲聞各有所說。"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘六菩薩亦各有說。"}
