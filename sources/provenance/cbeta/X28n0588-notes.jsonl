{"id": null, "n": null, "target": null, "type": null, "text": "三諦\n相即，不見無始"}
{"id": null, "n": null, "target": null, "type": null, "text": "三諦體性"}
{"id": null, "n": null, "target": null, "type": null, "text": "真中體即"}
{"id": null, "n": null, "target": null, "type": null, "text": "一切空"}
{"id": null, "n": null, "target": null, "type": null, "text": "三諦相即"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上並是經文"}
{"id": null, "n": null, "target": null, "type": null, "text": "音煩。"}
{"id": null, "n": null, "target": null, "type": null, "text": "於滯反。"}
{"id": null, "n": null, "target": null, "type": null, "text": "之設反。"}
{"id": null, "n": null, "target": null, "type": null, "text": "私官反。"}
{"id": null, "n": null, "target": null, "type": null, "text": "如羊反。"}
{"id": null, "n": null, "target": null, "type": null, "text": "巨依反。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "疏云：除色已，餘四陰\n即四識住"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂能通也"}
{"id": null, "n": null, "target": null, "type": null, "text": "因於實法有假名時"}
