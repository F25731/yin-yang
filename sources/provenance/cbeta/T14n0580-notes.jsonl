{"id": null, "n": "0962003", "target": "#nkr_note_mod_0962003", "type": "mod", "text": "佛說【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0962004", "target": "#nkr_note_mod_0962004", "type": "mod", "text": "經【大】，經似秦什師文意【元】【明】"}
{"id": null, "n": "0962005", "target": "#nkr_note_mod_0962005", "type": "mod", "text": "（失譯…錄）八字【大】，失譯今附粱錄【宋】【宮】，名開元拾遺附錄【元】，開元招遺附粱錄失譯人名【明】"}
{"id": null, "n": "0963001", "target": "#nkr_note_mod_0963001", "type": "mod", "text": "知【大】，亦知【宋】【元】【明】【宮】"}
{"id": null, "n": "0963002", "target": "#nkr_note_mod_0963002", "type": "mod", "text": "仰【大】，即【宮】"}
{"id": null, "n": "0963003", "target": "#nkr_note_mod_0963003", "type": "mod", "text": "偈言【大】，偈曰【元】【明】，說言【宮】"}
{"id": null, "n": "0963004", "target": "#nkr_note_mod_0963004", "type": "mod", "text": "心淨【大】，淨心【宋】【元】【明】【宮】"}
{"id": null, "n": "0963005", "target": "#nkr_note_mod_0963005", "type": "mod", "text": "即【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0963006", "target": "#nkr_note_mod_0963006", "type": "mod", "text": "爾來【大】，今來【宋】【元】【明】【宮】"}
{"id": null, "n": "0963007", "target": "#nkr_note_mod_0963007", "type": "mod", "text": "人【大】，〔－〕【宮】"}
{"id": null, "n": "0963008", "target": "#nkr_note_mod_0963008", "type": "mod", "text": "時【大】，爾時【宋】【元】【明】【宮】"}
{"id": null, "n": "0963009", "target": "#nkr_note_mod_0963009", "type": "mod", "text": "為義【大】，為生義【宋】【元】【明】【宮】"}
{"id": null, "n": "0963010", "target": "#nkr_note_mod_0963010", "type": "mod", "text": "為義【大】＊，為死義【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0964001", "target": "#nkr_note_mod_0964001", "type": "mod", "text": "得【大】，得有所【宋】【元】【明】【宮】"}
{"id": null, "n": "0964002", "target": "#nkr_note_mod_0964002", "type": "mod", "text": "問【大】，問曰【宋】【元】【明】【宮】"}
{"id": null, "n": "0964003", "target": "#nkr_note_mod_0964003", "type": "mod", "text": "義【大】，義也【宋】【元】【明】【宮】"}
{"id": null, "n": "0964004", "target": "#nkr_note_mod_0964004", "type": "mod", "text": "耶【大】，〔－〕【元】【明】"}
{"id": null, "n": "0964005", "target": "#nkr_note_mod_0964005", "type": "mod", "text": "相【大】，性【元】【明】"}
{"id": null, "n": "0964006", "target": "#nkr_note_mod_0964006", "type": "mod", "text": "是【大】，自【明】"}
{"id": null, "n": "0964007", "target": "#nkr_note_mod_0964007", "type": "mod", "text": "問【大】，問曰【宋】【元】【明】【宮】"}
{"id": null, "n": "0964008", "target": "#nkr_note_mod_0964008", "type": "mod", "text": "安【大】，安之【宋】【元】【明】【宮】"}
{"id": null, "n": "0964009", "target": "#nkr_note_mod_0964009", "type": "mod", "text": "吉相【大】，安相【宋】【元】【明】【宮】"}
{"id": null, "n": "0964010", "target": "#nkr_note_mod_0964010", "type": "mod", "text": "為【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0964011", "target": "#nkr_note_mod_0964011", "type": "mod", "text": "者【大】，者而有所說者乃【宋】【元】【明】【宮】"}
{"id": null, "n": "0964012", "target": "#nkr_note_mod_0964012", "type": "mod", "text": "相【大】，相也【宋】【元】【明】【宮】"}
{"id": null, "n": "0964013", "target": "#nkr_note_mod_0964013", "type": "mod", "text": "者【大】，者即【宋】【元】【明】【宮】"}
{"id": null, "n": "0964014", "target": "#nkr_note_mod_0964014", "type": "mod", "text": "而【大】，而以【宋】【元】【明】【宮】"}
{"id": null, "n": "0964015", "target": "#nkr_note_mod_0964015", "type": "mod", "text": "是【大】，非是【宋】【元】【明】【宮】"}
{"id": null, "n": "0964016", "target": "#nkr_note_mod_0964016", "type": "mod", "text": "久離【大】＊，久離耶【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0964017", "target": "#nkr_note_mod_0964017", "type": "mod", "text": "天【大】，諸天【宋】【元】【明】【宮】"}
{"id": null, "n": "0964018", "target": "#nkr_note_mod_0964018", "type": "mod", "text": "法眼【大】，法眼淨【宋】【元】【明】【宮】"}
{"id": null, "n": "0964019", "target": "#nkr_note_mod_0964019", "type": "mod", "text": "眾生【大】，諸眾生【宋】【元】【明】【宮】"}
{"id": null, "n": "0964020", "target": "#nkr_note_mod_0964020", "type": "mod", "text": "疑【大】，疑之也【宋】【元】【明】【宮】"}
{"id": null, "n": "0964021", "target": "#nkr_note_mod_0964021", "type": "mod", "text": "了義【大】，說了義【宋】【元】【明】【宮】"}
{"id": null, "n": "0964022", "target": "#nkr_note_mod_0964022", "type": "mod", "text": "佛說長者女菴提遮師子吼了義經【大】，佛說菴提遮女經【宋】【宮】，長者女菴提遮師子吼了義經【元】"}
{"id": null, "n": "0962003", "target": "#nkr_note_orig_0962003", "type": "orig", "text": "〔佛說〕－【宋】【元】【宮】"}
{"id": null, "n": "0962004", "target": "#nkr_note_orig_0962004", "type": "orig", "text": "經＋（似秦什師文意）【元】【明】"}
{"id": null, "n": "0962005", "target": "#nkr_note_orig_0962005", "type": "orig", "text": "（失譯…錄）八字＝失譯今附粱錄【宋】【宮】，名開元拾遺附錄【元】，開元招遺附粱錄失譯人名【明】"}
{"id": null, "n": "0963001", "target": "#nkr_note_orig_0963001", "type": "orig", "text": "（亦）＋知【三】【宮】"}
{"id": null, "n": "0963002", "target": "#nkr_note_orig_0963002", "type": "orig", "text": "仰＝即【宮】"}
{"id": null, "n": "0963003", "target": "#nkr_note_orig_0963003", "type": "orig", "text": "偈言＝偈曰【元】【明】，說言【宮】"}
{"id": null, "n": "0963004", "target": "#nkr_note_orig_0963004", "type": "orig", "text": "心淨＝淨心【三】【宮】"}
{"id": null, "n": "0963005", "target": "#nkr_note_orig_0963005", "type": "orig", "text": "〔即〕－【三】【宮】"}
{"id": null, "n": "0963006", "target": "#nkr_note_orig_0963006", "type": "orig", "text": "爾來＝今來【三】【宮】"}
{"id": null, "n": "0963007", "target": "#nkr_note_orig_0963007", "type": "orig", "text": "〔人〕－【宮】"}
{"id": null, "n": "0963008", "target": "#nkr_note_orig_0963008", "type": "orig", "text": "（爾）＋時【三】【宮】"}
{"id": null, "n": "0963009", "target": "#nkr_note_orig_0963009", "type": "orig", "text": "為義＝為生義【三】【宮】"}
{"id": null, "n": "0963010", "target": "#nkr_note_orig_0963010", "type": "orig", "text": "為義＝為死義【三】【宮】＊"}
{"id": null, "n": "0964001", "target": "#nkr_note_orig_0964001", "type": "orig", "text": "得＋（有所）【三】【宮】"}
{"id": null, "n": "0964002", "target": "#nkr_note_orig_0964002", "type": "orig", "text": "問＋（曰）【三】【宮】"}
{"id": null, "n": "0964003", "target": "#nkr_note_orig_0964003", "type": "orig", "text": "義＋（也）【三】【宮】"}
{"id": null, "n": "0964004", "target": "#nkr_note_orig_0964004", "type": "orig", "text": "〔耶〕－【元】【明】"}
{"id": null, "n": "0964005", "target": "#nkr_note_orig_0964005", "type": "orig", "text": "相＝性【元】【明】"}
{"id": null, "n": "0964006", "target": "#nkr_note_orig_0964006", "type": "orig", "text": "是＝自【明】"}
{"id": null, "n": "0964007", "target": "#nkr_note_orig_0964007", "type": "orig", "text": "問＋（曰）【三】【宮】"}
{"id": null, "n": "0964008", "target": "#nkr_note_orig_0964008", "type": "orig", "text": "安＋（之）【三】【宮】"}
{"id": null, "n": "0964009", "target": "#nkr_note_orig_0964009", "type": "orig", "text": "吉相＝安相【三】【宮】"}
{"id": null, "n": "0964010", "target": "#nkr_note_orig_0964010", "type": "orig", "text": "〔為〕－【三】【宮】"}
{"id": null, "n": "0964011", "target": "#nkr_note_orig_0964011", "type": "orig", "text": "者＋（而有所說者乃）【三】【宮】"}
{"id": null, "n": "0964012", "target": "#nkr_note_orig_0964012", "type": "orig", "text": "相＋（也）【三】【宮】"}
{"id": null, "n": "0964013", "target": "#nkr_note_orig_0964013", "type": "orig", "text": "者＋（即）【三】【宮】"}
{"id": null, "n": "0964014", "target": "#nkr_note_orig_0964014", "type": "orig", "text": "而＋（以）【三】【宮】"}
{"id": null, "n": "0964015", "target": "#nkr_note_orig_0964015", "type": "orig", "text": "（非）＋是【三】【宮】"}
{"id": null, "n": "0964016", "target": "#nkr_note_orig_0964016", "type": "orig", "text": "久離＝久離耶【三】【宮】＊"}
{"id": null, "n": "0964017", "target": "#nkr_note_orig_0964017", "type": "orig", "text": "（諸）＋天【三】【宮】"}
{"id": null, "n": "0964018", "target": "#nkr_note_orig_0964018", "type": "orig", "text": "法眼＋（淨）【三】【宮】"}
{"id": null, "n": "0964019", "target": "#nkr_note_orig_0964019", "type": "orig", "text": "（諸）＋眾生【三】【宮】"}
{"id": null, "n": "0964020", "target": "#nkr_note_orig_0964020", "type": "orig", "text": "疑＋（之也）【三】【宮】"}
{"id": null, "n": "0964021", "target": "#nkr_note_orig_0964021", "type": "orig", "text": "（說）＋了義【三】【宮】"}
{"id": null, "n": "0964022", "target": "#nkr_note_orig_0964022", "type": "orig", "text": "（佛說…經）十四字＝佛說菴提遮女經【宋】【宮】，〔佛說〕－【元】"}
{"id": null, "n": "0964b2701", "target": "#nkr_note_add_0964b2701", "type": "add", "text": "何【CB】，行【大】"}
