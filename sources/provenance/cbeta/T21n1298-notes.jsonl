{"id": null, "n": "0386001", "target": "#nkr_note_mod_0386001", "type": "mod", "text": "捧【大】，承【甲】"}
{"id": null, "n": "0386002", "target": "#nkr_note_mod_0386002", "type": "mod", "text": "跓【大】，柱【甲】"}
{"id": null, "n": "0386003", "target": "#nkr_note_mod_0386003", "type": "mod", "text": "嚩【大】，婆【甲】"}
{"id": null, "n": "0386004", "target": "#nkr_note_mod_0386004", "type": "mod", "text": "魔【大】，摩【甲】"}
{"id": null, "n": "0386005", "target": "#nkr_note_mod_0386005", "type": "mod", "text": "波【大】，波羅【甲】"}
{"id": null, "n": "0386006", "target": "#nkr_note_mod_0386006", "type": "mod", "text": "曩曳【大】，那耶【甲】"}
{"id": null, "n": "0386007", "target": "#nkr_note_mod_0386007", "type": "mod", "text": "右腰【大】，腰右【甲】"}
{"id": null, "n": "0386008", "target": "#nkr_note_mod_0386008", "type": "mod", "text": "羅【大】＊，囉【甲】＊"}
{"id": null, "n": "0386009", "target": "#nkr_note_mod_0386009", "type": "mod", "text": "訶摩【大】，𢈈麼【甲】"}
{"id": null, "n": "0386010", "target": "#nkr_note_mod_0386010", "type": "mod", "text": "寧【大】，寧尼矣反【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "尼矣反"}
{"id": null, "n": "0386011", "target": "#nkr_note_mod_0386011", "type": "mod", "text": "踁【大】，跓【校異-原】，拄【甲】"}
