{"id": null, "n": "0386013", "target": "#nkr_note_mod_0386013", "type": "mod", "text": "即成【大】，〔－〕【甲】"}
{"id": null, "n": "0386016", "target": "#nkr_note_mod_0386016", "type": "mod", "text": "偷【大】，渝【甲】"}
{"id": null, "n": "0386017", "target": "#nkr_note_mod_0386017", "type": "mod", "text": "底【大】，底丁以反【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "丁以反"}
{"id": null, "n": "0386018", "target": "#nkr_note_mod_0386018", "type": "mod", "text": "外【大】，〔－〕【甲】"}
{"id": null, "n": "0386019", "target": "#nkr_note_mod_0386019", "type": "mod", "text": "怛【大】，但【甲】"}
{"id": null, "n": "0386020", "target": "#nkr_note_mod_0386020", "type": "mod", "text": "涅【大】，涅寧以反【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "寧以反"}
{"id": null, "n": "0386021", "target": "#nkr_note_mod_0386021", "type": "mod", "text": "牙相【大】，想【校異-原】"}
{"id": null, "n": "0386022", "target": "#nkr_note_mod_0386022", "type": "mod", "text": "立【大】，云【甲】"}
{"id": null, "n": "0386026", "target": "#nkr_note_mod_0386026", "type": "mod", "text": "􈆻【大】，􈇗【考偽-原】"}
{"id": null, "n": "0385001", "target": "#nkr_note_orig_0385001", "type": "orig", "text": "【原】享和元年刊長谷寺藏本，【甲】永久元年寫東寺三密藏本"}
{"id": null, "n": "0385002", "target": "#nkr_note_orig_0385002", "type": "orig", "text": "〔二〕－【甲】"}
{"id": null, "n": "0385003", "target": "#nkr_note_orig_0385003", "type": "orig", "text": "已出護摩軌＝也【甲】"}
{"id": null, "n": "0385004", "target": "#nkr_note_orig_0385004", "type": "orig", "text": "合＝分【甲】"}
{"id": null, "n": "0385005", "target": "#nkr_note_orig_0385005", "type": "orig", "text": "用＝閑【甲】"}
{"id": null, "n": "0385006", "target": "#nkr_note_orig_0385006", "type": "orig", "text": "作＋（作）【甲】"}
{"id": null, "n": "0385007", "target": "#nkr_note_orig_0385007", "type": "orig", "text": "（一）＋器【甲】"}
{"id": null, "n": "0385008", "target": "#nkr_note_orig_0385008", "type": "orig", "text": "〔盛〕－【甲】"}
{"id": null, "n": "0385009", "target": "#nkr_note_orig_0385009", "type": "orig", "text": "（右）＋左【甲】"}
{"id": null, "n": "0385010", "target": "#nkr_note_orig_0385010", "type": "orig", "text": "（（曩莫…賀））十七字＝（（歸命印捺囉二合耶娑嚩訶））十一字【甲】"}
{"id": null, "n": "0385011", "target": "#nkr_note_orig_0385011", "type": "orig", "text": "右＝左【甲】"}
{"id": null, "n": "0385012", "target": "#nkr_note_orig_0385012", "type": "orig", "text": "左＝右【甲】"}
{"id": null, "n": "0385013", "target": "#nkr_note_orig_0385013", "type": "orig", "text": "蹉＝跪ィ【原】"}
{"id": null, "n": "0385014", "target": "#nkr_note_orig_0385014", "type": "orig", "text": "〔右〕－【甲】"}
{"id": null, "n": "0385015", "target": "#nkr_note_orig_0385015", "type": "orig", "text": "（（南莫…南））八字＝（（歸命））二字【甲】下同"}
{"id": null, "n": "0385016", "target": "#nkr_note_orig_0385016", "type": "orig", "text": "〔引〕－【甲】＊"}
{"id": null, "n": "0385017", "target": "#nkr_note_orig_0385017", "type": "orig", "text": "哩＋（二合）夾註【甲】"}
