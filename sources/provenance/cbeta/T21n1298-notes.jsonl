{"id": null, "n": "0385002", "target": "#nkr_note_mod_0385002", "type": "mod", "text": "二【大】，〔－〕【甲】"}
{"id": null, "n": "0385003", "target": "#nkr_note_mod_0385003", "type": "mod", "text": "已出護摩軌【大】，也【甲】"}
{"id": null, "n": "0385004", "target": "#nkr_note_mod_0385004", "type": "mod", "text": "合【大】，分【甲】"}
{"id": null, "n": "0385005", "target": "#nkr_note_mod_0385005", "type": "mod", "text": "用【大】，閑【甲】"}
{"id": null, "n": "0385006", "target": "#nkr_note_mod_0385006", "type": "mod", "text": "作【大】，作作【甲】"}
{"id": null, "n": "0385007", "target": "#nkr_note_mod_0385007", "type": "mod", "text": "器【大】，一器【甲】"}
{"id": null, "n": "0385008", "target": "#nkr_note_mod_0385008", "type": "mod", "text": "盛【大】，〔－〕【甲】"}
{"id": null, "n": "0385009", "target": "#nkr_note_mod_0385009", "type": "mod", "text": "左【大】，右左【甲】"}
{"id": null, "n": "0385010", "target": "#nkr_note_mod_0385010", "type": "mod", "text": "（曩莫…賀）十七字【大】，歸命印捺囉二合耶娑嚩訶【甲】"}
{"id": null, "n": "0385011", "target": "#nkr_note_mod_0385011", "type": "mod", "text": "右【大】，左【甲】"}
{"id": null, "n": "0385012", "target": "#nkr_note_mod_0385012", "type": "mod", "text": "左【大】，右【甲】"}
{"id": null, "n": "0385013", "target": "#nkr_note_mod_0385013", "type": "mod", "text": "蹉【大】，跪【校異-原】"}
{"id": null, "n": "0385014", "target": "#nkr_note_mod_0385014", "type": "mod", "text": "右【大】，〔－〕【甲】"}
{"id": null, "n": "0385015", "target": "#nkr_note_mod_0385015", "type": "mod", "text": "（南莫…南）八字【大】下同，歸命【甲】下同"}
{"id": null, "n": "0385016", "target": "#nkr_note_mod_0385016", "type": "mod", "text": "引【大】＊，〔－〕【甲】＊"}
{"id": null, "n": "0385017", "target": "#nkr_note_mod_0385017", "type": "mod", "text": "哩【大】，哩二合【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0385018", "target": "#nkr_note_mod_0385018", "type": "mod", "text": "賀【大】，訶【甲】"}
{"id": null, "n": "0385019", "target": "#nkr_note_mod_0385019", "type": "mod", "text": "取【大】，執【甲】"}
{"id": null, "n": "0385020", "target": "#nkr_note_mod_0385020", "type": "mod", "text": "龍【大】，羂【甲】"}
{"id": null, "n": "0385021", "target": "#nkr_note_mod_0385021", "type": "mod", "text": "二合【大】＊，〔－〕【甲】＊"}
{"id": null, "n": "0385022", "target": "#nkr_note_mod_0385022", "type": "mod", "text": "吠【大】，吠微洗反【甲】"}
