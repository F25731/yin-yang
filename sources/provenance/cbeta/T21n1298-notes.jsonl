{"id": null, "n": "0385019", "target": "#nkr_note_orig_0385019", "type": "orig", "text": "取＝執【甲】"}
{"id": null, "n": "0385020", "target": "#nkr_note_orig_0385020", "type": "orig", "text": "龍＝羂【甲】"}
{"id": null, "n": "0385021", "target": "#nkr_note_orig_0385021", "type": "orig", "text": "〔二合〕－【甲】＊"}
{"id": null, "n": "0385022", "target": "#nkr_note_orig_0385022", "type": "orig", "text": "吠＋（微洗反）夾註【甲】"}
{"id": null, "n": "0386001", "target": "#nkr_note_orig_0386001", "type": "orig", "text": "捧＝承【甲】"}
{"id": null, "n": "0386002", "target": "#nkr_note_orig_0386002", "type": "orig", "text": "跓＝柱【甲】"}
{"id": null, "n": "0386003", "target": "#nkr_note_orig_0386003", "type": "orig", "text": "嚩＝婆【甲】"}
