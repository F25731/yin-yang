{"id": null, "n": "0386006", "target": "#nkr_note_orig_0386006", "type": "orig", "text": "曩曳＝那耶【甲】"}
{"id": null, "n": "0386007", "target": "#nkr_note_orig_0386007", "type": "orig", "text": "右腰＝腰右【甲】"}
{"id": null, "n": "0386008", "target": "#nkr_note_orig_0386008", "type": "orig", "text": "羅＝囉【甲】＊"}
{"id": null, "n": "0386009", "target": "#nkr_note_orig_0386009", "type": "orig", "text": "訶摩＝𢈈麼【甲】"}
{"id": null, "n": "0386010", "target": "#nkr_note_orig_0386010", "type": "orig", "text": "寧＋（尼矣反）夾註【甲】"}
{"id": null, "n": "0386011", "target": "#nkr_note_orig_0386011", "type": "orig", "text": "踁＝跓ィ【原】，拄【甲】"}
{"id": null, "n": "0386012", "target": "#nkr_note_orig_0386012", "type": "orig", "text": "體＋（地以反）夾註【甲】"}
{"id": null, "n": "0386013", "target": "#nkr_note_orig_0386013", "type": "orig", "text": "〔即成〕－【甲】"}
{"id": null, "n": "0386014", "target": "#nkr_note_orig_0386014", "type": "orig", "text": "此呪甲本作梵字􆿅􄖫􄟗􅁥􄚩"}
{"id": null, "n": "0386015", "target": "#nkr_note_orig_0386015", "type": "orig", "text": "此呪甲本作梵字􄑼􈆦􄗱􅁥􄚩"}
{"id": null, "n": "0386016", "target": "#nkr_note_orig_0386016", "type": "orig", "text": "偷＝渝【甲】"}
{"id": null, "n": "0386017", "target": "#nkr_note_orig_0386017", "type": "orig", "text": "底＋（丁以反）夾註【甲】"}
{"id": null, "n": "0386018", "target": "#nkr_note_orig_0386018", "type": "orig", "text": "〔外〕－【甲】"}
{"id": null, "n": "0386019", "target": "#nkr_note_orig_0386019", "type": "orig", "text": "怛＝但【甲】"}
{"id": null, "n": "0386020", "target": "#nkr_note_orig_0386020", "type": "orig", "text": "涅＋（寧以反）夾註【甲】"}
{"id": null, "n": "0386021", "target": "#nkr_note_orig_0386021", "type": "orig", "text": "牙相＝想ィ【原】"}
{"id": null, "n": "0386022", "target": "#nkr_note_orig_0386022", "type": "orig", "text": "立＝云【甲】"}
{"id": null, "n": "0386023", "target": "#nkr_note_orig_0386023", "type": "orig", "text": "之字次甲本有二種樣三字"}
{"id": null, "n": "0386024", "target": "#nkr_note_orig_0386024", "type": "orig", "text": "圖中大甲本作自在，焰作焰天。"}
{"id": null, "n": "0386025", "target": "#nkr_note_orig_0386025", "type": "orig", "text": "以下甲本無，甲本奧書曰永久元年十月十六日奉寫了奉受事先了宗範，保元二年六月十一日奉受了傳領賢能"}
{"id": null, "n": "0386026", "target": "#nkr_note_orig_0386026", "type": "orig", "text": "􈆻＝􈇗ヵ【原】"}
