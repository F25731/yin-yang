{"id": null, "n": null, "target": null, "type": null, "text": "按古來及東域并無撰名一本云堅慧菩薩造未知所據"}
{"id": null, "n": null, "target": null, "type": null, "text": "按華嚴傳標上二部云右不知誰集但鳩集闕略未能備盡今賢首更廣其塵頗為詳悉"}
{"id": null, "n": null, "target": null, "type": null, "text": "按東域亦亡名"}
{"id": null, "n": null, "target": null, "type": null, "text": "按上二部請來東域並亡名"}
{"id": null, "n": null, "target": null, "type": null, "text": "按請來東域並亡名"}
{"id": null, "n": null, "target": null, "type": null, "text": "按東域亦亡名"}
{"id": null, "n": null, "target": null, "type": null, "text": "按東域亦亡名"}
{"id": null, "n": null, "target": null, "type": null, "text": "按與上別數不符合總別數中恐有寫誤"}
{"id": null, "n": "1133001", "target": "#nkr_note_mod_1133001", "type": "mod", "text": "譯【大】，譯按上三部出華嚴傳【甲】"}
{"id": null, "n": "1133002", "target": "#nkr_note_mod_1133002", "type": "mod", "text": "卷【大】，卷按古來及東域并無撰名一本云堅慧菩薩造未知所據【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "按古來及東域并無撰名一本云堅慧菩薩造未知所據"}
{"id": null, "n": "1133003", "target": "#nkr_note_mod_1133003", "type": "mod", "text": "述【大】，述按上二部出華嚴傳【甲】"}
{"id": null, "n": "1133004", "target": "#nkr_note_mod_1133004", "type": "mod", "text": "論【大】，論按東域等諸錄不出待勘【甲】"}
{"id": null, "n": "1133005", "target": "#nkr_note_mod_1133005", "type": "mod", "text": "述【大】，述按海東云九識章三卷【甲】"}
{"id": null, "n": "1133006", "target": "#nkr_note_mod_1133006", "type": "mod", "text": "述【大】，述按東域亦云十四恐倒海東珍錄義鏡并云四十【甲】"}
{"id": null, "n": "1133007", "target": "#nkr_note_mod_1133007", "type": "mod", "text": "述【大】，述按猶有或八十卷或百卷不同【甲】"}
{"id": null, "n": "1133008", "target": "#nkr_note_mod_1133008", "type": "mod", "text": "述【大】，述按義鏡云搜玄記五卷亦名方軌亦曰略疏【甲】"}
{"id": null, "n": "1133009", "target": "#nkr_note_mod_1133009", "type": "mod", "text": "述【大】，述按東域義鏡不出海東通路并云略疏十二卷法藏述恐是【甲】"}
{"id": null, "n": "1133010", "target": "#nkr_note_mod_1133010", "type": "mod", "text": "述【大】，述按上十六部出華嚴傳【甲】"}
{"id": null, "n": "1133011", "target": "#nkr_note_mod_1133011", "type": "mod", "text": "述【大】，述按海東云智儼待勘【甲】"}
{"id": null, "n": "1133012", "target": "#nkr_note_mod_1133012", "type": "mod", "text": "述【大】，述按東域註賢首教分記云亦云五教分記與杜順撰名同義鏡云五教止觀【甲】"}
{"id": null, "n": "1133013", "target": "#nkr_note_mod_1133013", "type": "mod", "text": "述【大】，述按上四部出華嚴傳【甲】"}
{"id": null, "n": "1133014", "target": "#nkr_note_mod_1133014", "type": "mod", "text": "述【大】，述按內題云華嚴經內章門雜孔目【甲】"}
{"id": null, "n": "1133015", "target": "#nkr_note_mod_1133015", "type": "mod", "text": "述【大】，述按義鏡云五十要問答【甲】"}
{"id": null, "n": "1133016", "target": "#nkr_note_mod_1133016", "type": "mod", "text": "述【大】，述按東域云或作漩洑或作漩澓十卷【甲】"}
{"id": null, "n": "1133017", "target": "#nkr_note_mod_1133017", "type": "mod", "text": "數【大】，數按通路云三寶對辨懸談一卷法藏述逸而不行未知何正【甲】"}
{"id": null, "n": "1133018", "target": "#nkr_note_mod_1133018", "type": "mod", "text": "述【大】，述按一本云亦名五教分記或云一乘教分記【甲】"}
{"id": null, "n": "1133019", "target": "#nkr_note_mod_1133019", "type": "mod", "text": "述【大】，述按上五部出華嚴傳【甲】"}
{"id": null, "n": "1133020", "target": "#nkr_note_mod_1133020", "type": "mod", "text": "述【大】，述按東域註華嚴綱目云亦云八會綱目章不可別舉八會章通路義鏡亦不出待勘【甲】"}
{"id": null, "n": "1133021", "target": "#nkr_note_mod_1133021", "type": "mod", "text": "述【大】，述按有謂探玄中指唯識章者非法藏自撰指孔目中唯識章耳通路義鏡亦不出待勘【甲】"}
{"id": null, "n": "1133022", "target": "#nkr_note_mod_1133022", "type": "mod", "text": "述【大】，述按亦名義海百門【甲】"}
{"id": null, "n": "1133023", "target": "#nkr_note_mod_1133023", "type": "mod", "text": "述【大】，述按若准通路與上三昧觀同卷【甲】"}
{"id": null, "n": "1133024", "target": "#nkr_note_mod_1133024", "type": "mod", "text": "述【大】，述按義鏡云釋新華嚴【甲】"}
{"id": null, "n": "1133025", "target": "#nkr_note_mod_1133025", "type": "mod", "text": "卷【大】，卷按華嚴傳標上二部云右不知誰集但鳩集闕略未能備盡今賢首更廣其塵頗為詳悉【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "按華嚴傳標上二部云右不知誰集但鳩集闕略未能備盡今賢首更廣其塵頗為詳悉"}
{"id": null, "n": "1133026", "target": "#nkr_note_mod_1133026", "type": "mod", "text": "述【大】，述按上八部出華嚴傳【甲】"}
{"id": null, "n": "1133027", "target": "#nkr_note_mod_1133027", "type": "mod", "text": "卷【大】＊，卷按東域亦亡名【甲】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "按東域亦亡名"}
{"id": null, "n": "1134001", "target": "#nkr_note_mod_1134001", "type": "mod", "text": "卷【大】，卷按上二部請來東域並亡名【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "按上二部請來東域並亡名"}
{"id": null, "n": "1134002", "target": "#nkr_note_mod_1134002", "type": "mod", "text": "卷【大】，卷按請來東域並亡名【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "按請來東域並亡名"}
{"id": null, "n": "1134003", "target": "#nkr_note_mod_1134003", "type": "mod", "text": "述【大】，述按亦名義記【甲】"}
{"id": null, "n": "1134004", "target": "#nkr_note_mod_1134004", "type": "mod", "text": "述【大】，述按准東域此釋新譯論【甲】"}
{"id": null, "n": "1134005", "target": "#nkr_note_mod_1134005", "type": "mod", "text": "述【大】，述按東域云文與元曉別記同可考【甲】"}
{"id": null, "n": "1134006", "target": "#nkr_note_mod_1134006", "type": "mod", "text": "矣【大】，矣按云廬山誤也故東域云華嚴宗錄云廬山近代學者勘續高僧傳隋淨影寺慧遠【甲】"}
{"id": null, "n": "1134007", "target": "#nkr_note_mod_1134007", "type": "mod", "text": "述【大】，述按東域云道璿【甲】"}
{"id": null, "n": "1134008", "target": "#nkr_note_mod_1134008", "type": "mod", "text": "述【大】，述按通路云起信唯識同異章【甲】"}
{"id": null, "n": "1134009", "target": "#nkr_note_mod_1134009", "type": "mod", "text": "述【大】，述按此一部可入下和書中【甲】"}
{"id": null, "n": "1134010", "target": "#nkr_note_mod_1134010", "type": "mod", "text": "述【大】，述按東域云亦云鈔多入因明錄【甲】"}
{"id": null, "n": "1134011", "target": "#nkr_note_mod_1134011", "type": "mod", "text": "述【大】，述按海東云宗要【甲】"}
{"id": null, "n": "1135001", "target": "#nkr_note_mod_1135001", "type": "mod", "text": "述【大】，述按東域云亦云紀衡亦云前記亦云略記【甲】"}
{"id": null, "n": "1135002", "target": "#nkr_note_mod_1135002", "type": "mod", "text": "述【大】，述按東域作智頴俊錄作智頻未知何正【甲】"}
{"id": null, "n": "1135003", "target": "#nkr_note_mod_1135003", "type": "mod", "text": "卷【大】，卷按與上別數不符合總別數中恐有寫誤【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "按與上別數不符合總別數中恐有寫誤"}
