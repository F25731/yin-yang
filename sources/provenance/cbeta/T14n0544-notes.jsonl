{"id": null, "n": "0839030", "target": "#nkr_note_orig_0839030", "type": "orig", "text": "〔於〕－【三】【宮】"}
{"id": null, "n": "0839031", "target": "#nkr_note_orig_0839031", "type": "orig", "text": "貧＝是【三】【宮】"}
{"id": null, "n": "0839032", "target": "#nkr_note_orig_0839032", "type": "orig", "text": "時＝食【三】【宮】"}
{"id": null, "n": "0839033", "target": "#nkr_note_orig_0839033", "type": "orig", "text": "者＋（當）【三】【宮】"}
{"id": null, "n": "0839034", "target": "#nkr_note_orig_0839034", "type": "orig", "text": "供養＋（佛乃至）【三】【宮】"}
{"id": null, "n": "0839035", "target": "#nkr_note_orig_0839035", "type": "orig", "text": "七＝十【三】"}
{"id": null, "n": "0839036", "target": "#nkr_note_orig_0839036", "type": "orig", "text": "已＝以【宋】【元】【宮】"}
{"id": null, "n": "0839037", "target": "#nkr_note_orig_0839037", "type": "orig", "text": "作禮＝禮拜【三】【宮】"}
{"id": null, "n": "0839038", "target": "#nkr_note_orig_0839038", "type": "orig", "text": "是＋（許之）【三】【宮】"}
{"id": null, "n": "0839039", "target": "#nkr_note_orig_0839039", "type": "orig", "text": "（諸）＋弟【三】【宮】"}
{"id": null, "n": "0839040", "target": "#nkr_note_orig_0839040", "type": "orig", "text": "設＝養【三】【宮】"}
{"id": null, "n": "0839041", "target": "#nkr_note_orig_0839041", "type": "orig", "text": "得蒙＝蒙得【三】【宮】"}
{"id": null, "n": "0839042", "target": "#nkr_note_orig_0839042", "type": "orig", "text": "眼＝曉【三】【宮】"}
{"id": null, "n": "0840001", "target": "#nkr_note_orig_0840001", "type": "orig", "text": "吾＝我【三】【宮】"}
{"id": null, "n": "0840002", "target": "#nkr_note_orig_0840002", "type": "orig", "text": "僧＝其【三】【宮】"}
{"id": null, "n": "0840003", "target": "#nkr_note_orig_0840003", "type": "orig", "text": "飯食出即＝而出即生【三】【宮】"}
{"id": null, "n": "0840004", "target": "#nkr_note_orig_0840004", "type": "orig", "text": "此等眾聖＝斯等聖眾【三】【宮】"}
{"id": null, "n": "0840005", "target": "#nkr_note_orig_0840005", "type": "orig", "text": "為＝是【三】【宮】"}
{"id": null, "n": "0840006", "target": "#nkr_note_orig_0840006", "type": "orig", "text": "自作身受患＝身自作受殃【三】【宮】"}
{"id": null, "n": "0840007", "target": "#nkr_note_orig_0840007", "type": "orig", "text": "天＝大【明】"}
{"id": null, "n": "0840008", "target": "#nkr_note_orig_0840008", "type": "orig", "text": "〔欲〕－【三】【宮】"}
{"id": null, "n": "0840009", "target": "#nkr_note_orig_0840009", "type": "orig", "text": "禮＋（歡喜）【三】【宮】"}
{"id": null, "n": "0840010", "target": "#nkr_note_orig_0840010", "type": "orig", "text": "政＝正【三】【宮】"}
{"id": null, "n": "0840011", "target": "#nkr_note_orig_0840011", "type": "orig", "text": "坐起＝座而起【三】【宮】"}
{"id": null, "n": "0840012", "target": "#nkr_note_orig_0840012", "type": "orig", "text": "言＋（世尊）【三】【宮】"}
{"id": null, "n": "0840013", "target": "#nkr_note_orig_0840013", "type": "orig", "text": "此＝斯【三】【宮】"}
{"id": null, "n": "0840014", "target": "#nkr_note_orig_0840014", "type": "orig", "text": "行＝持之【三】【宮】"}
{"id": null, "n": "0840015", "target": "#nkr_note_orig_0840015", "type": "orig", "text": "為＝曰【三】【宮】"}
{"id": null, "n": "0840016", "target": "#nkr_note_orig_0840016", "type": "orig", "text": "〔有〕－【三】【宮】"}
{"id": null, "n": "0840017", "target": "#nkr_note_orig_0840017", "type": "orig", "text": "諷＝讀【三】【宮】"}
{"id": null, "n": "0840018", "target": "#nkr_note_orig_0840018", "type": "orig", "text": "侍我＝持佛【三】【宮】"}
{"id": null, "n": "0840019", "target": "#nkr_note_orig_0840019", "type": "orig", "text": "決＝記【三】【宮】"}
{"id": null, "n": "0840020", "target": "#nkr_note_orig_0840020", "type": "orig", "text": "經＋（終）【明】"}
