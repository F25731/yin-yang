{"id": null, "n": null, "target": null, "type": "cf1", "text": "K05n0013_p0980a01"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "Q05_p0361a26"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K05n0013_p0980b17"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "Q05_p0361b28"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K05n0013_p0983c10"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "Q05_p0363c01"}
{"id": null, "n": "0748026", "target": "#nkr_note_mod_0748026", "type": "mod", "text": "天竺三藏【大】，三藏法師【宮】"}
{"id": null, "n": "0748028", "target": "#nkr_note_mod_0748028", "type": "mod", "text": "應云何【大】，云何應【明】"}
{"id": null, "n": "0749001", "target": "#nkr_note_mod_0749001", "type": "mod", "text": "來【大】，不來【明】（CBETA 按：《金剛般若經疏》：「阿那含，此云不還，亦云不來，欲界結盡，上界證無學，應云不來，略以『無』兼『不』，互文現耳。」（T33n1698_p0078c08-10））"}
{"id": null, "n": "0749002", "target": "#nkr_note_mod_0749002", "type": "mod", "text": "樂阿蘭那行者 Araṇāvihārin."}
{"id": null, "n": "0749004", "target": "#nkr_note_mod_0749004", "type": "mod", "text": "不【大】，不不也【宋】【元】【明】【宮】"}
{"id": null, "n": "0749005", "target": "#nkr_note_mod_0749005", "type": "mod", "text": "則【大】＊，即【明】＊"}
{"id": null, "n": "0750001", "target": "#nkr_note_mod_0750001", "type": "mod", "text": "非【大】，即非【明】"}
{"id": null, "n": "0750003", "target": "#nkr_note_mod_0750003", "type": "mod", "text": "分【大】，亦【宮】"}
{"id": null, "n": "0750004", "target": "#nkr_note_mod_0750004", "type": "mod", "text": "發大乘者 Agrayāna saṃprasthita."}
{"id": null, "n": "0750005", "target": "#nkr_note_mod_0750005", "type": "mod", "text": "發最上乘者 Śreṣṭayāna saṃprasthita."}
{"id": null, "n": "0750006", "target": "#nkr_note_mod_0750006", "type": "mod", "text": "樂小法者 Hīnādhimuktika."}
{"id": null, "n": "0750007", "target": "#nkr_note_mod_0750007", "type": "mod", "text": "罪【大】＊，󰏌【明】＊"}
{"id": null, "n": "0751001", "target": "#nkr_note_mod_0751001", "type": "mod", "text": "提【大】＊，提心【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0751002", "target": "#nkr_note_mod_0751002", "type": "mod", "text": "提【大】，提心【宋】【元】【明】【宮】"}
{"id": null, "n": "0751003", "target": "#nkr_note_mod_0751003", "type": "mod", "text": "受【大】＊，授【明】＊"}
{"id": null, "n": "0751004", "target": "#nkr_note_mod_0751004", "type": "mod", "text": "恒【大】，知恒【明】"}
{"id": null, "n": "0751005", "target": "#nkr_note_mod_0751005", "type": "mod", "text": "等【大】，沙等【元】【明】"}
{"id": null, "n": "0751006", "target": "#nkr_note_mod_0751006", "type": "mod", "text": "如【大】，佛言如【宋】【元】【明】【宮】"}
{"id": null, "n": "0751007", "target": "#nkr_note_mod_0751007", "type": "mod", "text": "非【大】，即非【明】"}
{"id": null, "n": "0752001", "target": "#nkr_note_mod_0752001", "type": "mod", "text": "百【大】，〔－〕【宋】"}
{"id": null, "n": "0752002", "target": "#nkr_note_mod_0752002", "type": "mod", "text": "夫【大】，夫是名凡夫【宋】【元】"}
{"id": null, "n": "0752003", "target": "#nkr_note_mod_0752003", "type": "mod", "text": "提【大】，提心【宋】【元】【明】"}
{"id": null, "n": "0752004", "target": "#nkr_note_mod_0752004", "type": "mod", "text": "相【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0752005", "target": "#nkr_note_mod_0752005", "type": "mod", "text": "寶【大】，寶持用【宋】【元】【明】【宮】"}
{"id": null, "n": "0752006", "target": "#nkr_note_mod_0752006", "type": "mod", "text": "德【大】，德何以故【宋】【明】【宮】"}
{"id": null, "n": "0752007", "target": "#nkr_note_mod_0752007", "type": "mod", "text": "不【大】，不不也【宋】【元】【明】【宮】"}
{"id": null, "n": "0752008", "target": "#nkr_note_mod_0752008", "type": "mod", "text": "薩【大】，提【明】"}
{"id": null, "n": "0752009", "target": "#nkr_note_mod_0752009", "type": "mod", "text": "一切有為法如夢幻泡影如露亦如電應作如是觀【大】，Tārakā timiraṃ dīpo māyāvaśyāya budbudaṃ, svapnaṃ ca vidyud abhraṃ ca evaṃ draṣṭavyaṃ saṃskṛtaṃ."}
{"id": null, "n": "0752010", "target": "#nkr_note_mod_0752010", "type": "mod", "text": "（真言…訶）三十五字【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0748025", "target": "#nkr_note_orig_0748025", "type": "orig", "text": "Vajracchedikā[-prajñāpā amitā]"}
{"id": null, "n": "0748026", "target": "#nkr_note_orig_0748026", "type": "orig", "text": "天竺三藏＝三藏法師【宮】"}
{"id": null, "n": "0748027", "target": "#nkr_note_orig_0748027", "type": "orig", "text": "subhūti"}
{"id": null, "n": "0748028", "target": "#nkr_note_orig_0748028", "type": "orig", "text": "應云何＝云何應【明】"}
{"id": null, "n": "0749001", "target": "#nkr_note_orig_0749001", "type": "orig", "text": "（不）＋來【明】"}
{"id": null, "n": "0749002", "target": "#nkr_note_orig_0749002", "type": "orig", "text": "樂阿蘭那行者. Araṇāvihārin."}
{"id": null, "n": "0749003", "target": "#nkr_note_orig_0749003", "type": "orig", "text": "然燈佛 Dīpaṃkara."}
{"id": null, "n": "0749004", "target": "#nkr_note_orig_0749004", "type": "orig", "text": "不＋（不也）【三】【宮】"}
{"id": null, "n": "0749005", "target": "#nkr_note_orig_0749005", "type": "orig", "text": "則＝即【明】＊"}
{"id": null, "n": "0750001", "target": "#nkr_note_orig_0750001", "type": "orig", "text": "（即）＋非【明】"}
{"id": null, "n": "0750002", "target": "#nkr_note_orig_0750002", "type": "orig", "text": "Kaīṅga."}
{"id": null, "n": "0750003", "target": "#nkr_note_orig_0750003", "type": "orig", "text": "分＝亦【宮】"}
{"id": null, "n": "0750004", "target": "#nkr_note_orig_0750004", "type": "orig", "text": "發大乘者. Agrayāna saṃprasthita."}
{"id": null, "n": "0750005", "target": "#nkr_note_orig_0750005", "type": "orig", "text": "發最上乘者. Śreṣṭayāna saṃprasthita."}
{"id": null, "n": "0750006", "target": "#nkr_note_orig_0750006", "type": "orig", "text": "樂小法者. Hīnādhimuktika."}
{"id": null, "n": "0750007", "target": "#nkr_note_orig_0750007", "type": "orig", "text": "罪＝󰏌【明】＊"}
{"id": null, "n": "0751001", "target": "#nkr_note_orig_0751001", "type": "orig", "text": "提＋（心）【三】＊"}
{"id": null, "n": "0751002", "target": "#nkr_note_orig_0751002", "type": "orig", "text": "提＋（心）【三】【宮】"}
{"id": null, "n": "0751003", "target": "#nkr_note_orig_0751003", "type": "orig", "text": "受＝授【明】＊"}
{"id": null, "n": "0751004", "target": "#nkr_note_orig_0751004", "type": "orig", "text": "（知）＋恒【明】"}
{"id": null, "n": "0751005", "target": "#nkr_note_orig_0751005", "type": "orig", "text": "（沙）＋等【元】【明】"}
{"id": null, "n": "0751006", "target": "#nkr_note_orig_0751006", "type": "orig", "text": "（佛言）＋如【三】【宮】"}
{"id": null, "n": "0751007", "target": "#nkr_note_orig_0751007", "type": "orig", "text": "（即）＋非【明】"}
{"id": null, "n": "0752001", "target": "#nkr_note_orig_0752001", "type": "orig", "text": "〔百〕－【宋】"}
{"id": null, "n": "0752002", "target": "#nkr_note_orig_0752002", "type": "orig", "text": "夫＋（是名凡夫）【宋】【元】"}
{"id": null, "n": "0752003", "target": "#nkr_note_orig_0752003", "type": "orig", "text": "提＋（心）【三】"}
{"id": null, "n": "0752004", "target": "#nkr_note_orig_0752004", "type": "orig", "text": "〔相〕－【三】【宮】"}
{"id": null, "n": "0752005", "target": "#nkr_note_orig_0752005", "type": "orig", "text": "寶＋（持用）【三】【宮】"}
{"id": null, "n": "0752006", "target": "#nkr_note_orig_0752006", "type": "orig", "text": "德＋（何以故）【宋】【明】【宮】"}
{"id": null, "n": "0752007", "target": "#nkr_note_orig_0752007", "type": "orig", "text": "不＋（不也）【三】【宮】"}
{"id": null, "n": "0752008", "target": "#nkr_note_orig_0752008", "type": "orig", "text": "薩＝提【明】"}
{"id": null, "n": "0752009", "target": "#nkr_note_orig_0752009", "type": "orig", "text": "偈 Tārakā timiraṃ dīpo māyāvaśyāya budbudaṃ, svapnaṃ ca vidyud abhraṃ ca evaṃ draṣṭavyaṃ saṃskṛtaṃ."}
{"id": null, "n": "0752010", "target": "#nkr_note_orig_0752010", "type": "orig", "text": "〔真言…訶〕三十五字－【三】"}
{"id": null, "n": "0749b2101", "target": "#nkr_note_add_0749b2101", "type": "add", "text": "福德【CB】【麗-CB】【磧-CB】，復福【大】"}
{"id": null, "n": "0749c2601", "target": "#nkr_note_add_0749c2601", "type": "add", "text": "有【CB】【麗-CB】【磧-CB】，所【大】"}
{"id": null, "n": "0751b1201", "target": "#nkr_note_add_0751b1201", "type": "add", "text": "CBETA 按：此處頓號在於表達二種無我故，謂人無我、法無我。"}
{"id": null, "n": "0752a2201", "target": "#nkr_note_add_0752a2201", "type": "add", "text": "汝【CB】【麗-CB】【磧-CB】，［－］【大】"}
{"id": null, "n": null, "target": "#nkr_note_foreign_0748025", "type": null, "text": "Vajracchedikā[-prajñāpā amitā]"}
{"id": null, "n": null, "target": "#nkr_note_foreign_0748027", "type": null, "text": "subhūti"}
{"id": null, "n": null, "target": "#nkr_note_foreign_0750002", "type": null, "text": "Kaīṅga."}
