{"id": null, "n": "0385001", "target": "#nkr_note_mod_0385001", "type": "mod", "text": "「＊」號以前的文字為西夏本所不存，按照房山石經甲本行款錄文。「＊」以後文字按照西夏本行款錄文。"}
{"id": null, "n": "0383001", "target": "#nkr_note_orig_0383001", "type": "orig", "text": "「疾」，乙本作「災」。"}
{"id": null, "n": "0383002", "target": "#nkr_note_orig_0383002", "type": "orig", "text": "「種」，甲本漏，據乙本補。"}
{"id": null, "n": "0383003", "target": "#nkr_note_orig_0383003", "type": "orig", "text": "「咒」，甲本漏，據乙本補。"}
{"id": null, "n": "0384001", "target": "#nkr_note_orig_0384001", "type": "orig", "text": "「心」，乙本作「心大」。"}
{"id": null, "n": "0384002", "target": "#nkr_note_orig_0384002", "type": "orig", "text": "「時」，甲本漏，據乙本補。"}
{"id": null, "n": "0385001", "target": "#nkr_note_orig_0385001", "type": "orig", "text": "「＊」號以為的文字為西夏本所不存，按照房山石經甲本行款錄文。「＊」以後文字按照西夏本行款錄文。"}
{"id": null, "n": "0386001", "target": "#nkr_note_orig_0386001", "type": "orig", "text": "「積」，西夏本作「種」，據甲、乙本改。"}
{"id": null, "n": "0386002", "target": "#nkr_note_orig_0386002", "type": "orig", "text": "「性」，甲本漏，據乙本補。"}
{"id": null, "n": "0387001", "target": "#nkr_note_orig_0387001", "type": "orig", "text": "「佛頂心觀世音經卷上」，甲本漏，據乙本補。"}
{"id": null, "n": "0387002", "target": "#nkr_note_orig_0387002", "type": "orig", "text": "「用」，甲本殘，據乙本補。"}
{"id": null, "n": "0387003", "target": "#nkr_note_orig_0387003", "type": "orig", "text": "「日」，甲、乙本作「月」。"}
{"id": null, "n": "0388001", "target": "#nkr_note_orig_0388001", "type": "orig", "text": "「痛」，甲本作「病」，據乙本改。"}
{"id": null, "n": "0388002", "target": "#nkr_note_orig_0388002", "type": "orig", "text": "「申」，甲本作「由」，據乙本改。"}
{"id": null, "n": "0388003", "target": "#nkr_note_orig_0388003", "type": "orig", "text": "「印」，乙本無。"}
{"id": null, "n": "0388004", "target": "#nkr_note_orig_0388004", "type": "orig", "text": "「佛」，甲、乙本作「佛，不住中陰佛」。"}
{"id": null, "n": "0388005", "target": "#nkr_note_orig_0388005", "type": "orig", "text": "「至」，乙本作「志」。"}
{"id": null, "n": "0389001", "target": "#nkr_note_orig_0389001", "type": "orig", "text": "「佛頂心觀世音經卷中」，甲本漏，據乙本補。"}
{"id": null, "n": "0391001", "target": "#nkr_note_orig_0391001", "type": "orig", "text": "「及」，甲本漏，據乙本補。"}
{"id": null, "n": "0391002", "target": "#nkr_note_orig_0391002", "type": "orig", "text": "「苦」，甲本漏，據乙本補。"}
{"id": null, "n": "0391003", "target": "#nkr_note_orig_0391003", "type": "orig", "text": "「喚」，甲本作「啖」，據乙本改。"}
{"id": null, "n": "0391004", "target": "#nkr_note_orig_0391004", "type": "orig", "text": "「特」，甲本作「時」，據西夏本、乙本改。"}
{"id": null, "n": "0391005", "target": "#nkr_note_orig_0391005", "type": "orig", "text": "「直」，乙本作「已」。"}
{"id": null, "n": "0392001", "target": "#nkr_note_orig_0392001", "type": "orig", "text": "「緣」，甲本作「經」，據乙本改。"}
{"id": null, "n": "0392002", "target": "#nkr_note_orig_0392002", "type": "orig", "text": "「怨」，西夏本作「冤」，據甲、乙本改。"}
{"id": null, "n": "0392003", "target": "#nkr_note_orig_0392003", "type": "orig", "text": "「夜」，甲本作「野」，據西夏本、乙本改。"}
{"id": null, "n": "0392004", "target": "#nkr_note_orig_0392004", "type": "orig", "text": "「汝」，甲本作「我」，據西夏本、乙本改。"}
{"id": null, "n": "0392005", "target": "#nkr_note_orig_0392005", "type": "orig", "text": "「兩」，西夏本、甲、乙本均作「雨」，據文意改。"}
{"id": null, "n": "0393001", "target": "#nkr_note_orig_0393001", "type": "orig", "text": "「理」，疑或為「李」字之誤。"}
{"id": null, "n": "0393002", "target": "#nkr_note_orig_0393002", "type": "orig", "text": "「盛」，西夏本作「城」，居甲、乙本改。"}
{"id": null, "n": "0394001", "target": "#nkr_note_orig_0394001", "type": "orig", "text": "「兩」，甲本作「二」，據西夏本、乙本改。"}
{"id": null, "n": "0394002", "target": "#nkr_note_orig_0394002", "type": "orig", "text": "「得」，西夏本、甲本漏，據乙本補。"}
{"id": null, "n": "0394003", "target": "#nkr_note_orig_0394003", "type": "orig", "text": "「被」，甲、乙本作「備」，據文意改。"}
{"id": null, "n": "0394004", "target": "#nkr_note_orig_0394004", "type": "orig", "text": "「近」，甲本漏，據乙本補。"}
