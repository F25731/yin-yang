{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "普寧律師\n《會粹記》，明義大師《隨難解》"}
{"id": null, "n": null, "target": null, "type": null, "text": "淨覺大師述《名義》，金山闍梨《拾遺圖》"}
{"id": null, "n": null, "target": null, "type": null, "text": "晝刻"}
{"id": null, "n": null, "target": null, "type": null, "text": "夜刻"}
{"id": null, "n": null, "target": null, "type": null, "text": "小雪後十二日，連大雪及冬至并小寒後三日"}
{"id": null, "n": null, "target": null, "type": null, "text": "小寒後四日至大寒後二日，小雪前一日至後十一日"}
{"id": null, "n": null, "target": null, "type": null, "text": "大寒後三日至十二日，立冬後四日至十三日"}
{"id": null, "n": null, "target": null, "type": null, "text": "立春前二日至後四日，立冬前四日至後三日"}
{"id": null, "n": null, "target": null, "type": null, "text": "立春後五日至後十二日，霜降後四日後十日"}
{"id": null, "n": null, "target": null, "type": null, "text": "雨水前二日至後三日，霜降前二日至後三日"}
{"id": null, "n": null, "target": null, "type": null, "text": "雨水後四日至後九日，寒露後六日至十二日"}
{"id": null, "n": null, "target": null, "type": null, "text": "雨水後十日至啟蟄節日，寒露前一日至後五日"}
{"id": null, "n": null, "target": null, "type": null, "text": "啟蟄後一日至後六日，秋分後九日至後十三日"}
{"id": null, "n": null, "target": null, "type": null, "text": "啟蟄後七日至後十二日，秋分後四日至後八日"}
{"id": null, "n": null, "target": null, "type": null, "text": "春分前二日至後三日，秋分前二日至後三日"}
{"id": null, "n": null, "target": null, "type": null, "text": "春分後四日至後八日，白露後七日至後十二日"}
{"id": null, "n": null, "target": null, "type": null, "text": "春分後九日至後十三日，白露後一日至後六日"}
{"id": null, "n": null, "target": null, "type": null, "text": "清明前一日至後五日，處暑後十日至白露節日"}
{"id": null, "n": null, "target": null, "type": null, "text": "清明後六日至後十一日，處暑後五日至後九日"}
{"id": null, "n": null, "target": null, "type": null, "text": "穀雨前三日至後三日，立秋後十二日至處暑後四日"}
{"id": null, "n": null, "target": null, "type": null, "text": "糓雨後四日至後十日，立秋後五日至後十一日"}
{"id": null, "n": null, "target": null, "type": null, "text": "糓雨後十一日至立夏後三日，大暑十二日至立秋後四日"}
{"id": null, "n": null, "target": null, "type": null, "text": "立夏後四日至後十三日，大暑後二日至後十一日"}
{"id": null, "n": null, "target": null, "type": null, "text": "小滿前一日至後十一日，小暑後四日至大暑後一日"}
{"id": null, "n": null, "target": null, "type": null, "text": "芒種前三日，連夏至及小暑後三日同"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
