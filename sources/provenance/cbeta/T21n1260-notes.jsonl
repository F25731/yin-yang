{"id": null, "n": "0286002", "target": "#nkr_note_mod_0286002", "type": "mod", "text": "（一卷…經）九字【大】，〔－〕【明】【乙】，〔一卷〕－【甲】"}
{"id": null, "n": "0286003", "target": "#nkr_note_mod_0286003", "type": "mod", "text": "經【大】，法【甲】"}
{"id": null, "n": "0286004", "target": "#nkr_note_mod_0286004", "type": "mod", "text": "開府儀同三司特進試鴻臚卿肅國公食邑三千戶賜紫贈司空諡大鑒正號大廣智大興善寺三藏沙門【大】，唐北天竺三藏法門大廣智【明】，唐北天竺三藏沙門大廣智【乙】，大興善寺三藏沙門大廣智【甲】"}
{"id": null, "n": "0286005", "target": "#nkr_note_mod_0286005", "type": "mod", "text": "住【大】，在【明】【甲】【乙】"}
{"id": null, "n": "0286006", "target": "#nkr_note_mod_0286006", "type": "mod", "text": "娑【大】，沙【明】【乙】"}
{"id": null, "n": "0286007", "target": "#nkr_note_mod_0286007", "type": "mod", "text": "將【大】，女【甲】"}
{"id": null, "n": "0286008", "target": "#nkr_note_mod_0286008", "type": "mod", "text": "昔云【大】，名【明】，名云【甲】，古名【乙】"}
{"id": null, "n": "0286009", "target": "#nkr_note_mod_0286009", "type": "mod", "text": "護【大】，護惡【甲】"}
{"id": null, "n": "0286010", "target": "#nkr_note_mod_0286010", "type": "mod", "text": "五【大】，五戒【明】【乙】"}
{"id": null, "n": "0286011", "target": "#nkr_note_mod_0286011", "type": "mod", "text": "唯【大】＊，惟【明】【乙】＊"}
{"id": null, "n": "0286012", "target": "#nkr_note_mod_0286012", "type": "mod", "text": "引【大】，〔－〕【明】【乙】"}
{"id": null, "n": "0286013", "target": "#nkr_note_mod_0286013", "type": "mod", "text": "反【大】＊，切【明】【乙】＊"}
{"id": null, "n": "0286014", "target": "#nkr_note_mod_0286014", "type": "mod", "text": "去【大】＊，去聲【明】【乙】＊"}
{"id": null, "n": "0286015", "target": "#nkr_note_mod_0286015", "type": "mod", "text": "一【大】，二【明】【甲】【乙】"}
{"id": null, "n": "0286016", "target": "#nkr_note_mod_0286016", "type": "mod", "text": "嚩【大】，嚩囉引【明】【甲】【乙】"}
{"id": null, "n": "0286017", "target": "#nkr_note_mod_0286017", "type": "mod", "text": "迦【大】，孕迦【考偽-乙】"}
{"id": null, "n": "0286018", "target": "#nkr_note_mod_0286018", "type": "mod", "text": "三【大】，二【乙】"}
{"id": null, "n": "0286019", "target": "#nkr_note_mod_0286019", "type": "mod", "text": "去【大】，〔－〕【明】【乙】"}
{"id": null, "n": "0286020", "target": "#nkr_note_mod_0286020", "type": "mod", "text": "訖【大】，紇【明】【甲】【乙】"}
{"id": null, "n": "0286021", "target": "#nkr_note_mod_0286021", "type": "mod", "text": "跢【大】，哆【明】【乙】"}
{"id": null, "n": "0286022", "target": "#nkr_note_mod_0286022", "type": "mod", "text": "囉【大】，哩【明】【甲】【乙】"}
{"id": null, "n": "0286023", "target": "#nkr_note_mod_0286023", "type": "mod", "text": "二合【大】，泥以反【甲】"}
{"id": null, "n": "0286024", "target": "#nkr_note_mod_0286024", "type": "mod", "text": "寗【大】，寧【明】【乙】"}
{"id": null, "n": "0286025", "target": "#nkr_note_mod_0286025", "type": "mod", "text": "拏【大】，拏鼻引【明】【甲】【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "鼻引"}
{"id": null, "n": "0286026", "target": "#nkr_note_mod_0286026", "type": "mod", "text": "諸有【大】，有情【明】【甲】【乙】"}
{"id": null, "n": "0286027", "target": "#nkr_note_mod_0286027", "type": "mod", "text": "欲【大】，能【甲】"}
{"id": null, "n": "0286028", "target": "#nkr_note_mod_0286028", "type": "mod", "text": "妹【大】，姝【明】【甲】【乙】"}
{"id": null, "n": "0286029", "target": "#nkr_note_mod_0286029", "type": "mod", "text": "兩【大】，南【明】"}
{"id": null, "n": "0286030", "target": "#nkr_note_mod_0286030", "type": "mod", "text": "侍【大】，兒【明】"}
{"id": null, "n": "0286031", "target": "#nkr_note_mod_0286031", "type": "mod", "text": "洒【大】，灑【明】【乙】"}
{"id": null, "n": "0286032", "target": "#nkr_note_mod_0286032", "type": "mod", "text": "埿【大】，泥【明】【甲】【乙】"}
{"id": null, "n": "0286033", "target": "#nkr_note_mod_0286033", "type": "mod", "text": "於【大】，〔－〕【明】"}
{"id": null, "n": "0286034", "target": "#nkr_note_mod_0286034", "type": "mod", "text": "幡【大】，旛【明】【乙】"}
{"id": null, "n": "0287001", "target": "#nkr_note_mod_0287001", "type": "mod", "text": "唵【大】＊，唵一【明】【乙】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": "0287002", "target": "#nkr_note_mod_0287002", "type": "mod", "text": "弩【大】，努【明】【甲】【乙】"}
{"id": null, "n": "0287003", "target": "#nkr_note_mod_0287003", "type": "mod", "text": "鼻【大】，鼻音【明】【乙】"}
{"id": null, "n": "0287004", "target": "#nkr_note_mod_0287004", "type": "mod", "text": "諦【大】，帝【甲】"}
{"id": null, "n": "0287005", "target": "#nkr_note_mod_0287005", "type": "mod", "text": "合【大】，合引【明】【甲】【乙】"}
{"id": null, "n": "0287006", "target": "#nkr_note_mod_0287006", "type": "mod", "text": "引【大】＊，引二【明】【乙】＊"}
{"id": null, "n": "0287007", "target": "#nkr_note_mod_0287007", "type": "mod", "text": "或【大】，〔－〕【明】【乙】"}
{"id": null, "n": "0287008", "target": "#nkr_note_mod_0287008", "type": "mod", "text": "有【大】，有相【乙】"}
{"id": null, "n": "0287009", "target": "#nkr_note_mod_0287009", "type": "mod", "text": "意【大】，任意【校異-乙】"}
{"id": null, "n": "0287010", "target": "#nkr_note_mod_0287010", "type": "mod", "text": "寐【大】，〔－〕【甲】"}
{"id": null, "n": "0287011", "target": "#nkr_note_mod_0287011", "type": "mod", "text": "息【大】＊，悉【明】【甲】＊"}
{"id": null, "n": "0287012", "target": "#nkr_note_mod_0287012", "type": "mod", "text": "囉【大】，羅【明】【乙】"}
{"id": null, "n": "0287013", "target": "#nkr_note_mod_0287013", "type": "mod", "text": "萬【大】，百【甲】"}
{"id": null, "n": "0287014", "target": "#nkr_note_mod_0287014", "type": "mod", "text": "彼【大】，〔－〕【甲】"}
{"id": null, "n": "0287015", "target": "#nkr_note_mod_0287015", "type": "mod", "text": "旦【CB】【明】【乙】，且【大】"}
{"id": null, "n": "0287016", "target": "#nkr_note_mod_0287016", "type": "mod", "text": "險【大】，驗【明】【甲】【乙】"}
{"id": null, "n": "0287017", "target": "#nkr_note_mod_0287017", "type": "mod", "text": "復【大】，數【明】"}
{"id": null, "n": "0287018", "target": "#nkr_note_mod_0287018", "type": "mod", "text": "不【大】，若得不【校異-乙】"}
{"id": null, "n": "0288001", "target": "#nkr_note_mod_0288001", "type": "mod", "text": "靜【大】，淨【明】【甲】【乙】"}
{"id": null, "n": "0288002", "target": "#nkr_note_mod_0288002", "type": "mod", "text": "欲【大】，〔－〕【明】【乙】"}
{"id": null, "n": "0288003", "target": "#nkr_note_mod_0288003", "type": "mod", "text": "等【大】，〔－〕【甲】"}
{"id": null, "n": "0288004", "target": "#nkr_note_mod_0288004", "type": "mod", "text": "切【大】，切更【甲】"}
{"id": null, "n": "0288005", "target": "#nkr_note_mod_0288005", "type": "mod", "text": "持【大】，得【甲】，修【校異-乙】"}
{"id": null, "n": "0288006", "target": "#nkr_note_mod_0288006", "type": "mod", "text": "役【大】，便【甲】"}
{"id": null, "n": "0288007", "target": "#nkr_note_mod_0288007", "type": "mod", "text": "召【大】，〔－〕【明】"}
{"id": null, "n": "0288008", "target": "#nkr_note_mod_0288008", "type": "mod", "text": "裹【大】，裏【明】"}
{"id": null, "n": "0288009", "target": "#nkr_note_mod_0288009", "type": "mod", "text": "來【大】，去【明】【乙】"}
{"id": null, "n": "0288010", "target": "#nkr_note_mod_0288010", "type": "mod", "text": "淨【大】，〔－〕【明】【乙】"}
