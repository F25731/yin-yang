{"id": null, "n": "0875011", "target": "#nkr_note_mod_0875011", "type": "mod", "text": "加【大】，跏【明】"}
{"id": null, "n": "0875012", "target": "#nkr_note_mod_0875012", "type": "mod", "text": "調【大】，掉【元】【明】"}
{"id": null, "n": "0875013", "target": "#nkr_note_mod_0875013", "type": "mod", "text": "是【大】，此【宋】【元】【明】"}
