{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": "0940002", "target": "#nkr_note_mod_0940002", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0940003", "target": "#nkr_note_mod_0940003", "type": "mod", "text": "開府儀同三司特進試鴻臚卿【大】，〔－〕【宋】【元】，唐特進試鴻臚卿【明】【甲】，普賢瑜伽阿闍梨集開府儀同三司特進試鴻臚卿【宋】【元】【明】【甲】，甲本朱書曰大師請來本無普賢瑜伽阿闍梨集八字"}
{"id": null, "n": "0940004", "target": "#nkr_note_mod_0940004", "type": "mod", "text": "肅國公食邑三千戶賜紫贈司空諡大鑒正號大廣智大興善寺【大】，〔－〕【明】【甲】，大興善寺【宋】【元】"}
{"id": null, "n": "0940005", "target": "#nkr_note_mod_0940005", "type": "mod", "text": "不【大】，大廣智不【宋】【元】【明】【甲】"}
{"id": null, "n": "0940006", "target": "#nkr_note_mod_0940006", "type": "mod", "text": "弟【大】，最上乘教受戒懺悔文弟【宋】【元】【明】【甲】，甲本朱書曰大師請來本無此九字，弟子乃至禮五十字宋元明三本甲本俱作長行"}
{"id": null, "n": "0940007", "target": "#nkr_note_mod_0940007", "type": "mod", "text": "唵【大】，唵一【甲】【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": "0940008", "target": "#nkr_note_mod_0940008", "type": "mod", "text": "日【CB】【宋】【元】【明】【甲】【乙】，曰【大】"}
{"id": null, "n": "0940009", "target": "#nkr_note_mod_0940009", "type": "mod", "text": "唯【大】下同，惟【宋】【元】【明】【甲】【乙】下同"}
{"id": null, "n": "0940010", "target": "#nkr_note_mod_0940010", "type": "mod", "text": "日囉【CB】，曰囉【大】，𭍒【宋】【元】"}
{"id": null, "n": "0940011", "target": "#nkr_note_mod_0940011", "type": "mod", "text": "合【大】，合引【甲】【乙】"}
{"id": null, "n": "0940012", "target": "#nkr_note_mod_0940012", "type": "mod", "text": "以【大】＊，已【明】【甲】【乙】＊"}
{"id": null, "n": "0941001", "target": "#nkr_note_mod_0941001", "type": "mod", "text": "怚【大】，怛【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0941004", "target": "#nkr_note_mod_0941004", "type": "mod", "text": "銷【大】，消【明】【甲】"}
{"id": null, "n": "0941005", "target": "#nkr_note_mod_0941005", "type": "mod", "text": "後【大】，往【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0941006", "target": "#nkr_note_mod_0941006", "type": "mod", "text": "菩提【大】，大菩提【宋】【元】【明】【甲】"}
{"id": null, "n": "0941007", "target": "#nkr_note_mod_0941007", "type": "mod", "text": "受【大】，最上乘教受戒懺悔文受【甲】【乙】"}
{"id": null, "n": "0941008", "target": "#nkr_note_mod_0941008", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0940001", "target": "#nkr_note_orig_0940001", "type": "orig", "text": "【原】麗本，【甲】黃蘗版淨嚴等校訂加筆本塚本賢曉氏藏，【乙】縮刷大藏經，甲本頭註朱書曰淨嚴云此本是貞元錄新入本非大師請來本"}
{"id": null, "n": "0940002", "target": "#nkr_note_orig_0940002", "type": "orig", "text": "〔一卷〕－【三】【甲】"}
{"id": null, "n": "0940003", "target": "#nkr_note_orig_0940003", "type": "orig", "text": "（普賢瑜伽阿闍梨集）八字＋開【三】【甲】，甲本朱書曰大師請來本無此八字，〔開府…智〕三十三字－【宋】【元】，開府儀同三司＝唐【明】【甲】"}
{"id": null, "n": "0940004", "target": "#nkr_note_orig_0940004", "type": "orig", "text": "〔肅國…寺〕二十五字－【明】【甲】"}
{"id": null, "n": "0940005", "target": "#nkr_note_orig_0940005", "type": "orig", "text": "（大廣智）＋不【三】【甲】"}
{"id": null, "n": "0940006", "target": "#nkr_note_orig_0940006", "type": "orig", "text": "（最上乘教受戒懺悔文）九字＋弟【三】【甲】，甲本朱書曰大師請來本無此九字，弟子乃至禮五十字宋元明三本甲本俱作長行"}
{"id": null, "n": "0940007", "target": "#nkr_note_orig_0940007", "type": "orig", "text": "唵＋（一）細註【甲】【乙】"}
{"id": null, "n": "0940008", "target": "#nkr_note_orig_0940008", "type": "orig", "text": "曰＝日【三】【甲】【乙】"}
{"id": null, "n": "0940009", "target": "#nkr_note_orig_0940009", "type": "orig", "text": "唯＝惟【三】【甲】【乙】下同"}
{"id": null, "n": "0940010", "target": "#nkr_note_orig_0940010", "type": "orig", "text": "曰囉＝𭍒【宋】【元】"}
{"id": null, "n": "0940011", "target": "#nkr_note_orig_0940011", "type": "orig", "text": "合＋（引）【甲】【乙】"}
{"id": null, "n": "0940012", "target": "#nkr_note_orig_0940012", "type": "orig", "text": "以＝已【明】【甲】【乙】＊"}
{"id": null, "n": "0941001", "target": "#nkr_note_orig_0941001", "type": "orig", "text": "怚＝怛【三】【甲】【乙】"}
{"id": null, "n": "0941002", "target": "#nkr_note_orig_0941002", "type": "orig", "text": "甲本朱書曰私云大師請來本文止于斯"}
{"id": null, "n": "0941003", "target": "#nkr_note_orig_0941003", "type": "orig", "text": "甲本頭註朱書曰已下仁運二師請來本"}
{"id": null, "n": "0941004", "target": "#nkr_note_orig_0941004", "type": "orig", "text": "銷＝消【明】【甲】"}
{"id": null, "n": "0941005", "target": "#nkr_note_orig_0941005", "type": "orig", "text": "後＝往【三】【甲】【乙】"}
{"id": null, "n": "0941006", "target": "#nkr_note_orig_0941006", "type": "orig", "text": "（大）＋菩提【三】【甲】"}
{"id": null, "n": "0941007", "target": "#nkr_note_orig_0941007", "type": "orig", "text": "（最上乘教受戒懺悔文）＋受【甲】【乙】"}
{"id": null, "n": "0941008", "target": "#nkr_note_orig_0941008", "type": "orig", "text": "〔一卷〕－【三】【甲】【乙】"}
{"id": null, "n": "0941009", "target": "#nkr_note_orig_0941009", "type": "orig", "text": "甲本奧書曰貞享甲子九月一日校正之了河州延命寺淨嚴四十六歲，元祿十五年十二月二十九日以和上御本再校了尊教寶永三丙戌之春得斯密軌而戊子之秋一校畢性寂"}
{"id": null, "n": "0940003", "target": "#nkr_note_rest_0940003", "type": "rest", "text": "甲本朱書曰大師請來本無此"}
{"id": null, "n": "0940006", "target": "#nkr_note_rest_0940006", "type": "rest", "text": "甲本朱書曰大師請來本無此九字"}
