{"id": null, "n": "0493014", "target": "#nkr_note_orig_0493014", "type": "orig", "text": "（莫與）＋與【三】"}
{"id": null, "n": "0493015", "target": "#nkr_note_orig_0493015", "type": "orig", "text": "蕩＝盪【元】【明】＊"}
{"id": null, "n": "0493016", "target": "#nkr_note_orig_0493016", "type": "orig", "text": "杅＝盂【三】"}
{"id": null, "n": "0493017", "target": "#nkr_note_orig_0493017", "type": "orig", "text": "慧＝惠【宋】＊"}
