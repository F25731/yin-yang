{"id": null, "n": "0493001", "target": "#nkr_note_mod_0493001", "type": "mod", "text": "經【大】，經一卷【元】"}
{"id": null, "n": "0493002", "target": "#nkr_note_mod_0493002", "type": "mod", "text": "附【大】，失譯附【宋】【元】，失譯人名附【明】"}
{"id": null, "n": "0493003", "target": "#nkr_note_mod_0493003", "type": "mod", "text": "～Sn. 4, S. 7. 2. 1. Kasi.，[No. 99(98), No. 100(204)]"}
{"id": null, "n": "0493004", "target": "#nkr_note_mod_0493004", "type": "mod", "text": "止【大】，上【宋】【元】【明】"}
{"id": null, "n": "0493005", "target": "#nkr_note_mod_0493005", "type": "mod", "text": "扠【大】，杈【宋】【元】【明】"}
{"id": null, "n": "0493006", "target": "#nkr_note_mod_0493006", "type": "mod", "text": "鄧【大】＊，𣃆【元】【明】＊"}
{"id": null, "n": "0493007", "target": "#nkr_note_mod_0493007", "type": "mod", "text": "我今【大】，今我【宋】【元】【明】"}
{"id": null, "n": "0493008", "target": "#nkr_note_mod_0493008", "type": "mod", "text": "出【大】，湧【明異】"}
{"id": null, "n": "0493009", "target": "#nkr_note_mod_0493009", "type": "mod", "text": "滊【大】，氣【宋】【元】【明】"}
{"id": null, "n": "0493010", "target": "#nkr_note_mod_0493010", "type": "mod", "text": "誡【大】＊，戒【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0493011", "target": "#nkr_note_mod_0493011", "type": "mod", "text": "～A. III. 57. Vacchagotta.，[No. 99(95), No. 100(261)]"}
{"id": null, "n": "0493012", "target": "#nkr_note_mod_0493012", "type": "mod", "text": "（莫與…施）七字【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0493013", "target": "#nkr_note_mod_0493013", "type": "mod", "text": "大【大】，與我弟子布施大【宋】【元】【明】"}
{"id": null, "n": "0493014", "target": "#nkr_note_mod_0493014", "type": "mod", "text": "與【大】，莫與與【宋】【元】【明】"}
{"id": null, "n": "0493015", "target": "#nkr_note_mod_0493015", "type": "mod", "text": "蕩【大】＊，盪【元】【明】＊"}
{"id": null, "n": "0493016", "target": "#nkr_note_mod_0493016", "type": "mod", "text": "杅【大】，盂【宋】【元】【明】"}
{"id": null, "n": "0493017", "target": "#nkr_note_mod_0493017", "type": "mod", "text": "慧【大】＊，惠【宋】＊"}
{"id": null, "n": "0493018", "target": "#nkr_note_mod_0493018", "type": "mod", "text": "坐【大】＊，座【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0493020", "target": "#nkr_note_mod_0493020", "type": "mod", "text": "在【大】，在在【宋】【元】【明】"}
{"id": null, "n": "0494001", "target": "#nkr_note_mod_0494001", "type": "mod", "text": "電【大】，雷【宋】"}
{"id": null, "n": "0494002", "target": "#nkr_note_mod_0494002", "type": "mod", "text": "得【大】，德【宋】【元】【明】"}
{"id": null, "n": "0494003", "target": "#nkr_note_mod_0494003", "type": "mod", "text": "󰪓【大】，陽【明】"}
{"id": null, "n": "0494004", "target": "#nkr_note_mod_0494004", "type": "mod", "text": "～S. 47. 18. Brahmā.，[No. 99(1189), No. 100(102)]."}
{"id": null, "n": "0494005", "target": "#nkr_note_mod_0494005", "type": "mod", "text": "墮【大】，隨【宋】【元】【明】"}
{"id": null, "n": "0494006", "target": "#nkr_note_mod_0494006", "type": "mod", "text": "屈【大】，屋【宋】，尼【元】【明】"}
{"id": null, "n": "0494007", "target": "#nkr_note_mod_0494007", "type": "mod", "text": "申【大】＊，伸【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0494008", "target": "#nkr_note_mod_0494008", "type": "mod", "text": "惱【大】，苦【明】"}
{"id": null, "n": "0494009", "target": "#nkr_note_mod_0494009", "type": "mod", "text": "自【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0494010", "target": "#nkr_note_mod_0494010", "type": "mod", "text": "～S. 6. 7. 10. Kokālika.，[No. 99(1193), 100(106)]"}
{"id": null, "n": "0494011", "target": "#nkr_note_mod_0494011", "type": "mod", "text": "乾【大】＊，揵【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0494012", "target": "#nkr_note_mod_0494012", "type": "mod", "text": "含【大】，舍【明】"}
{"id": null, "n": "0494013", "target": "#nkr_note_mod_0494013", "type": "mod", "text": "𠸻【大】，𭊺【宋】，嚏【元】【明】"}
{"id": null, "n": "0494014", "target": "#nkr_note_mod_0494014", "type": "mod", "text": "間【大】，問【宋】"}
{"id": null, "n": "0495001", "target": "#nkr_note_mod_0495001", "type": "mod", "text": "聞【大】，問【宋】"}
{"id": null, "n": "0495002", "target": "#nkr_note_mod_0495002", "type": "mod", "text": "者【大】，意【宋】【元】【明】"}
{"id": null, "n": "0495003", "target": "#nkr_note_mod_0495003", "type": "mod", "text": "我是是【大】＊，是我是【元】【明】＊"}
{"id": null, "n": "0495005", "target": "#nkr_note_mod_0495005", "type": "mod", "text": "洒【大】，洗【宋】【元】【明】"}
{"id": null, "n": "0495006", "target": "#nkr_note_mod_0495006", "type": "mod", "text": "惡【大】，厭【元】【明】"}
{"id": null, "n": "0495007", "target": "#nkr_note_mod_0495007", "type": "mod", "text": "復【大】，復任【元】【明】"}
{"id": null, "n": "0495008", "target": "#nkr_note_mod_0495008", "type": "mod", "text": "杅【大】，盂【宋】【元】【明】"}
{"id": null, "n": "0495009", "target": "#nkr_note_mod_0495009", "type": "mod", "text": "机【大】，機【明】"}
{"id": null, "n": "0495010", "target": "#nkr_note_mod_0495010", "type": "mod", "text": "藥【大】，樂【宋】【元】【明】"}
{"id": null, "n": "0495011", "target": "#nkr_note_mod_0495011", "type": "mod", "text": "兒【大】，兌【宋】【元】"}
{"id": null, "n": "0495012", "target": "#nkr_note_mod_0495012", "type": "mod", "text": "隨【大】＊，墮【元】【明】＊"}
{"id": null, "n": "0495013", "target": "#nkr_note_mod_0495013", "type": "mod", "text": "菓【大】，果【宋】【元】【明】"}
{"id": null, "n": "0495014", "target": "#nkr_note_mod_0495014", "type": "mod", "text": "蛇【大】，蚖【宋】【元】【明】"}
{"id": null, "n": "0495015", "target": "#nkr_note_mod_0495015", "type": "mod", "text": "悟【大】，寤【宋】【元】【明】"}
{"id": null, "n": "0495016", "target": "#nkr_note_mod_0495016", "type": "mod", "text": "夢【大】，夢如夢【宋】【元】【明】"}
{"id": null, "n": "0495017", "target": "#nkr_note_mod_0495017", "type": "mod", "text": "飢【大】，鈎肌【宋】【元】【明】"}
{"id": null, "n": "0495018", "target": "#nkr_note_mod_0495018", "type": "mod", "text": "菓【大】，果【明】"}
{"id": null, "n": "0495019", "target": "#nkr_note_mod_0495019", "type": "mod", "text": "末【大】，未【宋】【元】【明】"}
{"id": null, "n": "0495020", "target": "#nkr_note_mod_0495020", "type": "mod", "text": "王【大】，玉【宋】【元】【明】"}
{"id": null, "n": "0495021", "target": "#nkr_note_mod_0495021", "type": "mod", "text": "涕【大】，洟【宋】【元】【明】"}
{"id": null, "n": "0495022", "target": "#nkr_note_mod_0495022", "type": "mod", "text": "滓【大】，澤【宋】【元】【明】"}
{"id": null, "n": "0496001", "target": "#nkr_note_mod_0496001", "type": "mod", "text": "困【大】，因【宋】【元】"}
{"id": null, "n": "0496002", "target": "#nkr_note_mod_0496002", "type": "mod", "text": "為【大】，及【宋】【元】【明】"}
{"id": null, "n": "0496003", "target": "#nkr_note_mod_0496003", "type": "mod", "text": "僵【大】，強【宋】【元】【明】"}
{"id": null, "n": "0496004", "target": "#nkr_note_mod_0496004", "type": "mod", "text": "息【大】，悉【宋】【元】【明】"}
{"id": null, "n": "0496005", "target": "#nkr_note_mod_0496005", "type": "mod", "text": "如如說是【大】，說如是【宋】【元】【明】"}
{"id": null, "n": "0496006", "target": "#nkr_note_mod_0496006", "type": "mod", "text": "～S. 15. 10. Puggala.，[No. 150(30)]"}
{"id": null, "n": "0496007", "target": "#nkr_note_mod_0496007", "type": "mod", "text": "相【大】＊，想【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0496008", "target": "#nkr_note_mod_0496008", "type": "mod", "text": "內【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0497001", "target": "#nkr_note_mod_0497001", "type": "mod", "text": "～S. 54. 1. Ekadhamma.，[No. 99(802-803)]."}
{"id": null, "n": "0497002", "target": "#nkr_note_mod_0497002", "type": "mod", "text": "想【大】，相【宋】【元】【明】"}
{"id": null, "n": "0497003", "target": "#nkr_note_mod_0497003", "type": "mod", "text": "便【大】，但【宋】【元】【明】"}
{"id": null, "n": "0497004", "target": "#nkr_note_mod_0497004", "type": "mod", "text": "墮【大】，隨【元】【明】"}
{"id": null, "n": "0497005", "target": "#nkr_note_mod_0497005", "type": "mod", "text": "～A. II. 2. 1. Bala.，[No. 99(661)]."}
{"id": null, "n": "0497006", "target": "#nkr_note_mod_0497006", "type": "mod", "text": "聞【大】，間【宋】【元】【明】"}
{"id": null, "n": "0497007", "target": "#nkr_note_mod_0497007", "type": "mod", "text": "到【大】，致【宋】【元】【明】"}
{"id": null, "n": "0497008", "target": "#nkr_note_mod_0497008", "type": "mod", "text": "致【大】，到【宋】【元】【明】"}
{"id": null, "n": "0497009", "target": "#nkr_note_mod_0497009", "type": "mod", "text": "得【大】，行【宋】【元】【明】"}
{"id": null, "n": "0497010", "target": "#nkr_note_mod_0497010", "type": "mod", "text": "習【大】＊，集【元】【明】＊"}
{"id": null, "n": "0497012", "target": "#nkr_note_mod_0497012", "type": "mod", "text": "力【大】，身【宋】【元】【明】"}
{"id": null, "n": "0497014", "target": "#nkr_note_mod_0497014", "type": "mod", "text": "謂【大】，為【明】"}
{"id": null, "n": "0497015", "target": "#nkr_note_mod_0497015", "type": "mod", "text": "抦【大】，秉【宋】【元】【明】"}
{"id": null, "n": "0497016", "target": "#nkr_note_mod_0497016", "type": "mod", "text": "～S. 14. 17-24. Asaddha &c.，[No. 99(449-450), No. 111]."}
{"id": null, "n": "0497017", "target": "#nkr_note_mod_0497017", "type": "mod", "text": "俱【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0497018", "target": "#nkr_note_mod_0497018", "type": "mod", "text": "相聚相應相可【大】，相應相可相聚【宋】【元】【明】"}
{"id": null, "n": "0497019", "target": "#nkr_note_mod_0497019", "type": "mod", "text": "～S. 11. 2. 3. Devā.，[No. 99(1105), No. 100(34)]."}
{"id": null, "n": "0498001", "target": "#nkr_note_mod_0498001", "type": "mod", "text": "至【大】，到【宋】【元】【明】"}
{"id": null, "n": "0498002", "target": "#nkr_note_mod_0498002", "type": "mod", "text": "口【大】，中【宋】"}
{"id": null, "n": "0498003", "target": "#nkr_note_mod_0498003", "type": "mod", "text": "炎【CB】【麗-CB】，焰【大】，焱【宋】【元】【明】"}
{"id": null, "n": "0498004", "target": "#nkr_note_mod_0498004", "type": "mod", "text": "放【大】，施【宋】【元】【明】"}
{"id": null, "n": "0498005", "target": "#nkr_note_mod_0498005", "type": "mod", "text": "炎【大】，焱【元】【明】"}
{"id": null, "n": "0498006", "target": "#nkr_note_mod_0498006", "type": "mod", "text": "～S. 20. 2. Nakhasikha.，[No. 99(1256)]"}
{"id": null, "n": "0498007", "target": "#nkr_note_mod_0498007", "type": "mod", "text": "土【大】，上【宋】【元】【明】"}
{"id": null, "n": "0498008", "target": "#nkr_note_mod_0498008", "type": "mod", "text": "倍【大】，億【宋】【元】【明】"}
{"id": null, "n": "0498009", "target": "#nkr_note_mod_0498009", "type": "mod", "text": "復【大】，覆【明】"}
{"id": null, "n": "0498010", "target": "#nkr_note_mod_0498010", "type": "mod", "text": "聞【大】，問【宋】【元】【明】"}
{"id": null, "n": "0498011", "target": "#nkr_note_mod_0498011", "type": "mod", "text": "～S. 7. 1. 3. Asurindika.，[No. 99(1151), No. 100(74)]."}
{"id": null, "n": "0498012", "target": "#nkr_note_mod_0498012", "type": "mod", "text": "佛【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0498013", "target": "#nkr_note_mod_0498013", "type": "mod", "text": "～S. 7. 1. 5. Ahiṃsaka.，[No. 99(1156), No. 100(79)]."}
{"id": null, "n": "0498014", "target": "#nkr_note_mod_0498014", "type": "mod", "text": "處【大】，時【宋】【元】【明】"}
{"id": null, "n": "0498015", "target": "#nkr_note_mod_0498015", "type": "mod", "text": "誡【大】，戒【宋】【元】【明】"}
{"id": null, "n": "0498016", "target": "#nkr_note_mod_0498016", "type": "mod", "text": "～S. 22. 57. Sattaṭṭhāna.，[No. 99(42), No. 150(1)]."}
{"id": null, "n": "0498017", "target": "#nkr_note_mod_0498017", "type": "mod", "text": "聞【大】，間【宋】【元】【明】"}
{"id": null, "n": "0499001", "target": "#nkr_note_mod_0499001", "type": "mod", "text": "愛【大】，受【宋】"}
{"id": null, "n": "0499002", "target": "#nkr_note_mod_0499002", "type": "mod", "text": "常【大】，非常【宋】【元】【明】"}
{"id": null, "n": "0499003", "target": "#nkr_note_mod_0499003", "type": "mod", "text": "如【大】，知【明】"}
{"id": null, "n": "0499004", "target": "#nkr_note_mod_0499004", "type": "mod", "text": "栽【大】＊，裁【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0499005", "target": "#nkr_note_mod_0499005", "type": "mod", "text": "愛【大】，多【宋】"}
{"id": null, "n": "0499006", "target": "#nkr_note_mod_0499006", "type": "mod", "text": "如【大】，知【宋】"}
{"id": null, "n": "0499007", "target": "#nkr_note_mod_0499007", "type": "mod", "text": "諦【大】，意【宋】【元】【明】"}
{"id": null, "n": "0499008", "target": "#nkr_note_mod_0499008", "type": "mod", "text": "識盡【大】，盡識【明】"}
{"id": null, "n": "0499009", "target": "#nkr_note_mod_0499009", "type": "mod", "text": "行【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0493001", "target": "#nkr_note_orig_0493001", "type": "orig", "text": "經＋（一卷）【元】"}
{"id": null, "n": "0493002", "target": "#nkr_note_orig_0493002", "type": "orig", "text": "（失譯）＋附【宋】【元】，（失譯人名）＋附【明】"}
{"id": null, "n": "0493003", "target": "#nkr_note_orig_0493003", "type": "orig", "text": "～Sn. 4, S. 7. 2. 1. Kasi. [No. 99(98), No. 100(204)]"}
{"id": null, "n": "0493004", "target": "#nkr_note_orig_0493004", "type": "orig", "text": "止＝上【三】"}
{"id": null, "n": "0493005", "target": "#nkr_note_orig_0493005", "type": "orig", "text": "扠＝杈【三】"}
{"id": null, "n": "0493006", "target": "#nkr_note_orig_0493006", "type": "orig", "text": "鄧＝𣃆【元】【明】＊"}
{"id": null, "n": "0493007", "target": "#nkr_note_orig_0493007", "type": "orig", "text": "我今＝今我【三】"}
{"id": null, "n": "0493008", "target": "#nkr_note_orig_0493008", "type": "orig", "text": "出＝湧【明異】"}
{"id": null, "n": "0493009", "target": "#nkr_note_orig_0493009", "type": "orig", "text": "滊＝氣【三】"}
{"id": null, "n": "0493010", "target": "#nkr_note_orig_0493010", "type": "orig", "text": "誡＝戒【三】＊"}
{"id": null, "n": "0493011", "target": "#nkr_note_orig_0493011", "type": "orig", "text": "～A. III. 57. Vacchagotta. [No. 99(95), No. 100(261)]"}
{"id": null, "n": "0493012", "target": "#nkr_note_orig_0493012", "type": "orig", "text": "〔莫與…施〕七字－【三】"}
