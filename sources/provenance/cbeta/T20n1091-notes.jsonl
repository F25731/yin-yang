{"id": null, "n": "0224002", "target": "#nkr_note_mod_0224002", "type": "mod", "text": "又【大】，有【考偽-原】"}
{"id": null, "n": "0224003", "target": "#nkr_note_mod_0224003", "type": "mod", "text": "界【大】，〔－〕【校異-原】"}
