{"id": null, "n": "0560004", "target": "#nkr_note_mod_0560004", "type": "mod", "text": "縱【CB】，蹤【卍續】，蹤疑縱"}
{"id": null, "n": "0559001", "target": "#nkr_note_orig_0559001", "type": "orig", "text": "服疑複"}
{"id": null, "n": "0560001", "target": "#nkr_note_orig_0560001", "type": "orig", "text": "難消二字疑剩"}
{"id": null, "n": "0560002", "target": "#nkr_note_orig_0560002", "type": "orig", "text": "似疑事"}
{"id": null, "n": "0560003", "target": "#nkr_note_orig_0560003", "type": "orig", "text": "忌水異作水忌"}
{"id": null, "n": "0560004", "target": "#nkr_note_orig_0560004", "type": "orig", "text": "蹤疑縱"}
{"id": null, "n": "0560005", "target": "#nkr_note_orig_0560005", "type": "orig", "text": "欠疑次"}
{"id": null, "n": "0561001", "target": "#nkr_note_orig_0561001", "type": "orig", "text": "插入參字"}
{"id": null, "n": "0562001", "target": "#nkr_note_orig_0562001", "type": "orig", "text": "年疑至"}
