{"id": null, "n": "1384002", "target": "#nkr_note_orig_1384002", "type": "orig", "text": "枝＋（今當請勇力菩薩來呪魅人頭破作七分如阿犁樹枝）【甲】"}
{"id": null, "n": "1384003", "target": "#nkr_note_orig_1384003", "type": "orig", "text": "枝＋（今當請轉輪菩薩來呪魅人頭破作七分如阿犁樹枝）【甲】"}
{"id": null, "n": "1384004", "target": "#nkr_note_orig_1384004", "type": "orig", "text": "〔今當…枝〕二十一字－【甲】"}
{"id": null, "n": "1384005", "target": "#nkr_note_orig_1384005", "type": "orig", "text": "天＝王【甲】"}
{"id": null, "n": "1384006", "target": "#nkr_note_orig_1384006", "type": "orig", "text": "狩＝獸【甲】"}
{"id": null, "n": "1384007", "target": "#nkr_note_orig_1384007", "type": "orig", "text": "〔眼西…人〕九字－【甲】"}
{"id": null, "n": "1384008", "target": "#nkr_note_orig_1384008", "type": "orig", "text": "啄＝食【甲】"}
{"id": null, "n": "1384009", "target": "#nkr_note_orig_1384009", "type": "orig", "text": "〔神〕－【甲】"}
{"id": null, "n": "1384010", "target": "#nkr_note_orig_1384010", "type": "orig", "text": "在＋（人）【甲】"}
{"id": null, "n": "1384011", "target": "#nkr_note_orig_1384011", "type": "orig", "text": "良＝踉【甲】"}
{"id": null, "n": "1384012", "target": "#nkr_note_orig_1384012", "type": "orig", "text": "節＋（之）【甲】"}
{"id": null, "n": "1384013", "target": "#nkr_note_orig_1384013", "type": "orig", "text": "姓＋（字知汝姓）【甲】"}
{"id": null, "n": "1384014", "target": "#nkr_note_orig_1384014", "type": "orig", "text": "滅亡若立＝坐喪若立倒地【甲】"}
{"id": null, "n": "1384015", "target": "#nkr_note_orig_1384015", "type": "orig", "text": "赤＝人【甲】"}
{"id": null, "n": "1384016", "target": "#nkr_note_orig_1384016", "type": "orig", "text": "〔赤〕－【甲】"}
{"id": null, "n": "1384017", "target": "#nkr_note_orig_1384017", "type": "orig", "text": "久＝停【甲】"}
{"id": null, "n": "1384018", "target": "#nkr_note_orig_1384018", "type": "orig", "text": "（唱）＋言【甲】"}
{"id": null, "n": "1384019", "target": "#nkr_note_orig_1384019", "type": "orig", "text": "今為＝語【甲】"}
{"id": null, "n": "1384020", "target": "#nkr_note_orig_1384020", "type": "orig", "text": "（為）＋善【甲】"}
{"id": null, "n": "1384021", "target": "#nkr_note_orig_1384021", "type": "orig", "text": "說此＝等造作【甲】"}
{"id": null, "n": "1384022", "target": "#nkr_note_orig_1384022", "type": "orig", "text": "（鬼）＋神【甲】"}
{"id": null, "n": "1384023", "target": "#nkr_note_orig_1384023", "type": "orig", "text": "〔在〕－【甲】"}
{"id": null, "n": "1384024", "target": "#nkr_note_orig_1384024", "type": "orig", "text": "平＝許【甲】"}
{"id": null, "n": "1384025", "target": "#nkr_note_orig_1384025", "type": "orig", "text": "（（一切…會））十二字＝（（佛說此經已））五字【甲】"}
{"id": null, "n": "1384026", "target": "#nkr_note_orig_1384026", "type": "orig", "text": "生＝會【甲】"}
{"id": null, "n": "1384027", "target": "#nkr_note_orig_1384027", "type": "orig", "text": "仰為佛＝喜【甲】"}
{"id": null, "n": "1384028", "target": "#nkr_note_orig_1384028", "type": "orig", "text": "〔持念〕－【甲】"}
{"id": null, "n": "1384029", "target": "#nkr_note_orig_1384029", "type": "orig", "text": "（佛說）＋呪【甲】"}
{"id": null, "n": "1384030", "target": "#nkr_note_orig_1384030", "type": "orig", "text": "經＋（一卷）【甲】，此下甲本奧書曰令願進子一心供養"}
{"id": null, "n": "1384030", "target": "#nkr_note_rest_1384030", "type": "rest", "text": "此下甲本奧書曰令願進子一心供養"}
