{"id": null, "n": "0386001", "target": "#nkr_note_orig_0386001", "type": "orig", "text": "經首題名，甲、庚本殘，乙、戊、己本作「佛母經」，丙、丁本作「佛母經一卷」。"}
{"id": null, "n": "0386002", "target": "#nkr_note_orig_0386002", "type": "orig", "text": "「欲」，乙、丙、丁、戊、己本作「入」。"}
{"id": null, "n": "0386003", "target": "#nkr_note_orig_0386003", "type": "orig", "text": "「林」，戊本無。"}
{"id": null, "n": "0386004", "target": "#nkr_note_orig_0386004", "type": "orig", "text": "庚本自此起。"}
{"id": null, "n": "0386005", "target": "#nkr_note_orig_0386005", "type": "orig", "text": "「吾」，戊本作「五」。"}
{"id": null, "n": "0386006", "target": "#nkr_note_orig_0386006", "type": "orig", "text": "「背」，丙本作「皆」。"}
{"id": null, "n": "0386007", "target": "#nkr_note_orig_0386007", "type": "orig", "text": "「背痛」，戊本無。"}
{"id": null, "n": "0386008", "target": "#nkr_note_orig_0386008", "type": "orig", "text": "「吾」，丙本作「五」。"}
{"id": null, "n": "0386009", "target": "#nkr_note_orig_0386009", "type": "orig", "text": "「道」，乙、丙、丁、戊、己、庚本作「言」。"}
{"id": null, "n": "0386010", "target": "#nkr_note_orig_0386010", "type": "orig", "text": "「吾」，底本無，據乙、丙、丁、戊、己、庚本補。"}
{"id": null, "n": "0386011", "target": "#nkr_note_orig_0386011", "type": "orig", "text": "「汝」，丙本作「汝等」。"}
{"id": null, "n": "0386012", "target": "#nkr_note_orig_0386012", "type": "orig", "text": "「使」，丙本無，己本作「佛」。"}
{"id": null, "n": "0386013", "target": "#nkr_note_orig_0386013", "type": "orig", "text": "「優」，底、乙、丁、戊、己本作「憂」，據丙、庚本改。「波」，丙、己、庚本作「婆」。「離」，乙、丁、戊、己本作「梨」，丙本作「姨」。諸本對「優波離」之名，抄寫多有參差。為避文繁，以下一律正為「優波離」，不出註。"}
{"id": null, "n": "0386014", "target": "#nkr_note_orig_0386014", "type": "orig", "text": "「往」，底本作「住」，據乙、丙、丁、戊、己、庚本改。"}
{"id": null, "n": "0386015", "target": "#nkr_note_orig_0386015", "type": "orig", "text": "「詣」，丙本作「於詐」，庚本作「藝」。"}
{"id": null, "n": "0386016", "target": "#nkr_note_orig_0386016", "type": "orig", "text": "「忉」，底本作「刀」，據乙、丙、丁、戊、己、庚本改。"}
{"id": null, "n": "0386017", "target": "#nkr_note_orig_0386017", "type": "orig", "text": "「宮」，乙、丙、丁、戊、己、庚本作「上」。"}
{"id": null, "n": "0387001", "target": "#nkr_note_orig_0387001", "type": "orig", "text": "「議」，戊本作「義」。"}
{"id": null, "n": "0387002", "target": "#nkr_note_orig_0387002", "type": "orig", "text": "「中」，丙、己本作「眾」。"}
{"id": null, "n": "0387003", "target": "#nkr_note_orig_0387003", "type": "orig", "text": "「須」，戊本無。"}
{"id": null, "n": "0387004", "target": "#nkr_note_orig_0387004", "type": "orig", "text": "甲本自此起。"}
{"id": null, "n": "0387005", "target": "#nkr_note_orig_0387005", "type": "orig", "text": "「下」，甲、庚本作「降」。"}
{"id": null, "n": "0387006", "target": "#nkr_note_orig_0387006", "type": "orig", "text": "「幡」，丙本作「番」。"}
{"id": null, "n": "0387007", "target": "#nkr_note_orig_0387007", "type": "orig", "text": "「四」，丙本作「死」，庚本作「大」。"}
{"id": null, "n": "0387008", "target": "#nkr_note_orig_0387008", "type": "orig", "text": "「無故」，甲、乙、丙、丁、戊、己、庚本無。"}
{"id": null, "n": "0387009", "target": "#nkr_note_orig_0387009", "type": "orig", "text": "「了」，甲、乙、丙、丁、戊、己、庚本作「訖」。"}
{"id": null, "n": "0387010", "target": "#nkr_note_orig_0387010", "type": "orig", "text": "「空」，庚本作「空中」。"}
{"id": null, "n": "0387011", "target": "#nkr_note_orig_0387011", "type": "orig", "text": "「爾時佛母」，乙、丙、丁、戊、己、庚本無。"}
{"id": null, "n": "0387012", "target": "#nkr_note_orig_0387012", "type": "orig", "text": "「即」，底、乙、丙、丁、戊、己本作「口」，庚本作「借」，據甲本改。"}
{"id": null, "n": "0387013", "target": "#nkr_note_orig_0387013", "type": "orig", "text": "「人」，己本作「者」。"}
{"id": null, "n": "0387014", "target": "#nkr_note_orig_0387014", "type": "orig", "text": "「而」，甲、丙、丁、戊、己本作「方」，乙本作「何方」，庚本作「方而」。"}
{"id": null, "n": "0387015", "target": "#nkr_note_orig_0387015", "type": "orig", "text": "「太劇」，乙、丙、丁、戊、己本無，庚本作「爾劇」。"}
{"id": null, "n": "0387016", "target": "#nkr_note_orig_0387016", "type": "orig", "text": "「顏」，甲、庚本作「形」。"}
{"id": null, "n": "0387017", "target": "#nkr_note_orig_0387017", "type": "orig", "text": "「良」，底、戊、庚本作「量」，據丙本改。"}
{"id": null, "n": "0387018", "target": "#nkr_note_orig_0387018", "type": "orig", "text": "「哽咽聲嘶，良久不語」，甲、乙、丁、己本無。"}
{"id": null, "n": "0388001", "target": "#nkr_note_orig_0388001", "type": "orig", "text": "「佛母！佛母！」，丙本作「佛母！」。"}
{"id": null, "n": "0388002", "target": "#nkr_note_orig_0388002", "type": "orig", "text": "「我」，甲本無，丙本作「我是」。"}
{"id": null, "n": "0388003", "target": "#nkr_note_orig_0388003", "type": "orig", "text": "「三界」，甲、乙、丙、丁、戊、己、庚本無。"}
{"id": null, "n": "0388004", "target": "#nkr_note_orig_0388004", "type": "orig", "text": "「昨」，丙、戊本作「作」。"}
{"id": null, "n": "0388005", "target": "#nkr_note_orig_0388005", "type": "orig", "text": "「捨大法身」，甲本無。"}
{"id": null, "n": "0388006", "target": "#nkr_note_orig_0388006", "type": "orig", "text": "「使」，甲、乙、丙、丁、戊、己、庚本作「遣」。"}
{"id": null, "n": "0388007", "target": "#nkr_note_orig_0388007", "type": "orig", "text": "「是」，甲、乙、丙、丁、戊、己本作「此」。"}
{"id": null, "n": "0388008", "target": "#nkr_note_orig_0388008", "type": "orig", "text": "「語已」，丙本作「法以」，乙、丁、戊、己本作「語以」。"}
{"id": null, "n": "0388009", "target": "#nkr_note_orig_0388009", "type": "orig", "text": "「捶胸」，甲本作「魂堆」，乙、丙、丁、戊、己、庚本作「渾捶」。"}
{"id": null, "n": "0388010", "target": "#nkr_note_orig_0388010", "type": "orig", "text": "「狀似」，乙、丙、丁、戊、己本作「如」。"}
{"id": null, "n": "0388011", "target": "#nkr_note_orig_0388011", "type": "orig", "text": "「五」，己本無。"}
{"id": null, "n": "0388012", "target": "#nkr_note_orig_0388012", "type": "orig", "text": "「血現」，底、庚本作「血見」，戊本作「而現」，據甲、乙、丙、丁、己本改。"}
{"id": null, "n": "0388013", "target": "#nkr_note_orig_0388013", "type": "orig", "text": "「花」，甲、庚本作「華」。"}
{"id": null, "n": "0388014", "target": "#nkr_note_orig_0388014", "type": "orig", "text": "「擗」，甲本作「壀」，乙、丙、丁、戊、己、庚本作「躃」。"}
{"id": null, "n": "0388015", "target": "#nkr_note_orig_0388015", "type": "orig", "text": "「時」，底、甲、丙、庚本無，據乙、丁、戊、己本補。"}
{"id": null, "n": "0388016", "target": "#nkr_note_orig_0388016", "type": "orig", "text": "「將水」，甲本作「以」。"}
{"id": null, "n": "0388017", "target": "#nkr_note_orig_0388017", "type": "orig", "text": "「灑」，底、乙、丙、丁、戊、己、庚本作「𠹀」，據甲本改。"}
{"id": null, "n": "0388018", "target": "#nkr_note_orig_0388018", "type": "orig", "text": "「良」，底、甲、乙、丙、丁、戊、己、庚本作「量」，據文意改。"}
{"id": null, "n": "0388019", "target": "#nkr_note_orig_0388019", "type": "orig", "text": "「乃」，甲、乙、丙、丁、戊、己、庚本作「還」。"}
{"id": null, "n": "0388020", "target": "#nkr_note_orig_0388020", "type": "orig", "text": "「蘇」，乙、丁、戊、己本作「惺」。"}
{"id": null, "n": "0389001", "target": "#nkr_note_orig_0389001", "type": "orig", "text": "「將」，底本作「與」，據甲、乙、丙、丁、戊、己、庚本改。"}
{"id": null, "n": "0389002", "target": "#nkr_note_orig_0389002", "type": "orig", "text": "「天眾」，甲本作「眷屬」，乙、丙、丁、戊、庚本作「徒眾」。"}
{"id": null, "n": "0389003", "target": "#nkr_note_orig_0389003", "type": "orig", "text": "「圍」，底本作「違」，據甲、乙、丙、丁、戊、己、庚本改。"}
{"id": null, "n": "0389004", "target": "#nkr_note_orig_0389004", "type": "orig", "text": "「忉」，底、戊本作「刀」，據甲、乙、丙、丁、己、庚本改。"}
{"id": null, "n": "0389005", "target": "#nkr_note_orig_0389005", "type": "orig", "text": "「宮」，甲、乙、丙、丁、戊、己、庚本無。"}
{"id": null, "n": "0389006", "target": "#nkr_note_orig_0389006", "type": "orig", "text": "「至」，庚本作「直至」。"}
{"id": null, "n": "0389007", "target": "#nkr_note_orig_0389007", "type": "orig", "text": "「娑」，己本作「婆」，丙本作「波」。"}
{"id": null, "n": "0389008", "target": "#nkr_note_orig_0389008", "type": "orig", "text": "「羅」，底本作「蘿」，據甲、乙、丙、丁、戊、己、庚本改。"}
{"id": null, "n": "0389009", "target": "#nkr_note_orig_0389009", "type": "orig", "text": "「殯」，甲本作「一」。"}
{"id": null, "n": "0389010", "target": "#nkr_note_orig_0389010", "type": "orig", "text": "「已」，底、乙、丙、丁、戊、己本作「以」，據甲、庚本改。"}
{"id": null, "n": "0389011", "target": "#nkr_note_orig_0389011", "type": "orig", "text": "「離」，甲、乙、丙、丁、戊、己、庚本作「梨」。"}
{"id": null, "n": "0389012", "target": "#nkr_note_orig_0389012", "type": "orig", "text": "「疊」，底本作「褺」，據甲、乙、丙、丁、戊、己、庚本改。"}
{"id": null, "n": "0389013", "target": "#nkr_note_orig_0389013", "type": "orig", "text": "「著」，庚本作「在」。"}
{"id": null, "n": "0389014", "target": "#nkr_note_orig_0389014", "type": "orig", "text": "「瓶」，甲、乙、丙、丁、戊、己、庚本作「鉢」。"}
{"id": null, "n": "0389015", "target": "#nkr_note_orig_0389015", "type": "orig", "text": "「其」，底本作「奇」，據甲、乙、丙、丁、戊、己、庚本改。"}
{"id": null, "n": "0389016", "target": "#nkr_note_orig_0389016", "type": "orig", "text": "「縊」，底、乙、丙、丁、戊、己本作「俓」，據甲、庚本改。"}
{"id": null, "n": "0389017", "target": "#nkr_note_orig_0389017", "type": "orig", "text": "「以手拍頭」，乙、丙、丁、戊、己本無。"}
{"id": null, "n": "0389018", "target": "#nkr_note_orig_0389018", "type": "orig", "text": "「號」，底本作「嗥」，據甲、乙、丙、丁、戊、己、庚本改。"}
{"id": null, "n": "0389019", "target": "#nkr_note_orig_0389019", "type": "orig", "text": "「有二獅子自縊而死。十大弟子以手拍頭，向天號哭」，甲、庚本作「十大弟子向天號哭，有二獅子自縊而死」，且將此句置於本段尾。"}
{"id": null, "n": "0389020", "target": "#nkr_note_orig_0389020", "type": "orig", "text": "「而作是言」，甲本無。"}
{"id": null, "n": "0389021", "target": "#nkr_note_orig_0389021", "type": "orig", "text": "「住世之日」，底、乙、丙、丁、戊、己、庚本作「生存再日」，據甲本改。"}
{"id": null, "n": "0390001", "target": "#nkr_note_orig_0390001", "type": "orig", "text": "「將此瓶盂錫杖，處處」，甲、乙、丙、丁、戊、己、庚本作「持用此物」。"}
{"id": null, "n": "0390002", "target": "#nkr_note_orig_0390002", "type": "orig", "text": "「導」，丙本作「遍」。"}
{"id": null, "n": "0390003", "target": "#nkr_note_orig_0390003", "type": "orig", "text": "「化導眾生此物」六字，庚本無。"}
{"id": null, "n": "0390004", "target": "#nkr_note_orig_0390004", "type": "orig", "text": "「無」，丙本作「死」。"}
{"id": null, "n": "0390005", "target": "#nkr_note_orig_0390005", "type": "orig", "text": "「捫」，底本作「吻」，乙、丁、己本作「憫」，庚本作「汶」，據甲、丙、戊本改。"}
{"id": null, "n": "0390006", "target": "#nkr_note_orig_0390006", "type": "orig", "text": "「淚」，己本作「戾」。"}
{"id": null, "n": "0390007", "target": "#nkr_note_orig_0390007", "type": "orig", "text": "「悉達！悉達！」，甲、丁、庚本作「慈子！慈子！」，乙、丙、戊、己本作「慈子！」。"}
{"id": null, "n": "0390008", "target": "#nkr_note_orig_0390008", "type": "orig", "text": "「汝今」，丙本作「今」，己本無。"}
{"id": null, "n": "0390009", "target": "#nkr_note_orig_0390009", "type": "orig", "text": "「是為平等」，甲、乙、丙、丁、戊、己、庚本無。"}
{"id": null, "n": "0390010", "target": "#nkr_note_orig_0390010", "type": "orig", "text": "「如來」，庚本作「世尊」。"}
{"id": null, "n": "0390011", "target": "#nkr_note_orig_0390011", "type": "orig", "text": "「卻」，甲本作「還」。"}
{"id": null, "n": "0390012", "target": "#nkr_note_orig_0390012", "type": "orig", "text": "「華」，戊本作「花」。"}
{"id": null, "n": "0390013", "target": "#nkr_note_orig_0390013", "type": "orig", "text": "「上」，己本無。"}
{"id": null, "n": "0390014", "target": "#nkr_note_orig_0390014", "type": "orig", "text": "「為」，底本作「謂」，據甲、乙、丙、丁、戊、己、庚本改。"}
{"id": null, "n": "0390015", "target": "#nkr_note_orig_0390015", "type": "orig", "text": "「偈」，甲、乙、丙、丁、戊、己、庚本作「法」。"}
{"id": null, "n": "0390016", "target": "#nkr_note_orig_0390016", "type": "orig", "text": "「苦空」，底本作「空虛」，據甲、乙、丙、丁、戊、己、庚本改。"}
{"id": null, "n": "0390017", "target": "#nkr_note_orig_0390017", "type": "orig", "text": "「滅已」，底、乙、丁、戊、己本作「滅以」，丙本作「已以」，據甲、庚本改。"}
{"id": null, "n": "0391001", "target": "#nkr_note_orig_0391001", "type": "orig", "text": "「是」，甲、乙、丙、丁、戊、己本作「此」。"}
{"id": null, "n": "0391002", "target": "#nkr_note_orig_0391002", "type": "orig", "text": "「妙法」，乙、丙、丁、戊、己本作「法以」。"}
{"id": null, "n": "0391003", "target": "#nkr_note_orig_0391003", "type": "orig", "text": "「住」，庚本作「佇」。"}
{"id": null, "n": "0391004", "target": "#nkr_note_orig_0391004", "type": "orig", "text": "「震」，甲本作「振」。"}
{"id": null, "n": "0391005", "target": "#nkr_note_orig_0391005", "type": "orig", "text": "「離別」，甲、乙、丙、丁、戊、己本作「別離」。"}
{"id": null, "n": "0391006", "target": "#nkr_note_orig_0391006", "type": "orig", "text": "「一切江河，會有枯竭。一切叢林，會有摧折」，底、甲、丙、丁、戊、己本無，據乙本補，庚本將此十六字置於「一切恩愛，會有離別」句前。"}
{"id": null, "n": "0391007", "target": "#nkr_note_orig_0391007", "type": "orig", "text": "「期」，丙、己、戊本作「其」。"}
{"id": null, "n": "0391008", "target": "#nkr_note_orig_0391008", "type": "orig", "text": "「三界大師」，甲、乙、丙、丁、戊、己、庚本無。"}
{"id": null, "n": "0391009", "target": "#nkr_note_orig_0391009", "type": "orig", "text": "尾題，底本無，甲、戊本作「大般涅槃經佛母品」，據乙、丙、丁、己、庚本補。"}
