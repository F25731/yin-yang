{"id": null, "n": "0241008", "target": "#nkr_note_mod_0241008", "type": "mod", "text": "三藏【大】，國沙門【宋】【元】【明】"}
{"id": null, "n": "0242001", "target": "#nkr_note_mod_0242001", "type": "mod", "text": "但為【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0242002", "target": "#nkr_note_mod_0242002", "type": "mod", "text": "生死【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0242003", "target": "#nkr_note_mod_0242003", "type": "mod", "text": "撰【大】，梭【宋】【元】【明】"}
{"id": null, "n": "0242004", "target": "#nkr_note_mod_0242004", "type": "mod", "text": "有【大】，何【宋】【元】【明】"}
{"id": null, "n": "0242005", "target": "#nkr_note_mod_0242005", "type": "mod", "text": "受【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0242006", "target": "#nkr_note_mod_0242006", "type": "mod", "text": "可【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0242007", "target": "#nkr_note_mod_0242007", "type": "mod", "text": "生【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0242008", "target": "#nkr_note_mod_0242008", "type": "mod", "text": "令【大】，命【宋】【元】【明】"}
{"id": null, "n": "0242009", "target": "#nkr_note_mod_0242009", "type": "mod", "text": "因緣有【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0242010", "target": "#nkr_note_mod_0242010", "type": "mod", "text": "設【大】，發【明】"}
{"id": null, "n": "0242011", "target": "#nkr_note_mod_0242011", "type": "mod", "text": "是【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0242012", "target": "#nkr_note_mod_0242012", "type": "mod", "text": "愛【大】，受【宋】"}
{"id": null, "n": "0242013", "target": "#nkr_note_mod_0242013", "type": "mod", "text": "杖【大】＊，仗【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0242014", "target": "#nkr_note_mod_0242014", "type": "mod", "text": "鬪【大】，不鬪【宋】【元】【明】"}
{"id": null, "n": "0242015", "target": "#nkr_note_mod_0242015", "type": "mod", "text": "守【大】，家【宋】【元】【明】"}
{"id": null, "n": "0242016", "target": "#nkr_note_mod_0242016", "type": "mod", "text": "從【大】，令【宋】【元】【明】"}
{"id": null, "n": "0242017", "target": "#nkr_note_mod_0242017", "type": "mod", "text": "已發【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0242018", "target": "#nkr_note_mod_0242018", "type": "mod", "text": "阿難【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0243001", "target": "#nkr_note_mod_0243001", "type": "mod", "text": "發【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0243002", "target": "#nkr_note_mod_0243002", "type": "mod", "text": "雖【大】，離【宋】【元】【明】"}
{"id": null, "n": "0243003", "target": "#nkr_note_mod_0243003", "type": "mod", "text": "欲貪【大】，貪欲【宋】【元】【明】"}
{"id": null, "n": "0243004", "target": "#nkr_note_mod_0243004", "type": "mod", "text": "是【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0243005", "target": "#nkr_note_mod_0243005", "type": "mod", "text": "是當【大】，當是【宋】【元】【明】"}
{"id": null, "n": "0243006", "target": "#nkr_note_mod_0243006", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0243007", "target": "#nkr_note_mod_0243007", "type": "mod", "text": "已【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0243008", "target": "#nkr_note_mod_0243008", "type": "mod", "text": "是【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0243009", "target": "#nkr_note_mod_0243009", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0243010", "target": "#nkr_note_mod_0243010", "type": "mod", "text": "會【大】，貪【宋】【元】【明】"}
{"id": null, "n": "0243011", "target": "#nkr_note_mod_0243011", "type": "mod", "text": "無【大】，有【宋】【元】【明】"}
{"id": null, "n": "0243012", "target": "#nkr_note_mod_0243012", "type": "mod", "text": "有【大】，為【宋】【元】【明】"}
{"id": null, "n": "0243013", "target": "#nkr_note_mod_0243013", "type": "mod", "text": "處【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0243014", "target": "#nkr_note_mod_0243014", "type": "mod", "text": "有亦從所【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0243015", "target": "#nkr_note_mod_0243015", "type": "mod", "text": "令【CB】【麗-CB】【宋】【元】【明】，今【大】"}
{"id": null, "n": "0243016", "target": "#nkr_note_mod_0243016", "type": "mod", "text": "有【大】，〔－〕【宋】"}
{"id": null, "n": "0243017", "target": "#nkr_note_mod_0243017", "type": "mod", "text": "阿【大】，復告阿【元】【明】"}
{"id": null, "n": "0243018", "target": "#nkr_note_mod_0243018", "type": "mod", "text": "當【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0243019", "target": "#nkr_note_mod_0243019", "type": "mod", "text": "隨【大】，墮【宋】【元】【明】"}
{"id": null, "n": "0243020", "target": "#nkr_note_mod_0243020", "type": "mod", "text": "增長【大】，長增【宋】【元】【明】"}
{"id": null, "n": "0243021", "target": "#nkr_note_mod_0243021", "type": "mod", "text": "問【大】，聞【宋】【元】【明】"}
{"id": null, "n": "0243022", "target": "#nkr_note_mod_0243022", "type": "mod", "text": "阿難【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0243023", "target": "#nkr_note_mod_0243023", "type": "mod", "text": "緣【大】，緣因緣【宋】【元】【明】"}
{"id": null, "n": "0243024", "target": "#nkr_note_mod_0243024", "type": "mod", "text": "正【大】，政【宋】【元】【明】"}
{"id": null, "n": "0243025", "target": "#nkr_note_mod_0243025", "type": "mod", "text": "受【大】，愛【宋】【元】【明】"}
{"id": null, "n": "0243026", "target": "#nkr_note_mod_0243026", "type": "mod", "text": "是【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0243027", "target": "#nkr_note_mod_0243027", "type": "mod", "text": "樂痛阿難【大】，痛樂痛為【宋】【元】【明】"}
{"id": null, "n": "0243028", "target": "#nkr_note_mod_0243028", "type": "mod", "text": "更【CB】【元】【明】，便【大】"}
{"id": null, "n": "0243029", "target": "#nkr_note_mod_0243029", "type": "mod", "text": "為【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0243030", "target": "#nkr_note_mod_0243030", "type": "mod", "text": "有【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0244001", "target": "#nkr_note_mod_0244001", "type": "mod", "text": "亦【大】，而【宋】【元】【明】"}
{"id": null, "n": "0244002", "target": "#nkr_note_mod_0244002", "type": "mod", "text": "為不【大】，不為【宋】【元】【明】"}
{"id": null, "n": "0244003", "target": "#nkr_note_mod_0244003", "type": "mod", "text": "身【大】，身身【宋】【元】【明】"}
{"id": null, "n": "0244004", "target": "#nkr_note_mod_0244004", "type": "mod", "text": "身為見【大】，見為身【明】"}
{"id": null, "n": "0244005", "target": "#nkr_note_mod_0244005", "type": "mod", "text": "利【大】，說【宋】"}
{"id": null, "n": "0244006", "target": "#nkr_note_mod_0244006", "type": "mod", "text": "阿難【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0244007", "target": "#nkr_note_mod_0244007", "type": "mod", "text": "身【大】，身有【宋】【元】【明】"}
{"id": null, "n": "0244008", "target": "#nkr_note_mod_0244008", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0244009", "target": "#nkr_note_mod_0244009", "type": "mod", "text": "有【大】＊，有有【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0244010", "target": "#nkr_note_mod_0244010", "type": "mod", "text": "為【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0244011", "target": "#nkr_note_mod_0244011", "type": "mod", "text": "令【大】＊，今【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0244012", "target": "#nkr_note_mod_0244012", "type": "mod", "text": "如是【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0244013", "target": "#nkr_note_mod_0244013", "type": "mod", "text": "少【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0244014", "target": "#nkr_note_mod_0244014", "type": "mod", "text": "（自方…身）十七字【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0244015", "target": "#nkr_note_mod_0244015", "type": "mod", "text": "身【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0244016", "target": "#nkr_note_mod_0244016", "type": "mod", "text": "現身【大】，見【宋】【元】【明】"}
{"id": null, "n": "0244017", "target": "#nkr_note_mod_0244017", "type": "mod", "text": "令【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0244018", "target": "#nkr_note_mod_0244018", "type": "mod", "text": "彼【大】，彼是【宋】【元】【明】"}
{"id": null, "n": "0244019", "target": "#nkr_note_mod_0244019", "type": "mod", "text": "為色作【大】，色作為【宋】【元】【明】"}
{"id": null, "n": "0244020", "target": "#nkr_note_mod_0244020", "type": "mod", "text": "少色【大】，色少【宋】【元】【明】"}
{"id": null, "n": "0244021", "target": "#nkr_note_mod_0244021", "type": "mod", "text": "是無有【大】，無有是【宋】【元】【明】"}
{"id": null, "n": "0244022", "target": "#nkr_note_mod_0244022", "type": "mod", "text": "是【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0244023", "target": "#nkr_note_mod_0244023", "type": "mod", "text": "是【大】，是是【宋】【元】【明】"}
{"id": null, "n": "0244024", "target": "#nkr_note_mod_0244024", "type": "mod", "text": "身【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0244025", "target": "#nkr_note_mod_0244025", "type": "mod", "text": "身【大】，身已【宋】【元】【明】"}
{"id": null, "n": "0244026", "target": "#nkr_note_mod_0244026", "type": "mod", "text": "現【大】，現今【宋】【元】【明】"}
{"id": null, "n": "0245001", "target": "#nkr_note_mod_0245001", "type": "mod", "text": "不【大】，身【宋】【元】【明】"}
{"id": null, "n": "0245002", "target": "#nkr_note_mod_0245002", "type": "mod", "text": "行【大】，近【宋】【元】【明】"}
{"id": null, "n": "0245003", "target": "#nkr_note_mod_0245003", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0245004", "target": "#nkr_note_mod_0245004", "type": "mod", "text": "辟【大】＊，譬【宋】，辟【明】＊"}
{"id": null, "n": "0245005", "target": "#nkr_note_mod_0245005", "type": "mod", "text": "明【大】，門【元】"}
{"id": null, "n": "0245006", "target": "#nkr_note_mod_0245006", "type": "mod", "text": "受【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0245007", "target": "#nkr_note_mod_0245007", "type": "mod", "text": "不【大】，不在【宋】【元】【明】"}
{"id": null, "n": "0245008", "target": "#nkr_note_mod_0245008", "type": "mod", "text": "受【大】，是【宋】【元】【明】"}
{"id": null, "n": "0245009", "target": "#nkr_note_mod_0245009", "type": "mod", "text": "解【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0245010", "target": "#nkr_note_mod_0245010", "type": "mod", "text": "不【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0245011", "target": "#nkr_note_mod_0245011", "type": "mod", "text": "名【大】，天名【宋】【元】【明】"}
{"id": null, "n": "0245012", "target": "#nkr_note_mod_0245012", "type": "mod", "text": "處【大】，處天天【宋】【元】【明】"}
{"id": null, "n": "0245013a", "target": "#nkr_note_mod_0245013a", "type": "mod", "text": "（若阿…住處）六十五字【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0245013b", "target": "#nkr_note_mod_0245013b", "type": "mod", "text": "阿難對言不【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0245014", "target": "#nkr_note_mod_0245014", "type": "mod", "text": "為【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0245015", "target": "#nkr_note_mod_0245015", "type": "mod", "text": "可應【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0245016", "target": "#nkr_note_mod_0245016", "type": "mod", "text": "所【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0245017", "target": "#nkr_note_mod_0245017", "type": "mod", "text": "沒【大】，後【元】【明】"}
{"id": null, "n": "0245018", "target": "#nkr_note_mod_0245018", "type": "mod", "text": "（為從…切）十一字【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0245019", "target": "#nkr_note_mod_0245019", "type": "mod", "text": "彼阿難【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0245020", "target": "#nkr_note_mod_0245020", "type": "mod", "text": "是【大】，見【宋】【元】【明】"}
{"id": null, "n": "0245021", "target": "#nkr_note_mod_0245021", "type": "mod", "text": "受【大】＊，愛【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0245022", "target": "#nkr_note_mod_0245022", "type": "mod", "text": "亦【大】，亦習【宋】【元】【明】"}
{"id": null, "n": "0245023", "target": "#nkr_note_mod_0245023", "type": "mod", "text": "亦【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0245024", "target": "#nkr_note_mod_0245024", "type": "mod", "text": "止【大】，止行止【宋】【元】【明】"}
{"id": null, "n": "0246001", "target": "#nkr_note_mod_0246001", "type": "mod", "text": "本【大】，本本【宋】【元】【明】"}
{"id": null, "n": "0246002", "target": "#nkr_note_mod_0246002", "type": "mod", "text": "得【大】，復【宋】【元】【明】"}
