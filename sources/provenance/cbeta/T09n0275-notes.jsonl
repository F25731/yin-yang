{"id": null, "n": "0382003", "target": "#nkr_note_orig_0382003", "type": "orig", "text": "是＝此【三】【宮】"}
{"id": null, "n": "0382004", "target": "#nkr_note_orig_0382004", "type": "orig", "text": "苦＝世【明】"}
{"id": null, "n": "0383001", "target": "#nkr_note_orig_0383001", "type": "orig", "text": "若＋（有）【三】【宮】"}
{"id": null, "n": "0383002", "target": "#nkr_note_orig_0383002", "type": "orig", "text": "（得）＋不【三】【宮】"}
