{"id": null, "n": "0381004", "target": "#nkr_note_orig_0381004", "type": "orig", "text": "唯＝惟【宮】＊"}
{"id": null, "n": "0381005", "target": "#nkr_note_orig_0381005", "type": "orig", "text": "相＝想【三】【宮】"}
{"id": null, "n": "0382001", "target": "#nkr_note_orig_0382001", "type": "orig", "text": "誹＝非【三】【宮】"}
