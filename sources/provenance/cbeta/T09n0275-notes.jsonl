{"id": null, "n": "0379002", "target": "#nkr_note_mod_0379002", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0379003", "target": "#nkr_note_mod_0379003", "type": "mod", "text": "忘【大】，妄【宋】【元】【明】【宮】"}
{"id": null, "n": "0380001", "target": "#nkr_note_mod_0380001", "type": "mod", "text": "授【大】，受【宋】【元】【明】【宮】"}
{"id": null, "n": "0380002", "target": "#nkr_note_mod_0380002", "type": "mod", "text": "唯【大】下同，惟【宋】【宮】下同"}
{"id": null, "n": "0380003", "target": "#nkr_note_mod_0380003", "type": "mod", "text": "渧【大】，滴【宋】【元】【明】【宮】"}
{"id": null, "n": "0381001", "target": "#nkr_note_mod_0381001", "type": "mod", "text": "集【大】，習【宋】【元】【明】【宮】"}
{"id": null, "n": "0381002", "target": "#nkr_note_mod_0381002", "type": "mod", "text": "惟【大】，唯【元】【明】"}
{"id": null, "n": "0381003", "target": "#nkr_note_mod_0381003", "type": "mod", "text": "腦【CB】【麗-CB】【宮】，惱【大】"}
{"id": null, "n": "0381004", "target": "#nkr_note_mod_0381004", "type": "mod", "text": "唯【大】＊，惟【宮】＊"}
{"id": null, "n": "0381005", "target": "#nkr_note_mod_0381005", "type": "mod", "text": "相【大】，想【宋】【元】【明】【宮】"}
{"id": null, "n": "0382001", "target": "#nkr_note_mod_0382001", "type": "mod", "text": "誹【大】，非【宋】【元】【明】【宮】"}
{"id": null, "n": "0382002", "target": "#nkr_note_mod_0382002", "type": "mod", "text": "無【大】，現無【宋】【元】【明】【宮】"}
{"id": null, "n": "0382003", "target": "#nkr_note_mod_0382003", "type": "mod", "text": "是【大】，此【宋】【元】【明】【宮】"}
{"id": null, "n": "0382004", "target": "#nkr_note_mod_0382004", "type": "mod", "text": "苦【大】，世【明】"}
{"id": null, "n": "0383001", "target": "#nkr_note_mod_0383001", "type": "mod", "text": "若【大】，若有【宋】【元】【明】【宮】"}
{"id": null, "n": "0383002", "target": "#nkr_note_mod_0383002", "type": "mod", "text": "不【大】，得不【宋】【元】【明】【宮】"}
{"id": null, "n": "0379002", "target": "#nkr_note_orig_0379002", "type": "orig", "text": "〔一卷〕－【三】【宮】"}
