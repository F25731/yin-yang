{"id": null, "n": "0380002", "target": "#nkr_note_orig_0380002", "type": "orig", "text": "唯＝惟【宋】【宮】下同"}
{"id": null, "n": "0380003", "target": "#nkr_note_orig_0380003", "type": "orig", "text": "渧＝滴【三】【宮】"}
{"id": null, "n": "0381001", "target": "#nkr_note_orig_0381001", "type": "orig", "text": "集＝習【三】【宮】"}
{"id": null, "n": "0381002", "target": "#nkr_note_orig_0381002", "type": "orig", "text": "惟＝唯【元】【明】"}
