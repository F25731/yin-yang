{"id": null, "n": "0368a0201", "target": "#nkr_note_add_0368a0201", "type": "add", "text": "敕【CB】，敇【志彙】"}
{"id": null, "n": "0382a0101", "target": "#nkr_note_add_0382a0101", "type": "add", "text": "圮【CB】，𡉏【志彙】"}
{"id": null, "n": "0392a0101", "target": "#nkr_note_add_0392a0101", "type": "add", "text": "廓【CB】，廊【志彙】"}
{"id": null, "n": "0406a0401", "target": "#nkr_note_add_0406a0401", "type": "add", "text": "如【CB】，無【志彙】"}
