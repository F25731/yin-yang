{"id": null, "n": "0498001", "target": "#nkr_note_orig_0498001", "type": "orig", "text": "【原】享保年間刊豐山大學藏本"}
{"id": null, "n": "0498002", "target": "#nkr_note_orig_0498002", "type": "orig", "text": "世音自在王＝自在ィ【原】"}
{"id": null, "n": "0498003", "target": "#nkr_note_orig_0498003", "type": "orig", "text": "陀羅尼＝真言ィ【原】"}
{"id": null, "n": "0498004", "target": "#nkr_note_orig_0498004", "type": "orig", "text": "本＋（體）ヵ【原】"}
