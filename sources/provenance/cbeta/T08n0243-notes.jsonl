{"id": null, "n": "0784002", "target": "#nkr_note_mod_0784002", "type": "mod", "text": "經【大】，般若波羅蜜多理趣經【宋】【元】【明】【宮】，Prajñāpāramitā naya Śatapañcāśatikā or Adhyardha śatikā."}
{"id": null, "n": "0784003", "target": "#nkr_note_mod_0784003", "type": "mod", "text": "開府…譯【大】，三藏沙門大廣智不空奉詔譯【宋】【元】，唐三藏沙門大廣智不空奉詔譯【明】，大興善寺三藏沙門不空奉詔譯【宮】"}
{"id": null, "n": "0784004", "target": "#nkr_note_mod_0784004", "type": "mod", "text": "般若…品【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0784005", "target": "#nkr_note_mod_0784005", "type": "mod", "text": "金剛手 Vajrapāṇi."}
{"id": null, "n": "0784006", "target": "#nkr_note_mod_0784006", "type": "mod", "text": "觀自在 Avalokiteśvara."}
{"id": null, "n": "0784007", "target": "#nkr_note_mod_0784007", "type": "mod", "text": "虛空藏 Ākāśagarbha."}
{"id": null, "n": "0784010", "target": "#nkr_note_mod_0784010", "type": "mod", "text": "纔發心轉法輪 Sacittotpāda-dharmacakra-pravartin."}
{"id": null, "n": "0784011", "target": "#nkr_note_mod_0784011", "type": "mod", "text": "虛空庫 Gaganagañja."}
{"id": null, "n": "0784013", "target": "#nkr_note_mod_0784013", "type": "mod", "text": "一切法自性清淨 Sarvadharṃāḥ svabhāvaviśuddhāḥ."}
{"id": null, "n": "0784014", "target": "#nkr_note_mod_0784014", "type": "mod", "text": "搊【大】，抽【宋】【元】"}
{"id": null, "n": "0784016", "target": "#nkr_note_mod_0784016", "type": "mod", "text": "引重呼【大】，平聲重呼引【明】"}
{"id": null, "n": "0784017", "target": "#nkr_note_mod_0784017", "type": "mod", "text": "調伏難調釋迦牟尼 Sarva-duṣṭa-vinaya sākyamuni."}
{"id": null, "n": "0784019", "target": "#nkr_note_mod_0784019", "type": "mod", "text": "短【大】，短聲【明】"}
{"id": null, "n": "0784020", "target": "#nkr_note_mod_0784020", "type": "mod", "text": "得自性清淨法性 Svabhāva-śuddha."}
{"id": null, "n": "0785001", "target": "#nkr_note_mod_0785001", "type": "mod", "text": "紇唎 Hrī."}
{"id": null, "n": "0785002", "target": "#nkr_note_mod_0785002", "type": "mod", "text": "入【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0785003", "target": "#nkr_note_mod_0785003", "type": "mod", "text": "一切三界主 Sarva-traidhātukādhipati."}
{"id": null, "n": "0785004", "target": "#nkr_note_mod_0785004", "type": "mod", "text": "怛覽 Trāṃ."}
{"id": null, "n": "0785005", "target": "#nkr_note_mod_0785005", "type": "mod", "text": "得一切如來智印 Śāśvata-sarva-tathāgatajñana-mudrā-prāpta sarvatathāgata-muṣṭi-dhāra."}
{"id": null, "n": "0785006", "target": "#nkr_note_mod_0785006", "type": "mod", "text": "摩【大】，麼【宮】"}
{"id": null, "n": "0785007", "target": "#nkr_note_mod_0785007", "type": "mod", "text": "真【大】，真實【宋】【元】【明】"}
{"id": null, "n": "0785008", "target": "#nkr_note_mod_0785008", "type": "mod", "text": "一切無戲論 Sarvadharmāprapañca."}
{"id": null, "n": "0785010", "target": "#nkr_note_mod_0785010", "type": "mod", "text": "一切如來入大輪 Sarva-tathāgata cakrāntar gata."}
{"id": null, "n": "0785011", "target": "#nkr_note_mod_0785011", "type": "mod", "text": "一切如來種種供養藏廣大儀式 Sarva-pūjā-viddhi vistara-bhājana."}
{"id": null, "n": "0785012", "target": "#nkr_note_mod_0785012", "type": "mod", "text": "唵 Oṃ."}
{"id": null, "n": "0785013", "target": "#nkr_note_mod_0785013", "type": "mod", "text": "能調持智拳 Sarva-vinaya-samartha."}
{"id": null, "n": "0785014", "target": "#nkr_note_mod_0785014", "type": "mod", "text": "故【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0785015", "target": "#nkr_note_mod_0785015", "type": "mod", "text": "一切平等建立 Sarva-dharma-samatā-pratiṣṭhita."}
{"id": null, "n": "0785016", "target": "#nkr_note_mod_0785016", "type": "mod", "text": "一切有情如來藏 Sarva-sattvās tathāgata-garbhāḥ."}
{"id": null, "n": "0785017", "target": "#nkr_note_mod_0785017", "type": "mod", "text": "普賢 Samantabhadra."}
{"id": null, "n": "0785018", "target": "#nkr_note_mod_0785018", "type": "mod", "text": "羯磨 Karma."}
{"id": null, "n": "0785019", "target": "#nkr_note_mod_0785019", "type": "mod", "text": "怛𡃤【大】，炟𡃤【？】，Trī."}
{"id": null, "n": "0785020", "target": "#nkr_note_mod_0785020", "type": "mod", "text": "無量無邊究竟 Anantāparyantāniṣṭha."}
{"id": null, "n": "0786001", "target": "#nkr_note_mod_0786001", "type": "mod", "text": "毘盧…戲論 Vairocana sarva-tathāgata-guhya-dharmatā-prāpta-dharmāprapañca."}
{"id": null, "n": "0786002", "target": "#nkr_note_mod_0786002", "type": "mod", "text": "昧【大】，麼【明】"}
{"id": null, "n": "0786003", "target": "#nkr_note_mod_0786003", "type": "mod", "text": "大【大】，大來大【宮】"}
{"id": null, "n": "0786004", "target": "#nkr_note_mod_0786004", "type": "mod", "text": "昧【大】，麼【明】"}
{"id": null, "n": "0786005", "target": "#nkr_note_mod_0786005", "type": "mod", "text": "諸魔【大】，金剛【明】"}
{"id": null, "n": "0786006", "target": "#nkr_note_mod_0786006", "type": "mod", "text": "速【大】，趣【明】"}
{"id": null, "n": "0786007", "target": "#nkr_note_mod_0786007", "type": "mod", "text": "經【大】，般若波羅蜜多理趣經【宋】【元】【明】【宮】"}
{"id": null, "n": "0784002", "target": "#nkr_note_orig_0784002", "type": "orig", "text": "（般若波羅蜜多理趣）＋經【三】【宮】，Prajñāpāramitā naya Śatapañcāśatikā or Adhyardha śatikā."}
{"id": null, "n": "0784003", "target": "#nkr_note_orig_0784003", "type": "orig", "text": "開府…譯＝三藏沙門大廣智不空奉詔譯【宋】【元】，唐三藏沙門大廣智不空奉詔譯【明】，大興善寺三藏沙門不空奉詔譯【宮】"}
{"id": null, "n": "0784004", "target": "#nkr_note_orig_0784004", "type": "orig", "text": "〔般若…品〕－【三】【宮】"}
{"id": null, "n": "0784005", "target": "#nkr_note_orig_0784005", "type": "orig", "text": "金剛手. Vajrapāṇi."}
{"id": null, "n": "0784006", "target": "#nkr_note_orig_0784006", "type": "orig", "text": "觀自在. Avalokiteśvara."}
{"id": null, "n": "0784007", "target": "#nkr_note_orig_0784007", "type": "orig", "text": "虛空藏. Ākāśagarbha."}
{"id": null, "n": "0784008", "target": "#nkr_note_orig_0784008", "type": "orig", "text": "金剛拳 Vajramuṣṭi."}
{"id": null, "n": "0784009", "target": "#nkr_note_orig_0784009", "type": "orig", "text": "Mañjuśrī."}
{"id": null, "n": "0784010", "target": "#nkr_note_orig_0784010", "type": "orig", "text": "纔發心轉法輪. Sacittotpāda-dharmacakra-pravartin."}
{"id": null, "n": "0784011", "target": "#nkr_note_orig_0784011", "type": "orig", "text": "虛空庫. Gaganagañja."}
{"id": null, "n": "0784012", "target": "#nkr_note_orig_0784012", "type": "orig", "text": "摧一切魔 Sarvamāra-pramardin."}
{"id": null, "n": "0784013", "target": "#nkr_note_orig_0784013", "type": "orig", "text": "一切法自性清淨. Sarvadharṃāḥ svabhāvaviśuddhāḥ."}
{"id": null, "n": "0784014", "target": "#nkr_note_orig_0784014", "type": "orig", "text": "搊＝抽【宋】【元】"}
{"id": null, "n": "0784015", "target": "#nkr_note_orig_0784015", "type": "orig", "text": "Vairocana."}
{"id": null, "n": "0784016", "target": "#nkr_note_orig_0784016", "type": "orig", "text": "引重呼＝平聲重呼引【明】"}
{"id": null, "n": "0784017", "target": "#nkr_note_orig_0784017", "type": "orig", "text": "調伏難調釋迦牟尼. Sarva-duṣṭa-vinaya sākyamuni."}
{"id": null, "n": "0784018", "target": "#nkr_note_orig_0784018", "type": "orig", "text": "吽 Hūṃ."}
{"id": null, "n": "0784019", "target": "#nkr_note_orig_0784019", "type": "orig", "text": "短＋（聲）【明】"}
{"id": null, "n": "0784020", "target": "#nkr_note_orig_0784020", "type": "orig", "text": "得自性清淨法性. Svabhāva-śuddha."}
{"id": null, "n": "0785001", "target": "#nkr_note_orig_0785001", "type": "orig", "text": "紇唎. Hrī."}
{"id": null, "n": "0785002", "target": "#nkr_note_orig_0785002", "type": "orig", "text": "〔入〕－【三】"}
{"id": null, "n": "0785003", "target": "#nkr_note_orig_0785003", "type": "orig", "text": "一切三界主. Sarva-traidhātukādhipati."}
{"id": null, "n": "0785004", "target": "#nkr_note_orig_0785004", "type": "orig", "text": "怛覽. Trāṃ."}
{"id": null, "n": "0785005", "target": "#nkr_note_orig_0785005", "type": "orig", "text": "得一切如來智印. Śāśvata-sarva-tathāgatajñana-mudrā-prāpta sarvatathāgata-muṣṭi-dhāra."}
{"id": null, "n": "0785006", "target": "#nkr_note_orig_0785006", "type": "orig", "text": "摩＝麼【宮】"}
{"id": null, "n": "0785007", "target": "#nkr_note_orig_0785007", "type": "orig", "text": "真＋（實）【三】"}
{"id": null, "n": "0785008", "target": "#nkr_note_orig_0785008", "type": "orig", "text": "一切無戲論. Sarvadharmāprapañca."}
{"id": null, "n": "0785009", "target": "#nkr_note_orig_0785009", "type": "orig", "text": "菴 Aṃ."}
{"id": null, "n": "0785010", "target": "#nkr_note_orig_0785010", "type": "orig", "text": "一切如來入大輪. Sarva-tathāgata cakrāntar gata."}
{"id": null, "n": "0785011", "target": "#nkr_note_orig_0785011", "type": "orig", "text": "一切如來種々供養藏廣大儀式. Sarva-pūjā-viddhi vistara-bhājana."}
{"id": null, "n": "0785012", "target": "#nkr_note_orig_0785012", "type": "orig", "text": "唵. Oṃ."}
{"id": null, "n": "0785013", "target": "#nkr_note_orig_0785013", "type": "orig", "text": "能調持智拳. Sarva-vinaya-samartha."}
{"id": null, "n": "0785014", "target": "#nkr_note_orig_0785014", "type": "orig", "text": "〔故〕－【三】"}
{"id": null, "n": "0785015", "target": "#nkr_note_orig_0785015", "type": "orig", "text": "一切平等建立. Sarva-dharma-samatā-pratiṣṭhita."}
{"id": null, "n": "0785016", "target": "#nkr_note_orig_0785016", "type": "orig", "text": "一切有情如來藏. Sarva-sattvās tathāgata-garbhāḥ."}
{"id": null, "n": "0785017", "target": "#nkr_note_orig_0785017", "type": "orig", "text": "普賢. Samantabhadra."}
{"id": null, "n": "0785018", "target": "#nkr_note_orig_0785018", "type": "orig", "text": "羯磨. Karma."}
{"id": null, "n": "0785019", "target": "#nkr_note_orig_0785019", "type": "orig", "text": "怛賴＝炟𡃤，Trī."}
{"id": null, "n": "0785020", "target": "#nkr_note_orig_0785020", "type": "orig", "text": "無量無邊究竟. Anantāparyantāniṣṭha."}
{"id": null, "n": "0786001", "target": "#nkr_note_orig_0786001", "type": "orig", "text": "毘盧…戲論. Vairocana sarva-tathāgata-guhya-dharmatā-prāpta-dharmāprapañca."}
