{"id": null, "n": "0774001", "target": "#nkr_note_mod_0774001", "type": "mod", "text": "大檗本作大"}
{"id": null, "n": "0774005", "target": "#nkr_note_mod_0774005", "type": "mod", "text": "依【大】，作【考偽-甲】"}
{"id": null, "n": "0774018", "target": "#nkr_note_mod_0774018", "type": "mod", "text": "文【大】，〔－〕【考偽-甲】"}
{"id": null, "n": "0774024", "target": "#nkr_note_mod_0774024", "type": "mod", "text": "闍【大】，阿闍【甲】"}
{"id": null, "n": "0774025", "target": "#nkr_note_mod_0774025", "type": "mod", "text": "壇【大】，壇場【考偽-甲】"}
{"id": null, "n": "0776016", "target": "#nkr_note_mod_0776016", "type": "mod", "text": "三焰【大】，焰三【考偽-甲】"}
{"id": null, "n": "0776017", "target": "#nkr_note_mod_0776017", "type": "mod", "text": "髮【大】，髻【考偽-甲】"}
{"id": null, "n": "0773004", "target": "#nkr_note_orig_0773004", "type": "orig", "text": "【原】縮刷大藏經，【甲】黃檗版淨嚴等校訂加筆本塚本賢曉氏藏"}
{"id": null, "n": "0773005", "target": "#nkr_note_orig_0773005", "type": "orig", "text": "百八檗本作八百"}
{"id": null, "n": "0773006", "target": "#nkr_note_orig_0773006", "type": "orig", "text": "檗本無見字"}
{"id": null, "n": "0773007", "target": "#nkr_note_orig_0773007", "type": "orig", "text": "牽蘗本作掌"}
{"id": null, "n": "0773008", "target": "#nkr_note_orig_0773008", "type": "orig", "text": "蘗本無見字"}
{"id": null, "n": "0773009", "target": "#nkr_note_orig_0773009", "type": "orig", "text": "窮老少蘗本作老窮小"}
{"id": null, "n": "0773010", "target": "#nkr_note_orig_0773010", "type": "orig", "text": "勸蘗本作觀"}
{"id": null, "n": "0773011", "target": "#nkr_note_orig_0773011", "type": "orig", "text": "檗本無生字"}
{"id": null, "n": "0773012", "target": "#nkr_note_orig_0773012", "type": "orig", "text": "火檗本作大"}
{"id": null, "n": "0773013", "target": "#nkr_note_orig_0773013", "type": "orig", "text": "面檗本作而"}
{"id": null, "n": "0773014", "target": "#nkr_note_orig_0773014", "type": "orig", "text": "寡檗本作賓"}
{"id": null, "n": "0773015", "target": "#nkr_note_orig_0773015", "type": "orig", "text": "作檗本作住"}
{"id": null, "n": "0773016", "target": "#nkr_note_orig_0773016", "type": "orig", "text": "駝檗本作駄"}
{"id": null, "n": "0773017", "target": "#nkr_note_orig_0773017", "type": "orig", "text": "檗本無之字"}
{"id": null, "n": "0773018", "target": "#nkr_note_orig_0773018", "type": "orig", "text": "忍檗本作思"}
{"id": null, "n": "0773019", "target": "#nkr_note_orig_0773019", "type": "orig", "text": "於檗本作持"}
{"id": null, "n": "0773020", "target": "#nkr_note_orig_0773020", "type": "orig", "text": "欬檗本作𭭉下同"}
{"id": null, "n": "0773021", "target": "#nkr_note_orig_0773021", "type": "orig", "text": "遠下檗本有離字"}
{"id": null, "n": "0773022", "target": "#nkr_note_orig_0773022", "type": "orig", "text": "續檗本作讀"}
{"id": null, "n": "0773023", "target": "#nkr_note_orig_0773023", "type": "orig", "text": "甲本頭註曰不令二字之下恐有脫錯"}
{"id": null, "n": "0773024", "target": "#nkr_note_orig_0773024", "type": "orig", "text": "任檗本作住"}
{"id": null, "n": "0774001", "target": "#nkr_note_orig_0774001", "type": "orig", "text": "大檗本作大"}
{"id": null, "n": "0774002", "target": "#nkr_note_orig_0774002", "type": "orig", "text": "檗本無即字"}
{"id": null, "n": "0774003", "target": "#nkr_note_orig_0774003", "type": "orig", "text": "念結檗本作結念"}
{"id": null, "n": "0774004", "target": "#nkr_note_orig_0774004", "type": "orig", "text": "幡檗本作悁"}
{"id": null, "n": "0774005", "target": "#nkr_note_orig_0774005", "type": "orig", "text": "依＝作ヵ【甲】"}
{"id": null, "n": "0774006", "target": "#nkr_note_orig_0774006", "type": "orig", "text": "珠下檗本有五字"}
{"id": null, "n": "0774007", "target": "#nkr_note_orig_0774007", "type": "orig", "text": "甲本頭註曰之間之下恐有錯脫"}
{"id": null, "n": "0774008", "target": "#nkr_note_orig_0774008", "type": "orig", "text": "任檗本作住"}
{"id": null, "n": "0774009", "target": "#nkr_note_orig_0774009", "type": "orig", "text": "歡檗本作觀"}
{"id": null, "n": "0774010", "target": "#nkr_note_orig_0774010", "type": "orig", "text": "檗本無捨字"}
{"id": null, "n": "0774011", "target": "#nkr_note_orig_0774011", "type": "orig", "text": "甲本頭註曰依恐被字或又得字又任字又住作"}
{"id": null, "n": "0774012", "target": "#nkr_note_orig_0774012", "type": "orig", "text": "檗本無執字"}
{"id": null, "n": "0774013", "target": "#nkr_note_orig_0774013", "type": "orig", "text": "檗本無毘那二字"}
{"id": null, "n": "0774014", "target": "#nkr_note_orig_0774014", "type": "orig", "text": "檗本無是字"}
{"id": null, "n": "0774015", "target": "#nkr_note_orig_0774015", "type": "orig", "text": "甲本頭註曰我見之上恐有脫錯"}
{"id": null, "n": "0774016", "target": "#nkr_note_orig_0774016", "type": "orig", "text": "檗本無事字"}
{"id": null, "n": "0774017", "target": "#nkr_note_orig_0774017", "type": "orig", "text": "路之檗本作之路"}
{"id": null, "n": "0774018", "target": "#nkr_note_orig_0774018", "type": "orig", "text": "〔文〕－ヵ【甲】"}
{"id": null, "n": "0774019", "target": "#nkr_note_orig_0774019", "type": "orig", "text": "檗本無密字"}
{"id": null, "n": "0774020", "target": "#nkr_note_orig_0774020", "type": "orig", "text": "轉執即暗甲本朱註曰四字未詳"}
{"id": null, "n": "0774021", "target": "#nkr_note_orig_0774021", "type": "orig", "text": "奮檗本作奪"}
{"id": null, "n": "0774022", "target": "#nkr_note_orig_0774022", "type": "orig", "text": "檗本無應字"}
{"id": null, "n": "0774023", "target": "#nkr_note_orig_0774023", "type": "orig", "text": "誦上檗本有應字"}
{"id": null, "n": "0774024", "target": "#nkr_note_orig_0774024", "type": "orig", "text": "（阿）＋闍【甲】"}
{"id": null, "n": "0774025", "target": "#nkr_note_orig_0774025", "type": "orig", "text": "壇＋（場）ヵ【甲】"}
{"id": null, "n": "0775001", "target": "#nkr_note_orig_0775001", "type": "orig", "text": "軌蘗本作執"}
{"id": null, "n": "0775002", "target": "#nkr_note_orig_0775002", "type": "orig", "text": "持蘗本作於"}
{"id": null, "n": "0775003", "target": "#nkr_note_orig_0775003", "type": "orig", "text": "經蘗本作輕"}
{"id": null, "n": "0775004", "target": "#nkr_note_orig_0775004", "type": "orig", "text": "掉蘗本作悼"}
{"id": null, "n": "0775005", "target": "#nkr_note_orig_0775005", "type": "orig", "text": "甲本頭註曰呪神之下恐有脫文"}
{"id": null, "n": "0775006", "target": "#nkr_note_orig_0775006", "type": "orig", "text": "真信蘗本作信真"}
{"id": null, "n": "0775007", "target": "#nkr_note_orig_0775007", "type": "orig", "text": "乞蘗本作几"}
{"id": null, "n": "0775008", "target": "#nkr_note_orig_0775008", "type": "orig", "text": "合蘗本作令"}
{"id": null, "n": "0775009", "target": "#nkr_note_orig_0775009", "type": "orig", "text": "蘗本無之字"}
{"id": null, "n": "0775010", "target": "#nkr_note_orig_0775010", "type": "orig", "text": "甲本頭註曰孝子疑是狂子"}
{"id": null, "n": "0775011", "target": "#nkr_note_orig_0775011", "type": "orig", "text": "被蘗本作披"}
{"id": null, "n": "0776001", "target": "#nkr_note_orig_0776001", "type": "orig", "text": "蘗本無音字"}
{"id": null, "n": "0776002", "target": "#nkr_note_orig_0776002", "type": "orig", "text": "勇蘖本作男"}
{"id": null, "n": "0776003", "target": "#nkr_note_orig_0776003", "type": "orig", "text": "中蘖本作後"}
{"id": null, "n": "0776004", "target": "#nkr_note_orig_0776004", "type": "orig", "text": "蘗本無罪字"}
{"id": null, "n": "0776005", "target": "#nkr_note_orig_0776005", "type": "orig", "text": "飲蘗本作欲"}
{"id": null, "n": "0776006", "target": "#nkr_note_orig_0776006", "type": "orig", "text": "浴下蘗本無呪字"}
{"id": null, "n": "0776007", "target": "#nkr_note_orig_0776007", "type": "orig", "text": "下蘗本作上"}
{"id": null, "n": "0776008", "target": "#nkr_note_orig_0776008", "type": "orig", "text": "跋蘗本作跛"}
{"id": null, "n": "0776009", "target": "#nkr_note_orig_0776009", "type": "orig", "text": "娑蘗本作婆"}
{"id": null, "n": "0776010", "target": "#nkr_note_orig_0776010", "type": "orig", "text": "末蘗本作未"}
{"id": null, "n": "0776011", "target": "#nkr_note_orig_0776011", "type": "orig", "text": "𣐍蘗本作栓"}
{"id": null, "n": "0776012", "target": "#nkr_note_orig_0776012", "type": "orig", "text": "想蘗本作相"}
{"id": null, "n": "0776013", "target": "#nkr_note_orig_0776013", "type": "orig", "text": "鞔蘗本作𩊛"}
{"id": null, "n": "0776014", "target": "#nkr_note_orig_0776014", "type": "orig", "text": "鑵蘗本作灌"}
{"id": null, "n": "0776015", "target": "#nkr_note_orig_0776015", "type": "orig", "text": "蘗本無畫字"}
{"id": null, "n": "0776016", "target": "#nkr_note_orig_0776016", "type": "orig", "text": "三焰＝焰三ヵ【甲】"}
{"id": null, "n": "0776017", "target": "#nkr_note_orig_0776017", "type": "orig", "text": "髮＝髻ヵ【甲】"}
{"id": null, "n": "0776018", "target": "#nkr_note_orig_0776018", "type": "orig", "text": "鉤蘗本作苟"}
{"id": null, "n": "0776019", "target": "#nkr_note_orig_0776019", "type": "orig", "text": "畏蘗本作鬼"}
{"id": null, "n": "0776020", "target": "#nkr_note_orig_0776020", "type": "orig", "text": "佉蘗本作法"}
{"id": null, "n": "0776021", "target": "#nkr_note_orig_0776021", "type": "orig", "text": "宜畫蘗本作畫宜"}
{"id": null, "n": "0776022", "target": "#nkr_note_orig_0776022", "type": "orig", "text": "甲本無此奧書，甲本奧書云元祿十六年三月十七日淨嚴和上之本再校了尊教"}
{"id": null, "n": "0774a2801", "target": "#nkr_note_add_0774a2801", "type": "add", "text": "掐【CB】，搯【大】"}
{"id": null, "n": "0776c1501", "target": "#nkr_note_add_0776c1501", "type": "add", "text": "耶【CB】，那【大】"}
