{"id": null, "n": null, "target": null, "type": "cf1", "text": "K11n0248_p0530c19"}
{"id": null, "n": "1100004", "target": "#nkr_note_mod_1100004", "type": "mod", "text": "善【大】＊，佛說善【元】【明】＊"}
{"id": null, "n": "1100005", "target": "#nkr_note_mod_1100005", "type": "mod", "text": "三藏【大】，三藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "1100006", "target": "#nkr_note_mod_1100006", "type": "mod", "text": "優婆【大】，憂波【宋】【元】【明】【宮】"}
{"id": null, "n": "1101001", "target": "#nkr_note_mod_1101001", "type": "mod", "text": "言【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1101002", "target": "#nkr_note_mod_1101002", "type": "mod", "text": "如【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1101003", "target": "#nkr_note_mod_1101003", "type": "mod", "text": "惟【大】，唯【元】【明】"}
{"id": null, "n": "1101004", "target": "#nkr_note_mod_1101004", "type": "mod", "text": "和上【大】下同，和尚【明】【宮】下同"}
{"id": null, "n": "1101005", "target": "#nkr_note_mod_1101005", "type": "mod", "text": "順【大】，慎【宋】【元】【明】【宮】"}
{"id": null, "n": "1101006", "target": "#nkr_note_mod_1101006", "type": "mod", "text": "命【大】，令【宋】【元】【明】【宮】"}
{"id": null, "n": "1101007", "target": "#nkr_note_mod_1101007", "type": "mod", "text": "偏【大】，褊【元】【明】"}
{"id": null, "n": "1101008", "target": "#nkr_note_mod_1101008", "type": "mod", "text": "虫【大】下同，蟲【元】【明】下同"}
{"id": null, "n": "1101009", "target": "#nkr_note_mod_1101009", "type": "mod", "text": "至日【大】，日出【宋】【元】【明】【宮】"}
{"id": null, "n": "1101010", "target": "#nkr_note_mod_1101010", "type": "mod", "text": "洗【大】下同，洒【宮】下同"}
{"id": null, "n": "1101011", "target": "#nkr_note_mod_1101011", "type": "mod", "text": "不名【大】，名不【宋】【元】【明】【宮】"}
{"id": null, "n": "1102001", "target": "#nkr_note_mod_1102001", "type": "mod", "text": "椎【大】，磓【宋】【元】【明】【宮】"}
{"id": null, "n": "1102002", "target": "#nkr_note_mod_1102002", "type": "mod", "text": "𣣋【大】，凌【宋】【元】【明】【宮】"}
{"id": null, "n": "1102003", "target": "#nkr_note_mod_1102003", "type": "mod", "text": "檐【大】，擔【宋】【元】【明】【宮】"}
{"id": null, "n": "1100004", "target": "#nkr_note_orig_1100004", "type": "orig", "text": "（佛說）＋善【元】【明】＊"}
