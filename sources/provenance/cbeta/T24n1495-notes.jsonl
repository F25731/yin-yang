{"id": null, "n": "1101008", "target": "#nkr_note_orig_1101008", "type": "orig", "text": "虫＝蟲【元】【明】下同"}
{"id": null, "n": "1101009", "target": "#nkr_note_orig_1101009", "type": "orig", "text": "至日＝日出【三】【宮】"}
{"id": null, "n": "1101010", "target": "#nkr_note_orig_1101010", "type": "orig", "text": "洗＝洒【宮】下同"}
