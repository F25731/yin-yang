{"id": null, "n": null, "target": null, "type": null, "text": "毘盧遮那佛以為部主"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿閦佛為部主"}
{"id": null, "n": null, "target": null, "type": null, "text": "寶生佛以為部主"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿彌陀佛以為部主"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空成就佛以為部主"}
{"id": null, "n": null, "target": null, "type": null, "text": "以二手和合金剛縛發生成印"}
{"id": null, "n": null, "target": null, "type": null, "text": "名本尊種子法身三摩地一切契經文義"}
{"id": null, "n": null, "target": null, "type": null, "text": "以二手金剛拳如執持器\n仗幖幟如身威儀形"}
{"id": null, "n": null, "target": null, "type": null, "text": "敬愛法"}
{"id": null, "n": null, "target": null, "type": null, "text": "鉤召"}
{"id": null, "n": null, "target": null, "type": null, "text": "降伏\n心殺害煩惱也"}
{"id": null, "n": null, "target": null, "type": null, "text": "除毒息怨敵也"}
{"id": null, "n": null, "target": null, "type": null, "text": "其形方名金輪"}
{"id": null, "n": null, "target": null, "type": null, "text": "其形圓名水輪"}
{"id": null, "n": null, "target": null, "type": null, "text": "其形三角"}
{"id": null, "n": null, "target": null, "type": null, "text": "其形如半月"}
{"id": null, "n": null, "target": null, "type": null, "text": "五佛頂等"}
{"id": null, "n": null, "target": null, "type": null, "text": "半音呼一"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "北"}
{"id": null, "n": null, "target": null, "type": null, "text": "東"}
{"id": null, "n": null, "target": null, "type": null, "text": "南"}
{"id": null, "n": null, "target": null, "type": null, "text": "西"}
{"id": null, "n": "0898010", "target": null, "type": "orig", "text": "〔肅國…寺〕二十五字－【明】【乙】【丙】"}
{"id": null, "n": "0898010", "target": null, "type": "mod", "text": "（肅國…寺）二十五字【大】，〔－〕【明】【乙】【丙】"}
{"id": null, "n": "0898011", "target": null, "type": "orig", "text": "（大廣智）＋不【三】【乙】【丙】"}
{"id": null, "n": "0898011", "target": null, "type": "mod", "text": "不【大】，大廣智不【宋】【元】【明】【乙】【丙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛部佛眼以為部母蓮花部白衣觀自在以為部母金剛部忙麼鷄菩薩以為部母"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛部無能勝菩薩以為明妃蓮花部多羅菩薩以為明妃金剛部金剛孫那利菩薩以為明妃"}
{"id": null, "n": null, "target": null, "type": null, "text": "不動尊佛部忿怒忿怒鉤蓮花部忿怒軍茶利金剛部忿怒"}
{"id": null, "n": null, "target": null, "type": null, "text": "金剛橛地界金剛牆八方界金剛網上方界密縫阿三莽儗儞界"}
{"id": null, "n": "0899041", "target": null, "type": "orig", "text": "〔金剛〕－【甲】"}
{"id": null, "n": "0899041", "target": null, "type": "mod", "text": "金剛【大】，〔－〕【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "金剛索護東方金剛幢幡護西方金剛迦利護南方金剛峯護北方"}
{"id": null, "n": "0898008", "target": "#nkr_note_mod_0898008", "type": "mod", "text": "（都部…卷）八字【大】，陀羅尼門諸部要目【宋】【元】【明】【甲】，陀羅尼門諸部要目一卷【乙】【丙】，【原】麗本，【甲】策子第二十帖，【乙】黃蘗版淨嚴等校訂加筆本塚本賢曉氏藏，【丙】大日本縮刷大藏經"}
{"id": null, "n": "0898009", "target": "#nkr_note_mod_0898009", "type": "mod", "text": "開府儀同王司特進試鴻臚卿肅國公食邑三千戶賜紫贈司空諡大鑒正號大廣智大興善寺三藏沙門不空奉詔譯【大】，〔－〕【甲】，大興善寺三藏沙門不空奉詔譯【宋】【元】，唐特進試鴻臚卿肅國公食邑三千戶賜紫贈司空諡大鑒正號大廣智大興善寺三藏沙門不空奉詔譯【明】【乙】【丙】"}
{"id": null, "n": "0898010", "target": "#nkr_note_mod_0898010", "type": "mod", "text": "（肅國…寺）二十五字【大】，〔－〕【明】【乙】【丙】"}
{"id": null, "n": "0898011", "target": "#nkr_note_mod_0898011", "type": "mod", "text": "不【大】，大廣智不【宋】【元】【明】【乙】【丙】"}
{"id": null, "n": "0898012", "target": "#nkr_note_mod_0898012", "type": "mod", "text": "為【大】＊，以為【宋】【元】【明】【甲】【乙】【丙】＊"}
{"id": null, "n": "0898013", "target": "#nkr_note_mod_0898013", "type": "mod", "text": "各【大】，各各【乙】【丙】"}
{"id": null, "n": "0898014", "target": "#nkr_note_mod_0898014", "type": "mod", "text": "切【大】，千【宋】【元】【明】【甲】【乙】【丙】"}
{"id": null, "n": "0898015", "target": "#nkr_note_mod_0898015", "type": "mod", "text": "天【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0898016", "target": "#nkr_note_mod_0898016", "type": "mod", "text": "妃【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0898018", "target": "#nkr_note_mod_0898018", "type": "mod", "text": "有【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0898019", "target": "#nkr_note_mod_0898019", "type": "mod", "text": "四天【大】＊，天四【甲】＊"}
{"id": null, "n": "0898020", "target": "#nkr_note_mod_0898020", "type": "mod", "text": "茶【大】下同，荼【宋】【元】【明】【甲】【乙】【丙】下同"}
{"id": null, "n": "0898021", "target": "#nkr_note_mod_0898021", "type": "mod", "text": "薩【大】，提【乙】【丙】"}
{"id": null, "n": "0898022", "target": "#nkr_note_mod_0898022", "type": "mod", "text": "（謂金…矣）三十二字【大】，〔－〕【宋】【元】【明】【甲】【乙】【丙】"}
{"id": null, "n": "0898023", "target": "#nkr_note_mod_0898023", "type": "mod", "text": "磨【大】，摩【甲】"}
{"id": null, "n": "0899001", "target": "#nkr_note_mod_0899001", "type": "mod", "text": "曼茶羅【大】，〔－〕【宋】【元】【明】【甲】【乙】【丙】"}
{"id": null, "n": "0899002", "target": "#nkr_note_mod_0899002", "type": "mod", "text": "印【大】，智印【乙】"}
{"id": null, "n": "0899003", "target": "#nkr_note_mod_0899003", "type": "mod", "text": "手【大】，〔－〕【宋】【元】【明】【甲】【乙】【丙】"}
{"id": null, "n": "0899004", "target": "#nkr_note_mod_0899004", "type": "mod", "text": "幖幟【大】＊，標熾【甲】＊"}
{"id": null, "n": "0899005", "target": "#nkr_note_mod_0899005", "type": "mod", "text": "眼【大】，眼法眼【宋】【元】【明】【乙】【丙】"}
{"id": null, "n": "0899006", "target": "#nkr_note_mod_0899006", "type": "mod", "text": "法【大】，〔－〕【宋】【元】【明】【乙】【丙】"}
{"id": null, "n": "0899007", "target": "#nkr_note_mod_0899007", "type": "mod", "text": "也【大】＊，〔－〕【宋】【元】【明】【甲】＊，【乙】"}
{"id": null, "n": "0899008", "target": "#nkr_note_mod_0899008", "type": "mod", "text": "悲【大】，〔－〕【宋】【元】【明】【甲】【乙】【丙】"}
{"id": null, "n": "0899009", "target": "#nkr_note_mod_0899009", "type": "mod", "text": "怨【大】，冤【甲】【乙】"}
{"id": null, "n": "0899010", "target": "#nkr_note_mod_0899010", "type": "mod", "text": "敵【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0899011", "target": "#nkr_note_mod_0899011", "type": "mod", "text": "爐【大】，壚【甲】"}
{"id": null, "n": "0899012", "target": "#nkr_note_mod_0899012", "type": "mod", "text": "於【大】，〔－〕【宋】【元】【明】【甲】【乙】【丙】"}
{"id": null, "n": "0899013", "target": "#nkr_note_mod_0899013", "type": "mod", "text": "契【大】，執【宋】【元】【明】【甲】"}
{"id": null, "n": "0899014", "target": "#nkr_note_mod_0899014", "type": "mod", "text": "辦【大】，辨【宋】"}
{"id": null, "n": "0899015", "target": "#nkr_note_mod_0899015", "type": "mod", "text": "文繁【大】，繁文【宋】【元】【明】【甲】【乙】【丙】"}
{"id": null, "n": "0899016", "target": "#nkr_note_mod_0899016", "type": "mod", "text": "及【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0899017", "target": "#nkr_note_mod_0899017", "type": "mod", "text": "本【大】，〔－〕【宋】【元】【明】【乙】【丙】"}
{"id": null, "n": "0899018", "target": "#nkr_note_mod_0899018", "type": "mod", "text": "便【大】，便以【乙】【丙】"}
{"id": null, "n": "0899019", "target": "#nkr_note_mod_0899019", "type": "mod", "text": "二諦【大】，〔－〕【宋】【元】【明】【甲】【乙】【丙】"}
{"id": null, "n": "0899020", "target": "#nkr_note_mod_0899020", "type": "mod", "text": "稱【大】，絣【宋】【元】【明】【乙】【丙】，抨【甲】"}
{"id": null, "n": "0899021", "target": "#nkr_note_mod_0899021", "type": "mod", "text": "為【大】，作【乙】【丙】"}
{"id": null, "n": "0899022", "target": "#nkr_note_mod_0899022", "type": "mod", "text": "青【大】，青色【元】【明】"}
{"id": null, "n": "0899023", "target": "#nkr_note_mod_0899023", "type": "mod", "text": "黑【大】，黑色【元】【明】"}
{"id": null, "n": "0899024", "target": "#nkr_note_mod_0899024", "type": "mod", "text": "一者【大】，〔－〕【宋】【元】【明】【甲】【乙】【丙】"}
{"id": null, "n": "0899025", "target": "#nkr_note_mod_0899025", "type": "mod", "text": "二者【大】，〔－〕【宋】【元】【明】【甲】【乙】【丙】"}
{"id": null, "n": "0899026", "target": "#nkr_note_mod_0899026", "type": "mod", "text": "三者【大】，〔－〕【宋】【元】【明】【甲】【乙】【丙】"}
{"id": null, "n": "0899027", "target": "#nkr_note_mod_0899027", "type": "mod", "text": "若【大】＊，〔－〕【宋】【元】【明】【甲】【乙】【丙】＊"}
{"id": null, "n": "0899028", "target": "#nkr_note_mod_0899028", "type": "mod", "text": "法謂【大】，〔－〕【宋】【元】【明】【甲】【乙】【丙】"}
{"id": null, "n": "0899029", "target": "#nkr_note_mod_0899029", "type": "mod", "text": "為二也【大】，〔－〕【宋】【元】【明】【甲】【乙】【丙】"}
{"id": null, "n": "0899030", "target": "#nkr_note_mod_0899030", "type": "mod", "text": "各【大】，〔－〕【甲】"}
{"id": null, "n": "0899031", "target": "#nkr_note_mod_0899031", "type": "mod", "text": "爾【大】，羅【宋】【元】【明】"}
{"id": null, "n": "0899032", "target": "#nkr_note_mod_0899032", "type": "mod", "text": "一【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0899033", "target": "#nkr_note_mod_0899033", "type": "mod", "text": "力【大】，力迦【乙】【丙】"}
{"id": null, "n": "0899034", "target": "#nkr_note_mod_0899034", "type": "mod", "text": "叨【大】，力【宋】【元】【明】，力迦【乙】【丙】"}
{"id": null, "n": "0899035", "target": "#nkr_note_mod_0899035", "type": "mod", "text": "二合【大】，〔－〕【宋】【元】【明】【甲】【乙】【丙】"}
{"id": null, "n": "0899036", "target": "#nkr_note_mod_0899036", "type": "mod", "text": "佛部佛眼以為部母蓮花部白衣觀自在以為部母金剛部忙麼鷄菩薩以為部母【大】，佛部佛眼以為部母蓮花部白衣觀自在以為部母金剛部忙麼鷄菩薩以為部母【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛部佛眼以為部母蓮花部白衣觀自在以為部母金剛部忙麼鷄菩薩以為部母"}
{"id": null, "n": "0899037", "target": "#nkr_note_mod_0899037", "type": "mod", "text": "佛部無能勝菩薩以為明妃蓮花部多羅菩薩以為明妃金剛部金剛孫那利菩薩以為明妃【大】，佛部無能勝菩薩以為明妃蓮花部多羅菩薩以為明妃金剛部金剛孫那利菩薩以為明妃【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛部無能勝菩薩以為明妃蓮花部多羅菩薩以為明妃金剛部金剛孫那利菩薩以為明妃"}
{"id": null, "n": "0899038", "target": "#nkr_note_mod_0899038", "type": "mod", "text": "不動尊佛部忿怒忿怒鉤蓮花部忿怒軍茶利金剛部忿怒【大】，不動尊佛部忿怒忿怒鉤蓮花部忿怒軍茶利金剛部忿怒【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "不動尊佛部忿怒忿怒鉤蓮花部忿怒軍茶利金剛部忿怒"}
{"id": null, "n": "0899039", "target": "#nkr_note_mod_0899039", "type": "mod", "text": "金剛橛地界金剛牆八方界金剛網上方界密縫阿三莽儗儞界【大】，金剛橛地界金剛牆八方界金剛網上方界密縫阿三莽儗儞界【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "金剛橛地界金剛牆八方界金剛網上方界密縫阿三莽儗儞界"}
{"id": null, "n": "0899040", "target": "#nkr_note_mod_0899040", "type": "mod", "text": "金剛索護東方金剛幢幡護西方金剛迦利護南方金剛峯護北方【大】，金剛索護東方金剛幢幡護西方金剛迦利護南方金剛峯護北方【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "金剛索護東方金剛幢幡護西方金剛迦利護南方金剛峯護北方"}
{"id": null, "n": "0899041", "target": "#nkr_note_mod_0899041", "type": "mod", "text": "金剛【大】，〔－〕【甲】"}
{"id": null, "n": "0899042", "target": "#nkr_note_mod_0899042", "type": "mod", "text": "護【大】，〔－〕【考偽-乙】"}
{"id": null, "n": "0899043", "target": "#nkr_note_mod_0899043", "type": "mod", "text": "依【大】，〔－〕【甲】"}
{"id": null, "n": "0899044", "target": "#nkr_note_mod_0899044", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】【甲】【乙】【丙】"}
{"id": null, "n": "0899045", "target": "#nkr_note_mod_0899045", "type": "mod", "text": "者【大】＊，〔－〕【甲】＊"}
{"id": null, "n": "0899046", "target": "#nkr_note_mod_0899046", "type": "mod", "text": "廣如【大】，如廣【甲】"}
{"id": null, "n": "0899047", "target": "#nkr_note_mod_0899047", "type": "mod", "text": "浴【大】，洗【宋】【元】【明】【甲】"}
{"id": null, "n": "0899048", "target": "#nkr_note_mod_0899048", "type": "mod", "text": "換【大】，浣【宋】【元】【明】【甲】"}
{"id": null, "n": "0899049", "target": "#nkr_note_mod_0899049", "type": "mod", "text": "從【大】，〔－〕【宋】【元】【明】【甲】【乙】【丙】"}
{"id": null, "n": "0899050", "target": "#nkr_note_mod_0899050", "type": "mod", "text": "𪌘【大】，󳘌【宋】【元】【甲】，𪌜【明】，蕤【乙】【丙】"}
{"id": null, "n": "0899051", "target": "#nkr_note_mod_0899051", "type": "mod", "text": "耶【大】，邪【宋】【元】【明】【乙】"}
{"id": null, "n": "0899052", "target": "#nkr_note_mod_0899052", "type": "mod", "text": "說【大】＊，〔－〕【宋】【元】【明】【甲】【乙】【丙】＊"}
{"id": null, "n": "0899053", "target": "#nkr_note_mod_0899053", "type": "mod", "text": "又【大】，及【宋】【元】【明】【甲】【乙】【丙】"}
{"id": null, "n": "0899054", "target": "#nkr_note_mod_0899054", "type": "mod", "text": "辦【大】，辯【宋】【元】【明】【甲】【乙】【丙】"}
