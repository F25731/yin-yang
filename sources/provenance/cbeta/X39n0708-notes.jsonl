{"id": null, "n": "0275001", "target": "#nkr_note_orig_0275001", "type": "orig", "text": "目題新作"}
{"id": null, "n": "0286001", "target": "#nkr_note_orig_0286001", "type": "orig", "text": "丘下一有言字"}
{"id": null, "n": "0298001", "target": "#nkr_note_orig_0298001", "type": "orig", "text": "陸疑脚（陸ハ本文ニ陛トツクル。󴦒）"}
