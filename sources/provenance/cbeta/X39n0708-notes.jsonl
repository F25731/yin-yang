{"id": null, "n": "0309001", "target": "#nkr_note_orig_0309001", "type": "orig", "text": "經下一有中字"}
{"id": null, "n": "0316001", "target": "#nkr_note_orig_0316001", "type": "orig", "text": "覓罪一作語次同"}
