{"id": null, "n": "0696002", "target": null, "type": "orig", "text": "那＝羅【聖】"}
{"id": null, "n": "0696002", "target": null, "type": "mod", "text": "那【大】，羅【聖】"}
{"id": null, "n": "0694002", "target": "#nkr_note_mod_0694002", "type": "mod", "text": "失譯人名附東晉錄【大】，〔－〕【聖】"}
{"id": null, "n": "0694003", "target": "#nkr_note_mod_0694003", "type": "mod", "text": "避【大】＊，僻【聖】＊"}
{"id": null, "n": "0694004", "target": "#nkr_note_mod_0694004", "type": "mod", "text": "藂【大】＊，叢【聖】＊"}
{"id": null, "n": "0694005", "target": "#nkr_note_mod_0694005", "type": "mod", "text": "㧌撈【大】＊，枆橯【聖】＊"}
{"id": null, "n": "0694006", "target": "#nkr_note_mod_0694006", "type": "mod", "text": "仿【大】，防【聖】"}
{"id": null, "n": "0694008", "target": "#nkr_note_mod_0694008", "type": "mod", "text": "阿羅漢道【大】，～Arahattamagga."}
{"id": null, "n": "0694011", "target": "#nkr_note_mod_0694011", "type": "mod", "text": "共【大】，〔－〕【聖】"}
{"id": null, "n": "0694012", "target": "#nkr_note_mod_0694012", "type": "mod", "text": "披【大】＊，被【聖】＊"}
{"id": null, "n": "0694013", "target": "#nkr_note_mod_0694013", "type": "mod", "text": "令【CB】【麗-CB】【聖】，今【大】"}
{"id": null, "n": "0694015", "target": "#nkr_note_mod_0694015", "type": "mod", "text": "象【大】，～Nāga."}
{"id": null, "n": "0694017", "target": "#nkr_note_mod_0694017", "type": "mod", "text": "日【大】，日日【聖】"}
{"id": null, "n": "0694018", "target": "#nkr_note_mod_0694018", "type": "mod", "text": "戰【大】＊，鄲【聖】＊"}
{"id": null, "n": "0694019", "target": "#nkr_note_mod_0694019", "type": "mod", "text": "心【大】，〔－〕【聖】"}
{"id": null, "n": "0694020", "target": "#nkr_note_mod_0694020", "type": "mod", "text": "揚【大】＊，餳【聖】＊"}
{"id": null, "n": "0694021", "target": "#nkr_note_mod_0694021", "type": "mod", "text": "米【大】，〔－〕【聖】"}
{"id": null, "n": "0694022", "target": "#nkr_note_mod_0694022", "type": "mod", "text": "止【大】＊，上【聖】＊"}
{"id": null, "n": "0694023", "target": "#nkr_note_mod_0694023", "type": "mod", "text": "那【大】，曰那【聖】"}
{"id": null, "n": "0694024", "target": "#nkr_note_mod_0694024", "type": "mod", "text": "且【大】，主【聖】"}
{"id": null, "n": "0695001", "target": "#nkr_note_mod_0695001", "type": "mod", "text": "所【大】，〔－〕【聖】"}
{"id": null, "n": "0695002", "target": "#nkr_note_mod_0695002", "type": "mod", "text": "惱【大】，憂【聖】"}
{"id": null, "n": "0695003", "target": "#nkr_note_mod_0695003", "type": "mod", "text": "須陀洹道【大】，～Sotāpattimagga."}
{"id": null, "n": "0695004", "target": "#nkr_note_mod_0695004", "type": "mod", "text": "波【大】，婆【聖】"}
{"id": null, "n": "0695005", "target": "#nkr_note_mod_0695005", "type": "mod", "text": "政【大】，正【聖】"}
{"id": null, "n": "0695006", "target": "#nkr_note_mod_0695006", "type": "mod", "text": "山【大】，出【聖】"}
{"id": null, "n": "0695007", "target": "#nkr_note_mod_0695007", "type": "mod", "text": "斯陀含道【大】，～Sakadāgāmimagga."}
{"id": null, "n": "0695008", "target": "#nkr_note_mod_0695008", "type": "mod", "text": "阿那含道【大】，～Anāgamimagga."}
{"id": null, "n": "0695009", "target": "#nkr_note_mod_0695009", "type": "mod", "text": "忉利天【大】，～Tāvatiṃsabhavana."}
{"id": null, "n": "0695010", "target": "#nkr_note_mod_0695010", "type": "mod", "text": "舍【大】，含【聖】，～Sāgala."}
{"id": null, "n": "0695011", "target": "#nkr_note_mod_0695011", "type": "mod", "text": "臣【大】，秦【聖】"}
{"id": null, "n": "0695012", "target": "#nkr_note_mod_0695012", "type": "mod", "text": "沾彌利【大】，～Devamantiya."}
{"id": null, "n": "0695013", "target": "#nkr_note_mod_0695013", "type": "mod", "text": "望群【大】，～Maṅkura."}
{"id": null, "n": "0695014", "target": "#nkr_note_mod_0695014", "type": "mod", "text": "野惒羅【大】，～Āyupāla."}
{"id": null, "n": "0695015", "target": "#nkr_note_mod_0695015", "type": "mod", "text": "伎【大】，騎【聖】"}
{"id": null, "n": "0695016", "target": "#nkr_note_mod_0695016", "type": "mod", "text": "卿【大】，〔－〕【聖】"}
{"id": null, "n": "0695017", "target": "#nkr_note_mod_0695017", "type": "mod", "text": "捐【大】，損【聖】"}
{"id": null, "n": "0695018", "target": "#nkr_note_mod_0695018", "type": "mod", "text": "巧【大】，工【聖】"}
{"id": null, "n": "0695019", "target": "#nkr_note_mod_0695019", "type": "mod", "text": "弟子【大】，苐子【聖】"}
{"id": null, "n": "0695020", "target": "#nkr_note_mod_0695020", "type": "mod", "text": "以【大】，已【聖】"}
{"id": null, "n": "0695021", "target": "#nkr_note_mod_0695021", "type": "mod", "text": "白【大】，〔－〕【聖】"}
{"id": null, "n": "0696001", "target": "#nkr_note_mod_0696001", "type": "mod", "text": "首那先【大】，～Sūrasena."}
{"id": null, "n": "0696002", "target": "#nkr_note_mod_0696002", "type": "mod", "text": "那【大】，羅【聖】"}
{"id": null, "n": "0696003", "target": "#nkr_note_mod_0696003", "type": "mod", "text": "維迦先【大】，～Vīrasena."}
{"id": null, "n": "0696004", "target": "#nkr_note_mod_0696004", "type": "mod", "text": "耳【大】，取【聖】"}
{"id": null, "n": "0696005", "target": "#nkr_note_mod_0696005", "type": "mod", "text": "顏【大】，𮨛【聖】"}
{"id": null, "n": "0696006", "target": "#nkr_note_mod_0696006", "type": "mod", "text": "肺【大】，脯【聖】"}
{"id": null, "n": "0696007", "target": "#nkr_note_mod_0696007", "type": "mod", "text": "為那先耶不為那先【大】，〔－〕【聖】"}
{"id": null, "n": "0696008", "target": "#nkr_note_mod_0696008", "type": "mod", "text": "言【大】，〔－〕【聖】"}
{"id": null, "n": "0696009", "target": "#nkr_note_mod_0696009", "type": "mod", "text": "五【大】，〔－〕【聖】"}
{"id": null, "n": "0696010", "target": "#nkr_note_mod_0696010", "type": "mod", "text": "言【大】，那先言【聖】"}
{"id": null, "n": "0696011", "target": "#nkr_note_mod_0696011", "type": "mod", "text": "車【大】，～Ratta."}
{"id": null, "n": "0696012", "target": "#nkr_note_mod_0696012", "type": "mod", "text": "轂【大】，輻【聖】"}
{"id": null, "n": "0696013", "target": "#nkr_note_mod_0696013", "type": "mod", "text": "王言轂【大】，〔－〕【聖】"}
{"id": null, "n": "0696014", "target": "#nkr_note_mod_0696014", "type": "mod", "text": "輻【大】，輞【聖】"}
{"id": null, "n": "0696015", "target": "#nkr_note_mod_0696015", "type": "mod", "text": "輞【大】，䡰【聖】"}
{"id": null, "n": "0696016", "target": "#nkr_note_mod_0696016", "type": "mod", "text": "輿【大】，與【聖】"}
{"id": null, "n": "0696017", "target": "#nkr_note_mod_0696017", "type": "mod", "text": "顏【大】，𮖗【聖】"}
{"id": null, "n": "0696018", "target": "#nkr_note_mod_0696018", "type": "mod", "text": "智者問【大】，～Paṇḍitavāda."}
{"id": null, "n": "0696019", "target": "#nkr_note_mod_0696019", "type": "mod", "text": "王者問【大】，～Rājavāda."}
{"id": null, "n": "0696020", "target": "#nkr_note_mod_0696020", "type": "mod", "text": "恣【大】，次【聖】"}
{"id": null, "n": "0696021", "target": "#nkr_note_mod_0696021", "type": "mod", "text": "悷【大】，戾【聖】"}
{"id": null, "n": "0696022", "target": "#nkr_note_mod_0696022", "type": "mod", "text": "諸【大】，語【聖】"}
{"id": null, "n": "0696023", "target": "#nkr_note_mod_0696023", "type": "mod", "text": "冥【大】，冝【聖】"}
{"id": null, "n": "0696024", "target": "#nkr_note_mod_0696024", "type": "mod", "text": "王【大】，至【聖】"}
{"id": null, "n": "0696025", "target": "#nkr_note_mod_0696025", "type": "mod", "text": "吹笳【大】，〔－〕【聖】"}
{"id": null, "n": "0696026", "target": "#nkr_note_mod_0696026", "type": "mod", "text": "火【大】，大【聖】"}
{"id": null, "n": "0696027", "target": "#nkr_note_mod_0696027", "type": "mod", "text": "猶【大】，獨【聖】"}
{"id": null, "n": "0696028", "target": "#nkr_note_mod_0696028", "type": "mod", "text": "有【大】，〔－〕【聖】"}
{"id": null, "n": "0696029", "target": "#nkr_note_mod_0696029", "type": "mod", "text": "疊【大】，㲲【聖】"}
{"id": null, "n": "0696030", "target": "#nkr_note_mod_0696030", "type": "mod", "text": "緉【大】，量【聖】"}
{"id": null, "n": "0696031", "target": "#nkr_note_mod_0696031", "type": "mod", "text": "屣【大】，履【聖】"}
{"id": null, "n": "0697001", "target": "#nkr_note_mod_0697001", "type": "mod", "text": "最為善者【大】，～Paramattha."}
{"id": null, "n": "0697002", "target": "#nkr_note_mod_0697002", "type": "mod", "text": "作沙門【大】，～Pabbajjā."}
{"id": null, "n": "0697003", "target": "#nkr_note_mod_0697003", "type": "mod", "text": "欲棄世間…苦惱【大】，～Idaṃ dukkhaṃ nirujjheyya aññañ ca dukkhaṃ nauppajjayya."}
{"id": null, "n": "0697004", "target": "#nkr_note_mod_0697004", "type": "mod", "text": "債【大】，責【聖】"}
{"id": null, "n": "0697005", "target": "#nkr_note_mod_0697005", "type": "mod", "text": "復生【大】，～Paṭisandahati."}
{"id": null, "n": "0697006", "target": "#nkr_note_mod_0697006", "type": "mod", "text": "智慧【大】，～Paññā."}
{"id": null, "n": "0697007", "target": "#nkr_note_mod_0697007", "type": "mod", "text": "善事【大】，～Kusaladhamma."}
{"id": null, "n": "0697008", "target": "#nkr_note_mod_0697008", "type": "mod", "text": "孝【大】，有【聖】"}
{"id": null, "n": "0697009", "target": "#nkr_note_mod_0697009", "type": "mod", "text": "信有【大】，〔－〕【聖】"}
