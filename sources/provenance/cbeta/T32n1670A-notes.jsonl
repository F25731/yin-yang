{"id": null, "n": "0697021", "target": "#nkr_note_orig_0697021", "type": "orig", "text": "𢴲＝繫【聖】"}
{"id": null, "n": "0697022", "target": "#nkr_note_orig_0697022", "type": "orig", "text": "正＝政【聖】"}
{"id": null, "n": "0697023", "target": "#nkr_note_orig_0697023", "type": "orig", "text": "謂＝說【聖】"}
{"id": null, "n": "0698001", "target": "#nkr_note_orig_0698001", "type": "orig", "text": "〔不〕－【聖】"}
{"id": null, "n": "0698002", "target": "#nkr_note_orig_0698002", "type": "orig", "text": "（知有不利王者王）＋所【聖】"}
{"id": null, "n": "0698003", "target": "#nkr_note_orig_0698003", "type": "orig", "text": "敬＋（者）【聖】"}
{"id": null, "n": "0698004", "target": "#nkr_note_orig_0698004", "type": "orig", "text": "（之）＋人【聖】"}
{"id": null, "n": "0698005", "target": "#nkr_note_orig_0698005", "type": "orig", "text": "（之）＋意【聖】"}
{"id": null, "n": "0698006", "target": "#nkr_note_orig_0698006", "type": "orig", "text": "象兵 Hatthī, 馬兵 Assā, 車兵 Rathā, 步兵 Pattī."}
{"id": null, "n": "0698007", "target": "#nkr_note_orig_0698007", "type": "orig", "text": "續＝經【聖】"}
{"id": null, "n": "0698008", "target": "#nkr_note_orig_0698008", "type": "orig", "text": "〔人〕－【聖】"}
{"id": null, "n": "0698009", "target": "#nkr_note_orig_0698009", "type": "orig", "text": "〔神〕－【聖】"}
{"id": null, "n": "0698010", "target": "#nkr_note_orig_0698010", "type": "orig", "text": "（作蘇）＋取【聖】"}
{"id": null, "n": "0698011", "target": "#nkr_note_orig_0698011", "type": "orig", "text": "𦘺＝𦚣【聖】＊"}
{"id": null, "n": "0698012", "target": "#nkr_note_orig_0698012", "type": "orig", "text": "（醍醐）＋與【聖】"}
{"id": null, "n": "0698013", "target": "#nkr_note_orig_0698013", "type": "orig", "text": "酥＝蘇【聖】"}
{"id": null, "n": "0698014", "target": "#nkr_note_orig_0698014", "type": "orig", "text": "人＋（語）【聖】"}
{"id": null, "n": "0698015", "target": "#nkr_note_orig_0698015", "type": "orig", "text": "生＋（生）【聖】"}
{"id": null, "n": "0698016", "target": "#nkr_note_orig_0698016", "type": "orig", "text": "〔簟〕－【聖】"}
{"id": null, "n": "0698017", "target": "#nkr_note_orig_0698017", "type": "orig", "text": "〔善哉〕－【聖】"}
{"id": null, "n": "0698018", "target": "#nkr_note_orig_0698018", "type": "orig", "text": "面＋（耳）【聖】"}
{"id": null, "n": "0698019", "target": "#nkr_note_orig_0698019", "type": "orig", "text": "目＋（自）【聖】"}
{"id": null, "n": "0698020", "target": "#nkr_note_orig_0698020", "type": "orig", "text": "長命者 Dīghāyuka."}
{"id": null, "n": "0698021", "target": "#nkr_note_orig_0698021", "type": "orig", "text": "短命者 Appāyuka."}
{"id": null, "n": "0698022", "target": "#nkr_note_orig_0698022", "type": "orig", "text": "多病者 Bavhābādha."}
{"id": null, "n": "0698023", "target": "#nkr_note_orig_0698023", "type": "orig", "text": "少病者 Appābādha."}
{"id": null, "n": "0698024", "target": "#nkr_note_orig_0698024", "type": "orig", "text": "貧者 Appabhoga."}
{"id": null, "n": "0698025", "target": "#nkr_note_orig_0698025", "type": "orig", "text": "富者 Mahābhoga.（有）＋富【聖】"}
{"id": null, "n": "0698026", "target": "#nkr_note_orig_0698026", "type": "orig", "text": "長者 Mahākulīna."}
{"id": null, "n": "0698027", "target": "#nkr_note_orig_0698027", "type": "orig", "text": "卑者 Nīcakulīna."}
{"id": null, "n": "0698028", "target": "#nkr_note_orig_0698028", "type": "orig", "text": "端正者 Vaṇṇavant."}
{"id": null, "n": "0698029", "target": "#nkr_note_orig_0698029", "type": "orig", "text": "醜惡者 Dubbaṇṇa."}
{"id": null, "n": "0698030", "target": "#nkr_note_orig_0698030", "type": "orig", "text": "（有）＋為【聖】"}
{"id": null, "n": "0698031", "target": "#nkr_note_orig_0698031", "type": "orig", "text": "明者 Paññāvant."}
{"id": null, "n": "0698032", "target": "#nkr_note_orig_0698032", "type": "orig", "text": "闍者 Duppañña."}
{"id": null, "n": "0699001", "target": "#nkr_note_orig_0699001", "type": "orig", "text": "世間火 Pākatika-aggi."}
{"id": null, "n": "0699002", "target": "#nkr_note_orig_0699002", "type": "orig", "text": "泥犁火 Nerayika-aggi."}
{"id": null, "n": "0699003", "target": "#nkr_note_orig_0699003", "type": "orig", "text": "地 Pathavī."}
{"id": null, "n": "0699004", "target": "#nkr_note_orig_0699004", "type": "orig", "text": "水 Udaka."}
{"id": null, "n": "0699005", "target": "#nkr_note_orig_0699005", "type": "orig", "text": "風 Vāta."}
{"id": null, "n": "0699006", "target": "#nkr_note_orig_0699006", "type": "orig", "text": "空 Ākāsa."}
{"id": null, "n": "0699007", "target": "#nkr_note_orig_0699007", "type": "orig", "text": "生老死 Jāti-jarā-marana."}
{"id": null, "n": "0699008", "target": "#nkr_note_orig_0699008", "type": "orig", "text": "憂 Soka."}
{"id": null, "n": "0699009", "target": "#nkr_note_orig_0699009", "type": "orig", "text": "哭 Parideva."}
{"id": null, "n": "0699010", "target": "#nkr_note_orig_0699010", "type": "orig", "text": "痛 Domanassa."}
{"id": null, "n": "0699011", "target": "#nkr_note_orig_0699011", "type": "orig", "text": "無有勝佛者 Buddho anuttaro."}
{"id": null, "n": "0699012", "target": "#nkr_note_orig_0699012", "type": "orig", "text": "恒 Gaṅgā."}
{"id": null, "n": "0699013", "target": "#nkr_note_orig_0699013", "type": "orig", "text": "質 Tissa."}
{"id": null, "n": "0700001", "target": "#nkr_note_orig_0700001", "type": "orig", "text": "智 Vedagū."}
{"id": null, "n": "0700002", "target": "#nkr_note_orig_0700002", "type": "orig", "text": "身 Kāya."}
{"id": null, "n": "0700003", "target": "#nkr_note_orig_0700003", "type": "orig", "text": "九孔 Navadvāra."}
{"id": null, "n": "0700004", "target": "#nkr_note_orig_0700004", "type": "orig", "text": "三十二相 Dvattiṃsa-mahāpurisalakkhaṇa."}
{"id": null, "n": "0700005", "target": "#nkr_note_orig_0700005", "type": "orig", "text": "八十種好 Asīti-anubyañjana."}
{"id": null, "n": "0700006", "target": "#nkr_note_orig_0700006", "type": "orig", "text": "蓮花 Paduma."}
{"id": null, "n": "0700007", "target": "#nkr_note_orig_0700007", "type": "orig", "text": "梵所行 Brahmacārin."}
{"id": null, "n": "0700008", "target": "#nkr_note_orig_0700008", "type": "orig", "text": "奉行 Upasampadā."}
{"id": null, "n": "0701001", "target": "#nkr_note_orig_0701001", "type": "orig", "text": "念 Sati."}
{"id": null, "n": "0701002", "target": "#nkr_note_orig_0701002", "type": "orig", "text": "久遠所作 Abhijāna."}
{"id": null, "n": "0701003", "target": "#nkr_note_orig_0701003", "type": "orig", "text": "新有所學 Kaṭumikā."}
{"id": null, "n": "0701004", "target": "#nkr_note_orig_0701004", "type": "orig", "text": "若有大事 Oḷārikaviññāṇa."}
{"id": null, "n": "0701005", "target": "#nkr_note_orig_0701005", "type": "orig", "text": "思善 Hitaviññāṇa."}
{"id": null, "n": "0701006", "target": "#nkr_note_orig_0701006", "type": "orig", "text": "曾所更苦 Ahitaviññāṇa."}
{"id": null, "n": "0701007", "target": "#nkr_note_orig_0701007", "type": "orig", "text": "自思惟 Sabhāganimitta."}
{"id": null, "n": "0701008", "target": "#nkr_note_orig_0701008", "type": "orig", "text": "曾雜所作 Visabhāganimitta."}
{"id": null, "n": "0701009", "target": "#nkr_note_orig_0701009", "type": "orig", "text": "教人 Kathābhiññāṇa."}
{"id": null, "n": "0701010", "target": "#nkr_note_orig_0701010", "type": "orig", "text": "象 Lakkhaṇa."}
{"id": null, "n": "0701011", "target": "#nkr_note_orig_0701011", "type": "orig", "text": "曾有所忘 Saraṇa."}
{"id": null, "n": "0701012", "target": "#nkr_note_orig_0701012", "type": "orig", "text": "因識 Muddā."}
{"id": null, "n": "0701013", "target": "#nkr_note_orig_0701013", "type": "orig", "text": "教計 Ganaṇā."}
{"id": null, "n": "0701014", "target": "#nkr_note_orig_0701014", "type": "orig", "text": "負債 Dhāraṇa."}
{"id": null, "n": "0701015", "target": "#nkr_note_orig_0701015", "type": "orig", "text": "一心 Bhāvanā."}
{"id": null, "n": "0701016", "target": "#nkr_note_orig_0701016", "type": "orig", "text": "讀書 Potthakanibandhana."}
{"id": null, "n": "0701017", "target": "#nkr_note_orig_0701017", "type": "orig", "text": "曾有所寄更見 Upanikkhepa."}
{"id": null, "n": "0701018", "target": "#nkr_note_orig_0701018", "type": "orig", "text": "Ānanda."}
{"id": null, "n": "0701019", "target": "#nkr_note_orig_0701019", "type": "orig", "text": "Upāsikā."}
{"id": null, "n": "0701020", "target": "#nkr_note_orig_0701020", "type": "orig", "text": "Khujjuttarā."}
{"id": null, "n": "0702001", "target": "#nkr_note_orig_0702001", "type": "orig", "text": "過去苦～Atīta-dukkha."}
{"id": null, "n": "0702002", "target": "#nkr_note_orig_0702002", "type": "orig", "text": "現在苦～Paccupanna-dukkha."}
{"id": null, "n": "0702003", "target": "#nkr_note_orig_0702003", "type": "orig", "text": "當來苦～Anāgata-dukkha."}
{"id": null, "n": "0702004", "target": "#nkr_note_orig_0702004", "type": "orig", "text": "～Alasanda."}
{"id": null, "n": "0702005", "target": "#nkr_note_orig_0702005", "type": "orig", "text": "～Yojana."}
{"id": null, "n": "0702006", "target": "#nkr_note_orig_0702006", "type": "orig", "text": "罽賓～Kasmīra."}
{"id": null, "n": "0702007", "target": "#nkr_note_orig_0702007", "type": "orig", "text": "劫～Kappa."}
{"id": null, "n": "0702008", "target": "#nkr_note_orig_0702008", "type": "orig", "text": "智者～Jānanta."}
{"id": null, "n": "0702009", "target": "#nkr_note_orig_0702009", "type": "orig", "text": "愚人～Ajānanta."}
{"id": null, "n": "0702014", "target": "#nkr_note_orig_0702014", "type": "orig", "text": "梵天上～Brahmaloka."}
{"id": null, "n": "0702015", "target": "#nkr_note_orig_0702015", "type": "orig", "text": "～Uttarakuru."}
{"id": null, "n": "0703001", "target": "#nkr_note_orig_0703001", "type": "orig", "text": "～Vṭthika."}
{"id": null, "n": "0696b2201", "target": "#nkr_note_add_0696b2201", "type": "add", "text": "彌【CB】【麗-CB】，禰【大】"}
{"id": null, "n": "0697a0301", "target": "#nkr_note_add_0697a0301", "type": "add", "text": "王【CB】【麗-CB】，五【大】"}
{"id": null, "n": "0699a2401", "target": "#nkr_note_add_0699a2401", "type": "add", "text": "王【CB】【麗-CB】，士【大】"}
{"id": null, "n": "0700b1501", "target": "#nkr_note_add_0700b1501", "type": "add", "text": "愛【CB】【麗-CB】，受【大】"}
{"id": null, "n": "0700c1701", "target": "#nkr_note_add_0700c1701", "type": "add", "text": "假【CB】【麗-CB】，瑕【大】"}
{"id": null, "n": "0701a2201", "target": "#nkr_note_add_0701a2201", "type": "add", "text": "耶【CB】【麗-CB】，那【大】"}
{"id": null, "n": "0701b1601", "target": "#nkr_note_add_0701b1601", "type": "add", "text": "捶【CB】【麗-CB】，埵【大】"}
{"id": null, "n": "0701c1301", "target": "#nkr_note_add_0701c1301", "type": "add", "text": "耶【CB】【麗-CB】，那【大】"}
{"id": null, "n": "0701c2301", "target": "#nkr_note_add_0701c2301", "type": "add", "text": "歲【CB】【麗-CB】，藏【大】"}
{"id": null, "n": "0702a1201", "target": "#nkr_note_add_0702a1201", "type": "add", "text": "田【CB】【麗-CB】，由【大】"}
{"id": null, "n": "0702b0501", "target": "#nkr_note_add_0702b0501", "type": "add", "text": "那【CB】【麗-CB】，耶【大】"}
{"id": null, "n": "0702c0201", "target": "#nkr_note_add_0702c0201", "type": "add", "text": "輕【CB】【麗-CB】，［－］【大】"}
{"id": null, "n": "0702c0601", "target": "#nkr_note_add_0702c0601", "type": "add", "text": "［－］【CB】【麗-CB】，不制其身口者不能持經【大】（CBETA 按：修訂錯簡；原書位於 T32n1670Ap0702c06～c25「制其……得人者」移至 T32n1670Ap0703a16。）"}
{"id": null, "n": "0702c0701", "target": "#nkr_note_add_0702c0701", "type": "add", "text": "［－］【CB】【麗-CB】，戒如此曹人亦不樂其身那先言其學道人【大】"}
{"id": null, "n": "0702c0801", "target": "#nkr_note_add_0702c0801", "type": "add", "text": "［－］【CB】【麗-CB】，者能制其身能制口能持經戒能一其心得【大】"}
{"id": null, "n": "0702c0901", "target": "#nkr_note_add_0702c0901", "type": "add", "text": "［－］【CB】【麗-CB】，四禪便能不復喘息耳王言善哉善哉【大】"}
{"id": null, "n": "0702c1001", "target": "#nkr_note_add_0702c1001", "type": "add", "text": "［－］【CB】【麗-CB】，王復問那先為呼言海海為是水名為海【大】"}
{"id": null, "n": "0702c1101", "target": "#nkr_note_add_0702c1101", "type": "add", "text": "［－］【CB】【麗-CB】，耶用他事故言海那先言人所以呼為海者【大】"}
{"id": null, "n": "0702c1201", "target": "#nkr_note_add_0702c1201", "type": "add", "text": "［－］【CB】【麗-CB】，水與鹽參各半是故為海耳王復問那先何【大】"}
{"id": null, "n": "0702c1301", "target": "#nkr_note_add_0702c1301", "type": "add", "text": "［－］【CB】【麗-CB】，以故海悉醎如鹽味那先言所以海水醎者【大】"}
{"id": null, "n": "0702c1401", "target": "#nkr_note_add_0702c1401", "type": "add", "text": "［－］【CB】【麗-CB】，啖畜以來久遠及魚鼈虫多共漬水中是故【大】"}
{"id": null, "n": "0702c1501", "target": "#nkr_note_add_0702c1501", "type": "add", "text": "［－］【CB】【麗-CB】，爾醎耳王言善哉善哉【大】"}
{"id": null, "n": "0702c1601", "target": "#nkr_note_add_0702c1601", "type": "add", "text": "［－］【CB】【麗-CB】，王復問那先人得道已寧能悉思惟深奧眾【大】"}
{"id": null, "n": "0702c1701", "target": "#nkr_note_add_0702c1701", "type": "add", "text": "［－］【CB】【麗-CB】，事不那先言然人得道已能悉思惟深奧之【大】"}
{"id": null, "n": "0702c1801", "target": "#nkr_note_add_0702c1801", "type": "add", "text": "［－］【CB】【麗-CB】，事佛經最深奧知眾事不可稱量眾事皆以【大】"}
{"id": null, "n": "0702c1901", "target": "#nkr_note_add_0702c1901", "type": "add", "text": "［－］【CB】【麗-CB】，智評之王言善哉善哉【大】"}
{"id": null, "n": "0702c2001", "target": "#nkr_note_add_0702c2001", "type": "add", "text": "［－］【CB】【麗-CB】，王復問那先人神智自然此三事寧同不【大】"}
{"id": null, "n": "0702c2101", "target": "#nkr_note_add_0702c2101", "type": "add", "text": "［－］【CB】【麗-CB】，各異那先言人神者生覺智者曉道自然【大】"}
{"id": null, "n": "0702c2201", "target": "#nkr_note_add_0702c2201", "type": "add", "text": "［－］【CB】【麗-CB】，者虛空無有人也王又問那先人言得人何【大】"}
{"id": null, "n": "0702c2301", "target": "#nkr_note_add_0702c2301", "type": "add", "text": "［－］【CB】【麗-CB】，等為得人者今眼視色耳聽聲鼻聞香臭口【大】"}
{"id": null, "n": "0702c2401", "target": "#nkr_note_add_0702c2401", "type": "add", "text": "［－］【CB】【麗-CB】，知味身知軟麁志知善惡之事何所為得人【大】"}
{"id": null, "n": "0702c2501", "target": "#nkr_note_add_0702c2501", "type": "add", "text": "［－］【CB】【麗-CB】，者【大】"}
{"id": null, "n": "0703a1601", "target": "#nkr_note_add_0703a1601", "type": "add", "text": "（制其…得人者）二百九十五字【CB】【麗-CB】，［－］【大】（CBETA 按：修訂錯簡；原書位於 T32n1670Ap0702c06～c25「制其……得人者」移至 T32n1670Ap0703a16。）"}
{"id": null, "n": "0703a1602", "target": "#nkr_note_add_0703a1602", "type": "add", "text": "CBETA 按：大正本（T32n1670Ap0702c10）有校勘作「[10]海～Samudda.」。"}
{"id": null, "n": "0703a1603", "target": "#nkr_note_add_0703a1603", "type": "add", "text": "CBETA 按：大正本（T32n1670Ap0702c20）有校勘作「[11]人神～Jīva.」。"}
{"id": null, "n": "0703a1604", "target": "#nkr_note_add_0703a1604", "type": "add", "text": "CBETA 按：大正本（T32n1670Ap0702c20）有校勘作「[12]智～Paññā.」。"}
{"id": null, "n": "0703a1605", "target": "#nkr_note_add_0703a1605", "type": "add", "text": "CBETA 按：大正本（T32n1670Ap0702c20）有校勘作「[13]自然～Dhamma.」。"}
{"id": null, "n": "0694001", "target": "#nkr_note_rest_0694001", "type": "rest", "text": "此經與宋元明三本大異今以宋元宮本對校明本別附卷末"}
{"id": null, "n": null, "target": "#nkr_note_foreign_0694007", "type": null, "text": "Parinibbāna."}
{"id": null, "n": null, "target": "#nkr_note_foreign_0694009", "type": null, "text": "Samaṇa."}
{"id": null, "n": null, "target": "#nkr_note_foreign_0694010", "type": null, "text": "Brāhmaṇa."}
{"id": null, "n": null, "target": "#nkr_note_foreign_0694014", "type": null, "text": "Milinda."}
