{"id": null, "n": null, "target": null, "type": null, "text": "晉言華積"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉言最上天王"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉言無量光明"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉言大光明"}
{"id": null, "n": "0865012", "target": "#nkr_note_mod_0865012", "type": "mod", "text": "晉【大】下同，此【明】下同"}
{"id": null, "n": "0865013", "target": "#nkr_note_mod_0865013", "type": "mod", "text": "兩【大】，二【明】"}
{"id": null, "n": "0865014", "target": "#nkr_note_mod_0865014", "type": "mod", "text": "政【大】下同，正【宋】下同【元】下同【明】下同"}
{"id": null, "n": "0865015", "target": "#nkr_note_mod_0865015", "type": "mod", "text": "奇【大】，倚【宋】【元】【明】"}
{"id": null, "n": "0865016", "target": "#nkr_note_mod_0865016", "type": "mod", "text": "誦讀【大】，讀誦【宋】【元】【明】"}
{"id": null, "n": "0865017", "target": "#nkr_note_mod_0865017", "type": "mod", "text": "益【大】，氣【宋】【元】【明】"}
{"id": null, "n": "0865018", "target": "#nkr_note_mod_0865018", "type": "mod", "text": "跋【大】＊，拔【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0865019", "target": "#nkr_note_mod_0865019", "type": "mod", "text": "螫【大】，蠍【明】"}
{"id": null, "n": "0865020", "target": "#nkr_note_mod_0865020", "type": "mod", "text": "欲復【大】，復欲【宋】【元】【明】"}
{"id": null, "n": "0865021", "target": "#nkr_note_mod_0865021", "type": "mod", "text": "安【大】，案【宋】【元】【明】"}
{"id": null, "n": "0865022", "target": "#nkr_note_mod_0865022", "type": "mod", "text": "訶【大】，訶迦【宋】【元】【明】"}
{"id": null, "n": "0865023", "target": "#nkr_note_mod_0865023", "type": "mod", "text": "是【大】，其【明】"}
{"id": null, "n": "0866001", "target": "#nkr_note_mod_0866001", "type": "mod", "text": "佛說【大】，〔－〕【宋】"}
{"id": null, "n": "0865011", "target": "#nkr_note_orig_0865011", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0865012", "target": "#nkr_note_orig_0865012", "type": "orig", "text": "晉＝此【明】下同"}
{"id": null, "n": "0865013", "target": "#nkr_note_orig_0865013", "type": "orig", "text": "兩＝二【明】"}
{"id": null, "n": "0865014", "target": "#nkr_note_orig_0865014", "type": "orig", "text": "政＝正【三】下同"}
{"id": null, "n": "0865015", "target": "#nkr_note_orig_0865015", "type": "orig", "text": "奇＝倚【三】"}
{"id": null, "n": "0865016", "target": "#nkr_note_orig_0865016", "type": "orig", "text": "誦讀＝讀誦【三】"}
{"id": null, "n": "0865017", "target": "#nkr_note_orig_0865017", "type": "orig", "text": "益＝氣【三】"}
{"id": null, "n": "0865018", "target": "#nkr_note_orig_0865018", "type": "orig", "text": "跋＝拔【三】＊"}
{"id": null, "n": "0865019", "target": "#nkr_note_orig_0865019", "type": "orig", "text": "螫＝蠍【明】"}
{"id": null, "n": "0865020", "target": "#nkr_note_orig_0865020", "type": "orig", "text": "欲復＝復欲【三】"}
{"id": null, "n": "0865021", "target": "#nkr_note_orig_0865021", "type": "orig", "text": "安＝案【三】"}
{"id": null, "n": "0865022", "target": "#nkr_note_orig_0865022", "type": "orig", "text": "訶＋（迦）【三】"}
{"id": null, "n": "0865023", "target": "#nkr_note_orig_0865023", "type": "orig", "text": "是＝其【明】"}
{"id": null, "n": "0866001", "target": "#nkr_note_orig_0866001", "type": "orig", "text": "〔佛說〕－【宋】"}
