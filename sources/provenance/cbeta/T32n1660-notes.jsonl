{"id": null, "n": "0517006", "target": "#nkr_note_mod_0517006", "type": "mod", "text": "大隋南印度【大】＊，隋天竺【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0517007", "target": "#nkr_note_mod_0517007", "type": "mod", "text": "磨【大】＊，摩【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0517008", "target": "#nkr_note_mod_0517008", "type": "mod", "text": "覺【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0517009", "target": "#nkr_note_mod_0517009", "type": "mod", "text": "是【大】，見【宋】【元】【明】"}
{"id": null, "n": "0518001", "target": "#nkr_note_mod_0518001", "type": "mod", "text": "能無【大】，無能【宋】【元】【明】"}
{"id": null, "n": "0518002", "target": "#nkr_note_mod_0518002", "type": "mod", "text": "住【大】，往【明】"}
{"id": null, "n": "0519001", "target": "#nkr_note_mod_0519001", "type": "mod", "text": "囉【大】＊，邏【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0519002", "target": "#nkr_note_mod_0519002", "type": "mod", "text": "挐【大】，拏【宋】【元】【明】【宮】"}
{"id": null, "n": "0519003", "target": "#nkr_note_mod_0519003", "type": "mod", "text": "亦【大】，示【宮】"}
{"id": null, "n": "0519004", "target": "#nkr_note_mod_0519004", "type": "mod", "text": "險【大】，際【宋】【元】【明】【宮】"}
{"id": null, "n": "0519005", "target": "#nkr_note_mod_0519005", "type": "mod", "text": "猗【大】，倚【宋】【元】【明】"}
{"id": null, "n": "0520001", "target": "#nkr_note_mod_0520001", "type": "mod", "text": "等【大】，知【宋】"}
{"id": null, "n": "0520002", "target": "#nkr_note_mod_0520002", "type": "mod", "text": "諸【大】，謂【宋】【元】【明】【宮】"}
{"id": null, "n": "0520003", "target": "#nkr_note_mod_0520003", "type": "mod", "text": "迦【大】，迦偈【宋】【元】【明】【宮】"}
{"id": null, "n": "0520004", "target": "#nkr_note_mod_0520004", "type": "mod", "text": "善【大】，若【宮】"}
{"id": null, "n": "0521001", "target": "#nkr_note_mod_0521001", "type": "mod", "text": "痰癊【大】，淡飲【宮】"}
{"id": null, "n": "0521002", "target": "#nkr_note_mod_0521002", "type": "mod", "text": "無【大】，起【宋】【元】【明】"}
{"id": null, "n": "0521003", "target": "#nkr_note_mod_0521003", "type": "mod", "text": "覺【大】，坐菩提【宋】【元】【明】【宮】"}
{"id": null, "n": "0522001", "target": "#nkr_note_mod_0522001", "type": "mod", "text": "著【大】，者【元】"}
{"id": null, "n": "0522002", "target": "#nkr_note_mod_0522002", "type": "mod", "text": "於【大】，此【宋】【元】【明】【宮】"}
{"id": null, "n": "0522003", "target": "#nkr_note_mod_0522003", "type": "mod", "text": "曠【大】，廣【宋】【元】【明】"}
{"id": null, "n": "0523001", "target": "#nkr_note_mod_0523001", "type": "mod", "text": "說【大】，已說【宋】【元】【明】【宮】"}
{"id": null, "n": "0523002", "target": "#nkr_note_mod_0523002", "type": "mod", "text": "巧【大】＊，善巧【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0523003", "target": "#nkr_note_mod_0523003", "type": "mod", "text": "思【大】＊，思惟【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0523004", "target": "#nkr_note_mod_0523004", "type": "mod", "text": "趣【大】，趣於【宋】【元】【明】【宮】"}
{"id": null, "n": "0523005", "target": "#nkr_note_mod_0523005", "type": "mod", "text": "多【大】，滋【宋】【元】【明】【宮】"}
{"id": null, "n": "0523006", "target": "#nkr_note_mod_0523006", "type": "mod", "text": "劣【大】，芳【宮】"}
{"id": null, "n": "0523007", "target": "#nkr_note_mod_0523007", "type": "mod", "text": "在【大】，有【宮】"}
{"id": null, "n": "0523008", "target": "#nkr_note_mod_0523008", "type": "mod", "text": "行【大】，行其【宮】"}
{"id": null, "n": "0523009", "target": "#nkr_note_mod_0523009", "type": "mod", "text": "魔【大】，應【宮】"}
{"id": null, "n": "0523010", "target": "#nkr_note_mod_0523010", "type": "mod", "text": "六【大】，於【宮】"}
{"id": null, "n": "0523011", "target": "#nkr_note_mod_0523011", "type": "mod", "text": "愍【大】，門【宮】"}
{"id": null, "n": "0523012", "target": "#nkr_note_mod_0523012", "type": "mod", "text": "退墮【大】，下降【宋】【元】【明】【宮】"}
{"id": null, "n": "0524001", "target": "#nkr_note_mod_0524001", "type": "mod", "text": "雜【大】，離【宋】【元】【明】【宮】"}
{"id": null, "n": "0524002", "target": "#nkr_note_mod_0524002", "type": "mod", "text": "地【大】，十地【宋】【元】【明】【宮】"}
{"id": null, "n": "0524003", "target": "#nkr_note_mod_0524003", "type": "mod", "text": "論【大】，輪【宋】【元】【明】【宮】"}
{"id": null, "n": "0524004", "target": "#nkr_note_mod_0524004", "type": "mod", "text": "即【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0524005", "target": "#nkr_note_mod_0524005", "type": "mod", "text": "令【大】，即令【宋】【元】【明】【宮】"}
{"id": null, "n": "0524006", "target": "#nkr_note_mod_0524006", "type": "mod", "text": "悉【大】，慧【明】"}
{"id": null, "n": "0524007", "target": "#nkr_note_mod_0524007", "type": "mod", "text": "一【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0525001", "target": "#nkr_note_mod_0525001", "type": "mod", "text": "界【大】，界性【宋】【元】【明】【宮】"}
{"id": null, "n": "0525002", "target": "#nkr_note_mod_0525002", "type": "mod", "text": "癊【大】，飲【宮】"}
{"id": null, "n": "0525003", "target": "#nkr_note_mod_0525003", "type": "mod", "text": "顛【大】，癲【宋】【元】【明】【宮】"}
{"id": null, "n": "0525004", "target": "#nkr_note_mod_0525004", "type": "mod", "text": "石白如貝【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0525005", "target": "#nkr_note_mod_0525005", "type": "mod", "text": "玉【大】，石玉【宋】【元】【明】【宮】"}
{"id": null, "n": "0525006", "target": "#nkr_note_mod_0525006", "type": "mod", "text": "出【大】＊，出世【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0525007", "target": "#nkr_note_mod_0525007", "type": "mod", "text": "等諸資糧【大】，〔－〕【明】"}
{"id": null, "n": "0525008", "target": "#nkr_note_mod_0525008", "type": "mod", "text": "是【大】，如是【宋】【元】【明】【宮】"}
{"id": null, "n": "0525009", "target": "#nkr_note_mod_0525009", "type": "mod", "text": "陀【大】，檀【宋】【元】【明】【宮】"}
{"id": null, "n": "0525010", "target": "#nkr_note_mod_0525010", "type": "mod", "text": "濁【大】，濁處【宋】"}
{"id": null, "n": "0525011", "target": "#nkr_note_mod_0525011", "type": "mod", "text": "處【大】，處攝【宋】【元】【明】【宮】"}
{"id": null, "n": "0526001", "target": "#nkr_note_mod_0526001", "type": "mod", "text": "魔【大】，癡【宋】【元】【明】【宮】"}
{"id": null, "n": "0526002", "target": "#nkr_note_mod_0526002", "type": "mod", "text": "思【大】，思議【宋】【元】【明】【宮】"}
{"id": null, "n": "0526003", "target": "#nkr_note_mod_0526003", "type": "mod", "text": "功德【大】，功德聞諸佛神變者於中諸佛世尊為教【宋】【元】【明】【宮】"}
{"id": null, "n": "0526004", "target": "#nkr_note_mod_0526004", "type": "mod", "text": "心勇【大】，若心勇悅【宋】【元】【明】【宮】"}
{"id": null, "n": "0526005", "target": "#nkr_note_mod_0526005", "type": "mod", "text": "共【大】，共彼【宋】【元】【明】【宮】"}
{"id": null, "n": "0526006", "target": "#nkr_note_mod_0526006", "type": "mod", "text": "登【大】，行【宋】【元】【明】【宮】"}
{"id": null, "n": "0526007", "target": "#nkr_note_mod_0526007", "type": "mod", "text": "答【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0527001", "target": "#nkr_note_mod_0527001", "type": "mod", "text": "念【大】，是念【宋】【元】【明】【宮】"}
{"id": null, "n": "0527002", "target": "#nkr_note_mod_0527002", "type": "mod", "text": "說【大】，脫【元】"}
{"id": null, "n": "0527003", "target": "#nkr_note_mod_0527003", "type": "mod", "text": "性【大】，住【宋】【元】【明】【宮】"}
{"id": null, "n": "0527004", "target": "#nkr_note_mod_0527004", "type": "mod", "text": "得【大】，心得【宋】【元】【明】【宮】"}
{"id": null, "n": "0527005", "target": "#nkr_note_mod_0527005", "type": "mod", "text": "復【大】，大【宋】【元】【明】【宮】"}
{"id": null, "n": "0527006", "target": "#nkr_note_mod_0527006", "type": "mod", "text": "心無分別心【大】，無復分別【宋】【元】【明】【宮】"}
{"id": null, "n": "0527007", "target": "#nkr_note_mod_0527007", "type": "mod", "text": "所【大】，有【宋】【元】【明】【宮】"}
{"id": null, "n": "0527008", "target": "#nkr_note_mod_0527008", "type": "mod", "text": "毀【大】，呰毀【宋】【元】【明】【宮】"}
{"id": null, "n": "0527009", "target": "#nkr_note_mod_0527009", "type": "mod", "text": "說【大】，謂【宋】【元】【明】【宮】"}
{"id": null, "n": "0527010", "target": "#nkr_note_mod_0527010", "type": "mod", "text": "故【大】，故是為第一因緣【宋】【元】【明】【宮】"}
{"id": null, "n": "0527011", "target": "#nkr_note_mod_0527011", "type": "mod", "text": "二【大】，第二【宋】【元】【明】【宮】"}
{"id": null, "n": "0527012", "target": "#nkr_note_mod_0527012", "type": "mod", "text": "轉【大】，轉是為第五因緣【宋】【元】【明】【宮】"}
{"id": null, "n": "0527013", "target": "#nkr_note_mod_0527013", "type": "mod", "text": "彼【大】，於彼【宋】【元】【明】【宮】"}
{"id": null, "n": "0527014", "target": "#nkr_note_mod_0527014", "type": "mod", "text": "中間【大】，於其中間【宋】【元】【明】【宮】"}
{"id": null, "n": "0527015", "target": "#nkr_note_mod_0527015", "type": "mod", "text": "說【大】，諸【宋】【元】【明】【宮】"}
{"id": null, "n": "0528001", "target": "#nkr_note_mod_0528001", "type": "mod", "text": "生【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0528002", "target": "#nkr_note_mod_0528002", "type": "mod", "text": "斷【大】，斷取【宋】【元】【明】【宮】"}
{"id": null, "n": "0528003", "target": "#nkr_note_mod_0528003", "type": "mod", "text": "記【大】，記故【宋】【元】【明】【宮】"}
{"id": null, "n": "0528004", "target": "#nkr_note_mod_0528004", "type": "mod", "text": "名【大】，是【明】"}
{"id": null, "n": "0529001", "target": "#nkr_note_mod_0529001", "type": "mod", "text": "無【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0529002", "target": "#nkr_note_mod_0529002", "type": "mod", "text": "百【大】，〔－〕【明】"}
{"id": null, "n": "0529003", "target": "#nkr_note_mod_0529003", "type": "mod", "text": "與【大】，於【明】"}
