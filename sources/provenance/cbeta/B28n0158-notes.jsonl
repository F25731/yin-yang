{"id": null, "n": null, "target": null, "type": null, "text": "時年七十七"}
{"id": null, "n": null, "target": null, "type": null, "text": "憐其血氣已衰"}
{"id": null, "n": null, "target": null, "type": null, "text": "憐其血氣\n未全"}
{"id": null, "n": null, "target": null, "type": null, "text": "憐其血氣未平"}
{"id": null, "n": null, "target": null, "type": null, "text": "憐其不能將養"}
{"id": null, "n": null, "target": null, "type": null, "text": "恐再加刑\n致死"}
{"id": null, "n": null, "target": null, "type": null, "text": "系出天潢豈宜輕打"}
{"id": null, "n": null, "target": null, "type": null, "text": "一命之微亦列\n仕籍有過細審不可輕責"}
{"id": null, "n": null, "target": null, "type": null, "text": "斯文一脈關係風化且魚龍變化莫可測識"}
{"id": null, "n": null, "target": null, "type": null, "text": "敬主及使有過當申明處分"}
{"id": null, "n": null, "target": null, "type": null, "text": "恥辱關其終身名節干於性命"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼方急迫打則速死"}
{"id": null, "n": null, "target": null, "type": null, "text": "忿氣傷人易於殞命"}
{"id": null, "n": null, "target": null, "type": null, "text": "醉則無知可以情恕"}
{"id": null, "n": null, "target": null, "type": null, "text": "行途辛苦又無將息"}
{"id": null, "n": null, "target": null, "type": null, "text": "遠行喘息六脈奔騰用刑則血逆攻心致死"}
{"id": null, "n": null, "target": null, "type": null, "text": "盛怒之時刑必過當待我氣平徐加責問"}
{"id": null, "n": null, "target": null, "type": null, "text": "酒醉心昏恐刑失當"}
{"id": null, "n": null, "target": null, "type": null, "text": "病時多怒刑恐不平"}
{"id": null, "n": null, "target": null, "type": null, "text": "事未確審不可驟刑"}
{"id": null, "n": null, "target": null, "type": null, "text": "遇事難處必慮其終驟然加刑後必致悔"}
{"id": null, "n": null, "target": null, "type": null, "text": "受桚之人血方奔心\n又復用刑心慌血入必致殞命"}
{"id": null, "n": null, "target": null, "type": null, "text": "夾棍極刑人所難受又加刑責多致於死"}
{"id": null, "n": null, "target": null, "type": null, "text": "先打後枷瘡潰難治待放枷時責未晚"}
{"id": null, "n": null, "target": null, "type": null, "text": "順天\n\n之時恤民之命"}
{"id": null, "n": null, "target": null, "type": null, "text": "與人之樂"}
{"id": null, "n": null, "target": null, "type": null, "text": "憫人之苦"}
{"id": null, "n": null, "target": null, "type": null, "text": "明倫理也"}
{"id": null, "n": null, "target": null, "type": null, "text": "不庇私也"}
{"id": null, "n": null, "target": null, "type": null, "text": "不為己也"}
{"id": null, "n": null, "target": null, "type": null, "text": "重杖傷人宜酌用輕者"}
{"id": null, "n": null, "target": null, "type": null, "text": "皁𨽾求索不遂每重打腿灣或受人私托打在一塊多致人死貧人何辜受此冤苦"}
{"id": null, "n": null, "target": null, "type": null, "text": "佐貳奉官趨勢替人拷打出氣百姓定然受害"}
{"id": null, "n": null, "target": null, "type": null, "text": "手足屈伸不便"}
{"id": null, "n": null, "target": null, "type": null, "text": "筋骨未壯難支"}
{"id": null, "n": null, "target": null, "type": null, "text": "魔障易濱於死"}
{"id": null, "n": null, "target": null, "type": null, "text": "熱蒸毒入臟腑"}
{"id": null, "n": null, "target": null, "type": null, "text": "凍破肌膚實慘"}
{"id": null, "n": null, "target": null, "type": null, "text": "疾痛無人照管"}
{"id": null, "n": null, "target": null, "type": null, "text": "露體枵腹堪嗟"}
{"id": null, "n": null, "target": null, "type": null, "text": "悞其耕種入口何依"}
{"id": null, "n": null, "target": null, "type": null, "text": "子不在傍愁苦千狀"}
{"id": null, "n": null, "target": null, "type": null, "text": "正當悲慘少寬非縱"}
{"id": null, "n": null, "target": null, "type": null, "text": "一朝失足慚不欲生"}
{"id": null, "n": null, "target": null, "type": null, "text": "原非兇類經懲自改"}
{"id": null, "n": null, "target": null, "type": null, "text": "西河合集微有不同其畧云濟寧關壯侯祠與回之\n禮拜寺鱗次而列回眾素驕蹇至是大拓禮拜議撤壯侯祠以益其地濟寧諸生陳君者約州民同詞揭開府力持不可回率\n眾詣陳君恐脅備至忽一人猝前篡取去眾回爭從之至北城日已墜地眾回嘬集棓朴雨下腦陷肌肉滷瀝家人呼于官請\n救僅以屍還及將還主者復剔其兩瞳始聽舁去主者殺厲兒舁其屍相當開府以下皆無可如何眾回歸尚集主者主者忽\n仆地已而大怖若有誅之者竅出血死而陳君之以屍還者夜分聞有人來前按其肌砭腦潄毒㶁㶁恍傅之以糝者然後持\n物內兩眶寒甚有如丸冰甫內彷彿見侯引甲卒負一筐珠光溢于筐即內眶物也家人見君生駴甚急移燭視兩目目如故\n逮明州民遍傳君見侯狀于是回眾亦悔懼願復侯祠甲申大司馬楊君鎮之回眾稍斂陳君以明年舉于鄉丙戌成進士除\n貴池令山陰陳曾塤以舊記互異乃屬予更記之"}
{"id": null, "n": null, "target": null, "type": null, "text": "烏程費丹旭敬繪"}
