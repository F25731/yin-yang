{"id": null, "n": "0758008", "target": "#nkr_note_mod_0758008", "type": "mod", "text": "者【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0758009", "target": "#nkr_note_mod_0758009", "type": "mod", "text": "我【大】，中【宋】【元】【明】【宮】"}
{"id": null, "n": "0758010", "target": "#nkr_note_mod_0758010", "type": "mod", "text": "嬈【大】，擾【宋】【元】【明】【宮】"}
{"id": null, "n": "0758011", "target": "#nkr_note_mod_0758011", "type": "mod", "text": "阿【大】，佛說阿【宋】【元】【明】【宮】"}
