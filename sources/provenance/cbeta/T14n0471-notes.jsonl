{"id": null, "n": null, "target": null, "type": "cf1", "text": "K11n0267_p0593b22"}
{"id": null, "n": "0514003", "target": null, "type": "orig", "text": "經次行＋（豆那掘多譯本）六字【宋】【宮】"}
{"id": null, "n": "0514003", "target": null, "type": "mod", "text": "經次行【大】，經次行豆那掘多譯本【宋】【宮】"}
{"id": null, "n": "0512002", "target": "#nkr_note_mod_0512002", "type": "mod", "text": "佛說【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0512003", "target": "#nkr_note_mod_0512003", "type": "mod", "text": "隋【大】，北隋【元】"}
{"id": null, "n": "0512004", "target": "#nkr_note_mod_0512004", "type": "mod", "text": "藏【大】，藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0512005", "target": "#nkr_note_mod_0512005", "type": "mod", "text": "豆【大】＊，闍【元】【明】＊"}
{"id": null, "n": "0512006", "target": "#nkr_note_mod_0512006", "type": "mod", "text": "結加【大】下同，結跏【明】下同"}
{"id": null, "n": "0512007", "target": "#nkr_note_mod_0512007", "type": "mod", "text": "靜【大】，靖【宋】【元】【宮】"}
{"id": null, "n": "0512008", "target": "#nkr_note_mod_0512008", "type": "mod", "text": "諦【大】，庠【宋】【元】【宮】，詳【明】"}
{"id": null, "n": "0512009", "target": "#nkr_note_mod_0512009", "type": "mod", "text": "敷【大】，敷坐而【元】【明】"}
{"id": null, "n": "0512010", "target": "#nkr_note_mod_0512010", "type": "mod", "text": "問【大】，即問【宋】【元】【明】【宮】"}
{"id": null, "n": "0512011", "target": "#nkr_note_mod_0512011", "type": "mod", "text": "為【大】，為斷【元】【明】"}
{"id": null, "n": "0512012", "target": "#nkr_note_mod_0512012", "type": "mod", "text": "何【大】，何等法【元】【明】"}
{"id": null, "n": "0512013", "target": "#nkr_note_mod_0512013", "type": "mod", "text": "也【大】，耶【元】【明】"}
{"id": null, "n": "0512014", "target": "#nkr_note_mod_0512014", "type": "mod", "text": "無彼【大】，現無【元】【明】"}
{"id": null, "n": "0512015", "target": "#nkr_note_mod_0512015", "type": "mod", "text": "來【大】，來際【元】【明】"}
{"id": null, "n": "0512016", "target": "#nkr_note_mod_0512016", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0512017", "target": "#nkr_note_mod_0512017", "type": "mod", "text": "無【大】，無如來【明】"}
{"id": null, "n": "0513001", "target": "#nkr_note_mod_0513001", "type": "mod", "text": "取【大】，最【宋】【宮】"}
{"id": null, "n": "0513002", "target": "#nkr_note_mod_0513002", "type": "mod", "text": "仁【CB】【宋】【元】【明】【宮】，人【大】"}
{"id": null, "n": "0513003", "target": "#nkr_note_mod_0513003", "type": "mod", "text": "者【大】，者不作為有無者【元】【明】"}
{"id": null, "n": "0513004", "target": "#nkr_note_mod_0513004", "type": "mod", "text": "不【大】，可不【元】【明】"}
{"id": null, "n": "0513005", "target": "#nkr_note_mod_0513005", "type": "mod", "text": "利【大】，利見【元】【明】"}
{"id": null, "n": "0513006", "target": "#nkr_note_mod_0513006", "type": "mod", "text": "不【大】，不可【宋】【元】【明】【宮】"}
{"id": null, "n": "0513007", "target": "#nkr_note_mod_0513007", "type": "mod", "text": "可【大】，何【元】【明】"}
{"id": null, "n": "0513008", "target": "#nkr_note_mod_0513008", "type": "mod", "text": "丘【大】，更【明】"}
{"id": null, "n": "0514001", "target": "#nkr_note_mod_0514001", "type": "mod", "text": "智【大】，至【宋】【元】【明】【宮】"}
{"id": null, "n": "0514002", "target": "#nkr_note_mod_0514002", "type": "mod", "text": "佛說文殊尸利經【大】，是經名聖者文殊尸利行經大乘法本竟【宋】【宮】，文殊尸利行經【元】，佛說文殊尸利行經【明】"}
{"id": null, "n": "0514003", "target": "#nkr_note_mod_0514003", "type": "mod", "text": "經次行【大】，經次行豆那掘多譯本【宋】【宮】"}
{"id": null, "n": "0512002", "target": "#nkr_note_orig_0512002", "type": "orig", "text": "〔佛說〕－【宋】【元】【宮】"}
{"id": null, "n": "0512003", "target": "#nkr_note_orig_0512003", "type": "orig", "text": "（北）＋隋【元】"}
{"id": null, "n": "0512004", "target": "#nkr_note_orig_0512004", "type": "orig", "text": "藏＋（法師）【三】【宮】"}
{"id": null, "n": "0512005", "target": "#nkr_note_orig_0512005", "type": "orig", "text": "豆＝闍【元】【明】＊"}
{"id": null, "n": "0512006", "target": "#nkr_note_orig_0512006", "type": "orig", "text": "結加＝結跏【明】下同"}
{"id": null, "n": "0512007", "target": "#nkr_note_orig_0512007", "type": "orig", "text": "靜＝靖【宋】【元】【宮】"}
{"id": null, "n": "0512008", "target": "#nkr_note_orig_0512008", "type": "orig", "text": "諦＝庠【宋】【元】【宮】，詳【明】"}
{"id": null, "n": "0512009", "target": "#nkr_note_orig_0512009", "type": "orig", "text": "敷＋（坐而）【元】【明】"}
{"id": null, "n": "0512010", "target": "#nkr_note_orig_0512010", "type": "orig", "text": "（即）＋問【三】【宮】"}
{"id": null, "n": "0512011", "target": "#nkr_note_orig_0512011", "type": "orig", "text": "為＋（斷）【元】【明】"}
{"id": null, "n": "0512012", "target": "#nkr_note_orig_0512012", "type": "orig", "text": "何＋（等法）【元】【明】"}
{"id": null, "n": "0512013", "target": "#nkr_note_orig_0512013", "type": "orig", "text": "也＝耶【元】【明】"}
{"id": null, "n": "0512014", "target": "#nkr_note_orig_0512014", "type": "orig", "text": "無彼＝現無【元】【明】"}
{"id": null, "n": "0512015", "target": "#nkr_note_orig_0512015", "type": "orig", "text": "來＋（際）【元】【明】"}
{"id": null, "n": "0512016", "target": "#nkr_note_orig_0512016", "type": "orig", "text": "〔有〕－【三】【宮】"}
{"id": null, "n": "0512017", "target": "#nkr_note_orig_0512017", "type": "orig", "text": "無＋（如來）【明】"}
{"id": null, "n": "0513001", "target": "#nkr_note_orig_0513001", "type": "orig", "text": "取＝最【宋】【宮】"}
{"id": null, "n": "0513002", "target": "#nkr_note_orig_0513002", "type": "orig", "text": "人＝仁【三】【宮】"}
{"id": null, "n": "0513003", "target": "#nkr_note_orig_0513003", "type": "orig", "text": "者＋（不作為有無者）六字【元】【明】"}
{"id": null, "n": "0513004", "target": "#nkr_note_orig_0513004", "type": "orig", "text": "（可）＋不【元】【明】"}
{"id": null, "n": "0513005", "target": "#nkr_note_orig_0513005", "type": "orig", "text": "利＋（見）【元】【明】"}
{"id": null, "n": "0513006", "target": "#nkr_note_orig_0513006", "type": "orig", "text": "不＋（可）【三】【宮】"}
{"id": null, "n": "0513007", "target": "#nkr_note_orig_0513007", "type": "orig", "text": "可＝何【元】【明】"}
{"id": null, "n": "0513008", "target": "#nkr_note_orig_0513008", "type": "orig", "text": "丘＝更【明】"}
{"id": null, "n": "0514001", "target": "#nkr_note_orig_0514001", "type": "orig", "text": "智＝至【三】【宮】"}
{"id": null, "n": "0514002", "target": "#nkr_note_orig_0514002", "type": "orig", "text": "佛說文殊尸利經＝是經名聖者文殊尸利行經大乘法本竟【宋】【宮】，文殊尸利行經【元】，佛說文殊尸利行經【明】"}
