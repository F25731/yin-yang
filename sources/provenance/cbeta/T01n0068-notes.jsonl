{"id": null, "n": "0870022", "target": "#nkr_note_mod_0870022", "type": "mod", "text": "出【大】，上出【宋】【元】【明】"}
{"id": null, "n": "0870023", "target": "#nkr_note_mod_0870023", "type": "mod", "text": "廬【大】＊，樓【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0870024", "target": "#nkr_note_mod_0870024", "type": "mod", "text": "其【大】，於【宋】【元】【明】"}
{"id": null, "n": "0870025", "target": "#nkr_note_mod_0870025", "type": "mod", "text": "維【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0870026", "target": "#nkr_note_mod_0870026", "type": "mod", "text": "已【大】，以【宋】【元】【明】"}
{"id": null, "n": "0870027", "target": "#nkr_note_mod_0870027", "type": "mod", "text": "孚【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0870028", "target": "#nkr_note_mod_0870028", "type": "mod", "text": "也【大】，耶【宋】【元】【明】"}
{"id": null, "n": "0871001", "target": "#nkr_note_mod_0871001", "type": "mod", "text": "抂【大】，枉【明】"}
{"id": null, "n": "0871002", "target": "#nkr_note_mod_0871002", "type": "mod", "text": "耳【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0871003", "target": "#nkr_note_mod_0871003", "type": "mod", "text": "正【大】，政【明】"}
{"id": null, "n": "0871004", "target": "#nkr_note_mod_0871004", "type": "mod", "text": "正【大】＊，政【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0871005", "target": "#nkr_note_mod_0871005", "type": "mod", "text": "錢【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0871006", "target": "#nkr_note_mod_0871006", "type": "mod", "text": "家【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0871007", "target": "#nkr_note_mod_0871007", "type": "mod", "text": "者【大】，〔－〕【宋】【元】【明】"}
