{"id": null, "n": "0869001", "target": "#nkr_note_mod_0869001", "type": "mod", "text": "者【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0869002", "target": "#nkr_note_mod_0869002", "type": "mod", "text": "座【大】＊，坐【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0869003", "target": "#nkr_note_mod_0869003", "type": "mod", "text": "自思【大】，思惟【宋】【元】【明】"}
{"id": null, "n": "0869004", "target": "#nkr_note_mod_0869004", "type": "mod", "text": "被【大】，願被【宋】【元】【明】"}
{"id": null, "n": "0869005", "target": "#nkr_note_mod_0869005", "type": "mod", "text": "鬚【大】＊，願【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0869006", "target": "#nkr_note_mod_0869006", "type": "mod", "text": "被【大】，披【宋】【元】"}
{"id": null, "n": "0869007", "target": "#nkr_note_mod_0869007", "type": "mod", "text": "未【大】，我未【宋】【元】【明】"}
{"id": null, "n": "0869008", "target": "#nkr_note_mod_0869008", "type": "mod", "text": "姓【大】＊，姪【元】【明】＊"}
{"id": null, "n": "0869009", "target": "#nkr_note_mod_0869009", "type": "mod", "text": "不【大】，莫【宋】【元】【明】"}
{"id": null, "n": "0869010", "target": "#nkr_note_mod_0869010", "type": "mod", "text": "屍【大】＊，屍死【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0869011", "target": "#nkr_note_mod_0869011", "type": "mod", "text": "以【大】，已【宋】【元】【明】"}
{"id": null, "n": "0869012", "target": "#nkr_note_mod_0869012", "type": "mod", "text": "便【大】，便去【宋】【元】【明】"}
{"id": null, "n": "0869013", "target": "#nkr_note_mod_0869013", "type": "mod", "text": "日【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0869014", "target": "#nkr_note_mod_0869014", "type": "mod", "text": "後【大】，後世【宋】【元】【明】"}
{"id": null, "n": "0869015", "target": "#nkr_note_mod_0869015", "type": "mod", "text": "乎【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0869016", "target": "#nkr_note_mod_0869016", "type": "mod", "text": "乎【大】，于【宋】【元】【明】"}
{"id": null, "n": "0869017", "target": "#nkr_note_mod_0869017", "type": "mod", "text": "沮【大】，恒【宋】【元】【明】"}
{"id": null, "n": "0869018", "target": "#nkr_note_mod_0869018", "type": "mod", "text": "佛時【大】，時佛【宋】【元】【明】"}
{"id": null, "n": "0869019", "target": "#nkr_note_mod_0869019", "type": "mod", "text": "舍衛【大】，舍衛國【宋】【元】【明】"}
{"id": null, "n": "0869020", "target": "#nkr_note_mod_0869020", "type": "mod", "text": "視【大】，親【元】"}
{"id": null, "n": "0869021", "target": "#nkr_note_mod_0869021", "type": "mod", "text": "到【大】，至【宋】【元】【明】"}
{"id": null, "n": "0869022", "target": "#nkr_note_mod_0869022", "type": "mod", "text": "為【大】，向【宋】【元】【明】"}
{"id": null, "n": "0869023", "target": "#nkr_note_mod_0869023", "type": "mod", "text": "經【大】，戒【宋】【元】【明】"}
{"id": null, "n": "0869024", "target": "#nkr_note_mod_0869024", "type": "mod", "text": "達【大】＊，遠【明】＊"}
{"id": null, "n": "0869025", "target": "#nkr_note_mod_0869025", "type": "mod", "text": "訣【大】，決【宋】【元】【明】"}
{"id": null, "n": "0869026", "target": "#nkr_note_mod_0869026", "type": "mod", "text": "復【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0870001", "target": "#nkr_note_mod_0870001", "type": "mod", "text": "復能【大】，能復【宋】【元】【明】"}
{"id": null, "n": "0870002", "target": "#nkr_note_mod_0870002", "type": "mod", "text": "被【大】，披【宋】【元】"}
{"id": null, "n": "0870003", "target": "#nkr_note_mod_0870003", "type": "mod", "text": "大【大】＊，丈【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0870004", "target": "#nkr_note_mod_0870004", "type": "mod", "text": "滓【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0870005", "target": "#nkr_note_mod_0870005", "type": "mod", "text": "可【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0870006", "target": "#nkr_note_mod_0870006", "type": "mod", "text": "欲【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0870007", "target": "#nkr_note_mod_0870007", "type": "mod", "text": "子【大】，丈夫子【宋】【元】【明】"}
{"id": null, "n": "0870008", "target": "#nkr_note_mod_0870008", "type": "mod", "text": "汝【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0870009", "target": "#nkr_note_mod_0870009", "type": "mod", "text": "梳【大】，傾【宋】【元】【明】"}
{"id": null, "n": "0870010", "target": "#nkr_note_mod_0870010", "type": "mod", "text": "門【大】，聞【宋】【元】【明】"}
{"id": null, "n": "0870011", "target": "#nkr_note_mod_0870011", "type": "mod", "text": "婢【大】，是【宋】【元】【明】"}
{"id": null, "n": "0870012", "target": "#nkr_note_mod_0870012", "type": "mod", "text": "斂【大】，檢【宋】【元】【明】"}
{"id": null, "n": "0870013", "target": "#nkr_note_mod_0870013", "type": "mod", "text": "公【大】＊，父【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0870014", "target": "#nkr_note_mod_0870014", "type": "mod", "text": "美【大】，羹【宋】【元】【明】"}
{"id": null, "n": "0870015", "target": "#nkr_note_mod_0870015", "type": "mod", "text": "庭中【大】，中庭【宋】【元】【明】"}
{"id": null, "n": "0870016", "target": "#nkr_note_mod_0870016", "type": "mod", "text": "誡【大】＊，戒【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0870017", "target": "#nkr_note_mod_0870017", "type": "mod", "text": "多憂【大】，憂多【宋】【元】【明】"}
{"id": null, "n": "0870018", "target": "#nkr_note_mod_0870018", "type": "mod", "text": "耳【大】，爾【宋】【元】【明】"}
{"id": null, "n": "0870019", "target": "#nkr_note_mod_0870019", "type": "mod", "text": "者【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0870020", "target": "#nkr_note_mod_0870020", "type": "mod", "text": "姉【大】＊，弟【宋】【元】＊，娣【明】＊"}
