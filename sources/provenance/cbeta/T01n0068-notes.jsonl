{"id": null, "n": "0871028", "target": "#nkr_note_mod_0871028", "type": "mod", "text": "成【大】，茂【宋】【元】【明】"}
{"id": null, "n": "0872001", "target": "#nkr_note_mod_0872001", "type": "mod", "text": "（不能…沙門）八字【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0872002", "target": "#nkr_note_mod_0872002", "type": "mod", "text": "說【大】，說法【宋】【元】【明】"}
{"id": null, "n": "0872003", "target": "#nkr_note_mod_0872003", "type": "mod", "text": "便【大】，使【宋】【元】【明】"}
{"id": null, "n": "0872004", "target": "#nkr_note_mod_0872004", "type": "mod", "text": "兩舌【大】，〔－〕【宋】【元】【明】"}
