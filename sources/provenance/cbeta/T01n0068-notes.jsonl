{"id": null, "n": "0871010", "target": "#nkr_note_mod_0871010", "type": "mod", "text": "趍【大】＊，趨【明】＊"}
{"id": null, "n": "0871011", "target": "#nkr_note_mod_0871011", "type": "mod", "text": "雙【大】，有雙【宋】【元】【明】"}
{"id": null, "n": "0871012", "target": "#nkr_note_mod_0871012", "type": "mod", "text": "生【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0871013", "target": "#nkr_note_mod_0871013", "type": "mod", "text": "珍【大】，財【宋】【元】【明】"}
{"id": null, "n": "0871014", "target": "#nkr_note_mod_0871014", "type": "mod", "text": "王言【大】，我識道徑【宋】【元】【明】"}
{"id": null, "n": "0871015", "target": "#nkr_note_mod_0871015", "type": "mod", "text": "當【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0871016", "target": "#nkr_note_mod_0871016", "type": "mod", "text": "來【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0871017", "target": "#nkr_note_mod_0871017", "type": "mod", "text": "道【大】，導【宋】【元】【明】"}
{"id": null, "n": "0871018", "target": "#nkr_note_mod_0871018", "type": "mod", "text": "渡【大】，度【宋】【元】【明】"}
{"id": null, "n": "0871019", "target": "#nkr_note_mod_0871019", "type": "mod", "text": "言【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0871020", "target": "#nkr_note_mod_0871020", "type": "mod", "text": "常【大】，尚【宋】【元】【明】"}
{"id": null, "n": "0871021", "target": "#nkr_note_mod_0871021", "type": "mod", "text": "至【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0871022", "target": "#nkr_note_mod_0871022", "type": "mod", "text": "會【大】，貪【宋】【元】【明】"}
{"id": null, "n": "0871023", "target": "#nkr_note_mod_0871023", "type": "mod", "text": "人【大】，身【宋】【元】【明】"}
{"id": null, "n": "0871024", "target": "#nkr_note_mod_0871024", "type": "mod", "text": "人代【大】，代人【宋】【元】【明】"}
{"id": null, "n": "0871025", "target": "#nkr_note_mod_0871025", "type": "mod", "text": "偶【大】，禍【宋】【元】【明】"}
{"id": null, "n": "0871026", "target": "#nkr_note_mod_0871026", "type": "mod", "text": "穿【大】，穿壁【宋】【元】【明】"}
