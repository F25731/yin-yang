{"id": null, "n": "0688002", "target": "#nkr_note_mod_0688002", "type": "mod", "text": "以遍難大【大】，〔－〕【宮】【甲】"}
{"id": null, "n": "0688003", "target": "#nkr_note_mod_0688003", "type": "mod", "text": "以大難遍上皆【大】，〔－〕【宮】【甲】"}
