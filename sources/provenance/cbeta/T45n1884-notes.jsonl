{"id": null, "n": "0688006", "target": "#nkr_note_mod_0688006", "type": "mod", "text": "（宗…思之）百一字【大】，〔－〕【甲】"}
{"id": null, "n": "0688007", "target": "#nkr_note_mod_0688007", "type": "mod", "text": "讀【大】，識【宮】"}
