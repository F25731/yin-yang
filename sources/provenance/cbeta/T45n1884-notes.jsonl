{"id": null, "n": "0690005", "target": "#nkr_note_mod_0690005", "type": "mod", "text": "局【大】，局也【宮】【甲】"}
{"id": null, "n": "0690006", "target": "#nkr_note_mod_0690006", "type": "mod", "text": "入【大】，又【宮】"}
