{"id": null, "n": "0663001", "target": "#nkr_note_mod_0663001", "type": "mod", "text": "三藏【大】＊，唐三藏【明】＊"}
{"id": null, "n": "0663002", "target": "#nkr_note_mod_0663002", "type": "mod", "text": "一【大】，一之二【明】"}
{"id": null, "n": "0663003", "target": "#nkr_note_mod_0663003", "type": "mod", "text": "界【大】，何界【宋】【元】【明】【宮】"}
{"id": null, "n": "0663004", "target": "#nkr_note_mod_0663004", "type": "mod", "text": "所【大】，可【宋】【元】【明】【宮】"}
{"id": null, "n": "0663005", "target": "#nkr_note_mod_0663005", "type": "mod", "text": "種【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0663006", "target": "#nkr_note_mod_0663006", "type": "mod", "text": "定【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0663007", "target": "#nkr_note_mod_0663007", "type": "mod", "text": "生【大】，住【宮】"}
{"id": null, "n": "0664001", "target": "#nkr_note_mod_0664001", "type": "mod", "text": "惱【大】，害【宮】"}
{"id": null, "n": "0664002", "target": "#nkr_note_mod_0664002", "type": "mod", "text": "動【大】，慟【宮】"}
{"id": null, "n": "0664003", "target": "#nkr_note_mod_0664003", "type": "mod", "text": "為【大】，〔－〕【宮】"}
{"id": null, "n": "0664004", "target": "#nkr_note_mod_0664004", "type": "mod", "text": "恚【大】，表【宮】"}
{"id": null, "n": "0664005", "target": "#nkr_note_mod_0664005", "type": "mod", "text": "依【大】，衣【元】"}
{"id": null, "n": "0664006", "target": "#nkr_note_mod_0664006", "type": "mod", "text": "知【大】，智【宋】【元】【明】【宮】"}
{"id": null, "n": "0664007", "target": "#nkr_note_mod_0664007", "type": "mod", "text": "耶【大】，〔－〕【宮】"}
{"id": null, "n": "0665001", "target": "#nkr_note_mod_0665001", "type": "mod", "text": "杖【大】，伏【宋】，仗【元】【明】【宮】"}
{"id": null, "n": "0665002", "target": "#nkr_note_mod_0665002", "type": "mod", "text": "妬【大】，如【宮】"}
{"id": null, "n": "0665003", "target": "#nkr_note_mod_0665003", "type": "mod", "text": "授【大】，受【宋】【元】【明】【宮】"}
{"id": null, "n": "0665004", "target": "#nkr_note_mod_0665004", "type": "mod", "text": "越【大】，遺【宋】【元】【明】【宮】"}
{"id": null, "n": "0665005", "target": "#nkr_note_mod_0665005", "type": "mod", "text": "轉【大】＊，〔－〕【宮】＊"}
{"id": null, "n": "0665006", "target": "#nkr_note_mod_0665006", "type": "mod", "text": "稱【大】，續【宋】【元】【明】【宮】"}
{"id": null, "n": "0666001", "target": "#nkr_note_mod_0666001", "type": "mod", "text": "耶【大】，邪【宮】"}
{"id": null, "n": "0666002", "target": "#nkr_note_mod_0666002", "type": "mod", "text": "謂【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0666003", "target": "#nkr_note_mod_0666003", "type": "mod", "text": "義【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0666004", "target": "#nkr_note_mod_0666004", "type": "mod", "text": "欲【大】，故【宮】"}
{"id": null, "n": "0666005", "target": "#nkr_note_mod_0666005", "type": "mod", "text": "暫【大】，繫【宋】【宮】"}
{"id": null, "n": "0666006", "target": "#nkr_note_mod_0666006", "type": "mod", "text": "廛【大】下同，纏【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0666007", "target": "#nkr_note_mod_0666007", "type": "mod", "text": "蘊【大】，蘊聚【宋】【元】【明】【宮】"}
{"id": null, "n": "0667001", "target": "#nkr_note_mod_0667001", "type": "mod", "text": "故【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0667002", "target": "#nkr_note_mod_0667002", "type": "mod", "text": "諸【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0668001", "target": "#nkr_note_mod_0668001", "type": "mod", "text": "杖【大】，仗【宋】【元】【明】【宮】"}
{"id": null, "n": "0668002", "target": "#nkr_note_mod_0668002", "type": "mod", "text": "諍【大】，淨【明】【宮】"}
{"id": null, "n": "0668003", "target": "#nkr_note_mod_0668003", "type": "mod", "text": "諍【大】，淨【宋】【元】【明】【宮】"}
{"id": null, "n": "0668004", "target": "#nkr_note_mod_0668004", "type": "mod", "text": "嗜【大】，耆【宋】"}
{"id": null, "n": "0668005", "target": "#nkr_note_mod_0668005", "type": "mod", "text": "非【大】，非是【宋】【元】【明】【宮】"}
{"id": null, "n": "0669001", "target": "#nkr_note_mod_0669001", "type": "mod", "text": "戀【大】，變【宮】"}
{"id": null, "n": "0669002", "target": "#nkr_note_mod_0669002", "type": "mod", "text": "雜【大】，惟【宮】"}
{"id": null, "n": "0669003", "target": "#nkr_note_mod_0669003", "type": "mod", "text": "因【大】，相【宮】"}
{"id": null, "n": "0669004", "target": "#nkr_note_mod_0669004", "type": "mod", "text": "若【大】，故【明】"}
{"id": null, "n": "0669005", "target": "#nkr_note_mod_0669005", "type": "mod", "text": "法【大】，治【宮】"}
{"id": null, "n": "0670001", "target": "#nkr_note_mod_0670001", "type": "mod", "text": "及【大】，足【宮】"}
{"id": null, "n": "0671001", "target": "#nkr_note_mod_0671001", "type": "mod", "text": "情【大】，緣【宮】"}
{"id": null, "n": "0671002", "target": "#nkr_note_mod_0671002", "type": "mod", "text": "法品【大】，品法【宮】"}
{"id": null, "n": "0671003", "target": "#nkr_note_mod_0671003", "type": "mod", "text": "謂識【大】，識謂【宮】"}
{"id": null, "n": "0671004", "target": "#nkr_note_mod_0671004", "type": "mod", "text": "正【大】，臣【元】【明】"}
{"id": null, "n": "0671005", "target": "#nkr_note_mod_0671005", "type": "mod", "text": "勝【大】，益【宋】【元】【明】【宮】"}
{"id": null, "n": "0671006", "target": "#nkr_note_mod_0671006", "type": "mod", "text": "任【大】，住【明】"}
{"id": null, "n": "0671007", "target": "#nkr_note_mod_0671007", "type": "mod", "text": "住【大】，任【宋】"}
{"id": null, "n": "0672001", "target": "#nkr_note_mod_0672001", "type": "mod", "text": "彼【大】，被【明】"}
{"id": null, "n": "0672002", "target": "#nkr_note_mod_0672002", "type": "mod", "text": "食【大】，四食【宋】【元】【明】【宮】"}
{"id": null, "n": "0672003", "target": "#nkr_note_mod_0672003", "type": "mod", "text": "何【大】，阿【宮】"}
{"id": null, "n": "0672004", "target": "#nkr_note_mod_0672004", "type": "mod", "text": "大乘阿毘達磨集論【大】＊，〔－〕【明】＊"}
{"id": null, "n": "0673001", "target": "#nkr_note_mod_0673001", "type": "mod", "text": "如是【大】，〔－〕【元】【明】"}
{"id": null, "n": "0673002", "target": "#nkr_note_mod_0673002", "type": "mod", "text": "同【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0673003", "target": "#nkr_note_mod_0673003", "type": "mod", "text": "所【大】，已【宋】【元】【明】【宮】"}
{"id": null, "n": "0673004", "target": "#nkr_note_mod_0673004", "type": "mod", "text": "欲【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0673005", "target": "#nkr_note_mod_0673005", "type": "mod", "text": "欲【大】，欲界【宋】【元】【明】【宮】"}
{"id": null, "n": "0673006", "target": "#nkr_note_mod_0673006", "type": "mod", "text": "子【大】，成【元】"}
{"id": null, "n": "0674001", "target": "#nkr_note_mod_0674001", "type": "mod", "text": "之一【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0674002", "target": "#nkr_note_mod_0674002", "type": "mod", "text": "少淨天【大】，〔－〕【宮】"}
{"id": null, "n": "0674003", "target": "#nkr_note_mod_0674003", "type": "mod", "text": "化樂【大】，樂變化【宋】【元】【明】【宮】"}
{"id": null, "n": "0674004", "target": "#nkr_note_mod_0674004", "type": "mod", "text": "大【大】，天【宋】"}
{"id": null, "n": "0674005", "target": "#nkr_note_mod_0674005", "type": "mod", "text": "生【大】，異生【宋】【元】【明】【宮】"}
{"id": null, "n": "0674006", "target": "#nkr_note_mod_0674006", "type": "mod", "text": "今【大】，令【宋】【元】【明】【宮】"}
{"id": null, "n": "0674007", "target": "#nkr_note_mod_0674007", "type": "mod", "text": "合【大】，畧【宋】【元】【明】【宮】"}
{"id": null, "n": "0675001", "target": "#nkr_note_mod_0675001", "type": "mod", "text": "通【大】，遍【宋】【元】【明】【宮】"}
{"id": null, "n": "0675002", "target": "#nkr_note_mod_0675002", "type": "mod", "text": "待【大】，得【宮】"}
{"id": null, "n": "0675003", "target": "#nkr_note_mod_0675003", "type": "mod", "text": "大【大】，大苦【宋】【元】【宮】"}
{"id": null, "n": "0676001", "target": "#nkr_note_mod_0676001", "type": "mod", "text": "拘【大】，俱【宋】【元】【明】【宮】"}
{"id": null, "n": "0676002", "target": "#nkr_note_mod_0676002", "type": "mod", "text": "秤【大】，稱【宋】【元】【明】【宮】"}
{"id": null, "n": "0676003", "target": "#nkr_note_mod_0676003", "type": "mod", "text": "如【大】，加【宮】"}
{"id": null, "n": "0676004", "target": "#nkr_note_mod_0676004", "type": "mod", "text": "喜【大】，希【宋】【元】【明】【宮】"}
{"id": null, "n": "0676005", "target": "#nkr_note_mod_0676005", "type": "mod", "text": "匱【大】，遺【宮】"}
{"id": null, "n": "0676006", "target": "#nkr_note_mod_0676006", "type": "mod", "text": "不【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0677001", "target": "#nkr_note_mod_0677001", "type": "mod", "text": "背【大】，皆【元】"}
{"id": null, "n": "0677002", "target": "#nkr_note_mod_0677002", "type": "mod", "text": "三【大】，二【明】"}
{"id": null, "n": "0677003", "target": "#nkr_note_mod_0677003", "type": "mod", "text": "趣【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0677004", "target": "#nkr_note_mod_0677004", "type": "mod", "text": "由【大】，中【宋】"}
{"id": null, "n": "0677005", "target": "#nkr_note_mod_0677005", "type": "mod", "text": "正【大】，王【元】"}
{"id": null, "n": "0677006", "target": "#nkr_note_mod_0677006", "type": "mod", "text": "謂【大】，問於何等位障諸善法【宋】【元】【明】"}
{"id": null, "n": "0677007", "target": "#nkr_note_mod_0677007", "type": "mod", "text": "位【大】，（位於樂出家時貪欲蓋為障希求受用外境界門於彼不忻樂故於正覺行時瞋，恚蓋為障於所犯學處同梵行者正發學，時由心瞋，恚正不覺故於止舉兩位惛沈睡眠掉舉惡作蓋為障如前所說能引沈沒及散亂故於捨位疑為障遠離決定不能捨故）【宋】【元】【明】，但文中瞋宋本作顛，學明本作覺"}
{"id": null, "n": "0677008", "target": "#nkr_note_mod_0677008", "type": "mod", "text": "怨【大】，恐【元】【明】【宮】"}
{"id": null, "n": "0678001", "target": "#nkr_note_mod_0678001", "type": "mod", "text": "貧【大】，貪【元】"}
{"id": null, "n": "0678002", "target": "#nkr_note_mod_0678002", "type": "mod", "text": "熱【大】＊，執【宮】＊"}
{"id": null, "n": "0678003", "target": "#nkr_note_mod_0678003", "type": "mod", "text": "杖【大】，仗【宋】【元】【明】【宮】"}
{"id": null, "n": "0678004", "target": "#nkr_note_mod_0678004", "type": "mod", "text": "熾【大】，燒【宋】【元】【宮】"}
{"id": null, "n": "0678005", "target": "#nkr_note_mod_0678005", "type": "mod", "text": "二【大】，三【宮】"}
{"id": null, "n": "0678006", "target": "#nkr_note_mod_0678006", "type": "mod", "text": "憂【大】，愛【宮】"}
{"id": null, "n": "0679001", "target": "#nkr_note_mod_0679001", "type": "mod", "text": "諸不【大】，不諸【明】"}
{"id": null, "n": "0679002", "target": "#nkr_note_mod_0679002", "type": "mod", "text": "力【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0680001", "target": "#nkr_note_mod_0680001", "type": "mod", "text": "叉【大】，又【明】"}
{"id": null, "n": "0680002", "target": "#nkr_note_mod_0680002", "type": "mod", "text": "特【大】，持【宋】【元】"}
{"id": null, "n": "0680003", "target": "#nkr_note_mod_0680003", "type": "mod", "text": "耶【大】，邪【宋】【元】【明】【宮】"}
{"id": null, "n": "0680004", "target": "#nkr_note_mod_0680004", "type": "mod", "text": "月【大】，擇【宋】"}
{"id": null, "n": "0680005", "target": "#nkr_note_mod_0680005", "type": "mod", "text": "姓【大】，性【宋】【元】【明】【宮】"}
{"id": null, "n": "0680006", "target": "#nkr_note_mod_0680006", "type": "mod", "text": "控【大】，害【宮】"}
{"id": null, "n": "0680007", "target": "#nkr_note_mod_0680007", "type": "mod", "text": "業【大】，〔－〕【宮】"}
{"id": null, "n": "0680008", "target": "#nkr_note_mod_0680008", "type": "mod", "text": "熟【大】，〔－〕【宮】"}
{"id": null, "n": "0680009", "target": "#nkr_note_mod_0680009", "type": "mod", "text": "施【大】，〔－〕【宮】"}
{"id": null, "n": "0680010", "target": "#nkr_note_mod_0680010", "type": "mod", "text": "離【大】，雜【宋】【元】【明】【宮】"}
{"id": null, "n": "0681001", "target": "#nkr_note_mod_0681001", "type": "mod", "text": "雜【大】，離【宋】【元】【明】【宮】"}
{"id": null, "n": "0681002", "target": "#nkr_note_mod_0681002", "type": "mod", "text": "別【大】，對【宋】【元】【明】【宮】"}
{"id": null, "n": "0681003", "target": "#nkr_note_mod_0681003", "type": "mod", "text": "猶【大】，由【宋】【元】【明】【宮】"}
{"id": null, "n": "0681004", "target": "#nkr_note_mod_0681004", "type": "mod", "text": "得可【大】，可得【明】"}
{"id": null, "n": "0681005", "target": "#nkr_note_mod_0681005", "type": "mod", "text": "業【大】，願【元】"}
{"id": null, "n": "0681006", "target": "#nkr_note_mod_0681006", "type": "mod", "text": "摧【大】，催【明】"}
{"id": null, "n": "0682001", "target": "#nkr_note_mod_0682001", "type": "mod", "text": "常【大】，甞【宋】【元】【明】【宮】"}
{"id": null, "n": "0682002", "target": "#nkr_note_mod_0682002", "type": "mod", "text": "煖【大】＊，暖【明】＊"}
