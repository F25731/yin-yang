{"id": null, "n": "0362a0201", "target": "#nkr_note_add_0362a0201", "type": "add", "text": "窣【CB】，𡨔【卍續】"}
{"id": null, "n": "0363b0301", "target": "#nkr_note_add_0363b0301", "type": "add", "text": "已【CB】，巳【卍續】"}
