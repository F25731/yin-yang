{"id": null, "n": null, "target": null, "type": null, "text": "附"}
{"id": null, "n": null, "target": null, "type": null, "text": "請續末後句"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡孝切音效教也"}
{"id": null, "n": null, "target": null, "type": null, "text": "伊鳥切遙上聲抒臼也"}
{"id": null, "n": null, "target": null, "type": null, "text": "桑感切音𢕕雜也"}
{"id": null, "n": null, "target": null, "type": null, "text": "苦濫切音闞呵也"}
{"id": null, "n": null, "target": null, "type": null, "text": "敕角切音踔綽略速行也"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃計切音殢肥也"}
{"id": null, "n": null, "target": null, "type": null, "text": "狼敵切音歴病骨出也"}
{"id": null, "n": null, "target": null, "type": null, "text": "師代却是某甲罪過"}
{"id": null, "n": null, "target": null, "type": null, "text": "師別鳴指一下云只明這個事"}
{"id": null, "n": null, "target": null, "type": null, "text": "師代云這畜生"}
{"id": null, "n": null, "target": null, "type": null, "text": "代云\n瞌睡漢"}
{"id": null, "n": null, "target": null, "type": null, "text": "代云瞞阿兄不得"}
{"id": null, "n": null, "target": null, "type": null, "text": "師代云道即不辭只恐無人證\n明"}
{"id": null, "n": null, "target": null, "type": null, "text": "奪人不奪境"}
{"id": null, "n": null, "target": null, "type": null, "text": "奪境不奪人"}
{"id": null, "n": null, "target": null, "type": null, "text": "人境兩俱奪"}
{"id": null, "n": null, "target": null, "type": null, "text": "人境俱不奪"}
{"id": null, "n": null, "target": null, "type": null, "text": "神陵切音乗索也"}
{"id": null, "n": null, "target": null, "type": null, "text": "息吏切音四偵候也"}
{"id": null, "n": null, "target": null, "type": null, "text": "魚乞切音仡山獨立壯武\n貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "杜歷切音狄見也"}
{"id": null, "n": null, "target": null, "type": null, "text": "離呈切音靈"}
{"id": null, "n": null, "target": null, "type": null, "text": "披經切聘平聲竛竮行不\n正貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "烏禾切音倭藏也窟也穴居也"}
{"id": null, "n": null, "target": null, "type": null, "text": "克盍切音榼取也又擊也"}
{"id": null, "n": null, "target": null, "type": null, "text": "匹亦切音僻腹病也"}
{"id": null, "n": null, "target": null, "type": null, "text": "蘇典切音銑火也"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡夾切音狹合也"}
{"id": null, "n": null, "target": null, "type": null, "text": "古岳切音角欀也椽方曰桷"}
{"id": null, "n": null, "target": null, "type": null, "text": "高皇帝幸寺有作故二句及之"}
{"id": null, "n": null, "target": null, "type": null, "text": "在綠蘿菴前"}
{"id": null, "n": null, "target": null, "type": null, "text": "在繼隱菴前"}
{"id": null, "n": null, "target": null, "type": null, "text": "時淨公結茆船下"}
{"id": null, "n": null, "target": null, "type": null, "text": "時奉命較刊續正法眼藏"}
{"id": null, "n": null, "target": null, "type": null, "text": "有序"}
{"id": null, "n": null, "target": null, "type": null, "text": "有序"}
{"id": null, "n": null, "target": null, "type": null, "text": "有序"}
{"id": null, "n": null, "target": null, "type": null, "text": "有序"}
{"id": null, "n": null, "target": null, "type": null, "text": "庚辰繼隱菴作"}
{"id": null, "n": null, "target": null, "type": null, "text": "附"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "犬繠切音頍與䞨同舉一足曰跬半步也"}
{"id": null, "n": null, "target": null, "type": null, "text": "株衛切音錣連緝不絕貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "居侯切音鉤以籠覆燈火也"}
{"id": null, "n": null, "target": null, "type": null, "text": "離珍切音鄰壟田也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即恊切音𠗉周也"}
