{"id": null, "n": "0284001", "target": "#nkr_note_mod_0284001", "type": "mod", "text": "臆【大】，億【甲】"}
{"id": null, "n": "0285001", "target": "#nkr_note_mod_0285001", "type": "mod", "text": "紀【大】，糺【甲】"}
{"id": null, "n": "0287001", "target": "#nkr_note_mod_0287001", "type": "mod", "text": "惟【CB】【甲】，推【大】"}
{"id": null, "n": "0287002", "target": "#nkr_note_mod_0287002", "type": "mod", "text": "密【大】＊，蜜【甲】＊"}
{"id": null, "n": "0287003", "target": "#nkr_note_mod_0287003", "type": "mod", "text": "慈【大】，茲【甲】"}
{"id": null, "n": "0288001", "target": "#nkr_note_mod_0288001", "type": "mod", "text": "研【大】，斫【甲】"}
{"id": null, "n": "0288002", "target": "#nkr_note_mod_0288002", "type": "mod", "text": "釰【大】下同，劍【甲】下同"}
{"id": null, "n": "0288003", "target": "#nkr_note_mod_0288003", "type": "mod", "text": "羅【大】，〔－〕【甲】"}
{"id": null, "n": "0290001", "target": "#nkr_note_mod_0290001", "type": "mod", "text": "就【大】，三【甲】"}
{"id": null, "n": "0291001", "target": "#nkr_note_mod_0291001", "type": "mod", "text": "報【大】，執【甲】"}
{"id": null, "n": "0293001", "target": "#nkr_note_mod_0293001", "type": "mod", "text": "色【大】，光【甲】"}
{"id": null, "n": "0293002", "target": "#nkr_note_mod_0293002", "type": "mod", "text": "玉【大】＊，王【甲】＊"}
{"id": null, "n": "0294001", "target": "#nkr_note_mod_0294001", "type": "mod", "text": "計【CB】【甲】，討【大】"}
{"id": null, "n": "0294002", "target": "#nkr_note_mod_0294002", "type": "mod", "text": "玉【大】，王【甲】"}
{"id": null, "n": "0295001", "target": "#nkr_note_mod_0295001", "type": "mod", "text": "宮【CB】【甲】，官【大】"}
{"id": null, "n": "0296001", "target": "#nkr_note_mod_0296001", "type": "mod", "text": "八百【大】，〔－〕【甲】"}
{"id": null, "n": "0297001", "target": "#nkr_note_mod_0297001", "type": "mod", "text": "因【CB】【甲】，用【大】，用以觀音本是正法明如來故二十五由旬計一千里【甲】"}
{"id": null, "n": "0297002", "target": "#nkr_note_mod_0297002", "type": "mod", "text": "面【大】，面有二初面色二眉毫又三初毫色二流光三其色變現【甲】"}
{"id": null, "n": "0297003", "target": "#nkr_note_mod_0297003", "type": "mod", "text": "色【大】，色二眉毫又三初毫色【甲】"}
{"id": null, "n": "0297004", "target": "#nkr_note_mod_0297004", "type": "mod", "text": "色【大】，色二流光【甲】"}
{"id": null, "n": "0297005", "target": "#nkr_note_mod_0297005", "type": "mod", "text": "明【大】，明三其光變現【甲】"}
{"id": null, "n": "0297006", "target": "#nkr_note_mod_0297006", "type": "mod", "text": "臂【大】，臂又三初臂色二光為瓔珞三瓔珞變現初臂色【甲】"}
{"id": null, "n": "0297007", "target": "#nkr_note_mod_0297007", "type": "mod", "text": "色【大】，色二光為瓔珞【甲】"}
{"id": null, "n": "0297008", "target": "#nkr_note_mod_0297008", "type": "mod", "text": "珞【大】，珞三瓔珞變現【甲】"}
{"id": null, "n": "0297009", "target": "#nkr_note_mod_0297009", "type": "mod", "text": "事【大】，事諸莊嚴事必是彼國珠妙之相現於其中【甲】"}
{"id": null, "n": "0297010", "target": "#nkr_note_mod_0297010", "type": "mod", "text": "手【大】，手有三初手色二指端又三一文二色三光初手色【甲】"}
{"id": null, "n": "0297011", "target": "#nkr_note_mod_0297011", "type": "mod", "text": "色【大】，色二指端又三一文二色三光初文【甲】"}
{"id": null, "n": "0298001", "target": "#nkr_note_mod_0298001", "type": "mod", "text": "文【大】，文二色【甲】"}
{"id": null, "n": "0298002", "target": "#nkr_note_mod_0298002", "type": "mod", "text": "色【大】，色三光【甲】"}
{"id": null, "n": "0298003", "target": "#nkr_note_mod_0298003", "type": "mod", "text": "娑【大】，婆【甲】"}
{"id": null, "n": "0301001", "target": "#nkr_note_mod_0301001", "type": "mod", "text": "求【大】，願求【甲】"}
{"id": null, "n": "0301002", "target": "#nkr_note_mod_0301002", "type": "mod", "text": "向【大】，心【甲】"}
{"id": null, "n": "0302001", "target": "#nkr_note_mod_0302001", "type": "mod", "text": "即【大】，即得【甲】"}
{"id": null, "n": "0302002", "target": "#nkr_note_mod_0302002", "type": "mod", "text": "末【大】，未【考偽-大】"}
{"id": null, "n": "0302003", "target": "#nkr_note_mod_0302003", "type": "mod", "text": "也【大】，色【甲】"}
{"id": null, "n": "0303001", "target": "#nkr_note_mod_0303001", "type": "mod", "text": "惡因【CB】【卍續-CB】【甲】，因【大】"}
