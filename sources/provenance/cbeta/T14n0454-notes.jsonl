{"id": null, "n": "0423029", "target": "#nkr_note_mod_0423029", "type": "mod", "text": "塵坌【大】，坌塵【元】【宮】"}
{"id": null, "n": "0424001", "target": "#nkr_note_mod_0424001", "type": "mod", "text": "明【大】，照【宋】【元】【明】【宮】"}
