{"id": null, "n": "0294001", "target": "#nkr_note_mod_0294001", "type": "mod", "text": "又【大】，叉【宋】"}
{"id": null, "n": "0294002", "target": "#nkr_note_mod_0294002", "type": "mod", "text": "銷【大】＊，消【宋】【元】＊"}
