{"id": null, "n": "0293003", "target": "#nkr_note_mod_0293003", "type": "mod", "text": "蟲【大】＊，蠱【宋】＊"}
{"id": null, "n": "0293004", "target": "#nkr_note_mod_0293004", "type": "mod", "text": "蚖蝮【大】，蟒蛇【校異-甲】"}
{"id": null, "n": "0293005", "target": "#nkr_note_mod_0293005", "type": "mod", "text": "毒【大】，諸毒【校異-甲】"}
{"id": null, "n": "0293006", "target": "#nkr_note_mod_0293006", "type": "mod", "text": "漿【大】，漿及【校異-甲】"}
{"id": null, "n": "0293007", "target": "#nkr_note_mod_0293007", "type": "mod", "text": "梨【大】，梨童女【校異-甲】"}
{"id": null, "n": "0293008", "target": "#nkr_note_mod_0293008", "type": "mod", "text": "言【大】，言法【校異-甲】"}
{"id": null, "n": "0293009", "target": "#nkr_note_mod_0293009", "type": "mod", "text": "所【大】，傷【校異-甲】"}
{"id": null, "n": "0293010", "target": "#nkr_note_mod_0293010", "type": "mod", "text": "聲【大】＊，〔－〕【宋】【元】＊"}
{"id": null, "n": "0293011", "target": "#nkr_note_mod_0293011", "type": "mod", "text": "切【大】＊，反【宋】【元】＊"}
{"id": null, "n": "0293012", "target": "#nkr_note_mod_0293012", "type": "mod", "text": "三【大】，二【宋】【元】"}
{"id": null, "n": "0293013", "target": "#nkr_note_mod_0293013", "type": "mod", "text": "夜【大】，以【校異-原】"}
{"id": null, "n": "0293014", "target": "#nkr_note_mod_0293014", "type": "mod", "text": "陀【大】，此陀【宋】【元】"}
{"id": null, "n": "0293015", "target": "#nkr_note_mod_0293015", "type": "mod", "text": "䔠【大】，稍【宋】"}
{"id": null, "n": "0293016", "target": "#nkr_note_mod_0293016", "type": "mod", "text": "法【大】，法者【甲】"}
{"id": null, "n": "0293017", "target": "#nkr_note_mod_0293017", "type": "mod", "text": "引【大】，去引【宋】【元】"}
{"id": null, "n": "0293018", "target": "#nkr_note_mod_0293018", "type": "mod", "text": "報【大】，𧹞【校異-甲】"}
{"id": null, "n": "0293019", "target": "#nkr_note_mod_0293019", "type": "mod", "text": "引普吒囉蒵【大】，〔－〕【考偽-甲】"}
{"id": null, "n": "0293020", "target": "#nkr_note_mod_0293020", "type": "mod", "text": "揆【大】，捺【甲】"}
{"id": null, "n": "0293021", "target": "#nkr_note_mod_0293021", "type": "mod", "text": "蠱【大】，蟲【元】"}
{"id": null, "n": "0293022", "target": "#nkr_note_mod_0293022", "type": "mod", "text": "悉【大】，若已毒者悉【甲】"}
{"id": null, "n": "0293023", "target": "#nkr_note_mod_0293023", "type": "mod", "text": "復【大】，後【宋】【元】"}
{"id": null, "n": "0293024", "target": "#nkr_note_mod_0293024", "type": "mod", "text": "賀【大】，賀吠【宋】【元】"}
{"id": null, "n": "0293025", "target": "#nkr_note_mod_0293025", "type": "mod", "text": "嚩【大】，嚩日【甲】"}
{"id": null, "n": "0293026", "target": "#nkr_note_mod_0293026", "type": "mod", "text": "臾【大】，曳【宋】【元】【甲】"}
{"id": null, "n": "0293027", "target": "#nkr_note_mod_0293027", "type": "mod", "text": "三【大】，二【甲】"}
{"id": null, "n": "0293028", "target": "#nkr_note_mod_0293028", "type": "mod", "text": "搏【大】，博【宋】【元】"}
