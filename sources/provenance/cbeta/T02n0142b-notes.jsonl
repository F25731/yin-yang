{"id": null, "n": "0865001", "target": "#nkr_note_orig_0865001", "type": "orig", "text": "私＝和【宋】【元】"}
{"id": null, "n": "0865002", "target": "#nkr_note_orig_0865002", "type": "orig", "text": "女耶＝耶女【宋】【元】"}
