{"id": null, "n": "0864002", "target": "#nkr_note_mod_0864002", "type": "mod", "text": "失譯…錄【大】，失譯今附東晉錄【宋】，失譯今附西晉錄初出【元】"}
{"id": null, "n": "0864003", "target": "#nkr_note_mod_0864003", "type": "mod", "text": "公【大】＊，妐【宋】＊"}
{"id": null, "n": "0865001", "target": "#nkr_note_mod_0865001", "type": "mod", "text": "私【大】，和【宋】【元】"}
{"id": null, "n": "0865002", "target": "#nkr_note_mod_0865002", "type": "mod", "text": "女耶【大】，耶女【宋】【元】"}
{"id": null, "n": "0864001", "target": "#nkr_note_orig_0864001", "type": "orig", "text": "此經明本今以宋元對校之"}
