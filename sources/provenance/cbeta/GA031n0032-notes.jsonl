{"id": null, "n": null, "target": null, "type": null, "text": "今之龍井是也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "今喝石巖是也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "勒石現存。"}
{"id": null, "n": null, "target": null, "type": null, "text": "寺之玉芝巖、含暉亭，因名于此。"}
{"id": null, "n": null, "target": null, "type": null, "text": "具無上章。"}
{"id": null, "n": null, "target": null, "type": null, "text": "今禪牀二劒迹猶存。"}
{"id": null, "n": null, "target": null, "type": null, "text": "僖宗"}
{"id": null, "n": null, "target": null, "type": null, "text": "昭宗"}
{"id": null, "n": null, "target": null, "type": null, "text": "勤，即圓悟。"}
{"id": null, "n": null, "target": null, "type": null, "text": "擇木，乃朝士止息處。"}
{"id": null, "n": null, "target": null, "type": null, "text": "別録"}
{"id": null, "n": null, "target": null, "type": null, "text": "附"}
{"id": null, "n": null, "target": null, "type": null, "text": "補遺終"}
{"id": null, "n": null, "target": null, "type": null, "text": "附"}
{"id": null, "n": null, "target": null, "type": null, "text": "即馬祖"}
{"id": null, "n": null, "target": null, "type": null, "text": "石壁在徑山後，今廢。"}
{"id": null, "n": null, "target": null, "type": null, "text": "永樂十五年十月十\n五日"}
{"id": null, "n": null, "target": null, "type": null, "text": "萬曆二十八年\n九月初三日"}
{"id": null, "n": null, "target": null, "type": null, "text": "字毅夫，宋相國"}
{"id": null, "n": null, "target": null, "type": null, "text": "國子司業，金華人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號木石，錫山人"}
{"id": null, "n": null, "target": null, "type": null, "text": "蘇州人，修𢰅"}
{"id": null, "n": null, "target": null, "type": null, "text": "宋叅軍"}
{"id": null, "n": null, "target": null, "type": null, "text": "憨山"}
{"id": null, "n": null, "target": null, "type": null, "text": "達觀禪師"}
{"id": null, "n": null, "target": null, "type": null, "text": "字開之，南京祭酒"}
{"id": null, "n": null, "target": null, "type": null, "text": "字體中，薊遼總督"}
{"id": null, "n": null, "target": null, "type": null, "text": "聞谷禪師"}
{"id": null, "n": null, "target": null, "type": null, "text": "寒灰"}
{"id": null, "n": null, "target": null, "type": null, "text": "字密藏"}
{"id": null, "n": null, "target": null, "type": null, "text": "之福，植於"}
{"id": null, "n": null, "target": null, "type": null, "text": "戒山法師"}
{"id": null, "n": null, "target": null, "type": null, "text": "吳江人"}
{"id": null, "n": null, "target": null, "type": null, "text": "字仲醇，華亭人"}
{"id": null, "n": null, "target": null, "type": null, "text": "字孟芳，常熟人"}
{"id": null, "n": null, "target": null, "type": null, "text": "編修"}
{"id": null, "n": null, "target": null, "type": null, "text": "季潭泐為五十五代禪師，著有《全室外集》，古近體諸歌詩凡八卷，不能盡載，特存其二序云。"}
{"id": null, "n": null, "target": null, "type": null, "text": "侍讀學士"}
{"id": null, "n": null, "target": null, "type": null, "text": "進士"}
{"id": null, "n": null, "target": null, "type": null, "text": "楚中人"}
{"id": null, "n": null, "target": null, "type": null, "text": "字元實，常熟人"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "中國國家圖書館藏本"}
