{"id": null, "n": null, "target": null, "type": null, "text": "宏"}
{"id": null, "n": null, "target": null, "type": null, "text": "或作沼"}
{"id": null, "n": null, "target": null, "type": null, "text": "地藏"}
{"id": null, "n": null, "target": null, "type": null, "text": "法眼"}
{"id": null, "n": null, "target": null, "type": null, "text": "青原六世"}
{"id": null, "n": null, "target": null, "type": null, "text": "非我"}
{"id": null, "n": null, "target": null, "type": null, "text": "非渠"}
{"id": null, "n": null, "target": null, "type": null, "text": "仰汝取活"}
{"id": null, "n": null, "target": null, "type": null, "text": "不別有"}
{"id": null, "n": null, "target": null, "type": null, "text": "要且不是佛"}
{"id": null, "n": null, "target": null, "type": null, "text": "二俱不立"}
{"id": null, "n": null, "target": null, "type": null, "text": "若遇御飯。直須\n吐卻"}
{"id": null, "n": null, "target": null, "type": null, "text": "不通信"}
{"id": null, "n": null, "target": null, "type": null, "text": "為信唱"}
{"id": null, "n": null, "target": null, "type": null, "text": "不與你相似"}
{"id": null, "n": null, "target": null, "type": null, "text": "將謂是白雪"}
{"id": null, "n": null, "target": null, "type": null, "text": "汾陽注曰。素潔條然"}
{"id": null, "n": null, "target": null, "type": null, "text": "運機非面目"}
{"id": null, "n": null, "target": null, "type": null, "text": "蕩盡玲瓏\n性"}
{"id": null, "n": null, "target": null, "type": null, "text": "塵泥自異"}
{"id": null, "n": null, "target": null, "type": null, "text": "汾陽曰。妙智埋圓融"}
{"id": null, "n": null, "target": null, "type": null, "text": "無間功不立"}
{"id": null, "n": null, "target": null, "type": null, "text": "旁觀審騰距。爭功不自傷"}
{"id": null, "n": null, "target": null, "type": null, "text": "全力能負。不露頭角"}
{"id": null, "n": null, "target": null, "type": null, "text": "法眼"}
{"id": null, "n": null, "target": null, "type": null, "text": "音旁"}
{"id": null, "n": null, "target": null, "type": null, "text": "或作手"}
{"id": null, "n": null, "target": null, "type": null, "text": "師子峯在棲賢之後"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本曰。然行脚人。於世無求。敢希薦達哉"}
{"id": null, "n": null, "target": null, "type": null, "text": "或作意"}
{"id": null, "n": null, "target": null, "type": null, "text": "即興陽剖禪師"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云生於扈氏"}
{"id": null, "n": null, "target": null, "type": null, "text": "傳是舉道者"}
{"id": null, "n": null, "target": null, "type": null, "text": "千聖同源"}
{"id": null, "n": null, "target": null, "type": null, "text": "方可較些子"}
{"id": null, "n": null, "target": null, "type": null, "text": "有人不肯在"}
{"id": null, "n": null, "target": null, "type": null, "text": "青霄有路"}
{"id": null, "n": null, "target": null, "type": null, "text": "或一本云。名滿天下"}
{"id": null, "n": null, "target": null, "type": null, "text": "或一本云。富鄭公弼。得心要於顒華嚴。有偈寄本曰"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本云。自瞻顏而證之下。但云。則其大願真慈\n之力。無愧紹隆之職者也"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云。\n雲峰寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "或作於"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云志"}
{"id": null, "n": null, "target": null, "type": null, "text": "或作智"}
{"id": null, "n": null, "target": null, "type": null, "text": "或遠云。直饒不作境語會。亦未會在。何謂也云\n犀因玩月文生角。象被雷驚花入牙也"}
{"id": null, "n": null, "target": null, "type": null, "text": "或作楮林"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本云。黑頭生得白頭兒"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本知楷疎憃"}
{"id": null, "n": null, "target": null, "type": null, "text": "或作患之"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本云。闍梨無可布施。施肚為汝作棺材"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云依金地寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "或有汝汝"}
{"id": null, "n": null, "target": null, "type": null, "text": "󳪙󳫡𬺹才"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云。閱世六十有六。坐三十有七夏"}
{"id": null, "n": null, "target": null, "type": null, "text": "遠公所酌之泉。在方\n丈之西也"}
{"id": null, "n": null, "target": null, "type": null, "text": "御名"}
{"id": null, "n": null, "target": null, "type": null, "text": "即雲庵也"}
{"id": null, "n": null, "target": null, "type": null, "text": "時英邵武在同安。作首座。閑欲徃見之"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云七月\n七日"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本云。豈佛法有無之"}
{"id": null, "n": null, "target": null, "type": null, "text": "叢林號秀為鐵面"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云惠日禪師"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云潭州道吾"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云周氏"}
{"id": null, "n": null, "target": null, "type": null, "text": "或鵬禪師"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云常被塵勞羈鏁"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云西天"}
{"id": null, "n": null, "target": null, "type": null, "text": "或作哲宗"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云千眾"}
{"id": null, "n": null, "target": null, "type": null, "text": "或三"}
{"id": null, "n": null, "target": null, "type": null, "text": "或室"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本云。故明祖師西來之\n意也"}
{"id": null, "n": null, "target": null, "type": null, "text": "或作戲"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云法器"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云何疾\n法之弊"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "音來"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "廣聞"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T51n2076_p0331a03"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "X77n1522_p0137a05"}
{"id": null, "n": null, "target": null, "type": "cf3", "text": "X80n1565_p0127c16"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "J20nB101_p0592c25"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "《嘉興藏》（日本東京大學綜合圖書館藏續編第2帙第125冊第74圖左欄第4行）"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "X77n1524_p0415c16"}
{"id": null, "n": "0516001", "target": "#nkr_note_mod_0516001", "type": "mod", "text": "己下一有自己二字"}
{"id": null, "n": "0490001", "target": "#nkr_note_orig_0490001", "type": "orig", "text": "之一作出"}
{"id": null, "n": "0492001", "target": "#nkr_note_orig_0492001", "type": "orig", "text": "其一作宜"}
{"id": null, "n": "0492002", "target": "#nkr_note_orig_0492002", "type": "orig", "text": "必一作不"}
{"id": null, "n": "0492003", "target": "#nkr_note_orig_0492003", "type": "orig", "text": "兒一作女"}
{"id": null, "n": "0492004", "target": "#nkr_note_orig_0492004", "type": "orig", "text": "真一作他"}
{"id": null, "n": "0493001", "target": "#nkr_note_orig_0493001", "type": "orig", "text": "慢一作侵"}
{"id": null, "n": "0495001", "target": "#nkr_note_orig_0495001", "type": "orig", "text": "無或作何"}
{"id": null, "n": "0496001", "target": "#nkr_note_orig_0496001", "type": "orig", "text": "力下一有□字"}
{"id": null, "n": "0499001", "target": "#nkr_note_orig_0499001", "type": "orig", "text": "似一作是"}
{"id": null, "n": "0500001", "target": "#nkr_note_orig_0500001", "type": "orig", "text": "至通致"}
{"id": null, "n": "0500002", "target": "#nkr_note_orig_0500002", "type": "orig", "text": "時一作是"}
{"id": null, "n": "0500003", "target": "#nkr_note_orig_0500003", "type": "orig", "text": "齒一作舌"}
{"id": null, "n": "0501001", "target": "#nkr_note_orig_0501001", "type": "orig", "text": "席一作習"}
{"id": null, "n": "0504001", "target": "#nkr_note_orig_0504001", "type": "orig", "text": "淡一作談"}
{"id": null, "n": "0514001", "target": "#nkr_note_orig_0514001", "type": "orig", "text": "一無天字"}
{"id": null, "n": "0514002", "target": "#nkr_note_orig_0514002", "type": "orig", "text": "解后通邂逅"}
{"id": null, "n": "0515001", "target": "#nkr_note_orig_0515001", "type": "orig", "text": "宿下一有耆宿二字"}
{"id": null, "n": "0515002", "target": "#nkr_note_orig_0515002", "type": "orig", "text": "峯下一有翠峯二字"}
{"id": null, "n": "0516001", "target": "#nkr_note_orig_0516001", "type": "orig", "text": "巳下一有自巳二字"}
{"id": null, "n": "0516002", "target": "#nkr_note_orig_0516002", "type": "orig", "text": "風上一有被知解三字"}
{"id": null, "n": "0517001", "target": "#nkr_note_orig_0517001", "type": "orig", "text": "一無大悲二字"}
{"id": null, "n": "0517002", "target": "#nkr_note_orig_0517002", "type": "orig", "text": "備下一有若見未圓備五字"}
{"id": null, "n": "0517003", "target": "#nkr_note_orig_0517003", "type": "orig", "text": "見下一有知見二字"}
{"id": null, "n": "0517004", "target": "#nkr_note_orig_0517004", "type": "orig", "text": "四一作日"}
{"id": null, "n": "0520001", "target": "#nkr_note_orig_0520001", "type": "orig", "text": "觸下一有莫相觸三字"}
{"id": null, "n": "0521001", "target": "#nkr_note_orig_0521001", "type": "orig", "text": "昇下一有禪師昇三字"}
{"id": null, "n": "0525001", "target": "#nkr_note_orig_0525001", "type": "orig", "text": "心下一有我心二字"}
{"id": null, "n": "0525002", "target": "#nkr_note_orig_0525002", "type": "orig", "text": "或一作成"}
