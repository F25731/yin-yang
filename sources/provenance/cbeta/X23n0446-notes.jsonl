{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名尊那菩薩"}
{"id": null, "n": null, "target": null, "type": null, "text": "貫寶華為鬘"}
{"id": null, "n": null, "target": null, "type": null, "text": "澡罐也"}
{"id": null, "n": null, "target": null, "type": null, "text": "螺也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即淨瓶也"}
{"id": null, "n": null, "target": null, "type": null, "text": "某甲"}
{"id": null, "n": null, "target": null, "type": null, "text": "某甲"}
