{"id": null, "n": null, "target": null, "type": "cf1", "text": "K11n0281_p0629b23"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T16n0692_p0788b18"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K11n0281_p0629b23"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T16n0692_p0788b20"}
{"id": null, "n": "0788004", "target": "#nkr_note_mod_0788004", "type": "mod", "text": "闕譯人名出後漢錄【大】，失譯附漢錄【宋】【宮】，失譯師名附後漢錄【元】【明】"}
{"id": null, "n": "0788005", "target": "#nkr_note_mod_0788005", "type": "mod", "text": "目【大】，貌【宋】【元】【明】【宮】"}
{"id": null, "n": "0788006", "target": "#nkr_note_mod_0788006", "type": "mod", "text": "政【大】＊，正【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0788007", "target": "#nkr_note_mod_0788007", "type": "mod", "text": "生【大】，生於【宋】【元】【明】【宮】"}
{"id": null, "n": "0788008", "target": "#nkr_note_mod_0788008", "type": "mod", "text": "王【大】，主【宋】【元】【明】【宮】"}
{"id": null, "n": "0788009", "target": "#nkr_note_mod_0788009", "type": "mod", "text": "為【大】，或為【宋】【元】【明】【宮】"}
{"id": null, "n": "0788010", "target": "#nkr_note_mod_0788010", "type": "mod", "text": "得【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0788011", "target": "#nkr_note_mod_0788011", "type": "mod", "text": "上【大】，飛行上【宋】【元】【明】【宮】"}
{"id": null, "n": "0788012a", "target": "#nkr_note_mod_0788012a", "type": "mod", "text": "福【大】，德福【宮】"}
{"id": null, "n": "0788012b", "target": "#nkr_note_mod_0788012b", "type": "mod", "text": "〔－〕【CB】【麗-CB】【宮】，得【大】"}
{"id": null, "n": "0788013", "target": "#nkr_note_mod_0788013", "type": "mod", "text": "前【大】，昔是前【宋】【元】【明】【宮】"}
{"id": null, "n": "0788014", "target": "#nkr_note_mod_0788014", "type": "mod", "text": "故【大】，〔－〕【宮】"}
{"id": null, "n": "0788015", "target": "#nkr_note_mod_0788015", "type": "mod", "text": "道【大】，形像【宮】"}
{"id": null, "n": "0788016", "target": "#nkr_note_mod_0788016", "type": "mod", "text": "十【大】，〔－〕【宮】"}
{"id": null, "n": "0788017", "target": "#nkr_note_mod_0788017", "type": "mod", "text": "得福【大】，福得【宋】【元】【明】【宮】"}
{"id": null, "n": "0788004", "target": "#nkr_note_orig_0788004", "type": "orig", "text": "闕譯人名出後漢錄＝失譯附漢錄【宋】【宮】，失譯師名附後漢錄【元】【明】"}
{"id": null, "n": "0788005", "target": "#nkr_note_orig_0788005", "type": "orig", "text": "目＝貌【三】【宮】"}
{"id": null, "n": "0788006", "target": "#nkr_note_orig_0788006", "type": "orig", "text": "政＝正【三】【宮】＊"}
{"id": null, "n": "0788007", "target": "#nkr_note_orig_0788007", "type": "orig", "text": "生＋（於）【三】【宮】"}
{"id": null, "n": "0788008", "target": "#nkr_note_orig_0788008", "type": "orig", "text": "王＝主【三】【宮】"}
{"id": null, "n": "0788009", "target": "#nkr_note_orig_0788009", "type": "orig", "text": "（或）＋為【三】【宮】"}
{"id": null, "n": "0788010", "target": "#nkr_note_orig_0788010", "type": "orig", "text": "〔得〕－【三】【宮】"}
{"id": null, "n": "0788011", "target": "#nkr_note_orig_0788011", "type": "orig", "text": "（飛行）＋上【三】【宮】"}
{"id": null, "n": "0788012", "target": "#nkr_note_orig_0788012", "type": "orig", "text": "福得＝德福【宮】"}
{"id": null, "n": "0788013", "target": "#nkr_note_orig_0788013", "type": "orig", "text": "（昔是）＋前【三】【宮】"}
{"id": null, "n": "0788014", "target": "#nkr_note_orig_0788014", "type": "orig", "text": "〔故〕－【宮】"}
{"id": null, "n": "0788015", "target": "#nkr_note_orig_0788015", "type": "orig", "text": "道＝形像【宮】"}
{"id": null, "n": "0788016", "target": "#nkr_note_orig_0788016", "type": "orig", "text": "〔十〕－【宮】"}
{"id": null, "n": "0788017", "target": "#nkr_note_orig_0788017", "type": "orig", "text": "得福＝福得【三】【宮】"}
{"id": null, "n": "0788b2201", "target": "#nkr_note_add_0788b2201", "type": "add", "text": "得【CB】【麗-CB】，［－］【大】"}
