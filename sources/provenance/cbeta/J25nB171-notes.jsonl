{"id": null, "n": null, "target": null, "type": null, "text": "原書附"}
{"id": null, "n": null, "target": null, "type": null, "text": "師答：你還跳得出麼？"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：西天東土亦如是。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：你那裏摸索？"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：你不達古人方便，死了不得活。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：自生分別。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：將謂你鑿壁偷光。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：呵呵大笑。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：未舉先知。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：瞎漢。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：尚且不會。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：可見你有人我相。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：則恐你還不識。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：未到你在。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：從來不妄語。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：諸方早已見矣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：何曾隱晦來。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：不識好惡在。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：諜諜迷源，話頭也不識。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：待你腳跟點地方知。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：你也出不得。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：看取老僧上下文。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：錯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：錯錯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：你未夢見在。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：轉\n見不堪。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：放你三十棒。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：自\n領去。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：𧄼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：以楔出\n楔。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：我也知你作實法會。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答，以己方人，埋沒先聖。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：親言出親口。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：你未知落處在。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：待你徹後見。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：再參三十年與你道。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：照顧腳\n下。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：賞罰分明。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：闍黎切忌道著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：老僧決不謾你。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：想你不識。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：門外漢。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：恐你瞞頇。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：倚天長劍。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：威風凜凜。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：全提正令誰敢當鋒。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：杲日當天。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：虛空霹\n靂。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：風馳電捲不留剩跡。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：恰是。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：面皮厚\n多少。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：掩耳偷鈴。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：一分少你不得。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：簡了也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：寐語在。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：謗佛謗法謗僧。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：老僧不如你，音者聲之外者也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：扯東蓋西。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：劍去久矣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：果然。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：未知之咎也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答，可憐生。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：可知禮也？"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：難道。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：墮也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：負也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：大妄語漢。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：昧。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：你還跳\n得出麼？"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：下士聞\n道。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：自語相違漢。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：過。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：你那見他著實處？"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：作賊人心虛。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：也不消得。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：青天白日。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：放過則不可。"}
