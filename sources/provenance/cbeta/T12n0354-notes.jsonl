{"id": null, "n": "0223005", "target": "#nkr_note_mod_0223005", "type": "mod", "text": "之【大】，〔－〕【明】"}
{"id": null, "n": "0223006", "target": "#nkr_note_mod_0223006", "type": "mod", "text": "正求【大】，求正【元】【明】"}
{"id": null, "n": "0223007", "target": "#nkr_note_mod_0223007", "type": "mod", "text": "曇林【大】，曇琳【元】【明】"}
{"id": null, "n": "0223008", "target": "#nkr_note_mod_0223008", "type": "mod", "text": "客【大】，名【元】【明】"}
{"id": null, "n": "0223009", "target": "#nkr_note_mod_0223009", "type": "mod", "text": "建初【大】，建効【宋】【宮】，建功【元】【明】"}
{"id": null, "n": "0223010", "target": "#nkr_note_mod_0223010", "type": "mod", "text": "畢功【大】，日功訖【宋】【宮】"}
{"id": null, "n": "0223011", "target": "#nkr_note_mod_0223011", "type": "mod", "text": "元魏婆羅門瞿曇般若流支譯【大】，〔－〕【聖】，後魏三藏法師菩提留支譯【宋】【宮】，後魏三藏法師瞿曇般若流支譯【元】【明】"}
{"id": null, "n": "0223012", "target": "#nkr_note_mod_0223012", "type": "mod", "text": "婆伽婆【大】，婆迦婆【明】"}
{"id": null, "n": "0223013", "target": "#nkr_note_mod_0223013", "type": "mod", "text": "辦【大】，辨【宋】"}
{"id": null, "n": "0223014", "target": "#nkr_note_mod_0223014", "type": "mod", "text": "加趺【大】，跏趺【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0223015", "target": "#nkr_note_mod_0223015", "type": "mod", "text": "法【大】，住【元】【明】"}
{"id": null, "n": "0223016", "target": "#nkr_note_mod_0223016", "type": "mod", "text": "娑羅【大】，婆羅【宋】【元】【明】【宮】"}
{"id": null, "n": "0223017", "target": "#nkr_note_mod_0223017", "type": "mod", "text": "居【大】，拘【元】【明】"}
{"id": null, "n": "0223018", "target": "#nkr_note_mod_0223018", "type": "mod", "text": "憐【大】，隣【元】【明】【聖】"}
{"id": null, "n": "0223019", "target": "#nkr_note_mod_0223019", "type": "mod", "text": "娑【大】，婆【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0224001", "target": "#nkr_note_mod_0224001", "type": "mod", "text": "若【大】，苫【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0224002", "target": "#nkr_note_mod_0224002", "type": "mod", "text": "囉【大】，羅【宋】【元】【明】【宮】"}
{"id": null, "n": "0224003", "target": "#nkr_note_mod_0224003", "type": "mod", "text": "妙【大】，彼【聖】"}
{"id": null, "n": "0224004", "target": "#nkr_note_mod_0224004", "type": "mod", "text": "伽他【大】，伽陀【明】"}
{"id": null, "n": "0224005", "target": "#nkr_note_mod_0224005", "type": "mod", "text": "光洋【大】，汪洋【宋】【元】【明】【宮】"}
{"id": null, "n": "0224006", "target": "#nkr_note_mod_0224006", "type": "mod", "text": "齋【大】＊，齊【聖】＊"}
{"id": null, "n": "0224007", "target": "#nkr_note_mod_0224007", "type": "mod", "text": "寅【大】，晨【聖】"}
{"id": null, "n": "0224008", "target": "#nkr_note_mod_0224008", "type": "mod", "text": "自【大】，自名【聖】"}
{"id": null, "n": "0224009", "target": "#nkr_note_mod_0224009", "type": "mod", "text": "大【大】，火【宋】【元】【明】【宮】"}
{"id": null, "n": "0224010", "target": "#nkr_note_mod_0224010", "type": "mod", "text": "等【大】，〔－〕【聖】"}
{"id": null, "n": "0224011", "target": "#nkr_note_mod_0224011", "type": "mod", "text": "詳【大】，庠【聖】"}
{"id": null, "n": "0224012", "target": "#nkr_note_mod_0224012", "type": "mod", "text": "好縫【大】，好線【宋】【元】【明】【宮】，如線【聖】"}
{"id": null, "n": "0224013", "target": "#nkr_note_mod_0224013", "type": "mod", "text": "奇【大】，岐【宋】【元】【明】【宮】，〔－〕【聖】"}
{"id": null, "n": "0224014", "target": "#nkr_note_mod_0224014", "type": "mod", "text": "杖【大】，枝【宮】"}
{"id": null, "n": "0224015", "target": "#nkr_note_mod_0224015", "type": "mod", "text": "阿【大】，〔－〕【聖】"}
{"id": null, "n": "0224016", "target": "#nkr_note_mod_0224016", "type": "mod", "text": "唯【大】，惟【宋】【元】【明】【宮】"}
{"id": null, "n": "0224017", "target": "#nkr_note_mod_0224017", "type": "mod", "text": "死【大】，無【宮】"}
{"id": null, "n": "0224018", "target": "#nkr_note_mod_0224018", "type": "mod", "text": "段【大】，叚【宋】【元】【宮】"}
{"id": null, "n": "0224019", "target": "#nkr_note_mod_0224019", "type": "mod", "text": "辯【大】，辨【聖】"}
{"id": null, "n": "0224020", "target": "#nkr_note_mod_0224020", "type": "mod", "text": "說【大】，毘【宮】"}
{"id": null, "n": "0224021", "target": "#nkr_note_mod_0224021", "type": "mod", "text": "說【大】，諸【聖】"}
{"id": null, "n": "0224022", "target": "#nkr_note_mod_0224022", "type": "mod", "text": "種種【大】，二種【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0224023", "target": "#nkr_note_mod_0224023", "type": "mod", "text": "如【大】，知【宋】【元】【明】【宮】"}
{"id": null, "n": "0224024", "target": "#nkr_note_mod_0224024", "type": "mod", "text": "非所【大】，則非【聖】"}
{"id": null, "n": "0224025", "target": "#nkr_note_mod_0224025", "type": "mod", "text": "言【大】，告【聖】"}
{"id": null, "n": "0225001", "target": "#nkr_note_mod_0225001", "type": "mod", "text": "三十三【大】＊，三十二【聖】＊"}
{"id": null, "n": "0225002", "target": "#nkr_note_mod_0225002", "type": "mod", "text": "施【大】，捨【宋】【元】【明】【宮】"}
{"id": null, "n": "0225003", "target": "#nkr_note_mod_0225003", "type": "mod", "text": "教【大】，殺【聖】"}
{"id": null, "n": "0225004", "target": "#nkr_note_mod_0225004", "type": "mod", "text": "非【大】，非淨【宋】【元】【明】【宮】"}
{"id": null, "n": "0225005", "target": "#nkr_note_mod_0225005", "type": "mod", "text": "受【大】，授【宋】【元】【明】【宮】"}
{"id": null, "n": "0225006", "target": "#nkr_note_mod_0225006", "type": "mod", "text": "有【大】，在【宋】【元】【明】【宮】"}
{"id": null, "n": "0225007", "target": "#nkr_note_mod_0225007", "type": "mod", "text": "鍾【大】，屬【聖】"}
{"id": null, "n": "0225008", "target": "#nkr_note_mod_0225008", "type": "mod", "text": "迭【大】＊，遞【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0225009", "target": "#nkr_note_mod_0225009", "type": "mod", "text": "牙【大】，芽【宋】【元】【明】【宮】"}
{"id": null, "n": "0225010", "target": "#nkr_note_mod_0225010", "type": "mod", "text": "開眼【大】，眼開【聖】"}
{"id": null, "n": "0225011", "target": "#nkr_note_mod_0225011", "type": "mod", "text": "緣【大】，樂【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0225012", "target": "#nkr_note_mod_0225012", "type": "mod", "text": "老人【大】，長老【明】"}
{"id": null, "n": "0225013", "target": "#nkr_note_mod_0225013", "type": "mod", "text": "訓狐【大】，熏胡【宋】【元】【明】【宮】，薰胡【聖】"}
{"id": null, "n": "0226001", "target": "#nkr_note_mod_0226001", "type": "mod", "text": "果福【大】，福果【宋】【元】【明】【宮】"}
{"id": null, "n": "0226002", "target": "#nkr_note_mod_0226002", "type": "mod", "text": "甘蔗【大】＊，苷蔗【宋】【元】【宮】＊"}
{"id": null, "n": "0226003", "target": "#nkr_note_mod_0226003", "type": "mod", "text": "蒲桃【大】＊，蒱桃【宋】【宮】，蒲萄【明】＊"}
{"id": null, "n": "0226004", "target": "#nkr_note_mod_0226004", "type": "mod", "text": "人【大】，人人【宋】【宮】"}
{"id": null, "n": "0226005", "target": "#nkr_note_mod_0226005", "type": "mod", "text": "內【大】，中【宋】【元】【明】【宮】"}
{"id": null, "n": "0226006", "target": "#nkr_note_mod_0226006", "type": "mod", "text": "憧【大】，幢【宋】【元】【明】【宮】"}
{"id": null, "n": "0226007", "target": "#nkr_note_mod_0226007", "type": "mod", "text": "鉀【大】＊，甲【聖】＊"}
{"id": null, "n": "0226008", "target": "#nkr_note_mod_0226008", "type": "mod", "text": "治界【大】，持戒【宋】【元】【明】【宮】"}
{"id": null, "n": "0226009", "target": "#nkr_note_mod_0226009", "type": "mod", "text": "誡【大】，戒【宋】【元】【明】【宮】"}
{"id": null, "n": "0226010", "target": "#nkr_note_mod_0226010", "type": "mod", "text": "入【大】，人【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0226011", "target": "#nkr_note_mod_0226011", "type": "mod", "text": "汎漲【大】＊，汎長【宋】【元】【明】【宮】【聖】＊"}
{"id": null, "n": "0226012", "target": "#nkr_note_mod_0226012", "type": "mod", "text": "長奮【大】，盛飛【聖】"}
{"id": null, "n": "0226013", "target": "#nkr_note_mod_0226013", "type": "mod", "text": "虫【大】，蟲【宮】"}
{"id": null, "n": "0226014", "target": "#nkr_note_mod_0226014", "type": "mod", "text": "渡【大】，度【宋】【元】【明】【宮】"}
{"id": null, "n": "0227001", "target": "#nkr_note_mod_0227001", "type": "mod", "text": "渡【大】，濟【宋】【元】【明】【宮】"}
{"id": null, "n": "0227002", "target": "#nkr_note_mod_0227002", "type": "mod", "text": "人【大】，身【聖】"}
{"id": null, "n": "0227003", "target": "#nkr_note_mod_0227003", "type": "mod", "text": "退【大】，脫【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0227004", "target": "#nkr_note_mod_0227004", "type": "mod", "text": "渡【大】＊，度【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0227005", "target": "#nkr_note_mod_0227005", "type": "mod", "text": "羯那【大】下同，羶那【宋】【元】【明】【宮】【聖】下同"}
{"id": null, "n": "0227006", "target": "#nkr_note_mod_0227006", "type": "mod", "text": "爛身【大】，身爛【聖】"}
{"id": null, "n": "0227007", "target": "#nkr_note_mod_0227007", "type": "mod", "text": "善栰【大】，栰善【聖】"}
{"id": null, "n": "0227008", "target": "#nkr_note_mod_0227008", "type": "mod", "text": "二身【大】，三身【聖】"}
{"id": null, "n": "0227009", "target": "#nkr_note_mod_0227009", "type": "mod", "text": "皯䵴【大】，𩈅𪓱【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0227010", "target": "#nkr_note_mod_0227010", "type": "mod", "text": "壓【大】，𡨠【宋】【元】【明】【宮】，審【聖】"}
{"id": null, "n": "0227011", "target": "#nkr_note_mod_0227011", "type": "mod", "text": "何【大】，我【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0227012", "target": "#nkr_note_mod_0227012", "type": "mod", "text": "怒【大】，努【宋】【元】【明】【宮】"}
{"id": null, "n": "0227013", "target": "#nkr_note_mod_0227013", "type": "mod", "text": "地【大】，池【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0227014", "target": "#nkr_note_mod_0227014", "type": "mod", "text": "耶【大】，邪【宮】"}
{"id": null, "n": "0227015", "target": "#nkr_note_mod_0227015", "type": "mod", "text": "護【大】，說【聖】"}
{"id": null, "n": "0227016", "target": "#nkr_note_mod_0227016", "type": "mod", "text": "識知【大】，知識【明】"}
{"id": null, "n": "0227017", "target": "#nkr_note_mod_0227017", "type": "mod", "text": "喉【大】，惟【宋】【元】【明】【宮】"}
{"id": null, "n": "0228001", "target": "#nkr_note_mod_0228001", "type": "mod", "text": "天【大】，夫【聖】"}
{"id": null, "n": "0228002", "target": "#nkr_note_mod_0228002", "type": "mod", "text": "唯【大】下同，惟【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0228003", "target": "#nkr_note_mod_0228003", "type": "mod", "text": "騾【大】，縲【宋】【元】【明】"}
{"id": null, "n": "0228004", "target": "#nkr_note_mod_0228004", "type": "mod", "text": "揣【大】，摶【宋】【元】【明】【宮】"}
{"id": null, "n": "0228005", "target": "#nkr_note_mod_0228005", "type": "mod", "text": "命【大】，今【元】【明】【宮】"}
{"id": null, "n": "0228006", "target": "#nkr_note_mod_0228006", "type": "mod", "text": "願【大】，轉【聖】"}
{"id": null, "n": "0228007", "target": "#nkr_note_mod_0228007", "type": "mod", "text": "愛【大】，受【聖】"}
{"id": null, "n": "0228008", "target": "#nkr_note_mod_0228008", "type": "mod", "text": "迅【大】，躁【聖】"}
{"id": null, "n": "0228010", "target": "#nkr_note_mod_0228010", "type": "mod", "text": "元魏婆羅門瞿曇般若流支【大】，後魏三藏法師菩提留支【宋】【宮】，後魏三藏瞿曇般若流支【元】，後漢三藏法師瞿曇般若流支【明】"}
{"id": null, "n": "0228011", "target": "#nkr_note_mod_0228011", "type": "mod", "text": "王【大】，王天【宋】【元】【明】【宮】"}
{"id": null, "n": "0228012", "target": "#nkr_note_mod_0228012", "type": "mod", "text": "殖【大】，植【明】"}
{"id": null, "n": "0229001", "target": "#nkr_note_mod_0229001", "type": "mod", "text": "申【大】＊，伸【元】【明】＊"}
{"id": null, "n": "0229002", "target": "#nkr_note_mod_0229002", "type": "mod", "text": "礙【大】，閡【宋】【元】【明】【宮】"}
{"id": null, "n": "0229003", "target": "#nkr_note_mod_0229003", "type": "mod", "text": "綵【大】，彩【宋】【元】【明】【宮】"}
{"id": null, "n": "0229004", "target": "#nkr_note_mod_0229004", "type": "mod", "text": "幡【大】，幅【宮】"}
{"id": null, "n": "0229005", "target": "#nkr_note_mod_0229005", "type": "mod", "text": "揣【大】，摶【宋】【元】【明】【宮】"}
{"id": null, "n": "0229006", "target": "#nkr_note_mod_0229006", "type": "mod", "text": "盤【大】＊，槃【宋】【宮】＊"}
{"id": null, "n": "0229007", "target": "#nkr_note_mod_0229007", "type": "mod", "text": "飯食【大】，飲食【宋】【元】【明】【宮】"}
{"id": null, "n": "0229008", "target": "#nkr_note_mod_0229008", "type": "mod", "text": "佉【大】，法【宋】"}
{"id": null, "n": "0229009", "target": "#nkr_note_mod_0229009", "type": "mod", "text": "為花名【大】，名為華【宋】【元】【明】【宮】"}
{"id": null, "n": "0229010", "target": "#nkr_note_mod_0229010", "type": "mod", "text": "𨽦【大】，隔【元】【明】【宮】"}
{"id": null, "n": "0229011", "target": "#nkr_note_mod_0229011", "type": "mod", "text": "勝【大】，諸【明】"}
