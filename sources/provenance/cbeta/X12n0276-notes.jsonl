{"id": null, "n": "0482001", "target": "#nkr_note_orig_0482001", "type": "orig", "text": "一本分上中下三卷"}
{"id": null, "n": "0482002", "target": "#nkr_note_orig_0482002", "type": "orig", "text": "󴓀疑攢"}
{"id": null, "n": "0482003", "target": "#nkr_note_orig_0482003", "type": "orig", "text": "明古杭異作後學"}
{"id": null, "n": "0483001", "target": "#nkr_note_orig_0483001", "type": "orig", "text": "賷異作齎"}
{"id": null, "n": "0483002", "target": "#nkr_note_orig_0483002", "type": "orig", "text": "也異作矣"}
{"id": null, "n": "0483003", "target": "#nkr_note_orig_0483003", "type": "orig", "text": "異無矣字"}
