{"id": null, "n": "0781019", "target": "#nkr_note_orig_0781019", "type": "orig", "text": "汝＝法【元】"}
{"id": null, "n": "0781020", "target": "#nkr_note_orig_0781020", "type": "orig", "text": "（此法）＋當【三】【宮】"}
