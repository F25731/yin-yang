{"id": null, "n": "0781006", "target": "#nkr_note_mod_0781006", "type": "mod", "text": "（人名…錄）六字【大】，〔－〕【宋】【宮】，（（人名…錄））六字＝師名【元】【明】"}
{"id": null, "n": "0781007", "target": "#nkr_note_mod_0781007", "type": "mod", "text": "住【大】，在【明】"}
{"id": null, "n": "0781008", "target": "#nkr_note_mod_0781008", "type": "mod", "text": "復【大】，若【宋】【元】【明】【宮】"}
{"id": null, "n": "0781009", "target": "#nkr_note_mod_0781009", "type": "mod", "text": "坐【大】，坐坐【宋】【元】【明】【宮】"}
{"id": null, "n": "0781010", "target": "#nkr_note_mod_0781010", "type": "mod", "text": "伎【大】，妓【元】【明】"}
{"id": null, "n": "0781011", "target": "#nkr_note_mod_0781011", "type": "mod", "text": "末【大】，粖【宋】【元】【宮】"}
{"id": null, "n": "0781012", "target": "#nkr_note_mod_0781012", "type": "mod", "text": "人中【大】，中人【宋】【元】【明】【宮】"}
{"id": null, "n": "0781013", "target": "#nkr_note_mod_0781013", "type": "mod", "text": "青【大】＊，清【宋】【宮】＊"}
{"id": null, "n": "0781014", "target": "#nkr_note_mod_0781014", "type": "mod", "text": "紺【大】，井【元】【宮】"}
{"id": null, "n": "0781015", "target": "#nkr_note_mod_0781015", "type": "mod", "text": "復【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0781016", "target": "#nkr_note_mod_0781016", "type": "mod", "text": "億【大】，億萬【宋】【宮】"}
{"id": null, "n": "0781017", "target": "#nkr_note_mod_0781017", "type": "mod", "text": "神通【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0781018", "target": "#nkr_note_mod_0781018", "type": "mod", "text": "經【大】，法【宋】【元】【明】【宮】"}
{"id": null, "n": "0781019", "target": "#nkr_note_mod_0781019", "type": "mod", "text": "汝【大】，法【元】"}
{"id": null, "n": "0781020", "target": "#nkr_note_mod_0781020", "type": "mod", "text": "當【大】，此法當【宋】【元】【明】【宮】"}
{"id": null, "n": "0782001", "target": "#nkr_note_mod_0782001", "type": "mod", "text": "（藥王…佛）十六字【大】，〔－〕【宋】【元】【明】【宮】"}
