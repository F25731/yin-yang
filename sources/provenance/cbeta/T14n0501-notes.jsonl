{"id": null, "n": "0770012", "target": "#nkr_note_mod_0770012", "type": "mod", "text": "法炬【大】，釋法炬【宋】【元】【明】【宮】"}
{"id": null, "n": "0770013", "target": "#nkr_note_mod_0770013", "type": "mod", "text": "故【大】，雇【宋】【元】【明】【宮】"}
{"id": null, "n": "0770014", "target": "#nkr_note_mod_0770014", "type": "mod", "text": "等神【大】，神等【元】【明】"}
{"id": null, "n": "0770015", "target": "#nkr_note_mod_0770015", "type": "mod", "text": "言【大】，〔－〕【聖】"}
{"id": null, "n": "0770016", "target": "#nkr_note_mod_0770016", "type": "mod", "text": "笥【大】，笱【宋】【元】【明】【宮】"}
{"id": null, "n": "0770017", "target": "#nkr_note_mod_0770017", "type": "mod", "text": "皆【大】，有【宮】"}
{"id": null, "n": "0770018", "target": "#nkr_note_mod_0770018", "type": "mod", "text": "待【大】，須【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0770019", "target": "#nkr_note_mod_0770019", "type": "mod", "text": "還【大】，運【宮】"}
{"id": null, "n": "0770020", "target": "#nkr_note_mod_0770020", "type": "mod", "text": "遇【大】，過【宮】"}
{"id": null, "n": "0770021", "target": "#nkr_note_mod_0770021", "type": "mod", "text": "民【大】，〔－〕【聖】"}
{"id": null, "n": "0770022", "target": "#nkr_note_mod_0770022", "type": "mod", "text": "遇【大】，過【宋】【元】【明】【宮】"}
{"id": null, "n": "0770023", "target": "#nkr_note_mod_0770023", "type": "mod", "text": "時【大】，笑【宮】"}
{"id": null, "n": "0770024", "target": "#nkr_note_mod_0770024", "type": "mod", "text": "正【大】，整【明】"}
{"id": null, "n": "0770025", "target": "#nkr_note_mod_0770025", "type": "mod", "text": "得【大】，張【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0770026", "target": "#nkr_note_mod_0770026", "type": "mod", "text": "犍【大】，揵【聖】"}
{"id": null, "n": "0770027", "target": "#nkr_note_mod_0770027", "type": "mod", "text": "命【大】，〔－〕【聖】"}
{"id": null, "n": "0770028", "target": "#nkr_note_mod_0770028", "type": "mod", "text": "佛【大】，佛佛【聖】"}
{"id": null, "n": "0770029", "target": "#nkr_note_mod_0770029", "type": "mod", "text": "皆【大】，〔－〕【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0770030", "target": "#nkr_note_mod_0770030", "type": "mod", "text": "奉【大】，捧【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0770031", "target": "#nkr_note_mod_0770031", "type": "mod", "text": "臣【大】，人【明】"}
{"id": null, "n": "0770032", "target": "#nkr_note_mod_0770032", "type": "mod", "text": "華香【大】，香華【宋】【元】【明】【宮】"}
{"id": null, "n": "0770033", "target": "#nkr_note_mod_0770033", "type": "mod", "text": "王【大】，五【明】"}
{"id": null, "n": "0770034", "target": "#nkr_note_mod_0770034", "type": "mod", "text": "盥【CB】【麗-CB】【宋】，𮍮【大】"}
{"id": null, "n": "0770035", "target": "#nkr_note_mod_0770035", "type": "mod", "text": "稱【大】，勝【宋】【元】【明】【宮】"}
{"id": null, "n": "0770036", "target": "#nkr_note_mod_0770036", "type": "mod", "text": "歡喜奉行【大】，皆歡喜作禮而去【宋】【元】【明】【宮】【聖】"}
