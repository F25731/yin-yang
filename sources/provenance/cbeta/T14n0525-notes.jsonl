{"id": null, "n": "0800001", "target": "#nkr_note_mod_0800001", "type": "mod", "text": "佛說【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0800002", "target": "#nkr_note_mod_0800002", "type": "mod", "text": "子【大】＊，〔－〕【明】＊"}
{"id": null, "n": "0800003", "target": "#nkr_note_mod_0800003", "type": "mod", "text": "安息國【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0800004", "target": "#nkr_note_mod_0800004", "type": "mod", "text": "三藏【大】，三藏法師【明】，沙門【宮】"}
{"id": null, "n": "0800005", "target": "#nkr_note_mod_0800005", "type": "mod", "text": "祠【大】，祀【宋】【元】【明】【宮】"}
{"id": null, "n": "0800006", "target": "#nkr_note_mod_0800006", "type": "mod", "text": "知【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0800007", "target": "#nkr_note_mod_0800007", "type": "mod", "text": "飲食【大】＊，飯食【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0800008", "target": "#nkr_note_mod_0800008", "type": "mod", "text": "乳【大】，乳者【宋】【元】【明】"}
{"id": null, "n": "0800009", "target": "#nkr_note_mod_0800009", "type": "mod", "text": "賓從【大】，賓客【宋】【元】【明】【宮】"}
{"id": null, "n": "0800010", "target": "#nkr_note_mod_0800010", "type": "mod", "text": "弱【大】，若【宋】【元】【明】【宮】"}
{"id": null, "n": "0800011", "target": "#nkr_note_mod_0800011", "type": "mod", "text": "劣【大】，小【宋】【元】【明】【宮】"}
{"id": null, "n": "0800012", "target": "#nkr_note_mod_0800012", "type": "mod", "text": "兩【大】，其【宋】【元】【明】"}
{"id": null, "n": "0800013", "target": "#nkr_note_mod_0800013", "type": "mod", "text": "由【大】，因【宋】【元】【明】【宮】"}
{"id": null, "n": "0800014", "target": "#nkr_note_mod_0800014", "type": "mod", "text": "憂【大】，愛【宋】【元】【明】【宮】"}
{"id": null, "n": "0800015", "target": "#nkr_note_mod_0800015", "type": "mod", "text": "長者【大】，長者聞是及一切眾皆有慈心發大道意應時【宋】【元】【明】"}
{"id": null, "n": "0800001", "target": "#nkr_note_orig_0800001", "type": "orig", "text": "〔佛說〕－【三】【宮】＊"}
{"id": null, "n": "0800002", "target": "#nkr_note_orig_0800002", "type": "orig", "text": "〔子〕－【明】＊"}
{"id": null, "n": "0800003", "target": "#nkr_note_orig_0800003", "type": "orig", "text": "〔安息國〕－【三】【宮】"}
{"id": null, "n": "0800004", "target": "#nkr_note_orig_0800004", "type": "orig", "text": "三藏＋（法師）【明】，三藏＝沙門【宮】"}
{"id": null, "n": "0800005", "target": "#nkr_note_orig_0800005", "type": "orig", "text": "祠＝祀【三】【宮】"}
{"id": null, "n": "0800006", "target": "#nkr_note_orig_0800006", "type": "orig", "text": "〔知〕－【三】【宮】"}
{"id": null, "n": "0800007", "target": "#nkr_note_orig_0800007", "type": "orig", "text": "飲食＝飯食【三】【宮】＊"}
{"id": null, "n": "0800008", "target": "#nkr_note_orig_0800008", "type": "orig", "text": "乳＋（者）【三】"}
{"id": null, "n": "0800009", "target": "#nkr_note_orig_0800009", "type": "orig", "text": "賓從＝賓客【三】【宮】"}
{"id": null, "n": "0800010", "target": "#nkr_note_orig_0800010", "type": "orig", "text": "弱＝若【三】【宮】"}
{"id": null, "n": "0800011", "target": "#nkr_note_orig_0800011", "type": "orig", "text": "劣＝小【三】【宮】"}
{"id": null, "n": "0800012", "target": "#nkr_note_orig_0800012", "type": "orig", "text": "兩＝其【三】"}
{"id": null, "n": "0800013", "target": "#nkr_note_orig_0800013", "type": "orig", "text": "由＝因【三】【宮】"}
{"id": null, "n": "0800014", "target": "#nkr_note_orig_0800014", "type": "orig", "text": "憂＝愛【三】【宮】"}
{"id": null, "n": "0800015", "target": "#nkr_note_orig_0800015", "type": "orig", "text": "長者＋（聞是及一切眾皆有慈心發大道意應時）【三】"}
