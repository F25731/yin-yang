{"id": null, "n": null, "target": null, "type": null, "text": "時己酉臘八日"}
{"id": null, "n": null, "target": null, "type": null, "text": "只在一滴"}
{"id": null, "n": null, "target": null, "type": null, "text": "時命山足斧住華嚴"}
{"id": null, "n": null, "target": null, "type": null, "text": "時倪止先請回白下"}
{"id": null, "n": null, "target": null, "type": null, "text": "以虎終"}
{"id": null, "n": null, "target": null, "type": null, "text": "木主"}
{"id": null, "n": null, "target": null, "type": null, "text": "廩山孤立數百仞，舊題參天一筆。"}
