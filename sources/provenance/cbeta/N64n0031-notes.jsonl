{"id": null, "n": null, "target": null, "type": "cf1", "text": "N64n0031_p0160a03"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "N64n0031_p0160a08"}
{"id": null, "n": "0059001", "target": "#nkr_note_mod_0059001", "type": "mod", "text": "J. no. 470 kālingabodhi-jātaka 參照。於本生經唯有迦陵誐王而無沙摩哥蘭若之名。（CBETA 按：漢譯南傳大藏經此頁中缺相對應之註標[01]，今於此處加上[01]之註標。）"}
{"id": null, "n": "0065001", "target": "#nkr_note_mod_0065001", "type": "mod", "text": "底本 Vuttaṁ 依羅馬字本改為 Vattuṁ（CBETA 按：漢譯南傳大藏經此頁中缺相對應之註標[01]，今於此處加上[01]之註標。）"}
{"id": null, "n": "0192033", "target": "#nkr_note_mod_0192033", "type": "mod", "text": "A. I. 13. 7（漢譯南傳一九、三〇頁）。（CBETA 按：漢譯南傳大藏經此頁中缺相對應之註標[33]，今於此處加上[33]之註標。）"}
{"id": null, "n": "0214005", "target": "#nkr_note_mod_0214005", "type": "mod", "text": "S. V. LVI. 1. 7。（CBETA 按：漢譯南傳大藏經此頁中缺相對應之註標[05]，今於此處加上[05]之註標。）"}
{"id": null, "n": "0001001", "target": "#nkr_note_orig_0001001", "type": "orig", "text": "A. I. p. 23; 增一阿含四（大正二、五五七b）。"}
{"id": null, "n": "0001002", "target": "#nkr_note_orig_0001002", "type": "orig", "text": "corehi 於羅馬字本無。"}
{"id": null, "n": "0001003", "target": "#nkr_note_orig_0001003", "type": "orig", "text": "讀為 miñjaparigatto parikatto（√kṛt）。羅馬字本為 majja。"}
{"id": null, "n": "0001004", "target": "#nkr_note_orig_0001004", "type": "orig", "text": "底本為 taṇḍulasambalo viya ahosi ten' eva upaddavena so parinibbuto。sambala 之語不明。"}
{"id": null, "n": "0002005", "target": "#nkr_note_orig_0002005", "type": "orig", "text": "kāraṇe 羅馬字本為 pakarane。"}
{"id": null, "n": "0002001", "target": "#nkr_note_orig_0002001", "type": "orig", "text": "雖譯為法性（dhammatā）是慣例之意。"}
{"id": null, "n": "0003002", "target": "#nkr_note_orig_0003002", "type": "orig", "text": "此文依羅馬字本補充。"}
{"id": null, "n": "0003003", "target": "#nkr_note_orig_0003003", "type": "orig", "text": "anāgataṁ kālaṁ 言至正午之時間。比丘若過午不得食。"}
{"id": null, "n": "0004001", "target": "#nkr_note_orig_0004001", "type": "orig", "text": "波羅夷第三、五、一三參照。投身者突吉羅。"}
{"id": null, "n": "0004002", "target": "#nkr_note_orig_0004002", "type": "orig", "text": "底本 kilesavisavināsano 羅馬字本為於格。以下之情形皆同。"}
{"id": null, "n": "0005003", "target": "#nkr_note_orig_0005003", "type": "orig", "text": "A. I. p. 24 參照。"}
{"id": null, "n": "0006004", "target": "#nkr_note_orig_0006004", "type": "orig", "text": "以下各種之刑罰 M. I. 87; A. I. 47; II. 122; MNd. 604; 見本書第八頁、一二九頁等。"}
{"id": null, "n": "0006005", "target": "#nkr_note_orig_0006005", "type": "orig", "text": "於底本其次有 āvāṭha-gakkara-susarukkha-kallola-umi- 亦難解。羅馬字本是有 āvaṭṭa-gaggalaka-ūmikavaṅkacadika。"}
{"id": null, "n": "0007001", "target": "#nkr_note_orig_0007001", "type": "orig", "text": "A. IV. p. 150; V. p. 342 增一阿含四九、一〇（大正二、八〇六a）。"}
{"id": null, "n": "0007002", "target": "#nkr_note_orig_0007002", "type": "orig", "text": "J, no. 540 Sāmajātaka（漢譯南傳三一、睒摩賢者本生譚十六頁以下參照）。"}
{"id": null, "n": "0007003", "target": "#nkr_note_orig_0007003", "type": "orig", "text": "底本雖有 Pilayakkha 依羅馬字本及本生經之文改為 Piliyakkha。"}
{"id": null, "n": "0010001", "target": "#nkr_note_orig_0010001", "type": "orig", "text": "J. no. 474 Amba-jātaka（漢譯南傳三七、菴羅果本生譚）參照。"}
{"id": null, "n": "0010002", "target": "#nkr_note_orig_0010002", "type": "orig", "text": "J. no. 122 Dummedhajātaka（漢譯南傳三二、愚者本生譚）參照。"}
{"id": null, "n": "0010003", "target": "#nkr_note_orig_0010003", "type": "orig", "text": "J. no. 516 Mahākapi-jātaka（漢譯南傳三八、大猿本生譚）參照。"}
{"id": null, "n": "0010004", "target": "#nkr_note_orig_0010004", "type": "orig", "text": "J. no. 514 Chaddanta-jātaka（漢譯南傳三八、六色牙本生譚）參照。"}
{"id": null, "n": "0010005", "target": "#nkr_note_orig_0010005", "type": "orig", "text": "J. no. 438 Tittira-jātaka（漢譯南傳三六、鷓鴣本生譚）參照。"}
{"id": null, "n": "0010006", "target": "#nkr_note_orig_0010006", "type": "orig", "text": "J. no. 313 Khantivādi-jātaka（漢譯南傳三四、堪忍宗本生譚）參照。"}
{"id": null, "n": "0010007", "target": "#nkr_note_orig_0010007", "type": "orig", "text": "括弧內之文底本無，依羅馬字本而補充。"}
{"id": null, "n": "0010008", "target": "#nkr_note_orig_0010008", "type": "orig", "text": "J. no. 222 Cullanandiya-jātaka（漢譯南傳二八、小蘭提耶猿本生譚）參照。"}
{"id": null, "n": "0010009", "target": "#nkr_note_orig_0010009", "type": "orig", "text": "J. no. 518 Paṇḍara-jātaka（漢譯南傳三八、槃達羅龍王本生譚）參照。"}
{"id": null, "n": "0010010", "target": "#nkr_note_orig_0010010", "type": "orig", "text": "J. no. 492 Taccha-sukara-jataka（漢譯南傳三七、木匠養豬生譚）參照。"}
{"id": null, "n": "0011011", "target": "#nkr_note_orig_0011011", "type": "orig", "text": "J. no. 422 Cetiya-jātaka（漢譯南傳三六、支提本生譚）參照。"}
{"id": null, "n": "0011012", "target": "#nkr_note_orig_0011012", "type": "orig", "text": "J. no. 482 Rūr-jātaka（漢譯南傳三七、魯魯鹿本生譚）參照。"}
{"id": null, "n": "0011013", "target": "#nkr_note_orig_0011013", "type": "orig", "text": "J. no. 72 Silava-nāgarāja-jātaka（漢譯南傳三二、有德象王本生譚）參照。"}
{"id": null, "n": "0011014", "target": "#nkr_note_orig_0011014", "type": "orig", "text": "此故事相當於 J. no. 241 Ssbbadāṭha-jātaka（漢譯南傳三三、一切牙豺本生譚），菩薩為司祭而不是賢者，又不能列舉維都羅名。"}
{"id": null, "n": "0011015", "target": "#nkr_note_orig_0011015", "type": "orig", "text": "J. no. 357 Laṭukika-jātaka（漢譯南傳三五、鶉本生譚）參照。"}
{"id": null, "n": "0011016", "target": "#nkr_note_orig_0011016", "type": "orig", "text": "J. no. 457 Dhamma-jātaka（漢譯南傳三六、法天子本生譚）參照。此處非夜叉是天子。"}
{"id": null, "n": "0011017", "target": "#nkr_note_orig_0011017", "type": "orig", "text": "J. no. 12 Nigrodhamiga-jātaka（漢譯南傳三一、榕樹鹿本生譚）參照。"}
{"id": null, "n": "0011018", "target": "#nkr_note_orig_0011018", "type": "orig", "text": "J. no. 445 Nigrodha-jātaka（漢譯南傳三六、尼拘律童子本生譚）參照。"}
{"id": null, "n": "0011019", "target": "#nkr_note_orig_0011019", "type": "orig", "text": "J. no. 542 Khanḍahāla-jātaka（漢譯南傳三、康達哈羅司祭官本生譚）參照。"}
{"id": null, "n": "0011020", "target": "#nkr_note_orig_0011020", "type": "orig", "text": "J. no. 1 Apaṇṇaka-jātaka（漢譯南傳三一、無戲論本生譚）參照。"}
{"id": null, "n": "0012021", "target": "#nkr_note_orig_0012021", "type": "orig", "text": "J. no. 472 Mahāpaduma-jātaka（漢譯南傳三七、大蓮華王子本生譚）參照。"}
{"id": null, "n": "0012022", "target": "#nkr_note_orig_0012022", "type": "orig", "text": "J. no. 358 Culladhammapāla-jātaka（漢譯南傳三五、小護法王子本生譚）參照。"}
{"id": null, "n": "0012023", "target": "#nkr_note_orig_0012023", "type": "orig", "text": "底本依羅馬字本為 Bodhisatto n'eva paṭiviruddho，文意上如德譯註記，讀為 Bodhisatten'eva paṭiviruddho。"}
{"id": null, "n": "0013024", "target": "#nkr_note_orig_0013024", "type": "orig", "text": "M. no. 129 Bālapaṇḍita-sutta（漢譯南傳一二下、賢愚經）參照。"}
{"id": null, "n": "0014001", "target": "#nkr_note_orig_0014001", "type": "orig", "text": "J. no. 536 Kinnara-jātaka v. 1 參照。"}
{"id": null, "n": "0014002", "target": "#nkr_note_orig_0014002", "type": "orig", "text": "J. no. 546 Mahāummagga-jātaka（漢譯南傳四二、大隧道本生譚）參照。底本為 Mahosadha，依羅馬字本及本生經改正。"}
{"id": null, "n": "0017001", "target": "#nkr_note_orig_0017001", "type": "orig", "text": "類似於 Dhp. 39; 188, 214, 351, 385; Sn. 15, 70, 212, 621, 965等句。"}
{"id": null, "n": "0017002", "target": "#nkr_note_orig_0017002", "type": "orig", "text": "J. no. 389 Suvaṇṇakakkaṭaka-jātaka（漢譯南傳三五、金色蟹本生譚）參照。"}
{"id": null, "n": "0017003", "target": "#nkr_note_orig_0017003", "type": "orig", "text": "āgacchantaṁ 羅馬字本為 opatantaṁ。"}
{"id": null, "n": "0017004", "target": "#nkr_note_orig_0017004", "type": "orig", "text": "arahantānaṁ vigatabhayasantāsahetuto 與羅馬字本不同。"}
{"id": null, "n": "0019001", "target": "#nkr_note_orig_0019001", "type": "orig", "text": "於第四品第五（前卷三八九頁、無家無屋之問）曾一度出現。唯偈文之引用，前唯半偈，題名以採用偈最初之語，與前段不同而內容相同。底本重複。"}
{"id": null, "n": "0019002", "target": "#nkr_note_orig_0019002", "type": "orig", "text": "Sn. V. 207。"}
{"id": null, "n": "0019003", "target": "#nkr_note_orig_0019003", "type": "orig", "text": "Vin. II. p. 147。"}
{"id": null, "n": "0022004", "target": "#nkr_note_orig_0022004", "type": "orig", "text": "前面雖有「病」而今無。"}
{"id": null, "n": "0022005", "target": "#nkr_note_orig_0022005", "type": "orig", "text": "前面雖有「比丘」，而今為比丘尼。"}
{"id": null, "n": "0023001", "target": "#nkr_note_orig_0023001", "type": "orig", "text": "與第四品第九（前卷四〇二頁、無上醫師之問）同。"}
{"id": null, "n": "0024002", "target": "#nkr_note_orig_0024002", "type": "orig", "text": "前面是「二度」。"}
{"id": null, "n": "0024003", "target": "#nkr_note_orig_0024003", "type": "orig", "text": "前面無「六不共智」。"}
{"id": null, "n": "0025001", "target": "#nkr_note_orig_0025001", "type": "orig", "text": "S. VIII. 7; S. XX. 58; etc。"}
{"id": null, "n": "0025002", "target": "#nkr_note_orig_0025002", "type": "orig", "text": "cf. S. XII. 7. 5。"}
{"id": null, "n": "0025003", "target": "#nkr_note_orig_0025003", "type": "orig", "text": "Sampassamāno 羅馬字本為 Sammasamāno。"}
{"id": null, "n": "0027001", "target": "#nkr_note_orig_0027001", "type": "orig", "text": "有關佛陀正覺以前作菩薩之難行，參照 M. no. 36 Mahāsaccaka-sutra（漢譯南傳第九卷二二四頁以下）。"}
{"id": null, "n": "0027002", "target": "#nkr_note_orig_0027002", "type": "orig", "text": "Thag. V. 256; S. IV. 2. 4。"}
{"id": null, "n": "0031001", "target": "#nkr_note_orig_0031001", "type": "orig", "text": "以下之文底本無，依羅馬字本補充。"}
{"id": null, "n": "0033001", "target": "#nkr_note_orig_0033001", "type": "orig", "text": "cf. D. III. p. 166。"}
{"id": null, "n": "0033002", "target": "#nkr_note_orig_0033002", "type": "orig", "text": "cf. J. no. 433 Lomasakassapa-jātaka; J. no. 310 Sayha-jātaka。"}
{"id": null, "n": "0034003", "target": "#nkr_note_orig_0034003", "type": "orig", "text": "Lomasakassapa-jātaka V. 2; Sayha-jātaka V. 1。"}
{"id": null, "n": "0034004", "target": "#nkr_note_orig_0034004", "type": "orig", "text": "ratto 羅馬字本無。"}
{"id": null, "n": "0035001", "target": "#nkr_note_orig_0035001", "type": "orig", "text": "J. no. 514 Chaddanta-jātaka V. 25。"}
{"id": null, "n": "0036002", "target": "#nkr_note_orig_0036002", "type": "orig", "text": "M. no. 81 Ghaṭikāra-sutta 參照。"}
{"id": null, "n": "0036003", "target": "#nkr_note_orig_0036003", "type": "orig", "text": "ṭhito 羅馬字本無。"}
{"id": null, "n": "0036004", "target": "#nkr_note_orig_0036004", "type": "orig", "text": "loke aggâcariyaṁ 羅馬字本為 lokanāyakaṁ。"}
{"id": null, "n": "0037005", "target": "#nkr_note_orig_0037005", "type": "orig", "text": "kulajativasena andho bhavitva 羅馬字本無。"}
{"id": null, "n": "0038001", "target": "#nkr_note_orig_0038001", "type": "orig", "text": "M. no. 31 Ghatikara-sutta（M. II. P. 54）。"}
{"id": null, "n": "0038002", "target": "#nkr_note_orig_0038002", "type": "orig", "text": "同上（M. II. p. 53）。"}
{"id": null, "n": "0039001", "target": "#nkr_note_orig_0039001", "type": "orig", "text": "出第四品第九（第五品第九）。"}
{"id": null, "n": "0039002", "target": "#nkr_note_orig_0039002", "type": "orig", "text": "Sn. V. 554 第四品第一（前卷二九一頁）參照。"}
{"id": null, "n": "0042001", "target": "#nkr_note_orig_0042001", "type": "orig", "text": "A. I. p. 27。"}
{"id": null, "n": "0043002", "target": "#nkr_note_orig_0043002", "type": "orig", "text": "底本及羅馬字本同有 Samupādikā，從一採用杜連俱禮魯之註解 samupodika。"}
{"id": null, "n": "0044003", "target": "#nkr_note_orig_0044003", "type": "orig", "text": "Buddho 為單數，唯一佛時而言語，二佛以上則不可。以下一切皆然。"}
{"id": null, "n": "0045001", "target": "#nkr_note_orig_0045001", "type": "orig", "text": "M. no. 99 Subha-sutta（M. II. p. 197）; A. I. p. 69。"}
{"id": null, "n": "0053001", "target": "#nkr_note_orig_0053001", "type": "orig", "text": "底本及羅馬字本為 rakkhanabhayā 德譯改為 bhāva。今從德譯。"}
{"id": null, "n": "0053002", "target": "#nkr_note_orig_0053002", "type": "orig", "text": "pāpakā 應改為 pākatā（里斯．蕾維慈巴英辭典 pakata 之項參照）。"}
{"id": null, "n": "0054001", "target": "#nkr_note_orig_0054001", "type": "orig", "text": "前卷七二頁參照。"}
{"id": null, "n": "0059001", "target": "#nkr_note_orig_0059001", "type": "orig", "text": "J. no. 470 kālingabodhi-jātaka 參照。於本生經唯有迦陵誐王而無沙摩哥蘭若之名。"}
{"id": null, "n": "0061001", "target": "#nkr_note_orig_0061001", "type": "orig", "text": "M. no. 142 Dakkhiṇāvibhanga-sutta V. 1。"}
{"id": null, "n": "0065001", "target": "#nkr_note_orig_0065001", "type": "orig", "text": "底本 Vuttaṁ 依羅馬字本改為 Vattuṁ"}
{"id": null, "n": "0067001", "target": "#nkr_note_orig_0067001", "type": "orig", "text": "rajataloha 羅馬字本為 vaṭṭaloha。"}
{"id": null, "n": "0067002", "target": "#nkr_note_orig_0067002", "type": "orig", "text": "sattūpaladdhi natthi satta 而用 jīva, puggala，指實體之靈魂。"}
{"id": null, "n": "0068001", "target": "#nkr_note_orig_0068001", "type": "orig", "text": "僧殘第六參照。"}
{"id": null, "n": "0068002", "target": "#nkr_note_orig_0068002", "type": "orig", "text": "僧殘第五參照。"}
{"id": null, "n": "0068003", "target": "#nkr_note_orig_0068003", "type": "orig", "text": "波逸提第三十七參照。"}
{"id": null, "n": "0068004", "target": "#nkr_note_orig_0068004", "type": "orig", "text": "波逸提第四十六參照。"}
{"id": null, "n": "0068005", "target": "#nkr_note_orig_0068005", "type": "orig", "text": "波逸提第三十五參照。"}
{"id": null, "n": "0072001", "target": "#nkr_note_orig_0072001", "type": "orig", "text": "santena 羅馬字本無。"}
{"id": null, "n": "0077001", "target": "#nkr_note_orig_0077001", "type": "orig", "text": "有關毘善達羅王之故事，J. no. 547 Vessantarajātaka; Cariyāpiṭaka 9; Jātakamālā 9; 於漢譯經典之六度集經一四、須大拏經、太子須大拏經等參照。"}
{"id": null, "n": "0081002", "target": "#nkr_note_orig_0081002", "type": "orig", "text": "以下之文與羅馬字本不一致。"}
{"id": null, "n": "0083003", "target": "#nkr_note_orig_0083003", "type": "orig", "text": "此文與羅馬字本不一致。"}
{"id": null, "n": "0083004", "target": "#nkr_note_orig_0083004", "type": "orig", "text": "na sineheyya 羅馬字本是 na kampeyya na rajjeyya。"}
{"id": null, "n": "0083005", "target": "#nkr_note_orig_0083005", "type": "orig", "text": "於底本 sace kho mahārāja hitako vā sumakho vā singalo vā，但採用羅馬字本之 sace mahārāja koci。"}
{"id": null, "n": "0083006", "target": "#nkr_note_orig_0083006", "type": "orig", "text": "底本為 atavipathaṁ sākaṭapathaṁ vetapathaṁ，語義不明。今採用羅馬字本之 ājapathaṁ saṅkupathaṁ vettapathaṁ。"}
{"id": null, "n": "0084007", "target": "#nkr_note_orig_0084007", "type": "orig", "text": "vuḍḍhikāmo attādhikaranaṁ patikaṅkheyya 與羅馬字本異。"}
{"id": null, "n": "0084008", "target": "#nkr_note_orig_0084008", "type": "orig", "text": "rajjapaṭilabhāya 與羅馬字本異。"}
{"id": null, "n": "0085009", "target": "#nkr_note_orig_0085009", "type": "orig", "text": "Cariyāpitaka I. 9, V. 53。"}
{"id": null, "n": "0086010", "target": "#nkr_note_orig_0086010", "type": "orig", "text": "此文羅馬字本無。"}
{"id": null, "n": "0086011", "target": "#nkr_note_orig_0086011", "type": "orig", "text": "anorapāro lavaṇajaladharo 羅馬字本無。"}
{"id": null, "n": "0088012", "target": "#nkr_note_orig_0088012", "type": "orig", "text": "gavasataṁ 羅馬字本為 dhenusataṁ usabhasataṁ。"}
{"id": null, "n": "0088013", "target": "#nkr_note_orig_0088013", "type": "orig", "text": "J. no. p. 547 Vessantara-jātaka V. 675。"}
{"id": null, "n": "0090001", "target": "#nkr_note_orig_0090001", "type": "orig", "text": "「於海中者」羅馬字本無。"}
{"id": null, "n": "0090002", "target": "#nkr_note_orig_0090002", "type": "orig", "text": "此文羅馬字本無。"}
{"id": null, "n": "0090003", "target": "#nkr_note_orig_0090003", "type": "orig", "text": "稱深崖（Pātāla）是於海中之深懸崖。"}
{"id": null, "n": "0091004", "target": "#nkr_note_orig_0091004", "type": "orig", "text": "以下之文與羅馬字本異。"}
{"id": null, "n": "0094001", "target": "#nkr_note_orig_0094001", "type": "orig", "text": "七頁註[04]參照。"}
{"id": null, "n": "0095002", "target": "#nkr_note_orig_0095002", "type": "orig", "text": "此四人亦出於前卷難問一、四（二〇二頁）。Mandhāta 王之故事，本生經二五八（漢譯南傳三四、六三頁）、Nimi 王之故事，本生經五四一（漢譯南傳四一、六九頁）、Sadhina 王之故事，本生經四九四（漢譯南傳四六、三八七頁）、Guttila 王之故事，本生經二四三（漢譯南傳三三、四一八頁）及天宮事經三、三三（漢譯南傳二七、四七八頁）參照。"}
{"id": null, "n": "0095003", "target": "#nkr_note_orig_0095003", "type": "orig", "text": "Puṇṇaka 之故事，請參照 Dhp. A. III. p. 302f。"}
{"id": null, "n": "0095004", "target": "#nkr_note_orig_0095004", "type": "orig", "text": "Suppiyā 之故事，請參律藏大品六、二三（漢譯南傳三八一頁）。"}
{"id": null, "n": "0095005", "target": "#nkr_note_orig_0095005", "type": "orig", "text": "Mallika 之故事，請參照本生經四一五（漢譯南傳三五、四一一頁）。"}
{"id": null, "n": "0100001", "target": "#nkr_note_orig_0100001", "type": "orig", "text": "底本為 anena anumānena，依羅馬字本改為 saha akatena ananumatena。"}
{"id": null, "n": "0102002", "target": "#nkr_note_orig_0102002", "type": "orig", "text": "以下與羅馬字本不一致。"}
{"id": null, "n": "0103003", "target": "#nkr_note_orig_0103003", "type": "orig", "text": "以下與羅馬字本不一致。"}
{"id": null, "n": "0103004", "target": "#nkr_note_orig_0103004", "type": "orig", "text": "以下羅馬字本無。"}
{"id": null, "n": "0105001", "target": "#nkr_note_orig_0105001", "type": "orig", "text": "言有分（bhavaṅga）潛在意識態。詳細為 Visuddhimagga p. 458（漢譯南傳六九、四二頁）參照。"}
{"id": null, "n": "0106002", "target": "#nkr_note_orig_0106002", "type": "orig", "text": "以下與羅馬字本不一致。"}
{"id": null, "n": "0106003", "target": "#nkr_note_orig_0106003", "type": "orig", "text": "suññaṁ pavivittaṁ 羅馬字本無。"}
{"id": null, "n": "0106004", "target": "#nkr_note_orig_0106004", "type": "orig", "text": "evaṁ middhaṁ vivajjetvā majjhattabhūto 羅馬字本無。"}
{"id": null, "n": "0106005", "target": "#nkr_note_orig_0106005", "type": "orig", "text": "ajāgaro 羅馬字本之 jagaro 是誤。"}
{"id": null, "n": "0106006", "target": "#nkr_note_orig_0106006", "type": "orig", "text": "majjhupagato 羅馬字本為 ajjhupagato。"}
{"id": null, "n": "0108001", "target": "#nkr_note_orig_0108001", "type": "orig", "text": "底本於羅馬字本為 ekaṁsena，德譯讀為 ekaṁse na，今從之。"}
{"id": null, "n": "0109002", "target": "#nkr_note_orig_0109002", "type": "orig", "text": "出自前卷二一六頁，其他有：S. IV. 230; A. II. 87; III. 131; V. 110; Nd. 47 etc。"}
{"id": null, "n": "0116001", "target": "#nkr_note_orig_0116001", "type": "orig", "text": "底本之 ca 應除去。"}
{"id": null, "n": "0116002", "target": "#nkr_note_orig_0116002", "type": "orig", "text": "底本為 cittakāyaṁ paṭiheraṁ，如羅馬字本改為 cetiye pātihīraṁ（pāṭihāriya > pāṭihera > pātihīra）。"}
{"id": null, "n": "0117003", "target": "#nkr_note_orig_0117003", "type": "orig", "text": "mahiddhiko 羅馬字本無。"}
{"id": null, "n": "0122001", "target": "#nkr_note_orig_0122001", "type": "orig", "text": "M. I. p. 502。"}
{"id": null, "n": "0128001", "target": "#nkr_note_orig_0128001", "type": "orig", "text": "cf. Dhp. 401; Sn. 392; 625; 812。"}
{"id": null, "n": "0131001", "target": "#nkr_note_orig_0131001", "type": "orig", "text": "第七品第八參照。"}
{"id": null, "n": "0132002", "target": "#nkr_note_orig_0132002", "type": "orig", "text": "paripīliyamāno 羅馬字本為 dayhamāno。"}
{"id": null, "n": "0133003", "target": "#nkr_note_orig_0133003", "type": "orig", "text": "J. no. 477 Cullanārada-jātaka v. 9。"}
{"id": null, "n": "0135001", "target": "#nkr_note_orig_0135001", "type": "orig", "text": "yadi nibbānassa nikkhittokāso natthi 與羅馬字本相異。"}
{"id": null, "n": "0136001", "target": "#nkr_note_orig_0136001", "type": "orig", "text": "羅馬字本獨出於「比量之問」，成為本書之第五部。底本出第九品第八。"}
{"id": null, "n": "0137002", "target": "#nkr_note_orig_0137002", "type": "orig", "text": "以下之文與羅馬字本不一致。"}
{"id": null, "n": "0137003", "target": "#nkr_note_orig_0137003", "type": "orig", "text": "參照同一之問答第五品第一（前卷一一五頁）。"}
{"id": null, "n": "0139004", "target": "#nkr_note_orig_0139004", "type": "orig", "text": "以下之文則按照羅馬字本。"}
{"id": null, "n": "0142005", "target": "#nkr_note_orig_0142005", "type": "orig", "text": "Dhp. VV. 54-56最初一偈出 A. I. AP. 226。"}
{"id": null, "n": "0145006", "target": "#nkr_note_orig_0145006", "type": "orig", "text": "以下之文依羅馬字本。"}
{"id": null, "n": "0147007", "target": "#nkr_note_orig_0147007", "type": "orig", "text": "最初之一偈羅馬字本無。"}
{"id": null, "n": "0150008", "target": "#nkr_note_orig_0150008", "type": "orig", "text": "以下之文依羅馬字本。"}
{"id": null, "n": "0152009", "target": "#nkr_note_orig_0152009", "type": "orig", "text": "底本羅馬字本皆除去 taṇḍula-magga-māsena appakena pi。"}
{"id": null, "n": "0153010", "target": "#nkr_note_orig_0153010", "type": "orig", "text": "以下文與羅馬字本不一致。"}
{"id": null, "n": "0154011", "target": "#nkr_note_orig_0154011", "type": "orig", "text": "此一句依羅馬字本。"}
{"id": null, "n": "0157012", "target": "#nkr_note_orig_0157012", "type": "orig", "text": "以下文與羅馬字本不一致。"}
{"id": null, "n": "0160013", "target": "#nkr_note_orig_0160013", "type": "orig", "text": "至以下二三〇頁止之文中，除去偈頌之散文，羅馬字本無。羅馬字本唯有偈文。"}
{"id": null, "n": "0160014", "target": "#nkr_note_orig_0160014", "type": "orig", "text": "其次之 anekajangalarāmalakkhaṇapāratiṇṇo taraṅgasuravikkhoghitamaṇḍitamodakarāsī 不明。"}
{"id": null, "n": "0160015", "target": "#nkr_note_orig_0160015", "type": "orig", "text": "其次之 ālayapāralayo 至 pubbadevātālayo 止四行不明。"}
{"id": null, "n": "0160016", "target": "#nkr_note_orig_0160016", "type": "orig", "text": "其次之 anālayapaṭṭhiyo kepukapātālanarakapadahimukha-pubbadho。"}
{"id": null, "n": "0160017", "target": "#nkr_note_orig_0160017", "type": "orig", "text": "其次之 sikhisaṁsavanamaka ……不明。"}
{"id": null, "n": "0161018", "target": "#nkr_note_orig_0161018", "type": "orig", "text": "其次之 vinagulikkururilena-……不明。"}
{"id": null, "n": "0164019", "target": "#nkr_note_orig_0164019", "type": "orig", "text": "其次 āleyyapatthara-至 sāvannatāya 止四行不明。"}
{"id": null, "n": "0164020", "target": "#nkr_note_orig_0164020", "type": "orig", "text": "其次之 rasa 除去。"}
{"id": null, "n": "0165021", "target": "#nkr_note_orig_0165021", "type": "orig", "text": "底本之 sati 誤寫。"}
{"id": null, "n": "0166022", "target": "#nkr_note_orig_0166022", "type": "orig", "text": "其次之 taṁ enam aññe disvā jhāyino jānanti 誤寫。"}
{"id": null, "n": "0166023", "target": "#nkr_note_orig_0166023", "type": "orig", "text": "其次之 parihinatame……kasakappakadhuvappasatthena 不明。"}
{"id": null, "n": "0167024", "target": "#nkr_note_orig_0167024", "type": "orig", "text": "底本之 subddho 是 suvuṭṭho 之誤。"}
{"id": null, "n": "0168025", "target": "#nkr_note_orig_0168025", "type": "orig", "text": "其次自 setacchattakubbhalakkhanavimānantaro 至 ghaṇaruciraghaṇavattapīnapāso 之二行不明。"}
{"id": null, "n": "0170026", "target": "#nkr_note_orig_0170026", "type": "orig", "text": "其次之……dadhibalipubbaḍḍhakāyo 不明。"}
{"id": null, "n": "0173027", "target": "#nkr_note_orig_0173027", "type": "orig", "text": "其次之 nuddhamātanalamakkhikasamakiṇṇā atha'ssa vyāsatto 不明。"}
{"id": null, "n": "0174028", "target": "#nkr_note_orig_0174028", "type": "orig", "text": "底本之 dosamohakaṁ 如羅馬字本改為 samohitaṁ。"}
{"id": null, "n": "0175029", "target": "#nkr_note_orig_0175029", "type": "orig", "text": "以下之文雖在於羅馬字本，但語句不一致。"}
{"id": null, "n": "0176001", "target": "#nkr_note_orig_0176001", "type": "orig", "text": "羅馬字本此問別出。"}
{"id": null, "n": "0177002", "target": "#nkr_note_orig_0177002", "type": "orig", "text": "至以下次頁第九行止羅馬字本無。"}
{"id": null, "n": "0178003", "target": "#nkr_note_orig_0178003", "type": "orig", "text": "底本 natthi 為 na 之誤。"}
{"id": null, "n": "0179004", "target": "#nkr_note_orig_0179004", "type": "orig", "text": "J. IV. pp. 263-267（漢譯南傳三七、舍羅婆鹿譚）參照。cf. J. I. p. 77。"}
{"id": null, "n": "0179005", "target": "#nkr_note_orig_0179005", "type": "orig", "text": "M. no. 62. Mahārāhulovāda-sutta。"}
{"id": null, "n": "0179006", "target": "#nkr_note_orig_0179006", "type": "orig", "text": "Sn. II. 4. Mahāmaṅgala-sutta。"}
{"id": null, "n": "0179007", "target": "#nkr_note_orig_0179007", "type": "orig", "text": "Sn. I. 6. Parābhava-sutta。"}
{"id": null, "n": "0179008", "target": "#nkr_note_orig_0179008", "type": "orig", "text": "Sn. IV. 10. Purābheda-sutta。"}
{"id": null, "n": "0179009", "target": "#nkr_note_orig_0179009", "type": "orig", "text": "Sn. IV. 11. Kalahavivāda-sutta。"}
{"id": null, "n": "0179010", "target": "#nkr_note_orig_0179010", "type": "orig", "text": "Sn. IV. 12. Cūḷaviyūha-sutta（本書為 Cūlavyūha）。"}
{"id": null, "n": "0179011", "target": "#nkr_note_orig_0179011", "type": "orig", "text": "Sn. IV. 13. Mahāviyūha-sutta（本書為 Mahāvyūha）。"}
{"id": null, "n": "0179012", "target": "#nkr_note_orig_0179012", "type": "orig", "text": "Sn. IV. 14. Tuvataka-sutta。"}
{"id": null, "n": "0179013", "target": "#nkr_note_orig_0179013", "type": "orig", "text": "J. V. p. 333f（漢譯南傳四〇、小鵝本生譚）參照。於此本生譚，護財（dhanapalaka）則出於那羅祇梨之名。"}
{"id": null, "n": "0180014", "target": "#nkr_note_orig_0180014", "type": "orig", "text": "Sn. V. Pārāyaṇavagga, Vatthugātha。"}
{"id": null, "n": "0180015", "target": "#nkr_note_orig_0180015", "type": "orig", "text": "於因陀羅薩羅窟之說法出 D. no. 21 Sakkapañha-sutta; 長阿含一四、釋提桓因問經（大正一、六二b）、帝釋所問經（大正一、二四六b）、中阿含、一三四釋問經（大正一、六三一c）等。"}
{"id": null, "n": "0180016", "target": "#nkr_note_orig_0180016", "type": "orig", "text": "Mahāvagga I. 10-47（漢譯南傳三、律藏三、大品、第一大犍度）、四分律三二（大正二二、七八七c）、五分律（大正二二、一〇四a）參照。"}
{"id": null, "n": "0180017", "target": "#nkr_note_orig_0180017", "type": "orig", "text": "J. IV. p. 265（漢譯南傳三七、舍羅婆鹿本生譚）Vm. p. 391。"}
{"id": null, "n": "0180018", "target": "#nkr_note_orig_0180018", "type": "orig", "text": "Vm. p. 392。"}
{"id": null, "n": "0180019", "target": "#nkr_note_orig_0180019", "type": "orig", "text": "Buddhavamsa（漢譯南傳第四十四卷）。"}
{"id": null, "n": "0180020", "target": "#nkr_note_orig_0180020", "type": "orig", "text": "D. no. 20 Mahāsamayasuttanta。"}
{"id": null, "n": "0180021", "target": "#nkr_note_orig_0180021", "type": "orig", "text": "蘇蔓那事出前卷二〇二頁，本卷一三〇頁。"}
{"id": null, "n": "0180022", "target": "#nkr_note_orig_0180022", "type": "orig", "text": "伽羅哈丁那事參照 Dhp. A. I. p. 434f。"}
{"id": null, "n": "0180023", "target": "#nkr_note_orig_0180023", "type": "orig", "text": "斯羅沙事參照 J. no. 419 Sulasājātaka（漢譯南傳三六、美女斯羅沙本生譚）。"}
{"id": null, "n": "0180024", "target": "#nkr_note_orig_0180024", "type": "orig", "text": "西莉摩事參照 Dph. A. III. p. 104f。"}
{"id": null, "n": "0180025", "target": "#nkr_note_orig_0180025", "type": "orig", "text": "小須跋陀事參照 Mano. p. 517。"}
{"id": null, "n": "0180026", "target": "#nkr_note_orig_0180026", "type": "orig", "text": "D. no. 21Ṣakkapaṅhasutta。"}
{"id": null, "n": "0180027", "target": "#nkr_note_orig_0180027", "type": "orig", "text": "Kph. 7 Tirokuḍḍa（Petavatthu Tirokuḍḍapetavatthu）。"}
{"id": null, "n": "0180028", "target": "#nkr_note_orig_0180028", "type": "orig", "text": "Kph. 6 Ratanasutta（Sn. II. 1）。"}
{"id": null, "n": "0180029", "target": "#nkr_note_orig_0180029", "type": "orig", "text": "言 Pācīna（東方）Avanti（恆河上流地域）Dakkhiṇāpatha（德干地方）。"}
{"id": null, "n": "0180030", "target": "#nkr_note_orig_0180030", "type": "orig", "text": "此文從羅馬字本而讀。"}
{"id": null, "n": "0189031", "target": "#nkr_note_orig_0189031", "type": "orig", "text": "以下之十三頭陀支，請參照 Vm. Dhutaṅga-niddesa（漢譯南傳六七、清淨道論、第二品頭陀支之解釋）。"}
{"id": null, "n": "0191032", "target": "#nkr_note_orig_0191032", "type": "orig", "text": "以下之文與羅馬字本不一致。"}
{"id": null, "n": "0192033", "target": "#nkr_note_orig_0192033", "type": "orig", "text": "A. I. 13. 7（漢譯南傳一九、三〇頁）。"}
