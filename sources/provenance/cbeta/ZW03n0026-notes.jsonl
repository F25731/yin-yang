{"id": null, "n": "0216001", "target": "#nkr_note_orig_0216001", "type": "orig", "text": "「仁」，己本作「人」。"}
{"id": null, "n": "0216002", "target": "#nkr_note_orig_0216002", "type": "orig", "text": "「業苦」，戊本作「苦業」。"}
{"id": null, "n": "0216003", "target": "#nkr_note_orig_0216003", "type": "orig", "text": "「皆」，乙本作「習」。"}
{"id": null, "n": "0216004", "target": "#nkr_note_orig_0216004", "type": "orig", "text": "「七」，乙本作「一」。"}
{"id": null, "n": "0216005", "target": "#nkr_note_orig_0216005", "type": "orig", "text": "「唯」，己本作「為」。"}
{"id": null, "n": "0216006", "target": "#nkr_note_orig_0216006", "type": "orig", "text": "「因」，甲本作「有」。"}
{"id": null, "n": "0216007", "target": "#nkr_note_orig_0216007", "type": "orig", "text": "「眾生」，丁本作「有情」。"}
{"id": null, "n": "0216008", "target": "#nkr_note_orig_0216008", "type": "orig", "text": "「唯從」，戊本作「從唯」。"}
{"id": null, "n": "0216009", "target": "#nkr_note_orig_0216009", "type": "orig", "text": "「續結」，丙本作「結續」。"}
{"id": null, "n": "0216010", "target": "#nkr_note_orig_0216010", "type": "orig", "text": "「甚」，甲本作「是」。"}
{"id": null, "n": "0216011", "target": "#nkr_note_orig_0216011", "type": "orig", "text": "「因緣」，丁本作「巧故」。"}
{"id": null, "n": "0217001", "target": "#nkr_note_orig_0217001", "type": "orig", "text": "「遣」，底本作「遣」，乙本作「見」，據甲、丙、丁、戊、己本改。"}
{"id": null, "n": "0217002", "target": "#nkr_note_orig_0217002", "type": "orig", "text": "「因緣心論頌」，甲本無，丙本作「因緣心論頌一卷」，己本作「論頌一本」。"}
