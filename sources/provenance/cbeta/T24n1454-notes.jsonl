{"id": null, "n": "0502b2201", "target": "#nkr_note_add_0502b2201", "type": "add", "text": "德【CB】，聽【大】"}
{"id": null, "n": "0502b2301", "target": "#nkr_note_add_0502b2301", "type": "add", "text": "持【CB】【麗-CB】，時【大】"}
{"id": null, "n": "0504b0601", "target": "#nkr_note_add_0504b0601", "type": "add", "text": "撗【CB】【麗-CB】，擴【大】"}
{"id": null, "n": "0506a1201", "target": "#nkr_note_add_0506a1201", "type": "add", "text": "入【CB】【麗-CB】，人【大】"}
{"id": null, "n": "0506b1101", "target": "#nkr_note_add_0506b1101", "type": "add", "text": "【磧】同【宋】【元】【明】【宮】攝頌在前，而【大】【麗】則攝頌在後。"}
{"id": null, "n": "0506b1501", "target": "#nkr_note_add_0506b1501", "type": "add", "text": "各【CB】【麗-CB】，我【大】"}
{"id": null, "n": "0507a0201", "target": "#nkr_note_add_0507a0201", "type": "add", "text": "㗘【CB】【麗-CB】，𭉾【大】"}
{"id": null, "n": "0507b2001", "target": "#nkr_note_add_0507b2001", "type": "add", "text": "祇【CB】【麗-CB】，祗【大】"}
