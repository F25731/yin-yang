{"id": null, "n": "0878003", "target": "#nkr_note_mod_0878003", "type": "mod", "text": "佛語【大】＊，佛語法門【明】＊"}
{"id": null, "n": "0878004", "target": "#nkr_note_mod_0878004", "type": "mod", "text": "天【大】，北天【元】【明】"}
{"id": null, "n": "0878005", "target": "#nkr_note_mod_0878005", "type": "mod", "text": "三藏【大】，三藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0878006", "target": "#nkr_note_mod_0878006", "type": "mod", "text": "流【大】，留【宋】【元】【明】【宮】"}
{"id": null, "n": "0878007", "target": "#nkr_note_mod_0878007", "type": "mod", "text": "譯【大】，初譯【元】【明】"}
{"id": null, "n": "0878008", "target": "#nkr_note_mod_0878008", "type": "mod", "text": "右【大】，左【明】"}
{"id": null, "n": "0878009", "target": "#nkr_note_mod_0878009", "type": "mod", "text": "利【大】，離【宋】【元】【明】【宮】"}
{"id": null, "n": "0878010", "target": "#nkr_note_mod_0878010", "type": "mod", "text": "漏【大】，有漏【元】【明】"}
{"id": null, "n": "0878011", "target": "#nkr_note_mod_0878011", "type": "mod", "text": "悕【大】，布【明】"}
{"id": null, "n": "0878012", "target": "#nkr_note_mod_0878012", "type": "mod", "text": "分別【大】＊，分別而【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0878013", "target": "#nkr_note_mod_0878013", "type": "mod", "text": "卑【大】，卑旬【宮】"}
{"id": null, "n": "0879001", "target": "#nkr_note_mod_0879001", "type": "mod", "text": "開發【大】，開悟【明】"}
{"id": null, "n": "0879002", "target": "#nkr_note_mod_0879002", "type": "mod", "text": "遍【大】，逼【明】"}
{"id": null, "n": "0879003", "target": "#nkr_note_mod_0879003", "type": "mod", "text": "如【大】，知【元】【明】"}
{"id": null, "n": "0878003", "target": "#nkr_note_orig_0878003", "type": "orig", "text": "佛語＋（法門）【明】＊"}
{"id": null, "n": "0878004", "target": "#nkr_note_orig_0878004", "type": "orig", "text": "（北）＋天【元】【明】"}
{"id": null, "n": "0878005", "target": "#nkr_note_orig_0878005", "type": "orig", "text": "三藏＋（法師）【三】【宮】"}
{"id": null, "n": "0878006", "target": "#nkr_note_orig_0878006", "type": "orig", "text": "流＝留【三】【宮】"}
{"id": null, "n": "0878007", "target": "#nkr_note_orig_0878007", "type": "orig", "text": "（初）＋譯【元】【明】"}
{"id": null, "n": "0878008", "target": "#nkr_note_orig_0878008", "type": "orig", "text": "右＝左【明】"}
{"id": null, "n": "0878009", "target": "#nkr_note_orig_0878009", "type": "orig", "text": "利＝離【三】【宮】"}
{"id": null, "n": "0878010", "target": "#nkr_note_orig_0878010", "type": "orig", "text": "（有）＋漏【元】【明】"}
{"id": null, "n": "0878011", "target": "#nkr_note_orig_0878011", "type": "orig", "text": "悕＝布【明】"}
{"id": null, "n": "0878012", "target": "#nkr_note_orig_0878012", "type": "orig", "text": "分別＋（而）【三】＊"}
{"id": null, "n": "0878013", "target": "#nkr_note_orig_0878013", "type": "orig", "text": "卑＋（旬）【宮】"}
{"id": null, "n": "0879001", "target": "#nkr_note_orig_0879001", "type": "orig", "text": "開發＝開悟【明】"}
{"id": null, "n": "0879002", "target": "#nkr_note_orig_0879002", "type": "orig", "text": "遍＝逼【明】"}
{"id": null, "n": "0879003", "target": "#nkr_note_orig_0879003", "type": "orig", "text": "如＝知【元】【明】"}
{"id": null, "n": "0878c2801", "target": "#nkr_note_add_0878c2801", "type": "add", "text": "而【CB】【麗-CB】，面【大】"}
