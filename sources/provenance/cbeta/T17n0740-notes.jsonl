{"id": null, "n": null, "target": null, "type": "cf1", "text": "Q20_p0155a26"}
{"id": null, "n": "0543013", "target": "#nkr_note_mod_0543013", "type": "mod", "text": "佛說【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0543014", "target": "#nkr_note_mod_0543014", "type": "mod", "text": "人【大】，〔－〕【宋】【元】【宮】，人名【明】"}
{"id": null, "n": "0543015", "target": "#nkr_note_mod_0543015", "type": "mod", "text": "滿【大】，湯【宮】"}
{"id": null, "n": "0543016", "target": "#nkr_note_mod_0543016", "type": "mod", "text": "至佛前已【CB】【磧-CB】【宋】【元】【明】【宮】，前以後【大】"}
{"id": null, "n": "0543017", "target": "#nkr_note_mod_0543017", "type": "mod", "text": "披【大】，被【宋】【元】【明】【宮】"}
{"id": null, "n": "0543018", "target": "#nkr_note_mod_0543018", "type": "mod", "text": "經【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0543019", "target": "#nkr_note_mod_0543019", "type": "mod", "text": "耆【大】，耆經【宋】【元】【明】【宮】"}
{"id": null, "n": "0543020", "target": "#nkr_note_mod_0543020", "type": "mod", "text": "應【大】，應而【宋】【元】【明】【宮】"}
{"id": null, "n": "0543021", "target": "#nkr_note_mod_0543021", "type": "mod", "text": "福【大】，其福【宋】【元】【明】【宮】"}
{"id": null, "n": "0543022", "target": "#nkr_note_mod_0543022", "type": "mod", "text": "不知【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0543023", "target": "#nkr_note_mod_0543023", "type": "mod", "text": "所【大】，不【宋】【元】【明】【宮】"}
{"id": null, "n": "0543024", "target": "#nkr_note_mod_0543024", "type": "mod", "text": "不【大】，不以【宋】【元】【明】【宮】"}
{"id": null, "n": "0543025", "target": "#nkr_note_mod_0543025", "type": "mod", "text": "與【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0543026", "target": "#nkr_note_mod_0543026", "type": "mod", "text": "不【大】，不久【宋】【元】【明】【宮】"}
{"id": null, "n": "0543027", "target": "#nkr_note_mod_0543027", "type": "mod", "text": "忘【大】，亡【宋】【元】【明】【宮】"}
{"id": null, "n": "0543028", "target": "#nkr_note_mod_0543028", "type": "mod", "text": "損【大】，捐【宋】【元】【明】【宮】"}
{"id": null, "n": "0543029", "target": "#nkr_note_mod_0543029", "type": "mod", "text": "欲但【大】，但欲【宋】【元】【明】【宮】"}
{"id": null, "n": "0543013", "target": "#nkr_note_orig_0543013", "type": "orig", "text": "〔佛說〕－【宋】【元】【宮】"}
{"id": null, "n": "0543014", "target": "#nkr_note_orig_0543014", "type": "orig", "text": "〔人〕－【宋】【元】【宮】，人＋（名）【明】"}
{"id": null, "n": "0543015", "target": "#nkr_note_orig_0543015", "type": "orig", "text": "滿＝湯【宮】"}
{"id": null, "n": "0543016", "target": "#nkr_note_orig_0543016", "type": "orig", "text": "前以後＝至佛前已【三】【宮】"}
{"id": null, "n": "0543017", "target": "#nkr_note_orig_0543017", "type": "orig", "text": "披＝被【三】【宮】"}
{"id": null, "n": "0543018", "target": "#nkr_note_orig_0543018", "type": "orig", "text": "〔經〕－【三】【宮】"}
{"id": null, "n": "0543019", "target": "#nkr_note_orig_0543019", "type": "orig", "text": "耆＋（經）【三】【宮】"}
{"id": null, "n": "0543020", "target": "#nkr_note_orig_0543020", "type": "orig", "text": "應＋（而）【三】【宮】"}
{"id": null, "n": "0543021", "target": "#nkr_note_orig_0543021", "type": "orig", "text": "（其）＋福【三】【宮】"}
{"id": null, "n": "0543022", "target": "#nkr_note_orig_0543022", "type": "orig", "text": "〔不知〕－【三】【宮】"}
{"id": null, "n": "0543023", "target": "#nkr_note_orig_0543023", "type": "orig", "text": "所＝不【三】【宮】"}
{"id": null, "n": "0543024", "target": "#nkr_note_orig_0543024", "type": "orig", "text": "不＋（以）【三】【宮】"}
{"id": null, "n": "0543025", "target": "#nkr_note_orig_0543025", "type": "orig", "text": "〔與〕－【三】【宮】"}
{"id": null, "n": "0543026", "target": "#nkr_note_orig_0543026", "type": "orig", "text": "不＋（久）【三】【宮】"}
{"id": null, "n": "0543027", "target": "#nkr_note_orig_0543027", "type": "orig", "text": "忘＝亡【三】【宮】"}
{"id": null, "n": "0543028", "target": "#nkr_note_orig_0543028", "type": "orig", "text": "損＝捐【三】【宮】"}
{"id": null, "n": "0543029", "target": "#nkr_note_orig_0543029", "type": "orig", "text": "欲但＝但欲【三】【宮】"}
