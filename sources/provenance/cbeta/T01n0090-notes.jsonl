{"id": null, "n": null, "target": null, "type": null, "text": "姓也"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K19n0697_p0582a09"}
{"id": null, "n": "0913014", "target": "#nkr_note_mod_0913014", "type": "mod", "text": "天竺【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0913015", "target": "#nkr_note_mod_0913015", "type": "mod", "text": "行【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0914001", "target": "#nkr_note_mod_0914001", "type": "mod", "text": "等【大】，尊【宋】【元】【明】"}
{"id": null, "n": "0914002", "target": "#nkr_note_mod_0914002", "type": "mod", "text": "此【大】，此唯【宋】【元】【明】"}
{"id": null, "n": "0914003", "target": "#nkr_note_mod_0914003", "type": "mod", "text": "炷【大】，炷炷【宋】【元】【明】"}
{"id": null, "n": "0914004", "target": "#nkr_note_mod_0914004", "type": "mod", "text": "離【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0914005", "target": "#nkr_note_mod_0914005", "type": "mod", "text": "坐【大】，座【宋】【元】【明】"}
{"id": null, "n": "0913014", "target": "#nkr_note_orig_0913014", "type": "orig", "text": "〔天竺〕－【三】"}
{"id": null, "n": "0913015", "target": "#nkr_note_orig_0913015", "type": "orig", "text": "〔行〕－【三】"}
{"id": null, "n": "0914001", "target": "#nkr_note_orig_0914001", "type": "orig", "text": "等＝尊【三】"}
{"id": null, "n": "0914002", "target": "#nkr_note_orig_0914002", "type": "orig", "text": "此＋（唯）【三】"}
{"id": null, "n": "0914003", "target": "#nkr_note_orig_0914003", "type": "orig", "text": "炷＋（炷）【三】"}
{"id": null, "n": "0914004", "target": "#nkr_note_orig_0914004", "type": "orig", "text": "〔離〕－【三】"}
{"id": null, "n": "0914005", "target": "#nkr_note_orig_0914005", "type": "orig", "text": "坐＝座【三】"}
{"id": null, "n": "0913c1201", "target": "#nkr_note_add_0913c1201", "type": "add", "text": "旃【CB】【麗-CB】，栴【大】"}
