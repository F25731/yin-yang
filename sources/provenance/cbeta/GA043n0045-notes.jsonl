{"id": null, "n": "c019a0901", "target": "#nkr_note_add_c019a0901", "type": "add", "text": "遊鶴林寺【CB】，［－］【志彙】"}
{"id": null, "n": "c020a0401", "target": "#nkr_note_add_c020a0401", "type": "add", "text": "鶴林寺【CB】，［－］【志彙】"}
{"id": null, "n": "c020a0801", "target": "#nkr_note_add_c020a0801", "type": "add", "text": "集鶴林寺【CB】，［－］【志彙】"}
