{"id": null, "n": "c011a0201", "target": "#nkr_note_add_c011a0201", "type": "add", "text": "奉陪韋潤州遊鶴林寺【CB】，［－］【志彙】"}
{"id": null, "n": "c011a0601", "target": "#nkr_note_add_c011a0601", "type": "add", "text": "鶴林寺【CB】，［－］【志彙】"}
{"id": null, "n": "c012a0101", "target": "#nkr_note_add_c012a0101", "type": "add", "text": "題鶴林寺【CB】，［－］【志彙】"}
{"id": null, "n": "c012a0601", "target": "#nkr_note_add_c012a0601", "type": "add", "text": "寄江南鶴林寺石氷上人【CB】，［－］【志彙】"}
{"id": null, "n": "c013a0101", "target": "#nkr_note_add_c013a0101", "type": "add", "text": "報煙霞道【CB】，〔－〕【志彙】"}
{"id": null, "n": "c013a0102", "target": "#nkr_note_add_c013a0102", "type": "add", "text": "人間共不容【CB】，〔－〕【志彙】"}
{"id": null, "n": "c014a0201", "target": "#nkr_note_add_c014a0201", "type": "add", "text": "俞烈【CB】，〔－〕【志彙】"}
{"id": null, "n": "c014a0301", "target": "#nkr_note_add_c014a0301", "type": "add", "text": "蘚石魚龍卧【CB】，〔－〕【志彙】"}
{"id": null, "n": "c014a0302", "target": "#nkr_note_add_c014a0302", "type": "add", "text": "松風幾送迎【CB】，〔－〕【志彙】"}
{"id": null, "n": "c014a0303", "target": "#nkr_note_add_c014a0303", "type": "add", "text": "卯金空往記【CB】，〔－〕【志彙】"}
{"id": null, "n": "c014a0304", "target": "#nkr_note_add_c014a0304", "type": "add", "text": "玉立【CB】，〔－〕【志彙】"}
{"id": null, "n": "c015a0301", "target": "#nkr_note_add_c015a0301", "type": "add", "text": "鶴林寺【CB】，［－］【志彙】"}
{"id": null, "n": "c015a0401", "target": "#nkr_note_add_c015a0401", "type": "add", "text": "逢【CB】，過【志彙】"}
