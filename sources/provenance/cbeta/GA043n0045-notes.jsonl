{"id": null, "n": "c017a0401", "target": "#nkr_note_add_c017a0401", "type": "add", "text": "鶴林寺【CB】，［－］【志彙】"}
{"id": null, "n": "c018a0201", "target": "#nkr_note_add_c018a0201", "type": "add", "text": "鶴林寺【CB】，［－］【志彙】"}
{"id": null, "n": "c018a0601", "target": "#nkr_note_add_c018a0601", "type": "add", "text": "重游鶴林寺【CB】，［－］【志彙】"}
{"id": null, "n": "c018a0901", "target": "#nkr_note_add_c018a0901", "type": "add", "text": "戶侯【CB】，【志彙】"}
