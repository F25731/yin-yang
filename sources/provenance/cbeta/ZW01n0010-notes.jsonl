{"id": null, "n": "0339001", "target": "#nkr_note_orig_0339001", "type": "orig", "text": "本經首尾題「最妙勝定經」，底本均誤作「最妙定勝經」，據歷代經錄記載及本經「當知修禪最妙、最勝」等語改。"}
{"id": null, "n": "0339002", "target": "#nkr_note_orig_0339002", "type": "orig", "text": "「惑」，底、甲本作「或」，據文意改。"}
{"id": null, "n": "0339003", "target": "#nkr_note_orig_0339003", "type": "orig", "text": "甲本自此起。"}
{"id": null, "n": "0339004", "target": "#nkr_note_orig_0339004", "type": "orig", "text": "「惑」，甲本作「難」。"}
{"id": null, "n": "0340001", "target": "#nkr_note_orig_0340001", "type": "orig", "text": "「所」，底本作「使」，據甲本改。"}
{"id": null, "n": "0340002", "target": "#nkr_note_orig_0340002", "type": "orig", "text": "「用」，甲本無。"}
{"id": null, "n": "0340003", "target": "#nkr_note_orig_0340003", "type": "orig", "text": "「聞」，甲本作「問」。"}
{"id": null, "n": "0340004", "target": "#nkr_note_orig_0340004", "type": "orig", "text": "「者」，甲本作「為」。"}
{"id": null, "n": "0340005", "target": "#nkr_note_orig_0340005", "type": "orig", "text": "「者」，甲本作「為」。"}
{"id": null, "n": "0340006", "target": "#nkr_note_orig_0340006", "type": "orig", "text": "「獸」，底、甲本作「狩」，據文意改。下同。"}
{"id": null, "n": "0340007", "target": "#nkr_note_orig_0340007", "type": "orig", "text": "「如」，甲本無。"}
{"id": null, "n": "0340008", "target": "#nkr_note_orig_0340008", "type": "orig", "text": "「精」，底本無，據甲本補。"}
{"id": null, "n": "0340009", "target": "#nkr_note_orig_0340009", "type": "orig", "text": "甲本至此止。"}
{"id": null, "n": "0342001", "target": "#nkr_note_orig_0342001", "type": "orig", "text": "「滿」，底本無，據文意補。"}
{"id": null, "n": "0342002", "target": "#nkr_note_orig_0342002", "type": "orig", "text": "「如」，底本無，據文意補。"}
{"id": null, "n": "0342003", "target": "#nkr_note_orig_0342003", "type": "orig", "text": "已「已」，底本作「以」，據文意改。"}
{"id": null, "n": "0343001", "target": "#nkr_note_orig_0343001", "type": "orig", "text": "「捨」，底本作「舍」，據文意改。"}
{"id": null, "n": "0343002", "target": "#nkr_note_orig_0343002", "type": "orig", "text": "「移」，底本作「私」，據文意改。"}
{"id": null, "n": "0343003", "target": "#nkr_note_orig_0343003", "type": "orig", "text": "「猶」，底本作「由」，據文意改。"}
{"id": null, "n": "0345001", "target": "#nkr_note_orig_0345001", "type": "orig", "text": "「時」，底本作「時後」，據文意刪。"}
{"id": null, "n": "0346001", "target": "#nkr_note_orig_0346001", "type": "orig", "text": "「迫脅」，底本作「柏𭠱」，據文意改。"}
{"id": null, "n": "0346002", "target": "#nkr_note_orig_0346002", "type": "orig", "text": "「恣」，底本作「咨」，據文意改。"}
{"id": null, "n": "0346003", "target": "#nkr_note_orig_0346003", "type": "orig", "text": "「黨」，底本作「儻」，據文意改。"}
{"id": null, "n": "0346004", "target": "#nkr_note_orig_0346004", "type": "orig", "text": "此字不清，疑為「泥」。"}
{"id": null, "n": "0346005", "target": "#nkr_note_orig_0346005", "type": "orig", "text": "「棋」，底本作「基」，據文意改。"}
{"id": null, "n": "0347001", "target": "#nkr_note_orig_0347001", "type": "orig", "text": "「多」，底本作「名多」，據文意刪。"}
{"id": null, "n": "0347002", "target": "#nkr_note_orig_0347002", "type": "orig", "text": "「綺」，底本作「倚」，據文意改。"}
{"id": null, "n": "0347003", "target": "#nkr_note_orig_0347003", "type": "orig", "text": "「小」，底本作「少」，據文意改。"}
{"id": null, "n": "0347004", "target": "#nkr_note_orig_0347004", "type": "orig", "text": "「狹」，底本作「俠」，據文意改。"}
{"id": null, "n": "0347005", "target": "#nkr_note_orig_0347005", "type": "orig", "text": "「小」，底本作「少」，據文意改。"}
{"id": null, "n": "0347006", "target": "#nkr_note_orig_0347006", "type": "orig", "text": "「理」，底本作「裡」，據文意改。"}
{"id": null, "n": "0348001", "target": "#nkr_note_orig_0348001", "type": "orig", "text": "「止」，底本作「心」，據文意改。"}
