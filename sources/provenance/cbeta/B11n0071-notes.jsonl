{"id": null, "n": null, "target": null, "type": null, "text": "也"}
{"id": null, "n": null, "target": null, "type": null, "text": "容"}
{"id": null, "n": null, "target": null, "type": null, "text": "克"}
{"id": null, "n": null, "target": null, "type": null, "text": "也"}
{"id": null, "n": null, "target": null, "type": null, "text": "莽清\n却眾皆相信義"}
{"id": null, "n": null, "target": null, "type": null, "text": "不動義"}
{"id": null, "n": null, "target": null, "type": null, "text": "鳥"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿"}
{"id": null, "n": null, "target": null, "type": null, "text": "金剛寶義"}
{"id": null, "n": null, "target": null, "type": null, "text": "容"}
{"id": null, "n": null, "target": null, "type": null, "text": "衣"}
{"id": null, "n": null, "target": null, "type": null, "text": "衣"}
{"id": null, "n": null, "target": null, "type": null, "text": "平聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿"}
{"id": null, "n": null, "target": null, "type": null, "text": "朗噶國屬地"}
{"id": null, "n": null, "target": null, "type": null, "text": "此天魔即\n回教之初祖"}
{"id": null, "n": null, "target": null, "type": null, "text": "厄"}
{"id": null, "n": null, "target": null, "type": null, "text": "厄"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘二未詳"}
{"id": null, "n": null, "target": null, "type": null, "text": "燃燈佛"}
{"id": null, "n": null, "target": null, "type": null, "text": "尊下平聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "三身成就義"}
{"id": null, "n": null, "target": null, "type": null, "text": "并衣缽花冠瓔珞等"}
{"id": null, "n": null, "target": null, "type": null, "text": "即尸陀林"}
{"id": null, "n": null, "target": null, "type": null, "text": "攝二根交會在內"}
{"id": null, "n": null, "target": null, "type": null, "text": "即今康藏"}
{"id": null, "n": null, "target": null, "type": null, "text": "類似修羅"}
{"id": null, "n": null, "target": null, "type": null, "text": "容"}
{"id": null, "n": null, "target": null, "type": null, "text": "容"}
{"id": null, "n": null, "target": null, "type": null, "text": "即阿難"}
{"id": null, "n": null, "target": null, "type": null, "text": "內貯滿食子者"}
{"id": null, "n": null, "target": null, "type": null, "text": "文繁不具載"}
{"id": null, "n": null, "target": null, "type": null, "text": "以目光所不及見者為一里"}
{"id": null, "n": null, "target": null, "type": null, "text": "前奏報未建者"}
{"id": null, "n": null, "target": null, "type": null, "text": "印度名稱"}
{"id": null, "n": null, "target": null, "type": null, "text": "文繁從略"}
{"id": null, "n": null, "target": null, "type": null, "text": "容"}
{"id": null, "n": null, "target": null, "type": null, "text": "所傳般若經典、密教儀軌，廣如經軌所載茲從畧"}
{"id": null, "n": null, "target": null, "type": null, "text": "其他文繁不備述"}
{"id": null, "n": null, "target": null, "type": null, "text": "名未詳"}
{"id": null, "n": null, "target": null, "type": null, "text": "今之康藏"}
{"id": null, "n": null, "target": null, "type": null, "text": "也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即尼泊爾"}
{"id": null, "n": null, "target": null, "type": null, "text": "也"}
{"id": null, "n": null, "target": null, "type": null, "text": "也"}
{"id": null, "n": null, "target": null, "type": null, "text": "夜"}
{"id": null, "n": null, "target": null, "type": null, "text": "容"}
{"id": null, "n": null, "target": null, "type": null, "text": "馬哈阿落阿兌"}
{"id": null, "n": null, "target": null, "type": null, "text": "若常人三日後煙爐\n都息"}
{"id": null, "n": null, "target": null, "type": null, "text": "今大師曼達那像繪王衣王冠者由此出"}
{"id": null, "n": null, "target": null, "type": null, "text": "大師護法"}
{"id": null, "n": null, "target": null, "type": null, "text": "杵十字形"}
{"id": null, "n": null, "target": null, "type": null, "text": "食肉獸似兔形"}
{"id": null, "n": null, "target": null, "type": null, "text": "面達所化"}
{"id": null, "n": null, "target": null, "type": null, "text": "用"}
{"id": null, "n": null, "target": null, "type": null, "text": "克"}
{"id": null, "n": null, "target": null, "type": null, "text": "優填王所造"}
{"id": null, "n": null, "target": null, "type": null, "text": "曾載堪輿原理文繁不具"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿"}
{"id": null, "n": null, "target": null, "type": null, "text": "現西康有喇嘛云其第四代祖師曾述大師此相，在某崆峒中啟峒，果見一忿怒相，類似泥塑云。"}
{"id": null, "n": null, "target": null, "type": null, "text": "該處距藏都約一日程"}
{"id": null, "n": null, "target": null, "type": null, "text": "融巴藏盛餚饌器"}
{"id": null, "n": null, "target": null, "type": null, "text": "容"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿字"}
{"id": null, "n": null, "target": null, "type": null, "text": "其中受比丘戒者五"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿"}
