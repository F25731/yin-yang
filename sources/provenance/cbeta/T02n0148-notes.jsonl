{"id": null, "n": "0873001", "target": "#nkr_note_mod_0873001", "type": "mod", "text": "國【大】，佛說國【宋】【元】【明】"}
{"id": null, "n": "0873002", "target": "#nkr_note_mod_0873002", "type": "mod", "text": "梨【大】＊，𥠖【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0873003", "target": "#nkr_note_mod_0873003", "type": "mod", "text": "泥【大】＊，尼【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0873004", "target": "#nkr_note_mod_0873004", "type": "mod", "text": "西域沙門【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0873005", "target": "#nkr_note_mod_0873005", "type": "mod", "text": "坐【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0873006", "target": "#nkr_note_mod_0873006", "type": "mod", "text": "飲【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0873007", "target": "#nkr_note_mod_0873007", "type": "mod", "text": "趍【大】＊，趨【明】＊"}
{"id": null, "n": "0873008", "target": "#nkr_note_mod_0873008", "type": "mod", "text": "身【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0873009", "target": "#nkr_note_mod_0873009", "type": "mod", "text": "祠【大】＊，祀【明】＊"}
{"id": null, "n": "0873010", "target": "#nkr_note_mod_0873010", "type": "mod", "text": "徐【大】，得【宋】【元】【明】"}
{"id": null, "n": "0873011", "target": "#nkr_note_mod_0873011", "type": "mod", "text": "氣【大】，氣出【宋】【元】【明】"}
{"id": null, "n": "0873012", "target": "#nkr_note_mod_0873012", "type": "mod", "text": "唯【大】，惟【宋】【元】【明】"}
{"id": null, "n": "0873013", "target": "#nkr_note_mod_0873013", "type": "mod", "text": "誡【大】，戒【宋】"}
{"id": null, "n": "0873014", "target": "#nkr_note_mod_0873014", "type": "mod", "text": "愁【大】，恐【宋】【元】【明】"}
{"id": null, "n": "0873015", "target": "#nkr_note_mod_0873015", "type": "mod", "text": "妷【大】，泆【宋】【元】【明】"}
{"id": null, "n": "0873016", "target": "#nkr_note_mod_0873016", "type": "mod", "text": "姤【大】，妬【宋】【元】【明】"}
{"id": null, "n": "0873017", "target": "#nkr_note_mod_0873017", "type": "mod", "text": "夢【大】＊，王夢【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0873018", "target": "#nkr_note_mod_0873018", "type": "mod", "text": "也【大】，〔－〕【明】"}
{"id": null, "n": "0873019", "target": "#nkr_note_mod_0873019", "type": "mod", "text": "菓【大】，果【宋】【元】【明】"}
{"id": null, "n": "0873020", "target": "#nkr_note_mod_0873020", "type": "mod", "text": "果【大】，果者【宋】【元】【明】"}
{"id": null, "n": "0873021", "target": "#nkr_note_mod_0873021", "type": "mod", "text": "置【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0873022", "target": "#nkr_note_mod_0873022", "type": "mod", "text": "者【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0873023", "target": "#nkr_note_mod_0873023", "type": "mod", "text": "犢【大】，小犢【宋】【元】【明】"}
{"id": null, "n": "0873024", "target": "#nkr_note_mod_0873024", "type": "mod", "text": "恤【大】，訹【元】【明】"}
{"id": null, "n": "0873025", "target": "#nkr_note_mod_0873025", "type": "mod", "text": "賣【大】，采【宋】【元】【明】"}
{"id": null, "n": "0873026", "target": "#nkr_note_mod_0873026", "type": "mod", "text": "供【大】，饒【宋】【元】【明】"}
{"id": null, "n": "0874001", "target": "#nkr_note_mod_0874001", "type": "mod", "text": "趍【大】＊，趣【元】＊，趨【明】＊"}
{"id": null, "n": "0874002", "target": "#nkr_note_mod_0874002", "type": "mod", "text": "雨去【大】，而去雨【宋】【元】【明】"}
{"id": null, "n": "0874003", "target": "#nkr_note_mod_0874003", "type": "mod", "text": "忿【大】，分【宋】【元】【明】"}
