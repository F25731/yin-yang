{"id": null, "n": null, "target": null, "type": "cf1", "text": "K11n0279_p0626b10"}
{"id": null, "n": null, "target": null, "type": null, "text": "此經，宋藏即云：灌洗佛形像經【CB】【麗-CB】，經像【大】像經K11n0279_p0626b07經像，法炬譯。撿尋經文，與宋藏中《摩訶剎頭經》相濫，即宋藏錯亂。今按丹本，此經却是《摩訶剎頭經》，聖堅【CB】【麗-CB】，賢【大】堅K11n0279_p0626b10賢譯者，今從丹本，換其經題及譯者云"}
{"id": null, "n": "0798b2801", "target": null, "type": "add", "text": "像經【CB】【麗-CB】，經像【大】"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K11n0279_p0626b07"}
{"id": null, "n": "0798c0101", "target": null, "type": "add", "text": "堅【CB】【麗-CB】，賢【大】"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K11n0279_p0626b10"}
{"id": null, "n": "0797006", "target": "#nkr_note_mod_0797006", "type": "mod", "text": "摩訶剎頭經【大】＊，灌洗佛經【宋】＊【元】＊【明】＊【宮】＊"}
{"id": null, "n": "0797007", "target": "#nkr_note_mod_0797007", "type": "mod", "text": "亦名灌佛形像經【大】，一名摩訶剎頭【宋】【元】【宮】，一名摩訶剎頭經【明】"}
{"id": null, "n": "0797008", "target": "#nkr_note_mod_0797008", "type": "mod", "text": "西【大】，乞伏【宋】【元】【明】【宮】"}
{"id": null, "n": "0797009", "target": "#nkr_note_mod_0797009", "type": "mod", "text": "釋【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "0797010", "target": "#nkr_note_mod_0797010", "type": "mod", "text": "視【大】，現【宋】【元】【明】【宮】"}
{"id": null, "n": "0797011", "target": "#nkr_note_mod_0797011", "type": "mod", "text": "今【大】，令【元】"}
{"id": null, "n": "0797012", "target": "#nkr_note_mod_0797012", "type": "mod", "text": "神【大】，神龍皆【宋】【元】【明】【宮】"}
{"id": null, "n": "0797013", "target": "#nkr_note_mod_0797013", "type": "mod", "text": "知【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0797014", "target": "#nkr_note_mod_0797014", "type": "mod", "text": "得聞【大】，值若【宋】【元】【明】【宮】"}
{"id": null, "n": "0798001", "target": "#nkr_note_mod_0798001", "type": "mod", "text": "巨億【大】，百億【元】【明】"}
{"id": null, "n": "0798002", "target": "#nkr_note_mod_0798002", "type": "mod", "text": "死【大】，坐財物死【宋】【元】【明】【宮】"}
{"id": null, "n": "0798003", "target": "#nkr_note_mod_0798003", "type": "mod", "text": "佛【大】，佛形象者【宋】【元】【明】【宮】"}
{"id": null, "n": "0798004", "target": "#nkr_note_mod_0798004", "type": "mod", "text": "利【大】，剎【明】"}
{"id": null, "n": "0798005", "target": "#nkr_note_mod_0798005", "type": "mod", "text": "緣【大】，緣令諸賢者疾【宋】【元】【明】【宮】"}
{"id": null, "n": "0798006", "target": "#nkr_note_mod_0798006", "type": "mod", "text": "好香湯浴【大】，好香華汁【宋】【元】【明】【宮】"}
{"id": null, "n": "0798007", "target": "#nkr_note_mod_0798007", "type": "mod", "text": "所在【大】，在所從生常得【宋】【元】【明】【宮】"}
{"id": null, "n": "0798008", "target": "#nkr_note_mod_0798008", "type": "mod", "text": "聞【大】，聞十方【宋】【元】【明】【宮】"}
{"id": null, "n": "0798009", "target": "#nkr_note_mod_0798009", "type": "mod", "text": "花【大】，花散【宋】【元】【明】【宮】"}
{"id": null, "n": "0798010", "target": "#nkr_note_mod_0798010", "type": "mod", "text": "端【大】，在所從生常得端【宋】【元】【明】【宮】"}
{"id": null, "n": "0798011", "target": "#nkr_note_mod_0798011", "type": "mod", "text": "分【大】，〔－〕【宮】"}
{"id": null, "n": "0798012", "target": "#nkr_note_mod_0798012", "type": "mod", "text": "塐【大】，塑【明】，素【宮】"}
{"id": null, "n": "0798013", "target": "#nkr_note_mod_0798013", "type": "mod", "text": "錢【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0798014", "target": "#nkr_note_mod_0798014", "type": "mod", "text": "現【大】，見【宋】【元】【明】【宮】"}
{"id": null, "n": "0798015", "target": "#nkr_note_mod_0798015", "type": "mod", "text": "必敬【大】，畢竟【宋】【元】【明】【宮】"}
{"id": null, "n": "0798016", "target": "#nkr_note_mod_0798016", "type": "mod", "text": "肴【大】，餚【宋】【元】【明】【宮】"}
{"id": null, "n": "0798017", "target": "#nkr_note_mod_0798017", "type": "mod", "text": "自【大】，曰【元】"}
{"id": null, "n": "0798018", "target": "#nkr_note_mod_0798018", "type": "mod", "text": "香【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0798019", "target": "#nkr_note_mod_0798019", "type": "mod", "text": "挼【大】＊，捼【宮】＊"}
{"id": null, "n": "0798020", "target": "#nkr_note_mod_0798020", "type": "mod", "text": "而【大】，之【宋】【元】【明】【宮】"}
{"id": null, "n": "0798021", "target": "#nkr_note_mod_0798021", "type": "mod", "text": "梔【大】，支【宋】【宮】"}
{"id": null, "n": "0798022", "target": "#nkr_note_mod_0798022", "type": "mod", "text": "（此經…云）六十四字【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0797006", "target": "#nkr_note_orig_0797006", "type": "orig", "text": "摩訶剎頭經＝灌洗佛經【三】【宮】＊"}
{"id": null, "n": "0797007", "target": "#nkr_note_orig_0797007", "type": "orig", "text": "亦名灌佛形像經＝一名摩訶剎頭【宋】【元】【宮】，一名摩訶剎頭經【明】"}
