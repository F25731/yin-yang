{"id": null, "n": "0798009", "target": "#nkr_note_orig_0798009", "type": "orig", "text": "花＋（散）【三】【宮】"}
{"id": null, "n": "0798010", "target": "#nkr_note_orig_0798010", "type": "orig", "text": "（在所從生常得）＋端【三】【宮】"}
{"id": null, "n": "0798011", "target": "#nkr_note_orig_0798011", "type": "orig", "text": "〔分〕－【宮】"}
{"id": null, "n": "0798012", "target": "#nkr_note_orig_0798012", "type": "orig", "text": "塐＝塑【明】，素【宮】"}
