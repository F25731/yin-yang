{"id": null, "n": "0798014", "target": "#nkr_note_orig_0798014", "type": "orig", "text": "現＝見【三】【宮】"}
{"id": null, "n": "0798015", "target": "#nkr_note_orig_0798015", "type": "orig", "text": "必敬＝畢竟【三】【宮】"}
{"id": null, "n": "0798016", "target": "#nkr_note_orig_0798016", "type": "orig", "text": "肴＝餚【三】【宮】"}
{"id": null, "n": "0798017", "target": "#nkr_note_orig_0798017", "type": "orig", "text": "自＝曰【元】"}
{"id": null, "n": "0798018", "target": "#nkr_note_orig_0798018", "type": "orig", "text": "〔香〕－【三】【宮】"}
{"id": null, "n": "0798019", "target": "#nkr_note_orig_0798019", "type": "orig", "text": "挼＝捼【宮】＊"}
{"id": null, "n": "0798020", "target": "#nkr_note_orig_0798020", "type": "orig", "text": "而＝之【三】【宮】"}
