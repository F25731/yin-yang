{"id": null, "n": null, "target": null, "type": null, "text": "一名弟子學有三輩"}
{"id": null, "n": "0700004", "target": "#nkr_note_mod_0700004", "type": "mod", "text": "經【大】，經一名弟子學有三輩【元】【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "一名弟子學有三輩"}
{"id": null, "n": "0700005", "target": "#nkr_note_mod_0700005", "type": "mod", "text": "月氏國居士【大】，〔－〕【宋】【宮】，月支優婆塞【元】【明】"}
{"id": null, "n": "0700006", "target": "#nkr_note_mod_0700006", "type": "mod", "text": "唯【大】，惟【宋】【元】【明】【宮】"}
{"id": null, "n": "0700007", "target": "#nkr_note_mod_0700007", "type": "mod", "text": "恣【大】，恣汝【宋】【元】【明】"}
{"id": null, "n": "0700008", "target": "#nkr_note_mod_0700008", "type": "mod", "text": "所【大】，〔－〕【宮】"}
{"id": null, "n": "0700009", "target": "#nkr_note_mod_0700009", "type": "mod", "text": "受【大】，諦受【宋】【元】【明】"}
{"id": null, "n": "0700010", "target": "#nkr_note_mod_0700010", "type": "mod", "text": "者【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "0701001", "target": "#nkr_note_mod_0701001", "type": "mod", "text": "菩薩【大】，菩薩法【宋】【元】【明】【宮】"}
{"id": null, "n": "0701002", "target": "#nkr_note_mod_0701002", "type": "mod", "text": "使【大】，方便【宋】【元】【明】【宮】"}
{"id": null, "n": "0701003", "target": "#nkr_note_mod_0701003", "type": "mod", "text": "芸【大】，雲【宋】【元】【明】【宮】"}
{"id": null, "n": "0701004", "target": "#nkr_note_mod_0701004", "type": "mod", "text": "意【大】，想【宋】【元】【明】【宮】"}
{"id": null, "n": "0701005", "target": "#nkr_note_mod_0701005", "type": "mod", "text": "欲【大】，敬【明】"}
{"id": null, "n": "0701006", "target": "#nkr_note_mod_0701006", "type": "mod", "text": "平【大】，手【宋】【元】【明】【宮】"}
{"id": null, "n": "0701007", "target": "#nkr_note_mod_0701007", "type": "mod", "text": "起【大】，趣【宋】【元】【明】【宮】"}
{"id": null, "n": "0701008", "target": "#nkr_note_mod_0701008", "type": "mod", "text": "或【大】，滅【宋】【元】【明】，威【宮】"}
{"id": null, "n": "0701009", "target": "#nkr_note_mod_0701009", "type": "mod", "text": "爾【大】，爾時【元】【明】"}
{"id": null, "n": "0701010", "target": "#nkr_note_mod_0701010", "type": "mod", "text": "條疏【大】，修疏戒【宋】【元】【明】，條疏戒【宮】"}
{"id": null, "n": "0701011", "target": "#nkr_note_mod_0701011", "type": "mod", "text": "戒【大】，〔－〕【宮】"}
{"id": null, "n": "0701012", "target": "#nkr_note_mod_0701012", "type": "mod", "text": "障【大】，彰【宋】【元】【明】【宮】"}
{"id": null, "n": "0700004", "target": "#nkr_note_orig_0700004", "type": "orig", "text": "經＋（一名弟子學有三輩）夾註【元】【明】"}
{"id": null, "n": "0700005", "target": "#nkr_note_orig_0700005", "type": "orig", "text": "〔月氏國居士〕－【宋】【宮】，月氏國居士＝月支優婆塞【元】【明】"}
{"id": null, "n": "0700006", "target": "#nkr_note_orig_0700006", "type": "orig", "text": "唯＝惟【三】【宮】"}
{"id": null, "n": "0700007", "target": "#nkr_note_orig_0700007", "type": "orig", "text": "恣＋（汝）【三】"}
{"id": null, "n": "0700008", "target": "#nkr_note_orig_0700008", "type": "orig", "text": "〔所〕－【宮】"}
{"id": null, "n": "0700009", "target": "#nkr_note_orig_0700009", "type": "orig", "text": "（諦）＋受【三】"}
{"id": null, "n": "0700010", "target": "#nkr_note_orig_0700010", "type": "orig", "text": "〔者〕－【宋】【宮】"}
{"id": null, "n": "0701001", "target": "#nkr_note_orig_0701001", "type": "orig", "text": "菩薩＋（法）【三】【宮】"}
{"id": null, "n": "0701002", "target": "#nkr_note_orig_0701002", "type": "orig", "text": "使＝方便【三】【宮】"}
{"id": null, "n": "0701003", "target": "#nkr_note_orig_0701003", "type": "orig", "text": "芸＝雲【三】【宮】"}
{"id": null, "n": "0701004", "target": "#nkr_note_orig_0701004", "type": "orig", "text": "意＝想【三】【宮】"}
{"id": null, "n": "0701005", "target": "#nkr_note_orig_0701005", "type": "orig", "text": "欲＝敬【明】"}
{"id": null, "n": "0701006", "target": "#nkr_note_orig_0701006", "type": "orig", "text": "平＝手【三】【宮】"}
{"id": null, "n": "0701007", "target": "#nkr_note_orig_0701007", "type": "orig", "text": "起＝趣【三】【宮】"}
{"id": null, "n": "0701008", "target": "#nkr_note_orig_0701008", "type": "orig", "text": "或＝滅【三】，威【宮】"}
{"id": null, "n": "0701009", "target": "#nkr_note_orig_0701009", "type": "orig", "text": "爾＋（時）【元】【明】"}
{"id": null, "n": "0701010", "target": "#nkr_note_orig_0701010", "type": "orig", "text": "條疏＝修疏戒【三】，條疏戒【宮】"}
{"id": null, "n": "0701011", "target": "#nkr_note_orig_0701011", "type": "orig", "text": "〔戒〕－【宮】"}
{"id": null, "n": "0701012", "target": "#nkr_note_orig_0701012", "type": "orig", "text": "障＝彰【三】【宮】"}
