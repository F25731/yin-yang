{"id": null, "n": "0155004", "target": "#nkr_note_orig_0155004", "type": "orig", "text": "「次分輕物律令白二」，見《大正藏》第40卷第116頁下。"}
{"id": null, "n": "0155005", "target": "#nkr_note_orig_0155005", "type": "orig", "text": "「若外界不集者」，見《大正藏》第40卷第117頁上。"}
{"id": null, "n": "0155006", "target": "#nkr_note_orig_0155006", "type": "orig", "text": "「如是總計大數」，見《大正藏》第40卷第117頁上。"}
{"id": null, "n": "0156001", "target": "#nkr_note_orig_0156001", "type": "orig", "text": "「受淨」，底本無，據文意補。"}
{"id": null, "n": "0156002", "target": "#nkr_note_orig_0156002", "type": "orig", "text": "「翻」，底本作「番」，據文意改。"}
{"id": null, "n": "0158001", "target": "#nkr_note_orig_0158001", "type": "orig", "text": "「寬狹」，《行事鈔》作「通塞」，見《大正藏》第40卷第124頁上。"}
{"id": null, "n": "0159001", "target": "#nkr_note_orig_0159001", "type": "orig", "text": "「明」，底本作「相」，據文意改。"}
{"id": null, "n": "0159002", "target": "#nkr_note_orig_0159002", "type": "orig", "text": "「餘有養生……自如後列」，見《大正藏》第40卷第124頁下～125頁上，文字略有差異。"}
{"id": null, "n": "0159003", "target": "#nkr_note_orig_0159003", "type": "orig", "text": "「合」，底本作「含」，據文意改。"}
{"id": null, "n": "0159004", "target": "#nkr_note_orig_0159004", "type": "orig", "text": "「聽教中……雜列之也」，見《大正藏》第40卷第126頁上。"}
{"id": null, "n": "0160001", "target": "#nkr_note_orig_0160001", "type": "orig", "text": "「納」，底本作「約」，據《行事鈔》改，見《大正藏》40卷129頁中。"}
{"id": null, "n": "0161001", "target": "#nkr_note_orig_0161001", "type": "orig", "text": "「《四分》十種非威儀不應禮」，見《大正藏》第40卷第132頁上。"}
{"id": null, "n": "0162001", "target": "#nkr_note_orig_0162001", "type": "orig", "text": "「客」，底本無，據《行事鈔》補。"}
{"id": null, "n": "0162002", "target": "#nkr_note_orig_0162002", "type": "orig", "text": "「《五分》……不得入」，見《大正藏》第40卷第136頁中。"}
{"id": null, "n": "0163001", "target": "#nkr_note_orig_0163001", "type": "orig", "text": "「《僧祇》云……行食人過」，見《大正藏》第40卷第137頁上。"}
{"id": null, "n": "0163002", "target": "#nkr_note_orig_0163002", "type": "orig", "text": "「俗譏責」，底本作「機」，據《行事鈔》改。"}
{"id": null, "n": "0163003", "target": "#nkr_note_orig_0163003", "type": "orig", "text": "「《四分》云……為俗譏責」，見《大正藏》第40卷第137頁中。"}
{"id": null, "n": "0163004", "target": "#nkr_note_orig_0163004", "type": "orig", "text": "「《僧祇》：食時應護左手」，見《大正藏》第40卷第137頁中。「左手」，《行事鈔》作「右手」。"}
{"id": null, "n": "0163005", "target": "#nkr_note_orig_0163005", "type": "orig", "text": "「翻」，底本作「番」，據文意改。"}
{"id": null, "n": "0164001", "target": "#nkr_note_orig_0164001", "type": "orig", "text": "「必若無人者」，《行事鈔》作「必無人者」，見《大正藏》第40卷第140頁上。"}
{"id": null, "n": "0164002", "target": "#nkr_note_orig_0164002", "type": "orig", "text": "「次受法者，《智論》云」，見《大正藏》第40卷第140頁上。"}
{"id": null, "n": "0164003", "target": "#nkr_note_orig_0164003", "type": "orig", "text": "「願持是布薩福報」，見《大正藏》第40卷第140頁中。"}
{"id": null, "n": "0164004", "target": "#nkr_note_orig_0164004", "type": "orig", "text": "「《僧祇》：佛告比丘」，見《大正藏》第40卷第140頁中。"}
{"id": null, "n": "0164005", "target": "#nkr_note_orig_0164005", "type": "orig", "text": "「餘更略出」，見《大正藏》第40卷第141頁下。"}
{"id": null, "n": "0164006", "target": "#nkr_note_orig_0164006", "type": "orig", "text": "「主客」，底本作「客主」，據文意改。"}
{"id": null, "n": "0165001", "target": "#nkr_note_orig_0165001", "type": "orig", "text": "「眾」，《行事鈔》作「畜」，見《大正藏》第40卷第145頁下。"}
{"id": null, "n": "0166001", "target": "#nkr_note_orig_0166001", "type": "orig", "text": "「之」，底本作「無」，據《行事鈔》改，見《大正藏》第40卷第148頁下。"}
{"id": null, "n": "0167001", "target": "#nkr_note_orig_0167001", "type": "orig", "text": "「非」，底本殘，據《行事鈔》補，見《大正藏》第40卷第152頁上。"}
{"id": null, "n": "0167002", "target": "#nkr_note_orig_0167002", "type": "orig", "text": "「數量」，底本殘，據《行事鈔》補，見《大正藏》第40卷第152頁上。"}
{"id": null, "n": "0167003", "target": "#nkr_note_orig_0167003", "type": "orig", "text": "「須結界」，底本殘，據《行事鈔》補，見《大正藏》第40卷第152頁中。"}
{"id": null, "n": "0167004", "target": "#nkr_note_orig_0167004", "type": "orig", "text": "「中」，底本殘，據《行事鈔》補，見《大正藏》第40卷第152頁中。"}
{"id": null, "n": "0167005", "target": "#nkr_note_orig_0167005", "type": "orig", "text": "「法」，底本殘，據《行事鈔》補。"}
{"id": null, "n": "0167006", "target": "#nkr_note_orig_0167006", "type": "orig", "text": "「以外受法問難戒體」，見《大正藏》第40卷第152頁中。"}
{"id": null, "n": "0132a1001", "target": "#nkr_note_add_0132a1001", "type": "add", "text": "穀【CB】，榖【藏外】"}
{"id": null, "n": "0151a1301", "target": "#nkr_note_add_0151a1301", "type": "add", "text": "穀【CB】，榖【藏外】"}
