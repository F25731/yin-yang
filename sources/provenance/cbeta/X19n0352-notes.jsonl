{"id": null, "n": "0921011", "target": "#nkr_note_orig_0921011", "type": "orig", "text": "妄想等四字一本無"}
{"id": null, "n": "0921012", "target": "#nkr_note_orig_0921012", "type": "orig", "text": "上下一有名字"}
{"id": null, "n": "0921013", "target": "#nkr_note_orig_0921013", "type": "orig", "text": "異作業字"}
{"id": null, "n": "0921014", "target": "#nkr_note_orig_0921014", "type": "orig", "text": "異上一有業字"}
{"id": null, "n": "0921015", "target": "#nkr_note_orig_0921015", "type": "orig", "text": "業一作乘"}
{"id": null, "n": "0921016", "target": "#nkr_note_orig_0921016", "type": "orig", "text": "一無若字"}
{"id": null, "n": "0921017", "target": "#nkr_note_orig_0921017", "type": "orig", "text": "生下一有等字"}
{"id": null, "n": "0921018", "target": "#nkr_note_orig_0921018", "type": "orig", "text": "一無信字"}
{"id": null, "n": "0921019", "target": "#nkr_note_orig_0921019", "type": "orig", "text": "當業一作業當得三字"}
{"id": null, "n": "0921020", "target": "#nkr_note_orig_0921020", "type": "orig", "text": "一無智字"}
{"id": null, "n": "0921021", "target": "#nkr_note_orig_0921021", "type": "orig", "text": "四下一有依字"}
{"id": null, "n": "0921022", "target": "#nkr_note_orig_0921022", "type": "orig", "text": "一無言字"}
{"id": null, "n": "0922001", "target": "#nkr_note_orig_0922001", "type": "orig", "text": "間下一有法字"}
{"id": null, "n": "0922002", "target": "#nkr_note_orig_0922002", "type": "orig", "text": "依藏本巳下自性清淨章第十三"}
{"id": null, "n": "0922003", "target": "#nkr_note_orig_0922003", "type": "orig", "text": "持下一有依也二字"}
{"id": null, "n": "0922004", "target": "#nkr_note_orig_0922004", "type": "orig", "text": "無作依於水三字"}
{"id": null, "n": "0922005", "target": "#nkr_note_orig_0922005", "type": "orig", "text": "持一作得"}
{"id": null, "n": "0922006", "target": "#nkr_note_orig_0922006", "type": "orig", "text": "一無其字"}
{"id": null, "n": "0922007", "target": "#nkr_note_orig_0922007", "type": "orig", "text": "聖作重"}
{"id": null, "n": "0922008", "target": "#nkr_note_orig_0922008", "type": "orig", "text": "異作果"}
{"id": null, "n": "0922009", "target": "#nkr_note_orig_0922009", "type": "orig", "text": "云一作可"}
{"id": null, "n": "0922010", "target": "#nkr_note_orig_0922010", "type": "orig", "text": "一無定一二字"}
{"id": null, "n": "0922011", "target": "#nkr_note_orig_0922011", "type": "orig", "text": "一無法字"}
{"id": null, "n": "0922012", "target": "#nkr_note_orig_0922012 #note_star_d", "type": "orig", "text": "體一作能次同"}
{"id": null, "n": "0922013", "target": "#nkr_note_orig_0922013", "type": "orig", "text": "謂一作法"}
{"id": null, "n": "0922014", "target": "#nkr_note_orig_0922014", "type": "orig", "text": "因一作目"}
{"id": null, "n": "0922015", "target": "#nkr_note_orig_0922015", "type": "orig", "text": "果下有果字"}
{"id": null, "n": "0922016", "target": "#nkr_note_orig_0922016", "type": "orig", "text": "有下有識字"}
{"id": null, "n": "0922017", "target": "#nkr_note_orig_0922017", "type": "orig", "text": "人執一作喻執蛇三字"}
{"id": null, "n": "0922018", "target": "#nkr_note_orig_0922018", "type": "orig", "text": "法一作強"}
{"id": null, "n": "0922019", "target": "#nkr_note_orig_0922019", "type": "orig", "text": "真下一有理字"}
{"id": null, "n": "0923001", "target": "#nkr_note_orig_0923001", "type": "orig", "text": "自性清淨章第十三"}
{"id": null, "n": "0923002", "target": "#nkr_note_orig_0923002 #note_star_e", "type": "orig", "text": "深一作染次同"}
{"id": null, "n": "0923003", "target": "#nkr_note_orig_0923003", "type": "orig", "text": "也下一本有剎那不善心者有垢如也十字"}
{"id": null, "n": "0923004", "target": "#nkr_note_orig_0923004", "type": "orig", "text": "情疑清"}
{"id": null, "n": "0923005", "target": "#nkr_note_orig_0923005", "type": "orig", "text": "如來真子章第十四"}
{"id": null, "n": "0923006", "target": "#nkr_note_orig_0923006", "type": "orig", "text": "歎一作難"}
{"id": null, "n": "0923007", "target": "#nkr_note_orig_0923007", "type": "orig", "text": "一無名意名三字"}
{"id": null, "n": "0923008", "target": "#nkr_note_orig_0923008", "type": "orig", "text": "人疑一"}
{"id": null, "n": "0923009", "target": "#nkr_note_orig_0923009", "type": "orig", "text": "得四等重出"}
{"id": null, "n": "0923010", "target": "#nkr_note_orig_0923010", "type": "orig", "text": "歎下一有於難二字"}
{"id": null, "n": "0923011", "target": "#nkr_note_orig_0923011", "type": "orig", "text": "勝鬘師子吼章第十五"}
{"id": null, "n": "0923012", "target": "#nkr_note_orig_0923012", "type": "orig", "text": "一無說巳二字"}
{"id": null, "n": "0923013", "target": "#nkr_note_orig_0923013", "type": "orig", "text": "如一作妙"}
{"id": null, "n": "0923014", "target": "#nkr_note_orig_0923014", "type": "orig", "text": "推疑惟"}
{"id": null, "n": "0924001", "target": "#nkr_note_orig_0924001", "type": "orig", "text": "是疑還"}
{"id": null, "n": "0924002", "target": "#nkr_note_orig_0924002", "type": "orig", "text": "含疑念"}
{"id": null, "n": "0924003", "target": "#nkr_note_orig_0924003", "type": "orig", "text": "一無於字"}
{"id": null, "n": "0924004", "target": "#nkr_note_orig_0924004", "type": "orig", "text": "難一作歎"}
{"id": null, "n": "0924005", "target": "#nkr_note_orig_0924005", "type": "orig", "text": "問下一有經字"}
{"id": null, "n": "0924006", "target": "#nkr_note_orig_0924006", "type": "orig", "text": "羅下疑脫蜜字"}
{"id": null, "n": "0924007", "target": "#nkr_note_orig_0924007", "type": "orig", "text": "如一作知"}
{"id": null, "n": "0924008", "target": "#nkr_note_orig_0924008", "type": "orig", "text": "離一作難"}
{"id": null, "n": "0924009", "target": "#nkr_note_orig_0924009", "type": "orig", "text": "諸疑聽"}
{"id": null, "n": "0924010", "target": "#nkr_note_orig_0924010", "type": "orig", "text": "一無二字"}
{"id": null, "n": "0924011", "target": "#nkr_note_orig_0924011", "type": "orig", "text": "歎一作歡喜二字"}
{"id": null, "n": "0924012", "target": "#nkr_note_orig_0924012", "type": "orig", "text": "部一作喜"}
{"id": null, "n": "0924013", "target": "#nkr_note_orig_0924013", "type": "orig", "text": "自春初一作月一字"}
{"id": null, "n": "0924014", "target": "#nkr_note_orig_0924014", "type": "orig", "text": "儀鳳二年慈恩示寂永淳元年此當四年之前"}
