{"id": null, "n": null, "target": null, "type": "cf1", "text": "《福州藏》（日本宮內庁書陵部藏大藏經db2第3059帖第17圖第11行）"}
{"id": null, "n": "1089001", "target": "#nkr_note_mod_1089001", "type": "mod", "text": "【原】佛蘭西國民圖書館藏燉煌本, P. 2141, 【甲】大英博物館藏燉煌本, S. 2436, 甲本序文缺之"}
{"id": null, "n": "1089002", "target": "#nkr_note_mod_1089002", "type": "mod", "text": "建康【大】，〔－〕【甲】"}
{"id": null, "n": "1089003", "target": "#nkr_note_mod_1089003", "type": "mod", "text": "為【大】，謂【甲】"}
{"id": null, "n": "1089004", "target": "#nkr_note_mod_1089004", "type": "mod", "text": "三【大】，一【甲】"}
{"id": null, "n": "1089005", "target": "#nkr_note_mod_1089005", "type": "mod", "text": "一一剎土【大】，天外在【甲】"}
{"id": null, "n": "1090001", "target": "#nkr_note_mod_1090001", "type": "mod", "text": "數【大】，依數【甲】"}
{"id": null, "n": "1091001", "target": "#nkr_note_mod_1091001", "type": "mod", "text": "解【大】，等解【考偽-大】"}
{"id": null, "n": "1093001", "target": "#nkr_note_mod_1093001", "type": "mod", "text": "之【大】，發趣之【考偽-大】"}
{"id": null, "n": "1098001", "target": "#nkr_note_mod_1098001", "type": "mod", "text": "所【大】，所覺【考偽-大】"}
{"id": null, "n": "1089001", "target": "#nkr_note_orig_1089001", "type": "orig", "text": "【原】佛蘭西國民圖書館藏燉煌本, P. 2141, 【甲】大英博物館藏燉煌本, S. 2436, 甲本序文缺之"}
{"id": null, "n": "1089002", "target": "#nkr_note_orig_1089002", "type": "orig", "text": "〔建康〕－【甲】"}
{"id": null, "n": "1089003", "target": "#nkr_note_orig_1089003", "type": "orig", "text": "為＝謂【甲】"}
