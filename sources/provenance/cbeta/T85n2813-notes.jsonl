{"id": null, "n": "1091001", "target": "#nkr_note_orig_1091001", "type": "orig", "text": "（等）＋解？"}
{"id": null, "n": "1093001", "target": "#nkr_note_orig_1093001", "type": "orig", "text": "（發趣）＋之？"}
{"id": null, "n": "1098001", "target": "#nkr_note_orig_1098001", "type": "orig", "text": "所＋（覺）？"}
{"id": null, "n": "1103001", "target": "#nkr_note_orig_1103001", "type": "orig", "text": "以下原本缺依甲本補載之"}
