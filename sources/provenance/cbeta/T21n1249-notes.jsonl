{"id": null, "n": null, "target": null, "type": null, "text": "二十二"}
{"id": null, "n": "0227033", "target": "#nkr_note_mod_0227033", "type": "mod", "text": "【原】享和元年刊長谷寺藏本，原本校異中略符〔ィ〕者龍肝師校合秀陽闍梨本，〔ぃ〕者龍肝師校合板橋日曜寺本，【甲】高山寺藏古寫本"}
{"id": null, "n": "0227034", "target": "#nkr_note_mod_0227034", "type": "mod", "text": "沙門大廣智【大】，〔－〕【校異Ａ-原】"}
{"id": null, "n": "0227035", "target": "#nkr_note_mod_0227035", "type": "mod", "text": "奉詔【大】，〔－〕【甲】"}
{"id": null, "n": "0227036", "target": "#nkr_note_mod_0227036", "type": "mod", "text": "渴【大】，偈【校異Ｂ-原】"}
{"id": null, "n": "0227037", "target": "#nkr_note_mod_0227037", "type": "mod", "text": "蔇【大】，𮓂【校異Ｂ-原】"}
{"id": null, "n": "0227038", "target": "#nkr_note_mod_0227038", "type": "mod", "text": "拏【大】，囉【校異Ｂ-原】"}
{"id": null, "n": "0227039", "target": "#nkr_note_mod_0227039", "type": "mod", "text": "毘【大】，比【甲】"}
{"id": null, "n": "0227040", "target": "#nkr_note_mod_0227040", "type": "mod", "text": "彌【大】，〔－〕【校異Ａ-原】"}
{"id": null, "n": "0228001", "target": "#nkr_note_mod_0228001", "type": "mod", "text": "𠰘【大】＊，呬【甲】＊"}
{"id": null, "n": "0228002", "target": "#nkr_note_mod_0228002", "type": "mod", "text": "吠【大】，跋【校異Ｂ-原】，跋【考偽-原】"}
{"id": null, "n": "0228003", "target": "#nkr_note_mod_0228003", "type": "mod", "text": "囉【大】，羅【校異Ｂ-原】"}
{"id": null, "n": "0228004", "target": "#nkr_note_mod_0228004", "type": "mod", "text": "澄【大】，定【校異Ｂ-原】"}
{"id": null, "n": "0228005", "target": "#nkr_note_mod_0228005", "type": "mod", "text": "莎【大】，婆【校異Ａ-原】，娑【甲】"}
{"id": null, "n": "0228006", "target": "#nkr_note_mod_0228006", "type": "mod", "text": "言【大】，言曰【校異Ａ-原】"}
{"id": null, "n": "0228007", "target": "#nkr_note_mod_0228007", "type": "mod", "text": "薜【CB】【卍續-CB】，薛【大】，𮓂【原】"}
{"id": null, "n": "0228008", "target": "#nkr_note_mod_0228008", "type": "mod", "text": "娑【大】，沙【甲】"}
{"id": null, "n": "0228009", "target": "#nkr_note_mod_0228009", "type": "mod", "text": "真【大】，呪【校異Ａ-原】"}
{"id": null, "n": "0228010", "target": "#nkr_note_mod_0228010", "type": "mod", "text": "羅【大】，〔－〕【甲】"}
{"id": null, "n": "0228011", "target": "#nkr_note_mod_0228011", "type": "mod", "text": "娑【大】＊，莎【校異Ａ-原】＊，沙【甲】"}
{"id": null, "n": "0228012", "target": "#nkr_note_mod_0228012", "type": "mod", "text": "沙【大】，娑【校異Ａ-原】"}
{"id": null, "n": "0228013", "target": "#nkr_note_mod_0228013", "type": "mod", "text": "辛【大】，〔－〕【甲】"}
{"id": null, "n": "0228014", "target": "#nkr_note_mod_0228014", "type": "mod", "text": "溈慮蠶【大】，𪳵盧產【校異Ｂ-原】"}
{"id": null, "n": "0228015", "target": "#nkr_note_mod_0228015", "type": "mod", "text": "淴【大】＊，總【考偽-原】＊"}
{"id": null, "n": "0228016", "target": "#nkr_note_mod_0228016", "type": "mod", "text": "婆【大】，娑【校異Ａ-原】"}
{"id": null, "n": "0228017", "target": "#nkr_note_mod_0228017", "type": "mod", "text": "薜【大】，𮓂【校異Ａ-原】"}
{"id": null, "n": "0228018", "target": "#nkr_note_mod_0228018", "type": "mod", "text": "娑【大】，耶莎【校異Ａ-原】，沙【甲】"}
{"id": null, "n": "0228019", "target": "#nkr_note_mod_0228019", "type": "mod", "text": "殑【大】，施【校異Ｂ-原】"}
{"id": null, "n": "0228020", "target": "#nkr_note_mod_0228020", "type": "mod", "text": "仚【大】，企【校異Ｂ-原】"}
{"id": null, "n": "0228021", "target": "#nkr_note_mod_0228021", "type": "mod", "text": "寫【大】，〔－〕【甲】"}
{"id": null, "n": "0228022", "target": "#nkr_note_mod_0228022", "type": "mod", "text": "瞢【大】，普【甲】"}
{"id": null, "n": "0228023", "target": "#nkr_note_mod_0228023", "type": "mod", "text": "耶【大】，那【校異Ｂ-原】"}
{"id": null, "n": "0228024", "target": "#nkr_note_mod_0228024", "type": "mod", "text": "薩【大】，薩婆【校異Ｂ-原】"}
{"id": null, "n": "0228025", "target": "#nkr_note_mod_0228025", "type": "mod", "text": "壇作法【大】，〔－〕【校異Ａ-原】"}
{"id": null, "n": "0228026", "target": "#nkr_note_mod_0228026", "type": "mod", "text": "量【大】，〔－〕【甲】"}
{"id": null, "n": "0228027", "target": "#nkr_note_mod_0228027", "type": "mod", "text": "著【大】，〔－〕【甲】"}
{"id": null, "n": "0228028", "target": "#nkr_note_mod_0228028", "type": "mod", "text": "法【大】，〔－〕【校異Ａ-原】"}
{"id": null, "n": "0228029", "target": "#nkr_note_mod_0228029", "type": "mod", "text": "天木【大】，煎【校異Ｂ-原】"}
{"id": null, "n": "0228030", "target": "#nkr_note_mod_0228030", "type": "mod", "text": "膽【大】，瞻【甲】"}
{"id": null, "n": "0228031", "target": "#nkr_note_mod_0228031", "type": "mod", "text": "祝【大】，謹【甲】"}
{"id": null, "n": "0228032", "target": "#nkr_note_mod_0228032", "type": "mod", "text": "由【大】，當【考偽-原】，而【考偽-原】"}
{"id": null, "n": "0228033", "target": "#nkr_note_mod_0228033", "type": "mod", "text": "了【大】，畢【校異Ａ-原】，〔－〕【校異Ｂ-原】"}
{"id": null, "n": "0228034", "target": "#nkr_note_mod_0228034", "type": "mod", "text": "大【大】，〔－〕【甲】"}
{"id": null, "n": "0228035", "target": "#nkr_note_mod_0228035", "type": "mod", "text": "王【大】，王儀軌畢【校異Ｂ-原】"}
{"id": null, "n": "0228036", "target": "#nkr_note_mod_0228036", "type": "mod", "text": "五【大】，〔－〕【校異Ａ-原】"}
{"id": null, "n": "0228037", "target": "#nkr_note_mod_0228037", "type": "mod", "text": "禪【大】，〔－〕【甲】"}
{"id": null, "n": "0228038", "target": "#nkr_note_mod_0228038", "type": "mod", "text": "其【大】，某【甲】"}
{"id": null, "n": "0228039", "target": "#nkr_note_mod_0228039", "type": "mod", "text": "（聖人…上卷）六百五十六字【大】，〔－〕【原】"}
{"id": null, "n": "0228040", "target": "#nkr_note_mod_0228040", "type": "mod", "text": "墜【大】，隊【校異Ａ-原】，隊【考偽-原】"}
{"id": null, "n": "0228041", "target": "#nkr_note_mod_0228041", "type": "mod", "text": "中【大】，仲【甲】"}
{"id": null, "n": "0228042", "target": "#nkr_note_mod_0228042", "type": "mod", "text": "養【大】＊，奉【甲】＊"}
