{"id": null, "n": "0492001", "target": "#nkr_note_orig_0492001", "type": "orig", "text": "篇＝偏【宮】＊"}
{"id": null, "n": "0492002", "target": "#nkr_note_orig_0492002", "type": "orig", "text": "人一＝一人【三】【宮】"}
{"id": null, "n": "0492003", "target": "#nkr_note_orig_0492003", "type": "orig", "text": "如是三說四字宋本元本明本俱作夾註"}
{"id": null, "n": "0492004", "target": "#nkr_note_orig_0492004", "type": "orig", "text": "若＝者【三】【宮】"}
{"id": null, "n": "0492005", "target": "#nkr_note_orig_0492005", "type": "orig", "text": "當＝畜【宮】"}
{"id": null, "n": "0492006", "target": "#nkr_note_orig_0492006", "type": "orig", "text": "〔見〕－【三】【宮】"}
