{"id": null, "n": "0181006", "target": "#nkr_note_mod_0181006", "type": "mod", "text": "夜【大】，夜反【考偽-原】"}
{"id": null, "n": "0181007", "target": "#nkr_note_mod_0181007", "type": "mod", "text": "跋【大】，跛【考偽-原】"}
{"id": null, "n": "0184001", "target": "#nkr_note_mod_0184001", "type": "mod", "text": "住【大】，作【校異-原】"}
{"id": null, "n": "0186003", "target": "#nkr_note_mod_0186003", "type": "mod", "text": "真【大】，最真【考偽-原】"}
{"id": null, "n": "0181003", "target": "#nkr_note_orig_0181003", "type": "orig", "text": "【原】豐山版"}
{"id": null, "n": "0181004", "target": "#nkr_note_orig_0181004", "type": "orig", "text": "原本冠註曰密契大日經七作密印"}
{"id": null, "n": "0181005", "target": "#nkr_note_orig_0181005", "type": "orig", "text": "原本冠註曰歸命方便經七作作禮方便"}
{"id": null, "n": "0181006", "target": "#nkr_note_orig_0181006", "type": "orig", "text": "夜＋（反）ヵ【原】"}
{"id": null, "n": "0181007", "target": "#nkr_note_orig_0181007", "type": "orig", "text": "跋＝跛ヵ【原】"}
{"id": null, "n": "0181008", "target": "#nkr_note_orig_0181008", "type": "orig", "text": "原本冠註曰枳哆二字經七無"}
{"id": null, "n": "0181009", "target": "#nkr_note_orig_0181009", "type": "orig", "text": "原本冠註曰無垢地經七作無垢處"}
{"id": null, "n": "0181010", "target": "#nkr_note_orig_0181010", "type": "orig", "text": "原本冠註曰法界體經七作法界身"}
{"id": null, "n": "0182001", "target": "#nkr_note_orig_0182001", "type": "orig", "text": "原本冠註曰諸有情經七作眾生故"}
{"id": null, "n": "0182002", "target": "#nkr_note_orig_0182002", "type": "orig", "text": "原本冠註曰嚩枳質多二合經七無"}
{"id": null, "n": "0182003", "target": "#nkr_note_orig_0182003", "type": "orig", "text": "原本覽字傍有􄙈"}
{"id": null, "n": "0182004", "target": "#nkr_note_orig_0182004", "type": "orig", "text": "原本訶字傍有􄚨"}
{"id": null, "n": "0182005", "target": "#nkr_note_orig_0182005", "type": "orig", "text": "原本嚩字傍有􄙖"}
{"id": null, "n": "0182006", "target": "#nkr_note_orig_0182006", "type": "orig", "text": "原本阿字傍有􆿅"}
{"id": null, "n": "0183001", "target": "#nkr_note_orig_0183001", "type": "orig", "text": "原本冠註曰加備謂被與備音通歟"}
{"id": null, "n": "0184001", "target": "#nkr_note_orig_0184001", "type": "orig", "text": "住＝作ィ【原】"}
{"id": null, "n": "0184002", "target": "#nkr_note_orig_0184002", "type": "orig", "text": "原本覽字傍有􄙈"}
{"id": null, "n": "0184003", "target": "#nkr_note_orig_0184003", "type": "orig", "text": "原本冠註曰燒食例次常翻之"}
{"id": null, "n": "0184004", "target": "#nkr_note_orig_0184004", "type": "orig", "text": "原本冠註曰二合下經七有四字"}
{"id": null, "n": "0186001", "target": "#nkr_note_orig_0186001", "type": "orig", "text": "原本冠註曰真實經七作真言"}
{"id": null, "n": "0186002", "target": "#nkr_note_orig_0186002", "type": "orig", "text": "原本冠註曰隨意經七作隨息"}
{"id": null, "n": "0186003", "target": "#nkr_note_orig_0186003", "type": "orig", "text": "（最）ヵ＋真【原】"}
{"id": null, "n": "0186004", "target": "#nkr_note_orig_0186004", "type": "orig", "text": "原本冠註曰無礙經七作無等"}
{"id": null, "n": "0187001", "target": "#nkr_note_orig_0187001", "type": "orig", "text": "原本冠註曰若由經七作若故"}
{"id": null, "n": "0187002", "target": "#nkr_note_orig_0187002", "type": "orig", "text": "原本冠註曰一分經七作少分"}
{"id": null, "n": "0187003", "target": "#nkr_note_orig_0187003", "type": "orig", "text": "原本冠註曰與經七作而"}
{"id": null, "n": "0187004", "target": "#nkr_note_orig_0187004", "type": "orig", "text": "原本冠註曰誦讀經七作讀誦"}
{"id": null, "n": "0187005", "target": "#nkr_note_orig_0187005", "type": "orig", "text": "原本冠註曰覆經七作愛"}
{"id": null, "n": "0187006", "target": "#nkr_note_orig_0187006", "type": "orig", "text": "原本冠註曰展轉也開也整也誠也"}
{"id": null, "n": "0187007", "target": "#nkr_note_orig_0187007", "type": "orig", "text": "原本冠註曰傾動下經七有以字"}
{"id": null, "n": "0187008", "target": "#nkr_note_orig_0187008", "type": "orig", "text": "原本冠註曰護方等者謂方隅等結護也"}
{"id": null, "n": "0187009", "target": "#nkr_note_orig_0187009", "type": "orig", "text": "原本冠註曰南字經七無"}
{"id": null, "n": "0187010", "target": "#nkr_note_orig_0187010", "type": "orig", "text": "原本冠註曰急呼二合下經七有六字"}
{"id": null, "n": "0187011", "target": "#nkr_note_orig_0187011", "type": "orig", "text": "原本冠註曰量經七作盡"}
{"id": null, "n": "0188001", "target": "#nkr_note_orig_0188001", "type": "orig", "text": "原本冠註曰當經七作常"}
