{"id": null, "n": "0773004", "target": "#nkr_note_mod_0773004", "type": "mod", "text": "菩薩【大】＊，佛說菩薩【明】＊"}
{"id": null, "n": "0773005", "target": "#nkr_note_mod_0773005", "type": "mod", "text": "月氏三藏【大】，三藏法師【宋】【元】【明】"}
{"id": null, "n": "0773006", "target": "#nkr_note_mod_0773006", "type": "mod", "text": "若【大】，𢜪【宋】【元】【明】【宮】"}
{"id": null, "n": "0773007", "target": "#nkr_note_mod_0773007", "type": "mod", "text": "婇【大】，采【宋】【元】【明】【宮】"}
{"id": null, "n": "0773008", "target": "#nkr_note_mod_0773008", "type": "mod", "text": "經【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "0773009", "target": "#nkr_note_mod_0773009", "type": "mod", "text": "正【大】，改【宋】【元】【明】【宮】"}
{"id": null, "n": "0773010", "target": "#nkr_note_mod_0773010", "type": "mod", "text": "空【大】，虛【宮】"}
{"id": null, "n": "0773011", "target": "#nkr_note_mod_0773011", "type": "mod", "text": "姝【大】，殊【宋】【元】【明】【宮】"}
{"id": null, "n": "0773012", "target": "#nkr_note_mod_0773012", "type": "mod", "text": "梳【大】，䟽【元】【明】"}
{"id": null, "n": "0773013", "target": "#nkr_note_mod_0773013", "type": "mod", "text": "蟲蟻【大】，虫蛾【宋】，蟲蛾【宮】"}
{"id": null, "n": "0773014", "target": "#nkr_note_mod_0773014", "type": "mod", "text": "佛【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0773015", "target": "#nkr_note_mod_0773015", "type": "mod", "text": "鞈【大】，協【宋】【元】【明】【宮】"}
{"id": null, "n": "0774001", "target": "#nkr_note_mod_0774001", "type": "mod", "text": "用【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0774002", "target": "#nkr_note_mod_0774002", "type": "mod", "text": "愈【大】，喻【元】【明】，俞【宮】"}
{"id": null, "n": "0774003", "target": "#nkr_note_mod_0774003", "type": "mod", "text": "為【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0774004", "target": "#nkr_note_mod_0774004", "type": "mod", "text": "治【大】，去【宋】【元】【明】【宮】"}
{"id": null, "n": "0774005", "target": "#nkr_note_mod_0774005", "type": "mod", "text": "人【大】，見人【宋】【元】【明】【宮】"}
{"id": null, "n": "0774006", "target": "#nkr_note_mod_0774006", "type": "mod", "text": "蟲【大】，虫【宋】"}
{"id": null, "n": "0774007", "target": "#nkr_note_mod_0774007", "type": "mod", "text": "治【大】，持【宋】【元】【明】【宮】"}
{"id": null, "n": "0774008", "target": "#nkr_note_mod_0774008", "type": "mod", "text": "美【大】，靡【元】【明】【宮】"}
{"id": null, "n": "0774009", "target": "#nkr_note_mod_0774009", "type": "mod", "text": "嵐【大】＊，藍【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0774010", "target": "#nkr_note_mod_0774010", "type": "mod", "text": "是【大】，用是【宋】【元】【明】【宮】"}
{"id": null, "n": "0774011", "target": "#nkr_note_mod_0774011", "type": "mod", "text": "梵釋【大】，釋梵【宋】【元】【明】【宮】"}
