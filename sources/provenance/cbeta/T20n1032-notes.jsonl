{"id": null, "n": null, "target": null, "type": null, "text": "二十一"}
{"id": null, "n": null, "target": null, "type": null, "text": "二十一"}
{"id": null, "n": "0006032", "target": "#nkr_note_mod_0006032", "type": "mod", "text": "一卷【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0006033", "target": "#nkr_note_mod_0006033", "type": "mod", "text": "（開府…智）三十三字【大】，〔－〕【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0006034", "target": "#nkr_note_mod_0006034", "type": "mod", "text": "大興善寺【大】，唐北天竺【明】"}
{"id": null, "n": "0006035", "target": "#nkr_note_mod_0006035", "type": "mod", "text": "不【大】，大廣智不【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0006036", "target": "#nkr_note_mod_0006036", "type": "mod", "text": "指【大】，相【宋】"}
{"id": null, "n": "0006037", "target": "#nkr_note_mod_0006037", "type": "mod", "text": "秫【大】，戍【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0006038", "target": "#nkr_note_mod_0006038", "type": "mod", "text": "摩【大】＊，麼【明】＊"}
{"id": null, "n": "0006039", "target": "#nkr_note_mod_0006039", "type": "mod", "text": "娑嚩二合婆嚩【大】，薩嚩婆嚩二合【宋】【元】【明】【乙】，薩嚩娑嚩二合【甲】"}
{"id": null, "n": "0006040", "target": "#nkr_note_mod_0006040", "type": "mod", "text": "反【大】下同，切【明】下同"}
{"id": null, "n": "0006041", "target": "#nkr_note_mod_0006041", "type": "mod", "text": "加【大】，跏【明】【甲】【乙】"}
{"id": null, "n": "0006042", "target": "#nkr_note_mod_0006042", "type": "mod", "text": "加【大】，跏趺【明】，跏【甲】【乙】"}
{"id": null, "n": "0006043", "target": "#nkr_note_mod_0006043", "type": "mod", "text": "掌【大】，拳【乙】"}
{"id": null, "n": "0007001", "target": "#nkr_note_mod_0007001", "type": "mod", "text": "三【大】，二【明】"}
{"id": null, "n": "0007002", "target": "#nkr_note_mod_0007002", "type": "mod", "text": "勢【大】，契【乙】"}
{"id": null, "n": "0007003", "target": "#nkr_note_mod_0007003", "type": "mod", "text": "中【大】，手中【明】"}
{"id": null, "n": "0007004", "target": "#nkr_note_mod_0007004", "type": "mod", "text": "垂【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0007006", "target": "#nkr_note_mod_0007006", "type": "mod", "text": "二合引【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0007007", "target": "#nkr_note_mod_0007007", "type": "mod", "text": "引【大】，〔－〕【明】"}
{"id": null, "n": "0007010", "target": "#nkr_note_mod_0007010", "type": "mod", "text": "引【大】＊，〔－〕【明】【甲】【乙】＊"}
{"id": null, "n": "0007011", "target": "#nkr_note_mod_0007011", "type": "mod", "text": "惡【大】，噁【明】"}
{"id": null, "n": "0007012", "target": "#nkr_note_mod_0007012", "type": "mod", "text": "急【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0007013", "target": "#nkr_note_mod_0007013", "type": "mod", "text": "二【大】，三【甲】"}
{"id": null, "n": "0007014", "target": "#nkr_note_mod_0007014", "type": "mod", "text": "拄【大】＊，柱【乙】＊"}
{"id": null, "n": "0007015", "target": "#nkr_note_mod_0007015", "type": "mod", "text": "彌【大】，弭【明】"}
{"id": null, "n": "0007016", "target": "#nkr_note_mod_0007016", "type": "mod", "text": "但【大】，怛【宋】【元】"}
{"id": null, "n": "0007017", "target": "#nkr_note_mod_0007017", "type": "mod", "text": "畝【大】，母【明】"}
{"id": null, "n": "0007018", "target": "#nkr_note_mod_0007018", "type": "mod", "text": "轉【大】，輪【乙】"}
{"id": null, "n": "0007019", "target": "#nkr_note_mod_0007019", "type": "mod", "text": "唎【大】，哩【明】"}
{"id": null, "n": "0007020", "target": "#nkr_note_mod_0007020", "type": "mod", "text": "一【大】，百【宋】【元】"}
{"id": null, "n": "0007021", "target": "#nkr_note_mod_0007021", "type": "mod", "text": "姹【大】＊，吒【明】＊"}
{"id": null, "n": "0007022", "target": "#nkr_note_mod_0007022", "type": "mod", "text": "訶【大】，賀【明】"}
{"id": null, "n": "0007023", "target": "#nkr_note_mod_0007023", "type": "mod", "text": "含【大】，舍【甲】"}
{"id": null, "n": "0007024", "target": "#nkr_note_mod_0007024", "type": "mod", "text": "他孽【大】，多孽【明】，他蘖【乙】"}
{"id": null, "n": "0007025", "target": "#nkr_note_mod_0007025", "type": "mod", "text": "多【大】，多引【宋】【元】，哆【明】"}
{"id": null, "n": "0007026", "target": "#nkr_note_mod_0007026", "type": "mod", "text": "摩【大】，麼【宋】【元】【明】"}
{"id": null, "n": "0007027", "target": "#nkr_note_mod_0007027", "type": "mod", "text": "地【大】，成【宋】【元】，備【明】"}
{"id": null, "n": "0007028", "target": "#nkr_note_mod_0007028", "type": "mod", "text": "縛結【大】，結縛【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0007029", "target": "#nkr_note_mod_0007029", "type": "mod", "text": "蹙【大】，戚【乙】"}
{"id": null, "n": "0007030", "target": "#nkr_note_mod_0007030", "type": "mod", "text": "𡀔【大】，𠸪【宋】【元】【明】【甲】，洛【乙】"}
{"id": null, "n": "0007031", "target": "#nkr_note_mod_0007031", "type": "mod", "text": "額【大】，頭【甲】【乙】"}
{"id": null, "n": "0007032", "target": "#nkr_note_mod_0007032", "type": "mod", "text": "磨【大】，麼【明】"}
{"id": null, "n": "0007033", "target": "#nkr_note_mod_0007033", "type": "mod", "text": "指【大】，指押【宋】【元】【明】"}
{"id": null, "n": "0007034", "target": "#nkr_note_mod_0007034", "type": "mod", "text": "跕【大】，砧【宋】【元】【明】"}
{"id": null, "n": "0007035", "target": "#nkr_note_mod_0007035", "type": "mod", "text": "背上三繞【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0007036", "target": "#nkr_note_mod_0007036", "type": "mod", "text": "三【大】，三遍【明】"}
{"id": null, "n": "0007037", "target": "#nkr_note_mod_0007037", "type": "mod", "text": "史【大】，使【明】"}
{"id": null, "n": "0007038", "target": "#nkr_note_mod_0007038", "type": "mod", "text": "斛【大】，斛引【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0007039", "target": "#nkr_note_mod_0007039", "type": "mod", "text": "上【大】，上聲【明】，〔－〕【甲】"}
{"id": null, "n": "0007040", "target": "#nkr_note_mod_0007040", "type": "mod", "text": "二合【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0007041", "target": "#nkr_note_mod_0007041", "type": "mod", "text": "次【大】，次結【甲】【乙】"}
{"id": null, "n": "0008001", "target": "#nkr_note_mod_0008001", "type": "mod", "text": "大【大】，〔－〕【甲】"}
{"id": null, "n": "0008002", "target": "#nkr_note_mod_0008002", "type": "mod", "text": "二合吒𤚥【大】，吒二合鑁【宋】【元】【明】，吒三合𤚥【甲】【乙】"}
{"id": null, "n": "0008003", "target": "#nkr_note_mod_0008003", "type": "mod", "text": "遏【大】，閼【明】"}
{"id": null, "n": "0008004", "target": "#nkr_note_mod_0008004", "type": "mod", "text": "背【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0008005", "target": "#nkr_note_mod_0008005", "type": "mod", "text": "𡀔【大】，路【宋】【元】【甲】"}
{"id": null, "n": "0008006", "target": "#nkr_note_mod_0008006", "type": "mod", "text": "坼【大】，吒【明】"}
{"id": null, "n": "0008007", "target": "#nkr_note_mod_0008007", "type": "mod", "text": "摩【大】，磨【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0008008", "target": "#nkr_note_mod_0008008", "type": "mod", "text": "葉【大】，華【宋】【元】【明】"}
{"id": null, "n": "0008009", "target": "#nkr_note_mod_0008009", "type": "mod", "text": "本【大】，本尊【乙】"}
{"id": null, "n": "0008010", "target": "#nkr_note_mod_0008010", "type": "mod", "text": "里【大】，哩【明】"}
{"id": null, "n": "0008011", "target": "#nkr_note_mod_0008011", "type": "mod", "text": "誦三遍【大】，三遍誦【宋】【元】【甲】【乙】"}
{"id": null, "n": "0008012", "target": "#nkr_note_mod_0008012", "type": "mod", "text": "臂【大】，擘【甲】【乙】"}
{"id": null, "n": "0008013", "target": "#nkr_note_mod_0008013", "type": "mod", "text": "𡀔【大】，𠸪【宋】【元】"}
