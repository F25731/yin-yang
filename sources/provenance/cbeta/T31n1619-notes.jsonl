{"id": null, "n": null, "target": null, "type": null, "text": "全"}
{"id": null, "n": "0882010", "target": "#nkr_note_mod_0882010", "type": "mod", "text": "陳那菩薩造【大】，〔－〕【宮】"}
{"id": null, "n": "0882011", "target": "#nkr_note_mod_0882011", "type": "mod", "text": "陳西印度三藏法師【大】，陳世三藏【宋】【元】【宮】，陳三藏【明】"}
{"id": null, "n": "0882012", "target": "#nkr_note_mod_0882012", "type": "mod", "text": "本【大】，等【宋】【元】【明】【宮】"}
{"id": null, "n": "0882013", "target": "#nkr_note_mod_0882013", "type": "mod", "text": "若【大】，如【宋】【元】【明】【宮】"}
{"id": null, "n": "0882014", "target": "#nkr_note_mod_0882014", "type": "mod", "text": "識【大】，〔－〕【宮】"}
{"id": null, "n": "0882015", "target": "#nkr_note_mod_0882015", "type": "mod", "text": "別【大】，〔－〕【宋】【元】【明】，分【宮】"}
{"id": null, "n": "0882016", "target": "#nkr_note_mod_0882016", "type": "mod", "text": "故【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0883001", "target": "#nkr_note_mod_0883001", "type": "mod", "text": "是【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0883002", "target": "#nkr_note_mod_0883002", "type": "mod", "text": "此【大】，根【宋】【元】【明】【宮】"}
{"id": null, "n": "0883003", "target": "#nkr_note_mod_0883003", "type": "mod", "text": "能【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0883004", "target": "#nkr_note_mod_0883004", "type": "mod", "text": "故起【大】，起故【宋】【元】【明】【宮】"}
{"id": null, "n": "0883005", "target": "#nkr_note_mod_0883005", "type": "mod", "text": "於【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0883006", "target": "#nkr_note_mod_0883006", "type": "mod", "text": "外塵【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0883007", "target": "#nkr_note_mod_0883007", "type": "mod", "text": "問【大】＊，問曰【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0883008", "target": "#nkr_note_mod_0883008", "type": "mod", "text": "若【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0883009", "target": "#nkr_note_mod_0883009", "type": "mod", "text": "在【大】，〔－〕【宮】"}
{"id": null, "n": "0883010", "target": "#nkr_note_mod_0883010", "type": "mod", "text": "生【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0883011", "target": "#nkr_note_mod_0883011", "type": "mod", "text": "答【大】，答曰【宋】【元】【明】【宮】"}
{"id": null, "n": "0883012", "target": "#nkr_note_mod_0883012", "type": "mod", "text": "果【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0883013", "target": "#nkr_note_mod_0883013", "type": "mod", "text": "論【大】，論一卷【宋】【宮】，論全【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "全"}
{"id": null, "n": "0882010", "target": "#nkr_note_orig_0882010", "type": "orig", "text": "〔陳那菩薩造〕－【宮】"}
{"id": null, "n": "0882011", "target": "#nkr_note_orig_0882011", "type": "orig", "text": "陳西印度三藏法師＝陳世三藏【宋】【元】【宮】，陳三藏【明】"}
{"id": null, "n": "0882012", "target": "#nkr_note_orig_0882012", "type": "orig", "text": "本＝等【三】【宮】"}
{"id": null, "n": "0882013", "target": "#nkr_note_orig_0882013", "type": "orig", "text": "若＝如【三】【宮】"}
{"id": null, "n": "0882014", "target": "#nkr_note_orig_0882014", "type": "orig", "text": "〔識〕－【宮】"}
{"id": null, "n": "0882015", "target": "#nkr_note_orig_0882015", "type": "orig", "text": "〔別〕－【三】，別＝分【宮】"}
{"id": null, "n": "0882016", "target": "#nkr_note_orig_0882016", "type": "orig", "text": "〔故〕－【三】【宮】"}
{"id": null, "n": "0883001", "target": "#nkr_note_orig_0883001", "type": "orig", "text": "〔是〕－【三】【宮】"}
{"id": null, "n": "0883002", "target": "#nkr_note_orig_0883002", "type": "orig", "text": "此＝根【三】【宮】"}
{"id": null, "n": "0883003", "target": "#nkr_note_orig_0883003", "type": "orig", "text": "〔能〕－【三】【宮】"}
{"id": null, "n": "0883004", "target": "#nkr_note_orig_0883004", "type": "orig", "text": "故起＝起故【三】【宮】"}
{"id": null, "n": "0883005", "target": "#nkr_note_orig_0883005", "type": "orig", "text": "〔於〕－【三】【宮】"}
{"id": null, "n": "0883006", "target": "#nkr_note_orig_0883006", "type": "orig", "text": "〔外塵〕－【三】【宮】"}
{"id": null, "n": "0883007", "target": "#nkr_note_orig_0883007", "type": "orig", "text": "問＋（曰）【三】【宮】＊"}
{"id": null, "n": "0883008", "target": "#nkr_note_orig_0883008", "type": "orig", "text": "〔若〕－【三】"}
{"id": null, "n": "0883009", "target": "#nkr_note_orig_0883009", "type": "orig", "text": "〔在〕－【宮】"}
{"id": null, "n": "0883010", "target": "#nkr_note_orig_0883010", "type": "orig", "text": "〔生〕－【三】【宮】"}
{"id": null, "n": "0883011", "target": "#nkr_note_orig_0883011", "type": "orig", "text": "答＋（曰）【三】【宮】"}
{"id": null, "n": "0883012", "target": "#nkr_note_orig_0883012", "type": "orig", "text": "〔果〕－【三】"}
{"id": null, "n": "0883013", "target": "#nkr_note_orig_0883013", "type": "orig", "text": "論＋（一卷）【宋】【宮】，（全）夾註【明】"}
