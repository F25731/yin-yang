{"id": null, "n": null, "target": null, "type": null, "text": "唐云大自在"}
{"id": null, "n": null, "target": null, "type": null, "text": "無雲而雨者，是諸天悲泣之\n淚也"}
{"id": null, "n": null, "target": null, "type": null, "text": "日天除寒，月天除熱"}
{"id": null, "n": null, "target": null, "type": null, "text": "若粥"}
{"id": null, "n": "0384001", "target": "#nkr_note_mod_0384001", "type": "mod", "text": "悉【大】，悉不【校異-原】"}
{"id": null, "n": "0384002", "target": "#nkr_note_mod_0384002", "type": "mod", "text": "志【大】，應【考偽-原】"}
{"id": null, "n": "0383001", "target": "#nkr_note_orig_0383001", "type": "orig", "text": "【原】享保年間刊豐山大學藏本"}
