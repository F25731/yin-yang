{"id": null, "n": "0835004", "target": "#nkr_note_mod_0835004", "type": "mod", "text": "西域三藏【大】，三藏法師【宋】【元】【明】"}
{"id": null, "n": "0835005", "target": "#nkr_note_mod_0835005", "type": "mod", "text": "牧【大】＊，枝【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0835006", "target": "#nkr_note_mod_0835006", "type": "mod", "text": "道【大】，道道法捨家【宋】【元】【明】"}
{"id": null, "n": "0835007", "target": "#nkr_note_mod_0835007", "type": "mod", "text": "心【大】，【宋】【元】【明】"}
{"id": null, "n": "0835008", "target": "#nkr_note_mod_0835008", "type": "mod", "text": "力士【大】，壯人【宋】【元】【明】"}
{"id": null, "n": "0835009", "target": "#nkr_note_mod_0835009", "type": "mod", "text": "申【大】，伸【宋】【元】【明】"}
{"id": null, "n": "0835010", "target": "#nkr_note_mod_0835010", "type": "mod", "text": "以止【大】，已正【宋】【元】【明】"}
{"id": null, "n": "0835011", "target": "#nkr_note_mod_0835011", "type": "mod", "text": "又棄【大】，以捨【明】"}
{"id": null, "n": "0836001", "target": "#nkr_note_mod_0836001", "type": "mod", "text": "椷【大】，函【元】【明】"}
{"id": null, "n": "0836002", "target": "#nkr_note_mod_0836002", "type": "mod", "text": "燕【大】，宴【宋】【元】【明】"}
{"id": null, "n": "0836003", "target": "#nkr_note_mod_0836003", "type": "mod", "text": "酥【大】，蘇【宋】"}
{"id": null, "n": "0836004", "target": "#nkr_note_mod_0836004", "type": "mod", "text": "醍醐【大】，䬫餬【宋】"}
{"id": null, "n": "0836005", "target": "#nkr_note_mod_0836005", "type": "mod", "text": "趣【大】，取【宋】【元】【明】"}
{"id": null, "n": "0836006", "target": "#nkr_note_mod_0836006", "type": "mod", "text": "畜【大】＊，蓄【元】【明】＊"}
{"id": null, "n": "0836007", "target": "#nkr_note_mod_0836007", "type": "mod", "text": "法衣【大】，衣服【宋】【元】【明】"}
{"id": null, "n": "0836008", "target": "#nkr_note_mod_0836008", "type": "mod", "text": "病【大】，疾【宋】【元】【明】"}
{"id": null, "n": "0836009", "target": "#nkr_note_mod_0836009", "type": "mod", "text": "抴【大】，拽【宋】【元】【明】"}
{"id": null, "n": "0836010", "target": "#nkr_note_mod_0836010", "type": "mod", "text": "遁【大】，眾【宋】【元】【明】"}
{"id": null, "n": "0836011", "target": "#nkr_note_mod_0836011", "type": "mod", "text": "惓【大】，倦【宋】【元】【明】"}
{"id": null, "n": "0836012", "target": "#nkr_note_mod_0836012", "type": "mod", "text": "習【大】＊，集【元】【明】＊"}
{"id": null, "n": "0836013", "target": "#nkr_note_mod_0836013", "type": "mod", "text": "拄【大】，柱【宋】【元】"}
{"id": null, "n": "0836014", "target": "#nkr_note_mod_0836014", "type": "mod", "text": "癰疽【大】，疽癰【宋】【元】【明】"}
{"id": null, "n": "0836015", "target": "#nkr_note_mod_0836015", "type": "mod", "text": "皆【大】，比【宋】【元】【明】"}
{"id": null, "n": "0836016", "target": "#nkr_note_mod_0836016", "type": "mod", "text": "謂【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0836017", "target": "#nkr_note_mod_0836017", "type": "mod", "text": "志【大】，至【元】【明】，〔－〕【宋】"}
{"id": null, "n": "0836018", "target": "#nkr_note_mod_0836018", "type": "mod", "text": "愛【大】＊，受【宋】【元】【明】＊"}
{"id": null, "n": "0836019", "target": "#nkr_note_mod_0836019", "type": "mod", "text": "信【大】，作【宋】【元】【明】"}
{"id": null, "n": "0836020", "target": "#nkr_note_mod_0836020", "type": "mod", "text": "無【大】，無入【宋】【元】【明】"}
{"id": null, "n": "0836021", "target": "#nkr_note_mod_0836021", "type": "mod", "text": "已【大】＊，以【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0836022", "target": "#nkr_note_mod_0836022", "type": "mod", "text": "是【大】，數是【宋】【元】【明】"}
{"id": null, "n": "0836023", "target": "#nkr_note_mod_0836023", "type": "mod", "text": "不【大】，不漫【宋】【元】【明】"}
{"id": null, "n": "0836024", "target": "#nkr_note_mod_0836024", "type": "mod", "text": "過【大】，惡【宋】【元】【明】"}
{"id": null, "n": "0836025", "target": "#nkr_note_mod_0836025", "type": "mod", "text": "二【大】，二身【宋】【元】【明】"}
{"id": null, "n": "0836026", "target": "#nkr_note_mod_0836026", "type": "mod", "text": "紿【大】，怠【宋】【元】【明】"}
{"id": null, "n": "0836027", "target": "#nkr_note_mod_0836027", "type": "mod", "text": "以【大】，已【宋】【元】【明】"}
{"id": null, "n": "0836028", "target": "#nkr_note_mod_0836028", "type": "mod", "text": "嫉妬【大】，妬嫉【宋】【元】【明】"}
{"id": null, "n": "0836029", "target": "#nkr_note_mod_0836029", "type": "mod", "text": "志【CB】【明】，念【大】"}
{"id": null, "n": "0836030", "target": "#nkr_note_mod_0836030", "type": "mod", "text": "源【大】，原【宋】【元】【明】"}
{"id": null, "n": "0836031", "target": "#nkr_note_mod_0836031", "type": "mod", "text": "道【大】，隨【宋】【元】"}
{"id": null, "n": "0836032", "target": "#nkr_note_mod_0836032", "type": "mod", "text": "言【大】，曰【宋】【元】【明】"}
{"id": null, "n": "0836033", "target": "#nkr_note_mod_0836033", "type": "mod", "text": "放【大】，故【宋】【元】【明】"}
{"id": null, "n": "0836034", "target": "#nkr_note_mod_0836034", "type": "mod", "text": "以【大】，後【宋】【元】【明】"}
{"id": null, "n": "0836035", "target": "#nkr_note_mod_0836035", "type": "mod", "text": "別【大】，想【宋】【元】【明】"}
{"id": null, "n": "0836036", "target": "#nkr_note_mod_0836036", "type": "mod", "text": "命【大】，令【宋】【元】【明】"}
{"id": null, "n": "0837001", "target": "#nkr_note_mod_0837001", "type": "mod", "text": "聚【大】，𨽁【宋】【元】【明】"}
