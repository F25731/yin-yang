{"id": null, "n": "0490002", "target": "#nkr_note_mod_0490002", "type": "mod", "text": "能【大】＊，佛說能【明】【甲】＊，【原】麗本，【甲】黃檗版淨嚴等加筆本"}
{"id": null, "n": "0490003", "target": "#nkr_note_mod_0490003", "type": "mod", "text": "（開府…門）四十一字【大】，大興善寺三藏沙門大廣智【宋】【元】【甲】，唐三藏沙門大廣智【明】"}
{"id": null, "n": "0490004", "target": "#nkr_note_mod_0490004", "type": "mod", "text": "如【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0490005", "target": "#nkr_note_mod_0490005", "type": "mod", "text": "清【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0490006", "target": "#nkr_note_mod_0490006", "type": "mod", "text": "他【大】，他引一【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引一"}
{"id": null, "n": "0490007", "target": "#nkr_note_mod_0490007", "type": "mod", "text": "里【大】，哩二【宋】【元】【明】【甲】"}
{"id": null, "n": "0490008", "target": "#nkr_note_mod_0490008", "type": "mod", "text": "里【大】，里三【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": "0490009", "target": "#nkr_note_mod_0490009", "type": "mod", "text": "枳【大】，枳四【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "四"}
{"id": null, "n": "0490010", "target": "#nkr_note_mod_0490010", "type": "mod", "text": "里【大】，里五【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "五"}
{"id": null, "n": "0490011", "target": "#nkr_note_mod_0490011", "type": "mod", "text": "帝【大】，帝六【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "六"}
{"id": null, "n": "0490012", "target": "#nkr_note_mod_0490012", "type": "mod", "text": "庾【大】，庾七【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "七"}
{"id": null, "n": "0490013", "target": "#nkr_note_mod_0490013", "type": "mod", "text": "寧【大】，寧八【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "八"}
{"id": null, "n": "0490014", "target": "#nkr_note_mod_0490014", "type": "mod", "text": "魯【大】，魯九【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "九"}
{"id": null, "n": "0490015", "target": "#nkr_note_mod_0490015", "type": "mod", "text": "魯【大】，魯十【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "十"}
{"id": null, "n": "0490016", "target": "#nkr_note_mod_0490016", "type": "mod", "text": "訶【大】，訶引十一【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引十一"}
{"id": null, "n": "0490017", "target": "#nkr_note_mod_0490017", "type": "mod", "text": "集【大】，焦【宋】【元】【明】"}
{"id": null, "n": "0490018", "target": "#nkr_note_mod_0490018", "type": "mod", "text": "羅漢【大】，尸羅【宋】【元】【明】【甲】"}
{"id": null, "n": "0490019", "target": "#nkr_note_mod_0490019", "type": "mod", "text": "禁【大】，以禁【甲】"}
{"id": null, "n": "0490020", "target": "#nkr_note_mod_0490020", "type": "mod", "text": "梵【大】，梵天【甲】"}
{"id": null, "n": "0490021", "target": "#nkr_note_mod_0490021", "type": "mod", "text": "支【大】，支作必舍支【宋】【元】【明】【甲】"}
{"id": null, "n": "0490022", "target": "#nkr_note_mod_0490022", "type": "mod", "text": "授【大】，受【宋】【元】"}
{"id": null, "n": "0490023", "target": "#nkr_note_mod_0490023", "type": "mod", "text": "其【大】，其時【考偽-甲】"}
{"id": null, "n": "0490024", "target": "#nkr_note_mod_0490024", "type": "mod", "text": "陀【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0490025", "target": "#nkr_note_mod_0490025", "type": "mod", "text": "目【CB】【明】【甲】，耳【大】"}
{"id": null, "n": "0490002", "target": "#nkr_note_orig_0490002", "type": "orig", "text": "【原】麗本，【甲】黃檗版淨嚴等加筆本，（佛說）＋能【明】【甲】＊"}
{"id": null, "n": "0490003", "target": "#nkr_note_orig_0490003", "type": "orig", "text": "（（開府…門））四十一字＝（（大興善寺三藏沙門大廣智））十一字【宋】【元】【甲】，（（唐三藏沙門大廣智））八字【明】"}
