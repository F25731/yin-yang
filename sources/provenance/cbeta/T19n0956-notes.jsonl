{"id": null, "n": "0316008", "target": "#nkr_note_mod_0316008", "type": "mod", "text": "轉【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0316009", "target": "#nkr_note_mod_0316009", "type": "mod", "text": "當誦【大】，〔－〕【宋】【元】【明】"}
