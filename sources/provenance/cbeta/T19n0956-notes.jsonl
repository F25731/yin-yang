{"id": null, "n": "0315043", "target": "#nkr_note_mod_0315043", "type": "mod", "text": "大唐天竺【大】，唐北印土迦濕密羅國【宋】【元】【明】"}
{"id": null, "n": "0315044", "target": "#nkr_note_mod_0315044", "type": "mod", "text": "奉詔【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0316001", "target": "#nkr_note_mod_0316001", "type": "mod", "text": "曰告【大】，告曰【元】【明】"}
