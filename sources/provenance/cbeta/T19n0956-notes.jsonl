{"id": null, "n": "0316011", "target": "#nkr_note_mod_0316011", "type": "mod", "text": "蓼【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0317001", "target": "#nkr_note_mod_0317001", "type": "mod", "text": "燒藥【大】，〔－〕【宋】【元】【明】"}
