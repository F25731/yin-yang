{"id": null, "n": "0038009", "target": "#nkr_note_orig_0038009", "type": "orig", "text": "本上恐脫一字"}
{"id": null, "n": "0038010", "target": "#nkr_note_orig_0038010", "type": "orig", "text": "道恐剩"}
{"id": null, "n": "0038011", "target": "#nkr_note_orig_0038011", "type": "orig", "text": "建武恐誤周錄云義熙十三年譯"}
{"id": null, "n": "0038012", "target": "#nkr_note_orig_0038012", "type": "orig", "text": "陀下恐脫羅字"}
{"id": null, "n": "0038013", "target": "#nkr_note_orig_0038013", "type": "orig", "text": "監恐合作熙內典錄云六年周錄云十三年"}
{"id": null, "n": "0038014", "target": "#nkr_note_orig_0038014", "type": "orig", "text": "剎羅恐合作羅察"}
{"id": null, "n": "0038015", "target": "#nkr_note_orig_0038015", "type": "orig", "text": "阻合作沮下同"}
{"id": null, "n": "0039001", "target": "#nkr_note_orig_0039001", "type": "orig", "text": "逐恐應作遂"}
{"id": null, "n": "0039002", "target": "#nkr_note_orig_0039002", "type": "orig", "text": "拽準內典錄等合作牽"}
{"id": null, "n": "0039003", "target": "#nkr_note_orig_0039003", "type": "orig", "text": "何急枕眠讖藏六字恐衍"}
{"id": null, "n": "0039004", "target": "#nkr_note_orig_0039004", "type": "orig", "text": "縣恐或應作以"}
{"id": null, "n": "0039005", "target": "#nkr_note_orig_0039005", "type": "orig", "text": "城恐應作域"}
{"id": null, "n": "0039006", "target": "#nkr_note_orig_0039006", "type": "orig", "text": "建元內典錄周錄俱作孝建文帝合作孝武帝"}
{"id": null, "n": "0039007", "target": "#nkr_note_orig_0039007", "type": "orig", "text": "新內典錄釋教錄作辛周錄作新隋錄云般泥洹經"}
{"id": null, "n": "0039008", "target": "#nkr_note_orig_0039008", "type": "orig", "text": "保隋錄並作統周錄作保"}
{"id": null, "n": "0039009", "target": "#nkr_note_orig_0039009", "type": "orig", "text": "那合作耶"}
{"id": null, "n": "0039010", "target": "#nkr_note_orig_0039010", "type": "orig", "text": "周錄作崛多笈多釋教錄作闍那崛多隋錄作闍那笈多"}
{"id": null, "n": "0039011", "target": "#nkr_note_orig_0039011", "type": "orig", "text": "天邪跋陀釋教錄作那跋陀羅周錄無羅字隣二錄俱作陵"}
{"id": null, "n": "0039012", "target": "#nkr_note_orig_0039012", "type": "orig", "text": "△次明大緣感"}
{"id": null, "n": "0039013", "target": "#nkr_note_orig_0039013", "type": "orig", "text": "奚要作㨙"}
{"id": null, "n": "0039014", "target": "#nkr_note_orig_0039014", "type": "orig", "text": "後要作右"}
{"id": null, "n": "0040001", "target": "#nkr_note_orig_0040001", "type": "orig", "text": "刪一作削下亦同"}
{"id": null, "n": "0040002", "target": "#nkr_note_orig_0040002", "type": "orig", "text": "一無以字"}
{"id": null, "n": "0040003", "target": "#nkr_note_orig_0040003", "type": "orig", "text": "和要俱無碎字"}
{"id": null, "n": "0040004", "target": "#nkr_note_orig_0040004", "type": "orig", "text": "啑一作唼"}
{"id": null, "n": "0040005", "target": "#nkr_note_orig_0040005", "type": "orig", "text": "定恐衍"}
{"id": null, "n": "0040006", "target": "#nkr_note_orig_0040006", "type": "orig", "text": "被恐應作披"}
{"id": null, "n": "0040007", "target": "#nkr_note_orig_0040007", "type": "orig", "text": "△六指廣"}
{"id": null, "n": "0040008", "target": "#nkr_note_orig_0040008", "type": "orig", "text": "二要作三"}
{"id": null, "n": "0040009", "target": "#nkr_note_orig_0040009", "type": "orig", "text": "颿諸本作飄"}
{"id": null, "n": "0040010", "target": "#nkr_note_orig_0040010", "type": "orig", "text": "還一作旋"}
{"id": null, "n": "0040011", "target": "#nkr_note_orig_0040011", "type": "orig", "text": "勉經作免"}
{"id": null, "n": "0040012", "target": "#nkr_note_orig_0040012", "type": "orig", "text": "積下經有苦毒特兼四字"}
{"id": null, "n": "0040013", "target": "#nkr_note_orig_0040013", "type": "orig", "text": "早經作卑"}
{"id": null, "n": "0040014", "target": "#nkr_note_orig_0040014", "type": "orig", "text": "󴛏經作喚"}
{"id": null, "n": "0040015", "target": "#nkr_note_orig_0040015", "type": "orig", "text": "五上有時字"}
{"id": null, "n": "0040016", "target": "#nkr_note_orig_0040016", "type": "orig", "text": "各今經作人各令"}
{"id": null, "n": "0040017", "target": "#nkr_note_orig_0040017", "type": "orig", "text": "是經作足"}
{"id": null, "n": "0040018", "target": "#nkr_note_orig_0040018", "type": "orig", "text": "左上有合錢巳竟四字"}
{"id": null, "n": "0040019", "target": "#nkr_note_orig_0040019", "type": "orig", "text": "國作者"}
{"id": null, "n": "0040020", "target": "#nkr_note_orig_0040020", "type": "orig", "text": "語經作諸"}
{"id": null, "n": "0040021", "target": "#nkr_note_orig_0040021", "type": "orig", "text": "投經作捉"}
{"id": null, "n": "0040022", "target": "#nkr_note_orig_0040022", "type": "orig", "text": "踰經作蹋"}
{"id": null, "n": "0040023", "target": "#nkr_note_orig_0040023", "type": "orig", "text": "稼下有傷壞甚多四字"}
{"id": null, "n": "0040024", "target": "#nkr_note_orig_0040024", "type": "orig", "text": "與見作乞兒"}
{"id": null, "n": "0040025", "target": "#nkr_note_orig_0040025", "type": "orig", "text": "者下有愍之二字"}
{"id": null, "n": "0040026", "target": "#nkr_note_orig_0040026", "type": "orig", "text": "得經作向"}
{"id": null, "n": "0041001", "target": "#nkr_note_orig_0041001", "type": "orig", "text": "觀經作覩"}
{"id": null, "n": "0041002", "target": "#nkr_note_orig_0041002", "type": "orig", "text": "反經作返"}
{"id": null, "n": "0041003", "target": "#nkr_note_orig_0041003", "type": "orig", "text": "能經作純"}
{"id": null, "n": "0041004", "target": "#nkr_note_orig_0041004", "type": "orig", "text": "是經作即"}
{"id": null, "n": "0041005", "target": "#nkr_note_orig_0041005", "type": "orig", "text": "關經作開"}
{"id": null, "n": "0041006", "target": "#nkr_note_orig_0041006", "type": "orig", "text": "𤇅作昱"}
{"id": null, "n": "0041007", "target": "#nkr_note_orig_0041007", "type": "orig", "text": "得經作澤"}
{"id": null, "n": "0041008", "target": "#nkr_note_orig_0041008", "type": "orig", "text": "禮下經有畢訖二字"}
{"id": null, "n": "0041009", "target": "#nkr_note_orig_0041009", "type": "orig", "text": "疆一作僵"}
{"id": null, "n": "0041010", "target": "#nkr_note_orig_0041010", "type": "orig", "text": "墜一作湖"}
{"id": null, "n": "0041011", "target": "#nkr_note_orig_0041011", "type": "orig", "text": "詎一作誰"}
{"id": null, "n": "0041012", "target": "#nkr_note_orig_0041012", "type": "orig", "text": "伏要作服"}
{"id": null, "n": "0041013", "target": "#nkr_note_orig_0041013", "type": "orig", "text": "乙和作一"}
{"id": null, "n": "0041014", "target": "#nkr_note_orig_0041014", "type": "orig", "text": "不一作豈"}
{"id": null, "n": "0041015", "target": "#nkr_note_orig_0041015", "type": "orig", "text": "迨一作殆"}
{"id": null, "n": "0041016", "target": "#nkr_note_orig_0041016", "type": "orig", "text": "蒼下恐脫晏字"}
{"id": null, "n": "0010b2301", "target": "#nkr_note_add_0010b2301", "type": "add", "text": "已【CB】，巳【卍續】"}
