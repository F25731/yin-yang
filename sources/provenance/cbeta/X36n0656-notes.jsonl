{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "府巾反，文質也"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云\n云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "普悶反，吐氣也"}
{"id": null, "n": null, "target": null, "type": null, "text": "結昔非，顯今是"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "其菓反，及也，亦居未反，縣名，在會稽"}
{"id": null, "n": null, "target": null, "type": null, "text": "判其所屬"}
{"id": null, "n": null, "target": null, "type": null, "text": "測角反，不齊也"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "悲巾切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "創，初良切，與瘡同。疣，疑求切，贅也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "俞芮切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "朱芮切，疣贅瘤\n也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "羽委切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "險，疑檢切。喁，魚容切。險喁，魚口上見也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "歕，鋪魂切，吐也。\n沫，音末，涎沫也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "研計切，寐中有言也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "力灼切，奪取也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "居候切，取牛羊乳也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "伊鳥\n\n切，深遠也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "墨角切，遠也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "鉏山切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "五恠切，聾也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "柟，如占切，梅也。柹，鉏\n里切，果木名。"}
{"id": null, "n": null, "target": null, "type": null, "text": "居宜切，繫也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "邊迷切，掠器也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "於穴切，剔也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "未各切，翳膜也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "詰叶切，快也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "補火切，足偏癈也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "此中遺一章"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "此處恐有脫文，今敢補曰：二、有因下，示眾生因緣，用是漸頓。"}
{"id": null, "n": null, "target": null, "type": null, "text": "今更補曰：三、此中下，正釋，又二：初、標列，二、漸。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "此處必有脫文，今敢補曰：第二、常無常下，明二鳥雙遊用。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "古詣反"}
{"id": null, "n": null, "target": null, "type": null, "text": "長柄笠也"}
{"id": null, "n": null, "target": null, "type": null, "text": "獸名，居筠反，說文也"}
{"id": null, "n": null, "target": null, "type": null, "text": "大白，為立反也"}
{"id": null, "n": null, "target": null, "type": null, "text": "渠之切，與碁同。"}
{"id": null, "n": null, "target": null, "type": null, "text": "梵語具云一闡提，此云信不具。闡，齒善切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "暴，步木切，曬也。\n背，補昧切，脊也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "北角切，斑駁不純也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "梵語具云漚和俱舍羅，此云方便。嘔，烏候切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "房越切，桴也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "郎刀切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "鷸，以律切，鳥名。蚌，部項切，蛤也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "乙革切，持也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "何庚切，屋橫木曰桁。"}
{"id": null, "n": null, "target": null, "type": null, "text": "色角切，矛屬。"}
{"id": null, "n": null, "target": null, "type": null, "text": "彌正切，辨別物名也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "先結切，櫼也。櫼，音尖。"}
{"id": null, "n": null, "target": null, "type": null, "text": "羊即切，麥󱆄也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "陟交切，言相調也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "吁為切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "容朱切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "𤖆西切，持也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "沮，子余切。沮渠，本匈奴官名，以官為氏也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "仲良切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "作答切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "璀，取\n猥切。璨〔，蒼〕切。璀璨，玉光也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "極嘩切，篋也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "符咸切，與帆同。"}
{"id": null, "n": null, "target": null, "type": null, "text": "倚兩切，情不滿足也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "余章切，風所飛颺也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "倉甸切，草盛貌。"}
{"id": null, "n": null, "target": null, "type": null, "text": "鏤，郎豆切，㓮刻也。糅，女又切，雜糅也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "俱偏\n切，麞也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "螳，徒郎切，螳蜋也。𧑃，牛刀切，謂螳蜋足也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "燿，戈入切。螢燿，謂螢火之\n光也。"}
{"id": null, "n": "0016013A", "target": "#nkr_note_mod_0016013A", "type": "mod", "text": "一無不字"}
{"id": null, "n": "0016013B", "target": "#nkr_note_mod_0016013B", "type": "mod", "text": "一無復字"}
{"id": null, "n": "0031006A", "target": "#nkr_note_mod_0031006A", "type": "mod", "text": "一無出字"}
{"id": null, "n": "0031006B", "target": "#nkr_note_mod_0031006B", "type": "mod", "text": "一無解字"}
{"id": null, "n": "0040018", "target": "#nkr_note_mod_0040018", "type": "mod", "text": "左上有合錢已竟四字"}
{"id": null, "n": "0011001", "target": "#nkr_note_orig_0011001", "type": "orig", "text": "和無隋字一云丹丘沙門釋灌頂撰"}
{"id": null, "n": "0011002", "target": "#nkr_note_orig_0011002", "type": "orig", "text": "此處恐多脫字"}
{"id": null, "n": "0011003", "target": "#nkr_note_orig_0011003", "type": "orig", "text": "以字恐當作次"}
{"id": null, "n": "0011004", "target": "#nkr_note_orig_0011004", "type": "orig", "text": "一無極果二字"}
{"id": null, "n": "0011005", "target": "#nkr_note_orig_0011005", "type": "orig", "text": "一無摩訶二字"}
{"id": null, "n": "0012001", "target": "#nkr_note_orig_0012001", "type": "orig", "text": "爾恐應作示"}
{"id": null, "n": "0012002", "target": "#nkr_note_orig_0012002", "type": "orig", "text": "爽者前後恐有脫文"}
{"id": null, "n": "0012003", "target": "#nkr_note_orig_0012003", "type": "orig", "text": "性下一有者字"}
{"id": null, "n": "0012004", "target": "#nkr_note_orig_0012004", "type": "orig", "text": "△次通"}
{"id": null, "n": "0012005", "target": "#nkr_note_orig_0012005", "type": "orig", "text": "△次結"}
{"id": null, "n": "0012006", "target": "#nkr_note_orig_0012006", "type": "orig", "text": "又下一有滅字"}
{"id": null, "n": "0012007", "target": "#nkr_note_orig_0012007", "type": "orig", "text": "度下一更有度字"}
{"id": null, "n": "0013001", "target": "#nkr_note_orig_0013001", "type": "orig", "text": "岸恐應作斥下例之"}
{"id": null, "n": "0013002", "target": "#nkr_note_orig_0013002", "type": "orig", "text": "洹隸一作涅一字洹要作涅"}
{"id": null, "n": "0014001", "target": "#nkr_note_orig_0014001", "type": "orig", "text": "溥一作普"}
{"id": null, "n": "0014002", "target": "#nkr_note_orig_0014002", "type": "orig", "text": "一無云字"}
{"id": null, "n": "0014003", "target": "#nkr_note_orig_0014003", "type": "orig", "text": "一無於字"}
{"id": null, "n": "0014004", "target": "#nkr_note_orig_0014004", "type": "orig", "text": "柔要作桑"}
{"id": null, "n": "0014005", "target": "#nkr_note_orig_0014005", "type": "orig", "text": "昌和作冒"}
{"id": null, "n": "0014006", "target": "#nkr_note_orig_0014006", "type": "orig", "text": "一無云字"}
{"id": null, "n": "0014007", "target": "#nkr_note_orig_0014007", "type": "orig", "text": "一無云字"}
{"id": null, "n": "0014008", "target": "#nkr_note_orig_0014008", "type": "orig", "text": "非一作不"}
{"id": null, "n": "0014009", "target": "#nkr_note_orig_0014009", "type": "orig", "text": "即一作既"}
{"id": null, "n": "0014010", "target": "#nkr_note_orig_0014010 #note_star_1", "type": "orig", "text": "二同字一俱作用"}
{"id": null, "n": "0014011", "target": "#nkr_note_orig_0014011", "type": "orig", "text": "是下恐有脫文"}
{"id": null, "n": "0014012", "target": "#nkr_note_orig_0014012", "type": "orig", "text": "一次觀師難"}
{"id": null, "n": "0014013", "target": "#nkr_note_orig_0014013", "type": "orig", "text": "一無法字"}
{"id": null, "n": "0014014", "target": "#nkr_note_orig_0014014", "type": "orig", "text": "如一作以"}
{"id": null, "n": "0014015", "target": "#nkr_note_orig_0014015", "type": "orig", "text": "度下一有者字"}
{"id": null, "n": "0015001", "target": "#nkr_note_orig_0015001", "type": "orig", "text": "亦一作竝"}
{"id": null, "n": "0015002", "target": "#nkr_note_orig_0015002", "type": "orig", "text": "疆和作強"}
{"id": null, "n": "0015003", "target": "#nkr_note_orig_0015003", "type": "orig", "text": "鑽和作攢"}
{"id": null, "n": "0015004", "target": "#nkr_note_orig_0015004", "type": "orig", "text": "和要俱無推字"}
{"id": null, "n": "0015005", "target": "#nkr_note_orig_0015005", "type": "orig", "text": "△次結非釋失"}
{"id": null, "n": "0015006", "target": "#nkr_note_orig_0015006", "type": "orig", "text": "要無滅度二字"}
{"id": null, "n": "0015007", "target": "#nkr_note_orig_0015007", "type": "orig", "text": "依合作作"}
{"id": null, "n": "0015008", "target": "#nkr_note_orig_0015008", "type": "orig", "text": "之下恐脫大字"}
{"id": null, "n": "0016001", "target": "#nkr_note_orig_0016001", "type": "orig", "text": "胎藏恐合作照發"}
{"id": null, "n": "0016002", "target": "#nkr_note_orig_0016002", "type": "orig", "text": "輪恐當作綸"}
{"id": null, "n": "0016003", "target": "#nkr_note_orig_0016003", "type": "orig", "text": "△四結成祕藏"}
{"id": null, "n": "0016004", "target": "#nkr_note_orig_0016004", "type": "orig", "text": "明一作照"}
{"id": null, "n": "0016005", "target": "#nkr_note_orig_0016005", "type": "orig", "text": "疑剩滿字"}
{"id": null, "n": "0016006", "target": "#nkr_note_orig_0016006", "type": "orig", "text": "△三結成"}
{"id": null, "n": "0016007", "target": "#nkr_note_orig_0016007", "type": "orig", "text": "是一作此"}
{"id": null, "n": "0016008", "target": "#nkr_note_orig_0016008", "type": "orig", "text": "一無淨字"}
{"id": null, "n": "0016009", "target": "#nkr_note_orig_0016009", "type": "orig", "text": "△四結法同譬"}
{"id": null, "n": "0016010", "target": "#nkr_note_orig_0016010", "type": "orig", "text": "度下一有者字"}
{"id": null, "n": "0016011", "target": "#nkr_note_orig_0016011", "type": "orig", "text": "△三結歸"}
{"id": null, "n": "0016012", "target": "#nkr_note_orig_0016012", "type": "orig", "text": "三下一有解字"}
{"id": null, "n": "0016013A", "target": "#nkr_note_orig_0016013A", "type": "orig", "text": "一無不字及復字"}
{"id": null, "n": "0016013B", "target": "#nkr_note_orig_0016013B", "type": "orig", "text": "一無不字及復字"}
{"id": null, "n": "0016014", "target": "#nkr_note_orig_0016014", "type": "orig", "text": "耳一作爾"}
{"id": null, "n": "0017001", "target": "#nkr_note_orig_0017001", "type": "orig", "text": "別恐合作引次同"}
{"id": null, "n": "0017002", "target": "#nkr_note_orig_0017002", "type": "orig", "text": "一無卒字"}
{"id": null, "n": "0017003", "target": "#nkr_note_orig_0017003", "type": "orig", "text": "檀一作栴"}
{"id": null, "n": "0017004", "target": "#nkr_note_orig_0017004", "type": "orig", "text": "△三判"}
{"id": null, "n": "0017005", "target": "#nkr_note_orig_0017005", "type": "orig", "text": "彼恐應作皮"}
{"id": null, "n": "0017006", "target": "#nkr_note_orig_0017006", "type": "orig", "text": "△五斥通義不可依"}
{"id": null, "n": "0017007", "target": "#nkr_note_orig_0017007", "type": "orig", "text": "一無得字"}
{"id": null, "n": "0018001", "target": "#nkr_note_orig_0018001", "type": "orig", "text": "爾恐當作分"}
{"id": null, "n": "0018002", "target": "#nkr_note_orig_0018002", "type": "orig", "text": "自下恐應有三初番三字"}
{"id": null, "n": "0018003", "target": "#nkr_note_orig_0018003", "type": "orig", "text": "又恐當作文"}
{"id": null, "n": "0018004", "target": "#nkr_note_orig_0018004", "type": "orig", "text": "𤚲一作搆"}
{"id": null, "n": "0018005", "target": "#nkr_note_orig_0018005", "type": "orig", "text": "一無鈔字"}
{"id": null, "n": "0018006", "target": "#nkr_note_orig_0018006", "type": "orig", "text": "酸一作酢字"}
{"id": null, "n": "0018007", "target": "#nkr_note_orig_0018007", "type": "orig", "text": "小恐應作勝"}
{"id": null, "n": "0019001", "target": "#nkr_note_orig_0019001", "type": "orig", "text": "△三結三番分齊"}
{"id": null, "n": "0019002", "target": "#nkr_note_orig_0019002", "type": "orig", "text": "昔一作示"}
{"id": null, "n": "0019003", "target": "#nkr_note_orig_0019003", "type": "orig", "text": "󴛓論作偃"}
{"id": null, "n": "0019004", "target": "#nkr_note_orig_0019004", "type": "orig", "text": "天下論有而字"}
{"id": null, "n": "0019005", "target": "#nkr_note_orig_0019005", "type": "orig", "text": "恐相續下脫相續二字"}
{"id": null, "n": "0019006", "target": "#nkr_note_orig_0019006", "type": "orig", "text": "荒要一俱作三"}
{"id": null, "n": "0020001", "target": "#nkr_note_orig_0020001", "type": "orig", "text": "窈一作杳"}
{"id": null, "n": "0020002", "target": "#nkr_note_orig_0020002", "type": "orig", "text": "一無譯字"}
{"id": null, "n": "0020003", "target": "#nkr_note_orig_0020003", "type": "orig", "text": "詞一作辭"}
{"id": null, "n": "0020004", "target": "#nkr_note_orig_0020004", "type": "orig", "text": "因恐合作自"}
{"id": null, "n": "0020005", "target": "#nkr_note_orig_0020005", "type": "orig", "text": "次無二字恐剩"}
{"id": null, "n": "0020006", "target": "#nkr_note_orig_0020006", "type": "orig", "text": "豁論作曠"}
{"id": null, "n": "0020007", "target": "#nkr_note_orig_0020007", "type": "orig", "text": "一無標字論有之"}
{"id": null, "n": "0020008", "target": "#nkr_note_orig_0020008", "type": "orig", "text": "論當作淪"}
{"id": null, "n": "0020009", "target": "#nkr_note_orig_0020009", "type": "orig", "text": "忌恐應作忘"}
{"id": null, "n": "0020010", "target": "#nkr_note_orig_0020010", "type": "orig", "text": "爾恐應作示"}
{"id": null, "n": "0020011", "target": "#nkr_note_orig_0020011", "type": "orig", "text": "要無結盡之盡字"}
{"id": null, "n": "0020012", "target": "#nkr_note_orig_0020012", "type": "orig", "text": "詮一作論"}
