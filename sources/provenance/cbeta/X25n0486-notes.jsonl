{"id": null, "n": null, "target": null, "type": null, "text": "般若云智慧，破愚痴故。智慧與愚痴，俱無定體。悟此心，即\n愚痴是智慧；迷此心，即智慧是愚痴。"}
{"id": null, "n": null, "target": null, "type": null, "text": "竟"}
{"id": null, "n": "0208b01", "target": "#nkr_note_orig_0208b01", "type": "orig", "text": "正信序發起序"}
{"id": null, "n": "0208001", "target": "#nkr_note_orig_0208001", "type": "orig", "text": "佛弗音通"}
{"id": null, "n": "0208002", "target": "#nkr_note_orig_0208002", "type": "orig", "text": "伽疑跏"}
{"id": null, "n": "0208b02", "target": "#nkr_note_orig_0208b02", "type": "orig", "text": "正宗分二初直明問答二躡跡除疑即下文二十七段也"}
{"id": null, "n": "0210b01", "target": "#nkr_note_orig_0210b01", "type": "orig", "text": "一斷求佛行施住相疑"}
{"id": null, "n": "0210001", "target": "#nkr_note_orig_0210001", "type": "orig", "text": "机機通用"}
{"id": null, "n": "0210b02", "target": "#nkr_note_orig_0210b02", "type": "orig", "text": "二斷因果俱深無信疑"}
{"id": null, "n": "0210b03", "target": "#nkr_note_orig_0210b03", "type": "orig", "text": "三斷無相云何得說疑"}
{"id": null, "n": "0211b01", "target": "#nkr_note_orig_0211b01", "type": "orig", "text": "四斷聲聞得果是取疑"}
{"id": null, "n": "0212b01", "target": "#nkr_note_orig_0212b01", "type": "orig", "text": "五斷釋迦燃燈取說疑"}
{"id": null, "n": "0212b02", "target": "#nkr_note_orig_0212b02", "type": "orig", "text": "六斷嚴土違于不取疑"}
{"id": null, "n": "0212b03", "target": "#nkr_note_orig_0212b03", "type": "orig", "text": "七斷受得報身有取疑"}
{"id": null, "n": "0212001", "target": "#nkr_note_orig_0212001", "type": "orig", "text": "西疑面"}
{"id": null, "n": "0215b01", "target": "#nkr_note_orig_0215b01", "type": "orig", "text": "八斷持說未脫苦果疑"}
{"id": null, "n": "0216b01", "target": "#nkr_note_orig_0216b01", "type": "orig", "text": "九斷能證無體非因疑"}
{"id": null, "n": "0216b02", "target": "#nkr_note_orig_0216b02", "type": "orig", "text": "十斷如徧有得無得疑"}
{"id": null, "n": "0218b01", "target": "#nkr_note_orig_0218b01", "type": "orig", "text": "十一斷我住降伏有我疑"}
{"id": null, "n": "0218b02", "target": "#nkr_note_orig_0218b02", "type": "orig", "text": "十二斷佛因是有菩薩疑"}
{"id": null, "n": "0218b03", "target": "#nkr_note_orig_0218b03", "type": "orig", "text": "十三斷無因則無佛法疑"}
{"id": null, "n": "0218b04", "target": "#nkr_note_orig_0218b04", "type": "orig", "text": "十四斷無人度生嚴土疑"}
{"id": null, "n": "0219b01", "target": "#nkr_note_orig_0219b01", "type": "orig", "text": "十五斷諸佛不見諸法疑"}
{"id": null, "n": "0219b02", "target": "#nkr_note_orig_0219b02", "type": "orig", "text": "十六斷福德例心倒疑"}
{"id": null, "n": "0220b01", "target": "#nkr_note_orig_0220b01", "type": "orig", "text": "十七斷無為何有相好疑"}
{"id": null, "n": "0220b02", "target": "#nkr_note_orig_0220b02", "type": "orig", "text": "十八斷無身何以說法疑"}
{"id": null, "n": "0220b03", "target": "#nkr_note_orig_0220b03", "type": "orig", "text": "十九斷無法如何修證疑"}
{"id": null, "n": "0221b01", "target": "#nkr_note_orig_0221b01", "type": "orig", "text": "二十斷所說無記非因疑"}
{"id": null, "n": "0221b02", "target": "#nkr_note_orig_0221b02", "type": "orig", "text": "二十一斷平等云何度生疑"}
{"id": null, "n": "0222b01", "target": "#nkr_note_orig_0222b01", "type": "orig", "text": "二十二斷以相比知真佛疑"}
{"id": null, "n": "0222b02", "target": "#nkr_note_orig_0222b02", "type": "orig", "text": "二十三斷佛果非關福相疑"}
{"id": null, "n": "0223001", "target": "#nkr_note_orig_0223001", "type": "orig", "text": "木疑本或不"}
{"id": null, "n": "0223b01", "target": "#nkr_note_orig_0223b01", "type": "orig", "text": "二十四斷化身出現受福疑"}
{"id": null, "n": "0223b02", "target": "#nkr_note_orig_0223b02", "type": "orig", "text": "二十五斷法身化身一異疑"}
{"id": null, "n": "0224001", "target": "#nkr_note_orig_0224001", "type": "orig", "text": "机與機同"}
{"id": null, "n": "0224b01", "target": "#nkr_note_orig_0224b01", "type": "orig", "text": "二十六斷化身說法無福疑"}
{"id": null, "n": "0224b02", "target": "#nkr_note_orig_0224b02", "type": "orig", "text": "二十七＊入寂如何說法疑＊一三流通分（入ノ前ニ斷ノ字，脫カ。マタ，一ハ剩字カ。󴦒）"}
