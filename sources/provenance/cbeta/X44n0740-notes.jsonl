{"id": null, "n": "0300001", "target": "#nkr_note_orig_0300001", "type": "orig", "text": "佛法一作法輪"}
{"id": null, "n": "0300002", "target": "#nkr_note_orig_0300002", "type": "orig", "text": "不一作無"}
