{"id": null, "n": "0300006", "target": "#nkr_note_orig_0300006", "type": "orig", "text": "無理一作理無"}
{"id": null, "n": "0301001", "target": "#nkr_note_orig_0301001", "type": "orig", "text": "爾一作然"}
{"id": null, "n": "0301002", "target": "#nkr_note_orig_0301002", "type": "orig", "text": "此一作是"}
