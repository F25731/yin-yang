{"id": null, "n": "0405001", "target": "#nkr_note_orig_0405001", "type": "orig", "text": "「團圓」，甲本作「圓團」。"}
{"id": null, "n": "0405002", "target": "#nkr_note_orig_0405002", "type": "orig", "text": "「湧」，底、甲本作「勇」，據文意改。"}
{"id": null, "n": "0405003", "target": "#nkr_note_orig_0405003", "type": "orig", "text": "「阿彌陀佛」，甲本作「佛」。"}
{"id": null, "n": "0406001", "target": "#nkr_note_orig_0406001", "type": "orig", "text": "「琉」，甲本作「瑠」，此處兩字同，以下均正為「琉」。"}
{"id": null, "n": "0406002", "target": "#nkr_note_orig_0406002", "type": "orig", "text": "「念佛」，甲本作「念」，乙本作「稱南無阿彌陀佛」。下同。"}
{"id": null, "n": "0406003", "target": "#nkr_note_orig_0406003", "type": "orig", "text": "「比」，甲本作「譬」。"}
{"id": null, "n": "0406004", "target": "#nkr_note_orig_0406004", "type": "orig", "text": "「佛」，底本無，據文意補。"}
{"id": null, "n": "0406005", "target": "#nkr_note_orig_0406005", "type": "orig", "text": "「蔽」，底本、甲本作「弊」，據北8299號及斯4678號改。"}
{"id": null, "n": "0407001", "target": "#nkr_note_orig_0407001", "type": "orig", "text": "「靡」，底本、甲本作「眉」，據北8299號及斯4678號改。"}
{"id": null, "n": "0407002", "target": "#nkr_note_orig_0407002", "type": "orig", "text": "「青」，底本無，據甲本補。"}
{"id": null, "n": "0407003", "target": "#nkr_note_orig_0407003", "type": "orig", "text": "「猶」，甲本作「於」。"}
{"id": null, "n": "0407004", "target": "#nkr_note_orig_0407004", "type": "orig", "text": "「百」，底本作「白」，據甲本改。"}
{"id": null, "n": "0407005", "target": "#nkr_note_orig_0407005", "type": "orig", "text": "「鉢」，乙本無。"}
{"id": null, "n": "0407006", "target": "#nkr_note_orig_0407006", "type": "orig", "text": "「佛如來」，甲本作「佛」。"}
{"id": null, "n": "0407007", "target": "#nkr_note_orig_0407007", "type": "orig", "text": "「齊」，乙本作「眥」。"}
{"id": null, "n": "0407008", "target": "#nkr_note_orig_0407008", "type": "orig", "text": "「生」，甲本作「出」。"}
{"id": null, "n": "0407009", "target": "#nkr_note_orig_0407009", "type": "orig", "text": "「光」，乙本作「毛」。"}
{"id": null, "n": "0407010", "target": "#nkr_note_orig_0407010", "type": "orig", "text": "「花」，乙本作「華」。古時「花」、「華」通用，本文獻諸異本本身亦不統一。為避文繁，錄文時均依底本錄出，不出校記。"}
{"id": null, "n": "0407011", "target": "#nkr_note_orig_0407011", "type": "orig", "text": "「中」，乙本無。"}
{"id": null, "n": "0407012", "target": "#nkr_note_orig_0407012", "type": "orig", "text": "「艷」，乙本作「焰」。"}
{"id": null, "n": "0407013", "target": "#nkr_note_orig_0407013", "type": "orig", "text": "「槌」，乙本作「鎚」。"}
{"id": null, "n": "0408001", "target": "#nkr_note_orig_0408001", "type": "orig", "text": "「於」，乙本作「於其」。"}
{"id": null, "n": "0408002", "target": "#nkr_note_orig_0408002", "type": "orig", "text": "「󳠬」，乙本作「欠」。"}
{"id": null, "n": "0408003", "target": "#nkr_note_orig_0408003", "type": "orig", "text": "「整」，甲本作「正整」。"}
{"id": null, "n": "0408004", "target": "#nkr_note_orig_0408004", "type": "orig", "text": "「紅」，乙本無。"}
{"id": null, "n": "0408005", "target": "#nkr_note_orig_0408005", "type": "orig", "text": "「合」，乙本無。"}
{"id": null, "n": "0408006", "target": "#nkr_note_orig_0408006", "type": "orig", "text": "「從佛鼻」，甲本無。"}
{"id": null, "n": "0408007", "target": "#nkr_note_orig_0408007", "type": "orig", "text": "「出」，乙本無。"}
{"id": null, "n": "0408008", "target": "#nkr_note_orig_0408008", "type": "orig", "text": "「影」，乙本作「映」。"}
{"id": null, "n": "0408009", "target": "#nkr_note_orig_0408009", "type": "orig", "text": "「照」，乙本無。"}
{"id": null, "n": "0408010", "target": "#nkr_note_orig_0408010", "type": "orig", "text": "「令四十齒」，乙本無。"}
{"id": null, "n": "0408011", "target": "#nkr_note_orig_0408011", "type": "orig", "text": "「聽」，乙本作「齦」。"}
{"id": null, "n": "0408012", "target": "#nkr_note_orig_0408012", "type": "orig", "text": "北245至此止。"}
{"id": null, "n": "0408013", "target": "#nkr_note_orig_0408013", "type": "orig", "text": "斯2686號自此起。"}
{"id": null, "n": "0408014", "target": "#nkr_note_orig_0408014", "type": "orig", "text": "「珠」，甲、乙本無。"}
{"id": null, "n": "0408015", "target": "#nkr_note_orig_0408015", "type": "orig", "text": "「者，其」，底本殘，據甲本錄文。"}
{"id": null, "n": "0408016", "target": "#nkr_note_orig_0408016", "type": "orig", "text": "「之」，乙本作「諸」。"}
{"id": null, "n": "0409001", "target": "#nkr_note_orig_0409001", "type": "orig", "text": "「赤」，乙本作「亦」。"}
{"id": null, "n": "0409002", "target": "#nkr_note_orig_0409002", "type": "orig", "text": "「是眾色」，底本殘缺，據甲本錄文。"}
{"id": null, "n": "0409003", "target": "#nkr_note_orig_0409003", "type": "orig", "text": "「曜」，甲本作「耀」。"}
{"id": null, "n": "0409004", "target": "#nkr_note_orig_0409004", "type": "orig", "text": "「有」，乙本無。"}
{"id": null, "n": "0409005", "target": "#nkr_note_orig_0409005", "type": "orig", "text": "「齦」，甲本作「腭」。"}
{"id": null, "n": "0409006", "target": "#nkr_note_orig_0409006", "type": "orig", "text": "「曇」，甲、乙本無。"}
{"id": null, "n": "0409007", "target": "#nkr_note_orig_0409007", "type": "orig", "text": "「根下及舌」，乙本無。"}
{"id": null, "n": "0409008", "target": "#nkr_note_orig_0409008", "type": "orig", "text": "「滴」，乙本作「渧」。"}
{"id": null, "n": "0409009", "target": "#nkr_note_orig_0409009", "type": "orig", "text": "「五」，甲本無。"}
{"id": null, "n": "0409010", "target": "#nkr_note_orig_0409010", "type": "orig", "text": "「此」，乙本無。"}
{"id": null, "n": "0409011", "target": "#nkr_note_orig_0409011", "type": "orig", "text": "「五色光」。甲、乙本作「五光」。"}
{"id": null, "n": "0409012", "target": "#nkr_note_orig_0409012", "type": "orig", "text": "「嗡」，乙本作「󵓕」。"}
{"id": null, "n": "0409013", "target": "#nkr_note_orig_0409013", "type": "orig", "text": "「如」，甲本無。"}
{"id": null, "n": "0409014", "target": "#nkr_note_orig_0409014", "type": "orig", "text": "「花」，乙本無。"}
{"id": null, "n": "0410001", "target": "#nkr_note_orig_0410001", "type": "orig", "text": "「猶」，乙本作「由」。"}
{"id": null, "n": "0410002", "target": "#nkr_note_orig_0410002", "type": "orig", "text": "「畫」，乙本作「畫脈」。"}
{"id": null, "n": "0410003", "target": "#nkr_note_orig_0410003", "type": "orig", "text": "「佛」，甲本無。"}
{"id": null, "n": "0410004", "target": "#nkr_note_orig_0410004", "type": "orig", "text": "「間」，乙本作「開」。"}
{"id": null, "n": "0410005", "target": "#nkr_note_orig_0410005", "type": "orig", "text": "「苦」，底本作「若」，據甲、乙本改。"}
{"id": null, "n": "0410006", "target": "#nkr_note_orig_0410006", "type": "orig", "text": "「臃」，乙本作「傭」。"}
{"id": null, "n": "0410007", "target": "#nkr_note_orig_0410007", "type": "orig", "text": "「相」，乙本無。"}
{"id": null, "n": "0410008", "target": "#nkr_note_orig_0410008", "type": "orig", "text": "「有」，乙本作「出」。"}
{"id": null, "n": "0410009", "target": "#nkr_note_orig_0410009", "type": "orig", "text": "「一一」，底本、甲本作「二」，據乙本改。"}
{"id": null, "n": "0410010", "target": "#nkr_note_orig_0410010", "type": "orig", "text": "「兩」，甲本無。"}
{"id": null, "n": "0410011", "target": "#nkr_note_orig_0410011", "type": "orig", "text": "「如來」，甲本無。"}
{"id": null, "n": "0410012", "target": "#nkr_note_orig_0410012", "type": "orig", "text": "「著」，甲本作「佇」。"}
{"id": null, "n": "0411001", "target": "#nkr_note_orig_0411001", "type": "orig", "text": "「三念佛」，甲本無。"}
{"id": null, "n": "0411002", "target": "#nkr_note_orig_0411002", "type": "orig", "text": "「如來」，甲本無。"}
{"id": null, "n": "0411003", "target": "#nkr_note_orig_0411003", "type": "orig", "text": "「如來」，甲本無。"}
{"id": null, "n": "0411004", "target": "#nkr_note_orig_0411004", "type": "orig", "text": "「背」，底本作「輩」，據甲本改。"}
{"id": null, "n": "0412001", "target": "#nkr_note_orig_0412001", "type": "orig", "text": "「金」，底本作「念」，據北8299號、斯4678號及伯3595號背面改。"}
{"id": null, "n": "0413001", "target": "#nkr_note_orig_0413001", "type": "orig", "text": "「種」，底本無，據北8299號補。"}
{"id": null, "n": "0413002", "target": "#nkr_note_orig_0413002", "type": "orig", "text": "「會大眾」，底本作「大會眾」，據北8299號改。"}
{"id": null, "n": "0413003", "target": "#nkr_note_orig_0413003", "type": "orig", "text": "「種」，底本無，據北8299號補。"}
{"id": null, "n": "0413004", "target": "#nkr_note_orig_0413004", "type": "orig", "text": "「戒齋」，底本作「齋戒」，據北8299號改。"}
{"id": null, "n": "0413005", "target": "#nkr_note_orig_0413005", "type": "orig", "text": "「名」，底本無，據文意補。"}
{"id": null, "n": "0414001", "target": "#nkr_note_orig_0414001", "type": "orig", "text": "「迷」，底本無，據北8299號補。"}
{"id": null, "n": "0411a1201", "target": "#nkr_note_add_0411a1201", "type": "add", "text": "臆【CB】，億【藏外】"}
