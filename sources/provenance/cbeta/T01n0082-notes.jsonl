{"id": null, "n": "0901004", "target": "#nkr_note_mod_0901004", "type": "mod", "text": "月氏…藏【大】，三藏法師【宋】【元】【明】"}
{"id": null, "n": "0901005", "target": "#nkr_note_mod_0901005", "type": "mod", "text": "入【大】＊，人【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0901006", "target": "#nkr_note_mod_0901006", "type": "mod", "text": "比【大】，此比【宋】【元】【明】"}
{"id": null, "n": "0901007", "target": "#nkr_note_mod_0901007", "type": "mod", "text": "記數（一…十一）並（也）十一字【大】，〔－〕【明】"}
{"id": null, "n": "0902001", "target": "#nkr_note_mod_0902001", "type": "mod", "text": "習【大】，集【元】【明】"}
{"id": null, "n": "0902002", "target": "#nkr_note_mod_0902002", "type": "mod", "text": "彼【大】，修【宋】【元】【明】"}
{"id": null, "n": "0901004", "target": "#nkr_note_orig_0901004", "type": "orig", "text": "月氏…藏＝三藏法師【三】"}
{"id": null, "n": "0901005", "target": "#nkr_note_orig_0901005", "type": "orig", "text": "入＝人【三】＊"}
{"id": null, "n": "0901006", "target": "#nkr_note_orig_0901006", "type": "orig", "text": "（此）＋比【三】"}
{"id": null, "n": "0901007", "target": "#nkr_note_orig_0901007", "type": "orig", "text": "記數〔一…十一〕並〔也〕十一字－【明】"}
{"id": null, "n": "0902001", "target": "#nkr_note_orig_0902001", "type": "orig", "text": "習＝集【元】【明】"}
{"id": null, "n": "0902002", "target": "#nkr_note_orig_0902002", "type": "orig", "text": "彼＝修【三】"}
