{"id": null, "n": "0216010", "target": "#nkr_note_orig_0216010", "type": "orig", "text": "狀疑然"}
{"id": null, "n": "0216011", "target": "#nkr_note_orig_0216011", "type": "orig", "text": "筭字更勘"}
