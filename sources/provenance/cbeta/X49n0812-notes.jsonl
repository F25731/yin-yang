{"id": null, "n": "0216001", "target": "#nkr_note_orig_0216001", "type": "orig", "text": "不等更詳"}
{"id": null, "n": "0216002", "target": "#nkr_note_orig_0216002", "type": "orig", "text": "要疑惡"}
{"id": null, "n": "0216003", "target": "#nkr_note_orig_0216003", "type": "orig", "text": "切疑心"}
{"id": null, "n": "0216004", "target": "#nkr_note_orig_0216004", "type": "orig", "text": "亦字疑剩"}
