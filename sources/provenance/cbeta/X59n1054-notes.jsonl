{"id": null, "n": null, "target": null, "type": null, "text": "五十有三"}
{"id": null, "n": "0089001", "target": "#nkr_note_orig_0089001", "type": "orig", "text": "開南門一作南向開門"}
{"id": null, "n": "0090001", "target": "#nkr_note_orig_0090001", "type": "orig", "text": "人字更勘"}
{"id": null, "n": "0090002", "target": "#nkr_note_orig_0090002", "type": "orig", "text": "是者作是直也直廂者正面也"}
{"id": null, "n": "0090003", "target": "#nkr_note_orig_0090003", "type": "orig", "text": "右相相謂狀相次下金剛三昧文意亦然"}
{"id": null, "n": "0090004", "target": "#nkr_note_orig_0090004", "type": "orig", "text": "相或邊歟"}
{"id": null, "n": "0090005", "target": "#nkr_note_orig_0090005", "type": "orig", "text": "熟疑熱"}
{"id": null, "n": "0090006", "target": "#nkr_note_orig_0090006", "type": "orig", "text": "頭疑中"}
{"id": null, "n": "0091001", "target": "#nkr_note_orig_0091001", "type": "orig", "text": "頭疑中"}
{"id": null, "n": "0091002", "target": "#nkr_note_orig_0091002", "type": "orig", "text": "內疑外"}
{"id": null, "n": "0091003", "target": "#nkr_note_orig_0091003", "type": "orig", "text": "魚等四字疑剩"}
{"id": null, "n": "0092001", "target": "#nkr_note_orig_0092001", "type": "orig", "text": "𠴊疑哩"}
{"id": null, "n": "0092002", "target": "#nkr_note_orig_0092002", "type": "orig", "text": "＊金疑字（＊印ノ字ハ本文ト異ナル。󴦒）"}
{"id": null, "n": "0092003", "target": "#nkr_note_orig_0092003", "type": "orig", "text": "常疑當"}
{"id": null, "n": "0092004", "target": "#nkr_note_orig_0092004", "type": "orig", "text": "渟一作停"}
{"id": null, "n": "0093001", "target": "#nkr_note_orig_0093001", "type": "orig", "text": "安疑妄"}
{"id": null, "n": "0093002", "target": "#nkr_note_orig_0093002", "type": "orig", "text": "月疑心"}
{"id": null, "n": "0093003", "target": "#nkr_note_orig_0093003", "type": "orig", "text": "青疑音"}
{"id": null, "n": "0094001", "target": "#nkr_note_orig_0094001", "type": "orig", "text": "復疑後"}
{"id": null, "n": "0094002", "target": "#nkr_note_orig_0094002", "type": "orig", "text": "想疑相"}
{"id": null, "n": "0095001", "target": "#nkr_note_orig_0095001", "type": "orig", "text": "󴈍字疑剩"}
{"id": null, "n": "0096001", "target": "#nkr_note_orig_0096001", "type": "orig", "text": "左經作右"}
{"id": null, "n": "0096002", "target": "#nkr_note_orig_0096002", "type": "orig", "text": "及等四字疑剩"}
{"id": null, "n": "0096003", "target": "#nkr_note_orig_0096003", "type": "orig", "text": "前身呪經云本真言"}
{"id": null, "n": "0096004", "target": "#nkr_note_orig_0096004", "type": "orig", "text": "上疑二"}
{"id": null, "n": "0096005", "target": "#nkr_note_orig_0096005", "type": "orig", "text": "二疑右"}
{"id": null, "n": "0096006", "target": "#nkr_note_orig_0096006", "type": "orig", "text": "二經作右"}
{"id": null, "n": "0096007", "target": "#nkr_note_orig_0096007", "type": "orig", "text": "友疑反"}
{"id": null, "n": "0096008", "target": "#nkr_note_orig_0096008", "type": "orig", "text": "突經作圖次同"}
{"id": null, "n": "0096009", "target": "#nkr_note_orig_0096009", "type": "orig", "text": "喃作那"}
{"id": null, "n": "0097001", "target": "#nkr_note_orig_0097001", "type": "orig", "text": "鉢唎一作跛囉"}
{"id": null, "n": "0097002", "target": "#nkr_note_orig_0097002", "type": "orig", "text": "上下經有頭指小指直伸六字"}
{"id": null, "n": "0097003", "target": "#nkr_note_orig_0097003", "type": "orig", "text": "大上經有右字"}
{"id": null, "n": "0097004", "target": "#nkr_note_orig_0097004", "type": "orig", "text": "下上有左手二字"}
{"id": null, "n": "0097005", "target": "#nkr_note_orig_0097005", "type": "orig", "text": "右經作左"}
{"id": null, "n": "0097006", "target": "#nkr_note_orig_0097006", "type": "orig", "text": "經無你字"}
{"id": null, "n": "0097007", "target": "#nkr_note_orig_0097007", "type": "orig", "text": "銜疑到"}
