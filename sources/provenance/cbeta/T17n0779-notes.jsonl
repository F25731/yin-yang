{"id": null, "n": "0715005", "target": "#nkr_note_mod_0715005", "type": "mod", "text": "佛說【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0715006", "target": "#nkr_note_mod_0715006", "type": "mod", "text": "經【大】，經西土聖賢集【元】"}
{"id": null, "n": "0715007", "target": "#nkr_note_mod_0715007", "type": "mod", "text": "後漢安息國三藏安世高譯【大】，後漢安世高譯【宋】【宮】，後漢沙門安世高譯【元】【明】"}
{"id": null, "n": "0715008", "target": "#nkr_note_mod_0715008", "type": "mod", "text": "心是【大】，是心【宋】【元】【明】【宮】"}
{"id": null, "n": "0715009", "target": "#nkr_note_mod_0715009", "type": "mod", "text": "唯【大】＊，惟【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0715010", "target": "#nkr_note_mod_0715010", "type": "mod", "text": "冤【大】，怨【宋】【元】【明】【宮】"}
{"id": null, "n": "0715011", "target": "#nkr_note_mod_0715011", "type": "mod", "text": "瓦【CB】【磧-CB】【宋】【元】【明】【宮】，瓶【大】（CBETA 按：《大正》本原用字「瓶」同底本《麗》本（K14n0515_p0051b22）用字。《中華藏》收錄底本為《金藏》廣勝寺本，作「瓦」（C024n0563_p0362b22），其校勘記出注：《磧》、《普》、《南》、《徑》、《清》作「瓶」（C024n0563_p0363a17-18）。惟查閱《磧》本（Q13n0532_p0827a22）、《徑》本（日本東京大學綜合圖書館藏正編第70帙第1冊第47圖右欄第7行）、《清》本（L047n0508_p0765a15），及多部藏經用字均作「瓦」。）"}
{"id": null, "n": "0715005", "target": "#nkr_note_orig_0715005", "type": "orig", "text": "〔佛說〕－【三】【宮】＊"}
{"id": null, "n": "0715006", "target": "#nkr_note_orig_0715006", "type": "orig", "text": "經＋（西土聖賢集）【元】"}
{"id": null, "n": "0715007", "target": "#nkr_note_orig_0715007", "type": "orig", "text": "後漢安息國三藏安世高譯＝後漢安世高譯【宋】【宮】，後漢沙門安世高譯【元】【明】"}
{"id": null, "n": "0715008", "target": "#nkr_note_orig_0715008", "type": "orig", "text": "心是＝是心【三】【宮】"}
{"id": null, "n": "0715009", "target": "#nkr_note_orig_0715009", "type": "orig", "text": "唯＝惟【三】【宮】＊"}
{"id": null, "n": "0715010", "target": "#nkr_note_orig_0715010", "type": "orig", "text": "冤＝怨【三】【宮】"}
{"id": null, "n": "0715011", "target": "#nkr_note_orig_0715011", "type": "orig", "text": "瓶＝瓦【三】【宮】"}
{"id": null, "n": "0715b2001", "target": "#nkr_note_add_0715b2001", "type": "add", "text": "常【CB】，［－］【大】"}
