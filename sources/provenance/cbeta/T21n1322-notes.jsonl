{"id": null, "n": "0488002", "target": "#nkr_note_mod_0488002", "type": "mod", "text": "眾【大】，諸【校異-原】"}
{"id": null, "n": "0488003", "target": "#nkr_note_mod_0488003", "type": "mod", "text": "若【大】＊，惹【甲】＊"}
{"id": null, "n": "0488004", "target": "#nkr_note_mod_0488004", "type": "mod", "text": "墼【大】，縠【校異-原】"}
{"id": null, "n": "0489001", "target": "#nkr_note_mod_0489001", "type": "mod", "text": "沫【大】，〔－〕【甲】"}
{"id": null, "n": "0489002", "target": "#nkr_note_mod_0489002", "type": "mod", "text": "三去【大】，〔－〕【甲】"}
{"id": null, "n": "0489003", "target": "#nkr_note_mod_0489003", "type": "mod", "text": "引【大】，〔－〕【甲】"}
{"id": null, "n": "0489004", "target": "#nkr_note_mod_0489004", "type": "mod", "text": "小【大】，少【甲】"}
{"id": null, "n": "0489005", "target": "#nkr_note_mod_0489005", "type": "mod", "text": "浴【大】，〔－〕【甲】"}
{"id": null, "n": "0488001", "target": "#nkr_note_orig_0488001", "type": "orig", "text": "【原】享保年間刊豐山大學藏本，【甲】康平二年寫高山寺藏本"}
{"id": null, "n": "0488002", "target": "#nkr_note_orig_0488002", "type": "orig", "text": "眾＝諸ィ【原】"}
{"id": null, "n": "0488003", "target": "#nkr_note_orig_0488003", "type": "orig", "text": "若＝惹【甲】＊"}
{"id": null, "n": "0488004", "target": "#nkr_note_orig_0488004", "type": "orig", "text": "墼＝縠ィ【原】"}
{"id": null, "n": "0489001", "target": "#nkr_note_orig_0489001", "type": "orig", "text": "〔沫〕－【甲】"}
{"id": null, "n": "0489002", "target": "#nkr_note_orig_0489002", "type": "orig", "text": "〔三去〕－【甲】"}
{"id": null, "n": "0489003", "target": "#nkr_note_orig_0489003", "type": "orig", "text": "〔引〕－【甲】"}
{"id": null, "n": "0489004", "target": "#nkr_note_orig_0489004", "type": "orig", "text": "小＝少【甲】"}
{"id": null, "n": "0489005", "target": "#nkr_note_orig_0489005", "type": "orig", "text": "〔浴〕－【甲】"}
{"id": null, "n": "0489006", "target": "#nkr_note_orig_0489006", "type": "orig", "text": "此下甲本奧書曰康平二年七月三十日於日野書了大阿闍梨御本延昭本以他本比交了"}
{"id": null, "n": "0489b2301", "target": "#nkr_note_add_0489b2301", "type": "add", "text": "嗚【CB】，鳴【大】"}
