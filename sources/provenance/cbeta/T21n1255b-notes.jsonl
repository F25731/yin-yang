{"id": null, "n": "0260002", "target": "#nkr_note_mod_0260002", "type": "mod", "text": "月【大】，〔－〕【甲】"}
{"id": null, "n": "0260003", "target": "#nkr_note_mod_0260003", "type": "mod", "text": "月天【大】，〔－〕【甲】"}
{"id": null, "n": "0260004", "target": "#nkr_note_mod_0260004", "type": "mod", "text": "債【大】＊，責【甲】＊，善【校異-甲】，〔責〕－【校異-甲】"}
{"id": null, "n": "0260005", "target": "#nkr_note_mod_0260005", "type": "mod", "text": "夜【大】，夜引【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0260006", "target": "#nkr_note_mod_0260006", "type": "mod", "text": "麼【大】＊，麼鼻聲【甲】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "鼻聲"}
{"id": null, "n": "0260007", "target": "#nkr_note_mod_0260007", "type": "mod", "text": "鼻聲已下同【大】，〔－〕【甲】"}
{"id": null, "n": "0260008", "target": "#nkr_note_mod_0260008", "type": "mod", "text": "一【大】，於一【校異-甲】"}
{"id": null, "n": "0260009", "target": "#nkr_note_mod_0260009", "type": "mod", "text": "支【大】，支天【校異-甲】"}
{"id": null, "n": "0260010", "target": "#nkr_note_mod_0260010", "type": "mod", "text": "蓮【大】，蓮花【甲】"}
{"id": null, "n": "0261001", "target": "#nkr_note_mod_0261001", "type": "mod", "text": "指【大】，指頭【校異-甲】"}
{"id": null, "n": "0261002", "target": "#nkr_note_mod_0261002", "type": "mod", "text": "各【大】，真言各【校異-甲】"}
{"id": null, "n": "0261003", "target": "#nkr_note_mod_0261003", "type": "mod", "text": "賀【大】，二合引賀引【甲】"}
{"id": null, "n": "0261004", "target": "#nkr_note_mod_0261004", "type": "mod", "text": "微【大】，微屈【甲】"}
{"id": null, "n": "0261005", "target": "#nkr_note_mod_0261005", "type": "mod", "text": "戴【大】，載【考偽-甲】"}
{"id": null, "n": "0261006", "target": "#nkr_note_mod_0261006", "type": "mod", "text": "無【大】，能無【甲】"}
{"id": null, "n": "0260001", "target": "#nkr_note_orig_0260001", "type": "orig", "text": "【原】明本，【甲】黃檗版淨嚴等加筆本，此經與麗本大異故別載之"}
{"id": null, "n": "0260002", "target": "#nkr_note_orig_0260002", "type": "orig", "text": "〔月〕－【甲】"}
{"id": null, "n": "0260003", "target": "#nkr_note_orig_0260003", "type": "orig", "text": "〔月天〕－【甲】"}
{"id": null, "n": "0260004", "target": "#nkr_note_orig_0260004", "type": "orig", "text": "債＝責【甲】＊，善ィ【甲】，〔責〕－ィ【甲】"}
{"id": null, "n": "0260005", "target": "#nkr_note_orig_0260005", "type": "orig", "text": "夜＋（引）細註【甲】"}
{"id": null, "n": "0260006", "target": "#nkr_note_orig_0260006", "type": "orig", "text": "麼＋（鼻聲）細註【甲】＊"}
{"id": null, "n": "0260007", "target": "#nkr_note_orig_0260007", "type": "orig", "text": "〔鼻聲已下同〕－【甲】"}
{"id": null, "n": "0260008", "target": "#nkr_note_orig_0260008", "type": "orig", "text": "（於）＋一ィ【甲】"}
{"id": null, "n": "0260009", "target": "#nkr_note_orig_0260009", "type": "orig", "text": "支＋（天）ィ【甲】"}
{"id": null, "n": "0260010", "target": "#nkr_note_orig_0260010", "type": "orig", "text": "蓮＋（花）【甲】"}
{"id": null, "n": "0261001", "target": "#nkr_note_orig_0261001", "type": "orig", "text": "指＋（頭）ィ【甲】"}
{"id": null, "n": "0261002", "target": "#nkr_note_orig_0261002", "type": "orig", "text": "（真言）＋各ィ【甲】"}
{"id": null, "n": "0261003", "target": "#nkr_note_orig_0261003", "type": "orig", "text": "賀＝二合引賀引【甲】"}
{"id": null, "n": "0261004", "target": "#nkr_note_orig_0261004", "type": "orig", "text": "微＋（屈）【甲】"}
{"id": null, "n": "0261005", "target": "#nkr_note_orig_0261005", "type": "orig", "text": "戴＝載ヵ【甲】"}
{"id": null, "n": "0261006", "target": "#nkr_note_orig_0261006", "type": "orig", "text": "（能）＋無【甲】"}
{"id": null, "n": "0261007", "target": "#nkr_note_orig_0261007", "type": "orig", "text": "甲本奧書曰貞享四年中春十六左點了淨嚴四十九載，元祿十六年二月十八日以淨嚴和上之本再挍了尊教，寶永三丙戌之春得此密軌戊子之冬十月十九日一挍了性寂"}
