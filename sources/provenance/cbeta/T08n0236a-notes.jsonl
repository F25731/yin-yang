{"id": null, "n": null, "target": null, "type": "cf1", "text": "K05n0014_p0985a02"}
{"id": null, "n": "0752c1201", "target": null, "type": "add", "text": "竺【CB】【麗-CB】，笠【大】"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K05n0014_p0985a02"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K05n0014_p0988c04"}
{"id": null, "n": "0752012", "target": "#nkr_note_mod_0752012", "type": "mod", "text": "天竺…譯【大】，三藏法師菩提留支第二譯【元】，三藏留師譯【明】"}
{"id": null, "n": "0752013", "target": "#nkr_note_mod_0752013", "type": "mod", "text": "如【大】，序分第一如【明】"}
{"id": null, "n": "0752014", "target": "#nkr_note_mod_0752014", "type": "mod", "text": "加【大】，跏【明】"}
{"id": null, "n": "0752015", "target": "#nkr_note_mod_0752015", "type": "mod", "text": "爾【大】，護念付囑分第二爾【明】"}
{"id": null, "n": "0752016", "target": "#nkr_note_mod_0752016", "type": "mod", "text": "世【大】，住分第三世【明】"}
{"id": null, "n": "0753001", "target": "#nkr_note_mod_0753001", "type": "mod", "text": "復【大】，如實修行分第四復【明】"}
{"id": null, "n": "0753002", "target": "#nkr_note_mod_0753002", "type": "mod", "text": "須【大】，如來非有為分第五須【明】"}
{"id": null, "n": "0753003", "target": "#nkr_note_mod_0753003", "type": "mod", "text": "須【大】，我空法分第六須【明】"}
{"id": null, "n": "0753004", "target": "#nkr_note_mod_0753004", "type": "mod", "text": "栰【大】，筏【明】"}
{"id": null, "n": "0753005", "target": "#nkr_note_mod_0753005", "type": "mod", "text": "須【大】，具足功德校量分第七須【明】"}
{"id": null, "n": "0753006", "target": "#nkr_note_mod_0753006", "type": "mod", "text": "復【大】，復有人【元】"}
{"id": null, "n": "0753007", "target": "#nkr_note_mod_0753007", "type": "mod", "text": "法【大】，法是名佛法【元】，法是非佛法【明】"}
{"id": null, "n": "0753008", "target": "#nkr_note_mod_0753008", "type": "mod", "text": "漢【大】，漢果【明】"}
{"id": null, "n": "0753009", "target": "#nkr_note_mod_0753009", "type": "mod", "text": "記【大】，說【明】"}
{"id": null, "n": "0754001", "target": "#nkr_note_mod_0754001", "type": "mod", "text": "數【大】＊，所【明】＊"}
{"id": null, "n": "0754002", "target": "#nkr_note_mod_0754002", "type": "mod", "text": "恒【大】，恒河【元】【明】"}
{"id": null, "n": "0754003", "target": "#nkr_note_mod_0754003", "type": "mod", "text": "名【大】，人【元】【明】"}
{"id": null, "n": "0754004", "target": "#nkr_note_mod_0754004", "type": "mod", "text": "眾生相人相【大】，人相眾生【元】"}
{"id": null, "n": "0754005", "target": "#nkr_note_mod_0754005", "type": "mod", "text": "無眾生相無人相【大】，無人相無眾生【元】"}
{"id": null, "n": "0754006", "target": "#nkr_note_mod_0754006", "type": "mod", "text": "須【大】，真如分第八須【明】"}
{"id": null, "n": "0755001", "target": "#nkr_note_mod_0755001", "type": "mod", "text": "須【大】，利益分第九須【明】"}
{"id": null, "n": "0755002", "target": "#nkr_note_mod_0755002", "type": "mod", "text": "發【大】，說【明】"}
{"id": null, "n": "0755003", "target": "#nkr_note_mod_0755003", "type": "mod", "text": "世【大】，〔－〕【元】"}
{"id": null, "n": "0755004", "target": "#nkr_note_mod_0755004", "type": "mod", "text": "爾【大】，斷疑分第十爾【明】"}
{"id": null, "n": "0755005", "target": "#nkr_note_mod_0755005", "type": "mod", "text": "則【大】，即【明】"}
{"id": null, "n": "0755006", "target": "#nkr_note_mod_0755006", "type": "mod", "text": "薩【大】，薩不【明】"}
{"id": null, "n": "0755007", "target": "#nkr_note_mod_0755007", "type": "mod", "text": "無眾生無人【大】，無我無人無眾生【元】"}
{"id": null, "n": "0755008", "target": "#nkr_note_mod_0755008", "type": "mod", "text": "是【大】，實【明】"}
{"id": null, "n": "0755009", "target": "#nkr_note_mod_0755009", "type": "mod", "text": "菩薩【大】，〔－〕【元】【明】"}
{"id": null, "n": "0755010", "target": "#nkr_note_mod_0755010", "type": "mod", "text": "告【大】，言【明】"}
{"id": null, "n": "0756001", "target": "#nkr_note_mod_0756001", "type": "mod", "text": "耶【大】，邪【中】"}
{"id": null, "n": "0756002", "target": "#nkr_note_mod_0756002", "type": "mod", "text": "即【大】，則【元】"}
{"id": null, "n": "0756003", "target": "#nkr_note_mod_0756003", "type": "mod", "text": "念【大】，見【元】【中】"}
{"id": null, "n": "0756004", "target": "#nkr_note_mod_0756004", "type": "mod", "text": "提【大】，提耶【明】"}
{"id": null, "n": "0756005", "target": "#nkr_note_mod_0756005", "type": "mod", "text": "何以故【大】，〔－〕【元】【明】"}
{"id": null, "n": "0756006", "target": "#nkr_note_mod_0756006", "type": "mod", "text": "者不【大】，〔－〕【元】【明】"}
{"id": null, "n": "0756007", "target": "#nkr_note_mod_0756007", "type": "mod", "text": "相【大】，相何以故菩薩摩訶薩發阿耨多羅三󳥜三菩提心者於法不說斷滅相故【明】，相何以故菩薩發阿耨多羅三󳥜三菩提心者於法不說斷滅相【元】"}
{"id": null, "n": "0756008", "target": "#nkr_note_mod_0756008", "type": "mod", "text": "則【大】＊，即【元】＊"}
{"id": null, "n": "0757001", "target": "#nkr_note_mod_0757001", "type": "mod", "text": "說而說偈言【大】，說爾時世尊而說偈言【元】【明】，說【中】"}
{"id": null, "n": "0757002", "target": "#nkr_note_mod_0757002", "type": "mod", "text": "一【大】，不住道分第十一一【明】"}
{"id": null, "n": "0757003", "target": "#nkr_note_mod_0757003", "type": "mod", "text": "佛說【大】，流通分第十二佛說【明】"}
{"id": null, "n": "0757004", "target": "#nkr_note_mod_0757004", "type": "mod", "text": "經【大】，經字後有（金剛…記）九十字【元】"}
{"id": null, "n": "0752011", "target": "#nkr_note_orig_0752011", "type": "orig", "text": "宋本別載卷末"}
{"id": null, "n": "0752012", "target": "#nkr_note_orig_0752012", "type": "orig", "text": "天…竺譯＝三藏法師菩提留支第二譯【元】三藏留師譯【明】"}
{"id": null, "n": "0752013", "target": "#nkr_note_orig_0752013", "type": "orig", "text": "（序分第一）＋如【明】"}
{"id": null, "n": "0752014", "target": "#nkr_note_orig_0752014", "type": "orig", "text": "加＝跏【明】"}
{"id": null, "n": "0752015", "target": "#nkr_note_orig_0752015", "type": "orig", "text": "（護念付囑分第二）＋爾【明】"}
{"id": null, "n": "0752016", "target": "#nkr_note_orig_0752016", "type": "orig", "text": "（住分第三）＋世【明】"}
{"id": null, "n": "0753001", "target": "#nkr_note_orig_0753001", "type": "orig", "text": "（如實修行分第四）＋復【明】"}
{"id": null, "n": "0753002", "target": "#nkr_note_orig_0753002", "type": "orig", "text": "（如來非有為分第五）＋須【明】"}
{"id": null, "n": "0753003", "target": "#nkr_note_orig_0753003", "type": "orig", "text": "（我空法分第六）＋須【明】"}
{"id": null, "n": "0753004", "target": "#nkr_note_orig_0753004", "type": "orig", "text": "栰＝筏【明】"}
{"id": null, "n": "0753005", "target": "#nkr_note_orig_0753005", "type": "orig", "text": "（具足功德校量分第七）＋須【明】"}
{"id": null, "n": "0753006", "target": "#nkr_note_orig_0753006", "type": "orig", "text": "復＋（有人）【元】"}
{"id": null, "n": "0753007", "target": "#nkr_note_orig_0753007", "type": "orig", "text": "法＋（是名佛法）【元】，（是非佛法）【明】"}
{"id": null, "n": "0753008", "target": "#nkr_note_orig_0753008", "type": "orig", "text": "漢＋（果）【明】"}
{"id": null, "n": "0753009", "target": "#nkr_note_orig_0753009", "type": "orig", "text": "記＝說【明】"}
{"id": null, "n": "0754001", "target": "#nkr_note_orig_0754001", "type": "orig", "text": "數＝所【明】＊"}
{"id": null, "n": "0754002", "target": "#nkr_note_orig_0754002", "type": "orig", "text": "恒＋（河）【元】【明】"}
{"id": null, "n": "0754003", "target": "#nkr_note_orig_0754003", "type": "orig", "text": "名＝人【元】【明】"}
{"id": null, "n": "0754004", "target": "#nkr_note_orig_0754004", "type": "orig", "text": "眾生相人相＝人相眾生【元】"}
{"id": null, "n": "0754005", "target": "#nkr_note_orig_0754005", "type": "orig", "text": "無眾生相無人相＝無人相無眾生【元】"}
{"id": null, "n": "0754006", "target": "#nkr_note_orig_0754006", "type": "orig", "text": "（真如分第八）＋須【明】"}
{"id": null, "n": "0755001", "target": "#nkr_note_orig_0755001", "type": "orig", "text": "（利益分第九）＋須【明】"}
{"id": null, "n": "0755002", "target": "#nkr_note_orig_0755002", "type": "orig", "text": "發＝說【明】"}
{"id": null, "n": "0755003", "target": "#nkr_note_orig_0755003", "type": "orig", "text": "〔世〕－【元】"}
{"id": null, "n": "0755004", "target": "#nkr_note_orig_0755004", "type": "orig", "text": "（斷疑分第十）＋爾【明】"}
{"id": null, "n": "0755005", "target": "#nkr_note_orig_0755005", "type": "orig", "text": "則＝即【明】"}
{"id": null, "n": "0755006", "target": "#nkr_note_orig_0755006", "type": "orig", "text": "薩＋（不）【明】"}
{"id": null, "n": "0755007", "target": "#nkr_note_orig_0755007", "type": "orig", "text": "無眾生無人＝無我無人無眾生【元】"}
{"id": null, "n": "0755008", "target": "#nkr_note_orig_0755008", "type": "orig", "text": "是＝實【明】"}
{"id": null, "n": "0755009", "target": "#nkr_note_orig_0755009", "type": "orig", "text": "〔菩薩〕－【元】【明】"}
{"id": null, "n": "0755010", "target": "#nkr_note_orig_0755010", "type": "orig", "text": "告＝言【明】"}
{"id": null, "n": "0756001", "target": "#nkr_note_orig_0756001", "type": "orig", "text": "耶＝邪【中】"}
{"id": null, "n": "0756002", "target": "#nkr_note_orig_0756002", "type": "orig", "text": "即＝則【元】"}
{"id": null, "n": "0756003", "target": "#nkr_note_orig_0756003", "type": "orig", "text": "念＝見【元】【中】"}
{"id": null, "n": "0756004", "target": "#nkr_note_orig_0756004", "type": "orig", "text": "提＋（耶）【明】"}
{"id": null, "n": "0756005", "target": "#nkr_note_orig_0756005", "type": "orig", "text": "〔何以故〕－【元】【明】"}
{"id": null, "n": "0756006", "target": "#nkr_note_orig_0756006", "type": "orig", "text": "〔者不〕－【元】【明】"}
{"id": null, "n": "0756007", "target": "#nkr_note_orig_0756007", "type": "orig", "text": "相＋（何以故菩薩摩訶薩發阿耨多羅三󳥜三菩提心者於法不說斷滅相故）二十八字【明】，（何以故菩薩發阿耨多羅三󳥜三菩提心者於法不說斷滅相）二十四字【元】"}
{"id": null, "n": "0756008", "target": "#nkr_note_orig_0756008", "type": "orig", "text": "則＝即【元】＊"}
{"id": null, "n": "0757001", "target": "#nkr_note_orig_0757001", "type": "orig", "text": "說＋（爾時世尊）【元】【明】，〔而說偈言〕－【中】"}
{"id": null, "n": "0757002", "target": "#nkr_note_orig_0757002", "type": "orig", "text": "（不住道分第十一）＋一【明】"}
{"id": null, "n": "0757003", "target": "#nkr_note_orig_0757003", "type": "orig", "text": "（流通分第十二）＋佛說【明】"}
{"id": null, "n": "0757004", "target": "#nkr_note_orig_0757004", "type": "orig", "text": "經＋（金剛…記）九十字【元】"}
{"id": null, "n": "0752c1201", "target": "#nkr_note_add_0752c1201", "type": "add", "text": "竺【CB】【麗-CB】，笠【大】"}
{"id": null, "n": "0755a1901", "target": "#nkr_note_add_0755a1901", "type": "add", "text": "燃【CB】【麗-CB】，然【大】"}
