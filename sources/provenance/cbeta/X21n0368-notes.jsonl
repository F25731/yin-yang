{"id": null, "n": "0161004", "target": "#nkr_note_orig_0161004", "type": "orig", "text": "來華間疑脫二供養全文三供養一分文而不妄修補請就本文了知其意"}
{"id": null, "n": "0161005", "target": "#nkr_note_orig_0161005", "type": "orig", "text": "異無養字"}
{"id": null, "n": "0162001", "target": "#nkr_note_orig_0162001", "type": "orig", "text": "法上異有諸字"}
{"id": null, "n": "0162002", "target": "#nkr_note_orig_0162002", "type": "orig", "text": "名上異有上半二字"}
{"id": null, "n": "0162003", "target": "#nkr_note_orig_0162003", "type": "orig", "text": "波上異有海字"}
{"id": null, "n": "0162004", "target": "#nkr_note_orig_0162004", "type": "orig", "text": "異無阿字次同"}
{"id": null, "n": "0163001", "target": "#nkr_note_orig_0163001", "type": "orig", "text": "成疑威"}
{"id": null, "n": "0163002", "target": "#nkr_note_orig_0163002", "type": "orig", "text": "異無識字"}
{"id": null, "n": "0163003", "target": "#nkr_note_orig_0163003", "type": "orig", "text": "後下異有心字"}
{"id": null, "n": "0163004", "target": "#nkr_note_orig_0163004", "type": "orig", "text": "麤異作廣"}
{"id": null, "n": "0164001", "target": "#nkr_note_orig_0164001", "type": "orig", "text": "異無諸字"}
{"id": null, "n": "0164002", "target": "#nkr_note_orig_0164002", "type": "orig", "text": "二上異有一字"}
{"id": null, "n": "0165001", "target": "#nkr_note_orig_0165001", "type": "orig", "text": "法上異有定字"}
{"id": null, "n": "0165002", "target": "#nkr_note_orig_0165002", "type": "orig", "text": "得異作待"}
{"id": null, "n": "0165003", "target": "#nkr_note_orig_0165003", "type": "orig", "text": "行異作定"}
{"id": null, "n": "0165004", "target": "#nkr_note_orig_0165004", "type": "orig", "text": "槃下異有故字"}
{"id": null, "n": "0166001", "target": "#nkr_note_orig_0166001", "type": "orig", "text": "立下異有法字"}
{"id": null, "n": "0166002", "target": "#nkr_note_orig_0166002", "type": "orig", "text": "菩薩疑煩惱"}
{"id": null, "n": "0167001", "target": "#nkr_note_orig_0167001", "type": "orig", "text": "異無可字"}
{"id": null, "n": "0168001", "target": "#nkr_note_orig_0168001", "type": "orig", "text": "身下異有欠字間空"}
{"id": null, "n": "0168002", "target": "#nkr_note_orig_0168002", "type": "orig", "text": "心上異有一字"}
{"id": null, "n": "0168003", "target": "#nkr_note_orig_0168003", "type": "orig", "text": "藏異作識"}
{"id": null, "n": "0168004", "target": "#nkr_note_orig_0168004", "type": "orig", "text": "有上疑脫次字"}
{"id": null, "n": "0169001", "target": "#nkr_note_orig_0169001", "type": "orig", "text": "名下異有修行地三字"}
{"id": null, "n": "0169002", "target": "#nkr_note_orig_0169002", "type": "orig", "text": "慧異作惡"}
