{"id": null, "n": "0124003", "target": "#nkr_note_mod_0124003", "type": "mod", "text": "大【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0124004", "target": "#nkr_note_mod_0124004", "type": "mod", "text": "法師【大】，沙門【宋】【元】【明】【宮】"}
{"id": null, "n": "0124005", "target": "#nkr_note_mod_0124005", "type": "mod", "text": "杖【大】＊，仗【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0124006", "target": "#nkr_note_mod_0124006", "type": "mod", "text": "浮【大】＊，扶【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0125001", "target": "#nkr_note_mod_0125001", "type": "mod", "text": "多有【大】，有多【宋】【元】【明】【宮】"}
{"id": null, "n": "0124003", "target": "#nkr_note_orig_0124003", "type": "orig", "text": "〔大〕－【三】【宮】"}
{"id": null, "n": "0124004", "target": "#nkr_note_orig_0124004", "type": "orig", "text": "法師＝沙門【三】【宮】"}
{"id": null, "n": "0124005", "target": "#nkr_note_orig_0124005", "type": "orig", "text": "杖＝仗【三】【宮】＊"}
{"id": null, "n": "0124006", "target": "#nkr_note_orig_0124006", "type": "orig", "text": "浮＝扶【三】【宮】＊"}
{"id": null, "n": "0125001", "target": "#nkr_note_orig_0125001", "type": "orig", "text": "多有＝有多【三】【宮】"}
