{"id": null, "n": null, "target": null, "type": null, "text": "舊名天竺者訛也"}
{"id": null, "n": null, "target": null, "type": null, "text": "梵本一偈今為一偈半"}
{"id": null, "n": null, "target": null, "type": null, "text": "張宿名也"}
{"id": null, "n": null, "target": null, "type": null, "text": "梵本本一偈，今為一偈半。"}
{"id": null, "n": null, "target": null, "type": null, "text": "張宿名也"}
{"id": null, "n": null, "target": null, "type": null, "text": "來謂業未作竟其果\n即來，失謂業已作竟其果便失"}
{"id": null, "n": null, "target": null, "type": null, "text": "梵本一偈今為一偈半＋（偈）【三】【宮】半【大】，半偈【宋】【元】【明】【宮】半半偈"}
{"id": null, "n": "0482005", "target": null, "type": "orig", "text": "半＋（偈）【三】【宮】"}
{"id": null, "n": "0482005", "target": null, "type": "mod", "text": "半【大】，半偈【宋】【元】【明】【宮】"}
{"id": null, "n": null, "target": null, "type": null, "text": "張宿名也"}
{"id": null, "n": null, "target": null, "type": null, "text": "梵本本一偈，今為一偈半。"}
{"id": null, "n": null, "target": null, "type": null, "text": "張宿名也"}
{"id": null, "n": "0482001", "target": "#nkr_note_mod_0482001", "type": "mod", "text": "緣【大】，緣生論一卷緣【宋】【元】【宮】，此序麗本缺今以宋元兩本對校明本採錄"}
{"id": null, "n": "0482002", "target": "#nkr_note_mod_0482002", "type": "mod", "text": "例【大】，倒【宮】"}
{"id": null, "n": "0482003", "target": "#nkr_note_mod_0482003", "type": "mod", "text": "大隋南印度三藏【大】，隋天竺三藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0482004", "target": "#nkr_note_mod_0482004", "type": "mod", "text": "梵本一偈今為一偈半【大】，梵本一偈今為一偈半【宋】【元】【明】【宮】"}
{"id": null, "n": null, "target": null, "type": null, "text": "梵本一偈今為一偈半"}
{"id": null, "n": "0482005", "target": "#nkr_note_mod_0482005", "type": "mod", "text": "半【大】，半偈【宋】【元】【明】【宮】"}
{"id": null, "n": "0482006", "target": "#nkr_note_mod_0482006", "type": "mod", "text": "三【大】，二【宮】"}
{"id": null, "n": "0482007", "target": "#nkr_note_mod_0482007", "type": "mod", "text": "張宿名也【大】＊，〔－〕【明】＊"}
{"id": null, "n": "0482008", "target": "#nkr_note_mod_0482008", "type": "mod", "text": "用具【大】，具用【宋】【元】【明】【宮】"}
{"id": null, "n": "0482009", "target": "#nkr_note_mod_0482009", "type": "mod", "text": "業苦【大】，苦業【宋】【元】【明】【宮】"}
{"id": null, "n": "0483001", "target": "#nkr_note_mod_0483001", "type": "mod", "text": "無【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0483002", "target": "#nkr_note_mod_0483002", "type": "mod", "text": "生【大】，三【宮】"}
{"id": null, "n": "0483003", "target": "#nkr_note_mod_0483003", "type": "mod", "text": "名【大】，也【宋】【元】【明】"}
{"id": null, "n": "0483004", "target": "#nkr_note_mod_0483004", "type": "mod", "text": "是【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0484001", "target": "#nkr_note_mod_0484001", "type": "mod", "text": "（梵本…半）十字【大】，梵本一偈今為一偈半偈【宋】【元】【明】【宮】"}
{"id": null, "n": null, "target": null, "type": null, "text": "梵本…半"}
{"id": null, "n": "0485001", "target": "#nkr_note_mod_0485001", "type": "mod", "text": "中【大】，生【宋】【元】【明】"}
{"id": null, "n": "0485002", "target": "#nkr_note_mod_0485002", "type": "mod", "text": "無【大】，於【明】"}
{"id": null, "n": "0485003", "target": "#nkr_note_mod_0485003", "type": "mod", "text": "謂【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0485004", "target": "#nkr_note_mod_0485004", "type": "mod", "text": "其【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0485005", "target": "#nkr_note_mod_0485005", "type": "mod", "text": "性【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0485006", "target": "#nkr_note_mod_0485006", "type": "mod", "text": "業苦【大】，苦業【明】"}
{"id": null, "n": "0486001", "target": "#nkr_note_mod_0486001", "type": "mod", "text": "合【大】，〔－〕【明】"}
{"id": null, "n": "0486002", "target": "#nkr_note_mod_0486002", "type": "mod", "text": "羅【大】，邏【宋】【元】【明】【宮】"}
{"id": null, "n": "0486003", "target": "#nkr_note_mod_0486003", "type": "mod", "text": "緣生論【大】，緣生論二【宋】【宮】"}
{"id": null, "n": "0482001", "target": "#nkr_note_orig_0482001", "type": "orig", "text": "（緣生論一卷）＋緣【宋】【元】【宮】，此序麗本缺今以宋元兩本對校明本採錄"}
{"id": null, "n": "0482002", "target": "#nkr_note_orig_0482002", "type": "orig", "text": "例＝倒【宮】"}
{"id": null, "n": "0482003", "target": "#nkr_note_orig_0482003", "type": "orig", "text": "大隋南印度三藏＝隋天竺三藏法師【三】【宮】"}
{"id": null, "n": "0482004", "target": "#nkr_note_orig_0482004", "type": "orig", "text": "梵本乃至半九字夾註宋元明宮四本俱作本文"}
{"id": null, "n": "0482005", "target": "#nkr_note_orig_0482005", "type": "orig", "text": "半＋（偈）【三】【宮】"}
{"id": null, "n": "0482006", "target": "#nkr_note_orig_0482006", "type": "orig", "text": "三＝二【宮】"}
{"id": null, "n": "0482007", "target": "#nkr_note_orig_0482007", "type": "orig", "text": "〔張宿名也〕－【明】＊"}
{"id": null, "n": "0482008", "target": "#nkr_note_orig_0482008", "type": "orig", "text": "用具＝具用【三】【宮】"}
{"id": null, "n": "0482009", "target": "#nkr_note_orig_0482009", "type": "orig", "text": "業苦＝苦業【三】【宮】"}
{"id": null, "n": "0483001", "target": "#nkr_note_orig_0483001", "type": "orig", "text": "〔無〕－【三】【宮】"}
{"id": null, "n": "0483002", "target": "#nkr_note_orig_0483002", "type": "orig", "text": "生＝三【宮】"}
{"id": null, "n": "0483003", "target": "#nkr_note_orig_0483003", "type": "orig", "text": "名＝也【三】"}
{"id": null, "n": "0483004", "target": "#nkr_note_orig_0483004", "type": "orig", "text": "〔是〕－【三】【宮】"}
{"id": null, "n": "0484001", "target": "#nkr_note_orig_0484001", "type": "orig", "text": "（（梵本…半））十字＝（（梵本一偈今為一偈半偈））十字本文【三】【宮】"}
{"id": null, "n": "0485001", "target": "#nkr_note_orig_0485001", "type": "orig", "text": "中＝生【三】"}
{"id": null, "n": "0485002", "target": "#nkr_note_orig_0485002", "type": "orig", "text": "無＝於【明】"}
{"id": null, "n": "0485003", "target": "#nkr_note_orig_0485003", "type": "orig", "text": "〔謂〕－【三】【宮】"}
{"id": null, "n": "0485004", "target": "#nkr_note_orig_0485004", "type": "orig", "text": "〔其〕－【三】【宮】"}
{"id": null, "n": "0485005", "target": "#nkr_note_orig_0485005", "type": "orig", "text": "〔性〕－【三】【宮】"}
{"id": null, "n": "0485006", "target": "#nkr_note_orig_0485006", "type": "orig", "text": "業苦＝苦業【明】"}
{"id": null, "n": "0486001", "target": "#nkr_note_orig_0486001", "type": "orig", "text": "〔合〕－【明】"}
{"id": null, "n": "0486002", "target": "#nkr_note_orig_0486002", "type": "orig", "text": "羅＝邏【三】【宮】"}
{"id": null, "n": "0486003", "target": "#nkr_note_orig_0486003", "type": "orig", "text": "緣生論＋（二）【宋】【宮】"}
