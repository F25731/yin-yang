{"id": null, "n": null, "target": null, "type": null, "text": "十二"}
{"id": null, "n": "0614003", "target": "#nkr_note_mod_0614003", "type": "mod", "text": "軌【大】＊，軌經【明】＊"}
{"id": null, "n": "0614004", "target": "#nkr_note_mod_0614004", "type": "mod", "text": "西【大】，宋西【明】"}
{"id": null, "n": "0614005", "target": "#nkr_note_mod_0614005", "type": "mod", "text": "譯經【大】，〔－〕【明】"}
{"id": null, "n": "0614006", "target": "#nkr_note_mod_0614006", "type": "mod", "text": "賜紫臣【大】，〔－〕【明】"}
{"id": null, "n": "0614007", "target": "#nkr_note_mod_0614007", "type": "mod", "text": "句【大】，〔－〕【明】"}
{"id": null, "n": "0614008", "target": "#nkr_note_mod_0614008", "type": "mod", "text": "切身【大】，寧也切【明】"}
{"id": null, "n": "0614009", "target": "#nkr_note_mod_0614009", "type": "mod", "text": "想【大】＊，相【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0614010", "target": "#nkr_note_mod_0614010", "type": "mod", "text": "頂【大】，項【宋】【元】【明】"}
{"id": null, "n": "0615001", "target": "#nkr_note_mod_0615001", "type": "mod", "text": "合【大】，合一字【宋】【元】【明】"}
{"id": null, "n": "0615002", "target": "#nkr_note_mod_0615002", "type": "mod", "text": "持【大】，特【宋】"}
{"id": null, "n": "0615003", "target": "#nkr_note_mod_0615003", "type": "mod", "text": "應【大】，應當【宋】【元】【明】"}
{"id": null, "n": "0614002", "target": "#nkr_note_orig_0614002", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0614003", "target": "#nkr_note_orig_0614003", "type": "orig", "text": "軌＋（經）【明】＊"}
{"id": null, "n": "0614004", "target": "#nkr_note_orig_0614004", "type": "orig", "text": "（宋）＋西【明】"}
{"id": null, "n": "0614005", "target": "#nkr_note_orig_0614005", "type": "orig", "text": "〔譯經〕－【明】"}
{"id": null, "n": "0614006", "target": "#nkr_note_orig_0614006", "type": "orig", "text": "〔賜紫臣〕－【明】"}
{"id": null, "n": "0614007", "target": "#nkr_note_orig_0614007", "type": "orig", "text": "〔句〕－【明】"}
{"id": null, "n": "0614008", "target": "#nkr_note_orig_0614008", "type": "orig", "text": "切身＝寧也切【明】"}
{"id": null, "n": "0614009", "target": "#nkr_note_orig_0614009", "type": "orig", "text": "想＝相【三】＊"}
{"id": null, "n": "0614010", "target": "#nkr_note_orig_0614010", "type": "orig", "text": "頂＝項【三】"}
{"id": null, "n": "0615001", "target": "#nkr_note_orig_0615001", "type": "orig", "text": "合＋（一字）本文【三】"}
{"id": null, "n": "0615002", "target": "#nkr_note_orig_0615002", "type": "orig", "text": "持＝特【宋】"}
{"id": null, "n": "0615003", "target": "#nkr_note_orig_0615003", "type": "orig", "text": "應＋（當）【三】"}
