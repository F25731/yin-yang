{"id": null, "n": "0569001", "target": "#nkr_note_mod_0569001", "type": "mod", "text": "憐【CB】，隣【卍續】，隣疑憐"}
{"id": null, "n": "0580003", "target": "#nkr_note_mod_0580003", "type": "mod", "text": "黠【CB】，點【卍續】，點疑黠次同"}
{"id": null, "n": "0569001", "target": "#nkr_note_orig_0569001", "type": "orig", "text": "隣疑憐"}
{"id": null, "n": "0570001", "target": "#nkr_note_orig_0570001", "type": "orig", "text": "曇下原本存十一字間空疑有脫文歟"}
{"id": null, "n": "0571001", "target": "#nkr_note_orig_0571001", "type": "orig", "text": "八疑入"}
{"id": null, "n": "0572001", "target": "#nkr_note_orig_0572001", "type": "orig", "text": "釋疑譯"}
{"id": null, "n": "0578001", "target": "#nkr_note_orig_0578001", "type": "orig", "text": "世疑拘"}
{"id": null, "n": "0580001", "target": "#nkr_note_orig_0580001", "type": "orig", "text": "緯疑紐"}
{"id": null, "n": "0580002", "target": "#nkr_note_orig_0580002", "type": "orig", "text": "擊疑繫"}
{"id": null, "n": "0580003", "target": "#nkr_note_orig_0580003", "type": "orig", "text": "點疑黠次同"}
{"id": null, "n": "0581001", "target": "#nkr_note_orig_0581001", "type": "orig", "text": "牲疑性"}
{"id": null, "n": "0582001", "target": "#nkr_note_orig_0582001", "type": "orig", "text": "是疑足"}
{"id": null, "n": "0587001", "target": "#nkr_note_orig_0587001", "type": "orig", "text": "滅下原本有十二字間空"}
{"id": null, "n": "0590001", "target": "#nkr_note_orig_0590001", "type": "orig", "text": "菩疑薩"}
{"id": null, "n": "0595001", "target": "#nkr_note_orig_0595001", "type": "orig", "text": "行利疑寫倒"}
{"id": null, "n": "0596001", "target": "#nkr_note_orig_0596001", "type": "orig", "text": "青下恐脫牛字"}
{"id": null, "n": "0597001", "target": "#nkr_note_orig_0597001", "type": "orig", "text": "行下原有十九字間空"}
{"id": null, "n": "0603001", "target": "#nkr_note_orig_0603001", "type": "orig", "text": "間疑問"}
{"id": null, "n": "0605001", "target": "#nkr_note_orig_0605001", "type": "orig", "text": "愛欲疑寫倒"}
{"id": null, "n": "0621001", "target": "#nkr_note_orig_0621001", "type": "orig", "text": "加疑如"}
{"id": null, "n": "0622001", "target": "#nkr_note_orig_0622001", "type": "orig", "text": "斤疑斥"}
{"id": null, "n": "0629001", "target": "#nkr_note_orig_0629001", "type": "orig", "text": "仰疑抑"}
{"id": null, "n": "0629002", "target": "#nkr_note_orig_0629002", "type": "orig", "text": "呼嗚恐寫倒"}
{"id": null, "n": "0630001", "target": "#nkr_note_orig_0630001", "type": "orig", "text": "偈疑竭"}
{"id": null, "n": "0631001", "target": "#nkr_note_orig_0631001", "type": "orig", "text": "歡當作歎"}
