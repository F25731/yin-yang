{"id": null, "n": "0171c2302", "target": "#nkr_note_add_0171c2302", "type": "add", "text": "己【CB】，巳【卍續】"}
{"id": null, "n": "0172a2101", "target": "#nkr_note_add_0172a2101", "type": "add", "text": "涯【CB】，渥【卍續】"}
{"id": null, "n": "0172c0601", "target": "#nkr_note_add_0172c0601", "type": "add", "text": "已【CB】，巳【卍續】"}
{"id": null, "n": "0174c1401", "target": "#nkr_note_add_0174c1401", "type": "add", "text": "已【CB】，巳【卍續】"}
{"id": null, "n": "0175a0701", "target": "#nkr_note_add_0175a0701", "type": "add", "text": "已【CB】，巳【卍續】"}
{"id": null, "n": "0175c2201", "target": "#nkr_note_add_0175c2201", "type": "add", "text": "已【CB】，巳【卍續】"}
