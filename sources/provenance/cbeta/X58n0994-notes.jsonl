{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "名諱清本"}
{"id": null, "n": null, "target": null, "type": null, "text": "一體，二用，三徧"}
{"id": null, "n": null, "target": null, "type": null, "text": "上釋修字"}
{"id": null, "n": null, "target": null, "type": null, "text": "上資音下催音"}
{"id": null, "n": null, "target": null, "type": null, "text": "他宗執無記為真心，何異認瓦礫為真金乎"}
{"id": null, "n": null, "target": null, "type": null, "text": "文有二段：初、法。"}
{"id": null, "n": null, "target": null, "type": null, "text": "疏云：喻於佛性通平等智。\n所以得知佛智徧者，無一眾生不有本覺，與一切佛體無殊故。"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂倒故不澄，豈得言無？如壯士迷故額珠，豈是膚中無寶？"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂若先無，離倒寧有？既離倒現，明本\n不無。如貧得珠，非今授與。自然智者，自覺聖智也。無礙智者，始本無二，絕二礙也。二、喻。"}
{"id": null, "n": null, "target": null, "type": null, "text": "喻佛智無涯，性德圓滿。"}
{"id": null, "n": null, "target": null, "type": null, "text": "書寫一一各稱境者，\n智如理故。"}
{"id": null, "n": null, "target": null, "type": null, "text": "潛一塵者，略有三義：一、妄覆真故，二、小含大故，三、一具多故"}
{"id": null, "n": null, "target": null, "type": null, "text": "一切塵者，無一眾生不具佛智故"}
{"id": null, "n": null, "target": null, "type": null, "text": "三合"}
{"id": null, "n": null, "target": null, "type": null, "text": "合上書寫多事"}
{"id": null, "n": null, "target": null, "type": null, "text": "眾生身及妄想\n俱合上塵"}
{"id": null, "n": null, "target": null, "type": null, "text": "如來合上一人，智眼合上\n天眼，是皆於經益物也"}
{"id": null, "n": null, "target": null, "type": null, "text": "矜伐"}
{"id": null, "n": null, "target": null, "type": null, "text": "上體下用"}
{"id": null, "n": null, "target": null, "type": null, "text": "本覺智明"}
{"id": null, "n": null, "target": null, "type": null, "text": "本覺顯照諸法"}
{"id": null, "n": null, "target": null, "type": null, "text": "顯照\n之時無倒"}
{"id": null, "n": null, "target": null, "type": null, "text": "性離惑染"}
{"id": null, "n": null, "target": null, "type": null, "text": "象、馬、車、步"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔出下文玄通上〕"}
{"id": null, "n": null, "target": null, "type": null, "text": "一淨土行"}
{"id": null, "n": null, "target": null, "type": null, "text": "二供佛行"}
{"id": null, "n": null, "target": null, "type": null, "text": "三敬眾行"}
{"id": null, "n": null, "target": null, "type": null, "text": "四悲濟行"}
{"id": null, "n": null, "target": null, "type": null, "text": "五十度行兼明\n神通行，等之一字等取十度，後三謂願、力、智也"}
{"id": null, "n": null, "target": null, "type": null, "text": "結上自在"}
{"id": null, "n": null, "target": null, "type": null, "text": "總結所依"}
{"id": null, "n": null, "target": null, "type": null, "text": "總中\n有別"}
{"id": null, "n": null, "target": null, "type": null, "text": "小能容大"}
{"id": null, "n": null, "target": null, "type": null, "text": "依正互融"}
{"id": null, "n": null, "target": null, "type": null, "text": "結歸果德"}
{"id": null, "n": null, "target": null, "type": null, "text": "性德圓徧"}
{"id": null, "n": null, "target": null, "type": null, "text": "性德無遷"}
{"id": null, "n": null, "target": null, "type": null, "text": "性德恒沙不離真體"}
{"id": null, "n": null, "target": null, "type": null, "text": "聖證\n性已性德本有"}
{"id": null, "n": null, "target": null, "type": null, "text": "上一對為總，謂合前二徧，下十對為別"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦賢首造"}
{"id": null, "n": null, "target": null, "type": null, "text": "上二依圭峰釋"}
{"id": null, "n": null, "target": null, "type": null, "text": "依清凉解"}
{"id": null, "n": null, "target": null, "type": null, "text": "次下二句即維摩經"}
{"id": null, "n": null, "target": null, "type": null, "text": "一譯經，二義解，三習禪，四明律，五護法，六\n感通，七遺身，八讀誦，九興福，十雜科"}
{"id": null, "n": null, "target": null, "type": null, "text": "文出\n答桓玄書。"}
{"id": null, "n": null, "target": null, "type": null, "text": "文出宋高僧傳"}
{"id": null, "n": null, "target": null, "type": null, "text": "上虗音，下希音，悲歎也"}
{"id": null, "n": null, "target": null, "type": null, "text": "出僧史略"}
{"id": null, "n": null, "target": null, "type": null, "text": "上三緣出北山錄，皆自滔。下一緣出寶公注，兼滔他。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此云學法，\n先學本法後受尼戒"}
{"id": null, "n": null, "target": null, "type": null, "text": "此云息慈，息滅染情慈愛眾生"}
{"id": null, "n": null, "target": null, "type": null, "text": "身三等"}
{"id": null, "n": null, "target": null, "type": null, "text": "怨與冤音義同"}
{"id": null, "n": null, "target": null, "type": null, "text": "質，猶當也。如燕\n太子丹質於秦。"}
{"id": null, "n": null, "target": null, "type": null, "text": "即正治凡夫人法二執，貪樂世間也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即兼治二乘執五薀法，見苦生怖也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即正治二乘狹劣之心，令觀眾生起於大悲也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即兼治凡夫懈怠之心，令觀無常，策修善行。"}
{"id": null, "n": null, "target": null, "type": null, "text": "止即妙觀"}
{"id": null, "n": null, "target": null, "type": null, "text": "觀即大止"}
{"id": null, "n": null, "target": null, "type": null, "text": "觀即大止"}
{"id": null, "n": null, "target": null, "type": null, "text": "止即妙觀"}
{"id": null, "n": null, "target": null, "type": null, "text": "具有五緣：一閑\n居靜處，二持戒清淨，三衣食具足，四得善知識，五息諸緣務。今但舉初，故云靜處。"}
{"id": null, "n": null, "target": null, "type": null, "text": "調身也。正\n身端直，不低不昂，不偏不邪，正面而住。"}
{"id": null, "n": null, "target": null, "type": null, "text": "調心也。意欲令其觀心與理相應，自度度他，至無上\n道。"}
{"id": null, "n": null, "target": null, "type": null, "text": "數息觀境。"}
{"id": null, "n": null, "target": null, "type": null, "text": "骨璅等。"}
{"id": null, "n": null, "target": null, "type": null, "text": "青黃赤白四相。"}
{"id": null, "n": null, "target": null, "type": null, "text": "空等五相，皆是事定所緣之境。"}
{"id": null, "n": null, "target": null, "type": null, "text": "見聞等，是散心時所取六塵，不復託緣，故言不依。"}
{"id": null, "n": null, "target": null, "type": null, "text": "除前諸境，\n\n更有餘心，皆亦遣之。"}
{"id": null, "n": null, "target": null, "type": null, "text": "所遣既亡，能遣不立。"}
{"id": null, "n": null, "target": null, "type": null, "text": "欲順於法性，故能所皆不存。"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋成無想所以，此乃即生無生，\n即滅無滅。"}
{"id": null, "n": null, "target": null, "type": null, "text": "若心外有實境，心緣此境時，抑令不緣，不可得故。"}
{"id": null, "n": null, "target": null, "type": null, "text": "論中無然字。今既心外無塵，即所取無相，其能取自然不生，何勞後心方\n更除耶？"}
{"id": null, "n": null, "target": null, "type": null, "text": "論中即云：住於正念，初習馳散，\n故攝令住正。"}
{"id": null, "n": null, "target": null, "type": null, "text": "論中即云：是正念者，當知唯心，無外境界。文雖\n有異，厥旨大同。"}
{"id": null, "n": null, "target": null, "type": null, "text": "以此唯心，非彼所知故。此是通遣之法，故云遠\n離。"}
{"id": null, "n": null, "target": null, "type": null, "text": "體真\n止空觀，隨緣方便止假觀，息二邊分別止中觀"}
{"id": null, "n": null, "target": null, "type": null, "text": "始一體，終六觀，為六重門"}
{"id": null, "n": null, "target": null, "type": null, "text": "迷境妄生"}
{"id": null, "n": null, "target": null, "type": null, "text": "悟境妄滅"}
{"id": null, "n": null, "target": null, "type": null, "text": "合覺背塵"}
{"id": null, "n": null, "target": null, "type": null, "text": "正證唯心"}
{"id": null, "n": null, "target": null, "type": null, "text": "第六經云：如是諸剎土，一一塵\n中現。"}
{"id": null, "n": null, "target": null, "type": null, "text": "現相品云：如來於一毛孔中，一切剎塵諸\n佛坐。"}
{"id": null, "n": null, "target": null, "type": null, "text": "即觀文引偈身現剎土也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "即觀中引偈剎現佛身也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "如經云：一一塵中無量身，復現種種莊嚴剎。"}
{"id": null, "n": null, "target": null, "type": null, "text": "如經云：一毛孔內難思剎，一一皆有徧照尊。"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼經在第四類，今順觀文引之。"}
{"id": null, "n": null, "target": null, "type": null, "text": "一多相作"}
{"id": null, "n": null, "target": null, "type": null, "text": "一多相入"}
{"id": null, "n": null, "target": null, "type": null, "text": "離出入相"}
{"id": null, "n": null, "target": null, "type": null, "text": "出其本因"}
{"id": null, "n": null, "target": null, "type": null, "text": "如於前五境入正定，於法塵中\n定得起"}
{"id": null, "n": null, "target": null, "type": null, "text": "於法塵中入正定，於前五境從定起"}
{"id": null, "n": null, "target": null, "type": null, "text": "如比丘身中入正定，學無學身中從定出"}
{"id": null, "n": null, "target": null, "type": null, "text": "諸天身中\n入正定，大龍身中從定出"}
{"id": null, "n": null, "target": null, "type": null, "text": "彌勒"}
{"id": null, "n": null, "target": null, "type": null, "text": "善財"}
{"id": null, "n": null, "target": null, "type": null, "text": "一樓閣"}
{"id": null, "n": null, "target": null, "type": null, "text": "百千樓"}
{"id": null, "n": null, "target": null, "type": null, "text": "善財一身"}
{"id": null, "n": null, "target": null, "type": null, "text": "彌勒百千"}
{"id": null, "n": null, "target": null, "type": null, "text": "初見文殊在沙羅林中，今通指本會也。祗桓，玄應法師翻\n云勝林，新云逝多。"}
{"id": null, "n": null, "target": null, "type": null, "text": "尅定見五十四人善知識。"}
{"id": null, "n": null, "target": null, "type": null, "text": "即德生童子、有\n德童女，指示彌勒住處。"}
{"id": null, "n": null, "target": null, "type": null, "text": "標定也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "初見\n彌勒從別處來，向樓閣所，故令我得入。"}
{"id": null, "n": null, "target": null, "type": null, "text": "令其諸法亡言會旨，\n則佛法門開。"}
{"id": null, "n": null, "target": null, "type": null, "text": "即妄而真，更無入處，故云還閉。"}
{"id": null, "n": null, "target": null, "type": null, "text": "經云：或見其中有無量百千諸妙樓閣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "經云：自見其身\n徧一切樓閣中。"}
{"id": null, "n": null, "target": null, "type": null, "text": "經云：或見彌勒初發菩提心時，或見最初證得慈心三昧。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "鶖子皆影響眾，權示聾盲"}
{"id": null, "n": null, "target": null, "type": null, "text": "以第三徧合於前二"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T35n1735_p0880b05"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T32n1666_p0581c24"}
{"id": null, "n": "0170001", "target": "#nkr_note_orig_0170001", "type": "orig", "text": "熏一作重"}
{"id": null, "n": "0170002", "target": "#nkr_note_orig_0170002", "type": "orig", "text": "止作心"}
{"id": null, "n": "0170003", "target": "#nkr_note_orig_0170003", "type": "orig", "text": "觀下一有門字"}
{"id": null, "n": "0170004", "target": "#nkr_note_orig_0170004", "type": "orig", "text": "一無直字"}
{"id": null, "n": "0170005", "target": "#nkr_note_orig_0170005", "type": "orig", "text": "難微作雖徹"}
{"id": null, "n": "0170006", "target": "#nkr_note_orig_0170006", "type": "orig", "text": "一無絕字"}
{"id": null, "n": "0170007", "target": "#nkr_note_orig_0170007", "type": "orig", "text": "利下一有前字"}
{"id": null, "n": "0170008", "target": "#nkr_note_orig_0170008", "type": "orig", "text": "一無以字"}
{"id": null, "n": "0171001", "target": "#nkr_note_orig_0171001", "type": "orig", "text": "比一作法"}
{"id": null, "n": "0171002", "target": "#nkr_note_orig_0171002", "type": "orig", "text": "俱一作但"}
{"id": null, "n": "0172001", "target": "#nkr_note_orig_0172001", "type": "orig", "text": "自字疑衍"}
{"id": null, "n": "0172002", "target": "#nkr_note_orig_0172002", "type": "orig", "text": "渥一作涯"}
{"id": null, "n": "0173001", "target": "#nkr_note_orig_0173001", "type": "orig", "text": "涅下一有槃字"}
{"id": null, "n": "0174001", "target": "#nkr_note_orig_0174001", "type": "orig", "text": "嚴下一有麗字"}
{"id": null, "n": "0175001", "target": "#nkr_note_orig_0175001", "type": "orig", "text": "出等六字一作於下文言通心"}
{"id": null, "n": "0176001", "target": "#nkr_note_orig_0176001", "type": "orig", "text": "乘一作葉"}
{"id": null, "n": "0176002", "target": "#nkr_note_orig_0176002", "type": "orig", "text": "高字更勘"}
{"id": null, "n": "0177001", "target": "#nkr_note_orig_0177001", "type": "orig", "text": "避疑遐"}
{"id": null, "n": "0178001", "target": "#nkr_note_orig_0178001", "type": "orig", "text": "喻橙疑寫倒"}
{"id": null, "n": "0178002", "target": "#nkr_note_orig_0178002", "type": "orig", "text": "見下疑脫之字"}
{"id": null, "n": "0178003", "target": "#nkr_note_orig_0178003", "type": "orig", "text": "涅疑濕"}
{"id": null, "n": "0178004", "target": "#nkr_note_orig_0178004", "type": "orig", "text": "壞一作環"}
{"id": null, "n": "0178005", "target": "#nkr_note_orig_0178005", "type": "orig", "text": "人疑又"}
{"id": null, "n": "0178006", "target": "#nkr_note_orig_0178006", "type": "orig", "text": "支疑友"}
{"id": null, "n": "0178007", "target": "#nkr_note_orig_0178007", "type": "orig", "text": "遙疑逕"}
{"id": null, "n": "0179001", "target": "#nkr_note_orig_0179001", "type": "orig", "text": "字疑宇"}
{"id": null, "n": "0179002", "target": "#nkr_note_orig_0179002", "type": "orig", "text": "欠一作允更勘"}
{"id": null, "n": "0182001", "target": "#nkr_note_orig_0182001", "type": "orig", "text": "縕一作＊𪝑マ、。󴦒"}
{"id": null, "n": null, "target": null, "type": null, "text": "マ、。󴦒"}
{"id": null, "n": "0183001", "target": "#nkr_note_orig_0183001", "type": "orig", "text": "微一作徹今謂恐徵"}
{"id": null, "n": "0184001", "target": "#nkr_note_orig_0184001", "type": "orig", "text": "一無者字"}
{"id": null, "n": "0170c1501", "target": "#nkr_note_add_0170c1501", "type": "add", "text": "諡【CB】，謚【卍續】"}
{"id": null, "n": "0171c1101", "target": "#nkr_note_add_0171c1101", "type": "add", "text": "已【CB】，巳【卍續】"}
