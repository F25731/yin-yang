{"id": null, "n": null, "target": null, "type": "cf1", "text": "K19n0677_p0536b12"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T01n0049_p0841c26"}
{"id": null, "n": "0839001", "target": "#nkr_note_mod_0839001", "type": "mod", "text": "收【大】，牧【宋】【元】【明】"}
{"id": null, "n": "0839002", "target": "#nkr_note_mod_0839002", "type": "mod", "text": "或有人內有求欲彼內有求欲不知如真此諸賢【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0839003", "target": "#nkr_note_mod_0839003", "type": "mod", "text": "真【大】，真如真【宋】"}
{"id": null, "n": "0839004", "target": "#nkr_note_mod_0839004", "type": "mod", "text": "後【大】，彼【宋】【元】【明】"}
{"id": null, "n": "0839005", "target": "#nkr_note_mod_0839005", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0839006", "target": "#nkr_note_mod_0839006", "type": "mod", "text": "拭【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0839007", "target": "#nkr_note_mod_0839007", "type": "mod", "text": "知【大】，如【明】"}
{"id": null, "n": "0839008", "target": "#nkr_note_mod_0839008", "type": "mod", "text": "欲雜【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0839009", "target": "#nkr_note_mod_0839009", "type": "mod", "text": "持來【大】，求【宋】【元】【明】"}
{"id": null, "n": "0839010", "target": "#nkr_note_mod_0839010", "type": "mod", "text": "終【大】，終善【宋】【元】【明】"}
{"id": null, "n": "0839011", "target": "#nkr_note_mod_0839011", "type": "mod", "text": "故【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0839012", "target": "#nkr_note_mod_0839012", "type": "mod", "text": "來【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0839013", "target": "#nkr_note_mod_0839013", "type": "mod", "text": "淨【大】，〔－〕【宋】"}
{"id": null, "n": "0839014", "target": "#nkr_note_mod_0839014", "type": "mod", "text": "欲【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0839015", "target": "#nkr_note_mod_0839015", "type": "mod", "text": "命【大】，令【元】【明】"}
{"id": null, "n": "0840001", "target": "#nkr_note_mod_0840001", "type": "mod", "text": "能【大】，已能【宋】【元】【明】"}
{"id": null, "n": "0840002", "target": "#nkr_note_mod_0840002", "type": "mod", "text": "前【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0841001", "target": "#nkr_note_mod_0841001", "type": "mod", "text": "或有人【大】，有【宋】【元】【明】"}
{"id": null, "n": "0841002", "target": "#nkr_note_mod_0841002", "type": "mod", "text": "已【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0841003", "target": "#nkr_note_mod_0841003", "type": "mod", "text": "行【大】，彼【宋】【元】【明】"}
{"id": null, "n": "0841004", "target": "#nkr_note_mod_0841004", "type": "mod", "text": "令【大】，命【宋】【元】【明】"}
{"id": null, "n": "0841005", "target": "#nkr_note_mod_0841005", "type": "mod", "text": "或【大】，或有【宋】【元】【明】"}
{"id": null, "n": "0841006", "target": "#nkr_note_mod_0841006", "type": "mod", "text": "餘【大】，有餘【宋】【元】【明】"}
{"id": null, "n": "0841007", "target": "#nkr_note_mod_0841007", "type": "mod", "text": "不【大】，不共【宋】【元】【明】"}
{"id": null, "n": "0841008", "target": "#nkr_note_mod_0841008", "type": "mod", "text": "是【大】，此【宋】【元】【明】"}
{"id": null, "n": "0841009", "target": "#nkr_note_mod_0841009", "type": "mod", "text": "沙門【大】，沙門俱【宋】【元】【明】"}
{"id": null, "n": "0841010", "target": "#nkr_note_mod_0841010", "type": "mod", "text": "乾【大】＊，犍【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0842001", "target": "#nkr_note_mod_0842001", "type": "mod", "text": "鬘【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0839001", "target": "#nkr_note_orig_0839001", "type": "orig", "text": "收＝牧【三】"}
{"id": null, "n": "0839002", "target": "#nkr_note_orig_0839002", "type": "orig", "text": "〔或有人內有求欲彼內有求欲不知如真此諸賢〕十九字－【三】"}
{"id": null, "n": "0839003", "target": "#nkr_note_orig_0839003", "type": "orig", "text": "真＋（如真）【宋】"}
{"id": null, "n": "0839004", "target": "#nkr_note_orig_0839004", "type": "orig", "text": "後＝彼【三】"}
{"id": null, "n": "0839005", "target": "#nkr_note_orig_0839005", "type": "orig", "text": "〔有〕－【三】"}
{"id": null, "n": "0839006", "target": "#nkr_note_orig_0839006", "type": "orig", "text": "〔拭〕－【三】"}
{"id": null, "n": "0839007", "target": "#nkr_note_orig_0839007", "type": "orig", "text": "知＝如【明】"}
{"id": null, "n": "0839008", "target": "#nkr_note_orig_0839008", "type": "orig", "text": "〔欲雜〕－【三】"}
{"id": null, "n": "0839009", "target": "#nkr_note_orig_0839009", "type": "orig", "text": "持來＝求【三】"}
{"id": null, "n": "0839010", "target": "#nkr_note_orig_0839010", "type": "orig", "text": "終＋（善）【三】"}
{"id": null, "n": "0839011", "target": "#nkr_note_orig_0839011", "type": "orig", "text": "〔故〕－【三】"}
{"id": null, "n": "0839012", "target": "#nkr_note_orig_0839012", "type": "orig", "text": "〔來〕－【三】"}
{"id": null, "n": "0839013", "target": "#nkr_note_orig_0839013", "type": "orig", "text": "〔淨〕－【宋】"}
{"id": null, "n": "0839014", "target": "#nkr_note_orig_0839014", "type": "orig", "text": "〔欲〕－【三】"}
{"id": null, "n": "0839015", "target": "#nkr_note_orig_0839015", "type": "orig", "text": "命＝令【元】【明】"}
{"id": null, "n": "0840001", "target": "#nkr_note_orig_0840001", "type": "orig", "text": "（已）＋能【三】"}
{"id": null, "n": "0840002", "target": "#nkr_note_orig_0840002", "type": "orig", "text": "〔前〕－【三】"}
{"id": null, "n": "0841001", "target": "#nkr_note_orig_0841001", "type": "orig", "text": "或有人＝有【三】"}
{"id": null, "n": "0841002", "target": "#nkr_note_orig_0841002", "type": "orig", "text": "〔已〕－【三】"}
{"id": null, "n": "0841003", "target": "#nkr_note_orig_0841003", "type": "orig", "text": "行＝彼【三】"}
{"id": null, "n": "0841004", "target": "#nkr_note_orig_0841004", "type": "orig", "text": "令＝命【三】"}
{"id": null, "n": "0841005", "target": "#nkr_note_orig_0841005", "type": "orig", "text": "或＋（有）【三】"}
{"id": null, "n": "0841006", "target": "#nkr_note_orig_0841006", "type": "orig", "text": "（有）＋餘【三】"}
{"id": null, "n": "0841007", "target": "#nkr_note_orig_0841007", "type": "orig", "text": "不＋（共）【三】"}
{"id": null, "n": "0841008", "target": "#nkr_note_orig_0841008", "type": "orig", "text": "是＝此【三】"}
{"id": null, "n": "0841009", "target": "#nkr_note_orig_0841009", "type": "orig", "text": "沙門＋（俱）【三】"}
{"id": null, "n": "0841010", "target": "#nkr_note_orig_0841010", "type": "orig", "text": "乾＝犍【三】＊"}
{"id": null, "n": "0842001", "target": "#nkr_note_orig_0842001", "type": "orig", "text": "〔鬘〕－【三】"}
{"id": null, "n": "0842a1101", "target": "#nkr_note_add_0842a1101", "type": "add", "text": "說【CB】【麗-CB】，脫【大】"}
