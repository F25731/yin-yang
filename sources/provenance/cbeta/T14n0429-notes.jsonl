{"id": null, "n": "0074006", "target": "#nkr_note_mod_0074006", "type": "mod", "text": "天竺【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0074007", "target": "#nkr_note_mod_0074007", "type": "mod", "text": "致【大】，到【宋】【元】【明】【宮】"}
{"id": null, "n": "0074008", "target": "#nkr_note_mod_0074008", "type": "mod", "text": "又入戰鬪【大】，若入鬪戰【宋】【元】【明】【宮】"}
{"id": null, "n": "0074009", "target": "#nkr_note_mod_0074009", "type": "mod", "text": "名【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0074010", "target": "#nkr_note_mod_0074010", "type": "mod", "text": "此【大】，是【宋】【元】【明】【宮】"}
{"id": null, "n": "0074011", "target": "#nkr_note_mod_0074011", "type": "mod", "text": "以【大】，已【宋】【元】【明】【宮】"}
{"id": null, "n": "0074012", "target": "#nkr_note_mod_0074012", "type": "mod", "text": "場【大】，揚【宋】【元】【明】【宮】"}
{"id": null, "n": "0074013", "target": "#nkr_note_mod_0074013", "type": "mod", "text": "無上【大】，天上【宋】【元】【明】【宮】"}
{"id": null, "n": "0075001", "target": "#nkr_note_mod_0075001", "type": "mod", "text": "頒【大】，班【宋】【元】【明】【宮】"}
{"id": null, "n": "0075002", "target": "#nkr_note_mod_0075002", "type": "mod", "text": "燕【大】，宴【宋】【元】【明】【宮】"}
{"id": null, "n": "0075003", "target": "#nkr_note_mod_0075003", "type": "mod", "text": "名經【大】，經名【宋】【元】【明】【宮】"}
{"id": null, "n": "0075004", "target": "#nkr_note_mod_0075004", "type": "mod", "text": "厭【大】，魘【元】【明】"}
{"id": null, "n": "0075005", "target": "#nkr_note_mod_0075005", "type": "mod", "text": "溪谷壙路【大】，谿谷曠路【宋】【元】【明】【宮】"}
{"id": null, "n": "0075006", "target": "#nkr_note_mod_0075006", "type": "mod", "text": "罷【大】，羆【宋】【元】【明】【宮】"}
{"id": null, "n": "0075007", "target": "#nkr_note_mod_0075007", "type": "mod", "text": "踰【大】，喻【宋】【元】【明】【宮】"}
{"id": null, "n": "0075008", "target": "#nkr_note_mod_0075008", "type": "mod", "text": "退＋次行（性空佛法空燈佛天王佛金仁佛）【宋】【元】【明】【宮】"}
{"id": null, "n": "0075009", "target": "#nkr_note_mod_0075009", "type": "mod", "text": "經【大】，經終【明】"}
