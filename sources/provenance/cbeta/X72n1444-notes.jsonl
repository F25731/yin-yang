{"id": null, "n": null, "target": null, "type": null, "text": "以下四則俱無擇師請"}
{"id": null, "n": null, "target": null, "type": null, "text": "剡城周九賓求頌"}
{"id": null, "n": null, "target": null, "type": null, "text": "以下十七頌俱漢月請。"}
{"id": null, "n": null, "target": null, "type": null, "text": "有頌錄、頌古卷中"}
{"id": null, "n": null, "target": null, "type": null, "text": "此在初答"}
{"id": null, "n": null, "target": null, "type": null, "text": "法名大瀛，歙縣人。"}
{"id": null, "n": null, "target": null, "type": null, "text": "名化龍，󳱮東南海人。"}
{"id": null, "n": null, "target": null, "type": null, "text": "達觀大師索頌"}
{"id": null, "n": null, "target": null, "type": null, "text": "陶石簣請頌"}
{"id": null, "n": null, "target": null, "type": null, "text": "達觀大師索頌"}
{"id": null, "n": null, "target": null, "type": null, "text": "𢌞泉師請"}
{"id": null, "n": null, "target": null, "type": null, "text": "王雲萊請"}
{"id": null, "n": null, "target": null, "type": null, "text": "有序"}
{"id": null, "n": null, "target": null, "type": null, "text": "贈沈定凡，號旅泊居士。"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T49n2035_p0394b17"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "X61n1156_p0459b23"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T14n0475_p0552a11"}
{"id": null, "n": "0771001", "target": "#nkr_note_orig_0771001", "type": "orig", "text": "玉前作王"}
{"id": null, "n": "0772001", "target": "#nkr_note_orig_0772001", "type": "orig", "text": "別有門人明海編弟子明聲梓八卷本然彼略此廣仍採此錄"}
{"id": null, "n": "0772002", "target": "#nkr_note_orig_0772002", "type": "orig", "text": "煩應作今日"}
{"id": null, "n": "0772003", "target": "#nkr_note_orig_0772003", "type": "orig", "text": "感應作歌"}
{"id": null, "n": "0772004", "target": "#nkr_note_orig_0772004", "type": "orig", "text": "方下應入世界二字看"}
{"id": null, "n": "0772005", "target": "#nkr_note_orig_0772005", "type": "orig", "text": "也下應入到此時節四字見"}
{"id": null, "n": "0773001", "target": "#nkr_note_orig_0773001", "type": "orig", "text": "拈上應入驀字見"}
{"id": null, "n": "0773002", "target": "#nkr_note_orig_0773002", "type": "orig", "text": "為應作謂"}
{"id": null, "n": "0776001", "target": "#nkr_note_orig_0776001", "type": "orig", "text": "平當作淨"}
{"id": null, "n": "0777001", "target": "#nkr_note_orig_0777001", "type": "orig", "text": "下當作上"}
{"id": null, "n": "0777002", "target": "#nkr_note_orig_0777002", "type": "orig", "text": "義唱當作演為"}
{"id": null, "n": "0778001", "target": "#nkr_note_orig_0778001", "type": "orig", "text": "這當作一"}
{"id": null, "n": "0782001", "target": "#nkr_note_orig_0782001", "type": "orig", "text": "春應作生"}
{"id": null, "n": "0783001", "target": "#nkr_note_orig_0783001", "type": "orig", "text": "師云應作上堂看"}
{"id": null, "n": "0785001", "target": "#nkr_note_orig_0785001", "type": "orig", "text": "轉應作展"}
{"id": null, "n": "0785002", "target": "#nkr_note_orig_0785002", "type": "orig", "text": "似應作事"}
{"id": null, "n": "0787001", "target": "#nkr_note_orig_0787001", "type": "orig", "text": "了應作等"}
{"id": null, "n": "0787002", "target": "#nkr_note_orig_0787002", "type": "orig", "text": "若下應有也字"}
{"id": null, "n": "0788001", "target": "#nkr_note_orig_0788001", "type": "orig", "text": "年應作春"}
{"id": null, "n": "0790001", "target": "#nkr_note_orig_0790001", "type": "orig", "text": "省一作醒"}
{"id": null, "n": "0790002", "target": "#nkr_note_orig_0790002", "type": "orig", "text": "故下應有須字"}
{"id": null, "n": "0790003", "target": "#nkr_note_orig_0790003", "type": "orig", "text": "看他二字似剩"}
{"id": null, "n": "0791001", "target": "#nkr_note_orig_0791001", "type": "orig", "text": "閑應作消"}
{"id": null, "n": "0792001", "target": "#nkr_note_orig_0792001", "type": "orig", "text": "此字疑剩"}
{"id": null, "n": "0792002", "target": "#nkr_note_orig_0792002", "type": "orig", "text": "轉應作展"}
{"id": null, "n": "0793001", "target": "#nkr_note_orig_0793001", "type": "orig", "text": "似應作是"}
{"id": null, "n": "0798001", "target": "#nkr_note_orig_0798001", "type": "orig", "text": "脇或作肋"}
{"id": null, "n": "0802001", "target": "#nkr_note_orig_0802001", "type": "orig", "text": "趙州疑南泉"}
{"id": null, "n": "0808001", "target": "#nkr_note_orig_0808001", "type": "orig", "text": "白刃或作學人"}
{"id": null, "n": "0809001", "target": "#nkr_note_orig_0809001", "type": "orig", "text": "堂堂應作瓊樓"}
{"id": null, "n": "0816001", "target": "#nkr_note_orig_0816001", "type": "orig", "text": "非是一作是非"}
{"id": null, "n": "0820001", "target": "#nkr_note_orig_0820001", "type": "orig", "text": "問或作承諭"}
{"id": null, "n": "0820002", "target": "#nkr_note_orig_0820002", "type": "orig", "text": "正法或作要"}
{"id": null, "n": "0820003", "target": "#nkr_note_orig_0820003", "type": "orig", "text": "後後或作長久"}
{"id": null, "n": "0822001", "target": "#nkr_note_orig_0822001", "type": "orig", "text": "真或作身"}
{"id": null, "n": "0826001", "target": "#nkr_note_orig_0826001", "type": "orig", "text": "間疑問"}
{"id": null, "n": "0828001", "target": "#nkr_note_orig_0828001", "type": "orig", "text": "語或作辞"}
{"id": null, "n": "0828002", "target": "#nkr_note_orig_0828002", "type": "orig", "text": "法髓或作衣法"}
{"id": null, "n": "0829001", "target": "#nkr_note_orig_0829001", "type": "orig", "text": "陽復或作花開"}
{"id": null, "n": "0829002", "target": "#nkr_note_orig_0829002", "type": "orig", "text": "轡或作闡"}
{"id": null, "n": "0831001", "target": "#nkr_note_orig_0831001", "type": "orig", "text": "緣或作旨"}
{"id": null, "n": "0831002", "target": "#nkr_note_orig_0831002", "type": "orig", "text": "黠或作小"}
{"id": null, "n": "0831003", "target": "#nkr_note_orig_0831003", "type": "orig", "text": "父或作文"}
{"id": null, "n": "0838001", "target": "#nkr_note_orig_0838001", "type": "orig", "text": "一或作堕"}
{"id": null, "n": "0838002", "target": "#nkr_note_orig_0838002", "type": "orig", "text": "睡或作倦"}
{"id": null, "n": "0846001", "target": "#nkr_note_orig_0846001", "type": "orig", "text": "是當作似"}
{"id": null, "n": "0850001", "target": "#nkr_note_orig_0850001", "type": "orig", "text": "設疑說"}
{"id": null, "n": "0850002", "target": "#nkr_note_orig_0850002", "type": "orig", "text": "偕疑楷"}
{"id": null, "n": "0852001", "target": "#nkr_note_orig_0852001", "type": "orig", "text": "當疑常"}
{"id": null, "n": "0852002", "target": "#nkr_note_orig_0852002", "type": "orig", "text": "什當作恁下同"}
{"id": null, "n": "0853001", "target": "#nkr_note_orig_0853001", "type": "orig", "text": "是疑似"}
{"id": null, "n": "0853002", "target": "#nkr_note_orig_0853002", "type": "orig", "text": "也字疑剩"}
{"id": null, "n": "0853003", "target": "#nkr_note_orig_0853003", "type": "orig", "text": "矣疑其"}
