{"id": null, "n": null, "target": null, "type": null, "text": "亦可如者不定之詞\n意云其生久耶"}
{"id": null, "n": null, "target": null, "type": null, "text": "五蘊空也"}
{"id": null, "n": null, "target": null, "type": null, "text": "十二處十八界空也"}
{"id": null, "n": null, "target": null, "type": null, "text": "三界空也"}
{"id": null, "n": null, "target": null, "type": null, "text": "三寶空也"}
{"id": null, "n": null, "target": null, "type": null, "text": "只有五蔭無有第六"}
{"id": null, "n": null, "target": null, "type": null, "text": "只有第六根無第七也"}
{"id": null, "n": null, "target": null, "type": null, "text": "只有六根六識十二入門無第十三也"}
{"id": null, "n": null, "target": null, "type": null, "text": "只有六根六識六境三六十八更無十九"}
{"id": null, "n": null, "target": null, "type": null, "text": "悲願入中非因惡藥"}
{"id": null, "n": null, "target": null, "type": null, "text": "無福功德生餓鬼中菩薩示現不因無福"}
{"id": null, "n": null, "target": null, "type": null, "text": "智波羅蜜生佛身故"}
{"id": null, "n": null, "target": null, "type": null, "text": "方便善巧養菩提故"}
{"id": null, "n": null, "target": null, "type": null, "text": "法味充身悅樂心故"}
{"id": null, "n": null, "target": null, "type": null, "text": "柔和善順隨人意故"}
{"id": null, "n": null, "target": null, "type": null, "text": "堅固不虛丈夫性故"}
{"id": null, "n": null, "target": null, "type": null, "text": "神通迅速故云馳也"}
{"id": null, "n": null, "target": null, "type": null, "text": "迴施眾生\n功德多故"}
{"id": null, "n": null, "target": null, "type": null, "text": "安心處故"}
{"id": null, "n": null, "target": null, "type": null, "text": "三惡道也"}
{"id": null, "n": null, "target": null, "type": null, "text": "八難處也"}
{"id": null, "n": null, "target": null, "type": null, "text": "邊地下賤"}
{"id": null, "n": null, "target": null, "type": null, "text": "見光觸身發心入證"}
{"id": null, "n": null, "target": null, "type": null, "text": "他方淨土無聲聞眾見菩薩而能入證"}
{"id": null, "n": null, "target": null, "type": null, "text": "千佛之中有一佛與眾生無緣便入涅槃留一化身\n化眾生也"}
{"id": null, "n": null, "target": null, "type": null, "text": "遠離世樂故"}
{"id": null, "n": null, "target": null, "type": null, "text": "怜念眾生不受苦故"}
{"id": null, "n": null, "target": null, "type": null, "text": "利益我故"}
{"id": null, "n": null, "target": null, "type": null, "text": "境界多故"}
{"id": null, "n": null, "target": null, "type": null, "text": "不憎嫌也"}
{"id": null, "n": null, "target": null, "type": null, "text": "生佛身故"}
{"id": null, "n": null, "target": null, "type": null, "text": "隨逐我身不相離故"}
{"id": null, "n": null, "target": null, "type": null, "text": "不怯退故"}
{"id": null, "n": null, "target": null, "type": null, "text": "求不足故"}
{"id": null, "n": null, "target": null, "type": null, "text": "拔苦與樂福德滿故"}
{"id": null, "n": null, "target": null, "type": null, "text": "無數不經智慧滿故"}
{"id": null, "n": null, "target": null, "type": null, "text": "已滅故"}
{"id": null, "n": null, "target": null, "type": null, "text": "不生故"}
{"id": null, "n": null, "target": null, "type": null, "text": "無前後故"}
{"id": null, "n": null, "target": null, "type": null, "text": "有空故"}
{"id": null, "n": null, "target": null, "type": null, "text": "空空故"}
{"id": null, "n": null, "target": null, "type": null, "text": "無定故"}
{"id": null, "n": null, "target": null, "type": null, "text": "離能造也"}
{"id": null, "n": null, "target": null, "type": null, "text": "六根空也因緣積空也聚無實性也"}
{"id": null, "n": null, "target": null, "type": null, "text": "超六入也"}
{"id": null, "n": "0423002", "target": "#nkr_note_orig_0423002", "type": "orig", "text": "【原】佛蘭西國民圖書館藏燉煌本, P.2275, 首題新加"}
{"id": null, "n": "0426001", "target": "#nkr_note_orig_0426001", "type": "orig", "text": "經師下有因其出家四字"}
{"id": null, "n": "0427a2101", "target": "#nkr_note_add_0427a2101", "type": "add", "text": "刺【CB】，剌【大】"}
