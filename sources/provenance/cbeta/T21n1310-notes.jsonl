{"id": null, "n": null, "target": null, "type": null, "text": "複熾盛光法"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0457004", "target": "#nkr_note_mod_0457004", "type": "mod", "text": "複熾盛光法【大】，〔－〕【校異-原】"}
{"id": null, "n": "0457005", "target": "#nkr_note_mod_0457005", "type": "mod", "text": "曩【大】，〔－〕【校異-原】"}
{"id": null, "n": "0457006", "target": "#nkr_note_mod_0457006", "type": "mod", "text": "蜜【大】，密【校異-原】"}
{"id": null, "n": "0457007", "target": "#nkr_note_mod_0457007", "type": "mod", "text": "山【大】，仙【校異-原】"}
{"id": null, "n": "0457008", "target": "#nkr_note_mod_0457008", "type": "mod", "text": "野【大】，野唵阿謨伽寫野【校異-原】"}
{"id": null, "n": "0457009", "target": "#nkr_note_mod_0457009", "type": "mod", "text": "阿【大】，〔－〕【校異-原】"}
{"id": null, "n": "0457010", "target": "#nkr_note_mod_0457010", "type": "mod", "text": "囉二合嚩囉【大】，二合囉嚩【校異-原】"}
{"id": null, "n": "0457011", "target": "#nkr_note_mod_0457011", "type": "mod", "text": "泥【大】，泥吃【校異-原】"}
{"id": null, "n": "0457012", "target": "#nkr_note_mod_0457012", "type": "mod", "text": "作【大】，儞【校異-原】"}
{"id": null, "n": "0458001", "target": "#nkr_note_mod_0458001", "type": "mod", "text": "醫【大】，翳【校異-原】"}
{"id": null, "n": "0458002", "target": "#nkr_note_mod_0458002", "type": "mod", "text": "𠰘【大】，呬【校異-原】"}
{"id": null, "n": "0458003", "target": "#nkr_note_mod_0458003", "type": "mod", "text": "面【大】，面頭指【考偽-原】"}
{"id": null, "n": "0458004", "target": "#nkr_note_mod_0458004", "type": "mod", "text": "娜【大】，娜哩【校異-原】"}
{"id": null, "n": "0458005", "target": "#nkr_note_mod_0458005", "type": "mod", "text": "𮙖【大】，蹙【校異-原】"}
{"id": null, "n": "0458006", "target": "#nkr_note_mod_0458006", "type": "mod", "text": "曰【大】，白【校異-原】"}
{"id": null, "n": "0458007", "target": "#nkr_note_mod_0458007", "type": "mod", "text": "刑【大】，刊【校異-原】"}
{"id": null, "n": "0458008", "target": "#nkr_note_mod_0458008", "type": "mod", "text": "小【大】，少【考偽-原】"}
{"id": null, "n": "0458009", "target": "#nkr_note_mod_0458009", "type": "mod", "text": "刊【大】，削【校異-原】"}
{"id": null, "n": "0458010", "target": "#nkr_note_mod_0458010", "type": "mod", "text": "北斗法【大】，〔－〕【校異-原】"}
{"id": null, "n": "0458011", "target": "#nkr_note_mod_0458011", "type": "mod", "text": "陵逼諸座不能【大】，不能陵逼諸座【考偽-原】"}
{"id": null, "n": "0458012", "target": "#nkr_note_mod_0458012", "type": "mod", "text": "并【大】，麁【校異-原】"}
{"id": null, "n": "0459001", "target": "#nkr_note_mod_0459001", "type": "mod", "text": "死【大】，屍【校異-原】"}
{"id": null, "n": "0459002", "target": "#nkr_note_mod_0459002", "type": "mod", "text": "即【大】，天災即【校異-原】"}
{"id": null, "n": "0459003", "target": "#nkr_note_mod_0459003", "type": "mod", "text": "壇【大】，檀【校異-原】"}
{"id": null, "n": "0457003", "target": "#nkr_note_orig_0457003", "type": "orig", "text": "【原】享和二年刊長谷寺藏本"}
{"id": null, "n": "0457004", "target": "#nkr_note_orig_0457004", "type": "orig", "text": "〔複熾盛光法〕－ィ【原】"}
{"id": null, "n": "0457005", "target": "#nkr_note_orig_0457005", "type": "orig", "text": "〔曩〕－ィ【原】"}
{"id": null, "n": "0457006", "target": "#nkr_note_orig_0457006", "type": "orig", "text": "蜜＝密ィ【原】"}
{"id": null, "n": "0457007", "target": "#nkr_note_orig_0457007", "type": "orig", "text": "山＝仙ィ【原】"}
{"id": null, "n": "0457008", "target": "#nkr_note_orig_0457008", "type": "orig", "text": "野＋（唵阿謨伽寫野）ィ【原】"}
{"id": null, "n": "0457009", "target": "#nkr_note_orig_0457009", "type": "orig", "text": "〔阿〕－ィ【原】"}
{"id": null, "n": "0457010", "target": "#nkr_note_orig_0457010", "type": "orig", "text": "囉二合嚩囉＝二合囉嚩ィ【原】"}
{"id": null, "n": "0457011", "target": "#nkr_note_orig_0457011", "type": "orig", "text": "泥＋（吃）ィ【原】"}
{"id": null, "n": "0457012", "target": "#nkr_note_orig_0457012", "type": "orig", "text": "作＝儞ィ【原】"}
{"id": null, "n": "0458001", "target": "#nkr_note_orig_0458001", "type": "orig", "text": "醫＝翳ィ【原】"}
{"id": null, "n": "0458002", "target": "#nkr_note_orig_0458002", "type": "orig", "text": "𠰘＝呬ィ【原】"}
{"id": null, "n": "0458003", "target": "#nkr_note_orig_0458003", "type": "orig", "text": "面＋（頭指）ヵ【原】"}
{"id": null, "n": "0458004", "target": "#nkr_note_orig_0458004", "type": "orig", "text": "娜＋（哩）ィ【原】"}
{"id": null, "n": "0458005", "target": "#nkr_note_orig_0458005", "type": "orig", "text": "𮙖＝蹙ィ【原】"}
{"id": null, "n": "0458006", "target": "#nkr_note_orig_0458006", "type": "orig", "text": "曰＝白ィ【原】"}
{"id": null, "n": "0458007", "target": "#nkr_note_orig_0458007", "type": "orig", "text": "刑＝刊ィ【原】"}
{"id": null, "n": "0458008", "target": "#nkr_note_orig_0458008", "type": "orig", "text": "小＝少ヵ【原】"}
{"id": null, "n": "0458009", "target": "#nkr_note_orig_0458009", "type": "orig", "text": "刊＝削ィ【原】"}
{"id": null, "n": "0458010", "target": "#nkr_note_orig_0458010", "type": "orig", "text": "〔北斗法〕－ィ【原】"}
{"id": null, "n": "0458011", "target": "#nkr_note_orig_0458011", "type": "orig", "text": "陵逼諸座不能＝不能陵逼諸座ヵ【原】"}
{"id": null, "n": "0458012", "target": "#nkr_note_orig_0458012", "type": "orig", "text": "并＝麁ィ【原】"}
{"id": null, "n": "0459001", "target": "#nkr_note_orig_0459001", "type": "orig", "text": "死＝屍ィ【原】"}
{"id": null, "n": "0459002", "target": "#nkr_note_orig_0459002", "type": "orig", "text": "（天災）＋即ィ【原】"}
{"id": null, "n": "0459003", "target": "#nkr_note_orig_0459003", "type": "orig", "text": "壇＝檀ィ【原】"}
