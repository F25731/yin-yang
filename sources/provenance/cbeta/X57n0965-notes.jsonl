{"id": null, "n": null, "target": null, "type": null, "text": "此二意即上第二句"}
{"id": null, "n": null, "target": null, "type": null, "text": "即上初三二句是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦即第四句是也"}
