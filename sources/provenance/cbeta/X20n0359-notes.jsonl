{"id": null, "n": "0340001", "target": "#nkr_note_mod_0340001", "type": "mod", "text": "已下九十一字惜哉為紙魚損焉後日應以他本訂之耳"}
{"id": null, "n": "0311001", "target": "#nkr_note_orig_0311001", "type": "orig", "text": "如譬等十字疑衍文"}
{"id": null, "n": "0311002", "target": "#nkr_note_orig_0311002", "type": "orig", "text": "依別等五字恐衍文"}
{"id": null, "n": "0314001", "target": "#nkr_note_orig_0314001", "type": "orig", "text": "致到義通"}
{"id": null, "n": "0316001", "target": "#nkr_note_orig_0316001", "type": "orig", "text": "疆疑彊"}
{"id": null, "n": "0320001", "target": "#nkr_note_orig_0320001", "type": "orig", "text": "裏疑裹"}
