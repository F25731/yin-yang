{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "非以譬擬法也"}
{"id": null, "n": null, "target": null, "type": null, "text": "盧對切"}
{"id": null, "n": null, "target": null, "type": null, "text": "音似"}
