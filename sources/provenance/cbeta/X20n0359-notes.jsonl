{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "平呼"}
{"id": null, "n": null, "target": null, "type": null, "text": "實相理體不同因果之宗也"}
{"id": null, "n": null, "target": null, "type": null, "text": "依體立宗也"}
{"id": null, "n": null, "target": null, "type": null, "text": "宗成證體，取者獲得也"}
{"id": null, "n": null, "target": null, "type": null, "text": "智與體冥，能起大用，即經用也"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "言禮使人\n成器也"}
