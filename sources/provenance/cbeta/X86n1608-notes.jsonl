{"id": null, "n": null, "target": null, "type": null, "text": "附"}
{"id": null, "n": null, "target": null, "type": null, "text": "佑釲念祖　佑鋅禦宼"}
{"id": null, "n": null, "target": null, "type": null, "text": "又旁出一人"}
{"id": null, "n": null, "target": null, "type": null, "text": "旁出"}
{"id": null, "n": null, "target": null, "type": null, "text": "台宗尚有阿難旁出末田地尊者"}
{"id": null, "n": null, "target": null, "type": null, "text": "台宗不承"}
{"id": null, "n": null, "target": null, "type": null, "text": "台宗稱為高祖論主龍樹尊者一相大禪師"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上即繫台宗所承西土二十四祖"}
{"id": null, "n": null, "target": null, "type": null, "text": "已下三祖台宗不承"}
{"id": null, "n": null, "target": null, "type": null, "text": "吳"}
{"id": null, "n": null, "target": null, "type": null, "text": "後趙"}
{"id": null, "n": null, "target": null, "type": null, "text": "是為淨土蓮宗十祖名號并贊附"}
{"id": null, "n": null, "target": null, "type": null, "text": "後魏"}
{"id": null, "n": null, "target": null, "type": null, "text": "是為教外別傳"}
{"id": null, "n": null, "target": null, "type": null, "text": "是為四教法性觀行宗。台宗十七祖名號附"}
{"id": null, "n": null, "target": null, "type": null, "text": "是為\n三乘法相顯理宗。慈恩三祖名號附"}
{"id": null, "n": null, "target": null, "type": null, "text": "是為行事防非止惡宗。律宗九祖名號附"}
{"id": null, "n": null, "target": null, "type": null, "text": "是為一念圓融，具德宗華嚴五祖名號附"}
{"id": null, "n": null, "target": null, "type": null, "text": "是為瑜珈秘密\n微玅宗。密宗五祖名號附"}
{"id": null, "n": null, "target": null, "type": null, "text": "禪宗六祖下一世"}
{"id": null, "n": null, "target": null, "type": null, "text": "禪宗六祖下一世"}
{"id": null, "n": null, "target": null, "type": null, "text": "禪宗六祖旁出"}
{"id": null, "n": null, "target": null, "type": null, "text": "禪宗五祖，旁出玉泉神秀下，嵩山普寂嗣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "南嶽下一世"}
{"id": null, "n": null, "target": null, "type": null, "text": "青原下一世"}
{"id": null, "n": null, "target": null, "type": null, "text": "禪宗\n六祖，旁出荷澤神會下，五臺無名嗣"}
{"id": null, "n": null, "target": null, "type": null, "text": "景德傳燈錄列青原下二世"}
{"id": null, "n": null, "target": null, "type": null, "text": "南嶽下二世，馬祖旁出。"}
{"id": null, "n": null, "target": null, "type": null, "text": "南嶽下三世，後出臨濟宗。"}
{"id": null, "n": null, "target": null, "type": null, "text": "南嶽下三世，溈仰宗。"}
{"id": null, "n": null, "target": null, "type": null, "text": "禪宗六祖旁出荷澤會下四世繫荊南道圓嗣"}
{"id": null, "n": null, "target": null, "type": null, "text": "南嶽下四世，臨濟宗。"}
{"id": null, "n": null, "target": null, "type": null, "text": "青原下四世，曹洞宗。"}
{"id": null, "n": null, "target": null, "type": null, "text": "青原下五世，曹洞宗。"}
{"id": null, "n": null, "target": null, "type": null, "text": "禪宗四祖旁出，牛頭法融下七\n世繫，徑山道欽嗣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "道悟下三世，後出雲門法眼宗。"}
{"id": null, "n": null, "target": null, "type": null, "text": "後漢韶州雲門山光奉院大慈雲匡真弘明禪師文偃贊附（道悟下四世，祖堂無像，不立傳。）"}
{"id": null, "n": null, "target": null, "type": null, "text": "後周（南唐）江寧清涼院淨慧玄覺大法眼大智藏大導師文益贊附（道悟下六世，祖堂無像，不立傳。）"}
{"id": null, "n": null, "target": null, "type": null, "text": "南嶽下八世，臨濟宗派。"}
{"id": null, "n": null, "target": null, "type": null, "text": "吳越"}
{"id": null, "n": null, "target": null, "type": null, "text": "禪宗道悟下八世，繫法眼文益下，天台德韶嗣"}
{"id": null, "n": null, "target": null, "type": null, "text": "南岳下十世　臨濟宗派，後分出楊岐，黃\n龍二支。"}
{"id": null, "n": null, "target": null, "type": null, "text": "道悟下八世　雲門宗雪竇重顯嗣"}
{"id": null, "n": null, "target": null, "type": null, "text": "道悟下八世，\n雲門宗開先善暹嗣"}
{"id": null, "n": null, "target": null, "type": null, "text": "南岳下十一世，臨濟宗，黃龍支。"}
{"id": null, "n": null, "target": null, "type": null, "text": "南岳下十一世，臨濟宗，楊岐支。"}
{"id": null, "n": null, "target": null, "type": null, "text": "南岳下十二世，臨濟宗楊岐嗣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "南岳下十三世　臨濟宗，楊岐孫，後出虎丘派。"}
{"id": null, "n": null, "target": null, "type": null, "text": "南岳下十九世　臨濟宗，\n虎丘派。"}
{"id": null, "n": null, "target": null, "type": null, "text": "南岳下二十世，臨濟宗，虎丘派。"}
{"id": null, "n": null, "target": null, "type": null, "text": "南岳下二十世　臨濟楊岐派，金牛真嗣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "南岳下二十一世，臨濟宗，虎丘派"}
{"id": null, "n": null, "target": null, "type": null, "text": "南岳下二十一世　臨濟虎丘派，雪巖欽旁出。"}
{"id": null, "n": null, "target": null, "type": null, "text": "禪宗，南岳下二十二世，　臨濟宗，虎\n\n丘派。"}
{"id": null, "n": null, "target": null, "type": null, "text": "南岳下二十二世，　臨濟宗，虎丘派，高峯妙旁出。"}
{"id": null, "n": null, "target": null, "type": null, "text": "南岳下二十二世　臨濟宗，虎丘派，雪巖\n祖欽旁出，鐵牛持定嗣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "南岳下二十三世，　臨濟宗，虎\n丘派"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣法未詳再考"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣法未詳再考"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣法未詳再考"}
{"id": null, "n": null, "target": null, "type": null, "text": "南岳下二十一世，\n臨濟宗楊岐派笑隱大訢嗣"}
{"id": null, "n": null, "target": null, "type": null, "text": "南岳下二\n十二世，　臨濟宗，楊岐派，無用寬下，如海真嗣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "南岳下二十二世，　臨濟宗，虎丘派，千巖元長旁出。"}
{"id": null, "n": null, "target": null, "type": null, "text": "附"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "芻尼，此名野鵲子，賢仲南藏中作眾。"}
{"id": null, "n": null, "target": null, "type": null, "text": "印度一年為一白"}
{"id": null, "n": null, "target": null, "type": null, "text": "勒那，梵語，華言鶴也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "昔止七祖，至是升祔三祖，稱為十祖。"}
{"id": null, "n": null, "target": null, "type": null, "text": "慧遠師道安"}
{"id": null, "n": null, "target": null, "type": null, "text": "善導云是彌陀化身"}
{"id": null, "n": null, "target": null, "type": null, "text": "承遠"}
{"id": null, "n": null, "target": null, "type": null, "text": "法照善導後身，師承遠，　傳見後。"}
{"id": null, "n": null, "target": null, "type": null, "text": "少康"}
{"id": null, "n": null, "target": null, "type": null, "text": "延壽　傳見後"}
{"id": null, "n": null, "target": null, "type": null, "text": "省常"}
{"id": null, "n": null, "target": null, "type": null, "text": "明本　傳見後"}
{"id": null, "n": null, "target": null, "type": null, "text": "𣑽琦"}
{"id": null, "n": null, "target": null, "type": null, "text": "袾宏　傳見後"}
{"id": null, "n": null, "target": null, "type": null, "text": "補"}
{"id": null, "n": null, "target": null, "type": null, "text": "慧文"}
{"id": null, "n": null, "target": null, "type": null, "text": "慧思"}
{"id": null, "n": null, "target": null, "type": null, "text": "智顗"}
{"id": null, "n": null, "target": null, "type": null, "text": "灌頂"}
{"id": null, "n": null, "target": null, "type": null, "text": "智威"}
{"id": null, "n": null, "target": null, "type": null, "text": "慧威"}
{"id": null, "n": null, "target": null, "type": null, "text": "玄朗"}
{"id": null, "n": null, "target": null, "type": null, "text": "湛然"}
{"id": null, "n": null, "target": null, "type": null, "text": "道𮟏"}
{"id": null, "n": null, "target": null, "type": null, "text": "廣修"}
{"id": null, "n": null, "target": null, "type": null, "text": "物外"}
{"id": null, "n": null, "target": null, "type": null, "text": "元琇"}
{"id": null, "n": null, "target": null, "type": null, "text": "清竦"}
{"id": null, "n": null, "target": null, "type": null, "text": "羲寂"}
{"id": null, "n": null, "target": null, "type": null, "text": "義通"}
{"id": null, "n": null, "target": null, "type": null, "text": "知禮傳見後"}
{"id": null, "n": null, "target": null, "type": null, "text": "傳見後"}
{"id": null, "n": null, "target": null, "type": null, "text": "法順"}
{"id": null, "n": null, "target": null, "type": null, "text": "智儼"}
{"id": null, "n": null, "target": null, "type": null, "text": "法藏"}
{"id": null, "n": null, "target": null, "type": null, "text": "澄觀　傳見後"}
{"id": null, "n": null, "target": null, "type": null, "text": "宗密　傳見後"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲棲以西天馬鳴大師為初祖，龍樹大師為二祖，後祀帝心，至圭峰稱七祖。"}
{"id": null, "n": null, "target": null, "type": null, "text": "傳見後"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣法雪峰"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣法羅漢桂琛琛嗣玄沙師備備嗣雪峰"}
{"id": null, "n": null, "target": null, "type": null, "text": "補"}
{"id": null, "n": null, "target": null, "type": null, "text": "補"}
{"id": null, "n": null, "target": null, "type": null, "text": "補"}
{"id": null, "n": null, "target": null, "type": null, "text": "補"}
{"id": null, "n": null, "target": null, "type": null, "text": "補"}
{"id": null, "n": null, "target": null, "type": null, "text": "補"}
{"id": null, "n": null, "target": null, "type": null, "text": "補"}
{"id": null, "n": null, "target": null, "type": null, "text": "補"}
{"id": null, "n": null, "target": null, "type": null, "text": "補"}
{"id": null, "n": null, "target": null, "type": null, "text": "補"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "錢應金註：先生法名廣瀇，字明水"}
{"id": null, "n": null, "target": null, "type": null, "text": "錢應金註：先生爾時諱斗光，後更名\n道素。"}
{"id": null, "n": null, "target": null, "type": null, "text": "錢應金註：先生爾時諱斗光，後更名道素。"}
{"id": null, "n": null, "target": null, "type": null, "text": "錢應\n金註：高先生諱道素"}
{"id": null, "n": null, "target": null, "type": null, "text": "附"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X26n0532_p0767c03"}
