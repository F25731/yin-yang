{"id": null, "n": "0155005", "target": "#nkr_note_orig_0155005", "type": "orig", "text": "譯＋（師名）【明】"}
{"id": null, "n": "0155006", "target": "#nkr_note_orig_0155006", "type": "orig", "text": "〔俱〕－【明】【宮】"}
{"id": null, "n": "0155007", "target": "#nkr_note_orig_0155007", "type": "orig", "text": "〔花〕－【宮】"}
{"id": null, "n": "0155008", "target": "#nkr_note_orig_0155008", "type": "orig", "text": "繖＝傘【三】【宮】＊"}
{"id": null, "n": "0155009", "target": "#nkr_note_orig_0155009", "type": "orig", "text": "持＝將【宮】"}
{"id": null, "n": "0155010", "target": "#nkr_note_orig_0155010", "type": "orig", "text": "（持）＋頭【宮】"}
{"id": null, "n": "0155011", "target": "#nkr_note_orig_0155011", "type": "orig", "text": "〔叉手〕－【三】【宮】"}
{"id": null, "n": "0155012", "target": "#nkr_note_orig_0155012", "type": "orig", "text": "菩薩何因緣＝何因緣菩薩【三】【宮】"}
{"id": null, "n": "0155013", "target": "#nkr_note_orig_0155013", "type": "orig", "text": "〔得端…因緣〕二十字－【三】【宮】"}
{"id": null, "n": "0155014", "target": "#nkr_note_orig_0155014", "type": "orig", "text": "（能）＋知【三】【宮】"}
{"id": null, "n": "0155015", "target": "#nkr_note_orig_0155015", "type": "orig", "text": "婬妷＝婬泆【元】，淫泆【明】"}
{"id": null, "n": "0155016", "target": "#nkr_note_orig_0155016", "type": "orig", "text": "使＝快【宮】"}
{"id": null, "n": "0155017", "target": "#nkr_note_orig_0155017", "type": "orig", "text": "怠＝詒【元】【明】"}
{"id": null, "n": "0155018", "target": "#nkr_note_orig_0155018", "type": "orig", "text": "杖＝仗【明】"}
{"id": null, "n": "0155019", "target": "#nkr_note_orig_0155019", "type": "orig", "text": "惜餘＝𩜶【宮】"}
{"id": null, "n": "0155020", "target": "#nkr_note_orig_0155020", "type": "orig", "text": "（尊）＋貴【三】【宮】"}
{"id": null, "n": "0155021", "target": "#nkr_note_orig_0155021", "type": "orig", "text": "〔得〕－【宮】"}
{"id": null, "n": "0155022", "target": "#nkr_note_orig_0155022", "type": "orig", "text": "〔象〕－【三】"}
{"id": null, "n": "0155023", "target": "#nkr_note_orig_0155023", "type": "orig", "text": "便＝使【宮】"}
{"id": null, "n": "0155024", "target": "#nkr_note_orig_0155024", "type": "orig", "text": "預＝豫【三】【宮】＊"}
{"id": null, "n": "0155025", "target": "#nkr_note_orig_0155025", "type": "orig", "text": "緣預知＝絕治【宮】"}
{"id": null, "n": "0155026", "target": "#nkr_note_orig_0155026", "type": "orig", "text": "〔後〕－【宮】"}
{"id": null, "n": "0156001", "target": "#nkr_note_orig_0156001", "type": "orig", "text": "〔國〕－【宮】"}
{"id": null, "n": "0156002", "target": "#nkr_note_orig_0156002", "type": "orig", "text": "〔變化…是經〕十八字－【宮】"}
{"id": null, "n": "0156003", "target": "#nkr_note_orig_0156003", "type": "orig", "text": "〔佛說〕－【元】【明】"}
