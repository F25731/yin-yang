{"id": null, "n": "0155002", "target": "#nkr_note_mod_0155002", "type": "mod", "text": "佛說【大】，〔－〕【元】【明】"}
{"id": null, "n": "0155003", "target": "#nkr_note_mod_0155003", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0155004", "target": "#nkr_note_mod_0155004", "type": "mod", "text": "云【大】，云安公錄中【宋】【元】【明】【宮】"}
{"id": null, "n": "0155005", "target": "#nkr_note_mod_0155005", "type": "mod", "text": "譯【大】，譯師名【明】"}
{"id": null, "n": "0155006", "target": "#nkr_note_mod_0155006", "type": "mod", "text": "俱【大】，〔－〕【明】【宮】"}
{"id": null, "n": "0155007", "target": "#nkr_note_mod_0155007", "type": "mod", "text": "花【大】，〔－〕【宮】"}
{"id": null, "n": "0155008", "target": "#nkr_note_mod_0155008", "type": "mod", "text": "繖【大】＊，傘【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0155009", "target": "#nkr_note_mod_0155009", "type": "mod", "text": "持【大】，將【宮】"}
{"id": null, "n": "0155010", "target": "#nkr_note_mod_0155010", "type": "mod", "text": "頭【大】，持頭【宮】"}
{"id": null, "n": "0155011", "target": "#nkr_note_mod_0155011", "type": "mod", "text": "叉手【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0155012", "target": "#nkr_note_mod_0155012", "type": "mod", "text": "菩薩何因緣【大】，何因緣菩薩【宋】【元】【明】【宮】"}
{"id": null, "n": "0155013", "target": "#nkr_note_mod_0155013", "type": "mod", "text": "（得端…因緣）二十字【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0155014", "target": "#nkr_note_mod_0155014", "type": "mod", "text": "知【大】，能知【宋】【元】【明】【宮】"}
{"id": null, "n": "0155015", "target": "#nkr_note_mod_0155015", "type": "mod", "text": "婬妷【大】，婬泆【元】，淫泆【明】"}
{"id": null, "n": "0155016", "target": "#nkr_note_mod_0155016", "type": "mod", "text": "使【大】，快【宮】"}
{"id": null, "n": "0155017", "target": "#nkr_note_mod_0155017", "type": "mod", "text": "怠【大】，詒【元】【明】"}
{"id": null, "n": "0155018", "target": "#nkr_note_mod_0155018", "type": "mod", "text": "杖【大】，仗【明】"}
{"id": null, "n": "0155019", "target": "#nkr_note_mod_0155019", "type": "mod", "text": "惜餘【大】，𩜶【宮】"}
{"id": null, "n": "0155020", "target": "#nkr_note_mod_0155020", "type": "mod", "text": "貴【大】，尊貴【宋】【元】【明】【宮】"}
{"id": null, "n": "0155021", "target": "#nkr_note_mod_0155021", "type": "mod", "text": "得【大】，〔－〕【宮】"}
{"id": null, "n": "0155022", "target": "#nkr_note_mod_0155022", "type": "mod", "text": "象【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0155023", "target": "#nkr_note_mod_0155023", "type": "mod", "text": "便【大】，使【宮】"}
{"id": null, "n": "0155024", "target": "#nkr_note_mod_0155024", "type": "mod", "text": "預【大】＊，豫【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0155025", "target": "#nkr_note_mod_0155025", "type": "mod", "text": "緣預知【大】，絕治【宮】"}
{"id": null, "n": "0155026", "target": "#nkr_note_mod_0155026", "type": "mod", "text": "後【大】，〔－〕【宮】"}
{"id": null, "n": "0156001", "target": "#nkr_note_mod_0156001", "type": "mod", "text": "國【大】，〔－〕【宮】"}
{"id": null, "n": "0156002", "target": "#nkr_note_mod_0156002", "type": "mod", "text": "（變化…是經）十八字【大】，〔－〕【宮】"}
{"id": null, "n": "0156003", "target": "#nkr_note_mod_0156003", "type": "mod", "text": "佛說【大】，〔－〕【元】【明】"}
