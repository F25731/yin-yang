{"id": null, "n": null, "target": null, "type": null, "text": "四"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "善住天子也"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "五"}
{"id": null, "n": null, "target": null, "type": null, "text": "五藏曼荼羅是五部法身"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿字作地觀、金剛座觀"}
{"id": null, "n": null, "target": null, "type": null, "text": "鑁字作水觀、蓮華觀"}
{"id": null, "n": null, "target": null, "type": null, "text": "覽字作日觀"}
{"id": null, "n": null, "target": null, "type": null, "text": "唅字作月觀"}
{"id": null, "n": null, "target": null, "type": null, "text": "欠字\n作空觀"}
{"id": null, "n": null, "target": null, "type": null, "text": "此是下品悉地真言"}
{"id": null, "n": null, "target": null, "type": null, "text": "此是中品悉地真言"}
{"id": null, "n": null, "target": null, "type": null, "text": "是上品悉地真言也。以前五三印真言順一遍逆一遍，次順旋轉四遍，次逆\n旋轉四遍，此即利益一切眾生皆以悉地義也"}
{"id": null, "n": null, "target": null, "type": null, "text": "以後雜要文也"}
{"id": null, "n": null, "target": null, "type": null, "text": "五十四歲"}
{"id": null, "n": null, "target": null, "type": null, "text": "是三種悉地法"}
{"id": null, "n": null, "target": null, "type": null, "text": "以後雜要文也"}
{"id": null, "n": "0915001", "target": "#nkr_note_mod_0915001", "type": "mod", "text": "晏【大】，安【校異-原】"}
{"id": null, "n": "0915002", "target": "#nkr_note_mod_0915002", "type": "mod", "text": "疾【大】，疫【校異-原】"}
{"id": null, "n": "0915003", "target": "#nkr_note_mod_0915003", "type": "mod", "text": "書【大】，畫【校異-原】"}
{"id": null, "n": "0915004", "target": "#nkr_note_mod_0915004", "type": "mod", "text": "降【大】，障【校異-原】"}
{"id": null, "n": "0915005", "target": "#nkr_note_mod_0915005", "type": "mod", "text": "𮓔【大】，藍【校異-原】"}
{"id": null, "n": "0915006", "target": "#nkr_note_mod_0915006", "type": "mod", "text": "唅【大】＊，𤙖【校異-原】＊"}
{"id": null, "n": "0915007", "target": "#nkr_note_mod_0915007", "type": "mod", "text": "因【大】，自【原】"}
{"id": null, "n": "0915008", "target": "#nkr_note_mod_0915008", "type": "mod", "text": "覽【大】＊，藍【校異-原】＊"}
{"id": null, "n": "0915009", "target": "#nkr_note_mod_0915009", "type": "mod", "text": "言＋（也）【原】"}
{"id": null, "n": "0915010", "target": "#nkr_note_mod_0915010", "type": "mod", "text": "此【大】，〔－〕【校異-原】"}
{"id": null, "n": "0915011", "target": "#nkr_note_mod_0915011", "type": "mod", "text": "五三【大】，三五【校異-原】"}
{"id": null, "n": "0915012", "target": "#nkr_note_mod_0915012", "type": "mod", "text": "以悉地【大】，悉成佛【校異-原】"}
{"id": null, "n": "0915013", "target": "#nkr_note_mod_0915013", "type": "mod", "text": "言【大】，〔－〕【校異-原】"}
{"id": null, "n": "0915014", "target": "#nkr_note_mod_0915014", "type": "mod", "text": "禮【大】，〔－〕【校異-原】"}
{"id": null, "n": "0915015", "target": "#nkr_note_mod_0915015", "type": "mod", "text": "咸【大】，成【校異-原】"}
{"id": null, "n": "0915016", "target": "#nkr_note_mod_0915016", "type": "mod", "text": "剛【大】，剎【校異-原】"}
{"id": null, "n": "0915017", "target": "#nkr_note_mod_0915017", "type": "mod", "text": "儀【大】，義【校異-原】"}
{"id": null, "n": "0915018", "target": "#nkr_note_mod_0915018", "type": "mod", "text": "以後雜要文也【大】，〔－〕【校異-原】"}
{"id": null, "n": "0914003", "target": "#nkr_note_orig_0914003", "type": "orig", "text": "【原】享和元年刊長谷寺藏本"}
{"id": null, "n": "0914004", "target": "#nkr_note_orig_0914004", "type": "orig", "text": "原本冠註曰此下亂雜依三種悉地軌今以符號一乃至五示其亂脫"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": null, "target": null, "type": null, "text": "五"}
{"id": null, "n": "0915001", "target": "#nkr_note_orig_0915001", "type": "orig", "text": "晏＝安ィ【原】"}
{"id": null, "n": "0915002", "target": "#nkr_note_orig_0915002", "type": "orig", "text": "疾＝疫ィ【原】"}
{"id": null, "n": "0915003", "target": "#nkr_note_orig_0915003", "type": "orig", "text": "書＝畫ィ【原】"}
{"id": null, "n": "0915004", "target": "#nkr_note_orig_0915004", "type": "orig", "text": "降＝障ィ【原】"}
{"id": null, "n": "0915005", "target": "#nkr_note_orig_0915005", "type": "orig", "text": "𮓔＝藍ィ【原】"}
{"id": null, "n": "0915006", "target": "#nkr_note_orig_0915006", "type": "orig", "text": "唅＝𤙖ィ【原】＊"}
{"id": null, "n": "0915007", "target": "#nkr_note_orig_0915007", "type": "orig", "text": "因＝自【原】"}
{"id": null, "n": "0915008", "target": "#nkr_note_orig_0915008", "type": "orig", "text": "覽＝藍ィ【原】＊"}
{"id": null, "n": "0915009", "target": "#nkr_note_orig_0915009", "type": "orig", "text": "言＋（也）【原】"}
{"id": null, "n": "0915010", "target": "#nkr_note_orig_0915010", "type": "orig", "text": "〔此〕ィ－【原】"}
{"id": null, "n": "0915011", "target": "#nkr_note_orig_0915011", "type": "orig", "text": "五三＝三五ィ【原】"}
{"id": null, "n": "0915012", "target": "#nkr_note_orig_0915012", "type": "orig", "text": "以悉地＝悉成佛ィ【原】"}
{"id": null, "n": "0915013", "target": "#nkr_note_orig_0915013", "type": "orig", "text": "〔言〕ィ－【原】"}
{"id": null, "n": "0915014", "target": "#nkr_note_orig_0915014", "type": "orig", "text": "〔禮〕ィ－【原】"}
{"id": null, "n": "0915015", "target": "#nkr_note_orig_0915015", "type": "orig", "text": "咸＝成ィ【原】"}
{"id": null, "n": "0915016", "target": "#nkr_note_orig_0915016", "type": "orig", "text": "剛＝剎ィ【原】"}
{"id": null, "n": "0915017", "target": "#nkr_note_orig_0915017", "type": "orig", "text": "儀＝義ィ【原】"}
{"id": null, "n": "0915018", "target": "#nkr_note_orig_0915018", "type": "orig", "text": "〔以後雜要文也〕ィ－【原】"}
{"id": null, "n": "0915019", "target": "#nkr_note_orig_0915019", "type": "orig", "text": "原本奧書曰，再校本庇云，延寶二年甲寅十二月十日二更之後，於河內小西見如晦菴書寫一校了，正本誤字多之，後日得善本之時，可再校耳，金剛乘資淨嚴三十六天明二年壬寅十一月十三日之夜三更，以淨嚴大和尚本而書騰之了，寶林末葉宜雄一校加筆訖，享和癸亥年四月十三日，慈順文政三年庚辰仲秋二十五日以右傳寫之本得下總千葉妙見寺秀陽闍梨許，校之了，龍肝文政四年辛巳九月八日，以板敷日曜寺之本再校，尚寫續件三種已下五紙畢，龍肝"}
{"id": null, "n": "0915b0701", "target": "#nkr_note_add_0915b0701", "type": "add", "text": "珍【CB】，殄【大】"}
