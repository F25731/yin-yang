{"id": null, "n": "0054001", "target": "#nkr_note_orig_0054001", "type": "orig", "text": "「縱」，底本作「從」，據文意改。"}
{"id": null, "n": "0054002", "target": "#nkr_note_orig_0054002", "type": "orig", "text": "「忘」，底本作「妄」，據文意改。"}
{"id": null, "n": "0054003", "target": "#nkr_note_orig_0054003", "type": "orig", "text": "「因」，底本作「自」，據文意改。"}
{"id": null, "n": "0054004", "target": "#nkr_note_orig_0054004", "type": "orig", "text": "北新1254號至此止，以下為北新1255號。"}
{"id": null, "n": "0054005", "target": "#nkr_note_orig_0054005", "type": "orig", "text": "「惑」，底本作「或」，據文意改。"}
{"id": null, "n": "0055001", "target": "#nkr_note_orig_0055001", "type": "orig", "text": "「枷」，或為「假」之誤。"}
{"id": null, "n": "0055002", "target": "#nkr_note_orig_0055002", "type": "orig", "text": "「盡」，疑或為「晝」。"}
{"id": null, "n": "0055003", "target": "#nkr_note_orig_0055003", "type": "orig", "text": "「縱」，底本作「從」，據文意改。"}
{"id": null, "n": "0056001", "target": "#nkr_note_orig_0056001", "type": "orig", "text": "「鬥」，底本作「關」，據文意改。"}
{"id": null, "n": "0056002", "target": "#nkr_note_orig_0056002", "type": "orig", "text": "「認」，疑或為「忍」。"}
{"id": null, "n": "0056003", "target": "#nkr_note_orig_0056003", "type": "orig", "text": "「祥」，底本作「詳」，據文意改。"}
{"id": null, "n": "0057001", "target": "#nkr_note_orig_0057001", "type": "orig", "text": "「不」，底本無，據文意補。"}
{"id": null, "n": "0057002", "target": "#nkr_note_orig_0057002", "type": "orig", "text": "底本此處原空一字。"}
{"id": null, "n": "0057003", "target": "#nkr_note_orig_0057003", "type": "orig", "text": "「原」，底本作「元」，據文意改。"}
{"id": null, "n": "0057004", "target": "#nkr_note_orig_0057004", "type": "orig", "text": "「原」，底本作「元」，據文意改。"}
{"id": null, "n": "0057005", "target": "#nkr_note_orig_0057005", "type": "orig", "text": "「愚」，底本無，據文意補。"}
{"id": null, "n": "0058001", "target": "#nkr_note_orig_0058001", "type": "orig", "text": "「詩」，疑或為「侍」之誤。"}
{"id": null, "n": "0058002", "target": "#nkr_note_orig_0058002", "type": "orig", "text": "「相」，底本殘，據文意補。"}
{"id": null, "n": "0058003", "target": "#nkr_note_orig_0058003", "type": "orig", "text": "「不」，底本殘，據文意補。"}
{"id": null, "n": "0058004", "target": "#nkr_note_orig_0058004", "type": "orig", "text": "「拴」，底本殘，據文意補。"}
{"id": null, "n": "0058005", "target": "#nkr_note_orig_0058005", "type": "orig", "text": "「沙」，底本殘，據文意補。"}
