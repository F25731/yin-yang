{"id": null, "n": "0202030", "target": "#nkr_note_mod_0202030", "type": "mod", "text": "麼【大】，摩【甲】"}
{"id": null, "n": "0202031", "target": "#nkr_note_mod_0202031", "type": "mod", "text": "㘄【大】＊，楞【甲】＊"}
{"id": null, "n": "0202032", "target": "#nkr_note_mod_0202032", "type": "mod", "text": "二合【大】，〔－〕【甲】"}
