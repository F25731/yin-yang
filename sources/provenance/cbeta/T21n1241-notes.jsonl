{"id": null, "n": "0202024", "target": "#nkr_note_mod_0202024", "type": "mod", "text": "囉【大】＊，羅【甲】＊"}
{"id": null, "n": "0202025", "target": "#nkr_note_mod_0202025", "type": "mod", "text": "合【大】＊，二合【甲】＊"}
{"id": null, "n": "0202026", "target": "#nkr_note_mod_0202026", "type": "mod", "text": "日【大】，嚩日【甲】"}
{"id": null, "n": "0202027", "target": "#nkr_note_mod_0202027", "type": "mod", "text": "娑【大】，沙【甲】"}
