{"id": null, "n": "0202023", "target": "#nkr_note_orig_0202023", "type": "orig", "text": "【原】三十帖策子第二十六，【甲】黃檗版淨嚴等加筆本"}
{"id": null, "n": "0202024", "target": "#nkr_note_orig_0202024", "type": "orig", "text": "囉＝羅【甲】＊"}
{"id": null, "n": "0202025", "target": "#nkr_note_orig_0202025", "type": "orig", "text": "（二）＋合【甲】＊"}
{"id": null, "n": "0202026", "target": "#nkr_note_orig_0202026", "type": "orig", "text": "（嚩）＋日【甲】"}
{"id": null, "n": "0202027", "target": "#nkr_note_orig_0202027", "type": "orig", "text": "娑＝沙【甲】"}
{"id": null, "n": "0202028", "target": "#nkr_note_orig_0202028", "type": "orig", "text": "哦＝誐【甲】"}
{"id": null, "n": "0202029", "target": "#nkr_note_orig_0202029", "type": "orig", "text": "楞＝㘄【甲】＊"}
{"id": null, "n": "0202030", "target": "#nkr_note_orig_0202030", "type": "orig", "text": "麼＝摩【甲】"}
{"id": null, "n": "0202031", "target": "#nkr_note_orig_0202031", "type": "orig", "text": "㘄＝楞【甲】＊"}
{"id": null, "n": "0202032", "target": "#nkr_note_orig_0202032", "type": "orig", "text": "〔二合〕－【甲】"}
{"id": null, "n": "0203001", "target": "#nkr_note_orig_0203001", "type": "orig", "text": "能＋（二合）夾註【甲】"}
{"id": null, "n": "0203002", "target": "#nkr_note_orig_0203002", "type": "orig", "text": "耶＝也【甲】"}
{"id": null, "n": "0203003", "target": "#nkr_note_orig_0203003", "type": "orig", "text": "娘＝孃【甲】"}
{"id": null, "n": "0203004", "target": "#nkr_note_orig_0203004", "type": "orig", "text": "黨＝𭍀【甲】"}
