{"id": null, "n": null, "target": null, "type": null, "text": "聖位與祈晴疏\n同，至"}
{"id": null, "n": null, "target": null, "type": null, "text": "啟建祈雨道場文疏"}
{"id": null, "n": null, "target": null, "type": null, "text": "聖位與前疏同，至"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "聖位與前疏同，至"}
