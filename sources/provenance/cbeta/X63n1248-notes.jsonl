{"id": null, "n": null, "target": null, "type": null, "text": "或不兼帶神祗，則云："}
{"id": null, "n": null, "target": null, "type": null, "text": "中或兼具神祗，則云"}
{"id": null, "n": null, "target": null, "type": null, "text": "則\n曰"}
