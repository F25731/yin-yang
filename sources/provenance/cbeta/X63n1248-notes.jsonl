{"id": null, "n": null, "target": null, "type": null, "text": "前粘土僧口詞一紙"}
{"id": null, "n": null, "target": null, "type": null, "text": "係唱衣收到"}
{"id": null, "n": null, "target": null, "type": null, "text": "係亡僧衣鉢，內見官分"}
{"id": null, "n": null, "target": null, "type": null, "text": "係照叢林抽分，三分支一行"}
{"id": null, "n": null, "target": null, "type": null, "text": "係就常住回買龕子一具支了"}
{"id": null, "n": null, "target": null, "type": null, "text": "係就常住回紙剪幡花并油燭供養支了"}
{"id": null, "n": null, "target": null, "type": null, "text": "係菴主下火佛事支了"}
{"id": null, "n": null, "target": null, "type": null, "text": "係山頭念誦佛事支了"}
{"id": null, "n": null, "target": null, "type": null, "text": "係首座起龕佛事支了"}
{"id": null, "n": null, "target": null, "type": null, "text": "係菴主、副菴、知庫、僉單、把悵支了"}
{"id": null, "n": null, "target": null, "type": null, "text": "係宿夜件靈湯果點心支了"}
{"id": null, "n": null, "target": null, "type": null, "text": "係堂司打磬支了"}
{"id": null, "n": null, "target": null, "type": null, "text": "係行者伴靈支了"}
{"id": null, "n": null, "target": null, "type": null, "text": "係菴主、首座主喪支了"}
{"id": null, "n": null, "target": null, "type": null, "text": "係擡龕、化龕心力支了"}
{"id": null, "n": null, "target": null, "type": null, "text": "係厨下飯頭心力支了"}
{"id": null, "n": null, "target": null, "type": null, "text": "係就公界回祭一筵支了"}
{"id": null, "n": null, "target": null, "type": null, "text": "係浴亡心力支了"}
{"id": null, "n": null, "target": null, "type": null, "text": "係唱衣提衣心力支了"}
{"id": null, "n": null, "target": null, "type": null, "text": "係就常住回物設供支了"}
{"id": null, "n": null, "target": null, "type": null, "text": "係本菴僧道共三十人，每人諷經錢，係分半上項支了"}
{"id": null, "n": null, "target": null, "type": null, "text": "幾佰幾捨幾貫幾佰文"}
