{"id": null, "n": "0917005", "target": "#nkr_note_mod_0917005", "type": "mod", "text": "人名【大】，〔－〕【宋】【元】"}
{"id": null, "n": "0917006", "target": "#nkr_note_mod_0917006", "type": "mod", "text": "附【大】，〔－〕【元】"}
{"id": null, "n": "0917007", "target": "#nkr_note_mod_0917007", "type": "mod", "text": "身【大】＊，身是【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0917008", "target": "#nkr_note_mod_0917008", "type": "mod", "text": "謂【大】，請【宋】【元】【明】"}
{"id": null, "n": "0917009", "target": "#nkr_note_mod_0917009", "type": "mod", "text": "頭【大】，頗【宋】【元】【明】"}
{"id": null, "n": "0917010", "target": "#nkr_note_mod_0917010", "type": "mod", "text": "罵【大】，默【明】"}
{"id": null, "n": "0917011", "target": "#nkr_note_mod_0917011", "type": "mod", "text": "汗【大】，汙【元】【明】"}
{"id": null, "n": "0917012", "target": "#nkr_note_mod_0917012", "type": "mod", "text": "之【大】，人【宋】【元】【明】"}
{"id": null, "n": "0918001", "target": "#nkr_note_mod_0918001", "type": "mod", "text": "姓【大】＊，族【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0918002", "target": "#nkr_note_mod_0918002", "type": "mod", "text": "是【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0918003", "target": "#nkr_note_mod_0918003", "type": "mod", "text": "氂【大】＊，猫【宋】【元】＊"}
{"id": null, "n": "0918004", "target": "#nkr_note_mod_0918004", "type": "mod", "text": "漆【大】＊，棘【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0917005", "target": "#nkr_note_orig_0917005", "type": "orig", "text": "〔人名〕－【宋】【元】"}
{"id": null, "n": "0917006", "target": "#nkr_note_orig_0917006", "type": "orig", "text": "〔附〕－【元】"}
{"id": null, "n": "0917007", "target": "#nkr_note_orig_0917007", "type": "orig", "text": "身＋（是）【三】＊"}
{"id": null, "n": "0917008", "target": "#nkr_note_orig_0917008", "type": "orig", "text": "謂＝請【三】"}
{"id": null, "n": "0917009", "target": "#nkr_note_orig_0917009", "type": "orig", "text": "頭＝頗【三】"}
{"id": null, "n": "0917010", "target": "#nkr_note_orig_0917010", "type": "orig", "text": "罵＝默【明】"}
{"id": null, "n": "0917011", "target": "#nkr_note_orig_0917011", "type": "orig", "text": "汗＝汙【元】【明】"}
{"id": null, "n": "0917012", "target": "#nkr_note_orig_0917012", "type": "orig", "text": "之＝人【三】"}
{"id": null, "n": "0918001", "target": "#nkr_note_orig_0918001", "type": "orig", "text": "姓＝族【三】＊"}
{"id": null, "n": "0918002", "target": "#nkr_note_orig_0918002", "type": "orig", "text": "〔是〕－【三】＊"}
{"id": null, "n": "0918003", "target": "#nkr_note_orig_0918003", "type": "orig", "text": "氂＝猫【宋】【元】＊"}
{"id": null, "n": "0918004", "target": "#nkr_note_orig_0918004", "type": "orig", "text": "漆＝棘【三】＊"}
{"id": null, "n": "0917b2001", "target": "#nkr_note_add_0917b2001", "type": "add", "text": "CBETA 按：參考《中阿含．箭喻經》（T01n0026_p0804a28）對應經文，此處「無有命終」對應「亦非終亦非不終」，故此處「無有」，參考對應經文及上下文，或可理解作「非有此非無此」。"}
{"id": null, "n": "0917b2601", "target": "#nkr_note_add_0917b2601", "type": "add", "text": "CBETA 按：參考《中阿含．箭喻經》（T01n0026_p0804a28）對應經文，「無有命終」指「亦非終亦非不終」，故此處「無有」參考對應經文及上下文，或可理解作「非有此非無此」。"}
