{"id": null, "n": "0829002", "target": "#nkr_note_mod_0829002", "type": "mod", "text": "耶【大】下同，邪【宋】【宮】下同"}
{"id": null, "n": "0829003", "target": "#nkr_note_mod_0829003", "type": "mod", "text": "道【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0829004", "target": "#nkr_note_mod_0829004", "type": "mod", "text": "竊【大】，實【宋】【元】【明】【宮】"}
{"id": null, "n": "0829005", "target": "#nkr_note_mod_0829005", "type": "mod", "text": "更【大】，便【明】"}
{"id": null, "n": "0829006", "target": "#nkr_note_mod_0829006", "type": "mod", "text": "擊【大】，牽【宮】"}
{"id": null, "n": "0829007", "target": "#nkr_note_mod_0829007", "type": "mod", "text": "破【大】，拍【宋】【元】【明】【宮】"}
{"id": null, "n": "0829008", "target": "#nkr_note_mod_0829008", "type": "mod", "text": "移【大】，拔【宋】【元】【明】【宮】"}
{"id": null, "n": "0829009", "target": "#nkr_note_mod_0829009", "type": "mod", "text": "深【大】，探【宋】【元】【明】【宮】"}
{"id": null, "n": "0829010", "target": "#nkr_note_mod_0829010", "type": "mod", "text": "沃【大】，𱦗【宮】"}
{"id": null, "n": "0829011", "target": "#nkr_note_mod_0829011", "type": "mod", "text": "咤【大】，吒【宮】"}
{"id": null, "n": "0829012", "target": "#nkr_note_mod_0829012", "type": "mod", "text": "汝【大】＊，若【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0829002", "target": "#nkr_note_orig_0829002", "type": "orig", "text": "耶＝邪【宋】【宮】下同"}
