{"id": null, "n": "0879002", "target": "#nkr_note_mod_0879002", "type": "mod", "text": "中印度【大】，天竺【宋】【元】【明】"}
{"id": null, "n": "0879003", "target": "#nkr_note_mod_0879003", "type": "mod", "text": "穬【大】，󰎣【明】"}
{"id": null, "n": "0879004", "target": "#nkr_note_mod_0879004", "type": "mod", "text": "往【大】，在【宋】【元】"}
{"id": null, "n": "0879005", "target": "#nkr_note_mod_0879005", "type": "mod", "text": "鉢【大】＊，𥁊【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0879006", "target": "#nkr_note_mod_0879006", "type": "mod", "text": "大施【大】，大施以八十四千金𥁊滿中碎金彼如是行大施以八十四千銀𥁊滿中碎銀彼如是行大施【宋】【元】【明】"}
{"id": null, "n": "0879007", "target": "#nkr_note_mod_0879007", "type": "mod", "text": "珓珞【大】，交露【宋】【元】【明】"}
{"id": null, "n": "0879008", "target": "#nkr_note_mod_0879008", "type": "mod", "text": "𤛓【大】＊，搆【宋】＊"}
{"id": null, "n": "0879009", "target": "#nkr_note_mod_0879009", "type": "mod", "text": "珓珞【大】，交絡【宋】【元】【明】"}
{"id": null, "n": "0879010", "target": "#nkr_note_mod_0879010", "type": "mod", "text": "人【大】，人謂【宋】【元】【明】"}
{"id": null, "n": "0879011", "target": "#nkr_note_mod_0879011", "type": "mod", "text": "以【大】，已【宋】【元】【明】"}
{"id": null, "n": "0879012", "target": "#nkr_note_mod_0879012", "type": "mod", "text": "耶【大】，邪【宋】【元】【明】"}
{"id": null, "n": "0879002", "target": "#nkr_note_orig_0879002", "type": "orig", "text": "中印度＝天竺【三】"}
{"id": null, "n": "0879003", "target": "#nkr_note_orig_0879003", "type": "orig", "text": "櫎＝󰎣【明】"}
{"id": null, "n": "0879004", "target": "#nkr_note_orig_0879004", "type": "orig", "text": "往＝在【宋】【元】"}
{"id": null, "n": "0879005", "target": "#nkr_note_orig_0879005", "type": "orig", "text": "鉢＝𥁊【三】＊"}
{"id": null, "n": "0879006", "target": "#nkr_note_orig_0879006", "type": "orig", "text": "大施＋（以八十四千金𥁊滿中碎金彼如是行大施以八十四千銀𥁊滿中碎銀彼如是行大施）三十四字【三】"}
{"id": null, "n": "0879007", "target": "#nkr_note_orig_0879007", "type": "orig", "text": "珓珞＝交露【三】"}
{"id": null, "n": "0879008", "target": "#nkr_note_orig_0879008", "type": "orig", "text": "𤛓＝搆【宋】＊"}
{"id": null, "n": "0879009", "target": "#nkr_note_orig_0879009", "type": "orig", "text": "珓珞＝交絡【三】"}
{"id": null, "n": "0879010", "target": "#nkr_note_orig_0879010", "type": "orig", "text": "人＋（謂）【三】"}
{"id": null, "n": "0879011", "target": "#nkr_note_orig_0879011", "type": "orig", "text": "以＝已【三】"}
{"id": null, "n": "0879012", "target": "#nkr_note_orig_0879012", "type": "orig", "text": "耶＝邪【三】"}
