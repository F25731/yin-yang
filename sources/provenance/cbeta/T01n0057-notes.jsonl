{"id": null, "n": null, "target": null, "type": null, "text": "出《中阿含》令劫意"}
{"id": null, "n": "0851006", "target": "#nkr_note_mod_0851006", "type": "mod", "text": "出中阿含令劫意【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0851007", "target": "#nkr_note_mod_0851007", "type": "mod", "text": "漢【大】，漢世【宋】【元】"}
{"id": null, "n": "0851008", "target": "#nkr_note_mod_0851008", "type": "mod", "text": "三藏【大】，三藏法師【宋】【元】【明】"}
{"id": null, "n": "0852001", "target": "#nkr_note_mod_0852001", "type": "mod", "text": "有【CB】【宋】【元】【明】，為【大】"}
{"id": null, "n": "0853001", "target": "#nkr_note_mod_0853001", "type": "mod", "text": "卒【大】，本【宋】【元】【明】"}
{"id": null, "n": "0853002", "target": "#nkr_note_mod_0853002", "type": "mod", "text": "苦痛【大】，更苦痛【宋】【元】【明】"}
{"id": null, "n": "0851006", "target": "#nkr_note_orig_0851006", "type": "orig", "text": "〔出中阿含令劫意〕－【三】"}
{"id": null, "n": "0851007", "target": "#nkr_note_orig_0851007", "type": "orig", "text": "漢＋（世）【宋】【元】"}
{"id": null, "n": "0851008", "target": "#nkr_note_orig_0851008", "type": "orig", "text": "三藏＋（法師）【三】"}
{"id": null, "n": "0852001", "target": "#nkr_note_orig_0852001", "type": "orig", "text": "為＝有【三】"}
{"id": null, "n": "0853001", "target": "#nkr_note_orig_0853001", "type": "orig", "text": "卒＝本【三】"}
{"id": null, "n": "0853002", "target": "#nkr_note_orig_0853002", "type": "orig", "text": "（更）＋苦痛【三】"}
