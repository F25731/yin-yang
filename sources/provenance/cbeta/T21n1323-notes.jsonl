{"id": null, "n": "0489007", "target": "#nkr_note_mod_0489007", "type": "mod", "text": "除【大】＊，佛說除【明】【甲】＊，【原】麗本，【甲】黃檗版淨嚴等加筆本"}
{"id": null, "n": "0489008", "target": "#nkr_note_mod_0489008", "type": "mod", "text": "經【大】，經圓仁請來【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "圓仁請來"}
{"id": null, "n": "0489009", "target": "#nkr_note_mod_0489009", "type": "mod", "text": "（開府…門）四十一字【大】，大興善寺三藏沙門大廣智【宋】【元】【甲】，唐三藏沙門大廣智【明】"}
{"id": null, "n": "0489010", "target": "#nkr_note_mod_0489010", "type": "mod", "text": "時【大】，切【明】"}
{"id": null, "n": "0489011", "target": "#nkr_note_mod_0489011", "type": "mod", "text": "伐【大】，筏【宋】【元】【明】【甲】"}
{"id": null, "n": "0489012", "target": "#nkr_note_mod_0489012", "type": "mod", "text": "眾多諸大【大】，及眾大多【宋】【元】【明】，及眾多大【甲】"}
{"id": null, "n": "0489013", "target": "#nkr_note_mod_0489013", "type": "mod", "text": "反【大】，切【明】【甲】"}
{"id": null, "n": "0489014", "target": "#nkr_note_mod_0489014", "type": "mod", "text": "合【大】，合引【宋】【元】【明】【甲】"}
{"id": null, "n": "0489015", "target": "#nkr_note_mod_0489015", "type": "mod", "text": "訶【大】，訶引八【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引八"}
{"id": null, "n": "0489016", "target": "#nkr_note_mod_0489016", "type": "mod", "text": "癨【大】，霍【宋】【元】【明】【甲】"}
{"id": null, "n": "0489017", "target": "#nkr_note_mod_0489017", "type": "mod", "text": "瘻淋【大】，瘺淋瀝【宋】【明】【甲】，痛淋瀝【元】"}
{"id": null, "n": "0489018", "target": "#nkr_note_mod_0489018", "type": "mod", "text": "虐【大】，瘧【宋】【甲】"}
{"id": null, "n": "0489019", "target": "#nkr_note_mod_0489019", "type": "mod", "text": "半【大】，背【宋】【元】【明】【甲】"}
{"id": null, "n": "0489020", "target": "#nkr_note_mod_0489020", "type": "mod", "text": "尊【大】，為尊【校異-甲】"}
{"id": null, "n": "0489021", "target": "#nkr_note_mod_0489021", "type": "mod", "text": "引【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0489007", "target": "#nkr_note_orig_0489007", "type": "orig", "text": "【原】麗本，【甲】黃檗版淨嚴等加筆本，（佛說）＋除【明】【甲】＊"}
{"id": null, "n": "0489008", "target": "#nkr_note_orig_0489008", "type": "orig", "text": "經＋（圓仁請來）細註【甲】"}
{"id": null, "n": "0489009", "target": "#nkr_note_orig_0489009", "type": "orig", "text": "（（開府…門））四十一字＝（（大興善寺三藏沙門大廣智））十一字【宋】【元】【甲】，（（唐三藏沙門大廣智））八字【明】"}
{"id": null, "n": "0489010", "target": "#nkr_note_orig_0489010", "type": "orig", "text": "時＝切【明】"}
{"id": null, "n": "0489011", "target": "#nkr_note_orig_0489011", "type": "orig", "text": "伐＝筏【三】【甲】"}
{"id": null, "n": "0489012", "target": "#nkr_note_orig_0489012", "type": "orig", "text": "眾多諸大＝及眾大多【三】，及眾多大【甲】"}
{"id": null, "n": "0489013", "target": "#nkr_note_orig_0489013", "type": "orig", "text": "反＝切【明】【甲】"}
{"id": null, "n": "0489014", "target": "#nkr_note_orig_0489014", "type": "orig", "text": "合＋（引）【三】【甲】"}
{"id": null, "n": "0489015", "target": "#nkr_note_orig_0489015", "type": "orig", "text": "訶＋（引八）夾註【三】【甲】"}
{"id": null, "n": "0489016", "target": "#nkr_note_orig_0489016", "type": "orig", "text": "癨＝霍【三】【甲】"}
{"id": null, "n": "0489017", "target": "#nkr_note_orig_0489017", "type": "orig", "text": "瘻淋＝瘺淋瀝【宋】【明】【甲】，痛淋瀝【元】"}
{"id": null, "n": "0489018", "target": "#nkr_note_orig_0489018", "type": "orig", "text": "虐＝瘧【宋】【甲】"}
{"id": null, "n": "0489019", "target": "#nkr_note_orig_0489019", "type": "orig", "text": "半＝背【三】【甲】"}
{"id": null, "n": "0489020", "target": "#nkr_note_orig_0489020", "type": "orig", "text": "（為）ィ＋尊【甲】"}
{"id": null, "n": "0489021", "target": "#nkr_note_orig_0489021", "type": "orig", "text": "〔引〕－【三】"}
{"id": null, "n": "0490001", "target": "#nkr_note_orig_0490001", "type": "orig", "text": "此下甲本奧云貞享元甲子年九月二十一夕挍之點之是為明日指授諸徒也淨嚴四十六載，元祿十六年三月十八日以淨嚴和上之本再挍了尊教"}
{"id": null, "n": "0489007", "target": "#nkr_note_rest_0489007", "type": "rest", "text": "【原】麗本，【甲】黃檗版淨嚴等加筆本"}
