{"id": null, "n": "0002036", "target": "#nkr_note_mod_0002036", "type": "mod", "text": "可【大】，可得【敦】"}
{"id": null, "n": "0002037", "target": "#nkr_note_mod_0002037", "type": "mod", "text": "夫【大】，〔－〕【敦】"}
{"id": null, "n": "0002038", "target": "#nkr_note_mod_0002038", "type": "mod", "text": "能【大】，〔－〕【敦】"}
{"id": null, "n": "0002039", "target": "#nkr_note_mod_0002039", "type": "mod", "text": "子安【大】，〔－〕【敦】"}
{"id": null, "n": "0002040", "target": "#nkr_note_mod_0002040", "type": "mod", "text": "齡【大】，〔－〕【敦】"}
{"id": null, "n": "0002041", "target": "#nkr_note_mod_0002041", "type": "mod", "text": "閉【大】，開【校異-原】"}
{"id": null, "n": "0002042", "target": "#nkr_note_mod_0002042", "type": "mod", "text": "彼【大】，〔－〕【敦】"}
{"id": null, "n": "0002043", "target": "#nkr_note_mod_0002043", "type": "mod", "text": "是【大】，〔－〕【敦】"}
{"id": null, "n": "0002044", "target": "#nkr_note_mod_0002044", "type": "mod", "text": "迷【大】，迷解【敦】"}
{"id": null, "n": "0002045", "target": "#nkr_note_mod_0002045", "type": "mod", "text": "應【大】，〔－〕【敦】"}
{"id": null, "n": "0002046", "target": "#nkr_note_mod_0002046", "type": "mod", "text": "智【大】，智法若是無亦應有知無之智【校異-原】"}
{"id": null, "n": "0002047", "target": "#nkr_note_mod_0002047", "type": "mod", "text": "非【大】，亦非【敦】"}
{"id": null, "n": "0002048", "target": "#nkr_note_mod_0002048", "type": "mod", "text": "知【大】，智【校異-原】"}
{"id": null, "n": "0002049", "target": "#nkr_note_mod_0002049", "type": "mod", "text": "損【大】，指【敦】"}
{"id": null, "n": "0002050", "target": "#nkr_note_mod_0002050", "type": "mod", "text": "見【大】，見眾【校異-原】"}
{"id": null, "n": "0002051", "target": "#nkr_note_mod_0002051", "type": "mod", "text": "解【大】，〔－〕【敦】"}
{"id": null, "n": "0002052", "target": "#nkr_note_mod_0002052", "type": "mod", "text": "實不能【大】＊，不能實【甲】【敦】＊"}
{"id": null, "n": "0003001", "target": "#nkr_note_mod_0003001", "type": "mod", "text": "使【大】，便【甲】"}
{"id": null, "n": "0003002", "target": "#nkr_note_mod_0003002", "type": "mod", "text": "三【大】，復三【敦】"}
{"id": null, "n": "0003003", "target": "#nkr_note_mod_0003003", "type": "mod", "text": "佛【大】，〔－〕【甲】"}
{"id": null, "n": "0003004", "target": "#nkr_note_mod_0003004", "type": "mod", "text": "方【大】，方佛【敦】"}
{"id": null, "n": "0003005", "target": "#nkr_note_mod_0003005", "type": "mod", "text": "便【大】＊，使【敦】＊"}
{"id": null, "n": "0003006", "target": "#nkr_note_mod_0003006", "type": "mod", "text": "生【大】，〔－〕【敦】"}
{"id": null, "n": "0003007", "target": "#nkr_note_mod_0003007", "type": "mod", "text": "無量【大】，〔－〕【敦】"}
{"id": null, "n": "0003008", "target": "#nkr_note_mod_0003008", "type": "mod", "text": "復【大】，後【敦】"}
