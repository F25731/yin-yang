{"id": null, "n": "0001012", "target": "#nkr_note_mod_0001012", "type": "mod", "text": "天【大】，〔－〕【校異-原】"}
{"id": null, "n": "0001013", "target": "#nkr_note_mod_0001013", "type": "mod", "text": "十七種【大】，〔－〕【敦】"}
{"id": null, "n": "0001014", "target": "#nkr_note_mod_0001014", "type": "mod", "text": "王【大】，〔－〕【校異-原】"}
