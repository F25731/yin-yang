{"id": null, "n": "0003037", "target": "#nkr_note_mod_0003037", "type": "mod", "text": "是【大】，是十念【敦】"}
{"id": null, "n": "0003038", "target": "#nkr_note_mod_0003038", "type": "mod", "text": "心【大】，餘心【敦】"}
{"id": null, "n": "0003039", "target": "#nkr_note_mod_0003039", "type": "mod", "text": "若【大】，〔－〕【校異-原】"}
{"id": null, "n": "0003040", "target": "#nkr_note_mod_0003040", "type": "mod", "text": "猿【大】，猨【敦】"}
{"id": null, "n": "0003041", "target": "#nkr_note_mod_0003041", "type": "mod", "text": "不【大】，〔－〕【校異-原】，無【敦】"}
{"id": null, "n": "0003042", "target": "#nkr_note_mod_0003042", "type": "mod", "text": "至【大】，及【敦】"}
{"id": null, "n": "0003043", "target": "#nkr_note_mod_0003043", "type": "mod", "text": "性【大】，往【校異-原】"}
{"id": null, "n": "0003044", "target": "#nkr_note_mod_0003044", "type": "mod", "text": "曲【大】，曲也【敦】"}
{"id": null, "n": "0003045", "target": "#nkr_note_mod_0003045", "type": "mod", "text": "若習前【大】，習【敦】"}
{"id": null, "n": "0003046", "target": "#nkr_note_mod_0003046", "type": "mod", "text": "樂【大】，樂國【敦】"}
{"id": null, "n": "0004001", "target": "#nkr_note_mod_0004001", "type": "mod", "text": "也【大】，〔－〕【敦】"}
{"id": null, "n": "0004002", "target": "#nkr_note_mod_0004002", "type": "mod", "text": "略論安樂淨土義畢【大】，讚阿彌陀佛并論上卷【敦】"}
{"id": null, "n": "0001001", "target": "#nkr_note_orig_0001001", "type": "orig", "text": "【原】德川時代刊宗教大學藏本，【甲】延寶五年刊大谷大學藏本，【敦】唐景雲二年寫佛蘭西國民圖書館藏燉煌本"}
{"id": null, "n": "0001002", "target": "#nkr_note_orig_0001002", "type": "orig", "text": "原本註曰釋曇鸞撰一作曇鸞法師作，愚案此皆後人所安蓋原文無撰者之號然欲顯別故今且從一本標之，〔釋曇鸞撰〕－【敦】"}
