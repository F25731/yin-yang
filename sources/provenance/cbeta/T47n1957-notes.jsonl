{"id": null, "n": "0003034", "target": "#nkr_note_mod_0003034", "type": "mod", "text": "勁【大】，到【敦】"}
{"id": null, "n": "0003035", "target": "#nkr_note_mod_0003035", "type": "mod", "text": "視【大】，頑【敦】"}
