{"id": null, "n": "0003010", "target": "#nkr_note_mod_0003010", "type": "mod", "text": "乎【大】，取【敦】"}
{"id": null, "n": "0003011", "target": "#nkr_note_mod_0003011", "type": "mod", "text": "甲【大】，胄【敦】"}
{"id": null, "n": "0003012", "target": "#nkr_note_mod_0003012", "type": "mod", "text": "王【大】，主【甲】"}
{"id": null, "n": "0003013", "target": "#nkr_note_mod_0003013", "type": "mod", "text": "一切【大】，〔－〕【敦】"}
{"id": null, "n": "0003014", "target": "#nkr_note_mod_0003014", "type": "mod", "text": "冥【大】，𭂟【校異-原】"}
{"id": null, "n": "0003015", "target": "#nkr_note_mod_0003015", "type": "mod", "text": "震裂【大】，聲震【敦】"}
{"id": null, "n": "0003016", "target": "#nkr_note_mod_0003016", "type": "mod", "text": "理【大】，〔－〕【敦】"}
{"id": null, "n": "0003017", "target": "#nkr_note_mod_0003017", "type": "mod", "text": "徵【大】，微【校異-原】"}
{"id": null, "n": "0003018", "target": "#nkr_note_mod_0003018", "type": "mod", "text": "五【大】，五者【敦】"}
{"id": null, "n": "0003019", "target": "#nkr_note_mod_0003019", "type": "mod", "text": "即墮【大】，則隨【校異-原】"}
{"id": null, "n": "0003020", "target": "#nkr_note_mod_0003020", "type": "mod", "text": "智【大】，智耶【敦】"}
{"id": null, "n": "0003021", "target": "#nkr_note_mod_0003021", "type": "mod", "text": "不歸向【大】，〔－〕【甲】"}
{"id": null, "n": "0003022", "target": "#nkr_note_mod_0003022", "type": "mod", "text": "諸法【大】，〔－〕【敦】"}
{"id": null, "n": "0003023", "target": "#nkr_note_mod_0003023", "type": "mod", "text": "渡【大】＊，度【敦】＊"}
{"id": null, "n": "0003024", "target": "#nkr_note_mod_0003024", "type": "mod", "text": "度【大】，渡【敦】"}
{"id": null, "n": "0003025", "target": "#nkr_note_mod_0003025", "type": "mod", "text": "是【大】，名【敦】"}
{"id": null, "n": "0003026", "target": "#nkr_note_mod_0003026", "type": "mod", "text": "若【大】，若不【校異-原】"}
{"id": null, "n": "0003027", "target": "#nkr_note_mod_0003027", "type": "mod", "text": "照【大】，〔－〕【敦】"}
