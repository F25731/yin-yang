{"id": null, "n": "0001018", "target": "#nkr_note_mod_0001018", "type": "mod", "text": "圍【大】，〔－〕【校異-原】"}
{"id": null, "n": "0001019", "target": "#nkr_note_mod_0001019", "type": "mod", "text": "未證【大】，與諸【敦】，與未證【校異-原】"}
{"id": null, "n": "0001020", "target": "#nkr_note_mod_0001020", "type": "mod", "text": "證【大】，〔－〕【校異-原】"}
{"id": null, "n": "0001021", "target": "#nkr_note_mod_0001021", "type": "mod", "text": "大【大】，〔－〕【校異-原】"}
{"id": null, "n": "0001022", "target": "#nkr_note_mod_0001022", "type": "mod", "text": "寶【大】，〔－〕【校異-原】"}
{"id": null, "n": "0001023", "target": "#nkr_note_mod_0001023", "type": "mod", "text": "品輩有幾【大】，輩輩有【敦】，輩有幾【校異-原】"}
{"id": null, "n": "0001024", "target": "#nkr_note_mod_0001024", "type": "mod", "text": "品【大】，品中【敦】"}
{"id": null, "n": "0001025", "target": "#nkr_note_mod_0001025", "type": "mod", "text": "今【大】，令【校異-原】"}
{"id": null, "n": "0001026", "target": "#nkr_note_mod_0001026", "type": "mod", "text": "作【大】，〔－〕【敦】"}
{"id": null, "n": "0001027", "target": "#nkr_note_mod_0001027", "type": "mod", "text": "心【大】，〔－〕【校異-原】"}
{"id": null, "n": "0001028", "target": "#nkr_note_mod_0001028", "type": "mod", "text": "因【大】，〔－〕【敦】"}
{"id": null, "n": "0001029", "target": "#nkr_note_mod_0001029", "type": "mod", "text": "多少【大】，少多【敦】"}
{"id": null, "n": "0001030", "target": "#nkr_note_mod_0001030", "type": "mod", "text": "飯【大】，飲【校異-原】"}
{"id": null, "n": "0001031", "target": "#nkr_note_mod_0001031", "type": "mod", "text": "然【大】，燃【敦】"}
{"id": null, "n": "0001032", "target": "#nkr_note_mod_0001032", "type": "mod", "text": "樂【大】，樂國【甲】"}
{"id": null, "n": "0001033", "target": "#nkr_note_mod_0001033", "type": "mod", "text": "如【大】，〔－〕【敦】"}
{"id": null, "n": "0001034", "target": "#nkr_note_mod_0001034", "type": "mod", "text": "（下輩…中輩）七十二字【大】∞（又有…安樂）七十字【敦】"}
{"id": null, "n": "0001035", "target": "#nkr_note_mod_0001035", "type": "mod", "text": "（又有…安樂）七十字【大】∞（下輩…中輩）七十二字【敦】"}
{"id": null, "n": "0001036", "target": "#nkr_note_mod_0001036", "type": "mod", "text": "諸【大】，〔－〕【敦】"}
{"id": null, "n": "0002001", "target": "#nkr_note_mod_0002001", "type": "mod", "text": "生安樂【大】，〔－〕【考偽-原】，願生【敦】"}
{"id": null, "n": "0002002", "target": "#nkr_note_mod_0002002", "type": "mod", "text": "生【大】，又有一種往生安樂不入三輩中謂以疑惑心修諸功德不異前說生【敦】"}
{"id": null, "n": "0002003", "target": "#nkr_note_mod_0002003", "type": "mod", "text": "七【大】，已十【敦】"}
{"id": null, "n": "0002004", "target": "#nkr_note_mod_0002004", "type": "mod", "text": "常【大】，〔－〕【敦】"}
{"id": null, "n": "0002005", "target": "#nkr_note_mod_0002005", "type": "mod", "text": "土【大】，〔－〕【敦】"}
{"id": null, "n": "0002006", "target": "#nkr_note_mod_0002006", "type": "mod", "text": "向【大】，〔－〕【校異-原】"}
{"id": null, "n": "0002007", "target": "#nkr_note_mod_0002007", "type": "mod", "text": "否【大】，〔－〕【敦】"}
{"id": null, "n": "0002008", "target": "#nkr_note_mod_0002008", "type": "mod", "text": "於【大】，著【敦】"}
{"id": null, "n": "0002009", "target": "#nkr_note_mod_0002009", "type": "mod", "text": "具【大】，見【敦】"}
{"id": null, "n": "0002010", "target": "#nkr_note_mod_0002010", "type": "mod", "text": "王【大】，王子【敦】"}
{"id": null, "n": "0002011", "target": "#nkr_note_mod_0002011", "type": "mod", "text": "具【大】，其【敦】"}
{"id": null, "n": "0002012", "target": "#nkr_note_mod_0002012", "type": "mod", "text": "受【大】，愛【敦】"}
{"id": null, "n": "0002013", "target": "#nkr_note_mod_0002013", "type": "mod", "text": "念【大】，〔－〕【考偽-原】"}
{"id": null, "n": "0002014", "target": "#nkr_note_mod_0002014", "type": "mod", "text": "諸【大】，〔－〕【敦】"}
{"id": null, "n": "0002015", "target": "#nkr_note_mod_0002015", "type": "mod", "text": "好色【大】，妙色聲【敦】"}
{"id": null, "n": "0002016", "target": "#nkr_note_mod_0002016", "type": "mod", "text": "不【大】，以【校異-原】，以不【敦】"}
{"id": null, "n": "0002017", "target": "#nkr_note_mod_0002017", "type": "mod", "text": "責悔【大】，悔責【敦】"}
{"id": null, "n": "0002018", "target": "#nkr_note_mod_0002018", "type": "mod", "text": "悔【大】，生悔【敦】"}
{"id": null, "n": "0002019", "target": "#nkr_note_mod_0002019", "type": "mod", "text": "故【大】，〔－〕【敦】"}
{"id": null, "n": "0002020", "target": "#nkr_note_mod_0002020", "type": "mod", "text": "但【大】，〔－〕【敦】"}
{"id": null, "n": "0002021", "target": "#nkr_note_mod_0002021", "type": "mod", "text": "秤【大】，科【敦】"}
{"id": null, "n": "0002022", "target": "#nkr_note_mod_0002022", "type": "mod", "text": "或一月【大】，一日【敦】"}
{"id": null, "n": "0002023", "target": "#nkr_note_mod_0002023", "type": "mod", "text": "乎【大】＊，耶【敦】＊"}
{"id": null, "n": "0002024", "target": "#nkr_note_mod_0002024", "type": "mod", "text": "所【大】，取【敦】"}
{"id": null, "n": "0002025", "target": "#nkr_note_mod_0002025", "type": "mod", "text": "俱【大】，備【敦】"}
{"id": null, "n": "0002026", "target": "#nkr_note_mod_0002026", "type": "mod", "text": "以多【大】，〔－〕【敦】"}
{"id": null, "n": "0002027", "target": "#nkr_note_mod_0002027", "type": "mod", "text": "佛【大】，〔－〕【敦】"}
{"id": null, "n": "0002028", "target": "#nkr_note_mod_0002028", "type": "mod", "text": "（豈…盡）十三字【大】，〔－〕【敦】"}
{"id": null, "n": "0002029", "target": "#nkr_note_mod_0002029", "type": "mod", "text": "主【大】＊，王【敦】＊"}
{"id": null, "n": "0002030", "target": "#nkr_note_mod_0002030", "type": "mod", "text": "溢【大】，望【敦】"}
{"id": null, "n": "0002031", "target": "#nkr_note_mod_0002031", "type": "mod", "text": "言以可有【大】，以【敦】"}
{"id": null, "n": "0002032", "target": "#nkr_note_mod_0002032", "type": "mod", "text": "仕【大】，貧仕【敦】"}
{"id": null, "n": "0002033", "target": "#nkr_note_mod_0002033", "type": "mod", "text": "上下尚【大】，〔－〕【敦】"}
{"id": null, "n": "0002034", "target": "#nkr_note_mod_0002034", "type": "mod", "text": "言【大】，謂【考偽-原】"}
