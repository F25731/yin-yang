{"id": null, "n": "0003029", "target": "#nkr_note_mod_0003029", "type": "mod", "text": "邊【大】，邊無邊【敦】"}
{"id": null, "n": "0003030", "target": "#nkr_note_mod_0003030", "type": "mod", "text": "曰【大】，〔－〕【甲】"}
{"id": null, "n": "0003031", "target": "#nkr_note_mod_0003031", "type": "mod", "text": "遇【大】，愚【校異-原】"}
{"id": null, "n": "0003032", "target": "#nkr_note_mod_0003032", "type": "mod", "text": "來【大】，〔－〕【校異-原】"}
