{"id": null, "n": "0743003", "target": "#nkr_note_mod_0743003", "type": "mod", "text": "沙門【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "0743004", "target": "#nkr_note_mod_0743004", "type": "mod", "text": "廝【大】，斯【宮】"}
{"id": null, "n": "0743005", "target": "#nkr_note_mod_0743005", "type": "mod", "text": "罹【大】＊，羅【宋】【宮】＊"}
{"id": null, "n": "0743006", "target": "#nkr_note_mod_0743006", "type": "mod", "text": "久【大】，分【宮】"}
{"id": null, "n": "0743007", "target": "#nkr_note_mod_0743007", "type": "mod", "text": "堪【大】，進【宮】"}
{"id": null, "n": "0743008", "target": "#nkr_note_mod_0743008", "type": "mod", "text": "歛【大】，斂【宮】"}
{"id": null, "n": "0743009", "target": "#nkr_note_mod_0743009", "type": "mod", "text": "貧寒【大】，寒索【宮】"}
{"id": null, "n": "0744001", "target": "#nkr_note_mod_0744001", "type": "mod", "text": "憍貴太子者今卿是也【大】，〔－〕【宮】"}
{"id": null, "n": "0744002", "target": "#nkr_note_mod_0744002", "type": "mod", "text": "殘【大】，沒【宮】"}
{"id": null, "n": "0743002", "target": "#nkr_note_orig_0743002", "type": "orig", "text": "此經明本與宋本元本宮本對校 cf. p. 742"}
