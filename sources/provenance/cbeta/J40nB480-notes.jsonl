{"id": null, "n": null, "target": null, "type": null, "text": "上俱南華經"}
{"id": null, "n": null, "target": null, "type": null, "text": "上俱文始經"}
{"id": null, "n": null, "target": null, "type": null, "text": "上俱金剛經"}
{"id": null, "n": null, "target": null, "type": null, "text": "上俱彌勒經"}
{"id": null, "n": null, "target": null, "type": null, "text": "四十二章經"}
{"id": null, "n": null, "target": null, "type": null, "text": "上俱維摩經"}
{"id": null, "n": null, "target": null, "type": null, "text": "上俱楞伽經"}
{"id": null, "n": null, "target": null, "type": null, "text": "上俱圓覺經"}
{"id": null, "n": null, "target": null, "type": null, "text": "上俱楞嚴經"}
{"id": null, "n": null, "target": null, "type": null, "text": "上俱法華經"}
{"id": null, "n": null, "target": null, "type": null, "text": "上俱華嚴經"}
{"id": null, "n": null, "target": null, "type": null, "text": "此言理也，然理中含有數"}
{"id": null, "n": null, "target": null, "type": null, "text": "此言數也，然數中含有理"}
{"id": null, "n": null, "target": null, "type": null, "text": "四四"}
{"id": null, "n": null, "target": null, "type": null, "text": "五為"}
{"id": null, "n": null, "target": null, "type": null, "text": "裡去"}
{"id": null, "n": null, "target": null, "type": null, "text": "別號"}
{"id": null, "n": null, "target": null, "type": null, "text": "之曰"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "自自"}
{"id": null, "n": null, "target": null, "type": null, "text": "即有"}
{"id": null, "n": null, "target": null, "type": null, "text": "者大"}
{"id": null, "n": null, "target": null, "type": null, "text": "〡，飴，中有物日〡。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〡，合，卦名。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〡，山，輕車也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〡，福，車也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〡，谷，車〡也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〡，倉，動也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〡，標，紅風也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上祝下語，栗器也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上甫下弗，黑白文也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "浮塵"}
{"id": null, "n": null, "target": null, "type": null, "text": "一著而變化也，善念觀音者，切勿錯過。"}
{"id": null, "n": null, "target": null, "type": null, "text": "塵勞"}
{"id": null, "n": null, "target": null, "type": null, "text": "空界"}
{"id": null, "n": null, "target": null, "type": null, "text": "陰區"}
{"id": null, "n": null, "target": null, "type": null, "text": "如來"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "塵勞"}
{"id": null, "n": null, "target": null, "type": null, "text": "則同"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "〡，折，懼也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〡，詳，學也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〡，戾。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〡，集，敬也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〡，竹，靜也，安也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〡，博，〡飥也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〡，托，餺〡也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "奴錫切。飢也，思也，憂也。"}
