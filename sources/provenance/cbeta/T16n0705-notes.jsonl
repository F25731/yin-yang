{"id": null, "n": "0812009", "target": "#nkr_note_mod_0812009", "type": "mod", "text": "西天…師臣【大】，三藏法師【宋】【元】【宮】，宋西天三藏法師【明】"}
{"id": null, "n": "0812010", "target": "#nkr_note_mod_0812010", "type": "mod", "text": "賢【大】，天【明】"}
{"id": null, "n": "0812011", "target": "#nkr_note_mod_0812011", "type": "mod", "text": "旃【大】，栴【明】"}
{"id": null, "n": "0812012", "target": "#nkr_note_mod_0812012", "type": "mod", "text": "肢【大】，支【明】"}
{"id": null, "n": "0812013", "target": "#nkr_note_mod_0812013", "type": "mod", "text": "神【大】，禪【宋】【元】【明】【宮】"}
{"id": null, "n": "0813001", "target": "#nkr_note_mod_0813001", "type": "mod", "text": "飲【大】，飯【宮】"}
{"id": null, "n": "0813002", "target": "#nkr_note_mod_0813002", "type": "mod", "text": "而【大】，若【宋】【宮】"}
{"id": null, "n": "0813003", "target": "#nkr_note_mod_0813003", "type": "mod", "text": "妙【大】，妙樂【宋】【元】【明】【宮】"}
{"id": null, "n": "0812009", "target": "#nkr_note_orig_0812009", "type": "orig", "text": "西天…師臣＝三藏法師【宋】【元】【宮】，宋西天三藏法師【明】"}
{"id": null, "n": "0812010", "target": "#nkr_note_orig_0812010", "type": "orig", "text": "賢＝天【明】"}
{"id": null, "n": "0812011", "target": "#nkr_note_orig_0812011", "type": "orig", "text": "旃＝栴【明】"}
{"id": null, "n": "0812012", "target": "#nkr_note_orig_0812012", "type": "orig", "text": "肢＝支【明】"}
{"id": null, "n": "0812013", "target": "#nkr_note_orig_0812013", "type": "orig", "text": "神＝禪【三】【宮】"}
{"id": null, "n": "0813001", "target": "#nkr_note_orig_0813001", "type": "orig", "text": "飲＝飯【宮】"}
{"id": null, "n": "0813002", "target": "#nkr_note_orig_0813002", "type": "orig", "text": "而＝若【宋】【宮】"}
{"id": null, "n": "0813003", "target": "#nkr_note_orig_0813003", "type": "orig", "text": "妙＋（樂）【三】【宮】"}
