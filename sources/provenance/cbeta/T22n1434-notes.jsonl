{"id": null, "n": "1068011", "target": "#nkr_note_mod_1068011", "type": "mod", "text": "若【大】，右【宋】【元】【宮】"}
{"id": null, "n": "1068012", "target": "#nkr_note_mod_1068012", "type": "mod", "text": "如【大】＊，第二第三亦如【宋】【元】【明】【宮】＊"}
{"id": null, "n": "1068013", "target": "#nkr_note_mod_1068013", "type": "mod", "text": "三【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "1068014", "target": "#nkr_note_mod_1068014", "type": "mod", "text": "上【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "1068015", "target": "#nkr_note_mod_1068015", "type": "mod", "text": "白【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1069001", "target": "#nkr_note_mod_1069001", "type": "mod", "text": "一【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "1069002", "target": "#nkr_note_mod_1069002", "type": "mod", "text": "文【大】，〔－〕【宋】【元】【明】【宮】"}
