{"id": null, "n": "1066002", "target": "#nkr_note_orig_1066002", "type": "orig", "text": "歡＝觀【三】【宮】"}
{"id": null, "n": "1066003", "target": "#nkr_note_orig_1066003", "type": "orig", "text": "（盡形…能）二十四字∞（盡形…能）十九字【三】【宮】"}
{"id": null, "n": "1066004", "target": "#nkr_note_orig_1066004", "type": "orig", "text": "（盡形…能）二十四字∞（盡形…能）十九字【三】【宮】"}
{"id": null, "n": "1066005", "target": "#nkr_note_orig_1066005", "type": "orig", "text": "歲＝年【三】【宮】"}
{"id": null, "n": "1066006", "target": "#nkr_note_orig_1066006", "type": "orig", "text": "故＋（與我二歲學戒）【三】【宮】"}
