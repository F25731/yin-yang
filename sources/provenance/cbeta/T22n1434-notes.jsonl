{"id": null, "n": "1069010", "target": "#nkr_note_mod_1069010", "type": "mod", "text": "德【大】，德僧【宋】【元】【明】【宮】"}
{"id": null, "n": "1069011", "target": "#nkr_note_mod_1069011", "type": "mod", "text": "丘【大】，丘尼【宋】【元】【明】【宮】"}
{"id": null, "n": "1069012", "target": "#nkr_note_mod_1069012", "type": "mod", "text": "恣【大】，恣法【宋】【元】【明】【宮】"}
{"id": null, "n": "1069013", "target": "#nkr_note_mod_1069013", "type": "mod", "text": "處分【大】，分處【聖】"}
{"id": null, "n": "1069014", "target": "#nkr_note_mod_1069014", "type": "mod", "text": "匡【大】，正【宋】【元】【明】【宮】"}
{"id": null, "n": "1069015", "target": "#nkr_note_mod_1069015", "type": "mod", "text": "（一者…親近）三十四字【大】，一者出離非世法二越度非受法三無欲非有欲四無結非有結五不親近生死非親近【宋】【元】【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "一者出離非世法二越度非受法三無欲非有欲四無結非有結五不親近生死非親近"}
{"id": null, "n": "1069016", "target": "#nkr_note_mod_1069016", "type": "mod", "text": "者【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1069017", "target": "#nkr_note_mod_1069017", "type": "mod", "text": "（一少…愚癡）三十字【大】，一少欲非多欲二知足非無厭三易護非難護四易養非難養五智慧非愚癡【宋】【元】【明】【宮】"}
{"id": null, "n": null, "target": null, "type": null, "text": "一少欲非多欲二知足非無厭三易護非難護四易養非難養五智慧非愚癡"}
{"id": null, "n": "1069018", "target": "#nkr_note_mod_1069018", "type": "mod", "text": "（一有…稱歎）四十三字【大】，一有罪行者制二無罪者聽三若制若聽法有缺減者如法舉之四數數違犯折伏與念五真實功德愛念稱歎【宋】【元】【明】【宮】"}
{"id": null, "n": null, "target": null, "type": null, "text": "一有罪行者制二無罪者聽三若制若聽法有缺減者如法舉之四數數違犯折伏與念五真實功德愛念稱歎"}
{"id": null, "n": "1069019", "target": "#nkr_note_mod_1069019", "type": "mod", "text": "犯【大】，犯者【宋】【元】【明】【宮】"}
{"id": null, "n": "1069020", "target": "#nkr_note_mod_1069020", "type": "mod", "text": "綱【大】，網【宋】【元】【宮】"}
{"id": null, "n": "1069021", "target": "#nkr_note_mod_1069021", "type": "mod", "text": "繼【大】，經【宋】【元】【明】【宮】"}
{"id": null, "n": "1069022", "target": "#nkr_note_mod_1069022", "type": "mod", "text": "（一應…默然）五十五字【大】，一應以慈心二應自卑下如拭塵巾三應善知坐起上下威儀四不雜說俗事為眾說法若請他說五若見僧中有不可事心不安忍應作默然【宋】【元】【明】【宮】"}
{"id": null, "n": null, "target": null, "type": null, "text": "一應以慈心二應自卑下如拭塵巾三應善知坐起上下威儀四不雜說俗事為眾說法若請他說五若見僧中有不可事心不安忍應作默然"}
{"id": null, "n": "1069023", "target": "#nkr_note_mod_1069023", "type": "mod", "text": "作【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1069024", "target": "#nkr_note_mod_1069024", "type": "mod", "text": "（一見…默然）三十三字【大】，一見他非法而默然二不得伴而默然三犯重而默然四同住默然五在同住地默然【宋】【元】【明】【宮】"}
{"id": null, "n": null, "target": null, "type": null, "text": "一見他非法而默然二不得伴而默然三犯重而默然四同住默然五在同住地默然"}
{"id": null, "n": "1069025", "target": "#nkr_note_mod_1069025", "type": "mod", "text": "（一如…默然）四十七字【大】，一如法羯磨而心不同默然在之二得同意伴亦默然任之三若見小罪而默然四為作別住而默然五在戒場上而默然【宋】【元】【明】【宮】"}
{"id": null, "n": null, "target": null, "type": null, "text": "一如法羯磨而心不同默然在之二得同意伴亦默然任之三若見小罪而默然四為作別住而默然五在戒場上而默然"}
{"id": null, "n": "1069026", "target": "#nkr_note_mod_1069026", "type": "mod", "text": "任【CB】【宋】【元】【明】【宮】【聖】，在【大】"}
{"id": null, "n": "1069027", "target": "#nkr_note_mod_1069027", "type": "mod", "text": "一比丘乃至羯磨百七十二字宋元明宮四本俱作夾註"}
{"id": null, "n": "1070001", "target": "#nkr_note_mod_1070001", "type": "mod", "text": "懺【大】，懺悔【宋】【元】【明】【宮】"}
{"id": null, "n": "1070002", "target": "#nkr_note_mod_1070002", "type": "mod", "text": "一【大】，二【元】"}
{"id": null, "n": "1070003", "target": "#nkr_note_mod_1070003", "type": "mod", "text": "見【大】，現【宋】【元】【明】【宮】"}
{"id": null, "n": "1070004", "target": "#nkr_note_mod_1070004", "type": "mod", "text": "護【大】，講【宮】"}
{"id": null, "n": "1070005", "target": "#nkr_note_mod_1070005", "type": "mod", "text": "（謂呵責…磨）十二字【大】，謂呵責羯磨擯羯磨依止羯磨【宋】【元】【明】【宮】"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂呵責羯磨擯羯磨依止羯磨"}
{"id": null, "n": "1070006", "target": "#nkr_note_mod_1070006", "type": "mod", "text": "（謂罪處…地）十一字【大】，謂罪處所多人語如草覆地【宋】【元】【明】【宮】"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂罪處所多人語如草覆地"}
{"id": null, "n": "1070007", "target": "#nkr_note_mod_1070007", "type": "mod", "text": "（謂三…磨）十二字【大】，謂三舉羯磨惡罵治滅擯羯磨【宋】【元】【明】【宮】"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂三舉羯磨惡罵治滅擯羯磨"}
{"id": null, "n": "1070008", "target": "#nkr_note_mod_1070008", "type": "mod", "text": "罵【大】，馬【宋】【元】【明】【宮】"}
{"id": null, "n": "1070009", "target": "#nkr_note_mod_1070009", "type": "mod", "text": "德【大】，姊【宋】【元】【明】【宮】"}
{"id": null, "n": "1070010", "target": "#nkr_note_mod_1070010", "type": "mod", "text": "丘【大】＊，丘尼【宋】【元】【明】【宮】＊"}
{"id": null, "n": "1070011", "target": "#nkr_note_mod_1070011", "type": "mod", "text": "等【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1070012", "target": "#nkr_note_mod_1070012", "type": "mod", "text": "勉【CB】【宋】【元】【明】【宮】【聖】，免【大】"}
{"id": null, "n": "1070013", "target": "#nkr_note_mod_1070013", "type": "mod", "text": "儻【大】＊，黨【宋】【元】【明】【宮】＊"}
{"id": null, "n": "1070014", "target": "#nkr_note_mod_1070014", "type": "mod", "text": "丘【大】，丘尼【宋】【元】【明】【宮】"}
{"id": null, "n": "1070015", "target": "#nkr_note_mod_1070015", "type": "mod", "text": "言【大】，者【宋】【元】【明】【宮】"}
{"id": null, "n": "1070016", "target": "#nkr_note_mod_1070016", "type": "mod", "text": "德【大】＊，姊【宋】【元】【明】【宮】＊"}
{"id": null, "n": "1070017", "target": "#nkr_note_mod_1070017", "type": "mod", "text": "丘【大】，丘尼【明】"}
{"id": null, "n": "1070018", "target": "#nkr_note_mod_1070018", "type": "mod", "text": "丘【大】＊，丘尼【宋】＊【元】＊【明】＊"}
{"id": null, "n": "1070019", "target": "#nkr_note_mod_1070019", "type": "mod", "text": "彼【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1070020", "target": "#nkr_note_mod_1070020", "type": "mod", "text": "勉【CB】【宋】【元】【明】【宮】【聖】，免【大】"}
{"id": null, "n": "1070021", "target": "#nkr_note_mod_1070021", "type": "mod", "text": "長老【大】＊，大姊【宋】【元】【明】【宮】＊"}
{"id": null, "n": "1070022", "target": "#nkr_note_mod_1070022", "type": "mod", "text": "丘【大】＊，丘尼【明】＊"}
{"id": null, "n": "1070023", "target": "#nkr_note_mod_1070023", "type": "mod", "text": "更【大】，後更【宋】【元】【明】【宮】"}
{"id": null, "n": "1070024", "target": "#nkr_note_mod_1070024", "type": "mod", "text": "忍【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1070025", "target": "#nkr_note_mod_1070025", "type": "mod", "text": "不【大】，誰不【宋】【元】【明】【宮】"}
{"id": null, "n": "1070026", "target": "#nkr_note_mod_1070026", "type": "mod", "text": "奪【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1070027", "target": "#nkr_note_mod_1070027", "type": "mod", "text": "其【大】，某【宋】【宮】"}
{"id": null, "n": "1070028", "target": "#nkr_note_mod_1070028", "type": "mod", "text": "隨【大】，其隨【宋】【元】【明】【宮】"}
