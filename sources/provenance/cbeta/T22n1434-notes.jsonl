{"id": null, "n": "1070030", "target": "#nkr_note_mod_1070030", "type": "mod", "text": "擯【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1070031", "target": "#nkr_note_mod_1070031", "type": "mod", "text": "唯【大】，惟【宋】【元】【明】【宮】"}
{"id": null, "n": "1070032", "target": "#nkr_note_mod_1070032", "type": "mod", "text": "一卷【大】，〔－〕【明】【聖】"}
{"id": null, "n": "1070033", "target": "#nkr_note_mod_1070033", "type": "mod", "text": "卷【大】，卷七【宋】"}
{"id": null, "n": "1070035", "target": "#nkr_note_mod_1070035", "type": "mod", "text": "（按此…之）二百八十九字【大】，〔－〕【宋】【元】【明】"}
