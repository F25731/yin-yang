{"id": null, "n": "1066033", "target": "#nkr_note_mod_1066033", "type": "mod", "text": "使【大】，便【宋】【元】【明】【宮】"}
{"id": null, "n": "1066034", "target": "#nkr_note_mod_1066034", "type": "mod", "text": "䠒【大】，互【宋】【元】【明】【宮】"}
