{"id": null, "n": "1066005", "target": "#nkr_note_mod_1066005", "type": "mod", "text": "歲【大】，年【宋】【元】【明】【宮】"}
{"id": null, "n": "1066006", "target": "#nkr_note_mod_1066006", "type": "mod", "text": "故【大】，故與我二歲學戒【宋】【元】【明】【宮】"}
{"id": null, "n": "1066007", "target": "#nkr_note_mod_1066007", "type": "mod", "text": "如【大】，第二第三亦如【宋】【元】【明】【宮】"}
{"id": null, "n": "1066008", "target": "#nkr_note_mod_1066008", "type": "mod", "text": "三【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1066009", "target": "#nkr_note_mod_1066009", "type": "mod", "text": "尼【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "1066010", "target": "#nkr_note_mod_1066010", "type": "mod", "text": "堪【大】，堪能【宋】【元】【明】【宮】"}
{"id": null, "n": "1066011", "target": "#nkr_note_mod_1066011", "type": "mod", "text": "作【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1066012", "target": "#nkr_note_mod_1066012", "type": "mod", "text": "如【大】，第二第三亦如【宋】【元】【明】【宮】"}
{"id": null, "n": "1066013", "target": "#nkr_note_mod_1066013", "type": "mod", "text": "三【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1066014", "target": "#nkr_note_mod_1066014", "type": "mod", "text": "得【大】，淨行【宋】【元】【明】【宮】"}
{"id": null, "n": "1066015", "target": "#nkr_note_mod_1066015", "type": "mod", "text": "龍【大】，龍來【宋】【元】【明】【宮】"}
{"id": null, "n": "1066016", "target": "#nkr_note_mod_1066016", "type": "mod", "text": "戒【大】，受戒【宋】【元】【明】【宮】"}
{"id": null, "n": "1066017", "target": "#nkr_note_mod_1066017", "type": "mod", "text": "受【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1066018", "target": "#nkr_note_mod_1066018", "type": "mod", "text": "言【大】，說言【宋】【元】【明】【宮】"}
{"id": null, "n": "1066019", "target": "#nkr_note_mod_1066019", "type": "mod", "text": "戒【大】，戒慈愍故【宋】【元】【明】【宮】"}
{"id": null, "n": "1066020", "target": "#nkr_note_mod_1066020", "type": "mod", "text": "如【大】，第二第三亦如【宋】【元】【明】【宮】"}
{"id": null, "n": "1066021", "target": "#nkr_note_mod_1066021", "type": "mod", "text": "三【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1066022", "target": "#nkr_note_mod_1066022", "type": "mod", "text": "爾字宋元明三本俱作本文"}
{"id": null, "n": "1066023", "target": "#nkr_note_mod_1066023", "type": "mod", "text": "持【大】，將【宋】【元】【明】【宮】"}
{"id": null, "n": "1066024", "target": "#nkr_note_mod_1066024", "type": "mod", "text": "中【大】，十【宮】"}
{"id": null, "n": "1066025", "target": "#nkr_note_mod_1066025", "type": "mod", "text": "祇【大】，竭【宋】【元】【宮】"}
{"id": null, "n": "1066026", "target": "#nkr_note_mod_1066026", "type": "mod", "text": "己有【大】，是【宋】【元】【明】【宮】"}
{"id": null, "n": "1066027", "target": "#nkr_note_mod_1066027", "type": "mod", "text": "真人【大】，〔－〕【宋】【元】【明】【宮】"}
