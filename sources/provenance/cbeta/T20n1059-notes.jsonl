{"id": null, "n": null, "target": null, "type": null, "text": "拙具羅香者，安悉香是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "弭哩吒那，猫兒頭骨是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "劫布羅香者，龍腦香是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "結聹者，所聹耳穴內結耳屎是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "摩那屎羅者，雄黃是也。白者，淨也。印成鹽，美是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿婆末唎草，牛膝草是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "杜嚕香者，薰陸香是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "瞿摩夷者，烏牛屎是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "骨嚕末遮者，白馬屎也"}
{"id": null, "n": null, "target": null, "type": null, "text": "骨魯怛佉者，新驢糞是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "奢弭葉者，苟杞葉是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿梨瑟迦紫者，木槵子是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡盧遮那，牛黃是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "骨嚕萬異者，白馬屎是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "草纏羅菓者，菟糸子是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "瞿摩夷者，犢牛子之失是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "半角中子"}
