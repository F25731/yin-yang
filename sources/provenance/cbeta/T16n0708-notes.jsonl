{"id": null, "n": "0815003", "target": "#nkr_note_mod_0815003", "type": "mod", "text": "了本【大】，佛說了本【元】【明】，了本生死經 Śālistamba-sūtra"}
{"id": null, "n": "0815004", "target": "#nkr_note_mod_0815004", "type": "mod", "text": "氏【大】，支【宋】【元】【明】，氏國【元】【明】"}
{"id": null, "n": "0815005", "target": "#nkr_note_mod_0815005", "type": "mod", "text": "譯【大】，初譯【元】"}
{"id": null, "n": "0815006", "target": "#nkr_note_mod_0815006", "type": "mod", "text": "不【大】，不躇【宋】【宮】，不跬【元】【明】"}
{"id": null, "n": "0815007", "target": "#nkr_note_mod_0815007", "type": "mod", "text": "象【大】下同，像【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0815008", "target": "#nkr_note_mod_0815008", "type": "mod", "text": "躇【大】＊，跬【元】【明】＊"}
{"id": null, "n": "0815009", "target": "#nkr_note_mod_0815009", "type": "mod", "text": "非【大】，非故【宋】【元】【明】【宮】"}
{"id": null, "n": "0815010", "target": "#nkr_note_mod_0815010", "type": "mod", "text": "當【大】，常【宮】"}
{"id": null, "n": "0815011", "target": "#nkr_note_mod_0815011", "type": "mod", "text": "病【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0815012", "target": "#nkr_note_mod_0815012", "type": "mod", "text": "惱【大】，性【宋】【元】【明】【宮】"}
{"id": null, "n": "0816001", "target": "#nkr_note_mod_0816001", "type": "mod", "text": "我【大】，彼【明】"}
{"id": null, "n": "0816003", "target": "#nkr_note_mod_0816003", "type": "mod", "text": "妄【大】，淨【宋】【元】【明】【宮】"}
{"id": null, "n": "0816004", "target": "#nkr_note_mod_0816004", "type": "mod", "text": "受【大】，作受【宋】【元】【明】【宮】"}
{"id": null, "n": "0816005", "target": "#nkr_note_mod_0816005", "type": "mod", "text": "猗【大】下同，倚【元】【明】下同"}
{"id": null, "n": "0816006", "target": "#nkr_note_mod_0816006", "type": "mod", "text": "合【大】，會【宋】【元】【明】【宮】"}
{"id": null, "n": "0816007", "target": "#nkr_note_mod_0816007", "type": "mod", "text": "誑【大】，狂【宋】【元】【明】【宮】"}
{"id": null, "n": "0816008", "target": "#nkr_note_mod_0816008", "type": "mod", "text": "障【大】，彰【宋】【元】【明】【宮】"}
{"id": null, "n": "0816009", "target": "#nkr_note_mod_0816009", "type": "mod", "text": "滿【大】，懣【宋】【元】【明】【宮】"}
{"id": null, "n": "0816010", "target": "#nkr_note_mod_0816010", "type": "mod", "text": "主【大】，住【宋】【元】【明】【宮】"}
{"id": null, "n": "0816011", "target": "#nkr_note_mod_0816011", "type": "mod", "text": "知【大】，知為【宋】【元】【明】【宮】"}
{"id": null, "n": "0816012", "target": "#nkr_note_mod_0816012", "type": "mod", "text": "輒【大】，轉【宋】【元】【明】【宮】"}
{"id": null, "n": "0816013", "target": "#nkr_note_mod_0816013", "type": "mod", "text": "法【大】，行法【宋】【元】【明】【宮】"}
{"id": null, "n": "0816014", "target": "#nkr_note_mod_0816014", "type": "mod", "text": "報【大】，報報【宋】【元】【明】【宮】"}
{"id": null, "n": "0816015", "target": "#nkr_note_mod_0816015", "type": "mod", "text": "家【大】，像【宋】【元】【明】【宮】"}
{"id": null, "n": "0816016", "target": "#nkr_note_mod_0816016", "type": "mod", "text": "習【大】，集【宋】【元】【明】【宮】"}
{"id": null, "n": "0816017", "target": "#nkr_note_mod_0816017", "type": "mod", "text": "畫【大】，盡【明】【宮】"}
{"id": null, "n": "0816018", "target": "#nkr_note_mod_0816018", "type": "mod", "text": "現【大】，見【宋】【元】【明】【宮】"}
{"id": null, "n": "0815003", "target": "#nkr_note_orig_0815003", "type": "orig", "text": "Śālistamba-sūtra, （佛說）＋了本【元】【明】"}
{"id": null, "n": "0815004", "target": "#nkr_note_orig_0815004", "type": "orig", "text": "氏＝支【三】，氏＋（國）【元】【明】"}
{"id": null, "n": "0815005", "target": "#nkr_note_orig_0815005", "type": "orig", "text": "（初）＋譯【元】"}
{"id": null, "n": "0815006", "target": "#nkr_note_orig_0815006", "type": "orig", "text": "不＋（躇）【宋】【宮】，（跬）【元】【明】"}
{"id": null, "n": "0815007", "target": "#nkr_note_orig_0815007", "type": "orig", "text": "象＝像【三】【宮】下同"}
{"id": null, "n": "0815008", "target": "#nkr_note_orig_0815008", "type": "orig", "text": "躇＝跬【元】【明】＊"}
{"id": null, "n": "0815009", "target": "#nkr_note_orig_0815009", "type": "orig", "text": "非＋（故）【三】【宮】"}
{"id": null, "n": "0815010", "target": "#nkr_note_orig_0815010", "type": "orig", "text": "當＝常【宮】"}
{"id": null, "n": "0815011", "target": "#nkr_note_orig_0815011", "type": "orig", "text": "〔病〕－【三】【宮】"}
{"id": null, "n": "0815012", "target": "#nkr_note_orig_0815012", "type": "orig", "text": "惱＝性【三】【宮】"}
{"id": null, "n": "0816001", "target": "#nkr_note_orig_0816001", "type": "orig", "text": "我＝彼【明】"}
{"id": null, "n": "0816002", "target": "#nkr_note_orig_0816002", "type": "orig", "text": "明註曰一南藏作自"}
{"id": null, "n": "0816003", "target": "#nkr_note_orig_0816003", "type": "orig", "text": "妄＝淨【三】【宮】"}
{"id": null, "n": "0816004", "target": "#nkr_note_orig_0816004", "type": "orig", "text": "（作）＋受【三】【宮】"}
{"id": null, "n": "0816005", "target": "#nkr_note_orig_0816005", "type": "orig", "text": "猗＝倚【元】【明】下同"}
{"id": null, "n": "0816006", "target": "#nkr_note_orig_0816006", "type": "orig", "text": "合＝會【三】【宮】"}
{"id": null, "n": "0816007", "target": "#nkr_note_orig_0816007", "type": "orig", "text": "誑＝狂【三】【宮】"}
{"id": null, "n": "0816008", "target": "#nkr_note_orig_0816008", "type": "orig", "text": "障＝彰【三】【宮】"}
{"id": null, "n": "0816009", "target": "#nkr_note_orig_0816009", "type": "orig", "text": "滿＝懣【三】【宮】"}
{"id": null, "n": "0816010", "target": "#nkr_note_orig_0816010", "type": "orig", "text": "主＝住【三】【宮】"}
{"id": null, "n": "0816011", "target": "#nkr_note_orig_0816011", "type": "orig", "text": "知＋（為）【三】【宮】"}
{"id": null, "n": "0816012", "target": "#nkr_note_orig_0816012", "type": "orig", "text": "輒＝轉【三】【宮】"}
{"id": null, "n": "0816013", "target": "#nkr_note_orig_0816013", "type": "orig", "text": "（行）＋法【三】【宮】"}
{"id": null, "n": "0816014", "target": "#nkr_note_orig_0816014", "type": "orig", "text": "報＋（報）【三】【宮】"}
{"id": null, "n": "0816015", "target": "#nkr_note_orig_0816015", "type": "orig", "text": "家＝像【三】【宮】"}
{"id": null, "n": "0816016", "target": "#nkr_note_orig_0816016", "type": "orig", "text": "習＝集【三】【宮】"}
{"id": null, "n": "0816017", "target": "#nkr_note_orig_0816017", "type": "orig", "text": "畫＝盡【明】【宮】"}
{"id": null, "n": "0816018", "target": "#nkr_note_orig_0816018", "type": "orig", "text": "現＝見【三】【宮】"}
