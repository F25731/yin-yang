{"id": null, "n": null, "target": null, "type": "cf1", "text": "K37n1371_p0290c08"}
{"id": null, "n": "0610002", "target": "#nkr_note_mod_0610002", "type": "mod", "text": "一卷【大】，〔－〕【甲】"}
{"id": null, "n": "0610003", "target": "#nkr_note_mod_0610003", "type": "mod", "text": "乃【大】，及【甲】，彼【校異-甲】"}
{"id": null, "n": "0610004", "target": "#nkr_note_mod_0610004", "type": "mod", "text": "恒【大】，應【甲】"}
{"id": null, "n": "0611001a", "target": "#nkr_note_mod_0611001a", "type": "mod", "text": "如佛法亦然如法供養然【大】，佛法既無窮供養悉周遍【校異-甲】"}
{"id": null, "n": "0611001b", "target": "#nkr_note_mod_0611001b", "type": "mod", "text": "一切皆無量【大】，一心恒供養【校異-甲】"}
{"id": null, "n": "0611002", "target": "#nkr_note_mod_0611002", "type": "mod", "text": "敬禮諸如來【大】，普禮佛法海【校異-甲】"}
{"id": null, "n": "0611003", "target": "#nkr_note_mod_0611003", "type": "mod", "text": "曩【大】，娜【校異-甲】"}
{"id": null, "n": "0611004", "target": "#nkr_note_mod_0611004", "type": "mod", "text": "二【大】，一【考偽-甲】"}
{"id": null, "n": "0611005", "target": "#nkr_note_mod_0611005", "type": "mod", "text": "除滅皆【大】，滅盡令【校異-甲】"}
{"id": null, "n": "0611006", "target": "#nkr_note_mod_0611006", "type": "mod", "text": "真言曰【大】＊，〔－〕【校異-甲】＊"}
{"id": null, "n": "0611007", "target": "#nkr_note_mod_0611007", "type": "mod", "text": "唵【大】＊，〔－〕【校異-甲】＊"}
{"id": null, "n": "0611008", "target": "#nkr_note_mod_0611008", "type": "mod", "text": "𠻴一【大】，囉二【甲】"}
{"id": null, "n": "0611009", "target": "#nkr_note_mod_0611009", "type": "mod", "text": "（即當…曰）八字【大】，字想安於二乳即誦開心真言每誦掣開心戶【校異-甲】"}
{"id": null, "n": "0611010", "target": "#nkr_note_mod_0611010", "type": "mod", "text": "召入於【大】，即誦召入【校異-甲】"}
{"id": null, "n": "0611011", "target": "#nkr_note_mod_0611011", "type": "mod", "text": "跓【大】，拄【甲】"}
{"id": null, "n": "0611012", "target": "#nkr_note_mod_0611012", "type": "mod", "text": "智【大】，智以附拄心門【校異-甲】"}
{"id": null, "n": "0611013", "target": "#nkr_note_mod_0611013", "type": "mod", "text": "誦【大】＊，即誦【校異-甲】＊"}
{"id": null, "n": "0611014", "target": "#nkr_note_mod_0611014", "type": "mod", "text": "𤚥【大】，鑁【校異-甲】"}
{"id": null, "n": "0611015", "target": "#nkr_note_mod_0611015", "type": "mod", "text": "結已【大】，縛以【校異-甲】"}
{"id": null, "n": "0611016", "target": "#nkr_note_mod_0611016", "type": "mod", "text": "反【大】，交【校異-甲】"}
{"id": null, "n": "0611017", "target": "#nkr_note_mod_0611017", "type": "mod", "text": "復當誦真言曰【大】，〔－〕【甲】"}
{"id": null, "n": "0611018", "target": "#nkr_note_mod_0611018", "type": "mod", "text": "金【大】＊，即誦金【校異-甲】＊"}
{"id": null, "n": "0611019", "target": "#nkr_note_mod_0611019", "type": "mod", "text": "吒【大】，吒半音呼【校異-甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "半音呼"}
{"id": null, "n": "0611020", "target": "#nkr_note_mod_0611020", "type": "mod", "text": "專注實相理【大】，加持修行者【校異-甲】"}
{"id": null, "n": "0611021", "target": "#nkr_note_mod_0611021", "type": "mod", "text": "那【大】，娜【校異-甲】"}
{"id": null, "n": "0612001", "target": "#nkr_note_mod_0612001", "type": "mod", "text": "虛空瑜伽故【大】，真實瑜伽教【校異-甲】"}
{"id": null, "n": "0612002", "target": "#nkr_note_mod_0612002", "type": "mod", "text": "令【大】，〔－〕【考偽-甲】"}
