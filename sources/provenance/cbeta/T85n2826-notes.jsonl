{"id": null, "n": null, "target": null, "type": null, "text": "一名慈悲集"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X73n1456_p0496b03"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T37n1754_p0305a19"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T47n1974_p0375c11"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "AC6203_002_0025a19"}
{"id": null, "n": "1236002", "target": "#nkr_note_mod_1236002", "type": "mod", "text": "一【大】，二【甲】"}
{"id": null, "n": "1237002", "target": "#nkr_note_mod_1237002", "type": "mod", "text": "抵【大】，控【考偽-甲】"}
{"id": null, "n": "1237004", "target": "#nkr_note_mod_1237004", "type": "mod", "text": "夫【大】，大【甲】"}
{"id": null, "n": "1237005", "target": "#nkr_note_mod_1237005", "type": "mod", "text": "足【大】，之【考偽-甲】"}
{"id": null, "n": "1237006", "target": "#nkr_note_mod_1237006", "type": "mod", "text": "據【大】，諸【考偽-甲】"}
{"id": null, "n": "1238001", "target": "#nkr_note_mod_1238001", "type": "mod", "text": "人【大】，大【考偽-甲】"}
{"id": null, "n": "1239001", "target": "#nkr_note_mod_1239001", "type": "mod", "text": "菩薩【大】，聲聞【考偽-甲】"}
{"id": null, "n": "1239002", "target": "#nkr_note_mod_1239002", "type": "mod", "text": "王【大】，法【甲】"}
{"id": null, "n": "1239004", "target": "#nkr_note_mod_1239004", "type": "mod", "text": "時【大】，法【甲】"}
{"id": null, "n": "1240002", "target": "#nkr_note_mod_1240002", "type": "mod", "text": "今【大】＊，令【甲】＊"}
{"id": null, "n": "1240003", "target": "#nkr_note_mod_1240003", "type": "mod", "text": "亡【大】，無【考偽-甲】"}
{"id": null, "n": "1241001", "target": "#nkr_note_mod_1241001", "type": "mod", "text": "唯【大】，獨【甲】"}
{"id": null, "n": "1236001", "target": "#nkr_note_orig_1236001", "type": "orig", "text": "【原】朝鮮桐花寺藏刊本，【甲】大屋德城氏著鮮支巡禮行之內"}
{"id": null, "n": "1236002", "target": "#nkr_note_orig_1236002", "type": "orig", "text": "一＝二【甲】"}
{"id": null, "n": "1237001", "target": "#nkr_note_orig_1237001", "type": "orig", "text": "以下第六紙缺丁"}
{"id": null, "n": "1237002", "target": "#nkr_note_orig_1237002", "type": "orig", "text": "抵＝控ヵ【甲】"}
{"id": null, "n": "1237003", "target": "#nkr_note_orig_1237003", "type": "orig", "text": "以下第九，十之二紙缺丁"}
{"id": null, "n": "1237004", "target": "#nkr_note_orig_1237004", "type": "orig", "text": "夫＝大【甲】"}
{"id": null, "n": "1237005", "target": "#nkr_note_orig_1237005", "type": "orig", "text": "足＝之ヵ【甲】"}
{"id": null, "n": "1237006", "target": "#nkr_note_orig_1237006", "type": "orig", "text": "據＝諸ヵ【甲】"}
{"id": null, "n": "1237007", "target": "#nkr_note_orig_1237007", "type": "orig", "text": "以下第十三，十四，十五，十六之四紙缺丁"}
{"id": null, "n": "1237008", "target": "#nkr_note_orig_1237008", "type": "orig", "text": "堪然乃至無量壽佛少三百六字依甲本補載之"}
{"id": null, "n": "1238001", "target": "#nkr_note_orig_1238001", "type": "orig", "text": "人＝大ヵ【甲】"}
{"id": null, "n": "1239001", "target": "#nkr_note_orig_1239001", "type": "orig", "text": "菩薩＝聲聞ヵ【甲】"}
{"id": null, "n": "1239002", "target": "#nkr_note_orig_1239002", "type": "orig", "text": "王＝法【甲】"}
{"id": null, "n": "1239003", "target": "#nkr_note_orig_1239003", "type": "orig", "text": "以下第二十三，二十四之二紙缺丁"}
{"id": null, "n": "1239004", "target": "#nkr_note_orig_1239004", "type": "orig", "text": "時＝法【甲】"}
{"id": null, "n": "1240001", "target": "#nkr_note_orig_1240001", "type": "orig", "text": "以下第三十一乃至三十八之八紙缺丁"}
{"id": null, "n": "1240002", "target": "#nkr_note_orig_1240002", "type": "orig", "text": "今＝令【甲】＊"}
{"id": null, "n": "1240003", "target": "#nkr_note_orig_1240003", "type": "orig", "text": "亡＝無ヵ【甲】"}
{"id": null, "n": "1241001", "target": "#nkr_note_orig_1241001", "type": "orig", "text": "唯＝獨【甲】"}
{"id": null, "n": "1241002", "target": "#nkr_note_orig_1241002", "type": "orig", "text": "得見乃至往生安樂三百六字依甲本補載之"}
{"id": null, "n": "1242001", "target": "#nkr_note_orig_1242001", "type": "orig", "text": "第四十九紙以下缺"}
{"id": null, "n": "1236b2201", "target": "#nkr_note_add_1236b2201", "type": "add", "text": "土【CB】，士【大】"}
{"id": null, "n": "1238a0601", "target": "#nkr_note_add_1238a0601", "type": "add", "text": "恩【CB】，思【大】"}
{"id": null, "n": "1238a2901", "target": "#nkr_note_add_1238a2901", "type": "add", "text": "男【CB】，界【大】"}
{"id": null, "n": "1240a2601", "target": "#nkr_note_add_1240a2601", "type": "add", "text": "榖【CB】，穀【大】"}
