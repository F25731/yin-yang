{"id": null, "n": "1221010", "target": "#nkr_note_orig_1221010", "type": "orig", "text": "令＝今？"}
{"id": null, "n": "1221011", "target": "#nkr_note_orig_1221011", "type": "orig", "text": "􄗱＝􄗲【甲】"}
{"id": null, "n": "1221012", "target": "#nkr_note_orig_1221012", "type": "orig", "text": "􄙻􄽙＝􆶩􄙖"}
