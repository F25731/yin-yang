{"id": null, "n": "0912013", "target": "#nkr_note_mod_0912013", "type": "mod", "text": "經【大】，經一名勝福往生淨土經【元】【明】，經二名勝福往生淨土經【宋】"}
{"id": null, "n": "0912014", "target": "#nkr_note_mod_0912014", "type": "mod", "text": "大【大】，〔－〕【宋】【明】"}
{"id": null, "n": "0912015", "target": "#nkr_note_mod_0912015", "type": "mod", "text": "般【大】，尼【宋】【元】【明】"}
{"id": null, "n": "0912016", "target": "#nkr_note_mod_0912016", "type": "mod", "text": "讚歎【大】，稱讚【宋】【元】【明】"}
{"id": null, "n": "0912017", "target": "#nkr_note_mod_0912017", "type": "mod", "text": "王【大】，王一名大自在勝經【宋】【元】【明】"}
{"id": null, "n": "0912018", "target": "#nkr_note_mod_0912018", "type": "mod", "text": "命【大】，念【宋】【元】【明】"}
{"id": null, "n": "0912012", "target": "#nkr_note_orig_0912012", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0912013", "target": "#nkr_note_orig_0912013", "type": "orig", "text": "經＋（一名勝福往生淨土經）九字【三】，但宋本一作二"}
{"id": null, "n": "0912014", "target": "#nkr_note_orig_0912014", "type": "orig", "text": "〔大〕－【宋】【明】"}
{"id": null, "n": "0912015", "target": "#nkr_note_orig_0912015", "type": "orig", "text": "般＝尼【三】"}
{"id": null, "n": "0912016", "target": "#nkr_note_orig_0912016", "type": "orig", "text": "讚歎＝稱讚【三】"}
{"id": null, "n": "0912017", "target": "#nkr_note_orig_0912017", "type": "orig", "text": "王＋（一名大自在勝經）七字【三】"}
{"id": null, "n": "0912018", "target": "#nkr_note_orig_0912018", "type": "orig", "text": "命＝念【三】"}
{"id": null, "n": "0912c0101", "target": "#nkr_note_add_0912c0101", "type": "add", "text": "剌【CB】【麗-CB】，刺【大】"}
