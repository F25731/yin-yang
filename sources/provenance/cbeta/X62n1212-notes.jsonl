{"id": null, "n": null, "target": null, "type": null, "text": "第五篇"}
{"id": null, "n": null, "target": null, "type": null, "text": "江南金壇人，順治四年進士。"}
{"id": null, "n": null, "target": null, "type": null, "text": "湖廣黃岡人，順治六年進士。"}
{"id": null, "n": null, "target": null, "type": null, "text": "節錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "河南登封人，順治八年進士。"}
{"id": null, "n": null, "target": null, "type": null, "text": "節錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "河南河內人，順治九年進士。"}
{"id": null, "n": null, "target": null, "type": null, "text": "江南山陽人，順治六年進士。"}
{"id": null, "n": null, "target": null, "type": null, "text": "節錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "河南睢陽人，順治九年進士，諡文正。"}
{"id": null, "n": null, "target": null, "type": null, "text": "江南長洲人，順治十一年副貢生。"}
{"id": null, "n": null, "target": null, "type": null, "text": "浙江錢塘人，康熙三十九年進士，諡端恪。"}
{"id": null, "n": null, "target": null, "type": null, "text": "節錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "山西興縣人，康熙五十二年進士，諡文定。"}
{"id": null, "n": null, "target": null, "type": null, "text": "山西永寧人，諡清端。"}
{"id": null, "n": null, "target": null, "type": null, "text": "奉天人，隷正黃旗。"}
{"id": null, "n": null, "target": null, "type": null, "text": "節錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "江南太倉人，康熙六十年進士。"}
{"id": null, "n": null, "target": null, "type": null, "text": "直隷容城人，明萬歷中舉人。"}
{"id": null, "n": null, "target": null, "type": null, "text": "陝西󴏵屋人。"}
{"id": null, "n": null, "target": null, "type": null, "text": "江南南豐人，明季諸生。"}
{"id": null, "n": null, "target": null, "type": null, "text": "節錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "浙江錢唐人，明崇正中舉人。"}
{"id": null, "n": null, "target": null, "type": null, "text": "江南長洲人，明崇正中諸生。"}
{"id": null, "n": null, "target": null, "type": null, "text": "江南無錫人，明季諸生。"}
{"id": null, "n": null, "target": null, "type": null, "text": "江南歙縣人。"}
{"id": null, "n": null, "target": null, "type": null, "text": "江西贛州諸生。"}
