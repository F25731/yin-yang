{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至即見如來"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至生實信不"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛告須至以此為實"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "當知是至無量福德"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "何以故至無非法相"}
{"id": null, "n": null, "target": null, "type": null, "text": "何以故至眾生壽者"}
{"id": null, "n": null, "target": null, "type": null, "text": "是故不至何况非法"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至所說法耶"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至如來可說"}
{"id": null, "n": null, "target": null, "type": null, "text": "何以故至而有差別"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至說福德多"}
{"id": null, "n": null, "target": null, "type": null, "text": "若復有至即非佛法"}
{"id": null, "n": null, "target": null, "type": null, "text": "四"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至名須沱洹"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至名斯陀含"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至名阿那含"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至眾生壽者"}
{"id": null, "n": null, "target": null, "type": null, "text": "世尊佛至阿蘭那行"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛告須至實無所得"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至是名莊嚴"}
{"id": null, "n": null, "target": null, "type": null, "text": "是故須至而生其心"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至是名大身"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至甚多世尊"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛告須至勝前福德"}
{"id": null, "n": null, "target": null, "type": null, "text": "復次須至如佛塔廟"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "何况有至希有之法"}
{"id": null, "n": null, "target": null, "type": null, "text": "若是經至尊重弟子"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "爾時須至云何奉持"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛告須至汝當奉持"}
{"id": null, "n": null, "target": null, "type": null, "text": "所以者至若波羅蜜"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "五"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至如來無說"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至是名世界"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至三十二相"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至其福甚多"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "爾時須至如是之經"}
{"id": null, "n": null, "target": null, "type": null, "text": "世尊若至說名實相"}
{"id": null, "n": null, "target": null, "type": null, "text": "世尊我至即名諸佛"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛告須至如是"}
{"id": null, "n": null, "target": null, "type": null, "text": "若復有至甚為希有"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "何以故至一波羅蜜"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至辱波羅蜜"}
{"id": null, "n": null, "target": null, "type": null, "text": "何以故至無壽者相"}
{"id": null, "n": null, "target": null, "type": null, "text": "是故須至三菩提心"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "不應住至如是布施"}
{"id": null, "n": null, "target": null, "type": null, "text": "如來說至即非眾生"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至不異語者"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至無實無虛"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至即無所見"}
{"id": null, "n": null, "target": null, "type": null, "text": "若菩薩至見種種色"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至無邊功德"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至上乘者說"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "若有至三菩提"}
{"id": null, "n": null, "target": null, "type": null, "text": "何以故至為人解說"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至而散其處"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "復次至三菩提"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至所不能及"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至不可思議"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "爾時須至降伏其心"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛告須至即非菩薩"}
{"id": null, "n": null, "target": null, "type": null, "text": "所以者至菩提心者"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩至三菩提"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至釋迦牟尼"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "何以至三藐三菩提"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至名一切法"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至是名大身"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至無壽者"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至是名莊嚴"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩至是菩薩"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩至有佛眼"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩至不可得"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至甚多"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩至福德多"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至具足色身"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至諸相具足"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至是名說法"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "爾時"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛言"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至無所得耶"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛言如是如是"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩至三菩提"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "復次至三菩提"}
{"id": null, "n": null, "target": null, "type": null, "text": "以無我至是名善法"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩至不能及"}
{"id": null, "n": null, "target": null, "type": null, "text": "五"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至是名凡夫"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提見如來"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至斷滅相"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩至福德故"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩至受福德"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩至是故說不受福德"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至故名如來"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至貪著其事"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至名壽者見"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至是名法相"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "須菩提至其福勝彼"}
{"id": null, "n": null, "target": null, "type": null, "text": "云何至如是觀"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛說至奉行終"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "此准道安，經無豐約，悉分為三，謂序．正．流通者是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "將釋此序義分為二：一、明建立之因，二、明建立之意。"}
{"id": null, "n": null, "target": null, "type": null, "text": "建立因者，正明如是\n等言，因何而立？蓋當金河顧命之初，鶴樹潛輝之際，阿難悲哀。時有無貧尊者，語阿難言：汝是持佛法人，\n且須裁抑，宜當往佛，請問後事。阿難曰：云何後事？尊者答曰：世尊在日，以佛為師；世尊滅後，以誰為師？世\n尊在日，依世尊住；世尊滅後，依何而住？惡性比丘，佛在之日，佛自調伏；佛滅度後，如何調伏？遐益當來，理\n宜結集，一切經首，應置何語？阿難承教，一一咨問。佛答之曰：我滅度後，依四念處住，以戒為師，默擯惡性\n比丘，一切經首皆安。如是我聞：一時佛在某處，與某眾若干。此正第四問也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "建立之意者，亦有三：一、斷疑\n故。乃結集時，阿難昇座，欲宣佛語，感得相好同佛。爾時眾起三疑：一、疑世尊重起說法；二、疑他方佛來；三、\n疑阿難成佛。故舉如是我聞等，則三疑頓斷。二、息諍故。若不推從於佛，言自制作，則諸羅漢德業頗齊，未\n免諍論。今稱佛說，何諍之有？三、異邪故不同。外道經初，安阿歐二字。蓋阿者言無，歐者言有。彼謂萬法雖\n多，不出有無，置之經初，以之為吉。以初吉故，令中後亦吉。今則不爾，故云異邪。"}
{"id": null, "n": null, "target": null, "type": null, "text": "首約佛法廣釋降心離相竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X22n0427_p0778a15"}
