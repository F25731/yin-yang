{"id": null, "n": null, "target": null, "type": null, "text": "其三"}
{"id": null, "n": null, "target": null, "type": null, "text": "通佛四運"}
{"id": null, "n": null, "target": null, "type": null, "text": "元本第一卷終"}
{"id": null, "n": null, "target": null, "type": null, "text": "四悉檀名義出大論，蓋謂以大悲用四法徧施，令眾生得益也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "元本\n第二卷終"}
{"id": null, "n": null, "target": null, "type": null, "text": "其一"}
