{"id": null, "n": "0443007", "target": "#nkr_note_mod_0443007", "type": "mod", "text": "新為…錄【大】，新為失譯【宋】，新附三秦錄失譯師名【元】【明】"}
{"id": null, "n": "0443008", "target": "#nkr_note_mod_0443008", "type": "mod", "text": "捉【大】，旋【聖】"}
{"id": null, "n": "0443009", "target": "#nkr_note_mod_0443009", "type": "mod", "text": "獼【大】，猨【宋】【元】【明】"}
{"id": null, "n": "0444001", "target": "#nkr_note_mod_0444001", "type": "mod", "text": "花【大】，等【宋】【元】"}
{"id": null, "n": "0444002", "target": "#nkr_note_mod_0444002", "type": "mod", "text": "前【大】，與諸大眾前【宋】【元】【明】"}
{"id": null, "n": "0444003", "target": "#nkr_note_mod_0444003", "type": "mod", "text": "殖【大】，植【宋】【元】【明】"}
