{"id": null, "n": "0444006", "target": "#nkr_note_mod_0444006", "type": "mod", "text": "唯【大】＊，惟【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0444007", "target": "#nkr_note_mod_0444007", "type": "mod", "text": "得【大】，我【聖】"}
{"id": null, "n": "0444008", "target": "#nkr_note_mod_0444008", "type": "mod", "text": "念【大】，為【宋】【元】，惟【明】"}
{"id": null, "n": "0444009", "target": "#nkr_note_mod_0444009", "type": "mod", "text": "披【大】，被【宋】【元】【明】"}
