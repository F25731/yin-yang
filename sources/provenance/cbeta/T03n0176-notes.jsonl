{"id": null, "n": "0444011", "target": "#nkr_note_mod_0444011", "type": "mod", "text": "至【大】，〔－〕【聖】"}
{"id": null, "n": "0444012", "target": "#nkr_note_mod_0444012", "type": "mod", "text": "趣趣【大】，勝善【宋】【元】【明】"}
{"id": null, "n": "0444013", "target": "#nkr_note_mod_0444013", "type": "mod", "text": "性【大】，生【宋】【元】【明】【聖】"}
{"id": null, "n": "0444014", "target": "#nkr_note_mod_0444014", "type": "mod", "text": "濩【大】，鑊【宋】【元】【明】"}
{"id": null, "n": "0444015", "target": "#nkr_note_mod_0444015", "type": "mod", "text": "人【大】，上【聖】"}
{"id": null, "n": "0444016", "target": "#nkr_note_mod_0444016", "type": "mod", "text": "言曰【大】，白言【宋】【元】【明】【聖】"}
{"id": null, "n": "0445001", "target": "#nkr_note_mod_0445001", "type": "mod", "text": "申【大】，伸【元】【明】"}
