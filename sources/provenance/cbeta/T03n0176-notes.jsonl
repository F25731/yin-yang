{"id": null, "n": "0446001", "target": "#nkr_note_mod_0446001", "type": "mod", "text": "復【大】，〔－〕【聖】"}
{"id": null, "n": "0446002", "target": "#nkr_note_mod_0446002", "type": "mod", "text": "提【大】，薩【聖】"}
{"id": null, "n": "0446003", "target": "#nkr_note_mod_0446003", "type": "mod", "text": "正【大】，為正【聖】"}
{"id": null, "n": "0446004", "target": "#nkr_note_mod_0446004", "type": "mod", "text": "時會【大】，會時【聖】"}
