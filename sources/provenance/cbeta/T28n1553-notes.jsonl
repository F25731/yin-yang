{"id": null, "n": "0966001", "target": "#nkr_note_mod_0966001", "type": "mod", "text": "尊者瞿沙造【大】＊，〔－〕【宮】＊"}
{"id": null, "n": "0966002", "target": "#nkr_note_mod_0966002", "type": "mod", "text": "（曹魏…名）八字【大】＊，失譯【宮】＊"}
{"id": null, "n": "0966003", "target": "#nkr_note_mod_0966003", "type": "mod", "text": "三藏【大】＊，人【明】＊"}
{"id": null, "n": "0966004", "target": "#nkr_note_mod_0966004", "type": "mod", "text": "愛【大】，受【宋】【元】【明】【宮】"}
{"id": null, "n": "0966005", "target": "#nkr_note_mod_0966005", "type": "mod", "text": "三十【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0966006", "target": "#nkr_note_mod_0966006", "type": "mod", "text": "阿毘曇甘露味【大】＊，〔－〕【明】＊"}
{"id": null, "n": "0966007", "target": "#nkr_note_mod_0966007", "type": "mod", "text": "地獄【大】，地獄道【宋】【元】【明】【宮】"}
{"id": null, "n": "0966008", "target": "#nkr_note_mod_0966008", "type": "mod", "text": "畜生【大】，畜生道【宋】【元】【明】【宮】"}
{"id": null, "n": "0966009", "target": "#nkr_note_mod_0966009", "type": "mod", "text": "界【大】，界有【宋】【元】【明】【宮】"}
{"id": null, "n": "0966010", "target": "#nkr_note_mod_0966010", "type": "mod", "text": "四王天【大】，四天王【宋】【元】【明】【宮】"}
{"id": null, "n": "0966011", "target": "#nkr_note_mod_0966011", "type": "mod", "text": "一【大】，九【宋】【元】【明】【宮】"}
{"id": null, "n": "0966012", "target": "#nkr_note_mod_0966012", "type": "mod", "text": "時【大】＊，時披【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0966013", "target": "#nkr_note_mod_0966013", "type": "mod", "text": "犁【大】＊，黎【宋】【元】【宮】＊"}
{"id": null, "n": "0967001", "target": "#nkr_note_mod_0967001", "type": "mod", "text": "天上【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0967002", "target": "#nkr_note_mod_0967002", "type": "mod", "text": "魯臘【大】＊，合會【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0967003", "target": "#nkr_note_mod_0967003", "type": "mod", "text": "摩呵【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0967004", "target": "#nkr_note_mod_0967004", "type": "mod", "text": "多般【大】＊，摩訶魯臘【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0967005", "target": "#nkr_note_mod_0967005", "type": "mod", "text": "多槃【大】＊，那【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0967006", "target": "#nkr_note_mod_0967006", "type": "mod", "text": "歲【大】，歲波多般泥黎【宋】【元】【宮】，歲波多般泥犁【明】"}
{"id": null, "n": "0967007", "target": "#nkr_note_mod_0967007", "type": "mod", "text": "僧渴【大】，增【宋】【元】【明】【宮】"}
{"id": null, "n": "0967008", "target": "#nkr_note_mod_0967008", "type": "mod", "text": "弗【大】，佛【明】"}
{"id": null, "n": "0967009", "target": "#nkr_note_mod_0967009", "type": "mod", "text": "急【大】，煩【宋】【元】【明】【宮】"}
{"id": null, "n": "0967010", "target": "#nkr_note_mod_0967010", "type": "mod", "text": "痛想【大】，想痛【宋】【元】【明】【宮】"}
{"id": null, "n": "0967011", "target": "#nkr_note_mod_0967011", "type": "mod", "text": "想【大】，想處【宋】【元】【明】【宮】"}
{"id": null, "n": "0967012", "target": "#nkr_note_mod_0967012", "type": "mod", "text": "有【大】，〔－〕【宮】"}
{"id": null, "n": "0967013", "target": "#nkr_note_mod_0967013", "type": "mod", "text": "眾【大】，〔－〕【宮】"}
{"id": null, "n": "0967014", "target": "#nkr_note_mod_0967014", "type": "mod", "text": "意【大】，行【宋】【元】【明】【宮】"}
{"id": null, "n": "0968001", "target": "#nkr_note_mod_0968001", "type": "mod", "text": "後行【大】，行後【宋】【元】【明】【宮】"}
{"id": null, "n": "0968002", "target": "#nkr_note_mod_0968002", "type": "mod", "text": "法【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0968003", "target": "#nkr_note_mod_0968003", "type": "mod", "text": "故作不熟不得報【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0968004", "target": "#nkr_note_mod_0968004", "type": "mod", "text": "三【大】，二【元】【明】"}
{"id": null, "n": "0968005", "target": "#nkr_note_mod_0968005", "type": "mod", "text": "若【大】，苦【明】【宮】"}
{"id": null, "n": "0968006", "target": "#nkr_note_mod_0968006", "type": "mod", "text": "竟【CB】【宮-CB】【思溪-CB】【宋】【元】【明】【宮】，意【大】"}
