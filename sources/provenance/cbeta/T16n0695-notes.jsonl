{"id": null, "n": null, "target": null, "type": null, "text": "此下三十一行經文丹本所無，宋本自有，存之"}
{"id": null, "n": "0796011", "target": "#nkr_note_mod_0796011", "type": "mod", "text": "灌洗佛形像【大】＊，灌佛【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0796012", "target": "#nkr_note_mod_0796012", "type": "mod", "text": "經【大】，經一名灌洗佛形像經【元】【明】"}
{"id": null, "n": "0796013", "target": "#nkr_note_mod_0796013", "type": "mod", "text": "以【大】，太子以【宋】【元】【明】【宮】"}
{"id": null, "n": "0796014", "target": "#nkr_note_mod_0796014", "type": "mod", "text": "唯【大】，惟【宋】【元】【明】【宮】"}
{"id": null, "n": "0796015", "target": "#nkr_note_mod_0796015", "type": "mod", "text": "群氓【大】，群萌【宋】【元】【明】【宮】"}
{"id": null, "n": "0796016", "target": "#nkr_note_mod_0796016", "type": "mod", "text": "出家【大】，去家【宋】【元】【明】【宮】"}
{"id": null, "n": "0796017", "target": "#nkr_note_mod_0796017", "type": "mod", "text": "而【大】，入【元】【明】"}
{"id": null, "n": "0796018", "target": "#nkr_note_mod_0796018", "type": "mod", "text": "反【大】，返【宋】【元】【明】【宮】"}
{"id": null, "n": "0796019", "target": "#nkr_note_mod_0796019", "type": "mod", "text": "作【大】，為【宋】【元】【明】【宮】"}
{"id": null, "n": "0796020", "target": "#nkr_note_mod_0796020", "type": "mod", "text": "若【大】，業【宋】【元】【明】【宮】"}
{"id": null, "n": "0797001", "target": "#nkr_note_mod_0797001", "type": "mod", "text": "永【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0797002", "target": "#nkr_note_mod_0797002", "type": "mod", "text": "苦【大】，者【宋】【元】【明】【宮】"}
{"id": null, "n": "0797003", "target": "#nkr_note_mod_0797003", "type": "mod", "text": "者【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0797004", "target": "#nkr_note_mod_0797004", "type": "mod", "text": "（此下…如佛）四百四十八字【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0797005", "target": "#nkr_note_mod_0797005", "type": "mod", "text": "（此經…存）百二十四字【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0796011", "target": "#nkr_note_orig_0796011", "type": "orig", "text": "灌洗佛形象＝灌佛【三】【宮】＊"}
{"id": null, "n": "0796012", "target": "#nkr_note_orig_0796012", "type": "orig", "text": "經＋（一名灌洗佛形像經）【元】【明】"}
{"id": null, "n": "0796013", "target": "#nkr_note_orig_0796013", "type": "orig", "text": "（太子）＋以【三】【宮】"}
{"id": null, "n": "0796014", "target": "#nkr_note_orig_0796014", "type": "orig", "text": "唯＝惟【三】【宮】"}
{"id": null, "n": "0796015", "target": "#nkr_note_orig_0796015", "type": "orig", "text": "群氓＝群萌【三】【宮】"}
{"id": null, "n": "0796016", "target": "#nkr_note_orig_0796016", "type": "orig", "text": "出家＝去家【三】【宮】"}
{"id": null, "n": "0796017", "target": "#nkr_note_orig_0796017", "type": "orig", "text": "而＝入【元】【明】"}
{"id": null, "n": "0796018", "target": "#nkr_note_orig_0796018", "type": "orig", "text": "反＝返【三】【宮】"}
{"id": null, "n": "0796019", "target": "#nkr_note_orig_0796019", "type": "orig", "text": "作＝為【三】【宮】"}
{"id": null, "n": "0796020", "target": "#nkr_note_orig_0796020", "type": "orig", "text": "若＝業【三】【宮】"}
{"id": null, "n": "0797001", "target": "#nkr_note_orig_0797001", "type": "orig", "text": "〔永〕－【三】【宮】"}
{"id": null, "n": "0797002", "target": "#nkr_note_orig_0797002", "type": "orig", "text": "苦＝者【三】【宮】"}
{"id": null, "n": "0797003", "target": "#nkr_note_orig_0797003", "type": "orig", "text": "〔者〕－【三】【宮】"}
{"id": null, "n": "0797004", "target": "#nkr_note_orig_0797004", "type": "orig", "text": "〔此下…如佛〕四百四十八字－【三】【宮】"}
{"id": null, "n": "0797005", "target": "#nkr_note_orig_0797005", "type": "orig", "text": "〔此經…存〕百二十四字－【三】【宮】"}
