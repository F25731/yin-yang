{"id": null, "n": null, "target": null, "type": null, "text": "摩竭附邊"}
{"id": null, "n": "0843014", "target": "#nkr_note_mod_0843014", "type": "mod", "text": "人名【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0843015", "target": "#nkr_note_mod_0843015", "type": "mod", "text": "附【大】，今附【宋】【元】【明】"}
{"id": null, "n": "0843016", "target": "#nkr_note_mod_0843016", "type": "mod", "text": "多【大】，幻【宋】【元】【明】"}
{"id": null, "n": "0843017", "target": "#nkr_note_mod_0843017", "type": "mod", "text": "無【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0843018", "target": "#nkr_note_mod_0843018", "type": "mod", "text": "妬嫉【大】，嫉妬【宋】【元】【明】"}
{"id": null, "n": "0843019", "target": "#nkr_note_mod_0843019", "type": "mod", "text": "染【大】，染師【宋】【元】【明】"}
{"id": null, "n": "0843020", "target": "#nkr_note_mod_0843020", "type": "mod", "text": "清淨【大】，以漬之浣【宋】【元】【明】"}
{"id": null, "n": "0844001", "target": "#nkr_note_mod_0844001", "type": "mod", "text": "鹵【大】，鹵土【宋】【元】【明】"}
{"id": null, "n": "0844002", "target": "#nkr_note_mod_0844002", "type": "mod", "text": "上【大】，土【宋】【元】【明】"}
{"id": null, "n": "0844003", "target": "#nkr_note_mod_0844003", "type": "mod", "text": "意【大】，意着【宋】【元】【明】"}
{"id": null, "n": "0844004", "target": "#nkr_note_mod_0844004", "type": "mod", "text": "無【大】，無量【宋】【元】【明】"}
{"id": null, "n": "0844005", "target": "#nkr_note_mod_0844005", "type": "mod", "text": "行【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0844006", "target": "#nkr_note_mod_0844006", "type": "mod", "text": "行【大】，行清淨【宋】【元】【明】"}
{"id": null, "n": "0844007", "target": "#nkr_note_mod_0844007", "type": "mod", "text": "語【大】，言【宋】【元】【明】"}
{"id": null, "n": "0844008", "target": "#nkr_note_mod_0844008", "type": "mod", "text": "當【大】，常【宋】【元】【明】"}
{"id": null, "n": "0844009", "target": "#nkr_note_mod_0844009", "type": "mod", "text": "水【大】，外【宋】【元】【明】"}
{"id": null, "n": "0844010", "target": "#nkr_note_mod_0844010", "type": "mod", "text": "持【大】，於【宋】【元】【明】"}
{"id": null, "n": "0844011", "target": "#nkr_note_mod_0844011", "type": "mod", "text": "歸【大】，樂【宋】【元】【明】"}
