{"id": null, "n": "0773004", "target": "#nkr_note_mod_0773004", "type": "mod", "text": "西天【大】，宋西天【明】"}
{"id": null, "n": "0773005", "target": "#nkr_note_mod_0773005", "type": "mod", "text": "譯經【大】，〔－〕【明】"}
{"id": null, "n": "0773006", "target": "#nkr_note_mod_0773006", "type": "mod", "text": "朝散【大】，朝請【宋】【元】【明】"}
{"id": null, "n": "0773007", "target": "#nkr_note_mod_0773007", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0773008", "target": "#nkr_note_mod_0773008", "type": "mod", "text": "涅盤【大】下同，涅槃【宋】下同【元】下同【明】下同"}
{"id": null, "n": "0773009", "target": "#nkr_note_mod_0773009", "type": "mod", "text": "彼【大】，復【元】【明】"}
{"id": null, "n": "0773010", "target": "#nkr_note_mod_0773010", "type": "mod", "text": "照【CB】【麗-CB】【宋】【元】【明】，極【大】"}
{"id": null, "n": "0774001", "target": "#nkr_note_mod_0774001", "type": "mod", "text": "勝【大】，妙【明】"}
{"id": null, "n": "0774002", "target": "#nkr_note_mod_0774002", "type": "mod", "text": "天【大】，大【明】"}
{"id": null, "n": "0774003", "target": "#nkr_note_mod_0774003", "type": "mod", "text": "若【大】，苦【明】"}
{"id": null, "n": "0774004", "target": "#nkr_note_mod_0774004", "type": "mod", "text": "愍【大】，悲【明】"}
{"id": null, "n": "0774005", "target": "#nkr_note_mod_0774005", "type": "mod", "text": "又【大】，入【元】【明】"}
{"id": null, "n": "0774006", "target": "#nkr_note_mod_0774006", "type": "mod", "text": "襪【大】，韈【明】"}
{"id": null, "n": "0774007", "target": "#nkr_note_mod_0774007", "type": "mod", "text": "常【大】，當【宋】【元】【明】"}
