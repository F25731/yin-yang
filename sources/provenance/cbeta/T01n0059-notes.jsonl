{"id": null, "n": null, "target": null, "type": null, "text": "出《中阿含》別翻"}
{"id": null, "n": "0855008", "target": "#nkr_note_mod_0855008", "type": "mod", "text": "出…別翻【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "出…別翻"}
{"id": null, "n": "0855009", "target": "#nkr_note_mod_0855009", "type": "mod", "text": "國居士【大】，優婆塞【宋】【元】【明】"}
{"id": null, "n": "0855010", "target": "#nkr_note_mod_0855010", "type": "mod", "text": "死亡【大】，無忘【宋】【元】【明】"}
{"id": null, "n": "0855011", "target": "#nkr_note_mod_0855011", "type": "mod", "text": "別【大】，則【宋】【元】【明】"}
{"id": null, "n": "0855012", "target": "#nkr_note_mod_0855012", "type": "mod", "text": "知【大】，之【宋】【元】"}
{"id": null, "n": "0855013", "target": "#nkr_note_mod_0855013", "type": "mod", "text": "奉【大】，受【宋】【元】【明】"}
{"id": null, "n": "0855008", "target": "#nkr_note_orig_0855008", "type": "orig", "text": "夾註〔出…別翻〕－【三】"}
{"id": null, "n": "0855009", "target": "#nkr_note_orig_0855009", "type": "orig", "text": "國居士＝優婆塞【三】"}
{"id": null, "n": "0855010", "target": "#nkr_note_orig_0855010", "type": "orig", "text": "死亡＝無忘【三】"}
{"id": null, "n": "0855011", "target": "#nkr_note_orig_0855011", "type": "orig", "text": "別＝則【三】"}
{"id": null, "n": "0855012", "target": "#nkr_note_orig_0855012", "type": "orig", "text": "知＝之【宋】【元】"}
{"id": null, "n": "0855013", "target": "#nkr_note_orig_0855013", "type": "orig", "text": "奉＝受【三】"}
