{"id": null, "n": "0108001", "target": "#nkr_note_mod_0108001", "type": "mod", "text": "（唐天竺…譯）十二字【大】，南天竺國沙門菩提留志等奉制譯【宋】【元】【明】【宮】，南天竺三藏菩提流志奉制譯【聖乙】"}
{"id": null, "n": "0108002", "target": "#nkr_note_mod_0108002", "type": "mod", "text": "童【大】下同，僮【聖乙】下同"}
{"id": null, "n": "0108003", "target": "#nkr_note_mod_0108003", "type": "mod", "text": "今【大】，念【聖乙】"}
{"id": null, "n": "0108004", "target": "#nkr_note_mod_0108004", "type": "mod", "text": "非耳境界【大】，〔－〕【聖乙】"}
{"id": null, "n": "0108005", "target": "#nkr_note_mod_0108005", "type": "mod", "text": "自【大】，〔－〕【聖乙】"}
{"id": null, "n": "0108006", "target": "#nkr_note_mod_0108006", "type": "mod", "text": "空【大】，〔－〕【聖】"}
{"id": null, "n": "0108007", "target": "#nkr_note_mod_0108007", "type": "mod", "text": "瞋【大】，瞋癡【明】"}
{"id": null, "n": "0108008", "target": "#nkr_note_mod_0108008", "type": "mod", "text": "惱【大】，惱性【宋】【元】【明】【宮】【聖】【聖乙】"}
{"id": null, "n": "0109001", "target": "#nkr_note_mod_0109001", "type": "mod", "text": "法【大】，如【聖乙】"}
{"id": null, "n": "0109002", "target": "#nkr_note_mod_0109002", "type": "mod", "text": "恒覺【大】，覺悟【宋】【元】【明】【宮】"}
{"id": null, "n": "0109003", "target": "#nkr_note_mod_0109003", "type": "mod", "text": "位【大】，住【宮】【聖】【聖乙】"}
{"id": null, "n": "0109004", "target": "#nkr_note_mod_0109004", "type": "mod", "text": "此是聲聞地【大】，〔－〕【宋】【元】【宮】【聖】【聖乙】"}
{"id": null, "n": "0109005", "target": "#nkr_note_mod_0109005", "type": "mod", "text": "地【大】，地此是菩薩地【明】"}
{"id": null, "n": "0109006", "target": "#nkr_note_mod_0109006", "type": "mod", "text": "切【大】，切法【宋】【元】【明】【宮】"}
{"id": null, "n": "0109007", "target": "#nkr_note_mod_0109007", "type": "mod", "text": "特鍾【大】，極重【宋】【宮】"}
{"id": null, "n": "0109008", "target": "#nkr_note_mod_0109008", "type": "mod", "text": "持【大】，待【明】"}
{"id": null, "n": "0109009", "target": "#nkr_note_mod_0109009", "type": "mod", "text": "言【大】，所言【宋】【元】【明】【宮】【聖】【聖乙】"}
{"id": null, "n": "0110001", "target": "#nkr_note_mod_0110001", "type": "mod", "text": "染【大】，深【聖】"}
{"id": null, "n": "0110002", "target": "#nkr_note_mod_0110002", "type": "mod", "text": "會【大】，界【宋】【宮】"}
{"id": null, "n": "0110003", "target": "#nkr_note_mod_0110003", "type": "mod", "text": "攢【大】，欑【宋】【元】【宮】【聖】"}
{"id": null, "n": "0110004", "target": "#nkr_note_mod_0110004", "type": "mod", "text": "笙【大】，箜【宋】【元】【明】【宮】"}
{"id": null, "n": "0110005", "target": "#nkr_note_mod_0110005", "type": "mod", "text": "鐘【大】，鍾【宋】【元】【明】【宮】"}
{"id": null, "n": "0110006", "target": "#nkr_note_mod_0110006", "type": "mod", "text": "矚【大】，囑【聖】【聖乙】"}
{"id": null, "n": "0111001", "target": "#nkr_note_mod_0111001", "type": "mod", "text": "以【大】，以此【宋】【元】【明】【宮】"}
{"id": null, "n": "0111002", "target": "#nkr_note_mod_0111002", "type": "mod", "text": "內【大】＊，納【明】＊"}
{"id": null, "n": "0111003", "target": "#nkr_note_mod_0111003", "type": "mod", "text": "今【大】，合【宋】，〔－〕【宮】"}
{"id": null, "n": "0111004", "target": "#nkr_note_mod_0111004", "type": "mod", "text": "唯【大】，惟【宋】【元】【明】【宮】【聖】【聖乙】"}
{"id": null, "n": "0111006", "target": "#nkr_note_mod_0111006", "type": "mod", "text": "（唐天竺…譯）十二字【大】，南天竺國沙門菩提留志等奉詔譯【宋】【宮】，唐周南天竺國沙門菩提流志奉詔譯【元】，唐南天竺國沙門菩提流志等奉制譯【明】，南天竺三藏菩提流志奉制譯【聖】"}
{"id": null, "n": "0111007", "target": "#nkr_note_mod_0111007", "type": "mod", "text": "童【大】，僮【聖】"}
{"id": null, "n": "0111008", "target": "#nkr_note_mod_0111008", "type": "mod", "text": "沮【大】，惱【元】【明】"}
{"id": null, "n": "0111009", "target": "#nkr_note_mod_0111009", "type": "mod", "text": "音【大】，〔－〕【明】"}
{"id": null, "n": "0111010", "target": "#nkr_note_mod_0111010", "type": "mod", "text": "反【大】下同，切【明】下同"}
{"id": null, "n": "0111011", "target": "#nkr_note_mod_0111011", "type": "mod", "text": "𡀔【大】，路【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0111012", "target": "#nkr_note_mod_0111012", "type": "mod", "text": "末【大】，未【聖】"}
{"id": null, "n": "0111013", "target": "#nkr_note_mod_0111013", "type": "mod", "text": "去【大】，上【宋】【元】【明】【宮】"}
{"id": null, "n": "0111014", "target": "#nkr_note_mod_0111014", "type": "mod", "text": "輸【大】，〔－〕【聖】"}
{"id": null, "n": "0111015", "target": "#nkr_note_mod_0111015", "type": "mod", "text": "十【大】，十二【聖】"}
{"id": null, "n": "0111016", "target": "#nkr_note_mod_0111016", "type": "mod", "text": "合【大】，含【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0111017", "target": "#nkr_note_mod_0111017", "type": "mod", "text": "拏【大】，挐【宋】【元】【明】【宮】"}
{"id": null, "n": "0111018", "target": "#nkr_note_mod_0111018", "type": "mod", "text": "自【大】，目【宋】【元】【明】【宮】"}
{"id": null, "n": "0112001", "target": "#nkr_note_mod_0112001", "type": "mod", "text": "其【大】，其善【聖】"}
{"id": null, "n": "0112002", "target": "#nkr_note_mod_0112002", "type": "mod", "text": "辦【大】，辯【聖】"}
{"id": null, "n": "0112003", "target": "#nkr_note_mod_0112003", "type": "mod", "text": "唯【大】，惟【宮】"}
{"id": null, "n": "0112004", "target": "#nkr_note_mod_0112004", "type": "mod", "text": "言【大】，生【聖】"}
{"id": null, "n": "0112005", "target": "#nkr_note_mod_0112005", "type": "mod", "text": "諸【大】，語【宋】【元】【明】【宮】"}
{"id": null, "n": "0112006", "target": "#nkr_note_mod_0112006", "type": "mod", "text": "諸【大】，諸心捨諸【聖】"}
{"id": null, "n": "0112007", "target": "#nkr_note_mod_0112007", "type": "mod", "text": "樂【大】，樂是名禪定八種清淨【明】"}
{"id": null, "n": "0113001", "target": "#nkr_note_mod_0113001", "type": "mod", "text": "老【大】，者【宮】"}
{"id": null, "n": "0113002", "target": "#nkr_note_mod_0113002", "type": "mod", "text": "見【大】，具【明】"}
{"id": null, "n": "0113003", "target": "#nkr_note_mod_0113003", "type": "mod", "text": "授【大】，受【宋】【元】【明】【宮】"}
{"id": null, "n": "0113004", "target": "#nkr_note_mod_0113004", "type": "mod", "text": "謂【大】，且【宮】【聖】"}
{"id": null, "n": "0113005", "target": "#nkr_note_mod_0113005", "type": "mod", "text": "受【CB】【麗-CB】【宮】【聖】，察【大】"}
{"id": null, "n": "0113006", "target": "#nkr_note_mod_0113006", "type": "mod", "text": "希【大】，未【明】"}
{"id": null, "n": "0114001", "target": "#nkr_note_mod_0114001", "type": "mod", "text": "名【大】，不【明】"}
{"id": null, "n": "0115001", "target": "#nkr_note_mod_0115001", "type": "mod", "text": "廣【大】，佛【明】"}
{"id": null, "n": "0115002", "target": "#nkr_note_mod_0115002", "type": "mod", "text": "佛【大】，〔－〕【聖】"}
{"id": null, "n": "0115003", "target": "#nkr_note_mod_0115003", "type": "mod", "text": "卷【大】，〔－〕【聖】"}
{"id": null, "n": "0108001", "target": "#nkr_note_orig_0108001", "type": "orig", "text": "（（唐天竺…譯））十二字＝南天竺國沙門菩提留志等奉制譯【三】【宮】，南天竺三藏菩提流志奉制譯【聖乙】"}
{"id": null, "n": "0108002", "target": "#nkr_note_orig_0108002", "type": "orig", "text": "童＝僮【聖乙】下同"}
{"id": null, "n": "0108003", "target": "#nkr_note_orig_0108003", "type": "orig", "text": "今＝念【聖乙】"}
{"id": null, "n": "0108004", "target": "#nkr_note_orig_0108004", "type": "orig", "text": "〔非耳境界〕－【聖乙】"}
{"id": null, "n": "0108005", "target": "#nkr_note_orig_0108005", "type": "orig", "text": "〔自〕－【聖乙】"}
{"id": null, "n": "0108006", "target": "#nkr_note_orig_0108006", "type": "orig", "text": "〔空〕－【聖】"}
{"id": null, "n": "0108007", "target": "#nkr_note_orig_0108007", "type": "orig", "text": "瞋＋（癡）【明】"}
{"id": null, "n": "0108008", "target": "#nkr_note_orig_0108008", "type": "orig", "text": "惱＋（性）【三】【宮】【聖】【聖乙】"}
{"id": null, "n": "0109001", "target": "#nkr_note_orig_0109001", "type": "orig", "text": "法＝如【聖乙】"}
{"id": null, "n": "0109002", "target": "#nkr_note_orig_0109002", "type": "orig", "text": "恒覺＝覺悟【三】【宮】"}
{"id": null, "n": "0109003", "target": "#nkr_note_orig_0109003", "type": "orig", "text": "位＝住【宮】【聖】【聖乙】"}
{"id": null, "n": "0109004", "target": "#nkr_note_orig_0109004", "type": "orig", "text": "〔此是聲聞地〕－【宋】【元】【宮】【聖】【聖乙】"}
{"id": null, "n": "0109005", "target": "#nkr_note_orig_0109005", "type": "orig", "text": "地＋（此是菩薩地）【明】"}
{"id": null, "n": "0109006", "target": "#nkr_note_orig_0109006", "type": "orig", "text": "切＋（法）【三】【宮】"}
{"id": null, "n": "0109007", "target": "#nkr_note_orig_0109007", "type": "orig", "text": "特鐘＝極重【宋】【宮】"}
{"id": null, "n": "0109008", "target": "#nkr_note_orig_0109008", "type": "orig", "text": "持＝待【明】"}
{"id": null, "n": "0109009", "target": "#nkr_note_orig_0109009", "type": "orig", "text": "（所）＋言【三】【宮】【聖】【聖乙】"}
{"id": null, "n": "0110001", "target": "#nkr_note_orig_0110001", "type": "orig", "text": "染＝深【聖】"}
{"id": null, "n": "0110002", "target": "#nkr_note_orig_0110002", "type": "orig", "text": "會＝界【宋】【宮】"}
{"id": null, "n": "0110003", "target": "#nkr_note_orig_0110003", "type": "orig", "text": "攢＝欑【宋】【元】【宮】【聖】"}
{"id": null, "n": "0110004", "target": "#nkr_note_orig_0110004", "type": "orig", "text": "笙＝箜【三】【宮】"}
{"id": null, "n": "0110005", "target": "#nkr_note_orig_0110005", "type": "orig", "text": "鐘＝鍾【三】【宮】"}
{"id": null, "n": "0110006", "target": "#nkr_note_orig_0110006", "type": "orig", "text": "矚＝囑【聖】【聖乙】"}
{"id": null, "n": "0111001", "target": "#nkr_note_orig_0111001", "type": "orig", "text": "以＋（此）【三】【宮】"}
{"id": null, "n": "0111002", "target": "#nkr_note_orig_0111002", "type": "orig", "text": "內＝納【明】＊"}
{"id": null, "n": "0111003", "target": "#nkr_note_orig_0111003", "type": "orig", "text": "今＝合【宋】，〔今〕－【宮】"}
{"id": null, "n": "0111004", "target": "#nkr_note_orig_0111004", "type": "orig", "text": "唯＝惟【三】【宮】【聖】【聖乙】"}
{"id": null, "n": "0111005", "target": "#nkr_note_orig_0111005", "type": "orig", "text": "此下聖本有光明皇后願文"}
{"id": null, "n": "0111006", "target": "#nkr_note_orig_0111006", "type": "orig", "text": "（（唐天竺…譯））十二字＝南天竺國沙門菩提留志等奉詔譯【宋】【宮】，唐周南天竺國沙門菩提流志奉詔譯【元】，唐南天竺國沙門菩提流志等奉制譯【明】，南天竺三藏菩提流志奉制譯【聖】"}
{"id": null, "n": "0111007", "target": "#nkr_note_orig_0111007", "type": "orig", "text": "童＝僮【聖】"}
{"id": null, "n": "0111008", "target": "#nkr_note_orig_0111008", "type": "orig", "text": "沮＝惱【元】【明】"}
{"id": null, "n": "0111009", "target": "#nkr_note_orig_0111009", "type": "orig", "text": "〔音〕－【明】"}
{"id": null, "n": "0111010", "target": "#nkr_note_orig_0111010", "type": "orig", "text": "反＝切【明】下同"}
{"id": null, "n": "0111011", "target": "#nkr_note_orig_0111011", "type": "orig", "text": "𡀔＝路【三】【宮】【聖】"}
{"id": null, "n": "0111012", "target": "#nkr_note_orig_0111012", "type": "orig", "text": "末＝未【聖】"}
{"id": null, "n": "0111013", "target": "#nkr_note_orig_0111013", "type": "orig", "text": "去＝上【三】【宮】"}
{"id": null, "n": "0111014", "target": "#nkr_note_orig_0111014", "type": "orig", "text": "〔輸〕－【聖】"}
{"id": null, "n": "0111015", "target": "#nkr_note_orig_0111015", "type": "orig", "text": "十＋（二）【聖】"}
{"id": null, "n": "0111016", "target": "#nkr_note_orig_0111016", "type": "orig", "text": "合＝含【三】【宮】【聖】"}
{"id": null, "n": "0111017", "target": "#nkr_note_orig_0111017", "type": "orig", "text": "拏＝挐【三】【宮】"}
{"id": null, "n": "0111018", "target": "#nkr_note_orig_0111018", "type": "orig", "text": "自＝目【三】【宮】"}
{"id": null, "n": "0112001", "target": "#nkr_note_orig_0112001", "type": "orig", "text": "其＋（善）【聖】"}
{"id": null, "n": "0112002", "target": "#nkr_note_orig_0112002", "type": "orig", "text": "辦＝辯【聖】"}
{"id": null, "n": "0112003", "target": "#nkr_note_orig_0112003", "type": "orig", "text": "唯＝惟【宮】"}
{"id": null, "n": "0112004", "target": "#nkr_note_orig_0112004", "type": "orig", "text": "言＝生【聖】"}
{"id": null, "n": "0112005", "target": "#nkr_note_orig_0112005", "type": "orig", "text": "諸＝語【三】【宮】"}
{"id": null, "n": "0112006", "target": "#nkr_note_orig_0112006", "type": "orig", "text": "諸＋（心捨諸）【聖】"}
