{"id": null, "n": "0256033", "target": "#nkr_note_mod_0256033", "type": "mod", "text": "一段【大】，〔－〕【甲】"}
{"id": null, "n": "0256034", "target": "#nkr_note_mod_0256034", "type": "mod", "text": "尺【大】，擲【明】【乙】"}
{"id": null, "n": "0256035", "target": "#nkr_note_mod_0256035", "type": "mod", "text": "酥【大】，酪【明】【甲】【乙】"}
{"id": null, "n": "0257001", "target": "#nkr_note_mod_0257001", "type": "mod", "text": "如【大】，呪如【明】【乙】"}
{"id": null, "n": "0257002", "target": "#nkr_note_mod_0257002", "type": "mod", "text": "勿使末【大】，勿使末【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "勿使末"}
{"id": null, "n": "0257003", "target": "#nkr_note_mod_0257003", "type": "mod", "text": "我【大】，者【甲】"}
{"id": null, "n": "0257004", "target": "#nkr_note_mod_0257004", "type": "mod", "text": "三【大】，二【考偽-乙】"}
{"id": null, "n": "0257005", "target": "#nkr_note_mod_0257005", "type": "mod", "text": "並【大】，并【明】【乙】"}
{"id": null, "n": "0257006", "target": "#nkr_note_mod_0257006", "type": "mod", "text": "一【大】，曰【考偽-乙】"}
{"id": null, "n": "0257007", "target": "#nkr_note_mod_0257007", "type": "mod", "text": "知【大】，〔－〕【甲】"}
