{"id": null, "n": "0256013", "target": "#nkr_note_mod_0256013", "type": "mod", "text": "道【大】，〔－〕【甲】"}
{"id": null, "n": "0256014", "target": "#nkr_note_mod_0256014", "type": "mod", "text": "持【大】，〔－〕【甲】"}
{"id": null, "n": "0256015", "target": "#nkr_note_mod_0256015", "type": "mod", "text": "屏【大】，廁【明】【乙】"}
{"id": null, "n": "0256016", "target": "#nkr_note_mod_0256016", "type": "mod", "text": "交【大】，反【明】【甲】【乙】"}
{"id": null, "n": "0256017", "target": "#nkr_note_mod_0256017", "type": "mod", "text": "縛【大】，搏【明】【甲】【乙】"}
{"id": null, "n": "0256018", "target": "#nkr_note_mod_0256018", "type": "mod", "text": "尼印【大】，用【甲】"}
