{"id": null, "n": "0255024", "target": "#nkr_note_mod_0255024", "type": "mod", "text": "末【大】＊，佛說末【明】【乙】＊，麗本，【甲】三十帖策子第十六，【乙】黃檗版淨嚴等加筆本"}
{"id": null, "n": "0255025", "target": "#nkr_note_mod_0255025", "type": "mod", "text": "開府儀同三司特進試鴻臚卿肅國公食邑三千戶賜紫贈司空諡大鑒正號大廣智大興善寺【大】，唐【明】【乙】，大興善寺【甲】"}
{"id": null, "n": "0255026", "target": "#nkr_note_mod_0255026", "type": "mod", "text": "寺【大】，〔－〕【甲】"}
{"id": null, "n": "0255027", "target": "#nkr_note_mod_0255027", "type": "mod", "text": "門【大】，門大廣智【明】【甲】【乙】"}
{"id": null, "n": "0255028", "target": "#nkr_note_mod_0255028", "type": "mod", "text": "摩【大】，磨【明】【乙】"}
{"id": null, "n": "0256001", "target": "#nkr_note_mod_0256001", "type": "mod", "text": "漠【大】，謨【明】【乙】"}
{"id": null, "n": "0256002", "target": "#nkr_note_mod_0256002", "type": "mod", "text": "賀【大】＊，賀引【明】【乙】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0256003", "target": "#nkr_note_mod_0256003", "type": "mod", "text": "茶【大】，鳩盤茶【明】【乙】"}
{"id": null, "n": "0256004", "target": "#nkr_note_mod_0256004", "type": "mod", "text": "雞【大】，難【明】【乙】"}
{"id": null, "n": "0256005", "target": "#nkr_note_mod_0256005", "type": "mod", "text": "實語【大】，語真實【明】【乙】，語實【甲】"}
{"id": null, "n": "0256006", "target": "#nkr_note_mod_0256006", "type": "mod", "text": "也【大】，〔－〕【明】【乙】"}
{"id": null, "n": "0256007", "target": "#nkr_note_mod_0256007", "type": "mod", "text": "反【大】，〔－〕【明】【乙】"}
{"id": null, "n": "0256008", "target": "#nkr_note_mod_0256008", "type": "mod", "text": "上【大】，〔－〕【明】【乙】"}
{"id": null, "n": "0256009", "target": "#nkr_note_mod_0256009", "type": "mod", "text": "斯亞反【大】，〔－〕【明】"}
{"id": null, "n": "0256010", "target": "#nkr_note_mod_0256010", "type": "mod", "text": "毘【大】，〔－〕【明】【乙】"}
{"id": null, "n": "0256011", "target": "#nkr_note_mod_0256011", "type": "mod", "text": "作【大】，用【明】"}
