{"id": null, "n": null, "target": null, "type": null, "text": "一切佛經俱應作如是觀"}
{"id": null, "n": null, "target": null, "type": null, "text": "般若音鉢惹，後凡又遇，同此"}
{"id": null, "n": null, "target": null, "type": null, "text": "祇音奇，比音被。"}
{"id": null, "n": null, "target": null, "type": null, "text": "著，俗作着。已，音以。飯食，音反四。敷，音孚。"}
{"id": null, "n": null, "target": null, "type": null, "text": "著，同着。"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿讀倭，應〔因音〕。"}
{"id": null, "n": null, "target": null, "type": null, "text": "為音位。"}
{"id": null, "n": null, "target": null, "type": null, "text": "唯音委，樂音要。"}
{"id": null, "n": null, "target": null, "type": null, "text": "眾生音中生。"}
{"id": null, "n": null, "target": null, "type": null, "text": "令，平聲。涅，音年，入聲。"}
{"id": null, "n": null, "target": null, "type": null, "text": "相，去聲。"}
{"id": null, "n": null, "target": null, "type": null, "text": "施音是。"}
{"id": null, "n": null, "target": null, "type": null, "text": "六度，註見第一葉。"}
{"id": null, "n": null, "target": null, "type": null, "text": "凡問之不字，音否。凡答之不字，音弗。"}
{"id": null, "n": null, "target": null, "type": null, "text": "無量音無亮。"}
{"id": null, "n": null, "target": null, "type": null, "text": "解，去聲，音械。"}
{"id": null, "n": null, "target": null, "type": null, "text": "差，音雌。"}
{"id": null, "n": null, "target": null, "type": null, "text": "洹音丸。"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿、那俱平聲。"}
{"id": null, "n": null, "target": null, "type": null, "text": "樂音要，行音恨。"}
{"id": null, "n": null, "target": null, "type": null, "text": "土讀度。"}
{"id": null, "n": null, "target": null, "type": null, "text": "怖音布。"}
{"id": null, "n": null, "target": null, "type": null, "text": "解音皆上聲。"}
{"id": null, "n": null, "target": null, "type": null, "text": "闇同暗。"}
{"id": null, "n": null, "target": null, "type": null, "text": "分，去聲。"}
{"id": null, "n": null, "target": null, "type": null, "text": "稱、量俱平聲，古稱秤通用。"}
{"id": null, "n": null, "target": null, "type": null, "text": "樂音要。"}
{"id": null, "n": null, "target": null, "type": null, "text": "華，古花字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "那，平聲。他，音陀。分，去聲。"}
{"id": null, "n": null, "target": null, "type": null, "text": "比音彼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": "0580002", "target": "#nkr_note_orig_0580002", "type": "orig", "text": "又一作文"}
{"id": null, "n": "0580003", "target": "#nkr_note_orig_0580003", "type": "orig", "text": "取下廣本作一有計百餘種全集五千餘張分為六集編定寶金通壽安樂字號全部刷印發兌或有愛閱全集或有不足購取者即之字"}
{"id": null, "n": "0580004", "target": "#nkr_note_orig_0580004", "type": "orig", "text": "無編等八字"}
{"id": null, "n": "0584001", "target": "#nkr_note_orig_0584001", "type": "orig", "text": "脫疑說"}
{"id": null, "n": "0584002", "target": "#nkr_note_orig_0584002", "type": "orig", "text": "能異作難"}
{"id": null, "n": "0585001", "target": "#nkr_note_orig_0585001", "type": "orig", "text": "植異作殖"}
{"id": null, "n": "0585002", "target": "#nkr_note_orig_0585002", "type": "orig", "text": "因音異作音因"}
{"id": null, "n": "0586001", "target": "#nkr_note_orig_0586001", "type": "orig", "text": "明異作朋"}
{"id": null, "n": "0586002", "target": "#nkr_note_orig_0586002", "type": "orig", "text": "待異作時"}
{"id": null, "n": "0587001", "target": "#nkr_note_orig_0587001", "type": "orig", "text": "浩流異作平沈"}
{"id": null, "n": "0588001", "target": "#nkr_note_orig_0588001", "type": "orig", "text": "乎異作耶"}
{"id": null, "n": "0589001", "target": "#nkr_note_orig_0589001", "type": "orig", "text": "如異作猶"}
{"id": null, "n": "0590001", "target": "#nkr_note_orig_0590001", "type": "orig", "text": "息異作怠"}
{"id": null, "n": "0590002", "target": "#nkr_note_orig_0590002", "type": "orig", "text": "隨異作墮"}
{"id": null, "n": "0590003", "target": "#nkr_note_orig_0590003", "type": "orig", "text": "專異作等"}
{"id": null, "n": "0590004", "target": "#nkr_note_orig_0590004", "type": "orig", "text": "切異作相"}
{"id": null, "n": "0591001", "target": "#nkr_note_orig_0591001", "type": "orig", "text": "即＊是異作也是（是ハ本文ニ謂トツクル。󴦒）"}
{"id": null, "n": "0592001", "target": "#nkr_note_orig_0592001", "type": "orig", "text": "󴦺異作麵"}
{"id": null, "n": "0597001", "target": "#nkr_note_orig_0597001", "type": "orig", "text": "在異作王"}
{"id": null, "n": "0597002", "target": "#nkr_note_orig_0597002", "type": "orig", "text": "之作邊"}
{"id": null, "n": "0597003", "target": "#nkr_note_orig_0597003", "type": "orig", "text": "為異作萬"}
{"id": null, "n": "0597004", "target": "#nkr_note_orig_0597004", "type": "orig", "text": "闡異作問"}
{"id": null, "n": "0598001", "target": "#nkr_note_orig_0598001", "type": "orig", "text": "知異作加"}
{"id": null, "n": "0599001", "target": "#nkr_note_orig_0599001", "type": "orig", "text": "也異作矣"}
{"id": null, "n": "0601001", "target": "#nkr_note_orig_0601001", "type": "orig", "text": "一異作如"}
{"id": null, "n": "0601002", "target": "#nkr_note_orig_0601002", "type": "orig", "text": "三異作念"}
{"id": null, "n": "0603001", "target": "#nkr_note_orig_0603001", "type": "orig", "text": "聽異作曉"}
{"id": null, "n": "0605001", "target": "#nkr_note_orig_0605001", "type": "orig", "text": "耳疑爾"}
{"id": null, "n": "0605002", "target": "#nkr_note_orig_0605002", "type": "orig", "text": "等異作俱"}
