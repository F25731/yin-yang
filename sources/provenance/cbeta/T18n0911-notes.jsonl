{"id": null, "n": null, "target": null, "type": null, "text": "四十九載"}
{"id": null, "n": "0926008", "target": "#nkr_note_mod_0926008", "type": "mod", "text": "趣【大】，輙【甲】"}
{"id": null, "n": "0926009", "target": "#nkr_note_mod_0926009", "type": "mod", "text": "潭【大】＊，潬【甲】＊"}
{"id": null, "n": "0926010", "target": "#nkr_note_mod_0926010", "type": "mod", "text": "果【大】，藥【甲】，果【校異-甲】"}
{"id": null, "n": "0926011", "target": "#nkr_note_mod_0926011", "type": "mod", "text": "澤【大】，灑【甲】，澤【考偽-甲】"}
{"id": null, "n": "0927001", "target": "#nkr_note_mod_0927001", "type": "mod", "text": "辨【大】，辦【甲】"}
{"id": null, "n": "0927002", "target": "#nkr_note_mod_0927002", "type": "mod", "text": "請【大】，諸【甲】"}
{"id": null, "n": "0927003", "target": "#nkr_note_mod_0927003", "type": "mod", "text": "舉【大】，奉【甲】"}
{"id": null, "n": "0928001", "target": "#nkr_note_mod_0928001", "type": "mod", "text": "分【大】，〔－〕【甲】"}
{"id": null, "n": "0928002", "target": "#nkr_note_mod_0928002", "type": "mod", "text": "須【大】，頓【校異-原】【甲】"}
{"id": null, "n": "0928003", "target": "#nkr_note_mod_0928003", "type": "mod", "text": "土【大】，其土【考偽-原】【考偽-甲】"}
{"id": null, "n": "0928004", "target": "#nkr_note_mod_0928004", "type": "mod", "text": "䞉【大】＊，賸【甲】＊"}
{"id": null, "n": "0928005", "target": "#nkr_note_mod_0928005", "type": "mod", "text": "推【大】，摧【甲】"}
{"id": null, "n": "0928006", "target": "#nkr_note_mod_0928006", "type": "mod", "text": "不【大】，坏【甲】"}
{"id": null, "n": "0928007", "target": "#nkr_note_mod_0928007", "type": "mod", "text": "塗【大】，室【甲】"}
{"id": null, "n": "0926007", "target": "#nkr_note_orig_0926007", "type": "orig", "text": "【原】縮刷大藏經，【甲】黃檗版淨嚴等校訂加筆本塚本賢曉氏藏"}
{"id": null, "n": "0926008", "target": "#nkr_note_orig_0926008", "type": "orig", "text": "趣＝輙【甲】"}
{"id": null, "n": "0926009", "target": "#nkr_note_orig_0926009", "type": "orig", "text": "潭＝潬【甲】＊"}
{"id": null, "n": "0926010", "target": "#nkr_note_orig_0926010", "type": "orig", "text": "果＝藥【甲】，果ィ【甲】"}
{"id": null, "n": "0926011", "target": "#nkr_note_orig_0926011", "type": "orig", "text": "澤＝灑【甲】，澤ヵ【甲】"}
{"id": null, "n": "0927001", "target": "#nkr_note_orig_0927001", "type": "orig", "text": "辨＝辦【甲】"}
{"id": null, "n": "0927002", "target": "#nkr_note_orig_0927002", "type": "orig", "text": "請＝諸【甲】"}
{"id": null, "n": "0927003", "target": "#nkr_note_orig_0927003", "type": "orig", "text": "舉＝奉【甲】"}
{"id": null, "n": "0928001", "target": "#nkr_note_orig_0928001", "type": "orig", "text": "〔分〕－【甲】"}
{"id": null, "n": "0928002", "target": "#nkr_note_orig_0928002", "type": "orig", "text": "須＝頓ィ【原】【甲】"}
{"id": null, "n": "0928003", "target": "#nkr_note_orig_0928003", "type": "orig", "text": "（其）ヵ＋土【原】【甲】"}
{"id": null, "n": "0928004", "target": "#nkr_note_orig_0928004", "type": "orig", "text": "䞉＝賸【甲】＊"}
{"id": null, "n": "0928005", "target": "#nkr_note_orig_0928005", "type": "orig", "text": "推＝摧【甲】"}
{"id": null, "n": "0928006", "target": "#nkr_note_orig_0928006", "type": "orig", "text": "不＝坏【甲】"}
{"id": null, "n": "0928007", "target": "#nkr_note_orig_0928007", "type": "orig", "text": "塗＝室【甲】"}
