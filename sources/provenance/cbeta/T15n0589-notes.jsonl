{"id": null, "n": "0112011", "target": "#nkr_note_mod_0112011", "type": "mod", "text": "西晉【大】，西晉太康年【宋】【元】【宮】"}
{"id": null, "n": "0112012", "target": "#nkr_note_mod_0112012", "type": "mod", "text": "竺【大】，法師竺【宋】【元】【明】【宮】"}
{"id": null, "n": "0112013", "target": "#nkr_note_mod_0112013", "type": "mod", "text": "摩訶菩薩【大】，菩薩摩訶薩數【宋】【元】【明】【宮】"}
{"id": null, "n": "0112014", "target": "#nkr_note_mod_0112014", "type": "mod", "text": "白【大】，曰【元】【明】"}
{"id": null, "n": "0112015", "target": "#nkr_note_mod_0112015", "type": "mod", "text": "及【大】，反【宋】【元】【明】【宮】"}
{"id": null, "n": "0112016", "target": "#nkr_note_mod_0112016", "type": "mod", "text": "曰【大】，言【宋】【元】【明】【宮】"}
{"id": null, "n": "0112017", "target": "#nkr_note_mod_0112017", "type": "mod", "text": "不【大】，末【元】"}
{"id": null, "n": "0112018", "target": "#nkr_note_mod_0112018", "type": "mod", "text": "曰【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0112019", "target": "#nkr_note_mod_0112019", "type": "mod", "text": "於【大】，諸【宋】【元】【明】【宮】"}
{"id": null, "n": "0112020", "target": "#nkr_note_mod_0112020", "type": "mod", "text": "知【大】，智【宋】【元】【明】【宮】"}
{"id": null, "n": "0113001", "target": "#nkr_note_mod_0113001", "type": "mod", "text": "相【大】，根【元】"}
{"id": null, "n": "0113002", "target": "#nkr_note_mod_0113002", "type": "mod", "text": "致【大】，至【宋】【元】【明】【宮】"}
{"id": null, "n": "0113003", "target": "#nkr_note_mod_0113003", "type": "mod", "text": "係【大】，繫【元】【明】"}
{"id": null, "n": "0113004", "target": "#nkr_note_mod_0113004", "type": "mod", "text": "志【大】，至【宋】【元】【明】【宮】"}
{"id": null, "n": "0113005", "target": "#nkr_note_mod_0113005", "type": "mod", "text": "原【大】，願【明】"}
{"id": null, "n": "0113006", "target": "#nkr_note_mod_0113006", "type": "mod", "text": "等【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0113007", "target": "#nkr_note_mod_0113007", "type": "mod", "text": "已【大】＊，以【明】＊"}
{"id": null, "n": "0113008", "target": "#nkr_note_mod_0113008", "type": "mod", "text": "此【大】，諸【元】【明】"}
{"id": null, "n": "0113009", "target": "#nkr_note_mod_0113009", "type": "mod", "text": "返【大】，反【元】【明】"}
{"id": null, "n": "0113010", "target": "#nkr_note_mod_0113010", "type": "mod", "text": "失【大】，天【元】"}
{"id": null, "n": "0114001", "target": "#nkr_note_mod_0114001", "type": "mod", "text": "勤【大】，懃【宋】【元】【明】"}
{"id": null, "n": "0114002", "target": "#nkr_note_mod_0114002", "type": "mod", "text": "順【大】，敬【宋】【元】【明】【宮】"}
{"id": null, "n": "0114003", "target": "#nkr_note_mod_0114003", "type": "mod", "text": "見【大】，已【元】"}
{"id": null, "n": "0114004", "target": "#nkr_note_mod_0114004", "type": "mod", "text": "覩【大】，視【宋】【元】【明】【宮】"}
{"id": null, "n": "0114005", "target": "#nkr_note_mod_0114005", "type": "mod", "text": "為【大】，者【宋】【元】【明】【宮】"}
{"id": null, "n": "0114006", "target": "#nkr_note_mod_0114006", "type": "mod", "text": "又【大】，入【元】"}
{"id": null, "n": "0114007", "target": "#nkr_note_mod_0114007", "type": "mod", "text": "本【大】，求【宮】"}
{"id": null, "n": "0114008", "target": "#nkr_note_mod_0114008", "type": "mod", "text": "來【大】，來者【宋】【元】【明】【宮】"}
{"id": null, "n": "0114009", "target": "#nkr_note_mod_0114009", "type": "mod", "text": "懷【大】，壞【宋】【元】【宮】"}
{"id": null, "n": "0114010", "target": "#nkr_note_mod_0114010", "type": "mod", "text": "原【大】，源【元】【明】"}
{"id": null, "n": "0114011", "target": "#nkr_note_mod_0114011", "type": "mod", "text": "如【大】，如求火鑽木陽燧乃出火耳【宋】【元】【明】"}
{"id": null, "n": "0114012", "target": "#nkr_note_mod_0114012", "type": "mod", "text": "生【大】，出【明】"}
{"id": null, "n": "0114013", "target": "#nkr_note_mod_0114013", "type": "mod", "text": "（鑽木…耳）十二字【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0115001", "target": "#nkr_note_mod_0115001", "type": "mod", "text": "眾會【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0115002", "target": "#nkr_note_mod_0115002", "type": "mod", "text": "今【大】，即【宮】"}
{"id": null, "n": "0115003", "target": "#nkr_note_mod_0115003", "type": "mod", "text": "已【大】，以【元】【明】"}
{"id": null, "n": "0115004", "target": "#nkr_note_mod_0115004", "type": "mod", "text": "修行【大】，〔－〕【元】【明】"}
{"id": null, "n": "0115005", "target": "#nkr_note_mod_0115005", "type": "mod", "text": "無想【大】＊，無相【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0115006", "target": "#nkr_note_mod_0115006", "type": "mod", "text": "愚【大】，遇【元】【明】"}
{"id": null, "n": "0115007", "target": "#nkr_note_mod_0115007", "type": "mod", "text": "護【大】，獲【宋】【元】【明】【宮】"}
{"id": null, "n": "0115008", "target": "#nkr_note_mod_0115008", "type": "mod", "text": "動轉【大】，轉動【宋】【元】【明】【宮】"}
{"id": null, "n": "0115009", "target": "#nkr_note_mod_0115009", "type": "mod", "text": "六【大】，具【宋】【元】【明】，〔－〕【宮】"}
{"id": null, "n": "0115010", "target": "#nkr_note_mod_0115010", "type": "mod", "text": "著【大】，者【元】"}
{"id": null, "n": "0115011", "target": "#nkr_note_mod_0115011", "type": "mod", "text": "獲【大】，護【宋】【元】【明】【宮】"}
{"id": null, "n": "0115012", "target": "#nkr_note_mod_0115012", "type": "mod", "text": "淨【大】，清淨【宋】【元】【明】【宮】"}
{"id": null, "n": "0115013", "target": "#nkr_note_mod_0115013", "type": "mod", "text": "疵【大】＊，玼【元】【明】＊"}
{"id": null, "n": "0115014", "target": "#nkr_note_mod_0115014", "type": "mod", "text": "悉【大】，忍【元】【明】"}
{"id": null, "n": "0115015", "target": "#nkr_note_mod_0115015", "type": "mod", "text": "壞【大】，懷【宋】【元】【明】【宮】"}
{"id": null, "n": "0115016", "target": "#nkr_note_mod_0115016", "type": "mod", "text": "求【大】，永【明】"}
{"id": null, "n": "0116001", "target": "#nkr_note_mod_0116001", "type": "mod", "text": "望【大】，妄【宮】"}
{"id": null, "n": "0116002", "target": "#nkr_note_mod_0116002", "type": "mod", "text": "中【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0116003", "target": "#nkr_note_mod_0116003", "type": "mod", "text": "義理【大】，理義【宋】【元】【明】【宮】"}
{"id": null, "n": "0116004", "target": "#nkr_note_mod_0116004", "type": "mod", "text": "事【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0116005", "target": "#nkr_note_mod_0116005", "type": "mod", "text": "一【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "0116006", "target": "#nkr_note_mod_0116006", "type": "mod", "text": "諸【大】，於【宋】【元】【明】【宮】"}
{"id": null, "n": "0116007", "target": "#nkr_note_mod_0116007", "type": "mod", "text": "猗【大】，倚【元】【明】"}
{"id": null, "n": "0116008", "target": "#nkr_note_mod_0116008", "type": "mod", "text": "得【大】，是【元】【明】"}
{"id": null, "n": "0116009", "target": "#nkr_note_mod_0116009", "type": "mod", "text": "尊豪【大】，豪尊【宋】【元】【明】【宮】"}
{"id": null, "n": "0116010", "target": "#nkr_note_mod_0116010", "type": "mod", "text": "反【大】，及【宋】【元】【明】【宮】"}
{"id": null, "n": "0116011", "target": "#nkr_note_mod_0116011", "type": "mod", "text": "得有【大】，有得【宋】【元】【明】【宮】"}
{"id": null, "n": "0116012", "target": "#nkr_note_mod_0116012", "type": "mod", "text": "不【大】，無【宋】【元】【明】【宮】"}
{"id": null, "n": "0116013", "target": "#nkr_note_mod_0116013", "type": "mod", "text": "為【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0116014", "target": "#nkr_note_mod_0116014", "type": "mod", "text": "怨【大】，冤【宋】【元】【明】【宮】"}
{"id": null, "n": "0116015", "target": "#nkr_note_mod_0116015", "type": "mod", "text": "脫【大】，解脫【宋】【元】【明】"}
{"id": null, "n": "0117001", "target": "#nkr_note_mod_0117001", "type": "mod", "text": "沒【大】，歿【宋】【元】【明】【宮】"}
{"id": null, "n": "0117002", "target": "#nkr_note_mod_0117002", "type": "mod", "text": "究盡【大】，究竟【元】【明】"}
{"id": null, "n": "0117003", "target": "#nkr_note_mod_0117003", "type": "mod", "text": "厭【大】，〔－〕【宮】"}
{"id": null, "n": "0117004", "target": "#nkr_note_mod_0117004", "type": "mod", "text": "不得所行【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0117005", "target": "#nkr_note_mod_0117005", "type": "mod", "text": "眾【大】，〔－〕【宮】"}
{"id": null, "n": "0117006", "target": "#nkr_note_mod_0117006", "type": "mod", "text": "如【大】，于【宋】【明】【宮】，子【元】"}
{"id": null, "n": "0117007", "target": "#nkr_note_mod_0117007", "type": "mod", "text": "瑕【大】，暇【元】"}
{"id": null, "n": "0117008", "target": "#nkr_note_mod_0117008", "type": "mod", "text": "原【大】＊，源【元】【明】＊"}
{"id": null, "n": "0117009", "target": "#nkr_note_mod_0117009", "type": "mod", "text": "求【大】，永【宋】【元】【明】【宮】"}
{"id": null, "n": "0117010", "target": "#nkr_note_mod_0117010", "type": "mod", "text": "冥【大】，明【明】"}
{"id": null, "n": "0117011", "target": "#nkr_note_mod_0117011", "type": "mod", "text": "因【大】，思【宋】【元】【明】【宮】"}
{"id": null, "n": "0117012", "target": "#nkr_note_mod_0117012", "type": "mod", "text": "設【大】，說【元】【明】"}
{"id": null, "n": "0118001", "target": "#nkr_note_mod_0118001", "type": "mod", "text": "輪【大】，倫【明】"}
{"id": null, "n": "0118002", "target": "#nkr_note_mod_0118002", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0118003", "target": "#nkr_note_mod_0118003", "type": "mod", "text": "無此記【宋】【元】【明】【宮】"}
{"id": null, "n": "0112011", "target": "#nkr_note_orig_0112011", "type": "orig", "text": "西晉＋（太康年）【宋】【元】【宮】"}
{"id": null, "n": "0112012", "target": "#nkr_note_orig_0112012", "type": "orig", "text": "（法師）＋竺【三】【宮】"}
{"id": null, "n": "0112013", "target": "#nkr_note_orig_0112013", "type": "orig", "text": "摩訶菩薩＝菩薩摩訶薩數【三】【宮】"}
{"id": null, "n": "0112014", "target": "#nkr_note_orig_0112014", "type": "orig", "text": "白＝曰【元】【明】"}
{"id": null, "n": "0112015", "target": "#nkr_note_orig_0112015", "type": "orig", "text": "及＝反【三】【宮】"}
{"id": null, "n": "0112016", "target": "#nkr_note_orig_0112016", "type": "orig", "text": "曰＝言【三】【宮】"}
{"id": null, "n": "0112017", "target": "#nkr_note_orig_0112017", "type": "orig", "text": "不＝末【元】"}
{"id": null, "n": "0112018", "target": "#nkr_note_orig_0112018", "type": "orig", "text": "〔曰〕－【三】【宮】"}
{"id": null, "n": "0112019", "target": "#nkr_note_orig_0112019", "type": "orig", "text": "於＝諸【三】【宮】"}
{"id": null, "n": "0112020", "target": "#nkr_note_orig_0112020", "type": "orig", "text": "知＝智【三】【宮】"}
{"id": null, "n": "0113001", "target": "#nkr_note_orig_0113001", "type": "orig", "text": "相＝根【元】"}
{"id": null, "n": "0113002", "target": "#nkr_note_orig_0113002", "type": "orig", "text": "致＝至【三】【宮】"}
{"id": null, "n": "0113003", "target": "#nkr_note_orig_0113003", "type": "orig", "text": "係＝繫【元】【明】"}
{"id": null, "n": "0113004", "target": "#nkr_note_orig_0113004", "type": "orig", "text": "志＝至【三】【宮】"}
{"id": null, "n": "0113005", "target": "#nkr_note_orig_0113005", "type": "orig", "text": "原＝願【明】"}
{"id": null, "n": "0113006", "target": "#nkr_note_orig_0113006", "type": "orig", "text": "〔等〕－【三】【宮】"}
{"id": null, "n": "0113007", "target": "#nkr_note_orig_0113007", "type": "orig", "text": "已＝以【明】＊"}
{"id": null, "n": "0113008", "target": "#nkr_note_orig_0113008", "type": "orig", "text": "此＝諸【元】【明】"}
{"id": null, "n": "0113009", "target": "#nkr_note_orig_0113009", "type": "orig", "text": "返＝反【元】【明】"}
