{"id": null, "n": null, "target": null, "type": null, "text": "卷上"}
{"id": null, "n": null, "target": null, "type": null, "text": "卷下"}
{"id": null, "n": null, "target": null, "type": null, "text": "細軟衣也"}
{"id": null, "n": null, "target": null, "type": null, "text": "野蠶繭織為衣也"}
{"id": null, "n": null, "target": null, "type": null, "text": "奢那樹似麻取皮織為衣"}
{"id": null, "n": null, "target": null, "type": null, "text": "准主樹雜古貝樹花織為衣也"}
{"id": null, "n": null, "target": null, "type": null, "text": "穌懺反"}
{"id": null, "n": null, "target": null, "type": null, "text": "無誄反"}
{"id": null, "n": null, "target": null, "type": null, "text": "野蠶繭作\n緯、麻紵作經。麻紵似此間麻也"}
{"id": null, "n": null, "target": null, "type": null, "text": "織古貝庸磨之多毛也"}
{"id": null, "n": null, "target": null, "type": null, "text": "有蟲著波兜羅樹葉為窠子，取此窠糸織為衣也"}
{"id": null, "n": null, "target": null, "type": null, "text": "提婆田底樹取皮織\n為衣作驢毛色"}
{"id": null, "n": null, "target": null, "type": null, "text": "古貝花、憍奢耶、波兜羅三種雜織為衣也"}
{"id": null, "n": null, "target": null, "type": null, "text": "憍奢耶為\n經、古貝花為緯也"}
{"id": null, "n": null, "target": null, "type": null, "text": "織古貝花作衣，以蠟染之作斑色也"}
{"id": null, "n": null, "target": null, "type": null, "text": "庫麻雜古貝衣也"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K24n0938_p0474b20"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K24n0938_p0474c20"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K24n0938_p0478a13"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K24n0938_p0478a14"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K24n0938_p0482a21"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K24n0938_p0482b06"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K24n0938_p0484b14"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K24n0938_p0485a23"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K24n0938_p0489a22"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K24n0938_p0489a23"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K24n0938_p0490a18"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K24n0938_p0490a19"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K24n0938_p0490c18"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K24n0938_p0490c18"}
{"id": null, "n": null, "target": null, "type": null, "text": "穌懺反"}
{"id": null, "n": null, "target": null, "type": null, "text": "穌憾反"}
{"id": null, "n": null, "target": null, "type": null, "text": "蘇𢜩反"}
{"id": null, "n": null, "target": null, "type": null, "text": "無誄反"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K24n0938_p0492c19"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K24n0938_p0493a15"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K24n0938_p0493c14"}
{"id": null, "n": "0958001", "target": "#nkr_note_mod_0958001", "type": "mod", "text": "天竺【大】＊，世【宋】【元】【宮】＊，〔－〕【明】＊"}
{"id": null, "n": "0958002", "target": "#nkr_note_mod_0958002", "type": "mod", "text": "三藏【大】＊，三藏法師【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0958003", "target": "#nkr_note_mod_0958003", "type": "mod", "text": "稱【大】，秤【宋】【元】【明】，種【宮】"}
{"id": null, "n": "0958004", "target": "#nkr_note_mod_0958004", "type": "mod", "text": "亦【大】，六【宮】"}
{"id": null, "n": "0958005", "target": "#nkr_note_mod_0958005", "type": "mod", "text": "癡【大】，愚癡【宋】【元】【明】【宮】"}
{"id": null, "n": "0958006", "target": "#nkr_note_mod_0958006", "type": "mod", "text": "想想【大】，受受【宋】【元】【明】"}
{"id": null, "n": "0959001", "target": "#nkr_note_mod_0959001", "type": "mod", "text": "故【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0959002", "target": "#nkr_note_mod_0959002", "type": "mod", "text": "則【大】，明【宋】【元】【明】【宮】"}
{"id": null, "n": "0959003", "target": "#nkr_note_mod_0959003", "type": "mod", "text": "芽【大】＊，牙【宋】【宮】＊"}
{"id": null, "n": "0959004", "target": "#nkr_note_mod_0959004", "type": "mod", "text": "芽【大】，牙【宋】【元】【宮】"}
{"id": null, "n": "0959005", "target": "#nkr_note_mod_0959005", "type": "mod", "text": "芽【大】＊，牙【宋】【元】【宮】＊"}
{"id": null, "n": "0959006", "target": "#nkr_note_mod_0959006", "type": "mod", "text": "妙【大】，少【宋】【元】【明】【宮】"}
{"id": null, "n": "0959007", "target": "#nkr_note_mod_0959007", "type": "mod", "text": "𨵗【大】，闕【宋】【元】【宮】，礙【明】"}
{"id": null, "n": "0959008", "target": "#nkr_note_mod_0959008", "type": "mod", "text": "故從【大】，然故【宋】【元】【明】，然從【宮】"}
{"id": null, "n": "0959009", "target": "#nkr_note_mod_0959009", "type": "mod", "text": "所以者【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0959010", "target": "#nkr_note_mod_0959010", "type": "mod", "text": "四【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0960001", "target": "#nkr_note_mod_0960001", "type": "mod", "text": "挂【大】，掛【宋】【元】【明】【宮】"}
{"id": null, "n": "0960002", "target": "#nkr_note_mod_0960002", "type": "mod", "text": "大【大】，大喜【宋】【元】【明】【宮】"}
{"id": null, "n": "0960003", "target": "#nkr_note_mod_0960003", "type": "mod", "text": "衣【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0960004", "target": "#nkr_note_mod_0960004", "type": "mod", "text": "傘【大】，繖【宋】【元】【明】【宮】"}
{"id": null, "n": "0960005", "target": "#nkr_note_mod_0960005", "type": "mod", "text": "漚【大】＊，歐【宋】＊【元】＊【明】＊，區【宮】＊"}
{"id": null, "n": "0960006", "target": "#nkr_note_mod_0960006", "type": "mod", "text": "仍【大】，乃【宋】【元】【明】【宮】"}
{"id": null, "n": "0960007", "target": "#nkr_note_mod_0960007", "type": "mod", "text": "問【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0960008", "target": "#nkr_note_mod_0960008", "type": "mod", "text": "乃【大】，各【明】"}
{"id": null, "n": "0961001", "target": "#nkr_note_mod_0961001", "type": "mod", "text": "我【大】，我我【宋】【元】【明】【宮】"}
{"id": null, "n": "0961002", "target": "#nkr_note_mod_0961002", "type": "mod", "text": "從【大】，是【宋】【元】【明】【宮】"}
{"id": null, "n": "0961003", "target": "#nkr_note_mod_0961003", "type": "mod", "text": "具【大】，其【明】"}
{"id": null, "n": "0961004", "target": "#nkr_note_mod_0961004", "type": "mod", "text": "善【大】＊，聖【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0961005", "target": "#nkr_note_mod_0961005", "type": "mod", "text": "復【大】，相【明】"}
{"id": null, "n": "0961006", "target": "#nkr_note_mod_0961006", "type": "mod", "text": "苦【大】，若【明】"}
{"id": null, "n": "0961007", "target": "#nkr_note_mod_0961007", "type": "mod", "text": "稱【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0961008", "target": "#nkr_note_mod_0961008", "type": "mod", "text": "解【大】，得解【宋】【元】【明】【宮】"}
{"id": null, "n": "0961009", "target": "#nkr_note_mod_0961009", "type": "mod", "text": "今【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0961010", "target": "#nkr_note_mod_0961010", "type": "mod", "text": "波【大】＊，婆【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0962001", "target": "#nkr_note_mod_0962001", "type": "mod", "text": "有【大】，言【明】"}
{"id": null, "n": "0962002", "target": "#nkr_note_mod_0962002", "type": "mod", "text": "諸【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0962003", "target": "#nkr_note_mod_0962003", "type": "mod", "text": "疑【大】，諸疑【宋】【元】【明】【宮】"}
{"id": null, "n": "0962004", "target": "#nkr_note_mod_0962004", "type": "mod", "text": "清【大】，情【宋】【元】【明】【宮】"}
{"id": null, "n": "0962005", "target": "#nkr_note_mod_0962005", "type": "mod", "text": "來未【大】，未曾【宋】【元】【明】【宮】"}
{"id": null, "n": "0962006", "target": "#nkr_note_mod_0962006", "type": "mod", "text": "以【大】，已【宋】【元】【明】【宮】"}
{"id": null, "n": "0962007", "target": "#nkr_note_mod_0962007", "type": "mod", "text": "調【大】，諸【宋】【元】【明】"}
{"id": null, "n": "0962008", "target": "#nkr_note_mod_0962008", "type": "mod", "text": "飯【大】，飲【宋】【元】【明】【宮】"}
{"id": null, "n": "0962009", "target": "#nkr_note_mod_0962009", "type": "mod", "text": "等【大】，餘【明】"}
{"id": null, "n": "0963001", "target": "#nkr_note_mod_0963001", "type": "mod", "text": "言【大】，語【宋】【元】【明】【宮】"}
{"id": null, "n": "0963002", "target": "#nkr_note_mod_0963002", "type": "mod", "text": "不【大】，三不【宋】【元】【明】【宮】"}
{"id": null, "n": "0963003", "target": "#nkr_note_mod_0963003", "type": "mod", "text": "如實知十種不善【大】，十種善如實知【宋】【元】【明】【宮】"}
{"id": null, "n": "0963004", "target": "#nkr_note_mod_0963004", "type": "mod", "text": "網【大】＊，網耶【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0963005", "target": "#nkr_note_mod_0963005", "type": "mod", "text": "比丘和上【大】，作和尚【宋】【元】【明】，和尚【宮】"}
{"id": null, "n": "0964001", "target": "#nkr_note_mod_0964001", "type": "mod", "text": "上【大】，尚【宋】【元】【明】【宮】"}
{"id": null, "n": "0964002", "target": "#nkr_note_mod_0964002", "type": "mod", "text": "知【大】，知已覺【宋】【元】【明】【宮】"}
{"id": null, "n": "0964003", "target": "#nkr_note_mod_0964003", "type": "mod", "text": "離【大】，過籬【宋】【元】【明】【宮】"}
{"id": null, "n": "0965001", "target": "#nkr_note_mod_0965001", "type": "mod", "text": "習【大】，昌【宋】【元】，唱【宮】"}
{"id": null, "n": "0965002", "target": "#nkr_note_mod_0965002", "type": "mod", "text": "呰【大】，訾言【宋】【元】【明】【宮】"}
{"id": null, "n": "0965003", "target": "#nkr_note_mod_0965003", "type": "mod", "text": "出家相品【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0965004", "target": "#nkr_note_mod_0965004", "type": "mod", "text": "解脫解脫【大】，脫脫【宋】【元】【明】【宮】"}
{"id": null, "n": "0966001", "target": "#nkr_note_mod_0966001", "type": "mod", "text": "瓔珞【大】＊，纓絡【宮】＊"}
{"id": null, "n": "0966002", "target": "#nkr_note_mod_0966002", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0966003", "target": "#nkr_note_mod_0966003", "type": "mod", "text": "捼【大】＊，挼【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0966004", "target": "#nkr_note_mod_0966004", "type": "mod", "text": "和上【大】下同，和尚【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0967001", "target": "#nkr_note_mod_0967001", "type": "mod", "text": "諸【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0967002", "target": "#nkr_note_mod_0967002", "type": "mod", "text": "已【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0967003", "target": "#nkr_note_mod_0967003", "type": "mod", "text": "短【大】＊，瘠【宋】【元】【明】【宮】＊，但字下宋本元本宮本俱有夾註乙買二字"}
{"id": null, "n": "0968001", "target": "#nkr_note_mod_0968001", "type": "mod", "text": "憐【大】，怜【宋】【元】【宮】"}
{"id": null, "n": "0969001", "target": "#nkr_note_mod_0969001", "type": "mod", "text": "念【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0969002", "target": "#nkr_note_mod_0969002", "type": "mod", "text": "多【大】，陀【明】"}
{"id": null, "n": "0969003", "target": "#nkr_note_mod_0969003", "type": "mod", "text": "頹【大】＊，㿉【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0969004", "target": "#nkr_note_mod_0969004", "type": "mod", "text": "盤【大】，槃【宋】【元】【宮】"}
{"id": null, "n": "0970001", "target": "#nkr_note_mod_0970001", "type": "mod", "text": "槃【大】，盤【明】"}
{"id": null, "n": "0970002", "target": "#nkr_note_mod_0970002", "type": "mod", "text": "受【大】，授【宋】【元】【明】【宮】"}
{"id": null, "n": "0970003", "target": "#nkr_note_mod_0970003", "type": "mod", "text": "衣【大】，依【宋】【元】【明】【宮】"}
{"id": null, "n": "0970004", "target": "#nkr_note_mod_0970004", "type": "mod", "text": "糸【大】＊，絲【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0970005", "target": "#nkr_note_mod_0970005", "type": "mod", "text": "准【大】，唯【明】"}
{"id": null, "n": "0970006", "target": "#nkr_note_mod_0970006", "type": "mod", "text": "古【大】＊，吉【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0970007", "target": "#nkr_note_mod_0970007", "type": "mod", "text": "穌懺反【大】，穌憾反【宋】【元】，蘇𢜩反【宮】，〔－〕【明】"}
{"id": null, "n": "0970008", "target": "#nkr_note_mod_0970008", "type": "mod", "text": "無誄反【大】，〔－〕【明】"}
{"id": null, "n": "0970009", "target": "#nkr_note_mod_0970009", "type": "mod", "text": "紵【大】＊，苧【宋】＊【元】＊【明】＊，茅【宮】＊"}
{"id": null, "n": "0970010", "target": "#nkr_note_mod_0970010", "type": "mod", "text": "蟲【大】＊，虫【宋】【元】【宮】＊"}
{"id": null, "n": "0970011", "target": "#nkr_note_mod_0970011", "type": "mod", "text": "婆【大】，波【宋】【元】【宮】"}
{"id": null, "n": "0970012", "target": "#nkr_note_mod_0970012", "type": "mod", "text": "蠟【大】，蠟臘【宋】【元】【明】【宮】"}
{"id": null, "n": "0970013", "target": "#nkr_note_mod_0970013", "type": "mod", "text": "叛【大】，判【明】"}
{"id": null, "n": "0970014", "target": "#nkr_note_mod_0970014", "type": "mod", "text": "堂【大】，堂重閣堂【宋】【元】【明】【宮】"}
{"id": null, "n": "0970015", "target": "#nkr_note_mod_0970015", "type": "mod", "text": "檐【大】，擔【宋】【元】【明】【宮】"}
{"id": null, "n": "0970016", "target": "#nkr_note_mod_0970016", "type": "mod", "text": "供【大】，供不【宋】【元】【明】【宮】"}
{"id": null, "n": "0970017", "target": "#nkr_note_mod_0970017", "type": "mod", "text": "酥【大】，蘇【宋】【宮】"}
{"id": null, "n": "0970018", "target": "#nkr_note_mod_0970018", "type": "mod", "text": "壽【大】，壽藥【宋】【元】【明】【宮】"}
{"id": null, "n": "0970019", "target": "#nkr_note_mod_0970019", "type": "mod", "text": "芽【大】，牙【宋】【宮】"}
{"id": null, "n": "0970020", "target": "#nkr_note_mod_0970020", "type": "mod", "text": "堀【大】＊，窟【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0970021", "target": "#nkr_note_mod_0970021", "type": "mod", "text": "墮【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0971001", "target": "#nkr_note_mod_0971001", "type": "mod", "text": "與【大】，興【宋】【元】【明】【宮】"}
