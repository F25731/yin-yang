{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "四"}
{"id": null, "n": null, "target": null, "type": null, "text": "五"}
{"id": null, "n": null, "target": null, "type": null, "text": "六"}
{"id": null, "n": null, "target": null, "type": null, "text": "七"}
{"id": null, "n": null, "target": null, "type": null, "text": "垂拱二年於西魏國寺譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "蘇臘反"}
{"id": null, "n": null, "target": null, "type": null, "text": "都那反"}
{"id": null, "n": null, "target": null, "type": null, "text": "得香茅第一不得直茅亦得"}
{"id": null, "n": "0186026", "target": null, "type": "orig", "text": "今＝當【甲】"}
{"id": null, "n": "0186026", "target": null, "type": "mod", "text": "今【大】，當【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "垂拱二年於西魏國寺譯"}
{"id": null, "n": "0185005", "target": "#nkr_note_mod_0185005", "type": "mod", "text": "大唐天竺三藏【大】，大周沙門【宋】，唐武周沙門【明】【甲】"}
{"id": null, "n": "0185006", "target": "#nkr_note_mod_0185006", "type": "mod", "text": "愍【大】，愍念【宋】【明】【甲】"}
{"id": null, "n": "0185007", "target": "#nkr_note_mod_0185007", "type": "mod", "text": "謨【大】，無【明】【甲】"}
{"id": null, "n": "0185008", "target": "#nkr_note_mod_0185008", "type": "mod", "text": "颯【大】，颯蘇臘反【宋】"}
{"id": null, "n": null, "target": null, "type": null, "text": "蘇臘反"}
{"id": null, "n": "0185009", "target": "#nkr_note_mod_0185009", "type": "mod", "text": "哆【大】，哆都那反【宋】"}
{"id": null, "n": null, "target": null, "type": null, "text": "都那反"}
{"id": null, "n": "0185010", "target": "#nkr_note_mod_0185010", "type": "mod", "text": "一【大】，奴誓反一【宋】"}
{"id": null, "n": "0185011", "target": "#nkr_note_mod_0185011", "type": "mod", "text": "勃【大】，勃蒲沒反【宋】"}
{"id": null, "n": "0185012", "target": "#nkr_note_mod_0185012", "type": "mod", "text": "二【大】，同上二句【宋】"}
{"id": null, "n": "0185013", "target": "#nkr_note_mod_0185013", "type": "mod", "text": "怛【大】，怛都捺反【宋】"}
{"id": null, "n": "0185014", "target": "#nkr_note_mod_0185014", "type": "mod", "text": "姪【大】，姪徒列反【宋】"}
{"id": null, "n": "0185015", "target": "#nkr_note_mod_0185015", "type": "mod", "text": "三【大】，長引三【宋】【明】【甲】"}
{"id": null, "n": "0185016", "target": "#nkr_note_mod_0185016", "type": "mod", "text": "四【大】，之熱反四【宋】"}
{"id": null, "n": "0185017", "target": "#nkr_note_mod_0185017", "type": "mod", "text": "五【大】，同上五句【宋】"}
{"id": null, "n": "0185018", "target": "#nkr_note_mod_0185018", "type": "mod", "text": "締【大】，提【宋】【明】【甲】"}
{"id": null, "n": "0185019", "target": "#nkr_note_mod_0185019", "type": "mod", "text": "六【大】，六句【宋】"}
{"id": null, "n": "0185020", "target": "#nkr_note_mod_0185020", "type": "mod", "text": "娑【大】，莎【宋】【明】【甲】"}
{"id": null, "n": "0185021", "target": "#nkr_note_mod_0185021", "type": "mod", "text": "七【大】，七句【宋】"}
{"id": null, "n": "0185022", "target": "#nkr_note_mod_0185022", "type": "mod", "text": "皆【大】，〔－〕【宋】【明】【甲】"}
{"id": null, "n": "0185023", "target": "#nkr_note_mod_0185023", "type": "mod", "text": "消【大】，〔－〕【宋】【明】【甲】"}
{"id": null, "n": "0185024", "target": "#nkr_note_mod_0185024", "type": "mod", "text": "滅【大】，滅無餘【宋】【明】【甲】"}
{"id": null, "n": "0185025", "target": "#nkr_note_mod_0185025", "type": "mod", "text": "具【大】，具隨具【甲】"}
{"id": null, "n": "0185026", "target": "#nkr_note_mod_0185026", "type": "mod", "text": "說【大】，出【宋】【明】【甲】"}
{"id": null, "n": "0185027", "target": "#nkr_note_mod_0185027", "type": "mod", "text": "語【大】，教【宋】【甲】"}
{"id": null, "n": "0185028", "target": "#nkr_note_mod_0185028", "type": "mod", "text": "吐【大】＊，咄【甲】＊"}
{"id": null, "n": "0185029", "target": "#nkr_note_mod_0185029", "type": "mod", "text": "物【大】＊，飯【宋】【明】【甲】＊"}
{"id": null, "n": "0185030", "target": "#nkr_note_mod_0185030", "type": "mod", "text": "復【大】，〔－〕【宋】【明】【甲】"}
{"id": null, "n": "0185031", "target": "#nkr_note_mod_0185031", "type": "mod", "text": "見【大】，見口中【宋】【明】【甲】"}
{"id": null, "n": "0185032", "target": "#nkr_note_mod_0185032", "type": "mod", "text": "罪【大】，罪者【宋】【甲】"}
{"id": null, "n": "0185033", "target": "#nkr_note_mod_0185033", "type": "mod", "text": "之者宜【大】，現時【宋】【明】【甲】"}
{"id": null, "n": "0185034", "target": "#nkr_note_mod_0185034", "type": "mod", "text": "如酪飯等【大】，粳米酪飯【宋】【明】【甲】"}
{"id": null, "n": "0185035", "target": "#nkr_note_mod_0185035", "type": "mod", "text": "此【大】，之【明】【甲】"}
{"id": null, "n": "0185036", "target": "#nkr_note_mod_0185036", "type": "mod", "text": "夷【大】，夷唐云牛糞【宋】，夷此云牛糞【明】【甲】"}
{"id": null, "n": "0185037", "target": "#nkr_note_mod_0185037", "type": "mod", "text": "飲【大】，飯【甲】"}
{"id": null, "n": "0185038", "target": "#nkr_note_mod_0185038", "type": "mod", "text": "燈燭【大】，燈明燭火【宋】【明】【甲】"}
{"id": null, "n": "0185039", "target": "#nkr_note_mod_0185039", "type": "mod", "text": "方【大】，方及以【宋】【明】【甲】"}
{"id": null, "n": "0185040", "target": "#nkr_note_mod_0185040", "type": "mod", "text": "界【大】，界既結界已【宋】【明】【甲】"}
{"id": null, "n": "0185041", "target": "#nkr_note_mod_0185041", "type": "mod", "text": "胡【大】，䠒【甲】"}
{"id": null, "n": "0185042", "target": "#nkr_note_mod_0185042", "type": "mod", "text": "八【大】＊，八十【宋】【明】【甲】＊"}
{"id": null, "n": "0185043", "target": "#nkr_note_mod_0185043", "type": "mod", "text": "轉【大】，輪【甲】"}
{"id": null, "n": "0185044", "target": "#nkr_note_mod_0185044", "type": "mod", "text": "千【大】＊，一千【宋】【明】【甲】＊"}
{"id": null, "n": "0185045", "target": "#nkr_note_mod_0185045", "type": "mod", "text": "觀【大】，觀鏡面【宋】【元】【甲】"}
{"id": null, "n": "0185046", "target": "#nkr_note_mod_0185046", "type": "mod", "text": "遍【大】，遍又以香油以蘇摩那花香浸著胡麻油中塗手大指誦呪一百八遍即於童面鏡中指爪甲內皆各【宋】【明】【甲】"}
{"id": null, "n": "0185047", "target": "#nkr_note_mod_0185047", "type": "mod", "text": "應【大】，復誦呪【宋】【明】【甲】"}
{"id": null, "n": "0185048", "target": "#nkr_note_mod_0185048", "type": "mod", "text": "百【大】，一百【宋】【明】【甲】"}
{"id": null, "n": "0185049", "target": "#nkr_note_mod_0185049", "type": "mod", "text": "養【大】，養佛菩薩像心所有事一一【宋】【明】【甲】"}
{"id": null, "n": "0185050", "target": "#nkr_note_mod_0185050", "type": "mod", "text": "隨【大】，〔－〕【宋】【明】【甲】"}
{"id": null, "n": "0185051", "target": "#nkr_note_mod_0185051", "type": "mod", "text": "法【大】，〔－〕【宋】【甲】"}
{"id": null, "n": "0185052", "target": "#nkr_note_mod_0185052", "type": "mod", "text": "呪【大】，呪呪【宋】【明】【甲】"}
{"id": null, "n": "0185053", "target": "#nkr_note_mod_0185053", "type": "mod", "text": "草【大】，得香茅第一不得直茅亦得【宋】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "得香茅第一不得直茅亦得"}
{"id": null, "n": "0185054", "target": "#nkr_note_mod_0185054", "type": "mod", "text": "搓【大】，合【宋】【明】【甲】"}
{"id": null, "n": "0185055", "target": "#nkr_note_mod_0185055", "type": "mod", "text": "為【大】，成【宋】【明】【甲】"}
{"id": null, "n": "0185056", "target": "#nkr_note_mod_0185056", "type": "mod", "text": "一【大】，一結【宋】【明】【甲】"}
{"id": null, "n": "0185057", "target": "#nkr_note_mod_0185057", "type": "mod", "text": "以【大】，以白【宋】【明】【甲】"}
{"id": null, "n": "0185058", "target": "#nkr_note_mod_0185058", "type": "mod", "text": "滿【大】，之【宋】【明】【甲】"}
{"id": null, "n": "0185059", "target": "#nkr_note_mod_0185059", "type": "mod", "text": "散【大】，復散【宋】【明】【甲】"}
{"id": null, "n": "0185060", "target": "#nkr_note_mod_0185060", "type": "mod", "text": "差【大】＊，瘥【宋】【明】【甲】＊"}
{"id": null, "n": "0185061", "target": "#nkr_note_mod_0185061", "type": "mod", "text": "前【大】，前以【宋】【明】【甲】"}
{"id": null, "n": "0185062", "target": "#nkr_note_mod_0185062", "type": "mod", "text": "形【大】，病人形像【宋】【明】【甲】"}
{"id": null, "n": "0185063", "target": "#nkr_note_mod_0185063", "type": "mod", "text": "之【大】，此畫形【宋】【明】【甲】"}
{"id": null, "n": "0185064", "target": "#nkr_note_mod_0185064", "type": "mod", "text": "便【大】，得【宋】【明】【甲】"}
{"id": null, "n": "0185065", "target": "#nkr_note_mod_0185065", "type": "mod", "text": "次有【大】＊，有一【宋】【明】【甲】＊"}
{"id": null, "n": "0185066", "target": "#nkr_note_mod_0185066", "type": "mod", "text": "具【大】，足【宋】【明】【甲】"}
{"id": null, "n": "0185067", "target": "#nkr_note_mod_0185067", "type": "mod", "text": "人【大】，往【宋】【明】【甲】"}
{"id": null, "n": "0185068", "target": "#nkr_note_mod_0185068", "type": "mod", "text": "差【大】，愈【宋】【明】【甲】"}
{"id": null, "n": "0185069", "target": "#nkr_note_mod_0185069", "type": "mod", "text": "誦【大】，誦念【宋】【明】【甲】"}
{"id": null, "n": "0185070", "target": "#nkr_note_mod_0185070", "type": "mod", "text": "畏【大】，怖【宋】【明】【甲】"}
{"id": null, "n": "0185071", "target": "#nkr_note_mod_0185071", "type": "mod", "text": "禁【大】，禁繫【宋】【明】【甲】"}
{"id": null, "n": "0185072", "target": "#nkr_note_mod_0185072", "type": "mod", "text": "次有【大】，有一【宋】【明】，一【甲】"}
{"id": null, "n": "0185073", "target": "#nkr_note_mod_0185073", "type": "mod", "text": "行【大】，行應行【甲】"}
{"id": null, "n": "0185074", "target": "#nkr_note_mod_0185074", "type": "mod", "text": "置【大】，擲【宋】【明】【甲】"}
{"id": null, "n": "0185075", "target": "#nkr_note_mod_0185075", "type": "mod", "text": "悉皆【大】，無不【宋】【明】【甲】"}
{"id": null, "n": "0185076", "target": "#nkr_note_mod_0185076", "type": "mod", "text": "滅【大】，滅復有一法以酥和稻穀呪一百八遍火中燒之隨心所願無不成諦財寶增盈求心滿足若人欲令他敬念者稱彼前人名字一呪一稱滿一百八遍即便敬念【宋】【明】【甲】"}
{"id": null, "n": "0186001", "target": "#nkr_note_mod_0186001", "type": "mod", "text": "以【大】，以塗形像【宋】【明】，以塔形形像【甲】"}
{"id": null, "n": "0186002", "target": "#nkr_note_mod_0186002", "type": "mod", "text": "砂【大】，砂坦上【宋】，砂潬上【明】【甲】"}
{"id": null, "n": "0186003", "target": "#nkr_note_mod_0186003", "type": "mod", "text": "滿【大】，如是數滿【宋】【明】【甲】"}
{"id": null, "n": "0186004", "target": "#nkr_note_mod_0186004", "type": "mod", "text": "或【大】，即得覩【宋】【明】【甲】"}
{"id": null, "n": "0186005", "target": "#nkr_note_mod_0186005", "type": "mod", "text": "見【大】，見聖者【宋】【明】【甲】"}
{"id": null, "n": "0186006", "target": "#nkr_note_mod_0186006", "type": "mod", "text": "世音【大】，自在【宋】【明】【甲】"}
{"id": null, "n": "0186007", "target": "#nkr_note_mod_0186007", "type": "mod", "text": "薩【大】，薩之像【宋】【明】【甲】"}
{"id": null, "n": "0186008", "target": "#nkr_note_mod_0186008", "type": "mod", "text": "或見【大】，〔－〕【宋】【明】【甲】"}
{"id": null, "n": "0186009", "target": "#nkr_note_mod_0186009", "type": "mod", "text": "主【大】，手【甲】"}
{"id": null, "n": "0186010", "target": "#nkr_note_mod_0186010", "type": "mod", "text": "隨【大】，隨其【宋】【明】【甲】"}
{"id": null, "n": "0186011", "target": "#nkr_note_mod_0186011", "type": "mod", "text": "所求【大】，願【宋】【明】【甲】"}
{"id": null, "n": "0186012", "target": "#nkr_note_mod_0186012", "type": "mod", "text": "仙【大】，仙神妙【宋】【明】【甲】"}
{"id": null, "n": "0186013", "target": "#nkr_note_mod_0186013", "type": "mod", "text": "與受【大】，授與【宋】【明】【甲】"}
{"id": null, "n": "0186014", "target": "#nkr_note_mod_0186014", "type": "mod", "text": "法【大】，法作【宋】【明】【甲】"}
{"id": null, "n": "0186015", "target": "#nkr_note_mod_0186015", "type": "mod", "text": "惱【大】，侵【宋】【明】【甲】"}
{"id": null, "n": "0186016", "target": "#nkr_note_mod_0186016", "type": "mod", "text": "若於【大】，復有一法若在【宋】【明】【甲】"}
{"id": null, "n": "0186017", "target": "#nkr_note_mod_0186017", "type": "mod", "text": "復【大】，〔－〕【甲】"}
{"id": null, "n": "0186018", "target": "#nkr_note_mod_0186018", "type": "mod", "text": "念【大】，〔－〕【宋】【明】【甲】"}
{"id": null, "n": "0186019", "target": "#nkr_note_mod_0186019", "type": "mod", "text": "乃至【大】，〔－〕【宋】【明】【甲】"}
{"id": null, "n": "0186020", "target": "#nkr_note_mod_0186020", "type": "mod", "text": "人【大】，〔－〕【甲】"}
{"id": null, "n": "0186021", "target": "#nkr_note_mod_0186021", "type": "mod", "text": "從【大】，於【宋】【明】【甲】"}
{"id": null, "n": "0186022", "target": "#nkr_note_mod_0186022", "type": "mod", "text": "常【大】，〔－〕【宋】【明】【甲】"}
{"id": null, "n": "0186023", "target": "#nkr_note_mod_0186023", "type": "mod", "text": "善【大】，其勝【宋】【明】【甲】"}
{"id": null, "n": "0186024", "target": "#nkr_note_mod_0186024", "type": "mod", "text": "〔－〕【甲】，未來一切諸佛當說【大】∞現在一切諸佛今說【宋】【明】"}
{"id": null, "n": "0186025", "target": "#nkr_note_mod_0186025", "type": "mod", "text": "現在一切諸佛今說【大】∞未來一切諸佛當說【宋】【明】"}
{"id": null, "n": "0186026", "target": "#nkr_note_mod_0186026", "type": "mod", "text": "今【大】，當【甲】"}
{"id": null, "n": "0186027", "target": "#nkr_note_mod_0186027", "type": "mod", "text": "益【大】，〔－〕【宋】【甲】"}
{"id": null, "n": "0186028", "target": "#nkr_note_mod_0186028", "type": "mod", "text": "令【大】，〔－〕【宋】【明】【甲】"}
{"id": null, "n": "0186029", "target": "#nkr_note_mod_0186029", "type": "mod", "text": "無【大】，無有【宋】【明】【甲】"}
{"id": null, "n": "0186030", "target": "#nkr_note_mod_0186030", "type": "mod", "text": "菩提分法【大】，菩提分【宋】【明】，善根分【甲】"}
{"id": null, "n": "0186031", "target": "#nkr_note_mod_0186031", "type": "mod", "text": "陀【大】，大准提陀【宋】【明】【甲】"}
{"id": null, "n": "0186032", "target": "#nkr_note_mod_0186032", "type": "mod", "text": "能常自憶【大】，憶持誦【宋】【明】【甲】"}
{"id": null, "n": "0186033", "target": "#nkr_note_mod_0186033", "type": "mod", "text": "誦持此呪【大】，常不懈廢此佛母心大准提陀羅尼者【宋】【明】【甲】"}
