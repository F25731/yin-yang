{"id": null, "n": null, "target": null, "type": null, "text": "無所方便為苦"}
{"id": null, "n": "0863010", "target": "#nkr_note_mod_0863010", "type": "mod", "text": "加【大】，伽【宋】【元】【明】"}
{"id": null, "n": "0863011", "target": "#nkr_note_mod_0863011", "type": "mod", "text": "彼【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0863012", "target": "#nkr_note_mod_0863012", "type": "mod", "text": "施【大】，使【明】"}
{"id": null, "n": "0863013", "target": "#nkr_note_mod_0863013", "type": "mod", "text": "伏【大】，復【明】"}
{"id": null, "n": "0863014", "target": "#nkr_note_mod_0863014", "type": "mod", "text": "為【大】，施【宋】【元】【明】"}
{"id": null, "n": "0863015", "target": "#nkr_note_mod_0863015", "type": "mod", "text": "不【大】，亦不【宋】【元】【明】"}
{"id": null, "n": "0863016", "target": "#nkr_note_mod_0863016", "type": "mod", "text": "施與【大】，不施與【宋】【元】，不施【明】"}
{"id": null, "n": "0863017", "target": "#nkr_note_mod_0863017", "type": "mod", "text": "善處【大】，善處如是居士是一伏婬復次居士或一伏婬如法求財不干彼如法求財不干已自得安樂身及父母妻子奴婢施與沙門婆羅門為善得善身生善處【宋】【元】【明】"}
{"id": null, "n": "0864001", "target": "#nkr_note_mod_0864001", "type": "mod", "text": "知【大】，如【宋】【元】【明】"}
{"id": null, "n": "0864002", "target": "#nkr_note_mod_0864002", "type": "mod", "text": "酥【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0864003", "target": "#nkr_note_mod_0864003", "type": "mod", "text": "最【大】，最上【宋】【元】【明】"}
{"id": null, "n": "0863010", "target": "#nkr_note_orig_0863010", "type": "orig", "text": "加＝伽【三】"}
{"id": null, "n": "0863011", "target": "#nkr_note_orig_0863011", "type": "orig", "text": "〔彼〕－【三】＊"}
{"id": null, "n": "0863012", "target": "#nkr_note_orig_0863012", "type": "orig", "text": "施＝使【明】"}
{"id": null, "n": "0863013", "target": "#nkr_note_orig_0863013", "type": "orig", "text": "伏＝復【明】"}
{"id": null, "n": "0863014", "target": "#nkr_note_orig_0863014", "type": "orig", "text": "為＝施【三】"}
{"id": null, "n": "0863015", "target": "#nkr_note_orig_0863015", "type": "orig", "text": "（亦）＋不【三】"}
{"id": null, "n": "0863016", "target": "#nkr_note_orig_0863016", "type": "orig", "text": "施與＝不施與【宋】【元】，不施【明】"}
{"id": null, "n": "0863017", "target": "#nkr_note_orig_0863017", "type": "orig", "text": "善處＋（如是居士是一伏婬復次居士或一伏婬如法求財不干彼如法求財不干已自得安樂身及父母妻子奴婢施與沙門婆羅門為善得善身生善處）五十七字【三】"}
{"id": null, "n": "0864001", "target": "#nkr_note_orig_0864001", "type": "orig", "text": "知＝如【三】"}
{"id": null, "n": "0864002", "target": "#nkr_note_orig_0864002", "type": "orig", "text": "〔酥〕－【三】"}
{"id": null, "n": "0864003", "target": "#nkr_note_orig_0864003", "type": "orig", "text": "最＋（上）【三】"}
