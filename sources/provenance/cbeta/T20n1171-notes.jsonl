{"id": null, "n": "0705002", "target": "#nkr_note_mod_0705002", "type": "mod", "text": "亦名五字呪法【大】，〔－〕【乙】"}
{"id": null, "n": "0705003", "target": "#nkr_note_mod_0705003", "type": "mod", "text": "開府儀同三司【大】，〔－〕【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0705004", "target": "#nkr_note_mod_0705004", "type": "mod", "text": "特【大】，唐特【明】【甲】"}
{"id": null, "n": "0705005", "target": "#nkr_note_mod_0705005", "type": "mod", "text": "卿【大】，〔－〕【乙】"}
{"id": null, "n": "0705006", "target": "#nkr_note_mod_0705006", "type": "mod", "text": "（肅國…智）二十一字【大】，〔－〕【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0705007", "target": "#nkr_note_mod_0705007", "type": "mod", "text": "大興善寺【大】，〔－〕【明】【甲】"}
{"id": null, "n": "0705008", "target": "#nkr_note_mod_0705008", "type": "mod", "text": "門【大】，門大廣智【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0705009", "target": "#nkr_note_mod_0705009", "type": "mod", "text": "義【大】，藏【乙】"}
{"id": null, "n": "0705010", "target": "#nkr_note_mod_0705010", "type": "mod", "text": "阿【大】＊，婀【宋】【元】【明】【甲】＊"}
{"id": null, "n": "0705011", "target": "#nkr_note_mod_0705011", "type": "mod", "text": "法【大】，諸法【校異-甲】"}
{"id": null, "n": "0705012", "target": "#nkr_note_mod_0705012", "type": "mod", "text": "令【大】，令利益【宋】【元】，今利益【明】"}
{"id": null, "n": "0705013", "target": "#nkr_note_mod_0705013", "type": "mod", "text": "荼【大】＊，茶【宋】【元】＊"}
{"id": null, "n": "0705014", "target": "#nkr_note_mod_0705014", "type": "mod", "text": "擇極乃至供養之四百五十字元本闕"}
{"id": null, "n": "0705015", "target": "#nkr_note_mod_0705015", "type": "mod", "text": "茶【大】＊，荼【明】【甲】【乙】＊"}
{"id": null, "n": "0705016", "target": "#nkr_note_mod_0705016", "type": "mod", "text": "利【大】，別【宋】"}
