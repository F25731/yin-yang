{"id": null, "n": null, "target": null, "type": null, "text": "「順宗」者，《歷帝記》云：「大唐第十一代順宗皇帝\n是也。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "「清涼」者，佳號也。准碑文云：師本越州人，俗姓夏\n候氏。十一便投師體真寶林寺，年滿具尸羅，解通三藏義等。\n其問答義在向下也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "「心」者，所證之理也；「門」者，能生之文也；「法」\n者，軌生物解也。因文生智，以為軌則，悟此心地，誠為要\n哉。"}
{"id": null, "n": null, "target": null, "type": null, "text": "裴公云：「觀」者，見法之眼；「門」者，通智眼，令\n見法之門也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "諸佛眾生，迷悟本也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "萬法之宗，本乎無住。即心體也。\n《淨名經》云：「依無住本，立一切法。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "瑩淨之理。"}
{"id": null, "n": null, "target": null, "type": null, "text": "性即空，空絕迹相，即星象粲然。"}
{"id": null, "n": null, "target": null, "type": null, "text": "性包含於\n神用，具塵沙之無邊；"}
{"id": null, "n": null, "target": null, "type": null, "text": "相該攝於內外，亦不\n\n在於中間。"}
{"id": null, "n": null, "target": null, "type": null, "text": "無外也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "無內也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "妙有不空，真空不有。"}
{"id": null, "n": null, "target": null, "type": null, "text": "非四相所遷也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "明一真心地，\n絕取捨之情。"}
{"id": null, "n": null, "target": null, "type": null, "text": "迷本逐末。"}
{"id": null, "n": null, "target": null, "type": null, "text": "返本還源。"}
{"id": null, "n": null, "target": null, "type": null, "text": "凡聖一真，猶來見\n隔。見在即凡，情忘即佛。智與理冥，境與神會者方知也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "若存證\n知，則棄內而外求，即滯於有。"}
{"id": null, "n": null, "target": null, "type": null, "text": "若忘智忘照，即外忘緣而內忘照，即滯\n於無。"}
{"id": null, "n": null, "target": null, "type": null, "text": "妄心不生，二際\n\n俱斷。"}
{"id": null, "n": null, "target": null, "type": null, "text": "真智現前，我及我所，\n悉皆同體。"}
{"id": null, "n": null, "target": null, "type": null, "text": "至理虛玄，言忘\n慮絕。不可以識識，不可以行得。"}
{"id": null, "n": null, "target": null, "type": null, "text": "性自天真，\n本無取捨。"}
{"id": null, "n": null, "target": null, "type": null, "text": "本非對待，豈有修作？"}
{"id": null, "n": null, "target": null, "type": null, "text": "迷即六凡，悟則四聖。\n真智生，妄念滅。妄若起，真智隱。"}
{"id": null, "n": null, "target": null, "type": null, "text": "若有取捨，\n勞形役智。"}
{"id": null, "n": null, "target": null, "type": null, "text": "妄無自\n性，舉體即真。"}
{"id": null, "n": null, "target": null, "type": null, "text": "既忘心照，煩惱\n自空。"}
{"id": null, "n": null, "target": null, "type": null, "text": "起即體之用。\n用而無用，何假因耶？"}
{"id": null, "n": null, "target": null, "type": null, "text": "不著彼此。"}
{"id": null, "n": null, "target": null, "type": null, "text": "動靜不失理也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "語默全真。"}
{"id": null, "n": null, "target": null, "type": null, "text": "去住合道。"}
{"id": null, "n": null, "target": null, "type": null, "text": "止觀俱泯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "止觀齊彰。"}
{"id": null, "n": null, "target": null, "type": null, "text": "寂然之理，不可說示。"}
{"id": null, "n": null, "target": null, "type": null, "text": "唯證相應。"}
{"id": null, "n": null, "target": null, "type": null, "text": "智與理泯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "真知之理，泯能知智。"}
{"id": null, "n": null, "target": null, "type": null, "text": "以即理之智也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "證不二之理\n也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "二邊不立，中道不安。"}
{"id": null, "n": null, "target": null, "type": null, "text": "任法界性，延促無礙。"}
{"id": null, "n": null, "target": null, "type": null, "text": "法界真性，思慮叵窮。若絕能\n所，則真智現前也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "不從外得。"}
{"id": null, "n": null, "target": null, "type": null, "text": "非新新有。"}
{"id": null, "n": null, "target": null, "type": null, "text": "理非智不能顯也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "智非理不能生。"}
{"id": null, "n": null, "target": null, "type": null, "text": "本末俱泯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "體無瑕翳。"}
{"id": null, "n": null, "target": null, "type": null, "text": "凡聖相入。"}
{"id": null, "n": null, "target": null, "type": null, "text": "念念全真。"}
{"id": null, "n": null, "target": null, "type": null, "text": "即染而淨。"}
{"id": null, "n": null, "target": null, "type": null, "text": "二而不二。"}
{"id": null, "n": null, "target": null, "type": null, "text": "不二而二。"}
{"id": null, "n": null, "target": null, "type": null, "text": "迷\n真逐妄。"}
{"id": null, "n": null, "target": null, "type": null, "text": "物象無體。"}
{"id": null, "n": null, "target": null, "type": null, "text": "本離言念。"}
{"id": null, "n": null, "target": null, "type": null, "text": "非同異境。"}
{"id": null, "n": null, "target": null, "type": null, "text": "佩道之士，契之即神。"}
{"id": null, "n": null, "target": null, "type": null, "text": "喻之也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "虛心之鑒。"}
{"id": null, "n": null, "target": null, "type": null, "text": "所迷之理。"}
{"id": null, "n": null, "target": null, "type": null, "text": "萬物自\n虛。"}
{"id": null, "n": null, "target": null, "type": null, "text": "緣生本無。"}
{"id": null, "n": null, "target": null, "type": null, "text": "起處\n不真。"}
{"id": null, "n": null, "target": null, "type": null, "text": "似日初出。"}
{"id": null, "n": null, "target": null, "type": null, "text": "即無障\n礙。"}
{"id": null, "n": null, "target": null, "type": null, "text": "情忘理現。"}
{"id": null, "n": null, "target": null, "type": null, "text": "智起惑\n忘。"}
{"id": null, "n": null, "target": null, "type": null, "text": "性無異故。"}
{"id": null, "n": null, "target": null, "type": null, "text": "真妄無\n別。"}
{"id": null, "n": "0039001", "target": "#nkr_note_orig_0039001", "type": "orig", "text": "《宋高僧傳》，中華書局，1987年8月，第106頁。"}
{"id": null, "n": "0041001", "target": "#nkr_note_orig_0041001", "type": "orig", "text": "孟列夫著、王克孝譯：《黑城出土漢文遺書敘錄》，寧夏人民出版社，1994年11月，第189頁。"}
{"id": null, "n": "0043001", "target": "#nkr_note_orig_0043001", "type": "orig", "text": "參見《應縣木塔遼代秘藏》，文物出版社，1991年7月，第7頁。"}
{"id": null, "n": "0045001", "target": "#nkr_note_orig_0045001", "type": "orig", "text": "自文首至此，甲本作「五臺山鎮國大師澄觀答皇太子問心要」。乙本作「答順宗心要法門，唐清涼國師澄觀撰，圭峰沙門宗密注」。乙本無宗密注。"}
{"id": null, "n": "0045002", "target": "#nkr_note_orig_0045002", "type": "orig", "text": "「無住心體，靈知不昧。瑩淨之理」，原系於「丁二，二釋心之相」下，但視其內容，應歸入「丁三，三體用」之中。故移入此處。"}
{"id": null, "n": "0045003", "target": "#nkr_note_orig_0045003", "type": "orig", "text": "「然」，乙本作「默」。"}
{"id": null, "n": "0045004", "target": "#nkr_note_orig_0045004", "type": "orig", "text": "「性包含於神用，具塵沙之無邊」等12字，底本置於「該攝內外」之後，據乙本移置此處。"}
{"id": null, "n": "0046001", "target": "#nkr_note_orig_0046001", "type": "orig", "text": "「能廣能深」，甲本作「能深能廣」。"}
{"id": null, "n": "0046002", "target": "#nkr_note_orig_0046002", "type": "orig", "text": "「無始無終」，底本、乙本無，據甲本補。"}
{"id": null, "n": "0046003", "target": "#nkr_note_orig_0046003", "type": "orig", "text": "「之」，甲本作「之而」。"}
{"id": null, "n": "0046004", "target": "#nkr_note_orig_0046004", "type": "orig", "text": "「之」，甲本作「之而」。"}
{"id": null, "n": "0046005", "target": "#nkr_note_orig_0046005", "type": "orig", "text": "「惑」，甲本作「感」。"}
{"id": null, "n": "0046006", "target": "#nkr_note_orig_0046006", "type": "orig", "text": "「悟」，甲本作「寤」。"}
{"id": null, "n": "0046007", "target": "#nkr_note_orig_0046007", "type": "orig", "text": "「慧」，底本作「惠」，據甲本、乙本改。"}
{"id": null, "n": "0046008", "target": "#nkr_note_orig_0046008", "type": "orig", "text": "「外」，底本作「好」，據乙本改。"}
{"id": null, "n": "0046009", "target": "#nkr_note_orig_0046009", "type": "orig", "text": "「忘」，底本無，據乙本補。"}
{"id": null, "n": "0046010", "target": "#nkr_note_orig_0046010", "type": "orig", "text": "「但」，甲本作「若」。"}
{"id": null, "n": "0046011", "target": "#nkr_note_orig_0046011", "type": "orig", "text": "「前」，甲本作「則前」。"}
{"id": null, "n": "0047001", "target": "#nkr_note_orig_0047001", "type": "orig", "text": "「如避」，甲本作「猶棄」。"}
{"id": null, "n": "0047002", "target": "#nkr_note_orig_0047002", "type": "orig", "text": "「以」，甲本無。"}
{"id": null, "n": "0047003", "target": "#nkr_note_orig_0047003", "type": "orig", "text": "「而」，甲本無。"}
{"id": null, "n": "0047004", "target": "#nkr_note_orig_0047004", "type": "orig", "text": "「累」，甲本作「慮」。"}
{"id": null, "n": "0047005", "target": "#nkr_note_orig_0047005", "type": "orig", "text": "「爰」，乙本作「圓」。"}
{"id": null, "n": "0047006", "target": "#nkr_note_orig_0047006", "type": "orig", "text": "「著」，底本不清，似為「看」，據乙本改。"}
{"id": null, "n": "0047007", "target": "#nkr_note_orig_0047007", "type": "orig", "text": "「見」，甲本作「覺」。"}
{"id": null, "n": "0047008", "target": "#nkr_note_orig_0047008", "type": "orig", "text": "「豈」，甲本作「未」。"}
{"id": null, "n": "0048001", "target": "#nkr_note_orig_0048001", "type": "orig", "text": "「忘」，甲本作「亡」。"}
{"id": null, "n": "0048002", "target": "#nkr_note_orig_0048002", "type": "orig", "text": "「知」，底本、乙本作「智」，據甲本改。"}
{"id": null, "n": "0048003", "target": "#nkr_note_orig_0048003", "type": "orig", "text": "「證」，甲本作「證則」。"}
{"id": null, "n": "0048004", "target": "#nkr_note_orig_0048004", "type": "orig", "text": "「理」，甲本作「理則」。"}
{"id": null, "n": "0048005", "target": "#nkr_note_orig_0048005", "type": "orig", "text": "「悟」，甲本作「是以悟」。"}
{"id": null, "n": "0048006", "target": "#nkr_note_orig_0048006", "type": "orig", "text": "「著」，底本作「著」，據甲本、乙本改。"}
{"id": null, "n": "0048007", "target": "#nkr_note_orig_0048007", "type": "orig", "text": "「忘」，甲本作「亡」。"}
{"id": null, "n": "0048008", "target": "#nkr_note_orig_0048008", "type": "orig", "text": "「絕」，甲本作「寂」。"}
{"id": null, "n": "0048009", "target": "#nkr_note_orig_0048009", "type": "orig", "text": "「般」，甲本作「則般」。"}
{"id": null, "n": "0048010", "target": "#nkr_note_orig_0048010", "type": "orig", "text": "「見」，甲本作「現」。"}
{"id": null, "n": "0049001", "target": "#nkr_note_orig_0049001", "type": "orig", "text": "「也」，乙本無。"}
{"id": null, "n": "0049002", "target": "#nkr_note_orig_0049002", "type": "orig", "text": "「終」，甲本作「修」。"}
{"id": null, "n": "0049003", "target": "#nkr_note_orig_0049003", "type": "orig", "text": "「兩」，甲本作「實無兩」。"}
{"id": null, "n": "0049004", "target": "#nkr_note_orig_0049004", "type": "orig", "text": "「絕」，甲本作「亡」。"}
{"id": null, "n": "0049005", "target": "#nkr_note_orig_0049005", "type": "orig", "text": "「證」，甲本作「正」。"}
{"id": null, "n": "0049006", "target": "#nkr_note_orig_0049006", "type": "orig", "text": "「悟本」，甲本作「始末該融」。"}
{"id": null, "n": "0049007", "target": "#nkr_note_orig_0049007", "type": "orig", "text": "「證真」，甲本作「成道」。"}
{"id": null, "n": "0049008", "target": "#nkr_note_orig_0049008", "type": "orig", "text": "「真」，甲本作「故真」。"}
{"id": null, "n": "0049009", "target": "#nkr_note_orig_0049009", "type": "orig", "text": "「炳」，甲本作「渾」。"}
{"id": null, "n": "0049010", "target": "#nkr_note_orig_0049010", "type": "orig", "text": "「迷」，甲本作「是知迷」。"}
{"id": null, "n": "0049011", "target": "#nkr_note_orig_0049011", "type": "orig", "text": "「致」，甲本作「智」。"}
{"id": null, "n": "0049012", "target": "#nkr_note_orig_0049012", "type": "orig", "text": "「融」，底本作「悟」，據甲本、乙本改。"}
{"id": null, "n": "0050001", "target": "#nkr_note_orig_0050001", "type": "orig", "text": "「之」，乙本無。"}
{"id": null, "n": "0050002", "target": "#nkr_note_orig_0050002", "type": "orig", "text": "「鏡」，甲本作「鑒」。"}
{"id": null, "n": "0050003", "target": "#nkr_note_orig_0050003", "type": "orig", "text": "此《心要法門頌》，甲本無。"}
{"id": null, "n": "0050004", "target": "#nkr_note_orig_0050004", "type": "orig", "text": "「蹤」，乙本作「從」。"}
{"id": null, "n": "0051001", "target": "#nkr_note_orig_0051001", "type": "orig", "text": "「注心要法門」，甲本無，乙本作「答順宗心要法門終」。"}
