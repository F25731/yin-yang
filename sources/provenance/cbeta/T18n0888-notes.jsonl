{"id": null, "n": "0536006", "target": null, "type": "orig", "text": "（朝奉大夫試光祿卿）＋傳法【宋】【元】＊，（朝奉大夫試光錄）＋傳法【宮】＊"}
{"id": null, "n": "0536006", "target": null, "type": "mod", "text": "傳法【大】＊，朝奉大夫試光祿卿傳法【宋】【元】＊，朝奉大夫試光錄傳法【宮】＊"}
{"id": null, "n": "0536007", "target": null, "type": "orig", "text": "〔沙門〕－【三】【宮】"}
{"id": null, "n": "0536007", "target": null, "type": "mod", "text": "沙門【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0536004", "target": "#nkr_note_mod_0536004", "type": "mod", "text": "（此於…出）九字【大】，〔－〕【明】"}
{"id": null, "n": "0536005", "target": "#nkr_note_mod_0536005", "type": "mod", "text": "（西天…譯）二十字【大】＊，宋西天三藏朝奉大夫試光祿卿傳法大師施護奉詔譯【明】＊"}
{"id": null, "n": "0536006", "target": "#nkr_note_mod_0536006", "type": "mod", "text": "傳法【大】＊，朝奉大夫試光祿卿傳法【宋】【元】＊，朝奉大夫試光錄傳法【宮】＊"}
{"id": null, "n": "0536007", "target": "#nkr_note_mod_0536007", "type": "mod", "text": "沙門【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0537001", "target": "#nkr_note_mod_0537001", "type": "mod", "text": "即【大】，印【宋】【元】【明】【宮】"}
{"id": null, "n": "0537002", "target": "#nkr_note_mod_0537002", "type": "mod", "text": "量【大】，最【元】【明】"}
{"id": null, "n": "0537003", "target": "#nkr_note_mod_0537003", "type": "mod", "text": "摩【大】＊，磨【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0537004", "target": "#nkr_note_mod_0537004", "type": "mod", "text": "語【大】，諸【宋】【元】【明】【宮】"}
{"id": null, "n": "0538001", "target": "#nkr_note_mod_0538001", "type": "mod", "text": "是【大】，其【宮】"}
{"id": null, "n": "0538002", "target": "#nkr_note_mod_0538002", "type": "mod", "text": "密【大】，蜜【宋】【元】【明】"}
{"id": null, "n": "0538003", "target": "#nkr_note_mod_0538003", "type": "mod", "text": "定【大】，空【宋】【元】【明】"}
{"id": null, "n": "0538004", "target": "#nkr_note_mod_0538004", "type": "mod", "text": "生【大】，心【明】"}
{"id": null, "n": "0538005", "target": "#nkr_note_mod_0538005", "type": "mod", "text": "善【大】，喜【宋】【元】【明】"}
{"id": null, "n": "0539001", "target": "#nkr_note_mod_0539001", "type": "mod", "text": "亦【大】，不【明】"}
{"id": null, "n": "0539002", "target": "#nkr_note_mod_0539002", "type": "mod", "text": "善【大】，普【宋】【元】【明】"}
{"id": null, "n": "0539003", "target": "#nkr_note_mod_0539003", "type": "mod", "text": "悉【大】，想【宋】【元】【明】【宮】"}
{"id": null, "n": "0539004", "target": "#nkr_note_mod_0539004", "type": "mod", "text": "密【大】，蜜【宋】【元】"}
{"id": null, "n": "0539005", "target": "#nkr_note_mod_0539005", "type": "mod", "text": "印【大】，相【明】"}
{"id": null, "n": "0539006", "target": "#nkr_note_mod_0539006", "type": "mod", "text": "秤【大】，抨【宋】【明】【宮】"}
{"id": null, "n": "0540001", "target": "#nkr_note_mod_0540001", "type": "mod", "text": "半【大】，牛【宮】"}
{"id": null, "n": "0540002", "target": "#nkr_note_mod_0540002", "type": "mod", "text": "大【大】，火【宋】【元】【明】"}
{"id": null, "n": "0540003", "target": "#nkr_note_mod_0540003", "type": "mod", "text": "摩【大】，磨【宋】【元】【明】"}
{"id": null, "n": "0540004", "target": "#nkr_note_mod_0540004", "type": "mod", "text": "滿【大】，明【宋】【元】【明】【宮】"}
{"id": null, "n": "0540005", "target": "#nkr_note_mod_0540005", "type": "mod", "text": "忘【大】，想【宋】【元】【明】【宮】"}
{"id": null, "n": "0540006", "target": "#nkr_note_mod_0540006", "type": "mod", "text": "即【大】，身【宮】"}
{"id": null, "n": "0541001", "target": "#nkr_note_mod_0541001", "type": "mod", "text": "生【大】，現【宋】【元】【明】【宮】"}
{"id": null, "n": "0541002", "target": "#nkr_note_mod_0541002", "type": "mod", "text": "提【大】，薩【宋】【元】【明】"}
{"id": null, "n": "0541003", "target": "#nkr_note_mod_0541003", "type": "mod", "text": "二【大】，〔－〕【宋】"}
{"id": null, "n": "0541004", "target": "#nkr_note_mod_0541004", "type": "mod", "text": "三二合【大】，二合三【宋】【元】【明】【宮】"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0541005", "target": "#nkr_note_mod_0541005", "type": "mod", "text": "句【大】，〔－〕【明】"}
{"id": null, "n": "0541006", "target": "#nkr_note_mod_0541006", "type": "mod", "text": "義【大】，義大教王【宋】【元】【明】【宮】"}
{"id": null, "n": "0536003", "target": "#nkr_note_orig_0536003", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0536004", "target": "#nkr_note_orig_0536004", "type": "orig", "text": "〔此於…出〕九字－【明】"}
{"id": null, "n": "0536005", "target": "#nkr_note_orig_0536005", "type": "orig", "text": "（（西天…譯））二十字＝（（宋西天三藏朝奉大夫試光祿卿傳法大師施護奉詔譯））二十二字【明】＊"}
{"id": null, "n": "0536006", "target": "#nkr_note_orig_0536006", "type": "orig", "text": "（朝奉大夫試光祿卿）＋傳法【宋】【元】＊，（朝奉大夫試光錄）＋傳法【宮】＊"}
{"id": null, "n": "0536007", "target": "#nkr_note_orig_0536007", "type": "orig", "text": "〔沙門〕－【三】【宮】"}
{"id": null, "n": "0537001", "target": "#nkr_note_orig_0537001", "type": "orig", "text": "即＝印【三】【宮】"}
{"id": null, "n": "0537002", "target": "#nkr_note_orig_0537002", "type": "orig", "text": "量＝最【元】【明】"}
{"id": null, "n": "0537003", "target": "#nkr_note_orig_0537003", "type": "orig", "text": "摩＝磨【三】＊"}
{"id": null, "n": "0537004", "target": "#nkr_note_orig_0537004", "type": "orig", "text": "語＝諸【三】【宮】"}
{"id": null, "n": "0538001", "target": "#nkr_note_orig_0538001", "type": "orig", "text": "是＝其【宮】"}
{"id": null, "n": "0538002", "target": "#nkr_note_orig_0538002", "type": "orig", "text": "密＝蜜【三】"}
{"id": null, "n": "0538003", "target": "#nkr_note_orig_0538003", "type": "orig", "text": "定＝空【三】"}
{"id": null, "n": "0538004", "target": "#nkr_note_orig_0538004", "type": "orig", "text": "生＝心【明】"}
{"id": null, "n": "0538005", "target": "#nkr_note_orig_0538005", "type": "orig", "text": "善＝喜【三】"}
{"id": null, "n": "0539001", "target": "#nkr_note_orig_0539001", "type": "orig", "text": "亦＝不【明】"}
{"id": null, "n": "0539002", "target": "#nkr_note_orig_0539002", "type": "orig", "text": "善＝普【三】"}
{"id": null, "n": "0539003", "target": "#nkr_note_orig_0539003", "type": "orig", "text": "悉＝想【三】【宮】"}
{"id": null, "n": "0539004", "target": "#nkr_note_orig_0539004", "type": "orig", "text": "密＝蜜【宋】【元】"}
{"id": null, "n": "0539005", "target": "#nkr_note_orig_0539005", "type": "orig", "text": "印＝相【明】"}
{"id": null, "n": "0539006", "target": "#nkr_note_orig_0539006", "type": "orig", "text": "秤＝抨【宋】【明】【宮】"}
{"id": null, "n": "0540001", "target": "#nkr_note_orig_0540001", "type": "orig", "text": "半＝牛【宮】"}
{"id": null, "n": "0540002", "target": "#nkr_note_orig_0540002", "type": "orig", "text": "大＝火【三】"}
{"id": null, "n": "0540003", "target": "#nkr_note_orig_0540003", "type": "orig", "text": "摩＝磨【三】"}
{"id": null, "n": "0540004", "target": "#nkr_note_orig_0540004", "type": "orig", "text": "滿＝明【三】【宮】"}
{"id": null, "n": "0540005", "target": "#nkr_note_orig_0540005", "type": "orig", "text": "忘＝想【三】【宮】"}
{"id": null, "n": "0540006", "target": "#nkr_note_orig_0540006", "type": "orig", "text": "即＝身【宮】"}
{"id": null, "n": "0541001", "target": "#nkr_note_orig_0541001", "type": "orig", "text": "生＝現【三】【宮】"}
{"id": null, "n": "0541002", "target": "#nkr_note_orig_0541002", "type": "orig", "text": "提＝薩【三】"}
{"id": null, "n": "0541003", "target": "#nkr_note_orig_0541003", "type": "orig", "text": "〔二〕－【宋】"}
{"id": null, "n": "0541004", "target": "#nkr_note_orig_0541004", "type": "orig", "text": "三二合＝二合三【三】【宮】"}
{"id": null, "n": "0541005", "target": "#nkr_note_orig_0541005", "type": "orig", "text": "〔句〕－【明】"}
