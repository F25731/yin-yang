{"id": null, "n": null, "target": null, "type": null, "text": "齊法上法師"}
{"id": null, "n": null, "target": null, "type": null, "text": "老子教以\n璇璣經"}
{"id": null, "n": null, "target": null, "type": null, "text": "問禮"}
{"id": null, "n": null, "target": null, "type": null, "text": "此偷佛書世界初成風輪下旋之事也"}
{"id": null, "n": null, "target": null, "type": null, "text": "五行之主"}
{"id": null, "n": null, "target": null, "type": null, "text": "黃帝臣大橈造甲子"}
{"id": null, "n": null, "target": null, "type": null, "text": "武帝\n始立年號"}
{"id": null, "n": null, "target": null, "type": null, "text": "伏犧"}
{"id": null, "n": null, "target": null, "type": null, "text": "炎帝"}
{"id": null, "n": null, "target": null, "type": null, "text": "太皡"}
{"id": null, "n": null, "target": null, "type": null, "text": "少皡"}
{"id": null, "n": null, "target": null, "type": null, "text": "鄒衍"}
{"id": null, "n": null, "target": null, "type": null, "text": "黃繚"}
{"id": null, "n": null, "target": null, "type": null, "text": "地志"}
{"id": null, "n": null, "target": null, "type": null, "text": "地圖"}
{"id": null, "n": null, "target": null, "type": null, "text": "有古史考並世本並明造物之源"}
{"id": null, "n": null, "target": null, "type": null, "text": "哀公問子夏文氏春秋亦有見劉向新序\n呂文不次爾"}
{"id": null, "n": null, "target": null, "type": null, "text": "老子之子名宗宗之子名注注之子名宮侍魏文矦"}
{"id": null, "n": null, "target": null, "type": null, "text": "此破佛生\n夜虹十二道入貫太微之事"}
{"id": null, "n": null, "target": null, "type": null, "text": "劉向新文"}
{"id": null, "n": null, "target": null, "type": null, "text": "前漢書中"}
{"id": null, "n": null, "target": null, "type": null, "text": "後漢書中"}
{"id": null, "n": null, "target": null, "type": null, "text": "太尉王儉有百家譜"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡曾云。七雄戈戟亂如麻。四海無人得坐家。老氏却思天竺去。便將徐甲過流沙。\n斯則周末時人明矣"}
{"id": null, "n": null, "target": null, "type": null, "text": "老君\n弟子"}
{"id": null, "n": null, "target": null, "type": null, "text": "樓觀尹喜故宅。在關之南今道士\n居之仍在"}
{"id": null, "n": null, "target": null, "type": null, "text": "孟之反"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐琳法師對太宗之表。張丞相作護法論皆引此文佛西方聖人也"}
{"id": null, "n": null, "target": null, "type": null, "text": "後漢西域傳史論文"}
{"id": null, "n": null, "target": null, "type": null, "text": "令改為開道竺乾"}
{"id": null, "n": null, "target": null, "type": null, "text": "此依張道陵解道陵如此說也"}
{"id": null, "n": null, "target": null, "type": null, "text": "圖六十卷志四十卷合一百卷成西域志"}
{"id": null, "n": null, "target": null, "type": null, "text": "上之銘讚在王玄策傳中"}
{"id": null, "n": null, "target": null, "type": null, "text": "今有扶風槐里鄉有老子󱌵"}
{"id": null, "n": null, "target": null, "type": null, "text": "分自他報"}
{"id": null, "n": null, "target": null, "type": null, "text": "金依華嚴十地品十\n不善法集成"}
{"id": null, "n": null, "target": null, "type": null, "text": "令改南渠"}
{"id": null, "n": null, "target": null, "type": null, "text": "見劉煦舊唐書"}
{"id": null, "n": null, "target": null, "type": null, "text": "見悟了然破化胡狀"}
{"id": null, "n": null, "target": null, "type": null, "text": "此出\n列子仲尼篇"}
{"id": null, "n": null, "target": null, "type": null, "text": "此出老潭經"}
{"id": null, "n": null, "target": null, "type": null, "text": "符朗也"}
{"id": null, "n": null, "target": null, "type": null, "text": "為蒼梧太守"}
{"id": null, "n": null, "target": null, "type": null, "text": "此出舊吳書"}
{"id": null, "n": null, "target": null, "type": null, "text": "有家則篇"}
{"id": null, "n": null, "target": null, "type": null, "text": "後周王褒庭誥章在梁弘明十異又在清涼華嚴大教中"}
{"id": null, "n": null, "target": null, "type": null, "text": "暗符班固九等人表老子列在賢人之階及晉孫盛有老子非大賢論文在廣弘明集也"}
{"id": null, "n": null, "target": null, "type": null, "text": "字義山"}
{"id": null, "n": null, "target": null, "type": null, "text": "仲尼"}
{"id": null, "n": null, "target": null, "type": null, "text": "老子"}
{"id": null, "n": null, "target": null, "type": null, "text": "對吳主事"}
{"id": null, "n": null, "target": null, "type": null, "text": "李思慎釋道十異文"}
{"id": null, "n": null, "target": null, "type": null, "text": "帝王通紀"}
{"id": null, "n": null, "target": null, "type": null, "text": "法上北齊大統與道士爭論道士落髮"}
{"id": null, "n": null, "target": null, "type": null, "text": "見者便宜燒毀"}
{"id": null, "n": null, "target": null, "type": null, "text": "王浮撰"}
{"id": null, "n": null, "target": null, "type": null, "text": "宋謝守灝撰"}
{"id": null, "n": null, "target": null, "type": null, "text": "齊人張融假託他姓"}
{"id": null, "n": null, "target": null, "type": null, "text": "傳奕李玄卿"}
{"id": null, "n": null, "target": null, "type": null, "text": "吳筠"}
{"id": null, "n": null, "target": null, "type": null, "text": "吳筠"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐員半千\n假託他姓"}
{"id": null, "n": null, "target": null, "type": null, "text": "吳筠"}
{"id": null, "n": null, "target": null, "type": null, "text": "杜庭"}
{"id": null, "n": null, "target": null, "type": null, "text": "梁曠"}
{"id": null, "n": null, "target": null, "type": null, "text": "梁曠"}
{"id": null, "n": null, "target": null, "type": null, "text": "破大藏經林靈素杜光庭撰"}
{"id": null, "n": null, "target": null, "type": null, "text": "大金天長觀道士李大方述"}
{"id": null, "n": null, "target": null, "type": null, "text": "弘景"}
{"id": null, "n": null, "target": null, "type": null, "text": "謙之"}
{"id": null, "n": null, "target": null, "type": null, "text": "摶"}
{"id": null, "n": null, "target": null, "type": null, "text": "金朝世宗章廟禁斷其風使楊尚書就海州竟\n杖斷丘公八十而音不絕世之共聞非妄言也"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云邪木思干遼之河中府也"}
{"id": null, "n": null, "target": null, "type": null, "text": "李浩然集來"}
{"id": null, "n": null, "target": null, "type": null, "text": "大道四祖之語也"}
{"id": null, "n": null, "target": null, "type": null, "text": "計鈔二十萬兩"}
{"id": null, "n": null, "target": null, "type": null, "text": "七日方滿飯僧萬餘也"}
{"id": null, "n": null, "target": null, "type": null, "text": "字義卿"}
{"id": null, "n": null, "target": null, "type": null, "text": "即戊午年六月日也"}
{"id": null, "n": null, "target": null, "type": null, "text": "已未年九月初七日。於中都憫忠寺前築臺。集在城僧道官僚及士庶人。焚燒諸路應有道藏經傳記。并\n刊行印板並皆除毀掃其邪蹤仍仰墮處道觀不得私畜。如違治罪"}
{"id": null, "n": null, "target": null, "type": null, "text": "薛道錄。并道士李掌祭暗中在逃餘者。一十七名。\n先是童謠有云。十七換頭至是驗矣"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "《嘉興藏》（日本東京大學綜合圖書館藏正編第222帙第5冊第21圖右欄第7行）"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "QC119n1521_p0465a02"}
{"id": null, "n": "0775001", "target": "#nkr_note_mod_0775001", "type": "mod", "text": "縣【大】，懸【考偽-大】"}
{"id": null, "n": "0777001", "target": "#nkr_note_mod_0777001", "type": "mod", "text": "舍【大】，含【考偽-大】"}
{"id": null, "n": "0775001", "target": "#nkr_note_orig_0775001", "type": "orig", "text": "縣＝懸？"}
{"id": null, "n": "0777001", "target": "#nkr_note_orig_0777001", "type": "orig", "text": "舍＝含？"}
{"id": null, "n": "0751a2201", "target": "#nkr_note_add_0751a2201", "type": "add", "text": "巳【CB】，已【大】"}
{"id": null, "n": "0755c1401", "target": "#nkr_note_add_0755c1401", "type": "add", "text": "篡【CB】【嘉興乙-CB】，纂【大】"}
{"id": null, "n": "0755c2501", "target": "#nkr_note_add_0755c2501", "type": "add", "text": "秖【CB】，秪【大】"}
{"id": null, "n": "0756b1301", "target": "#nkr_note_add_0756b1301", "type": "add", "text": "僭【CB】，僣【大】"}
{"id": null, "n": "0757c0201", "target": "#nkr_note_add_0757c0201", "type": "add", "text": "籀【CB】，籕【大】"}
{"id": null, "n": "0759c2301", "target": "#nkr_note_add_0759c2301", "type": "add", "text": "僭【CB】，僣【大】"}
{"id": null, "n": "0760a1501", "target": "#nkr_note_add_0760a1501", "type": "add", "text": "僭【CB】，僣【大】"}
{"id": null, "n": "0760b2901", "target": "#nkr_note_add_0760b2901", "type": "add", "text": "廟【CB】【磧乙-CB】，廊【大】"}
{"id": null, "n": "0761a0801", "target": "#nkr_note_add_0761a0801", "type": "add", "text": "羨【CB】，羡【大】"}
{"id": null, "n": "0761b1401", "target": "#nkr_note_add_0761b1401", "type": "add", "text": "羨【CB】，羡【大】"}
{"id": null, "n": "0762c0801", "target": "#nkr_note_add_0762c0801", "type": "add", "text": "嚚【CB】，囂【大】"}
{"id": null, "n": "0765b1001", "target": "#nkr_note_add_0765b1001", "type": "add", "text": "己【CB】，已【大】"}
{"id": null, "n": "0766b0901", "target": "#nkr_note_add_0766b0901", "type": "add", "text": "巳【CB】，已【大】"}
{"id": null, "n": "0774b0301", "target": "#nkr_note_add_0774b0301", "type": "add", "text": "僭【CB】，僣【大】"}
{"id": null, "n": "0774c0201", "target": "#nkr_note_add_0774c0201", "type": "add", "text": "梁【CB】，粱【大】"}
{"id": null, "n": "0778c1401", "target": "#nkr_note_add_0778c1401", "type": "add", "text": "棊【CB】，綦【大】"}
