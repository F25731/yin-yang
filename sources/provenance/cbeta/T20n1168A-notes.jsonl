{"id": null, "n": "0676006", "target": "#nkr_note_mod_0676006", "type": "mod", "text": "佛說【大】，〔－〕【宋】【元】【明】，【原】麗本"}
{"id": null, "n": "0676007", "target": "#nkr_note_mod_0676007", "type": "mod", "text": "西【大】，宋西【明】"}
{"id": null, "n": "0676008", "target": "#nkr_note_mod_0676008", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0676009", "target": "#nkr_note_mod_0676009", "type": "mod", "text": "持【大】，特【元】"}
{"id": null, "n": "0676010", "target": "#nkr_note_mod_0676010", "type": "mod", "text": "一【大】＊，〔－〕【明】＊"}
{"id": null, "n": "0676011", "target": "#nkr_note_mod_0676011", "type": "mod", "text": "引一【大】，〔－〕【明】，一【宋】【元】"}
{"id": null, "n": "0676012", "target": "#nkr_note_mod_0676012", "type": "mod", "text": "引一【大】，〔－〕【宋】【元】，一【明】"}
{"id": null, "n": "0676013", "target": "#nkr_note_mod_0676013", "type": "mod", "text": "一【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0676014", "target": "#nkr_note_mod_0676014", "type": "mod", "text": "一【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0676015", "target": "#nkr_note_mod_0676015", "type": "mod", "text": "儞【大】，付【元】"}
{"id": null, "n": "0676016", "target": "#nkr_note_mod_0676016", "type": "mod", "text": "叱【大】，摩【宋】【元】【明】"}
{"id": null, "n": "0676017", "target": "#nkr_note_mod_0676017", "type": "mod", "text": "如是【大】，爾時【宋】【元】【明】"}
{"id": null, "n": "0676018", "target": "#nkr_note_mod_0676018", "type": "mod", "text": "志【大】，至【明】"}
{"id": null, "n": "0676006", "target": "#nkr_note_orig_0676006", "type": "orig", "text": "【原】麗本，〔佛說〕－【三】"}
{"id": null, "n": "0676007", "target": "#nkr_note_orig_0676007", "type": "orig", "text": "（宋）＋西【明】"}
{"id": null, "n": "0676008", "target": "#nkr_note_orig_0676008", "type": "orig", "text": "〔臣〕－【明】"}
{"id": null, "n": "0676009", "target": "#nkr_note_orig_0676009", "type": "orig", "text": "持＝特【元】"}
{"id": null, "n": "0676010", "target": "#nkr_note_orig_0676010", "type": "orig", "text": "〔一〕－【明】＊"}
{"id": null, "n": "0676011", "target": "#nkr_note_orig_0676011", "type": "orig", "text": "〔引〕－【宋】【元】，〔引一〕－【明】"}
{"id": null, "n": "0676012", "target": "#nkr_note_orig_0676012", "type": "orig", "text": "〔引一〕－【宋】【元】，引一＝一【明】"}
{"id": null, "n": "0676013", "target": "#nkr_note_orig_0676013", "type": "orig", "text": "〔一〕－【三】"}
{"id": null, "n": "0676014", "target": "#nkr_note_orig_0676014", "type": "orig", "text": "〔一〕－【三】"}
{"id": null, "n": "0676015", "target": "#nkr_note_orig_0676015", "type": "orig", "text": "儞＝付【元】"}
{"id": null, "n": "0676016", "target": "#nkr_note_orig_0676016", "type": "orig", "text": "叱＝摩【三】"}
{"id": null, "n": "0676017", "target": "#nkr_note_orig_0676017", "type": "orig", "text": "如是＝爾時【三】"}
{"id": null, "n": "0676018", "target": "#nkr_note_orig_0676018", "type": "orig", "text": "志＝至【明】"}
{"id": null, "n": "0676006", "target": "#nkr_note_rest_0676006", "type": "rest", "text": "【原】麗本"}
