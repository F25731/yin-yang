{"id": null, "n": "0546002", "target": "#nkr_note_mod_0546002", "type": "mod", "text": "後秦龜茲國三藏【大】，姚秦三藏法師【宋】【元】【明】"}
{"id": null, "n": "0546003", "target": "#nkr_note_mod_0546003", "type": "mod", "text": "鳩摩【大】，〔－〕【宋】【元】"}
{"id": null, "n": "0546004", "target": "#nkr_note_mod_0546004", "type": "mod", "text": "渡【大】＊，度【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0546005", "target": "#nkr_note_mod_0546005", "type": "mod", "text": "事【大】，者【宋】【元】【明】"}
{"id": null, "n": "0546006", "target": "#nkr_note_mod_0546006", "type": "mod", "text": "葉枝【大】，枝葉【宋】【元】【明】"}
{"id": null, "n": "0546007", "target": "#nkr_note_mod_0546007", "type": "mod", "text": "愚【大】，恚【宋】【元】【明】"}
{"id": null, "n": "0546008", "target": "#nkr_note_mod_0546008", "type": "mod", "text": "捨【大】，捨不吐【宋】【元】【明】"}
{"id": null, "n": "0546009", "target": "#nkr_note_mod_0546009", "type": "mod", "text": "聞【大】，問【宋】【元】【明】"}
{"id": null, "n": "0546010", "target": "#nkr_note_mod_0546010", "type": "mod", "text": "愛【大】＊，愛牛【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0546011", "target": "#nkr_note_mod_0546011", "type": "mod", "text": "習【大】＊，集【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0546012", "target": "#nkr_note_mod_0546012", "type": "mod", "text": "博【大】，󳑆【宋】【明】，󳑧【麗-CB】"}
{"id": null, "n": "0546013", "target": "#nkr_note_mod_0546013", "type": "mod", "text": "坐【大】＊，座【宋】【元】【明】＊"}
{"id": null, "n": "0546014", "target": "#nkr_note_mod_0546014", "type": "mod", "text": "養【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0546015", "target": "#nkr_note_mod_0546015", "type": "mod", "text": "時【大】，時時【宋】【元】【明】"}
{"id": null, "n": "0546016", "target": "#nkr_note_mod_0546016", "type": "mod", "text": "耆艾【大】＊，者【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0547001", "target": "#nkr_note_mod_0547001", "type": "mod", "text": "護【大】，護瘡【宋】【元】【明】"}
{"id": null, "n": "0547002", "target": "#nkr_note_mod_0547002", "type": "mod", "text": "是【大】，時【宋】【元】【明】"}
{"id": null, "n": "0547003", "target": "#nkr_note_mod_0547003", "type": "mod", "text": "逆【大】，送【宋】【元】【明】"}
{"id": null, "n": "0547004", "target": "#nkr_note_mod_0547004", "type": "mod", "text": "上【大】，止【宋】【元】【明】"}
{"id": null, "n": "0547005", "target": "#nkr_note_mod_0547005", "type": "mod", "text": "頌【大】，讚【宋】【元】【明】"}
{"id": null, "n": "0547006", "target": "#nkr_note_mod_0547006", "type": "mod", "text": "恭敬【大】，供養【宋】【元】【明】"}
