{"id": null, "n": "0130002", "target": "#nkr_note_mod_0130002", "type": "mod", "text": "盛【大】，然【校異-原】"}
{"id": null, "n": "0130003", "target": "#nkr_note_mod_0130003", "type": "mod", "text": "廣【大】，應【校異-原】"}
{"id": null, "n": "0130004", "target": "#nkr_note_mod_0130004", "type": "mod", "text": "怛尸悉怛尼部【大】，怛尼悉【校異-原】"}
{"id": null, "n": "0130005", "target": "#nkr_note_mod_0130005", "type": "mod", "text": "密真言【大】，密言【校異-原】"}
{"id": null, "n": "0131001", "target": "#nkr_note_mod_0131001", "type": "mod", "text": "者【大】，印【校異-原】"}
{"id": null, "n": "0131002", "target": "#nkr_note_mod_0131002", "type": "mod", "text": "左右【大】，辟除【校異-原】"}
{"id": null, "n": "0131003", "target": "#nkr_note_mod_0131003", "type": "mod", "text": "謨【大】，莫【校異-原】"}
{"id": null, "n": "0131004", "target": "#nkr_note_mod_0131004", "type": "mod", "text": "入【大】，惹【校異-原】"}
{"id": null, "n": "0131005", "target": "#nkr_note_mod_0131005", "type": "mod", "text": "攞【大】，蘭【校異-原】"}
{"id": null, "n": "0131006", "target": "#nkr_note_mod_0131006", "type": "mod", "text": "泮吒【大】，泮吒泮吒【校異-原】"}
{"id": null, "n": "0131007", "target": "#nkr_note_mod_0131007", "type": "mod", "text": "苾【大】，㧙【考偽-原】"}
{"id": null, "n": "0131008", "target": "#nkr_note_mod_0131008", "type": "mod", "text": "方押智【大】，智押方【考偽-原】"}
{"id": null, "n": "0132001", "target": "#nkr_note_mod_0132001", "type": "mod", "text": "界【大】，有【考偽-原】"}
{"id": null, "n": "0132002", "target": "#nkr_note_mod_0132002", "type": "mod", "text": "圓【大】，竪【校異-原】"}
{"id": null, "n": "0132003", "target": "#nkr_note_mod_0132003", "type": "mod", "text": "左【大】，尼【校異-原】"}
{"id": null, "n": "0132004", "target": "#nkr_note_mod_0132004", "type": "mod", "text": "諸【大】，請【校異-原】"}
{"id": null, "n": "0132005", "target": "#nkr_note_mod_0132005", "type": "mod", "text": "薄【大】，部【考偽-原】"}
{"id": null, "n": "0133001", "target": "#nkr_note_mod_0133001", "type": "mod", "text": "背【大】，皆【考偽-原】"}
{"id": null, "n": "0130001", "target": "#nkr_note_orig_0130001", "type": "orig", "text": "【原】享保年間刊豐山大學藏本"}
{"id": null, "n": "0130002", "target": "#nkr_note_orig_0130002", "type": "orig", "text": "盛＝然ィ【原】"}
{"id": null, "n": "0130003", "target": "#nkr_note_orig_0130003", "type": "orig", "text": "廣＝應ィ【原】"}
{"id": null, "n": "0130004", "target": "#nkr_note_orig_0130004", "type": "orig", "text": "怛尸悉怛尼部＝怛尼悉ィ【原】"}
{"id": null, "n": "0130005", "target": "#nkr_note_orig_0130005", "type": "orig", "text": "密真言＝密言ィ【原】"}
{"id": null, "n": "0131001", "target": "#nkr_note_orig_0131001", "type": "orig", "text": "者＝印ィ【原】"}
{"id": null, "n": "0131002", "target": "#nkr_note_orig_0131002", "type": "orig", "text": "左右＝辟除ィ【原】"}
{"id": null, "n": "0131003", "target": "#nkr_note_orig_0131003", "type": "orig", "text": "謨＝莫ィ【原】"}
{"id": null, "n": "0131004", "target": "#nkr_note_orig_0131004", "type": "orig", "text": "入＝惹ィ【原】"}
{"id": null, "n": "0131005", "target": "#nkr_note_orig_0131005", "type": "orig", "text": "攞＝蘭ィ【原】"}
{"id": null, "n": "0131006", "target": "#nkr_note_orig_0131006", "type": "orig", "text": "泮吒＋（泮吒）ィ【原】"}
{"id": null, "n": "0131007", "target": "#nkr_note_orig_0131007", "type": "orig", "text": "苾＝㧙ヵ【原】"}
{"id": null, "n": "0131008", "target": "#nkr_note_orig_0131008", "type": "orig", "text": "方押智＝智押方ヵ【原】"}
{"id": null, "n": "0132001", "target": "#nkr_note_orig_0132001", "type": "orig", "text": "界＝有ヵ【原】"}
{"id": null, "n": "0132002", "target": "#nkr_note_orig_0132002", "type": "orig", "text": "圓＝竪ィ【原】"}
{"id": null, "n": "0132003", "target": "#nkr_note_orig_0132003", "type": "orig", "text": "左＝尼ィ【原】"}
{"id": null, "n": "0132004", "target": "#nkr_note_orig_0132004", "type": "orig", "text": "諸＝請ィ【原】"}
{"id": null, "n": "0132005", "target": "#nkr_note_orig_0132005", "type": "orig", "text": "薄＝部ヵ【原】"}
{"id": null, "n": "0133001", "target": "#nkr_note_orig_0133001", "type": "orig", "text": "背＝皆ヵ【原】"}
