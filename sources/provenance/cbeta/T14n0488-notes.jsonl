{"id": null, "n": null, "target": null, "type": "cf1", "text": "K34n1227_p0485c01"}
{"id": null, "n": "0700005", "target": "#nkr_note_mod_0700005", "type": "mod", "text": "西天【大】，宋西天【明】"}
{"id": null, "n": "0700006", "target": "#nkr_note_mod_0700006", "type": "mod", "text": "譯經【大】，〔－〕【明】"}
{"id": null, "n": "0700007", "target": "#nkr_note_mod_0700007", "type": "mod", "text": "光祿【大】，鴻臚【宋】【元】【明】【宮】"}
{"id": null, "n": "0700008", "target": "#nkr_note_mod_0700008", "type": "mod", "text": "卿【大】，少卿【宋】【元】【宮】"}
{"id": null, "n": "0700009", "target": "#nkr_note_mod_0700009", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0700010", "target": "#nkr_note_mod_0700010", "type": "mod", "text": "裝嚴【大】下同，莊嚴【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0700011", "target": "#nkr_note_mod_0700011", "type": "mod", "text": "照耀【大】，照曜【宮】"}
{"id": null, "n": "0701001", "target": "#nkr_note_mod_0701001", "type": "mod", "text": "璨鑭【大】，燦爛【宋】【元】【明】，璨爛【宮】"}
{"id": null, "n": "0701002", "target": "#nkr_note_mod_0701002", "type": "mod", "text": "鬒【大】，鬚【明】"}
{"id": null, "n": "0701003", "target": "#nkr_note_mod_0701003", "type": "mod", "text": "右【大】，又【宋】【宮】"}
{"id": null, "n": "0702001", "target": "#nkr_note_mod_0702001", "type": "mod", "text": "事【大】，時【明】"}
{"id": null, "n": "0702002", "target": "#nkr_note_mod_0702002", "type": "mod", "text": "問【大】，尚【元】"}
{"id": null, "n": "0702003", "target": "#nkr_note_mod_0702003", "type": "mod", "text": "言【大】，〔－〕【明】"}
{"id": null, "n": "0703001", "target": "#nkr_note_mod_0703001", "type": "mod", "text": "者【大】，赤【宋】【元】【宮】"}
{"id": null, "n": "0703002", "target": "#nkr_note_mod_0703002", "type": "mod", "text": "慾【大】，欲【宋】【元】【明】【宮】"}
{"id": null, "n": "0703003", "target": "#nkr_note_mod_0703003", "type": "mod", "text": "菩提【大】，菩薩【宋】【元】【明】【宮】"}
{"id": null, "n": "0700005", "target": "#nkr_note_orig_0700005", "type": "orig", "text": "（宋）＋西天【明】"}
{"id": null, "n": "0700006", "target": "#nkr_note_orig_0700006", "type": "orig", "text": "〔譯經〕－【明】"}
{"id": null, "n": "0700007", "target": "#nkr_note_orig_0700007", "type": "orig", "text": "光祿＝鴻臚【三】【宮】"}
{"id": null, "n": "0700008", "target": "#nkr_note_orig_0700008", "type": "orig", "text": "（少）＋卿【宋】【元】【宮】"}
{"id": null, "n": "0700009", "target": "#nkr_note_orig_0700009", "type": "orig", "text": "〔臣〕－【明】"}
{"id": null, "n": "0700010", "target": "#nkr_note_orig_0700010", "type": "orig", "text": "裝嚴＝莊嚴【三】【宮】下同"}
{"id": null, "n": "0700011", "target": "#nkr_note_orig_0700011", "type": "orig", "text": "照耀＝照曜【宮】"}
{"id": null, "n": "0701001", "target": "#nkr_note_orig_0701001", "type": "orig", "text": "璨鑭＝燦爛【三】，璨爛【宮】"}
{"id": null, "n": "0701002", "target": "#nkr_note_orig_0701002", "type": "orig", "text": "鬒＝鬚【明】"}
{"id": null, "n": "0701003", "target": "#nkr_note_orig_0701003", "type": "orig", "text": "右＝又【宋】【宮】"}
{"id": null, "n": "0702001", "target": "#nkr_note_orig_0702001", "type": "orig", "text": "事＝時【明】"}
{"id": null, "n": "0702002", "target": "#nkr_note_orig_0702002", "type": "orig", "text": "問＝尚【元】"}
{"id": null, "n": "0702003", "target": "#nkr_note_orig_0702003", "type": "orig", "text": "〔言〕－【明】"}
{"id": null, "n": "0703001", "target": "#nkr_note_orig_0703001", "type": "orig", "text": "者＝赤【宋】【元】【宮】"}
{"id": null, "n": "0703002", "target": "#nkr_note_orig_0703002", "type": "orig", "text": "慾＝欲【三】【宮】"}
{"id": null, "n": "0703003", "target": "#nkr_note_orig_0703003", "type": "orig", "text": "菩提＝菩薩【三】【宮】"}
