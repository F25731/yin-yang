{"id": null, "n": "0184002", "target": "#nkr_note_orig_0184002", "type": "orig", "text": "梵第十二品, Dṛṣṭi-vipratiṣedhabhāvanāsaṃdarśana."}
{"id": null, "n": "0184003", "target": "#nkr_note_orig_0184003", "type": "orig", "text": "方便, Upāya."}
{"id": null, "n": "0184004", "target": "#nkr_note_orig_0184004", "type": "orig", "text": "捨, Tyāga."}
{"id": null, "n": "0184005", "target": "#nkr_note_orig_0184005", "type": "orig", "text": "尸羅, Śila."}
{"id": null, "n": "0184006", "target": "#nkr_note_orig_0184006", "type": "orig", "text": "善趣，梵, Svarga."}
{"id": null, "n": "0184007", "target": "#nkr_note_orig_0184007", "type": "orig", "text": "涅槃，梵, Para-pada."}
{"id": null, "n": "0184008", "target": "#nkr_note_orig_0184008", "type": "orig", "text": "我執, Ahaṃkāra."}
{"id": null, "n": "0184009", "target": "#nkr_note_orig_0184009", "type": "orig", "text": "離繫, Nirgrantha."}
{"id": null, "n": "0184010", "target": "#nkr_note_orig_0184010", "type": "orig", "text": "恭＝供【三】【宮】"}
{"id": null, "n": "0184011", "target": "#nkr_note_orig_0184011", "type": "orig", "text": "苦業所感, Kleśa-karmavipāka."}
{"id": null, "n": "0184012", "target": "#nkr_note_orig_0184012", "type": "orig", "text": "身業, Janmakarman."}
{"id": null, "n": "0184013", "target": "#nkr_note_orig_0184013", "type": "orig", "text": "不害, Ahiṃsa."}
{"id": null, "n": "0184014", "target": "#nkr_note_orig_0184014", "type": "orig", "text": "梵，第十三品, Indriyārtha-pratiṣedha."}
{"id": null, "n": "0184015", "target": "#nkr_note_orig_0184015", "type": "orig", "text": "實性, Satsvarūpa."}
{"id": null, "n": "0184016", "target": "#nkr_note_orig_0184016", "type": "orig", "text": "至＝智【明】"}
{"id": null, "n": "0185001", "target": "#nkr_note_orig_0185001", "type": "orig", "text": "能＝人【明】"}
{"id": null, "n": "0185002", "target": "#nkr_note_orig_0185002", "type": "orig", "text": "詮＝證【三】【宮】"}
{"id": null, "n": "0185003", "target": "#nkr_note_orig_0185003", "type": "orig", "text": "火輪, Alātacakra."}
{"id": null, "n": "0185004", "target": "#nkr_note_orig_0185004", "type": "orig", "text": "變化, Nirmāṇa."}
{"id": null, "n": "0185005", "target": "#nkr_note_orig_0185005", "type": "orig", "text": "夢, Svapna."}
{"id": null, "n": "0185006", "target": "#nkr_note_orig_0185006", "type": "orig", "text": "幻, Māyā."}
{"id": null, "n": "0185007", "target": "#nkr_note_orig_0185007", "type": "orig", "text": "水, Ambu."}
{"id": null, "n": "0185008", "target": "#nkr_note_orig_0185008", "type": "orig", "text": "月, Candraka."}
{"id": null, "n": "0185009", "target": "#nkr_note_orig_0185009", "type": "orig", "text": "彗＝篲【三】，彗星, Dhumikānta."}
{"id": null, "n": "0185010", "target": "#nkr_note_orig_0185010", "type": "orig", "text": "響, Pratiśrutkā."}
{"id": null, "n": "0185011", "target": "#nkr_note_orig_0185011", "type": "orig", "text": "陽焰, Marici."}
{"id": null, "n": "0185012", "target": "#nkr_note_orig_0185012", "type": "orig", "text": "浮雲, Abhra."}
{"id": null, "n": "0185013", "target": "#nkr_note_orig_0185013", "type": "orig", "text": "梵，第十四品, Antagrāhavipratiṣedhayoga."}
{"id": null, "n": "0185014", "target": "#nkr_note_orig_0185014", "type": "orig", "text": "有分, Avayavin."}
{"id": null, "n": "0185015", "target": "#nkr_note_orig_0185015", "type": "orig", "text": "分, Avayava."}
{"id": null, "n": "0185016", "target": "#nkr_note_orig_0185016", "type": "orig", "text": "和合, Samavāya."}
{"id": null, "n": "0185017", "target": "#nkr_note_orig_0185017", "type": "orig", "text": "煖, Uṣṇa."}
{"id": null, "n": "0185018", "target": "#nkr_note_orig_0185018", "type": "orig", "text": "三性, Tritva."}
{"id": null, "n": "0185019", "target": "#nkr_note_orig_0185019", "type": "orig", "text": "諸＝謂【三】【宮】"}
{"id": null, "n": "0185020", "target": "#nkr_note_orig_0185020", "type": "orig", "text": "自在, Svatantra."}
{"id": null, "n": "0185021", "target": "#nkr_note_orig_0185021", "type": "orig", "text": "識, Vijñana."}
{"id": null, "n": "0185022", "target": "#nkr_note_orig_0185022", "type": "orig", "text": "有種, Bhavavīja."}
{"id": null, "n": "0185023", "target": "#nkr_note_orig_0185023", "type": "orig", "text": "境, Viṣaya."}
{"id": null, "n": "0185024", "target": "#nkr_note_orig_0185024", "type": "orig", "text": "梵，第十五品, Saṃskṛtārthapratiṣedha."}
{"id": null, "n": "0185025", "target": "#nkr_note_orig_0185025", "type": "orig", "text": "七＝十【宋】"}
{"id": null, "n": "0185026", "target": "#nkr_note_orig_0185026", "type": "orig", "text": "本無, Abhāva."}
{"id": null, "n": "0185027", "target": "#nkr_note_orig_0185027", "type": "orig", "text": "無而＝而無【明】"}
{"id": null, "n": "0185028", "target": "#nkr_note_orig_0185028", "type": "orig", "text": "一＝二【三】【宮】"}
{"id": null, "n": "0186001", "target": "#nkr_note_orig_0186001", "type": "orig", "text": "應＝因【明】"}
{"id": null, "n": "0186002", "target": "#nkr_note_orig_0186002", "type": "orig", "text": "生等＝成位【明】"}
{"id": null, "n": "0186003", "target": "#nkr_note_orig_0186003", "type": "orig", "text": "所相, Lakṣya."}
{"id": null, "n": "0186004", "target": "#nkr_note_orig_0186004", "type": "orig", "text": "能相, Lakṣaṇa."}
{"id": null, "n": "0186005", "target": "#nkr_note_orig_0186005", "type": "orig", "text": "後＝方【三】【宮】"}
{"id": null, "n": "0186006", "target": "#nkr_note_orig_0186006", "type": "orig", "text": "轉生，轉滅, Pravṛtti, Nivṛtti."}
{"id": null, "n": "0186007", "target": "#nkr_note_orig_0186007", "type": "orig", "text": "梵，第十六品, Guruśiṣyavyavasthopadeśa."}
{"id": null, "n": "0186008", "target": "#nkr_note_orig_0186008", "type": "orig", "text": "疑＝凝【三】"}
{"id": null, "n": "0186009", "target": "#nkr_note_orig_0186009", "type": "orig", "text": "執＝瓶【三】【宮】"}
{"id": null, "n": "0186010", "target": "#nkr_note_orig_0186010", "type": "orig", "text": "空＝宗【宋】【元】"}
{"id": null, "n": "0186011", "target": "#nkr_note_orig_0186011", "type": "orig", "text": "諸＝非【三】【宮】"}
{"id": null, "n": "0186012", "target": "#nkr_note_orig_0186012", "type": "orig", "text": "唯＝惟【明】"}
{"id": null, "n": "0186013", "target": "#nkr_note_orig_0186013", "type": "orig", "text": "成＝惑【宮】"}
{"id": null, "n": "0186014", "target": "#nkr_note_orig_0186014", "type": "orig", "text": "沷＝沃【明】"}
{"id": null, "n": "0186015", "target": "#nkr_note_orig_0186015", "type": "orig", "text": "酥＝蘇【宋】【元】【宮】"}
{"id": null, "n": "0187001", "target": "#nkr_note_orig_0187001", "type": "orig", "text": "〔一卷〕－【宋】【元】【宮】，一卷＋（梵本二百頌）【三】【宮】"}
{"id": null, "n": null, "target": "#nkr_note_foreign_0182003", "type": null, "text": "The latter half of Bodhisattva-yogācāra Catuḥ-śataka-śāstrakārikā."}
{"id": null, "n": null, "target": "#nkr_note_foreign_0182004", "type": null, "text": "Ārya-Deva."}
