{"id": null, "n": "0001a0102", "target": "#nkr_note_add_0001a0102", "type": "add", "text": "僧有愛【CB】，【國圖】"}
{"id": null, "n": "0001a0201", "target": "#nkr_note_add_0001a0201", "type": "add", "text": "有恚有怖有【CB】，【國圖】"}
{"id": null, "n": "0001a0202", "target": "#nkr_note_add_0001a0202", "type": "add", "text": "不癡【CB】，【國圖】"}
{"id": null, "n": "0001a0301", "target": "#nkr_note_add_0001a0301", "type": "add", "text": "汝自有愛有【CB】，【國圖】"}
{"id": null, "n": "0001a0701", "target": "#nkr_note_add_0001a0701", "type": "add", "text": "後【CB】，【國圖】"}
