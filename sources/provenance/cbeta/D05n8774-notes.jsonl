{"id": null, "n": "0001a0902", "target": "#nkr_note_add_0001a0902", "type": "add", "text": "愛有恚【CB】，【國圖】"}
{"id": null, "n": "0001a1001", "target": "#nkr_note_add_0001a1001", "type": "add", "text": "某甲比丘𡰱作【CB】，【國圖】"}
{"id": null, "n": "0001a1101", "target": "#nkr_note_add_0001a1101", "type": "add", "text": "便說是初羯【CB】，【國圖】"}
