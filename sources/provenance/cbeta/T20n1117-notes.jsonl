{"id": null, "n": "0506002", "target": "#nkr_note_mod_0506002", "type": "mod", "text": "佛說【大】，〔－〕【明】，麗本"}
{"id": null, "n": "0506003", "target": "#nkr_note_mod_0506003", "type": "mod", "text": "西天譯經【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0506004", "target": "#nkr_note_mod_0506004", "type": "mod", "text": "三【大】，宋三【明】"}
{"id": null, "n": "0506005", "target": "#nkr_note_mod_0506005", "type": "mod", "text": "藏【大】，藏法師【宋】【元】【明】"}
{"id": null, "n": "0506006", "target": "#nkr_note_mod_0506006", "type": "mod", "text": "（朝散…臣）十三字【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0506007", "target": "#nkr_note_mod_0506007", "type": "mod", "text": "讀誦得已【大】，得已讀誦【宋】【元】【明】"}
{"id": null, "n": "0506008", "target": "#nkr_note_mod_0506008", "type": "mod", "text": "現【大】，見【宋】【元】【明】"}
{"id": null, "n": "0506009", "target": "#nkr_note_mod_0506009", "type": "mod", "text": "三【大】＊，二【明】＊"}
{"id": null, "n": "0506002", "target": "#nkr_note_orig_0506002", "type": "orig", "text": "麗本，〔佛說〕－【明】"}
{"id": null, "n": "0506003", "target": "#nkr_note_orig_0506003", "type": "orig", "text": "〔西天譯經〕－【三】"}
{"id": null, "n": "0506004", "target": "#nkr_note_orig_0506004", "type": "orig", "text": "（宋）＋三【明】"}
{"id": null, "n": "0506005", "target": "#nkr_note_orig_0506005", "type": "orig", "text": "藏＋（法師）【三】"}
{"id": null, "n": "0506006", "target": "#nkr_note_orig_0506006", "type": "orig", "text": "〔朝散…臣〕十三字－【三】"}
{"id": null, "n": "0506007", "target": "#nkr_note_orig_0506007", "type": "orig", "text": "讀誦得已＝得已讀誦【三】"}
{"id": null, "n": "0506008", "target": "#nkr_note_orig_0506008", "type": "orig", "text": "現＝見【三】"}
{"id": null, "n": "0506009", "target": "#nkr_note_orig_0506009", "type": "orig", "text": "三＝二【明】＊"}
{"id": null, "n": "0506002", "target": "#nkr_note_rest_0506002", "type": "rest", "text": "麗本"}
