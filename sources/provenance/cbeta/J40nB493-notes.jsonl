{"id": null, "n": null, "target": null, "type": null, "text": "石壇、光模、石丈、嶽麓"}
{"id": null, "n": null, "target": null, "type": null, "text": "金面關聖"}
{"id": null, "n": null, "target": null, "type": null, "text": "風俗：家戶僧送祖師\n圖乞米，永鎮隨例"}
{"id": null, "n": null, "target": null, "type": null, "text": "是日立春"}
{"id": null, "n": null, "target": null, "type": null, "text": "時寺產狗\n子"}
{"id": null, "n": null, "target": null, "type": null, "text": "老子"}
{"id": null, "n": null, "target": null, "type": null, "text": "我莊、源白、石帆、達川"}
{"id": null, "n": null, "target": null, "type": null, "text": "鹿柴、本嶽、石床、融星"}
{"id": null, "n": null, "target": null, "type": null, "text": "一字渡波"}
{"id": null, "n": null, "target": null, "type": null, "text": "一字鼎銘"}
{"id": null, "n": null, "target": null, "type": null, "text": "相頗不像"}
{"id": null, "n": null, "target": null, "type": null, "text": "師參\n話頭"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂楚琦、樵水兩知識"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂嵩安茂"}
{"id": null, "n": null, "target": null, "type": null, "text": "弩箭，山名，\n嵩安奉師休老是山，故云"}
{"id": null, "n": null, "target": null, "type": null, "text": "以下皆祖\n語"}
{"id": null, "n": null, "target": null, "type": null, "text": "祖語止"}
{"id": null, "n": null, "target": null, "type": null, "text": "化作"}
{"id": null, "n": null, "target": null, "type": null, "text": "老人家居麻姑，一號麻姑一小峰"}
