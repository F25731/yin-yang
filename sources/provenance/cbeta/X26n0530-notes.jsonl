{"id": null, "n": null, "target": null, "type": null, "text": "有引"}
{"id": null, "n": null, "target": null, "type": null, "text": "音拘"}
{"id": null, "n": null, "target": null, "type": null, "text": "音嗟"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": "0739001", "target": "#nkr_note_orig_0739001", "type": "orig", "text": "愚間居編作吾"}
{"id": null, "n": "0740001", "target": "#nkr_note_orig_0740001", "type": "orig", "text": "是下疑脫非字"}
{"id": null, "n": "0740002", "target": "#nkr_note_orig_0740002", "type": "orig", "text": "說疑詳"}
{"id": null, "n": "0741001", "target": "#nkr_note_orig_0741001", "type": "orig", "text": "外上疑脫界字"}
{"id": null, "n": "0742001", "target": "#nkr_note_orig_0742001", "type": "orig", "text": "令疑合"}
{"id": null, "n": "0744001", "target": "#nkr_note_orig_0744001", "type": "orig", "text": "即滅意為意識疑誤當作即滅為意根"}
{"id": null, "n": "0745001", "target": "#nkr_note_orig_0745001", "type": "orig", "text": "即疑耶"}
{"id": null, "n": "0745002", "target": "#nkr_note_orig_0745002", "type": "orig", "text": "智當作知"}
{"id": null, "n": "0745003", "target": "#nkr_note_orig_0745003", "type": "orig", "text": "如當作妨"}
