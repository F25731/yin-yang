{"id": null, "n": "0867003", "target": "#nkr_note_mod_0867003", "type": "mod", "text": "（僧祐…錄）十二字【大】，失譯【宋】【宮】，劉宋失譯師名出祐公錄【元】【明】"}
{"id": null, "n": "0867004", "target": "#nkr_note_mod_0867004", "type": "mod", "text": "唯【大】，惟【宋】【元】【明】【宮】"}
{"id": null, "n": "0867005", "target": "#nkr_note_mod_0867005", "type": "mod", "text": "或【大】，成【元】【明】"}
{"id": null, "n": "0867006", "target": "#nkr_note_mod_0867006", "type": "mod", "text": "殖【大】，植【宋】【元】【明】【宮】"}
{"id": null, "n": "0867007", "target": "#nkr_note_mod_0867007", "type": "mod", "text": "者【大】，著【宋】【元】【明】【宮】"}
{"id": null, "n": "0868001", "target": "#nkr_note_mod_0868001", "type": "mod", "text": "法【大】，法法【宮】"}
{"id": null, "n": "0868002", "target": "#nkr_note_mod_0868002", "type": "mod", "text": "別【大】，莂【宋】【元】【明】【宮】"}
{"id": null, "n": "0868003", "target": "#nkr_note_mod_0868003", "type": "mod", "text": "以【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0867003", "target": "#nkr_note_orig_0867003", "type": "orig", "text": "（（僧祐…錄））十二字＝（（失譯））二字【宋】【宮】，（（劉宋失譯師名出祐公錄））十字【元】【明】"}
{"id": null, "n": "0867004", "target": "#nkr_note_orig_0867004", "type": "orig", "text": "唯＝惟【三】【宮】"}
{"id": null, "n": "0867005", "target": "#nkr_note_orig_0867005", "type": "orig", "text": "或＝成【元】【明】"}
{"id": null, "n": "0867006", "target": "#nkr_note_orig_0867006", "type": "orig", "text": "殖＝植【三】【宮】"}
{"id": null, "n": "0867007", "target": "#nkr_note_orig_0867007", "type": "orig", "text": "者＝著【三】【宮】"}
{"id": null, "n": "0868001", "target": "#nkr_note_orig_0868001", "type": "orig", "text": "法＋（法）【宮】"}
{"id": null, "n": "0868002", "target": "#nkr_note_orig_0868002", "type": "orig", "text": "別＝莂【三】【宮】"}
{"id": null, "n": "0868003", "target": "#nkr_note_orig_0868003", "type": "orig", "text": "〔以〕－【三】【宮】"}
