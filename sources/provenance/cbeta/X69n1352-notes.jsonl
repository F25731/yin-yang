{"id": null, "n": null, "target": null, "type": null, "text": "謝辭不錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "辛酉冬會圓通，壬寅夏回五祖"}
{"id": null, "n": null, "target": null, "type": null, "text": "來法華時有此"}
{"id": null, "n": null, "target": null, "type": null, "text": "咄！"}
{"id": null, "n": null, "target": null, "type": null, "text": "師云：誰欲招？"}
{"id": null, "n": null, "target": null, "type": null, "text": "音茶"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T47n1995_p0657b12"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T47n1994Ap0642a15"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X67n1309_p0616c08"}
{"id": null, "n": "0308001", "target": "#nkr_note_orig_0308001", "type": "orig", "text": "得下別行本有悟後更須遇人始得八字"}
{"id": null, "n": "0308002", "target": "#nkr_note_orig_0308002", "type": "orig", "text": "人下有若悟了遇人五字"}
{"id": null, "n": "0308003", "target": "#nkr_note_orig_0308003", "type": "orig", "text": "什上一有箇字"}
{"id": null, "n": "0310001", "target": "#nkr_note_orig_0310001", "type": "orig", "text": "可疑未"}
{"id": null, "n": "0310002", "target": "#nkr_note_orig_0310002", "type": "orig", "text": "拍一作拈"}
{"id": null, "n": "0311001", "target": "#nkr_note_orig_0311001", "type": "orig", "text": "孤疑狐"}
{"id": null, "n": "0312001", "target": "#nkr_note_orig_0312001", "type": "orig", "text": "膈一作隔"}
{"id": null, "n": "0313001", "target": "#nkr_note_orig_0313001", "type": "orig", "text": "處下一有即又隨他聲色所轉既隨聲色所轉即為意理所縛二十字"}
{"id": null, "n": "0313002", "target": "#nkr_note_orig_0313002", "type": "orig", "text": "有上曾字"}
{"id": null, "n": "0313003", "target": "#nkr_note_orig_0313003", "type": "orig", "text": "看下一有客來須看四字"}
{"id": null, "n": "0318001", "target": "#nkr_note_orig_0318001", "type": "orig", "text": "然一作前"}
{"id": null, "n": "0318002", "target": "#nkr_note_orig_0318002", "type": "orig", "text": "侶一作似"}
{"id": null, "n": "0319001", "target": "#nkr_note_orig_0319001", "type": "orig", "text": "輪疑綸"}
