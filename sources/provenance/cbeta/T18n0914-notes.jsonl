{"id": null, "n": "0938035", "target": "#nkr_note_orig_0938035", "type": "orig", "text": "〔娑〕－【乙】"}
{"id": null, "n": "0938036", "target": "#nkr_note_orig_0938036", "type": "orig", "text": "〔唵〕－【乙】＊"}
{"id": null, "n": "0938037", "target": "#nkr_note_orig_0938037", "type": "orig", "text": "〔苾〕－【乙】"}
{"id": null, "n": "0938038", "target": "#nkr_note_orig_0938038", "type": "orig", "text": "〔耶〕－【乙】"}
{"id": null, "n": "0938039", "target": "#nkr_note_orig_0938039", "type": "orig", "text": "〔二合〕－【乙】"}
{"id": null, "n": "0938040", "target": "#nkr_note_orig_0938040", "type": "orig", "text": "顒＝𮨒【乙】＊"}
{"id": null, "n": "0938041", "target": "#nkr_note_orig_0938041", "type": "orig", "text": "〔南〕－【甲】【乙】"}
{"id": null, "n": "0938042", "target": "#nkr_note_orig_0938042", "type": "orig", "text": "破＝彼【甲】"}
{"id": null, "n": "0938043", "target": "#nkr_note_orig_0938043", "type": "orig", "text": "羅＋（說誦）細註【乙】"}
{"id": null, "n": "0938044", "target": "#nkr_note_orig_0938044", "type": "orig", "text": "（唵）＋曩【甲】【乙】"}
{"id": null, "n": "0939001", "target": "#nkr_note_orig_0939001", "type": "orig", "text": "體＝底【甲】【乙】"}
{"id": null, "n": "0939002", "target": "#nkr_note_orig_0939002", "type": "orig", "text": "〔一卷〕－【乙】"}
{"id": null, "n": "0939003", "target": "#nkr_note_orig_0939003", "type": "orig", "text": "乙本已下無"}
{"id": null, "n": "0939004", "target": "#nkr_note_orig_0939004", "type": "orig", "text": "心＋（即請火天言）【甲】"}
{"id": null, "n": "0939005", "target": "#nkr_note_orig_0939005", "type": "orig", "text": "座＝字【甲】"}
{"id": null, "n": "0939006", "target": "#nkr_note_orig_0939006", "type": "orig", "text": "（曩莫…訶）十六字＝􄖩􄗥􄙺􄗥􆩖􈎭􇧺􈁀􈁃􅍏􄗷􇩉􄚩【甲】"}
{"id": null, "n": "0939007", "target": "#nkr_note_orig_0939007", "type": "orig", "text": "奴＝如【甲】"}
{"id": null, "n": "0939008", "target": "#nkr_note_orig_0939008", "type": "orig", "text": "榱＝欀【甲】"}
{"id": null, "n": "0939009", "target": "#nkr_note_orig_0939009", "type": "orig", "text": "其＝某【甲】"}
{"id": null, "n": "0939010", "target": "#nkr_note_orig_0939010", "type": "orig", "text": "寫＝寫𭤶入反【甲】"}
{"id": null, "n": "0939011", "target": "#nkr_note_orig_0939011", "type": "orig", "text": "甲本火字前有次文，唵翳呬翳呬摩訶沒馱埿波哩志儞毘惹薩埵摩伽里里都縛俱帝摩訶羅魔志比左儞都波波阿合奈囊可比也令比也那可那散娑婆訶或本奧有之"}
{"id": null, "n": "0939012", "target": "#nkr_note_orig_0939012", "type": "orig", "text": "〔韻會…又〕二十三字－【甲】"}
{"id": null, "n": "0939013", "target": "#nkr_note_orig_0939013", "type": "orig", "text": "白＝皃【甲】"}
{"id": null, "n": "0939014", "target": "#nkr_note_orig_0939014", "type": "orig", "text": "抹＝󳗤【甲】"}
{"id": null, "n": "0939015", "target": "#nkr_note_orig_0939015", "type": "orig", "text": "粻＝糗【甲】"}
{"id": null, "n": "0939016", "target": "#nkr_note_orig_0939016", "type": "orig", "text": "以下依乙本載之 cf. p. 937 [27]"}
{"id": null, "n": "0940a0801", "target": "#nkr_note_add_0940a0801", "type": "add", "text": "駝【CB】，馳【大】"}
{"id": null, "n": "0936036", "target": "#nkr_note_rest_0936036", "type": "rest", "text": "【原】豐山版，【甲】高山寺藏古寫本，【乙】應保二年寫東寺三密藏本"}
