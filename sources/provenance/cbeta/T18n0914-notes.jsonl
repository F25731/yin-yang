{"id": null, "n": null, "target": null, "type": null, "text": "三七遍"}
{"id": null, "n": null, "target": null, "type": null, "text": "丁以反"}
{"id": null, "n": null, "target": null, "type": null, "text": "帝釋右"}
{"id": null, "n": null, "target": null, "type": null, "text": "水天左"}
{"id": null, "n": null, "target": null, "type": null, "text": "帝釋左"}
{"id": null, "n": null, "target": null, "type": null, "text": "水天右"}
{"id": null, "n": null, "target": null, "type": null, "text": "同月天位"}
{"id": null, "n": null, "target": null, "type": null, "text": "同水天明"}
{"id": null, "n": null, "target": null, "type": null, "text": "於東北方散施"}
{"id": null, "n": null, "target": null, "type": null, "text": "著座誦真言結印"}
{"id": null, "n": null, "target": null, "type": null, "text": "合掌是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "以二手內交竪右頭指"}
{"id": null, "n": null, "target": null, "type": null, "text": "以無名小指外交，竪中指屈上節，令頭相拄以頭指\n\n各微屈，以頭附中指上節側，大母指外交之"}
{"id": null, "n": null, "target": null, "type": null, "text": "即劍印是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "政和上處得之"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "《韻會》：丁歷反。《說文》：明也。徐日光的然也。《增韻》：實也，又端也。又丁激反，遠貌明見也。亦的字，明也、曉也"}
{"id": null, "n": null, "target": null, "type": null, "text": "清歲\n反，易折也。言香脆餅食者，是胡脆餅歟"}
{"id": null, "n": null, "target": null, "type": null, "text": "蓋是𩛞𩜶蒸餅等之類歟"}
{"id": null, "n": null, "target": null, "type": null, "text": "步干反，盤也"}
{"id": null, "n": null, "target": null, "type": null, "text": "大見反，定也，置也，薦也，陳也，調也"}
{"id": null, "n": null, "target": null, "type": null, "text": "大候反，量名也。《爾雅》：食器也。今上下合調置也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上卷反，飲食也"}
{"id": null, "n": null, "target": null, "type": null, "text": "孚云反，香和也"}
{"id": null, "n": null, "target": null, "type": null, "text": "普加反，草華之白也。又「皅」字也。今上下合盛也"}
{"id": null, "n": null, "target": null, "type": null, "text": "被備也。同音故代用之"}
{"id": null, "n": null, "target": null, "type": null, "text": "古「寶」字也"}
{"id": null, "n": null, "target": null, "type": null, "text": "千丹、蒼千二反，吞也。無功而食祿曰素餐"}
{"id": null, "n": null, "target": null, "type": null, "text": "口告反，熟也"}
{"id": null, "n": null, "target": null, "type": null, "text": "力折反，威葉也。菓空敷榮\n謂之為酷烈也"}
{"id": null, "n": null, "target": null, "type": null, "text": "當稽反也"}
{"id": null, "n": null, "target": null, "type": null, "text": "口清、口回二反也。堛，善逼反"}
{"id": null, "n": null, "target": null, "type": null, "text": "撫屢浮也。滓陀武也"}
{"id": null, "n": null, "target": null, "type": null, "text": "子清反，好也，明\n也，善也，靈也，正也"}
{"id": null, "n": null, "target": null, "type": null, "text": "叵達、叵結二反，糜也。糜，正皮也，饘也。䄞為糜碎，𮂦，止彼反，碎也，穰也，精也。今或「糜」也"}
{"id": null, "n": null, "target": null, "type": null, "text": "初教反，掠也，強取"}
{"id": null, "n": null, "target": null, "type": null, "text": "蘇旱反，餅也，熬稻粻餭。又作「饊」"}
{"id": null, "n": null, "target": null, "type": null, "text": "上音錄。王芻也"}
{"id": null, "n": null, "target": null, "type": null, "text": "郁文反，烟熅，無氣鬱\n烟也"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒲沒反，健也，盛也。上府芻褒屢，下賀鄔縷也"}
{"id": null, "n": null, "target": null, "type": null, "text": "博教、普角二反，謂皮散起也"}
{"id": null, "n": null, "target": null, "type": null, "text": "都嫁反，噴也。上\n葩託銘驅，下曩樓"}
{"id": null, "n": null, "target": null, "type": null, "text": "真流類也"}
{"id": null, "n": null, "target": null, "type": null, "text": "告臥反，誡也"}
{"id": null, "n": null, "target": null, "type": null, "text": "鄙直反，執也"}
{"id": null, "n": null, "target": null, "type": null, "text": "力對反，絲節也"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃結反，捺\n搦也"}
{"id": null, "n": null, "target": null, "type": null, "text": "去"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0938027", "target": null, "type": "orig", "text": "和＋（和）【甲】"}
{"id": null, "n": "0938027", "target": null, "type": "mod", "text": "和【大】，和和【甲】"}
{"id": null, "n": "0938028", "target": null, "type": "orig", "text": "〔塗香末香〕－【乙】"}
{"id": null, "n": "0938028", "target": null, "type": "mod", "text": "塗香末香【大】，〔－〕【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "說誦"}
{"id": null, "n": "0936036", "target": "#nkr_note_mod_0936036", "type": "mod", "text": "火吽軌別錄【大】，火吽供養經法【甲】，〔－〕【乙】，【原】豐山版，【甲】高山寺藏古寫本，【乙】應保二年寫東寺三密藏本"}
{"id": null, "n": "0936037", "target": "#nkr_note_mod_0936037", "type": "mod", "text": "王【大】，〔－〕【乙】"}
{"id": null, "n": "0936039", "target": "#nkr_note_mod_0936039", "type": "mod", "text": "跢【大】＊，哆【乙】＊"}
{"id": null, "n": "0936040", "target": "#nkr_note_mod_0936040", "type": "mod", "text": "喃【大】＊，南【乙】＊"}
{"id": null, "n": "0936041", "target": "#nkr_note_mod_0936041", "type": "mod", "text": "去【大】，〔－〕【乙】"}
{"id": null, "n": "0936042", "target": "#nkr_note_mod_0936042", "type": "mod", "text": "娑嚩二合引【大】，莎【？】"}
{"id": null, "n": "0936043", "target": "#nkr_note_mod_0936043", "type": "mod", "text": "引【大】＊，〔－〕【甲】【乙】＊"}
{"id": null, "n": "0936044", "target": "#nkr_note_mod_0936044", "type": "mod", "text": "遍【大】，反【乙】"}
{"id": null, "n": "0936045", "target": "#nkr_note_mod_0936045", "type": "mod", "text": "唵【大】，〔－〕【乙】"}
{"id": null, "n": "0936046", "target": "#nkr_note_mod_0936046", "type": "mod", "text": "二合【大】，〔－〕【乙】"}
{"id": null, "n": "0936047", "target": "#nkr_note_mod_0936047", "type": "mod", "text": "二合引【大】＊，〔－〕【甲】【乙】＊"}
{"id": null, "n": "0936048", "target": "#nkr_note_mod_0936048", "type": "mod", "text": "二合【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0936049", "target": "#nkr_note_mod_0936049", "type": "mod", "text": "魔羅【大】，摩【乙】"}
{"id": null, "n": "0936050", "target": "#nkr_note_mod_0936050", "type": "mod", "text": "磨【大】，摩【乙】"}
{"id": null, "n": "0936051", "target": "#nkr_note_mod_0936051", "type": "mod", "text": "喃【大】，〔－〕【乙】"}
{"id": null, "n": "0936052", "target": "#nkr_note_mod_0936052", "type": "mod", "text": "去【大】＊，〔－〕【甲】＊"}
{"id": null, "n": "0936053", "target": "#nkr_note_mod_0936053", "type": "mod", "text": "地【大】，他【甲】"}
{"id": null, "n": "0936054", "target": "#nkr_note_mod_0936054", "type": "mod", "text": "二合【大】，〔－〕【乙】"}
{"id": null, "n": "0936055", "target": "#nkr_note_mod_0936055", "type": "mod", "text": "嚩【大】，縛【乙】"}
{"id": null, "n": "0937001", "target": "#nkr_note_mod_0937001", "type": "mod", "text": "拏【大】，拏去【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "去"}
{"id": null, "n": "0937002", "target": "#nkr_note_mod_0937002", "type": "mod", "text": "去【大】，〔－〕【乙】"}
{"id": null, "n": "0937003", "target": "#nkr_note_mod_0937003", "type": "mod", "text": "藥【大】，藥羯【乙】"}
{"id": null, "n": "0937004", "target": "#nkr_note_mod_0937004", "type": "mod", "text": "蜜【大】，〔－〕【甲】"}
{"id": null, "n": "0937005", "target": "#nkr_note_mod_0937005", "type": "mod", "text": "也二合陀哩【大】，夜塞施【甲】，夜蜜陀哩【乙】"}
{"id": null, "n": "0937006", "target": "#nkr_note_mod_0937006", "type": "mod", "text": "右【大】，左【甲】【乙】"}
{"id": null, "n": "0937007", "target": "#nkr_note_mod_0937007", "type": "mod", "text": "二合【大】＊，〔－〕【甲】【乙】＊"}
{"id": null, "n": "0937008", "target": "#nkr_note_mod_0937008", "type": "mod", "text": "智【大】，贊【甲】【乙】"}
{"id": null, "n": "0937009", "target": "#nkr_note_mod_0937009", "type": "mod", "text": "謎【大】，譴【乙】"}
{"id": null, "n": "0937010", "target": "#nkr_note_mod_0937010", "type": "mod", "text": "嚩【大】＊，縛【乙】＊"}
{"id": null, "n": "0937011", "target": "#nkr_note_mod_0937011", "type": "mod", "text": "左【大】，右【甲】【乙】"}
{"id": null, "n": "0937012", "target": "#nkr_note_mod_0937012", "type": "mod", "text": "跢【大】，多【乙】"}
{"id": null, "n": "0937013", "target": "#nkr_note_mod_0937013", "type": "mod", "text": "去【大】，〔－〕【乙】"}
{"id": null, "n": "0937014", "target": "#nkr_note_mod_0937014", "type": "mod", "text": "夜【大】，〔－〕【甲】，也【乙】"}
{"id": null, "n": "0937015", "target": "#nkr_note_mod_0937015", "type": "mod", "text": "多也【大】，〔－〕【乙】"}
{"id": null, "n": "0937016", "target": "#nkr_note_mod_0937016", "type": "mod", "text": "囉【大】，羅【乙】"}
{"id": null, "n": "0937017", "target": "#nkr_note_mod_0937017", "type": "mod", "text": "二合引【大】，去【甲】【乙】"}
{"id": null, "n": "0937018", "target": "#nkr_note_mod_0937018", "type": "mod", "text": "諾【大】，諾羯【甲】【乙】"}
{"id": null, "n": "0937019", "target": "#nkr_note_mod_0937019", "type": "mod", "text": "縛【大】，嚩【乙】"}
{"id": null, "n": "0937020", "target": "#nkr_note_mod_0937020", "type": "mod", "text": "明【大】，位【甲】【乙】"}
{"id": null, "n": "0937021", "target": "#nkr_note_mod_0937021", "type": "mod", "text": "跢【大】，多【乙】"}
{"id": null, "n": "0937022", "target": "#nkr_note_mod_0937022", "type": "mod", "text": "諸【大】，〔－〕【乙】"}
{"id": null, "n": "0937023", "target": "#nkr_note_mod_0937023", "type": "mod", "text": "毘【大】，妣【乙】"}
{"id": null, "n": "0937024", "target": "#nkr_note_mod_0937024", "type": "mod", "text": "上【大】，〔－〕【甲】"}
{"id": null, "n": "0937025", "target": "#nkr_note_mod_0937025", "type": "mod", "text": "上【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0937026", "target": "#nkr_note_mod_0937026", "type": "mod", "text": "多【大】，哆【乙】"}
{"id": null, "n": "0937028", "target": "#nkr_note_mod_0937028", "type": "mod", "text": "以【大】，以有【乙】"}
{"id": null, "n": "0937029", "target": "#nkr_note_mod_0937029", "type": "mod", "text": "杓【大】，釣【甲】，釰【乙】"}
{"id": null, "n": "0937030", "target": "#nkr_note_mod_0937030", "type": "mod", "text": "護【大】，設【乙】"}
{"id": null, "n": "0937031", "target": "#nkr_note_mod_0937031", "type": "mod", "text": "誦【大】，謂【乙】"}
{"id": null, "n": "0937032", "target": "#nkr_note_mod_0937032", "type": "mod", "text": "結【大】，坐結【甲】【乙】"}
{"id": null, "n": "0937033", "target": "#nkr_note_mod_0937033", "type": "mod", "text": "跢【大】，多【乙】"}
{"id": null, "n": "0937034", "target": "#nkr_note_mod_0937034", "type": "mod", "text": "底【大】，逸【甲】【乙】"}
{"id": null, "n": "0937035", "target": "#nkr_note_mod_0937035", "type": "mod", "text": "也【大】，〔－〕【乙】"}
{"id": null, "n": "0937036", "target": "#nkr_note_mod_0937036", "type": "mod", "text": "左右【大】，右左【乙】"}
{"id": null, "n": "0937037", "target": "#nkr_note_mod_0937037", "type": "mod", "text": "二【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0937038", "target": "#nkr_note_mod_0937038", "type": "mod", "text": "交【大】，〔－〕【乙】"}
{"id": null, "n": "0937039", "target": "#nkr_note_mod_0937039", "type": "mod", "text": "指【大】，指之【甲】"}
{"id": null, "n": "0937040", "target": "#nkr_note_mod_0937040", "type": "mod", "text": "佛【大】＊，諸佛【乙】＊"}
{"id": null, "n": "0937041", "target": "#nkr_note_mod_0937041", "type": "mod", "text": "漫【大】＊，曼【乙】＊"}
{"id": null, "n": "0937042", "target": "#nkr_note_mod_0937042", "type": "mod", "text": "嚩【大】，婆【乙】"}
{"id": null, "n": "0937043", "target": "#nkr_note_mod_0937043", "type": "mod", "text": "二合【大】，〔－〕【甲】"}
{"id": null, "n": "0937044", "target": "#nkr_note_mod_0937044", "type": "mod", "text": "拘【大】，𤘽【乙】"}
{"id": null, "n": "0937045", "target": "#nkr_note_mod_0937045", "type": "mod", "text": "洛【大】，路【甲】，𡀔【乙】"}
{"id": null, "n": "0937046", "target": "#nkr_note_mod_0937046", "type": "mod", "text": "節【大】，一節【甲】【乙】"}
{"id": null, "n": "0937047", "target": "#nkr_note_mod_0937047", "type": "mod", "text": "相拄【大】，柱【乙】"}
{"id": null, "n": "0938001", "target": "#nkr_note_mod_0938001", "type": "mod", "text": "之【大】＊，〔－〕【乙】＊"}
{"id": null, "n": "0938002", "target": "#nkr_note_mod_0938002", "type": "mod", "text": "曰【大】，〔－〕【乙】"}
{"id": null, "n": "0938003", "target": "#nkr_note_mod_0938003", "type": "mod", "text": "味【大】，未【甲】【乙】"}
{"id": null, "n": "0938004", "target": "#nkr_note_mod_0938004", "type": "mod", "text": "然【大】，亦後【乙】"}
{"id": null, "n": "0938005", "target": "#nkr_note_mod_0938005", "type": "mod", "text": "數【大】，〔－〕【甲】"}
{"id": null, "n": "0938006", "target": "#nkr_note_mod_0938006", "type": "mod", "text": "劍【大】＊，釰【乙】＊"}
{"id": null, "n": "0938007", "target": "#nkr_note_mod_0938007", "type": "mod", "text": "印【大】，印誦【甲】"}
{"id": null, "n": "0938008", "target": "#nkr_note_mod_0938008", "type": "mod", "text": "也【大】，〔－〕【乙】"}
{"id": null, "n": "0938009", "target": "#nkr_note_mod_0938009", "type": "mod", "text": "哆【大】＊，多【乙】＊"}
{"id": null, "n": "0938010", "target": "#nkr_note_mod_0938010", "type": "mod", "text": "囉【大】＊，羅【乙】＊"}
{"id": null, "n": "0938011", "target": "#nkr_note_mod_0938011", "type": "mod", "text": "拏【大】，拏二合【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0938012", "target": "#nkr_note_mod_0938012", "type": "mod", "text": "吒【大】，吒二合【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0938013", "target": "#nkr_note_mod_0938013", "type": "mod", "text": "桁引【大】，折【乙】"}
{"id": null, "n": "0938014", "target": "#nkr_note_mod_0938014", "type": "mod", "text": "此【大】，誦【乙】"}
{"id": null, "n": "0938015", "target": "#nkr_note_mod_0938015", "type": "mod", "text": "把【大】，把把【甲】"}
{"id": null, "n": "0938016", "target": "#nkr_note_mod_0938016", "type": "mod", "text": "殷勤【大】，慇懃【甲】"}
{"id": null, "n": "0938017", "target": "#nkr_note_mod_0938017", "type": "mod", "text": "左【大】，〔－〕【乙】"}
{"id": null, "n": "0938018", "target": "#nkr_note_mod_0938018", "type": "mod", "text": "眾【大】，〔－〕【乙】"}
{"id": null, "n": "0938019", "target": "#nkr_note_mod_0938019", "type": "mod", "text": "麼【大】＊，摩【乙】＊"}
{"id": null, "n": "0938020", "target": "#nkr_note_mod_0938020", "type": "mod", "text": "𡀔【大】，路【甲】"}
{"id": null, "n": "0938021", "target": "#nkr_note_mod_0938021", "type": "mod", "text": "拏【大】，吒【甲】【乙】"}
{"id": null, "n": "0938022", "target": "#nkr_note_mod_0938022", "type": "mod", "text": "二合【大】，〔－〕【乙】"}
{"id": null, "n": "0938023", "target": "#nkr_note_mod_0938023", "type": "mod", "text": "嚩二合【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0938024", "target": "#nkr_note_mod_0938024", "type": "mod", "text": "政【大】，政知【甲】【乙】"}
