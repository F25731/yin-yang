{"id": null, "n": null, "target": null, "type": null, "text": "諸佛眾生，迷悟本也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "萬法之宗，本乎無住，\n即心體也。淨名經云：依無住本，立一切法。"}
{"id": null, "n": null, "target": null, "type": null, "text": "瑩淨之理。"}
{"id": null, "n": null, "target": null, "type": null, "text": "性即空空絕跡，相即星象粲然。"}
{"id": null, "n": null, "target": null, "type": null, "text": "性包含於神用，具塵沙之無邊。"}
{"id": null, "n": null, "target": null, "type": null, "text": "相該攝於內外，亦不在於中間"}
{"id": null, "n": null, "target": null, "type": null, "text": "無外也"}
{"id": null, "n": null, "target": null, "type": null, "text": "無內也"}
{"id": null, "n": null, "target": null, "type": null, "text": "妙有不空，真空不有"}
{"id": null, "n": null, "target": null, "type": null, "text": "非四相所遷也"}
{"id": null, "n": null, "target": null, "type": null, "text": "明一真心地，絕取捨之情。"}
{"id": null, "n": null, "target": null, "type": null, "text": "迷本逐末。"}
{"id": null, "n": null, "target": null, "type": null, "text": "返本還源。"}
{"id": null, "n": null, "target": null, "type": null, "text": "凡聖一真，猶來見隔。見在即凡，情忘即佛。智與理冥，\n境與神會者，方知也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "若存證知，則棄內而外求，即滯於有"}
{"id": null, "n": null, "target": null, "type": null, "text": "若忘智忘照，則外忘緣而內忘照，即\n滯於無。"}
{"id": null, "n": null, "target": null, "type": null, "text": "妄心不生，二際俱斷。"}
{"id": null, "n": null, "target": null, "type": null, "text": "真智現前，我及我所，悉皆同體。"}
{"id": null, "n": null, "target": null, "type": null, "text": "至理虗玄，言忘慮絕，不可以識識，不可以行得"}
{"id": null, "n": null, "target": null, "type": null, "text": "性自天真，本無取捨"}
{"id": null, "n": null, "target": null, "type": null, "text": "本非對待，豈有修作"}
{"id": null, "n": null, "target": null, "type": null, "text": "迷即六凡，悟則四聖。真智生，妄念滅。妄若起，真智隱。"}
{"id": null, "n": null, "target": null, "type": null, "text": "若有取捨，勞形役智"}
{"id": null, "n": null, "target": null, "type": null, "text": "妄無自性，舉體即真"}
{"id": null, "n": null, "target": null, "type": null, "text": "既忘心照，煩惱自空。"}
{"id": null, "n": null, "target": null, "type": null, "text": "起即體之用，用而無用，何假因耶"}
{"id": null, "n": null, "target": null, "type": null, "text": "不著彼此"}
{"id": null, "n": null, "target": null, "type": null, "text": "動靜不失理也"}
{"id": null, "n": null, "target": null, "type": null, "text": "語默全真"}
{"id": null, "n": null, "target": null, "type": null, "text": "去住合道"}
{"id": null, "n": null, "target": null, "type": null, "text": "止觀俱泯"}
{"id": null, "n": null, "target": null, "type": null, "text": "止觀齊彰"}
{"id": null, "n": null, "target": null, "type": null, "text": "寂然之理不可說示"}
{"id": null, "n": null, "target": null, "type": null, "text": "唯證相應"}
{"id": null, "n": null, "target": null, "type": null, "text": "智與理冥。"}
{"id": null, "n": null, "target": null, "type": null, "text": "真如之理，泯能知智。"}
{"id": null, "n": null, "target": null, "type": null, "text": "以即理之智也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "證不二之理也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "二邊不立，中道不安。"}
{"id": null, "n": null, "target": null, "type": null, "text": "任法界性，延促無礙。"}
{"id": null, "n": null, "target": null, "type": null, "text": "法界真性，思慮叵窮。若絕能所，則真智現前也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "不從外得"}
{"id": null, "n": null, "target": null, "type": null, "text": "非新新有"}
{"id": null, "n": null, "target": null, "type": null, "text": "理非智不能顯"}
{"id": null, "n": null, "target": null, "type": null, "text": "智非理不能生"}
{"id": null, "n": null, "target": null, "type": null, "text": "本末俱泯"}
{"id": null, "n": null, "target": null, "type": null, "text": "體無瑕翳"}
{"id": null, "n": null, "target": null, "type": null, "text": "凡聖相入"}
{"id": null, "n": null, "target": null, "type": null, "text": "念念全真。"}
{"id": null, "n": null, "target": null, "type": null, "text": "即染而淨。"}
{"id": null, "n": null, "target": null, "type": null, "text": "二而不二。"}
{"id": null, "n": null, "target": null, "type": null, "text": "不二而二。"}
{"id": null, "n": null, "target": null, "type": null, "text": "迷真逐妄"}
{"id": null, "n": null, "target": null, "type": null, "text": "物象無體"}
{"id": null, "n": null, "target": null, "type": null, "text": "本離言念"}
{"id": null, "n": null, "target": null, "type": null, "text": "非同異境"}
{"id": null, "n": null, "target": null, "type": null, "text": "佩道之士，契之即神。"}
{"id": null, "n": null, "target": null, "type": null, "text": "喻也"}
{"id": null, "n": null, "target": null, "type": null, "text": "虛心之鑑"}
{"id": null, "n": null, "target": null, "type": null, "text": "所迷之理"}
{"id": null, "n": null, "target": null, "type": null, "text": "萬物自虗"}
{"id": null, "n": null, "target": null, "type": null, "text": "緣生本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "起處不真"}
{"id": null, "n": null, "target": null, "type": null, "text": "似日初出"}
{"id": null, "n": null, "target": null, "type": null, "text": "即無障礙"}
{"id": null, "n": null, "target": null, "type": null, "text": "情忘理現"}
{"id": null, "n": null, "target": null, "type": null, "text": "智起惑忘"}
{"id": null, "n": null, "target": null, "type": null, "text": "性無異故"}
{"id": null, "n": null, "target": null, "type": null, "text": "真妄無別"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
