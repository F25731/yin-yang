{"id": null, "n": null, "target": null, "type": null, "text": "萬法所因似各有性，推而會之實自無性，通達無滯故謂之門"}
{"id": null, "n": null, "target": null, "type": null, "text": "重推無性之法，為先有而生？為先無而生？有無無生，以之為門"}
{"id": null, "n": null, "target": null, "type": null, "text": "上推因，此推緣，四緣廣略皆無有果，故以為門"}
{"id": null, "n": null, "target": null, "type": null, "text": "上三門推因緣無生，此推三相，三相既無，以之為門"}
{"id": null, "n": null, "target": null, "type": null, "text": "此推三相之實，為有相而相？為無相而相？有無無相，故以為門"}
{"id": null, "n": null, "target": null, "type": null, "text": "即推有相無相，為在一法？為在異法？不一不異，以之為門"}
{"id": null, "n": null, "target": null, "type": null, "text": "上推三相非相，此明四相亦非，生住為有變異？為無？同處不有，異處亦無，故以為門"}
{"id": null, "n": null, "target": null, "type": null, "text": "既知有無，又推其性，變易無常從緣而有，則非性也，故以為門"}
{"id": null, "n": null, "target": null, "type": null, "text": "無性之法既無因果，變異處推求則無得理，故以為門"}
{"id": null, "n": null, "target": null, "type": null, "text": "無因無果則為無作，四處既無，以之為門"}
{"id": null, "n": null, "target": null, "type": null, "text": "既推無作必盡其因，故尋三時無作而以為門"}
{"id": null, "n": null, "target": null, "type": null, "text": "作為有造，生為有起，時中既無，誰為生者？即以為門"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K16n0579_p0527b05"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K16n0579_p0527b06"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K16n0579_p0530a10"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K16n0579_p0530a11"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K16n0579_p0530a12"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "《思溪藏》（中國國家圖書館藏第2282冊第58圖第8至9行）"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "QC050n0598_p0019b09"}
{"id": null, "n": null, "target": null, "type": "cf3", "text": "JM109_04_0064a01"}
{"id": null, "n": "0159001", "target": "#nkr_note_mod_0159001", "type": "mod", "text": "似【大】，以【宋】【元】【明】"}
{"id": null, "n": "0159002", "target": "#nkr_note_mod_0159002", "type": "mod", "text": "性【大】，姓【宋】【元】"}
{"id": null, "n": "0159003", "target": "#nkr_note_mod_0159003", "type": "mod", "text": "自【大】，因【宋】"}
{"id": null, "n": "0159004", "target": "#nkr_note_mod_0159004", "type": "mod", "text": "性【大】，性故言觀【宋】【元】【明】"}
{"id": null, "n": "0159005", "target": "#nkr_note_mod_0159005", "type": "mod", "text": "略【大】，略無垢心足出人間物外遊絕往還翻笑白雲元不定又如霖幽雨過也【明】，略無垢心足出人間物外遊絕往還翻笑白雲元不定又如霖幽兩過他【宋】，略無垢心足出人間物外遊絕往還翻笑白雲元不定又如霖幽兩過也【元】"}
{"id": null, "n": "0159006", "target": "#nkr_note_mod_0159006", "type": "mod", "text": "皆【大】，出【宋】【元】【明】"}
{"id": null, "n": "0159007", "target": "#nkr_note_mod_0159007", "type": "mod", "text": "推【大】，推其【宋】【元】【明】"}
{"id": null, "n": "0159008", "target": "#nkr_note_mod_0159008", "type": "mod", "text": "以【大】，名【宋】【元】【明】"}
{"id": null, "n": "0159009", "target": "#nkr_note_mod_0159009", "type": "mod", "text": "序【大】，序釋僧叡造【宋】【元】，序釋僧叡述【明】"}
{"id": null, "n": "0159010", "target": "#nkr_note_mod_0159010", "type": "mod", "text": "門【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0159011", "target": "#nkr_note_mod_0159011", "type": "mod", "text": "或【大】，惑【宋】【元】【明】"}
{"id": null, "n": "0159012", "target": "#nkr_note_mod_0159012", "type": "mod", "text": "塗【大】，途【宋】【元】【明】"}
{"id": null, "n": "0159013", "target": "#nkr_note_mod_0159013", "type": "mod", "text": "以【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0159014", "target": "#nkr_note_mod_0159014", "type": "mod", "text": "塗【大】，關【宋】【元】【明】"}
{"id": null, "n": "0159015", "target": "#nkr_note_mod_0159015", "type": "mod", "text": "冥【大】，溟【宋】【元】【明】"}
{"id": null, "n": "0159016", "target": "#nkr_note_mod_0159016", "type": "mod", "text": "迴【大】，逈【宋】【元】【明】"}
{"id": null, "n": "0159017", "target": "#nkr_note_mod_0159017", "type": "mod", "text": "慧【大】，惡【宋】【元】【明】"}
{"id": null, "n": "0159018", "target": "#nkr_note_mod_0159018", "type": "mod", "text": "希【大】，晞【宋】【元】【明】"}
{"id": null, "n": "0159019", "target": "#nkr_note_mod_0159019", "type": "mod", "text": "〔－〕【CB】，朋【大】，明【宋】【元】【明】"}
{"id": null, "n": "0159020", "target": "#nkr_note_mod_0159020", "type": "mod", "text": "宜【大】，冥【宋】【元】【明】"}
{"id": null, "n": "0159021", "target": "#nkr_note_mod_0159021", "type": "mod", "text": "殖【大】，植【宋】【元】【明】"}
{"id": null, "n": "0159022", "target": "#nkr_note_mod_0159022", "type": "mod", "text": "敬【大】，景【宋】【元】【明】"}
{"id": null, "n": "0159023", "target": "#nkr_note_mod_0159023", "type": "mod", "text": "𢭃【大】，短【宋】【元】【明】"}
{"id": null, "n": "0159024", "target": "#nkr_note_mod_0159024", "type": "mod", "text": "其【大】，期【宋】【元】【明】"}
{"id": null, "n": "0159025", "target": "#nkr_note_mod_0159025", "type": "mod", "text": "也【大】，耶【宋】【元】【明】"}
{"id": null, "n": "0159026", "target": "#nkr_note_mod_0159026", "type": "mod", "text": "疾【大】，自【宋】【元】【明】"}
{"id": null, "n": "0159027", "target": "#nkr_note_mod_0159027", "type": "mod", "text": "觀因緣【大】，十二門論觀因緣【宋】【元】【明】"}
{"id": null, "n": "0159028", "target": "#nkr_note_mod_0159028", "type": "mod", "text": "三藏【大】，三藏法師【宋】【元】【明】"}
{"id": null, "n": "0159029", "target": "#nkr_note_mod_0159029", "type": "mod", "text": "說【大】，釋【明】"}
{"id": null, "n": "0159030", "target": "#nkr_note_mod_0159030", "type": "mod", "text": "者【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0159031", "target": "#nkr_note_mod_0159031", "type": "mod", "text": "達【大】，了【宋】【元】【明】"}
{"id": null, "n": "0159032", "target": "#nkr_note_mod_0159032", "type": "mod", "text": "欲【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0159033", "target": "#nkr_note_mod_0159033", "type": "mod", "text": "義【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0159034", "target": "#nkr_note_mod_0159034", "type": "mod", "text": "又【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0159035", "target": "#nkr_note_mod_0159035", "type": "mod", "text": "能【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0159036", "target": "#nkr_note_mod_0159036", "type": "mod", "text": "謂【大】，謂眾緣所生法【宋】【元】【明】"}
{"id": null, "n": "0160001", "target": "#nkr_note_mod_0160001", "type": "mod", "text": "故有【大】，有故【宋】【元】"}
{"id": null, "n": "0160002", "target": "#nkr_note_mod_0160002", "type": "mod", "text": "繩【大】，綖【宋】【元】【明】"}
{"id": null, "n": "0160003", "target": "#nkr_note_mod_0160003", "type": "mod", "text": "疊【大】＊，㲲【明】＊"}
{"id": null, "n": "0160004", "target": "#nkr_note_mod_0160004", "type": "mod", "text": "梁【大】，樑【宋】【元】"}
{"id": null, "n": "0160005", "target": "#nkr_note_mod_0160005", "type": "mod", "text": "酪【大】，酪酪鑽【宋】【元】，乳酪鑽【明】"}
{"id": null, "n": "0160006", "target": "#nkr_note_mod_0160006", "type": "mod", "text": "酥【大】，蘇【宋】"}
{"id": null, "n": "0160007", "target": "#nkr_note_mod_0160007", "type": "mod", "text": "芽【大】，牙【宋】"}
{"id": null, "n": "0160008", "target": "#nkr_note_mod_0160008", "type": "mod", "text": "因緣者所謂【大】，緣者謂諸【宋】【元】【明】"}
{"id": null, "n": "0160009", "target": "#nkr_note_mod_0160009", "type": "mod", "text": "從眾緣生故即【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0160010", "target": "#nkr_note_mod_0160010", "type": "mod", "text": "柰【大】＊，㮈【宋】【元】＊"}
{"id": null, "n": "0160011", "target": "#nkr_note_mod_0160011", "type": "mod", "text": "酥【大】，蘇【宋】【元】"}
{"id": null, "n": "0160012", "target": "#nkr_note_mod_0160012", "type": "mod", "text": "皆【大】，皆緣【宋】【元】【明】"}
{"id": null, "n": "0160013", "target": "#nkr_note_mod_0160013", "type": "mod", "text": "說【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0160014", "target": "#nkr_note_mod_0160014", "type": "mod", "text": "已【大】＊，以【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0160015", "target": "#nkr_note_mod_0160015", "type": "mod", "text": "先【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0160016", "target": "#nkr_note_mod_0160016", "type": "mod", "text": "復應【大】，應復【宋】【元】【明】"}
{"id": null, "n": "0160017", "target": "#nkr_note_mod_0160017", "type": "mod", "text": "亦【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0160018", "target": "#nkr_note_mod_0160018", "type": "mod", "text": "亦【大】，亦應【宋】【元】【明】"}
{"id": null, "n": "0160019", "target": "#nkr_note_mod_0160019", "type": "mod", "text": "時【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0160020", "target": "#nkr_note_mod_0160020", "type": "mod", "text": "有生【大】，〔－〕【明】"}
{"id": null, "n": "0160021", "target": "#nkr_note_mod_0160021", "type": "mod", "text": "見【大】，得見【宋】【元】【明】"}
{"id": null, "n": "0160022", "target": "#nkr_note_mod_0160022", "type": "mod", "text": "果【大】，者【宋】"}
{"id": null, "n": "0160023", "target": "#nkr_note_mod_0160023", "type": "mod", "text": "未【大】，末【明】"}
{"id": null, "n": "0160024", "target": "#nkr_note_mod_0160024", "type": "mod", "text": "可【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0160025", "target": "#nkr_note_mod_0160025", "type": "mod", "text": "得【大】，得見【宋】【元】【明】"}
{"id": null, "n": "0160026", "target": "#nkr_note_mod_0160026", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0161001", "target": "#nkr_note_mod_0161001", "type": "mod", "text": "變【大】，變法【宋】【元】【明】"}
{"id": null, "n": "0161002", "target": "#nkr_note_mod_0161002", "type": "mod", "text": "等【大】，等不同【宋】【元】【明】"}
{"id": null, "n": "0161003", "target": "#nkr_note_mod_0161003", "type": "mod", "text": "故生【大】，生故【明】"}
{"id": null, "n": "0161004", "target": "#nkr_note_mod_0161004", "type": "mod", "text": "者則【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0161005", "target": "#nkr_note_mod_0161005", "type": "mod", "text": "住【大】，作【宋】【元】【明】"}
{"id": null, "n": "0161006", "target": "#nkr_note_mod_0161006", "type": "mod", "text": "鵠【大】，鶴【宋】【元】【明】"}
{"id": null, "n": "0161007", "target": "#nkr_note_mod_0161007", "type": "mod", "text": "緣【大】，緣而【宋】【元】【明】"}
{"id": null, "n": "0161008", "target": "#nkr_note_mod_0161008", "type": "mod", "text": "則【大】，則凡【宋】【元】【明】"}
{"id": null, "n": "0161009", "target": "#nkr_note_mod_0161009", "type": "mod", "text": "出【大】，生【宋】【元】【明】"}
{"id": null, "n": "0161010", "target": "#nkr_note_mod_0161010", "type": "mod", "text": "而【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0161011", "target": "#nkr_note_mod_0161011", "type": "mod", "text": "者【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0162001", "target": "#nkr_note_mod_0162001", "type": "mod", "text": "故【大】，是故【宋】【元】【明】"}
{"id": null, "n": "0162002", "target": "#nkr_note_mod_0162002", "type": "mod", "text": "先【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0162003", "target": "#nkr_note_mod_0162003", "type": "mod", "text": "三【大】，二【元】【明】"}
{"id": null, "n": "0162004", "target": "#nkr_note_mod_0162004", "type": "mod", "text": "者【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0162005", "target": "#nkr_note_mod_0162005", "type": "mod", "text": "苦【大】，若【宋】【元】"}
{"id": null, "n": "0162006", "target": "#nkr_note_mod_0162006", "type": "mod", "text": "縛解【大】，解縛【明】"}
{"id": null, "n": "0162007", "target": "#nkr_note_mod_0162007", "type": "mod", "text": "法【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0162009", "target": "#nkr_note_mod_0162009", "type": "mod", "text": "曰【大】，〔－〕【明】"}
{"id": null, "n": "0162011", "target": "#nkr_note_mod_0162011", "type": "mod", "text": "於【大】，與【明】"}
{"id": null, "n": "0162012", "target": "#nkr_note_mod_0162012", "type": "mod", "text": "而【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0162013", "target": "#nkr_note_mod_0162013", "type": "mod", "text": "復次【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0162015", "target": "#nkr_note_mod_0162015", "type": "mod", "text": "以【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0162016", "target": "#nkr_note_mod_0162016", "type": "mod", "text": "耶【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0162017", "target": "#nkr_note_mod_0162017", "type": "mod", "text": "以角峯垂𩑶【大】，角犎垂壺【宋】【元】【明】"}
{"id": null, "n": "0162018", "target": "#nkr_note_mod_0162018", "type": "mod", "text": "細【大】，細口圓【宋】【元】【明】"}
{"id": null, "n": "0162019", "target": "#nkr_note_mod_0162019", "type": "mod", "text": "為【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0162020", "target": "#nkr_note_mod_0162020", "type": "mod", "text": "者【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0162021", "target": "#nkr_note_mod_0162021", "type": "mod", "text": "無【大】，得無【宋】【元】【明】"}
{"id": null, "n": "0162022", "target": "#nkr_note_mod_0162022", "type": "mod", "text": "亦爾【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0162023", "target": "#nkr_note_mod_0162023", "type": "mod", "text": "皆【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0163001", "target": "#nkr_note_mod_0163001", "type": "mod", "text": "生【大】，能生【宋】【元】【明】"}
{"id": null, "n": "0163002", "target": "#nkr_note_mod_0163002", "type": "mod", "text": "若【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0163003", "target": "#nkr_note_mod_0163003", "type": "mod", "text": "燈若【大】，若燈【宋】【元】【明】"}
{"id": null, "n": "0163004", "target": "#nkr_note_mod_0163004", "type": "mod", "text": "一切【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0163005", "target": "#nkr_note_mod_0163005", "type": "mod", "text": "應【大】，能【明】"}
{"id": null, "n": "0163006", "target": "#nkr_note_mod_0163006", "type": "mod", "text": "闇與燈【大】，燈與闇【宋】【元】【明】"}
{"id": null, "n": "0163007", "target": "#nkr_note_mod_0163007", "type": "mod", "text": "不【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0163008", "target": "#nkr_note_mod_0163008", "type": "mod", "text": "已【大】，中【宋】【元】【明】"}
{"id": null, "n": "0163009", "target": "#nkr_note_mod_0163009", "type": "mod", "text": "生【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0163010", "target": "#nkr_note_mod_0163010", "type": "mod", "text": "有【大】，是有【宋】【元】【明】"}
{"id": null, "n": "0163011", "target": "#nkr_note_mod_0163011", "type": "mod", "text": "空【大】，生【元】"}
{"id": null, "n": "0163012", "target": "#nkr_note_mod_0163012", "type": "mod", "text": "亦【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0163013", "target": "#nkr_note_mod_0163013", "type": "mod", "text": "是【大】，是涅槃是【宋】【元】【明】"}
{"id": null, "n": "0163014", "target": "#nkr_note_mod_0163014", "type": "mod", "text": "相【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0163015", "target": "#nkr_note_mod_0163015", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0163017", "target": "#nkr_note_mod_0163017", "type": "mod", "text": "何【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0163018", "target": "#nkr_note_mod_0163018", "type": "mod", "text": "是相【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0163019", "target": "#nkr_note_mod_0163019", "type": "mod", "text": "事【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0163020", "target": "#nkr_note_mod_0163020", "type": "mod", "text": "所相【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0164001", "target": "#nkr_note_mod_0164001", "type": "mod", "text": "愛【大】，相愛【宋】【元】【明】"}
{"id": null, "n": "0164002", "target": "#nkr_note_mod_0164002", "type": "mod", "text": "故【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0164003", "target": "#nkr_note_mod_0164003", "type": "mod", "text": "能【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0164004", "target": "#nkr_note_mod_0164004", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0164005", "target": "#nkr_note_mod_0164005", "type": "mod", "text": "信【大】，相【元】【明】"}
{"id": null, "n": "0164006", "target": "#nkr_note_mod_0164006", "type": "mod", "text": "相【大】，言相【宋】【元】【明】"}
{"id": null, "n": "0164007", "target": "#nkr_note_mod_0164007", "type": "mod", "text": "更【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0164008", "target": "#nkr_note_mod_0164008", "type": "mod", "text": "可相【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0164009", "target": "#nkr_note_mod_0164009", "type": "mod", "text": "是事不然【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0164011", "target": "#nkr_note_mod_0164011", "type": "mod", "text": "七【大】，九【宋】【元】【明】"}
{"id": null, "n": "0164012", "target": "#nkr_note_mod_0164012", "type": "mod", "text": "無【大】，無常【宋】【元】【明】"}
{"id": null, "n": "0164013", "target": "#nkr_note_mod_0164013", "type": "mod", "text": "令【大】，今【明】"}
{"id": null, "n": "0165001", "target": "#nkr_note_mod_0165001", "type": "mod", "text": "為【大】，〔－〕【明】"}
{"id": null, "n": "0165002", "target": "#nkr_note_mod_0165002", "type": "mod", "text": "空【大】，空空【宋】【元】"}
{"id": null, "n": "0165004", "target": "#nkr_note_mod_0165004", "type": "mod", "text": "無【大】，空【宋】【元】【明】"}
{"id": null, "n": "0165005", "target": "#nkr_note_mod_0165005", "type": "mod", "text": "果【大】，法【宋】【元】【明】"}
{"id": null, "n": "0165006", "target": "#nkr_note_mod_0165006", "type": "mod", "text": "無【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0165007", "target": "#nkr_note_mod_0165007", "type": "mod", "text": "當【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0165008", "target": "#nkr_note_mod_0165008", "type": "mod", "text": "有【大】，一切有【宋】【元】【明】"}
{"id": null, "n": "0165009", "target": "#nkr_note_mod_0165009", "type": "mod", "text": "若【大】，無若【宋】【元】【明】"}
{"id": null, "n": "0165010", "target": "#nkr_note_mod_0165010", "type": "mod", "text": "法空【大】，空一切【宋】【元】【明】"}
{"id": null, "n": "0165013", "target": "#nkr_note_mod_0165013", "type": "mod", "text": "他【大】，共【宋】【元】【明】"}
{"id": null, "n": "0165014", "target": "#nkr_note_mod_0165014", "type": "mod", "text": "經【大】，經中【宋】【元】【明】"}
{"id": null, "n": "0166001", "target": "#nkr_note_mod_0166001", "type": "mod", "text": "法【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0166002", "target": "#nkr_note_mod_0166002", "type": "mod", "text": "性【大】，相【宋】【元】【明】"}
{"id": null, "n": "0166003", "target": "#nkr_note_mod_0166003", "type": "mod", "text": "眾生者【大】，者眾生【宋】【元】【明】"}
{"id": null, "n": "0166004", "target": "#nkr_note_mod_0166004", "type": "mod", "text": "從自在【大】，自在天【宋】【元】【明】"}
{"id": null, "n": "0166005", "target": "#nkr_note_mod_0166005", "type": "mod", "text": "是【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0166006", "target": "#nkr_note_mod_0166006", "type": "mod", "text": "能【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0166007", "target": "#nkr_note_mod_0166007", "type": "mod", "text": "礙【大】，閡【宋】【元】【明】"}
{"id": null, "n": "0166008", "target": "#nkr_note_mod_0166008", "type": "mod", "text": "蟲【大】＊，虫【宋】＊"}
{"id": null, "n": "0166009", "target": "#nkr_note_mod_0166009", "type": "mod", "text": "當【大】＊，是故當【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0166010", "target": "#nkr_note_mod_0166010", "type": "mod", "text": "作【大】，作是不自在【宋】【元】【明】"}
{"id": null, "n": "0166011", "target": "#nkr_note_mod_0166011", "type": "mod", "text": "所【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0166012", "target": "#nkr_note_mod_0166012", "type": "mod", "text": "愛【大】，愛念【宋】【元】【明】"}
{"id": null, "n": "0166013", "target": "#nkr_note_mod_0166013", "type": "mod", "text": "當【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0166014", "target": "#nkr_note_mod_0166014", "type": "mod", "text": "生【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0166015", "target": "#nkr_note_mod_0166015", "type": "mod", "text": "說【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0167001", "target": "#nkr_note_mod_0167001", "type": "mod", "text": "我【大】，汝【宋】【元】【明】"}
{"id": null, "n": "0167002", "target": "#nkr_note_mod_0167002", "type": "mod", "text": "（我不說…難）十四字【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0167003", "target": "#nkr_note_mod_0167003", "type": "mod", "text": "眼【大】，可【明】"}
{"id": null, "n": "0167004", "target": "#nkr_note_mod_0167004", "type": "mod", "text": "有【大】，如【明】"}
{"id": null, "n": "0167005", "target": "#nkr_note_mod_0167005", "type": "mod", "text": "因【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0167006", "target": "#nkr_note_mod_0167006", "type": "mod", "text": "空【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0167007", "target": "#nkr_note_mod_0167007", "type": "mod", "text": "皆【大】，亦【宋】【元】【明】"}
{"id": null, "n": "0167008", "target": "#nkr_note_mod_0167008", "type": "mod", "text": "生【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0167009", "target": "#nkr_note_mod_0167009", "type": "mod", "text": "不【大】，未【宋】【元】【明】"}
{"id": null, "n": "0167010", "target": "#nkr_note_mod_0167010", "type": "mod", "text": "又【大】，有【宋】【元】【明】"}
{"id": null, "n": "0167011", "target": "#nkr_note_mod_0167011", "type": "mod", "text": "則【大】，則不生若【思溪-CB】【磧乙-CB】【嘉興丙-CB】，則不生宮【宋】【元】【明】"}
{"id": null, "n": "0167012", "target": "#nkr_note_mod_0167012", "type": "mod", "text": "是【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0167013", "target": "#nkr_note_mod_0167013", "type": "mod", "text": "（不生…則）八字【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0167014", "target": "#nkr_note_mod_0167014", "type": "mod", "text": "又【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0167015", "target": "#nkr_note_mod_0167015", "type": "mod", "text": "不【大】，亦不【宋】【元】【明】"}
{"id": null, "n": "0167016", "target": "#nkr_note_mod_0167016", "type": "mod", "text": "前【大】，先【宋】【元】【明】"}
