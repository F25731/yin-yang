{"id": null, "n": "0861002", "target": "#nkr_note_mod_0861002", "type": "mod", "text": "天竺【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0861003", "target": "#nkr_note_mod_0861003", "type": "mod", "text": "二【大】，千二【宋】【元】【明】"}
{"id": null, "n": "0861004", "target": "#nkr_note_mod_0861004", "type": "mod", "text": "也【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0861005", "target": "#nkr_note_mod_0861005", "type": "mod", "text": "健【大】，猛【宋】【元】【明】"}
{"id": null, "n": "0861006", "target": "#nkr_note_mod_0861006", "type": "mod", "text": "忘【大】，妄【宋】【元】【明】"}
{"id": null, "n": "0861007", "target": "#nkr_note_mod_0861007", "type": "mod", "text": "智【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0861008", "target": "#nkr_note_mod_0861008", "type": "mod", "text": "便【大】，使【元】【明】"}
{"id": null, "n": "0861009", "target": "#nkr_note_mod_0861009", "type": "mod", "text": "起【大】，赴【宋】"}
{"id": null, "n": "0861010", "target": "#nkr_note_mod_0861010", "type": "mod", "text": "佛說【大】，〔－〕【宋】【元】"}
