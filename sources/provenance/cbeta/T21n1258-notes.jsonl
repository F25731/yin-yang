{"id": null, "n": "0285002", "target": "#nkr_note_mod_0285002", "type": "mod", "text": "次【大】，其【甲】"}
{"id": null, "n": "0285003", "target": "#nkr_note_mod_0285003", "type": "mod", "text": "欠【大】，欠平呼【甲】【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "平呼"}
{"id": null, "n": "0285004", "target": "#nkr_note_mod_0285004", "type": "mod", "text": "各【大】，相各【甲】"}
{"id": null, "n": "0285005", "target": "#nkr_note_mod_0285005", "type": "mod", "text": "次【大】，〔－〕【乙】"}
{"id": null, "n": "0285006", "target": "#nkr_note_mod_0285006", "type": "mod", "text": "夜【大】，夜引【甲】【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0285007", "target": "#nkr_note_mod_0285007", "type": "mod", "text": "思【大】，惡【乙】"}
{"id": null, "n": "0285008", "target": "#nkr_note_mod_0285008", "type": "mod", "text": "摩【大】，度【甲】"}
{"id": null, "n": "0285009", "target": "#nkr_note_mod_0285009", "type": "mod", "text": "馱【大】，但【乙】"}
{"id": null, "n": "0285010", "target": "#nkr_note_mod_0285010", "type": "mod", "text": "波【大】，婆【甲】【乙】"}
{"id": null, "n": "0285011", "target": "#nkr_note_mod_0285011", "type": "mod", "text": "二合【大】，引二合【甲】，二合引【乙】"}
{"id": null, "n": "0285012", "target": "#nkr_note_mod_0285012", "type": "mod", "text": "引十三【大】，〔－〕【甲】"}
{"id": null, "n": "0285013", "target": "#nkr_note_mod_0285013", "type": "mod", "text": "引【大】，〔－〕【甲】"}
{"id": null, "n": "0285014", "target": "#nkr_note_mod_0285014", "type": "mod", "text": "利【大】，〔－〕【甲】"}
{"id": null, "n": "0285015", "target": "#nkr_note_mod_0285015", "type": "mod", "text": "沙嚩二合【大】，二合娑婆【甲】"}
{"id": null, "n": "0285016", "target": "#nkr_note_mod_0285016", "type": "mod", "text": "訶【大】，訶引【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0285017", "target": "#nkr_note_mod_0285017", "type": "mod", "text": "次【大】，心【乙】"}
{"id": null, "n": "0285018", "target": "#nkr_note_mod_0285018", "type": "mod", "text": "心【大】，心印【甲】"}
{"id": null, "n": "0285019", "target": "#nkr_note_mod_0285019", "type": "mod", "text": "手【大】，〔－〕【甲】"}
{"id": null, "n": "0285020", "target": "#nkr_note_mod_0285020", "type": "mod", "text": "在【大】，隱在【甲】【乙】"}
{"id": null, "n": "0285021", "target": "#nkr_note_mod_0285021", "type": "mod", "text": "除【大】，消【甲】【乙】"}
{"id": null, "n": "0285022", "target": "#nkr_note_mod_0285022", "type": "mod", "text": "則【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0285023", "target": "#nkr_note_mod_0285023", "type": "mod", "text": "即【大】，速【甲】【乙】"}
{"id": null, "n": "0285024", "target": "#nkr_note_mod_0285024", "type": "mod", "text": "悲愍【大】，慈悲【甲】"}
{"id": null, "n": "0285025", "target": "#nkr_note_mod_0285025", "type": "mod", "text": "妄【大】，忘【甲】"}
{"id": null, "n": "0285001", "target": "#nkr_note_orig_0285001", "type": "orig", "text": "【原】享保年間刊豐山大學藏本，【甲】保延三年寫高山寺藏本，【乙】保安四年寫寶壽院藏本"}
{"id": null, "n": "0285002", "target": "#nkr_note_orig_0285002", "type": "orig", "text": "次＝其【甲】"}
{"id": null, "n": "0285003", "target": "#nkr_note_orig_0285003", "type": "orig", "text": "欠＋（平呼）細註【甲】【乙】"}
{"id": null, "n": "0285004", "target": "#nkr_note_orig_0285004", "type": "orig", "text": "（相）＋各【甲】"}
{"id": null, "n": "0285005", "target": "#nkr_note_orig_0285005", "type": "orig", "text": "〔次〕－【乙】"}
{"id": null, "n": "0285006", "target": "#nkr_note_orig_0285006", "type": "orig", "text": "夜＋（引）夾註【甲】【乙】"}
{"id": null, "n": "0285007", "target": "#nkr_note_orig_0285007", "type": "orig", "text": "思＝惡【乙】"}
{"id": null, "n": "0285008", "target": "#nkr_note_orig_0285008", "type": "orig", "text": "摩＝度【甲】"}
{"id": null, "n": "0285009", "target": "#nkr_note_orig_0285009", "type": "orig", "text": "馱＝但【乙】"}
{"id": null, "n": "0285010", "target": "#nkr_note_orig_0285010", "type": "orig", "text": "波＝婆【甲】【乙】"}
{"id": null, "n": "0285011", "target": "#nkr_note_orig_0285011", "type": "orig", "text": "二合＝引二合【甲】，二合引【乙】"}
{"id": null, "n": "0285012", "target": "#nkr_note_orig_0285012", "type": "orig", "text": "〔引十三〕－【甲】"}
{"id": null, "n": "0285013", "target": "#nkr_note_orig_0285013", "type": "orig", "text": "〔引〕－【甲】"}
{"id": null, "n": "0285014", "target": "#nkr_note_orig_0285014", "type": "orig", "text": "〔利〕－【甲】"}
{"id": null, "n": "0285015", "target": "#nkr_note_orig_0285015", "type": "orig", "text": "沙嚩二合＝二合娑婆【甲】"}
{"id": null, "n": "0285016", "target": "#nkr_note_orig_0285016", "type": "orig", "text": "訶＋（引）夾註【乙】"}
{"id": null, "n": "0285017", "target": "#nkr_note_orig_0285017", "type": "orig", "text": "次＝心【乙】"}
{"id": null, "n": "0285018", "target": "#nkr_note_orig_0285018", "type": "orig", "text": "心＋（印）【甲】"}
{"id": null, "n": "0285019", "target": "#nkr_note_orig_0285019", "type": "orig", "text": "〔手〕－【甲】"}
{"id": null, "n": "0285020", "target": "#nkr_note_orig_0285020", "type": "orig", "text": "（隱）＋在【甲】【乙】"}
{"id": null, "n": "0285021", "target": "#nkr_note_orig_0285021", "type": "orig", "text": "除＝消【甲】【乙】"}
{"id": null, "n": "0285022", "target": "#nkr_note_orig_0285022", "type": "orig", "text": "〔則〕－【甲】【乙】"}
{"id": null, "n": "0285023", "target": "#nkr_note_orig_0285023", "type": "orig", "text": "即＝速【甲】【乙】"}
{"id": null, "n": "0285024", "target": "#nkr_note_orig_0285024", "type": "orig", "text": "悲愍＝慈悲【甲】"}
{"id": null, "n": "0285025", "target": "#nkr_note_orig_0285025", "type": "orig", "text": "妄＝忘【甲】"}
{"id": null, "n": "0285026", "target": "#nkr_note_orig_0285026", "type": "orig", "text": "此下甲本奧書曰保延三年二月二十五日酉尅書畢執筆生年二十歲□□□保延三年五月十四日辰時交點了，乙本奧書曰保安四年四月十六日書了同日移點了執筆􅕷"}
