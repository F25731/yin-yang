{"id": null, "n": "0364001", "target": "#nkr_note_orig_0364001", "type": "orig", "text": "「令一」，底本殘，據殘存字形及文意補。"}
{"id": null, "n": "0365001", "target": "#nkr_note_orig_0365001", "type": "orig", "text": "甲本從此起。"}
{"id": null, "n": "0365002", "target": "#nkr_note_orig_0365002", "type": "orig", "text": "「走」，甲本照片不清，矢吹錄文作「遠」。"}
{"id": null, "n": "0365003", "target": "#nkr_note_orig_0365003", "type": "orig", "text": "「之」，矢吹錄文作「亦」。"}
{"id": null, "n": "0365004", "target": "#nkr_note_orig_0365004", "type": "orig", "text": "「法」，甲本無。"}
{"id": null, "n": "0366001", "target": "#nkr_note_orig_0366001", "type": "orig", "text": "「少」，底本作「小」，甲本殘，據文意改。"}
{"id": null, "n": "0366002", "target": "#nkr_note_orig_0366002", "type": "orig", "text": "「二」，甲本作「一」。"}
{"id": null, "n": "0366003", "target": "#nkr_note_orig_0366003", "type": "orig", "text": "「三」，甲本作「二」。"}
{"id": null, "n": "0366004", "target": "#nkr_note_orig_0366004", "type": "orig", "text": "「淨」，甲本作「靜」。"}
{"id": null, "n": "0366005", "target": "#nkr_note_orig_0366005", "type": "orig", "text": "「行」，甲本無。"}
{"id": null, "n": "0367001", "target": "#nkr_note_orig_0367001", "type": "orig", "text": "「施」，甲本作「燃」。"}
{"id": null, "n": "0367002", "target": "#nkr_note_orig_0367002", "type": "orig", "text": "「日」，甲本作「日或」。"}
{"id": null, "n": "0367003", "target": "#nkr_note_orig_0367003", "type": "orig", "text": "「造像」，甲本無。"}
{"id": null, "n": "0367004", "target": "#nkr_note_orig_0367004", "type": "orig", "text": "「未」，甲本作「來」。"}
{"id": null, "n": "0367005", "target": "#nkr_note_orig_0367005", "type": "orig", "text": "「不續」，甲本無。"}
{"id": null, "n": "0367006", "target": "#nkr_note_orig_0367006", "type": "orig", "text": "「普」，甲本作「布」。"}
{"id": null, "n": "0367007", "target": "#nkr_note_orig_0367007", "type": "orig", "text": "「減」，甲本作「滅」。"}
{"id": null, "n": "0368001", "target": "#nkr_note_orig_0368001", "type": "orig", "text": "「二」，甲本作「三」。"}
{"id": null, "n": "0368002", "target": "#nkr_note_orig_0368002", "type": "orig", "text": "「處」，甲本無。"}
{"id": null, "n": "0368003", "target": "#nkr_note_orig_0368003", "type": "orig", "text": "「現」，甲本作「見」。"}
{"id": null, "n": "0368004", "target": "#nkr_note_orig_0368004", "type": "orig", "text": "「州」，甲本作「州人」。"}
{"id": null, "n": "0368005", "target": "#nkr_note_orig_0368005", "type": "orig", "text": "「並」，甲本作「相」。"}
{"id": null, "n": "0369001", "target": "#nkr_note_orig_0369001", "type": "orig", "text": "「陶」，甲本無。"}
{"id": null, "n": "0369002", "target": "#nkr_note_orig_0369002", "type": "orig", "text": "「四」，甲本無。"}
{"id": null, "n": "0369003", "target": "#nkr_note_orig_0369003", "type": "orig", "text": "「行」，甲本作「行行」。"}
{"id": null, "n": "0369004", "target": "#nkr_note_orig_0369004", "type": "orig", "text": "「羈」，甲本作空格。"}
{"id": null, "n": "0369005", "target": "#nkr_note_orig_0369005", "type": "orig", "text": "「還復」，甲本無。"}
{"id": null, "n": "0369006", "target": "#nkr_note_orig_0369006", "type": "orig", "text": "「一」，甲本無。"}
{"id": null, "n": "0369007", "target": "#nkr_note_orig_0369007", "type": "orig", "text": "「二就」，甲本作「就二」。"}
{"id": null, "n": "0369008", "target": "#nkr_note_orig_0369008", "type": "orig", "text": "「盡」，甲本無。"}
{"id": null, "n": "0370001", "target": "#nkr_note_orig_0370001", "type": "orig", "text": "「皆」，甲本作「還」。"}
{"id": null, "n": "0370002", "target": "#nkr_note_orig_0370002", "type": "orig", "text": "「某甲啟」，甲本無。"}
{"id": null, "n": "0370003", "target": "#nkr_note_orig_0370003", "type": "orig", "text": "「功」，底本無，據甲本補。"}
{"id": null, "n": "0370004", "target": "#nkr_note_orig_0370004", "type": "orig", "text": "「佛」，甲本無。"}
{"id": null, "n": "0370005", "target": "#nkr_note_orig_0370005", "type": "orig", "text": "「行」，底本無，據甲本補。"}
{"id": null, "n": "0371001", "target": "#nkr_note_orig_0371001", "type": "orig", "text": "「食」，甲本無。"}
{"id": null, "n": "0371002", "target": "#nkr_note_orig_0371002", "type": "orig", "text": "「者」，甲本無。"}
{"id": null, "n": "0371003", "target": "#nkr_note_orig_0371003", "type": "orig", "text": "「籍」，底、甲本作「藉」，據文意改。"}
{"id": null, "n": "0371004", "target": "#nkr_note_orig_0371004", "type": "orig", "text": "「籍」，底、甲本作「藉」，據文意改。"}
{"id": null, "n": "0371005", "target": "#nkr_note_orig_0371005", "type": "orig", "text": "「切」，甲本作「初」。"}
{"id": null, "n": "0372001", "target": "#nkr_note_orig_0372001", "type": "orig", "text": "「行」，甲本無。"}
{"id": null, "n": "0372002", "target": "#nkr_note_orig_0372002", "type": "orig", "text": "「並」，甲本作「相」。"}
{"id": null, "n": "0372003", "target": "#nkr_note_orig_0372003", "type": "orig", "text": "「到」，底本作「道」，據甲本改。"}
{"id": null, "n": "0372004", "target": "#nkr_note_orig_0372004", "type": "orig", "text": "甲本至此結束。下面抄有「四謗法」，錄文如下：「四謗法：若道有增益謗，若道無損減謗，非有非無戲論謗，亦有亦無相違謗。入入不入是如來入，入一一切是修道，一切一是成道。」"}
{"id": null, "n": "0372005", "target": "#nkr_note_orig_0372005", "type": "orig", "text": "底本卷末有題記如下：「十方三世一切諸佛，當證弟子閤家眷屬，願從今身乃至成佛，普為一切三寶，普為一切眾生，日捨上上錢一文。普供養一切三寶，普供養一切眾生，施入信行禪師法界普無盡藏。常無休息，乃至成佛。」"}
