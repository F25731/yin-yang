{"id": null, "n": "0233006", "target": null, "type": "orig", "text": "〔一卷〕－【宋】"}
{"id": null, "n": "0233006", "target": null, "type": "mod", "text": "一卷【大】，〔－〕【宋】"}
{"id": null, "n": "0230014", "target": "#nkr_note_mod_0230014", "type": "mod", "text": "經【大】，〔－〕【宋】"}
{"id": null, "n": "0230015", "target": "#nkr_note_mod_0230015", "type": "mod", "text": "願生偈【大】，經【宋】，〔－〕【元】【明】"}
{"id": null, "n": "0230016", "target": "#nkr_note_mod_0230016", "type": "mod", "text": "三藏【大】，三藏法師【宋】【元】【明】"}
{"id": null, "n": "0230017", "target": "#nkr_note_mod_0230017", "type": "mod", "text": "流【大】，留【宋】【元】【明】"}
{"id": null, "n": "0230018", "target": "#nkr_note_mod_0230018", "type": "mod", "text": "世尊前行宋元明三本俱有無量壽經優波提舍願生偈十一字"}
{"id": null, "n": "0231001", "target": "#nkr_note_mod_0231001", "type": "mod", "text": "語【大】＊，悟【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0231002", "target": "#nkr_note_mod_0231002", "type": "mod", "text": "受【大】，愛【明】"}
{"id": null, "n": "0231003", "target": "#nkr_note_mod_0231003", "type": "mod", "text": "皆願【大】，願皆【宋】【元】【明】"}
{"id": null, "n": "0231004", "target": "#nkr_note_mod_0231004", "type": "mod", "text": "偈【大】，偈頌【宋】【元】【明】"}
{"id": null, "n": "0231005", "target": "#nkr_note_mod_0231005", "type": "mod", "text": "門【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0231006", "target": "#nkr_note_mod_0231006", "type": "mod", "text": "陀【大】，陀佛【宋】【元】【明】"}
{"id": null, "n": "0231007", "target": "#nkr_note_mod_0231007", "type": "mod", "text": "向【大】，向於彼觀察【宋】【元】【明】"}
{"id": null, "n": "0231008", "target": "#nkr_note_mod_0231008", "type": "mod", "text": "不捨一切【大】，一切世間【宋】【元】【明】"}
{"id": null, "n": "0231009", "target": "#nkr_note_mod_0231009", "type": "mod", "text": "（心常…故）十四字【大】，同願生彼安樂國土願心所有功德善根以巧方便作願回向攝取眾生不捨一切世間故【宋】【元】【明】"}
{"id": null, "n": "0231010", "target": "#nkr_note_mod_0231010", "type": "mod", "text": "成就【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0231011", "target": "#nkr_note_mod_0231011", "type": "mod", "text": "量【大】＊，無量【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0231012", "target": "#nkr_note_mod_0231012", "type": "mod", "text": "闇冥【大】，冥闇【宋】【元】"}
{"id": null, "n": "0232001", "target": "#nkr_note_mod_0232001", "type": "mod", "text": "亦【大】，亦有【宋】【元】【明】"}
{"id": null, "n": "0232002", "target": "#nkr_note_mod_0232002", "type": "mod", "text": "佛【大】，佛國【宋】【元】【明】"}
{"id": null, "n": "0232003", "target": "#nkr_note_mod_0232003", "type": "mod", "text": "界【大】，界相【宋】【元】【明】"}
{"id": null, "n": "0232004", "target": "#nkr_note_mod_0232004", "type": "mod", "text": "讚佛【大】，讚歎【明】"}
{"id": null, "n": "0232005", "target": "#nkr_note_mod_0232005", "type": "mod", "text": "皆願【大】，願皆【宋】【元】【明】"}
{"id": null, "n": "0232006", "target": "#nkr_note_mod_0232006", "type": "mod", "text": "功德【大】，功德莊嚴【宋】【元】【明】"}
{"id": null, "n": "0232007", "target": "#nkr_note_mod_0232007", "type": "mod", "text": "種【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0232008", "target": "#nkr_note_mod_0232008", "type": "mod", "text": "不以【大】，以不【宋】【元】【明】"}
{"id": null, "n": "0233001", "target": "#nkr_note_mod_0233001", "type": "mod", "text": "想【大】，知相【宋】【元】【明】"}
{"id": null, "n": "0233002", "target": "#nkr_note_mod_0233002", "type": "mod", "text": "門【大】，門者【宋】【元】【明】"}
{"id": null, "n": "0233003", "target": "#nkr_note_mod_0233003", "type": "mod", "text": "亦【大】，示【宋】【元】【明】"}
{"id": null, "n": "0233004", "target": "#nkr_note_mod_0233004", "type": "mod", "text": "故【大】，故無量壽修多羅優波提舍願生偈略解義竟【宋】【元】【明】"}
{"id": null, "n": "0233005", "target": "#nkr_note_mod_0233005", "type": "mod", "text": "論一卷【大】，無量壽經優波提舍【元】【明】"}
{"id": null, "n": "0233006", "target": "#nkr_note_mod_0233006", "type": "mod", "text": "一卷【大】，〔－〕【宋】"}
{"id": null, "n": "0233007", "target": "#nkr_note_mod_0233007", "type": "mod", "text": "（大乘…之）三十四字【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0230014", "target": "#nkr_note_orig_0230014", "type": "orig", "text": "〔經〕－【宋】"}
{"id": null, "n": "0230015", "target": "#nkr_note_orig_0230015", "type": "orig", "text": "願生偈＝經【宋】，〔願生偈〕－【元】【明】"}
{"id": null, "n": "0230016", "target": "#nkr_note_orig_0230016", "type": "orig", "text": "三藏＋（法師）【三】"}
{"id": null, "n": "0230017", "target": "#nkr_note_orig_0230017", "type": "orig", "text": "流＝留【三】"}
{"id": null, "n": "0230018", "target": "#nkr_note_orig_0230018", "type": "orig", "text": "世尊前行宋元明三本俱有無量壽經優波提舍願生偈十一字"}
{"id": null, "n": "0231001", "target": "#nkr_note_orig_0231001", "type": "orig", "text": "語＝悟【三】＊"}
{"id": null, "n": "0231002", "target": "#nkr_note_orig_0231002", "type": "orig", "text": "受＝愛【明】"}
{"id": null, "n": "0231003", "target": "#nkr_note_orig_0231003", "type": "orig", "text": "皆願＝願皆【三】"}
{"id": null, "n": "0231004", "target": "#nkr_note_orig_0231004", "type": "orig", "text": "偈＋（頌）【三】"}
{"id": null, "n": "0231005", "target": "#nkr_note_orig_0231005", "type": "orig", "text": "〔門〕－【三】＊"}
{"id": null, "n": "0231006", "target": "#nkr_note_orig_0231006", "type": "orig", "text": "陀＋（佛）【三】"}
{"id": null, "n": "0231007", "target": "#nkr_note_orig_0231007", "type": "orig", "text": "向＋（於彼觀察）【三】"}
{"id": null, "n": "0231008", "target": "#nkr_note_orig_0231008", "type": "orig", "text": "不捨一切＝一切世間【三】"}
{"id": null, "n": "0231009", "target": "#nkr_note_orig_0231009", "type": "orig", "text": "（（心常…故））十四字＝（（同願生彼安樂國土願心所有功德善根以巧方便作願回向攝取眾生不捨一切世間故））三十五字【三】"}
{"id": null, "n": "0231010", "target": "#nkr_note_orig_0231010", "type": "orig", "text": "〔成就〕－【三】"}
{"id": null, "n": "0231011", "target": "#nkr_note_orig_0231011", "type": "orig", "text": "（無）＋量【三】＊"}
{"id": null, "n": "0231012", "target": "#nkr_note_orig_0231012", "type": "orig", "text": "闇冥＝冥闇【宋】【元】"}
{"id": null, "n": "0232001", "target": "#nkr_note_orig_0232001", "type": "orig", "text": "亦＋（有）【三】"}
{"id": null, "n": "0232002", "target": "#nkr_note_orig_0232002", "type": "orig", "text": "佛＋（國）【三】"}
{"id": null, "n": "0232003", "target": "#nkr_note_orig_0232003", "type": "orig", "text": "界＋（相）【三】"}
{"id": null, "n": "0232004", "target": "#nkr_note_orig_0232004", "type": "orig", "text": "讚佛＝讚歎【明】"}
{"id": null, "n": "0232005", "target": "#nkr_note_orig_0232005", "type": "orig", "text": "皆願＝願皆【三】"}
{"id": null, "n": "0232006", "target": "#nkr_note_orig_0232006", "type": "orig", "text": "功德＋（莊嚴）【三】"}
{"id": null, "n": "0232007", "target": "#nkr_note_orig_0232007", "type": "orig", "text": "〔種〕－【三】"}
{"id": null, "n": "0232008", "target": "#nkr_note_orig_0232008", "type": "orig", "text": "不以＝以不【三】"}
{"id": null, "n": "0233001", "target": "#nkr_note_orig_0233001", "type": "orig", "text": "想＝知相【三】"}
{"id": null, "n": "0233002", "target": "#nkr_note_orig_0233002", "type": "orig", "text": "門＋（者）【三】"}
{"id": null, "n": "0233003", "target": "#nkr_note_orig_0233003", "type": "orig", "text": "亦＝示【三】"}
{"id": null, "n": "0233004", "target": "#nkr_note_orig_0233004", "type": "orig", "text": "故＋（無量壽修多羅優波提舍願生偈略解義竟）【三】"}
{"id": null, "n": "0233005", "target": "#nkr_note_orig_0233005", "type": "orig", "text": "論一卷＝無量壽經優波提舍【元】【明】"}
{"id": null, "n": "0233006", "target": "#nkr_note_orig_0233006", "type": "orig", "text": "〔一卷〕－【宋】"}
{"id": null, "n": "0233007", "target": "#nkr_note_orig_0233007", "type": "orig", "text": "〔大乘…之〕三十四字－【三】"}
