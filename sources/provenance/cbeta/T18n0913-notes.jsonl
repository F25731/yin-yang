{"id": null, "n": null, "target": null, "type": null, "text": "隨部者，謂：如來部十五日、菩薩部十四日、金剛部八日、諸天部五日、藥叉部四日也"}
{"id": null, "n": null, "target": null, "type": null, "text": "誦外儀九遍"}
{"id": null, "n": null, "target": null, "type": null, "text": "三七遍是懺悔法"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂：帝釋綱皆是寶珠，珠珠相射瑩映明徹"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂正殿中"}
{"id": null, "n": null, "target": null, "type": null, "text": "閼伽香水、商佉坏也"}
{"id": null, "n": null, "target": null, "type": null, "text": "百八遍或\n三七"}
{"id": null, "n": null, "target": null, "type": null, "text": "一百\n八遍"}
{"id": null, "n": null, "target": null, "type": null, "text": "大約普賢為主，然當部自有對法也"}
{"id": null, "n": null, "target": null, "type": null, "text": "大約觀音為主"}
{"id": null, "n": null, "target": null, "type": null, "text": "大約金剛手為主"}
{"id": null, "n": null, "target": null, "type": null, "text": "必孕反"}
{"id": null, "n": null, "target": null, "type": null, "text": "小尺一尺八寸"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂十字跋折羅"}
{"id": null, "n": null, "target": null, "type": null, "text": "都闊十二\n指"}
{"id": null, "n": null, "target": null, "type": null, "text": "日出時、人定時、後夜時"}
{"id": null, "n": null, "target": null, "type": null, "text": "如無龍惱，鬱金單用，檀香亦得也"}
{"id": null, "n": null, "target": null, "type": null, "text": "火供養左手執杵按之"}
{"id": null, "n": null, "target": null, "type": null, "text": "漿水煮洗，蜜和炒令乾，別搗之"}
{"id": null, "n": null, "target": null, "type": null, "text": "如鄉土難得隨得辨"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上共搗"}
{"id": null, "n": null, "target": null, "type": null, "text": "各半分別絹袋盛著，諸秣中了"}
{"id": null, "n": null, "target": null, "type": null, "text": "每時各三四計，酪則減半相和，一銅盆盛之"}
{"id": null, "n": null, "target": null, "type": null, "text": "糤米油煮及染作紫、赤、黃等色，名為稻穀華，盛于一器。"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上相和別盛一器"}
{"id": null, "n": null, "target": null, "type": null, "text": "如無丁香亦得"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂：某甲扇底迦娑縛訶也"}
{"id": null, "n": null, "target": null, "type": null, "text": "三七遍"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X59n1035_p0005a24"}
{"id": null, "n": "0935018", "target": null, "type": "orig", "text": "想＝相【乙】"}
{"id": null, "n": "0935018", "target": null, "type": "mod", "text": "想【大】，相【乙】"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X59n1035_p0005b12"}
{"id": null, "n": "0936034", "target": null, "type": "orig", "text": "儀軌＝經法【乙】"}
{"id": null, "n": "0936034", "target": null, "type": "mod", "text": "儀軌【大】，經法【乙】"}
{"id": null, "n": "0934011", "target": "#nkr_note_mod_0934011", "type": "mod", "text": "火【大】，金剛頂護摩瑜伽供養火天火【校異-乙】，【原】豐山版，【甲】高山寺藏古寫本，【乙】應保二年寫東寺三密藏本"}
{"id": null, "n": "0934012", "target": "#nkr_note_mod_0934012", "type": "mod", "text": "供養【大】，〔－〕【校異-乙】"}
{"id": null, "n": "0934013", "target": "#nkr_note_mod_0934013", "type": "mod", "text": "軌【大】，軌三藏善無畏【校異-原】，軌三藏善無畏【乙】"}
{"id": null, "n": "0934014", "target": "#nkr_note_mod_0934014", "type": "mod", "text": "法【大】，數【乙】"}
{"id": null, "n": "0934015", "target": "#nkr_note_mod_0934015", "type": "mod", "text": "尊【大】，教【考偽-原】"}
{"id": null, "n": "0934016", "target": "#nkr_note_mod_0934016", "type": "mod", "text": "壇【大】，爐【校異-原】，爐【甲】"}
{"id": null, "n": "0934017", "target": "#nkr_note_mod_0934017", "type": "mod", "text": "銜蒸【大】，行【校異-原】"}
{"id": null, "n": "0934018", "target": "#nkr_note_mod_0934018", "type": "mod", "text": "酥【大】，蘇【甲】【乙】"}
{"id": null, "n": "0935002", "target": "#nkr_note_mod_0935002", "type": "mod", "text": "盤【大】，拌【甲】【乙】"}
{"id": null, "n": "0935003", "target": "#nkr_note_mod_0935003", "type": "mod", "text": "心【大】，心中心【乙】"}
{"id": null, "n": "0935004", "target": "#nkr_note_mod_0935004", "type": "mod", "text": "又【大】，叉【甲】【乙】"}
{"id": null, "n": "0935006", "target": "#nkr_note_mod_0935006", "type": "mod", "text": "阿【大】，隨阿【甲】"}
{"id": null, "n": "0935007", "target": "#nkr_note_mod_0935007", "type": "mod", "text": "㗚【大】，嘌【乙】"}
{"id": null, "n": "0935008", "target": "#nkr_note_mod_0935008", "type": "mod", "text": "多【大】，哆【甲】【乙】"}
{"id": null, "n": "0935009", "target": "#nkr_note_mod_0935009", "type": "mod", "text": "音【大】，〔－〕【乙】"}
{"id": null, "n": "0935010", "target": "#nkr_note_mod_0935010", "type": "mod", "text": "豫【大】，預【乙】"}
{"id": null, "n": "0935011", "target": "#nkr_note_mod_0935011", "type": "mod", "text": "捷【CB】【卍續-CB】【乙】，揵【大】"}
{"id": null, "n": "0935012", "target": "#nkr_note_mod_0935012", "type": "mod", "text": "備【大】，被【甲】【乙】"}
{"id": null, "n": "0935013", "target": "#nkr_note_mod_0935013", "type": "mod", "text": "稱【大】，〔－〕【校異-原】"}
{"id": null, "n": "0935014", "target": "#nkr_note_mod_0935014", "type": "mod", "text": "拜【大】，遍【校異-原】"}
{"id": null, "n": "0935015", "target": "#nkr_note_mod_0935015", "type": "mod", "text": "遍【大】＊，返【乙】＊"}
{"id": null, "n": "0935016", "target": "#nkr_note_mod_0935016", "type": "mod", "text": "淨【大】，滓【甲】，澤【乙】"}
{"id": null, "n": "0935017", "target": "#nkr_note_mod_0935017", "type": "mod", "text": "門想【大】，〔－〕【甲】，想【乙】"}
{"id": null, "n": "0935018", "target": "#nkr_note_mod_0935018", "type": "mod", "text": "想【大】，相【乙】"}
{"id": null, "n": "0935019", "target": "#nkr_note_mod_0935019", "type": "mod", "text": "皎【大】，曉【乙】"}
{"id": null, "n": "0935020", "target": "#nkr_note_mod_0935020", "type": "mod", "text": "爐【大】＊，鑪【乙】＊"}
{"id": null, "n": "0935021", "target": "#nkr_note_mod_0935021", "type": "mod", "text": "之【大】，〔－〕【甲】"}
{"id": null, "n": "0935022", "target": "#nkr_note_mod_0935022", "type": "mod", "text": "耀【大】，曜【甲】【乙】"}
{"id": null, "n": "0935023", "target": "#nkr_note_mod_0935023", "type": "mod", "text": "寶【大】，瑤【乙】"}
{"id": null, "n": "0935024", "target": "#nkr_note_mod_0935024", "type": "mod", "text": "矜【大】，羚【乙】"}
{"id": null, "n": "0935025", "target": "#nkr_note_mod_0935025", "type": "mod", "text": "絞【大】，交【甲】【乙】"}
{"id": null, "n": "0935026", "target": "#nkr_note_mod_0935026", "type": "mod", "text": "珠【大】，〔－〕【甲】"}
{"id": null, "n": "0935027", "target": "#nkr_note_mod_0935027", "type": "mod", "text": "瑩【大】，鑒【乙】"}
{"id": null, "n": "0935028", "target": "#nkr_note_mod_0935028", "type": "mod", "text": "覩婆【大】，覩波【甲】，都波【乙】"}
{"id": null, "n": "0935029", "target": "#nkr_note_mod_0935029", "type": "mod", "text": "想【大】，相【甲】"}
{"id": null, "n": "0935030", "target": "#nkr_note_mod_0935030", "type": "mod", "text": "跏【大】，加【乙】"}
{"id": null, "n": "0935031", "target": "#nkr_note_mod_0935031", "type": "mod", "text": "佛【大】，法【乙】"}
{"id": null, "n": "0935032", "target": "#nkr_note_mod_0935032", "type": "mod", "text": "妙【大】，音【甲】【乙】"}
{"id": null, "n": "0935033", "target": "#nkr_note_mod_0935033", "type": "mod", "text": "諸【大】，法【甲】【乙】"}
{"id": null, "n": "0935034", "target": "#nkr_note_mod_0935034", "type": "mod", "text": "閼伽【大】，〔－〕【甲】"}
{"id": null, "n": "0935035", "target": "#nkr_note_mod_0935035", "type": "mod", "text": "餐【大】，飡【乙】"}
{"id": null, "n": "0935036", "target": "#nkr_note_mod_0935036", "type": "mod", "text": "製【大】，掣【甲】【乙】"}
{"id": null, "n": "0935037", "target": "#nkr_note_mod_0935037", "type": "mod", "text": "百八遍或三七【大】，或三七百八邊【乙】"}
{"id": null, "n": "0935039", "target": "#nkr_note_mod_0935039", "type": "mod", "text": "法【大】，〔－〕【乙】"}
{"id": null, "n": "0935040", "target": "#nkr_note_mod_0935040", "type": "mod", "text": "撥【大】，發【甲】【乙】"}
{"id": null, "n": "0935041", "target": "#nkr_note_mod_0935041", "type": "mod", "text": "一【大】，〔－〕【乙】"}
{"id": null, "n": "0935042", "target": "#nkr_note_mod_0935042", "type": "mod", "text": "𤙖【大】，吽【乙】"}
{"id": null, "n": "0935043", "target": "#nkr_note_mod_0935043", "type": "mod", "text": "法也【大】，治【甲】"}
{"id": null, "n": "0935044", "target": "#nkr_note_mod_0935044", "type": "mod", "text": "微【大】，致【乙】"}
{"id": null, "n": "0935045", "target": "#nkr_note_mod_0935045", "type": "mod", "text": "其【大】，具【甲】"}
{"id": null, "n": "0935046", "target": "#nkr_note_mod_0935046", "type": "mod", "text": "主【大】，主此謂靜佛法中剌【乙】"}
{"id": null, "n": "0935047", "target": "#nkr_note_mod_0935047", "type": "mod", "text": "養【大】，具【乙】"}
{"id": null, "n": "0935048", "target": "#nkr_note_mod_0935048", "type": "mod", "text": "捏【大】，想【甲】，相【乙】"}
{"id": null, "n": "0935049", "target": "#nkr_note_mod_0935049", "type": "mod", "text": "磨【大】，摩【乙】"}
{"id": null, "n": "0935050", "target": "#nkr_note_mod_0935050", "type": "mod", "text": "跋【大】，拔【乙】"}
{"id": null, "n": "0935051", "target": "#nkr_note_mod_0935051", "type": "mod", "text": "闊【大】，廣【甲】"}
{"id": null, "n": "0935052", "target": "#nkr_note_mod_0935052", "type": "mod", "text": "畫【大】，畫作【乙】"}
{"id": null, "n": "0935053", "target": "#nkr_note_mod_0935053", "type": "mod", "text": "時【大】，時也【乙】"}
{"id": null, "n": "0935054", "target": "#nkr_note_mod_0935054", "type": "mod", "text": "每【大】，每日【校異-原】，無【甲】"}
{"id": null, "n": "0935055", "target": "#nkr_note_mod_0935055", "type": "mod", "text": "必【大】，〔－〕【校異-原】，〔－〕【乙】"}
{"id": null, "n": "0935056", "target": "#nkr_note_mod_0935056", "type": "mod", "text": "不孝【大】，老【校異-原】，孝【甲】【乙】"}
{"id": null, "n": "0935057", "target": "#nkr_note_mod_0935057", "type": "mod", "text": "爐【大】，壚【乙】"}
{"id": null, "n": "0935058", "target": "#nkr_note_mod_0935058", "type": "mod", "text": "之【大】，〔－〕【乙】"}
{"id": null, "n": "0935059", "target": "#nkr_note_mod_0935059", "type": "mod", "text": "令【大】＊，合【甲】＊"}
{"id": null, "n": "0935060", "target": "#nkr_note_mod_0935060", "type": "mod", "text": "也【大】，〔－〕【甲】"}
{"id": null, "n": "0935061", "target": "#nkr_note_mod_0935061", "type": "mod", "text": "計【大】，許【乙】"}
{"id": null, "n": "0935062", "target": "#nkr_note_mod_0935062", "type": "mod", "text": "之【大】，之也【乙】"}
{"id": null, "n": "0935063", "target": "#nkr_note_mod_0935063", "type": "mod", "text": "淺【大】＊，牋【乙】＊"}
{"id": null, "n": "0935064", "target": "#nkr_note_mod_0935064", "type": "mod", "text": "㢇唐【大】，薝葡【校異-原】，薝唐【乙】"}
{"id": null, "n": "0935065", "target": "#nkr_note_mod_0935065", "type": "mod", "text": "兩【大】，分【乙】"}
{"id": null, "n": "0935066", "target": "#nkr_note_mod_0935066", "type": "mod", "text": "三【大】，十二【乙】"}
{"id": null, "n": "0935067", "target": "#nkr_note_mod_0935067", "type": "mod", "text": "水【大】，〔－〕【甲】"}
{"id": null, "n": "0935068", "target": "#nkr_note_mod_0935068", "type": "mod", "text": "煮【大】，者【乙】"}
{"id": null, "n": "0935069", "target": "#nkr_note_mod_0935069", "type": "mod", "text": "鍊【大】，練【甲】【乙】"}
{"id": null, "n": "0935070", "target": "#nkr_note_mod_0935070", "type": "mod", "text": "難【大】，唯【甲】"}
{"id": null, "n": "0935071", "target": "#nkr_note_mod_0935071", "type": "mod", "text": "得【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0935072", "target": "#nkr_note_mod_0935072", "type": "mod", "text": "辨【大】，辨也【乙】"}
{"id": null, "n": "0935073", "target": "#nkr_note_mod_0935073", "type": "mod", "text": "秣【大】＊，粖【乙】＊"}
{"id": null, "n": "0935074", "target": "#nkr_note_mod_0935074", "type": "mod", "text": "兩【大】，〔－〕【乙】"}
{"id": null, "n": "0936001", "target": "#nkr_note_mod_0936001", "type": "mod", "text": "二兩【大】，〔－〕【甲】"}
{"id": null, "n": "0936002", "target": "#nkr_note_mod_0936002", "type": "mod", "text": "好【大】，始【甲】"}
{"id": null, "n": "0936003", "target": "#nkr_note_mod_0936003", "type": "mod", "text": "了【大】，〔－〕【乙】"}
{"id": null, "n": "0936004", "target": "#nkr_note_mod_0936004", "type": "mod", "text": "酥【大】，蘇【乙】"}
{"id": null, "n": "0936005", "target": "#nkr_note_mod_0936005", "type": "mod", "text": "四計【大】，兩許【甲】【乙】"}
{"id": null, "n": "0936006", "target": "#nkr_note_mod_0936006", "type": "mod", "text": "盆【大】，瓫【甲】，盂【乙】"}
{"id": null, "n": "0936007", "target": "#nkr_note_mod_0936007", "type": "mod", "text": "稻穀花【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0936008", "target": "#nkr_note_mod_0936008", "type": "mod", "text": "米【大】，粖【乙】"}
{"id": null, "n": "0936009", "target": "#nkr_note_mod_0936009", "type": "mod", "text": "為【大】，〔－〕【乙】"}
{"id": null, "n": "0936010", "target": "#nkr_note_mod_0936010", "type": "mod", "text": "華【大】，華稻穀花【甲】，華稻穀花別【乙】"}
{"id": null, "n": "0936011", "target": "#nkr_note_mod_0936011", "type": "mod", "text": "于【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0936012", "target": "#nkr_note_mod_0936012", "type": "mod", "text": "器【大】，器之【乙】"}
{"id": null, "n": "0936013", "target": "#nkr_note_mod_0936013", "type": "mod", "text": "豆【大】，豆烏豆【乙】"}
{"id": null, "n": "0936014", "target": "#nkr_note_mod_0936014", "type": "mod", "text": "器【大】，器之【甲】"}
{"id": null, "n": "0936015", "target": "#nkr_note_mod_0936015", "type": "mod", "text": "合【大】＊，含【乙】＊"}
{"id": null, "n": "0936016", "target": "#nkr_note_mod_0936016", "type": "mod", "text": "粒【大】，粉【甲】"}
{"id": null, "n": "0936017", "target": "#nkr_note_mod_0936017", "type": "mod", "text": "糖【大】，餹【乙】"}
{"id": null, "n": "0936018", "target": "#nkr_note_mod_0936018", "type": "mod", "text": "天【大】，天各誦其本【考偽-原】"}
{"id": null, "n": "0936019", "target": "#nkr_note_mod_0936019", "type": "mod", "text": "搵【大】，榅【乙】"}
{"id": null, "n": "0936020", "target": "#nkr_note_mod_0936020", "type": "mod", "text": "詳【大】，祥【甲】"}
{"id": null, "n": "0936021", "target": "#nkr_note_mod_0936021", "type": "mod", "text": "甲【大】，乙【乙】"}
{"id": null, "n": "0936022", "target": "#nkr_note_mod_0936022", "type": "mod", "text": "明【大】，〔－〕【乙】"}
{"id": null, "n": "0936023", "target": "#nkr_note_mod_0936023", "type": "mod", "text": "𠷈【大】，律【乙】"}
{"id": null, "n": "0936024", "target": "#nkr_note_mod_0936024", "type": "mod", "text": "三合【CB】，二合【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0936025", "target": "#nkr_note_mod_0936025", "type": "mod", "text": "葷【大】，薰【甲】【乙】"}
{"id": null, "n": "0936026", "target": "#nkr_note_mod_0936026", "type": "mod", "text": "然【大】，燃【甲】"}
