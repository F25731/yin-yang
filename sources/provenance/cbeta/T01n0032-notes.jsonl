{"id": null, "n": null, "target": null, "type": null, "text": "《大安般》云「信本因緣」，知從宿命有，名直見。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《義決》云「知前事」，如後事是也"}
{"id": null, "n": "0814007", "target": "#nkr_note_mod_0814007", "type": "mod", "text": "安息國三藏【大】，沙門【宋】【元】【明】"}
{"id": null, "n": "0814008", "target": "#nkr_note_mod_0814008", "type": "mod", "text": "從【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0814009", "target": "#nkr_note_mod_0814009", "type": "mod", "text": "惡【大】，要【元】【明】"}
{"id": null, "n": "0814010", "target": "#nkr_note_mod_0814010", "type": "mod", "text": "具【大】，見【宋】【元】【明】"}
{"id": null, "n": "0814011", "target": "#nkr_note_mod_0814011", "type": "mod", "text": "坐【大】，座【明】"}
{"id": null, "n": "0814012", "target": "#nkr_note_mod_0814012", "type": "mod", "text": "今【大】，令【明】"}
{"id": null, "n": "0814013", "target": "#nkr_note_mod_0814013", "type": "mod", "text": "習【大】＊，集【元】【明】＊"}
{"id": null, "n": "0814014", "target": "#nkr_note_mod_0814014", "type": "mod", "text": "苦復苦【大】，復受【宋】【元】【明】"}
{"id": null, "n": "0814015", "target": "#nkr_note_mod_0814015", "type": "mod", "text": "鬢髮墮【大】，鬚髮隨【宋】【元】【明】"}
{"id": null, "n": "0814016", "target": "#nkr_note_mod_0814016", "type": "mod", "text": "𭣛𭣛【大】，變變【元】【明】"}
{"id": null, "n": "0815001", "target": "#nkr_note_mod_0815001", "type": "mod", "text": "顛【大】，癲【宋】【元】【明】"}
{"id": null, "n": "0815002", "target": "#nkr_note_mod_0815002", "type": "mod", "text": "癅【大】，𠺕【宋】"}
{"id": null, "n": "0815003", "target": "#nkr_note_mod_0815003", "type": "mod", "text": "皮【大】，疲【宋】"}
{"id": null, "n": "0815004", "target": "#nkr_note_mod_0815004", "type": "mod", "text": "念【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0815005", "target": "#nkr_note_mod_0815005", "type": "mod", "text": "者【大】，者為【宋】【元】【明】"}
{"id": null, "n": "0815006", "target": "#nkr_note_mod_0815006", "type": "mod", "text": "愛【大】，受【宋】【元】【明】"}
{"id": null, "n": "0815007", "target": "#nkr_note_mod_0815007", "type": "mod", "text": "亡【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0815008", "target": "#nkr_note_mod_0815008", "type": "mod", "text": "栽【大】＊，裁【宋】＊"}
{"id": null, "n": "0815009", "target": "#nkr_note_mod_0815009", "type": "mod", "text": "令【大】，念【宋】【元】【明】"}
{"id": null, "n": "0815010", "target": "#nkr_note_mod_0815010", "type": "mod", "text": "疾【大】，病【宋】【元】【明】"}
{"id": null, "n": "0815011", "target": "#nkr_note_mod_0815011", "type": "mod", "text": "不【大】，可【宋】【元】【明】"}
{"id": null, "n": "0815012", "target": "#nkr_note_mod_0815012", "type": "mod", "text": "現【大】＊，見【宋】【元】【明】＊"}
{"id": null, "n": "0816001", "target": "#nkr_note_mod_0816001", "type": "mod", "text": "蚤【大】，亦【宋】【元】【明】"}
{"id": null, "n": "0816002", "target": "#nkr_note_mod_0816002", "type": "mod", "text": "如【大】＊，而【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0816003", "target": "#nkr_note_mod_0816003", "type": "mod", "text": "會【大】，貪【宋】【元】【明】"}
{"id": null, "n": "0816004", "target": "#nkr_note_mod_0816004", "type": "mod", "text": "念【大】，令【宋】【元】【明】"}
{"id": null, "n": "0816005", "target": "#nkr_note_mod_0816005", "type": "mod", "text": "餘【大】，除【宋】【元】【明】"}
{"id": null, "n": "0816006", "target": "#nkr_note_mod_0816006", "type": "mod", "text": "苦【大】，若【元】"}
{"id": null, "n": "0816007", "target": "#nkr_note_mod_0816007", "type": "mod", "text": "毀【大】＊，皺【宋】＊，翍【元】【明】＊"}
{"id": null, "n": "0816008", "target": "#nkr_note_mod_0816008", "type": "mod", "text": "所【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0816009", "target": "#nkr_note_mod_0816009", "type": "mod", "text": "正直【大】，直正【宋】【元】【明】"}
{"id": null, "n": "0816010", "target": "#nkr_note_mod_0816010", "type": "mod", "text": "脫【大】，解【宋】"}
{"id": null, "n": "0816011", "target": "#nkr_note_mod_0816011", "type": "mod", "text": "苦【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0816012", "target": "#nkr_note_mod_0816012", "type": "mod", "text": "持宿命觀大安般云信本因緣知從宿命有名直見義決云知前事如後事是也【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "大安般云信本因緣知從宿命有名直見"}
{"id": null, "n": null, "target": null, "type": null, "text": "義決云知前事如後事是也"}
