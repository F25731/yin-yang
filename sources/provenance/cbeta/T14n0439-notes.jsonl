{"id": null, "n": null, "target": null, "type": "cf1", "text": "K34n1194_p0224b06"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T01n0002_p0150a27"}
{"id": null, "n": "0112005", "target": "#nkr_note_mod_0112005", "type": "mod", "text": "西天譯經【大】，宋西天【明】"}
{"id": null, "n": "0112006", "target": "#nkr_note_mod_0112006", "type": "mod", "text": "（朝散…法）十字【大】，〔－〕【宮】"}
{"id": null, "n": "0112007", "target": "#nkr_note_mod_0112007", "type": "mod", "text": "臣【大】，〔－〕【明】【宮】"}
{"id": null, "n": "0112008", "target": "#nkr_note_mod_0112008", "type": "mod", "text": "目乾連【大】下同，目犍連【明】下同"}
{"id": null, "n": "0112009", "target": "#nkr_note_mod_0112009", "type": "mod", "text": "天【大】，大【元】"}
{"id": null, "n": "0113001", "target": "#nkr_note_mod_0113001", "type": "mod", "text": "如是【大】，是時【宋】【元】【明】【宮】"}
{"id": null, "n": "0113002", "target": "#nkr_note_mod_0113002", "type": "mod", "text": "各各【大】，名名【宋】【元】【明】"}
{"id": null, "n": "0113003", "target": "#nkr_note_mod_0113003", "type": "mod", "text": "多【大】，名【宋】【元】【明】"}
{"id": null, "n": "0113004", "target": "#nkr_note_mod_0113004", "type": "mod", "text": "染【大】，深【宋】【元】【明】"}
{"id": null, "n": "0112005", "target": "#nkr_note_orig_0112005", "type": "orig", "text": "西天譯經＝宋西天【明】"}
{"id": null, "n": "0112006", "target": "#nkr_note_orig_0112006", "type": "orig", "text": "〔朝散…法〕十字－【宮】"}
{"id": null, "n": "0112007", "target": "#nkr_note_orig_0112007", "type": "orig", "text": "〔臣〕－【明】【宮】"}
{"id": null, "n": "0112008", "target": "#nkr_note_orig_0112008", "type": "orig", "text": "目乾連＝目犍連【明】下同"}
{"id": null, "n": "0112009", "target": "#nkr_note_orig_0112009", "type": "orig", "text": "天＝大【元】"}
{"id": null, "n": "0113001", "target": "#nkr_note_orig_0113001", "type": "orig", "text": "如是＝是時【三】【宮】"}
{"id": null, "n": "0113002", "target": "#nkr_note_orig_0113002", "type": "orig", "text": "各各＝名名【三】"}
{"id": null, "n": "0113003", "target": "#nkr_note_orig_0113003", "type": "orig", "text": "多＝名【三】"}
{"id": null, "n": "0113004", "target": "#nkr_note_orig_0113004", "type": "orig", "text": "染＝深【三】"}
{"id": null, "n": "0113c1801", "target": "#nkr_note_add_0113c1801", "type": "add", "text": "含【CB】【麗-CB】，舍【大】"}
