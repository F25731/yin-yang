{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "宗泐"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "如玘"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "宗泐"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "宗泐"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "宗泐"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "如玘【CB】，󰃗【大】玘󰃗"}
{"id": null, "n": "0228a1101", "target": null, "type": "add", "text": "玘【CB】，󰃗【大】"}
{"id": null, "n": null, "target": null, "type": null, "text": "此流通分也流通者流通般若使之不壅利益後世眾生也天親偈云佛說希有總持法不可稱量深句義從尊者聞及廣說同此福德施群生"}
{"id": null, "n": "0228002", "target": "#nkr_note_mod_0228002", "type": "mod", "text": "（大明…註）二十八字【大】，〔－〕【宮】"}
{"id": null, "n": "0228003", "target": "#nkr_note_mod_0228003", "type": "mod", "text": "尤【大】，元【宮】"}
{"id": null, "n": "0228004", "target": "#nkr_note_mod_0228004", "type": "mod", "text": "故【大】，今【宮】"}
{"id": null, "n": "0228005", "target": "#nkr_note_mod_0228005", "type": "mod", "text": "天【大】，慈氏天【宮】"}
{"id": null, "n": "0228006", "target": "#nkr_note_mod_0228006", "type": "mod", "text": "等【大】，偈【宮】"}
{"id": null, "n": "0228007", "target": "#nkr_note_mod_0228007", "type": "mod", "text": "給【CB】【宮】＊，結【大】＊"}
{"id": null, "n": "0228008", "target": "#nkr_note_mod_0228008", "type": "mod", "text": "身【大】，身又折己幔幢生彼福德【宮】"}
{"id": null, "n": "0228009", "target": "#nkr_note_mod_0228009", "type": "mod", "text": "序【大】＊，敘【宮】＊"}
{"id": null, "n": "0228010", "target": "#nkr_note_mod_0228010", "type": "mod", "text": "（欲令…德）十字【大】，〔－〕【宮】"}
{"id": null, "n": "0228011", "target": "#nkr_note_mod_0228011", "type": "mod", "text": "者【大】，者天竺跣足而食故【宮】"}
{"id": null, "n": "0228012", "target": "#nkr_note_mod_0228012", "type": "mod", "text": "加【大】，跏【宮】"}
{"id": null, "n": "0229001", "target": "#nkr_note_mod_0229001", "type": "mod", "text": "雙【大】，濩【宮】"}
{"id": null, "n": "0229002", "target": "#nkr_note_mod_0229002", "type": "mod", "text": "萬【大】，梵【宮】"}
{"id": null, "n": "0229003", "target": "#nkr_note_mod_0229003", "type": "mod", "text": "（無住…佛）八字【大】，〔－〕【宮】"}
{"id": null, "n": "0230001", "target": "#nkr_note_mod_0230001", "type": "mod", "text": "此【大】，此乃【宮】"}
{"id": null, "n": "0230002", "target": "#nkr_note_mod_0230002", "type": "mod", "text": "（該乎…耳）九十九字【大】，（若有四相生信不深得法不廣其福德無量者為無此四相也無法相者相執報空也亦無非法者性執空也）四十一字【宮】"}
{"id": null, "n": "0230003", "target": "#nkr_note_mod_0230003", "type": "mod", "text": "則【大】，即【宮】"}
{"id": null, "n": "0230004", "target": "#nkr_note_mod_0230004", "type": "mod", "text": "此【大】，此一節是【宮】"}
{"id": null, "n": "0230005", "target": "#nkr_note_mod_0230005", "type": "mod", "text": "（若心…也）十八字【大】，〔－〕【宮】"}
{"id": null, "n": "0230006a", "target": "#nkr_note_mod_0230006a", "type": "mod", "text": "（此結…㳷合）百一十八字【大】，（（我人眾生壽者四相該乎生法二執生即眾生假名也法乃五陰實法也亦名我我所此二執中各有性相二執此二執非性相二空妙觀不能破也故龍樹云於生於法破性破相謂於假名中破性相二執於實法中亦破性相二執也不應取法者忘能觀之智也不應取非法忘所觀之境也所觀如病觀智如藥境智俱泯如病去藥忘也））百三十字【宮】"}
{"id": null, "n": "0230006b", "target": "#nkr_note_mod_0230006b", "type": "mod", "text": "（言筏…物矣）四十七字【大】，（（言如筏喻者筏乃渡河之具到彼岸則不用之借喻法尚應捨何況非法））二十八字【宮】"}
{"id": null, "n": "0230007", "target": "#nkr_note_mod_0230007", "type": "mod", "text": "問【大】，乃發問【宮】"}
{"id": null, "n": "0230008", "target": "#nkr_note_mod_0230008", "type": "mod", "text": "（佛又…而）十二字【大】，然世間布施福報乃有漏因果【宮】"}
{"id": null, "n": "0230009", "target": "#nkr_note_mod_0230009", "type": "mod", "text": "其【大】，所以其【宮】"}
{"id": null, "n": "0230010", "target": "#nkr_note_mod_0230010", "type": "mod", "text": "然持經福勝者【大】，其故何哉【宮】"}
{"id": null, "n": "0230011", "target": "#nkr_note_mod_0230011", "type": "mod", "text": "上無為法【大】，第三疑中【宮】"}
{"id": null, "n": "0231001", "target": "#nkr_note_mod_0231001", "type": "mod", "text": "（無無…證）十二字【大】，不著於無學果位若著於此【宮】"}
{"id": null, "n": "0231002", "target": "#nkr_note_mod_0231002", "type": "mod", "text": "（離惑…也）十八字【大】，離智則不著於法離惑則不著於非法【宮】"}
{"id": null, "n": "0231003", "target": "#nkr_note_mod_0231003", "type": "mod", "text": "無所【大】，言實無【宮】"}
{"id": null, "n": "0231004", "target": "#nkr_note_mod_0231004", "type": "mod", "text": "此【大】，此段【宮】"}
{"id": null, "n": "0231005", "target": "#nkr_note_mod_0231005", "type": "mod", "text": "迷【大】，述【宮】"}
{"id": null, "n": "0231006", "target": "#nkr_note_mod_0231006", "type": "mod", "text": "（行嚴…嚴）十五字【大】，梵行莊嚴是無作行稱性莊嚴【宮】"}
{"id": null, "n": "0231007", "target": "#nkr_note_mod_0231007", "type": "mod", "text": "告【大】，囑【宮】"}
{"id": null, "n": "0231008", "target": "#nkr_note_mod_0231008", "type": "mod", "text": "有【大】，是【宮】"}
{"id": null, "n": "0231009", "target": "#nkr_note_mod_0231009", "type": "mod", "text": "（增勝…功）十字【大】，前少後多蓋漸化眾生令起信心故也【宮】"}
{"id": null, "n": "0232001", "target": "#nkr_note_mod_0232001", "type": "mod", "text": "天人固當敬之如佛塔廟況能具足持誦者耶【大】∞成就最上第一希有之法者成無上佛果菩提也【宮】"}
{"id": null, "n": "0232002", "target": "#nkr_note_mod_0232002", "type": "mod", "text": "成就最上第一希有之法者成無上佛果菩提也【大】∞天人固當敬之如佛塔廟況能具足持誦者耶【宮】"}
{"id": null, "n": "0232003", "target": "#nkr_note_mod_0232003", "type": "mod", "text": "若是經典等者【大】，〔－〕【宮】"}
{"id": null, "n": "0232004", "target": "#nkr_note_mod_0232004", "type": "mod", "text": "（即佛…哉）十九字【大】，之處固當敬之如佛現在若尊重弟子者若猶及也言說經弟子亦當重之蓋能續佛慧命故也【宮】"}
{"id": null, "n": "0232005", "target": "#nkr_note_mod_0232005", "type": "mod", "text": "持經成就【大】，是【宮】"}
{"id": null, "n": "0232006", "target": "#nkr_note_mod_0232006", "type": "mod", "text": "法【大】，法則生忻樂【宮】"}
{"id": null, "n": "0232007", "target": "#nkr_note_mod_0232007", "type": "mod", "text": "（此經…持）八字【大】，經名及受持之法【宮】"}
{"id": null, "n": "0232008", "target": "#nkr_note_mod_0232008", "type": "mod", "text": "當【大】，當如是【宮】"}
{"id": null, "n": "0232009", "target": "#nkr_note_mod_0232009", "type": "mod", "text": "也【大】，〔－〕【宮】"}
{"id": null, "n": "0232010", "target": "#nkr_note_mod_0232010", "type": "mod", "text": "斷執【大】，能斷疑執【宮】"}
{"id": null, "n": "0232011", "target": "#nkr_note_mod_0232011", "type": "mod", "text": "誥【大】，詰【宮】"}
{"id": null, "n": "0232012", "target": "#nkr_note_mod_0232012", "type": "mod", "text": "法【大】，〔－〕【宮】"}
{"id": null, "n": "0232013", "target": "#nkr_note_mod_0232013", "type": "mod", "text": "即【大】，節【宮】"}
{"id": null, "n": "0232014", "target": "#nkr_note_mod_0232014", "type": "mod", "text": "非離性則【大】，〔－〕【宮】"}
{"id": null, "n": "0232015", "target": "#nkr_note_mod_0232015", "type": "mod", "text": "有為福報故此【大】，流轉生死【宮】"}
{"id": null, "n": "0232016", "target": "#nkr_note_mod_0232016", "type": "mod", "text": "界【大】，〔－〕【宮】"}
{"id": null, "n": "0232017", "target": "#nkr_note_mod_0232017", "type": "mod", "text": "塵界【大】，微塵【宮】"}
{"id": null, "n": "0232018", "target": "#nkr_note_mod_0232018", "type": "mod", "text": "（是名…者）九字【大】，〔－〕【宮】"}
{"id": null, "n": "0232019", "target": "#nkr_note_mod_0232019", "type": "mod", "text": "法【大】，非法【宮】"}
{"id": null, "n": "0232020", "target": "#nkr_note_mod_0232020", "type": "mod", "text": "（應既…應）八字【大】，有感即應【宮】"}
{"id": null, "n": "0232021", "target": "#nkr_note_mod_0232021", "type": "mod", "text": "（佛身相…持）十字【大】，〔－〕【宮】"}
{"id": null, "n": "0232022", "target": "#nkr_note_mod_0232022", "type": "mod", "text": "之經【大】，經典【宮】"}
{"id": null, "n": "0232023", "target": "#nkr_note_mod_0232023", "type": "mod", "text": "已【大】，以【宮】"}
{"id": null, "n": "0232024", "target": "#nkr_note_mod_0232024", "type": "mod", "text": "若人聞經【大】，蓋由【宮】"}
{"id": null, "n": "0232025", "target": "#nkr_note_mod_0232025", "type": "mod", "text": "直【大】，值【宮】"}
{"id": null, "n": "0232026", "target": "#nkr_note_mod_0232026", "type": "mod", "text": "（即是…也）十字【大】，即我空也言非相者即法空也【宮】"}
{"id": null, "n": "0232027", "target": "#nkr_note_mod_0232027", "type": "mod", "text": "法本無說【大】，猶【宮】"}
{"id": null, "n": "0232028", "target": "#nkr_note_mod_0232028", "type": "mod", "text": "著【大】，著其法本離言說【宮】"}
{"id": null, "n": "0232029", "target": "#nkr_note_mod_0232029", "type": "mod", "text": "上【大】，第七疑中【宮】"}
{"id": null, "n": "0233001", "target": "#nkr_note_mod_0233001", "type": "mod", "text": "也【大】＊，〔－〕【宮】＊"}
{"id": null, "n": "0233002", "target": "#nkr_note_mod_0233002", "type": "mod", "text": "畋【大】，田【宮】"}
{"id": null, "n": "0233003", "target": "#nkr_note_mod_0233003", "type": "mod", "text": "心【大】，〔－〕【宮】"}
{"id": null, "n": "0233004", "target": "#nkr_note_mod_0233004", "type": "mod", "text": "應【大】，當【宮】"}
{"id": null, "n": "0233005", "target": "#nkr_note_mod_0233005", "type": "mod", "text": "能住菩提【大】，即菩提因【宮】"}
{"id": null, "n": "0233006", "target": "#nkr_note_mod_0233006", "type": "mod", "text": "則非住佛道矣【大】，不名菩薩故曰非住【宮】"}
{"id": null, "n": "0233007", "target": "#nkr_note_mod_0233007", "type": "mod", "text": "則非無住下復遣著【大】，又非妙行【宮】"}
{"id": null, "n": "0233008", "target": "#nkr_note_mod_0233008", "type": "mod", "text": "上【大】，第八疑中【宮】"}
{"id": null, "n": "0233009", "target": "#nkr_note_mod_0233009", "type": "mod", "text": "解【大】，古【宮】"}
{"id": null, "n": "0233010", "target": "#nkr_note_mod_0233010", "type": "mod", "text": "真如【大】，如徧【宮】"}
{"id": null, "n": "0233011", "target": "#nkr_note_mod_0233011", "type": "mod", "text": "從前不住相【大】，遠從第三疑中一切賢聖皆以無為法得名【宮】"}
{"id": null, "n": "0233012", "target": "#nkr_note_mod_0233012", "type": "mod", "text": "通指衍門三教之人也【大】，元住大乘之人也【宮】"}
{"id": null, "n": "0233013", "target": "#nkr_note_mod_0233013", "type": "mod", "text": "（的指…也）十二字【大】，初聞最妙大乘而能信解之人也【宮】"}
{"id": null, "n": "0234001", "target": "#nkr_note_mod_0234001", "type": "mod", "text": "但被輕賤【大】，轉重為輕【宮】"}
{"id": null, "n": "0234002", "target": "#nkr_note_mod_0234002", "type": "mod", "text": "蓋【大】，何然【宮】"}
{"id": null, "n": "0234003", "target": "#nkr_note_mod_0234003", "type": "mod", "text": "故【大】，較以【宮】"}
{"id": null, "n": "0234004", "target": "#nkr_note_mod_0234004", "type": "mod", "text": "也【大】，者以此【宮】"}
{"id": null, "n": "0234005", "target": "#nkr_note_mod_0234005", "type": "mod", "text": "聞【大】，問【宮】"}
{"id": null, "n": "0234006", "target": "#nkr_note_mod_0234006", "type": "mod", "text": "上【大】，第十一疑中【宮】"}
{"id": null, "n": "0234007", "target": "#nkr_note_mod_0234007", "type": "mod", "text": "（上釋…來）十四字【大】，第十二疑中來【宮】"}
{"id": null, "n": "0234008", "target": "#nkr_note_mod_0234008", "type": "mod", "text": "實【大】，寔【宮】"}
{"id": null, "n": "0235001", "target": "#nkr_note_mod_0235001", "type": "mod", "text": "修行嚴土【大】，修習梵行淨佛國土【宮】"}
{"id": null, "n": "0235002", "target": "#nkr_note_mod_0235002", "type": "mod", "text": "者【大】，〔－〕【宮】"}
{"id": null, "n": "0235003", "target": "#nkr_note_mod_0235003", "type": "mod", "text": "故云【大】，〔－〕【宮】"}
{"id": null, "n": "0235004", "target": "#nkr_note_mod_0235004", "type": "mod", "text": "（上菩…來）十五字【大】，第十四疑中來【宮】"}
{"id": null, "n": "0235005", "target": "#nkr_note_mod_0235005", "type": "mod", "text": "惟【大】，唯【宮】"}
{"id": null, "n": "0235006", "target": "#nkr_note_mod_0235006", "type": "mod", "text": "下【大】，者【宮】"}
{"id": null, "n": "0235007", "target": "#nkr_note_mod_0235007", "type": "mod", "text": "釋【大】，起【宮】"}
{"id": null, "n": "0235008", "target": "#nkr_note_mod_0235008", "type": "mod", "text": "也【大】，而釋之【宮】"}
{"id": null, "n": "0235009", "target": "#nkr_note_mod_0235009", "type": "mod", "text": "蓋三世之心【大】，三世心者虛妄生滅心也求之皆不可得蓋【宮】"}
{"id": null, "n": "0235010", "target": "#nkr_note_mod_0235010", "type": "mod", "text": "上心住顛倒而來【大】，第十五疑中來【宮】"}
{"id": null, "n": "0235011", "target": "#nkr_note_mod_0235011", "type": "mod", "text": "實【大】，寔【宮】"}
{"id": null, "n": "0235012", "target": "#nkr_note_mod_0235012", "type": "mod", "text": "（前如…來）十一字【大】，第三疑中無為得名而來【宮】"}
{"id": null, "n": "0235013", "target": "#nkr_note_mod_0235013", "type": "mod", "text": "上身相不可得見而來【大】，第十疑中即非身相而來【宮】"}
{"id": null, "n": "0236001", "target": "#nkr_note_mod_0236001", "type": "mod", "text": "於未來世【大】，〔－〕【宮】"}
{"id": null, "n": "0236002", "target": "#nkr_note_mod_0236002", "type": "mod", "text": "下文又徵釋之【大】，又自釋云【宮】"}
{"id": null, "n": "0236003", "target": "#nkr_note_mod_0236003", "type": "mod", "text": "（牒上…也）十一字【大】，言凡夫眾生也【宮】"}
{"id": null, "n": "0236004", "target": "#nkr_note_mod_0236004", "type": "mod", "text": "無法得阿耨菩提而【大】，〔－〕【宮】"}
{"id": null, "n": "0236005", "target": "#nkr_note_mod_0236005", "type": "mod", "text": "為正覺【大】，〔－〕【宮】"}
{"id": null, "n": "0236006", "target": "#nkr_note_mod_0236006", "type": "mod", "text": "三【大】，無【宮】"}
{"id": null, "n": "0236007", "target": "#nkr_note_mod_0236007", "type": "mod", "text": "上【大】，第十九疑中【宮】"}
{"id": null, "n": "0236008", "target": "#nkr_note_mod_0236008", "type": "mod", "text": "是無記法【大】，〔－〕【宮】"}
{"id": null, "n": "0236009", "target": "#nkr_note_mod_0236009", "type": "mod", "text": "耶【大】，耶蓋所說之法是無記故【宮】"}
{"id": null, "n": "0236010", "target": "#nkr_note_mod_0236010", "type": "mod", "text": "一【大】，一言無記者謂【宮】"}
{"id": null, "n": "0236011", "target": "#nkr_note_mod_0236011", "type": "mod", "text": "蓋佛【大】，〔－〕【宮】"}
{"id": null, "n": "0236012", "target": "#nkr_note_mod_0236012", "type": "mod", "text": "相【大】，相也【宮】"}
{"id": null, "n": "0236013", "target": "#nkr_note_mod_0236013", "type": "mod", "text": "而【大】，若【宮】"}
{"id": null, "n": "0237001", "target": "#nkr_note_mod_0237001", "type": "mod", "text": "上不應以相觀佛而來【大】，第二十二疑中來【宮】"}
{"id": null, "n": "0237002", "target": "#nkr_note_mod_0237002", "type": "mod", "text": "上【大】，二十二疑中【宮】"}
{"id": null, "n": "0237003", "target": "#nkr_note_mod_0237003", "type": "mod", "text": "謂【大】，良【宮】"}
{"id": null, "n": "0237004", "target": "#nkr_note_mod_0237004", "type": "mod", "text": "（應用…也）十六字【大】，法身如如不動所有動作乃應身耳【宮】"}
{"id": null, "n": "0237005", "target": "#nkr_note_mod_0237005", "type": "mod", "text": "（上應…去來）九字【大】，二十四二十三二十二疑中【宮】"}
{"id": null, "n": "0237006", "target": "#nkr_note_mod_0237006", "type": "mod", "text": "矣【大】，由煩惱淨盡故也【宮】"}
{"id": null, "n": "0237007", "target": "#nkr_note_mod_0237007", "type": "mod", "text": "（微塵…塵）八字【大】，全微塵即是世界則界之與塵皆【宮】"}
{"id": null, "n": "0237008", "target": "#nkr_note_mod_0237008", "type": "mod", "text": "則【大】，即【宮】"}
{"id": null, "n": "0237009", "target": "#nkr_note_mod_0237009", "type": "mod", "text": "（以離…法）二十五字【大】，是名微塵得此喻意則應身是全法之應【宮】"}
{"id": null, "n": "0237010", "target": "#nkr_note_mod_0237010", "type": "mod", "text": "（若知合…性）二十字【大】，前以世界是一喻法身是一世界若定是一世尊何故說三千大千世界是則世界實性了不何得【宮】"}
{"id": null, "n": "0237011", "target": "#nkr_note_mod_0237011", "type": "mod", "text": "（以離…曰）十字【大】，〔－〕【宮】"}
{"id": null, "n": "0237012", "target": "#nkr_note_mod_0237012", "type": "mod", "text": "也【大】，〔－〕【宮】"}
{"id": null, "n": "0237013", "target": "#nkr_note_mod_0237013", "type": "mod", "text": "一【大】，言一【宮】"}
{"id": null, "n": "0237014", "target": "#nkr_note_mod_0237014", "type": "mod", "text": "言【大】，乃【宮】"}
{"id": null, "n": "0237015", "target": "#nkr_note_mod_0237015", "type": "mod", "text": "非【大】，言非【宮】"}
{"id": null, "n": "0237016", "target": "#nkr_note_mod_0237016", "type": "mod", "text": "（是名…也）十三字【大】，乃離性之一合故云是名一合相【宮】"}
{"id": null, "n": "0237017", "target": "#nkr_note_mod_0237017", "type": "mod", "text": "此喻全【大】，良以即【宮】"}
{"id": null, "n": "0237018", "target": "#nkr_note_mod_0237018", "type": "mod", "text": "不離應【大】，尚叵得【宮】"}
{"id": null, "n": "0237019", "target": "#nkr_note_mod_0237019", "type": "mod", "text": "下【大】，〔－〕【宮】"}
{"id": null, "n": "0238001", "target": "#nkr_note_mod_0238001", "type": "mod", "text": "說【大】，說當知法受乃告善現【宮】"}
{"id": null, "n": "0238002", "target": "#nkr_note_mod_0238002", "type": "mod", "text": "心【大】，〔－〕【宮】"}
{"id": null, "n": "0238003", "target": "#nkr_note_mod_0238003", "type": "mod", "text": "妄【大】，要【宮】"}
{"id": null, "n": "0238004", "target": "#nkr_note_mod_0238004", "type": "mod", "text": "上塵喻化身是異而來【大】，二十五疑中來【宮】"}
{"id": null, "n": "0238005", "target": "#nkr_note_mod_0238005", "type": "mod", "text": "格量【大】，〔－〕【宮】"}
{"id": null, "n": "0238006", "target": "#nkr_note_mod_0238006", "type": "mod", "text": "下【大】，以下【宮】"}
{"id": null, "n": "0238007", "target": "#nkr_note_mod_0238007", "type": "mod", "text": "故功德無量【大】，以【宮】"}
{"id": null, "n": "0238008", "target": "#nkr_note_mod_0238008", "type": "mod", "text": "則【大】，〔－〕【宮】"}
{"id": null, "n": "0238009", "target": "#nkr_note_mod_0238009", "type": "mod", "text": "之【大】，〔－〕【宮】"}
{"id": null, "n": "0238010", "target": "#nkr_note_mod_0238010", "type": "mod", "text": "故【大】，故云如如【宮】"}
{"id": null, "n": "0238011", "target": "#nkr_note_mod_0238011", "type": "mod", "text": "上【大】，第二十六疑中【宮】"}
{"id": null, "n": "0238012", "target": "#nkr_note_mod_0238012", "type": "mod", "text": "法【大】，旨【宮】"}
{"id": null, "n": "0238013", "target": "#nkr_note_mod_0238013", "type": "mod", "text": "實【大】，寔【宮】"}
{"id": null, "n": "0238014", "target": "#nkr_note_mod_0238014", "type": "mod", "text": "行【大】，行此流通分也流通者流通般若使之不壅利益後世眾生也天親偈云佛說希有總持法不可稱量深句義從尊者聞及廣說同此福德施群生【宮】"}
{"id": null, "n": null, "target": null, "type": null, "text": "此流通分也流通者流通般若使之不壅利益後世眾生也天親偈云佛說希有總持法不可稱量深句義從尊者聞及廣說同此福德施群生"}
{"id": null, "n": "0238016", "target": "#nkr_note_mod_0238016", "type": "mod", "text": "日＋（天界善世禪寺住持臣僧宗泐註演福天台教寺前住持臣僧如󰃗同註天界善世禪寺說經臣僧祖杲等校正天界善世禪寺副住持臣僧宗冐天竺靈山教寺住持臣僧弘道臥佛賢首教寺住持臣僧淨行雙林禪寺住持臣僧致凱白蓮天台教寺住持臣僧允中能仁禪寺住持臣僧本淨天童禪寺住持臣僧智昌金山禪寺住持臣僧慧明道場禪寺住持臣僧慕䏈廣教寺前住持臣僧大章崇壽教寺前住持臣僧是乘江心禪寺住持臣僧子勤延慶教寺住持臣僧原旻天寧禪寺住持臣僧智猷康曆二年庚申八月日重刊于臨川寺）二百九字【宮】"}
{"id": null, "n": "0228001", "target": "#nkr_note_orig_0228001", "type": "orig", "text": "【原】增上寺藏明本，【宮】康曆二年刊宮內省圖書寮藏本"}
{"id": null, "n": "0228002", "target": "#nkr_note_orig_0228002", "type": "orig", "text": "〔大明…註〕二十八字－【宮】"}
{"id": null, "n": "0228003", "target": "#nkr_note_orig_0228003", "type": "orig", "text": "尤＝元【宮】"}
{"id": null, "n": "0228004", "target": "#nkr_note_orig_0228004", "type": "orig", "text": "故＝今【宮】"}
{"id": null, "n": "0228005", "target": "#nkr_note_orig_0228005", "type": "orig", "text": "（慈氏）＋天【宮】"}
{"id": null, "n": "0228006", "target": "#nkr_note_orig_0228006", "type": "orig", "text": "等＝偈【宮】"}
{"id": null, "n": "0228007", "target": "#nkr_note_orig_0228007", "type": "orig", "text": "結＝給【宮】＊"}
{"id": null, "n": "0228008", "target": "#nkr_note_orig_0228008", "type": "orig", "text": "身＋（又折己幔幢生彼福德）九字【宮】"}
{"id": null, "n": "0228009", "target": "#nkr_note_orig_0228009", "type": "orig", "text": "序＝敘【宮】＊"}
{"id": null, "n": "0228010", "target": "#nkr_note_orig_0228010", "type": "orig", "text": "〔欲令…德〕十字－【宮】"}
{"id": null, "n": "0228011", "target": "#nkr_note_orig_0228011", "type": "orig", "text": "者＋（天竺跣足而食故）【宮】"}
{"id": null, "n": "0228012", "target": "#nkr_note_orig_0228012", "type": "orig", "text": "加＝跏【宮】"}
{"id": null, "n": "0229001", "target": "#nkr_note_orig_0229001", "type": "orig", "text": "雙＝濩【宮】"}
{"id": null, "n": "0229002", "target": "#nkr_note_orig_0229002", "type": "orig", "text": "萬＝梵【宮】"}
{"id": null, "n": "0229003", "target": "#nkr_note_orig_0229003", "type": "orig", "text": "〔無住…佛〕八字－【宮】"}
{"id": null, "n": "0230001", "target": "#nkr_note_orig_0230001", "type": "orig", "text": "此＋（乃）【宮】"}
{"id": null, "n": "0230002", "target": "#nkr_note_orig_0230002", "type": "orig", "text": "（（該乎…耳））九十九字＝（（若有四相生信不深得法不廣其福德無量者為無此四相也無法相者相執報空也亦無非法者性執空也））四十一字【宮】"}
{"id": null, "n": "0230003", "target": "#nkr_note_orig_0230003", "type": "orig", "text": "則＝即【宮】"}
{"id": null, "n": "0230004", "target": "#nkr_note_orig_0230004", "type": "orig", "text": "此＋（一節是）【宮】"}
{"id": null, "n": "0230005", "target": "#nkr_note_orig_0230005", "type": "orig", "text": "〔若心…也〕十八字－【宮】"}
{"id": null, "n": "0230006", "target": "#nkr_note_orig_0230006", "type": "orig", "text": "（（此結…矣））百八十三字＝（（我人眾生壽者四相該乎生法二執生即眾生假名也法乃五陰實法也亦名我我所此二執中各有性相二執此二執非性相二空妙觀不能破也故龍樹云於生於法破性破相謂於假名中破性相二執於實法中亦破性相二執也不應取法者忘能觀之智也不應取非法忘所觀之境也所觀如病觀智如藥境智俱泯如病去藥忘也言如筏喻者筏乃渡河之具到彼岸則不用之借喻法尚應捨何況非法））百五十八字【宮】"}
{"id": null, "n": "0230007", "target": "#nkr_note_orig_0230007", "type": "orig", "text": "（乃發）＋問【宮】"}
{"id": null, "n": "0230008", "target": "#nkr_note_orig_0230008", "type": "orig", "text": "（（佛又…而））十二字＝（（然世間布施福報乃有漏因果））十二字【宮】"}
{"id": null, "n": "0230009", "target": "#nkr_note_orig_0230009", "type": "orig", "text": "（所以）＋其【宮】"}
{"id": null, "n": "0230010", "target": "#nkr_note_orig_0230010", "type": "orig", "text": "然持經福勝者＝其故何哉【宮】"}
{"id": null, "n": "0230011", "target": "#nkr_note_orig_0230011", "type": "orig", "text": "上無為法＝第三疑中【宮】"}
{"id": null, "n": "0231001", "target": "#nkr_note_orig_0231001", "type": "orig", "text": "（（無無…證））十二字＝（（不著於無學果位若著於此））十一字【宮】"}
{"id": null, "n": "0231002", "target": "#nkr_note_orig_0231002", "type": "orig", "text": "（（離惑…也））十八字＝（（離智則不著於法離惑則不著於非法））十五字【宮】"}
{"id": null, "n": "0231003", "target": "#nkr_note_orig_0231003", "type": "orig", "text": "無所＝言實無【宮】"}
{"id": null, "n": "0231004", "target": "#nkr_note_orig_0231004", "type": "orig", "text": "此＋（段）【宮】"}
{"id": null, "n": "0231005", "target": "#nkr_note_orig_0231005", "type": "orig", "text": "迷＝述【宮】"}
{"id": null, "n": "0231006", "target": "#nkr_note_orig_0231006", "type": "orig", "text": "（（行嚴…嚴））十五字＝（（梵行莊嚴是無作行稱性莊嚴））十二字【宮】"}
{"id": null, "n": "0231007", "target": "#nkr_note_orig_0231007", "type": "orig", "text": "告＝囑【宮】"}
{"id": null, "n": "0231008", "target": "#nkr_note_orig_0231008", "type": "orig", "text": "有＝是【宮】"}
{"id": null, "n": "0231009", "target": "#nkr_note_orig_0231009", "type": "orig", "text": "（（增勝…功））十字＝（（前少後多蓋漸化眾生令起信心故也））十五字【宮】"}
{"id": null, "n": "0232001", "target": "#nkr_note_orig_0232001", "type": "orig", "text": "（天人…耶）十八字∞（成就…也）十九字【宮】"}
{"id": null, "n": "0232002", "target": "#nkr_note_orig_0232002", "type": "orig", "text": "（天人…耶）十八字∞（成就…也）十九字【宮】"}
{"id": null, "n": "0232003", "target": "#nkr_note_orig_0232003", "type": "orig", "text": "〔若是經典等者〕－【宮】"}
{"id": null, "n": "0232004", "target": "#nkr_note_orig_0232004", "type": "orig", "text": "（（即佛…哉））十九字＝（（之處固當敬之如佛現在若尊重弟子者若猶及也言說經弟子亦當重之蓋能續佛慧命故也））三十七字【宮】"}
{"id": null, "n": "0232005", "target": "#nkr_note_orig_0232005", "type": "orig", "text": "持經成就＝是【宮】"}
{"id": null, "n": "0232006", "target": "#nkr_note_orig_0232006", "type": "orig", "text": "法＋（則生忻樂）【宮】"}
{"id": null, "n": "0232007", "target": "#nkr_note_orig_0232007", "type": "orig", "text": "（（此經…持））八字＝（（經名及受持之法））七字【宮】"}
{"id": null, "n": "0232008", "target": "#nkr_note_orig_0232008", "type": "orig", "text": "當＋（如是）【宮】"}
{"id": null, "n": "0232009", "target": "#nkr_note_orig_0232009", "type": "orig", "text": "〔也〕－【宮】"}
{"id": null, "n": "0232010", "target": "#nkr_note_orig_0232010", "type": "orig", "text": "斷執＝能斷疑執【宮】"}
{"id": null, "n": "0232011", "target": "#nkr_note_orig_0232011", "type": "orig", "text": "誥＝詰【宮】"}
{"id": null, "n": "0232012", "target": "#nkr_note_orig_0232012", "type": "orig", "text": "〔法〕－【宮】"}
{"id": null, "n": "0232013", "target": "#nkr_note_orig_0232013", "type": "orig", "text": "即＝節【宮】"}
{"id": null, "n": "0232014", "target": "#nkr_note_orig_0232014", "type": "orig", "text": "〔非離性則〕－【宮】"}
{"id": null, "n": "0232015", "target": "#nkr_note_orig_0232015", "type": "orig", "text": "有為福報故此＝流轉生死【宮】"}
{"id": null, "n": "0232016", "target": "#nkr_note_orig_0232016", "type": "orig", "text": "〔界〕－【宮】"}
{"id": null, "n": "0232017", "target": "#nkr_note_orig_0232017", "type": "orig", "text": "塵界＝微塵【宮】"}
{"id": null, "n": "0232018", "target": "#nkr_note_orig_0232018", "type": "orig", "text": "〔是名…者〕九字－【宮】"}
{"id": null, "n": "0232019", "target": "#nkr_note_orig_0232019", "type": "orig", "text": "（非）＋法【宮】"}
{"id": null, "n": "0232020", "target": "#nkr_note_orig_0232020", "type": "orig", "text": "（（應既…應））八字＝（（有感即應））四字【宮】"}
{"id": null, "n": "0232021", "target": "#nkr_note_orig_0232021", "type": "orig", "text": "〔佛身相…持〕十字－【宮】"}
{"id": null, "n": "0232022", "target": "#nkr_note_orig_0232022", "type": "orig", "text": "之經＝經典【宮】"}
{"id": null, "n": "0232023", "target": "#nkr_note_orig_0232023", "type": "orig", "text": "已＝以【宮】"}
{"id": null, "n": "0232024", "target": "#nkr_note_orig_0232024", "type": "orig", "text": "若人聞經＝蓋由【宮】"}
{"id": null, "n": "0232025", "target": "#nkr_note_orig_0232025", "type": "orig", "text": "直＝值【宮】"}
{"id": null, "n": "0232026", "target": "#nkr_note_orig_0232026", "type": "orig", "text": "（（即是…也））十字＝（（即我空也言非相者即法空也））十二字【宮】"}
{"id": null, "n": "0232027", "target": "#nkr_note_orig_0232027", "type": "orig", "text": "法本無說＝猶【宮】"}
{"id": null, "n": "0232028", "target": "#nkr_note_orig_0232028", "type": "orig", "text": "著＋（其法本離言說）【宮】"}
{"id": null, "n": "0232029", "target": "#nkr_note_orig_0232029", "type": "orig", "text": "上＝第七疑中【宮】"}
{"id": null, "n": "0233001", "target": "#nkr_note_orig_0233001", "type": "orig", "text": "〔也〕－【宮】＊"}
{"id": null, "n": "0233002", "target": "#nkr_note_orig_0233002", "type": "orig", "text": "畋＝田【宮】"}
{"id": null, "n": "0233003", "target": "#nkr_note_orig_0233003", "type": "orig", "text": "〔心〕－【宮】"}
{"id": null, "n": "0233004", "target": "#nkr_note_orig_0233004", "type": "orig", "text": "應＝當【宮】"}
{"id": null, "n": "0233005", "target": "#nkr_note_orig_0233005", "type": "orig", "text": "能住菩提＝即菩提因【宮】"}
{"id": null, "n": "0233006", "target": "#nkr_note_orig_0233006", "type": "orig", "text": "則非住佛道矣＝不名菩薩故曰非住【宮】"}
{"id": null, "n": "0233007", "target": "#nkr_note_orig_0233007", "type": "orig", "text": "則非無住下復遣著＝又非妙行【宮】"}
{"id": null, "n": "0233008", "target": "#nkr_note_orig_0233008", "type": "orig", "text": "上＝第八疑中【宮】"}
{"id": null, "n": "0233009", "target": "#nkr_note_orig_0233009", "type": "orig", "text": "解＝古【宮】"}
{"id": null, "n": "0233010", "target": "#nkr_note_orig_0233010", "type": "orig", "text": "真如＝如徧【宮】"}
{"id": null, "n": "0233011", "target": "#nkr_note_orig_0233011", "type": "orig", "text": "從前不住相＝遠從第三疑中一切賢聖皆以無為法得名【宮】"}
{"id": null, "n": "0233012", "target": "#nkr_note_orig_0233012", "type": "orig", "text": "通指衍門三教之人也＝元住大乘之人也【宮】"}
{"id": null, "n": "0233013", "target": "#nkr_note_orig_0233013", "type": "orig", "text": "（（的指…也））十二字＝（（初聞最妙大乘而能信解之人也））十三字【宮】"}
{"id": null, "n": "0234001", "target": "#nkr_note_orig_0234001", "type": "orig", "text": "但被輕賤＝轉重為輕【宮】"}
{"id": null, "n": "0234002", "target": "#nkr_note_orig_0234002", "type": "orig", "text": "蓋＝何然【宮】"}
{"id": null, "n": "0234003", "target": "#nkr_note_orig_0234003", "type": "orig", "text": "故＝較以【宮】"}
{"id": null, "n": "0234004", "target": "#nkr_note_orig_0234004", "type": "orig", "text": "也＝者以此【宮】"}
{"id": null, "n": "0234005", "target": "#nkr_note_orig_0234005", "type": "orig", "text": "聞＝問【宮】"}
{"id": null, "n": "0234006", "target": "#nkr_note_orig_0234006", "type": "orig", "text": "上＝第十一疑中【宮】"}
{"id": null, "n": "0234007", "target": "#nkr_note_orig_0234007", "type": "orig", "text": "（（上釋…來））十四字＝（（第十二疑中來））六字【宮】"}
{"id": null, "n": "0234008", "target": "#nkr_note_orig_0234008", "type": "orig", "text": "實＝寔【宮】"}
{"id": null, "n": "0235001", "target": "#nkr_note_orig_0235001", "type": "orig", "text": "修行嚴土＝修習梵行淨佛國土【宮】"}
{"id": null, "n": "0235002", "target": "#nkr_note_orig_0235002", "type": "orig", "text": "〔者〕－【宮】"}
{"id": null, "n": "0235003", "target": "#nkr_note_orig_0235003", "type": "orig", "text": "〔故云〕－【宮】"}
{"id": null, "n": "0235004", "target": "#nkr_note_orig_0235004", "type": "orig", "text": "（（上菩…來））十五字＝（（第十四疑中來））六字【宮】"}
{"id": null, "n": "0235005", "target": "#nkr_note_orig_0235005", "type": "orig", "text": "惟＝唯【宮】"}
{"id": null, "n": "0235006", "target": "#nkr_note_orig_0235006", "type": "orig", "text": "下＝者【宮】"}
{"id": null, "n": "0235007", "target": "#nkr_note_orig_0235007", "type": "orig", "text": "釋＝起【宮】"}
{"id": null, "n": "0235008", "target": "#nkr_note_orig_0235008", "type": "orig", "text": "也＝而釋之【宮】"}
{"id": null, "n": "0235009", "target": "#nkr_note_orig_0235009", "type": "orig", "text": "（（蓋三世之心））五字＝（（三世心者虛妄生滅心也求之皆不可得蓋））十七字【宮】"}
{"id": null, "n": "0235010", "target": "#nkr_note_orig_0235010", "type": "orig", "text": "上心住顛倒而來＝第十五疑中來【宮】"}
{"id": null, "n": "0235011", "target": "#nkr_note_orig_0235011", "type": "orig", "text": "實＝寔【宮】"}
{"id": null, "n": "0235012", "target": "#nkr_note_orig_0235012", "type": "orig", "text": "（（前如…來））十一字＝（（第三疑中無為得名而來））十字【宮】"}
{"id": null, "n": "0235013", "target": "#nkr_note_orig_0235013", "type": "orig", "text": "上身相不可得見而來＝第十疑中即非身相而來【宮】"}
{"id": null, "n": "0236001", "target": "#nkr_note_orig_0236001", "type": "orig", "text": "〔於未來世〕－【宮】"}
{"id": null, "n": "0236002", "target": "#nkr_note_orig_0236002", "type": "orig", "text": "下文又徵釋之＝又自釋云【宮】"}
{"id": null, "n": "0236003", "target": "#nkr_note_orig_0236003", "type": "orig", "text": "（（牒上…也））十一字＝（（言凡夫眾生也））六字【宮】"}
{"id": null, "n": "0236004", "target": "#nkr_note_orig_0236004", "type": "orig", "text": "〔無法得阿耨菩提而〕－【宮】"}
{"id": null, "n": "0236005", "target": "#nkr_note_orig_0236005", "type": "orig", "text": "〔為正覺〕－【宮】"}
{"id": null, "n": "0236006", "target": "#nkr_note_orig_0236006", "type": "orig", "text": "三＝無【宮】"}
{"id": null, "n": "0236007", "target": "#nkr_note_orig_0236007", "type": "orig", "text": "上＝第十九疑中【宮】"}
{"id": null, "n": "0236008", "target": "#nkr_note_orig_0236008", "type": "orig", "text": "〔是無記法〕－【宮】"}
{"id": null, "n": "0236009", "target": "#nkr_note_orig_0236009", "type": "orig", "text": "耶＋（蓋所說之法是無記故）【宮】"}
{"id": null, "n": "0236010", "target": "#nkr_note_orig_0236010", "type": "orig", "text": "一＋（言無記者謂）【宮】"}
{"id": null, "n": "0236011", "target": "#nkr_note_orig_0236011", "type": "orig", "text": "〔蓋佛〕－【宮】"}
{"id": null, "n": "0236012", "target": "#nkr_note_orig_0236012", "type": "orig", "text": "相＋（也）【宮】"}
{"id": null, "n": "0236013", "target": "#nkr_note_orig_0236013", "type": "orig", "text": "而＝若【宮】"}
{"id": null, "n": "0237001", "target": "#nkr_note_orig_0237001", "type": "orig", "text": "上不應以相觀佛而來＝第二十二疑中來【宮】"}
{"id": null, "n": "0237002", "target": "#nkr_note_orig_0237002", "type": "orig", "text": "上＝二十二疑中【宮】"}
{"id": null, "n": "0237003", "target": "#nkr_note_orig_0237003", "type": "orig", "text": "謂＝良【宮】"}
{"id": null, "n": "0237004", "target": "#nkr_note_orig_0237004", "type": "orig", "text": "（（應用…也））十六字＝（（法身如如不動所有動作乃應身耳））十四字【宮】"}
{"id": null, "n": "0237005", "target": "#nkr_note_orig_0237005", "type": "orig", "text": "（（上應…去來））九字＝（（二十四二十三二十二疑中））十一字【宮】"}
{"id": null, "n": "0237006", "target": "#nkr_note_orig_0237006", "type": "orig", "text": "矣＝由煩惱淨盡故也【宮】"}
{"id": null, "n": "0237007", "target": "#nkr_note_orig_0237007", "type": "orig", "text": "（（微塵…塵））八字＝（（全微塵即是世界則界之與塵皆））十三字【宮】"}
{"id": null, "n": "0237008", "target": "#nkr_note_orig_0237008", "type": "orig", "text": "則＝即【宮】"}
{"id": null, "n": "0237009", "target": "#nkr_note_orig_0237009", "type": "orig", "text": "（（以離…法））二十五字＝（（是名微塵得此喻意則應身是全法之應））十六字【宮】"}
{"id": null, "n": "0237010", "target": "#nkr_note_orig_0237010", "type": "orig", "text": "（（若知合…性））二十字＝（（前以世界是一喻法身是一世界若定是一世尊何故說三千大千世界是則世界實性了不何得））三十八字【宮】"}
{"id": null, "n": "0237011", "target": "#nkr_note_orig_0237011", "type": "orig", "text": "〔以離…曰〕十字－【宮】"}
{"id": null, "n": "0237012", "target": "#nkr_note_orig_0237012", "type": "orig", "text": "〔也〕－【宮】"}
{"id": null, "n": "0237013", "target": "#nkr_note_orig_0237013", "type": "orig", "text": "（言）＋一【宮】"}
{"id": null, "n": "0237014", "target": "#nkr_note_orig_0237014", "type": "orig", "text": "言＝乃【宮】"}
{"id": null, "n": "0237015", "target": "#nkr_note_orig_0237015", "type": "orig", "text": "（言）＋非【宮】"}
{"id": null, "n": "0237016", "target": "#nkr_note_orig_0237016", "type": "orig", "text": "（（是名…也））十三字＝（（乃離性之一合故云是名一合相））十三字【宮】"}
{"id": null, "n": "0237017", "target": "#nkr_note_orig_0237017", "type": "orig", "text": "此喻全＝良以即【宮】"}
{"id": null, "n": "0237018", "target": "#nkr_note_orig_0237018", "type": "orig", "text": "不離應＝尚叵得【宮】"}
{"id": null, "n": "0237019", "target": "#nkr_note_orig_0237019", "type": "orig", "text": "〔下〕－【宮】"}
{"id": null, "n": "0238001", "target": "#nkr_note_orig_0238001", "type": "orig", "text": "說＋（當知法受乃告善現）【宮】"}
{"id": null, "n": "0238002", "target": "#nkr_note_orig_0238002", "type": "orig", "text": "〔心〕－【宮】"}
{"id": null, "n": "0238003", "target": "#nkr_note_orig_0238003", "type": "orig", "text": "妄＝要【宮】"}
{"id": null, "n": "0238004", "target": "#nkr_note_orig_0238004", "type": "orig", "text": "上塵喻化身是異而來＝二十五疑中來【宮】"}
{"id": null, "n": "0238005", "target": "#nkr_note_orig_0238005", "type": "orig", "text": "〔格量〕－【宮】"}
{"id": null, "n": "0238006", "target": "#nkr_note_orig_0238006", "type": "orig", "text": "（以）＋下【宮】"}
{"id": null, "n": "0238007", "target": "#nkr_note_orig_0238007", "type": "orig", "text": "故功德無量＝以【宮】"}
{"id": null, "n": "0238008", "target": "#nkr_note_orig_0238008", "type": "orig", "text": "〔則〕－【宮】"}
{"id": null, "n": "0238009", "target": "#nkr_note_orig_0238009", "type": "orig", "text": "〔之〕－【宮】"}
{"id": null, "n": "0238010", "target": "#nkr_note_orig_0238010", "type": "orig", "text": "故＋（云如如）【宮】"}
{"id": null, "n": "0238011", "target": "#nkr_note_orig_0238011", "type": "orig", "text": "上＝第二十六疑中【宮】"}
{"id": null, "n": "0238012", "target": "#nkr_note_orig_0238012", "type": "orig", "text": "法＝旨【宮】"}
{"id": null, "n": "0238013", "target": "#nkr_note_orig_0238013", "type": "orig", "text": "實＝寔【宮】"}
{"id": null, "n": "0238014", "target": "#nkr_note_orig_0238014", "type": "orig", "text": "行＋（此流通分也流通者流通般若使之不壅利益後世眾生也天親偈云佛說希有總持法不可稱量深句義從尊者聞及廣說同此福德施群生）註五十五字【宮】"}
{"id": null, "n": "0238015", "target": "#nkr_note_orig_0238015", "type": "orig", "text": "皇帝乃至金剛楞十六字宮本空白"}
{"id": null, "n": "0238016", "target": "#nkr_note_orig_0238016", "type": "orig", "text": "日＋（天界善世禪寺住持臣僧宗泐註演福天台教寺前住持臣僧如󰃗同註天界善世禪寺說經臣僧祖杲等校正天界善世禪寺副住持臣僧宗冐天竺靈山教寺住持臣僧弘道臥佛賢首教寺住持臣僧淨行雙林禪寺住持臣僧致凱白蓮天台教寺住持臣僧允中能仁禪寺住持臣僧本淨天童禪寺住持臣僧智昌金山禪寺住持臣僧慧明道場禪寺住持臣僧慕䏈廣教寺前住持臣僧大章崇壽教寺前住持臣僧是乘江心禪寺住持臣僧子勤延慶教寺住持臣僧原旻天寧禪寺住持臣僧智猷康曆二年庚申八月日重刊于臨川寺）二百九字【宮】"}
{"id": null, "n": "0228a1101", "target": "#nkr_note_add_0228a1101", "type": "add", "text": "玘【CB】，󰃗【大】"}
{"id": null, "n": "0228b0601", "target": "#nkr_note_add_0228b0601", "type": "add", "text": "給【CB】，結【大】"}
{"id": null, "n": "0230c1501", "target": "#nkr_note_add_0230c1501", "type": "add", "text": "人【CB】，入【大】"}
{"id": null, "n": "0236b2501", "target": "#nkr_note_add_0236b2501", "type": "add", "text": "離【CB】，難【大】"}
