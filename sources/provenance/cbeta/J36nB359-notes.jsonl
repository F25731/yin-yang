{"id": null, "n": null, "target": null, "type": null, "text": "四卷六十四葉"}
{"id": null, "n": null, "target": null, "type": null, "text": "安樂院智安，備資敬刻\n　　百老和尚語錄第一卷。"}
{"id": null, "n": null, "target": null, "type": null, "text": "德賢法孫恭，備資敬刻\n　　百老和尚語錄第二卷。"}
{"id": null, "n": null, "target": null, "type": null, "text": "清淨菴德隆，備資敬刻\n　　百老和尚語錄第三卷。"}
{"id": null, "n": null, "target": null, "type": null, "text": "無塵貞道人，捐資敬刻\n　　百老和尚語錄第四卷。"}
{"id": null, "n": null, "target": null, "type": null, "text": "無相修道人，備資敬刻\n　　百老和尚語錄第五卷。"}
{"id": null, "n": null, "target": null, "type": null, "text": "圓通菴德龍、德雲，備資敬刻\n　　百老和尚語錄第六卷。"}
{"id": null, "n": null, "target": null, "type": null, "text": "德　照禪、德輝、張燈榮，備資敬刻\n　　百老和尚語錄第七卷。"}
{"id": null, "n": null, "target": null, "type": null, "text": "栴檀菴德孫，備資敬刻\n　　百老和尚語錄第八卷。"}
{"id": null, "n": null, "target": null, "type": null, "text": "問津菴德超，備資敬刻\n　　百老和尚語錄第九卷。"}
{"id": null, "n": null, "target": null, "type": null, "text": "大悲菴德曇，備資敬刻\n　　百老和尚語錄第十卷。"}
{"id": null, "n": null, "target": null, "type": null, "text": "茹珍、德坤、儀鳳、孫氏、陳氏、行、衍常，敬刻\n　　百老和尚語錄第十一卷。"}
{"id": null, "n": null, "target": null, "type": null, "text": "石刻親筆，現存禮菴青龍。"}
{"id": null, "n": null, "target": null, "type": null, "text": "心奧、心護、法智、心榮、心和、心朵、心易、宗祥、\n　　　湛秀、萬善、樂然、大念、李文芳，備資敬刻\n　　百老和尚語錄第十二卷。"}
{"id": null, "n": null, "target": null, "type": null, "text": "吳士林、谷澤、孫耀、龍心泰、行真、行滿、行雄、\n　　　慶玅、寂定、彬雅，備資敬刻\n　　百老和尚語錄第十三卷。"}
{"id": null, "n": null, "target": null, "type": null, "text": "海珠、寂明、性慧、心章、祖域、定元、等心、德洪、\n　　　行誠、行研、行志，備資敬刻\n　　百老和尚語錄第十四卷。"}
{"id": null, "n": null, "target": null, "type": null, "text": "德玄、寂、行悟、續箇、明才、明朗、明判、\n　　　李花秀、李馥，備資敬刻\n　　百老和尚語錄第十五卷。"}
{"id": null, "n": null, "target": null, "type": null, "text": "向"}
{"id": null, "n": null, "target": null, "type": null, "text": "奉"}
{"id": null, "n": null, "target": null, "type": null, "text": "功"}
{"id": null, "n": null, "target": null, "type": null, "text": "共功"}
{"id": null, "n": null, "target": null, "type": null, "text": "功功"}
{"id": null, "n": null, "target": null, "type": null, "text": "誕生"}
{"id": null, "n": null, "target": null, "type": null, "text": "朝生"}
{"id": null, "n": null, "target": null, "type": null, "text": "末生"}
{"id": null, "n": null, "target": null, "type": null, "text": "化生"}
{"id": null, "n": null, "target": null, "type": null, "text": "內生"}
{"id": null, "n": null, "target": null, "type": null, "text": "玅唱不干舌"}
{"id": null, "n": null, "target": null, "type": null, "text": "死蛇驚出艸"}
{"id": null, "n": null, "target": null, "type": null, "text": "解鍼枯骨吟"}
{"id": null, "n": null, "target": null, "type": null, "text": "鐵鋸舞三台"}
{"id": null, "n": null, "target": null, "type": null, "text": "見"}
{"id": null, "n": null, "target": null, "type": null, "text": "情"}
{"id": null, "n": null, "target": null, "type": null, "text": "語"}
{"id": null, "n": null, "target": null, "type": null, "text": "類　隨　尊貴"}
{"id": null, "n": null, "target": null, "type": null, "text": "轉功"}
{"id": null, "n": null, "target": null, "type": null, "text": "轉位"}
{"id": null, "n": null, "target": null, "type": null, "text": "齊施"}
{"id": null, "n": null, "target": null, "type": null, "text": "俱隱"}
{"id": null, "n": null, "target": null, "type": null, "text": "平常無生"}
{"id": null, "n": null, "target": null, "type": null, "text": "玄玅無私"}
{"id": null, "n": null, "target": null, "type": null, "text": "體玅無盡"}
{"id": null, "n": null, "target": null, "type": null, "text": "正位一色"}
{"id": null, "n": null, "target": null, "type": null, "text": "大功一色"}
{"id": null, "n": null, "target": null, "type": null, "text": "今時一色"}
{"id": null, "n": null, "target": null, "type": null, "text": "奪人"}
{"id": null, "n": null, "target": null, "type": null, "text": "奪境"}
{"id": null, "n": null, "target": null, "type": null, "text": "俱奪"}
{"id": null, "n": null, "target": null, "type": null, "text": "俱不奪"}
{"id": null, "n": null, "target": null, "type": null, "text": "賓中賓"}
{"id": null, "n": null, "target": null, "type": null, "text": "賓中主"}
{"id": null, "n": null, "target": null, "type": null, "text": "主中賓"}
{"id": null, "n": null, "target": null, "type": null, "text": "主中主"}
{"id": null, "n": null, "target": null, "type": null, "text": "垂示三昧"}
{"id": null, "n": null, "target": null, "type": null, "text": "問荅互換"}
{"id": null, "n": null, "target": null, "type": null, "text": "性起無作"}
{"id": null, "n": null, "target": null, "type": null, "text": "緣起無礙"}
{"id": null, "n": null, "target": null, "type": null, "text": "明機普互"}
{"id": null, "n": null, "target": null, "type": null, "text": "暗合賓主"}
{"id": null, "n": null, "target": null, "type": null, "text": "三生不隔"}
{"id": null, "n": null, "target": null, "type": null, "text": "即約明真"}
{"id": null, "n": null, "target": null, "type": null, "text": "用了生緣"}
{"id": null, "n": null, "target": null, "type": null, "text": "就生顯法"}
{"id": null, "n": null, "target": null, "type": null, "text": "冥府生緣"}
{"id": null, "n": null, "target": null, "type": null, "text": "三境順真"}
{"id": null, "n": null, "target": null, "type": null, "text": "隨機識生"}
{"id": null, "n": null, "target": null, "type": null, "text": "印海收生"}
{"id": null, "n": null, "target": null, "type": null, "text": "密用靈機"}
{"id": null, "n": null, "target": null, "type": null, "text": "啐啄同時"}
{"id": null, "n": null, "target": null, "type": null, "text": "隨時收放"}
{"id": null, "n": null, "target": null, "type": null, "text": "卷舒無任"}
{"id": null, "n": null, "target": null, "type": null, "text": "一多自在"}
{"id": null, "n": null, "target": null, "type": null, "text": "德溥、張應宿、張龍、程良德，敬刻\n　　百老和尚語錄第十六卷。"}
{"id": null, "n": null, "target": null, "type": null, "text": "識自宗"}
{"id": null, "n": null, "target": null, "type": null, "text": "死中活"}
{"id": null, "n": null, "target": null, "type": null, "text": "活中死"}
{"id": null, "n": null, "target": null, "type": null, "text": "不落生死"}
{"id": null, "n": null, "target": null, "type": null, "text": "背捨"}
{"id": null, "n": null, "target": null, "type": null, "text": "不背捨"}
{"id": null, "n": null, "target": null, "type": null, "text": "活人劍"}
{"id": null, "n": null, "target": null, "type": null, "text": "殺人刀"}
{"id": null, "n": null, "target": null, "type": null, "text": "平常"}
{"id": null, "n": null, "target": null, "type": null, "text": "利道拔生"}
{"id": null, "n": null, "target": null, "type": null, "text": "言無過失"}
{"id": null, "n": null, "target": null, "type": null, "text": "透脫"}
{"id": null, "n": null, "target": null, "type": null, "text": "透脫不透脫"}
{"id": null, "n": null, "target": null, "type": null, "text": "稱揚"}
{"id": null, "n": null, "target": null, "type": null, "text": "降句"}
{"id": null, "n": null, "target": null, "type": null, "text": "方入圓"}
{"id": null, "n": null, "target": null, "type": null, "text": "大悲菴行慧，備資敬刻\n　　百老和尚語錄第十七卷。"}
{"id": null, "n": null, "target": null, "type": null, "text": "四首"}
{"id": null, "n": null, "target": null, "type": null, "text": "有序"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "四首"}
{"id": null, "n": null, "target": null, "type": null, "text": "有序"}
{"id": null, "n": null, "target": null, "type": null, "text": "五首"}
{"id": null, "n": null, "target": null, "type": null, "text": "得戒師"}
{"id": null, "n": null, "target": null, "type": null, "text": "文表請"}
{"id": null, "n": null, "target": null, "type": null, "text": "寒松操首座請"}
{"id": null, "n": null, "target": null, "type": null, "text": "弁山常住請"}
{"id": null, "n": null, "target": null, "type": null, "text": "九芝侍者請"}
{"id": null, "n": null, "target": null, "type": null, "text": "載月禪人請"}
{"id": null, "n": null, "target": null, "type": null, "text": "天髻禪德請"}
{"id": null, "n": null, "target": null, "type": null, "text": "北冥西堂請"}
{"id": null, "n": null, "target": null, "type": null, "text": "靈枝知客請"}
{"id": null, "n": null, "target": null, "type": null, "text": "大休靜主請"}
{"id": null, "n": null, "target": null, "type": null, "text": "紫谷參頭請"}
{"id": null, "n": null, "target": null, "type": null, "text": "韞之知藏請"}
{"id": null, "n": null, "target": null, "type": null, "text": "子菴西堂請"}
{"id": null, "n": null, "target": null, "type": null, "text": "雪田禪人請"}
{"id": null, "n": null, "target": null, "type": null, "text": "時聞書記請"}
{"id": null, "n": null, "target": null, "type": null, "text": "杲目靜主請"}
{"id": null, "n": null, "target": null, "type": null, "text": "柴也後堂請"}
{"id": null, "n": null, "target": null, "type": null, "text": "白雪、智吟，備資敬刻\n　　百老和尚語錄第十八卷。"}
{"id": null, "n": null, "target": null, "type": null, "text": "有序"}
{"id": null, "n": null, "target": null, "type": null, "text": "源朗、道昌、然貴、\n　　　寂秀、從德，備資敬刻\n　　百老和尚語錄第十九卷。"}
{"id": null, "n": null, "target": null, "type": null, "text": "銘碑高六裁尺，闊三尺，分二十六行，每行六十四字"}
{"id": null, "n": null, "target": null, "type": null, "text": "報國寺普達，備資敬刻\n　　百老和尚語錄第二十卷。"}
{"id": null, "n": null, "target": null, "type": null, "text": "有序"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "辛丑歲大旱，故有此作。"}
{"id": null, "n": null, "target": null, "type": null, "text": "王可交成仙處"}
{"id": null, "n": null, "target": null, "type": null, "text": "昔韓世忠勞軍處。《通鑑》云：「世忠後軍屯青龍」，即此也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "即煬帝建宮處"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "有序"}
{"id": null, "n": null, "target": null, "type": null, "text": "有序"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
