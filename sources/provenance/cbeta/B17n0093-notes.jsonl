{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "雜俎首昴今改首角"}
{"id": null, "n": null, "target": null, "type": null, "text": "二宿不載屬"}
{"id": null, "n": null, "target": null, "type": null, "text": "不載屬"}
{"id": null, "n": null, "target": null, "type": null, "text": "居喬切"}
{"id": null, "n": null, "target": null, "type": null, "text": "三宿不載屬"}
{"id": null, "n": null, "target": null, "type": null, "text": "竭天之子"}
{"id": null, "n": null, "target": null, "type": null, "text": "四宿不載屬"}
{"id": null, "n": null, "target": null, "type": null, "text": "丘茄切"}
{"id": null, "n": null, "target": null, "type": null, "text": "音察"}
{"id": null, "n": null, "target": null, "type": null, "text": "即臘縛"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂一呼一吸"}
{"id": null, "n": null, "target": null, "type": null, "text": "山多青石頭似鷲鳥\n竺法維佛國記云靈鷲山在摩竭提南屬天竺國"}
{"id": null, "n": null, "target": null, "type": null, "text": "道家稱元圃吐蕃稱亦耳麻不剌山釋道安西域志云摩\n訶賴國有阿耨達山王舍城在山東南角竹園精舍在城西"}
{"id": null, "n": null, "target": null, "type": null, "text": "中有渴槃陀國"}
{"id": null, "n": null, "target": null, "type": null, "text": "音兢"}
{"id": null, "n": null, "target": null, "type": null, "text": "此河從天堂而來恒河東面金象口而出流入東海"}
{"id": null, "n": null, "target": null, "type": null, "text": "從阿耨池南面銀牛口而出流入南海"}
{"id": null, "n": null, "target": null, "type": null, "text": "從阿耨池西面琉璃馬口而出流入西海"}
{"id": null, "n": null, "target": null, "type": null, "text": "從阿耨池北面頗黎獅子口而出流入北海"}
{"id": null, "n": null, "target": null, "type": null, "text": "在迦濕彌羅國西"}
{"id": null, "n": null, "target": null, "type": null, "text": "在泥婆羅國南"}
{"id": null, "n": null, "target": null, "type": null, "text": "在叨剌拏河西如來涅槃之所"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂眾僧聚處如大樹叢叢枝幹團結也"}
{"id": null, "n": null, "target": null, "type": null, "text": "在大宛北"}
{"id": null, "n": null, "target": null, "type": null, "text": "在桑乾北"}
{"id": null, "n": null, "target": null, "type": null, "text": "都那密水西"}
{"id": null, "n": null, "target": null, "type": null, "text": "都烏滸水西"}
{"id": null, "n": null, "target": null, "type": null, "text": "都那密水南康居舊地"}
{"id": null, "n": null, "target": null, "type": null, "text": "在東天竺東"}
{"id": null, "n": null, "target": null, "type": null, "text": "並見吾學編"}
{"id": null, "n": null, "target": null, "type": null, "text": "見洛陽伽藍記"}
{"id": null, "n": null, "target": null, "type": null, "text": "見記聞"}
{"id": null, "n": null, "target": null, "type": null, "text": "見酉\n陽雜俎"}
{"id": null, "n": null, "target": null, "type": null, "text": "在中天竺南"}
{"id": null, "n": null, "target": null, "type": null, "text": "在婆利國西"}
{"id": null, "n": null, "target": null, "type": null, "text": "即海西國"}
{"id": null, "n": null, "target": null, "type": null, "text": "在疎勒南"}
{"id": null, "n": null, "target": null, "type": null, "text": "在安\n息北"}
{"id": null, "n": null, "target": null, "type": null, "text": "即瑟匿國"}
{"id": null, "n": null, "target": null, "type": null, "text": "在烏萇西"}
{"id": null, "n": null, "target": null, "type": null, "text": "在吐蕃西"}
{"id": null, "n": null, "target": null, "type": null, "text": "居沙奇城屬天竺"}
{"id": null, "n": null, "target": null, "type": null, "text": "即姑墨國"}
{"id": null, "n": null, "target": null, "type": null, "text": "即邱兹一作屈茨在且末北烏孫南"}
{"id": null, "n": null, "target": null, "type": null, "text": "即康居在大宛西北"}
{"id": null, "n": null, "target": null, "type": null, "text": "總稱華夏宋史太平興國\n初天竺王沒徙曩遣使上書譯云近聞支那國內有大明王威力自在又云伏願支那皇帝福慧圓滿"}
{"id": null, "n": null, "target": null, "type": null, "text": "涅槃經"}
{"id": null, "n": null, "target": null, "type": null, "text": "樓炭經注\n云葱嶺以東名為震旦以日初出耀乎東隅也唐書貞觀十五年中天竺王尸羅逸多自稱摩伽佗遣使\n上書帝使雲騎尉梁懷璥持節慰撫王喜曰摩訶震旦亦有使者至吾國云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼岸指樂地喻眾生輪廻苦海沉溺此中\n諸佛所在謂之彼岸徐士英金剛經口義云波羅蜜訓為到彼岸似於字義猶有遺論葢波羅蜜乃樹名\n此樹生實甘美言聞經悟道者眾苦俱忘而甘美如蜜也"}
{"id": null, "n": null, "target": null, "type": null, "text": "一驛地"}
{"id": null, "n": null, "target": null, "type": null, "text": "天竺棄尸處"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐書天寶初中天竺王尸羅逸\n多死國亂其臣阿羅那順篡立時右率衛府長史王元䇿奉使至彼拒不得入乃檄吐蕃西鄰諸國兵破\n之降城五百八十餘所東天竺王尸鳩摩送牛馬三萬犒軍迦沒路國獻地圖譜則合計五天竺之城葢\n不止杜氏所謂數百而已"}
{"id": null, "n": null, "target": null, "type": null, "text": "柰一作祭"}
{"id": null, "n": null, "target": null, "type": null, "text": "竺法維佛國記云波羅柰國在\n伽維羅越國南千四百八十里又釋道安西域志云波羅柰斯國佛轉法輪處"}
{"id": null, "n": null, "target": null, "type": null, "text": "有法術之稱"}
{"id": null, "n": null, "target": null, "type": null, "text": "姓王氏耀州人"}
{"id": null, "n": null, "target": null, "type": null, "text": "即中印度"}
{"id": null, "n": null, "target": null, "type": null, "text": "東西曰廣南北曰袤"}
{"id": null, "n": null, "target": null, "type": null, "text": "奴鈎\n切"}
{"id": null, "n": null, "target": null, "type": null, "text": "自四人以\n上謂之僧今一人亦稱僧者從合眾之義猶萬二千五百人稱軍一人亦稱軍也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂能糾正弟子所行"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂乞法諸佛資益慧命乞食施主資益色身"}
{"id": null, "n": null, "target": null, "type": null, "text": "即清淨士"}
{"id": null, "n": null, "target": null, "type": null, "text": "此名尼"}
{"id": null, "n": null, "target": null, "type": null, "text": "取勤行善息之義"}
{"id": null, "n": null, "target": null, "type": null, "text": "息慈謂安息於慈悲之地一云息惡行慈也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂抖擻貪嗔癡而捨之也"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐人無子之稱"}
{"id": null, "n": null, "target": null, "type": null, "text": "般吒滑冷也有男根用而不生子"}
{"id": null, "n": null, "target": null, "type": null, "text": "伊利涉妬也謂\n行欲即發不行即無亦具男根而不生子"}
{"id": null, "n": null, "target": null, "type": null, "text": "丑皆切"}
{"id": null, "n": null, "target": null, "type": null, "text": "扇榹弱也謂本\n\n來男根不滿亦不能生子"}
{"id": null, "n": null, "target": null, "type": null, "text": "博义二形也謂半月有男形半月則女形"}
{"id": null, "n": null, "target": null, "type": null, "text": "留拏割也謂被宮刑者以上並大般若經注余聞世人有天騸者木\n來男根完具但痿廢不舉耳佛經遺此"}
{"id": null, "n": null, "target": null, "type": null, "text": "又稱尋香人"}
{"id": null, "n": null, "target": null, "type": null, "text": "路史發揮云臨猊國王太子名浮屠\n即佛也釋氏要覽云佛小名天中天"}
{"id": null, "n": null, "target": null, "type": null, "text": "凡有生者皆有情菩薩乃有情\n之中覺者也佛有覺性而無情菩薩則不免有情故謂之覺有情"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂能\n救度人大有情也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即皈命信從之義"}
{"id": null, "n": null, "target": null, "type": null, "text": "默一作照"}
{"id": null, "n": null, "target": null, "type": null, "text": "音宰"}
{"id": null, "n": null, "target": null, "type": null, "text": "初莧\n切"}
{"id": null, "n": null, "target": null, "type": null, "text": "尊者又有馬鳴"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿育國名"}
{"id": null, "n": null, "target": null, "type": null, "text": "舍利有二說佛之舍利取\n\n堅固之義尊者之名則曰鶖鷺子龍舒心經注云舍利弗即舍利子乃佛弟子名也以其母眼似舍利鳥\n之眼故因其母而立名舍利鳥即鶖鷺其眼圓因以舍利稱其母所謂舍利子者猶言婦人舍利者之子\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "尊者亦有鳩摩羅什"}
{"id": null, "n": null, "target": null, "type": null, "text": "後人改佛父曰\n淨梵王母曰摩耶非也摩耶是其祖名佛未出家時娶妻曰耶輸佗生子曰摩睺羅出家十二年歸妻子\n復聚居今僧徒無妻非佛本教也"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦稱目連"}
{"id": null, "n": null, "target": null, "type": null, "text": "一作剎利帝自\n二祖慧可至六祖惠能以及南北二宗諸禪師皆中華姓氏"}
{"id": null, "n": null, "target": null, "type": null, "text": "閃一作閦"}
{"id": null, "n": null, "target": null, "type": null, "text": "法華經云無間地獄有頂天堂寶星經序云擊大法鼓響振於無間吹大法螺聲通於有\n頂"}
{"id": null, "n": null, "target": null, "type": null, "text": "西方惡人殺人取指為鬘"}
{"id": null, "n": null, "target": null, "type": null, "text": "注見人品類"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛祖名"}
{"id": null, "n": null, "target": null, "type": null, "text": "執持是自行流布是化眾"}
{"id": null, "n": null, "target": null, "type": null, "text": "音敗"}
{"id": null, "n": null, "target": null, "type": null, "text": "設盂\n蘭盆自目連救母始"}
{"id": null, "n": null, "target": null, "type": null, "text": "一切\n禪定攝心者皆稱三摩提"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋伽經云涅槃乃不生不死之地一切修行之所依歸又佛教施燈\n文云願一切眾生皆得涅槃微妙光明葢謂修行至涅槃者乃有微妙光明或誤云死非也"}
{"id": null, "n": null, "target": null, "type": null, "text": "要覽云天竺第九祖入滅眾以香油\n旃檀闍維真體注云闍維焚燒也"}
{"id": null, "n": null, "target": null, "type": null, "text": "藏經記天竺多羅樹葉書二百四十縛謂貝葉經二百四十卷也"}
{"id": null, "n": null, "target": null, "type": null, "text": "陳思王曹子建遊魚山忽聞空中梵天之\n音張若祖詩云乘虛感靈覺魚山振思童指子建也"}
{"id": null, "n": null, "target": null, "type": null, "text": "達磨示慧可曰吾觀震旦所有經教惟楞伽四卷可以印心揚用修云從佛出十二部經從十二部經出\n九部修多羅從九部修多羅出方等從方等出摩訶般若從摩訶般若出大涅槃"}
{"id": null, "n": null, "target": null, "type": null, "text": "音知"}
{"id": null, "n": null, "target": null, "type": null, "text": "園者生植之所佛弟子居之取生植道本成就聖果之義"}
{"id": null, "n": null, "target": null, "type": null, "text": "篅市專切𥫱也"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云凡金石竹木之類有聲可以集眾者皆稱犍椎"}
{"id": null, "n": null, "target": null, "type": null, "text": "寄歸傳云軍持有二甆器是淨用銅鐵器是濁用"}
{"id": null, "n": null, "target": null, "type": null, "text": "此接引下根牽果修業之具"}
{"id": null, "n": null, "target": null, "type": null, "text": "即鉢類"}
{"id": null, "n": null, "target": null, "type": null, "text": "法華經注云優曇華鉢名瑞應三千年一現現則金輪王出"}
{"id": null, "n": null, "target": null, "type": null, "text": "即幡柱"}
{"id": null, "n": null, "target": null, "type": null, "text": "西域沙門得一法者即建幡以\n告四遠其建幡之柱謂之剎今以寺院稱剎非也"}
{"id": null, "n": null, "target": null, "type": null, "text": "昔慧達晝在高塔說法夜入繭中故稱為蘇何聖"}
{"id": null, "n": null, "target": null, "type": null, "text": "樂府有菩薩蠻或菩薩鬘之訛耳"}
{"id": null, "n": null, "target": null, "type": null, "text": "或從毛作毠㲚"}
{"id": null, "n": null, "target": null, "type": null, "text": "即七條衣"}
{"id": null, "n": null, "target": null, "type": null, "text": "一幅㲲成"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂蠶所成"}
{"id": null, "n": null, "target": null, "type": null, "text": "僧食名齋者取\n齋戒之義齋者齊也日未中與過中皆不齊故不食"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂󰉓飯乾飯魚肉邸正食也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂枝\n葉花果細末磨食即不正食也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音炒糗也"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋迦譜序云馥薝蔔而無\n異鳴迦陵而不殊"}
{"id": null, "n": null, "target": null, "type": null, "text": "于闐稱鱗"}
{"id": null, "n": null, "target": null, "type": null, "text": "韃靼稱阿剌渾"}
{"id": null, "n": null, "target": null, "type": null, "text": "土番稱速速兒"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋法盛歷國傳云天竺有稍割牛黑色角\n細長十日一割否則病或至死人服牛血壽五百餘歲"}
{"id": null, "n": null, "target": null, "type": null, "text": "東夷稱好剌"}
{"id": null, "n": null, "target": null, "type": null, "text": "東夷稱失剌孫"}
{"id": null, "n": null, "target": null, "type": null, "text": "龍種"}
{"id": null, "n": null, "target": null, "type": null, "text": "西域用俱蘇摩羅花\n結為條貫無問男女身首皆以此莊嚴凡經中稱華鬘天鬘寶鬘皆指此花"}
{"id": null, "n": null, "target": null, "type": null, "text": "形如梔子翦刀六出刻房七道"}
{"id": null, "n": null, "target": null, "type": null, "text": "經云貝多葉下思惟\n樹故菩提樹一名思惟樹大業拾遺記云西域有貝多樹其葉長五六寸闊五寸許形似琵琶而厚大用\n以書經"}
{"id": null, "n": null, "target": null, "type": null, "text": "舊以\n菴羅為柰非是此果花多而結實甚少其葉似柳果形似梨西域以為王樹謂王城種之也經中生熟難\n知以此為喻菴羅女持園施佛罔以為名"}
{"id": null, "n": null, "target": null, "type": null, "text": "三果似胡桃"}
{"id": null, "n": null, "target": null, "type": null, "text": "戶骨切鶻同義"}
{"id": null, "n": null, "target": null, "type": null, "text": "一統志云西番有草根株獨立枝葉如盖臭氣逼人生取其汁熬膏成阿魏又云三佛齊國有\n樹不甚高納竹筒於樹梢脂滿其中冬月破筒取脂即阿魏也酉陽雜俎云阿魏出伽闍那國即北天竺\n也伽闍那呼為形虞亦出波斯國波斯呼為阿虞樹長八九尺皮色青黃三月生葉似鼠耳無花實斷其\n枝汁出如飴久乃堅凝名阿魏又摩伽陀國僧提婆言取汁和米豆屑成阿魏唐本草注云阿魏體性極\n臭而能止臭亦奇物也又海藥本草云阿魏生崑崙國木液如桃膠黃色為上黑不堪用"}
{"id": null, "n": null, "target": null, "type": null, "text": "樹脂"}
{"id": null, "n": null, "target": null, "type": null, "text": "生恒河沙中"}
{"id": null, "n": null, "target": null, "type": null, "text": "即地骨皮"}
{"id": null, "n": null, "target": null, "type": null, "text": "並出金光明經"}
{"id": null, "n": null, "target": null, "type": null, "text": "出法苑珠林"}
{"id": null, "n": null, "target": null, "type": null, "text": "即離垢香出崑\n崙盤盤國華嚴經云牛頭旃檀香從離垢出若以塗身火不能燒"}
{"id": null, "n": null, "target": null, "type": null, "text": "即羅香又名馬尾香出天竺者多白色出邯祁國者夾綠色"}
{"id": null, "n": null, "target": null, "type": null, "text": "音榖"}
{"id": null, "n": null, "target": null, "type": null, "text": "即伊蒲西域以之供佛後漢書伊蒲之供是也或云即菖蒲花世不恒有貴其難得耳經云天\n末香莫若旃檀天澤香莫若薰陸天華香莫若伊蘭注云天末者為末而爇之天澤者濕爇之天華者以\n生蕋露蕾供佛也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音閉"}
{"id": null, "n": null, "target": null, "type": null, "text": "並出釋氏會要"}
{"id": null, "n": null, "target": null, "type": null, "text": "出波律國樹高八九丈有\n脂乾脂為龍腦香清脂為波律膏"}
{"id": null, "n": null, "target": null, "type": null, "text": "魚豢典略云芸香辟紙魚蠹"}
{"id": null, "n": null, "target": null, "type": null, "text": "即母丁香"}
{"id": null, "n": null, "target": null, "type": null, "text": "出波斯國其樹名辟邪長三丈許刻皮出膠如飴名安息香此香非\n出安息國不知何以得名"}
{"id": null, "n": null, "target": null, "type": null, "text": "出大\n秦國魏略云春月開花如紅藍夏月採之其香十二葉為百草之英"}
{"id": null, "n": null, "target": null, "type": null, "text": "內典云化木似老椿葉落水中魚暴死其香亦辟蠹魚"}
{"id": null, "n": null, "target": null, "type": null, "text": "云出海國"}
{"id": null, "n": null, "target": null, "type": null, "text": "云出頓遜國"}
{"id": null, "n": null, "target": null, "type": null, "text": "云出大秦國"}
{"id": null, "n": null, "target": null, "type": null, "text": "云出\n西域"}
{"id": null, "n": null, "target": null, "type": null, "text": "云出波斯國"}
{"id": null, "n": null, "target": null, "type": null, "text": "云出康居國"}
{"id": null, "n": null, "target": null, "type": null, "text": "云出越底延國"}
{"id": null, "n": null, "target": null, "type": null, "text": "云出西域"}
{"id": null, "n": null, "target": null, "type": null, "text": "云出兜渠國"}
{"id": null, "n": null, "target": null, "type": null, "text": "云出罽賔國"}
{"id": null, "n": null, "target": null, "type": null, "text": "金剛經云八百四千萬億那由他諸佛注云那由他十億也"}
{"id": null, "n": null, "target": null, "type": null, "text": "央一作鞅"}
{"id": null, "n": null, "target": null, "type": null, "text": "伸臂也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音奎半步也"}
{"id": null, "n": null, "target": null, "type": null, "text": "詩作匊"}
{"id": null, "n": null, "target": null, "type": null, "text": "禮記朝一溢米注云米一升二十四分升之一為一溢"}
{"id": null, "n": null, "target": null, "type": null, "text": "狀如榛子又呼無名子"}
{"id": null, "n": null, "target": null, "type": null, "text": "𨥥音礦樹上凝脂乃麒麟竭之類"}
{"id": null, "n": null, "target": null, "type": null, "text": "狀如枳橘"}
{"id": null, "n": null, "target": null, "type": null, "text": "疷音邸又音枝"}
{"id": null, "n": null, "target": null, "type": null, "text": "西域有乾陀木用其汁染僧衣故名"}
{"id": null, "n": null, "target": null, "type": null, "text": "此亦\n梵語華人習呼熟耳"}
{"id": null, "n": null, "target": null, "type": null, "text": "此說盖自騶衍談天推廣出來"}
{"id": null, "n": null, "target": null, "type": null, "text": "既識\n驢却不肯下此病更難醫若解下驢方喚作無事道人"}
{"id": null, "n": null, "target": null, "type": null, "text": "天以大寶鏡輪照四大洲此三月照南贍部洲宜修福"}
{"id": null, "n": null, "target": null, "type": null, "text": "即大衣"}
{"id": null, "n": null, "target": null, "type": null, "text": "即七條衣"}
{"id": null, "n": null, "target": null, "type": null, "text": "即五條衣"}
{"id": null, "n": null, "target": null, "type": null, "text": "黫音因即󲱙字"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂屈寬"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂日月暈"}
{"id": null, "n": null, "target": null, "type": null, "text": "苦謂一切\n生老病死之類集謂一切積聚肉骨財帛之類滅謂滅壞道謂修行四諦謂審諦四者之理非徒說也經\n云見苦斷集因滅修道"}
{"id": null, "n": null, "target": null, "type": null, "text": "補特\n伽羅正信出家身參法侶心猶顧戀所愛諸欲"}
{"id": null, "n": null, "target": null, "type": null, "text": "補特伽羅雖畜\n妻子止用上妙衣食珍寶而於諸欲不生躭染"}
{"id": null, "n": null, "target": null, "type": null, "text": "補特伽羅正信出家\n身參法侶於諸欲境心無顧戀"}
{"id": null, "n": null, "target": null, "type": null, "text": "補特伽羅畜養妻子上妙受用\n深生躭染"}
{"id": null, "n": null, "target": null, "type": null, "text": "照破幻蘊情累不留苦惱"}
{"id": null, "n": null, "target": null, "type": null, "text": "洞曉相續有情都是一真法界"}
{"id": null, "n": null, "target": null, "type": null, "text": "任其外緣所觸如八風之吹妙高山"}
{"id": null, "n": null, "target": null, "type": null, "text": "如晏海澄湛絕識浪之騰起"}
{"id": null, "n": null, "target": null, "type": null, "text": "深信\n樂欲此為根本"}
{"id": null, "n": null, "target": null, "type": null, "text": "無諸疾障事役"}
{"id": null, "n": null, "target": null, "type": null, "text": "有物足用有人善奉"}
{"id": null, "n": null, "target": null, "type": null, "text": "運歷平寧心緣由己身資山三緣委命"}
{"id": null, "n": null, "target": null, "type": null, "text": "獨我在此不容餘人"}
{"id": null, "n": null, "target": null, "type": null, "text": "獨我出入此地不容餘人"}
{"id": null, "n": null, "target": null, "type": null, "text": "我於中獨得布\n施不容餘人"}
{"id": null, "n": null, "target": null, "type": null, "text": "獨稱贊我不許稱贊餘人"}
{"id": null, "n": null, "target": null, "type": null, "text": "獨我知此法不傳餘\n\n人"}
{"id": null, "n": null, "target": null, "type": null, "text": "洞分至理不入邪見"}
{"id": null, "n": null, "target": null, "type": null, "text": "靈徹而見"}
{"id": null, "n": null, "target": null, "type": null, "text": "覺之大成無所不備"}
{"id": null, "n": null, "target": null, "type": null, "text": "圓覺馴臻至極"}
{"id": null, "n": null, "target": null, "type": null, "text": "等覺之上即本覺"}
{"id": null, "n": null, "target": null, "type": null, "text": "物不淨故"}
{"id": null, "n": null, "target": null, "type": null, "text": "亂眾生故"}
{"id": null, "n": null, "target": null, "type": null, "text": "惱眾生故"}
{"id": null, "n": null, "target": null, "type": null, "text": "害眾生故"}
{"id": null, "n": null, "target": null, "type": null, "text": "壞淨心故"}
{"id": null, "n": null, "target": null, "type": null, "text": "出尊勝經又善覺要覽云體性柔軟引蔓旁布馨香\n遠聞能療疼不背日光也"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛大勝多分別徒眾之號"}
{"id": null, "n": null, "target": null, "type": null, "text": "七者能資用成佛故名為財"}
{"id": null, "n": null, "target": null, "type": null, "text": "出十住論"}
{"id": null, "n": null, "target": null, "type": null, "text": "天樂神即翼星"}
{"id": null, "n": null, "target": null, "type": null, "text": "與帝釋戰者"}
{"id": null, "n": null, "target": null, "type": null, "text": "金翅鳥神後訛為嘍囉"}
{"id": null, "n": null, "target": null, "type": null, "text": "似人頭有\n角"}
{"id": null, "n": null, "target": null, "type": null, "text": "大蟒神出觀音經注"}
{"id": null, "n": null, "target": null, "type": null, "text": "前為凡夫四倒後為二乘四倒合為八倒"}
{"id": null, "n": null, "target": null, "type": null, "text": "因果不忘故名為有"}
{"id": null, "n": null, "target": null, "type": null, "text": "即兜羅綿世界"}
{"id": null, "n": null, "target": null, "type": null, "text": "堅固服餌而不休息食道圓成"}
{"id": null, "n": null, "target": null, "type": null, "text": "堅固草木而不休息藥道圓成"}
{"id": null, "n": null, "target": null, "type": null, "text": "堅固金石而不休息化道圓成"}
{"id": null, "n": null, "target": null, "type": null, "text": "堅固動止而不休息精氣圓成"}
{"id": null, "n": null, "target": null, "type": null, "text": "堅固津液而不休息潤德圓成"}
{"id": null, "n": null, "target": null, "type": null, "text": "堅固精色而不休息吸粹圓成"}
{"id": null, "n": null, "target": null, "type": null, "text": "堅固禁呪而不休息術法圓成"}
{"id": null, "n": null, "target": null, "type": null, "text": "堅固思念而不休息思意圓成"}
{"id": null, "n": null, "target": null, "type": null, "text": "堅固交媾而不休息感應圓成"}
{"id": null, "n": null, "target": null, "type": null, "text": "堅固變化而不休息覺悟圓成"}
{"id": null, "n": null, "target": null, "type": null, "text": "真性明了"}
{"id": null, "n": null, "target": null, "type": null, "text": "夙念無忘"}
{"id": null, "n": null, "target": null, "type": null, "text": "精明進趣"}
{"id": null, "n": null, "target": null, "type": null, "text": "智慧現前"}
{"id": null, "n": null, "target": null, "type": null, "text": "寂妙常凝"}
{"id": null, "n": null, "target": null, "type": null, "text": "明性深入"}
{"id": null, "n": null, "target": null, "type": null, "text": "保持不失"}
{"id": null, "n": null, "target": null, "type": null, "text": "回光弗"}
{"id": null, "n": null, "target": null, "type": null, "text": "安住無為"}
{"id": null, "n": null, "target": null, "type": null, "text": "所往隨願"}
{"id": null, "n": null, "target": null, "type": null, "text": "具佛妙德"}
{"id": null, "n": null, "target": null, "type": null, "text": "利益\n眾生"}
{"id": null, "n": null, "target": null, "type": null, "text": "利物無拒"}
{"id": null, "n": null, "target": null, "type": null, "text": "通達十方"}
{"id": null, "n": null, "target": null, "type": null, "text": "事無\n差悞"}
{"id": null, "n": null, "target": null, "type": null, "text": "異中現同"}
{"id": null, "n": null, "target": null, "type": null, "text": "塵剎不礙"}
{"id": null, "n": null, "target": null, "type": null, "text": "皆第一義"}
{"id": null, "n": null, "target": null, "type": null, "text": "圓佛軌則"}
{"id": null, "n": null, "target": null, "type": null, "text": "一真無偽"}
{"id": null, "n": null, "target": null, "type": null, "text": "即六入"}
{"id": null, "n": null, "target": null, "type": null, "text": "出楞嚴經"}
{"id": null, "n": null, "target": null, "type": null, "text": "上六門為依報"}
{"id": null, "n": null, "target": null, "type": null, "text": "上七門為正報"}
{"id": null, "n": null, "target": null, "type": null, "text": "上三門為三軰往生合為十六觀門昔唐宣宗問宏辯禪師今人念佛如何對\n曰如來出世為天人師隨根器而說法上根者聞最上乘頓悟至理中下者未能頓悟故權開十六觀門\n令念佛生於極樂又圭峯禪源序云念佛求生淨土須修十六觀門"}
{"id": null, "n": null, "target": null, "type": null, "text": "起於我"}
{"id": null, "n": null, "target": null, "type": null, "text": "如父有子"}
{"id": null, "n": null, "target": null, "type": null, "text": "命根成就"}
{"id": null, "n": null, "target": null, "type": null, "text": "能舉事故"}
{"id": null, "n": null, "target": null, "type": null, "text": "蘊和合生"}
{"id": null, "n": null, "target": null, "type": null, "text": "因緣故長"}
{"id": null, "n": null, "target": null, "type": null, "text": "諸法有數"}
{"id": null, "n": null, "target": null, "type": null, "text": "妄計我是人"}
{"id": null, "n": null, "target": null, "type": null, "text": "手足\n所能"}
{"id": null, "n": null, "target": null, "type": null, "text": "力能役佗"}
{"id": null, "n": null, "target": null, "type": null, "text": "作後世業"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦含陀"}
{"id": null, "n": null, "target": null, "type": null, "text": "苦樂果現"}
{"id": null, "n": null, "target": null, "type": null, "text": "厭於苦樂"}
{"id": null, "n": null, "target": null, "type": null, "text": "五識名知"}
{"id": null, "n": null, "target": null, "type": null, "text": "目觀色相"}
{"id": null, "n": null, "target": null, "type": null, "text": "姓賈氏鴈門樓\n煩人"}
{"id": null, "n": null, "target": null, "type": null, "text": "姓繁氏河內人"}
{"id": null, "n": null, "target": null, "type": null, "text": "遠公弟也與兄同事道安"}
{"id": null, "n": null, "target": null, "type": null, "text": "姓魏氏鉅\n野人客居彭城"}
{"id": null, "n": null, "target": null, "type": null, "text": "罽賔國婆羅門種"}
{"id": null, "n": null, "target": null, "type": null, "text": "甘露飯王之裔"}
{"id": null, "n": null, "target": null, "type": null, "text": "冀州人"}
{"id": null, "n": null, "target": null, "type": null, "text": "黃龍人"}
{"id": null, "n": null, "target": null, "type": null, "text": "瑯琊王氏\n隨祖凝之守江州"}
{"id": null, "n": null, "target": null, "type": null, "text": "河東人"}
{"id": null, "n": null, "target": null, "type": null, "text": "姓陳氏穎川人"}
{"id": null, "n": null, "target": null, "type": null, "text": "廣陵人"}
{"id": null, "n": null, "target": null, "type": null, "text": "名程之字仲思號遺民彭城聚里人漢楚元王之後"}
{"id": null, "n": null, "target": null, "type": null, "text": "字仲倫南\n昌人"}
{"id": null, "n": null, "target": null, "type": null, "text": "字少文南陽人官任太子舍人"}
{"id": null, "n": null, "target": null, "type": null, "text": "字萊民官任治中"}
{"id": null, "n": null, "target": null, "type": null, "text": "字秀碩張野族"}
{"id": null, "n": null, "target": null, "type": null, "text": "字道祖鴈門廣武人"}
{"id": null, "n": null, "target": null, "type": null, "text": "出般\n若經又菩薩本經云佛身紫金色有三十二相傳燈錄云優填王思佛請目連運神通攝匠人俾雕佛像\n得三十二相"}
{"id": null, "n": null, "target": null, "type": null, "text": "北天竺人"}
{"id": null, "n": null, "target": null, "type": null, "text": "東天竺人"}
{"id": null, "n": null, "target": null, "type": null, "text": "本名菩提多羅南天竺國王第三子也王姓剎利帝名香至有三子長名月淨多羅仲名功德多羅\n季即達磨大師梁普通七年至金陵是為震旦初祖"}
{"id": null, "n": null, "target": null, "type": null, "text": "共八十八佛人所常誦不\n詳載"}
{"id": null, "n": null, "target": null, "type": null, "text": "音閉又音關"}
{"id": null, "n": null, "target": null, "type": null, "text": "出大集經"}
{"id": null, "n": null, "target": null, "type": null, "text": "菩薩本經云佛有大神力八十種好前知無窮却睹南極"}
{"id": null, "n": null, "target": null, "type": null, "text": "詳西域僧天親百法論"}
{"id": null, "n": null, "target": null, "type": null, "text": "閻浮提今中國及四夷皆是也\n中國稱震旦又稱人國則自天竺名之為閻浮提之一耳"}
{"id": null, "n": null, "target": null, "type": null, "text": "載容齋五筆"}
{"id": null, "n": null, "target": null, "type": null, "text": "並出釋氏通鑑"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋鑑"}
{"id": null, "n": null, "target": null, "type": null, "text": "侯君素記"}
{"id": null, "n": null, "target": null, "type": null, "text": "並釋鑑"}
{"id": null, "n": null, "target": null, "type": null, "text": "玉堂閒話"}
{"id": null, "n": null, "target": null, "type": null, "text": "衡州志"}
{"id": null, "n": null, "target": null, "type": null, "text": "並釋鑑"}
{"id": null, "n": null, "target": null, "type": null, "text": "潛溪集"}
{"id": null, "n": null, "target": null, "type": null, "text": "並釋鑑"}
{"id": null, "n": null, "target": null, "type": null, "text": "法苑珠林"}
{"id": null, "n": null, "target": null, "type": null, "text": "談藪"}
{"id": null, "n": null, "target": null, "type": null, "text": "感應傳"}
{"id": null, "n": null, "target": null, "type": null, "text": "報應記"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉僧同名"}
{"id": null, "n": null, "target": null, "type": null, "text": "並釋鑑"}
{"id": null, "n": null, "target": null, "type": null, "text": "湖廣通志"}
{"id": null, "n": null, "target": null, "type": null, "text": "出晉書"}
{"id": null, "n": null, "target": null, "type": null, "text": "並釋鑑"}
{"id": null, "n": null, "target": null, "type": null, "text": "並釋鑑"}
{"id": null, "n": null, "target": null, "type": null, "text": "高僧傳"}
{"id": null, "n": null, "target": null, "type": null, "text": "並釋鑑"}
{"id": null, "n": null, "target": null, "type": null, "text": "並湖廣通志"}
{"id": null, "n": null, "target": null, "type": null, "text": "陳尊宿"}
{"id": null, "n": null, "target": null, "type": null, "text": "並釋鑑"}
{"id": null, "n": null, "target": null, "type": null, "text": "太平廣記"}
{"id": null, "n": null, "target": null, "type": null, "text": "西湖遊覽志餘"}
{"id": null, "n": null, "target": null, "type": null, "text": "並荊州志"}
