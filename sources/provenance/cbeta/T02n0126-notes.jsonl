{"id": null, "n": "0831001", "target": "#nkr_note_mod_0831001", "type": "mod", "text": "西天【大】，宋西天【明】，譯號宋元俱作三藏法師法賢奉詔譯九字"}
{"id": null, "n": "0831002", "target": "#nkr_note_mod_0831002", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0831003", "target": "#nkr_note_mod_0831003", "type": "mod", "text": "大【大】，天【明】"}
{"id": null, "n": "0832001", "target": "#nkr_note_mod_0832001", "type": "mod", "text": "堀【大】＊，掘【明】＊"}
{"id": null, "n": "0832002", "target": "#nkr_note_mod_0832002", "type": "mod", "text": "娑【大】，婆【宋】【元】【明】"}
{"id": null, "n": "0832003", "target": "#nkr_note_mod_0832003", "type": "mod", "text": "惹敢切【大】，〔－〕【明】"}
{"id": null, "n": "0831001", "target": "#nkr_note_orig_0831001", "type": "orig", "text": "譯號宋元俱作三藏法師法賢奉詔譯九字，（宋）＋西天【明】"}
{"id": null, "n": "0831002", "target": "#nkr_note_orig_0831002", "type": "orig", "text": "〔臣〕－【明】"}
{"id": null, "n": "0831003", "target": "#nkr_note_orig_0831003", "type": "orig", "text": "大＝天【明】"}
{"id": null, "n": "0832001", "target": "#nkr_note_orig_0832001", "type": "orig", "text": "堀＝掘【明】＊"}
{"id": null, "n": "0832002", "target": "#nkr_note_orig_0832002", "type": "orig", "text": "娑＝婆【三】"}
{"id": null, "n": "0832003", "target": "#nkr_note_orig_0832003", "type": "orig", "text": "〔惹敢切〕－【明】"}
{"id": null, "n": "0831b0101", "target": "#nkr_note_add_0831b0101", "type": "add", "text": "跋【CB】【麗-CB】，拔【大】"}
{"id": null, "n": "0832a1301", "target": "#nkr_note_add_0832a1301", "type": "add", "text": "墯【CB】【麗-CB】，墮【大】"}
{"id": null, "n": "0833b2201", "target": "#nkr_note_add_0833b2201", "type": "add", "text": "愛【CB】【麗-CB】，受【大】"}
{"id": null, "n": "0834b0101", "target": "#nkr_note_add_0834b0101", "type": "add", "text": "住【CB】，往【大】"}
