{"id": null, "n": "0338002", "target": "#nkr_note_orig_0338002", "type": "orig", "text": "「怒」，底本作「努」，據文意改。"}
{"id": null, "n": "0338003", "target": "#nkr_note_orig_0338003", "type": "orig", "text": "「焦」，底本作「燋」，據文意改。"}
{"id": null, "n": "0339001", "target": "#nkr_note_orig_0339001", "type": "orig", "text": "「焦」，底本作「燋」，據文意改。"}
{"id": null, "n": "0339002", "target": "#nkr_note_orig_0339002", "type": "orig", "text": "「士」，底本作「土」，據文意改。"}
{"id": null, "n": "0340001", "target": "#nkr_note_orig_0340001", "type": "orig", "text": "「悟」，底本作「悞」，據文意改。下同，不一一出註。"}
{"id": null, "n": "0340002", "target": "#nkr_note_orig_0340002", "type": "orig", "text": "「醒」，底本作「惺」，據文意改。"}
{"id": null, "n": "0341001", "target": "#nkr_note_orig_0341001", "type": "orig", "text": "「測」，底本作「惻」，據文意改。"}
{"id": null, "n": "0341002", "target": "#nkr_note_orig_0341002", "type": "orig", "text": "「猶」，底本作「由」，據文意改。"}
{"id": null, "n": "0343001", "target": "#nkr_note_orig_0343001", "type": "orig", "text": "「愚」，底本作「息」，據文意改。"}
{"id": null, "n": "0344001", "target": "#nkr_note_orig_0344001", "type": "orig", "text": "「今」，底本作「金」，據文意改。"}
{"id": null, "n": "0344002", "target": "#nkr_note_orig_0344002", "type": "orig", "text": "「猶」，底本作「由」，據文意改。"}
{"id": null, "n": "0345001", "target": "#nkr_note_orig_0345001", "type": "orig", "text": "「耀」，底本作「曜」，據文意改。"}
{"id": null, "n": "0345002", "target": "#nkr_note_orig_0345002", "type": "orig", "text": "「形」，底本作「刑」，據文意改。"}
{"id": null, "n": "0345003", "target": "#nkr_note_orig_0345003", "type": "orig", "text": "「迷」，底本作「悉」，據文意改。"}
{"id": null, "n": "0346001", "target": "#nkr_note_orig_0346001", "type": "orig", "text": "「代」，底本作「伐」，據文意改。"}
{"id": null, "n": "0346002", "target": "#nkr_note_orig_0346002", "type": "orig", "text": "「猶」，底本作「由」，據文意改。"}
{"id": null, "n": "0346003", "target": "#nkr_note_orig_0346003", "type": "orig", "text": "「鑑」，底本作「監」，據文意改。"}
{"id": null, "n": "0347001", "target": "#nkr_note_orig_0347001", "type": "orig", "text": "「院」，底本作「阮」，據文意改。"}
{"id": null, "n": "0347002", "target": "#nkr_note_orig_0347002", "type": "orig", "text": "「停」，底本作「亭」，據文意改。"}
{"id": null, "n": "0347003", "target": "#nkr_note_orig_0347003", "type": "orig", "text": "「咽」，底本作「唵」，據文意改。"}
{"id": null, "n": "0347004", "target": "#nkr_note_orig_0347004", "type": "orig", "text": "「免」，底本作「勉」，據文意改。"}
{"id": null, "n": "0348001", "target": "#nkr_note_orig_0348001", "type": "orig", "text": "「邪」，底本作「耶」，據文意改。"}
