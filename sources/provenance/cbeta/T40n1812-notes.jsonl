{"id": null, "n": "0599002", "target": "#nkr_note_mod_0599002", "type": "mod", "text": "他【大】，〔－〕【考偽-大】"}
{"id": null, "n": "0600001", "target": "#nkr_note_mod_0600001", "type": "mod", "text": "別罪也【大】，〔－〕【考偽-大】"}
{"id": null, "n": "0600002", "target": "#nkr_note_mod_0600002", "type": "mod", "text": "□【大】，不【考偽-大】"}
