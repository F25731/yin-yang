{"id": null, "n": "0594001", "target": "#nkr_note_orig_0594001", "type": "orig", "text": "是＋（福）？"}
{"id": null, "n": "0596001", "target": "#nkr_note_orig_0596001", "type": "orig", "text": "寶＝重ィ【原】"}
