{"id": null, "n": null, "target": null, "type": null, "text": "草書滅法，傳者須真。"}
{"id": null, "n": null, "target": null, "type": null, "text": "外凡"}
{"id": null, "n": null, "target": null, "type": null, "text": "內凡"}
{"id": null, "n": null, "target": null, "type": null, "text": "不出觀，共斷見惑，與三藏初果齊"}
{"id": null, "n": null, "target": null, "type": null, "text": "三人同斷欲界六品思惑，\n與三藏二果齊"}
{"id": null, "n": null, "target": null, "type": null, "text": "斷欲界九品思惑，與三藏三果齊"}
{"id": null, "n": null, "target": null, "type": null, "text": "斷三界見思盡，\n與三藏羅漢齊"}
{"id": null, "n": null, "target": null, "type": null, "text": "福德深利，能侵習也"}
{"id": null, "n": null, "target": null, "type": null, "text": "從空出假，侵小習氣，及界內無\n知，學佛十力等法"}
{"id": null, "n": null, "target": null, "type": null, "text": "一念相應，習氣永盡，與三藏佛齊也"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說。"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說。"}
{"id": null, "n": null, "target": null, "type": null, "text": "禮三寶。"}
{"id": null, "n": null, "target": null, "type": null, "text": "三反。"}
{"id": null, "n": null, "target": null, "type": null, "text": "禮一拜。"}
{"id": null, "n": null, "target": null, "type": null, "text": "詞句同前。"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說。"}
{"id": null, "n": null, "target": null, "type": null, "text": "約佛在世，別行\n五法布薩羯磨"}
{"id": null, "n": null, "target": null, "type": null, "text": "一說。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：「能。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：「無。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂證四果等。並答「無」。"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說、三問、三答。"}
{"id": null, "n": null, "target": null, "type": null, "text": "次說第二遍。"}
{"id": null, "n": null, "target": null, "type": null, "text": "次說第二遍。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云。"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：「能。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "詞句同前。"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云於草堂寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂梵民"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂梵臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂梵主"}
{"id": null, "n": null, "target": null, "type": null, "text": "身光少故"}
{"id": null, "n": null, "target": null, "type": null, "text": "光量多故"}
{"id": null, "n": null, "target": null, "type": null, "text": "光體\n遍故"}
{"id": null, "n": null, "target": null, "type": null, "text": "例上釋之"}
{"id": null, "n": null, "target": null, "type": null, "text": "下地有雲，上地無雲，名無雲"}
{"id": null, "n": null, "target": null, "type": null, "text": "勝福往生\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "勝福感果，故名廣果"}
{"id": null, "n": null, "target": null, "type": null, "text": "修無心定，因生彼天，故名外道天"}
{"id": null, "n": null, "target": null, "type": null, "text": "初離繁雜，故名無繁"}
{"id": null, "n": null, "target": null, "type": null, "text": "離於下地，熱故煩惱"}
{"id": null, "n": null, "target": null, "type": null, "text": "果德易顯故"}
{"id": null, "n": null, "target": null, "type": null, "text": "漸見清徹故"}
{"id": null, "n": null, "target": null, "type": null, "text": "五淨之極故"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦云三十三天"}
{"id": null, "n": null, "target": null, "type": null, "text": "此云時分"}
{"id": null, "n": null, "target": null, "type": null, "text": "此云知足"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "序文竟。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "俗云葫是"}
{"id": null, "n": null, "target": null, "type": null, "text": "即韮薤等"}
{"id": null, "n": null, "target": null, "type": null, "text": "只是葱等"}
{"id": null, "n": null, "target": null, "type": null, "text": "䔉野䔉等"}
{"id": null, "n": null, "target": null, "type": null, "text": "荖蒠䓔蒺"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂惡律多\n等"}
{"id": null, "n": null, "target": null, "type": null, "text": "過中食為本也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "律中開畜\n為誑賊故"}
{"id": null, "n": null, "target": null, "type": null, "text": "所類反"}
{"id": null, "n": null, "target": null, "type": null, "text": "來夜反"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "他曆反，跳貌也"}
{"id": null, "n": null, "target": null, "type": null, "text": "墮和\n反"}
{"id": null, "n": null, "target": null, "type": null, "text": "女言大姉"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說。若在俗宅，除此句也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "某甲"}
{"id": null, "n": null, "target": null, "type": null, "text": "浴籌竟，打一下云云："}
{"id": null, "n": null, "target": null, "type": null, "text": "打一下。"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說，打一下。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：「能。」打一下。"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說，打一下。"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說，一下。"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說。行籌竟，打一下。"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說，打一下。"}
{"id": null, "n": null, "target": null, "type": null, "text": "次請上座說戒，同聲聞法\n請。"}
{"id": null, "n": null, "target": null, "type": null, "text": "誦戒人具儀禮三拜已，互跪云："}
{"id": null, "n": null, "target": null, "type": null, "text": "詞同聲聞行香說偈。"}
{"id": null, "n": null, "target": null, "type": null, "text": "去聲呼"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "由羯磨故"}
{"id": null, "n": null, "target": null, "type": null, "text": "無羯磨故"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說。"}
{"id": null, "n": null, "target": null, "type": null, "text": "䠒跪合掌"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說。懺悔主云："}
{"id": null, "n": null, "target": null, "type": null, "text": "答云。今此依唐三藏羯磨出之。"}
