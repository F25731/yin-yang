{"id": null, "n": "0487001", "target": "#nkr_note_mod_0487001", "type": "mod", "text": "天竺三藏【大】，開皇年【聖】"}
{"id": null, "n": "0487002", "target": "#nkr_note_mod_0487002", "type": "mod", "text": "三藏【大】，沙門【宋】【元】【明】【宮】"}
{"id": null, "n": "0487003", "target": "#nkr_note_mod_0487003", "type": "mod", "text": "流【大】，留【聖】"}
{"id": null, "n": "0487004", "target": "#nkr_note_mod_0487004", "type": "mod", "text": "譯【大】，第三譯【元】【明】"}
{"id": null, "n": "0487005", "target": "#nkr_note_mod_0487005", "type": "mod", "text": "䗍【大】，螺【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0487006", "target": "#nkr_note_mod_0487006", "type": "mod", "text": "相【大】，狀【聖】"}
{"id": null, "n": "0487007", "target": "#nkr_note_mod_0487007", "type": "mod", "text": "等【大】，尊【聖】"}
{"id": null, "n": "0488001", "target": "#nkr_note_mod_0488001", "type": "mod", "text": "繼念【大】下同，係念【元】【明】【宮】【聖】下同"}
{"id": null, "n": "0488002", "target": "#nkr_note_mod_0488002", "type": "mod", "text": "復【大】，行【聖】"}
{"id": null, "n": "0489001", "target": "#nkr_note_mod_0489001", "type": "mod", "text": "心【大】，〔－〕【聖】"}
{"id": null, "n": "0489002", "target": "#nkr_note_mod_0489002", "type": "mod", "text": "他【大】，地【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0489003", "target": "#nkr_note_mod_0489003", "type": "mod", "text": "此【大】，是【聖】"}
{"id": null, "n": "0489004", "target": "#nkr_note_mod_0489004", "type": "mod", "text": "象【大】，佛說象【明】"}
{"id": null, "n": "0487001", "target": "#nkr_note_orig_0487001", "type": "orig", "text": "天竺三藏＝開皇年【聖】"}
{"id": null, "n": "0487002", "target": "#nkr_note_orig_0487002", "type": "orig", "text": "三藏＝沙門【三】【宮】"}
{"id": null, "n": "0487003", "target": "#nkr_note_orig_0487003", "type": "orig", "text": "流＝留【聖】"}
{"id": null, "n": "0487004", "target": "#nkr_note_orig_0487004", "type": "orig", "text": "（第三）＋譯【元】【明】"}
{"id": null, "n": "0487005", "target": "#nkr_note_orig_0487005", "type": "orig", "text": "䗍＝螺【三】【宮】【聖】"}
{"id": null, "n": "0487006", "target": "#nkr_note_orig_0487006", "type": "orig", "text": "相＝狀【聖】"}
{"id": null, "n": "0487007", "target": "#nkr_note_orig_0487007", "type": "orig", "text": "等＝尊【聖】"}
{"id": null, "n": "0488001", "target": "#nkr_note_orig_0488001", "type": "orig", "text": "繼念＝係念【元】【明】【宮】【聖】下同"}
{"id": null, "n": "0488002", "target": "#nkr_note_orig_0488002", "type": "orig", "text": "復＝行【聖】"}
{"id": null, "n": "0489001", "target": "#nkr_note_orig_0489001", "type": "orig", "text": "〔心〕－【聖】"}
{"id": null, "n": "0489002", "target": "#nkr_note_orig_0489002", "type": "orig", "text": "他＝地【三】【宮】【聖】"}
{"id": null, "n": "0489003", "target": "#nkr_note_orig_0489003", "type": "orig", "text": "此＝是【聖】"}
{"id": null, "n": "0489004", "target": "#nkr_note_orig_0489004", "type": "orig", "text": "（佛說）＋象【明】"}
