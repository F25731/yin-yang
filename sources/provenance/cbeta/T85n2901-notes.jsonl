{"id": null, "n": "1435001", "target": "#nkr_note_orig_1435001", "type": "orig", "text": "示＝說【甲】"}
{"id": null, "n": "1435002", "target": "#nkr_note_orig_1435002", "type": "orig", "text": "如＝相【甲】"}
{"id": null, "n": "1435003", "target": "#nkr_note_orig_1435003", "type": "orig", "text": "諸＝說【甲】"}
{"id": null, "n": "1435004", "target": "#nkr_note_orig_1435004", "type": "orig", "text": "到＝倒【甲】"}
{"id": null, "n": "1435005", "target": "#nkr_note_orig_1435005", "type": "orig", "text": "虛＝崖【甲】"}
{"id": null, "n": "1435006", "target": "#nkr_note_orig_1435006", "type": "orig", "text": "則＝即【甲】"}
{"id": null, "n": "1435007", "target": "#nkr_note_orig_1435007", "type": "orig", "text": "此＝斯【甲】"}
{"id": null, "n": "1435008", "target": "#nkr_note_orig_1435008", "type": "orig", "text": "攝＝說【甲】"}
{"id": null, "n": "1435009", "target": "#nkr_note_orig_1435009", "type": "orig", "text": "所＝有【甲】"}
{"id": null, "n": "1435010", "target": "#nkr_note_orig_1435010", "type": "orig", "text": "等＝經【甲】"}
{"id": null, "n": "1435011", "target": "#nkr_note_orig_1435011", "type": "orig", "text": "恩＝因【甲】"}
{"id": null, "n": "1435012", "target": "#nkr_note_orig_1435012", "type": "orig", "text": "〔有〕－【甲】"}
{"id": null, "n": "1435013", "target": "#nkr_note_orig_1435013", "type": "orig", "text": "急＝怠【甲】"}
{"id": null, "n": "1435014", "target": "#nkr_note_orig_1435014", "type": "orig", "text": "中如＝而【甲】"}
{"id": null, "n": "1435015", "target": "#nkr_note_orig_1435015", "type": "orig", "text": "次下甲本有尾題佛說法句經一卷七字"}
{"id": null, "n": "1432c2601", "target": "#nkr_note_add_1432c2601", "type": "add", "text": "倒【CB】，到【大】"}
{"id": null, "n": "1432c2602", "target": "#nkr_note_add_1432c2602", "type": "add", "text": "惑【CB】，或【大】"}
{"id": null, "n": "1432c2701", "target": "#nkr_note_add_1432c2701", "type": "add", "text": "惑【CB】，或【大】"}
{"id": null, "n": "1433b2801", "target": "#nkr_note_add_1433b2801", "type": "add", "text": "妄【CB】，忘【大】"}
{"id": null, "n": "1433c1601", "target": "#nkr_note_add_1433c1601", "type": "add", "text": "衣【CB】，依【大】"}
{"id": null, "n": "1433c1801", "target": "#nkr_note_add_1433c1801", "type": "add", "text": "離【CB】，雖【大】"}
{"id": null, "n": "1434a0701", "target": "#nkr_note_add_1434a0701", "type": "add", "text": "裁【CB】，栽【大】"}
