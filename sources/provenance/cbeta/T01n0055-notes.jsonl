{"id": null, "n": "0850003", "target": "#nkr_note_mod_0850003", "type": "mod", "text": "杖【大】，仗【宋】【元】【明】"}
{"id": null, "n": "0850004", "target": "#nkr_note_mod_0850004", "type": "mod", "text": "椎【大】，杵【宋】【元】【明】"}
{"id": null, "n": "0850005", "target": "#nkr_note_mod_0850005", "type": "mod", "text": "或以鉞【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0850006", "target": "#nkr_note_mod_0850006", "type": "mod", "text": "或【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0850007", "target": "#nkr_note_mod_0850007", "type": "mod", "text": "消【大】，銷【元】【明】"}
{"id": null, "n": "0850008", "target": "#nkr_note_mod_0850008", "type": "mod", "text": "彼【大】，被【明】"}
{"id": null, "n": "0850009", "target": "#nkr_note_mod_0850009", "type": "mod", "text": "座【大】，床【宋】【元】【明】"}
{"id": null, "n": "0850010", "target": "#nkr_note_mod_0850010", "type": "mod", "text": "痛【大】，病【宋】【元】【明】"}
{"id": null, "n": "0850011", "target": "#nkr_note_mod_0850011", "type": "mod", "text": "乾【大】＊，揵【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0850012", "target": "#nkr_note_mod_0850012", "type": "mod", "text": "不【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0850013", "target": "#nkr_note_mod_0850013", "type": "mod", "text": "等【大】，業【宋】【元】【明】"}
{"id": null, "n": "0850014", "target": "#nkr_note_mod_0850014", "type": "mod", "text": "住【大】＊，任【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0850015", "target": "#nkr_note_mod_0850015", "type": "mod", "text": "及耶【大】，耶及【宋】【元】【明】"}
{"id": null, "n": "0850016", "target": "#nkr_note_mod_0850016", "type": "mod", "text": "自【大】，目【元】"}
{"id": null, "n": "0851001", "target": "#nkr_note_mod_0851001", "type": "mod", "text": "為身【大】，身為【宋】【元】【明】"}
