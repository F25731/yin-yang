{"id": null, "n": "0849010", "target": "#nkr_note_mod_0849010", "type": "mod", "text": "以【大】，已【宋】【元】【明】"}
{"id": null, "n": "0849011", "target": "#nkr_note_mod_0849011", "type": "mod", "text": "汝【CB】【宋】【元】【明】，法【大】"}
{"id": null, "n": "0849012", "target": "#nkr_note_mod_0849012", "type": "mod", "text": "盡【大】，盡故【宋】【元】【明】"}
{"id": null, "n": "0849013", "target": "#nkr_note_mod_0849013", "type": "mod", "text": "客【大】，傭【宋】【元】【明】"}
{"id": null, "n": "0849014", "target": "#nkr_note_mod_0849014", "type": "mod", "text": "椎【大】＊，槌【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0850001", "target": "#nkr_note_mod_0850001", "type": "mod", "text": "眾【大】，〔－〕【宋】【元】【明】"}
