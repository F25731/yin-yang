{"id": null, "n": "0104001", "target": "#nkr_note_orig_0104001", "type": "orig", "text": "「座」，底本做「坐」，據文意改。"}
{"id": null, "n": "0104002", "target": "#nkr_note_orig_0104002", "type": "orig", "text": "「列」，底本作「烈」，據文意改。"}
{"id": null, "n": "0104003", "target": "#nkr_note_orig_0104003", "type": "orig", "text": "「制」，底本作「離」，據伯2756號改。"}
{"id": null, "n": "0104004", "target": "#nkr_note_orig_0104004", "type": "orig", "text": "「首」，底本作「道」，據伯2756號改。"}
{"id": null, "n": "0105001", "target": "#nkr_note_orig_0105001", "type": "orig", "text": "「利」，底本無，據石本補。"}
{"id": null, "n": "0105002", "target": "#nkr_note_orig_0105002", "type": "orig", "text": "「隨求」，底本殘，據石本補。"}
{"id": null, "n": "0105003", "target": "#nkr_note_orig_0105003", "type": "orig", "text": "「金剛」，底本殘，據石本補。"}
{"id": null, "n": "0105004", "target": "#nkr_note_orig_0105004", "type": "orig", "text": "「災」，底本殘，據石本補。"}
{"id": null, "n": "0105005", "target": "#nkr_note_orig_0105005", "type": "orig", "text": "「奉請大神金剛」，底本殘，據石本補。"}
{"id": null, "n": "0105006", "target": "#nkr_note_orig_0105006", "type": "orig", "text": "「奉請」，底本無，據文意補。"}
{"id": null, "n": "0106001", "target": "#nkr_note_orig_0106001", "type": "orig", "text": "「奉請」，底本無，據文意補。"}
{"id": null, "n": "0107001", "target": "#nkr_note_orig_0107001", "type": "orig", "text": "「不染塵」底本無，據石本補。"}
{"id": null, "n": "0108001", "target": "#nkr_note_orig_0108001", "type": "orig", "text": "「大」，底本作「代」，據石本改。"}
{"id": null, "n": "0108002", "target": "#nkr_note_orig_0108002", "type": "orig", "text": "「菩提」，底本無，據羅什譯本補。"}
{"id": null, "n": "0108003", "target": "#nkr_note_orig_0108003", "type": "orig", "text": "「北方四」，底本無，據羅什譯本補。"}
{"id": null, "n": "0108004", "target": "#nkr_note_orig_0108004", "type": "orig", "text": "「菩提」，底本無，據羅什譯本補。"}
{"id": null, "n": "0108005", "target": "#nkr_note_orig_0108005", "type": "orig", "text": "「揚」，底本作「楊」，據石本改。"}
{"id": null, "n": "0110001", "target": "#nkr_note_orig_0110001", "type": "orig", "text": "此處重復一段經文及一個頌： 「得如是無量福德。頌曰：信根生一念，諸佛盡能知。生因於此日，證果未來時。「三大經多劫，六度久安施。熏成無漏種，方號不思議。何以故？是諸眾生無復我相、人相、眾生相、壽者相、無法相、亦無非法相。何以故？是諸眾生，若心取相，則為著我、人、眾生。」"}
{"id": null, "n": "0110002", "target": "#nkr_note_orig_0110002", "type": "orig", "text": "「亦空」，底本無，據石本補。"}
{"id": null, "n": "0110003", "target": "#nkr_note_orig_0110003", "type": "orig", "text": "「有無情」，底本無，據石本補。"}
{"id": null, "n": "0111001", "target": "#nkr_note_orig_0111001", "type": "orig", "text": "「無有定法名阿耨多羅三藐三菩提，亦」，底本無，據羅什譯本補。"}
{"id": null, "n": "0112001", "target": "#nkr_note_orig_0112001", "type": "orig", "text": "「阿」，底本無，據羅什譯本補。"}
{"id": null, "n": "0112002", "target": "#nkr_note_orig_0112002", "type": "orig", "text": "「而實無不來」，底本無，據羅什譯本補。"}
{"id": null, "n": "0113001", "target": "#nkr_note_orig_0113001", "type": "orig", "text": "「人」，底本無，據羅什譯本補。"}
{"id": null, "n": "0113002", "target": "#nkr_note_orig_0113002", "type": "orig", "text": "「世尊，我」，底本無，據羅什譯本補。"}
{"id": null, "n": "0113003", "target": "#nkr_note_orig_0113003", "type": "orig", "text": "「智」，底本作「知」，據石本改。"}
{"id": null, "n": "0113004", "target": "#nkr_note_orig_0113004", "type": "orig", "text": "「不也」，底本無，據羅什譯本補。"}
{"id": null, "n": "0114001", "target": "#nkr_note_orig_0114001", "type": "orig", "text": "「者」，底本作「者者」，據羅什譯本刪。"}
{"id": null, "n": "0114002", "target": "#nkr_note_orig_0114002", "type": "orig", "text": "「如」，底本無，據羅什譯本補。"}
{"id": null, "n": "0114003", "target": "#nkr_note_orig_0114003", "type": "orig", "text": "「王」，底本無，據羅什譯本補。"}
{"id": null, "n": "0114004", "target": "#nkr_note_orig_0114004", "type": "orig", "text": "「諸」，底本無，據羅什譯本補。"}
{"id": null, "n": "0115001", "target": "#nkr_note_orig_0115001", "type": "orig", "text": "「有」，底本無，據羅什譯本補。"}
{"id": null, "n": "0115002", "target": "#nkr_note_orig_0115002", "type": "orig", "text": "「是名般若波羅蜜」，底本無，據羅什譯本補。"}
{"id": null, "n": "0116001", "target": "#nkr_note_orig_0116001", "type": "orig", "text": "「槃」，底本作「般」，據石本改。"}
{"id": null, "n": "0117001", "target": "#nkr_note_orig_0117001", "type": "orig", "text": "「便」，底本無，據石本補。"}
{"id": null, "n": "0119001", "target": "#nkr_note_orig_0119001", "type": "orig", "text": "「五」，底本作「吾」，據羅什譯本改。"}
{"id": null, "n": "0119002", "target": "#nkr_note_orig_0119002", "type": "orig", "text": "「語」，底本無，據羅什譯本補。"}
{"id": null, "n": "0120001", "target": "#nkr_note_orig_0120001", "type": "orig", "text": "「此」，底本作「無此」，據羅什譯本刪。"}
{"id": null, "n": "0121001", "target": "#nkr_note_orig_0121001", "type": "orig", "text": "「為」，底本無，據羅什譯本補。"}
{"id": null, "n": "0121002", "target": "#nkr_note_orig_0121002", "type": "orig", "text": "「三」，底本作「三菩」，據羅什譯本刪。"}
{"id": null, "n": "0121003", "target": "#nkr_note_orig_0121003", "type": "orig", "text": "「成」，底本無，據石本補。"}
{"id": null, "n": "0121004", "target": "#nkr_note_orig_0121004", "type": "orig", "text": "「若」，底本無，據羅什譯本補。"}
{"id": null, "n": "0121005", "target": "#nkr_note_orig_0121005", "type": "orig", "text": "「須菩提」，底本無，據羅什譯本補。"}
{"id": null, "n": "0124001", "target": "#nkr_note_orig_0124001", "type": "orig", "text": "「沙」，底本無，據羅什譯本補。"}
{"id": null, "n": "0125001", "target": "#nkr_note_orig_0125001", "type": "orig", "text": "「德」，底本無，據羅什譯本補。"}
{"id": null, "n": "0125002", "target": "#nkr_note_orig_0125002", "type": "orig", "text": "「眾」，底本作「眾眾」，據羅什譯本刪。"}
{"id": null, "n": "0126001", "target": "#nkr_note_orig_0126001", "type": "orig", "text": "「是名凡夫」，底本無，據羅什譯本補。"}
{"id": null, "n": "0127001", "target": "#nkr_note_orig_0127001", "type": "orig", "text": "「持用」，底本無，據羅什譯本補。"}
{"id": null, "n": "0127002", "target": "#nkr_note_orig_0127002", "type": "orig", "text": "「何以故」，底本無，據羅什譯本補。"}
{"id": null, "n": "0128001", "target": "#nkr_note_orig_0128001", "type": "orig", "text": "「不也」，底本無，據羅什譯本補。"}
{"id": null, "n": "0128002", "target": "#nkr_note_orig_0128002", "type": "orig", "text": "「眾生見」，底本無，據羅什譯本補。"}
{"id": null, "n": "0129001", "target": "#nkr_note_orig_0129001", "type": "orig", "text": "「比丘」，底本無，據羅什譯本補。"}
{"id": null, "n": "0130001", "target": "#nkr_note_orig_0130001", "type": "orig", "text": "卷末有題記「廣順三年癸丑歲八月二十一日，畢手。」"}
