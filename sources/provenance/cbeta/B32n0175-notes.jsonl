{"id": null, "n": null, "target": null, "type": null, "text": "311"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】卷下群本有之字。序字群本無。"}
{"id": null, "n": null, "target": null, "type": null, "text": "榮西"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】前以下十字壽本作律師二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】也下壽本有末代二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】也字傍原本有假名ハ字今改為句點。壽本無也字。而\n有人倫二字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】曾壽水作昔"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】矣壽本作之"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】古原本作吉今據群本"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】古以下七字壽本作從昔以來自國他國俱尚之。今更可指乎況末量養生之良藥也廿五字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】摘乎二字壽本作斟酌矣三字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】人以下五字壽本作時人四大〔地肉\n骨水血火煖氣風動作力〕堅固與諸天身同廿三字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】今以下十二字壽本作末世時人骨肉怯弱如朽木矣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】然者二字壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】傷壽本作痛"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】詳本作如"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】此字壽本作其"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】不字壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】昔以下十五字壽本無。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】以字壽本在像下"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】期下壽本有以字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】命下群本有以字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】源上壽本有根字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】于壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】術下壽本有計字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】壽本注云肝心脾肺又藏作臟下同。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本作主"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】壽本作心藏建立"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】厥下壽本有\n忘字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】弱字壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】皆以下三字壽本作無力也。忘\n五藏則身命有厄乎十二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】而下壽本有隔字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】診壽本作間"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】而下壽\n本有送字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】傍訓原本作今據群壽兩本"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】危原本及壽本作厄。今從群本"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】炙壽本改失恐非"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】而壽本作即"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】與原本無。今據群本。壽本作而。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】贈群本作賜"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】昆壽本作"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】年群本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】歲群本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】建以下十一字壽本作承元五年辛未歲春正月一日十二字。應知壽本是初稿本而原本及群本是二年後之再治本"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】法字壽本作儀軌二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "木火土金水也"}
{"id": null, "n": null, "target": null, "type": null, "text": "東南西北中也〔【考】群本作東西南北中也〕"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】末壽本作終"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】同下壽本有一藏二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】醎下壽本有之字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】而壽本作之"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】恆群本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】病下壽本注云其病日本名云心助也"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】食下壽本有萬物二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】喫壽本作用"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】心以下六字壽本作治心藏為令無病也八字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】之字壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】日以下八字壽本作自國他國調菜之味同之皆以缺苦味乎十六字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】獨字壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】故字壽本作我國不喫茶大國人八字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】也字壽本作不得長病羸瘦乎七字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】多群本作與"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】多以下五字\n壽本作人心藏有病多長病羸瘦乎十一字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】人下壽本有五藏不調四字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】爾壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】可壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】云字壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】古群本作鈷"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】誦原本作訓今從群壽兩本"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】梵字群本作梵怛羅字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本壽本形下有印字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】梵字下壽本有怛羅字三字。群本作梵乞里字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本也下有即字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】梵字下壽本有乞里字三字。群本作梵吽字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本摩作磨"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本也下有即"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】磨壽本作摩"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】梵字下壽本有惡字二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】則壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】古群本\n作鈷"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】梵字下壽本有鍐字二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】則壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】方壽本作術"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本療作病"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】治壽本作持。而傍有治歟二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】柚下壽本有酢字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本無也"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】又以下九字壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本者下有是"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】之壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】苦字壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】味下壽\n本有之字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】味下壽本群本有之字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】首群本作味"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】心以下四字壽本作以此味建立此藏七字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本也下有以"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群\n本之下有若"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本醎下有性"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本無之字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本作又"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】一以下四字壽本作一者叨名字章六字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】爾上群本有檟字。檟苦茶群壽兩本檟ハ苦茶ナリト牒ム似是"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】茆下群本有冬㭟二字注。注有按茆今本不見六字"}
{"id": null, "n": null, "target": null, "type": null, "text": "西蜀國之名也"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本無都字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】外諸二字壽本作有此處一切七字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】亦壽本作必。群本作又"}
{"id": null, "n": null, "target": null, "type": null, "text": "茶也"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】外即二字壽本作有此處三字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】相近以下十一字壽本作并人竺相近五字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】即壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】傳以下四字壽本作生於此三字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本作又"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本也下有茶字壽本有仍字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本無也字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】厄群本作危"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】多壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】子下壽本有客人強多喫之六字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】多壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】人下壽本有來字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】仍下壽本有貴重二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】極貴重三字壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "茶也"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】也群本無。更有茗苦澀謂之過羅六字注"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】羽壽本作州"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】茶下群本有早取謂之四字注"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】檟下群本有周公謂之四字注"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】蔎下群本有南人謂之四字注"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】茗下群本有晚取謂之四字注"}
{"id": null, "n": null, "target": null, "type": null, "text": "加茆為六"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本茗下有葉也二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】二以下七字壽本作二者明樹形花葉形章九字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本木下有葉其色白四字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】花群一本作葉"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本無花其色白云云六字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】也下壽本群本有云云二字。群本云\n云下有注云實如栟櫚蔕如丁香如胡桃"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】三以下四字壽本作三者明功能章六字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本願注云\n按茶經茆作舜。壽本無云云二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】也下壽本有君子召物皆名稱供御九字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】哉下壽本有茶乎二字。群本無貴哉二字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】焉群本作云云二字。原本焉字傍有假\n\n名二不審"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】云下壽本有眠萬病\n之根源也無病不眠十一字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本令下有人字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】少壽本作小"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】眠下壽本有者字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】昧以下七字壽本作鈍根二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本有下有力字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】傍訓歟壽本左傍有訓"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】壽\n本作小"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本作疾壽本作痤"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本無云云二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】病\n壽本作不豫二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本作云云。非也"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】也下壽本有宿食三日五日食也八字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】花他群本作華陀"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本意思二字作思意二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】身以下九字壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】云字壽本無。而更有韮草此方無之韮之類也十字。群本願注云按茶經服作食。自作體。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本無\n云云二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】也下壽本有脚氣妙藥何物如之哉九字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】原作桐據壽本群本改"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】眠下群本有云云二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】也下群本有云云二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】壽本無云云二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】五內也三字壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】也下壽本有\n治五藏不和在茶而已又五內云也十四字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】盂群本壽本作孟"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本頭注云按茶　清作情"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】土群本作物"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】聊壽本作所"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】六以下六字壽本作六根清明云六清也八字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】城群本作城。壽本無區者城也四字。而有漢地九分立州今卅六群〔【考】群恐郡字〕三百六十八州十六字注"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】茶以下八字壽本作生苟者生用菜。身安樂無病云也。苟則菜也。可娛者\n樂也廿三字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】依群本作作字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】眠壽本作睡"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本無\n云云二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "廣州以下至此州七字壽本作廣州之洋有孤絕之島稱曰海南。又云廣南也。又近近有多洲渚。此等皆稱日南也。今南人即是等也。廣州\n即四十二字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此方赤蟲病云也〔【考】群本無也字〕"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】補受領壽本作知州二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】歸下壽本有\n北方二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】喫下壽本有食字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】若壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】喫下壽本有多食二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】身下壽本有\n藏不存百之一也。無寒之地故十二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】壽本云云二字作是字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】輕下壽本有而可飛三字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】非以下七字\n壽本作非百姓下人所宜故貴重而如此云也十五字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】睡群本作眠"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】食以下六字壽本無。眠群本作病。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】或原本作惑。今據群本。壽本無。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】茶下壽本有字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】也下壽本有淺\n茶非也六字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】日群本作目壽本無明日二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】盃群本作盂"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】也字壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】等必二字壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】也上壽本群本有故字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】四以下五字壽本作四者明採茶時節章八字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】二月下壽本群本有三月二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】云云二字壽本作也一字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】冬下壽本有中字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】造下壽本有則字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】民壽本作百姓民下群本有之字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】之字群本無。之下壽本有過之二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】茶下群壽兩本俱有云云二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】儀群本作義"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】比群本作此壽本作此比二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】來下壽本有終日二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】芽字群本壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】銀群本作錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】鑷子壽本作毛拔"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】䗶群本作蠟。壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】五以下四字壽本作五者明採茶樣章七字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】亦群本作又字。壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】雲下壽本有亦字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】六以下四字壽本作六者明調樣章六字。【考】原本作茶調樣今據群本。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】則壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】樣壽本作許"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】火下壽本有入字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】急群本作怠"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】竟壽本作終"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】可以下五字壽本作焙上二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】封以下八字壽本作閇一字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】千群本壽本作年"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】矣下壽本有欲採時人夫并食物炭薪巨多割置而後採之而已廿字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】已上字壽本作右。法下同有記錄二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】國下壽本有醫道之三字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】茶下壽本有之字"}
{"id": null, "n": null, "target": null, "type": null, "text": "榮西"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】給忠臣三字壽本作帝王有忠臣必給茶八字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】施高僧三字壽本作僧說妙法則施茶七字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】儀\n群本作義"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】壽本作今昔同儀"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】唐醫以下至之矣\n卅字壽本作式只在茶之法。若不喫茶昔諸藥無効。心藏弱故也。庶幾末代上中下諸人悉之。今依仰撰之後不可添削矣四十二字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本卷字下有之字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本上下有終字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】卷下群本有之字。始字壽本無。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】前以下十字壽本作律師二字。\n位字群本無。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】于壽本作之"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】誦下群壽兩\n本有者字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】復下壽本有依字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】祈三寶壽本作三寶祈請"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本無\n還字"}
{"id": null, "n": null, "target": null, "type": null, "text": "略鈔"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】年群本作歲"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】也下壽本有即彼儀軌有印術而已。榮西恆得此意治之多有驗矣廿一字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本作頃"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】即以下八字壽本無。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】一下壽本有者字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】冷氣二字壽本作喫濃味則以鹽味為厄九字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】佗原本似仵。今從群本"}
{"id": null, "n": null, "target": null, "type": null, "text": "忌薤是〔【考】鬼病以下全文壽本還增故作鬼病必惡葷腥耳。〕"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】二下壽本有者字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】近至矣六字壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】亦原本作赤。群本作又。壽本無。今改亦。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】等壽本作濕氣"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】出血壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】流汗壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】害壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】永以下五字壽本作若不近火不浴湯七字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】常時壽本作平體時三字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本作如"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】漫漫以下全文壽本作漫漫治則漸平復。是又服桑粥桑湯。若欲沐浴時煎桑湯行水一桶二桶。三五日一度浴之。浴時不\n垂汗是治方也。若湯氣上則必不食故也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】三下壽本有者字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】復壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】冷氣壽本作濕氣"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】好浴上壽本有好火二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】流以下四字壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】粥下壽本有桑字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】答群本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】忩群本作忩"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】弱壽本作增"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】發壽本作起"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】故以下四字壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】是壽本作又"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】多壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】故壽本作也"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】桑下壽本有\n木字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】桑下至也十二字壽本作必有効三字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】矣壽本作々々二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】四下壽本有者字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】近以下四字壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】等以下四字壽本作冷\n氣而三字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本作疔"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】非丁以下五字壽本作非癰丁等之惡瘡七字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】識\n壽本作知"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】但以下八字壽本作但起於冷氣故六字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】少壽本群本作小"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】依此二字壽本作因不負火四字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】少群本作小"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本作壯"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】第二可忌群本作云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "皆瘡妙藥〔【考】藥下群本有也字〕"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】炙則以下全文凡十二行壽本有少差如左。近年以來。瘡大小俱炙\n則腫增。腫增則無治也。火毒無能治者故也。水寒石寒為厄矣。決定應\n死之業何依炙可活。不定業雖不炙何死哉。不炙活者多。炙活者少。\n尤可斟酌。若瘡出則不問強軟。不知善惡。牛膝根擣絞以汁付瘡。乾又\n付則不腫傍。只瘡許腫熟破無事矣。是服桑粥桑湯。兼服五香煎矣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】五下壽本有者字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】滿下壽本有若字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】而飽壽本作食一字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】飯酒群本作酒食"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】午後以下八字壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】亦壽本群本作又"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】湯下壽本有又服二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】薑下壽本有并字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】奇以下七字壽本作為妙治矣四字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】比群本作頃"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】近比以下全文凡二行壽本無。第二為奇群本作云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本無然字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】桑下壽\n本有木字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】事壽本作之"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】頗以下九字壽本無。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】亦群本作又"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】致夭群本作□大"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】病壽本作氣"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】病字傍恐誤"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】病群本作痛"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】亦桑以下全文凡七行壽本頗異如左。桑樹是過去諸佛成道之靈木\n也。以此樹為乳木護摩時鬼魅悉退散馳走。又患災法相應木也。桑樹下\n鬼魅不來。是故此樹為萬病之藥也。若人携。此木為念珠為杖為枕天\n魔尚以不得便。況諸餘下劣鬼魅附近乎。是以榮西以此木治諸病無\n不得効驗矣。有情人察之。近年以來病皆為冷氣侵故。桑是第一之治\n方也。人不知此旨多致夭害。瘡稱惡瘡。諸病稱脚病。竝是惡。附高\n大之名不知所治。尤不便事。惡瘡無藥脚病無治。故云惡也勿就矣。\n脚病無治者近年痛脚則冷氣故也。不用冷氣故脚病不可平癒。惡瘡\n無藥者近年以來無惡瘡。只是冷氣雜熱故。今名惡瘡則無治方也。\n因名得力增氣勢故也。以桑木治之自得其驗矣。桑方在左注之。"}
{"id": null, "n": null, "target": null, "type": null, "text": "灼料〔【考】灼群本作炊〕"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本剪作煎"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本無即字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】藥下群本有也字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】宋朝以下全文凡六行壽本如左　黑豆一把。桑枝口一寸長三寸。\n〔【考】若納指許可計〕細破與豆俱入水三升〔【考】炊料〕煮之。豆桑破煎即\n取木加米一把。隨水多少煮浮粥也。冬夜鷄鳴之期夏夜半以前初煮。\n夜明即煮畢空心服之不副鹽。少分服後含御菜也。每朝無懈。久煮為\n藥頓煮非藥。若無効可知不熟煮也。朝食之其日不引水不醉酒。身心\n靜也。信心有驗矣。竪粥無効。但不似餘物也。〔【考】桑當年生枝粥煎\n共彌妙之無者亦不之〕"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】桑煎法群本在服桑木法後"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本作計"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】或原本作惑。今據群本"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】復群本作又"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】脚氣群本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】拘攣原本似物攣今依群本改"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本少作小"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】此章壽本如左　截桑枝如雙六截破燥之。木角燋許燥之割置。三\n升五升可盛袋歟。久持彌好乎。臨時水一升許入木半合許煎之服之。\n或不燥而煎服無失。生木又不苦矣。水氣脚氣癰腫風氣皆治矣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】服桑木法群本在桑煎法前"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】鋸截壽本作以鋸截之四字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】撮壽本作取"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】氣下壽本有又字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】是以下四字壽本作仙術在之"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】恆以下八字壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】此章壽本少差如左。如齒木削之。常口含之。口無病齒無失。口\n常香。魔不附近。末代醫術何事如之哉。以根作彌好。土下三尺入\n者妙也。土上自有毒。土下個無毒矣。口咼目咼皆治直也。人皆所\n知也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】造下壽本有之字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】亦壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】矣壽本作不能註過之"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】十月壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】干下群本有和合二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】此章又影干以下壽本同一葉可惜"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本服下有之字"}
{"id": null, "n": null, "target": null, "type": null, "text": "日本桑頗力微"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】契丹原本作熱舟據群本改"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本許作計"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本比作頃"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】原作折據群本改"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本小作少"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本湯下有以字"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】殊以下八字群本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】也以上十八行壽本爾。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】詳本病作疫"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】宋人歌以下全文壽本有少差如左。宋人歌云。疫神捨駕禮茶水。\n是故本草拾遺云〔【注】文之名也〕止渴除疫云云。貴哉茶乎。上通神靈\n諸天境界。下資飲食侵害之人倫矣。諸藥唯主一種病。各施用力\n耳。茶為萬病之藥而已。"}
{"id": null, "n": null, "target": null, "type": null, "text": "一兩"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】壽本云其性苦辛"}
{"id": null, "n": null, "target": null, "type": null, "text": "一分"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】壽本云其性苦辛"}
{"id": null, "n": null, "target": null, "type": null, "text": "二分"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】丁下群壽兩本有子字。又壽本云其性苦辛"}
{"id": null, "n": null, "target": null, "type": null, "text": "一分"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】壽本云其性苦辛"}
{"id": null, "n": null, "target": null, "type": null, "text": "少少"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】少少群本作少一字。少少下壽本有大熱故不多加也七字。次云其性苦辛"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】服下群本有之字"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】右五種以下全文壽本有參差如左。右五種同時和合。末每服一錢\n沸湯點服。或煎服其用弱〔【注】不末只煎〕五香和合之志為令服青木香\n也。或只青木香服之意治心藏也。榮西昔在唐時。從天台山到明州\n時六月十日也。天極熱人皆氣絕乎。于時店主取銚子盛十子〔【考】十\n子恐丁子〕八分。即添水滿銚子良久煎之。不知何要乎。煎了茶盞\n\n之大滴入。持來與榮西令服。偁。法師天熱之時遠涉路來。汗多流。\n恐有不快。仍與令服也云云。令炊一升水一升一半歟。煎只二\n合許也。其後身涼心地清潔也。以知大熱之時能涼。大寒之時能溫\n也。此五種隨一有此德。不可不知矣。冬月到亦同前。云云。五香\n煎德與茶同。仍可服也。五香不整足者隨一可服歟。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】已字群本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云前出之"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】已上以下全文壽本參差如左　已上末世養生記。蒙佛加被一一記\n錄畢。是唯依大國口傳。非自由之情。以此方治諸病。見之無相違\n乎。抑桑木是仙藥也。仙人有二種仙人。一苦行仙。二服藥仙也。苦\n行仙者斷食味。服一米一粟等久活命。服藥仙者。服種種藥以久保命。\n其中服桑木仙能久保也。上件桑治方勝諸方。是依為仙藥也。本草\n云。煎桑枝服療水氣肺氣脚氣癰腫兼風氣。常服療遍體風痒乾燥又\n治。眠暈歟又消食利小便身輕耳目聽明。令人光澤。又療口乾矣。仙\n經云。一切仙藥不得桑煎則不服云云。先服桑煎後服諸仙藥。以知\n桑是又仙藥之上首乎。茶與桑竝服。貴重無高下。二俱仙藥之上首。\n養生之妙術而已。此等記錄皆有所又稟承在大國乎。不春之到大\n國詢之。無隱歟。今依仰之旨錄上。後時不改章矣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】群本下字下有終字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】云群本作之"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】已群本作也"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】此後聞記壽本無"}
{"id": null, "n": null, "target": null, "type": null, "text": "己丑"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上四時也"}
{"id": null, "n": null, "target": null, "type": null, "text": "辛未"}
{"id": null, "n": null, "target": null, "type": null, "text": "（校訂史料綱篡掛影寫本用）"}
{"id": null, "n": null, "target": null, "type": null, "text": "（再治本）"}
