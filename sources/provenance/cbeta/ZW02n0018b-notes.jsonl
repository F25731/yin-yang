{"id": null, "n": "0170003", "target": "#nkr_note_orig_0170003", "type": "orig", "text": "「由常看守心故」，底本殘，據伯2039號補。"}
{"id": null, "n": "0170004", "target": "#nkr_note_orig_0170004", "type": "orig", "text": "「惑」，底本作「或」，據文意改。"}
{"id": null, "n": "0170005", "target": "#nkr_note_orig_0170005", "type": "orig", "text": "「中不令亂。故《維摩經》云：念定」，底本殘，據伯2039號補。其中「云」，伯2039號無，據文意補。"}
{"id": null, "n": "0170006", "target": "#nkr_note_orig_0170006", "type": "orig", "text": "引文出自《維摩經．佛國品》。見《大正藏》第14卷第537頁上。"}
{"id": null, "n": "0171001", "target": "#nkr_note_orig_0171001", "type": "orig", "text": "「云」，底本作「云悟心」，據文意刪。"}
{"id": null, "n": "0171002", "target": "#nkr_note_orig_0171002", "type": "orig", "text": "「心」，據底本殘存字形及伯2039號補。"}
{"id": null, "n": "0171003", "target": "#nkr_note_orig_0171003", "type": "orig", "text": "「言」，據底本殘存字形及伯2039號補。"}
{"id": null, "n": "0171004", "target": "#nkr_note_orig_0171004", "type": "orig", "text": "「息心者，由常」，底本殘，據本號體例及伯2039號補。"}
{"id": null, "n": "0171005", "target": "#nkr_note_orig_0171005", "type": "orig", "text": "「名」，底本殘，據文意補。"}
{"id": null, "n": "0171006", "target": "#nkr_note_orig_0171006", "type": "orig", "text": "「息心」，底本殘，據本號體例及伯2039號補。"}
{"id": null, "n": "0171007", "target": "#nkr_note_orig_0171007", "type": "orig", "text": "「言」，底本殘，據伯2039號補。"}
{"id": null, "n": "0171008", "target": "#nkr_note_orig_0171008", "type": "orig", "text": "「數」，據底本殘存字形及伯2039號補。"}
{"id": null, "n": "0171009", "target": "#nkr_note_orig_0171009", "type": "orig", "text": "「法，攀」，底本殘，據伯2039號補。"}
{"id": null, "n": "0171010", "target": "#nkr_note_orig_0171010", "type": "orig", "text": "「緣」，據底本殘存字形及伯2039號補。"}
{"id": null, "n": "0171011", "target": "#nkr_note_orig_0171011", "type": "orig", "text": "「心」，底本無，據伯2039號本補。"}
{"id": null, "n": "0171012", "target": "#nkr_note_orig_0171012", "type": "orig", "text": "「由常看守心故，知心去、來、生、滅悉常善。故云『知心』」，底本無，據本號體例及伯2039號補。"}
{"id": null, "n": "0171013", "target": "#nkr_note_orig_0171013", "type": "orig", "text": "「言止心者」，底本無，據本號體例及伯2039號補。"}
{"id": null, "n": "0172001", "target": "#nkr_note_orig_0172001", "type": "orig", "text": "「滑」，底本作「謂」，據伯2039號改。"}
{"id": null, "n": "0172002", "target": "#nkr_note_orig_0172002", "type": "orig", "text": "「愛」，底本無，據伯2039號補。"}
{"id": null, "n": "0172003", "target": "#nkr_note_orig_0172003", "type": "orig", "text": "引文出自《維摩詰經．見阿閦佛品》，見《大正藏》第14卷第554頁下。"}
{"id": null, "n": "0172004", "target": "#nkr_note_orig_0172004", "type": "orig", "text": "此段引文見《維摩詰經．見阿閦佛品》，見《大正藏》第14卷第555頁上。引文中「若自觀者」，《維摩詰經》原文作「以斯觀者」。"}
{"id": null, "n": "0172005", "target": "#nkr_note_orig_0172005", "type": "orig", "text": "「邪」，底本作「耶」，據文意改。下同。"}
{"id": null, "n": "0173001", "target": "#nkr_note_orig_0173001", "type": "orig", "text": "「慧」，底本作「惠」，此處「慧」、「惠」相通，故正作「慧」。下同。"}
{"id": null, "n": "0173002", "target": "#nkr_note_orig_0173002", "type": "orig", "text": "引文出自《大正藏》第9卷第58頁上。"}
{"id": null, "n": "0173003", "target": "#nkr_note_orig_0173003", "type": "orig", "text": "「測」，底本作「惻」，據文意改。"}
{"id": null, "n": "0173004", "target": "#nkr_note_orig_0173004", "type": "orig", "text": "「門」，底本無，據文意補。"}
{"id": null, "n": "0173005", "target": "#nkr_note_orig_0173005", "type": "orig", "text": "「安」，底本作「般」，據文意改。"}
{"id": null, "n": "0173006", "target": "#nkr_note_orig_0173006", "type": "orig", "text": "「間」，底本作「聞」，據文意改。"}
{"id": null, "n": "0174001", "target": "#nkr_note_orig_0174001", "type": "orig", "text": "引文出自《佛為心王菩薩說頭陀經》，原文作「五陰以為車，無相以為牛，調御以一心，運載諸群生，趣向波若洲。」參見《藏外佛教文獻》第一輯第281頁。"}
{"id": null, "n": "0174002", "target": "#nkr_note_orig_0174002", "type": "orig", "text": "「有」，底本無，據文意補。"}
{"id": null, "n": "0174003", "target": "#nkr_note_orig_0174003", "type": "orig", "text": "「根，外有六塵」，底本殘，據殘存字形及文意補。"}
{"id": null, "n": "0174004", "target": "#nkr_note_orig_0174004", "type": "orig", "text": "「界」，底本作「戒」，據文意改。"}
{"id": null, "n": "0174005", "target": "#nkr_note_orig_0174005", "type": "orig", "text": "「入」，底本作「人」，據文意改。"}
