{"id": null, "n": null, "target": null, "type": "cf1", "text": "F03n0298_p0610a22"}
{"id": null, "n": "0756005", "target": "#nkr_note_mod_0756005", "type": "mod", "text": "佛說【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0756006", "target": "#nkr_note_mod_0756006", "type": "mod", "text": "月支國居士【大】，代【宋】【元】，優婆塞【明】，月支優婆塞【宮】"}
{"id": null, "n": "0756007", "target": "#nkr_note_mod_0756007", "type": "mod", "text": "王【大】＊，主【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0756008", "target": "#nkr_note_mod_0756008", "type": "mod", "text": "志【大】，心【宋】【元】【明】"}
{"id": null, "n": "0756009", "target": "#nkr_note_mod_0756009", "type": "mod", "text": "上【大】，上生【宋】【元】【明】"}
{"id": null, "n": "0756010", "target": "#nkr_note_mod_0756010", "type": "mod", "text": "今【大】，念【宮】"}
{"id": null, "n": "0756011", "target": "#nkr_note_mod_0756011", "type": "mod", "text": "尊【大】，貴【宋】【元】【明】【宮】"}
{"id": null, "n": "0757001a", "target": "#nkr_note_mod_0757001a", "type": "mod", "text": "與得佛身其福正等【大】，得福得道與待佛身正等【宋】，得福得道與侍佛身正等【元】【明】【宮】"}
{"id": null, "n": "0757001b", "target": "#nkr_note_mod_0757001b", "type": "mod", "text": "阿難又言願佛為我解釋四事【大】，難白佛為我解說四事【宋】【元】【明】【宮】"}
{"id": null, "n": "0757001c", "target": "#nkr_note_mod_0757001c", "type": "mod", "text": "世尊曰當以【大】，佛言當【宋】【元】【明】【宮】"}
{"id": null, "n": "0757002", "target": "#nkr_note_mod_0757002", "type": "mod", "text": "也【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0757003", "target": "#nkr_note_mod_0757003", "type": "mod", "text": "勿【大】，愚【宋】【元】【明】【宮】"}
{"id": null, "n": "0757004", "target": "#nkr_note_mod_0757004", "type": "mod", "text": "寶【大】，寶重【宋】【元】【明】【宮】"}
{"id": null, "n": "0757005", "target": "#nkr_note_mod_0757005", "type": "mod", "text": "賙【大】，周【宋】【元】【明】【宮】"}
{"id": null, "n": "0757006", "target": "#nkr_note_mod_0757006", "type": "mod", "text": "計【大】，忖【宋】【元】【明】"}
{"id": null, "n": "0757007", "target": "#nkr_note_mod_0757007", "type": "mod", "text": "二【大】，姻【宋】【元】【明】，恩【宮】"}
{"id": null, "n": "0757008", "target": "#nkr_note_mod_0757008", "type": "mod", "text": "日【大】，曰【宋】【元】"}
{"id": null, "n": "0757009", "target": "#nkr_note_mod_0757009", "type": "mod", "text": "切【大】，剋【宋】【元】【明】【宮】"}
{"id": null, "n": "0757010", "target": "#nkr_note_mod_0757010", "type": "mod", "text": "困【大】，因【宋】【元】【明】"}
{"id": null, "n": "0757011", "target": "#nkr_note_mod_0757011", "type": "mod", "text": "行【大】，存【宋】【元】【明】【宮】"}
{"id": null, "n": "0757012", "target": "#nkr_note_mod_0757012", "type": "mod", "text": "教【大】，法【宋】【元】【明】【宮】"}
{"id": null, "n": "0757013", "target": "#nkr_note_mod_0757013", "type": "mod", "text": "鍮【大】，塗【宮】"}
{"id": null, "n": "0757014", "target": "#nkr_note_mod_0757014", "type": "mod", "text": "與【大】，得【宋】【元】【明】【宮】"}
{"id": null, "n": "0757015", "target": "#nkr_note_mod_0757015", "type": "mod", "text": "命【大】，死【宮】"}
{"id": null, "n": "0757016", "target": "#nkr_note_mod_0757016", "type": "mod", "text": "也【大】，世【宋】【元】【明】【宮】"}
{"id": null, "n": "0757017", "target": "#nkr_note_mod_0757017", "type": "mod", "text": "國中【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0757018", "target": "#nkr_note_mod_0757018", "type": "mod", "text": "流布【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0757019", "target": "#nkr_note_mod_0757019", "type": "mod", "text": "毒【大】，毒氣【宋】【元】【明】"}
{"id": null, "n": "0757020", "target": "#nkr_note_mod_0757020", "type": "mod", "text": "墮海中為龍【大】，海中【宋】【元】【明】【宮】"}
{"id": null, "n": "0757021", "target": "#nkr_note_mod_0757021", "type": "mod", "text": "太【大】，大【宋】【元】【明】【宮】"}
{"id": null, "n": "0757022", "target": "#nkr_note_mod_0757022", "type": "mod", "text": "因【大】，故【宋】【元】【明】【宮】"}
{"id": null, "n": "0757023", "target": "#nkr_note_mod_0757023", "type": "mod", "text": "惡【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0757024", "target": "#nkr_note_mod_0757024", "type": "mod", "text": "中【大】，土【宋】【元】【明】【宮】"}
{"id": null, "n": "0757025", "target": "#nkr_note_mod_0757025", "type": "mod", "text": "污【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0757026", "target": "#nkr_note_mod_0757026", "type": "mod", "text": "皆由【大】，此皆【宋】【元】【明】【宮】"}
{"id": null, "n": "0757027", "target": "#nkr_note_mod_0757027", "type": "mod", "text": "手自【大】，自手【宋】【元】【明】【宮】"}
{"id": null, "n": "0757028", "target": "#nkr_note_mod_0757028", "type": "mod", "text": "不相塗污【大】，〔－〕【宮】"}
{"id": null, "n": "0757029", "target": "#nkr_note_mod_0757029", "type": "mod", "text": "聽聰【大】，聰明【宋】【元】【明】【宮】"}
{"id": null, "n": "0757030", "target": "#nkr_note_mod_0757030", "type": "mod", "text": "追【大】，遺【宋】【元】【明】"}
{"id": null, "n": "0757031", "target": "#nkr_note_mod_0757031", "type": "mod", "text": "護【大】，捨【宋】【元】【明】"}
{"id": null, "n": "0757032", "target": "#nkr_note_mod_0757032", "type": "mod", "text": "家【大】，害【宮】"}
{"id": null, "n": "0757033", "target": "#nkr_note_mod_0757033", "type": "mod", "text": "之【大】，肉【宋】【元】【明】【宮】"}
{"id": null, "n": "0757034", "target": "#nkr_note_mod_0757034", "type": "mod", "text": "王【大】＊，主【明】＊"}
{"id": null, "n": "0757035", "target": "#nkr_note_mod_0757035", "type": "mod", "text": "富【大】，當【宋】【元】【明】【宮】"}
{"id": null, "n": "0757036", "target": "#nkr_note_mod_0757036", "type": "mod", "text": "篤【大】，苦【宋】【元】【明】"}
{"id": null, "n": "0757037", "target": "#nkr_note_mod_0757037", "type": "mod", "text": "活【大】，治【宋】【元】【明】【宮】"}
{"id": null, "n": "0757038", "target": "#nkr_note_mod_0757038", "type": "mod", "text": "令【大】，今【明】"}
{"id": null, "n": "0757039", "target": "#nkr_note_mod_0757039", "type": "mod", "text": "言輒【大】，輒言【宋】【元】【明】"}
{"id": null, "n": "0757040", "target": "#nkr_note_mod_0757040", "type": "mod", "text": "臣【大】＊，人【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0757041", "target": "#nkr_note_mod_0757041", "type": "mod", "text": "稟【大】，彼【宋】【元】【明】【宮】"}
{"id": null, "n": "0757042", "target": "#nkr_note_mod_0757042", "type": "mod", "text": "之遺典也【大】，說之遺典【宋】【元】【明】，之遺典【宮】"}
{"id": null, "n": "0757043", "target": "#nkr_note_mod_0757043", "type": "mod", "text": "洋【大】，烊【宮】"}
{"id": null, "n": "0757044", "target": "#nkr_note_mod_0757044", "type": "mod", "text": "自斷手【大】，就斷首【宋】【元】【明】【宮】"}
{"id": null, "n": "0757045", "target": "#nkr_note_mod_0757045", "type": "mod", "text": "剖【大】，割【宋】【元】【明】【宮】"}
{"id": null, "n": "0757046", "target": "#nkr_note_mod_0757046", "type": "mod", "text": "群【大】，群邪【宋】【元】【明】【宮】"}
{"id": null, "n": "0757047", "target": "#nkr_note_mod_0757047", "type": "mod", "text": "護【大】，故【宋】【元】【明】【宮】"}
{"id": null, "n": "0757048", "target": "#nkr_note_mod_0757048", "type": "mod", "text": "臣【大】，人【明】"}
{"id": null, "n": "0757049", "target": "#nkr_note_mod_0757049", "type": "mod", "text": "務【大】，豫【宋】【元】【明】【宮】"}
{"id": null, "n": "0757050", "target": "#nkr_note_mod_0757050", "type": "mod", "text": "智【大】，知【宋】【元】【明】【宮】"}
{"id": null, "n": "0757051", "target": "#nkr_note_mod_0757051", "type": "mod", "text": "疾病【大】，病瘐【宮】"}
{"id": null, "n": "0757052", "target": "#nkr_note_mod_0757052", "type": "mod", "text": "講【大】，讚【宋】【元】【明】【宮】"}
{"id": null, "n": "0757053", "target": "#nkr_note_mod_0757053", "type": "mod", "text": "謂【大】，諸【宋】【元】【明】【宮】"}
{"id": null, "n": "0757054", "target": "#nkr_note_mod_0757054", "type": "mod", "text": "視【大】，親【宋】【元】【明】"}
{"id": null, "n": "0757055", "target": "#nkr_note_mod_0757055", "type": "mod", "text": "者也【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0757056", "target": "#nkr_note_mod_0757056", "type": "mod", "text": "廣【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0757057", "target": "#nkr_note_mod_0757057", "type": "mod", "text": "累【大】，屬累【宋】【元】【明】"}
{"id": null, "n": "0756005", "target": "#nkr_note_orig_0756005", "type": "orig", "text": "〔佛說〕－【三】【宮】＊"}
{"id": null, "n": "0756006", "target": "#nkr_note_orig_0756006", "type": "orig", "text": "月支國居士＝代【宋】【元】，優婆塞【明】，月支優婆塞【宮】"}
{"id": null, "n": "0756007", "target": "#nkr_note_orig_0756007", "type": "orig", "text": "王＝主【三】【宮】＊"}
{"id": null, "n": "0756008", "target": "#nkr_note_orig_0756008", "type": "orig", "text": "志＝心【三】"}
{"id": null, "n": "0756009", "target": "#nkr_note_orig_0756009", "type": "orig", "text": "上＋（生）【三】"}
{"id": null, "n": "0756010", "target": "#nkr_note_orig_0756010", "type": "orig", "text": "今＝念【宮】"}
{"id": null, "n": "0756011", "target": "#nkr_note_orig_0756011", "type": "orig", "text": "尊＝貴【三】【宮】"}
{"id": null, "n": "0757001", "target": "#nkr_note_orig_0757001", "type": "orig", "text": "（與得…當以）二十五字＝得福得道與侍（侍＝待【宋】）佛身正等難白佛為我解說四事佛言當【三】【宮】"}
