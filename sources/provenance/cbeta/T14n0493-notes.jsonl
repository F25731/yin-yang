{"id": null, "n": "0757016", "target": "#nkr_note_orig_0757016", "type": "orig", "text": "也＝世【三】【宮】"}
{"id": null, "n": "0757017", "target": "#nkr_note_orig_0757017", "type": "orig", "text": "〔國中〕－【三】【宮】"}
{"id": null, "n": "0757018", "target": "#nkr_note_orig_0757018", "type": "orig", "text": "〔流布〕－【三】【宮】"}
{"id": null, "n": "0757019", "target": "#nkr_note_orig_0757019", "type": "orig", "text": "毒＋（氣）【三】"}
{"id": null, "n": "0757020", "target": "#nkr_note_orig_0757020", "type": "orig", "text": "墮海中為龍＝海中【三】【宮】"}
{"id": null, "n": "0757021", "target": "#nkr_note_orig_0757021", "type": "orig", "text": "太＝大【三】【宮】"}
{"id": null, "n": "0757022", "target": "#nkr_note_orig_0757022", "type": "orig", "text": "因＝故【三】【宮】"}
{"id": null, "n": "0757023", "target": "#nkr_note_orig_0757023", "type": "orig", "text": "〔惡〕－【三】【宮】"}
{"id": null, "n": "0757024", "target": "#nkr_note_orig_0757024", "type": "orig", "text": "中＝土【三】【宮】"}
{"id": null, "n": "0757025", "target": "#nkr_note_orig_0757025", "type": "orig", "text": "〔污〕－【三】【宮】"}
{"id": null, "n": "0757026", "target": "#nkr_note_orig_0757026", "type": "orig", "text": "皆由＝此皆【三】【宮】"}
{"id": null, "n": "0757027", "target": "#nkr_note_orig_0757027", "type": "orig", "text": "手自＝自手【三】【宮】"}
{"id": null, "n": "0757028", "target": "#nkr_note_orig_0757028", "type": "orig", "text": "〔不相塗污〕－【宮】"}
{"id": null, "n": "0757029", "target": "#nkr_note_orig_0757029", "type": "orig", "text": "聽聰＝聰明【三】【宮】"}
{"id": null, "n": "0757030", "target": "#nkr_note_orig_0757030", "type": "orig", "text": "追＝遺【三】"}
{"id": null, "n": "0757031", "target": "#nkr_note_orig_0757031", "type": "orig", "text": "護＝捨【三】"}
{"id": null, "n": "0757032", "target": "#nkr_note_orig_0757032", "type": "orig", "text": "家＝害【宮】"}
{"id": null, "n": "0757033", "target": "#nkr_note_orig_0757033", "type": "orig", "text": "之＝肉【三】【宮】"}
{"id": null, "n": "0757034", "target": "#nkr_note_orig_0757034", "type": "orig", "text": "王＝主【明】＊"}
