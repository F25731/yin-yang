{"id": null, "n": "0757038", "target": "#nkr_note_orig_0757038", "type": "orig", "text": "令＝今【明】"}
{"id": null, "n": "0757039", "target": "#nkr_note_orig_0757039", "type": "orig", "text": "言輒＝輒言【三】"}
{"id": null, "n": "0757040", "target": "#nkr_note_orig_0757040", "type": "orig", "text": "臣＝人【三】【宮】＊"}
