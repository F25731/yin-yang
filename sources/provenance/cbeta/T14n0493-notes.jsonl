{"id": null, "n": "0757006", "target": "#nkr_note_orig_0757006", "type": "orig", "text": "計＝忖【三】"}
{"id": null, "n": "0757007", "target": "#nkr_note_orig_0757007", "type": "orig", "text": "二＝姻【三】，恩【宮】"}
{"id": null, "n": "0757008", "target": "#nkr_note_orig_0757008", "type": "orig", "text": "日＝曰【宋】【元】"}
{"id": null, "n": "0757009", "target": "#nkr_note_orig_0757009", "type": "orig", "text": "切＝剋【三】【宮】"}
{"id": null, "n": "0757010", "target": "#nkr_note_orig_0757010", "type": "orig", "text": "困＝因【三】"}
{"id": null, "n": "0757011", "target": "#nkr_note_orig_0757011", "type": "orig", "text": "行＝存【三】【宮】"}
{"id": null, "n": "0757012", "target": "#nkr_note_orig_0757012", "type": "orig", "text": "教＝法【三】【宮】"}
{"id": null, "n": "0757013", "target": "#nkr_note_orig_0757013", "type": "orig", "text": "鍮＝塗【宮】"}
{"id": null, "n": "0757014", "target": "#nkr_note_orig_0757014", "type": "orig", "text": "與＝得【三】【宮】"}
