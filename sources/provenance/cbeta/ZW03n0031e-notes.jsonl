{"id": null, "n": null, "target": null, "type": null, "text": "三稱南無阿彌陀佛。"}
{"id": null, "n": "0437001", "target": "#nkr_note_orig_0437001", "type": "orig", "text": "「齊」，底本作「劑」，據文意改。"}
{"id": null, "n": "0437002", "target": "#nkr_note_orig_0437002", "type": "orig", "text": "「脈」，底本作「腦」，據伯2130號改。"}
{"id": null, "n": "0437003", "target": "#nkr_note_orig_0437003", "type": "orig", "text": "「十四色」，底本無，據北8299號補。"}
{"id": null, "n": "0438001", "target": "#nkr_note_orig_0438001", "type": "orig", "text": "「上出」，底本字迹不清，據北8299號錄文。"}
{"id": null, "n": "0438002", "target": "#nkr_note_orig_0438002", "type": "orig", "text": "「猶」，底本作「由」，據文意改。"}
{"id": null, "n": "0439001", "target": "#nkr_note_orig_0439001", "type": "orig", "text": "「上」，底本無，據甲本補。"}
{"id": null, "n": "0440001", "target": "#nkr_note_orig_0440001", "type": "orig", "text": "「𦡈」，甲本注音為：「烏公反。」"}
{"id": null, "n": "0440002", "target": "#nkr_note_orig_0440002", "type": "orig", "text": "「翅」，甲本注音為：「傷豉（？）反。」"}
{"id": null, "n": "0440003", "target": "#nkr_note_orig_0440003", "type": "orig", "text": "「四」，底本無，據甲本補。"}
{"id": null, "n": "0440004", "target": "#nkr_note_orig_0440004", "type": "orig", "text": "「猶」，底本、甲本作「由」，據北8299號改。"}
{"id": null, "n": "0440005", "target": "#nkr_note_orig_0440005", "type": "orig", "text": "「畫有」，甲本作「畫中有」。"}
{"id": null, "n": "0440006", "target": "#nkr_note_orig_0440006", "type": "orig", "text": "「色中有」，甲本作「色有」。"}
{"id": null, "n": "0440007", "target": "#nkr_note_orig_0440007", "type": "orig", "text": "「臃」，甲本注音為：「敕容反。」"}
{"id": null, "n": "0440008", "target": "#nkr_note_orig_0440008", "type": "orig", "text": "「照」，底本無，據甲本補。"}
{"id": null, "n": "0440009", "target": "#nkr_note_orig_0440009", "type": "orig", "text": "「纖」，甲本注音為：「息占反。」"}
{"id": null, "n": "0440010", "target": "#nkr_note_orig_0440010", "type": "orig", "text": "「蟠」，甲本注音為：「盤音。」"}
{"id": null, "n": "0441001", "target": "#nkr_note_orig_0441001", "type": "orig", "text": "「所」，底本作「意」，據甲本改。"}
{"id": null, "n": "0441002", "target": "#nkr_note_orig_0441002", "type": "orig", "text": "「縵」，甲本注音為：「莫半反。」"}
{"id": null, "n": "0441003", "target": "#nkr_note_orig_0441003", "type": "orig", "text": "「斂」，底本作「劍」，據甲本改。"}
{"id": null, "n": "0441004", "target": "#nkr_note_orig_0441004", "type": "orig", "text": "「出」，甲本作「中」。"}
{"id": null, "n": "0441005", "target": "#nkr_note_orig_0441005", "type": "orig", "text": "「腋」，甲本注音為：「亦音。」"}
{"id": null, "n": "0441006", "target": "#nkr_note_orig_0441006", "type": "orig", "text": "「光」，甲本作「珠」。"}
{"id": null, "n": "0441007", "target": "#nkr_note_orig_0441007", "type": "orig", "text": "「百」，底本無，據北8299號補。"}
{"id": null, "n": "0441008", "target": "#nkr_note_orig_0441008", "type": "orig", "text": "「腹」，底本、甲本作「復」，據文意改。"}
{"id": null, "n": "0442001", "target": "#nkr_note_orig_0442001", "type": "orig", "text": "「色」，底本作「光」，據甲本改。"}
{"id": null, "n": "0442002", "target": "#nkr_note_orig_0442002", "type": "orig", "text": "「一一色有萬億那由他光」，底本無，據北8299號補。"}
{"id": null, "n": "0442003", "target": "#nkr_note_orig_0442003", "type": "orig", "text": "「右」，甲本注音為：「許劫反。」"}
{"id": null, "n": "0442004", "target": "#nkr_note_orig_0442004", "type": "orig", "text": "「緻」，甲本注音為：「長利反。」"}
{"id": null, "n": "0442005", "target": "#nkr_note_orig_0442005", "type": "orig", "text": "「如」，甲本無。"}
{"id": null, "n": "0442006", "target": "#nkr_note_orig_0442006", "type": "orig", "text": "「䏶」，底本作「陛」，據甲本改。"}
{"id": null, "n": "0442007", "target": "#nkr_note_orig_0442007", "type": "orig", "text": "「跟」，甲本注音為：「根音。」"}
{"id": null, "n": "0442008", "target": "#nkr_note_orig_0442008", "type": "orig", "text": "「敷」，甲本作「趺」。"}
{"id": null, "n": "0443001", "target": "#nkr_note_orig_0443001", "type": "orig", "text": "「足」，底本無，據甲本補。"}
{"id": null, "n": "0443002", "target": "#nkr_note_orig_0443002", "type": "orig", "text": "「如」，甲本無。"}
{"id": null, "n": "0443003", "target": "#nkr_note_orig_0443003", "type": "orig", "text": "「摩」，甲本注音為：「莫賀反。」"}
{"id": null, "n": "0443004", "target": "#nkr_note_orig_0443004", "type": "orig", "text": "「轂」，甲本注音為：「谷音。」"}
{"id": null, "n": "0443005", "target": "#nkr_note_orig_0443005", "type": "orig", "text": "「座」，底本作「坐」，據北8299號改。"}
{"id": null, "n": "0443006", "target": "#nkr_note_orig_0443006", "type": "orig", "text": "「後一由旬純黃金色」，底本無，據甲本補。"}
{"id": null, "n": "0444001", "target": "#nkr_note_orig_0444001", "type": "orig", "text": "「設復有人但聞白毫，心不驚疑，歡喜信受，此人亦除卻八十億劫生死之罪，」底本無，甲本殘，據伯2130號補。"}
{"id": null, "n": "0444002", "target": "#nkr_note_orig_0444002", "type": "orig", "text": "「等人」，底本作「人等」，據甲本改。"}
{"id": null, "n": "0444003", "target": "#nkr_note_orig_0444003", "type": "orig", "text": "「功」，甲本作「功功」。"}
{"id": null, "n": "0445001", "target": "#nkr_note_orig_0445001", "type": "orig", "text": "「來」，底本無，據甲本補。"}
{"id": null, "n": "0445002", "target": "#nkr_note_orig_0445002", "type": "orig", "text": "「解脫」，底本無，據甲本補。"}
{"id": null, "n": "0445003", "target": "#nkr_note_orig_0445003", "type": "orig", "text": "「佛名」，底本作「億佛名」，甲本作「名」，據北8299號改。"}
{"id": null, "n": "0445004", "target": "#nkr_note_orig_0445004", "type": "orig", "text": "「斯福」，甲本作「禍」。"}
{"id": null, "n": "0445005", "target": "#nkr_note_orig_0445005", "type": "orig", "text": "尾題甲本作「相好經一卷」。"}
