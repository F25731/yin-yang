{"id": null, "n": "0928004", "target": "#nkr_note_mod_0928004", "type": "mod", "text": "天竺【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0928005", "target": "#nkr_note_mod_0928005", "type": "mod", "text": "三藏【大】，〔－〕【宋】"}
{"id": null, "n": "0928006", "target": "#nkr_note_mod_0928006", "type": "mod", "text": "王【大】，珠【明】"}
{"id": null, "n": "0928007", "target": "#nkr_note_mod_0928007", "type": "mod", "text": "輪【大】，轉【宋】【元】【明】【宮】"}
{"id": null, "n": "0928008", "target": "#nkr_note_mod_0928008", "type": "mod", "text": "繩【大】，網【明】"}
{"id": null, "n": "0929001", "target": "#nkr_note_mod_0929001", "type": "mod", "text": "分【大】，芬【明】【聖】"}
{"id": null, "n": "0929002", "target": "#nkr_note_mod_0929002", "type": "mod", "text": "大【大】，天【明】"}
{"id": null, "n": "0929003", "target": "#nkr_note_mod_0929003", "type": "mod", "text": "疑【大】，礙【明】【聖】"}
{"id": null, "n": "0929004", "target": "#nkr_note_mod_0929004", "type": "mod", "text": "唯【大】，惟【宮】"}
{"id": null, "n": "0929005", "target": "#nkr_note_mod_0929005", "type": "mod", "text": "住【大】，信【宋】【元】【明】【宮】"}
{"id": null, "n": "0929006", "target": "#nkr_note_mod_0929006", "type": "mod", "text": "故【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0929007", "target": "#nkr_note_mod_0929007", "type": "mod", "text": "慰【大】，隱【宋】【元】【宮】"}
{"id": null, "n": "0930001", "target": "#nkr_note_mod_0930001", "type": "mod", "text": "慰【CB】【宋】【元】【明】【宮】【聖】，隱【大】"}
{"id": null, "n": "0931001", "target": "#nkr_note_mod_0931001", "type": "mod", "text": "故【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0931002", "target": "#nkr_note_mod_0931002", "type": "mod", "text": "依【大】，依彼【宋】【元】【明】【宮】"}
{"id": null, "n": "0932001", "target": "#nkr_note_mod_0932001", "type": "mod", "text": "得【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0932002", "target": "#nkr_note_mod_0932002", "type": "mod", "text": "慰【CB】【麗-CB】【宋】【元】【明】【宮】，隱【大】"}
{"id": null, "n": "0933001a", "target": "#nkr_note_mod_0933001a", "type": "mod", "text": "生【大】，生安隱心為令他住無明無差別明智故起安慰心有言無明無差別明智者所謂無明體即是明體何以故明體不異無明體無明體不異明體即無明體明故依彼無明體明智一切法明故【CB】【麗-CB】【宋】【元】【明】【宮】"}
{"id": null, "n": "0933001b", "target": "#nkr_note_mod_0933001b", "type": "mod", "text": "二謂菩薩生如是心我已得住貪無差別無貪智故生安隱心為令他住貪無差別無貪智故起安慰心有言貪無差別無貪智者所謂貪體即無貪體何以故以無貪體不異貪體貪體不異無貪體故以即貪體是無貪故依彼貪體無貪智一切法無貪故三謂菩薩生如是心我已得住瞋無差別無瞋智故生安隱心為令他住瞋無差別無瞋智故起安慰心有言瞋無差別無瞋智者所謂瞋體即無瞋體何以故以無瞋體不異瞋體瞋體不異無瞋體故以即瞋體是無瞋故依彼瞋體無瞋智一切法無瞋故【CB】【麗-CB】【宋】【元】【明】【宮】，〔－〕【大】"}
{"id": null, "n": "0933001c", "target": "#nkr_note_mod_0933001c", "type": "mod", "text": "四謂菩薩生如是心我已得住癡無差別無癡智故生安隱心為令他住癡無差別無癡智故起安慰心有言癡無差別無癡智者所謂癡【CB】【麗-CB】【宋】【元】【明】【宮】，〔－〕【大】"}
{"id": null, "n": "0933002", "target": "#nkr_note_mod_0933002", "type": "mod", "text": "智【大】，體【聖】"}
{"id": null, "n": "0933003", "target": "#nkr_note_mod_0933003", "type": "mod", "text": "受【大】，受事行攝受【宋】【元】【明】【宮】"}
{"id": null, "n": "0933004", "target": "#nkr_note_mod_0933004", "type": "mod", "text": "住【大】，得【宋】【元】"}
{"id": null, "n": "0933005", "target": "#nkr_note_mod_0933005", "type": "mod", "text": "位【大】，住【宋】【元】【明】【宮】"}
{"id": null, "n": "0934001", "target": "#nkr_note_mod_0934001", "type": "mod", "text": "（元魏…譯）十一字【大】，〔－〕【聖】"}
{"id": null, "n": "0934002", "target": "#nkr_note_mod_0934002", "type": "mod", "text": "三藏【大】＊，〔－〕【宋】【宮】＊"}
{"id": null, "n": "0934003", "target": "#nkr_note_mod_0934003", "type": "mod", "text": "謂【大】，論【宋】【元】【明】【宮】"}
{"id": null, "n": "0934004", "target": "#nkr_note_mod_0934004", "type": "mod", "text": "支【大】，枝【聖】"}
{"id": null, "n": "0935001", "target": "#nkr_note_mod_0935001", "type": "mod", "text": "謂【大】，諸【宋】【宮】"}
{"id": null, "n": "0936001", "target": "#nkr_note_mod_0936001", "type": "mod", "text": "地【大】，故【宋】【元】【明】【宮】"}
{"id": null, "n": "0937001", "target": "#nkr_note_mod_0937001", "type": "mod", "text": "隱【大】，慰【聖】"}
{"id": null, "n": "0937002", "target": "#nkr_note_mod_0937002", "type": "mod", "text": "故【大】，則【宋】【元】【明】【宮】"}
{"id": null, "n": "0938001", "target": "#nkr_note_mod_0938001", "type": "mod", "text": "相【大】，想【宋】【元】【明】【宮】"}
{"id": null, "n": "0938002", "target": "#nkr_note_mod_0938002", "type": "mod", "text": "人【大】，人住【宋】【元】，住【明】【宮】"}
{"id": null, "n": "0938003", "target": "#nkr_note_mod_0938003", "type": "mod", "text": "疑【大】＊，礙【元】【明】＊"}
{"id": null, "n": "0939001", "target": "#nkr_note_mod_0939001", "type": "mod", "text": "不【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "0939002", "target": "#nkr_note_mod_0939002", "type": "mod", "text": "者【大】，者謂離九種事故【聖】"}
{"id": null, "n": "0939003", "target": "#nkr_note_mod_0939003", "type": "mod", "text": "不【大】，〔－〕【宋】"}
{"id": null, "n": "0939004", "target": "#nkr_note_mod_0939004", "type": "mod", "text": "善【大】，苦【宋】【宮】"}
{"id": null, "n": "0940001", "target": "#nkr_note_mod_0940001", "type": "mod", "text": "入【大】，大【宋】"}
{"id": null, "n": "0940002", "target": "#nkr_note_mod_0940002", "type": "mod", "text": "他【大】，化【宋】【元】【明】【宮】"}
{"id": null, "n": "0940003", "target": "#nkr_note_mod_0940003", "type": "mod", "text": "息【大】，鳥【明】"}
{"id": null, "n": "0941001", "target": "#nkr_note_mod_0941001", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0941002", "target": "#nkr_note_mod_0941002", "type": "mod", "text": "隱【CB】【麗-CB】【宋】【元】【明】【宮】，慰【大】"}
{"id": null, "n": "0941003", "target": "#nkr_note_mod_0941003", "type": "mod", "text": "生【大】，住【明】"}
{"id": null, "n": "0941004", "target": "#nkr_note_mod_0941004", "type": "mod", "text": "唯【大】，惟【宮】"}
{"id": null, "n": "0941005", "target": "#nkr_note_mod_0941005", "type": "mod", "text": "謂【大】，諸【宋】【元】【明】【宮】"}
{"id": null, "n": "0941006", "target": "#nkr_note_mod_0941006", "type": "mod", "text": "言【大】，言住【宋】【元】【明】【宮】"}
{"id": null, "n": "0941007", "target": "#nkr_note_mod_0941007", "type": "mod", "text": "（有言…體）二十六字【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0941008", "target": "#nkr_note_mod_0941008", "type": "mod", "text": "以【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0942001", "target": "#nkr_note_mod_0942001", "type": "mod", "text": "有【大】，有言【宋】【元】【明】【宮】"}
{"id": null, "n": "0942002", "target": "#nkr_note_mod_0942002", "type": "mod", "text": "法【大】，白法【宋】【元】【明】【宮】"}
{"id": null, "n": "0943001", "target": "#nkr_note_mod_0943001", "type": "mod", "text": "行【大】，得【宋】【元】【明】【宮】"}
{"id": null, "n": "0945001", "target": "#nkr_note_mod_0945001", "type": "mod", "text": "所【大】，六【宋】【元】【宮】，亦【明】，明註曰所南藏作六"}
{"id": null, "n": "0946001", "target": "#nkr_note_mod_0946001", "type": "mod", "text": "慰【CB】【麗-CB】【宋】【元】【明】【宮】，隱【大】"}
{"id": null, "n": "0946002", "target": "#nkr_note_mod_0946002", "type": "mod", "text": "住【大】，各【明】"}
{"id": null, "n": "0946004", "target": "#nkr_note_mod_0946004", "type": "mod", "text": "集【大】，習【聖】"}
{"id": null, "n": "0947001", "target": "#nkr_note_mod_0947001", "type": "mod", "text": "馬瑙【大】＊，瑪瑙【宋】【元】【宮】＊，碼碯【明】【聖】＊"}
{"id": null, "n": "0947002", "target": "#nkr_note_mod_0947002", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0947003", "target": "#nkr_note_mod_0947003", "type": "mod", "text": "（文殊…障礙）六十四字【大】，〔－〕【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0947004", "target": "#nkr_note_mod_0947004", "type": "mod", "text": "（文殊…障礙）六十四字【大】，〔－〕【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0948001", "target": "#nkr_note_mod_0948001", "type": "mod", "text": "（文殊…障礙）七十六字【大】，〔－〕【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0948002", "target": "#nkr_note_mod_0948002", "type": "mod", "text": "（文殊…障礙）一百三十八字【大】，〔－〕【宋】【元】【明】【聖】"}
{"id": null, "n": "0948003", "target": "#nkr_note_mod_0948003", "type": "mod", "text": "令【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0948004", "target": "#nkr_note_mod_0948004", "type": "mod", "text": "世界【大】，世界一切佛國土微塵數智功德莊嚴大海於念念間有阿僧祇異異說智有障礙如是種種異異世界【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0948005", "target": "#nkr_note_mod_0948005", "type": "mod", "text": "祇【大】，祇異異境界【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0948006a", "target": "#nkr_note_mod_0948006a", "type": "mod", "text": "（一切…障礙）二十九字【大】，〔－〕【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0948006b", "target": "#nkr_note_mod_0948006b", "type": "mod", "text": "（如是…世界）八字【大】，〔－〕【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0948007", "target": "#nkr_note_mod_0948007", "type": "mod", "text": "異異說智【大】，勝異異智【宋】【元】【明】【宮】"}
{"id": null, "n": "0948008", "target": "#nkr_note_mod_0948008", "type": "mod", "text": "障礙【大】，障礙如是種種異異世界一切佛國土微塵數令入世界大海於念念間有阿僧祇異異說智無有障礙【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0948009a", "target": "#nkr_note_mod_0948009a", "type": "mod", "text": "（如是…障礙）一百五十五字【大】，〔－〕【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0948009b", "target": "#nkr_note_mod_0948009b", "type": "mod", "text": "（如是…障礙）四十字【大】，〔－〕【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0949001", "target": "#nkr_note_mod_0949001", "type": "mod", "text": "于【大】，於【宋】【元】"}
{"id": null, "n": "0949002", "target": "#nkr_note_mod_0949002", "type": "mod", "text": "休息【大】，休息文殊師利如是如來肉髻十方世界一切世界一切住處一一世界一一閻浮提無障無礙無有差別遍覆一切虛空法界一切世間教化眾生盡未來際遍至無邊世界劫數住持無有休息【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0949003", "target": "#nkr_note_mod_0949003", "type": "mod", "text": "切【大】，〔－〕【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0949004", "target": "#nkr_note_mod_0949004", "type": "mod", "text": "童【大】＊，僮【宋】【元】【宮】＊"}
{"id": null, "n": "0949005", "target": "#nkr_note_mod_0949005", "type": "mod", "text": "以【大】，以得【聖】"}
{"id": null, "n": "0949006", "target": "#nkr_note_mod_0949006", "type": "mod", "text": "（或有…清淨之）二十一字【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0949007", "target": "#nkr_note_mod_0949007", "type": "mod", "text": "（住地…清淨之）十六字【大】，〔－〕【聖】"}
{"id": null, "n": "0949008", "target": "#nkr_note_mod_0949008", "type": "mod", "text": "（或有…清淨之）二十五字【大】，〔－〕【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0949009", "target": "#nkr_note_mod_0949009", "type": "mod", "text": "神通【大】，三昧【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0949010", "target": "#nkr_note_mod_0949010", "type": "mod", "text": "大願【大】，解脫【宋】【元】【明】【宮】【聖】"}
