{"id": null, "n": null, "target": null, "type": null, "text": "永嘉禪師"}
{"id": null, "n": null, "target": null, "type": null, "text": "鎮大羅"}
{"id": null, "n": null, "target": null, "type": null, "text": "武陵春"}
{"id": null, "n": null, "target": null, "type": null, "text": "驚醒夢中人"}
{"id": null, "n": null, "target": null, "type": null, "text": "《度人經》"}
{"id": null, "n": null, "target": null, "type": null, "text": "大如黍米"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X26n0575_p0972c01"}
{"id": null, "n": "0966001", "target": "#nkr_note_orig_0966001", "type": "orig", "text": "願不疑倒"}
{"id": null, "n": "0970001", "target": "#nkr_note_orig_0970001", "type": "orig", "text": "炁或作細"}
{"id": null, "n": "0971001", "target": "#nkr_note_orig_0971001", "type": "orig", "text": "求或作未"}
{"id": null, "n": "0971002", "target": "#nkr_note_orig_0971002", "type": "orig", "text": "守疑字"}
{"id": null, "n": "0973001", "target": "#nkr_note_orig_0973001", "type": "orig", "text": "杖或作張"}
{"id": null, "n": "0974001", "target": "#nkr_note_orig_0974001", "type": "orig", "text": "一無我字"}
{"id": null, "n": "0976001", "target": "#nkr_note_orig_0976001", "type": "orig", "text": "如如自然異作圓同大虗"}
{"id": null, "n": "0977001", "target": "#nkr_note_orig_0977001", "type": "orig", "text": "綱疑網"}
{"id": null, "n": "0978001", "target": "#nkr_note_orig_0978001", "type": "orig", "text": "休下一有教生二字"}
{"id": null, "n": "0980001", "target": "#nkr_note_orig_0980001", "type": "orig", "text": "反一作及"}
{"id": null, "n": "0981001", "target": "#nkr_note_orig_0981001", "type": "orig", "text": "心一作星"}
