{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云，即四緣也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即四中因緣義"}
{"id": null, "n": null, "target": null, "type": null, "text": "大、小疏皆錯，以病患之患作幻化之幻。"}
{"id": null, "n": null, "target": null, "type": null, "text": "是牒第二患喻釋也云云，如鈔"}
{"id": null, "n": null, "target": null, "type": null, "text": "今抄亦誤作幻化字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "第十二、鈔約患損眼根，見青、黃等，或\n見種種若人若物。《原人論》亦用彼文，乃云：「重病心惛，見異色人、物。」今抄約熱翳故，見空華等，但以患字義，隨說\n皆得。"}
{"id": null, "n": null, "target": null, "type": null, "text": "能說為智"}
{"id": null, "n": null, "target": null, "type": null, "text": "所化之機"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "此文亦可\n削之矣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "此總標二家。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此合云言字"}
{"id": null, "n": null, "target": null, "type": null, "text": "略合在中"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云如彼"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂詮師也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此意由孟浪，故云羯濕彌羅。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云，具如五十一演義說。"}
{"id": null, "n": null, "target": null, "type": null, "text": "故漢書銘西域謂身毒國，即天竺也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "南、西、北、東、中也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上皆《釋教錄》文。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "即此齊滅道場"}
{"id": null, "n": null, "target": null, "type": null, "text": "此三是〈世界成就品〉初三因也"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "東即是真"}
{"id": null, "n": null, "target": null, "type": null, "text": "西即妄也，此是執妄，妄即是他"}
{"id": null, "n": null, "target": null, "type": null, "text": "從此已下，初講者不須用之"}
{"id": null, "n": null, "target": null, "type": null, "text": "如勝〔縵〕等"}
{"id": null, "n": null, "target": null, "type": null, "text": "如，《華\n嚴》、《起信》等"}
{"id": null, "n": null, "target": null, "type": null, "text": "即巾"}
{"id": null, "n": null, "target": null, "type": null, "text": "即幻師、術法"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "并注云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云，如此抄"}
{"id": null, "n": null, "target": null, "type": null, "text": "已自標列"}
{"id": null, "n": null, "target": null, "type": null, "text": "上是《大抄》"}
{"id": null, "n": null, "target": null, "type": null, "text": "上牒疏，牒疏無此文"}
{"id": null, "n": null, "target": null, "type": null, "text": "此是一句"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "現見\n智也。觀如，故云現見，謂觀差別；聞如，故不異也"}
{"id": null, "n": null, "target": null, "type": null, "text": "比智也。比即類也。觀前能觀之智亦無實，故云類也。然所知境即二諦，能知法、比即無礙體，立名不\n同前後。已前後皆明所知，此明能知從體"}
{"id": null, "n": null, "target": null, "type": null, "text": "後九皆下相字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂初二門"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "此行以我見屬境慧，配法執，不配第七識中我見也。此抄返違《大疏》。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《大抄》\n於亦可下方云：執我第七識中有四惑故。以說經據此爾。《小抄》亦不應直云此識中有此四惑。前《小疏》既略此\n義，而此字足指疏列四惑爾。說前我見屬別境慧，不配第七識，此方配四惑故。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": "0011001", "target": "#nkr_note_mod_0011001", "type": "mod", "text": "妄【CB】，忘【卍續】，忘疑妄"}
{"id": null, "n": "0002001", "target": "#nkr_note_orig_0002001", "type": "orig", "text": "＊贍疑膽（贍ハ本文ニ瞻トツクル。󴦒）"}
{"id": null, "n": "0002002", "target": "#nkr_note_orig_0002002", "type": "orig", "text": "但疑俱"}
{"id": null, "n": "0002003", "target": "#nkr_note_orig_0002003 #note_star_1", "type": "orig", "text": "後鈔作從次同"}
{"id": null, "n": "0002004", "target": "#nkr_note_orig_0002004", "type": "orig", "text": "改疑段"}
{"id": null, "n": "0003001", "target": "#nkr_note_orig_0003001", "type": "orig", "text": "徑疑經"}
{"id": null, "n": "0003002", "target": "#nkr_note_orig_0003002", "type": "orig", "text": "今鈔作令"}
{"id": null, "n": "0003003", "target": "#nkr_note_orig_0003003", "type": "orig", "text": "絕疑剩字"}
{"id": null, "n": "0003004", "target": "#nkr_note_orig_0003004", "type": "orig", "text": "片疑斥"}
{"id": null, "n": "0004001", "target": "#nkr_note_orig_0004001", "type": "orig", "text": "手疑乎"}
{"id": null, "n": "0004002", "target": "#nkr_note_orig_0004002", "type": "orig", "text": "科疑料"}
{"id": null, "n": "0004003", "target": "#nkr_note_orig_0004003", "type": "orig", "text": "稱下疑脫性"}
{"id": null, "n": "0006001", "target": "#nkr_note_orig_0006001", "type": "orig", "text": "去疑云"}
{"id": null, "n": "0006002", "target": "#nkr_note_orig_0006002", "type": "orig", "text": "覩疑都"}
{"id": null, "n": "0007001", "target": "#nkr_note_orig_0007001", "type": "orig", "text": "恬疑怕"}
{"id": null, "n": "0007002", "target": "#nkr_note_orig_0007002", "type": "orig", "text": "於疑無"}
{"id": null, "n": "0007003", "target": "#nkr_note_orig_0007003", "type": "orig", "text": "却疑靜"}
{"id": null, "n": "0007004", "target": "#nkr_note_orig_0007004", "type": "orig", "text": "南疑兩"}
{"id": null, "n": "0008001", "target": "#nkr_note_orig_0008001", "type": "orig", "text": "遊疑逝"}
{"id": null, "n": "0008002", "target": "#nkr_note_orig_0008002 #note_star_2", "type": "orig", "text": "縵疑鬘次同"}
{"id": null, "n": "0009001", "target": "#nkr_note_orig_0009001", "type": "orig", "text": "迷疑述"}
{"id": null, "n": "0009002", "target": "#nkr_note_orig_0009002", "type": "orig", "text": "無下疑脫上"}
{"id": null, "n": "0009003", "target": "#nkr_note_orig_0009003", "type": "orig", "text": "棱當作楞次同"}
{"id": null, "n": "0009004", "target": "#nkr_note_orig_0009004", "type": "orig", "text": "藏疑識"}
{"id": null, "n": "0010001", "target": "#nkr_note_orig_0010001", "type": "orig", "text": "休疑對"}
{"id": null, "n": "0010002", "target": "#nkr_note_orig_0010002", "type": "orig", "text": "知疑智"}
{"id": null, "n": "0010003", "target": "#nkr_note_orig_0010003", "type": "orig", "text": "提疑薩"}
{"id": null, "n": "0010004", "target": "#nkr_note_orig_0010004", "type": "orig", "text": "沐疑流"}
{"id": null, "n": "0011001", "target": "#nkr_note_orig_0011001", "type": "orig", "text": "忘疑妄"}
{"id": null, "n": "0011002", "target": "#nkr_note_orig_0011002", "type": "orig", "text": "報疑執"}
