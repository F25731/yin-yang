{"id": null, "n": "0113001", "target": "#nkr_note_orig_0113001", "type": "orig", "text": "儀東春作祿"}
{"id": null, "n": "0113002", "target": "#nkr_note_orig_0113002", "type": "orig", "text": "髀清本髀疑脾"}
{"id": null, "n": "0116001", "target": "#nkr_note_orig_0116001", "type": "orig", "text": "四五○故輕南五六相比鬼難或死故重王固故輕似南󴥏順"}
{"id": null, "n": "0117001", "target": "#nkr_note_orig_0117001", "type": "orig", "text": "等來檗作算束"}
{"id": null, "n": "0117002", "target": "#nkr_note_orig_0117002", "type": "orig", "text": "為一作謂"}
{"id": null, "n": "0120001", "target": "#nkr_note_orig_0120001", "type": "orig", "text": "曰疑應作有"}
{"id": null, "n": "0122001", "target": "#nkr_note_orig_0122001", "type": "orig", "text": "增應作僧"}
{"id": null, "n": "0126001", "target": "#nkr_note_orig_0126001", "type": "orig", "text": "義舊作意"}
{"id": null, "n": "0126002", "target": "#nkr_note_orig_0126002", "type": "orig", "text": "刑古作形"}
{"id": null, "n": "0127001", "target": "#nkr_note_orig_0127001 #note_star_1", "type": "orig", "text": "三箇一一舊皆脫一字今依一本及經補成"}
{"id": null, "n": "0129001", "target": "#nkr_note_orig_0129001", "type": "orig", "text": "延疑廷"}
{"id": null, "n": "0132001", "target": "#nkr_note_orig_0132001", "type": "orig", "text": "成獲二字據一補成"}
{"id": null, "n": "0133001", "target": "#nkr_note_orig_0133001", "type": "orig", "text": "欲疏現文作貪"}
{"id": null, "n": "0133002", "target": "#nkr_note_orig_0133002", "type": "orig", "text": "少相一作於少"}
{"id": null, "n": "0133003", "target": "#nkr_note_orig_0133003", "type": "orig", "text": "為原違今依論并一本訂之"}
{"id": null, "n": "0135001", "target": "#nkr_note_orig_0135001", "type": "orig", "text": "類論作盧或作必"}
{"id": null, "n": "0136001", "target": "#nkr_note_orig_0136001", "type": "orig", "text": "門上恐脫法字"}
{"id": null, "n": "0136002", "target": "#nkr_note_orig_0136002", "type": "orig", "text": "說疑思"}
{"id": null, "n": "0137001", "target": "#nkr_note_orig_0137001", "type": "orig", "text": "住法二字依經補成"}
{"id": null, "n": "0137002", "target": "#nkr_note_orig_0137002", "type": "orig", "text": "具足經作有字"}
{"id": null, "n": "0137003", "target": "#nkr_note_orig_0137003", "type": "orig", "text": "呻原伸今依經"}
{"id": null, "n": "0137004", "target": "#nkr_note_orig_0137004", "type": "orig", "text": "藏下經有三昧二字"}
{"id": null, "n": "0137005", "target": "#nkr_note_orig_0137005", "type": "orig", "text": "假實恐逆順"}
{"id": null, "n": "0139001", "target": "#nkr_note_orig_0139001", "type": "orig", "text": "志一作至"}
{"id": null, "n": "0141001", "target": "#nkr_note_orig_0141001", "type": "orig", "text": "事輔正作而"}
{"id": null, "n": "0142001", "target": "#nkr_note_orig_0142001", "type": "orig", "text": "男下恐脫女字"}
{"id": null, "n": "0143001", "target": "#nkr_note_orig_0143001", "type": "orig", "text": "功一作福今依疏訂"}
{"id": null, "n": "0146001", "target": "#nkr_note_orig_0146001", "type": "orig", "text": "翻者今依一本訂成文"}
{"id": null, "n": "0146002", "target": "#nkr_note_orig_0146002", "type": "orig", "text": "相三三原無今取古本補"}
{"id": null, "n": "0147001", "target": "#nkr_note_orig_0147001", "type": "orig", "text": "二原脫今依古"}
{"id": null, "n": "0147002", "target": "#nkr_note_orig_0147002", "type": "orig", "text": "則下一本有多人二字"}
{"id": null, "n": "0147003", "target": "#nkr_note_orig_0147003", "type": "orig", "text": "常下一有此字"}
{"id": null, "n": "0149001", "target": "#nkr_note_orig_0149001", "type": "orig", "text": "並原并今取古"}
{"id": null, "n": "0150001", "target": "#nkr_note_orig_0150001", "type": "orig", "text": "心字諸本脫既不成句今依經補成句"}
{"id": null, "n": "0150002", "target": "#nkr_note_orig_0150002", "type": "orig", "text": "土經業今依義作土引"}
{"id": null, "n": "0154001", "target": "#nkr_note_orig_0154001", "type": "orig", "text": "提桓原脫提字今依一補"}
{"id": null, "n": "0155001", "target": "#nkr_note_orig_0155001", "type": "orig", "text": "八健宋本經作鉢建"}
{"id": null, "n": "0155002", "target": "#nkr_note_orig_0155002", "type": "orig", "text": "伽論作羅"}
{"id": null, "n": "0155003", "target": "#nkr_note_orig_0155003", "type": "orig", "text": "掌一作宰"}
{"id": null, "n": "0156001", "target": "#nkr_note_orig_0156001", "type": "orig", "text": "一持一作持一"}
{"id": null, "n": "0157001", "target": "#nkr_note_orig_0157001", "type": "orig", "text": "合一作令"}
{"id": null, "n": "0157002", "target": "#nkr_note_orig_0157002", "type": "orig", "text": "珠或二字一作作一字"}
{"id": null, "n": "0157003", "target": "#nkr_note_orig_0157003", "type": "orig", "text": "寶珠珠原脫校疏釋補"}
{"id": null, "n": "0158001", "target": "#nkr_note_orig_0158001", "type": "orig", "text": "財恐法"}
{"id": null, "n": "0162001", "target": "#nkr_note_orig_0162001", "type": "orig", "text": "說字一無"}
