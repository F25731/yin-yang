{"id": null, "n": "0878003", "target": "#nkr_note_mod_0878003", "type": "mod", "text": "反【大】，切【明】"}
{"id": null, "n": "0878004", "target": "#nkr_note_mod_0878004", "type": "mod", "text": "丁履反【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0878005", "target": "#nkr_note_mod_0878005", "type": "mod", "text": "反【大】，反下同【甲】"}
{"id": null, "n": "0878006", "target": "#nkr_note_mod_0878006", "type": "mod", "text": "磨【大】，摩【宋】【元】【明】"}
