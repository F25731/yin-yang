{"id": null, "n": null, "target": null, "type": null, "text": "五科入"}
{"id": null, "n": null, "target": null, "type": null, "text": "帶數釋也"}
{"id": null, "n": null, "target": null, "type": null, "text": "佳苑云：「四方郡國錄一代之事，總而計之，名曰會也。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "案：今正以後也。前小三乘等，案為眼自出，後門中略也"}
{"id": null, "n": null, "target": null, "type": null, "text": "是七處也"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉經八會，欠第七重會，准也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此義後當別出"}
{"id": null, "n": null, "target": null, "type": null, "text": "此義亦當後別出"}
{"id": null, "n": null, "target": null, "type": null, "text": "此義亦當\n後出之"}
{"id": null, "n": null, "target": null, "type": null, "text": "如下文云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "如下文云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "如下文云云，此義下當別述也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此上二本隱在龍宮不出"}
{"id": null, "n": null, "target": null, "type": null, "text": "常說如此\n也，更後說〔三〕十八品，又云三十九品也，准之"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉經三萬六千偈"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉經三十四品六十卷，亦是五十卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "上來七問\n答辨其總竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉經如來淨藏\n三昧"}
{"id": null, "n": null, "target": null, "type": null, "text": "五卷，從第一至第五，晉經〈世間淨眼品〉"}
{"id": null, "n": null, "target": null, "type": null, "text": "次明正宗"}
{"id": null, "n": null, "target": null, "type": null, "text": "一卷，第六"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上兩品共一卷，第七"}
{"id": null, "n": null, "target": null, "type": null, "text": "三卷，從第八至第十"}
{"id": null, "n": null, "target": null, "type": null, "text": "一卷，第十一，晉經此上五品分名〈盧舍那佛品〉"}
{"id": null, "n": null, "target": null, "type": null, "text": "四卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上二品〔於〕一卷，第十二"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上二品共一卷，第十三"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上二品共二卷，第十四、第十五"}
{"id": null, "n": null, "target": null, "type": null, "text": "身、語、意，如次准之"}
{"id": null, "n": null, "target": null, "type": null, "text": "解行德，如\n次准之。又釋初行、次願、後德"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上三品\n共一卷，第十六"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上二品\n共一卷，第十七"}
{"id": null, "n": null, "target": null, "type": null, "text": "一卷，第十八"}
{"id": null, "n": null, "target": null, "type": null, "text": "嚴處集眾"}
{"id": null, "n": null, "target": null, "type": null, "text": "解行德，如次准之"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉經菩薩善伏三昧"}
{"id": null, "n": null, "target": null, "type": null, "text": "三卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上三品共二卷，第十九、第二十"}
{"id": null, "n": null, "target": null, "type": null, "text": "一卷，第二十一"}
{"id": null, "n": null, "target": null, "type": null, "text": "同前會"}
{"id": null, "n": null, "target": null, "type": null, "text": "初一品正位，後一品蘊行成就，生起後位"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉經菩薩明智三昧"}
{"id": null, "n": null, "target": null, "type": null, "text": "一十二卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "一卷，第二\n十二"}
{"id": null, "n": null, "target": null, "type": null, "text": "并前品合一十一卷，從第二十三至三十三"}
{"id": null, "n": null, "target": null, "type": null, "text": "同前"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉論經菩薩大乘光明三昧"}
{"id": null, "n": null, "target": null, "type": null, "text": "六卷，從第三十四至第三十九"}
{"id": null, "n": null, "target": null, "type": null, "text": "一十三卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "從第四十至第四十三，晉\n經欠此品也"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉經〈十明品〉"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上二品共一卷，第四十四"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉經〈壽命品〉"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上三品共一卷，第四十五"}
{"id": null, "n": null, "target": null, "type": null, "text": "二卷，第四十六、第四十七"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉經〈小相光明功德品〉。已\n上二品共一卷，第四十八"}
{"id": null, "n": null, "target": null, "type": null, "text": "云\n云"}
{"id": null, "n": null, "target": null, "type": null, "text": "一卷，第四十五"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉經〈寶王如來性起品〉，三卷，從第五十至第五十二"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉經脫莊嚴也"}
{"id": null, "n": null, "target": null, "type": null, "text": "七卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "七卷，從第五十三至\n第五十九"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉經\n舍衛國祇恒林中，乃至奮迅三昧"}
{"id": null, "n": null, "target": null, "type": null, "text": "二十一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "二十一卷，從第六十至第八十"}
{"id": null, "n": null, "target": null, "type": null, "text": "雖有此說，無分明也"}
{"id": null, "n": null, "target": null, "type": null, "text": "並准\n思之"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云。後二門如別說記"}
{"id": null, "n": null, "target": null, "type": null, "text": "如常說也"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "如是等文，處處皆有"}
{"id": null, "n": null, "target": null, "type": null, "text": "准釋可知"}
{"id": null, "n": null, "target": null, "type": null, "text": "此小乘"}
{"id": null, "n": null, "target": null, "type": null, "text": "是三乘"}
{"id": null, "n": null, "target": null, "type": null, "text": "此一乘"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "此云別相時，如說或時在眾不\n得聞等"}
{"id": null, "n": null, "target": null, "type": null, "text": "此云破耶見時，不簡白黑，一切得聞"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "說經二字，義如上說"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "此翻為覺"}
{"id": null, "n": null, "target": null, "type": null, "text": "後說合於經意，元曉師又多同說唯一圓滿法身無上如來耳"}
{"id": null, "n": null, "target": null, "type": null, "text": "准思之"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "此在人天位"}
{"id": null, "n": null, "target": null, "type": null, "text": "以表說小乘法故"}
{"id": null, "n": null, "target": null, "type": null, "text": "此約\n初教"}
{"id": null, "n": null, "target": null, "type": null, "text": "此約終教"}
{"id": null, "n": null, "target": null, "type": null, "text": "此約頓教，上來約三乘說"}
{"id": null, "n": null, "target": null, "type": null, "text": "此約同教"}
{"id": null, "n": null, "target": null, "type": null, "text": "此約圓教"}
{"id": null, "n": null, "target": null, "type": null, "text": "一假名佛，謂六神通；二寂靜佛，謂或不生；三真實佛，謂即真也"}
{"id": null, "n": null, "target": null, "type": null, "text": "般若、解脫、法身"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂自覺、覺他也"}
{"id": null, "n": null, "target": null, "type": null, "text": "廣說如經"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂論云別依本者，明依總開別；滿彼本者，還能成總也"}
{"id": null, "n": null, "target": null, "type": null, "text": "思之\n可解"}
{"id": null, "n": null, "target": null, "type": null, "text": "以別無同相，不成總故；同無異相，不成滿故。以有別中有同、異\n相，乃得相應成一總滿"}
{"id": null, "n": null, "target": null, "type": null, "text": "以成故非無，以\n壞故非有。若但成非壞，隨增益〔是〕；唯壞無成，隨損減邊。今有成壞，故離二邊；二邊離故，即是中道。有成、有壞，亦\n非一中，是謂甚深緣起道理"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂此文出在下經第四大願初中經家自說，非是論主率意而作"}
{"id": null, "n": null, "target": null, "type": null, "text": "懍法師諸門廣述繁言，故略之"}
{"id": null, "n": null, "target": null, "type": null, "text": "一云：若〔鬪〕一緣，餘不成起；起不\n成故，緣義則壞。得此一緣，全一切成起；一起成故，緣義方立。是故一緣是能起，多緣及果俱是所起。是即多為\n一成，多是無體；一能作多，一是有體。然此義後更說也"}
{"id": null, "n": null, "target": null, "type": null, "text": "義相師云：「中門中向上來、向下\n去，即門中向上去、向下來。」前後言錯，故不用也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此中數數\n法者，一者十，二者十中九，乃至十者十中一"}
{"id": null, "n": null, "target": null, "type": null, "text": "第一門竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃至十重"}
{"id": null, "n": null, "target": null, "type": null, "text": "六科入"}
{"id": null, "n": null, "target": null, "type": null, "text": "隨妄為染"}
{"id": null, "n": null, "target": null, "type": null, "text": "離妄名淨"}
{"id": null, "n": null, "target": null, "type": null, "text": "癈緣論實"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘後九門別處說云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名諸緣互異門，即異體也"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名諸緣互應門，即同體也"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名應異無礙門，即雙辨同異也"}
{"id": null, "n": null, "target": null, "type": null, "text": "別章云「由自若有時，他必無故，他即是自。」何〔以〕？由他無性，以自作故。由自若空時，他必有故，自即是他。何\n以故？由自無性，用他作故。又別章云「多緣無性，為一所成，是故多即一；一無性為多，故成多有一空。」又疏下文\n云「有一即有一切，却一即却一切。」此即一切是空義，故泯自即他；以一是有義，有義故攝他。即自反上來即一\n是空義，故亦泯自即他；多是有義，故攝他即自。來上來四處說文，有同有異，准思之"}
{"id": null, "n": null, "target": null, "type": null, "text": "一云：\n由一有體能攝多，由多無性潛同一故"}
{"id": null, "n": null, "target": null, "type": null, "text": "反上思之"}
{"id": null, "n": null, "target": null, "type": null, "text": "容入亦爾"}
{"id": null, "n": null, "target": null, "type": null, "text": "同體入門竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "如一多有\n多空既爾，多有一空亦爾"}
{"id": null, "n": null, "target": null, "type": null, "text": "同體相即竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "同體門竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "多攝亦爾"}
{"id": null, "n": null, "target": null, "type": null, "text": "即顯入隱亦爾"}
{"id": null, "n": null, "target": null, "type": null, "text": "同顯異隱亦爾"}
{"id": null, "n": null, "target": null, "type": null, "text": "上二行注也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上來總是\n緣起相由門竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "下皆准此"}
{"id": null, "n": null, "target": null, "type": null, "text": "慧苑師云：「一多相望六句，謂一中有一、多中有多、一中有多、多中有\n一、一中有多、一多中有一多。」餘大少等准之。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云無量"}
{"id": null, "n": null, "target": null, "type": null, "text": "十重"}
{"id": null, "n": null, "target": null, "type": null, "text": "宜如理思"}
{"id": null, "n": null, "target": null, "type": null, "text": "智正覺世間"}
{"id": null, "n": null, "target": null, "type": null, "text": "器世間"}
{"id": null, "n": null, "target": null, "type": null, "text": "眾生世間"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "可去情思之"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉經普莊嚴童子"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂如一事法帶自十義，具此十門則為一百，餘教義等亦各准之，故成千門。如\n教義等望自類十義及同時十門有此千門，彼同時等亦望自類十門及教義等亦成千門，准思可見"}
{"id": null, "n": null, "target": null, "type": null, "text": "如常說也"}
{"id": null, "n": null, "target": null, "type": null, "text": "如一微塵，一切亦爾"}
{"id": null, "n": null, "target": null, "type": null, "text": "如一剎那，一切亦爾"}
{"id": null, "n": null, "target": null, "type": null, "text": "此清辨宗也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此護法宗也"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘義如別說也。此上諸師義，取捨任情"}
{"id": null, "n": null, "target": null, "type": null, "text": "遠公體相如是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "如論廣說"}
{"id": null, "n": null, "target": null, "type": null, "text": "如《大品》等"}
{"id": null, "n": null, "target": null, "type": null, "text": "如《勝鬘經》、《楞伽經》說也"}
{"id": null, "n": null, "target": null, "type": null, "text": "因起如是"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名道發"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃至"}
{"id": null, "n": null, "target": null, "type": null, "text": "仰緣菩提而發心求，名緣心，未位前也"}
{"id": null, "n": null, "target": null, "type": null, "text": "若解一切法悉是菩提，名解發\n心，十解位也"}
{"id": null, "n": null, "target": null, "type": null, "text": "行一切行皆合菩提，名行發心，十行、十向位也"}
{"id": null, "n": null, "target": null, "type": null, "text": "證一切法即是菩提，自體顯發，名為體發也。初地以上至金剛心"}
{"id": null, "n": null, "target": null, "type": null, "text": "初住位也"}
{"id": null, "n": null, "target": null, "type": null, "text": "從第二住以上"}
{"id": null, "n": null, "target": null, "type": null, "text": "從初至七地"}
{"id": null, "n": null, "target": null, "type": null, "text": "八地至金剛"}
{"id": null, "n": null, "target": null, "type": null, "text": "妙覺地也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂同體本性清淨心也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此謂\n真心體也"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃至"}
{"id": null, "n": null, "target": null, "type": null, "text": "例如金剛定"}
{"id": null, "n": null, "target": null, "type": null, "text": "例如來出已出家動魔宮"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "本際八問答竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "先際九問答竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "後際六問答竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "實際十四問答竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "此上約始\n終教說"}
{"id": null, "n": null, "target": null, "type": null, "text": "此約圓教\n顯耳"}
{"id": null, "n": null, "target": null, "type": null, "text": "二科入"}
{"id": null, "n": null, "target": null, "type": null, "text": "若兼顯辨用所依，則通有漏五\n蘊為性"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋義不同有耳"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "常、無常等一切例此"}
{"id": null, "n": null, "target": null, "type": null, "text": "常、無常等一切例也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此中五節，更准鏡論也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂理法者，無相之空；實相者，諸法皆如是，即諸\n法相也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此總\n問答"}
{"id": null, "n": null, "target": null, "type": null, "text": "有為八問答例一切竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "無為五問答竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "自體中六問答竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "如前\n所說"}
{"id": null, "n": null, "target": null, "type": null, "text": "常、無常等亦爾"}
{"id": null, "n": null, "target": null, "type": null, "text": "此隨分半等入也"}
{"id": null, "n": null, "target": null, "type": null, "text": "平等法界緣集十七問答竟。上來法鏡論\n師述之"}
{"id": null, "n": null, "target": null, "type": null, "text": "二師同云"}
{"id": null, "n": null, "target": null, "type": null, "text": "此約同義"}
{"id": null, "n": null, "target": null, "type": null, "text": "二師同云"}
{"id": null, "n": null, "target": null, "type": null, "text": "此義出《智度論》等"}
{"id": null, "n": null, "target": null, "type": null, "text": "此義出《中邊論》等"}
{"id": null, "n": null, "target": null, "type": null, "text": "法藏云師"}
{"id": null, "n": null, "target": null, "type": null, "text": "此義出《對法論》也。曉公此為第三門"}
{"id": null, "n": null, "target": null, "type": null, "text": "曉公此為第四門，此經宗正在此，中\n兼有三，前不出此故"}
{"id": null, "n": null, "target": null, "type": null, "text": "自此以後，共法藏師\n述之"}
{"id": null, "n": null, "target": null, "type": null, "text": "此之謂也"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃至廣說"}
{"id": null, "n": null, "target": null, "type": null, "text": "如前已列"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦以六相准思之，餘門云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "廣列眾名云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云准之"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃至餘法望相皆爾"}
{"id": null, "n": null, "target": null, "type": null, "text": "上來八問答顯一義，後二法界義也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上來元曉師言，宜審記知之"}
{"id": null, "n": null, "target": null, "type": null, "text": "如《佛性論》說"}
{"id": null, "n": null, "target": null, "type": null, "text": "如《瑜伽論》說"}
{"id": null, "n": null, "target": null, "type": null, "text": "如常說也"}
{"id": null, "n": null, "target": null, "type": null, "text": "准\n之"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "准之"}
{"id": null, "n": null, "target": null, "type": null, "text": "新經云「設有菩薩於無量百千億那由他劫行六波羅蜜，修習種種\n菩提分法。若未聞此如來不思議大威德法，或時聞已，不信、不解、不順、不入，不得名為真實菩薩。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "可准"}
{"id": null, "n": null, "target": null, "type": null, "text": "引晉經文，新經准之"}
{"id": null, "n": null, "target": null, "type": null, "text": "如後緣攝門說"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云，斷得亦爾"}
{"id": null, "n": null, "target": null, "type": null, "text": "如〈性起品．菩提章〉說"}
{"id": null, "n": null, "target": null, "type": null, "text": "如《淨名》杜嘿之意等"}
{"id": null, "n": null, "target": null, "type": null, "text": "如此經文"}
{"id": null, "n": null, "target": null, "type": null, "text": "如此經文"}
{"id": null, "n": null, "target": null, "type": null, "text": "此文約本末分異，仍會末歸本，明一乘、三乘差\n別耳"}
{"id": null, "n": null, "target": null, "type": null, "text": "此如同教中辨"}
{"id": null, "n": null, "target": null, "type": null, "text": "如前引也"}
{"id": null, "n": null, "target": null, "type": null, "text": "依《攝論》，如問答中辨"}
{"id": null, "n": null, "target": null, "type": null, "text": "如《孔目》中說"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "初約一乘，\n次約三乘，後約小乘"}
{"id": null, "n": null, "target": null, "type": null, "text": "准之"}
{"id": null, "n": null, "target": null, "type": null, "text": "一一乘、三乘為四，二一乘、三乘、\n小乘、人天為四"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "即一乘也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即三乘也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂別教也"}
{"id": null, "n": null, "target": null, "type": null, "text": "如三乘等，以不知一故"}
{"id": null, "n": null, "target": null, "type": null, "text": "如同教"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "准之"}
{"id": null, "n": null, "target": null, "type": null, "text": "五科入"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名初教"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名就教"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名至說教，同此之別教"}
{"id": null, "n": null, "target": null, "type": null, "text": "此即約空理有餘名始教，約如來藏常住\n無上名為終教"}
{"id": null, "n": null, "target": null, "type": null, "text": "此之謂也"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "解云：以義依文，句得顯故"}
{"id": null, "n": null, "target": null, "type": null, "text": "總能發生\n勝解行故，並為教體"}
{"id": null, "n": null, "target": null, "type": null, "text": "小乘"}
{"id": null, "n": null, "target": null, "type": null, "text": "如護法論師等"}
{"id": null, "n": null, "target": null, "type": null, "text": "如龍軍、堅慧師等"}
{"id": null, "n": null, "target": null, "type": null, "text": "如龍樹等"}
{"id": null, "n": null, "target": null, "type": null, "text": "以各聖教從淺至深攝眾生故"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂諸眾生無別自體，攬如來藏以成於眾生。然此如\n來藏即是佛智證為自體，離佛心智無一法可得"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂佛證於眾生心中真如成佛"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂眾生心內佛為佛心中眾生說法，佛心中眾生聽眾生\n心中佛法，如是全收說聽無礙，是謂甚深道理"}
{"id": null, "n": null, "target": null, "type": null, "text": "如海起潮，\n不失醎味"}
{"id": null, "n": null, "target": null, "type": null, "text": "此二門者，如常說也"}
{"id": null, "n": null, "target": null, "type": null, "text": "如常\n說也"}
{"id": null, "n": null, "target": null, "type": null, "text": "如下文云「一切示現無有餘，海印三昧勢力故」"}
{"id": null, "n": null, "target": null, "type": null, "text": "如普莊嚴童子\n聞佛說《一切法界無垢莊嚴經》，有世界微塵一修多羅以為眷屬也"}
{"id": null, "n": null, "target": null, "type": null, "text": "如小乘諸部經論說"}
{"id": null, "n": null, "target": null, "type": null, "text": "如《瑜伽》、《雜集》等\n說"}
{"id": null, "n": null, "target": null, "type": null, "text": "如《楞伽》等經、《寶性》等論說"}
{"id": null, "n": null, "target": null, "type": null, "text": "如《淨\n名》嘿住顯不二等，是其意也"}
{"id": null, "n": null, "target": null, "type": null, "text": "如《華嚴經》說"}
{"id": null, "n": null, "target": null, "type": null, "text": "如上所指，\n通諸經論"}
{"id": null, "n": null, "target": null, "type": null, "text": "多依慧苑師四捃餘說"}
{"id": null, "n": null, "target": null, "type": null, "text": "安云：「兩師俱依本質教說。若就影像，則非唯一音，隨聞者識，聚集異故。若依無礙法\n界，則說聽圓融，合身相攝，一多無礙。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "此中妨難，煩言多也"}
{"id": null, "n": null, "target": null, "type": null, "text": "文義全涅槃、教義無過"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂釋迦經，如《涅槃》等"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂舍那經，如《華嚴經》"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂釋迦化身與舍那十身異故"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂娑婆木樹、華藏寶樹異\n故"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂地前菩薩、二乘凡夫、十地菩薩眾異故"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂局處之說與通方之說\n異故。慧苑師云：「義寬斷狹，多所違犯。」然今更准之"}
{"id": null, "n": null, "target": null, "type": null, "text": "其門人遵統亦同此說。汎論此說，若漸根生、熟俱漸，頓根生、熟俱頓。既云未熟名漸、已熟\n名頓，此則於一漸根但生、熟為異，無頓義也。又圓機既是分階佛境，則地前無有堪聞此經故"}
{"id": null, "n": null, "target": null, "type": null, "text": "又重重云"}
{"id": null, "n": null, "target": null, "type": null, "text": "此中妨難同前，且略言也。藏師云：「真諦立漸、頓\n二教者，其違謬也。」測法師《唯識疏》中引真諦四教，而亦甚謬舛也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此說亦違《密跡》、《提謂》等經第二七日說三乘故。是故約時尅教，皆不可也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂經部教"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂般若教"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂《華\n嚴》、《涅槃》。若論此說者，因緣假名，有名濫失，何之教內不說此名"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名小乘教，《法華經》云「不得親近小乘三藏學」者"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名漸教，如《大品》乾慧等十地通三乘者是"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名頓教。聲聞在坐，如聾\n如瘂"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名祕密教，此中亦名相濫失，與前同之"}
{"id": null, "n": null, "target": null, "type": null, "text": "依乘立教，\n\n理極成也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂《楞伽經》等"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂《華嚴經》。測師引此四教為真諦述，舛謬失甚，恐無順也"}
{"id": null, "n": null, "target": null, "type": null, "text": "如四諦教，《緣起經》等"}
{"id": null, "n": null, "target": null, "type": null, "text": "如般若教，《深密\n經》等"}
{"id": null, "n": null, "target": null, "type": null, "text": "如《瓔珞》及《梵網經》等"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂《華嚴經》，普賢教"}
{"id": null, "n": null, "target": null, "type": null, "text": "具顯如《華嚴疏》中"}
{"id": null, "n": null, "target": null, "type": null, "text": "當異生位"}
{"id": null, "n": null, "target": null, "type": null, "text": "當二乘人"}
{"id": null, "n": null, "target": null, "type": null, "text": "當初心菩薩"}
{"id": null, "n": null, "target": null, "type": null, "text": "當識如來\n藏之根器"}
{"id": null, "n": null, "target": null, "type": null, "text": "此上三教同衍師說"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂《涅槃經》說佛性常住故"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂《華嚴經》說法界門故。案此說法者，四、五兩說，\n但是部別之，非通宗之故"}
{"id": null, "n": null, "target": null, "type": null, "text": "此上三教，同笈多說"}
{"id": null, "n": null, "target": null, "type": null, "text": "後之三教，亦但可言一部宗也"}
{"id": null, "n": null, "target": null, "type": null, "text": "更准之"}
{"id": null, "n": null, "target": null, "type": null, "text": "此二同衍說"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂通說諸法如幻故"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂說諸法真理"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂說恒沙德義"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂說法界無礙德用故"}
{"id": null, "n": null, "target": null, "type": null, "text": "新經具足方便住"}
{"id": null, "n": null, "target": null, "type": null, "text": "新經無法字"}
{"id": null, "n": null, "target": null, "type": null, "text": "新經住處廣大"}
{"id": null, "n": null, "target": null, "type": null, "text": "此約圓教辨"}
{"id": null, "n": null, "target": null, "type": null, "text": "從處非處至乃漏盡"}
{"id": null, "n": null, "target": null, "type": null, "text": "如經廣說"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦如經說"}
{"id": null, "n": null, "target": null, "type": null, "text": "此約始教辨"}
{"id": null, "n": null, "target": null, "type": null, "text": "此約終教辨"}
{"id": null, "n": null, "target": null, "type": null, "text": "十住之義，辨之云爾"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉經"}
{"id": null, "n": null, "target": null, "type": null, "text": "新經無違逆行"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉經"}
{"id": null, "n": null, "target": null, "type": null, "text": "新經無屈撓行"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉經"}
{"id": null, "n": null, "target": null, "type": null, "text": "新經難得行"}
{"id": null, "n": null, "target": null, "type": null, "text": "順違皆忍，故名無違逆也。《本業經》無瞋恨行也"}
{"id": null, "n": null, "target": null, "type": null, "text": "懃勇離怯，故名無屈。屈者，曲也，弱也"}
{"id": null, "n": null, "target": null, "type": null, "text": "深廣行願，非易得故，名難得也"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉經善伏三昧"}
{"id": null, "n": null, "target": null, "type": null, "text": "《地論》准之"}
{"id": null, "n": null, "target": null, "type": null, "text": "如下釋之"}
{"id": null, "n": null, "target": null, "type": null, "text": "如下偈中說，今即後三"}
{"id": null, "n": null, "target": null, "type": null, "text": "此約初教"}
{"id": null, "n": null, "target": null, "type": null, "text": "此約終教"}
{"id": null, "n": null, "target": null, "type": null, "text": "此約圓教。餘義如十勝行廣說"}
{"id": null, "n": null, "target": null, "type": null, "text": "准之"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "緣眾生為境"}
{"id": null, "n": null, "target": null, "type": null, "text": "緣法為境"}
{"id": null, "n": null, "target": null, "type": null, "text": "緣無法為境"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘門准之"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘門云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "准之"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "如《攝論》說"}
{"id": null, "n": null, "target": null, "type": null, "text": "體相差別，略述如是"}
{"id": null, "n": null, "target": null, "type": null, "text": "新經\n菩薩善思惟三昧"}
{"id": null, "n": null, "target": null, "type": null, "text": "十行\n義如是"}
{"id": null, "n": null, "target": null, "type": null, "text": "新經等一切諸佛迴向"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉經"}
{"id": null, "n": null, "target": null, "type": null, "text": "新經二處文不同也。本分中云入一切平等善根迴向，釋文中云隨順堅固善\n根迴向"}
{"id": null, "n": null, "target": null, "type": null, "text": "新經無心字"}
{"id": null, "n": null, "target": null, "type": null, "text": "新經真如相"}
{"id": null, "n": null, "target": null, "type": null, "text": "新經入法界無量"}
{"id": null, "n": null, "target": null, "type": null, "text": "同遠說"}
{"id": null, "n": null, "target": null, "type": null, "text": "與遠異之"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦同亦異"}
{"id": null, "n": null, "target": null, "type": null, "text": "異"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦同亦異"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦同亦別"}
{"id": null, "n": null, "target": null, "type": null, "text": "同"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦同亦異"}
{"id": null, "n": null, "target": null, "type": null, "text": "異"}
{"id": null, "n": null, "target": null, "type": null, "text": "新經智光三昧"}
{"id": null, "n": null, "target": null, "type": null, "text": "別別辨體了，隨位顯之"}
{"id": null, "n": null, "target": null, "type": null, "text": "於中，初一起行心堅、二約\n佛辨廣、三約法顯遍、四約德顯多"}
{"id": null, "n": null, "target": null, "type": null, "text": "一智行成、二悲行成"}
{"id": null, "n": null, "target": null, "type": null, "text": "此約終教"}
{"id": null, "n": null, "target": null, "type": null, "text": "此約圓教普賢位說"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦因攝果分，准思"}
{"id": null, "n": null, "target": null, "type": null, "text": "新經十萬，准思"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉經、論經同名明地"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉經、論經同名\n炎地"}
{"id": null, "n": null, "target": null, "type": null, "text": "遠公亦同此說"}
{"id": null, "n": null, "target": null, "type": null, "text": "可在地前也"}
{"id": null, "n": null, "target": null, "type": null, "text": "取捨任情"}
{"id": null, "n": null, "target": null, "type": null, "text": "度者，至也"}
{"id": null, "n": null, "target": null, "type": null, "text": "遠云：「得出世等也，釋其難也。能度難度，解其勝也。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "名義如是"}
{"id": null, "n": null, "target": null, "type": null, "text": "如彼《相續解說經》說"}
{"id": null, "n": null, "target": null, "type": null, "text": "信等十行，又十度也"}
{"id": null, "n": null, "target": null, "type": null, "text": "與遠多同"}
{"id": null, "n": null, "target": null, "type": null, "text": "出離真如"}
{"id": null, "n": null, "target": null, "type": null, "text": "法無我智分位"}
{"id": null, "n": null, "target": null, "type": null, "text": "如《成唯識論》說"}
{"id": null, "n": null, "target": null, "type": null, "text": "十相喻地，一海喻佛"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘門如遠\n公說"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "此得、離為雙"}
{"id": null, "n": null, "target": null, "type": null, "text": "此內、外雙"}
{"id": null, "n": null, "target": null, "type": null, "text": "此難、易雙"}
{"id": null, "n": null, "target": null, "type": null, "text": "此動、靜雙"}
{"id": null, "n": null, "target": null, "type": null, "text": "此行、法雙"}
{"id": null, "n": null, "target": null, "type": null, "text": "處處文非一"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云，如法鏡論說"}
{"id": null, "n": null, "target": null, "type": null, "text": "此約十地因分辨耳"}
{"id": null, "n": null, "target": null, "type": null, "text": "與前同也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此說甚疎"}
{"id": null, "n": null, "target": null, "type": null, "text": "此義通一部經中大意"}
{"id": null, "n": null, "target": null, "type": null, "text": "此釋局其地"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃至說十，亦可品類無量，別章可見"}
{"id": null, "n": null, "target": null, "type": null, "text": "廣如經說"}
{"id": null, "n": null, "target": null, "type": null, "text": "准之可知"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃至"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃\n至"}
{"id": null, "n": null, "target": null, "type": null, "text": "廣如論說"}
{"id": null, "n": null, "target": null, "type": null, "text": "十地之義，辨之云爾"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T35n1733_p0118a19"}
{"id": null, "n": "0414001", "target": "#nkr_note_orig_0414001", "type": "orig", "text": "三異作四"}
{"id": null, "n": "0414002", "target": "#nkr_note_orig_0414002", "type": "orig", "text": "後疑復"}
{"id": null, "n": "0414003", "target": "#nkr_note_orig_0414003", "type": "orig", "text": "即攝等五字疑衍文"}
{"id": null, "n": "0414004", "target": "#nkr_note_orig_0414004", "type": "orig", "text": "三異作四"}
{"id": null, "n": "0414005", "target": "#nkr_note_orig_0414005", "type": "orig", "text": "於疑共"}
{"id": null, "n": "0415001", "target": "#nkr_note_orig_0415001 #note_star_1", "type": "orig", "text": "若疑答下同"}
{"id": null, "n": "0416001", "target": "#nkr_note_orig_0416001", "type": "orig", "text": "一下疑脫切"}
{"id": null, "n": "0417001", "target": "#nkr_note_orig_0417001", "type": "orig", "text": "妙上疑脫勝"}
{"id": null, "n": "0417002", "target": "#nkr_note_orig_0417002", "type": "orig", "text": "異無一一支分之四字"}
{"id": null, "n": "0417003", "target": "#nkr_note_orig_0417003", "type": "orig", "text": "賢疑現"}
{"id": null, "n": "0418001", "target": "#nkr_note_orig_0418001", "type": "orig", "text": "其異作共"}
{"id": null, "n": "0418002", "target": "#nkr_note_orig_0418002", "type": "orig", "text": "懷疑壞"}
{"id": null, "n": "0419001", "target": "#nkr_note_orig_0419001", "type": "orig", "text": "去疑者"}
{"id": null, "n": "0419002", "target": "#nkr_note_orig_0419002", "type": "orig", "text": "是疑邊"}
{"id": null, "n": "0419003", "target": "#nkr_note_orig_0419003", "type": "orig", "text": "別疑則"}
{"id": null, "n": "0419004", "target": "#nkr_note_orig_0419004", "type": "orig", "text": "別疑剩字"}
{"id": null, "n": "0419005", "target": "#nkr_note_orig_0419005", "type": "orig", "text": "成上疑有為"}
{"id": null, "n": "0419006", "target": "#nkr_note_orig_0419006", "type": "orig", "text": "猶下疑有同"}
{"id": null, "n": "0419007", "target": "#nkr_note_orig_0419007", "type": "orig", "text": "雖下疑有無"}
{"id": null, "n": "0420001", "target": "#nkr_note_orig_0420001", "type": "orig", "text": "闘疑闕"}
{"id": null, "n": "0421001", "target": "#nkr_note_orig_0421001", "type": "orig", "text": "人疑剩字"}
{"id": null, "n": "0421002", "target": "#nkr_note_orig_0421002", "type": "orig", "text": "性異作相"}
{"id": null, "n": "0422001", "target": "#nkr_note_orig_0422001", "type": "orig", "text": "知不疑倒"}
{"id": null, "n": "0422002", "target": "#nkr_note_orig_0422002", "type": "orig", "text": "緣異作入"}
{"id": null, "n": "0422003", "target": "#nkr_note_orig_0422003", "type": "orig", "text": "勉疑免"}
{"id": null, "n": "0422004", "target": "#nkr_note_orig_0422004", "type": "orig", "text": "不異作因"}
{"id": null, "n": "0422005", "target": "#nkr_note_orig_0422005", "type": "orig", "text": "以下疑脫故"}
{"id": null, "n": "0422006", "target": "#nkr_note_orig_0422006", "type": "orig", "text": "交出異作用失"}
{"id": null, "n": "0422007", "target": "#nkr_note_orig_0422007", "type": "orig", "text": "疑不用顛倒"}
{"id": null, "n": "0422008", "target": "#nkr_note_orig_0422008", "type": "orig", "text": "三異作巳恐亡之誤歟"}
{"id": null, "n": "0423001", "target": "#nkr_note_orig_0423001", "type": "orig", "text": "同一以下至一門十二字疑衍文"}
{"id": null, "n": "0423002", "target": "#nkr_note_orig_0423002", "type": "orig", "text": "異疑果"}
{"id": null, "n": "0423003", "target": "#nkr_note_orig_0423003", "type": "orig", "text": "如疑始"}
{"id": null, "n": "0424001", "target": "#nkr_note_orig_0424001", "type": "orig", "text": "因疑同"}
{"id": null, "n": "0424002", "target": "#nkr_note_orig_0424002", "type": "orig", "text": "令疑今"}
{"id": null, "n": "0424003", "target": "#nkr_note_orig_0424003", "type": "orig", "text": "隠疑一"}
{"id": null, "n": "0425001", "target": "#nkr_note_orig_0425001", "type": "orig", "text": "謂疑諸"}
{"id": null, "n": "0425002", "target": "#nkr_note_orig_0425002", "type": "orig", "text": "經疑住"}
{"id": null, "n": "0425003", "target": "#nkr_note_orig_0425003", "type": "orig", "text": "著疑差"}
{"id": null, "n": "0425004", "target": "#nkr_note_orig_0425004", "type": "orig", "text": "此一作比"}
{"id": null, "n": "0426001", "target": "#nkr_note_orig_0426001", "type": "orig", "text": "如下疑脫有"}
{"id": null, "n": "0426002", "target": "#nkr_note_orig_0426002", "type": "orig", "text": "識疑議"}
{"id": null, "n": "0426003", "target": "#nkr_note_orig_0426003", "type": "orig", "text": "懼故異作驚懼"}
{"id": null, "n": "0427001", "target": "#nkr_note_orig_0427001", "type": "orig", "text": "悲疑慈"}
{"id": null, "n": "0429001", "target": "#nkr_note_orig_0429001", "type": "orig", "text": "空如疑剩字"}
{"id": null, "n": "0429002", "target": "#nkr_note_orig_0429002", "type": "orig", "text": "性疑剩字"}
{"id": null, "n": "0429003", "target": "#nkr_note_orig_0429003", "type": "orig", "text": "無名疑剩字"}
{"id": null, "n": "0429004", "target": "#nkr_note_orig_0429004", "type": "orig", "text": "異上疑脫謂不二三字"}
{"id": null, "n": "0429005", "target": "#nkr_note_orig_0429005", "type": "orig", "text": "則疑若"}
{"id": null, "n": "0430001", "target": "#nkr_note_orig_0430001", "type": "orig", "text": "著無等八字疑衍文"}
{"id": null, "n": "0431001", "target": "#nkr_note_orig_0431001", "type": "orig", "text": "覩疑都"}
{"id": null, "n": "0432001", "target": "#nkr_note_orig_0432001", "type": "orig", "text": "可下疑脫得"}
{"id": null, "n": "0433001", "target": "#nkr_note_orig_0433001", "type": "orig", "text": "界疑身"}
{"id": null, "n": "0433002", "target": "#nkr_note_orig_0433002", "type": "orig", "text": "入疑人"}
{"id": null, "n": "0435001", "target": "#nkr_note_orig_0435001", "type": "orig", "text": "理疑現"}
{"id": null, "n": "0435002", "target": "#nkr_note_orig_0435002", "type": "orig", "text": "住疑作"}
{"id": null, "n": "0436001", "target": "#nkr_note_orig_0436001", "type": "orig", "text": "不上異有此薩波若果四字"}
{"id": null, "n": "0438001", "target": "#nkr_note_orig_0438001", "type": "orig", "text": "間疑聞"}
{"id": null, "n": "0439001", "target": "#nkr_note_orig_0439001", "type": "orig", "text": "無上疑脫二"}
{"id": null, "n": "0439002", "target": "#nkr_note_orig_0439002", "type": "orig", "text": "宗疑守"}
{"id": null, "n": "0439003", "target": "#nkr_note_orig_0439003", "type": "orig", "text": "貴下疑脫名生貴三字"}
{"id": null, "n": "0440001", "target": "#nkr_note_orig_0440001", "type": "orig", "text": "有二疑衍文"}
{"id": null, "n": "0440002", "target": "#nkr_note_orig_0440002", "type": "orig", "text": "一疑二"}
{"id": null, "n": "0440003", "target": "#nkr_note_orig_0440003", "type": "orig", "text": "答疑若"}
{"id": null, "n": "0440004", "target": "#nkr_note_orig_0440004", "type": "orig", "text": "皆下異有初章攝三字"}
{"id": null, "n": "0440005", "target": "#nkr_note_orig_0440005", "type": "orig", "text": "地作十地亦三字"}
{"id": null, "n": "0441001", "target": "#nkr_note_orig_0441001", "type": "orig", "text": "法下疑脫名善法三字"}
{"id": null, "n": "0442001", "target": "#nkr_note_orig_0442001", "type": "orig", "text": "俱疑但"}
{"id": null, "n": "0442002", "target": "#nkr_note_orig_0442002", "type": "orig", "text": "曠疑願"}
{"id": null, "n": "0443001", "target": "#nkr_note_orig_0443001", "type": "orig", "text": "起疑趣"}
{"id": null, "n": "0443002", "target": "#nkr_note_orig_0443002", "type": "orig", "text": "縛上疑脫無"}
{"id": null, "n": "0444001", "target": "#nkr_note_orig_0444001 #note_star_2", "type": "orig", "text": "忘或妄寫誤"}
{"id": null, "n": "0445001", "target": "#nkr_note_orig_0445001", "type": "orig", "text": "盡疑畫"}
{"id": null, "n": "0446001", "target": "#nkr_note_orig_0446001 #note_star_3 #note_star_4 #note_star_5 #note_star_6 #note_star_7 #note_star_8 #note_star_9 #note_star_a", "type": "orig", "text": "盡疑畫下同"}
{"id": null, "n": "0447001", "target": "#nkr_note_orig_0447001", "type": "orig", "text": "說上疑脫可"}
{"id": null, "n": "0447002", "target": "#nkr_note_orig_0447002", "type": "orig", "text": "行疑剩字"}
