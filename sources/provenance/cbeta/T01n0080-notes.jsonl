{"id": null, "n": null, "target": null, "type": "cf1", "text": "K20n0805_p1057a19"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K20n0805_p1059c24"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T54n2128_p0497a06"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K20n0805_p1061b20"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T01n0080_p0895a12"}
{"id": null, "n": "0891001", "target": "#nkr_note_mod_0891001", "type": "mod", "text": "為首迦長者【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0891002", "target": "#nkr_note_mod_0891002", "type": "mod", "text": "忉【大】，力【元】【明】"}
{"id": null, "n": "0891003", "target": "#nkr_note_mod_0891003", "type": "mod", "text": "耶【大】，邪【元】【明】"}
{"id": null, "n": "0891004", "target": "#nkr_note_mod_0891004", "type": "mod", "text": "首迦長者【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0891005", "target": "#nkr_note_mod_0891005", "type": "mod", "text": "是【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0891006", "target": "#nkr_note_mod_0891006", "type": "mod", "text": "即白佛【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0891007", "target": "#nkr_note_mod_0891007", "type": "mod", "text": "修【大】＊，脩【宋】【元】＊"}
{"id": null, "n": "0891008", "target": "#nkr_note_mod_0891008", "type": "mod", "text": "趣【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0891009", "target": "#nkr_note_mod_0891009", "type": "mod", "text": "天【大】＊，界天【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0891010", "target": "#nkr_note_mod_0891010", "type": "mod", "text": "俱【大】＊，二俱【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0891011", "target": "#nkr_note_mod_0891011", "type": "mod", "text": "命【大】，壽命【宋】【元】【明】"}
{"id": null, "n": "0891012", "target": "#nkr_note_mod_0891012", "type": "mod", "text": "業【大】，具業【宋】【元】【明】"}
{"id": null, "n": "0891013", "target": "#nkr_note_mod_0891013", "type": "mod", "text": "命俱…諸【大】，之與命二俱不盡而能斷除一切【宋】【元】【明】"}
{"id": null, "n": "0891014", "target": "#nkr_note_mod_0891014", "type": "mod", "text": "行【大】＊，行世間【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0891015", "target": "#nkr_note_mod_0891015", "type": "mod", "text": "復次長者【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0891016", "target": "#nkr_note_mod_0891016", "type": "mod", "text": "幡【大】，旛【明】"}
{"id": null, "n": "0891017", "target": "#nkr_note_mod_0891017", "type": "mod", "text": "世間【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0891018", "target": "#nkr_note_mod_0891018", "type": "mod", "text": "報【大】＊，報何等為十【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0892001", "target": "#nkr_note_mod_0892001", "type": "mod", "text": "惡憎所【大】，所怨憎之人【宋】【元】【明】"}
{"id": null, "n": "0892002", "target": "#nkr_note_mod_0892002", "type": "mod", "text": "教人戰鬪【大】，戰鬪自作教人【元】【明】"}
{"id": null, "n": "0892003", "target": "#nkr_note_mod_0892003", "type": "mod", "text": "之人【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0892004", "target": "#nkr_note_mod_0892004", "type": "mod", "text": "之人【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0892005", "target": "#nkr_note_mod_0892005", "type": "mod", "text": "食【大】，食因緣【元】【明】"}
{"id": null, "n": "0892006", "target": "#nkr_note_mod_0892006", "type": "mod", "text": "不【大】，未【宋】【元】【明】"}
{"id": null, "n": "0892007", "target": "#nkr_note_mod_0892007", "type": "mod", "text": "食【大】，噉【宋】【元】【明】"}
{"id": null, "n": "0892008", "target": "#nkr_note_mod_0892008", "type": "mod", "text": "不打【大】，人不令鞭杖【宋】【元】【明】"}
{"id": null, "n": "0892009", "target": "#nkr_note_mod_0892009", "type": "mod", "text": "不【大】，歎不鞭【宋】【元】【明】"}
{"id": null, "n": "0892010", "target": "#nkr_note_mod_0892010", "type": "mod", "text": "供養【大】，供養自己【宋】【元】【明】"}
{"id": null, "n": "0892011", "target": "#nkr_note_mod_0892011", "type": "mod", "text": "病【大】，有病患者【宋】【元】【明】"}
{"id": null, "n": "0892012", "target": "#nkr_note_mod_0892012", "type": "mod", "text": "生【大】，生及諸【宋】【元】【明】"}
{"id": null, "n": "0892013", "target": "#nkr_note_mod_0892013", "type": "mod", "text": "廟【大】，廟之所【宋】【元】【明】"}
{"id": null, "n": "0892014", "target": "#nkr_note_mod_0892014", "type": "mod", "text": "呰【大】，訾【明】"}
{"id": null, "n": "0892015", "target": "#nkr_note_mod_0892015", "type": "mod", "text": "父母【大】，父母尊長【宋】【元】【明】"}
{"id": null, "n": "0892016", "target": "#nkr_note_mod_0892016", "type": "mod", "text": "賢聖【大】，賢聖道德【宋】【元】【明】"}
{"id": null, "n": "0892017", "target": "#nkr_note_mod_0892017", "type": "mod", "text": "五者【大】，五者恒常【宋】【元】【明】"}
{"id": null, "n": "0892018", "target": "#nkr_note_mod_0892018", "type": "mod", "text": "佛塔【大】，佛塔精舍【宋】【元】【明】"}
{"id": null, "n": "0892019", "target": "#nkr_note_mod_0892019", "type": "mod", "text": "掃灑【大】，清淨泥塗【宋】【元】【明】"}
{"id": null, "n": "0892020", "target": "#nkr_note_mod_0892020", "type": "mod", "text": "掃灑僧【大】，平治僧伽藍【宋】【元】【明】"}
{"id": null, "n": "0892021", "target": "#nkr_note_mod_0892021", "type": "mod", "text": "宿因【大】，宿因知福德感【宋】【元】【明】"}
{"id": null, "n": "0892022", "target": "#nkr_note_mod_0892022", "type": "mod", "text": "小【大】，少【宋】【元】【明】"}
{"id": null, "n": "0892023", "target": "#nkr_note_mod_0892023", "type": "mod", "text": "於他【大】＊，見他得好【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0892024", "target": "#nkr_note_mod_0892024", "type": "mod", "text": "見失【大】，若見他失【宋】【元】【明】"}
{"id": null, "n": "0892025", "target": "#nkr_note_mod_0892025", "type": "mod", "text": "勸【大】，唯勸【宋】【元】【明】"}
{"id": null, "n": "0892026", "target": "#nkr_note_mod_0892026", "type": "mod", "text": "德【大】，儀【元】"}
{"id": null, "n": "0892027", "target": "#nkr_note_mod_0892027", "type": "mod", "text": "諸【大】，諸師友【宋】【元】【明】"}
{"id": null, "n": "0892028", "target": "#nkr_note_mod_0892028", "type": "mod", "text": "蔑【大】，懱【宋】【元】【明】"}
{"id": null, "n": "0892029", "target": "#nkr_note_mod_0892029", "type": "mod", "text": "飢【大】＊，饑【明】＊"}
{"id": null, "n": "0892030", "target": "#nkr_note_mod_0892030", "type": "mod", "text": "賢聖【大】，賢聖尊長【宋】【元】【明】"}
{"id": null, "n": "0892031", "target": "#nkr_note_mod_0892031", "type": "mod", "text": "忻悅【大】，悅欣【宋】【元】【明】"}
{"id": null, "n": "0892032", "target": "#nkr_note_mod_0892032", "type": "mod", "text": "見【大】，若見【宋】【元】【明】"}
{"id": null, "n": "0892033", "target": "#nkr_note_mod_0892033", "type": "mod", "text": "饉【大】，饉時【宋】【元】【明】"}
{"id": null, "n": "0892034", "target": "#nkr_note_mod_0892034", "type": "mod", "text": "智慧【大】，智慧大德【宋】【元】【明】"}
{"id": null, "n": "0892035", "target": "#nkr_note_mod_0892035", "type": "mod", "text": "沙門【大】＊，沙門及【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0892036", "target": "#nkr_note_mod_0892036", "type": "mod", "text": "邪見【大】，邪見法行【宋】【元】【明】"}
{"id": null, "n": "0893001", "target": "#nkr_note_mod_0893001", "type": "mod", "text": "見癡【大】，若見愚癡【宋】【元】【明】"}
{"id": null, "n": "0893002", "target": "#nkr_note_mod_0893002", "type": "mod", "text": "智慧【大】，智慧聰點【宋】【元】【明】"}
{"id": null, "n": "0893003", "target": "#nkr_note_mod_0893003", "type": "mod", "text": "聞持【大】，聞持弘護【宋】【元】【明】"}
{"id": null, "n": "0893004", "target": "#nkr_note_mod_0893004", "type": "mod", "text": "正法【大】，真正法要【宋】【元】【明】"}
{"id": null, "n": "0893005", "target": "#nkr_note_mod_0893005", "type": "mod", "text": "智【大】，智慧【宋】【元】【明】"}
{"id": null, "n": "0893006", "target": "#nkr_note_mod_0893006", "type": "mod", "text": "攝護【大】，守攝護持【宋】【元】【明】"}
{"id": null, "n": "0893007", "target": "#nkr_note_mod_0893007", "type": "mod", "text": "勤修【大】，精勤修習【宋】【元】【明】"}
{"id": null, "n": "0893008", "target": "#nkr_note_mod_0893008", "type": "mod", "text": "邪見【大】，邪見惡人【宋】【元】【明】"}
{"id": null, "n": "0893009", "target": "#nkr_note_mod_0893009", "type": "mod", "text": "無見【大】，無見見【宋】【元】【明】"}
{"id": null, "n": "0893010", "target": "#nkr_note_mod_0893010", "type": "mod", "text": "愛著【大】，慳恡愛著【宋】【元】【明】"}
{"id": null, "n": "0893011", "target": "#nkr_note_mod_0893011", "type": "mod", "text": "因【大】，病因因【宋】【元】【明】"}
{"id": null, "n": "0893012", "target": "#nkr_note_mod_0893012", "type": "mod", "text": "枯渴【大】，惱逼枯渴【宋】【元】【明】"}
{"id": null, "n": "0893013", "target": "#nkr_note_mod_0893013", "type": "mod", "text": "所謂【大】，所謂勝妙【宋】【元】【明】"}
{"id": null, "n": "0893014", "target": "#nkr_note_mod_0893014", "type": "mod", "text": "定【大】，空【元】"}
{"id": null, "n": "0893015", "target": "#nkr_note_mod_0893015", "type": "mod", "text": "想【大】，想處【宋】【元】【明】"}
{"id": null, "n": "0893016", "target": "#nkr_note_mod_0893016", "type": "mod", "text": "者【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0893017", "target": "#nkr_note_mod_0893017", "type": "mod", "text": "心【大】，心殷重布【宋】【元】【明】"}
{"id": null, "n": "0893018", "target": "#nkr_note_mod_0893018", "type": "mod", "text": "非【大】，非是【宋】【元】【明】"}
{"id": null, "n": "0893019", "target": "#nkr_note_mod_0893019", "type": "mod", "text": "增上【大】＊，增上勇猛【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0893020", "target": "#nkr_note_mod_0893020", "type": "mod", "text": "不【大】，不生【宋】【元】【明】"}
{"id": null, "n": "0893021", "target": "#nkr_note_mod_0893021", "type": "mod", "text": "增上殷重【大】，殷重增上【宋】【元】【明】"}
{"id": null, "n": "0893022", "target": "#nkr_note_mod_0893022", "type": "mod", "text": "者【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0894001", "target": "#nkr_note_mod_0894001", "type": "mod", "text": "還【大】，亦【宋】【元】【明】"}
{"id": null, "n": "0894002", "target": "#nkr_note_mod_0894002", "type": "mod", "text": "是名初苦後苦【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0894003", "target": "#nkr_note_mod_0894003", "type": "mod", "text": "能【大】，樂【宋】【元】【明】"}
{"id": null, "n": "0894004", "target": "#nkr_note_mod_0894004", "type": "mod", "text": "形容…嚴【大】，身體鮮潔毛色姝妍【元】【明】"}
{"id": null, "n": "0894005", "target": "#nkr_note_mod_0894005", "type": "mod", "text": "業【大】，業能令眾生【宋】【元】【明】"}
{"id": null, "n": "0894006", "target": "#nkr_note_mod_0894006", "type": "mod", "text": "以【大】，其【元】【明】"}
{"id": null, "n": "0894007", "target": "#nkr_note_mod_0894007", "type": "mod", "text": "殺【大】，殺生【宋】【元】【明】"}
{"id": null, "n": "0894008", "target": "#nkr_note_mod_0894008", "type": "mod", "text": "峻崖…菜【大】，山陵塠阜株杭丘坑【宋】【元】【明】"}
{"id": null, "n": "0894009", "target": "#nkr_note_mod_0894009", "type": "mod", "text": "果【大】，菓【宋】【元】【明】"}
{"id": null, "n": "0894010", "target": "#nkr_note_mod_0894010", "type": "mod", "text": "禮【大】，恭敬禮拜諸【宋】【元】【明】"}
{"id": null, "n": "0894011", "target": "#nkr_note_mod_0894011", "type": "mod", "text": "功德【大】＊，功德何等為十【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0894012", "target": "#nkr_note_mod_0894012", "type": "mod", "text": "言【大】，吐言辭【宋】【元】【明】"}
{"id": null, "n": "0894013", "target": "#nkr_note_mod_0894013", "type": "mod", "text": "處【大】，堂堂處【宋】【元】【明】"}
{"id": null, "n": "0894014", "target": "#nkr_note_mod_0894014", "type": "mod", "text": "天人【大】，天人世間【宋】【元】【明】"}
{"id": null, "n": "0894015", "target": "#nkr_note_mod_0894015", "type": "mod", "text": "名禮【大】，名禮拜諸【宋】【元】【明】"}
{"id": null, "n": "0894016", "target": "#nkr_note_mod_0894016", "type": "mod", "text": "如蓋【大】，猶如傘蓋【宋】【元】【明】"}
{"id": null, "n": "0894017", "target": "#nkr_note_mod_0894017", "type": "mod", "text": "一切【大】，一切世間【宋】【元】【明】"}
{"id": null, "n": "0894018", "target": "#nkr_note_mod_0894018", "type": "mod", "text": "者【大】，者勸導【宋】【元】【明】"}
{"id": null, "n": "0894019", "target": "#nkr_note_mod_0894019", "type": "mod", "text": "幡【大】＊，旛【明】＊"}
{"id": null, "n": "0894020", "target": "#nkr_note_mod_0894020", "type": "mod", "text": "如幢【大】，猶如寶幢【宋】【元】【明】"}
{"id": null, "n": "0894021", "target": "#nkr_note_mod_0894021", "type": "mod", "text": "鍾【大】，鐘【元】【明】"}
{"id": null, "n": "0894022", "target": "#nkr_note_mod_0894022", "type": "mod", "text": "鍾【大】，鐘【明】"}
{"id": null, "n": "0895001", "target": "#nkr_note_mod_0895001", "type": "mod", "text": "輕【大】，輕捷勦【宋】【元】【明】"}
{"id": null, "n": "0895002", "target": "#nkr_note_mod_0895002", "type": "mod", "text": "世【大】，世淨沙【宋】【元】【明】"}
{"id": null, "n": "0895003", "target": "#nkr_note_mod_0895003", "type": "mod", "text": "常【大】，常清淨【宋】【元】【明】"}
{"id": null, "n": "0895004", "target": "#nkr_note_mod_0895004", "type": "mod", "text": "得【大】，人中得【宋】【元】【明】"}
{"id": null, "n": "0895005", "target": "#nkr_note_mod_0895005", "type": "mod", "text": "善惡…慧【大】，諸善惡之法智慧明了【宋】【元】【明】"}
{"id": null, "n": "0895006", "target": "#nkr_note_mod_0895006", "type": "mod", "text": "除【大】，隨處除【宋】【元】【明】"}
{"id": null, "n": "0895007", "target": "#nkr_note_mod_0895007", "type": "mod", "text": "在【大】，不【宋】【元】【明】"}
{"id": null, "n": "0895008", "target": "#nkr_note_mod_0895008", "type": "mod", "text": "忉【大】，力【元】【明】"}
{"id": null, "n": "0895009", "target": "#nkr_note_mod_0895009", "type": "mod", "text": "為首迦長者【大】，〔－〕【明】"}
{"id": null, "n": "0891001", "target": "#nkr_note_orig_0891001", "type": "orig", "text": "〔為首迦長者〕－【三】"}
{"id": null, "n": "0891002", "target": "#nkr_note_orig_0891002", "type": "orig", "text": "忉＝力【元】【明】"}
{"id": null, "n": "0891003", "target": "#nkr_note_orig_0891003", "type": "orig", "text": "耶＝邪【元】【明】"}
{"id": null, "n": "0891004", "target": "#nkr_note_orig_0891004", "type": "orig", "text": "〔首迦長者〕－【三】"}
{"id": null, "n": "0891005", "target": "#nkr_note_orig_0891005", "type": "orig", "text": "〔是〕－【三】"}
{"id": null, "n": "0891006", "target": "#nkr_note_orig_0891006", "type": "orig", "text": "〔即白佛〕－【三】"}
