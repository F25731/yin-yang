{"id": null, "n": "0019001", "target": "#nkr_note_orig_0019001", "type": "orig", "text": "「為」，底本殘，據甲本補。"}
{"id": null, "n": "0019002", "target": "#nkr_note_orig_0019002", "type": "orig", "text": "「障」，底本殘，據甲本補。"}
{"id": null, "n": "0019003", "target": "#nkr_note_orig_0019003", "type": "orig", "text": "「惑」，底本殘，據字形擬補。"}
{"id": null, "n": "0019004", "target": "#nkr_note_orig_0019004", "type": "orig", "text": "「皮」，底本殘，據甲本補。"}
{"id": null, "n": "0019005", "target": "#nkr_note_orig_0019005", "type": "orig", "text": "「恆沙」，底本殘，據甲本補。"}
{"id": null, "n": "0019006", "target": "#nkr_note_orig_0019006", "type": "orig", "text": "「深」，甲本作「染」。"}
{"id": null, "n": "0019007", "target": "#nkr_note_orig_0019007", "type": "orig", "text": "「膚」，底本無，據甲本補。"}
{"id": null, "n": "0019008", "target": "#nkr_note_orig_0019008", "type": "orig", "text": "「深」，甲本作「染」。"}
{"id": null, "n": "0019009", "target": "#nkr_note_orig_0019009", "type": "orig", "text": "「已」，底本作「以」，據《華嚴經》卷一改。"}
{"id": null, "n": "0020001", "target": "#nkr_note_orig_0020001", "type": "orig", "text": "「粗」，底本作「羸」，據甲本改。"}
{"id": null, "n": "0020002", "target": "#nkr_note_orig_0020002", "type": "orig", "text": "「使」，底本無，據甲本補。"}
{"id": null, "n": "0020003", "target": "#nkr_note_orig_0020003", "type": "orig", "text": "「諦」，底本作「帝」，據甲本改。下同，不一一出註。"}
{"id": null, "n": "0020004", "target": "#nkr_note_orig_0020004", "type": "orig", "text": "「有」，底本殘，據甲本補。"}
{"id": null, "n": "0020005", "target": "#nkr_note_orig_0020005", "type": "orig", "text": "「二十八」，底本作「十九」，據甲本及文意改。"}
{"id": null, "n": "0020006", "target": "#nkr_note_orig_0020006", "type": "orig", "text": "「二十八」，底本作「十九」，據甲本及文意改。"}
{"id": null, "n": "0020007", "target": "#nkr_note_orig_0020007", "type": "orig", "text": "「應」，底本殘，據甲本補。"}
{"id": null, "n": "0020008", "target": "#nkr_note_orig_0020008", "type": "orig", "text": "「者」，甲本漏。"}
{"id": null, "n": "0021001", "target": "#nkr_note_orig_0021001", "type": "orig", "text": "「其」，甲本錄改作「期」。"}
{"id": null, "n": "0022001", "target": "#nkr_note_orig_0022001", "type": "orig", "text": "「以」，底本作「已」，據甲本改。"}
{"id": null, "n": "0022002", "target": "#nkr_note_orig_0022002", "type": "orig", "text": "「德」，底本作「得」，據文意改。甲本將此處「眾得」，錄為「眾生得」。"}
{"id": null, "n": "0023001", "target": "#nkr_note_orig_0023001", "type": "orig", "text": "「番」，底本作「幡」，據甲本改。以下不一一出校記。"}
{"id": null, "n": "0023002", "target": "#nkr_note_orig_0023002", "type": "orig", "text": "「頌」，底本作「訟」，據甲本改。"}
{"id": null, "n": "0024001", "target": "#nkr_note_orig_0024001", "type": "orig", "text": "「座」，底本作「坐」，據文意改。下同。"}
{"id": null, "n": "0024002", "target": "#nkr_note_orig_0024002", "type": "orig", "text": "「愛」，底本作「愛法」，據《華嚴經》原文刪。"}
{"id": null, "n": "0025001", "target": "#nkr_note_orig_0025001", "type": "orig", "text": "「等」，底本無，據甲本補。"}
{"id": null, "n": "0025002", "target": "#nkr_note_orig_0025002", "type": "orig", "text": "「涌」，底本作「勇」，據甲本改。"}
{"id": null, "n": "0027001", "target": "#nkr_note_orig_0027001", "type": "orig", "text": "「鑛」，底本作「󵕘」，據甲本改。"}
{"id": null, "n": "0027002", "target": "#nkr_note_orig_0027002", "type": "orig", "text": "「穀」，底本作「䅽」，據甲本改。"}
{"id": null, "n": "0027003", "target": "#nkr_note_orig_0027003", "type": "orig", "text": "「淨」，《華嚴經》原文作「淨妙」。"}
{"id": null, "n": "0027004", "target": "#nkr_note_orig_0027004", "type": "orig", "text": "「神」，底本作「神神」，據甲本刪。"}
{"id": null, "n": "0027005", "target": "#nkr_note_orig_0027005", "type": "orig", "text": "「往」，《華嚴經》原文作「往久遠」。"}
{"id": null, "n": "0027006", "target": "#nkr_note_orig_0027006", "type": "orig", "text": "「堪」，底本作「勘」，據甲本改。下同，不出校記。"}
{"id": null, "n": "0029001", "target": "#nkr_note_orig_0029001", "type": "orig", "text": "「修」，《華嚴經》原文作「修行」。"}
{"id": null, "n": "0030001", "target": "#nkr_note_orig_0030001", "type": "orig", "text": "「間」，底本無，據文意補。"}
{"id": null, "n": "0031001", "target": "#nkr_note_orig_0031001", "type": "orig", "text": "「測」，底本作「側」，據文意改。"}
{"id": null, "n": "0032001", "target": "#nkr_note_orig_0032001", "type": "orig", "text": "「能」，疑為「德」之誤。下同，不出校記。"}
{"id": null, "n": "0032002", "target": "#nkr_note_orig_0032002", "type": "orig", "text": "「機」，底本作「譏」，據甲本改。"}
{"id": null, "n": "0033001", "target": "#nkr_note_orig_0033001", "type": "orig", "text": "「時」，底本無，據《華嚴經》經文補。"}
{"id": null, "n": "0034001", "target": "#nkr_note_orig_0034001", "type": "orig", "text": "「謂」，底本無，據甲本補。"}
{"id": null, "n": "0034002", "target": "#nkr_note_orig_0034002", "type": "orig", "text": "「迂」，底本無，據甲本補。"}
{"id": null, "n": "0034003", "target": "#nkr_note_orig_0034003", "type": "orig", "text": "「邊」，底本無，據文意補。"}
{"id": null, "n": "0035001", "target": "#nkr_note_orig_0035001", "type": "orig", "text": "「復有」，底本作「有復」，據文意改。"}
{"id": null, "n": "0035002", "target": "#nkr_note_orig_0035002", "type": "orig", "text": "「□」，底本此處不通，疑脫「體」字。"}
{"id": null, "n": "0035003", "target": "#nkr_note_orig_0035003", "type": "orig", "text": "「測」，底本作「惻」，據文意改。"}
{"id": null, "n": "0036001", "target": "#nkr_note_orig_0036001", "type": "orig", "text": "「無」，底本無，據甲本補。"}
{"id": null, "n": "0036002", "target": "#nkr_note_orig_0036002", "type": "orig", "text": "「如」，底本無，據文意補。"}
{"id": null, "n": "0036003", "target": "#nkr_note_orig_0036003", "type": "orig", "text": "「二十」，底本作「廿三」，據《華嚴經》經文改。"}
{"id": null, "n": "0036004", "target": "#nkr_note_orig_0036004", "type": "orig", "text": "「末」，底本無，據文意補。"}
{"id": null, "n": "0037001", "target": "#nkr_note_orig_0037001", "type": "orig", "text": "「理藉言顯」，底本作「理絕言頑」，據文意改。甲本改作「理絕言辭」。"}
{"id": null, "n": "0037002", "target": "#nkr_note_orig_0037002", "type": "orig", "text": "「答」，底本作「益」，據甲本改。"}
{"id": null, "n": "0037003", "target": "#nkr_note_orig_0037003", "type": "orig", "text": "「感」，底本作「或」，據文意改。"}
{"id": null, "n": "0037004", "target": "#nkr_note_orig_0037004", "type": "orig", "text": "「八」，底本作「八輪」，據甲本刪。"}
{"id": null, "n": "0038001", "target": "#nkr_note_orig_0038001", "type": "orig", "text": "「□…□」，此處底本原缺，所缺字數不詳。"}
{"id": null, "n": "0040001", "target": "#nkr_note_orig_0040001", "type": "orig", "text": "「辦」，底本作「辯」，據甲本改。"}
{"id": null, "n": "0040002", "target": "#nkr_note_orig_0040002", "type": "orig", "text": "「辦」，底本作「辨」，據甲本改。"}
{"id": null, "n": "0042001", "target": "#nkr_note_orig_0042001", "type": "orig", "text": "「喜」，底本作「意」，據甲本改。"}
{"id": null, "n": "0042002", "target": "#nkr_note_orig_0042002", "type": "orig", "text": "「懸」，底本作「玄」，據文意改。"}
{"id": null, "n": "0042003", "target": "#nkr_note_orig_0042003", "type": "orig", "text": "「東」，底本作「一東」，據甲本刪。"}
{"id": null, "n": "0044001", "target": "#nkr_note_orig_0044001", "type": "orig", "text": "「億」，底本無，據文意補。"}
{"id": null, "n": "0045001", "target": "#nkr_note_orig_0045001", "type": "orig", "text": "「狹」，底本作「俠」，據文意改。"}
{"id": null, "n": "0045002", "target": "#nkr_note_orig_0045002", "type": "orig", "text": "「忘」，底本作「望」，據甲本改。"}
{"id": null, "n": "0047001", "target": "#nkr_note_orig_0047001", "type": "orig", "text": "「妄」，底本作「忘」，據甲本改。"}
{"id": null, "n": "0048001", "target": "#nkr_note_orig_0048001", "type": "orig", "text": "「總」，甲本改作「禍」。"}
{"id": null, "n": "0049001", "target": "#nkr_note_orig_0049001", "type": "orig", "text": "「問」，底本無，據甲本補。"}
{"id": null, "n": "0049002", "target": "#nkr_note_orig_0049002", "type": "orig", "text": "「初」，底本殘，據甲本補。"}
{"id": null, "n": "0049003", "target": "#nkr_note_orig_0049003", "type": "orig", "text": "「賢」，底本作「堅」，據甲本改。"}
{"id": null, "n": "0049004", "target": "#nkr_note_orig_0049004", "type": "orig", "text": "「難」，底本殘，據甲本補。"}
{"id": null, "n": "0049005", "target": "#nkr_note_orig_0049005", "type": "orig", "text": "「說其」，底本殘，據甲本補。"}
{"id": null, "n": "0050001", "target": "#nkr_note_orig_0050001", "type": "orig", "text": "「就」，底本殘，據文意補。"}
{"id": null, "n": "0050002", "target": "#nkr_note_orig_0050002", "type": "orig", "text": "「第六」，底本殘，據甲本補。"}
{"id": null, "n": "0050003", "target": "#nkr_note_orig_0050003", "type": "orig", "text": "「初地」，底本殘，據甲本補。"}
{"id": null, "n": "0050004", "target": "#nkr_note_orig_0050004", "type": "orig", "text": "「地、七」，底本殘，據甲本補。"}
{"id": null, "n": "0050005", "target": "#nkr_note_orig_0050005", "type": "orig", "text": "「行」，底本殘，據甲本補。"}
{"id": null, "n": "0050006", "target": "#nkr_note_orig_0050006", "type": "orig", "text": "「地」，底本作「地他」，據甲本刪。"}
{"id": null, "n": "0050007", "target": "#nkr_note_orig_0050007", "type": "orig", "text": "「相」，底本脫，據文意補。"}
{"id": null, "n": "0050008", "target": "#nkr_note_orig_0050008", "type": "orig", "text": "「者」，底本殘，據甲本補。"}
{"id": null, "n": "0050009", "target": "#nkr_note_orig_0050009", "type": "orig", "text": "「自」，底本殘，據甲本補。"}
{"id": null, "n": "0050010", "target": "#nkr_note_orig_0050010", "type": "orig", "text": "「行」，底本殘，據甲本補。"}
{"id": null, "n": "0050011", "target": "#nkr_note_orig_0050011", "type": "orig", "text": "「三」，底本殘，據甲本補。"}
{"id": null, "n": "0051001", "target": "#nkr_note_orig_0051001", "type": "orig", "text": "「初」，底本殘，據甲本補。"}
{"id": null, "n": "0051002", "target": "#nkr_note_orig_0051002", "type": "orig", "text": "「切諸佛皆共」，底本殘，據《華嚴經》經文補。"}
{"id": null, "n": "0051003", "target": "#nkr_note_orig_0051003", "type": "orig", "text": "「菩」，底本殘，據甲本補。"}
{"id": null, "n": "0051004", "target": "#nkr_note_orig_0051004", "type": "orig", "text": "「三業」，底本殘，據甲本補。"}
{"id": null, "n": "0052001", "target": "#nkr_note_orig_0052001", "type": "orig", "text": "尾有題記：「比丘法淵供養流通。」"}
