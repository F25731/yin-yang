{"id": null, "n": null, "target": null, "type": null, "text": "伸音"}
{"id": null, "n": null, "target": null, "type": null, "text": "希迪"}
{"id": null, "n": null, "target": null, "type": null, "text": "希迪"}
{"id": null, "n": null, "target": null, "type": null, "text": "希迪"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦是敘賢首文。"}
{"id": null, "n": null, "target": null, "type": null, "text": "自知不成佛也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "法華唯會昔權，不會昔實，昔實不滯方便故。"}
{"id": null, "n": null, "target": null, "type": null, "text": "但揀昔實，法華不會"}
{"id": null, "n": null, "target": null, "type": null, "text": "尋教至義，即教、理二量"}
{"id": null, "n": null, "target": null, "type": null, "text": "雖同一處，豈尋夢游天宮"}
{"id": null, "n": null, "target": null, "type": null, "text": "經曰：唯髻中明珠，不以與之。鎮\n國曰：以權隱實，各在髻中。又曰：以權覆實，即昔開三。三即為髻，隱一乘旨"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": "0397001", "target": "#nkr_note_orig_0397001", "type": "orig", "text": "志疑致"}
{"id": null, "n": "0397002", "target": "#nkr_note_orig_0397002", "type": "orig", "text": "位疑作"}
{"id": null, "n": "0397003", "target": "#nkr_note_orig_0397003", "type": "orig", "text": "心等四字疑剩"}
{"id": null, "n": "0397004", "target": "#nkr_note_orig_0397004", "type": "orig", "text": "名一作其"}
{"id": null, "n": "0397005", "target": "#nkr_note_orig_0397005", "type": "orig", "text": "總一作物心"}
{"id": null, "n": "0398001", "target": "#nkr_note_orig_0398001", "type": "orig", "text": "宜一作直次同"}
{"id": null, "n": "0398002", "target": "#nkr_note_orig_0398002", "type": "orig", "text": "插入言字"}
{"id": null, "n": "0398003", "target": "#nkr_note_orig_0398003", "type": "orig", "text": "究疑竟"}
{"id": null, "n": "0399001", "target": "#nkr_note_orig_0399001", "type": "orig", "text": "演疑宣"}
{"id": null, "n": "0400001", "target": "#nkr_note_orig_0400001", "type": "orig", "text": "法下應有說字"}
{"id": null, "n": "0403001", "target": "#nkr_note_orig_0403001", "type": "orig", "text": "以下一有下字"}
{"id": null, "n": "0404001", "target": "#nkr_note_orig_0404001", "type": "orig", "text": "者下章有此則二字"}
{"id": null, "n": "0404002", "target": "#nkr_note_orig_0404002", "type": "orig", "text": "先人指肇公"}
{"id": null, "n": "0404003", "target": "#nkr_note_orig_0404003", "type": "orig", "text": "貞字更勘"}
{"id": null, "n": "0405001", "target": "#nkr_note_orig_0405001", "type": "orig", "text": "隋古本作隨"}
{"id": null, "n": "0406001", "target": "#nkr_note_orig_0406001", "type": "orig", "text": "巳疑亡"}
{"id": null, "n": "0406002", "target": "#nkr_note_orig_0406002", "type": "orig", "text": "弉上一有但字"}
{"id": null, "n": "0406003", "target": "#nkr_note_orig_0406003", "type": "orig", "text": "尚尚復古作宗宗"}
{"id": null, "n": "0406004", "target": "#nkr_note_orig_0406004", "type": "orig", "text": "湛然一作不變湛然有耳"}
{"id": null, "n": "0406005", "target": "#nkr_note_orig_0406005", "type": "orig", "text": "經寬作通義"}
{"id": null, "n": "0407001", "target": "#nkr_note_orig_0407001", "type": "orig", "text": "部下一有經字"}
{"id": null, "n": "0408001", "target": "#nkr_note_orig_0408001", "type": "orig", "text": "少與小通下同"}
