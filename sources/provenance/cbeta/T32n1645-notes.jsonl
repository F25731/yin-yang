{"id": null, "n": "0232a1101", "target": "#nkr_note_add_0232a1101", "type": "add", "text": "靜【CB】【磧-CB】，諍【大】"}
{"id": null, "n": "0233b2001", "target": "#nkr_note_add_0233b2001", "type": "add", "text": "睡【CB】，唾【大】"}
{"id": null, "n": "0236b1801", "target": "#nkr_note_add_0236b1801", "type": "add", "text": "情【CB】【磧-CB】，精【大】"}
