{"id": null, "n": "0783022", "target": "#nkr_note_orig_0783022", "type": "orig", "text": "居天眾會＝居天【宋】【明】【宮】，世界【元】"}
{"id": null, "n": "0783023", "target": "#nkr_note_orig_0783023", "type": "orig", "text": "〔眾會〕－【聖】"}
{"id": null, "n": "0783024", "target": "#nkr_note_orig_0783024", "type": "orig", "text": "還＝而【三】【宮】【聖】"}
{"id": null, "n": "0783025", "target": "#nkr_note_orig_0783025", "type": "orig", "text": "〔佛說〕－【宋】【元】【宮】【聖】"}
{"id": null, "n": "0781b0201", "target": "#nkr_note_add_0781b0201", "type": "add", "text": "駃【CB】【麗-CB】，駛【大】"}
{"id": null, "n": "0782a0301", "target": "#nkr_note_add_0782a0301", "type": "add", "text": "癲【CB】【麗-CB】，顛【大】"}
