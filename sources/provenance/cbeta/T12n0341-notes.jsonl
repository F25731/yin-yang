{"id": null, "n": "0116006", "target": "#nkr_note_mod_0116006", "type": "mod", "text": "唯【大】＊，惟【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0116007", "target": "#nkr_note_mod_0116007", "type": "mod", "text": "佛【大】，彼【聖】"}
