{"id": null, "n": "0118011", "target": "#nkr_note_mod_0118011", "type": "mod", "text": "二【大】＊，三【聖】＊"}
{"id": null, "n": "0118012", "target": "#nkr_note_mod_0118012", "type": "mod", "text": "何所依【大】，在住處【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0119001", "target": "#nkr_note_mod_0119001", "type": "mod", "text": "加【大】，跏【宋】【元】【明】【宮】"}
{"id": null, "n": "0119002", "target": "#nkr_note_mod_0119002", "type": "mod", "text": "王天【大】，天王【宋】【元】【明】【宮】，天王天【聖】"}
{"id": null, "n": "0119003", "target": "#nkr_note_mod_0119003", "type": "mod", "text": "復【大】，有【宋】"}
