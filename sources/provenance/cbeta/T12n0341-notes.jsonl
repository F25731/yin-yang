{"id": null, "n": "0115004", "target": "#nkr_note_mod_0115004", "type": "mod", "text": "聖善住意天子所問經【大】，〔－〕【明】，善住意天子所問經【宋】【元】【宮】"}
{"id": null, "n": "0115005", "target": "#nkr_note_mod_0115005", "type": "mod", "text": "之【大】，〔－〕【明】"}
{"id": null, "n": "0115006", "target": "#nkr_note_mod_0115006", "type": "mod", "text": "唯【大】，惟【宋】【元】【明】【宮】"}
{"id": null, "n": "0115007", "target": "#nkr_note_mod_0115007", "type": "mod", "text": "此世【大】，於此【元】【明】"}
{"id": null, "n": "0115008", "target": "#nkr_note_mod_0115008", "type": "mod", "text": "功【大】，効【宮】"}
{"id": null, "n": "0115009", "target": "#nkr_note_mod_0115009", "type": "mod", "text": "聖善住意天子所問經卷上【大】＊，〔－〕【聖】＊，善住意天子所問經卷上【宋】【元】【明】【宮】＊"}
