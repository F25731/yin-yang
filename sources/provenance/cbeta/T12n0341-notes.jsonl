{"id": null, "n": "0122002", "target": "#nkr_note_mod_0122002", "type": "mod", "text": "知【大】，如【宋】【元】【明】【宮】"}
{"id": null, "n": "0122003", "target": "#nkr_note_mod_0122003", "type": "mod", "text": "言【大】，告【宋】【元】【明】【宮】"}
{"id": null, "n": "0122004", "target": "#nkr_note_mod_0122004", "type": "mod", "text": "諦【大】，聽【宮】"}
