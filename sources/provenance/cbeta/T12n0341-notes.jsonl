{"id": null, "n": "0116009", "target": "#nkr_note_mod_0116009", "type": "mod", "text": "迷【大】，悉【宮】"}
{"id": null, "n": "0117001", "target": "#nkr_note_mod_0117001", "type": "mod", "text": "睺【大】＊，侯【宋】【元】【明】【宮】【聖】＊"}
