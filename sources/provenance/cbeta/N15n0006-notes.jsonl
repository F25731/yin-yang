{"id": null, "n": null, "target": null, "type": "cf1", "text": "T02n0099_p0011b23"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "S.25.1 (PTS 1890: III 225)"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "S.25.10 (PTS 1890: III 228)"}
{"id": null, "n": "0008002", "target": "#nkr_note_mod_0008002", "type": "mod", "text": "「說何」，原本 kiṁvādā 以暹羅本 kiṁvādi 改之。（CBETA 按：漢譯南傳大藏經此頁有二個對應之註標[02]與章節校注內容不符，故今將此處修訂為[02]之註標。）"}
{"id": null, "n": "0208001", "target": "#nkr_note_mod_0208001", "type": "mod", "text": "漢譯增壹阿含經卷十四（大正藏二．六一七b）原本經名有 nakhāsikam 應作 nakhasikhaṁ。"}
{"id": null, "n": "0001001", "target": "#nkr_note_orig_0001001", "type": "orig", "text": "漢譯雜阿含經卷五（大正藏二．三三a），增一阿含經卷六（大正藏二．五七三a），增支部原典六．一六參照。"}
{"id": null, "n": "0002002", "target": "#nkr_note_orig_0002002", "type": "orig", "text": "意修習之諸比丘。若見其比丘時心增長故名之。言舍利弗、目犍連等大長老。"}
{"id": null, "n": "0004003", "target": "#nkr_note_orig_0004003", "type": "orig", "text": "變易 pari 依暹本 vipari 改之。"}
{"id": null, "n": "0007001", "target": "#nkr_note_orig_0007001", "type": "orig", "text": "漢譯雜阿含經卷五（大正藏二．三三b），增一阿含經卷三十五（大正藏二．七五四b）。"}
{"id": null, "n": "0008002", "target": "#nkr_note_orig_0008002", "type": "orig", "text": "「說何」，原本 kiṁvādā 以暹羅本 kiṁvādi 改之。"}
{"id": null, "n": "0011003", "target": "#nkr_note_orig_0011003", "type": "orig", "text": "「善法」，原本 akusale 是 kusale 之誤。"}
{"id": null, "n": "0011001", "target": "#nkr_note_orig_0011001", "type": "orig", "text": "漢譯雜阿含經卷二十（大正藏二．一四四a）。"}
{"id": null, "n": "0011002", "target": "#nkr_note_orig_0011002", "type": "orig", "text": "「拘留歡喜山曲」，原本 pavatte 以 papāte 改之。"}
{"id": null, "n": "0011003-1", "target": "#nkr_note_orig_0011003-1", "type": "orig", "text": "「義品經」，經集第八四四偈。"}
{"id": null, "n": "0012004", "target": "#nkr_note_orig_0012004", "type": "orig", "text": "「無希望」（apurakkharāna），原文之意為「向前寄望」。但漢譯相當此文有「還滿」。此應語根 pr 來的。"}
{"id": null, "n": "0013005", "target": "#nkr_note_orig_0013005", "type": "orig", "text": "流出。原本 sāra 暹羅本 visāra，原註釋為「所轉相」pavattitabhava。"}
{"id": null, "n": "0016001", "target": "#nkr_note_orig_0016001", "type": "orig", "text": "漢譯雜阿含經卷二十（大正藏二．一四四c）。"}
{"id": null, "n": "0016002", "target": "#nkr_note_orig_0016002", "type": "orig", "text": "長部經典原典卷二．二八三。"}
{"id": null, "n": "0017001", "target": "#nkr_note_orig_0017001", "type": "orig", "text": "漢譯雜阿含經卷三（大正藏二．一七a）。"}
{"id": null, "n": "0020001", "target": "#nkr_note_orig_0020001", "type": "orig", "text": "「想」，原本略去想和識。"}
{"id": null, "n": "0021001", "target": "#nkr_note_orig_0021001", "type": "orig", "text": "漢譯雜阿含經卷二（大正藏二．一〇c）。"}
{"id": null, "n": "0021002", "target": "#nkr_note_orig_0021002", "type": "orig", "text": "「法之生起」，於原註釋為「不善法之生起」。"}
{"id": null, "n": "0024001", "target": "#nkr_note_orig_0024001", "type": "orig", "text": "漢譯雜阿含經卷二（大正藏二．一一a）。"}
{"id": null, "n": "0024002", "target": "#nkr_note_orig_0024002", "type": "orig", "text": "變易原本 pariṇāma 是 vipariṇāma 之誤。"}
{"id": null, "n": "0026001", "target": "#nkr_note_orig_0026001", "type": "orig", "text": "漢譯雜阿含經卷一（大正藏二．一c）同卷三（大正藏二．二〇a）。"}
{"id": null, "n": "0029001", "target": "#nkr_note_orig_0029001", "type": "orig", "text": "漢譯雜阿含經卷一（大正二．一a）。"}
{"id": null, "n": "0030001", "target": "#nkr_note_orig_0030001", "type": "orig", "text": "漢譯雜阿含經卷一（大正藏二．二a）。"}
{"id": null, "n": "0032001", "target": "#nkr_note_orig_0032001", "type": "orig", "text": "漢譯雜阿含經卷一（大正藏二．二a）。"}
{"id": null, "n": "0033001", "target": "#nkr_note_orig_0033001", "type": "orig", "text": "漢譯雜阿含經卷一（大正藏二．二b）。"}
{"id": null, "n": "0035001", "target": "#nkr_note_orig_0035001", "type": "orig", "text": "漢譯未詳。"}
{"id": null, "n": "0036001", "target": "#nkr_note_orig_0036001", "type": "orig", "text": "漢譯雜阿含經卷三（大正藏二．一九a）增一阿含經卷十七（大正藏二．六三一c）。"}
{"id": null, "n": "0038001", "target": "#nkr_note_orig_0038001", "type": "orig", "text": "漢譯雜阿含經卷三（大正藏二．一九a）。"}
{"id": null, "n": "0039001", "target": "#nkr_note_orig_0039001", "type": "orig", "text": "漢譯雜阿含經卷一（大正藏二．一a）。"}
{"id": null, "n": "0040001", "target": "#nkr_note_orig_0040001", "type": "orig", "text": "漢譯雜阿含經卷三（大正藏二．一九c）。"}
{"id": null, "n": "0041001", "target": "#nkr_note_orig_0041001", "type": "orig", "text": "漢譯雜阿含經卷一（大正藏二．二c）。"}
{"id": null, "n": "0045001", "target": "#nkr_note_orig_0045001", "type": "orig", "text": "「有情」一語，原本逸失。"}
{"id": null, "n": "0045001-1", "target": "#nkr_note_orig_0045001-1", "type": "orig", "text": "漢譯雜阿含經卷一（大正藏二．一c、b）。"}
{"id": null, "n": "0046002", "target": "#nkr_note_orig_0046002", "type": "orig", "text": "「不歡喜苦者」一句原本逸脫。"}
{"id": null, "n": "0046001", "target": "#nkr_note_orig_0046001", "type": "orig", "text": "漢譯雜阿含經卷三（大正藏二．二〇a）。"}
{"id": null, "n": "0047001", "target": "#nkr_note_orig_0047001", "type": "orig", "text": "漢譯未詳。"}
{"id": null, "n": "0048001", "target": "#nkr_note_orig_0048001", "type": "orig", "text": "漢譯雜阿含經卷二（大正藏二．一二b）。"}
{"id": null, "n": "0050001", "target": "#nkr_note_orig_0050001", "type": "orig", "text": "漢譯雜阿含經卷十（大正藏二．七〇b）。"}
{"id": null, "n": "0052001", "target": "#nkr_note_orig_0052001", "type": "orig", "text": "漢譯雜阿含經卷一（大正藏二．三b）。"}
{"id": null, "n": "0052002", "target": "#nkr_note_orig_0052002", "type": "orig", "text": "「若有所執者」云云，原註漢譯有各各別解，今依本文譯出。"}
{"id": null, "n": "0053003", "target": "#nkr_note_orig_0053003", "type": "orig", "text": "「比丘」，原本 bhikkhave 依暹羅本 bhikkhu mayā 改之。"}
{"id": null, "n": "0054001", "target": "#nkr_note_orig_0054001", "type": "orig", "text": "雜阿含經卷一（大正藏二．三a）。"}
{"id": null, "n": "0055002", "target": "#nkr_note_orig_0055002", "type": "orig", "text": "「比丘」，原本 bhikkhave 是 bhikkhu 之誤。"}
{"id": null, "n": "0056001", "target": "#nkr_note_orig_0056001", "type": "orig", "text": "漢譯雜阿含經卷二（大正藏二．一二a）。"}
{"id": null, "n": "0059001", "target": "#nkr_note_orig_0059001", "type": "orig", "text": "漢譯雜阿含經卷一（大正藏二．五c）。"}
{"id": null, "n": "0061001", "target": "#nkr_note_orig_0061001", "type": "orig", "text": "漢譯雜阿含經卷二（大正藏二．八a）。"}
{"id": null, "n": "0061002", "target": "#nkr_note_orig_0061002", "type": "orig", "text": "「如理」，原本 yoni yeva 從暹羅本 yoniso'va 改之。"}
{"id": null, "n": "0064001", "target": "#nkr_note_orig_0064001", "type": "orig", "text": "漢譯雜阿含經卷二（大正藏二．一八a）。"}
{"id": null, "n": "0065001", "target": "#nkr_note_orig_0065001", "type": "orig", "text": "漢譯雜阿含經卷三（大正藏二．二一c）。"}
{"id": null, "n": "0066002", "target": "#nkr_note_orig_0066002", "type": "orig", "text": "「令解脫故」，原本 vimuttatā 由暹羅本 vimuttattā 改之。"}
{"id": null, "n": "0066001", "target": "#nkr_note_orig_0066001", "type": "orig", "text": "漢譯雜阿含卷三（大正藏二．二一c）。"}
{"id": null, "n": "0067002", "target": "#nkr_note_orig_0067002", "type": "orig", "text": "「前邊」「後邊」，六十二見前分之十八及後分之四十四（原註）。"}
{"id": null, "n": "0067003", "target": "#nkr_note_orig_0067003", "type": "orig", "text": "「執拗妄取」，原本 thāmaso parāmaso 由暹羅本 thamasā-parāmaso 改之。"}
{"id": null, "n": "0067001", "target": "#nkr_note_orig_0067001", "type": "orig", "text": "漢譯雜阿含卷二（大正藏二．一一b）同卷三（大正藏二．一六b）。"}
{"id": null, "n": "0068002", "target": "#nkr_note_orig_0068002", "type": "orig", "text": "「不離」，原本 adhigataṁ 由暹羅本 avigataṁ 改之。"}
{"id": null, "n": "0068003", "target": "#nkr_note_orig_0068003", "type": "orig", "text": "「無明界」，原本 vijjādhātu 由暹羅本 avijjādhātu 改之。"}
{"id": null, "n": "0069001", "target": "#nkr_note_orig_0069001", "type": "orig", "text": "漢譯雜阿含經卷二（大正藏二．一三b）。"}
{"id": null, "n": "0070001", "target": "#nkr_note_orig_0070001", "type": "orig", "text": "漢譯雜阿含經卷一（大正藏二．六a）。"}
{"id": null, "n": "0073001", "target": "#nkr_note_orig_0073001", "type": "orig", "text": "漢譯阿含經卷一（大正藏二．六c）。"}
{"id": null, "n": "0074002", "target": "#nkr_note_orig_0074002", "type": "orig", "text": "「受集」，原本有重復。"}
{"id": null, "n": "0075001", "target": "#nkr_note_orig_0075001", "type": "orig", "text": "漢譯未詳。"}
{"id": null, "n": "0075002", "target": "#nkr_note_orig_0075002", "type": "orig", "text": "「得」，原本 yāyaṁ 由暹羅本 sā'ssa 改之。"}
{"id": null, "n": "0076001", "target": "#nkr_note_orig_0076001", "type": "orig", "text": "漢譯未詳。"}
{"id": null, "n": "0078001", "target": "#nkr_note_orig_0078001", "type": "orig", "text": "漢譯雜阿含經卷二（大正藏二．九a）。"}
{"id": null, "n": "0079001", "target": "#nkr_note_orig_0079001", "type": "orig", "text": "漢譯雜阿含經卷二（大正藏二．八c）。"}
{"id": null, "n": "0080002", "target": "#nkr_note_orig_0080002", "type": "orig", "text": "「有堅核」（sārādāyini），用原註之讀法，原本及暹羅本均作 sārādāni。"}
{"id": null, "n": "0080003", "target": "#nkr_note_orig_0080003", "type": "orig", "text": "「諸比丘」，此節暹羅本缺。"}
{"id": null, "n": "0080004", "target": "#nkr_note_orig_0080004", "type": "orig", "text": "「無堅核」，原本無否定辭。"}
{"id": null, "n": "0080005", "target": "#nkr_note_orig_0080005", "type": "orig", "text": "「四識住」，業識所緣之色受想行的四蘊。"}
{"id": null, "n": "0080006", "target": "#nkr_note_orig_0080006", "type": "orig", "text": "「食」者，緣也。"}
{"id": null, "n": "0082001", "target": "#nkr_note_orig_0082001", "type": "orig", "text": "漢譯雜阿含卷二（大正藏二．一六c）。"}
{"id": null, "n": "0082002", "target": "#nkr_note_orig_0082002", "type": "orig", "text": "「非我」，原本 no cassa 由暹羅本 no cassaṁ 改之。"}
{"id": null, "n": "0082003", "target": "#nkr_note_orig_0082003", "type": "orig", "text": "「應無我」，原本 na bhavissati 由暹羅本 na bhavissāmi。"}
{"id": null, "n": "0085004", "target": "#nkr_note_orig_0085004", "type": "orig", "text": "「離想」，原本逸脫。"}
{"id": null, "n": "0086001", "target": "#nkr_note_orig_0086001", "type": "orig", "text": "漢譯雜阿含經卷二（大正藏二．九b）。"}
{"id": null, "n": "0087002", "target": "#nkr_note_orig_0087002", "type": "orig", "text": "「識集」，原本重復「識滅」之誤。"}
{"id": null, "n": "0087003", "target": "#nkr_note_orig_0087003", "type": "orig", "text": "「食」，此處與俱欲貪言為摶食（原註）。"}
{"id": null, "n": "0087004", "target": "#nkr_note_orig_0087004", "type": "orig", "text": "「善向」，原本 supatipatipannā 是 supatipannā 之誤。"}
{"id": null, "n": "0088005", "target": "#nkr_note_orig_0088005", "type": "orig", "text": "「轉」，解作輪迴繫縛。"}
{"id": null, "n": "0090001", "target": "#nkr_note_orig_0090001", "type": "orig", "text": "漢譯雜阿含卷二（大正藏二．一〇a），七處三觀經（大正藏二．四九八c～同大正藏二．八七五b）增一阿含經卷三十五（大正藏二．七五四b）。"}
{"id": null, "n": "0092002", "target": "#nkr_note_orig_0092002", "type": "orig", "text": "「法」之語，原本逸失。"}
{"id": null, "n": "0092003", "target": "#nkr_note_orig_0092003", "type": "orig", "text": "原本之節號碼錯誤，今不改訂。"}
{"id": null, "n": "0095001", "target": "#nkr_note_orig_0095001", "type": "orig", "text": "漢譯雜阿含經卷二（大正藏二．一九b）。"}
{"id": null, "n": "0097001", "target": "#nkr_note_orig_0097001", "type": "orig", "text": "漢譯雜阿含經卷二（大正藏二．七c）律藏大品原典一三頁以下。"}
{"id": null, "n": "0097002", "target": "#nkr_note_orig_0097002", "type": "orig", "text": "「此色」，rūpaṁ ca hidaṁ 之中，最後一語，原本逸失。"}
{"id": null, "n": "0100001", "target": "#nkr_note_orig_0100001", "type": "orig", "text": "漢譯雜阿含卷二（大正藏二．二〇b）。"}
{"id": null, "n": "0101002", "target": "#nkr_note_orig_0101002", "type": "orig", "text": "「眾生」之語，原本逸脫。"}
{"id": null, "n": "0103001", "target": "#nkr_note_orig_0103001", "type": "orig", "text": "律藏大品原典三四頁。"}
{"id": null, "n": "0107001", "target": "#nkr_note_orig_0107001", "type": "orig", "text": "漢譯雜阿含經卷一（大正藏二．四b）。"}
{"id": null, "n": "0108002", "target": "#nkr_note_orig_0108002", "type": "orig", "text": "原本節號錯誤，今不改訂。"}
{"id": null, "n": "0108003", "target": "#nkr_note_orig_0108003", "type": "orig", "text": "「行右繞」，原本逸脫。"}
{"id": null, "n": "0111001", "target": "#nkr_note_orig_0111001", "type": "orig", "text": "漢譯雜阿含經卷一（大正藏二．三b）。"}
{"id": null, "n": "0113001", "target": "#nkr_note_orig_0113001", "type": "orig", "text": "漢譯雜阿含經卷一（大正藏二．三b）。"}
{"id": null, "n": "0114001", "target": "#nkr_note_orig_0114001", "type": "orig", "text": "漢譯雜阿含經卷一（大正藏二．三c）。"}
{"id": null, "n": "0115001", "target": "#nkr_note_orig_0115001", "type": "orig", "text": "漢譯雜阿含經卷一（大正藏二．四a）。"}
{"id": null, "n": "0117001", "target": "#nkr_note_orig_0117001", "type": "orig", "text": "漢譯雜阿含經卷六（大正藏二．三七c）。"}
{"id": null, "n": "0118001", "target": "#nkr_note_orig_0118001", "type": "orig", "text": "漢譯未詳。"}
{"id": null, "n": "0120001", "target": "#nkr_note_orig_0120001", "type": "orig", "text": "漢譯未詳。"}
{"id": null, "n": "0121001", "target": "#nkr_note_orig_0121001", "type": "orig", "text": "漢譯未詳。"}
{"id": null, "n": "0122001", "target": "#nkr_note_orig_0122001", "type": "orig", "text": "漢譯未詳。"}
{"id": null, "n": "0123002", "target": "#nkr_note_orig_0123002", "type": "orig", "text": "「不動」云云，原本 anejanto 由暹羅本及原註 anejan te 改之。"}
{"id": null, "n": "0123003", "target": "#nkr_note_orig_0123003", "type": "orig", "text": "「七正法」，信、慚、愧、多真、發勤、在念、慧之七種（原註）。"}
{"id": null, "n": "0124004", "target": "#nkr_note_orig_0124004", "type": "orig", "text": "「七寶」，謂七覺支（原註）。"}
{"id": null, "n": "0124005", "target": "#nkr_note_orig_0124005", "type": "orig", "text": "「十分」，謂無學位十之分（原註）。"}
{"id": null, "n": "0125006", "target": "#nkr_note_orig_0125006", "type": "orig", "text": "「上下左右」，原註有三釋〔一〕上為頭髮頂、下是蹠、左右是中央，〔二〕是過去、未來、現在，〔三〕是配稱天界、惡趣、人界。"}
{"id": null, "n": "0126001", "target": "#nkr_note_orig_0126001", "type": "orig", "text": "漢譯未詳。和增支部經典第四集三十三經一致。"}
{"id": null, "n": "0129001", "target": "#nkr_note_orig_0129001", "type": "orig", "text": "漢譯雜阿含經卷二（大正藏二．一一b）英譯者，此經名為「師子」是錯誤，應該是云「所食」。於漢譯謂「三世陰世所食經」。"}
{"id": null, "n": "0130002", "target": "#nkr_note_orig_0130002", "type": "orig", "text": "「甘」，原本 madhukaṁ 由暹羅本 madhuraṁ 改之。"}
{"id": null, "n": "0135003", "target": "#nkr_note_orig_0135003", "type": "orig", "text": "「我等」云云，原本 tenābhijānāma 由暹羅本 te nābhijānāma 改之。"}
{"id": null, "n": "0135001", "target": "#nkr_note_orig_0135001", "type": "orig", "text": "漢譯雜阿含經卷十（大正藏二．七一c）中阿含經卷三十四（大正藏一．六四七a）。"}
{"id": null, "n": "0137002", "target": "#nkr_note_orig_0137002", "type": "orig", "text": "「獨」云云，原本 ekavihakāya 由暹羅本 ekadvihikāya 改之。"}
{"id": null, "n": "0137003", "target": "#nkr_note_orig_0137003", "type": "orig", "text": "以下次節至最終，與如是語經九一同文。"}
{"id": null, "n": "0137004", "target": "#nkr_note_orig_0137004", "type": "orig", "text": "如是禁咒原本 abhisāpāyaṁ 由暹羅本 abhisapo 'yaṁ 改之。"}
{"id": null, "n": "0138005", "target": "#nkr_note_orig_0138005", "type": "orig", "text": "「苦於活命」，原本 jīvikā pakatā 由暹羅本 ājivikā 'pakatā 改之。"}
{"id": null, "n": "0138006", "target": "#nkr_note_orig_0138006", "type": "orig", "text": "「我等」云云，原本 atiṇṇamhi 由暹羅本 atiṇṇā 'mha 改之。"}
{"id": null, "n": "0138007", "target": "#nkr_note_orig_0138007", "type": "orig", "text": "此喻出增支部經典原典二．九五，本生經原典一．四八二。"}
{"id": null, "n": "0138008", "target": "#nkr_note_orig_0138008", "type": "orig", "text": "「心」，原本 citassa 是 cittassa 之誤。"}
{"id": null, "n": "0139009", "target": "#nkr_note_orig_0139009", "type": "orig", "text": "常，原本 saṁkhittaṁ 由暹羅本 niccaṁ 改之。"}
{"id": null, "n": "0140001", "target": "#nkr_note_orig_0140001", "type": "orig", "text": "漢譯雜阿含經卷二（大正藏二．一三c）。"}
{"id": null, "n": "0140002", "target": "#nkr_note_orig_0140002", "type": "orig", "text": "「無二」，adutiyo 原本逸失。"}
{"id": null, "n": "0142003", "target": "#nkr_note_orig_0142003", "type": "orig", "text": "「四」，cattāro 原本逸失。"}
{"id": null, "n": "0142004", "target": "#nkr_note_orig_0142004", "type": "orig", "text": "「說法」，原本 desite……dhamme 由暹羅本 desito……dhammo 改之。"}
{"id": null, "n": "0146001", "target": "#nkr_note_orig_0146001", "type": "orig", "text": "漢譯雜阿經卷二（大正藏二．一四b）中部經典一〇九、一一〇。"}
{"id": null, "n": "0147002", "target": "#nkr_note_orig_0147002", "type": "orig", "text": "「比丘」，原本 bhikkhave 是 bhikkhu 之誤。"}
{"id": null, "n": "0153001", "target": "#nkr_note_orig_0153001", "type": "orig", "text": "漢譯雜阿含經卷十（大正藏二．六六a）。"}
{"id": null, "n": "0153002", "target": "#nkr_note_orig_0153002", "type": "orig", "text": "「彼」，原本 ti 是 te 之誤。"}
{"id": null, "n": "0155001", "target": "#nkr_note_orig_0155001", "type": "orig", "text": "漢譯雜阿含經卷十（大正藏二．七一a）。"}
{"id": null, "n": "0159001", "target": "#nkr_note_orig_0159001", "type": "orig", "text": "漢譯雜阿含經卷五（大正藏二．三〇c）。"}
{"id": null, "n": "0162002", "target": "#nkr_note_orig_0162002", "type": "orig", "text": "「色」，原本 rūpā 是 rūpaṁ 之誤。"}
{"id": null, "n": "0162003", "target": "#nkr_note_orig_0162003", "type": "orig", "text": "「如應」，原本 thetato 是 tathato 之誤。"}
{"id": null, "n": "0163004", "target": "#nkr_note_orig_0163004", "type": "orig", "text": "「信」，原本及暹羅本皆 daheyya 由原註 saddaheyya 改之。"}
{"id": null, "n": "0165005", "target": "#nkr_note_orig_0165005", "type": "orig", "text": "「攝持」，原本 adhiṭṭāti 是 adhiṭṭhāti 之誤。"}
{"id": null, "n": "0166006", "target": "#nkr_note_orig_0166006", "type": "orig", "text": "原本 idaṁ ce 是 idaṁ ca 之誤。"}
{"id": null, "n": "0167001", "target": "#nkr_note_orig_0167001", "type": "orig", "text": "漢譯雜阿含經卷五（大正藏二．三二c）。"}
{"id": null, "n": "0168002", "target": "#nkr_note_orig_0168002", "type": "orig", "text": "「順正說」，原本和暹羅本俱為 vādānupāto 由異本讀為 vādānuvādo。"}
{"id": null, "n": "0171001", "target": "#nkr_note_orig_0171001", "type": "orig", "text": "漢譯雜阿含經卷四十七（大正藏二．三四六b），增一阿含經卷十九（大正藏二．六四二b）。"}
{"id": null, "n": "0175002", "target": "#nkr_note_orig_0175002", "type": "orig", "text": "善解脫，原本 vimutto 由暹羅本 suvimutto 改之。"}
{"id": null, "n": "0176003", "target": "#nkr_note_orig_0176003", "type": "orig", "text": "「跋迦梨」，原本逸脫。"}
{"id": null, "n": "0178001", "target": "#nkr_note_orig_0178001", "type": "orig", "text": "漢譯雜阿含經卷二十七（大正藏二．二六七b）。"}
{"id": null, "n": "0180002", "target": "#nkr_note_orig_0180002", "type": "orig", "text": "「前我未」，原本 pubbe……gelaññaṁ（由暹羅本 gelaññe 改為 pubbe……gelañña）。"}
{"id": null, "n": "0180003", "target": "#nkr_note_orig_0180003", "type": "orig", "text": "「我」，原本 so taṁ 由暹羅本 so'haṁ 改之。"}
{"id": null, "n": "0180004", "target": "#nkr_note_orig_0180004", "type": "orig", "text": "「退失」，原註由「教之過失」漢譯云「由三昧退失」。"}
{"id": null, "n": "0182001", "target": "#nkr_note_orig_0182001", "type": "orig", "text": "漢譯雖阿含經卷五（大正藏二．二九c）。"}
{"id": null, "n": "0182001", "target": "#nkr_note_mod_0182001", "type": "mod", "text": "漢譯雜阿含經卷五（大正藏二．二九c）。"}
{"id": null, "n": "0185002", "target": "#nkr_note_orig_0185002", "type": "orig", "text": "莖原本及暹羅本俱為 vaṇṇassa 由異本 vaṇṭassa 改之。"}
{"id": null, "n": "0187003", "target": "#nkr_note_orig_0187003", "type": "orig", "text": "「欲嬈亂而問」，原本 vihesā apekhā pucchimha 由暹羅本 vihesāpekkhā apucchimhā 改之。"}
{"id": null, "n": "0188001", "target": "#nkr_note_orig_0188001", "type": "orig", "text": "漢譯雜含卷十（大正藏二．六六b）。"}
{"id": null, "n": "0189002", "target": "#nkr_note_orig_0189002", "type": "orig", "text": "「恐懼取著」，由暹羅本及註之原本的句讀點改之。"}
{"id": null, "n": "0191003", "target": "#nkr_note_orig_0191003", "type": "orig", "text": "「隨眠」，原本 anusayā 是 anusayaṁ 之誤。"}
{"id": null, "n": "0192001", "target": "#nkr_note_orig_0192001", "type": "orig", "text": "漢譯雜阿含經卷一（大正藏二．五a）。"}
{"id": null, "n": "0194001", "target": "#nkr_note_orig_0194001", "type": "orig", "text": "漢譯雜阿含經卷十（大正藏二．七〇a）。"}
{"id": null, "n": "0196001", "target": "#nkr_note_orig_0196001", "type": "orig", "text": "漢譯雜阿含經卷二（大正藏二．八b）。"}
{"id": null, "n": "0198001", "target": "#nkr_note_orig_0198001", "type": "orig", "text": "漢譯雜阿含經卷十（大正藏二．六八b）五陰譬喻經（大正藏二．五〇一a）佛說水沫所漂經（大正藏二．五〇一c）。"}
{"id": null, "n": "0199002", "target": "#nkr_note_orig_0199002", "type": "orig", "text": "「陽燄流動」，marīcikā 由暹羅本讀為 marīci phandati。"}
{"id": null, "n": "0200003", "target": "#nkr_note_orig_0200003", "type": "orig", "text": "「無核心」，原註 akukkajāta，由「內部無堅固杖」而譯之。"}
{"id": null, "n": "0200004", "target": "#nkr_note_orig_0200004", "type": "orig", "text": "「衢道」，原本 mahāpathe 暹羅本為 catummahāpathe。"}
{"id": null, "n": "0203001", "target": "#nkr_note_orig_0203001", "type": "orig", "text": "漢譯雜阿含經卷十（大正藏二．六七c），中阿經卷十一（大正藏一．四九六a），同卷三十四（大正藏一．六四五c）。"}
{"id": null, "n": "0204002", "target": "#nkr_note_orig_0204002", "type": "orig", "text": "「相似永住」，相似須彌山頂、大地、日月等之永住，而譯（原註）。"}
{"id": null, "n": "0208001", "target": "#nkr_note_orig_0208001", "type": "orig", "text": "漢譯雜阿含經卷十四（大正藏二．六一七b）原本經名有 nakhāsikam 應作 nakhasikhaṁ。"}
{"id": null, "n": "0209002", "target": "#nkr_note_orig_0209002", "type": "orig", "text": "「比丘」，原本 bhikkhave 是 bhikkhu 之誤。"}
{"id": null, "n": "0210001", "target": "#nkr_note_orig_0210001", "type": "orig", "text": "漢譯未詳，對經名不明白，參照前經。"}
{"id": null, "n": "0211001", "target": "#nkr_note_orig_0211001", "type": "orig", "text": "漢譯雜阿含經卷十（大正藏二．六九b）。"}
{"id": null, "n": "0213001", "target": "#nkr_note_orig_0213001", "type": "orig", "text": "漢譯雜阿含經卷十（大正藏二．六九c）。"}
{"id": null, "n": "0214002", "target": "#nkr_note_orig_0214002", "type": "orig", "text": "「名為行之畫」。「是遊方之畫」，名為數論婆羅門外道。彼等以布作褲，由善趣惡趣畫種種幸、不幸，說若行是業必得是果，持此而遊方（原註）。"}
{"id": null, "n": "0214003", "target": "#nkr_note_orig_0214003", "type": "orig", "text": "「所思」，原本 cittatā 由暹羅本 cintitā 改之。"}
{"id": null, "n": "0215001", "target": "#nkr_note_orig_0215001", "type": "orig", "text": "漢譯雜阿含經卷十（大正藏二．六七a）。"}
{"id": null, "n": "0216002", "target": "#nkr_note_orig_0216002", "type": "orig", "text": "以下至本經之終，和增支部經典原典四、一二五以下同文。"}
{"id": null, "n": "0218003", "target": "#nkr_note_orig_0218003", "type": "orig", "text": "「霑」，原本 abhippavaṭṭhāni 由暹羅本 abhippavuṭṭhāni 改之。"}
{"id": null, "n": "0218001", "target": "#nkr_note_orig_0218001", "type": "orig", "text": "漢譯雜阿含經卷十（大正藏二．七〇c）。"}
{"id": null, "n": "0221001", "target": "#nkr_note_orig_0221001", "type": "orig", "text": "原本 -sambhayaṁ 以暹羅本 -savhayaṁ 改之。"}
{"id": null, "n": "0222001", "target": "#nkr_note_orig_0222001", "type": "orig", "text": "漢譯雜阿含經卷三（大正藏二．一八b）。"}
{"id": null, "n": "0224001", "target": "#nkr_note_orig_0224001", "type": "orig", "text": "漢雜阿含經卷三（大正藏二．一八b）。"}
{"id": null, "n": "0225001", "target": "#nkr_note_orig_0225001", "type": "orig", "text": "漢譯雜阿含經卷三（大正藏二．一九a）。"}
{"id": null, "n": "0226001", "target": "#nkr_note_orig_0226001", "type": "orig", "text": "漢譯未詳。"}
{"id": null, "n": "0226002", "target": "#nkr_note_orig_0226002", "type": "orig", "text": "以下原本有省略由暹羅本補之。"}
{"id": null, "n": "0230001", "target": "#nkr_note_orig_0230001", "type": "orig", "text": "漢譯未詳，第一一五經參照。"}
{"id": null, "n": "0231001", "target": "#nkr_note_orig_0231001", "type": "orig", "text": "漢譯雜阿含經卷一（大正藏二．五c）。"}
{"id": null, "n": "0232001", "target": "#nkr_note_orig_0232001", "type": "orig", "text": "前經參照。"}
{"id": null, "n": "0233001", "target": "#nkr_note_orig_0233001", "type": "orig", "text": "漢譯雜阿含經卷二（大正藏二．一九b）。"}
{"id": null, "n": "0235001", "target": "#nkr_note_orig_0235001", "type": "orig", "text": "漢譯雜阿含經卷二（大正藏二．一九c）。"}
{"id": null, "n": "0236001", "target": "#nkr_note_orig_0236001", "type": "orig", "text": "參照前經。"}
{"id": null, "n": "0237001", "target": "#nkr_note_orig_0237001", "type": "orig", "text": "漢譯未詳。"}
{"id": null, "n": "0237001-1", "target": "#nkr_note_orig_0237001-1", "type": "orig", "text": "參照前經。"}
{"id": null, "n": "0238001", "target": "#nkr_note_orig_0238001", "type": "orig", "text": "漢譯雜阿含經卷十（大正藏二．六五b）。"}
{"id": null, "n": "0240001", "target": "#nkr_note_orig_0240001", "type": "orig", "text": "和前完全相同，但「戒具足」改為「有聞」。"}
{"id": null, "n": "0241001", "target": "#nkr_note_orig_0241001", "type": "orig", "text": "漢譯雜阿含經卷一（大正藏二．四c）。"}
{"id": null, "n": "0242001", "target": "#nkr_note_orig_0242001", "type": "orig", "text": "參照前經。"}
{"id": null, "n": "0244001", "target": "#nkr_note_orig_0244001", "type": "orig", "text": "漢譯雜阿含經卷十（大正藏二．六四b）。"}
{"id": null, "n": "0244002", "target": "#nkr_note_orig_0244002", "type": "orig", "text": "「如實」，原本誤為「如法」。"}
{"id": null, "n": "0246001", "target": "#nkr_note_orig_0246001", "type": "orig", "text": "「住」，原本 viharati 是 viharanti 之誤。"}
{"id": null, "n": "0247002", "target": "#nkr_note_orig_0247002", "type": "orig", "text": "「無明」，原本逸失。"}
{"id": null, "n": "0250001", "target": "#nkr_note_orig_0250001", "type": "orig", "text": "「味、過患」之二語，原本逸失。"}
{"id": null, "n": "0250001-1", "target": "#nkr_note_orig_0250001-1", "type": "orig", "text": "「具壽」，原本逸失。"}
{"id": null, "n": "0250002", "target": "#nkr_note_orig_0250002", "type": "orig", "text": "「友！」之下原本有 koṭṭhita 是衍字。"}
{"id": null, "n": "0251001", "target": "#nkr_note_orig_0251001", "type": "orig", "text": "原本有缺失，以前經補之。"}
{"id": null, "n": "0252002", "target": "#nkr_note_orig_0252002", "type": "orig", "text": "原本有缺失，以前經補之。"}
{"id": null, "n": "0254001", "target": "#nkr_note_orig_0254001", "type": "orig", "text": "漢譯未詳。"}
{"id": null, "n": "0255001", "target": "#nkr_note_orig_0255001", "type": "orig", "text": "漢譯未詳。"}
{"id": null, "n": "0257001", "target": "#nkr_note_orig_0257001", "type": "orig", "text": "漢譯雜阿含經卷二（大正藏二．一二a）。"}
{"id": null, "n": "0259001", "target": "#nkr_note_orig_0259001", "type": "orig", "text": "「三」，原本暹羅本俱為「二」。"}
{"id": null, "n": "0259001-1", "target": "#nkr_note_orig_0259001-1", "type": "orig", "text": "漢譯雜阿含經卷七（大正藏二．四三b）。"}
{"id": null, "n": "0261001", "target": "#nkr_note_orig_0261001", "type": "orig", "text": "漢譯雜阿含經卷七（大正藏二．四三a）。"}
{"id": null, "n": "0262002", "target": "#nkr_note_orig_0262002", "type": "orig", "text": "「不取」，底本 api me taṁ……是 api nu taṁ……之誤。"}
{"id": null, "n": "0262001", "target": "#nkr_note_orig_0262001", "type": "orig", "text": "漢譯雜阿含經卷七（大正藏二．四三c）。"}
{"id": null, "n": "0264001", "target": "#nkr_note_orig_0264001", "type": "orig", "text": "漢譯未詳。"}
{"id": null, "n": "0271001", "target": "#nkr_note_orig_0271001", "type": "orig", "text": "漢譯未詳。"}
{"id": null, "n": "0272002", "target": "#nkr_note_orig_0272002", "type": "orig", "text": "「大德！不也」一句原本逸失。"}
{"id": null, "n": "0273003", "target": "#nkr_note_orig_0273003", "type": "orig", "text": "原本 vijjā samudayañ 由暹羅本 dhamma-kathikāvijjā 改之。"}
{"id": null, "n": "0275001", "target": "#nkr_note_orig_0275001", "type": "orig", "text": "漢譯雜阿含經卷六（大正藏二．三九b）。"}
{"id": null, "n": "0276002", "target": "#nkr_note_orig_0276002", "type": "orig", "text": "「甚過」，原本 assa 由暹羅本 accasarā。"}
{"id": null, "n": "0277001", "target": "#nkr_note_orig_0277001", "type": "orig", "text": "漢譯雜阿含經卷六（大正藏二．四〇a）。"}
{"id": null, "n": "0277002", "target": "#nkr_note_orig_0277002", "type": "orig", "text": "「眾生」（satta），於巴利語形和「染著」同。"}
{"id": null, "n": "0278001", "target": "#nkr_note_orig_0278001", "type": "orig", "text": "漢譯雜阿含經卷六（大正藏二．三七c）「有綱」於原註有 bhava-rajju 漢譯為「有流」。"}
{"id": null, "n": "0278002", "target": "#nkr_note_orig_0278002", "type": "orig", "text": "「有綱、有綱」，於原本有「有綱、有綱滅。」今改之。"}
{"id": null, "n": "0279001", "target": "#nkr_note_orig_0279001", "type": "orig", "text": "漢譯雜阿含經卷六（大正藏二．三七c）本經以下十經止，與「蘊相應」第一〇六～一一二經之內容同。"}
{"id": null, "n": "0282001", "target": "#nkr_note_orig_0282001", "type": "orig", "text": "漢譯雜阿含經卷六（大正藏二．四〇a）。"}
{"id": null, "n": "0284001", "target": "#nkr_note_orig_0284001", "type": "orig", "text": "漢譯雜阿含經卷六（大正藏二．四〇b）。"}
{"id": null, "n": "0285001", "target": "#nkr_note_orig_0285001", "type": "orig", "text": "漢譯雜阿含經卷六（大正藏二．三九c）。"}
{"id": null, "n": "0287001", "target": "#nkr_note_orig_0287001", "type": "orig", "text": "漢譯雜阿含經卷六（大正藏二．四〇c）。"}
{"id": null, "n": "0288001", "target": "#nkr_note_orig_0288001", "type": "orig", "text": "漢譯雜阿含經卷六（大正藏二．四一a）漢譯為「斷法」。"}
{"id": null, "n": "0289001", "target": "#nkr_note_orig_0289001", "type": "orig", "text": "漢譯雜阿含經卷六（大正藏二．四一a）。"}
{"id": null, "n": "0290001", "target": "#nkr_note_orig_0290001", "type": "orig", "text": "「大德」，bhante vuccati 之兩語原本逸失。"}
{"id": null, "n": "0291001", "target": "#nkr_note_orig_0291001", "type": "orig", "text": "漢譯雜阿含經卷六（大正藏二．四〇c）。"}
{"id": null, "n": "0292001", "target": "#nkr_note_orig_0292001", "type": "orig", "text": "漢譯雜阿含經卷六（大正藏二．四〇c）。"}
{"id": null, "n": "0292001-1", "target": "#nkr_note_orig_0292001-1", "type": "orig", "text": "漢譯雜阿含經卷六（大正藏二．四一a）。"}
{"id": null, "n": "0298001", "target": "#nkr_note_orig_0298001", "type": "orig", "text": "漢譯雜阿含經卷七（大正藏二．四五a）。"}
{"id": null, "n": "0301001", "target": "#nkr_note_orig_0301001", "type": "orig", "text": "前半是與蘊相應一五〇經同。"}
{"id": null, "n": "0303001", "target": "#nkr_note_orig_0303001", "type": "orig", "text": "前半是與蘊相應一五一經同。"}
{"id": null, "n": "0304001", "target": "#nkr_note_orig_0304001", "type": "orig", "text": "前半是與蘊相應第一五二經同。"}
{"id": null, "n": "0306001", "target": "#nkr_note_orig_0306001", "type": "orig", "text": "漢譯雜阿含經卷七（大正藏二．四三c）。"}
{"id": null, "n": "0306002", "target": "#nkr_note_orig_0306002", "type": "orig", "text": "以下出長部經典（原典一．五五頁），中部經典（原典一．五一五頁）。"}
{"id": null, "n": "0306003", "target": "#nkr_note_orig_0306003", "type": "orig", "text": "「輿牀」，原本 āyanti pañcamā 是 āsandi-pañcamā 之誤。"}
{"id": null, "n": "0308004", "target": "#nkr_note_orig_0308004", "type": "orig", "text": "「決定」一語，原本逸失。"}
{"id": null, "n": "0309001", "target": "#nkr_note_orig_0309001", "type": "orig", "text": "漢譯雜阿含經卷七（大正藏二．四四b）。"}
{"id": null, "n": "0309002", "target": "#nkr_note_orig_0309002", "type": "orig", "text": "「煮、令煮」，原本 vadhato vadhāpayata 以 pacato pācayato 改之。"}
{"id": null, "n": "0309003", "target": "#nkr_note_orig_0309003", "type": "orig", "text": "原本節號碼有誤，不改之。"}
{"id": null, "n": "0311001", "target": "#nkr_note_orig_0311001", "type": "orig", "text": "漢譯雜阿含經卷七（大正藏二．四四a）長部經典（原典一．五三頁），中部經典（原典一．五一六頁）參照。"}
{"id": null, "n": "0313001", "target": "#nkr_note_orig_0313001", "type": "orig", "text": "漢譯雜阿含經卷七（大正藏二．四四c）長部經典（原典一．五六頁、五三～四頁）中部經典（原典一．五一七頁）。"}
{"id": null, "n": "0313001", "target": "#nkr_note_mod_0313001", "type": "mod", "text": "漢譯雜阿含經卷七（大正藏二．四四c）長部經典（原典一．五六頁、五三【南傳】，～四頁）中部經典（原典一．五一七頁）。"}
{"id": null, "n": "0314002", "target": "#nkr_note_orig_0314002", "type": "orig", "text": "「七天」，原本 satta dibbā 以 satta devā 改之。"}
{"id": null, "n": "0314003", "target": "#nkr_note_orig_0314003", "type": "orig", "text": "「七嶮」之前語 pavudhā 完全不明白，於長部經典原註可說是 pavuṭā ti gaṇṭhikā。"}
{"id": null, "n": "0316001", "target": "#nkr_note_orig_0316001", "type": "orig", "text": "本經以下第十八經止，漢譯雜阿含經卷七（大正藏二．四五b）。"}
{"id": null, "n": "0322001", "target": "#nkr_note_orig_0322001", "type": "orig", "text": "由暹羅本之讀法而譯之。"}
{"id": null, "n": "0325001", "target": "#nkr_note_orig_0325001", "type": "orig", "text": "漢譯雜阿含經卷七（大正藏二．四五a）。"}
{"id": null, "n": "0332001", "target": "#nkr_note_orig_0332001", "type": "orig", "text": "「由取」，原本於此後，插進「此」是現貪。"}
{"id": null, "n": "0336001", "target": "#nkr_note_orig_0336001", "type": "orig", "text": "「知」，原本 pajānāmiti 是 pajānātiti 之誤。"}
{"id": null, "n": "0340001", "target": "#nkr_note_orig_0340001", "type": "orig", "text": "「鼻識所生之受」及「身觸所生之受」，原本缺失。"}
{"id": null, "n": "0341001", "target": "#nkr_note_orig_0341001", "type": "orig", "text": "「識界」，原本缺失。"}
{"id": null, "n": "0344001", "target": "#nkr_note_orig_0344001", "type": "orig", "text": "漢譯雜阿含經卷十三（大正藏二．九〇c）。"}
{"id": null, "n": "0358001", "target": "#nkr_note_orig_0358001", "type": "orig", "text": "漢譯雜阿含經卷十八（大正藏二．一三一）於漢譯有淨口外道出家尼。依原註淨口是出家尼之名。"}
{"id": null, "n": "0359002", "target": "#nkr_note_orig_0359002", "type": "orig", "text": "「事明」，原註「事明」知胡蘆、南瓜、蘿葡等事之果、成、因、的方便，又長部經典原註（一．九三頁）云相「宅地、園地」等得失之明。"}
{"id": null, "n": "0360003", "target": "#nkr_note_orig_0360003", "type": "orig", "text": "「滅九」，由暹羅本 nirodho navamo vutto 讀之。"}
{"id": null, "n": "0362001", "target": "#nkr_note_orig_0362001", "type": "orig", "text": "漢譯增一阿含經卷十九（大正藏二．六四六a）長阿含世記經（大正藏一．一二七）。"}
{"id": null, "n": "0363001", "target": "#nkr_note_orig_0363001", "type": "orig", "text": "「比丘」，原本誤為諸比丘。"}
{"id": null, "n": "0366001", "target": "#nkr_note_orig_0366001", "type": "orig", "text": "原本「命終」之語缺失。"}
{"id": null, "n": "0371001", "target": "#nkr_note_orig_0371001", "type": "orig", "text": "漢譯增一阿含經卷十九（大正藏二．六四六a）長阿含世記經（大正藏一．一二七）。"}
{"id": null, "n": "0371001-1", "target": "#nkr_note_orig_0371001-1", "type": "orig", "text": "漢譯一阿含經卷十九（大正藏二．六四六a）長阿含世記經（大正藏一．一二七）。"}
{"id": null, "n": "0381001", "target": "#nkr_note_orig_0381001", "type": "orig", "text": "漢譯雜阿含經卷三十一（大正藏二．二二〇b）。"}
{"id": null, "n": "0381002", "target": "#nkr_note_orig_0381002", "type": "orig", "text": "「我、汝等」云云，由暹羅本讀為 valāhakāyike deve ov bhikkhave desissāmi。"}
{"id": null, "n": "0383001", "target": "#nkr_note_orig_0383001", "type": "orig", "text": "「比丘」，原本誤為諸比丘。"}
{"id": null, "n": "0387001", "target": "#nkr_note_orig_0387001", "type": "orig", "text": "漢譯雜阿含經卷四十八（大正藏二．二四六a），別譯雜含經卷十（大正藏二．四四五c）。"}
{"id": null, "n": "0394001", "target": "#nkr_note_orig_0394001", "type": "orig", "text": "「尊瞿曇」，原本缺失。"}
{"id": null, "n": "0397001", "target": "#nkr_note_orig_0397001", "type": "orig", "text": "漢譯雜阿含經卷三十一（大正藏二．二二二c）。"}
{"id": null, "n": "0399001", "target": "#nkr_note_orig_0399001", "type": "orig", "text": "「安樂」，原本 kallavā 及由本文中之 kallakusala 後文及暹羅本 kallita, kallitakusala 改之。"}
{"id": null, "n": "0409001", "target": "#nkr_note_orig_0409001", "type": "orig", "text": "原本在此下有一文，當有八經之廣說而成，暹羅本沒有，恐怕是衍文。"}
{"id": null, "n": "0410001", "target": "#nkr_note_orig_0410001", "type": "orig", "text": "原本有「止住——所緣——」而改之。"}
{"id": null, "n": "0418001", "target": "#nkr_note_orig_0418001", "type": "orig", "text": "「世尊之所說」，原本 bhāsitam 之前缺失 bhagavato 一語。"}
