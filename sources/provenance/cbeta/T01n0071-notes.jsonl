{"id": null, "n": "0876013", "target": "#nkr_note_mod_0876013", "type": "mod", "text": "梵【大】，佛說梵【宋】【元】【明】"}
{"id": null, "n": "0876014", "target": "#nkr_note_mod_0876014", "type": "mod", "text": "西域三藏【大】，沙門【宋】【元】【明】"}
{"id": null, "n": "0876015", "target": "#nkr_note_mod_0876015", "type": "mod", "text": "婆【大】，有婆【宋】【元】【明】"}
{"id": null, "n": "0876016", "target": "#nkr_note_mod_0876016", "type": "mod", "text": "大【大】，人【宋】【元】【明】"}
{"id": null, "n": "0876017", "target": "#nkr_note_mod_0876017", "type": "mod", "text": "佳【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0877001", "target": "#nkr_note_mod_0877001", "type": "mod", "text": "反【大】，更【宋】【元】【明】"}
{"id": null, "n": "0877002", "target": "#nkr_note_mod_0877002", "type": "mod", "text": "所【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0877003", "target": "#nkr_note_mod_0877003", "type": "mod", "text": "甚【大】，其【宋】【元】【明】"}
{"id": null, "n": "0877004", "target": "#nkr_note_mod_0877004", "type": "mod", "text": "落【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0877005", "target": "#nkr_note_mod_0877005", "type": "mod", "text": "渡【大】＊，度【宋】【元】【明】＊"}
{"id": null, "n": "0877006", "target": "#nkr_note_mod_0877006", "type": "mod", "text": "耶【大】，邪【宋】【元】【明】"}
{"id": null, "n": "0877007", "target": "#nkr_note_mod_0877007", "type": "mod", "text": "為【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0877008", "target": "#nkr_note_mod_0877008", "type": "mod", "text": "為生…為【大】，生子名是【宋】【元】【明】"}
{"id": null, "n": "0877009", "target": "#nkr_note_mod_0877009", "type": "mod", "text": "佳【大】＊，往【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0878001", "target": "#nkr_note_mod_0878001", "type": "mod", "text": "焰【大】，爛【宋】【元】【明】"}
{"id": null, "n": "0878002", "target": "#nkr_note_mod_0878002", "type": "mod", "text": "旄【大】，毛【宋】【元】【明】"}
{"id": null, "n": "0878003", "target": "#nkr_note_mod_0878003", "type": "mod", "text": "阿【大】，何【元】"}
{"id": null, "n": "0878004", "target": "#nkr_note_mod_0878004", "type": "mod", "text": "近【大】，之【宋】【元】【明】"}
{"id": null, "n": "0878005", "target": "#nkr_note_mod_0878005", "type": "mod", "text": "請【大】，謂【宋】【元】【明】"}
{"id": null, "n": "0878006", "target": "#nkr_note_mod_0878006", "type": "mod", "text": "斂【大】，歛【宋】【元】"}
{"id": null, "n": "0878007", "target": "#nkr_note_mod_0878007", "type": "mod", "text": "梵【大】，佛說梵【宋】【元】【明】"}
