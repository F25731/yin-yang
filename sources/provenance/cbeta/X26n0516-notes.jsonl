{"id": null, "n": null, "target": null, "type": null, "text": "減也"}
{"id": null, "n": null, "target": null, "type": null, "text": "空也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即色也"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼在第八"}
