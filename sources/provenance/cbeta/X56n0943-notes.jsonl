{"id": null, "n": null, "target": null, "type": null, "text": "文句只爾，記釋亦略，至下\n隨釋引之。"}
{"id": null, "n": null, "target": null, "type": null, "text": "記並無解"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上彼文"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
