{"id": null, "n": "0778010", "target": "#nkr_note_mod_0778010", "type": "mod", "text": "〔號妙花〕－【宋】【元】【明】【宮】次同"}
{"id": null, "n": "0778011", "target": "#nkr_note_mod_0778011", "type": "mod", "text": "天竺三藏【大】，西域沙門【宋】【元】【明】【宮】"}
{"id": null, "n": "0778012", "target": "#nkr_note_mod_0778012", "type": "mod", "text": "逕【大】，經【宋】【元】【明】【宮】"}
{"id": null, "n": "0778013", "target": "#nkr_note_mod_0778013", "type": "mod", "text": "遇【大】，過【宮】"}
{"id": null, "n": "0778014", "target": "#nkr_note_mod_0778014", "type": "mod", "text": "䩭【大】，羈【元】【明】"}
{"id": null, "n": "0778015", "target": "#nkr_note_mod_0778015", "type": "mod", "text": "三【大】，三三【元】"}
{"id": null, "n": "0778016", "target": "#nkr_note_mod_0778016", "type": "mod", "text": "時【大】，法時【元】【明】"}
{"id": null, "n": "0778017", "target": "#nkr_note_mod_0778017", "type": "mod", "text": "夫【大】，人【明】"}
{"id": null, "n": "0778018", "target": "#nkr_note_mod_0778018", "type": "mod", "text": "遙【大】，途【宋】【元】【明】【宮】"}
{"id": null, "n": "0778019", "target": "#nkr_note_mod_0778019", "type": "mod", "text": "以【大】，已【宋】【元】【明】【宮】"}
{"id": null, "n": "0778020", "target": "#nkr_note_mod_0778020", "type": "mod", "text": "惟【大】，唯【宋】【元】【明】【宮】"}
{"id": null, "n": "0778010", "target": "#nkr_note_orig_0778010", "type": "orig", "text": "〔號妙花〕－【三】【宮】次同"}
