{"id": null, "n": null, "target": null, "type": null, "text": "凡一字皆具十\n義"}
{"id": null, "n": null, "target": null, "type": null, "text": "矣"}
{"id": null, "n": null, "target": null, "type": null, "text": "符篇"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X10n0253_p0283c03"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X10n0253_p0313b11"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T51n2076_p0384b13"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T39n1795_p0559b05"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "X09n0243_p0393a24"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T17n0842_p0921b17"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X10n0253_p0374a08"}
{"id": null, "n": "0206002", "target": "#nkr_note_mod_0206002", "type": "mod", "text": "羗【CB】，差【卍續】，差疑羌"}
{"id": null, "n": "0167001", "target": "#nkr_note_orig_0167001", "type": "orig", "text": "死疑剩字"}
{"id": null, "n": "0168001", "target": "#nkr_note_orig_0168001", "type": "orig", "text": "討土槁切音叨尋也"}
{"id": null, "n": "0168002", "target": "#nkr_note_orig_0168002", "type": "orig", "text": "指一作旨"}
{"id": null, "n": "0168003", "target": "#nkr_note_orig_0168003", "type": "orig", "text": "遂疑逐"}
{"id": null, "n": "0169001", "target": "#nkr_note_orig_0169001", "type": "orig", "text": "𤴯胡翫切音換潰胡對切音會逃散也"}
{"id": null, "n": "0170001", "target": "#nkr_note_orig_0170001", "type": "orig", "text": "＊造胡道切水盛貌（造ハ浩カ。󴦒）"}
{"id": null, "n": "0170002", "target": "#nkr_note_orig_0170002", "type": "orig", "text": "瀚音干海名"}
{"id": null, "n": "0170003", "target": "#nkr_note_orig_0170003", "type": "orig", "text": "怛疑坦"}
{"id": null, "n": "0170004", "target": "#nkr_note_orig_0170004", "type": "orig", "text": "壤如掌切"}
{"id": null, "n": "0170005", "target": "#nkr_note_orig_0170005", "type": "orig", "text": "漏疑滿"}
{"id": null, "n": "0170006", "target": "#nkr_note_orig_0170006", "type": "orig", "text": "廉疑麤"}
{"id": null, "n": "0171001", "target": "#nkr_note_orig_0171001", "type": "orig", "text": "獐止良切音張似鹿小角"}
{"id": null, "n": "0171002", "target": "#nkr_note_orig_0171002", "type": "orig", "text": "手疑乎"}
{"id": null, "n": "0171003", "target": "#nkr_note_orig_0171003", "type": "orig", "text": "堆阜堆都回切對聚土云阜房缶切浮大陸山無石云也"}
{"id": null, "n": "0171004", "target": "#nkr_note_orig_0171004", "type": "orig", "text": "瓊渠營切赤玉也"}
{"id": null, "n": "0173001", "target": "#nkr_note_orig_0173001", "type": "orig", "text": "黨丁朗切朋也"}
{"id": null, "n": "0173002", "target": "#nkr_note_orig_0173002", "type": "orig", "text": "壅於容切音雍塞也障也"}
{"id": null, "n": "0173003", "target": "#nkr_note_orig_0173003", "type": "orig", "text": "謂上疑脫真"}
{"id": null, "n": "0174001", "target": "#nkr_note_orig_0174001", "type": "orig", "text": "輟朱劣切音拙止也"}
{"id": null, "n": "0174002", "target": "#nkr_note_orig_0174002", "type": "orig", "text": "纖細也"}
{"id": null, "n": "0175001", "target": "#nkr_note_orig_0175001", "type": "orig", "text": "讎視周切"}
{"id": null, "n": "0176001", "target": "#nkr_note_orig_0176001", "type": "orig", "text": "竅口弔切穴也"}
{"id": null, "n": "0176002", "target": "#nkr_note_orig_0176002", "type": "orig", "text": "嘆疑喚"}
{"id": null, "n": "0176003", "target": "#nkr_note_orig_0176003", "type": "orig", "text": "摶徒官切音團周禮羽人百羽為摶"}
{"id": null, "n": "0176004", "target": "#nkr_note_orig_0176004", "type": "orig", "text": "縈於營切絆補畔切"}
{"id": null, "n": "0176005", "target": "#nkr_note_orig_0176005", "type": "orig", "text": "垣疑恒"}
{"id": null, "n": "0177001", "target": "#nkr_note_orig_0177001", "type": "orig", "text": "語疑悟"}
{"id": null, "n": "0179001", "target": "#nkr_note_orig_0179001", "type": "orig", "text": "痊且緣切音詮病除也"}
{"id": null, "n": "0180001", "target": "#nkr_note_orig_0180001", "type": "orig", "text": "憋耻力切從也歟"}
{"id": null, "n": "0180j01", "target": "#nkr_note_orig_0180j01", "type": "orig", "text": "四請修方便也"}
{"id": null, "n": "0181001", "target": "#nkr_note_orig_0181001", "type": "orig", "text": "著疑看"}
{"id": null, "n": "0181002", "target": "#nkr_note_orig_0181002", "type": "orig", "text": "智疑都"}
{"id": null, "n": "0182001", "target": "#nkr_note_orig_0182001", "type": "orig", "text": "確口角切堅也"}
{"id": null, "n": "0182002", "target": "#nkr_note_orig_0182002", "type": "orig", "text": "丙疑兩"}
{"id": null, "n": "0182003", "target": "#nkr_note_orig_0182003", "type": "orig", "text": "金疑全"}
{"id": null, "n": "0182004", "target": "#nkr_note_orig_0182004", "type": "orig", "text": "般疑船"}
{"id": null, "n": "0184001", "target": "#nkr_note_orig_0184001", "type": "orig", "text": "地下疑脫歸地二字"}
{"id": null, "n": "0188001", "target": "#nkr_note_orig_0188001", "type": "orig", "text": "緣疑絲"}
{"id": null, "n": "0189001", "target": "#nkr_note_orig_0189001", "type": "orig", "text": "烱居永切音憬炎蒸"}
{"id": null, "n": "0189002", "target": "#nkr_note_orig_0189002", "type": "orig", "text": "益疑葢"}
{"id": null, "n": "0192001", "target": "#nkr_note_orig_0192001", "type": "orig", "text": "󴑰或謂之誤乎"}
{"id": null, "n": "0196001", "target": "#nkr_note_orig_0196001", "type": "orig", "text": "＊諦雄皆切音骸和也合也（諦ハ本文ニ諧トツクル。󴦒）"}
{"id": null, "n": "0196002", "target": "#nkr_note_orig_0196002", "type": "orig", "text": "間疑問"}
{"id": null, "n": "0196003", "target": "#nkr_note_orig_0196003", "type": "orig", "text": "天字疑剩"}
{"id": null, "n": "0197001", "target": "#nkr_note_orig_0197001", "type": "orig", "text": "羅疑螺"}
{"id": null, "n": "0197002", "target": "#nkr_note_orig_0197002", "type": "orig", "text": "聲字疑剩"}
{"id": null, "n": "0197003", "target": "#nkr_note_orig_0197003", "type": "orig", "text": "十上疑脫三"}
{"id": null, "n": "0200001", "target": "#nkr_note_orig_0200001", "type": "orig", "text": "銷疑可在下併字下歟"}
{"id": null, "n": "0201001", "target": "#nkr_note_orig_0201001", "type": "orig", "text": "心從前恐脫一段之文未見良本無由補之"}
{"id": null, "n": "0203001", "target": "#nkr_note_orig_0203001", "type": "orig", "text": "得下恐是於字"}
{"id": null, "n": "0203002", "target": "#nkr_note_orig_0203002", "type": "orig", "text": "持疑時"}
{"id": null, "n": "0204001", "target": "#nkr_note_orig_0204001", "type": "orig", "text": "絕疑純"}
{"id": null, "n": "0205001", "target": "#nkr_note_orig_0205001", "type": "orig", "text": "󳴈初用功音早擊也"}
{"id": null, "n": "0205002", "target": "#nkr_note_orig_0205002", "type": "orig", "text": "戈疑才"}
{"id": null, "n": "0205003", "target": "#nkr_note_orig_0205003", "type": "orig", "text": "手疑乎"}
{"id": null, "n": "0205004", "target": "#nkr_note_orig_0205004", "type": "orig", "text": "簦笈書箱也"}
{"id": null, "n": "0206001", "target": "#nkr_note_orig_0206001", "type": "orig", "text": "恨疑痕"}
{"id": null, "n": "0206002", "target": "#nkr_note_orig_0206002", "type": "orig", "text": "差疑羌"}
{"id": null, "n": "0206003", "target": "#nkr_note_orig_0206003", "type": "orig", "text": "墳疑憤"}
{"id": null, "n": "0207001", "target": "#nkr_note_orig_0207001", "type": "orig", "text": "怛疑坦"}
{"id": null, "n": "0208001", "target": "#nkr_note_orig_0208001", "type": "orig", "text": "經無於字恐衍文"}
{"id": null, "n": "0210001", "target": "#nkr_note_orig_0210001", "type": "orig", "text": "真疑直"}
{"id": null, "n": "0210002", "target": "#nkr_note_orig_0210002", "type": "orig", "text": "本疑亦"}
{"id": null, "n": "0211001", "target": "#nkr_note_orig_0211001", "type": "orig", "text": "澤疑譯"}
{"id": null, "n": "0211002", "target": "#nkr_note_orig_0211002", "type": "orig", "text": "四疑回"}
{"id": null, "n": "0212001", "target": "#nkr_note_orig_0212001", "type": "orig", "text": "者字疑剩"}
{"id": null, "n": "0212002", "target": "#nkr_note_orig_0212002", "type": "orig", "text": "乃疑及"}
{"id": null, "n": "0212003", "target": "#nkr_note_orig_0212003", "type": "orig", "text": "乘疑埀"}
{"id": null, "n": "0213001", "target": "#nkr_note_orig_0213001", "type": "orig", "text": "耗虎告切虗也散也"}
{"id": null, "n": "0214001", "target": "#nkr_note_orig_0214001", "type": "orig", "text": "不假及此明下疑是支註"}
{"id": null, "n": "0214002", "target": "#nkr_note_orig_0214002", "type": "orig", "text": "鏞大鐘也"}
{"id": null, "n": "0214003", "target": "#nkr_note_orig_0214003", "type": "orig", "text": "者字未考"}
{"id": null, "n": "0217001", "target": "#nkr_note_orig_0217001", "type": "orig", "text": "今上經有汝字"}
{"id": null, "n": "0218001", "target": "#nkr_note_orig_0218001", "type": "orig", "text": "文疑夫"}
{"id": null, "n": "0219001", "target": "#nkr_note_orig_0219001", "type": "orig", "text": "䩕牛唐切絲屣本經如貝聲"}
{"id": null, "n": "0220001", "target": "#nkr_note_orig_0220001", "type": "orig", "text": "慈疑茲"}
{"id": null, "n": "0221001", "target": "#nkr_note_orig_0221001", "type": "orig", "text": "牛疑手"}
{"id": null, "n": "0221002", "target": "#nkr_note_orig_0221002", "type": "orig", "text": "不合疑反合歟"}
{"id": null, "n": "0222001", "target": "#nkr_note_orig_0222001", "type": "orig", "text": "宇疑寧"}
{"id": null, "n": "0223001", "target": "#nkr_note_orig_0223001", "type": "orig", "text": "壽疑嘉"}
{"id": null, "n": "0223002", "target": "#nkr_note_orig_0223002", "type": "orig", "text": "謂疑得"}
{"id": null, "n": "0225001", "target": "#nkr_note_orig_0225001", "type": "orig", "text": "狀疑牀"}
{"id": null, "n": "0225002", "target": "#nkr_note_orig_0225002", "type": "orig", "text": "數疑敷"}
{"id": null, "n": "0226001", "target": "#nkr_note_orig_0226001", "type": "orig", "text": "䖍處疑致䖍"}
{"id": null, "n": "0226002", "target": "#nkr_note_orig_0226002", "type": "orig", "text": "摶徒桓切圜也"}
{"id": null, "n": "0230001", "target": "#nkr_note_orig_0230001", "type": "orig", "text": "不得二字疑剩"}
{"id": null, "n": "0230002", "target": "#nkr_note_orig_0230002", "type": "orig", "text": "今上經有汝字"}
{"id": null, "n": "0231001", "target": "#nkr_note_orig_0231001", "type": "orig", "text": "貪疑含"}
{"id": null, "n": "0232001", "target": "#nkr_note_orig_0232001", "type": "orig", "text": "瑕下疑脫翳"}
{"id": null, "n": "0234001", "target": "#nkr_note_orig_0234001", "type": "orig", "text": "便疑使"}
{"id": null, "n": "0235001", "target": "#nkr_note_orig_0235001", "type": "orig", "text": "若下疑心"}
{"id": null, "n": "0236001", "target": "#nkr_note_orig_0236001", "type": "orig", "text": "八上疑礙"}
{"id": null, "n": "0236002", "target": "#nkr_note_orig_0236002", "type": "orig", "text": "等本經作非"}
{"id": null, "n": "0236003", "target": "#nkr_note_orig_0236003", "type": "orig", "text": "本經無如字"}
{"id": null, "n": "0236004", "target": "#nkr_note_orig_0236004", "type": "orig", "text": "等下經有即從座起頂五字"}
