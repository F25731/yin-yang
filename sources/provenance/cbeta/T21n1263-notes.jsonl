{"id": null, "n": null, "target": null, "type": null, "text": "甲午"}
{"id": null, "n": "0291008", "target": "#nkr_note_mod_0291008", "type": "mod", "text": "自【大】，白【乙】"}
{"id": null, "n": "0291009", "target": "#nkr_note_mod_0291009", "type": "mod", "text": "火【大】，大【乙】"}
{"id": null, "n": "0291010", "target": "#nkr_note_mod_0291010", "type": "mod", "text": "片【大】，行【丙】"}
{"id": null, "n": "0291011", "target": "#nkr_note_mod_0291011", "type": "mod", "text": "十【大】，十九【考偽-丁】"}
{"id": null, "n": "0291012", "target": "#nkr_note_mod_0291012", "type": "mod", "text": "證【大】，稱【丁】"}
{"id": null, "n": "0291013", "target": "#nkr_note_mod_0291013", "type": "mod", "text": "云云【大】，心【甲】【丁】"}
{"id": null, "n": "0291014", "target": "#nkr_note_mod_0291014", "type": "mod", "text": "誦【大】，無誦【乙】【丙】"}
{"id": null, "n": "0291015", "target": "#nkr_note_mod_0291015", "type": "mod", "text": "乏【大】，〔－〕【甲】【丁】"}
{"id": null, "n": "0292001", "target": "#nkr_note_mod_0292001", "type": "mod", "text": "於【大】，投於【丁】"}
{"id": null, "n": "0292002", "target": "#nkr_note_mod_0292002", "type": "mod", "text": "持【大】，指【乙】【丙】"}
{"id": null, "n": "0292003", "target": "#nkr_note_mod_0292003", "type": "mod", "text": "縶【大】，𮂑【乙】"}
{"id": null, "n": "0292004", "target": "#nkr_note_mod_0292004", "type": "mod", "text": "欲【大】，意欲【甲】【乙】【丁】"}
{"id": null, "n": "0292006", "target": "#nkr_note_mod_0292006", "type": "mod", "text": "娑嚩【大】，莎【丙】【丁】"}
{"id": null, "n": "0292007", "target": "#nkr_note_mod_0292007", "type": "mod", "text": "阿【大】，阿阿【甲】【丙】"}
{"id": null, "n": "0292008", "target": "#nkr_note_mod_0292008", "type": "mod", "text": "蘖【大】＊，蘖車【乙】＊，蘖󰋲車【丙】"}
{"id": null, "n": "0292009", "target": "#nkr_note_mod_0292009", "type": "mod", "text": "阿【大】，〔－〕【甲】【丙】"}
{"id": null, "n": "0292010", "target": "#nkr_note_mod_0292010", "type": "mod", "text": "莎【大】，娑【丁】"}
{"id": null, "n": "0292011", "target": "#nkr_note_mod_0292011", "type": "mod", "text": "下【大】，上【丁】"}
{"id": null, "n": "0292012", "target": "#nkr_note_mod_0292012", "type": "mod", "text": "發【大】，〔－〕【甲】【乙】【丙】"}
{"id": null, "n": "0292013", "target": "#nkr_note_mod_0292013", "type": "mod", "text": "曰【大】，〔－〕【丙】"}
{"id": null, "n": "0292014", "target": "#nkr_note_mod_0292014", "type": "mod", "text": "𤙖【大】，吽【甲】【乙】【丁】"}
{"id": null, "n": "0291007", "target": "#nkr_note_orig_0291007", "type": "orig", "text": "【原】保延三年寫高山寺藏本，【甲】高山寺藏古寫本，【乙】寶壽院藏古寫本，【丙】建長八年寫東寺三密藏本，【丁】黃檗版淨嚴等加筆本"}
{"id": null, "n": "0291008", "target": "#nkr_note_orig_0291008", "type": "orig", "text": "自＝白【乙】"}
{"id": null, "n": "0291009", "target": "#nkr_note_orig_0291009", "type": "orig", "text": "火＝大【乙】"}
{"id": null, "n": "0291010", "target": "#nkr_note_orig_0291010", "type": "orig", "text": "片＝行【丙】"}
{"id": null, "n": "0291011", "target": "#nkr_note_orig_0291011", "type": "orig", "text": "十＋（九）ヵ【丁】"}
{"id": null, "n": "0291012", "target": "#nkr_note_orig_0291012", "type": "orig", "text": "證＝稱【丁】"}
{"id": null, "n": "0291013", "target": "#nkr_note_orig_0291013", "type": "orig", "text": "云云＝心【甲】【丁】"}
{"id": null, "n": "0291014", "target": "#nkr_note_orig_0291014", "type": "orig", "text": "（無）＋誦【乙】【丙】"}
{"id": null, "n": "0291015", "target": "#nkr_note_orig_0291015", "type": "orig", "text": "〔乏〕－【甲】【丁】"}
{"id": null, "n": "0292001", "target": "#nkr_note_orig_0292001", "type": "orig", "text": "（投）＋於【丁】"}
{"id": null, "n": "0292002", "target": "#nkr_note_orig_0292002", "type": "orig", "text": "持＝指【乙】【丙】"}
{"id": null, "n": "0292003", "target": "#nkr_note_orig_0292003", "type": "orig", "text": "縶＝𮂑【乙】"}
{"id": null, "n": "0292004", "target": "#nkr_note_orig_0292004", "type": "orig", "text": "（意）＋欲【甲】【乙】【丁】"}
{"id": null, "n": "0292005", "target": "#nkr_note_orig_0292005", "type": "orig", "text": "以下梵字原本甲本乙本丙本俱無今依丁本補載之"}
{"id": null, "n": "0292006", "target": "#nkr_note_orig_0292006", "type": "orig", "text": "娑嚩＝莎【丙】【丁】"}
{"id": null, "n": "0292007", "target": "#nkr_note_orig_0292007", "type": "orig", "text": "阿＋（阿）【甲】【丙】"}
{"id": null, "n": "0292008", "target": "#nkr_note_orig_0292008", "type": "orig", "text": "󰋲＋（車）【乙】＊，（󰋲車）【丙】"}
{"id": null, "n": "0292009", "target": "#nkr_note_orig_0292009", "type": "orig", "text": "〔阿〕－【甲】【丙】"}
{"id": null, "n": "0292010", "target": "#nkr_note_orig_0292010", "type": "orig", "text": "莎＝娑【丁】"}
{"id": null, "n": "0292011", "target": "#nkr_note_orig_0292011", "type": "orig", "text": "下＝上【丁】"}
{"id": null, "n": "0292012", "target": "#nkr_note_orig_0292012", "type": "orig", "text": "〔發〕－【甲】【乙】【丙】"}
{"id": null, "n": "0292013", "target": "#nkr_note_orig_0292013", "type": "orig", "text": "〔曰〕－【丙】"}
{"id": null, "n": "0292014", "target": "#nkr_note_orig_0292014", "type": "orig", "text": "𤙖＝吽【甲】【乙】【丁】"}
{"id": null, "n": "0292015", "target": "#nkr_note_orig_0292015", "type": "orig", "text": "以下甲乙丙丁四本俱無之，丙本奧書曰建長八年正月十八日於覺洞院書寫之以遍照院本校了詔尊二十一，丁本奧書曰貞享四年中春十六一校了淨嚴四十九，元祿十五年十一月二十三日以御本再挍了尊教，寶永三丙戌之春得茲密軌戊子之冬十月二十日於妙法寺五遊軒電視一校了性寂"}
{"id": null, "n": "0292a2001", "target": "#nkr_note_add_0292a2001", "type": "add", "text": "􆿅􄑘【CB】，􇥗【大】"}
{"id": null, "n": "0292a2301", "target": "#nkr_note_add_0292a2301", "type": "add", "text": "􄑘􇩹【CB】，􇥗【大】"}
