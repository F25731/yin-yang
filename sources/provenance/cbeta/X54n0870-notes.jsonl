{"id": null, "n": null, "target": null, "type": null, "text": "慧達述曉月注"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "宜經宜論、樂實樂權"}
{"id": null, "n": null, "target": null, "type": null, "text": "與佛有緣則宜經、與菩薩有緣則宜論"}
{"id": null, "n": null, "target": null, "type": null, "text": "下論\n云「誠真一之無差」，又云「第一大道無有兩正」"}
{"id": null, "n": null, "target": null, "type": null, "text": "三乘并無\n性及不定性"}
{"id": null, "n": null, "target": null, "type": null, "text": "下云「九流於是乎交歸，眾聖於是乎冥會」"}
{"id": null, "n": null, "target": null, "type": null, "text": "俗有真無"}
{"id": null, "n": null, "target": null, "type": null, "text": "下云「言真未甞\n有、言偽未甞無，二言未始一、二理未始殊」"}
{"id": null, "n": null, "target": null, "type": null, "text": "根本智證真、後\n得智達俗"}
{"id": null, "n": null, "target": null, "type": null, "text": "下云「觀空而不證、處有而不染」"}
{"id": null, "n": null, "target": null, "type": null, "text": "生屬過去、住異屬現在、滅屬未來"}
{"id": null, "n": null, "target": null, "type": null, "text": "下云\n「一切眾生即寂滅相」"}
{"id": null, "n": null, "target": null, "type": null, "text": "以有為智、證無為理"}
{"id": null, "n": null, "target": null, "type": null, "text": "下云「此彼寂滅、物我冥一、怕爾無朕，乃曰涅槃」"}
{"id": null, "n": null, "target": null, "type": null, "text": "下云「不動真際為諸法立處」，又云「法身無象，應物而\n形」"}
{"id": null, "n": null, "target": null, "type": null, "text": "下云「終日知而\n\n未甞知」，又云「智有窮幽之鑒而無知焉」等"}
{"id": null, "n": null, "target": null, "type": null, "text": "無性為真如"}
{"id": null, "n": null, "target": null, "type": null, "text": "下云「涅槃之為道也，量太虗而永久」，又云「寂滅永安，無始無終，\n湛若虗空」"}
{"id": null, "n": null, "target": null, "type": null, "text": "一切智智亦清淨"}
{"id": null, "n": null, "target": null, "type": null, "text": "下云「理無不契，故萬德斯弘」，又云「佛如虗空，無去無來；應緣而現，無有方所」"}
{"id": null, "n": null, "target": null, "type": null, "text": "下云「般若\n虗玄者，蓋是三乘之宗極也，誠真一之無差」"}
{"id": null, "n": null, "target": null, "type": null, "text": "下云「言之者失其真」等，又云「釋迦掩室於摩竭、淨名杜口於毗耶」"}
