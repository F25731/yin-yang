{"id": null, "n": null, "target": null, "type": null, "text": "一十四則"}
{"id": null, "n": null, "target": null, "type": null, "text": "一十三則"}
{"id": null, "n": null, "target": null, "type": null, "text": "上中"}
{"id": null, "n": null, "target": null, "type": null, "text": "下"}
{"id": null, "n": null, "target": null, "type": null, "text": "此日無問話者"}
{"id": null, "n": null, "target": null, "type": null, "text": "敘謝不錄。"}
{"id": null, "n": null, "target": null, "type": null, "text": "敘謝，不錄。"}
{"id": null, "n": null, "target": null, "type": null, "text": "想生"}
{"id": null, "n": null, "target": null, "type": null, "text": "相生"}
{"id": null, "n": null, "target": null, "type": null, "text": "流注生"}
{"id": null, "n": null, "target": null, "type": null, "text": "一十四則"}
{"id": null, "n": null, "target": null, "type": null, "text": "一十三則"}
{"id": null, "n": null, "target": null, "type": null, "text": "參無字話"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱自性，建昌府人。"}
{"id": null, "n": null, "target": null, "type": null, "text": "時退天寧歸普照"}
{"id": null, "n": null, "target": null, "type": null, "text": "受業法華寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "書華嚴誦法華"}
{"id": null, "n": null, "target": null, "type": null, "text": "時住淨慧菴"}
{"id": null, "n": null, "target": null, "type": null, "text": "并引"}
{"id": null, "n": null, "target": null, "type": null, "text": "此偈因緣寄呂敬夫，故著語於每句之下。"}
{"id": null, "n": null, "target": null, "type": null, "text": "千聖仰之不及"}
{"id": null, "n": null, "target": null, "type": null, "text": "可知禮也"}
{"id": null, "n": null, "target": null, "type": null, "text": "只恐不是玉"}
{"id": null, "n": null, "target": null, "type": null, "text": "未敢相許"}
{"id": null, "n": null, "target": null, "type": null, "text": "未是到家時節"}
{"id": null, "n": null, "target": null, "type": null, "text": "好箇消息"}
{"id": null, "n": null, "target": null, "type": null, "text": "切忌認驢鞍橋作阿爺下頷"}
{"id": null, "n": null, "target": null, "type": null, "text": "玄關\n更有百千重"}
{"id": null, "n": null, "target": null, "type": null, "text": "正因"}
{"id": null, "n": null, "target": null, "type": null, "text": "國一"}
{"id": null, "n": null, "target": null, "type": null, "text": "無上"}
