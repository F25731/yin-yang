{"id": null, "n": "0281003", "target": "#nkr_note_mod_0281003", "type": "mod", "text": "真諦三藏【大】，天竺三藏真諦【宋】【元】【明】"}
{"id": null, "n": "0281004", "target": "#nkr_note_mod_0281004", "type": "mod", "text": "無有【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0281005", "target": "#nkr_note_mod_0281005", "type": "mod", "text": "屋【大】＊，空【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0282001", "target": "#nkr_note_mod_0282001", "type": "mod", "text": "難【大】，難難【宋】【元】【明】"}
{"id": null, "n": "0282002", "target": "#nkr_note_mod_0282002", "type": "mod", "text": "減【大】，滅【宋】【元】【明】"}
{"id": null, "n": "0282003", "target": "#nkr_note_mod_0282003", "type": "mod", "text": "即【大】，則【宋】【元】【明】"}
{"id": null, "n": "0282004", "target": "#nkr_note_mod_0282004", "type": "mod", "text": "如來【大】，如來地【宋】【元】【明】"}
{"id": null, "n": "0282005", "target": "#nkr_note_mod_0282005", "type": "mod", "text": "辨【大】，辯【宋】【元】【明】"}
{"id": null, "n": "0281003", "target": "#nkr_note_orig_0281003", "type": "orig", "text": "真諦三藏＝天竺三藏真諦【三】"}
{"id": null, "n": "0281004", "target": "#nkr_note_orig_0281004", "type": "orig", "text": "〔無有〕－【三】"}
{"id": null, "n": "0281005", "target": "#nkr_note_orig_0281005", "type": "orig", "text": "屋＝空【三】＊"}
{"id": null, "n": "0282001", "target": "#nkr_note_orig_0282001", "type": "orig", "text": "難＋（難）【三】"}
{"id": null, "n": "0282002", "target": "#nkr_note_orig_0282002", "type": "orig", "text": "減＝滅【三】"}
{"id": null, "n": "0282003", "target": "#nkr_note_orig_0282003", "type": "orig", "text": "即＝則【三】"}
{"id": null, "n": "0282004", "target": "#nkr_note_orig_0282004", "type": "orig", "text": "如來＋（地）【三】"}
{"id": null, "n": "0282005", "target": "#nkr_note_orig_0282005", "type": "orig", "text": "辨＝辯【三】"}
