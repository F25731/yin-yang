{"id": null, "n": "0510016", "target": "#nkr_note_mod_0510016", "type": "mod", "text": "西晉沙門法炬譯【大】，西晉世三藏法師竺法護別譯【宋】【元】，西晉三藏法師竺法護譯【明】"}
{"id": null, "n": "0510017", "target": "#nkr_note_mod_0510017", "type": "mod", "text": "尼師檀【大】＊，尼師壇【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0510018", "target": "#nkr_note_mod_0510018", "type": "mod", "text": "至【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0510019", "target": "#nkr_note_mod_0510019", "type": "mod", "text": "以【大】，〔－〕【明】"}
{"id": null, "n": "0510020", "target": "#nkr_note_mod_0510020", "type": "mod", "text": "比丘【大】，彼比丘【宋】【元】【明】"}
{"id": null, "n": "0510021", "target": "#nkr_note_mod_0510021", "type": "mod", "text": "坐【大】，座【宋】【元】【明】"}
{"id": null, "n": "0510022", "target": "#nkr_note_mod_0510022", "type": "mod", "text": "三【大】，止【宋】【元】【明】"}
{"id": null, "n": "0510023", "target": "#nkr_note_mod_0510023", "type": "mod", "text": "或【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0510024", "target": "#nkr_note_mod_0510024", "type": "mod", "text": "食【大】，殺【宋】【元】【明】"}
{"id": null, "n": "0510025", "target": "#nkr_note_mod_0510025", "type": "mod", "text": "便【大】，更【宋】【元】【明】"}
{"id": null, "n": "0510026", "target": "#nkr_note_mod_0510026", "type": "mod", "text": "之【大】，人【元】【明】"}
{"id": null, "n": "0511001", "target": "#nkr_note_mod_0511001", "type": "mod", "text": "梵【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0511002", "target": "#nkr_note_mod_0511002", "type": "mod", "text": "拂柄【大】，柄拂【宋】【元】【明】"}
{"id": null, "n": "0511003", "target": "#nkr_note_mod_0511003", "type": "mod", "text": "尊者【大】，世尊【明】"}
{"id": null, "n": "0511004", "target": "#nkr_note_mod_0511004", "type": "mod", "text": "加【大】，跏【宋】【元】【明】"}
{"id": null, "n": "0511005", "target": "#nkr_note_mod_0511005", "type": "mod", "text": "乃【大】，乃能【宋】【元】【明】"}
{"id": null, "n": "0511006", "target": "#nkr_note_mod_0511006", "type": "mod", "text": "生【大】，告【元】【明】"}
{"id": null, "n": "0511007", "target": "#nkr_note_mod_0511007", "type": "mod", "text": "以【大】＊，已【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0511008", "target": "#nkr_note_mod_0511008", "type": "mod", "text": "破【大】，彼【宋】【元】【明】"}
{"id": null, "n": "0512001", "target": "#nkr_note_mod_0512001", "type": "mod", "text": "還【大】，逮【宋】【元】【明】"}
{"id": null, "n": "0512002", "target": "#nkr_note_mod_0512002", "type": "mod", "text": "律【CB】【磧-CB】【宋】【元】【明】，佛【大】"}
