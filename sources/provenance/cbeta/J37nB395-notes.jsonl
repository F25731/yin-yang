{"id": null, "n": null, "target": null, "type": null, "text": "噫！"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "同門請"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "開子，明時詩僧也"}
{"id": null, "n": null, "target": null, "type": null, "text": "相傳買臣墓在此"}
{"id": null, "n": null, "target": null, "type": null, "text": "時修志寺中"}
{"id": null, "n": null, "target": null, "type": null, "text": "嘉興楞嚴經坊，夏繼寧。"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
