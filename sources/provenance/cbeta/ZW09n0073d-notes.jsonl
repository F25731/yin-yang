{"id": null, "n": "0073001", "target": "#nkr_note_orig_0073001", "type": "orig", "text": "「程」，底本作「呈」，據文意改。"}
{"id": null, "n": "0075001", "target": "#nkr_note_orig_0075001", "type": "orig", "text": "「一」，甲本自此開始。"}
{"id": null, "n": "0075002", "target": "#nkr_note_orig_0075002", "type": "orig", "text": "「命」，甲本作「令」。"}
{"id": null, "n": "0075003", "target": "#nkr_note_orig_0075003", "type": "orig", "text": "「命」，甲本作「令」。"}
{"id": null, "n": "0075004", "target": "#nkr_note_orig_0075004", "type": "orig", "text": "「道」，甲本無。"}
{"id": null, "n": "0075005", "target": "#nkr_note_orig_0075005", "type": "orig", "text": "「亦云」，甲本作「亦云道」。"}
{"id": null, "n": "0075006", "target": "#nkr_note_orig_0075006", "type": "orig", "text": "「大」，底、甲本作「代」，據文意改。"}
{"id": null, "n": "0076001", "target": "#nkr_note_orig_0076001", "type": "orig", "text": "「與」，底本作「與蘊」，據甲本刪。"}
{"id": null, "n": "0076002", "target": "#nkr_note_orig_0076002", "type": "orig", "text": "「無」，甲本作「不」。"}
{"id": null, "n": "0076003", "target": "#nkr_note_orig_0076003", "type": "orig", "text": "「路」，甲本作「行」。"}
{"id": null, "n": "0076004", "target": "#nkr_note_orig_0076004", "type": "orig", "text": "「皆依」，甲本作「依他」。"}
{"id": null, "n": "0076005", "target": "#nkr_note_orig_0076005", "type": "orig", "text": "「修成」，底本作「能依」，據甲本改。"}
{"id": null, "n": "0077001", "target": "#nkr_note_orig_0077001", "type": "orig", "text": "「曰」，甲本作「者」。"}
{"id": null, "n": "0077002", "target": "#nkr_note_orig_0077002", "type": "orig", "text": "「人輕賤」，底本無，據甲本補。"}
{"id": null, "n": "0078001", "target": "#nkr_note_orig_0078001", "type": "orig", "text": "「眾生」，甲本殘缺。"}
{"id": null, "n": "0078002", "target": "#nkr_note_orig_0078002", "type": "orig", "text": "「眾」，甲本殘缺。"}
{"id": null, "n": "0078003", "target": "#nkr_note_orig_0078003", "type": "orig", "text": "「妄故滅，眾生隨佛語」，甲本殘缺。"}
{"id": null, "n": "0078004", "target": "#nkr_note_orig_0078004", "type": "orig", "text": "「云」，甲本至此結束。"}
{"id": null, "n": "0078005", "target": "#nkr_note_orig_0078005", "type": "orig", "text": "「燃」，乙本自此開始。"}
{"id": null, "n": "0079001", "target": "#nkr_note_orig_0079001", "type": "orig", "text": "「義」，乙本無。"}
{"id": null, "n": "0079002", "target": "#nkr_note_orig_0079002", "type": "orig", "text": "「得」，乙本無。"}
{"id": null, "n": "0079003", "target": "#nkr_note_orig_0079003", "type": "orig", "text": "「釋曰」，乙本作「如義釋曰」。"}
{"id": null, "n": "0079004", "target": "#nkr_note_orig_0079004", "type": "orig", "text": "「如」，乙本無。"}
{"id": null, "n": "0080001", "target": "#nkr_note_orig_0080001", "type": "orig", "text": "「既」，乙本作「即」。"}
{"id": null, "n": "0080002", "target": "#nkr_note_orig_0080002", "type": "orig", "text": "「法」，乙本無。"}
{"id": null, "n": "0080003", "target": "#nkr_note_orig_0080003", "type": "orig", "text": "「呼」，乙本作「乎」。"}
{"id": null, "n": "0080004", "target": "#nkr_note_orig_0080004", "type": "orig", "text": "「明」，乙本作「名」。"}
{"id": null, "n": "0080005", "target": "#nkr_note_orig_0080005", "type": "orig", "text": "「法」，乙本無。"}
{"id": null, "n": "0080006", "target": "#nkr_note_orig_0080006", "type": "orig", "text": "「十四」，底本作「十三」，乙本作「三十」，據《大正藏》本《大般涅槃經．聖行品第七之四》第十四卷「如來即是法……法即如來」改。"}
{"id": null, "n": "0080007", "target": "#nkr_note_orig_0080007", "type": "orig", "text": "「法」，乙本無。"}
{"id": null, "n": "0080008", "target": "#nkr_note_orig_0080008", "type": "orig", "text": "「即」，底本作「滅即」，據乙本刪。"}
{"id": null, "n": "0080009", "target": "#nkr_note_orig_0080009", "type": "orig", "text": "「故」，乙本無。"}
{"id": null, "n": "0081001", "target": "#nkr_note_orig_0081001", "type": "orig", "text": "「諸法」，底、乙本均作「法諸」，據文意改。"}
{"id": null, "n": "0081002", "target": "#nkr_note_orig_0081002", "type": "orig", "text": "「既」，乙本作「即」。"}
{"id": null, "n": "0081003", "target": "#nkr_note_orig_0081003", "type": "orig", "text": "「此」，乙本作「此是」。"}
{"id": null, "n": "0081004", "target": "#nkr_note_orig_0081004", "type": "orig", "text": "「名」，乙本無。"}
{"id": null, "n": "0082001", "target": "#nkr_note_orig_0082001", "type": "orig", "text": "「名」，乙本至此結束，丙本自此開始。"}
{"id": null, "n": "0082002", "target": "#nkr_note_orig_0082002", "type": "orig", "text": "「心」，丙本無。"}
{"id": null, "n": "0082003", "target": "#nkr_note_orig_0082003", "type": "orig", "text": "「名」，丙本無。"}
{"id": null, "n": "0082004", "target": "#nkr_note_orig_0082004", "type": "orig", "text": "「縱」，丙本作「蹤」。"}
{"id": null, "n": "0083001", "target": "#nkr_note_orig_0083001", "type": "orig", "text": "「作如」，丙本作「能作」。"}
{"id": null, "n": "0083002", "target": "#nkr_note_orig_0083002", "type": "orig", "text": "「應化是方便之身」，丙本無。"}
{"id": null, "n": "0083003", "target": "#nkr_note_orig_0083003", "type": "orig", "text": "「報」，丙本作「物」。"}
{"id": null, "n": "0084001", "target": "#nkr_note_orig_0084001", "type": "orig", "text": "「法身，法身具合萬法」，底本殘，據丙本補。"}
{"id": null, "n": "0084002", "target": "#nkr_note_orig_0084002", "type": "orig", "text": "「有」，丙本作「假」。"}
{"id": null, "n": "0084003", "target": "#nkr_note_orig_0084003", "type": "orig", "text": "「名故云是說」，底本殘，據丙本補。"}
{"id": null, "n": "0084004", "target": "#nkr_note_orig_0084004", "type": "orig", "text": "「法佛說法」，底本無，據丙本補。"}
{"id": null, "n": "0084005", "target": "#nkr_note_orig_0084005", "type": "orig", "text": "「有」，丙本無。"}
{"id": null, "n": "0084006", "target": "#nkr_note_orig_0084006", "type": "orig", "text": "「下」，底本殘，據丙本補。"}
{"id": null, "n": "0084007", "target": "#nkr_note_orig_0084007", "type": "orig", "text": "「二乘之人為佛是高，眾生」，底本殘，據丙本補。"}
{"id": null, "n": "0084008", "target": "#nkr_note_orig_0084008", "type": "orig", "text": "「二乘無目，不見」，底本殘，據丙本補。"}
{"id": null, "n": "0084009", "target": "#nkr_note_orig_0084009", "type": "orig", "text": "「人心自有高下」，底本殘，據丙本補。"}
{"id": null, "n": "0085001", "target": "#nkr_note_orig_0085001", "type": "orig", "text": "「即」，戊本自此開始。"}
{"id": null, "n": "0085002", "target": "#nkr_note_orig_0085002", "type": "orig", "text": "「即是般若波羅蜜法，即是菩提」，底本殘，據丙、戊本補。"}
{"id": null, "n": "0085003", "target": "#nkr_note_orig_0085003", "type": "orig", "text": "「下文云」，底、丙本無，據戊本補。"}
{"id": null, "n": "0085004", "target": "#nkr_note_orig_0085004", "type": "orig", "text": "「善法者，如來說非」，戊本殘。"}
{"id": null, "n": "0085005", "target": "#nkr_note_orig_0085005", "type": "orig", "text": "「善」，底本至此結束，以下敦研369號背為底本。"}
{"id": null, "n": "0085006", "target": "#nkr_note_orig_0085006", "type": "orig", "text": "「修」，底本、戊本殘，據丙本補。"}
{"id": null, "n": "0085007", "target": "#nkr_note_orig_0085007", "type": "orig", "text": "「所攝，即無」，底本殘，據丙本補。"}
{"id": null, "n": "0085008", "target": "#nkr_note_orig_0085008", "type": "orig", "text": "「無別」，丙本作「別無」。"}
{"id": null, "n": "0085009", "target": "#nkr_note_orig_0085009", "type": "orig", "text": "「釋曰」，丙本無。"}
{"id": null, "n": "0085010", "target": "#nkr_note_orig_0085010", "type": "orig", "text": "「經」，底本無，據丙本補。"}
{"id": null, "n": "0085011", "target": "#nkr_note_orig_0085011", "type": "orig", "text": "「空」，丙本無。"}
{"id": null, "n": "0086001", "target": "#nkr_note_orig_0086001", "type": "orig", "text": "「想」，底本作「念」，據丙本改。"}
{"id": null, "n": "0086002", "target": "#nkr_note_orig_0086002", "type": "orig", "text": "「許」，丙本至此結束。"}
{"id": null, "n": "0086003", "target": "#nkr_note_orig_0086003", "type": "orig", "text": "「即」底本作「既」，據文意改。"}
{"id": null, "n": "0086004", "target": "#nkr_note_orig_0086004", "type": "orig", "text": "「相」，底本作「想」，據文意改。"}
{"id": null, "n": "0086005", "target": "#nkr_note_orig_0086005", "type": "orig", "text": "「無」，丁本自此開始。"}
{"id": null, "n": "0086006", "target": "#nkr_note_orig_0086006", "type": "orig", "text": "「以」，底本作「如」，據丁本改。"}
{"id": null, "n": "0086007", "target": "#nkr_note_orig_0086007", "type": "orig", "text": "「文云：如來說有我者則非有」，丁本殘。"}
{"id": null, "n": "0086008", "target": "#nkr_note_orig_0086008", "type": "orig", "text": "「生死而求涅槃」，丁本殘。"}
{"id": null, "n": "0086009", "target": "#nkr_note_orig_0086009", "type": "orig", "text": "「空」，丁本作「為空」。"}
{"id": null, "n": "0087001", "target": "#nkr_note_orig_0087001", "type": "orig", "text": "「以」，丁本無。"}
{"id": null, "n": "0087002", "target": "#nkr_note_orig_0087002", "type": "orig", "text": "「則」，丁本作「即」。"}
{"id": null, "n": "0087003", "target": "#nkr_note_orig_0087003", "type": "orig", "text": "「無相貌」，底本殘，據丁本補。"}
{"id": null, "n": "0087004", "target": "#nkr_note_orig_0087004", "type": "orig", "text": "「若以音聲為如來」，丁本無。"}
{"id": null, "n": "0087005", "target": "#nkr_note_orig_0087005", "type": "orig", "text": "「是」，丁本無。"}
{"id": null, "n": "0087006", "target": "#nkr_note_orig_0087006", "type": "orig", "text": "「如來無色無聲，是故偈云」，底本殘，據丁本補。"}
{"id": null, "n": "0087007", "target": "#nkr_note_orig_0087007", "type": "orig", "text": "「而」，丁本作「如」。"}
{"id": null, "n": "0088001", "target": "#nkr_note_orig_0088001", "type": "orig", "text": "「故」，丁本無。"}
{"id": null, "n": "0088002", "target": "#nkr_note_orig_0088002", "type": "orig", "text": "「若」，底本作「若不」，據丁本刪。"}
{"id": null, "n": "0088003", "target": "#nkr_note_orig_0088003", "type": "orig", "text": "「施」，底本作「施命」，據丁本刪。"}
{"id": null, "n": "0088004", "target": "#nkr_note_orig_0088004", "type": "orig", "text": "「情」，丁本作「貪」。"}
{"id": null, "n": "0089001", "target": "#nkr_note_orig_0089001", "type": "orig", "text": "「是」，丁本至此結束。"}
{"id": null, "n": "0089002", "target": "#nkr_note_orig_0089002", "type": "orig", "text": "「云」，底本無，據文意補。"}
{"id": null, "n": "0090001", "target": "#nkr_note_orig_0090001", "type": "orig", "text": "「應作如是觀」，底本字體與「注」、「釋」同，比前面「經」的字體小號。"}
{"id": null, "n": "0090002", "target": "#nkr_note_orig_0090002", "type": "orig", "text": "「讚曰」，底本無，據文意補。"}
{"id": null, "n": "0091001", "target": "#nkr_note_orig_0091001", "type": "orig", "text": "「長」，底本作「常」，據斯4105號改。"}
{"id": null, "n": "0091002", "target": "#nkr_note_orig_0091002", "type": "orig", "text": "「是」，底本殘，據文意補。"}
{"id": null, "n": "0091003", "target": "#nkr_note_orig_0091003", "type": "orig", "text": "「勘」，底本作「堪」，據文意改。"}
