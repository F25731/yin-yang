{"id": null, "n": "0906004", "target": "#nkr_note_mod_0906004", "type": "mod", "text": "五母子經【大】，佛說五母子經一卷【知】，五母子經與【宋】【元】【明】大異今以【宋】【元】對校【明】別附卷末"}
{"id": null, "n": "0906005", "target": "#nkr_note_mod_0906005", "type": "mod", "text": "吳月氏國居士支謙譯【大】，〔－〕【知】"}
{"id": null, "n": "0906006", "target": "#nkr_note_mod_0906006", "type": "mod", "text": "昔者有阿羅漢【大】，昔有羅漢【知】"}
{"id": null, "n": "0906007", "target": "#nkr_note_mod_0906007", "type": "mod", "text": "道業【大】，道法【知】"}
{"id": null, "n": "0906008", "target": "#nkr_note_mod_0906008", "type": "mod", "text": "沙彌【大】＊，沙門【知】＊"}
{"id": null, "n": "0906009", "target": "#nkr_note_mod_0906009", "type": "mod", "text": "道【大】，〔－〕【知】"}
{"id": null, "n": "0906010", "target": "#nkr_note_mod_0906010", "type": "mod", "text": "慧眼【大】，道眼【知】"}
{"id": null, "n": "0906011", "target": "#nkr_note_mod_0906011", "type": "mod", "text": "天上【大】，〔－〕【知】"}
{"id": null, "n": "0906012", "target": "#nkr_note_mod_0906012", "type": "mod", "text": "及【大】，乃【知】"}
{"id": null, "n": "0906013", "target": "#nkr_note_mod_0906013", "type": "mod", "text": "笑嗤【大】，豈唉【知】"}
{"id": null, "n": "0906014", "target": "#nkr_note_mod_0906014", "type": "mod", "text": "適【大】，這【知】"}
{"id": null, "n": "0907001", "target": "#nkr_note_mod_0907001", "type": "mod", "text": "哭【大】，〔－〕【知】"}
{"id": null, "n": "0907002", "target": "#nkr_note_mod_0907002", "type": "mod", "text": "發念【大】，我念【知】"}
{"id": null, "n": "0906004", "target": "#nkr_note_orig_0906004", "type": "orig", "text": "五母子經與【三】大異今以【宋】【元】對校【明】別附卷末，（佛說）＋五母子經＋（一卷）【知】"}
