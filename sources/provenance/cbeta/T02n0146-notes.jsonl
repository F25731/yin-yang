{"id": null, "n": "0870023", "target": "#nkr_note_mod_0870023", "type": "mod", "text": "譯【大】，譯今附西晉錄【宋】【元】，譯人名今附西晉錄【明】"}
{"id": null, "n": "0870024", "target": "#nkr_note_mod_0870024", "type": "mod", "text": "桓【大】＊，洹【明】＊"}
{"id": null, "n": "0871001", "target": "#nkr_note_mod_0871001", "type": "mod", "text": "正【大】＊，政【宋】＊"}
{"id": null, "n": "0871002", "target": "#nkr_note_mod_0871002", "type": "mod", "text": "亡【大】，忘【明】"}
{"id": null, "n": "0871003", "target": "#nkr_note_mod_0871003", "type": "mod", "text": "祠【大】＊，祀【明】＊"}
{"id": null, "n": "0871004", "target": "#nkr_note_mod_0871004", "type": "mod", "text": "傍【大】，旁【宋】【元】【明】"}
{"id": null, "n": "0871005", "target": "#nkr_note_mod_0871005", "type": "mod", "text": "祠【大】，祀【宋】【元】【明】"}
{"id": null, "n": "0871006", "target": "#nkr_note_mod_0871006", "type": "mod", "text": "若【大】＊，苦【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0871007", "target": "#nkr_note_mod_0871007", "type": "mod", "text": "反【大】＊，及【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0871008", "target": "#nkr_note_mod_0871008", "type": "mod", "text": "已【大】＊，以【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0871009", "target": "#nkr_note_mod_0871009", "type": "mod", "text": "蓋【大】，善【宋】"}
{"id": null, "n": "0871010", "target": "#nkr_note_mod_0871010", "type": "mod", "text": "婆【大】，披【宋】【元】【明】"}
{"id": null, "n": "0871011", "target": "#nkr_note_mod_0871011", "type": "mod", "text": "徐【大】，得【宋】【元】【明】"}
{"id": null, "n": "0871012", "target": "#nkr_note_mod_0871012", "type": "mod", "text": "大【大】，妻【宋】【元】【明】"}
{"id": null, "n": "0871013", "target": "#nkr_note_mod_0871013", "type": "mod", "text": "淫【大】，婬【宋】【元】【明】"}
{"id": null, "n": "0871014", "target": "#nkr_note_mod_0871014", "type": "mod", "text": "陂【大】，溪【宋】【元】【明】"}
{"id": null, "n": "0872001", "target": "#nkr_note_mod_0872001", "type": "mod", "text": "（按此經…哲）此記六十九字【大】，〔－〕【宋】【元】【明】"}
