{"id": null, "n": "0206071", "target": "#nkr_note_mod_0206071", "type": "mod", "text": "一卷【大】，念誦法【明】，〔－〕【校異-乙】"}
{"id": null, "n": "0206072", "target": "#nkr_note_mod_0206072", "type": "mod", "text": "（開府…譯）四十六字【大】，唐北天竺三藏沙門大廣智不空奉詔譯【明】【乙】，特進試鴻臚卿大興善寺三藏沙門大廣智不空奉詔譯【甲】"}
{"id": null, "n": "0207001", "target": "#nkr_note_mod_0207001", "type": "mod", "text": "梨【大】，黎【明】【乙】"}
{"id": null, "n": "0207002", "target": "#nkr_note_mod_0207002", "type": "mod", "text": "危【大】，厄【校異-乙】"}
{"id": null, "n": "0207003", "target": "#nkr_note_mod_0207003", "type": "mod", "text": "具【大】，養【明】【乙】"}
{"id": null, "n": "0207004", "target": "#nkr_note_mod_0207004", "type": "mod", "text": "承【大】，垂【甲】"}
{"id": null, "n": "0207005", "target": "#nkr_note_mod_0207005", "type": "mod", "text": "婆【大】，嚩【明】【乙】"}
{"id": null, "n": "0207006", "target": "#nkr_note_mod_0207006", "type": "mod", "text": "反【大】，切【明】【乙】"}
{"id": null, "n": "0207007", "target": "#nkr_note_mod_0207007", "type": "mod", "text": "全跏半跏【大】，全加而坐【明】【乙】"}
{"id": null, "n": "0207008", "target": "#nkr_note_mod_0207008", "type": "mod", "text": "跏【大】，加【明】【乙】"}
{"id": null, "n": "0207009", "target": "#nkr_note_mod_0207009", "type": "mod", "text": "意【大】，喜【甲】"}
{"id": null, "n": "0207010", "target": "#nkr_note_mod_0207010", "type": "mod", "text": "眾【大】，諸【明】【乙】"}
{"id": null, "n": "0207011", "target": "#nkr_note_mod_0207011", "type": "mod", "text": "羅【大】，囉二合【明】【乙】"}
{"id": null, "n": "0207012", "target": "#nkr_note_mod_0207012", "type": "mod", "text": "麼【大】，麼二合【明】【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0207013", "target": "#nkr_note_mod_0207013", "type": "mod", "text": "受【大】，授【明】"}
{"id": null, "n": "0207014", "target": "#nkr_note_mod_0207014", "type": "mod", "text": "安【大】，安樂【甲】"}
{"id": null, "n": "0207015", "target": "#nkr_note_mod_0207015", "type": "mod", "text": "去【大】，去聲【明】【乙】"}
{"id": null, "n": "0207016", "target": "#nkr_note_mod_0207016", "type": "mod", "text": "蘇【大】，蘇上【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "上"}
{"id": null, "n": "0207017", "target": "#nkr_note_mod_0207017", "type": "mod", "text": "示【大】，是【明】"}
{"id": null, "n": "0207018", "target": "#nkr_note_mod_0207018", "type": "mod", "text": "右【大】，左【明】"}
{"id": null, "n": "0207019", "target": "#nkr_note_mod_0207019", "type": "mod", "text": "左【大】，右【明】"}
{"id": null, "n": "0207020", "target": "#nkr_note_mod_0207020", "type": "mod", "text": "平【大】，平聲【明】【乙】"}
{"id": null, "n": "0207021", "target": "#nkr_note_mod_0207021", "type": "mod", "text": "羅【大】，囉【明】【乙】"}
{"id": null, "n": "0207022", "target": "#nkr_note_mod_0207022", "type": "mod", "text": "植【大】，直【明】"}
{"id": null, "n": "0207023", "target": "#nkr_note_mod_0207023", "type": "mod", "text": "及【大】，反【乙】"}
{"id": null, "n": "0207024", "target": "#nkr_note_mod_0207024", "type": "mod", "text": "語【大】，言【明】【甲】【乙】"}
{"id": null, "n": "0207025", "target": "#nkr_note_mod_0207025", "type": "mod", "text": "波【大】，婆【甲】"}
{"id": null, "n": "0207026", "target": "#nkr_note_mod_0207026", "type": "mod", "text": "入【大】＊，入聲【明】【乙】＊"}
{"id": null, "n": "0207027", "target": "#nkr_note_mod_0207027", "type": "mod", "text": "摩【大】，麼【乙】"}
{"id": null, "n": "0207028", "target": "#nkr_note_mod_0207028", "type": "mod", "text": "吽【大】，薩怛嚩二合吽【乙】"}
{"id": null, "n": "0208001", "target": "#nkr_note_mod_0208001", "type": "mod", "text": "普【大】，普二合【明】【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0208002", "target": "#nkr_note_mod_0208002", "type": "mod", "text": "蘖【大】＊，㜸【明】【乙】＊"}
{"id": null, "n": "0208003", "target": "#nkr_note_mod_0208003", "type": "mod", "text": "丁以反【大】，〔－〕【明】【乙】"}
{"id": null, "n": "0208004", "target": "#nkr_note_mod_0208004", "type": "mod", "text": "挽【大】，挽二合【明】【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0208005", "target": "#nkr_note_mod_0208005", "type": "mod", "text": "磨【大】，麼【甲】【乙】"}
{"id": null, "n": "0208006", "target": "#nkr_note_mod_0208006", "type": "mod", "text": "合【大】，合短【乙】"}
{"id": null, "n": "0208007", "target": "#nkr_note_mod_0208007", "type": "mod", "text": "以此【大】，此以【明】"}
{"id": null, "n": "0208008", "target": "#nkr_note_mod_0208008", "type": "mod", "text": "故【大】，門【甲】【乙】"}
{"id": null, "n": "0208009", "target": "#nkr_note_mod_0208009", "type": "mod", "text": "愚迷【大】，迷愚【明】"}
{"id": null, "n": "0208010", "target": "#nkr_note_mod_0208010", "type": "mod", "text": "阿【大】，惡【乙】"}
{"id": null, "n": "0208011", "target": "#nkr_note_mod_0208011", "type": "mod", "text": "密【大】，真【明】【乙】"}
{"id": null, "n": "0208012", "target": "#nkr_note_mod_0208012", "type": "mod", "text": "住【大】，拄【明】【乙】"}
{"id": null, "n": "0208013", "target": "#nkr_note_mod_0208013", "type": "mod", "text": "致【大】，致二合【明】【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0208014", "target": "#nkr_note_mod_0208014", "type": "mod", "text": "𤚥【大】，𤚥平聲【明】【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "平聲"}
{"id": null, "n": "0208015", "target": "#nkr_note_mod_0208015", "type": "mod", "text": "花【大】，葉【校異-乙】"}
