{"id": null, "n": "0376002", "target": "#nkr_note_orig_0376002", "type": "orig", "text": "【原】享保年間刊豐山大學藏本，【甲】石山寺藏古寫本"}
{"id": null, "n": "0376003", "target": "#nkr_note_orig_0376003", "type": "orig", "text": "土火下有脫文ヵ【原】，土＝加【甲】"}
