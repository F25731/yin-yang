{"id": null, "n": null, "target": null, "type": null, "text": "基辯"}
{"id": null, "n": null, "target": null, "type": null, "text": "基辯"}
{"id": null, "n": null, "target": null, "type": null, "text": "基辯"}
{"id": null, "n": null, "target": null, "type": null, "text": "舉"}
{"id": null, "n": "0585002", "target": "#nkr_note_mod_0585002", "type": "mod", "text": "校正唯等已下十六行錯亂"}
{"id": null, "n": "0586003", "target": "#nkr_note_mod_0586003", "type": "mod", "text": "基辨云准上末已下第二總敘有部末宗異義類多"}
{"id": null, "n": "0588001", "target": "#nkr_note_mod_0588001", "type": "mod", "text": "基辨云其已下此即第二別陳末所執"}
{"id": null, "n": "0568001", "target": "#nkr_note_orig_0568001", "type": "orig", "text": "一無一字"}
{"id": null, "n": "0569001", "target": "#nkr_note_orig_0569001", "type": "orig", "text": "得上一有不字"}
{"id": null, "n": "0569002", "target": "#nkr_note_orig_0569002", "type": "orig", "text": "一無悉字"}
{"id": null, "n": "0569003", "target": "#nkr_note_orig_0569003", "type": "orig", "text": "彼一作時"}
{"id": null, "n": "0573001", "target": "#nkr_note_orig_0573001", "type": "orig", "text": "校加汝等四字"}
{"id": null, "n": "0575001", "target": "#nkr_note_orig_0575001", "type": "orig", "text": "眾下一有部字"}
{"id": null, "n": "0575002", "target": "#nkr_note_orig_0575002", "type": "orig", "text": "校加此等十二字"}
{"id": null, "n": "0575003", "target": "#nkr_note_orig_0575003", "type": "orig", "text": "高一作亮"}
{"id": null, "n": "0575004", "target": "#nkr_note_orig_0575004", "type": "orig", "text": "一無自字"}
{"id": null, "n": "0578001", "target": "#nkr_note_orig_0578001", "type": "orig", "text": "校加名等十七字"}
{"id": null, "n": "0580001", "target": "#nkr_note_orig_0580001", "type": "orig", "text": "部疑剖"}
{"id": null, "n": "0580002", "target": "#nkr_note_orig_0580002", "type": "orig", "text": "校加若等四字"}
{"id": null, "n": "0581001", "target": "#nkr_note_orig_0581001", "type": "orig", "text": "校加能等四字"}
{"id": null, "n": "0583001", "target": "#nkr_note_orig_0583001", "type": "orig", "text": "道一作遂"}
{"id": null, "n": "0583002", "target": "#nkr_note_orig_0583002", "type": "orig", "text": "各作客"}
{"id": null, "n": "0584001", "target": "#nkr_note_orig_0584001", "type": "orig", "text": "校加此等十二字"}
{"id": null, "n": "0584002", "target": "#nkr_note_orig_0584002", "type": "orig", "text": "基辨云自下疏文脫述曰二字及科文按例上應知故略之歟今准上示科則此是十一段中第五段文文有二初標部敘本宗次總敘末宗異義類多今即初也"}
{"id": null, "n": "0585001", "target": "#nkr_note_orig_0585001", "type": "orig", "text": "離疑雖"}
{"id": null, "n": "0585002", "target": "#nkr_note_orig_0585002", "type": "orig", "text": "校正唯等巳下十六行錯亂"}
{"id": null, "n": "0586001", "target": "#nkr_note_orig_0586001", "type": "orig", "text": "話一作治"}
{"id": null, "n": "0586002", "target": "#nkr_note_orig_0586002", "type": "orig", "text": "者一作有"}
{"id": null, "n": "0586003", "target": "#nkr_note_orig_0586003", "type": "orig", "text": "基辨云准上末巳下第二總敘有部末宗異義類多"}
{"id": null, "n": "0586004", "target": "#nkr_note_orig_0586004", "type": "orig", "text": "基辨云准上此即第六段文文中有二初標部敘本宗次略指餘同執"}
{"id": null, "n": "0586005", "target": "#nkr_note_orig_0586005", "type": "orig", "text": "基辨云此即第二略指餘同執"}
{"id": null, "n": "0586006", "target": "#nkr_note_orig_0586006", "type": "orig", "text": "基辨云此是第七段文文有二初標部敘本宗次略陳末宗異義"}
{"id": null, "n": "0587001", "target": "#nkr_note_orig_0587001", "type": "orig", "text": "基辨云此即第二略陳末宗異義"}
{"id": null, "n": "0587002", "target": "#nkr_note_orig_0587002", "type": "orig", "text": "基辨云此即第八段文文有二初標部敘本宗次別陳末所執此即初也"}
{"id": null, "n": "0588001", "target": "#nkr_note_orig_0588001", "type": "orig", "text": "基辨云其巳下此即第二別陳末所執"}
{"id": null, "n": "0588002", "target": "#nkr_note_orig_0588002", "type": "orig", "text": "校加見等十字"}
{"id": null, "n": "0589001", "target": "#nkr_note_orig_0589001", "type": "orig", "text": "基辨云此即第九段文文有二初標部敘本宗次略指同執"}
{"id": null, "n": "0589002", "target": "#nkr_note_orig_0589002", "type": "orig", "text": "基辨云此即第二略指同執"}
{"id": null, "n": "0589003", "target": "#nkr_note_orig_0589003", "type": "orig", "text": "基辨云此即第十段文文有二初標部敘本宗次略指餘同執"}
{"id": null, "n": "0589004", "target": "#nkr_note_orig_0589004", "type": "orig", "text": "基辨云此即第二文也"}
{"id": null, "n": "0589005", "target": "#nkr_note_orig_0589005", "type": "orig", "text": "基辨云此即第十一段文文有二初標部敘本宗次略指餘同執"}
