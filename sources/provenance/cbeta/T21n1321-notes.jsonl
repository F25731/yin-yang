{"id": null, "n": "0484001", "target": "#nkr_note_orig_0484001", "type": "orig", "text": "【原】鎌倉時代成賢寫東寺三密藏藏本"}
{"id": null, "n": "0484b2301", "target": "#nkr_note_add_0484b2301", "type": "add", "text": "薜【CB】，薛【大】"}
{"id": null, "n": "0484b2601", "target": "#nkr_note_add_0484b2601", "type": "add", "text": "惡【CB】，悉【大】"}
{"id": null, "n": "0484b2801", "target": "#nkr_note_add_0484b2801", "type": "add", "text": "伺【CB】，詞【大】"}
{"id": null, "n": "0484c0801", "target": "#nkr_note_add_0484c0801", "type": "add", "text": "CBETA 按：「鳴鳴」疑作「嗚嗚」。"}
{"id": null, "n": "0484c1501", "target": "#nkr_note_add_0484c1501", "type": "add", "text": "唼【CB】，接【大】"}
{"id": null, "n": "0484c2201", "target": "#nkr_note_add_0484c2201", "type": "add", "text": "縛【CB】，溥【大】"}
{"id": null, "n": "0485a0701", "target": "#nkr_note_add_0485a0701", "type": "add", "text": "CBETA 按：「衡」疑是「衝」。"}
{"id": null, "n": "0485a2001", "target": "#nkr_note_add_0485a2001", "type": "add", "text": "頃【CB】，項【大】"}
{"id": null, "n": "0485a2002", "target": "#nkr_note_add_0485a2002", "type": "add", "text": "頃【CB】，項【大】"}
{"id": null, "n": "0485c2701", "target": "#nkr_note_add_0485c2701", "type": "add", "text": "茹【CB】，茄【大】"}
{"id": null, "n": "0486c0401", "target": "#nkr_note_add_0486c0401", "type": "add", "text": "時【CB】，肘【大】"}
{"id": null, "n": "0487a0901", "target": "#nkr_note_add_0487a0901", "type": "add", "text": "辦【CB】，辨【大】"}
{"id": null, "n": "0487b1801", "target": "#nkr_note_add_0487b1801", "type": "add", "text": "人民【CB】，民人【大】"}
{"id": null, "n": "0487c1201", "target": "#nkr_note_add_0487c1201", "type": "add", "text": "CBETA 按：「模」疑是「果」。"}
{"id": null, "n": "0487c2601", "target": "#nkr_note_add_0487c2601", "type": "add", "text": "是【CB】，最【大】"}
{"id": null, "n": "0488b1401", "target": "#nkr_note_add_0488b1401", "type": "add", "text": "辯【CB】，辨【大】"}
