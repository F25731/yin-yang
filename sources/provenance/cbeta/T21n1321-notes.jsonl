{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐云「施餓鬼甘露味大道場會陀羅尼」"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐云餓鬼"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐云影鬼"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐云食香\n鬼"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐云食花餓鬼"}
{"id": null, "n": null, "target": null, "type": null, "text": "云食胎藏鬼"}
{"id": null, "n": null, "target": null, "type": null, "text": "食不淨鬼"}
{"id": null, "n": null, "target": null, "type": null, "text": "云食風鬼"}
{"id": null, "n": null, "target": null, "type": null, "text": "食精氣鬼"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗔惡心鬼"}
{"id": null, "n": null, "target": null, "type": null, "text": "惡心鬼"}
{"id": null, "n": null, "target": null, "type": null, "text": "食祭祀鬼"}
{"id": null, "n": null, "target": null, "type": null, "text": "食人壽命鬼"}
{"id": null, "n": null, "target": null, "type": null, "text": "食肉食脂等鬼"}
{"id": null, "n": null, "target": null, "type": null, "text": "云食初產子鬼"}
{"id": null, "n": null, "target": null, "type": null, "text": "云奇臭鬼，其身如燒骨臭"}
{"id": null, "n": null, "target": null, "type": null, "text": "守宮鬼"}
{"id": null, "n": null, "target": null, "type": null, "text": "廁神，云守廁，伺人不淨食"}
{"id": null, "n": null, "target": null, "type": null, "text": "痑音他但\n反"}
