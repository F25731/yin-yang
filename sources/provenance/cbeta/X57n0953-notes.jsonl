{"id": null, "n": null, "target": null, "type": null, "text": "〔惠言〕"}
{"id": null, "n": null, "target": null, "type": null, "text": "可之下不言燦而言滿益"}
{"id": null, "n": null, "target": null, "type": null, "text": "心宗乃龍樹、馬鳴諸祖口傳文等之旨是矣"}
{"id": null, "n": null, "target": null, "type": null, "text": "此文與上別議，其旨大同，故今附之。"}
{"id": null, "n": "0052005", "target": "#nkr_note_orig_0052005", "type": "orig", "text": "□疑日"}
{"id": null, "n": "0052006", "target": "#nkr_note_orig_0052006", "type": "orig", "text": "□□疑三藏"}
