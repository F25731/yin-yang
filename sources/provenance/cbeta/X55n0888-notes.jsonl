{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "同伸一有法云："}
{"id": null, "n": null, "target": null, "type": null, "text": "後陳定相翻云："}
{"id": null, "n": null, "target": null, "type": null, "text": "不改先因云："}
{"id": null, "n": null, "target": null, "type": null, "text": "番異作同云："}
{"id": null, "n": null, "target": null, "type": null, "text": "附　唯識義利"}
{"id": null, "n": null, "target": null, "type": null, "text": "如人能持"}
{"id": null, "n": null, "target": null, "type": null, "text": "如所持種"}
{"id": null, "n": null, "target": null, "type": null, "text": "如所熏種"}
{"id": null, "n": null, "target": null, "type": null, "text": "如受重者，即第\n八識"}
{"id": null, "n": null, "target": null, "type": null, "text": "初阿賴耶識"}
{"id": null, "n": null, "target": null, "type": null, "text": "異熟"}
{"id": null, "n": null, "target": null, "type": null, "text": "一切種"}
{"id": null, "n": null, "target": null, "type": null, "text": "不可知"}
{"id": null, "n": null, "target": null, "type": null, "text": "執受處"}
{"id": null, "n": null, "target": null, "type": null, "text": "了"}
{"id": null, "n": null, "target": null, "type": null, "text": "常與至相應"}
{"id": null, "n": null, "target": null, "type": null, "text": "唯捨受"}
{"id": null, "n": null, "target": null, "type": null, "text": "是無覆無記"}
{"id": null, "n": null, "target": null, "type": null, "text": "觸等亦如是"}
{"id": null, "n": null, "target": null, "type": null, "text": "恒轉如瀑流"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿羅漢位捨"}
{"id": null, "n": null, "target": null, "type": null, "text": "次第末那"}
{"id": null, "n": null, "target": null, "type": null, "text": "依彼"}
{"id": null, "n": null, "target": null, "type": null, "text": "緣彼"}
{"id": null, "n": null, "target": null, "type": null, "text": "思量為性"}
{"id": null, "n": null, "target": null, "type": null, "text": "思量為相"}
{"id": null, "n": null, "target": null, "type": null, "text": "四煩至愛"}
{"id": null, "n": null, "target": null, "type": null, "text": "及餘等俱"}
{"id": null, "n": null, "target": null, "type": null, "text": "有覆記攝"}
{"id": null, "n": null, "target": null, "type": null, "text": "隨所生所繁"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿至無有"}
{"id": null, "n": null, "target": null, "type": null, "text": "次第至六種"}
{"id": null, "n": null, "target": null, "type": null, "text": "了別為性"}
{"id": null, "n": null, "target": null, "type": null, "text": "了別為相"}
{"id": null, "n": null, "target": null, "type": null, "text": "善不\n俱非"}
{"id": null, "n": null, "target": null, "type": null, "text": "此心所至不定"}
{"id": null, "n": null, "target": null, "type": null, "text": "皆三受相應"}
{"id": null, "n": null, "target": null, "type": null, "text": "依止至隨緣現"}
{"id": null, "n": null, "target": null, "type": null, "text": "或俱或不俱，如波濤依水"}
{"id": null, "n": null, "target": null, "type": null, "text": "意識常至悶絕"}
{"id": null, "n": null, "target": null, "type": null, "text": "此等合在識變後安"}
{"id": null, "n": null, "target": null, "type": null, "text": "長短相似故"}
{"id": null, "n": null, "target": null, "type": null, "text": "殺他命損\n自壽"}
{"id": null, "n": null, "target": null, "type": null, "text": "因前六不善之業，促第八無記之壽"}
{"id": null, "n": null, "target": null, "type": null, "text": "有力增上故"}
{"id": null, "n": null, "target": null, "type": null, "text": "法力"}
{"id": null, "n": null, "target": null, "type": null, "text": "虗怯多畏"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "附　五究竟位"}
{"id": null, "n": null, "target": null, "type": null, "text": "附　十號名義　薄伽六義　諸佛別名　三業化義"}
{"id": null, "n": null, "target": null, "type": null, "text": "附　二無我義"}
{"id": null, "n": null, "target": null, "type": null, "text": "附　天神居處"}
{"id": null, "n": null, "target": null, "type": null, "text": "人間屋上作龍\n象之爾"}
{"id": null, "n": null, "target": null, "type": null, "text": "以鼓切"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
