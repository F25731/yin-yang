{"id": null, "n": null, "target": null, "type": null, "text": "玉谿小師"}
{"id": null, "n": null, "target": null, "type": null, "text": "時在上柏玉几菴"}
{"id": null, "n": null, "target": null, "type": null, "text": "以上流清詔歸"}
{"id": null, "n": null, "target": null, "type": null, "text": "聶府博以母在日所奉像請贊"}
{"id": null, "n": null, "target": null, "type": null, "text": "半身"}
{"id": null, "n": null, "target": null, "type": null, "text": "叔凱講師請"}
{"id": null, "n": null, "target": null, "type": null, "text": "賣薪挂一壺酒"}
{"id": null, "n": null, "target": null, "type": null, "text": "整襟獨立聽琴"}
{"id": null, "n": null, "target": null, "type": null, "text": "風雨"}
{"id": null, "n": null, "target": null, "type": null, "text": "中死號西山"}
{"id": null, "n": null, "target": null, "type": null, "text": "中有三佛議論，又有虎丘隆和尚事。"}
{"id": null, "n": null, "target": null, "type": null, "text": "龜齡諱十朋，號梅溪。"}
