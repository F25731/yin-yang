{"id": null, "n": "0448061", "target": "#nkr_note_mod_0448061", "type": "mod", "text": "便與【大】，與之【宋】【元】【明】，與使【聖】"}
{"id": null, "n": "0448062", "target": "#nkr_note_mod_0448062", "type": "mod", "text": "之【大】，其【宋】【元】【明】【聖】"}
{"id": null, "n": "0448063", "target": "#nkr_note_mod_0448063", "type": "mod", "text": "躃【大】，墮【聖】"}
{"id": null, "n": "0448064", "target": "#nkr_note_mod_0448064", "type": "mod", "text": "奄【大】，掩【宋】【元】【明】【聖】"}
{"id": null, "n": "0448065", "target": "#nkr_note_mod_0448065", "type": "mod", "text": "其【大】，甚【宋】【元】【明】【聖】"}
{"id": null, "n": "0448066", "target": "#nkr_note_mod_0448066", "type": "mod", "text": "我【大】，汝【聖】"}
{"id": null, "n": "0448067", "target": "#nkr_note_mod_0448067", "type": "mod", "text": "瘢【大】，瘡瘢【宋】【元】【明】【聖】"}
{"id": null, "n": "0448068", "target": "#nkr_note_mod_0448068", "type": "mod", "text": "見【大】，見之【宋】【元】【明】【聖】"}
{"id": null, "n": "0448069", "target": "#nkr_note_mod_0448069", "type": "mod", "text": "婬妷女【大】，婬妷之【宋】，妬嫉之【元】【明】【聖】"}
{"id": null, "n": "0448070", "target": "#nkr_note_mod_0448070", "type": "mod", "text": "福【大】，福德【宋】【元】【明】【聖】"}
