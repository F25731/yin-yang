{"id": null, "n": "0448073", "target": "#nkr_note_mod_0448073", "type": "mod", "text": "杖【大】，〔－〕【宋】【元】【明】【聖】"}
{"id": null, "n": "0448074", "target": "#nkr_note_mod_0448074", "type": "mod", "text": "行乞匃【大】，行匃自【宋】【元】【明】，空自【聖】"}
{"id": null, "n": "0448075", "target": "#nkr_note_mod_0448075", "type": "mod", "text": "此【大】，此上色【宋】【元】【明】【聖】"}
{"id": null, "n": "0448076", "target": "#nkr_note_mod_0448076", "type": "mod", "text": "乞【大】，與【宋】【元】【明】【聖】"}
{"id": null, "n": "0448077", "target": "#nkr_note_mod_0448077", "type": "mod", "text": "行【大】，〔－〕【宋】【元】【明】【聖】"}
{"id": null, "n": "0448078", "target": "#nkr_note_mod_0448078", "type": "mod", "text": "道人【大】，婆羅門言【宋】【元】【明】【聖】"}
{"id": null, "n": "0448079", "target": "#nkr_note_mod_0448079", "type": "mod", "text": "之【大】，〔－〕【宋】【元】【明】【聖】"}
{"id": null, "n": "0448080", "target": "#nkr_note_mod_0448080", "type": "mod", "text": "願【大】，願事【宋】【元】【明】【聖】"}
{"id": null, "n": "0448081", "target": "#nkr_note_mod_0448081", "type": "mod", "text": "梵【大】，梵耶【宋】【元】【明】【聖】"}
{"id": null, "n": "0449001", "target": "#nkr_note_mod_0449001", "type": "mod", "text": "為【大】，若為【宋】【元】【明】【聖】"}
{"id": null, "n": "0449002", "target": "#nkr_note_mod_0449002", "type": "mod", "text": "王【大】，玉【宋】【元】【明】"}
{"id": null, "n": "0449003", "target": "#nkr_note_mod_0449003", "type": "mod", "text": "如【大】，乃如【宋】【元】【明】【聖】"}
{"id": null, "n": "0449004", "target": "#nkr_note_mod_0449004", "type": "mod", "text": "婆羅門【大】，所可作【宋】【元】【明】【聖】"}
{"id": null, "n": "0449005", "target": "#nkr_note_mod_0449005", "type": "mod", "text": "愁憂【大】，憂愁【宋】【元】【明】【聖】"}
{"id": null, "n": "0449006", "target": "#nkr_note_mod_0449006", "type": "mod", "text": "言問【大】，問言【宋】【元】【明】【聖】"}
{"id": null, "n": "0449007", "target": "#nkr_note_mod_0449007", "type": "mod", "text": "無【大】，無有【宋】【元】【明】【聖】"}
{"id": null, "n": "0449008", "target": "#nkr_note_mod_0449008", "type": "mod", "text": "適竟【大】，這意【聖】"}
{"id": null, "n": "0449009", "target": "#nkr_note_mod_0449009", "type": "mod", "text": "正法【大】，王法【元】，法【聖】"}
{"id": null, "n": "0449010", "target": "#nkr_note_mod_0449010", "type": "mod", "text": "外【大】，〔－〕【宋】【元】【明】【聖】"}
{"id": null, "n": "0449011", "target": "#nkr_note_mod_0449011", "type": "mod", "text": "（飯食…舍宅）十四字【大】，（飯者與飯欲得財者與財欲得衣者與衣欲得香熏花者與熏華欲得房室坐席者與房室坐席欲得舍宅者與舍宅欲得）四十八字【宋】【元】【明】【聖】"}
{"id": null, "n": "0449012", "target": "#nkr_note_mod_0449012", "type": "mod", "text": "其【大】，所【宋】【元】【明】【聖】"}
{"id": null, "n": "0449013", "target": "#nkr_note_mod_0449013", "type": "mod", "text": "〔－〕【CB】【麗-CB】【宋】【元】【明】【聖】，一【大】"}
{"id": null, "n": "0449014", "target": "#nkr_note_mod_0449014", "type": "mod", "text": "稻【大】，生稻【宋】【元】【明】【聖】"}
{"id": null, "n": "0449015", "target": "#nkr_note_mod_0449015", "type": "mod", "text": "日【大】，〔－〕【宋】【元】【明】【聖】"}
{"id": null, "n": "0449016", "target": "#nkr_note_mod_0449016", "type": "mod", "text": "其【大】，〔－〕【宋】【元】【明】【聖】"}
{"id": null, "n": "0449017", "target": "#nkr_note_mod_0449017", "type": "mod", "text": "味【大】，其味【宋】【元】【明】【聖】"}
{"id": null, "n": "0449018", "target": "#nkr_note_mod_0449018", "type": "mod", "text": "已【大】，以【宋】【元】【明】【聖】"}
{"id": null, "n": "0449019", "target": "#nkr_note_mod_0449019", "type": "mod", "text": "越【大】，曰【聖】"}
{"id": null, "n": "0449020", "target": "#nkr_note_mod_0449020", "type": "mod", "text": "下【大】，下人【宋】【元】【明】【聖】"}
{"id": null, "n": "0449021", "target": "#nkr_note_mod_0449021", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】【聖】"}
{"id": null, "n": "0449022", "target": "#nkr_note_mod_0449022", "type": "mod", "text": "我【大】，哉【聖】"}
{"id": null, "n": "0449023", "target": "#nkr_note_mod_0449023", "type": "mod", "text": "穌【大】，以穌【宋】【元】【明】【聖】"}
{"id": null, "n": "0449024", "target": "#nkr_note_mod_0449024", "type": "mod", "text": "拭【大】，莊飾【宋】【元】【明】【聖】"}
{"id": null, "n": "0449025", "target": "#nkr_note_mod_0449025", "type": "mod", "text": "人【大】，大人【宋】，夫人【元】【明】【聖】"}
{"id": null, "n": "0449026", "target": "#nkr_note_mod_0449026", "type": "mod", "text": "議【大】，護【宋】【元】【明】【聖】"}
{"id": null, "n": "0449027", "target": "#nkr_note_mod_0449027", "type": "mod", "text": "百【大】，〔－〕【聖】"}
{"id": null, "n": "0449028", "target": "#nkr_note_mod_0449028", "type": "mod", "text": "甚【大】，其【宋】【元】【明】"}
{"id": null, "n": "0449029", "target": "#nkr_note_mod_0449029", "type": "mod", "text": "不【大】，石【聖】"}
{"id": null, "n": "0449030", "target": "#nkr_note_mod_0449030", "type": "mod", "text": "馳【大】，便【宋】【元】【明】【聖】"}
{"id": null, "n": "0449031", "target": "#nkr_note_mod_0449031", "type": "mod", "text": "空處處【大】，於空閑【宋】【元】【明】【聖】"}
{"id": null, "n": "0449032", "target": "#nkr_note_mod_0449032", "type": "mod", "text": "重愛【大】，愛重【宋】【元】【明】【聖】"}
{"id": null, "n": "0449033", "target": "#nkr_note_mod_0449033", "type": "mod", "text": "食飲【大】，飲食【宋】【元】【明】【聖】"}
{"id": null, "n": "0449034", "target": "#nkr_note_mod_0449034", "type": "mod", "text": "用【大】，用為【宋】【元】【明】【聖】"}
{"id": null, "n": "0449035", "target": "#nkr_note_mod_0449035", "type": "mod", "text": "道【大】，道乎【宋】【元】【明】【聖】"}
{"id": null, "n": "0449036", "target": "#nkr_note_mod_0449036", "type": "mod", "text": "者【大】，至【宋】【元】【明】【聖】"}
{"id": null, "n": "0449037", "target": "#nkr_note_mod_0449037", "type": "mod", "text": "日【大】，反【宋】【元】【明】【聖】"}
{"id": null, "n": "0449038", "target": "#nkr_note_mod_0449038", "type": "mod", "text": "來往【大】，往來【宋】【元】【明】【聖】"}
{"id": null, "n": "0449039", "target": "#nkr_note_mod_0449039", "type": "mod", "text": "諾【大】，諾子【宋】【元】【明】，諸子【聖】"}
{"id": null, "n": "0449040", "target": "#nkr_note_mod_0449040", "type": "mod", "text": "子【大】，〔－〕【宋】【元】【明】【聖】"}
{"id": null, "n": "0449041", "target": "#nkr_note_mod_0449041", "type": "mod", "text": "入【大】，入山【聖】"}
{"id": null, "n": "0449042", "target": "#nkr_note_mod_0449042", "type": "mod", "text": "空閑【大】，空樹下【宋】【元】【明】【聖】"}
{"id": null, "n": "0449043", "target": "#nkr_note_mod_0449043", "type": "mod", "text": "離【大】，離於【宋】【元】【明】【聖】"}
{"id": null, "n": "0449044", "target": "#nkr_note_mod_0449044", "type": "mod", "text": "中【大】，其中【宋】【元】【明】【聖】"}
{"id": null, "n": "0449045", "target": "#nkr_note_mod_0449045", "type": "mod", "text": "二【大】，兩【宋】【元】【明】【聖】"}
{"id": null, "n": "0449046", "target": "#nkr_note_mod_0449046", "type": "mod", "text": "大【大】，大神【宋】【元】【明】【聖】"}
{"id": null, "n": "0449047", "target": "#nkr_note_mod_0449047", "type": "mod", "text": "妊娠【大】，妊身【宋】【元】【明】【聖】"}
{"id": null, "n": "0449048", "target": "#nkr_note_mod_0449048", "type": "mod", "text": "果【大】，菓【宋】【元】【聖】"}
{"id": null, "n": "0449049", "target": "#nkr_note_mod_0449049", "type": "mod", "text": "語【大】，詣【聖】"}
{"id": null, "n": "0449050", "target": "#nkr_note_mod_0449050", "type": "mod", "text": "產【大】，生【宋】【元】【明】【聖】"}
{"id": null, "n": "0449051", "target": "#nkr_note_mod_0449051", "type": "mod", "text": "食【大】＊，餧【宋】【元】【明】【聖】＊"}
{"id": null, "n": "0449052", "target": "#nkr_note_mod_0449052", "type": "mod", "text": "虎【大】，虎已【宋】【元】【明】【聖】"}
{"id": null, "n": "0449053", "target": "#nkr_note_mod_0449053", "type": "mod", "text": "噉之【大】，〔－〕【宋】【元】【明】【聖】"}
{"id": null, "n": "0449054", "target": "#nkr_note_mod_0449054", "type": "mod", "text": "道人【大】，一道人【宋】【元】【明】【聖】"}
{"id": null, "n": "0449055", "target": "#nkr_note_mod_0449055", "type": "mod", "text": "噉【大】，取【宋】【元】【明】【聖】"}
{"id": null, "n": "0449056", "target": "#nkr_note_mod_0449056", "type": "mod", "text": "子【大】，子食之【宋】【元】【明】【聖】"}
{"id": null, "n": "0449057", "target": "#nkr_note_mod_0449057", "type": "mod", "text": "食之【大】，飼者彌勒菩薩言我當持身飼之【宋】【元】【明】【聖】"}
{"id": null, "n": "0449058", "target": "#nkr_note_mod_0449058", "type": "mod", "text": "開目【大】，因【宋】【元】【明】【聖】"}
{"id": null, "n": "0449059", "target": "#nkr_note_mod_0449059", "type": "mod", "text": "人【大】，道人【宋】【元】【明】【聖】"}
{"id": null, "n": "0449060", "target": "#nkr_note_mod_0449060", "type": "mod", "text": "道人【大】，云何【宋】【元】【明】【聖】"}
{"id": null, "n": "0449061", "target": "#nkr_note_mod_0449061", "type": "mod", "text": "也【大】＊，耶【宋】【元】【明】【聖】＊"}
{"id": null, "n": "0449062", "target": "#nkr_note_mod_0449062", "type": "mod", "text": "食【大】＊，飼【宋】【元】【明】【聖】＊"}
{"id": null, "n": "0449063", "target": "#nkr_note_mod_0449063", "type": "mod", "text": "視【大】，〔－〕【宋】【元】【明】【聖】"}
{"id": null, "n": "0449064", "target": "#nkr_note_mod_0449064", "type": "mod", "text": "流【大】，放流【宋】【元】【明】"}
{"id": null, "n": "0449065", "target": "#nkr_note_mod_0449065", "type": "mod", "text": "血【大】，放血【宋】【元】【明】【聖】"}
{"id": null, "n": "0449066", "target": "#nkr_note_mod_0449066", "type": "mod", "text": "因【大】，虎因【宋】【元】【明】【聖】"}
{"id": null, "n": "0449067", "target": "#nkr_note_mod_0449067", "type": "mod", "text": "則【大】，童子道人即【宋】【元】【明】【聖】"}
{"id": null, "n": "0449068", "target": "#nkr_note_mod_0449068", "type": "mod", "text": "餧【大】，飼【宋】【元】【明】【聖】"}
{"id": null, "n": "0449069", "target": "#nkr_note_mod_0449069", "type": "mod", "text": "葉【大】，葉菩薩【宋】【元】【明】【聖】"}
{"id": null, "n": "0449070", "target": "#nkr_note_mod_0449070", "type": "mod", "text": "道【大】，〔－〕【聖】"}
{"id": null, "n": "0449071", "target": "#nkr_note_mod_0449071", "type": "mod", "text": "彌勒【大】，彌勒菩薩【宋】【元】【明】"}
{"id": null, "n": "0449072", "target": "#nkr_note_mod_0449072", "type": "mod", "text": "死【大】，餓死【宋】【元】【明】【聖】"}
{"id": null, "n": "0447008", "target": "#nkr_note_orig_0447008", "type": "orig", "text": "（佛說）＋前【三】【聖】"}
{"id": null, "n": "0447009", "target": "#nkr_note_orig_0447009", "type": "orig", "text": "〔西晉…譯〕－【聖】"}
{"id": null, "n": "0447010", "target": "#nkr_note_orig_0447010", "type": "orig", "text": "（釋）＋法炬【三】"}
{"id": null, "n": "0447011", "target": "#nkr_note_orig_0447011", "type": "orig", "text": "（初）＋譯【三】"}
{"id": null, "n": "0447012", "target": "#nkr_note_orig_0447012", "type": "orig", "text": "〔也〕－【聖】"}
{"id": null, "n": "0447013", "target": "#nkr_note_orig_0447013", "type": "orig", "text": "央＝鞅【聖】＊"}
{"id": null, "n": "0447014", "target": "#nkr_note_orig_0447014", "type": "orig", "text": "菩薩＋（俱）【三】【聖】"}
{"id": null, "n": "0448001", "target": "#nkr_note_orig_0448001", "type": "orig", "text": "口＋（中）【三】【聖】"}
{"id": null, "n": "0448002", "target": "#nkr_note_orig_0448002", "type": "orig", "text": "光還照＝還繞【三】【聖】"}
{"id": null, "n": "0448003", "target": "#nkr_note_orig_0448003", "type": "orig", "text": "〔中〕－【三】【聖】"}
{"id": null, "n": "0448004", "target": "#nkr_note_orig_0448004", "type": "orig", "text": "臍＋（中）【三】"}
{"id": null, "n": "0448005", "target": "#nkr_note_orig_0448005", "type": "orig", "text": "見＝現【三】【聖】"}
{"id": null, "n": "0448006", "target": "#nkr_note_orig_0448006", "type": "orig", "text": "（說）＋種【三】"}
{"id": null, "n": "0448007", "target": "#nkr_note_orig_0448007", "type": "orig", "text": "（是）＋為【三】【聖】"}
{"id": null, "n": "0448008", "target": "#nkr_note_orig_0448008", "type": "orig", "text": "（皆）＋比丘【三】【聖】"}
{"id": null, "n": "0448009", "target": "#nkr_note_orig_0448009", "type": "orig", "text": "（知義…身事）二十三字＝知法二者知時三者知義四者知節五者知己身六者知眾會事【三】【聖】"}
{"id": null, "n": "0448010", "target": "#nkr_note_orig_0448010", "type": "orig", "text": "被＝服【三】【聖】"}
{"id": null, "n": "0448011", "target": "#nkr_note_orig_0448011", "type": "orig", "text": "得＝德【聖】"}
{"id": null, "n": "0448012", "target": "#nkr_note_orig_0448012", "type": "orig", "text": "遠照＝照遠【三】"}
{"id": null, "n": "0448013", "target": "#nkr_note_orig_0448013", "type": "orig", "text": "得＝德【三】"}
{"id": null, "n": "0448014", "target": "#nkr_note_orig_0448014", "type": "orig", "text": "今＝受【三】【聖】"}
{"id": null, "n": "0448015", "target": "#nkr_note_orig_0448015", "type": "orig", "text": "面＝而【聖】"}
{"id": null, "n": "0448016", "target": "#nkr_note_orig_0448016", "type": "orig", "text": "說之＝道說【聖】"}
{"id": null, "n": "0448017", "target": "#nkr_note_orig_0448017", "type": "orig", "text": "惟＝唯【三】【聖】"}
{"id": null, "n": "0448018", "target": "#nkr_note_orig_0448018", "type": "orig", "text": "天＋（人）【聖】"}
{"id": null, "n": "0448019", "target": "#nkr_note_orig_0448019", "type": "orig", "text": "（已）＋斷【三】【聖】"}
{"id": null, "n": "0448020", "target": "#nkr_note_orig_0448020", "type": "orig", "text": "是＝用【三】【聖】"}
{"id": null, "n": "0448021", "target": "#nkr_note_orig_0448021", "type": "orig", "text": "（葉）＋施【三】"}
{"id": null, "n": "0448022", "target": "#nkr_note_orig_0448022", "type": "orig", "text": "〔諸佛天中天〕－【三】【聖】"}
{"id": null, "n": "0448023", "target": "#nkr_note_orig_0448023", "type": "orig", "text": "（所）＋念【三】【聖】"}
{"id": null, "n": "0448024", "target": "#nkr_note_orig_0448024", "type": "orig", "text": "無＝非【三】【聖】"}
{"id": null, "n": "0448025", "target": "#nkr_note_orig_0448025", "type": "orig", "text": "諸＝願【三】【聖】"}
{"id": null, "n": "0448026", "target": "#nkr_note_orig_0448026", "type": "orig", "text": "〔佛〕－【三】【聖】"}
{"id": null, "n": "0448027", "target": "#nkr_note_orig_0448027", "type": "orig", "text": "過＋（去）【三】"}
{"id": null, "n": "0448028", "target": "#nkr_note_orig_0448028", "type": "orig", "text": "〔得〕－【三】，＝復【聖】"}
{"id": null, "n": "0448029", "target": "#nkr_note_orig_0448029", "type": "orig", "text": "〔佛語〕－【三】【聖】"}
{"id": null, "n": "0448030", "target": "#nkr_note_orig_0448030", "type": "orig", "text": "（以）＋正法【三】，＝以法【聖】"}
{"id": null, "n": "0448031", "target": "#nkr_note_orig_0448031", "type": "orig", "text": "民＝命【三】【聖】"}
{"id": null, "n": "0448032", "target": "#nkr_note_orig_0448032", "type": "orig", "text": "女＋（人名）【三】【聖】"}
{"id": null, "n": "0448033", "target": "#nkr_note_orig_0448033", "type": "orig", "text": "（行）＋往【三】【聖】"}
{"id": null, "n": "0448034", "target": "#nkr_note_orig_0448034", "type": "orig", "text": "生男＝適生男子【三】，這生子男【聖】"}
{"id": null, "n": "0448035", "target": "#nkr_note_orig_0448035", "type": "orig", "text": "女＋（人）【三】【聖】＊"}
{"id": null, "n": "0448036", "target": "#nkr_note_orig_0448036", "type": "orig", "text": "之＋（言）【三】【聖】"}
{"id": null, "n": "0448037", "target": "#nkr_note_orig_0448037", "type": "orig", "text": "兒＝子【三】【聖】＊"}
{"id": null, "n": "0448038", "target": "#nkr_note_orig_0448038", "type": "orig", "text": "（兒母）＋報【三】【聖】"}
{"id": null, "n": "0448039", "target": "#nkr_note_orig_0448039", "type": "orig", "text": "（又）＋問【三】【聖】"}
{"id": null, "n": "0448040", "target": "#nkr_note_orig_0448040", "type": "orig", "text": "（寧）＋無【三】【聖】"}
{"id": null, "n": "0448041", "target": "#nkr_note_orig_0448041", "type": "orig", "text": "〔報〕－【三】【聖】"}
{"id": null, "n": "0448042", "target": "#nkr_note_orig_0448042", "type": "orig", "text": "須＝頃【三】＊"}
{"id": null, "n": "0448043", "target": "#nkr_note_orig_0448043", "type": "orig", "text": "答曰＝報言【三】【聖】"}
{"id": null, "n": "0448044", "target": "#nkr_note_orig_0448044", "type": "orig", "text": "那＝耶【三】"}
{"id": null, "n": "0448045", "target": "#nkr_note_orig_0448045", "type": "orig", "text": "（豈）＋能【聖】"}
{"id": null, "n": "0448046", "target": "#nkr_note_orig_0448046", "type": "orig", "text": "飯＝食【三】【聖】"}
{"id": null, "n": "0448047", "target": "#nkr_note_orig_0448047", "type": "orig", "text": "見之便＝是人便念【三】【聖】"}
{"id": null, "n": "0448048", "target": "#nkr_note_orig_0448048", "type": "orig", "text": "悲＋（哀之）【三】【聖】"}
{"id": null, "n": "0448049", "target": "#nkr_note_orig_0448049", "type": "orig", "text": "侍＝待【三】"}
{"id": null, "n": "0448050", "target": "#nkr_note_orig_0448050", "type": "orig", "text": "欲心＝婬意【三】【聖】"}
{"id": null, "n": "0448051", "target": "#nkr_note_orig_0448051", "type": "orig", "text": "嬈＝取【聖】"}
{"id": null, "n": "0448052", "target": "#nkr_note_orig_0448052", "type": "orig", "text": "（如是）＋者【三】【聖】"}
{"id": null, "n": "0448053", "target": "#nkr_note_orig_0448053", "type": "orig", "text": "適＝這【聖】＊"}
{"id": null, "n": "0448054", "target": "#nkr_note_orig_0448054", "type": "orig", "text": "問＋（言）【三】【聖】"}
{"id": null, "n": "0448055", "target": "#nkr_note_orig_0448055", "type": "orig", "text": "食＋（之）【三】"}
{"id": null, "n": "0448056", "target": "#nkr_note_orig_0448056", "type": "orig", "text": "〔去〕－【三】【聖】"}
{"id": null, "n": "0448057", "target": "#nkr_note_orig_0448057", "type": "orig", "text": "念＋（言）【三】【聖】"}
{"id": null, "n": "0448058", "target": "#nkr_note_orig_0448058", "type": "orig", "text": "適持兒去＝取兒持去者【三】【聖】"}
{"id": null, "n": "0448059", "target": "#nkr_note_orig_0448059", "type": "orig", "text": "（餓）＋死【三】【聖】"}
{"id": null, "n": "0448060", "target": "#nkr_note_orig_0448060", "type": "orig", "text": "噉＋（之）【三】【聖】"}
