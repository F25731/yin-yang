{"id": null, "n": "0447010", "target": "#nkr_note_mod_0447010", "type": "mod", "text": "法炬【大】，釋法炬【宋】【元】【明】"}
{"id": null, "n": "0447011", "target": "#nkr_note_mod_0447011", "type": "mod", "text": "譯【大】，初譯【宋】【元】【明】"}
{"id": null, "n": "0447012", "target": "#nkr_note_mod_0447012", "type": "mod", "text": "也【大】，〔－〕【聖】"}
{"id": null, "n": "0447013", "target": "#nkr_note_mod_0447013", "type": "mod", "text": "央【大】＊，鞅【聖】＊"}
{"id": null, "n": "0447014", "target": "#nkr_note_mod_0447014", "type": "mod", "text": "菩薩【大】，菩薩俱【宋】【元】【明】【聖】"}
{"id": null, "n": "0448001", "target": "#nkr_note_mod_0448001", "type": "mod", "text": "口【大】，口中【宋】【元】【明】【聖】"}
{"id": null, "n": "0448002", "target": "#nkr_note_mod_0448002", "type": "mod", "text": "光還照【大】，還繞【宋】【元】【明】【聖】"}
{"id": null, "n": "0448003", "target": "#nkr_note_mod_0448003", "type": "mod", "text": "中【大】，〔－〕【宋】【元】【明】【聖】"}
{"id": null, "n": "0448004", "target": "#nkr_note_mod_0448004", "type": "mod", "text": "臍【大】，臍中【宋】【元】【明】"}
{"id": null, "n": "0448005", "target": "#nkr_note_mod_0448005", "type": "mod", "text": "見【大】，現【宋】【元】【明】【聖】"}
{"id": null, "n": "0448006", "target": "#nkr_note_mod_0448006", "type": "mod", "text": "種【大】，說種【宋】【元】【明】"}
{"id": null, "n": "0448007", "target": "#nkr_note_mod_0448007", "type": "mod", "text": "為【大】，是為【宋】【元】【明】【聖】"}
{"id": null, "n": "0448008", "target": "#nkr_note_mod_0448008", "type": "mod", "text": "比丘【大】，皆比丘【宋】【元】【明】【聖】"}
{"id": null, "n": "0448009", "target": "#nkr_note_mod_0448009", "type": "mod", "text": "（知義…身事）二十三字【大】，知法二者知時三者知義四者知節五者知己身六者知眾會事【宋】【元】【明】【聖】"}
{"id": null, "n": "0448010", "target": "#nkr_note_mod_0448010", "type": "mod", "text": "被【大】，服【宋】【元】【明】【聖】"}
{"id": null, "n": "0448011", "target": "#nkr_note_mod_0448011", "type": "mod", "text": "得【大】，德【聖】"}
{"id": null, "n": "0448012", "target": "#nkr_note_mod_0448012", "type": "mod", "text": "遠照【大】，照遠【宋】【元】【明】"}
{"id": null, "n": "0448013", "target": "#nkr_note_mod_0448013", "type": "mod", "text": "得【大】，德【宋】【元】【明】"}
{"id": null, "n": "0448014", "target": "#nkr_note_mod_0448014", "type": "mod", "text": "今【大】，受【宋】【元】【明】【聖】"}
{"id": null, "n": "0448015", "target": "#nkr_note_mod_0448015", "type": "mod", "text": "面【大】，而【聖】"}
{"id": null, "n": "0448016", "target": "#nkr_note_mod_0448016", "type": "mod", "text": "說之【大】，道說【聖】"}
{"id": null, "n": "0448017", "target": "#nkr_note_mod_0448017", "type": "mod", "text": "惟【大】，唯【宋】【元】【明】【聖】"}
{"id": null, "n": "0448018", "target": "#nkr_note_mod_0448018", "type": "mod", "text": "天【大】，天人【聖】"}
{"id": null, "n": "0448019", "target": "#nkr_note_mod_0448019", "type": "mod", "text": "斷【大】，已斷【宋】【元】【明】【聖】"}
{"id": null, "n": "0448020", "target": "#nkr_note_mod_0448020", "type": "mod", "text": "是【大】，用【宋】【元】【明】【聖】"}
{"id": null, "n": "0448021", "target": "#nkr_note_mod_0448021", "type": "mod", "text": "施【大】，葉施【宋】【元】【明】"}
{"id": null, "n": "0448022", "target": "#nkr_note_mod_0448022", "type": "mod", "text": "諸佛天中天【大】，〔－〕【宋】【元】【明】【聖】"}
{"id": null, "n": "0448023", "target": "#nkr_note_mod_0448023", "type": "mod", "text": "念【大】，所念【宋】【元】【明】【聖】"}
{"id": null, "n": "0448024", "target": "#nkr_note_mod_0448024", "type": "mod", "text": "無【大】，非【宋】【元】【明】【聖】"}
{"id": null, "n": "0448025", "target": "#nkr_note_mod_0448025", "type": "mod", "text": "諸【大】，願【宋】【元】【明】【聖】"}
{"id": null, "n": "0448026", "target": "#nkr_note_mod_0448026", "type": "mod", "text": "佛【大】，〔－〕【宋】【元】【明】【聖】"}
{"id": null, "n": "0448027", "target": "#nkr_note_mod_0448027", "type": "mod", "text": "過【大】，過去【宋】【元】【明】"}
{"id": null, "n": "0448028", "target": "#nkr_note_mod_0448028", "type": "mod", "text": "得【大】，〔－〕【宋】【元】【明】，復【聖】"}
{"id": null, "n": "0448029", "target": "#nkr_note_mod_0448029", "type": "mod", "text": "佛語【大】，〔－〕【宋】【元】【明】【聖】"}
{"id": null, "n": "0448030", "target": "#nkr_note_mod_0448030", "type": "mod", "text": "正法【大】，以正法【宋】【元】【明】，以法【聖】"}
{"id": null, "n": "0448031", "target": "#nkr_note_mod_0448031", "type": "mod", "text": "民【大】，命【宋】【元】【明】【聖】"}
{"id": null, "n": "0448032", "target": "#nkr_note_mod_0448032", "type": "mod", "text": "女【大】，女人名【宋】【元】【明】【聖】"}
{"id": null, "n": "0448033", "target": "#nkr_note_mod_0448033", "type": "mod", "text": "往【大】，行往【宋】【元】【明】【聖】"}
{"id": null, "n": "0448034", "target": "#nkr_note_mod_0448034", "type": "mod", "text": "生男【大】，適生男子【宋】【元】【明】，這生子男【聖】"}
{"id": null, "n": "0448035", "target": "#nkr_note_mod_0448035", "type": "mod", "text": "女【大】＊，女人【宋】【元】【明】【聖】＊"}
{"id": null, "n": "0448036", "target": "#nkr_note_mod_0448036", "type": "mod", "text": "之【大】，之言【宋】【元】【明】【聖】"}
{"id": null, "n": "0448037", "target": "#nkr_note_mod_0448037", "type": "mod", "text": "兒【大】＊，子【宋】【元】【明】【聖】＊"}
{"id": null, "n": "0448038", "target": "#nkr_note_mod_0448038", "type": "mod", "text": "報【大】，兒母報【宋】【元】【明】【聖】"}
{"id": null, "n": "0448039", "target": "#nkr_note_mod_0448039", "type": "mod", "text": "問【大】，又問【宋】【元】【明】【聖】"}
{"id": null, "n": "0448040", "target": "#nkr_note_mod_0448040", "type": "mod", "text": "無【大】，寧無【宋】【元】【明】【聖】"}
{"id": null, "n": "0448041", "target": "#nkr_note_mod_0448041", "type": "mod", "text": "報【大】，〔－〕【宋】【元】【明】【聖】"}
{"id": null, "n": "0448042", "target": "#nkr_note_mod_0448042", "type": "mod", "text": "須【大】＊，頃【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0448043", "target": "#nkr_note_mod_0448043", "type": "mod", "text": "答曰【大】，報言【宋】【元】【明】【聖】"}
{"id": null, "n": "0448044", "target": "#nkr_note_mod_0448044", "type": "mod", "text": "那【大】，耶【宋】【元】【明】"}
{"id": null, "n": "0448045", "target": "#nkr_note_mod_0448045", "type": "mod", "text": "能【大】，豈能【聖】"}
{"id": null, "n": "0448046", "target": "#nkr_note_mod_0448046", "type": "mod", "text": "飯【大】，食【宋】【元】【明】【聖】"}
{"id": null, "n": "0448047", "target": "#nkr_note_mod_0448047", "type": "mod", "text": "見之便【大】，是人便念【宋】【元】【明】【聖】"}
{"id": null, "n": "0448048", "target": "#nkr_note_mod_0448048", "type": "mod", "text": "悲【大】，悲哀之【宋】【元】【明】【聖】"}
{"id": null, "n": "0448049", "target": "#nkr_note_mod_0448049", "type": "mod", "text": "侍【大】，待【宋】【元】【明】"}
{"id": null, "n": "0448050", "target": "#nkr_note_mod_0448050", "type": "mod", "text": "欲心【大】，婬意【宋】【元】【明】【聖】"}
{"id": null, "n": "0448051", "target": "#nkr_note_mod_0448051", "type": "mod", "text": "嬈【大】，取【聖】"}
{"id": null, "n": "0448052", "target": "#nkr_note_mod_0448052", "type": "mod", "text": "者【大】，如是者【宋】【元】【明】【聖】"}
{"id": null, "n": "0448053", "target": "#nkr_note_mod_0448053", "type": "mod", "text": "適【大】＊，這【聖】＊"}
{"id": null, "n": "0448054", "target": "#nkr_note_mod_0448054", "type": "mod", "text": "問【大】，問言【宋】【元】【明】【聖】"}
{"id": null, "n": "0448055", "target": "#nkr_note_mod_0448055", "type": "mod", "text": "食【大】，食之【宋】【元】【明】"}
{"id": null, "n": "0448056", "target": "#nkr_note_mod_0448056", "type": "mod", "text": "去【大】，〔－〕【宋】【元】【明】【聖】"}
{"id": null, "n": "0448057", "target": "#nkr_note_mod_0448057", "type": "mod", "text": "念【大】，念言【宋】【元】【明】【聖】"}
{"id": null, "n": "0448058", "target": "#nkr_note_mod_0448058", "type": "mod", "text": "適持兒去【大】，取兒持去者【宋】【元】【明】【聖】"}
