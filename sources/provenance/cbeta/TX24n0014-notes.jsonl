{"id": null, "n": "a475048", "target": "#nkr_note_orig_a475048", "type": "orig", "text": "錄宗依編第五章第二節第七目。"}
{"id": null, "n": "a475049", "target": "#nkr_note_orig_a475049", "type": "orig", "text": "錄佛教救世主義「眾的淨化」之「人類第一」。"}
{"id": null, "n": "a476050", "target": "#nkr_note_orig_a476050", "type": "orig", "text": "錄印順「印度之佛教」「佛理」要略章第三節。"}
{"id": null, "n": "a476051", "target": "#nkr_note_orig_a476051", "type": "orig", "text": "錄佛教救世主義「眾的淨化」之「有情第二」。"}
{"id": null, "n": "a476052", "target": "#nkr_note_orig_a476052", "type": "orig", "text": "錄佛乘宗要論下篇第二章。"}
{"id": null, "n": "a476053", "target": "#nkr_note_orig_a476053", "type": "orig", "text": "錄芝峰之「進化的人生」。"}
{"id": null, "n": "a477054", "target": "#nkr_note_orig_a477054", "type": "orig", "text": "錄人生觀的科學三至六，共四節。"}
{"id": null, "n": "a477055", "target": "#nkr_note_orig_a477055", "type": "orig", "text": "錄起信論「修行信心分」。"}
{"id": null, "n": "a477056", "target": "#nkr_note_orig_a477056", "type": "orig", "text": "節錄「我的佛教改進運動略史」。"}
{"id": null, "n": "a477057", "target": "#nkr_note_orig_a477057", "type": "orig", "text": "節錄瑜伽師地論本分中菩薩地之戒品。"}
{"id": null, "n": "a478058", "target": "#nkr_note_orig_a478058", "type": "orig", "text": "錄佛教救世主義「眾的淨化」之「法界第三」。"}
{"id": null, "n": "a478059", "target": "#nkr_note_orig_a478059", "type": "orig", "text": "節錄大智度論七十五卷。"}
{"id": null, "n": "a478060", "target": "#nkr_note_orig_a478060", "type": "orig", "text": "錄宗依編第四章第三節第四目。"}
{"id": null, "n": "a478061", "target": "#nkr_note_orig_a478061", "type": "orig", "text": "錄起信論「分別發趣道相」。"}
{"id": null, "n": "a478062", "target": "#nkr_note_orig_a478062", "type": "orig", "text": "錄佛教救世主義「心的淨化」之「成德第三」。"}
{"id": null, "n": "a479063", "target": "#nkr_note_orig_a479063", "type": "orig", "text": "節錄自由史觀第五章第二節。"}
{"id": null, "n": "a479064", "target": "#nkr_note_orig_a479064", "type": "orig", "text": "錄華嚴法界玄鏡卷三。"}
