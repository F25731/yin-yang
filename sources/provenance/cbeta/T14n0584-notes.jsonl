{"id": null, "n": "0968004", "target": "#nkr_note_mod_0968004", "type": "mod", "text": "大【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0968005", "target": "#nkr_note_mod_0968005", "type": "mod", "text": "言【大】，云【宋】【元】【明】【宮】"}
{"id": null, "n": "0968006", "target": "#nkr_note_mod_0968006", "type": "mod", "text": "曰【大】，問曰【宋】【元】【明】【宮】"}
{"id": null, "n": "0968007", "target": "#nkr_note_mod_0968007", "type": "mod", "text": "染之【大】，邪行【宋】【元】【明】【宮】"}
{"id": null, "n": "0968008", "target": "#nkr_note_mod_0968008", "type": "mod", "text": "驕【大】，嬌【宋】【元】【明】【宮】"}
{"id": null, "n": "0968009", "target": "#nkr_note_mod_0968009", "type": "mod", "text": "時【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0968010", "target": "#nkr_note_mod_0968010", "type": "mod", "text": "達磨離欲【大】，達摩離染【宋】【元】【明】【宮】"}
{"id": null, "n": "0968004", "target": "#nkr_note_orig_0968004", "type": "orig", "text": "〔大〕－【三】【宮】"}
{"id": null, "n": "0968005", "target": "#nkr_note_orig_0968005", "type": "orig", "text": "言＝云【三】【宮】"}
{"id": null, "n": "0968006", "target": "#nkr_note_orig_0968006", "type": "orig", "text": "（問）＋曰【三】【宮】"}
{"id": null, "n": "0968007", "target": "#nkr_note_orig_0968007", "type": "orig", "text": "染之＝邪行【三】【宮】"}
{"id": null, "n": "0968008", "target": "#nkr_note_orig_0968008", "type": "orig", "text": "驕＝嬌【三】【宮】"}
{"id": null, "n": "0968009", "target": "#nkr_note_orig_0968009", "type": "orig", "text": "〔時〕－【三】【宮】"}
{"id": null, "n": "0968010", "target": "#nkr_note_orig_0968010", "type": "orig", "text": "達磨離欲＝達摩離染【三】【宮】"}
