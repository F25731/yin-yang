{"id": null, "n": null, "target": null, "type": null, "text": "其父正月十七日死於賊"}
{"id": null, "n": null, "target": null, "type": null, "text": "其人卒死"}
{"id": null, "n": null, "target": null, "type": null, "text": "有序"}
{"id": null, "n": null, "target": null, "type": null, "text": "有序"}
{"id": null, "n": null, "target": null, "type": null, "text": "四山：黃檗、福嚴、金栗、興陽"}
{"id": null, "n": null, "target": null, "type": null, "text": "本懷上請師別號沙翁"}
{"id": null, "n": null, "target": null, "type": null, "text": "禪人請"}
{"id": null, "n": null, "target": null, "type": null, "text": "師俗姓謝"}
{"id": null, "n": null, "target": null, "type": null, "text": "坡為五祖戒禪師後身。"}
{"id": null, "n": null, "target": null, "type": null, "text": "有鐘被火化為塊鐵，人屢竊，卒雷雨驚退。"}
{"id": null, "n": null, "target": null, "type": null, "text": "次古韻古題"}
{"id": null, "n": null, "target": null, "type": null, "text": "有序"}
{"id": null, "n": null, "target": null, "type": null, "text": "有序"}
{"id": null, "n": null, "target": null, "type": null, "text": "聖自蜀還南，有纂續古尊宿志。"}
{"id": null, "n": null, "target": null, "type": null, "text": "天王悟，俗姓崔。"}
{"id": null, "n": null, "target": null, "type": null, "text": "有序"}
{"id": null, "n": null, "target": null, "type": null, "text": "神秀禪師住度門，為兩京法主、三帝國師，趺坐覲君，肩輿上殿。"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱象璜"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱學洙"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱行"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱斌，來書請詳悉天王之訛。"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱養心"}
{"id": null, "n": null, "target": null, "type": null, "text": "傳為佛軀所化，或鐘所鎔，約四五千斤。"}
{"id": null, "n": null, "target": null, "type": null, "text": "版存嘉興府楞嚴寺經坊流通。\n康熙十一年重陽日謹識"}
