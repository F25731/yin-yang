{"id": null, "n": "0507008", "target": "#nkr_note_mod_0507008", "type": "mod", "text": "佛【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0507009", "target": "#nkr_note_mod_0507009", "type": "mod", "text": "長跪叉手【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0507010", "target": "#nkr_note_mod_0507010", "type": "mod", "text": "而【大】，前【宋】【元】【明】"}
{"id": null, "n": "0507011", "target": "#nkr_note_mod_0507011", "type": "mod", "text": "香【大】，意【宋】【元】【明】"}
{"id": null, "n": "0507012", "target": "#nkr_note_mod_0507012", "type": "mod", "text": "淫【大】，婬【宋】【元】【明】"}
{"id": null, "n": "0507013", "target": "#nkr_note_mod_0507013", "type": "mod", "text": "妬【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0507014", "target": "#nkr_note_mod_0507014", "type": "mod", "text": "三尊【大】，三寶【宋】【元】【明】"}
{"id": null, "n": "0507015", "target": "#nkr_note_mod_0507015", "type": "mod", "text": "奉行十【大】，及奉行【宋】【元】【明】"}
{"id": null, "n": "0507016", "target": "#nkr_note_mod_0507016", "type": "mod", "text": "蜜【大】，櫁【元】【明】"}
{"id": null, "n": "0507017", "target": "#nkr_note_mod_0507017", "type": "mod", "text": "者【大】，戒【宋】【元】【明】"}
{"id": null, "n": "0507018", "target": "#nkr_note_mod_0507018", "type": "mod", "text": "經【大】，維【宋】【元】【明】"}
{"id": null, "n": "0507019", "target": "#nkr_note_mod_0507019", "type": "mod", "text": "不【大】，無【宋】【元】【明】"}
{"id": null, "n": "0507020", "target": "#nkr_note_mod_0507020", "type": "mod", "text": "生【大】，盜媱【宋】【元】【明】"}
{"id": null, "n": "0507021", "target": "#nkr_note_mod_0507021", "type": "mod", "text": "橫【大】，限【宋】【元】【明】"}
{"id": null, "n": "0507022", "target": "#nkr_note_mod_0507022", "type": "mod", "text": "妄【大】，忘【宋】【元】【明】"}
{"id": null, "n": "0507023", "target": "#nkr_note_mod_0507023", "type": "mod", "text": "婬色者【大】，婬失者【宋】【元】【明】，婬妷者【磧-CB】"}
{"id": null, "n": "0507024", "target": "#nkr_note_mod_0507024", "type": "mod", "text": "人【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0507025", "target": "#nkr_note_mod_0507025", "type": "mod", "text": "妻【大】，他妻【宋】【元】【明】"}
{"id": null, "n": "0507026", "target": "#nkr_note_mod_0507026", "type": "mod", "text": "輒【大】，可【宋】【元】【明】"}
{"id": null, "n": "0507027", "target": "#nkr_note_mod_0507027", "type": "mod", "text": "有別離【大】，別離業【宋】【元】【明】"}
{"id": null, "n": "0507028", "target": "#nkr_note_mod_0507028", "type": "mod", "text": "語【大】，言【宋】【元】【明】"}
{"id": null, "n": "0507029", "target": "#nkr_note_mod_0507029", "type": "mod", "text": "喜【大】，然【宋】【元】【明】"}
