{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "黑胡子元表"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云小獸林王"}
{"id": null, "n": null, "target": null, "type": null, "text": "存古文"}
{"id": null, "n": null, "target": null, "type": null, "text": "或作虛"}
{"id": null, "n": null, "target": null, "type": null, "text": "此贊當在順道傳下"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐言三印山"}
{"id": null, "n": null, "target": null, "type": null, "text": "今與輪寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "今永興寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "今皇龍寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "今芬皇寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "今天王寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "今靈妙寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "今曇嚴寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "今嚴莊寺是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云異次頓或云居次頓"}
{"id": null, "n": null, "target": null, "type": null, "text": "按國史及古諸傳商量而述"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "明觀"}
{"id": null, "n": null, "target": null, "type": null, "text": "曇育"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡僧曇和　漢僧安和"}
{"id": null, "n": null, "target": null, "type": null, "text": "玄照名二人"}
{"id": null, "n": null, "target": null, "type": null, "text": "僧哲"}
{"id": null, "n": null, "target": null, "type": null, "text": "續高僧傳云入唐剎削"}
{"id": null, "n": null, "target": null, "type": null, "text": "碑文隱晦未詳"}
{"id": null, "n": null, "target": null, "type": null, "text": "碑文苔蝕字缺十。喪四五。略取可觀擬以成文"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐云惠甲"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐言一切智天"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T54n2128_p0380b06"}
