{"id": null, "n": null, "target": null, "type": "cf1", "text": "T54n2128_p0380b06"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "J25nB154_p0033c16"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T54n2128_p0318b05"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T49n2039_p1002b09"}
{"id": null, "n": "1015001", "target": "#nkr_note_mod_1015001", "type": "mod", "text": "󱛙子【大】，迹于【考偽-大】"}
{"id": null, "n": "1015002", "target": "#nkr_note_mod_1015002", "type": "mod", "text": "千【大】，于【考偽-大】"}
{"id": null, "n": "1016001", "target": "#nkr_note_mod_1016001", "type": "mod", "text": "續高僧傳卷八"}
{"id": null, "n": "1017002", "target": "#nkr_note_mod_1017002", "type": "mod", "text": "生【大】，〔－〕【考偽-大】"}
{"id": null, "n": "1017006", "target": "#nkr_note_mod_1017006", "type": "mod", "text": "拒【大】，距【考偽-大】"}
{"id": null, "n": "1019001", "target": "#nkr_note_mod_1019001", "type": "mod", "text": "乎【大】，手【考偽-大】"}
{"id": null, "n": "1020001", "target": "#nkr_note_mod_1020001", "type": "mod", "text": "訅【大】，訓【考偽-大】"}
{"id": null, "n": "1021015", "target": "#nkr_note_mod_1021015", "type": "mod", "text": "農伽陀 Naugata"}
{"id": null, "n": "1015001", "target": "#nkr_note_orig_1015001", "type": "orig", "text": "󱛙子＝迹于？"}
{"id": null, "n": "1015002", "target": "#nkr_note_orig_1015002", "type": "orig", "text": "千＝于？"}
{"id": null, "n": "1015003", "target": "#nkr_note_orig_1015003", "type": "orig", "text": "姓朴下見"}
{"id": null, "n": "1015004", "target": "#nkr_note_orig_1015004", "type": "orig", "text": "案當高麗高宗第二年。支那南宋寧宗嘉定八年。此傳之著蓋係此年"}
{"id": null, "n": "1016001", "target": "#nkr_note_orig_1016001", "type": "orig", "text": "續高僧傳卷八"}
{"id": null, "n": "1016002", "target": "#nkr_note_orig_1016002", "type": "orig", "text": "聖續傳作丞"}
{"id": null, "n": "1016003", "target": "#nkr_note_orig_1016003", "type": "orig", "text": "Asaṅga"}
{"id": null, "n": "1016004", "target": "#nkr_note_orig_1016004", "type": "orig", "text": "Vasubandhu"}
{"id": null, "n": "1016005", "target": "#nkr_note_orig_1016005", "type": "orig", "text": "三國遺事三注云。一作惠始"}
{"id": null, "n": "1017001", "target": "#nkr_note_orig_1017001", "type": "orig", "text": "第十神異下"}
{"id": null, "n": "1017002", "target": "#nkr_note_orig_1017002", "type": "orig", "text": "〔生〕－？"}
{"id": null, "n": "1017003", "target": "#nkr_note_orig_1017003", "type": "orig", "text": "曰梁傳作於"}
{"id": null, "n": "1017004", "target": "#nkr_note_orig_1017004", "type": "orig", "text": "Malananda"}
{"id": null, "n": "1017005", "target": "#nkr_note_orig_1017005", "type": "orig", "text": "三國遺事卷三引百濟本記云第十五枕流王即位甲申難陀至注云僧傳云十四誤"}
{"id": null, "n": "1017006", "target": "#nkr_note_orig_1017006", "type": "orig", "text": "拒＝距？"}
{"id": null, "n": "1017007", "target": "#nkr_note_orig_1017007", "type": "orig", "text": "三國遺事卷三阿道下注云一作我道又阿頭"}
{"id": null, "n": "1017008", "target": "#nkr_note_orig_1017008", "type": "orig", "text": "三國遺事注云又作毛祿"}
{"id": null, "n": "1018001", "target": "#nkr_note_orig_1018001", "type": "orig", "text": "三國遺事注云有注云與本碑及諸傳記殊異又高僧傳云西竺人或云從吳來"}
{"id": null, "n": "1018002", "target": "#nkr_note_orig_1018002", "type": "orig", "text": "橋下遺事有東字"}
{"id": null, "n": "1018003", "target": "#nkr_note_orig_1018003", "type": "orig", "text": "輪原本作輔今依下文法空傳及三國遺事改之"}
{"id": null, "n": "1018004", "target": "#nkr_note_orig_1018004", "type": "orig", "text": "味遺事作未"}
{"id": null, "n": "1018005", "target": "#nkr_note_orig_1018005", "type": "orig", "text": "村遺事作林注云今一善縣"}
{"id": null, "n": "1018006", "target": "#nkr_note_orig_1018006", "type": "orig", "text": "三國遺事三注云祿與禮形近之誤"}
{"id": null, "n": "1018007", "target": "#nkr_note_orig_1018007", "type": "orig", "text": "興下原本空一字"}
{"id": null, "n": "1019001", "target": "#nkr_note_orig_1019001", "type": "orig", "text": "乎＝手？"}
{"id": null, "n": "1019002", "target": "#nkr_note_orig_1019002", "type": "orig", "text": "年原本作梁今依下文覺德傳改之"}
{"id": null, "n": "1020001", "target": "#nkr_note_orig_1020001", "type": "orig", "text": "訅＝訓？"}
{"id": null, "n": "1020002", "target": "#nkr_note_orig_1020002", "type": "orig", "text": "事見續高僧傳卷之十三及三國遺事卷四"}
{"id": null, "n": "1021001", "target": "#nkr_note_orig_1021001", "type": "orig", "text": "小或北字"}
{"id": null, "n": "1021002", "target": "#nkr_note_orig_1021002", "type": "orig", "text": "治原本作詔今依續傳十三改之"}
{"id": null, "n": "1021003", "target": "#nkr_note_orig_1021003", "type": "orig", "text": "寺號遺事四作嘉瑟岬注云或作加西又嘉栖皆方言也岬俗云古尸故或云古尸寺猶言岬寺也今雲門寺東九千步許有加西岬或云嘉瑟峴峴之北洞有寺基臺是也"}
{"id": null, "n": "1021004", "target": "#nkr_note_orig_1021004", "type": "orig", "text": "頂遺事四作項貴山󰆠頂二賢士之名"}
{"id": null, "n": "1021005", "target": "#nkr_note_orig_1021005", "type": "orig", "text": "二空字宜作有用二字遺事作唯其所用"}
{"id": null, "n": "1021006", "target": "#nkr_note_orig_1021006", "type": "orig", "text": "空字據遺事四及續僧十三宜作損"}
{"id": null, "n": "1021007", "target": "#nkr_note_orig_1021007", "type": "orig", "text": "斯民遺事四作民斯"}
{"id": null, "n": "1021008", "target": "#nkr_note_orig_1021008", "type": "orig", "text": "詳遺事四作祥"}
{"id": null, "n": "1021009", "target": "#nkr_note_orig_1021009", "type": "orig", "text": "安原本作光今依本傳改之"}
{"id": null, "n": "1021010", "target": "#nkr_note_orig_1021010", "type": "orig", "text": "永遺事續傳俱作求"}
{"id": null, "n": "1021011", "target": "#nkr_note_orig_1021011", "type": "orig", "text": "設或說字"}
{"id": null, "n": "1021012", "target": "#nkr_note_orig_1021012", "type": "orig", "text": "相恐湘字"}
{"id": null, "n": "1021013", "target": "#nkr_note_orig_1021013", "type": "orig", "text": "Udyana"}
{"id": null, "n": "1021014", "target": "#nkr_note_orig_1021014", "type": "orig", "text": "Vimala-cimti"}
{"id": null, "n": "1021015", "target": "#nkr_note_orig_1021015", "type": "orig", "text": "Naugata＊"}
{"id": null, "n": "1021016", "target": "#nkr_note_orig_1021016", "type": "orig", "text": "Mathura"}
{"id": null, "n": "1021017", "target": "#nkr_note_orig_1021017", "type": "orig", "text": "Buddha-saṅgha"}
{"id": null, "n": "1021018", "target": "#nkr_note_orig_1021018", "type": "orig", "text": "始下恐脫入字"}
{"id": null, "n": "1022001", "target": "#nkr_note_orig_1022001", "type": "orig", "text": "天字恐王字"}
{"id": null, "n": "1022002", "target": "#nkr_note_orig_1022002", "type": "orig", "text": "Arya-varman"}
{"id": null, "n": "1022003", "target": "#nkr_note_orig_1022003", "type": "orig", "text": "Nālanda"}
{"id": null, "n": "1022004", "target": "#nkr_note_orig_1022004", "type": "orig", "text": "空字恐僧字"}
{"id": null, "n": "1022005", "target": "#nkr_note_orig_1022005", "type": "orig", "text": "新羅僧八人入竺事見大唐求法高僧傳"}
{"id": null, "n": "1022006", "target": "#nkr_note_orig_1022006", "type": "orig", "text": "事見求法傳"}
{"id": null, "n": "1022007", "target": "#nkr_note_orig_1022007", "type": "orig", "text": "Prajñā-vaman"}
{"id": null, "n": "1022008", "target": "#nkr_note_orig_1022008", "type": "orig", "text": "原本作申非也"}
{"id": null, "n": "1022009", "target": "#nkr_note_orig_1022009", "type": "orig", "text": "波求法傳作跛宋元明三本俱作跋國屬中天或可 Amravati 又 Amarāvati"}
{"id": null, "n": "1022010", "target": "#nkr_note_orig_1022010", "type": "orig", "text": "Ciñcā-vihāra"}
{"id": null, "n": "1022011", "target": "#nkr_note_orig_1022011", "type": "orig", "text": "Gandhāra"}
{"id": null, "n": "1022012", "target": "#nkr_note_orig_1022012", "type": "orig", "text": "求法傳唯云太州人不以為新羅人"}
{"id": null, "n": "1022013", "target": "#nkr_note_orig_1022013", "type": "orig", "text": "Srībuja"}
{"id": null, "n": "1022014", "target": "#nkr_note_orig_1022014", "type": "orig", "text": "求法傳玄太法師遺事四歸竺諸師下作玄泰"}
{"id": null, "n": "1022015", "target": "#nkr_note_orig_1022015", "type": "orig", "text": "梵宜下在名字上"}
{"id": null, "n": "1022016", "target": "#nkr_note_orig_1022016", "type": "orig", "text": "法字宜削之"}
{"id": null, "n": "1022017", "target": "#nkr_note_orig_1022017", "type": "orig", "text": "Sarvajña-deva"}
