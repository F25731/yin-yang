{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "有本小異大同"}
{"id": null, "n": null, "target": null, "type": null, "text": "有本小異大同"}
{"id": null, "n": null, "target": null, "type": null, "text": "上"}
{"id": null, "n": null, "target": null, "type": null, "text": "諸深切與針同"}
{"id": null, "n": null, "target": null, "type": null, "text": "正作鎞邊迷切掠噐"}
{"id": null, "n": null, "target": null, "type": null, "text": "郎亘切雕刻也"}
{"id": null, "n": null, "target": null, "type": null, "text": "克盍切"}
{"id": null, "n": null, "target": null, "type": null, "text": "祖峻切與儁同"}
{"id": null, "n": null, "target": null, "type": null, "text": "祥里切年也"}
{"id": null, "n": null, "target": null, "type": null, "text": "璀七罪切燦七旦切璀燦玉光\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "大含切白魚蟲"}
{"id": null, "n": null, "target": null, "type": null, "text": "牆之切引鐵石"}
{"id": null, "n": null, "target": null, "type": null, "text": "七宵切臿也"}
{"id": null, "n": null, "target": null, "type": null, "text": "測洽切。鍫\n\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "古額切𮌎膈也"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃󲊸切頂也"}
{"id": null, "n": null, "target": null, "type": null, "text": "古痕切足踵也"}
{"id": null, "n": null, "target": null, "type": null, "text": "子小切絕\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒲拜切吹火韋囊也"}
{"id": null, "n": null, "target": null, "type": null, "text": "息勇切"}
{"id": null, "n": null, "target": null, "type": null, "text": "羊諸切兩手對舉也"}
{"id": null, "n": null, "target": null, "type": null, "text": "岌魚及切山高貌峇口合切山\n窟也"}
{"id": null, "n": null, "target": null, "type": null, "text": "魚開切癡也"}
{"id": null, "n": null, "target": null, "type": null, "text": "陟嫁切姹女水銀也"}
{"id": null, "n": null, "target": null, "type": null, "text": "尼耕切大惡也"}
{"id": null, "n": null, "target": null, "type": null, "text": "其月\n切"}
{"id": null, "n": null, "target": null, "type": null, "text": "俱為切"}
{"id": null, "n": null, "target": null, "type": null, "text": "之列切"}
{"id": null, "n": null, "target": null, "type": null, "text": "人者切"}
{"id": null, "n": null, "target": null, "type": null, "text": "烏貫切手󵖛也"}
{"id": null, "n": null, "target": null, "type": null, "text": "他歷\n切"}
{"id": null, "n": null, "target": null, "type": null, "text": "𨁝蒲沒切跳也弔切"}
{"id": null, "n": null, "target": null, "type": null, "text": "七慮切同視也"}
{"id": null, "n": null, "target": null, "type": null, "text": "下"}
{"id": null, "n": null, "target": null, "type": null, "text": "有本小異大同"}
{"id": null, "n": null, "target": null, "type": null, "text": "外道問佛亦類於此"}
{"id": null, "n": null, "target": null, "type": null, "text": "下"}
{"id": null, "n": null, "target": null, "type": null, "text": "祖官切穿也"}
{"id": null, "n": null, "target": null, "type": null, "text": "石證切󲈺長也"}
{"id": null, "n": null, "target": null, "type": null, "text": "之列切"}
{"id": null, "n": null, "target": null, "type": null, "text": "光結切櫼也"}
{"id": null, "n": null, "target": null, "type": null, "text": "瑯音郎瑘音耶"}
{"id": null, "n": null, "target": null, "type": null, "text": "懡忙果切㦬郎可切"}
{"id": null, "n": null, "target": null, "type": null, "text": "埏尸連切和土也埴\n丞職切黏土也"}
{"id": null, "n": null, "target": null, "type": null, "text": "大透切"}
{"id": null, "n": null, "target": null, "type": null, "text": "梵語也此云賤種罽居例切"}
{"id": null, "n": null, "target": null, "type": null, "text": "歷德\n切"}
{"id": null, "n": null, "target": null, "type": null, "text": "髑音獨髏音婁髑髏首骨也"}
{"id": null, "n": null, "target": null, "type": null, "text": "渠竹切"}
{"id": null, "n": null, "target": null, "type": null, "text": "虛業切"}
{"id": null, "n": null, "target": null, "type": null, "text": "於加切"}
{"id": null, "n": null, "target": null, "type": null, "text": "千羊切"}
{"id": null, "n": null, "target": null, "type": null, "text": "𣯫力朱切𣯜霜俱切"}
{"id": null, "n": null, "target": null, "type": null, "text": "子小切絕也"}
{"id": null, "n": null, "target": null, "type": null, "text": "𢤱力董切悷郎計切𢤱悷多惡不調也"}
{"id": null, "n": null, "target": null, "type": null, "text": "余律切鳥名"}
{"id": null, "n": null, "target": null, "type": null, "text": "槽音\n曹廠昌而切"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘亮切風非物也"}
{"id": null, "n": null, "target": null, "type": null, "text": "荷合可切"}
{"id": null, "n": null, "target": null, "type": null, "text": "即淡切與楫同"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣牛頭威"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣鶴林業"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣徑山欽"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣安國師"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣破竈墮"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣嵩山寂"}
{"id": null, "n": null, "target": null, "type": null, "text": "有云東寺或云百丈問南泉"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣忠國師"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云師問麻谷"}
{"id": null, "n": null, "target": null, "type": null, "text": "住廬山"}
{"id": null, "n": null, "target": null, "type": null, "text": "或曰南泉大同小異"}
{"id": null, "n": null, "target": null, "type": null, "text": "雪竇云三生六十劫"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本曰豐干"}
{"id": null, "n": null, "target": null, "type": null, "text": "有本云紙衣道者問德上座或謂洞\n山問曹山"}
{"id": null, "n": null, "target": null, "type": null, "text": "見洪州鷄足山主"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云匾檐山菴主"}
{"id": null, "n": null, "target": null, "type": null, "text": "或曰石霜"}
{"id": null, "n": null, "target": null, "type": null, "text": "朱惟切猶鑽也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音因"}
{"id": null, "n": null, "target": null, "type": null, "text": "踟直知切躕直朱切踟躕行不進也"}
{"id": null, "n": null, "target": null, "type": null, "text": "悚息勇切怖也慄力質切懼也"}
{"id": null, "n": null, "target": null, "type": null, "text": "起虔切與愆同"}
{"id": null, "n": null, "target": null, "type": null, "text": "蛤古合切蜊音\n梨"}
{"id": null, "n": null, "target": null, "type": null, "text": "郎狄切小石也"}
{"id": null, "n": null, "target": null, "type": null, "text": "戶吾切"}
{"id": null, "n": null, "target": null, "type": null, "text": "尺栗切訶也"}
{"id": null, "n": null, "target": null, "type": null, "text": "式荏切"}
{"id": null, "n": null, "target": null, "type": null, "text": "徒果切"}
{"id": null, "n": null, "target": null, "type": null, "text": "直䧟切錯也"}
{"id": null, "n": null, "target": null, "type": null, "text": "離珍切"}
{"id": null, "n": null, "target": null, "type": null, "text": "音雷研物也"}
{"id": null, "n": null, "target": null, "type": null, "text": "七慮切伺\n\n視也"}
{"id": null, "n": null, "target": null, "type": null, "text": "盧登切"}
{"id": null, "n": null, "target": null, "type": null, "text": "子刮切逼拶也"}
{"id": null, "n": null, "target": null, "type": null, "text": "谷音欲"}
{"id": null, "n": null, "target": null, "type": null, "text": "朱欲切照也"}
{"id": null, "n": null, "target": null, "type": null, "text": "楚限切"}
{"id": null, "n": null, "target": null, "type": null, "text": "息移切役也"}
{"id": null, "n": null, "target": null, "type": null, "text": "悉合切"}
{"id": null, "n": null, "target": null, "type": null, "text": "火故切抒水器也"}
{"id": null, "n": null, "target": null, "type": null, "text": "先奚切"}
{"id": null, "n": null, "target": null, "type": null, "text": "俶昌六切動也裝側霜切裹也"}
{"id": null, "n": null, "target": null, "type": null, "text": "尼止切指物貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣馬大師"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云百丈政禪師語"}
{"id": null, "n": null, "target": null, "type": null, "text": "有曰徑山"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本曰鄧隱峯或曰永嘉"}
{"id": null, "n": null, "target": null, "type": null, "text": "有本少異"}
{"id": null, "n": null, "target": null, "type": null, "text": "香嚴錄有亦類於此不収"}
{"id": null, "n": null, "target": null, "type": null, "text": "懵莫孔切懂音董懵懂不慧也"}
{"id": null, "n": null, "target": null, "type": null, "text": "朱惟切烏騅馬名"}
{"id": null, "n": null, "target": null, "type": null, "text": "朦音\n蒙朧音龍"}
{"id": null, "n": null, "target": null, "type": null, "text": "古獲切批打也"}
{"id": null, "n": null, "target": null, "type": null, "text": "其月切"}
{"id": null, "n": null, "target": null, "type": null, "text": "音潑"}
{"id": null, "n": null, "target": null, "type": null, "text": "音求"}
{"id": null, "n": null, "target": null, "type": null, "text": "音丙"}
{"id": null, "n": null, "target": null, "type": null, "text": "澄應切直視貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "力對切"}
{"id": null, "n": null, "target": null, "type": null, "text": "於教切相違也"}
{"id": null, "n": null, "target": null, "type": null, "text": "他歷切"}
{"id": null, "n": null, "target": null, "type": null, "text": "徒弔切燒\n噐也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音祿"}
{"id": null, "n": null, "target": null, "type": null, "text": "他各切泥拓也"}
{"id": null, "n": null, "target": null, "type": null, "text": "於買切短也"}
{"id": null, "n": null, "target": null, "type": null, "text": "莽莫補切鹵郎\n\n古切"}
{"id": null, "n": null, "target": null, "type": null, "text": "顢莫安切頇許安切"}
{"id": null, "n": null, "target": null, "type": null, "text": "古痕切足踵也"}
{"id": null, "n": null, "target": null, "type": null, "text": "搕烏合切𢶍蘇\n盍切搕𢶍糞也"}
{"id": null, "n": null, "target": null, "type": null, "text": "蘇到切狂踈貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "五怪切聾也"}
{"id": null, "n": null, "target": null, "type": null, "text": "委粉切"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡麥\n切破物也"}
{"id": null, "n": null, "target": null, "type": null, "text": "古豆切"}
{"id": null, "n": null, "target": null, "type": null, "text": "音迪"}
{"id": null, "n": null, "target": null, "type": null, "text": "古猛切金也"}
{"id": null, "n": null, "target": null, "type": null, "text": "似及切"}
{"id": null, "n": null, "target": null, "type": null, "text": "音離\n瓠瓢也"}
{"id": null, "n": null, "target": null, "type": null, "text": "或出栢岩錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "或藥山下鄂州百顏語錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦曰隱山"}
{"id": null, "n": null, "target": null, "type": null, "text": "有本悞指大智禪師"}
{"id": null, "n": null, "target": null, "type": null, "text": "即益官也"}
{"id": null, "n": null, "target": null, "type": null, "text": "或曰\n師到齊峰"}
{"id": null, "n": null, "target": null, "type": null, "text": "或曰拍門三下"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本󰅻高峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "或出趙州語同"}
{"id": null, "n": null, "target": null, "type": null, "text": "蜀人"}
{"id": null, "n": null, "target": null, "type": null, "text": "俗你同"}
{"id": null, "n": null, "target": null, "type": null, "text": "音生狌狌能言獸也"}
{"id": null, "n": null, "target": null, "type": null, "text": "側洽切"}
{"id": null, "n": null, "target": null, "type": null, "text": "余六切"}
{"id": null, "n": null, "target": null, "type": null, "text": "蟭音焦螟音冥"}
{"id": null, "n": null, "target": null, "type": null, "text": "即涉切目旁毛也"}
{"id": null, "n": null, "target": null, "type": null, "text": "栲音考栳音老栲栳柳噐"}
{"id": null, "n": null, "target": null, "type": null, "text": "初覲切近身衣也"}
{"id": null, "n": null, "target": null, "type": null, "text": "疾茲切"}
{"id": null, "n": null, "target": null, "type": null, "text": "羊諸切兩手對舉也"}
{"id": null, "n": null, "target": null, "type": null, "text": "磅蒲光切\n礡白各切"}
{"id": null, "n": null, "target": null, "type": null, "text": "鏌音莫鎁音耶鏌鎁劒名"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣南泉願"}
{"id": null, "n": null, "target": null, "type": null, "text": "或謂金峯又曰香嚴"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本云金輪可觀和尚"}
{"id": null, "n": null, "target": null, "type": null, "text": "或曰天皇語"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本云泉乃擊鍋三下"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣歸宗常"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣章敬惲"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣盤山積"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣麻谷徹"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣西堂藏"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣永叅滯"}
{"id": null, "n": null, "target": null, "type": null, "text": "音巴"}
{"id": null, "n": null, "target": null, "type": null, "text": "他達切足跌也"}
{"id": null, "n": null, "target": null, "type": null, "text": "芳無切"}
{"id": null, "n": null, "target": null, "type": null, "text": "邯音寒鄲音丹"}
{"id": null, "n": null, "target": null, "type": null, "text": "蹭七亘切蹬音鄧蹭蹬無能也"}
{"id": null, "n": null, "target": null, "type": null, "text": "他歷切"}
{"id": null, "n": null, "target": null, "type": null, "text": "七宵切"}
{"id": null, "n": null, "target": null, "type": null, "text": "音是"}
{"id": null, "n": null, "target": null, "type": null, "text": "闒託合切茸而隴切"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡老切"}
{"id": null, "n": null, "target": null, "type": null, "text": "音至"}
{"id": null, "n": null, "target": null, "type": null, "text": "呼括切"}
{"id": null, "n": null, "target": null, "type": null, "text": "初覲切"}
{"id": null, "n": null, "target": null, "type": null, "text": "初加切"}
{"id": null, "n": null, "target": null, "type": null, "text": "七亂切"}
{"id": null, "n": null, "target": null, "type": null, "text": "呼刀切攪也"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣百丈海"}
{"id": null, "n": null, "target": null, "type": null, "text": "首座即樺林也"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本小真"}
{"id": null, "n": null, "target": null, "type": null, "text": "○○"}
{"id": null, "n": null, "target": null, "type": null, "text": "待骨切"}
{"id": null, "n": null, "target": null, "type": null, "text": "抖音斗擻音叟抖擻振舉貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "苦盍切與磕同"}
{"id": null, "n": null, "target": null, "type": null, "text": "初江切"}
{"id": null, "n": null, "target": null, "type": null, "text": "勿發切足衣也"}
{"id": null, "n": null, "target": null, "type": null, "text": "直雙切喫也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音零與羚同"}
{"id": null, "n": null, "target": null, "type": null, "text": "骼柯額切胔疾智切露骨曰骼有肉曰胔"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣趙州諗"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣紫胡蹤"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣茱萸"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣大愚"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣天龍"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣關南常"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣大溈祐"}
{"id": null, "n": null, "target": null, "type": null, "text": "或曰鷃山"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本謂鄭愚問"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本小異大同"}
{"id": null, "n": null, "target": null, "type": null, "text": "師到乳源語亦頗同"}
{"id": null, "n": null, "target": null, "type": null, "text": "或曰重"}
{"id": null, "n": null, "target": null, "type": null, "text": "始住大溈時號懶安"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本少異"}
{"id": null, "n": null, "target": null, "type": null, "text": "或謂米七師或曰米胡者"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本語少異大\n意相類"}
{"id": null, "n": null, "target": null, "type": null, "text": "第九同卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣黃檗運"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲峯恱云作賊\n人心虛"}
{"id": null, "n": null, "target": null, "type": null, "text": "有本小異大同"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云德山回顧云欲借一問得麼師便喝"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云謝和尚指示或時僧不顧"}
{"id": null, "n": null, "target": null, "type": null, "text": "即洛浦也"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本曰到翠峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "第二世者"}
{"id": null, "n": null, "target": null, "type": null, "text": "或依和尚問端長老小異大同"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣徑山諲"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣長慶安"}
{"id": null, "n": null, "target": null, "type": null, "text": "或出趙州"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣先雙峯"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣睦州"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣臨濟玄"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本\n出興化問"}
{"id": null, "n": null, "target": null, "type": null, "text": "與巖陽問\n趙州語同"}
{"id": null, "n": null, "target": null, "type": null, "text": "質涉切怖也"}
{"id": null, "n": null, "target": null, "type": null, "text": "七慮切伺視也"}
{"id": null, "n": null, "target": null, "type": null, "text": "𥉌都合切𭿇赤脂切"}
{"id": null, "n": null, "target": null, "type": null, "text": "所鳩\n切飯壞也"}
{"id": null, "n": null, "target": null, "type": null, "text": "作木切矢𨫢也"}
{"id": null, "n": null, "target": null, "type": null, "text": "市流切與讎同"}
{"id": null, "n": null, "target": null, "type": null, "text": "酩莫迥切酊音鼎酩\n酊醉甚貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒲拜切吹火韋囊也"}
{"id": null, "n": null, "target": null, "type": null, "text": "漚於候切漬也"}
{"id": null, "n": null, "target": null, "type": null, "text": "尼止切指物貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "呼括切"}
{"id": null, "n": null, "target": null, "type": null, "text": "𬢿竹洽切𧫡陟栗切"}
{"id": null, "n": null, "target": null, "type": null, "text": "居六切曲岸水外曰𨸰"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣仰山西塔穆"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣南塔涌"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣寶壽治"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣三聖然"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣先大覺"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦曰南院嗣興化樊"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣克符道者"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣芭蕉清"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣西院明"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣南院顒"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本分上一句作主家語"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣風穴沼"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦住寶"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣首山念"}
{"id": null, "n": null, "target": null, "type": null, "text": "或曰首山"}
{"id": null, "n": null, "target": null, "type": null, "text": "見廣慧璉"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱遵勗見石門聦禪師"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣汾州昭"}
{"id": null, "n": null, "target": null, "type": null, "text": "時謂泰河東"}
{"id": null, "n": null, "target": null, "type": null, "text": "有本小差"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣慈明圓"}
{"id": null, "n": null, "target": null, "type": null, "text": "薄邁切吹火韋囊也"}
{"id": null, "n": null, "target": null, "type": null, "text": "俱為切"}
{"id": null, "n": null, "target": null, "type": null, "text": "時及切"}
{"id": null, "n": null, "target": null, "type": null, "text": "乞洽切"}
{"id": null, "n": null, "target": null, "type": null, "text": "鏌末各切鎁音耶鏌鎁劒名"}
{"id": null, "n": null, "target": null, "type": null, "text": "籠都切韓獹犬也"}
{"id": null, "n": null, "target": null, "type": null, "text": "陳知切"}
{"id": null, "n": null, "target": null, "type": null, "text": "于葛\n切逼拶也"}
{"id": null, "n": null, "target": null, "type": null, "text": "力活切手捋也"}
{"id": null, "n": null, "target": null, "type": null, "text": "渠龜切似牛一角皮可冒鼓"}
{"id": null, "n": null, "target": null, "type": null, "text": "普火切不\n可也"}
{"id": null, "n": null, "target": null, "type": null, "text": "楚尤切手搊也"}
{"id": null, "n": null, "target": null, "type": null, "text": "租恱切断也"}
{"id": null, "n": null, "target": null, "type": null, "text": "研奚切鯨鯢魚名"}
{"id": null, "n": null, "target": null, "type": null, "text": "陟扇\n切馬土浴也"}
{"id": null, "n": null, "target": null, "type": null, "text": "顰毗賔切蹙子六切顰蹙眉攢也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音葛"}
{"id": null, "n": null, "target": null, "type": null, "text": "詩車\n切田也"}
{"id": null, "n": null, "target": null, "type": null, "text": "蘇到切狂踈貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "匹棄切氣下泄也"}
{"id": null, "n": null, "target": null, "type": null, "text": "楖音即𣗖音栗\n楖𣗖木名"}
{"id": null, "n": null, "target": null, "type": null, "text": "歷德切"}
{"id": null, "n": null, "target": null, "type": null, "text": "於絞切手拉也"}
{"id": null, "n": null, "target": null, "type": null, "text": "各核切𮌎膈也"}
{"id": null, "n": null, "target": null, "type": null, "text": "力讓切履\n兩枚也"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃結切握也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣青原思"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣石頭遷"}
{"id": null, "n": null, "target": null, "type": null, "text": "有本謂馬祖問僧"}
{"id": null, "n": null, "target": null, "type": null, "text": "或曰道吾"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本云這冤家\n子喪我門風"}
{"id": null, "n": null, "target": null, "type": null, "text": "上"}
{"id": null, "n": null, "target": null, "type": null, "text": "弦鷄切小鼠也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音你指物貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "女蟹切乳也"}
{"id": null, "n": null, "target": null, "type": null, "text": "休居切吹也"}
{"id": null, "n": null, "target": null, "type": null, "text": "荒故切抒水噐"}
{"id": null, "n": null, "target": null, "type": null, "text": "徒沃切皂纛軍中大旗也"}
{"id": null, "n": null, "target": null, "type": null, "text": "郭獲切批打也"}
{"id": null, "n": null, "target": null, "type": null, "text": "下"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本曰棗樹話未詳是何世代"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣藥山儼"}
{"id": null, "n": null, "target": null, "type": null, "text": "後竹園與僧有語頗相同"}
{"id": null, "n": null, "target": null, "type": null, "text": "蓋船子曾囑道吾已後有座主指一\n箇來"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云\n\n目前無似"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云是什麼"}
{"id": null, "n": null, "target": null, "type": null, "text": "有曰嗣馬祖者"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣天皇悟"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣丹霞然"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣長髭曠"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣大川"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣大顛"}
{"id": null, "n": null, "target": null, "type": null, "text": "與章敬語同"}
{"id": null, "n": null, "target": null, "type": null, "text": "下"}
{"id": null, "n": null, "target": null, "type": null, "text": "鋤佳切桴也"}
{"id": null, "n": null, "target": null, "type": null, "text": "先結切櫼也"}
{"id": null, "n": null, "target": null, "type": null, "text": "厥縳切爪持也"}
{"id": null, "n": null, "target": null, "type": null, "text": "厥縳切大鉏也"}
{"id": null, "n": null, "target": null, "type": null, "text": "吉恊切"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣道吾智"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云鏡清\n問僧"}
{"id": null, "n": null, "target": null, "type": null, "text": "雪竇著語蒼天蒼天"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣雲巖晟"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣船子誠"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣龍潭信"}
{"id": null, "n": null, "target": null, "type": null, "text": "雪竇著語勘破了也"}
{"id": null, "n": null, "target": null, "type": null, "text": "雪竇著語勘破了也"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣翠微學"}
{"id": null, "n": null, "target": null, "type": null, "text": "懵母緫切懂覩動切懵懂心亂貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "遷遙切田噐也"}
{"id": null, "n": null, "target": null, "type": null, "text": "狹澗切"}
{"id": null, "n": null, "target": null, "type": null, "text": "里弟切州名"}
{"id": null, "n": null, "target": null, "type": null, "text": "郎豆切雕刻也"}
{"id": null, "n": null, "target": null, "type": null, "text": "乙𭶑切"}
{"id": null, "n": null, "target": null, "type": null, "text": "苦淮切口戾不正也"}
{"id": null, "n": null, "target": null, "type": null, "text": "除孟切磨也"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡千切船邊也"}
{"id": null, "n": null, "target": null, "type": null, "text": "蘇曹切"}
{"id": null, "n": null, "target": null, "type": null, "text": "冬毒切尻𡱰也"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X84n1580_p0321c07"}
