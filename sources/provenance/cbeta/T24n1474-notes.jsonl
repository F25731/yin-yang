{"id": null, "n": "0937001", "target": "#nkr_note_mod_0937001", "type": "mod", "text": "在後漢錄【大】，失譯今在漢錄【宋】【元】，失譯人名【明】，失譯【宮】"}
{"id": null, "n": "0937002", "target": "#nkr_note_mod_0937002", "type": "mod", "text": "泆【大】＊，妷【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0937003", "target": "#nkr_note_mod_0937003", "type": "mod", "text": "得一心清【大】，婬真一清淨【宋】【元】【明】【宮】"}
{"id": null, "n": "0937004", "target": "#nkr_note_mod_0937004", "type": "mod", "text": "直避【大】，真譬【宋】【元】【明】【宮】"}
{"id": null, "n": "0937005", "target": "#nkr_note_mod_0937005", "type": "mod", "text": "縷【大】，屨【宋】【元】【明】【宮】"}
{"id": null, "n": "0937006", "target": "#nkr_note_mod_0937006", "type": "mod", "text": "寶【大】，實【宋】【元】【明】【宮】"}
{"id": null, "n": "0937007", "target": "#nkr_note_mod_0937007", "type": "mod", "text": "殖【大】，植【宋】【元】【明】【宮】"}
{"id": null, "n": "0937008", "target": "#nkr_note_mod_0937008", "type": "mod", "text": "寶【大】，眾寶【宋】【元】【明】【宮】"}
{"id": null, "n": "0937009", "target": "#nkr_note_mod_0937009", "type": "mod", "text": "㲖【大】，捎【宋】【元】【明】【宮】"}
{"id": null, "n": "0937010", "target": "#nkr_note_mod_0937010", "type": "mod", "text": "于【大】＊，於【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0937011", "target": "#nkr_note_mod_0937011", "type": "mod", "text": "寶【大】，實【宋】【元】【宮】"}
{"id": null, "n": "0937012", "target": "#nkr_note_mod_0937012", "type": "mod", "text": "妙【大】，如【元】"}
{"id": null, "n": "0937013", "target": "#nkr_note_mod_0937013", "type": "mod", "text": "王【大】，主【宮】"}
{"id": null, "n": "0937014", "target": "#nkr_note_mod_0937014", "type": "mod", "text": "後【大】，後施【宋】【元】【明】【宮】"}
{"id": null, "n": "0937015", "target": "#nkr_note_mod_0937015", "type": "mod", "text": "服【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0937016", "target": "#nkr_note_mod_0937016", "type": "mod", "text": "食【大】，〔－〕【宮】"}
{"id": null, "n": "0937017", "target": "#nkr_note_mod_0937017", "type": "mod", "text": "達【大】，遠【宋】【元】【明】【宮】"}
{"id": null, "n": "0937018", "target": "#nkr_note_mod_0937018", "type": "mod", "text": "治【大】，活【宋】【元】【明】【宮】"}
{"id": null, "n": "0938001", "target": "#nkr_note_mod_0938001", "type": "mod", "text": "和上【大】下同，和尚【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0938002", "target": "#nkr_note_mod_0938002", "type": "mod", "text": "反【大】，返【宋】【元】【明】【宮】"}
{"id": null, "n": "0938003", "target": "#nkr_note_mod_0938003", "type": "mod", "text": "燒【大】，嬈【宋】【元】【明】【宮】"}
{"id": null, "n": "0938004", "target": "#nkr_note_mod_0938004", "type": "mod", "text": "處【大】，劇【宋】【元】【明】【宮】"}
{"id": null, "n": "0938005", "target": "#nkr_note_mod_0938005", "type": "mod", "text": "導【大】，道【宋】【元】【明】【宮】"}
{"id": null, "n": "0938006", "target": "#nkr_note_mod_0938006", "type": "mod", "text": "度【大】，渡【明】"}
{"id": null, "n": "0938007", "target": "#nkr_note_mod_0938007", "type": "mod", "text": "併【大】，并【宋】【元】【明】，棄【宮】"}
{"id": null, "n": "0938008", "target": "#nkr_note_mod_0938008", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0937001", "target": "#nkr_note_orig_0937001", "type": "orig", "text": "在後漢錄＝失譯今在漢錄【宋】【元】，失譯人名【明】，失譯【宮】"}
