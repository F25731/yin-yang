{"id": null, "n": "0937013", "target": "#nkr_note_orig_0937013", "type": "orig", "text": "王＝主【宮】"}
{"id": null, "n": "0937014", "target": "#nkr_note_orig_0937014", "type": "orig", "text": "後＋（施）【三】【宮】"}
