{"id": null, "n": "0938003", "target": "#nkr_note_orig_0938003", "type": "orig", "text": "燒＝嬈【三】【宮】"}
{"id": null, "n": "0938004", "target": "#nkr_note_orig_0938004", "type": "orig", "text": "處＝劇【三】【宮】"}
{"id": null, "n": "0938005", "target": "#nkr_note_orig_0938005", "type": "orig", "text": "導＝道【三】【宮】"}
