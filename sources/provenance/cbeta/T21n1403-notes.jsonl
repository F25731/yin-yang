{"id": null, "n": "0919008", "target": null, "type": "orig", "text": "〔譯經〕－【明】"}
{"id": null, "n": "0919008", "target": null, "type": "mod", "text": "譯經【大】，〔－〕【明】"}
{"id": null, "n": "0919009", "target": null, "type": "orig", "text": "〔臣〕－【明】"}
{"id": null, "n": "0919009", "target": null, "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0919007", "target": "#nkr_note_mod_0919007", "type": "mod", "text": "西天譯經三藏朝散大夫試鴻臚少卿傳法大師臣【大】，三藏法師【宋】【元】，宋西天譯經三藏朝散大夫試鴻臚少卿傳法大師臣【明】"}
{"id": null, "n": "0919008", "target": "#nkr_note_mod_0919008", "type": "mod", "text": "譯經【大】，〔－〕【明】"}
{"id": null, "n": "0919009", "target": "#nkr_note_mod_0919009", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0920001", "target": "#nkr_note_mod_0920001", "type": "mod", "text": "羅【大】，囉【明】"}
{"id": null, "n": "0920002", "target": "#nkr_note_mod_0920002", "type": "mod", "text": "入【大】，引【明】"}
{"id": null, "n": "0920003", "target": "#nkr_note_mod_0920003", "type": "mod", "text": "娑【大】，婆【明】"}
{"id": null, "n": "0920004", "target": "#nkr_note_mod_0920004", "type": "mod", "text": "賀【大】，賀引【明】"}
{"id": null, "n": "0920005", "target": "#nkr_note_mod_0920005", "type": "mod", "text": "句【大】，句曰【宋】【元】"}
{"id": null, "n": "0920006", "target": "#nkr_note_mod_0920006", "type": "mod", "text": "囉【大】，羅【宋】【元】【明】"}
{"id": null, "n": "0920007", "target": "#nkr_note_mod_0920007", "type": "mod", "text": "羅【大】，〔－〕【明】"}
{"id": null, "n": "0920008", "target": "#nkr_note_mod_0920008", "type": "mod", "text": "印【大】，引【元】【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0920009", "target": "#nkr_note_mod_0920009", "type": "mod", "text": "彌【大】，儞【元】【明】"}
{"id": null, "n": "0919006", "target": "#nkr_note_orig_0919006", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0919007", "target": "#nkr_note_orig_0919007", "type": "orig", "text": "（（西天…臣））二十字＝（（三藏法師））四字【宋】【元】，（宋）＋西【明】"}
{"id": null, "n": "0919008", "target": "#nkr_note_orig_0919008", "type": "orig", "text": "〔譯經〕－【明】"}
{"id": null, "n": "0919009", "target": "#nkr_note_orig_0919009", "type": "orig", "text": "〔臣〕－【明】"}
{"id": null, "n": "0920001", "target": "#nkr_note_orig_0920001", "type": "orig", "text": "羅＝囉【明】"}
{"id": null, "n": "0920002", "target": "#nkr_note_orig_0920002", "type": "orig", "text": "入＝引【明】"}
{"id": null, "n": "0920003", "target": "#nkr_note_orig_0920003", "type": "orig", "text": "娑＝婆【明】"}
{"id": null, "n": "0920004", "target": "#nkr_note_orig_0920004", "type": "orig", "text": "賀＋（引）【明】"}
{"id": null, "n": "0920005", "target": "#nkr_note_orig_0920005", "type": "orig", "text": "句＋（曰）【宋】【元】"}
{"id": null, "n": "0920006", "target": "#nkr_note_orig_0920006", "type": "orig", "text": "囉＝羅【三】"}
{"id": null, "n": "0920007", "target": "#nkr_note_orig_0920007", "type": "orig", "text": "〔羅〕－【明】"}
{"id": null, "n": "0920008", "target": "#nkr_note_orig_0920008", "type": "orig", "text": "印＝引夾註【元】【明】"}
{"id": null, "n": "0920009", "target": "#nkr_note_orig_0920009", "type": "orig", "text": "彌＝儞【元】【明】"}
