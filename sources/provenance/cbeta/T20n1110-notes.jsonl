{"id": null, "n": null, "target": null, "type": null, "text": "三稜＝楞【甲】稜【大】，楞【甲】稜楞成者"}
{"id": null, "n": "0488003", "target": null, "type": "orig", "text": "稜＝楞【甲】"}
{"id": null, "n": "0488003", "target": null, "type": "mod", "text": "稜【大】，楞【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "是大吉祥"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
