{"id": null, "n": "0484003", "target": "#nkr_note_mod_0484003", "type": "mod", "text": "開府儀同三司特進試鴻臚卿肅國公食邑三千戶賜紫贈司空諡大鑒正號大廣智大興善寺三藏沙門不空奉詔譯【大】，唐北天竺三藏沙門大廣智不空奉詔譯【明】【乙】，大興善寺三藏沙門不空奉詔譯【甲】"}
{"id": null, "n": "0484004", "target": "#nkr_note_mod_0484004", "type": "mod", "text": "門【大】，門大廣智【甲】"}
{"id": null, "n": "0484005", "target": "#nkr_note_mod_0484005", "type": "mod", "text": "師【大】，歸【明】【甲】【乙】"}
{"id": null, "n": "0484006", "target": "#nkr_note_mod_0484006", "type": "mod", "text": "今【CB】【金藏乙-CB】【明】【甲】【乙】，令【大】"}
{"id": null, "n": "0484007", "target": "#nkr_note_mod_0484007", "type": "mod", "text": "怪【大】，悋【甲】"}
{"id": null, "n": "0484008", "target": "#nkr_note_mod_0484008", "type": "mod", "text": "除【大】，欲除【明】【甲】【乙】"}
{"id": null, "n": "0484009", "target": "#nkr_note_mod_0484009", "type": "mod", "text": "罪【大】，眾罪【明】【甲】【乙】"}
{"id": null, "n": "0484010", "target": "#nkr_note_mod_0484010", "type": "mod", "text": "陣【大】，陳【甲】"}
{"id": null, "n": "0484011", "target": "#nkr_note_mod_0484011", "type": "mod", "text": "已【大】，以【明】【甲】"}
{"id": null, "n": "0484012", "target": "#nkr_note_mod_0484012", "type": "mod", "text": "說【大】，記【明】【甲】"}
{"id": null, "n": "0485001", "target": "#nkr_note_mod_0485001", "type": "mod", "text": "令不【大】，勿令【考偽-乙】，勿令不【甲】"}
{"id": null, "n": "0485002", "target": "#nkr_note_mod_0485002", "type": "mod", "text": "常無【大】，無常【甲】"}
{"id": null, "n": "0485003", "target": "#nkr_note_mod_0485003", "type": "mod", "text": "難【大】，火【甲】"}
{"id": null, "n": "0485004", "target": "#nkr_note_mod_0485004", "type": "mod", "text": "名【大】，〔－〕【明】"}
{"id": null, "n": "0485005", "target": "#nkr_note_mod_0485005", "type": "mod", "text": "得【大】，有【明】"}
{"id": null, "n": "0485006", "target": "#nkr_note_mod_0485006", "type": "mod", "text": "曰【大】，日【明】"}
{"id": null, "n": "0485007", "target": "#nkr_note_mod_0485007", "type": "mod", "text": "此【大】，〔－〕【甲】"}
{"id": null, "n": "0485008", "target": "#nkr_note_mod_0485008", "type": "mod", "text": "持【大】，〔－〕【明】【乙】"}
{"id": null, "n": "0485009", "target": "#nkr_note_mod_0485009", "type": "mod", "text": "悉皆【大】，皆悉【明】【甲】【乙】"}
{"id": null, "n": "0485010", "target": "#nkr_note_mod_0485010", "type": "mod", "text": "爐【大】＊，鑪【甲】＊"}
{"id": null, "n": "0485011", "target": "#nkr_note_mod_0485011", "type": "mod", "text": "善【大】，若善【甲】"}
{"id": null, "n": "0485012", "target": "#nkr_note_mod_0485012", "type": "mod", "text": "此【大】，以此【甲】"}
{"id": null, "n": "0485013", "target": "#nkr_note_mod_0485013", "type": "mod", "text": "言【大】，〔－〕【甲】"}
{"id": null, "n": "0485014", "target": "#nkr_note_mod_0485014", "type": "mod", "text": "善男【大】，男善【甲】"}
{"id": null, "n": "0485015", "target": "#nkr_note_mod_0485015", "type": "mod", "text": "王【大】，主【甲】"}
{"id": null, "n": "0485016", "target": "#nkr_note_mod_0485016", "type": "mod", "text": "皆捨【大】，〔－〕【明】【甲】"}
{"id": null, "n": "0485017", "target": "#nkr_note_mod_0485017", "type": "mod", "text": "所【大】，〔－〕【甲】"}
{"id": null, "n": "0485018", "target": "#nkr_note_mod_0485018", "type": "mod", "text": "時【大】，〔－〕【明】"}
{"id": null, "n": "0485019", "target": "#nkr_note_mod_0485019", "type": "mod", "text": "迦【大】，〔－〕【甲】"}
{"id": null, "n": "0485020", "target": "#nkr_note_mod_0485020", "type": "mod", "text": "坐【大】，住【甲】"}
{"id": null, "n": "0485021", "target": "#nkr_note_mod_0485021", "type": "mod", "text": "無【大】，有無【甲】"}
{"id": null, "n": "0485022", "target": "#nkr_note_mod_0485022", "type": "mod", "text": "即【大】，既【甲】"}
{"id": null, "n": "0485023", "target": "#nkr_note_mod_0485023", "type": "mod", "text": "謀【大】，謨【明】【乙】"}
{"id": null, "n": "0485024", "target": "#nkr_note_mod_0485024", "type": "mod", "text": "莫【大】＊，謨【明】【乙】＊"}
{"id": null, "n": "0485025", "target": "#nkr_note_mod_0485025", "type": "mod", "text": "合【大】，合引【乙】"}
{"id": null, "n": "0485026", "target": "#nkr_note_mod_0485026", "type": "mod", "text": "引【大】，〔－〕【甲】"}
{"id": null, "n": "0485027", "target": "#nkr_note_mod_0485027", "type": "mod", "text": "跢【大】＊，埵【明】＊"}
{"id": null, "n": "0485028", "target": "#nkr_note_mod_0485028", "type": "mod", "text": "邏【大】，囉【明】【甲】【乙】"}
{"id": null, "n": "0485029", "target": "#nkr_note_mod_0485029", "type": "mod", "text": "纈【大】，頡【明】【乙】"}
{"id": null, "n": "0485030", "target": "#nkr_note_mod_0485030", "type": "mod", "text": "囉【大】，邏【甲】"}
{"id": null, "n": "0485031", "target": "#nkr_note_mod_0485031", "type": "mod", "text": "訖【大】，乞【明】【乙】"}
{"id": null, "n": "0486001", "target": "#nkr_note_mod_0486001", "type": "mod", "text": "二合【大】，二合引【明】【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0486002", "target": "#nkr_note_mod_0486002", "type": "mod", "text": "訶【大】＊，訶引【明】【乙】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0486003", "target": "#nkr_note_mod_0486003", "type": "mod", "text": "夜耶【大】，耶夜【明】【乙】"}
{"id": null, "n": "0486004", "target": "#nkr_note_mod_0486004", "type": "mod", "text": "耶【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0486005", "target": "#nkr_note_mod_0486005", "type": "mod", "text": "引【大】＊，〔－〕【明】【乙】＊"}
{"id": null, "n": "0486006", "target": "#nkr_note_mod_0486006", "type": "mod", "text": "摩【大】，麼【乙】"}
{"id": null, "n": "0486007", "target": "#nkr_note_mod_0486007", "type": "mod", "text": "嚧【大】＊，盧【明】【乙】＊"}
{"id": null, "n": "0486008", "target": "#nkr_note_mod_0486008", "type": "mod", "text": "耶【大】，那【明】【乙】"}
{"id": null, "n": "0486009", "target": "#nkr_note_mod_0486009", "type": "mod", "text": "拏【大】，努【乙】"}
{"id": null, "n": "0486010", "target": "#nkr_note_mod_0486010", "type": "mod", "text": "娑【大】，曼娑【甲】"}
{"id": null, "n": "0486011", "target": "#nkr_note_mod_0486011", "type": "mod", "text": "跛【大】，跋【明】"}
{"id": null, "n": "0486012", "target": "#nkr_note_mod_0486012", "type": "mod", "text": "上【大】，〔－〕【明】【乙】"}
{"id": null, "n": "0486013", "target": "#nkr_note_mod_0486013", "type": "mod", "text": "哆【大】，跢【明】【甲】【乙】"}
{"id": null, "n": "0486014", "target": "#nkr_note_mod_0486014", "type": "mod", "text": "㗌【大】，室【明】【乙】"}
{"id": null, "n": "0486015", "target": "#nkr_note_mod_0486015", "type": "mod", "text": "吽【大】，泮【明】【甲】【乙】"}
{"id": null, "n": "0486016", "target": "#nkr_note_mod_0486016", "type": "mod", "text": "訶【大】，訶引【甲】【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0486017", "target": "#nkr_note_mod_0486017", "type": "mod", "text": "麼【大】，摩【明】【乙】"}
{"id": null, "n": "0486018", "target": "#nkr_note_mod_0486018", "type": "mod", "text": "（娑嚩…引）七字【大】，莎訶【明】【乙】"}
{"id": null, "n": "0486019", "target": "#nkr_note_mod_0486019", "type": "mod", "text": "從【大】，〔－〕【明】"}
{"id": null, "n": "0486020", "target": "#nkr_note_mod_0486020", "type": "mod", "text": "見【大】，建【明】"}
{"id": null, "n": "0486021", "target": "#nkr_note_mod_0486021", "type": "mod", "text": "便【大】，得【明】【甲】【乙】"}
{"id": null, "n": "0486022", "target": "#nkr_note_mod_0486022", "type": "mod", "text": "梨【大】，梨身【明】【甲】【乙】"}
