{"id": null, "n": null, "target": null, "type": null, "text": "摩竭國"}
{"id": null, "n": null, "target": null, "type": null, "text": "摩尼雲"}
{"id": null, "n": null, "target": null, "type": null, "text": "天神讚詠"}
{"id": null, "n": null, "target": null, "type": null, "text": "普賢"}
{"id": null, "n": null, "target": null, "type": null, "text": "華藏海"}
{"id": null, "n": null, "target": null, "type": null, "text": "文殊現師子頻申三昧，申手摩頂，忽然不現。"}
{"id": null, "n": null, "target": null, "type": null, "text": "文殊樓閤、彌勒樓閣"}
{"id": null, "n": null, "target": null, "type": null, "text": "逝多林、娑羅林"}
{"id": null, "n": null, "target": null, "type": null, "text": "善財南詢"}
{"id": null, "n": null, "target": null, "type": null, "text": "德雲相見"}
{"id": null, "n": null, "target": null, "type": null, "text": "比丘比丘尼"}
{"id": null, "n": null, "target": null, "type": null, "text": "優婆夷"}
{"id": null, "n": null, "target": null, "type": null, "text": "長者、　居士、　童男、　童女。"}
{"id": null, "n": null, "target": null, "type": null, "text": "毗目仙人"}
{"id": null, "n": null, "target": null, "type": null, "text": "勝熱婆羅門，最寂靜婆羅門。"}
{"id": null, "n": null, "target": null, "type": null, "text": "河渚童子，善知眾藝童子。"}
{"id": null, "n": null, "target": null, "type": null, "text": "無厭足王，妙光城王。"}
{"id": null, "n": null, "target": null, "type": null, "text": "遍行外道婆施羅船師"}
{"id": null, "n": null, "target": null, "type": null, "text": "婆須密女，瞿波女。"}
{"id": null, "n": null, "target": null, "type": null, "text": "觀自在菩薩、正趣菩薩"}
{"id": null, "n": null, "target": null, "type": null, "text": "大天神"}
{"id": null, "n": null, "target": null, "type": null, "text": "主地神、主林神"}
{"id": null, "n": null, "target": null, "type": null, "text": "主夜神"}
{"id": null, "n": null, "target": null, "type": null, "text": "摩耶夫人天女"}
