{"id": null, "n": null, "target": null, "type": null, "text": "是日雨霽"}
{"id": null, "n": null, "target": null, "type": null, "text": "光孝寺，又名出水寺，又名廉泉寺。"}
{"id": null, "n": null, "target": null, "type": null, "text": "克勤乃佛果諱也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "梁乃湛堂姓也"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃宜興口號。"}
{"id": null, "n": null, "target": null, "type": null, "text": "前三移，後一改"}
{"id": null, "n": null, "target": null, "type": null, "text": "法名行敕"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱登明"}
{"id": null, "n": null, "target": null, "type": null, "text": "即葉廷尉，諱紹順"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "臘八日見訪贈偈，附來偈，諱懋康"}
{"id": null, "n": null, "target": null, "type": null, "text": "其一"}
{"id": null, "n": null, "target": null, "type": null, "text": "其二"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱旦"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "法名行弘，大心季弟，大心名行毅"}
{"id": null, "n": null, "target": null, "type": null, "text": "三首"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "三首"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首，有引，諱兌金"}
{"id": null, "n": null, "target": null, "type": null, "text": "黃海即黃山也"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首，蔡大夫請"}
{"id": null, "n": null, "target": null, "type": null, "text": "號即中"}
{"id": null, "n": null, "target": null, "type": null, "text": "號本得"}
{"id": null, "n": null, "target": null, "type": null, "text": "號普薰"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱永年，附來偈"}
{"id": null, "n": null, "target": null, "type": null, "text": "時師年三十八"}
{"id": null, "n": null, "target": null, "type": null, "text": "曾割肝救母"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱繼登，法名悟第"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱子壯，師至五羊，寓訶林禪堂"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首，塔中供丙堂智藏禪師真身"}
{"id": null, "n": null, "target": null, "type": null, "text": "小心居士請"}
{"id": null, "n": null, "target": null, "type": null, "text": "已下七讚，琉球國蔡大夫請"}
{"id": null, "n": null, "target": null, "type": null, "text": "等箇"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "適有訪不晤"}
{"id": null, "n": null, "target": null, "type": null, "text": "以默禪人請"}
{"id": null, "n": null, "target": null, "type": null, "text": "琉球國蔡大夫請歸國供養"}
{"id": null, "n": null, "target": null, "type": null, "text": "旋聞禪人請"}
{"id": null, "n": null, "target": null, "type": null, "text": "齒髮塔也，身在五乳。時有僧假稱老宿付法，又有僧假師號先至"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱一鐸"}
{"id": null, "n": null, "target": null, "type": null, "text": "有回書付拂一柄"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱遵明，送點心并茶至，書中有點佛心、泉生心等語"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱倩"}
{"id": null, "n": null, "target": null, "type": null, "text": "法名大參"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱逢日"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱亮乾"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱蓋"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱紹煙"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱如寵"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱當泰"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱大成"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱猶龍"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱同卉"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱應遴"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱士珂"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱嘉俊"}
{"id": null, "n": null, "target": null, "type": null, "text": "時師避兵永新高峰。"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
