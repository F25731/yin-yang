{"id": null, "n": "0917003", "target": "#nkr_note_mod_0917003", "type": "mod", "text": "西【大】，宋西【明】"}
{"id": null, "n": "0917004", "target": "#nkr_note_mod_0917004", "type": "mod", "text": "譯經【大】，〔－〕【明】"}
{"id": null, "n": "0917005", "target": "#nkr_note_mod_0917005", "type": "mod", "text": "少【大】，〔－〕【明】"}
{"id": null, "n": "0917006", "target": "#nkr_note_mod_0917006", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0917007", "target": "#nkr_note_mod_0917007", "type": "mod", "text": "曳【大】，㖂【明】"}
{"id": null, "n": "0917008", "target": "#nkr_note_mod_0917008", "type": "mod", "text": "羅【大】＊，囉【宋】【明】＊"}
{"id": null, "n": "0917009", "target": "#nkr_note_mod_0917009", "type": "mod", "text": "𧹞【大】，赦【宋】【明】"}
{"id": null, "n": "0917010", "target": "#nkr_note_mod_0917010", "type": "mod", "text": "合【大】，合引【明】"}
{"id": null, "n": "0917011", "target": "#nkr_note_mod_0917011", "type": "mod", "text": "劍【大】，歛【明】"}
{"id": null, "n": "0917012", "target": "#nkr_note_mod_0917012", "type": "mod", "text": "祖【大】，袒【明】"}
{"id": null, "n": "0917013", "target": "#nkr_note_mod_0917013", "type": "mod", "text": "扇【大】，房【明】"}
{"id": null, "n": "0917014", "target": "#nkr_note_mod_0917014", "type": "mod", "text": "憾【大】，感【明】"}
{"id": null, "n": "0917015", "target": "#nkr_note_mod_0917015", "type": "mod", "text": "里【大】，哩【宋】【明】"}
{"id": null, "n": "0917016", "target": "#nkr_note_mod_0917016", "type": "mod", "text": "唵【大】，左【明】"}
{"id": null, "n": "0918001", "target": "#nkr_note_mod_0918001", "type": "mod", "text": "摩【大】，麻【明】"}
{"id": null, "n": "0918002", "target": "#nkr_note_mod_0918002", "type": "mod", "text": "嚩【大】，囉【明】"}
{"id": null, "n": "0918003", "target": "#nkr_note_mod_0918003", "type": "mod", "text": "檐【大】下同，擔【宋】【明】下同"}
{"id": null, "n": "0918004", "target": "#nkr_note_mod_0918004", "type": "mod", "text": "尼【大】，尾【宋】【明】"}
{"id": null, "n": "0918005", "target": "#nkr_note_mod_0918005", "type": "mod", "text": "囉【大】，維【明】"}
{"id": null, "n": "0918006", "target": "#nkr_note_mod_0918006", "type": "mod", "text": "大【大】，佛說大【明】"}
{"id": null, "n": "0917002", "target": "#nkr_note_orig_0917002", "type": "orig", "text": "【原】麗本，此經增上寺元本缺依麗本與宋本明本對校"}
