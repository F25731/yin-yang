{"id": null, "n": "1102004", "target": "#nkr_note_mod_1102004", "type": "mod", "text": "（元魏…譯）十一字【大】，〔－〕【西】"}
{"id": null, "n": "1102005", "target": "#nkr_note_mod_1102005", "type": "mod", "text": "住【大】，在【宋】【元】【明】【宮】"}
{"id": null, "n": "1102006", "target": "#nkr_note_mod_1102006", "type": "mod", "text": "揚【大】，楊【西】"}
{"id": null, "n": "1102007", "target": "#nkr_note_mod_1102007", "type": "mod", "text": "登【大】，鐙【宋】【元】【明】【宮】"}
{"id": null, "n": "1102008", "target": "#nkr_note_mod_1102008", "type": "mod", "text": "來【大】，是【宋】【元】【明】【宮】"}
{"id": null, "n": "1102009", "target": "#nkr_note_mod_1102009", "type": "mod", "text": "敬法【大】，法故【宮】"}
{"id": null, "n": "1102010", "target": "#nkr_note_mod_1102010", "type": "mod", "text": "惟【大】，唯【西】"}
{"id": null, "n": "1102011", "target": "#nkr_note_mod_1102011", "type": "mod", "text": "和上【大】，和尚【明】"}
{"id": null, "n": "1103001", "target": "#nkr_note_mod_1103001", "type": "mod", "text": "（或言…誨）十四字【大】，〔－〕【西】"}
{"id": null, "n": "1103002", "target": "#nkr_note_mod_1103002", "type": "mod", "text": "以【大】＊，已【宋】【元】【明】【宮】＊"}
{"id": null, "n": "1103003", "target": "#nkr_note_mod_1103003", "type": "mod", "text": "自【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1103004", "target": "#nkr_note_mod_1103004", "type": "mod", "text": "齒【大】，棄【宋】【宮】【西】"}
{"id": null, "n": "1103005", "target": "#nkr_note_mod_1103005", "type": "mod", "text": "壘【大】，疊【元】【明】，蹀【西】"}
{"id": null, "n": "1103006", "target": "#nkr_note_mod_1103006", "type": "mod", "text": "熟熟【大】，熟【宋】【宮】，孰孰【西】"}
{"id": null, "n": "1103007", "target": "#nkr_note_mod_1103007", "type": "mod", "text": "循【大】，修【西】"}
{"id": null, "n": "1103008", "target": "#nkr_note_mod_1103008", "type": "mod", "text": "何【大】，向【明】"}
{"id": null, "n": "1103009", "target": "#nkr_note_mod_1103009", "type": "mod", "text": "洗【大】下同，洒【宮】下同"}
{"id": null, "n": "1103010", "target": "#nkr_note_mod_1103010", "type": "mod", "text": "陀【大】，〔－〕【宋】，多【元】【明】【宮】【西】"}
{"id": null, "n": "1103011", "target": "#nkr_note_mod_1103011", "type": "mod", "text": "㖒【大】，洟【宋】【元】【明】【宮】"}
{"id": null, "n": "1103012", "target": "#nkr_note_mod_1103012", "type": "mod", "text": "扇【大】，床【西】"}
{"id": null, "n": "1103013", "target": "#nkr_note_mod_1103013", "type": "mod", "text": "煖【大】，暖【宋】【元】【明】【宮】"}
{"id": null, "n": "1103014", "target": "#nkr_note_mod_1103014", "type": "mod", "text": "干【大】，于【西】"}
{"id": null, "n": "1103015", "target": "#nkr_note_mod_1103015", "type": "mod", "text": "字【大】，守【西】"}
{"id": null, "n": "1103016", "target": "#nkr_note_mod_1103016", "type": "mod", "text": "告【大】，語【西】"}
{"id": null, "n": "1103017", "target": "#nkr_note_mod_1103017", "type": "mod", "text": "淨【大】，靜【西】"}
{"id": null, "n": "1104001", "target": "#nkr_note_mod_1104001", "type": "mod", "text": "持【大】，時【元】"}
{"id": null, "n": "1102004", "target": "#nkr_note_orig_1102004", "type": "orig", "text": "〔元魏…譯〕十一字－【西】"}
{"id": null, "n": "1102005", "target": "#nkr_note_orig_1102005", "type": "orig", "text": "住＝在【三】【宮】"}
{"id": null, "n": "1102006", "target": "#nkr_note_orig_1102006", "type": "orig", "text": "揚＝楊【西】"}
{"id": null, "n": "1102007", "target": "#nkr_note_orig_1102007", "type": "orig", "text": "登＝鐙【三】【宮】"}
{"id": null, "n": "1102008", "target": "#nkr_note_orig_1102008", "type": "orig", "text": "來＝是【三】【宮】"}
{"id": null, "n": "1102009", "target": "#nkr_note_orig_1102009", "type": "orig", "text": "敬法＝法故【宮】"}
{"id": null, "n": "1102010", "target": "#nkr_note_orig_1102010", "type": "orig", "text": "惟＝唯【西】"}
{"id": null, "n": "1102011", "target": "#nkr_note_orig_1102011", "type": "orig", "text": "和上＝和尚【明】"}
{"id": null, "n": "1103001", "target": "#nkr_note_orig_1103001", "type": "orig", "text": "〔或言…誨〕十四字－【西】"}
{"id": null, "n": "1103002", "target": "#nkr_note_orig_1103002", "type": "orig", "text": "以＝已【三】【宮】＊"}
{"id": null, "n": "1103003", "target": "#nkr_note_orig_1103003", "type": "orig", "text": "〔自〕－【三】【宮】"}
{"id": null, "n": "1103004", "target": "#nkr_note_orig_1103004", "type": "orig", "text": "齒＝棄【宋】【宮】【西】"}
{"id": null, "n": "1103005", "target": "#nkr_note_orig_1103005", "type": "orig", "text": "壘＝疊【元】【明】，蹀【西】"}
{"id": null, "n": "1103006", "target": "#nkr_note_orig_1103006", "type": "orig", "text": "熟熟＝熟【宋】【宮】，孰孰【西】"}
{"id": null, "n": "1103007", "target": "#nkr_note_orig_1103007", "type": "orig", "text": "循＝修【西】"}
{"id": null, "n": "1103008", "target": "#nkr_note_orig_1103008", "type": "orig", "text": "何＝向【明】"}
{"id": null, "n": "1103009", "target": "#nkr_note_orig_1103009", "type": "orig", "text": "洗＝洒【宮】下同"}
{"id": null, "n": "1103010", "target": "#nkr_note_orig_1103010", "type": "orig", "text": "〔陀〕－【宋】，陀＝多【元】【明】【宮】【西】"}
{"id": null, "n": "1103011", "target": "#nkr_note_orig_1103011", "type": "orig", "text": "㖒＝洟【三】【宮】"}
{"id": null, "n": "1103012", "target": "#nkr_note_orig_1103012", "type": "orig", "text": "扇＝床【西】"}
{"id": null, "n": "1103013", "target": "#nkr_note_orig_1103013", "type": "orig", "text": "煖＝暖【三】【宮】"}
{"id": null, "n": "1103014", "target": "#nkr_note_orig_1103014", "type": "orig", "text": "干＝于【西】"}
{"id": null, "n": "1103015", "target": "#nkr_note_orig_1103015", "type": "orig", "text": "字＝守【西】"}
{"id": null, "n": "1103016", "target": "#nkr_note_orig_1103016", "type": "orig", "text": "告＝語【西】"}
{"id": null, "n": "1103017", "target": "#nkr_note_orig_1103017", "type": "orig", "text": "淨＝靜【西】"}
{"id": null, "n": "1104001", "target": "#nkr_note_orig_1104001", "type": "orig", "text": "持＝時【元】"}
{"id": null, "n": "1104002", "target": "#nkr_note_orig_1104002", "type": "orig", "text": "此次西福寺本有後魏正光六年至元象二年三藏佛陀扇多於洛陽白馬寺及鄴金花寺譯出費長房錄三十四字"}
