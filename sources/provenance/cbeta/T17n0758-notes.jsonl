{"id": null, "n": "0600002", "target": "#nkr_note_mod_0600002", "type": "mod", "text": "西天中印度摩伽陀國那爛陀寺【大】，〔－〕【宋】【元】【宮】，宋西天中印度摩伽陀國那爛陀寺【明】"}
{"id": null, "n": "0600003", "target": "#nkr_note_mod_0600003", "type": "mod", "text": "那爛陀寺【大】，〔－〕【明】"}
{"id": null, "n": "0600004", "target": "#nkr_note_mod_0600004", "type": "mod", "text": "沙門【大】，〔－〕【明】"}
{"id": null, "n": "0600005", "target": "#nkr_note_mod_0600005", "type": "mod", "text": "臣【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0600006", "target": "#nkr_note_mod_0600006", "type": "mod", "text": "靜【大】，淨【宋】【元】【明】【宮】"}
{"id": null, "n": "0600007", "target": "#nkr_note_mod_0600007", "type": "mod", "text": "坏【大】，不【宋】"}
