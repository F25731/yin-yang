{"id": null, "n": null, "target": null, "type": null, "text": "嵩嶽閑居，唐永淳。"}
{"id": null, "n": null, "target": null, "type": null, "text": "京師安國，唐開元。"}
{"id": null, "n": null, "target": null, "type": null, "text": "洛京荷澤，唐開元。"}
{"id": null, "n": null, "target": null, "type": null, "text": "京兆鎮國，唐永泰。"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐大曆"}
{"id": null, "n": null, "target": null, "type": null, "text": "圭峰，唐會昌。"}
{"id": null, "n": null, "target": null, "type": null, "text": "汾州開元，唐長慶。"}
{"id": null, "n": null, "target": null, "type": null, "text": "鼎州德山，唐咸通。"}
{"id": null, "n": null, "target": null, "type": null, "text": "趙州，唐乾寧。"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐光啟△機用爍今古贊。寧列之苦行，冤哉！"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐乾和△係雲門鼻祖，贊寧不收傳內，惜哉！"}
{"id": null, "n": null, "target": null, "type": null, "text": "居士唐"}
{"id": null, "n": null, "target": null, "type": null, "text": "豐州洛浦，唐光化。"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲峯，唐大中。"}
{"id": null, "n": null, "target": null, "type": null, "text": "洪州翠巖，宋。"}
{"id": null, "n": null, "target": null, "type": null, "text": "舒州投子，梁乾化"}
{"id": null, "n": null, "target": null, "type": null, "text": "黃龍，宋熙寧。"}
{"id": null, "n": null, "target": null, "type": null, "text": "臨安徑山南，宋紹興。"}
{"id": null, "n": null, "target": null, "type": null, "text": "安吉何山，南宋紹興。"}
{"id": null, "n": null, "target": null, "type": null, "text": "靈隱，南宋淳熙。"}
{"id": null, "n": null, "target": null, "type": null, "text": "建康華藏，南宋。"}
{"id": null, "n": null, "target": null, "type": null, "text": "臨安徑山，宋淳熙。"}
{"id": null, "n": null, "target": null, "type": null, "text": "泉州教忠，南宋。"}
{"id": null, "n": null, "target": null, "type": null, "text": "建康府，南宋"}
{"id": null, "n": null, "target": null, "type": null, "text": "臨安靈隱，南宋淳熙。"}
{"id": null, "n": null, "target": null, "type": null, "text": "天台薦福，元天曆。"}
{"id": null, "n": null, "target": null, "type": null, "text": "天台慈雲明。"}
{"id": null, "n": null, "target": null, "type": null, "text": "海鹽天寧，明。"}
{"id": null, "n": null, "target": null, "type": null, "text": "海鹽資聖名法聚，明。"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲棲名袾宏，明。"}
{"id": null, "n": null, "target": null, "type": null, "text": "寧波天童，明。"}
{"id": null, "n": null, "target": null, "type": null, "text": "明"}
{"id": null, "n": null, "target": null, "type": null, "text": "徑山，明、清。"}
{"id": null, "n": null, "target": null, "type": null, "text": "大法無間，幽顯可通，知來遡徃，振聵驚聾。一番寒徹骨，徧界是香風，佛法相見，也誰之功？"}
{"id": null, "n": null, "target": null, "type": null, "text": "鄴中竺，晉咸和。"}
{"id": null, "n": null, "target": null, "type": null, "text": "天竺，晉建元。"}
{"id": null, "n": null, "target": null, "type": null, "text": "京師追遠，周太和。"}
