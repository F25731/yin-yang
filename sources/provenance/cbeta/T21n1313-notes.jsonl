{"id": null, "n": "0464002", "target": "#nkr_note_mod_0464002", "type": "mod", "text": "（開府…門）四十一字【大】，大興善寺三藏沙門大廣智【宋】【元】，唐三藏沙門大廣智【明】【甲】"}
{"id": null, "n": "0464003", "target": "#nkr_note_mod_0464003", "type": "mod", "text": "俱【大】，拘【宋】【元】【明】【甲】"}
{"id": null, "n": "0464004", "target": "#nkr_note_mod_0464004", "type": "mod", "text": "蓬【大】＊，髼【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0464005", "target": "#nkr_note_mod_0464005", "type": "mod", "text": "於【大】，此【宋】【元】【明】【甲】"}
{"id": null, "n": "0464006", "target": "#nkr_note_mod_0464006", "type": "mod", "text": "言【大】，曰【宋】【元】【明】【甲】"}
{"id": null, "n": "0464007", "target": "#nkr_note_mod_0464007", "type": "mod", "text": "毛爪【大】，爪牙【宋】【元】【明】【甲】"}
{"id": null, "n": "0464008", "target": "#nkr_note_mod_0464008", "type": "mod", "text": "戰【大】，顫【宋】【元】【明】"}
{"id": null, "n": "0464009", "target": "#nkr_note_mod_0464009", "type": "mod", "text": "授【大】，受【宋】【元】【明】【甲】"}
{"id": null, "n": "0464010", "target": "#nkr_note_mod_0464010", "type": "mod", "text": "殊【大】，〔－〕【甲】"}
{"id": null, "n": "0464011", "target": "#nkr_note_mod_0464011", "type": "mod", "text": "世音【大】，自在【宋】【元】【明】【甲】"}
{"id": null, "n": "0465001", "target": "#nkr_note_mod_0465001", "type": "mod", "text": "那謨【大】，曩莫【宋】【元】【明】【甲】"}
{"id": null, "n": "0465002", "target": "#nkr_note_mod_0465002", "type": "mod", "text": "嚩【大】，嚩無可反下同【元】，嚩無可切下同【明】【甲】"}
{"id": null, "n": "0465003", "target": "#nkr_note_mod_0465003", "type": "mod", "text": "他【大】，他引【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0465004", "target": "#nkr_note_mod_0465004", "type": "mod", "text": "蘖多引【大】，蘖跢引一【宋】【元】，𭒯跢引一【明】"}
{"id": null, "n": "0465005", "target": "#nkr_note_mod_0465005", "type": "mod", "text": "盧【大】，路引【宋】【元】【明】【甲】"}
{"id": null, "n": "0465006", "target": "#nkr_note_mod_0465006", "type": "mod", "text": "帝【大】，帝二【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": "0465007", "target": "#nkr_note_mod_0465007", "type": "mod", "text": "唵參婆囉參婆囉吽【大】，唵引三三去跋羅三拔羅吽引四【宋】【元】，唵引三三去聲跋羅三跋羅吽引四【明】【甲】"}
{"id": null, "n": "0465008", "target": "#nkr_note_mod_0465008", "type": "mod", "text": "飯【大】，飲【宋】【元】【明】【甲】"}
{"id": null, "n": "0465009", "target": "#nkr_note_mod_0465009", "type": "mod", "text": "食【大】，飯【宋】【元】【明】【甲】"}
{"id": null, "n": "0465010", "target": "#nkr_note_mod_0465010", "type": "mod", "text": "加【大】，按【宋】【元】【明】【甲】"}
{"id": null, "n": "0465011", "target": "#nkr_note_mod_0465011", "type": "mod", "text": "曩【大】，南謨多寶如來曩【宋】【元】【明】【甲】"}
{"id": null, "n": "0465012", "target": "#nkr_note_mod_0465012", "type": "mod", "text": "婆【大】＊，婆去【宋】【元】，婆去聲【明】【甲】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "去"}
{"id": null, "n": "0465013", "target": "#nkr_note_mod_0465013", "type": "mod", "text": "帝【大】，帝一【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": "0465014", "target": "#nkr_note_mod_0465014", "type": "mod", "text": "枳孃二合【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0465015", "target": "#nkr_note_mod_0465015", "type": "mod", "text": "多【大】，哆【宋】【元】【明】【甲】"}
{"id": null, "n": "0465016", "target": "#nkr_note_mod_0465016", "type": "mod", "text": "怛【大】，野怛【宋】【元】【明】【甲】"}
{"id": null, "n": "0465017", "target": "#nkr_note_mod_0465017", "type": "mod", "text": "他【大】＊，他引【宋】【元】【明】【甲】＊"}
{"id": null, "n": "0465018", "target": "#nkr_note_mod_0465018", "type": "mod", "text": "多也此云多寶如來【大】，跢引野二【宋】【元】【明】【甲】"}
{"id": null, "n": "0465019", "target": "#nkr_note_mod_0465019", "type": "mod", "text": "業【大】，業罪障消滅【宋】【元】【明】【甲】"}
{"id": null, "n": "0465020", "target": "#nkr_note_mod_0465020", "type": "mod", "text": "那【大】，南謨妙色身如來曩【宋】【元】【明】，曩【甲】"}
{"id": null, "n": "0465021", "target": "#nkr_note_mod_0465021", "type": "mod", "text": "嚩【大】，縛【宋】【元】【明】【甲】"}
{"id": null, "n": "0465022", "target": "#nkr_note_mod_0465022", "type": "mod", "text": "帝【大】＊，帝一【宋】【元】【明】【甲】＊"}
{"id": null, "n": "0465023", "target": "#nkr_note_mod_0465023", "type": "mod", "text": "波引耶【大】，二合播引野【宋】【元】【明】【甲】"}
{"id": null, "n": "0465024", "target": "#nkr_note_mod_0465024", "type": "mod", "text": "哆【大】，跢【宋】【元】【明】【甲】"}
{"id": null, "n": "0465025", "target": "#nkr_note_mod_0465025", "type": "mod", "text": "此云南無妙色身如來【大】，二【宋】【元】【明】【甲】"}
{"id": null, "n": "0465026", "target": "#nkr_note_mod_0465026", "type": "mod", "text": "曩【大】，南謨廣博身如來曩【宋】【元】【明】【甲】"}
{"id": null, "n": "0465027", "target": "#nkr_note_mod_0465027", "type": "mod", "text": "謨【大】，謨引【宋】【元】【明】【甲】"}
{"id": null, "n": "0465028", "target": "#nkr_note_mod_0465028", "type": "mod", "text": "（鉢囉…來）二十五字【大】，補羅誐引怛囉二合引野怛他引孽跢引野二【宋】【元】【明】【甲】"}
{"id": null, "n": "0465029", "target": "#nkr_note_mod_0465029", "type": "mod", "text": "曩【大】，南謨離怖如來曩【宋】【元】【明】【甲】"}
{"id": null, "n": "0465030", "target": "#nkr_note_mod_0465030", "type": "mod", "text": "上【大】，上聲【明】【甲】"}
{"id": null, "n": "0465031", "target": "#nkr_note_mod_0465031", "type": "mod", "text": "去【大】，去聲【明】【甲】"}
{"id": null, "n": "0465032", "target": "#nkr_note_mod_0465032", "type": "mod", "text": "囉也【大】，囉引野【宋】【元】【明】【甲】"}
{"id": null, "n": "0465033", "target": "#nkr_note_mod_0465033", "type": "mod", "text": "他【大】，他去【宋】【元】，他去聲【明】【甲】"}
{"id": null, "n": "0465034", "target": "#nkr_note_mod_0465034", "type": "mod", "text": "多也此云離怖畏如來【大】，哆引野二【宋】【元】【明】【甲】"}
{"id": null, "n": "0465035", "target": "#nkr_note_mod_0465035", "type": "mod", "text": "善男子等既【大】，子等【宋】【元】【明】，子等既【甲】"}
{"id": null, "n": "0465036", "target": "#nkr_note_mod_0465036", "type": "mod", "text": "各【大】，各各【宋】【元】【明】【甲】"}
{"id": null, "n": "0465037", "target": "#nkr_note_mod_0465037", "type": "mod", "text": "鬼等悉【大】，餓鬼悉等【宋】【元】【明】【甲】"}
{"id": null, "n": "0465038", "target": "#nkr_note_mod_0465038", "type": "mod", "text": "密【大】＊，真【宋】【元】【明】【甲】＊"}
{"id": null, "n": "0465039", "target": "#nkr_note_mod_0465039", "type": "mod", "text": "施【大】，施餓【宋】【元】【明】【甲】"}
{"id": null, "n": "0465040", "target": "#nkr_note_mod_0465040", "type": "mod", "text": "仙【大】，諸【元】【明】【甲】"}
{"id": null, "n": "0465041", "target": "#nkr_note_mod_0465041", "type": "mod", "text": "之【大】，飲【宋】【元】【明】【甲】"}
{"id": null, "n": "0465042", "target": "#nkr_note_mod_0465042", "type": "mod", "text": "以密言【大】，以呪【宋】【元】【明】【甲】"}
{"id": null, "n": "0465043", "target": "#nkr_note_mod_0465043", "type": "mod", "text": "是【大】，施【宋】【元】【明】【甲】"}
{"id": null, "n": "0465044", "target": "#nkr_note_mod_0465044", "type": "mod", "text": "令壽【大】，壽命【宋】【元】【明】【甲】"}
{"id": null, "n": "0465045", "target": "#nkr_note_mod_0465045", "type": "mod", "text": "善【大】，及善【宋】【元】【明】【甲】"}
{"id": null, "n": "0465046", "target": "#nkr_note_mod_0465046", "type": "mod", "text": "界【大】，世界【宋】【元】【明】【甲】"}
{"id": null, "n": "0465047", "target": "#nkr_note_mod_0465047", "type": "mod", "text": "救【大】，佛說救【宋】【元】【明】【甲】"}
{"id": null, "n": "0465048", "target": "#nkr_note_mod_0465048", "type": "mod", "text": "拔【大】，〔－〕【宋】【元】"}
{"id": null, "n": "0465049", "target": "#nkr_note_mod_0465049", "type": "mod", "text": "〔－〕【大】，貞享四年中春十九夕一校點之淨嚴四十九歲元祿十六年二月十六日以淨嚴和上之本再校了尊教【甲】"}
{"id": null, "n": "0464001", "target": "#nkr_note_orig_0464001", "type": "orig", "text": "【原】麗本，【甲】黃檗版淨嚴等加筆本"}
