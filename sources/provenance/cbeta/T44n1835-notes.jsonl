{"id": null, "n": "0026003", "target": "#nkr_note_orig_0026003", "type": "orig", "text": "（心）＋見【甲】"}
{"id": null, "n": "0027001", "target": "#nkr_note_orig_0027001", "type": "orig", "text": "〔句〕－【甲】"}
{"id": null, "n": "0028001", "target": "#nkr_note_orig_0028001", "type": "orig", "text": "亦＝然【甲】"}
{"id": null, "n": "0028002", "target": "#nkr_note_orig_0028002", "type": "orig", "text": "餘＝今ヵ【甲】"}
{"id": null, "n": "0029001", "target": "#nkr_note_orig_0029001", "type": "orig", "text": "分＝全【甲】"}
{"id": null, "n": "0030001", "target": "#nkr_note_orig_0030001", "type": "orig", "text": "狹＝挾【甲】"}
{"id": null, "n": "0030002", "target": "#nkr_note_orig_0030002", "type": "orig", "text": "今＝合【甲】"}
{"id": null, "n": "0031001", "target": "#nkr_note_orig_0031001", "type": "orig", "text": "等＝亦ィ【甲】"}
{"id": null, "n": "0032001", "target": "#nkr_note_orig_0032001", "type": "orig", "text": "成＝或【甲】"}
{"id": null, "n": "0034001", "target": "#nkr_note_orig_0034001", "type": "orig", "text": "唯＋（能）【甲】"}
{"id": null, "n": "0034002", "target": "#nkr_note_orig_0034002", "type": "orig", "text": "非＋（有）【甲】"}
{"id": null, "n": "0035001", "target": "#nkr_note_orig_0035001", "type": "orig", "text": "田＝由【甲】"}
{"id": null, "n": "0037001", "target": "#nkr_note_orig_0037001", "type": "orig", "text": "〔高〕－【甲】"}
{"id": null, "n": "0038001", "target": "#nkr_note_orig_0038001", "type": "orig", "text": "假＝倒【甲】"}
{"id": null, "n": "0039001", "target": "#nkr_note_orig_0039001", "type": "orig", "text": "身＝者【甲】"}
{"id": null, "n": "0040001", "target": "#nkr_note_orig_0040001", "type": "orig", "text": "隨＝邊【甲】"}
{"id": null, "n": "0040002", "target": "#nkr_note_orig_0040002", "type": "orig", "text": "〔來無〕－【甲】"}
{"id": null, "n": "0040003", "target": "#nkr_note_orig_0040003", "type": "orig", "text": "道＋（所取能取）【甲】"}
{"id": null, "n": "0043001", "target": "#nkr_note_orig_0043001", "type": "orig", "text": "愚＋（癡）【甲】"}
{"id": null, "n": "0043002", "target": "#nkr_note_orig_0043002", "type": "orig", "text": "〔記〕－【甲】"}
{"id": null, "n": "0044001", "target": "#nkr_note_orig_0044001", "type": "orig", "text": "沙＝娑【甲】"}
{"id": null, "n": "0045001", "target": "#nkr_note_orig_0045001", "type": "orig", "text": "無＝是【甲】"}
{"id": null, "n": "0008a1701", "target": "#nkr_note_add_0008a1701", "type": "add", "text": "互【CB】，樂【大】"}
{"id": null, "n": "0013a2901", "target": "#nkr_note_add_0013a2901", "type": "add", "text": "曰【CB】，日【大】"}
{"id": null, "n": "0014c2801", "target": "#nkr_note_add_0014c2801", "type": "add", "text": "辦【CB】，辯【大】"}
{"id": null, "n": "0025c2401", "target": "#nkr_note_add_0025c2401", "type": "add", "text": "［－］【CB】，述曰有學修治【大】"}
{"id": null, "n": "0025c2501", "target": "#nkr_note_add_0025c2501", "type": "add", "text": "［－］【CB】，體是無漏名無顛倒然所依身猶有煩惱名【大】"}
{"id": null, "n": "0025c2601", "target": "#nkr_note_add_0025c2601", "type": "add", "text": "［－］【CB】，有倒隨隨者逐也為倒逐故隨所修治亦有【大】"}
{"id": null, "n": "0025c2701", "target": "#nkr_note_add_0025c2701", "type": "add", "text": "［－］【CB】，有漏非此所說約總說故【大】"}
{"id": null, "n": "0025c2801", "target": "#nkr_note_add_0025c2801", "type": "add", "text": "［－］【CB】，論曰三無顛倒隨【大】"}
{"id": null, "n": "0039a2001", "target": "#nkr_note_add_0039a2001", "type": "add", "text": "滅【CB】，減【大】"}
{"id": null, "n": "0040b1801", "target": "#nkr_note_add_0040b1801", "type": "add", "text": "滅【CB】，減【大】"}
