{"id": null, "n": "0667016", "target": "#nkr_note_mod_0667016", "type": "mod", "text": "唐三藏沙門大廣智不空奉詔譯【大】，〔－〕【甲】，大興善寺三藏沙門大廣智不空奉詔譯【宋】【元】"}
{"id": null, "n": "0667017", "target": "#nkr_note_mod_0667017", "type": "mod", "text": "事【大】，〔－〕【甲】"}
{"id": null, "n": "0667018", "target": "#nkr_note_mod_0667018", "type": "mod", "text": "惟【大】＊，唯【甲】＊"}
{"id": null, "n": "0668001", "target": "#nkr_note_mod_0668001", "type": "mod", "text": "碼【大】，馬【甲】"}
{"id": null, "n": "0668002", "target": "#nkr_note_mod_0668002", "type": "mod", "text": "故【大】，〔－〕【甲】"}
{"id": null, "n": "0668003", "target": "#nkr_note_mod_0668003", "type": "mod", "text": "利【大】，痢【宋】【元】【甲】"}
{"id": null, "n": "0668004", "target": "#nkr_note_mod_0668004", "type": "mod", "text": "隱【大】，樂【甲】"}
{"id": null, "n": "0668005", "target": "#nkr_note_mod_0668005", "type": "mod", "text": "夜【大】＊，日【甲】＊"}
{"id": null, "n": "0668006", "target": "#nkr_note_mod_0668006", "type": "mod", "text": "受【大】，愛【甲】"}
{"id": null, "n": "0668008", "target": "#nkr_note_mod_0668008", "type": "mod", "text": "聲【大】＊，〔－〕【宋】【元】【甲】＊"}
{"id": null, "n": "0668009", "target": "#nkr_note_mod_0668009", "type": "mod", "text": "切【大】＊，反【宋】【元】【甲】＊"}
{"id": null, "n": "0668010", "target": "#nkr_note_mod_0668010", "type": "mod", "text": "引【大】，〔－〕【甲】"}
{"id": null, "n": "0668011", "target": "#nkr_note_mod_0668011", "type": "mod", "text": "誐【大】，誐㘑【甲】"}
{"id": null, "n": "0668012", "target": "#nkr_note_mod_0668012", "type": "mod", "text": "如【大】，始【宋】【元】【甲】"}
{"id": null, "n": "0668013", "target": "#nkr_note_mod_0668013", "type": "mod", "text": "嚩【大】，嚩日㘑二合引嚩【甲】"}
{"id": null, "n": "0668014", "target": "#nkr_note_mod_0668014", "type": "mod", "text": "磨【大】，麼【宋】【元】【甲】"}
{"id": null, "n": "0668015", "target": "#nkr_note_mod_0668015", "type": "mod", "text": "四十三【大】，〔－〕【甲】"}
{"id": null, "n": "0668016", "target": "#nkr_note_mod_0668016", "type": "mod", "text": "四【大】，三【甲】"}
{"id": null, "n": "0668017", "target": "#nkr_note_mod_0668017", "type": "mod", "text": "僧【大】，達磨薩底也二合麼弩娑麼二合囉四十四僧【甲】"}
{"id": null, "n": "0668018", "target": "#nkr_note_mod_0668018", "type": "mod", "text": "也【大】，野【甲】"}
{"id": null, "n": "0668019", "target": "#nkr_note_mod_0668019", "type": "mod", "text": "引【大】＊，〔－〕【甲】＊"}
{"id": null, "n": "0668020", "target": "#nkr_note_mod_0668020", "type": "mod", "text": "阿【大】，阿引【甲】"}
{"id": null, "n": "0668022", "target": "#nkr_note_mod_0668022", "type": "mod", "text": "銷【大】，消【宋】【元】【甲】"}
{"id": null, "n": "0668023", "target": "#nkr_note_mod_0668023", "type": "mod", "text": "佛【大】，佛以【甲】"}
{"id": null, "n": "0668024", "target": "#nkr_note_mod_0668024", "type": "mod", "text": "往【大】，〔－〕【甲】"}
{"id": null, "n": "0668025", "target": "#nkr_note_mod_0668025", "type": "mod", "text": "之【大】，〔－〕【甲】"}
{"id": null, "n": "0668026", "target": "#nkr_note_mod_0668026", "type": "mod", "text": "難【大】，難陀【甲】"}
{"id": null, "n": "0668027", "target": "#nkr_note_mod_0668027", "type": "mod", "text": "況【大】，況得【甲】"}
{"id": null, "n": "0668028", "target": "#nkr_note_mod_0668028", "type": "mod", "text": "然【大】，爾【甲】"}
{"id": null, "n": "0669001", "target": "#nkr_note_mod_0669001", "type": "mod", "text": "阿【大】，〔－〕【宋】【元】"}
{"id": null, "n": "0669002", "target": "#nkr_note_mod_0669002", "type": "mod", "text": "陀【大】，〔－〕【甲】"}
{"id": null, "n": "0667015", "target": "#nkr_note_orig_0667015", "type": "orig", "text": "【原】明本，【甲】三十帖策子第十五，題名 Vasudhāra-dhāraṇī. 東京帝國大學所藏梵本 Nos. 261, 272. 梵本與漢譯不合致"}
{"id": null, "n": "0667016", "target": "#nkr_note_orig_0667016", "type": "orig", "text": "唐＝大興善寺【宋】【元】，〔唐三…譯〕十三字－【甲】"}
{"id": null, "n": "0667017", "target": "#nkr_note_orig_0667017", "type": "orig", "text": "〔事〕－【甲】"}
{"id": null, "n": "0667018", "target": "#nkr_note_orig_0667018", "type": "orig", "text": "惟＝唯【甲】＊"}
{"id": null, "n": "0668001", "target": "#nkr_note_orig_0668001", "type": "orig", "text": "碼＝馬【甲】"}
{"id": null, "n": "0668002", "target": "#nkr_note_orig_0668002", "type": "orig", "text": "〔故〕－【甲】"}
{"id": null, "n": "0668003", "target": "#nkr_note_orig_0668003", "type": "orig", "text": "利＝痢【宋】【元】【甲】"}
{"id": null, "n": "0668004", "target": "#nkr_note_orig_0668004", "type": "orig", "text": "隱＝樂【甲】"}
{"id": null, "n": "0668005", "target": "#nkr_note_orig_0668005", "type": "orig", "text": "夜＝日【甲】＊"}
{"id": null, "n": "0668006", "target": "#nkr_note_orig_0668006", "type": "orig", "text": "受＝愛【甲】"}
{"id": null, "n": "0668007", "target": "#nkr_note_orig_0668007", "type": "orig", "text": "真言附卷末 cf. P. 669 [04][05]"}
{"id": null, "n": "0668008", "target": "#nkr_note_orig_0668008", "type": "orig", "text": "〔聲〕－【宋】【元】【甲】＊"}
{"id": null, "n": "0668009", "target": "#nkr_note_orig_0668009", "type": "orig", "text": "切＝反【宋】【元】【甲】＊"}
{"id": null, "n": "0668010", "target": "#nkr_note_orig_0668010", "type": "orig", "text": "〔引〕－【甲】"}
{"id": null, "n": "0668011", "target": "#nkr_note_orig_0668011", "type": "orig", "text": "誐＋（㘑）【甲】"}
{"id": null, "n": "0668012", "target": "#nkr_note_orig_0668012", "type": "orig", "text": "如＝始【宋】【元】【甲】"}
{"id": null, "n": "0668013", "target": "#nkr_note_orig_0668013", "type": "orig", "text": "（嚩日㘑二合引）＋嚩【甲】"}
{"id": null, "n": "0668014", "target": "#nkr_note_orig_0668014", "type": "orig", "text": "磨＝麼【宋】【元】【甲】"}
{"id": null, "n": "0668015", "target": "#nkr_note_orig_0668015", "type": "orig", "text": "〔四十三〕－【甲】"}
{"id": null, "n": "0668016", "target": "#nkr_note_orig_0668016", "type": "orig", "text": "四＝三【甲】"}
{"id": null, "n": "0668017", "target": "#nkr_note_orig_0668017", "type": "orig", "text": "（達磨薩底也二合麼弩娑麼二合囉四十四）＋僧【甲】"}
{"id": null, "n": "0668018", "target": "#nkr_note_orig_0668018", "type": "orig", "text": "也＝野【甲】"}
{"id": null, "n": "0668019", "target": "#nkr_note_orig_0668019", "type": "orig", "text": "〔引〕－【甲】＊"}
{"id": null, "n": "0668020", "target": "#nkr_note_orig_0668020", "type": "orig", "text": "阿＋（引）【甲】"}
{"id": null, "n": "0668021", "target": "#nkr_note_orig_0668021", "type": "orig", "text": "此下甲本有卷末心真言等呪文 cf. P. 669 註[04]"}
{"id": null, "n": "0668022", "target": "#nkr_note_orig_0668022", "type": "orig", "text": "銷＝消【宋】【元】【甲】"}
{"id": null, "n": "0668023", "target": "#nkr_note_orig_0668023", "type": "orig", "text": "佛＋（以）【甲】"}
{"id": null, "n": "0668024", "target": "#nkr_note_orig_0668024", "type": "orig", "text": "〔往〕－【甲】"}
