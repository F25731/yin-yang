{"id": null, "n": "0330001", "target": "#nkr_note_orig_0330001", "type": "orig", "text": "「金」，底本作「今」，據文意改。"}
{"id": null, "n": "0330002", "target": "#nkr_note_orig_0330002", "type": "orig", "text": "「肝」，底本無，據文意補。"}
{"id": null, "n": "0330003", "target": "#nkr_note_orig_0330003", "type": "orig", "text": "「裹」，底本作「果」，據文意改。"}
{"id": null, "n": "0330004", "target": "#nkr_note_orig_0330004", "type": "orig", "text": "「忙」，底本作「芒」，據文意改。"}
{"id": null, "n": "0330005", "target": "#nkr_note_orig_0330005", "type": "orig", "text": "此字不清，從字形看，似為「索」。下同。"}
{"id": null, "n": "0330006", "target": "#nkr_note_orig_0330006", "type": "orig", "text": "「王」，底本作「主」，據文意改。"}
{"id": null, "n": "0331001", "target": "#nkr_note_orig_0331001", "type": "orig", "text": "「狗」，底本作「苟」，據文意改。下同。"}
{"id": null, "n": "0331002", "target": "#nkr_note_orig_0331002", "type": "orig", "text": "「黃門」，底本無，據文意補。"}
{"id": null, "n": "0331003", "target": "#nkr_note_orig_0331003", "type": "orig", "text": "「暈」，底本作「運」，據文意改。"}
{"id": null, "n": "0331004", "target": "#nkr_note_orig_0331004", "type": "orig", "text": "「瘥」，底本作「差」，據文意改。"}
{"id": null, "n": "0331005", "target": "#nkr_note_orig_0331005", "type": "orig", "text": "「爾」，底本如此，疑有錯衍。"}
{"id": null, "n": "0331006", "target": "#nkr_note_orig_0331006", "type": "orig", "text": "「德」，底本作「得」，據文意改。"}
{"id": null, "n": "0332001", "target": "#nkr_note_orig_0332001", "type": "orig", "text": "「留一腳跡」，底本無，據文意補。"}
{"id": null, "n": "0332002", "target": "#nkr_note_orig_0332002", "type": "orig", "text": "「禮」，底本無，據文意補。"}
{"id": null, "n": "0332003", "target": "#nkr_note_orig_0332003", "type": "orig", "text": "「投」，底本作「頭」，據文意改。"}
{"id": null, "n": "0332004", "target": "#nkr_note_orig_0332004", "type": "orig", "text": "「無」，底本作「無無」，據文意刪。"}
{"id": null, "n": "0332005", "target": "#nkr_note_orig_0332005", "type": "orig", "text": "「中」，底本作「衷」，據文意改。"}
{"id": null, "n": "0333001", "target": "#nkr_note_orig_0333001", "type": "orig", "text": "「已」，底本作「以」，據文意改。"}
{"id": null, "n": "0333002", "target": "#nkr_note_orig_0333002", "type": "orig", "text": "「嫁」，底本作「稼」，據文意改。"}
{"id": null, "n": "0333003", "target": "#nkr_note_orig_0333003", "type": "orig", "text": "「聞」，底本無，據文意補。"}
{"id": null, "n": "0333004", "target": "#nkr_note_orig_0333004", "type": "orig", "text": "「青」，底本作「清」，據文意改。"}
{"id": null, "n": "0333005", "target": "#nkr_note_orig_0333005", "type": "orig", "text": "「旬」，底本作「信」，據文意改。"}
{"id": null, "n": "0334001", "target": "#nkr_note_orig_0334001", "type": "orig", "text": "「撫」，底本作「無」，據文意改。"}
{"id": null, "n": "0334002", "target": "#nkr_note_orig_0334002", "type": "orig", "text": "「拱」，底本作「洪」，據文意改。"}
{"id": null, "n": "0334003", "target": "#nkr_note_orig_0334003", "type": "orig", "text": "「提」，底本無，據文意補。"}
{"id": null, "n": "0334004", "target": "#nkr_note_orig_0334004", "type": "orig", "text": "「夫」，底本無，據文意補。"}
{"id": null, "n": "0334005", "target": "#nkr_note_orig_0334005", "type": "orig", "text": "「翻」，底本作「幡」，據文意改。"}
{"id": null, "n": "0335001", "target": "#nkr_note_orig_0335001", "type": "orig", "text": "「地」，底本作「帝」，據文意改。"}
{"id": null, "n": "0335002", "target": "#nkr_note_orig_0335002", "type": "orig", "text": "「去」，底本無，據文意補。"}
{"id": null, "n": "0335003", "target": "#nkr_note_orig_0335003", "type": "orig", "text": "「痛」，底本作「誦」，據文意改。"}
{"id": null, "n": "0335004", "target": "#nkr_note_orig_0335004", "type": "orig", "text": "「提」，底本無，據文意補。"}
{"id": null, "n": "0335005", "target": "#nkr_note_orig_0335005", "type": "orig", "text": "「如」，疑衍。"}
{"id": null, "n": "0335006", "target": "#nkr_note_orig_0335006", "type": "orig", "text": "「廂」，底本作「相」，據文意改。下同。"}
{"id": null, "n": "0336001", "target": "#nkr_note_orig_0336001", "type": "orig", "text": "「何」，底本無，據文意補。"}
{"id": null, "n": "0336002", "target": "#nkr_note_orig_0336002", "type": "orig", "text": "「頭」，底本此字不清，疑當作「頭」。"}
{"id": null, "n": "0336003", "target": "#nkr_note_orig_0336003", "type": "orig", "text": "「川」，底本此字不清，疑當作「川」。"}
{"id": null, "n": "0336004", "target": "#nkr_note_orig_0336004", "type": "orig", "text": "「已」，底本作「以」，據文意改。"}
{"id": null, "n": "0336005", "target": "#nkr_note_orig_0336005", "type": "orig", "text": "「鋒」，底本作「峰」，據文意改。"}
{"id": null, "n": "0336006", "target": "#nkr_note_orig_0336006", "type": "orig", "text": "「干」，底本作「忏」，據文意改。"}
{"id": null, "n": "0337001", "target": "#nkr_note_orig_0337001", "type": "orig", "text": "「輸」，底本作「舒」，據文意改。"}
{"id": null, "n": "0337002", "target": "#nkr_note_orig_0337002", "type": "orig", "text": "「調」，底本作「朝」，疑為「調」之誤。"}
