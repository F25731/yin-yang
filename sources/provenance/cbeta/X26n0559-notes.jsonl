{"id": null, "n": null, "target": null, "type": null, "text": "八門"}
{"id": null, "n": null, "target": null, "type": null, "text": "經云行深般若"}
{"id": null, "n": null, "target": null, "type": null, "text": "經云\n照五蘊空度一切苦"}
{"id": null, "n": null, "target": null, "type": null, "text": "文云色不異空空即是色，離四句絕\n百非也"}
{"id": null, "n": null, "target": null, "type": null, "text": "生滅垢淨增減俱無，纖塵不立也"}
{"id": null, "n": null, "target": null, "type": null, "text": "蘊處界世間法，諦緣智出世法，盡如幻影空無實也"}
{"id": null, "n": null, "target": null, "type": null, "text": "文云諸法空相、空中無色等"}
{"id": null, "n": null, "target": null, "type": null, "text": "心無罣礙，恐怖夢想業報惑障悉除，安住涅槃三德"}
{"id": null, "n": null, "target": null, "type": null, "text": "自覺\n離心異凡夫，覺他離色異二乘，圓覺識境二俱離異菩薩也"}
{"id": null, "n": null, "target": null, "type": null, "text": "前顯了經，後祕密呪，二皆融通無礙"}
{"id": null, "n": null, "target": null, "type": null, "text": "經義解理發慧，\n呪語離障生福，福慧二嚴定智兩足果，位功德圓滿究竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "非律論故"}
{"id": null, "n": null, "target": null, "type": null, "text": "長行、重頌、授記、孤起、自說、因緣、譬喻、本事、本生、方廣，未有論義"}
{"id": null, "n": null, "target": null, "type": null, "text": "先、轉、還"}
{"id": null, "n": null, "target": null, "type": null, "text": "初、中、後"}
{"id": null, "n": null, "target": null, "type": null, "text": "華嚴、阿含、深密、妙智、法華"}
{"id": null, "n": null, "target": null, "type": null, "text": "差別、起末、歸本、無礙、不定、顯密、頓演、寂寞、該通、無盡"}
{"id": null, "n": null, "target": null, "type": null, "text": "我"}
{"id": null, "n": null, "target": null, "type": null, "text": "法"}
{"id": null, "n": null, "target": null, "type": null, "text": "俱"}
{"id": null, "n": null, "target": null, "type": null, "text": "正定、邪定、不定"}
{"id": null, "n": null, "target": null, "type": null, "text": "告舍利子"}
{"id": null, "n": null, "target": null, "type": null, "text": "空即\n色等"}
{"id": null, "n": null, "target": null, "type": null, "text": "色不異空及不生不滅等"}
{"id": null, "n": null, "target": null, "type": null, "text": "人、天、聲聞、緣覺、菩薩"}
{"id": null, "n": null, "target": null, "type": null, "text": "聲聞、緣覺、如來、\n不定、無性"}
{"id": null, "n": null, "target": null, "type": null, "text": "法月"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "同諸經序分"}
{"id": null, "n": null, "target": null, "type": null, "text": "六和"}
{"id": null, "n": null, "target": null, "type": null, "text": "一精"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "四"}
{"id": null, "n": null, "target": null, "type": null, "text": "五"}
{"id": null, "n": null, "target": null, "type": null, "text": "《楞嚴》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《菩薩善戒》"}
{"id": null, "n": null, "target": null, "type": null, "text": "大三災、小三災"}
{"id": null, "n": null, "target": null, "type": null, "text": "《楞嚴》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《華嚴》"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "初句約相，三句約性。"}
{"id": null, "n": null, "target": null, "type": null, "text": "二句\n通問，四句通性，問隔以釋。"}
{"id": null, "n": null, "target": null, "type": null, "text": "順次解釋"}
{"id": null, "n": null, "target": null, "type": null, "text": "人天小乘，明生滅法，\n\n作析空觀，故說不異。"}
{"id": null, "n": null, "target": null, "type": null, "text": "空相大乘，了法無生，作體空觀，故說即是。"}
{"id": null, "n": null, "target": null, "type": null, "text": "色不異空。"}
{"id": null, "n": null, "target": null, "type": null, "text": "空不異色。"}
{"id": null, "n": null, "target": null, "type": null, "text": "色即\n是空。"}
{"id": null, "n": null, "target": null, "type": null, "text": "空即是色。"}
{"id": null, "n": null, "target": null, "type": null, "text": "出法界觀"}
{"id": null, "n": null, "target": null, "type": null, "text": "出《纓絡經》"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦非常相異相，及計色大我小我在色中，\n乃至非我相自性等，色不異空故"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦非斷相一相，及計我大色小色在我中，乃至\n非人相他性等，空不異色故"}
{"id": null, "n": null, "target": null, "type": null, "text": "三句非雙存，亦非即蘊是我，乃至非\n眾生相共性等，色即是空故"}
{"id": null, "n": null, "target": null, "type": null, "text": "四句非並泯，亦非離蘊是我，乃至非\n壽者相無因性等，空即是色故"}
{"id": null, "n": null, "target": null, "type": null, "text": "有無存泯句也，四相四性俱攝在內"}
{"id": null, "n": null, "target": null, "type": null, "text": "色不異空，色即是空"}
{"id": null, "n": null, "target": null, "type": null, "text": "空不異色，空即是色"}
{"id": null, "n": null, "target": null, "type": null, "text": "《唯識》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《楞嚴》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《楞伽》"}
{"id": null, "n": null, "target": null, "type": null, "text": "《梵網》"}
