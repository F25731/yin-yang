{"id": null, "n": "0662002", "target": "#nkr_note_mod_0662002", "type": "mod", "text": "卷【大】，〔－〕【聖】【聖乙】"}
{"id": null, "n": "0662003", "target": "#nkr_note_mod_0662003", "type": "mod", "text": "大唐【大】，〔－〕【宋】【元】【宮】【聖】【聖乙】，唐【明】"}
{"id": null, "n": "0662004", "target": "#nkr_note_mod_0662004", "type": "mod", "text": "三藏法師【大】，沙門【聖】"}
