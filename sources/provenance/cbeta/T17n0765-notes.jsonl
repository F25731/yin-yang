{"id": null, "n": "0673006", "target": "#nkr_note_mod_0673006", "type": "mod", "text": "之一【大】，〔－〕【聖乙】"}
{"id": null, "n": "0673007", "target": "#nkr_note_mod_0673007", "type": "mod", "text": "與【大】，於【明】"}
