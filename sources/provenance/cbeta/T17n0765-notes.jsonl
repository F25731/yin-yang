{"id": null, "n": "0662007", "target": "#nkr_note_mod_0662007", "type": "mod", "text": "第一【大】，〔－〕【聖】【聖乙】"}
{"id": null, "n": "0662008", "target": "#nkr_note_mod_0662008", "type": "mod", "text": "之一【大】，〔－〕【宋】【元】【宮】【聖】【聖乙】"}
{"id": null, "n": "0662009", "target": "#nkr_note_mod_0662009", "type": "mod", "text": "途【大】，遠【宮】"}
{"id": null, "n": "0662010", "target": "#nkr_note_mod_0662010", "type": "mod", "text": "刀【大】，力【聖】【聖乙】"}
{"id": null, "n": "0662011", "target": "#nkr_note_mod_0662011", "type": "mod", "text": "縛【大】，結【聖】【聖乙】"}
{"id": null, "n": "0663001", "target": "#nkr_note_mod_0663001", "type": "mod", "text": "行履如是【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "0663002", "target": "#nkr_note_mod_0663002", "type": "mod", "text": "生【大】，生於【聖】【聖乙】"}
{"id": null, "n": "0663003", "target": "#nkr_note_mod_0663003", "type": "mod", "text": "界【大】，〔－〕【聖】【聖乙】"}
{"id": null, "n": "0663004", "target": "#nkr_note_mod_0663004", "type": "mod", "text": "已業【大】，業已【宋】【元】【明】【宮】"}
{"id": null, "n": "0663005", "target": "#nkr_note_mod_0663005", "type": "mod", "text": "業【大】，業因緣既正了知諸業【宋】【元】【明】【宮】"}
{"id": null, "n": "0663006", "target": "#nkr_note_mod_0663006", "type": "mod", "text": "謂【大】，諸【聖】【聖乙】"}
{"id": null, "n": "0663007", "target": "#nkr_note_mod_0663007", "type": "mod", "text": "業異熟【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0663008", "target": "#nkr_note_mod_0663008", "type": "mod", "text": "修【大】，能【宋】【宮】"}
{"id": null, "n": "0664001", "target": "#nkr_note_mod_0664001", "type": "mod", "text": "陵【大】＊，凌【元】【明】＊"}
{"id": null, "n": "0664002", "target": "#nkr_note_mod_0664002", "type": "mod", "text": "反【大】＊，返【宋】【元】【明】【宮】【聖乙】＊"}
{"id": null, "n": "0664003", "target": "#nkr_note_mod_0664003", "type": "mod", "text": "癡【大】，鈍【聖】【聖乙】"}
{"id": null, "n": "0664004", "target": "#nkr_note_mod_0664004", "type": "mod", "text": "墮落【大】，落墮【宋】【宮】，隨落【元】【明】"}
{"id": null, "n": "0664005", "target": "#nkr_note_mod_0664005", "type": "mod", "text": "令【大】，今【聖乙】"}
{"id": null, "n": "0664006", "target": "#nkr_note_mod_0664006", "type": "mod", "text": "柁【CB】【磧乙-CB】【宋】【元】【明】【宮】＊，拕【大】"}
{"id": null, "n": "0665001", "target": "#nkr_note_mod_0665001", "type": "mod", "text": "於【大】，捨【宋】【元】【明】【宮】"}
{"id": null, "n": "0665002", "target": "#nkr_note_mod_0665002", "type": "mod", "text": "吾【大】，（吾從世尊聞如是語苾芻當知若諸有情永斷一法我證彼定得不還果云何一法謂是於欲所以者何一切有情由欲染故數數還來墮諸惡趣受生死苦若能永斷如是一法我證彼定得不還果不復還來生此世間是故我說若諸有情永斷一法我證彼定得不還果爾時世尊重攝此義而說頌曰我觀諸有情，由欲之所染，還來墮惡道，受生死輪迴，若能正了知，永斷此欲者，定得不還果，不來生世間吾）【宋】【元】【明】【宮】"}
{"id": null, "n": "0665003", "target": "#nkr_note_mod_0665003", "type": "mod", "text": "此【大】，世【宋】【元】【明】【宮】"}
{"id": null, "n": "0665004", "target": "#nkr_note_mod_0665004", "type": "mod", "text": "吾【大】，（吾從世尊聞如是語苾芻當知若諸有情永斷一法我證彼定得不還果云何一法謂是於恚所以者何一切有情由恚染故數數還來墮諸惡趣受生死苦若能永斷如是一法我證彼定得不還果不復還來生此世間是故我說若諸有情永斷一法我證彼定得不還果爾時世尊重攝此義而說頌曰我觀諸有情，由恚之所染，還來墮惡趣，受生死輪迴，若能正了知，永斷此恚者，定得不還果，不來生此間吾）【宋】【元】【明】【宮】"}
{"id": null, "n": "0665005", "target": "#nkr_note_mod_0665005", "type": "mod", "text": "此【大】，死【宋】【元】【明】【宮】"}
{"id": null, "n": "0666001", "target": "#nkr_note_mod_0666001", "type": "mod", "text": "耽【大】＊，嗜【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0666002", "target": "#nkr_note_mod_0666002", "type": "mod", "text": "惱及【大】，及惱【宋】【元】【明】【宮】"}
{"id": null, "n": "0666004", "target": "#nkr_note_mod_0666004", "type": "mod", "text": "〔－〕【CB】【麗-CB】【宋】【元】【明】【宮】，故【大】"}
{"id": null, "n": "0667001", "target": "#nkr_note_mod_0667001", "type": "mod", "text": "世【大】＊，〔－〕【宮】＊"}
