{"id": null, "n": "0673011", "target": "#nkr_note_mod_0673011", "type": "mod", "text": "往【大】，生【宋】【元】【宮】【聖】"}
{"id": null, "n": "0674001", "target": "#nkr_note_mod_0674001", "type": "mod", "text": "罪【大】，福【宋】【明】【宮】"}
{"id": null, "n": "0674002", "target": "#nkr_note_mod_0674002", "type": "mod", "text": "擔【大】＊，檐【元】【明】＊"}
{"id": null, "n": "0674003", "target": "#nkr_note_mod_0674003", "type": "mod", "text": "悲【大】，慧【聖】【聖乙】"}
{"id": null, "n": "0674004", "target": "#nkr_note_mod_0674004", "type": "mod", "text": "惱【大】，悔【宋】【宮】"}
