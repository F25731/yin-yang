{"id": null, "n": "0667005", "target": "#nkr_note_mod_0667005", "type": "mod", "text": "惡趣【大】，諸惡【宋】【宮】"}
{"id": null, "n": "0667006", "target": "#nkr_note_mod_0667006", "type": "mod", "text": "念安般【大】，安般故【宋】【元】【宮】"}
{"id": null, "n": "0668002", "target": "#nkr_note_mod_0668002", "type": "mod", "text": "大唐【大】，〔－〕【宋】【元】【宮】【聖】，唐【明】"}
{"id": null, "n": "0668003", "target": "#nkr_note_mod_0668003", "type": "mod", "text": "詔【大】，制【聖】"}
{"id": null, "n": "0668004", "target": "#nkr_note_mod_0668004", "type": "mod", "text": "一法【大】，本事經一法【聖】"}
{"id": null, "n": "0668005", "target": "#nkr_note_mod_0668005", "type": "mod", "text": "彼於【大】，於彼【聖】"}
{"id": null, "n": "0668006", "target": "#nkr_note_mod_0668006", "type": "mod", "text": "偈言【大】，頌曰【宋】【元】【明】【宮】"}
