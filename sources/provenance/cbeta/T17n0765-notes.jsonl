{"id": null, "n": "0669004", "target": "#nkr_note_mod_0669004", "type": "mod", "text": "能【大】，得【明】"}
{"id": null, "n": "0670001", "target": "#nkr_note_mod_0670001", "type": "mod", "text": "實【大】，是【宋】【元】【明】【宮】"}
{"id": null, "n": "0670002", "target": "#nkr_note_mod_0670002", "type": "mod", "text": "柁【CB】【磧乙-CB】【宋】【元】【明】【宮】【聖】，拕【大】"}
