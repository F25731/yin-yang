{"id": null, "n": null, "target": null, "type": null, "text": "一本作圓明密"}
{"id": null, "n": null, "target": null, "type": null, "text": "或作曹山問僧"}
{"id": null, "n": null, "target": null, "type": null, "text": "并附"}
{"id": null, "n": null, "target": null, "type": null, "text": "見帝王門"}
{"id": null, "n": null, "target": null, "type": null, "text": "見水火門"}
{"id": null, "n": null, "target": null, "type": null, "text": "雪竇顯着語云：勘破了也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "竇云：勘破了也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "竇云：雪上加霜。"}
{"id": null, "n": null, "target": null, "type": null, "text": "并附"}
{"id": null, "n": null, "target": null, "type": null, "text": "廣燈小異"}
{"id": null, "n": null, "target": null, "type": null, "text": "或作\n龍雲"}
{"id": null, "n": null, "target": null, "type": null, "text": "廣燈先參\n臨濟"}
{"id": null, "n": null, "target": null, "type": null, "text": "或作夾山，小異"}
{"id": null, "n": null, "target": null, "type": null, "text": "廣燈小異"}
{"id": null, "n": null, "target": null, "type": null, "text": "或作雲居"}
{"id": null, "n": null, "target": null, "type": null, "text": "請續此二句"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本小異"}
{"id": null, "n": null, "target": null, "type": null, "text": "問答悟由，俻見彼章"}
{"id": null, "n": null, "target": null, "type": null, "text": "即睦州也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即洛浦也"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲峰悅云：賊人心虗。"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本小異"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本小異"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本小異"}
{"id": null, "n": null, "target": null, "type": null, "text": "雪竇云：三生六十劫"}
{"id": null, "n": null, "target": null, "type": null, "text": "或作肇法師云"}
{"id": null, "n": null, "target": null, "type": null, "text": "其頌見悟道門"}
{"id": null, "n": null, "target": null, "type": null, "text": "或藥山下鄂州\n百顏語收"}
{"id": null, "n": null, "target": null, "type": null, "text": "莊務附"}
{"id": null, "n": null, "target": null, "type": null, "text": "傳燈作嗣，百丈海呼南泉為師伯，今依之。"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本小異"}
