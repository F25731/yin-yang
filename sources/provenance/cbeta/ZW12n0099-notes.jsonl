{"id": null, "n": "0328002", "target": "#nkr_note_orig_0328002", "type": "orig", "text": "「住」，底本作「柱」，據文意改。"}
{"id": null, "n": "0329001", "target": "#nkr_note_orig_0329001", "type": "orig", "text": "「南無星宿王菩薩……南無天山菩薩」，此段文字參見《大正藏》第14卷第183頁上欄～第183頁中欄。"}
{"id": null, "n": "0329002", "target": "#nkr_note_orig_0329002", "type": "orig", "text": "「南無火身辟支佛……南無違陀辟支佛」，此段文字參見《大正藏》第14卷第145頁下欄。"}
{"id": null, "n": "0331001", "target": "#nkr_note_orig_0331001", "type": "orig", "text": "「策」，底本作「筞」，據文意改。"}
{"id": null, "n": "0332001", "target": "#nkr_note_orig_0332001", "type": "orig", "text": "「經」，底本無，據文意補。"}
{"id": null, "n": "0334001", "target": "#nkr_note_orig_0334001", "type": "orig", "text": "「佛說佛名經卷第十……南無月光自」306字，底本殘，據《大正藏》本補。參見《大正藏》第14卷第147頁上欄～中欄。"}
{"id": null, "n": "0334002", "target": "#nkr_note_orig_0334002", "type": "orig", "text": "「南無無盡法海寶幢佛。南無金剛波頭」15字，底本殘，據《大正藏》本補。參見《大正藏》第14卷第147頁中欄。"}
{"id": null, "n": "0334003", "target": "#nkr_note_orig_0334003", "type": "orig", "text": "「南無廣俱蘇摩作佛。南無人」11字，底本殘，據《大正藏》本補。參見《大正藏》第14卷第147頁中欄。"}
{"id": null, "n": "0334004", "target": "#nkr_note_orig_0334004", "type": "orig", "text": "「南無一切智輪照盧舍那佛。南無龍」14字，底本殘，據《大正藏》本補。參見《大正藏》第14卷第147頁中欄。"}
{"id": null, "n": "0334005", "target": "#nkr_note_orig_0334005", "type": "orig", "text": "「南無寶功德鬘光佛」8字，底本殘，據《大正藏》本補。參見《大正藏》第14卷第147頁中欄。"}
{"id": null, "n": "0334006", "target": "#nkr_note_orig_0334006", "type": "orig", "text": "「六千二百」，《大正藏》本無。參見《大正藏》第14卷第147頁中欄。"}
{"id": null, "n": "0334007", "target": "#nkr_note_orig_0334007", "type": "orig", "text": "「南無寶焰須彌山佛」8字，底本殘，據《大正藏》本補。參見《大正藏》第14卷第147頁中欄。"}
{"id": null, "n": "0334008", "target": "#nkr_note_orig_0334008", "type": "orig", "text": "「南無」，底本殘，據文意補。"}
{"id": null, "n": "0334009", "target": "#nkr_note_orig_0334009", "type": "orig", "text": "「羅蜜海佛」4字，底本殘，據《大正藏》本補。參見《大正藏》第14卷第147頁中欄。"}
{"id": null, "n": "0335001", "target": "#nkr_note_orig_0335001", "type": "orig", "text": "「南無一切通首王佛」，底本作「南無一切通首王佛。南無一切通首王佛」，據《大正藏》本刪。參見《大正藏》第14卷第147頁中欄。"}
{"id": null, "n": "0336001", "target": "#nkr_note_orig_0336001", "type": "orig", "text": "「南無照佛」，《大正藏》本作「南無智佛。南無照佛」，參見《大正藏》第14卷第147頁中欄。"}
{"id": null, "n": "0337001", "target": "#nkr_note_orig_0337001", "type": "orig", "text": "「火」，底本作「大」，據《大正藏》本改。參見《大正藏》第14卷第147頁下欄。"}
{"id": null, "n": "0337002", "target": "#nkr_note_orig_0337002", "type": "orig", "text": "「南無一切寶色莊嚴光明照世界善化法界聲幢佛」，底本為行間加行，極其模糊，據《大正藏》本補。參見《大正藏》第14卷第147頁下欄。"}
{"id": null, "n": "0337003", "target": "#nkr_note_orig_0337003", "type": "orig", "text": "「南無香藏金剛莊嚴光明照世界善化法界聲幢佛」，《大正藏》本無。參見《大正藏》第14卷第147頁下欄。"}
{"id": null, "n": "0337004", "target": "#nkr_note_orig_0337004", "type": "orig", "text": "「南無無量莊嚴間錯世界高智種種華光明佛。南無妙華幢照世界大智敷花光明佛」，《大正藏》本作「南無妙華幢照世界大智敷花光明佛。南無無量莊嚴間錯世界高智種種華光明佛」，參見《大正藏》第14卷第147頁下欄～第148頁上欄。底本「南無妙華幢照世界大智敷花光明佛」為行間加行。"}
{"id": null, "n": "0338001", "target": "#nkr_note_orig_0338001", "type": "orig", "text": "「礙」，底本作「疑」，據《大正藏》本改。參見《大正藏》第14卷第148頁上欄。"}
{"id": null, "n": "0339001", "target": "#nkr_note_orig_0339001", "type": "orig", "text": "「六千三百」，《大正藏》本無。參見《大正藏》第14卷第148頁上欄。"}
{"id": null, "n": "0342001", "target": "#nkr_note_orig_0342001", "type": "orig", "text": "「南無金剛密跡佛……亦悉歸命」，此段文字見《大正藏》第14卷第147頁上欄～第149頁上欄。"}
{"id": null, "n": "0342002", "target": "#nkr_note_orig_0342002", "type": "orig", "text": "「碎金剛佛國土為一日一夜。若袈裟幢世界」，《大正藏》本作「為一日一夜。若袈裟幢世界碎金剛佛國土」，參見《大正藏》第14卷第149頁上欄。"}
{"id": null, "n": "0343001", "target": "#nkr_note_orig_0343001", "type": "orig", "text": "「如來」，《大正藏》本作「如來。南無釋迦牟尼佛。南無阿彌陀佛。南無碎金剛佛。南無善快光明波頭摩敷身佛。南無法幢佛。南無師子佛。南無盧舍那藏佛。南無法光明波頭摩敷身佛。南無一切通光佛。南無月智佛。南無賢勝佛」，參見《大正藏》第14卷第149頁中欄。"}
{"id": null, "n": "0344001", "target": "#nkr_note_orig_0344001", "type": "orig", "text": "「六千四百」，《大正藏》本無。參見《大正藏》第14卷第149頁中欄。"}
{"id": null, "n": "0346001", "target": "#nkr_note_orig_0346001", "type": "orig", "text": "「佛」，底本作「一佛」，據文意刪。"}
{"id": null, "n": "0346002", "target": "#nkr_note_orig_0346002", "type": "orig", "text": "「種種」，《大正藏》本作「種種寶莊嚴王」，參見《大正藏》第14卷第149頁下欄。"}
{"id": null, "n": "0347001", "target": "#nkr_note_orig_0347001", "type": "orig", "text": "「南無不濁身佛。南無一切身智光明月佛」，《大正藏》本作「南無一切身智光明月佛。南無不濁身佛」，參見《大正藏》第14卷第150頁上欄。"}
{"id": null, "n": "0347002", "target": "#nkr_note_orig_0347002", "type": "orig", "text": "「佛」，《大正藏》本作「佛。南無相莊嚴身佛，南無種種光明火月佛」，參見《大正藏》第14卷第150頁上欄。"}
{"id": null, "n": "0347003", "target": "#nkr_note_orig_0347003", "type": "orig", "text": "「六千五百」，《大正藏》本無。參見《大正藏》第14卷第150頁上欄。"}
{"id": null, "n": "0347004", "target": "#nkr_note_orig_0347004", "type": "orig", "text": "「南」，甲本自此始。"}
{"id": null, "n": "0348001", "target": "#nkr_note_orig_0348001", "type": "orig", "text": "「海」，甲本殘，據留存筆跡似作「界」。"}
{"id": null, "n": "0348002", "target": "#nkr_note_orig_0348002", "type": "orig", "text": "「堅」，甲本作「竪」。"}
{"id": null, "n": "0348003", "target": "#nkr_note_orig_0348003", "type": "orig", "text": "「幢」，底本作「憶」，據甲本改。"}
{"id": null, "n": "0348004", "target": "#nkr_note_orig_0348004", "type": "orig", "text": "「長」，甲本作「萇」。"}
{"id": null, "n": "0349001", "target": "#nkr_note_orig_0349001", "type": "orig", "text": "「法」，甲本無。"}
{"id": null, "n": "0349002", "target": "#nkr_note_orig_0349002", "type": "orig", "text": "「法」，甲本作「海」。"}
{"id": null, "n": "0349003", "target": "#nkr_note_orig_0349003", "type": "orig", "text": "「月」，甲本無。"}
{"id": null, "n": "0349004", "target": "#nkr_note_orig_0349004", "type": "orig", "text": "「佛」，甲本無。"}
{"id": null, "n": "0349005", "target": "#nkr_note_orig_0349005", "type": "orig", "text": "「波」，甲本無。"}
{"id": null, "n": "0350001", "target": "#nkr_note_orig_0350001", "type": "orig", "text": "「菩」，甲本作「善」。"}
{"id": null, "n": "0350002", "target": "#nkr_note_orig_0350002", "type": "orig", "text": "「輪」，甲本無。"}
{"id": null, "n": "0351001", "target": "#nkr_note_orig_0351001", "type": "orig", "text": "「南無法日雲𤇺王佛。六千六百。南無法雲稱勝月佛」，《大正藏》本無，參見《大正藏》第14卷第150頁下欄。"}
{"id": null, "n": "0351002", "target": "#nkr_note_orig_0351002", "type": "orig", "text": "「佛」，《大正藏》本作「佛。南無法火炎光明佛」，參見《大正藏》第14卷第150頁下欄。"}
{"id": null, "n": "0352001", "target": "#nkr_note_orig_0352001", "type": "orig", "text": "「南無阿尼羅有眼佛。南無龍自在王佛」，《大正藏》本無。參見《大正藏》第14卷第150頁下欄。"}
{"id": null, "n": "0352002", "target": "#nkr_note_orig_0352002", "type": "orig", "text": "「南無光明輪峰王佛……南無寶稱佛」505字，甲本無。「爾時……南無寶稱佛」，此段文字見《大正藏》第14卷第149頁上欄～第151頁上欄。"}
{"id": null, "n": "0352003", "target": "#nkr_note_orig_0352003", "type": "orig", "text": "「南無」，甲本作「次禮」。"}
{"id": null, "n": "0353001", "target": "#nkr_note_orig_0353001", "type": "orig", "text": "「大」，甲本無。"}
{"id": null, "n": "0353002", "target": "#nkr_note_orig_0353002", "type": "orig", "text": "「問」，甲本作「門」。"}
{"id": null, "n": "0353003", "target": "#nkr_note_orig_0353003", "type": "orig", "text": "「南無」，甲本作「次禮」。"}
{"id": null, "n": "0354001", "target": "#nkr_note_orig_0354001", "type": "orig", "text": "「南無善眼菩薩……南無寂靜心菩薩」145字，甲本作「南無師子奮迅行菩薩。南無不可思□…□。南無善勝菩薩。南無善□…□。南無寶語菩薩。南無愛見菩薩。南無無障礙菩薩。南無斷諸疑菩薩。南無寶作菩薩。南無廣◇菩薩。南無護賢菩薩。南無寶月菩薩」。"}
{"id": null, "n": "0354002", "target": "#nkr_note_orig_0354002", "type": "orig", "text": "「南無」，甲本作「次禮」。"}
{"id": null, "n": "0354003", "target": "#nkr_note_orig_0354003", "type": "orig", "text": "「辟支佛」，甲本作「賢聖」。"}
{"id": null, "n": "0354004", "target": "#nkr_note_orig_0354004", "type": "orig", "text": "「南無心上辟支佛……南無斷有辟支佛」37字，甲本作「南無摩訶男辟支佛。南無善快辟支佛。南無違陀辟支佛。南無□…□。南無髮淨辟支佛」。《大正藏》本作「南無心上辟支佛。南無髮淨辟支佛。南無善快辟支佛。南無違陀辟支佛。南無吉沙辟支佛。南無憂波吉沙辟支佛。南無斷有辟支佛」，參見《大正藏》第14卷第145頁下欄。"}
{"id": null, "n": "0354005", "target": "#nkr_note_orig_0354005", "type": "orig", "text": "「健」，甲本作「建」。"}
{"id": null, "n": "0354006", "target": "#nkr_note_orig_0354006", "type": "orig", "text": "「不」，底本作「在」，據甲本改。"}
{"id": null, "n": "0354007", "target": "#nkr_note_orig_0354007", "type": "orig", "text": "「悔」，甲本作「懺」。"}
{"id": null, "n": "0354008", "target": "#nkr_note_orig_0354008", "type": "orig", "text": "「有」，甲本無。"}
{"id": null, "n": "0354009", "target": "#nkr_note_orig_0354009", "type": "orig", "text": "「白」，甲本作「自」。"}
{"id": null, "n": "0355001", "target": "#nkr_note_orig_0355001", "type": "orig", "text": "「首」，底本作「手」，據甲本改。"}
{"id": null, "n": "0355002", "target": "#nkr_note_orig_0355002", "type": "orig", "text": "「蓋」，底本無，據甲本補。"}
{"id": null, "n": "0355003", "target": "#nkr_note_orig_0355003", "type": "orig", "text": "「佛」，甲本至此止。"}
{"id": null, "n": "0355004", "target": "#nkr_note_orig_0355004", "type": "orig", "text": "「妄」，底本作「忘」，據文意改。"}
{"id": null, "n": "0356001", "target": "#nkr_note_orig_0356001", "type": "orig", "text": "「希」，底本無，據文意補。"}
{"id": null, "n": "0356002", "target": "#nkr_note_orig_0356002", "type": "orig", "text": "「撥」，底本作「發」，據文意改。"}
{"id": null, "n": "0356003", "target": "#nkr_note_orig_0356003", "type": "orig", "text": "「惰」，底本無，據文意補。"}
{"id": null, "n": "0356004", "target": "#nkr_note_orig_0356004", "type": "orig", "text": "「俱」，底本無，據文意補。"}
{"id": null, "n": "0357001", "target": "#nkr_note_orig_0357001", "type": "orig", "text": "「護」，底本作「讓」，據文意改。"}
{"id": null, "n": "0357002", "target": "#nkr_note_orig_0357002", "type": "orig", "text": "「鏘」，底本作「蹌」，據文意改。"}
{"id": null, "n": "0357003", "target": "#nkr_note_orig_0357003", "type": "orig", "text": "「羅」，底本無，據文意補。"}
{"id": null, "n": "0358001", "target": "#nkr_note_orig_0358001", "type": "orig", "text": "「十」，底本至此止。"}
{"id": null, "n": "0357a1801", "target": "#nkr_note_add_0357a1801", "type": "add", "text": "圊【CB】，清【藏外】"}
