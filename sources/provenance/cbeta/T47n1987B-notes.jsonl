{"id": null, "n": "0538009", "target": "#nkr_note_mod_0538009", "type": "mod", "text": "乃點指【大】，其僧過手師點【甲】"}
{"id": null, "n": "0538010", "target": "#nkr_note_mod_0538010", "type": "mod", "text": "問承教有言【大】，僧問教中道【甲】"}
{"id": null, "n": "0538011", "target": "#nkr_note_mod_0538011", "type": "mod", "text": "有【大】，有者【甲】"}
