{"id": null, "n": "0538006", "target": "#nkr_note_mod_0538006", "type": "mod", "text": "痒【大】，痒好【甲】"}
{"id": null, "n": "0538007", "target": "#nkr_note_mod_0538007", "type": "mod", "text": "人問古人曰【大】，僧問【甲】"}
