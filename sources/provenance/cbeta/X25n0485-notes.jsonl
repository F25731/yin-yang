{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "琮"}
{"id": null, "n": "0200j02", "target": "#nkr_note_mod_0200j02", "type": "mod", "text": "第七分已言無法可說此竝其念而冥之"}
{"id": null, "n": "0202j01", "target": "#nkr_note_mod_0202j01", "type": "mod", "text": "第三分已言寔無眾生得滅度此重在作念上"}
{"id": null, "n": "0204001", "target": "#nkr_note_mod_0204001", "type": "mod", "text": "博疑摶（CBETA 按：《嘉興藏》本（J19nB038_p0075c11）作「博」之異體。）"}
{"id": null, "n": "0186j01", "target": "#nkr_note_orig_0186j01", "type": "orig", "text": "是法平等故敘佛衣食了不異人意"}
{"id": null, "n": "0187j01", "target": "#nkr_note_orig_0187j01", "type": "orig", "text": "希有二字看來亦是佛法"}
{"id": null, "n": "0188j01", "target": "#nkr_note_orig_0188j01", "type": "orig", "text": "就菩薩說起直指如是心竝諸生盡歸降伏"}
{"id": null, "n": "0189j01", "target": "#nkr_note_orig_0189j01", "type": "orig", "text": "法施無住是度菩薩先闡如是降伏其心次闡應如是住恐著意降伏便落有住耳"}
{"id": null, "n": "0189j02", "target": "#nkr_note_orig_0189j02", "type": "orig", "text": "身相非相請問如來與何處相見"}
{"id": null, "n": "0189j03", "target": "#nkr_note_orig_0189j03", "type": "orig", "text": "是度眾生"}
{"id": null, "n": "0191j01", "target": "#nkr_note_orig_0191j01", "type": "orig", "text": "是虗設一人菩薩眾生俱在．從福德見法"}
{"id": null, "n": "0191j02", "target": "#nkr_note_orig_0191j02", "type": "orig", "text": "四果皆無念"}
{"id": null, "n": "0192001", "target": "#nkr_note_orig_0192001 #note_star_1", "type": "orig", "text": "取疑所次同"}
{"id": null, "n": "0192j01", "target": "#nkr_note_orig_0192j01", "type": "orig", "text": "從師法說亦如是"}
{"id": null, "n": "0192j02", "target": "#nkr_note_orig_0192j02", "type": "orig", "text": "就眼前河沙比喻．十一分與第八分旨意全同疑此分與十二分原是一分"}
{"id": null, "n": "0193j01", "target": "#nkr_note_orig_0193j01", "type": "orig", "text": "此分總言所以名經持經功夫可以貫串全經自為一部是以語句與前後多重"}
{"id": null, "n": "0193001", "target": "#nkr_note_orig_0193001", "type": "orig", "text": "（旧版、欠字。󴦒）"}
{"id": null, "n": "0194j01", "target": "#nkr_note_orig_0194j01", "type": "orig", "text": "忽聞如是之義又度到後世眾生為說法"}
{"id": null, "n": "0194j02", "target": "#nkr_note_orig_0194j02", "type": "orig", "text": "因說後生故說到前世總此法此佛"}
{"id": null, "n": "0196j01", "target": "#nkr_note_orig_0196j01", "type": "orig", "text": "與十一分意同但諸見比諸相又精"}
{"id": null, "n": "0196001", "target": "#nkr_note_orig_0196001", "type": "orig", "text": "問疑間"}
{"id": null, "n": "0197j01", "target": "#nkr_note_orig_0197j01", "type": "orig", "text": "現在過去未來"}
{"id": null, "n": "0197j02", "target": "#nkr_note_orig_0197j02", "type": "orig", "text": "又提住心降心之要總歸於無我法"}
{"id": null, "n": "0199j01", "target": "#nkr_note_orig_0199j01", "type": "orig", "text": "到佛眼處總是無心"}
{"id": null, "n": "0200j01", "target": "#nkr_note_orig_0200j01", "type": "orig", "text": "與第八分全同此拈出因緣二字"}
{"id": null, "n": "0200j02", "target": "#nkr_note_orig_0200j02", "type": "orig", "text": "第七分巳言無法可說此竝其念而冥之"}
{"id": null, "n": "0201j01", "target": "#nkr_note_orig_0201j01", "type": "orig", "text": "第七分反言之此分正言之"}
{"id": null, "n": "0201j02", "target": "#nkr_note_orig_0201j02", "type": "orig", "text": "與十一分十五分意同彼以河沙此以山勢各喻其顯者"}
{"id": null, "n": "0202j01", "target": "#nkr_note_orig_0202j01", "type": "orig", "text": "第三分巳言寔無眾生得滅度此重在作念上"}
{"id": null, "n": "0202j02", "target": "#nkr_note_orig_0202j02", "type": "orig", "text": "此分最關係"}
{"id": null, "n": "0203j01", "target": "#nkr_note_orig_0203j01", "type": "orig", "text": "提出忍為無我之要"}
{"id": null, "n": "0204001", "target": "#nkr_note_orig_0204001", "type": "orig", "text": "博疑摶"}
{"id": null, "n": "0204j01", "target": "#nkr_note_orig_0204j01", "type": "orig", "text": "演說只此一句盡之"}
