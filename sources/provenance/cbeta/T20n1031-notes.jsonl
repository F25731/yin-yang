{"id": null, "n": "0004022", "target": "#nkr_note_mod_0004022", "type": "mod", "text": "儀軌【大】，軌儀【宋】【元】【明】"}
{"id": null, "n": "0004023", "target": "#nkr_note_mod_0004023", "type": "mod", "text": "成道【大】，〔－〕【甲】"}
{"id": null, "n": "0004024", "target": "#nkr_note_mod_0004024", "type": "mod", "text": "（開府…智）三十三字【大】，〔－〕【宋】【元】【明】，（開府…智）三十三字＝（特進試鴻臚卿）六字【甲】"}
{"id": null, "n": "0004025", "target": "#nkr_note_mod_0004025", "type": "mod", "text": "大興善寺【大】，唐【明】"}
{"id": null, "n": "0004026", "target": "#nkr_note_mod_0004026", "type": "mod", "text": "門【大】，門大廣智【宋】【元】【明】【甲】"}
{"id": null, "n": "0004027", "target": "#nkr_note_mod_0004027", "type": "mod", "text": "於【大】，〔－〕【甲】"}
{"id": null, "n": "0004028", "target": "#nkr_note_mod_0004028", "type": "mod", "text": "跏【大】＊，加【宋】【元】＊"}
{"id": null, "n": "0005001", "target": "#nkr_note_mod_0005001", "type": "mod", "text": "唯【大】＊，惟【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0005002", "target": "#nkr_note_mod_0005002", "type": "mod", "text": "護【大】＊，授【甲】＊"}
{"id": null, "n": "0005003", "target": "#nkr_note_mod_0005003", "type": "mod", "text": "應【大】，〔－〕【甲】"}
{"id": null, "n": "0005004", "target": "#nkr_note_mod_0005004", "type": "mod", "text": "其輪【大】，〔－〕【甲】"}
{"id": null, "n": "0005005", "target": "#nkr_note_mod_0005005", "type": "mod", "text": "上【大】＊，上聲【明】＊"}
{"id": null, "n": "0005006", "target": "#nkr_note_mod_0005006", "type": "mod", "text": "披【大】，被【校異-甲】"}
{"id": null, "n": "0005007", "target": "#nkr_note_mod_0005007", "type": "mod", "text": "去【大】＊，去聲【明】＊"}
{"id": null, "n": "0005008", "target": "#nkr_note_mod_0005008", "type": "mod", "text": "鼻【大】，鼻聲【明】"}
{"id": null, "n": "0005009", "target": "#nkr_note_mod_0005009", "type": "mod", "text": "引【大】＊，〔－〕【甲】＊"}
{"id": null, "n": "0005010", "target": "#nkr_note_mod_0005010", "type": "mod", "text": "拄【大】＊，跓【甲】＊"}
{"id": null, "n": "0005011", "target": "#nkr_note_mod_0005011", "type": "mod", "text": "字【大】，宇【宋】【元】"}
{"id": null, "n": "0005012", "target": "#nkr_note_mod_0005012", "type": "mod", "text": "那【大】，娜【明】"}
{"id": null, "n": "0005013", "target": "#nkr_note_mod_0005013", "type": "mod", "text": "磨【大】，摩【宋】【元】【明】"}
{"id": null, "n": "0005014", "target": "#nkr_note_mod_0005014", "type": "mod", "text": "引去【大】，去引【宋】【元】，去聲引【明】，〔－〕【甲】"}
{"id": null, "n": "0005015", "target": "#nkr_note_mod_0005015", "type": "mod", "text": "拳【大】，拳從頂【甲】"}
{"id": null, "n": "0005016", "target": "#nkr_note_mod_0005016", "type": "mod", "text": "左【大】，右【甲】"}
{"id": null, "n": "0005017", "target": "#nkr_note_mod_0005017", "type": "mod", "text": "祕【大】，㧙【甲】"}
{"id": null, "n": "0005018", "target": "#nkr_note_mod_0005018", "type": "mod", "text": "右【大】，左【甲】"}
{"id": null, "n": "0005019", "target": "#nkr_note_mod_0005019", "type": "mod", "text": "股【大】，鈷【宋】"}
{"id": null, "n": "0005020", "target": "#nkr_note_mod_0005020", "type": "mod", "text": "娜【大】＊，那【甲】＊"}
{"id": null, "n": "0005021", "target": "#nkr_note_mod_0005021", "type": "mod", "text": "引【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0005022", "target": "#nkr_note_mod_0005022", "type": "mod", "text": "散【大】，當散【甲】"}
{"id": null, "n": "0005023", "target": "#nkr_note_mod_0005023", "type": "mod", "text": "跓【大】，拄【宋】【元】【明】"}
{"id": null, "n": "0005024", "target": "#nkr_note_mod_0005024", "type": "mod", "text": "上【大】＊，〔－〕【宋】【元】【明】【甲】＊"}
{"id": null, "n": "0005025", "target": "#nkr_note_mod_0005025", "type": "mod", "text": "即【大】，〔－〕【明】"}
{"id": null, "n": "0005026", "target": "#nkr_note_mod_0005026", "type": "mod", "text": "南【大】，喃引【甲】"}
{"id": null, "n": "0005027", "target": "#nkr_note_mod_0005027", "type": "mod", "text": "二合【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0005028", "target": "#nkr_note_mod_0005028", "type": "mod", "text": "平【大】，平聲【明】，引【甲】"}
{"id": null, "n": "0005029", "target": "#nkr_note_mod_0005029", "type": "mod", "text": "毫【大】，豪【宋】【元】【明】"}
{"id": null, "n": "0005030", "target": "#nkr_note_mod_0005030", "type": "mod", "text": "相【大】，相先【宋】【元】，相光【明】"}
{"id": null, "n": "0005031", "target": "#nkr_note_mod_0005031", "type": "mod", "text": "滿【大】，滿明【甲】"}
{"id": null, "n": "0005032", "target": "#nkr_note_mod_0005032", "type": "mod", "text": "蘊【大】，蘊處界【甲】"}
{"id": null, "n": "0005033", "target": "#nkr_note_mod_0005033", "type": "mod", "text": "性【大】，世【宋】【元】【明】"}
{"id": null, "n": "0006001", "target": "#nkr_note_mod_0006001", "type": "mod", "text": "彼【大】，從【甲】"}
{"id": null, "n": "0006002", "target": "#nkr_note_mod_0006002", "type": "mod", "text": "令【大】，於【明】"}
{"id": null, "n": "0006003", "target": "#nkr_note_mod_0006003", "type": "mod", "text": "除【大】，際【宋】【元】【明】"}
{"id": null, "n": "0006004", "target": "#nkr_note_mod_0006004", "type": "mod", "text": "轉成【大】，得成【宋】【元】，轉【甲】"}
{"id": null, "n": "0006005", "target": "#nkr_note_mod_0006005", "type": "mod", "text": "毘【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0006006", "target": "#nkr_note_mod_0006006", "type": "mod", "text": "住【大】，作住【宋】【元】【明】【甲】"}
{"id": null, "n": "0006007", "target": "#nkr_note_mod_0006007", "type": "mod", "text": "觀【大】，觀一切已【宋】【元】【明】"}
{"id": null, "n": "0006008", "target": "#nkr_note_mod_0006008", "type": "mod", "text": "翹【大】，剋【甲】"}
{"id": null, "n": "0006009", "target": "#nkr_note_mod_0006009", "type": "mod", "text": "二【大】，右【宋】【元】【明】【甲】"}
{"id": null, "n": "0006010", "target": "#nkr_note_mod_0006010", "type": "mod", "text": "誦【大】＊，〔－〕【甲】＊"}
{"id": null, "n": "0006011", "target": "#nkr_note_mod_0006011", "type": "mod", "text": "迦半音呼【大】，半音【甲】"}
{"id": null, "n": "0006012", "target": "#nkr_note_mod_0006012", "type": "mod", "text": "呼【大】，呼方音中含迦字也下同【明】"}
{"id": null, "n": "0006013", "target": "#nkr_note_mod_0006013", "type": "mod", "text": "引【大】，引去聲【宋】【元】，去聲引【明】"}
{"id": null, "n": "0006014", "target": "#nkr_note_mod_0006014", "type": "mod", "text": "還【大】，還來【宋】【元】【明】【甲】"}
{"id": null, "n": "0006015", "target": "#nkr_note_mod_0006015", "type": "mod", "text": "字【大】，字門【甲】"}
{"id": null, "n": "0006016", "target": "#nkr_note_mod_0006016", "type": "mod", "text": "四【大】，句【校異-甲】"}
{"id": null, "n": "0006017", "target": "#nkr_note_mod_0006017", "type": "mod", "text": "念【大】，念誦【甲】"}
{"id": null, "n": "0006018", "target": "#nkr_note_mod_0006018", "type": "mod", "text": "作【大】，加【甲】"}
{"id": null, "n": "0006019", "target": "#nkr_note_mod_0006019", "type": "mod", "text": "力者中含迦字也【大】，〔－〕【明】"}
{"id": null, "n": "0006020", "target": "#nkr_note_mod_0006020", "type": "mod", "text": "者【大】，音【宋】【元】【甲】"}
{"id": null, "n": "0006021", "target": "#nkr_note_mod_0006021", "type": "mod", "text": "異反下同【大】，以切【明】"}
{"id": null, "n": "0006022", "target": "#nkr_note_mod_0006022", "type": "mod", "text": "𡀩【大】，洛【明】【甲】"}
{"id": null, "n": "0006023", "target": "#nkr_note_mod_0006023", "type": "mod", "text": "灑【大】，灑二合【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0006024", "target": "#nkr_note_mod_0006024", "type": "mod", "text": "二【大】，三【宋】【元】【明】"}
{"id": null, "n": "0006025", "target": "#nkr_note_mod_0006025", "type": "mod", "text": "賀【大】，賀引【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0006026", "target": "#nkr_note_mod_0006026", "type": "mod", "text": "嚧力【大】，囉攞【宋】【元】【明】，羅攞【甲】"}
{"id": null, "n": "0006027", "target": "#nkr_note_mod_0006027", "type": "mod", "text": "心真言【大】，〔－〕【甲】"}
{"id": null, "n": "0006028", "target": "#nkr_note_mod_0006028", "type": "mod", "text": "觀行【大】，念誦【甲】"}
{"id": null, "n": "0006029", "target": "#nkr_note_mod_0006029", "type": "mod", "text": "儀軌一卷【大】，軌儀【宋】【元】【明】"}
{"id": null, "n": "0004021", "target": "#nkr_note_orig_0004021", "type": "orig", "text": "【原】麗本，【甲】天永三年寫東寺三密藏本"}
{"id": null, "n": "0004022", "target": "#nkr_note_orig_0004022", "type": "orig", "text": "儀軌＝軌儀【三】"}
{"id": null, "n": "0004023", "target": "#nkr_note_orig_0004023", "type": "orig", "text": "〔成道〕－【甲】"}
{"id": null, "n": "0004024", "target": "#nkr_note_orig_0004024", "type": "orig", "text": "〔開府…智〕三十三字－【三】，（開府…智）三十三字＝（特進試鴻臚卿）六字【甲】"}
{"id": null, "n": "0004025", "target": "#nkr_note_orig_0004025", "type": "orig", "text": "大興善寺＝唐【明】"}
{"id": null, "n": "0004026", "target": "#nkr_note_orig_0004026", "type": "orig", "text": "門＋（大廣智）【三】【甲】"}
{"id": null, "n": "0004027", "target": "#nkr_note_orig_0004027", "type": "orig", "text": "〔於〕－【甲】"}
{"id": null, "n": "0004028", "target": "#nkr_note_orig_0004028", "type": "orig", "text": "跏＝加【宋】【元】＊"}
{"id": null, "n": "0005001", "target": "#nkr_note_orig_0005001", "type": "orig", "text": "唯＝惟【三】＊"}
{"id": null, "n": "0005002", "target": "#nkr_note_orig_0005002", "type": "orig", "text": "護＝授【甲】＊"}
{"id": null, "n": "0005003", "target": "#nkr_note_orig_0005003", "type": "orig", "text": "〔應〕－【甲】"}
{"id": null, "n": "0005004", "target": "#nkr_note_orig_0005004", "type": "orig", "text": "〔其輪〕－【甲】"}
{"id": null, "n": "0005005", "target": "#nkr_note_orig_0005005", "type": "orig", "text": "上＋（聲）【明】＊"}
{"id": null, "n": "0005006", "target": "#nkr_note_orig_0005006", "type": "orig", "text": "披＝被ィ【甲】"}
{"id": null, "n": "0005007", "target": "#nkr_note_orig_0005007", "type": "orig", "text": "去＋（聲）【明】＊"}
{"id": null, "n": "0005008", "target": "#nkr_note_orig_0005008", "type": "orig", "text": "鼻＋（聲）【明】"}
{"id": null, "n": "0005009", "target": "#nkr_note_orig_0005009", "type": "orig", "text": "〔引〕－【甲】＊"}
{"id": null, "n": "0005010", "target": "#nkr_note_orig_0005010", "type": "orig", "text": "拄＝跓【甲】＊"}
{"id": null, "n": "0005011", "target": "#nkr_note_orig_0005011", "type": "orig", "text": "字＝宇【宋】【元】"}
{"id": null, "n": "0005012", "target": "#nkr_note_orig_0005012", "type": "orig", "text": "那＝娜【明】"}
{"id": null, "n": "0005013", "target": "#nkr_note_orig_0005013", "type": "orig", "text": "磨＝摩【三】"}
{"id": null, "n": "0005014", "target": "#nkr_note_orig_0005014", "type": "orig", "text": "引去＝去引【宋】【元】，去聲引【明】，〔引去〕－【甲】"}
{"id": null, "n": "0005015", "target": "#nkr_note_orig_0005015", "type": "orig", "text": "拳＋（從頂）【甲】"}
{"id": null, "n": "0005016", "target": "#nkr_note_orig_0005016", "type": "orig", "text": "左＝右【甲】"}
{"id": null, "n": "0005017", "target": "#nkr_note_orig_0005017", "type": "orig", "text": "祕＝㧙【甲】"}
{"id": null, "n": "0005018", "target": "#nkr_note_orig_0005018", "type": "orig", "text": "右＝左【甲】"}
{"id": null, "n": "0005019", "target": "#nkr_note_orig_0005019", "type": "orig", "text": "股＝鈷【宋】"}
{"id": null, "n": "0005020", "target": "#nkr_note_orig_0005020", "type": "orig", "text": "娜＝那【甲】＊"}
{"id": null, "n": "0005021", "target": "#nkr_note_orig_0005021", "type": "orig", "text": "〔引〕－【三】【甲】"}
{"id": null, "n": "0005022", "target": "#nkr_note_orig_0005022", "type": "orig", "text": "（當）＋散【甲】"}
{"id": null, "n": "0005023", "target": "#nkr_note_orig_0005023", "type": "orig", "text": "跓＝拄【三】"}
{"id": null, "n": "0005024", "target": "#nkr_note_orig_0005024", "type": "orig", "text": "〔上〕－【三】【甲】＊"}
{"id": null, "n": "0005025", "target": "#nkr_note_orig_0005025", "type": "orig", "text": "〔即〕－【明】"}
{"id": null, "n": "0005026", "target": "#nkr_note_orig_0005026", "type": "orig", "text": "南＝喃引【甲】"}
{"id": null, "n": "0005027", "target": "#nkr_note_orig_0005027", "type": "orig", "text": "〔二合〕－【三】"}
{"id": null, "n": "0005028", "target": "#nkr_note_orig_0005028", "type": "orig", "text": "平＋（聲）【明】，平＝引【甲】"}
{"id": null, "n": "0005029", "target": "#nkr_note_orig_0005029", "type": "orig", "text": "毫＝豪【三】"}
{"id": null, "n": "0005030", "target": "#nkr_note_orig_0005030", "type": "orig", "text": "相＋（先）【宋】【元】，（光）【明】"}
{"id": null, "n": "0005031", "target": "#nkr_note_orig_0005031", "type": "orig", "text": "滿＋（明）【甲】"}
{"id": null, "n": "0005032", "target": "#nkr_note_orig_0005032", "type": "orig", "text": "蘊＋（處界）【甲】"}
{"id": null, "n": "0005033", "target": "#nkr_note_orig_0005033", "type": "orig", "text": "性＝世【三】"}
{"id": null, "n": "0006001", "target": "#nkr_note_orig_0006001", "type": "orig", "text": "彼＝從【甲】"}
{"id": null, "n": "0006002", "target": "#nkr_note_orig_0006002", "type": "orig", "text": "令＝於【明】"}
{"id": null, "n": "0006003", "target": "#nkr_note_orig_0006003", "type": "orig", "text": "除＝際【三】"}
{"id": null, "n": "0006004", "target": "#nkr_note_orig_0006004", "type": "orig", "text": "轉成＝得成【宋】【元】，轉【甲】"}
{"id": null, "n": "0006005", "target": "#nkr_note_orig_0006005", "type": "orig", "text": "〔毘〕－【三】"}
{"id": null, "n": "0006006", "target": "#nkr_note_orig_0006006", "type": "orig", "text": "（作）＋住【三】【甲】"}
{"id": null, "n": "0006007", "target": "#nkr_note_orig_0006007", "type": "orig", "text": "觀＋（一切已）【三】"}
{"id": null, "n": "0006008", "target": "#nkr_note_orig_0006008", "type": "orig", "text": "翹＝剋【甲】"}
{"id": null, "n": "0006009", "target": "#nkr_note_orig_0006009", "type": "orig", "text": "二＝右【三】【甲】"}
{"id": null, "n": "0006010", "target": "#nkr_note_orig_0006010", "type": "orig", "text": "〔誦〕－【甲】＊"}
{"id": null, "n": "0006011", "target": "#nkr_note_orig_0006011", "type": "orig", "text": "迦半音呼＝半音【甲】"}
{"id": null, "n": "0006012", "target": "#nkr_note_orig_0006012", "type": "orig", "text": "呼＋（方音中含迦字也下同）【明】"}
{"id": null, "n": "0006013", "target": "#nkr_note_orig_0006013", "type": "orig", "text": "引＝引去聲【宋】【元】，去聲引【明】"}
{"id": null, "n": "0006014", "target": "#nkr_note_orig_0006014", "type": "orig", "text": "還＋（來）【三】【甲】"}
{"id": null, "n": "0006015", "target": "#nkr_note_orig_0006015", "type": "orig", "text": "字＋（門）【甲】"}
{"id": null, "n": "0006016", "target": "#nkr_note_orig_0006016", "type": "orig", "text": "四＝句ィ【甲】"}
{"id": null, "n": "0006017", "target": "#nkr_note_orig_0006017", "type": "orig", "text": "念＋（誦）【甲】"}
{"id": null, "n": "0006018", "target": "#nkr_note_orig_0006018", "type": "orig", "text": "作＝加【甲】"}
{"id": null, "n": "0006019", "target": "#nkr_note_orig_0006019", "type": "orig", "text": "〔力者中含迦字也〕－【明】"}
{"id": null, "n": "0006020", "target": "#nkr_note_orig_0006020", "type": "orig", "text": "者＝音【宋】【元】【甲】"}
{"id": null, "n": "0006021", "target": "#nkr_note_orig_0006021", "type": "orig", "text": "異反下同＝以切【明】"}
{"id": null, "n": "0006022", "target": "#nkr_note_orig_0006022", "type": "orig", "text": "𡀩＝洛【明】【甲】"}
{"id": null, "n": "0006023", "target": "#nkr_note_orig_0006023", "type": "orig", "text": "灑＋（二合）細註【甲】"}
{"id": null, "n": "0006024", "target": "#nkr_note_orig_0006024", "type": "orig", "text": "二＝三【三】"}
{"id": null, "n": "0006025", "target": "#nkr_note_orig_0006025", "type": "orig", "text": "賀＋（引）細註【三】【甲】"}
{"id": null, "n": "0006026", "target": "#nkr_note_orig_0006026", "type": "orig", "text": "嚧力＝囉攞【三】，羅攞【甲】"}
{"id": null, "n": "0006027", "target": "#nkr_note_orig_0006027", "type": "orig", "text": "〔心真言〕－【甲】"}
{"id": null, "n": "0006028", "target": "#nkr_note_orig_0006028", "type": "orig", "text": "觀行＝念誦【甲】"}
{"id": null, "n": "0006029", "target": "#nkr_note_orig_0006029", "type": "orig", "text": "儀軌一卷＝軌儀【三】"}
{"id": null, "n": "0006030", "target": "#nkr_note_orig_0006030", "type": "orig", "text": "甲本奧書曰，天永三年十一月二十五日於冷泉院書點了，求法僧宗觀記之，四年二月三日一交了仁平二年八月十四日於嚴淨院傳受了，求法沙門覺樹，寶曆九年五月下浣加修復了，僧正承照七十六歲"}
