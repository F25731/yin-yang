{"id": null, "n": "0176018", "target": "#nkr_note_mod_0176018", "type": "mod", "text": "西【大】，宋西【明】"}
{"id": null, "n": "0176019", "target": "#nkr_note_mod_0176019", "type": "mod", "text": "譯經【大】，〔－〕【明】"}
{"id": null, "n": "0176020", "target": "#nkr_note_mod_0176020", "type": "mod", "text": "傳【大】，明【宋】【元】"}
{"id": null, "n": "0176021", "target": "#nkr_note_mod_0176021", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0176022", "target": "#nkr_note_mod_0176022", "type": "mod", "text": "譯【大】，鐸【宋】【元】【明】"}
{"id": null, "n": "0176023", "target": "#nkr_note_mod_0176023", "type": "mod", "text": "末【大】，未【明】"}
{"id": null, "n": "0177001", "target": "#nkr_note_mod_0177001", "type": "mod", "text": "囉【大】＊，囉二合【明】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0177002", "target": "#nkr_note_mod_0177002", "type": "mod", "text": "玉【大】，王【明】"}
{"id": null, "n": "0177003", "target": "#nkr_note_mod_0177003", "type": "mod", "text": "羅【大】，囉【宋】【元】【明】"}
{"id": null, "n": "0177004", "target": "#nkr_note_mod_0177004", "type": "mod", "text": "焰摩【大】，琰魔【明】"}
{"id": null, "n": "0177005", "target": "#nkr_note_mod_0177005", "type": "mod", "text": "去【大】，云【元】【明】"}
{"id": null, "n": "0177006", "target": "#nkr_note_mod_0177006", "type": "mod", "text": "室【大】，空【宋】【元】"}
{"id": null, "n": "0177007", "target": "#nkr_note_mod_0177007", "type": "mod", "text": "左【大】，尼【宋】【元】【明】"}
{"id": null, "n": "0177008", "target": "#nkr_note_mod_0177008", "type": "mod", "text": "里【大】，哩【宋】【元】【明】"}
{"id": null, "n": "0177009", "target": "#nkr_note_mod_0177009", "type": "mod", "text": "尼【大】，尾【宋】【元】【明】"}
{"id": null, "n": "0177010", "target": "#nkr_note_mod_0177010", "type": "mod", "text": "路【大】，路二合【宋】【元】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0177011", "target": "#nkr_note_mod_0177011", "type": "mod", "text": "隷【大】，隷二合【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0177012", "target": "#nkr_note_mod_0177012", "type": "mod", "text": "羅【大】＊，囉【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0177013", "target": "#nkr_note_mod_0177013", "type": "mod", "text": "說【大】，〔－〕【宋】【元】【明】"}
