{"id": null, "n": null, "target": null, "type": "cf1", "text": "K11n0249_p0534b03"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "Q11_p0190c16"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K11n0249_p0534c07"}
{"id": null, "n": "0783010", "target": "#nkr_note_mod_0783010", "type": "mod", "text": "佛說【大】＊，〔－〕【宋】【元】【宮】＊"}
{"id": null, "n": "0783011", "target": "#nkr_note_mod_0783011", "type": "mod", "text": "隋【大】，隋北【元】【明】"}
{"id": null, "n": "0783012", "target": "#nkr_note_mod_0783012", "type": "mod", "text": "天竺【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "0783013", "target": "#nkr_note_mod_0783013", "type": "mod", "text": "藏【大】，藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0783014", "target": "#nkr_note_mod_0783014", "type": "mod", "text": "園【大】，國【宋】"}
{"id": null, "n": "0783015", "target": "#nkr_note_mod_0783015", "type": "mod", "text": "詳【大】，庠【宋】【元】【明】【宮】"}
{"id": null, "n": "0783016", "target": "#nkr_note_mod_0783016", "type": "mod", "text": "而【大】，如【宮】"}
{"id": null, "n": "0783017", "target": "#nkr_note_mod_0783017", "type": "mod", "text": "詣【大】，諸【宋】"}
{"id": null, "n": "0783018", "target": "#nkr_note_mod_0783018", "type": "mod", "text": "肩【大】，有【宋】"}
{"id": null, "n": "0783019", "target": "#nkr_note_mod_0783019", "type": "mod", "text": "能善【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "0783020", "target": "#nkr_note_mod_0783020", "type": "mod", "text": "葙【大】，箱【宋】【宮】，廂【元】【明】"}
{"id": null, "n": "0783021", "target": "#nkr_note_mod_0783021", "type": "mod", "text": "狹【大】，陿【宋】【元】【明】【宮】"}
{"id": null, "n": "0784001", "target": "#nkr_note_mod_0784001", "type": "mod", "text": "蘇【大】，酥【宋】【元】【明】【宮】"}
{"id": null, "n": "0784002", "target": "#nkr_note_mod_0784002", "type": "mod", "text": "伎樂【大】下同，妓樂【元】【明】下同"}
{"id": null, "n": "0784003", "target": "#nkr_note_mod_0784003", "type": "mod", "text": "珊【大】，那【宮】"}
{"id": null, "n": "0784004", "target": "#nkr_note_mod_0784004", "type": "mod", "text": "滿【大】，供滿【宋】【元】【明】，佛＋（滿）【宮】"}
{"id": null, "n": "0785001", "target": "#nkr_note_mod_0785001", "type": "mod", "text": "悉【大】，受【宋】【元】"}
{"id": null, "n": "0785002", "target": "#nkr_note_mod_0785002", "type": "mod", "text": "校【大】，格【宋】【元】【明】【宮】"}
{"id": null, "n": "0783010", "target": "#nkr_note_orig_0783010", "type": "orig", "text": "〔佛說〕－【宋】【元】【宮】＊"}
{"id": null, "n": "0783011", "target": "#nkr_note_orig_0783011", "type": "orig", "text": "隋＋（北）【元】【明】"}
{"id": null, "n": "0783012", "target": "#nkr_note_orig_0783012", "type": "orig", "text": "〔天竺〕－【宋】【宮】"}
{"id": null, "n": "0783013", "target": "#nkr_note_orig_0783013", "type": "orig", "text": "藏＋（法師）【三】【宮】"}
{"id": null, "n": "0783014", "target": "#nkr_note_orig_0783014", "type": "orig", "text": "園＝國【宋】"}
{"id": null, "n": "0783015", "target": "#nkr_note_orig_0783015", "type": "orig", "text": "詳＝庠【三】【宮】"}
{"id": null, "n": "0783016", "target": "#nkr_note_orig_0783016", "type": "orig", "text": "而＝如【宮】"}
{"id": null, "n": "0783017", "target": "#nkr_note_orig_0783017", "type": "orig", "text": "詣＝諸【宋】"}
{"id": null, "n": "0783018", "target": "#nkr_note_orig_0783018", "type": "orig", "text": "肩＝有【宋】"}
{"id": null, "n": "0783019", "target": "#nkr_note_orig_0783019", "type": "orig", "text": "〔能善〕－【宋】【宮】"}
{"id": null, "n": "0783020", "target": "#nkr_note_orig_0783020", "type": "orig", "text": "葙＝箱【宋】【宮】，廂【元】【明】"}
{"id": null, "n": "0783021", "target": "#nkr_note_orig_0783021", "type": "orig", "text": "狹＝陿【三】【宮】"}
{"id": null, "n": "0784001", "target": "#nkr_note_orig_0784001", "type": "orig", "text": "蘇＝酥【三】【宮】"}
{"id": null, "n": "0784002", "target": "#nkr_note_orig_0784002", "type": "orig", "text": "伎樂＝妓樂【元】【明】下同"}
{"id": null, "n": "0784003", "target": "#nkr_note_orig_0784003", "type": "orig", "text": "珊＝那【宮】"}
{"id": null, "n": "0784004", "target": "#nkr_note_orig_0784004", "type": "orig", "text": "（供）＋滿【三】，佛＋（滿）【宮】"}
{"id": null, "n": "0785001", "target": "#nkr_note_orig_0785001", "type": "orig", "text": "悉＝受【宋】【元】"}
{"id": null, "n": "0785002", "target": "#nkr_note_orig_0785002", "type": "orig", "text": "挍＝格【三】【宮】"}
