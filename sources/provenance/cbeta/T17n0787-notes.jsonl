{"id": null, "n": "0726042", "target": "#nkr_note_mod_0726042", "type": "mod", "text": "大【大】，〔－〕【宋】【明】【宮】"}
{"id": null, "n": "0726043", "target": "#nkr_note_mod_0726043", "type": "mod", "text": "沙門釋義淨【大】，法師義淨奉詔【宋】【元】【明】【宮】"}
{"id": null, "n": "0726044", "target": "#nkr_note_mod_0726044", "type": "mod", "text": "唯【大】，惟【元】【明】"}
{"id": null, "n": "0726045", "target": "#nkr_note_mod_0726045", "type": "mod", "text": "念【大】，持【宋】【元】【明】【宮】"}
{"id": null, "n": "0726046", "target": "#nkr_note_mod_0726046", "type": "mod", "text": "時【大】，用【元】【明】"}
{"id": null, "n": "0726047", "target": "#nkr_note_mod_0726047", "type": "mod", "text": "壞【大】，懷【宋】【元】【明】【宮】"}
{"id": null, "n": "0727001", "target": "#nkr_note_mod_0727001", "type": "mod", "text": "利【大】，利呪藏中【宋】【元】【明】【宮】"}
