{"id": null, "n": "0171028", "target": "#nkr_note_mod_0171028", "type": "mod", "text": "於【大】，杖【宮】，枚【甲】"}
{"id": null, "n": "0171029", "target": "#nkr_note_mod_0171029", "type": "mod", "text": "今【大】，今心念【宋】【元】【明】【宮】"}
{"id": null, "n": "0171030", "target": "#nkr_note_mod_0171030", "type": "mod", "text": "怱【大】＊，忽【明】【甲】＊"}
