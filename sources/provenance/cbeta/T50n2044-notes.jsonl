{"id": null, "n": "0172004", "target": "#nkr_note_mod_0172004", "type": "mod", "text": "報【大】，報悉能誦持智【宋】【元】【明】【宮】"}
{"id": null, "n": "0172005", "target": "#nkr_note_mod_0172005", "type": "mod", "text": "謂【大】，量【宋】【元】【明】【宮】【甲】"}
{"id": null, "n": "0172006", "target": "#nkr_note_mod_0172006", "type": "mod", "text": "肥【大】，服【甲】"}
{"id": null, "n": "0172007", "target": "#nkr_note_mod_0172007", "type": "mod", "text": "以【大】，已【宋】【元】【明】【宮】"}
{"id": null, "n": "0172008", "target": "#nkr_note_mod_0172008", "type": "mod", "text": "減【大】，滅【甲】"}
{"id": null, "n": "0172009", "target": "#nkr_note_mod_0172009", "type": "mod", "text": "天尊說【大】，〔－〕【宋】【元】【明】【宮】【甲】"}
