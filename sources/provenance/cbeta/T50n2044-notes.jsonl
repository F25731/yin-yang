{"id": null, "n": "0171039", "target": "#nkr_note_mod_0171039", "type": "mod", "text": "得【大】，德【甲】"}
{"id": null, "n": "0171040", "target": "#nkr_note_mod_0171040", "type": "mod", "text": "已【大】，以【甲】"}
{"id": null, "n": "0171041", "target": "#nkr_note_mod_0171041", "type": "mod", "text": "在生【大】，生在【麗-CB】【甲】"}
{"id": null, "n": "0171042", "target": "#nkr_note_mod_0171042", "type": "mod", "text": "難【大】，勤【甲】"}
