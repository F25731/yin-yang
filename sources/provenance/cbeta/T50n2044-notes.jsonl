{"id": null, "n": "0171035", "target": "#nkr_note_mod_0171035", "type": "mod", "text": "東南【大】，南東【甲】"}
{"id": null, "n": "0171036", "target": "#nkr_note_mod_0171036", "type": "mod", "text": "自【大】，白【宋】【元】【明】【宮】【甲】"}
{"id": null, "n": "0171037", "target": "#nkr_note_mod_0171037", "type": "mod", "text": "捉【大】，投【甲】"}
