{"id": null, "n": "0171044", "target": "#nkr_note_mod_0171044", "type": "mod", "text": "此【大】，〔－〕【甲】"}
{"id": null, "n": "0171045", "target": "#nkr_note_mod_0171045", "type": "mod", "text": "道【大】，道道【宋】【元】【明】【宮】"}
{"id": null, "n": "0171046", "target": "#nkr_note_mod_0171046", "type": "mod", "text": "衛【大】，分衛【宋】【元】【明】【宮】"}
{"id": null, "n": "0171047", "target": "#nkr_note_mod_0171047", "type": "mod", "text": "斗【大】＊，舛【宋】【元】【明】【宮】【甲】＊"}
{"id": null, "n": "0171048", "target": "#nkr_note_mod_0171048", "type": "mod", "text": "諳【大】＊，菴【甲】＊"}
{"id": null, "n": "0171049", "target": "#nkr_note_mod_0171049", "type": "mod", "text": "行【大】，衛【宋】【元】【明】【宮】【甲】"}
{"id": null, "n": "0172001", "target": "#nkr_note_mod_0172001", "type": "mod", "text": "自【大】，日【甲】"}
{"id": null, "n": "0172002", "target": "#nkr_note_mod_0172002", "type": "mod", "text": "米【大】，〔－〕【甲】"}
