{"id": null, "n": "0170002", "target": "#nkr_note_mod_0170002", "type": "mod", "text": "天尊說【大】，〔－〕【宋】【元】【明】【宮】，【原】麗本，【甲】奈良時代寫法然院藏本"}
{"id": null, "n": "0170003", "target": "#nkr_note_mod_0170003", "type": "mod", "text": "人名附東晉錄【大】，〔－〕【宋】【宮】，今附東晉錄【元】，人名今【明】"}
{"id": null, "n": "0170004", "target": "#nkr_note_mod_0170004", "type": "mod", "text": "弭【大】，糜【宋】【元】【明】【宮】，彌【甲】"}
{"id": null, "n": "0170005", "target": "#nkr_note_mod_0170005", "type": "mod", "text": "試【大】，識【甲】"}
{"id": null, "n": "0170006", "target": "#nkr_note_mod_0170006", "type": "mod", "text": "搥【大】，椎【宋】【元】【明】【宮】，推【甲】"}
{"id": null, "n": "0170007", "target": "#nkr_note_mod_0170007", "type": "mod", "text": "憐【大】，擁【宋】【元】【明】【宮】"}
{"id": null, "n": "0170008", "target": "#nkr_note_mod_0170008", "type": "mod", "text": "歸服【大】，歸伏【宋】【元】【明】【宮】"}
{"id": null, "n": "0170009", "target": "#nkr_note_mod_0170009", "type": "mod", "text": "稱【大】，秤【宋】【元】【明】"}
{"id": null, "n": "0170010", "target": "#nkr_note_mod_0170010", "type": "mod", "text": "秤【大】＊，稱【甲】＊"}
{"id": null, "n": "0170011", "target": "#nkr_note_mod_0170011", "type": "mod", "text": "告【大】，普告【宋】【元】【明】【宮】"}
{"id": null, "n": "0170012", "target": "#nkr_note_mod_0170012", "type": "mod", "text": "乏【大】，之【甲】"}
{"id": null, "n": "0170013", "target": "#nkr_note_mod_0170013", "type": "mod", "text": "利【大】，利弗【甲】"}
{"id": null, "n": "0170014", "target": "#nkr_note_mod_0170014", "type": "mod", "text": "眾【大】，眾僧【宋】【元】【明】，〔－〕【宮】"}
{"id": null, "n": "0170015", "target": "#nkr_note_mod_0170015", "type": "mod", "text": "簿【大】，蓐【甲】"}
{"id": null, "n": "0170016", "target": "#nkr_note_mod_0170016", "type": "mod", "text": "貢【大】，真【甲】"}
{"id": null, "n": "0170017", "target": "#nkr_note_mod_0170017", "type": "mod", "text": "寶【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0170018", "target": "#nkr_note_mod_0170018", "type": "mod", "text": "文【大】，久【宮】【甲】"}
{"id": null, "n": "0170019", "target": "#nkr_note_mod_0170019", "type": "mod", "text": "不可【大】，可不【宋】【元】【明】【宮】"}
{"id": null, "n": "0170020", "target": "#nkr_note_mod_0170020", "type": "mod", "text": "世尊【大】，天尊【宋】【元】【明】"}
{"id": null, "n": "0170021", "target": "#nkr_note_mod_0170021", "type": "mod", "text": "賢【大】，賢人【甲】"}
{"id": null, "n": "0170022", "target": "#nkr_note_mod_0170022", "type": "mod", "text": "謂【大】，謂也【宋】【元】【明】【宮】"}
{"id": null, "n": "0170023", "target": "#nkr_note_mod_0170023", "type": "mod", "text": "慎【大】，思【甲】"}
{"id": null, "n": "0170024", "target": "#nkr_note_mod_0170024", "type": "mod", "text": "辟【大】，壁【宮】【甲】"}
{"id": null, "n": "0170025", "target": "#nkr_note_mod_0170025", "type": "mod", "text": "渡【大】下同，度【宋】【元】【明】【宮】【甲】下同"}
{"id": null, "n": "0170026", "target": "#nkr_note_mod_0170026", "type": "mod", "text": "此【大】，是【宋】【甲】"}
{"id": null, "n": "0170027", "target": "#nkr_note_mod_0170027", "type": "mod", "text": "免【大】，勉【甲】"}
{"id": null, "n": "0170028", "target": "#nkr_note_mod_0170028", "type": "mod", "text": "遇【大】，偶【甲】"}
{"id": null, "n": "0170029", "target": "#nkr_note_mod_0170029", "type": "mod", "text": "斧【大】＊，斫【甲】＊"}
{"id": null, "n": "0170030", "target": "#nkr_note_mod_0170030", "type": "mod", "text": "賈【大】，估【甲】"}
{"id": null, "n": "0170031", "target": "#nkr_note_mod_0170031", "type": "mod", "text": "悵【大】，長跪【甲】"}
{"id": null, "n": "0170032", "target": "#nkr_note_mod_0170032", "type": "mod", "text": "薩【大】，地【宋】【元】【明】【宮】【甲】"}
{"id": null, "n": "0170033", "target": "#nkr_note_mod_0170033", "type": "mod", "text": "以【大】，已【宮】"}
{"id": null, "n": "0170034", "target": "#nkr_note_mod_0170034", "type": "mod", "text": "度【大】，展【宋】【元】【明】"}
{"id": null, "n": "0170035", "target": "#nkr_note_mod_0170035", "type": "mod", "text": "誤【大】，悟【宋】【元】【明】【宮】"}
{"id": null, "n": "0170036", "target": "#nkr_note_mod_0170036", "type": "mod", "text": "獸【大】，〔－〕【甲】"}
{"id": null, "n": "0170037", "target": "#nkr_note_mod_0170037", "type": "mod", "text": "抖擻【大】，水凍【甲】"}
{"id": null, "n": "0170038", "target": "#nkr_note_mod_0170038", "type": "mod", "text": "吁【大】，呼【宋】【元】【明】【宮】【甲】"}
{"id": null, "n": "0170039", "target": "#nkr_note_mod_0170039", "type": "mod", "text": "誠【大】，成【甲】"}
{"id": null, "n": "0170040", "target": "#nkr_note_mod_0170040", "type": "mod", "text": "滅挾【大】，滅使【宋】，啟使【元】【明】【甲】，滅殃【宮】"}
{"id": null, "n": "0170041", "target": "#nkr_note_mod_0170041", "type": "mod", "text": "諸【大】，護【宮】"}
{"id": null, "n": "0170042", "target": "#nkr_note_mod_0170042", "type": "mod", "text": "禮起【大】，檀越【宋】【元】【明】【甲】"}
{"id": null, "n": "0170043", "target": "#nkr_note_mod_0170043", "type": "mod", "text": "災【大】，火【宋】【元】【明】【宮】"}
{"id": null, "n": "0170044", "target": "#nkr_note_mod_0170044", "type": "mod", "text": "量【大】，數【甲】"}
{"id": null, "n": "0171001", "target": "#nkr_note_mod_0171001", "type": "mod", "text": "尚【大】，儻【元】【明】，償【甲】"}
{"id": null, "n": "0171002", "target": "#nkr_note_mod_0171002", "type": "mod", "text": "舍【大】，會【甲】"}
{"id": null, "n": "0171003", "target": "#nkr_note_mod_0171003", "type": "mod", "text": "盆【大】，貪【甲】"}
{"id": null, "n": "0171004", "target": "#nkr_note_mod_0171004", "type": "mod", "text": "西【大】，面【宋】【元】【明】，而【宮】，惡【甲】"}
{"id": null, "n": "0171005", "target": "#nkr_note_mod_0171005", "type": "mod", "text": "瓫【大】＊，瓮【宮】＊"}
{"id": null, "n": "0171006", "target": "#nkr_note_mod_0171006", "type": "mod", "text": "隨【大】，〔－〕【甲】"}
{"id": null, "n": "0171007", "target": "#nkr_note_mod_0171007", "type": "mod", "text": "經【大】，教【甲】"}
{"id": null, "n": "0171008", "target": "#nkr_note_mod_0171008", "type": "mod", "text": "義【大】，〔－〕【甲】"}
{"id": null, "n": "0171009", "target": "#nkr_note_mod_0171009", "type": "mod", "text": "（善後…無）五字【大】，〔－〕【甲】"}
{"id": null, "n": "0171010", "target": "#nkr_note_mod_0171010", "type": "mod", "text": "大【大】，火【甲】"}
{"id": null, "n": "0171011", "target": "#nkr_note_mod_0171011", "type": "mod", "text": "將【大】，持【甲】"}
{"id": null, "n": "0171012", "target": "#nkr_note_mod_0171012", "type": "mod", "text": "看【大】，者【甲】"}
{"id": null, "n": "0171013", "target": "#nkr_note_mod_0171013", "type": "mod", "text": "餘【大】，俞【甲】"}
{"id": null, "n": "0171014", "target": "#nkr_note_mod_0171014", "type": "mod", "text": "最【大】，窮【甲】"}
{"id": null, "n": "0171015", "target": "#nkr_note_mod_0171015", "type": "mod", "text": "智【大】，智慧【宋】【元】【明】【宮】【甲】"}
{"id": null, "n": "0171016", "target": "#nkr_note_mod_0171016", "type": "mod", "text": "二十【大】，二十一【宋】【元】【明】【宮】"}
{"id": null, "n": "0171017", "target": "#nkr_note_mod_0171017", "type": "mod", "text": "卒【大】，年【甲】"}
{"id": null, "n": "0171018", "target": "#nkr_note_mod_0171018", "type": "mod", "text": "誦【大】，訟【甲】"}
{"id": null, "n": "0171019", "target": "#nkr_note_mod_0171019", "type": "mod", "text": "明月【大】，月明見【宋】【元】【明】【宮】"}
{"id": null, "n": "0171020", "target": "#nkr_note_mod_0171020", "type": "mod", "text": "履【大】，色履【宋】【元】【明】【宮】"}
{"id": null, "n": "0171021", "target": "#nkr_note_mod_0171021", "type": "mod", "text": "爾【大】，〔－〕【甲】"}
{"id": null, "n": "0171022", "target": "#nkr_note_mod_0171022", "type": "mod", "text": "耶【大】，那【甲】"}
{"id": null, "n": "0171023", "target": "#nkr_note_mod_0171023", "type": "mod", "text": "便【大】，使【甲】"}
{"id": null, "n": "0171024", "target": "#nkr_note_mod_0171024", "type": "mod", "text": "耶【大】，邪【甲】"}
{"id": null, "n": "0171025", "target": "#nkr_note_mod_0171025", "type": "mod", "text": "恒【CB】【宋】【元】【明】【宮】【甲】，洹【大】"}
{"id": null, "n": "0171026", "target": "#nkr_note_mod_0171026", "type": "mod", "text": "人【大】，之【宋】【元】【明】【宮】【甲】"}
