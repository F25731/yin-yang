{"id": null, "n": null, "target": null, "type": "cf1", "text": "K40n1417_p0088b08"}
{"id": null, "n": "0789004", "target": "#nkr_note_mod_0789004", "type": "mod", "text": "西【大】，宋西【明】"}
{"id": null, "n": "0789005", "target": "#nkr_note_mod_0789005", "type": "mod", "text": "譯經【大】，〔－〕【明】"}
{"id": null, "n": "0789006", "target": "#nkr_note_mod_0789006", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0789007", "target": "#nkr_note_mod_0789007", "type": "mod", "text": "土【大】，王【元】"}
{"id": null, "n": "0789008", "target": "#nkr_note_mod_0789008", "type": "mod", "text": "爾時＋（大王…大國）三百十六字【宋】【元】【明】【宮】卷末出之"}
{"id": null, "n": "0789009", "target": "#nkr_note_mod_0789009", "type": "mod", "text": "都【大】，者【宋】【元】，唯【明】"}
{"id": null, "n": "0789010", "target": "#nkr_note_mod_0789010", "type": "mod", "text": "大【大】，火【明】"}
{"id": null, "n": "0789011", "target": "#nkr_note_mod_0789011", "type": "mod", "text": "剎那【大】，一剎那【明】"}
{"id": null, "n": "0790001", "target": "#nkr_note_mod_0790001", "type": "mod", "text": "聚【大】，眾【元】"}
{"id": null, "n": "0790002", "target": "#nkr_note_mod_0790002", "type": "mod", "text": "淨【大】，涼【宋】【元】【明】【宮】"}
{"id": null, "n": "0790003", "target": "#nkr_note_mod_0790003", "type": "mod", "text": "浴【大】，沐【宋】【元】【明】【宮】"}
{"id": null, "n": "0790004", "target": "#nkr_note_mod_0790004", "type": "mod", "text": "莊嚴【大】，嚴飾【宋】【元】【明】【宮】"}
{"id": null, "n": "0790005", "target": "#nkr_note_mod_0790005", "type": "mod", "text": "妙香＋（常有…是故）三百二十二字【宋】【元】【明】【宮】卷末出之"}
{"id": null, "n": "0790006", "target": "#nkr_note_mod_0790006", "type": "mod", "text": "加【大】，伽【宋】【元】【明】【宮】"}
{"id": null, "n": "0790008", "target": "#nkr_note_mod_0790008", "type": "mod", "text": "統【大】，純【宮】"}
{"id": null, "n": "0789004", "target": "#nkr_note_orig_0789004", "type": "orig", "text": "（宋）＋西【明】"}
{"id": null, "n": "0789005", "target": "#nkr_note_orig_0789005", "type": "orig", "text": "〔譯經〕－【明】"}
{"id": null, "n": "0789006", "target": "#nkr_note_orig_0789006", "type": "orig", "text": "〔臣〕－【明】"}
{"id": null, "n": "0789007", "target": "#nkr_note_orig_0789007", "type": "orig", "text": "土＝王【元】"}
{"id": null, "n": "0789008", "target": "#nkr_note_orig_0789008", "type": "orig", "text": "爾時＋（大王…大國）三百十六字【三】【宮】卷末出之"}
{"id": null, "n": "0789009", "target": "#nkr_note_orig_0789009", "type": "orig", "text": "都＝者【宋】【元】，唯【明】"}
{"id": null, "n": "0789010", "target": "#nkr_note_orig_0789010", "type": "orig", "text": "大＝火【明】"}
{"id": null, "n": "0789011", "target": "#nkr_note_orig_0789011", "type": "orig", "text": "剎那＝一剎那【明】"}
{"id": null, "n": "0790001", "target": "#nkr_note_orig_0790001", "type": "orig", "text": "聚＝眾【元】"}
{"id": null, "n": "0790002", "target": "#nkr_note_orig_0790002", "type": "orig", "text": "淨＝涼【三】【宮】"}
{"id": null, "n": "0790003", "target": "#nkr_note_orig_0790003", "type": "orig", "text": "浴＝沐【三】【宮】"}
{"id": null, "n": "0790004", "target": "#nkr_note_orig_0790004", "type": "orig", "text": "莊嚴＝嚴飾【三】【宮】"}
{"id": null, "n": "0790005", "target": "#nkr_note_orig_0790005", "type": "orig", "text": "妙香＋（常有…是故）三百二十二字【三】【宮】卷末出之"}
{"id": null, "n": "0790006", "target": "#nkr_note_orig_0790006", "type": "orig", "text": "加＝伽【三】【宮】"}
{"id": null, "n": "0790007", "target": "#nkr_note_orig_0790007", "type": "orig", "text": "（大王…大國）三百十六字爾時下三本之文也"}
{"id": null, "n": "0790008", "target": "#nkr_note_orig_0790008", "type": "orig", "text": "統＝純【宮】"}
{"id": null, "n": "0790009", "target": "#nkr_note_orig_0790009", "type": "orig", "text": "（常有…是故）三百二十二字妙香下三本之文也"}
{"id": null, "n": "0789a2101", "target": "#nkr_note_add_0789a2101", "type": "add", "text": "孤【CB】，狐【大】"}
{"id": null, "n": "0789b0601", "target": "#nkr_note_add_0789b0601", "type": "add", "text": "愛【CB】【麗-CB】，受【大】"}
