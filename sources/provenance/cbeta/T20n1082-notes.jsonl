{"id": null, "n": "0197014", "target": "#nkr_note_mod_0197014", "type": "mod", "text": "如意輪陀羅尼【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0197015", "target": "#nkr_note_mod_0197015", "type": "mod", "text": "唐【大】，大唐天后代【宋】【元】"}
{"id": null, "n": "0197016", "target": "#nkr_note_mod_0197016", "type": "mod", "text": "除【大】，觀世音菩薩祕密藏神呪除【宋】【元】，祕密藏神呪除【明】"}
{"id": null, "n": "0197017", "target": "#nkr_note_mod_0197017", "type": "mod", "text": "本坐【大】，坐本【明】"}
{"id": null, "n": "0197018", "target": "#nkr_note_mod_0197018", "type": "mod", "text": "悲【大】，心【宋】【元】【明】"}
{"id": null, "n": "0197020", "target": "#nkr_note_mod_0197020", "type": "mod", "text": "已上是身呪【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0197022", "target": "#nkr_note_mod_0197022", "type": "mod", "text": "已上是心呪【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0197024", "target": "#nkr_note_mod_0197024", "type": "mod", "text": "種【大】，眾【明】"}
{"id": null, "n": "0198001", "target": "#nkr_note_mod_0198001", "type": "mod", "text": "善哉乃至益四字六句宋元明三本俱作長行"}
{"id": null, "n": "0198002", "target": "#nkr_note_mod_0198002", "type": "mod", "text": "滅除【大】，除滅【宋】【元】【明】"}
{"id": null, "n": "0198003", "target": "#nkr_note_mod_0198003", "type": "mod", "text": "風【大】，風黃腦【宋】【元】【明】"}
{"id": null, "n": "0198004", "target": "#nkr_note_mod_0198004", "type": "mod", "text": "頭【大】，頂【宋】【元】【明】"}
{"id": null, "n": "0198005", "target": "#nkr_note_mod_0198005", "type": "mod", "text": "雨【大】，雷【宋】【元】【明】"}
{"id": null, "n": "0198006", "target": "#nkr_note_mod_0198006", "type": "mod", "text": "誦【大】，讀誦【宋】【元】【明】"}
{"id": null, "n": "0198007", "target": "#nkr_note_mod_0198007", "type": "mod", "text": "遂【大】，隨【宋】【元】【明】"}
{"id": null, "n": "0198008", "target": "#nkr_note_mod_0198008", "type": "mod", "text": "等【大】，汝等【宋】【元】【明】"}
{"id": null, "n": "0198009", "target": "#nkr_note_mod_0198009", "type": "mod", "text": "觀世音菩薩【大】，〔－〕【明】"}
{"id": null, "n": "0198010", "target": "#nkr_note_mod_0198010", "type": "mod", "text": "財有二種【大】，有二種財【宋】【元】【明】"}
{"id": null, "n": "0198011", "target": "#nkr_note_mod_0198011", "type": "mod", "text": "世【大】，世間【宋】【元】【明】"}
{"id": null, "n": "0198012", "target": "#nkr_note_mod_0198012", "type": "mod", "text": "利【大】，增【宋】【元】【明】"}
{"id": null, "n": "0198013", "target": "#nkr_note_mod_0198013", "type": "mod", "text": "我【大】，求【宋】【元】【明】"}
{"id": null, "n": "0198014", "target": "#nkr_note_mod_0198014", "type": "mod", "text": "咎【大】，失【宋】【元】【明】"}
{"id": null, "n": "0198015", "target": "#nkr_note_mod_0198015", "type": "mod", "text": "名【大】＊，人名【宋】【元】【明】＊"}
{"id": null, "n": "0198016", "target": "#nkr_note_mod_0198016", "type": "mod", "text": "見【大】＊，親覲【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0198017", "target": "#nkr_note_mod_0198017", "type": "mod", "text": "欲見宮人【大】，親覲內宮【宋】【元】【明】"}
{"id": null, "n": "0198018", "target": "#nkr_note_mod_0198018", "type": "mod", "text": "親【大】＊，欲親【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0198019", "target": "#nkr_note_mod_0198019", "type": "mod", "text": "六【大】，誦六【宋】【元】【明】"}
{"id": null, "n": "0198020", "target": "#nkr_note_mod_0198020", "type": "mod", "text": "近【大】，覲【宋】【元】【明】"}
{"id": null, "n": "0198021", "target": "#nkr_note_mod_0198021", "type": "mod", "text": "其【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0198022", "target": "#nkr_note_mod_0198022", "type": "mod", "text": "法【大】，法滿【宋】【元】【明】"}
{"id": null, "n": "0198023", "target": "#nkr_note_mod_0198023", "type": "mod", "text": "射【大】＊，麝【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0198024", "target": "#nkr_note_mod_0198024", "type": "mod", "text": "茲【大】，羡【宋】【元】【明】"}
{"id": null, "n": "0198025", "target": "#nkr_note_mod_0198025", "type": "mod", "text": "之【大】，與【宋】【元】【明】"}
{"id": null, "n": "0198026", "target": "#nkr_note_mod_0198026", "type": "mod", "text": "滅【大】，除【宋】【元】【明】"}
{"id": null, "n": "0198027", "target": "#nkr_note_mod_0198027", "type": "mod", "text": "毒【大】，毒藥【宋】【元】【明】"}
{"id": null, "n": "0198028", "target": "#nkr_note_mod_0198028", "type": "mod", "text": "樂【大】，樂法【宋】【元】【明】"}
{"id": null, "n": "0199001", "target": "#nkr_note_mod_0199001", "type": "mod", "text": "類【大】，顆【宋】【元】【明】"}
{"id": null, "n": "0199002", "target": "#nkr_note_mod_0199002", "type": "mod", "text": "幔【大】，㦥【宋】【明】"}
{"id": null, "n": "0199003", "target": "#nkr_note_mod_0199003", "type": "mod", "text": "至【大】，志【宋】【元】【明】"}
{"id": null, "n": "0199004", "target": "#nkr_note_mod_0199004", "type": "mod", "text": "（觀世…五）十字【大】，觀世音菩薩栴檀摩尼心輪眼藥法品第五【宋】【元】，栴檀摩尼心輪眼藥法品第五【明】"}
{"id": null, "n": "0199005", "target": "#nkr_note_mod_0199005", "type": "mod", "text": "樂【大】，樂心【明】"}
{"id": null, "n": "0199006", "target": "#nkr_note_mod_0199006", "type": "mod", "text": "末【大】，沫【宋】【元】【明】"}
{"id": null, "n": "0199007", "target": "#nkr_note_mod_0199007", "type": "mod", "text": "末【大】，骨【宋】【元】【明】"}
{"id": null, "n": "0199008", "target": "#nkr_note_mod_0199008", "type": "mod", "text": "畢撥【大】，蓽茇【元】【明】"}
{"id": null, "n": "0199009", "target": "#nkr_note_mod_0199009", "type": "mod", "text": "音【大】＊，音菩薩【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0199010", "target": "#nkr_note_mod_0199010", "type": "mod", "text": "藥【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0199011", "target": "#nkr_note_mod_0199011", "type": "mod", "text": "頭【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0199012", "target": "#nkr_note_mod_0199012", "type": "mod", "text": "膜清【大】，瘼青【宋】【元】【明】"}
{"id": null, "n": "0199013", "target": "#nkr_note_mod_0199013", "type": "mod", "text": "隨【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0199014", "target": "#nkr_note_mod_0199014", "type": "mod", "text": "力【大】，功能【宋】【元】【明】"}
{"id": null, "n": "0199015", "target": "#nkr_note_mod_0199015", "type": "mod", "text": "隨【大】，隨逐【宋】【元】【明】"}
{"id": null, "n": "0199016", "target": "#nkr_note_mod_0199016", "type": "mod", "text": "者【大】，悉【宋】【元】【明】"}
{"id": null, "n": "0199017", "target": "#nkr_note_mod_0199017", "type": "mod", "text": "十【大】，一十【宋】【元】"}
{"id": null, "n": "0199018", "target": "#nkr_note_mod_0199018", "type": "mod", "text": "德【大】，得【宋】【元】【明】"}
{"id": null, "n": "0199019", "target": "#nkr_note_mod_0199019", "type": "mod", "text": "種【大】，種清【宋】【元】【明】"}
{"id": null, "n": "0199020", "target": "#nkr_note_mod_0199020", "type": "mod", "text": "法則難成如上【大】，一切成就如前【宋】【元】【明】"}
{"id": null, "n": "0199021", "target": "#nkr_note_mod_0199021", "type": "mod", "text": "觀世音【大】，〔－〕【明】"}
{"id": null, "n": "0199022", "target": "#nkr_note_mod_0199022", "type": "mod", "text": "復【大】，復能【宋】【元】【明】"}
{"id": null, "n": "0199023", "target": "#nkr_note_mod_0199023", "type": "mod", "text": "咸【大】，普【宋】【元】【明】"}
{"id": null, "n": "0199024", "target": "#nkr_note_mod_0199024", "type": "mod", "text": "酥【大】＊，蘇【宋】＊"}
{"id": null, "n": "0199025", "target": "#nkr_note_mod_0199025", "type": "mod", "text": "之【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0199026", "target": "#nkr_note_mod_0199026", "type": "mod", "text": "長二【大】，延長年一【宋】【元】【明】"}
{"id": null, "n": "0199027", "target": "#nkr_note_mod_0199027", "type": "mod", "text": "能【大】，若能【宋】【元】【明】"}
{"id": null, "n": "0199028", "target": "#nkr_note_mod_0199028", "type": "mod", "text": "天【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0199029", "target": "#nkr_note_mod_0199029", "type": "mod", "text": "雨【大】，雨時若【宋】【元】【明】"}
{"id": null, "n": "0199030", "target": "#nkr_note_mod_0199030", "type": "mod", "text": "散【大】，散之其【宋】【元】【明】"}
{"id": null, "n": "0199031", "target": "#nkr_note_mod_0199031", "type": "mod", "text": "灰【大】，爐灰【宋】【元】【明】"}
{"id": null, "n": "0199032", "target": "#nkr_note_mod_0199032", "type": "mod", "text": "此【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0199033", "target": "#nkr_note_mod_0199033", "type": "mod", "text": "在所【大】，所在【宋】【元】【明】"}
{"id": null, "n": "0199034", "target": "#nkr_note_mod_0199034", "type": "mod", "text": "乃【大】，即【宋】【元】【明】"}
{"id": null, "n": "0199035", "target": "#nkr_note_mod_0199035", "type": "mod", "text": "佛【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0199036", "target": "#nkr_note_mod_0199036", "type": "mod", "text": "懷【大】，生【宋】【元】【明】"}
{"id": null, "n": "0199037", "target": "#nkr_note_mod_0199037", "type": "mod", "text": "得唯須深信【大】，須深敬【宋】【元】【明】"}
{"id": null, "n": "0200001", "target": "#nkr_note_mod_0200001", "type": "mod", "text": "使【大】，便【宋】【元】【明】"}
{"id": null, "n": "0200002", "target": "#nkr_note_mod_0200002", "type": "mod", "text": "擁【大】，衛【宋】【元】【明】"}
{"id": null, "n": "0200003", "target": "#nkr_note_mod_0200003", "type": "mod", "text": "奉行【大】，（奉行火唵吉祥陀羅尼，那謨阿羅那哆羅，夜耶那謨彌陀婆耶怛他揭哆耶，那謨曷耶，跋嚧枳帝攝拔囉耶，菩提薩哆嚩耶，摩訶薩埵耶，摩訶伽嚧尼，伽耶，怛姪他，唵阿慕佉阿波唎帝，喝多吽，吽破吒娑婆訶）【明】，（奉行火唵吉祥陀羅尼第六，那謨阿羅那哆羅，夜耶那謨彌陀婆耶怛他揭哆耶，那謨曷耶，跋嚧根帝攝拔囉耶，菩提薩哆嚩耶，摩訶薩埵耶，摩訶伽嚧尼，伽耶，怛姪他，唵阿慕佉阿波唎帝，喝多吽，吽破吒娑婆訶）【宋】【元】"}
{"id": null, "n": "0200004", "target": "#nkr_note_mod_0200004", "type": "mod", "text": "音【大】，音菩薩【宋】【元】【明】"}
{"id": null, "n": "0200005", "target": "#nkr_note_mod_0200005", "type": "mod", "text": "如意輪陀羅尼【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0200006", "target": "#nkr_note_mod_0200006", "type": "mod", "text": "此三呪依明本載之與宋本元本對校 cf. p. 197c"}
{"id": null, "n": "0200007", "target": "#nkr_note_mod_0200007", "type": "mod", "text": "亡【大】下同，三【宋】下同"}
{"id": null, "n": "0200008", "target": "#nkr_note_mod_0200008", "type": "mod", "text": "切【大】下同，反【宋】【元】下同"}
{"id": null, "n": "0197013", "target": "#nkr_note_orig_0197013", "type": "orig", "text": "【原】麗本"}
