{"id": null, "n": "0207005", "target": "#nkr_note_mod_0207005", "type": "mod", "text": "佛說大堅固婆羅門緣起經【大】，～Mahāgovindiya in Mahavastu."}
{"id": null, "n": "0207006", "target": "#nkr_note_mod_0207006", "type": "mod", "text": "西天譯經【大】，宋西天【明】"}
{"id": null, "n": "0207007", "target": "#nkr_note_mod_0207007", "type": "mod", "text": "賜紫臣【大】，〔－〕【明】"}
{"id": null, "n": "0209001", "target": "#nkr_note_mod_0209001", "type": "mod", "text": "久【大】，名【宋】【元】【明】"}
{"id": null, "n": "0209002", "target": "#nkr_note_mod_0209002", "type": "mod", "text": "往【大】，性【宋】"}
{"id": null, "n": "0209003", "target": "#nkr_note_mod_0209003", "type": "mod", "text": "招【大】，詔【宋】【元】【明】"}
{"id": null, "n": "0210001", "target": "#nkr_note_mod_0210001", "type": "mod", "text": "西天譯經三藏朝奉大夫試光祿卿傳法大師賜紫臣施護等奉詔譯【大】，宋西天三藏朝奉大夫試光祿卿傳法大師施護等奉詔譯【明】"}
{"id": null, "n": "0210002", "target": "#nkr_note_mod_0210002", "type": "mod", "text": "󰦷【大】，怛【宋】【元】【明】"}
{"id": null, "n": "0210003", "target": "#nkr_note_mod_0210003", "type": "mod", "text": "互【大】，五【宋】【元】"}
{"id": null, "n": "0211001", "target": "#nkr_note_mod_0211001", "type": "mod", "text": "北【大】，此【宋】【元】【明】"}
{"id": null, "n": "0211002", "target": "#nkr_note_mod_0211002", "type": "mod", "text": "合【大】，（修無…未聞佛合）五百六十五字【宋】【元】【明】"}
{"id": null, "n": "0211003", "target": "#nkr_note_mod_0211003", "type": "mod", "text": "蘇【大】＊，酥【元】【明】＊"}
{"id": null, "n": "0211004", "target": "#nkr_note_mod_0211004", "type": "mod", "text": "邪【大】＊，耶【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0211005", "target": "#nkr_note_mod_0211005", "type": "mod", "text": "（修無…未聞佛）五百六十四字【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0211006", "target": "#nkr_note_mod_0211006", "type": "mod", "text": "行【大】，者【明】"}
{"id": null, "n": "0211007", "target": "#nkr_note_mod_0211007", "type": "mod", "text": "寂【大】＊，最【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0212001", "target": "#nkr_note_mod_0212001", "type": "mod", "text": "俟【大】＊，候【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0207005", "target": "#nkr_note_orig_0207005", "type": "orig", "text": "～Mahāgovindiya in Mahavastu."}
{"id": null, "n": "0207006", "target": "#nkr_note_orig_0207006", "type": "orig", "text": "西天譯經＝宋西天【明】"}
{"id": null, "n": "0207007", "target": "#nkr_note_orig_0207007", "type": "orig", "text": "〔賜紫臣〕－【明】"}
{"id": null, "n": "0209001", "target": "#nkr_note_orig_0209001", "type": "orig", "text": "久＝名【三】"}
{"id": null, "n": "0209002", "target": "#nkr_note_orig_0209002", "type": "orig", "text": "往＝性【宋】"}
{"id": null, "n": "0209003", "target": "#nkr_note_orig_0209003", "type": "orig", "text": "招＝詔【三】"}
{"id": null, "n": "0210001", "target": "#nkr_note_orig_0210001", "type": "orig", "text": "譯號如上卷"}
{"id": null, "n": "0210002", "target": "#nkr_note_orig_0210002", "type": "orig", "text": "󰦷＝怛【三】"}
{"id": null, "n": "0210003", "target": "#nkr_note_orig_0210003", "type": "orig", "text": "互＝五【宋】【元】"}
{"id": null, "n": "0211001", "target": "#nkr_note_orig_0211001", "type": "orig", "text": "北＝此【三】"}
{"id": null, "n": "0211002", "target": "#nkr_note_orig_0211002", "type": "orig", "text": "（修無…未聞佛）五百六十四字＋合【三】"}
{"id": null, "n": "0211003", "target": "#nkr_note_orig_0211003", "type": "orig", "text": "蘇＝酥【元】【明】＊"}
{"id": null, "n": "0211004", "target": "#nkr_note_orig_0211004", "type": "orig", "text": "邪＝耶【三】＊"}
{"id": null, "n": "0211005", "target": "#nkr_note_orig_0211005", "type": "orig", "text": "〔修無…未聞佛〕五百六十四字－【三】"}
{"id": null, "n": "0211006", "target": "#nkr_note_orig_0211006", "type": "orig", "text": "行＝者【明】"}
{"id": null, "n": "0211007", "target": "#nkr_note_orig_0211007", "type": "orig", "text": "寂＝最【三】＊"}
{"id": null, "n": "0212001", "target": "#nkr_note_orig_0212001", "type": "orig", "text": "俟＝候【三】＊"}
{"id": null, "n": "0208b2901", "target": "#nkr_note_add_0208b2901", "type": "add", "text": "諠【CB】【麗-CB】，誼【大】"}
{"id": null, "n": "0208c0501", "target": "#nkr_note_add_0208c0501", "type": "add", "text": "飲【CB】【麗-CB】，飯【大】"}
{"id": null, "n": "0211a2001", "target": "#nkr_note_add_0211a2001", "type": "add", "text": "于【CB】【麗-CB】，干【大】"}
{"id": null, "n": "0212c1001", "target": "#nkr_note_add_0212c1001", "type": "add", "text": "當【CB】【麗-CB】，答【大】"}
