{"id": null, "n": "0904015", "target": "#nkr_note_mod_0904015", "type": "mod", "text": "西天譯經三藏朝散大夫試光祿卿明教大師【大】，三藏法師【宋】【元】，宋西天譯經三藏朝散大夫試光祿卿明教大師【明】"}
{"id": null, "n": "0904016", "target": "#nkr_note_mod_0904016", "type": "mod", "text": "臣【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0904017", "target": "#nkr_note_mod_0904017", "type": "mod", "text": "他【大】，也【明】"}
{"id": null, "n": "0904018", "target": "#nkr_note_mod_0904018", "type": "mod", "text": "曷【大】，喝【明】"}
{"id": null, "n": "0904019", "target": "#nkr_note_mod_0904019", "type": "mod", "text": "囉【大】，羅【明】"}
{"id": null, "n": "0904020", "target": "#nkr_note_mod_0904020", "type": "mod", "text": "提【大】，地【明】"}
{"id": null, "n": "0904021", "target": "#nkr_note_mod_0904021", "type": "mod", "text": "唧【大】，即【元】【明】"}
{"id": null, "n": "0904014", "target": "#nkr_note_orig_0904014", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0904015", "target": "#nkr_note_orig_0904015", "type": "orig", "text": "（（西天…師））十八字＝（（三藏法師））四字【宋】【元】，（宋）＋西【明】"}
{"id": null, "n": "0904016", "target": "#nkr_note_orig_0904016", "type": "orig", "text": "〔臣〕－【三】"}
{"id": null, "n": "0904017", "target": "#nkr_note_orig_0904017", "type": "orig", "text": "他＝也【明】"}
{"id": null, "n": "0904018", "target": "#nkr_note_orig_0904018", "type": "orig", "text": "曷＝喝【明】"}
{"id": null, "n": "0904019", "target": "#nkr_note_orig_0904019", "type": "orig", "text": "囉＝羅【明】"}
{"id": null, "n": "0904020", "target": "#nkr_note_orig_0904020", "type": "orig", "text": "提＝地【明】"}
{"id": null, "n": "0904021", "target": "#nkr_note_orig_0904021", "type": "orig", "text": "唧＝即【元】【明】"}
