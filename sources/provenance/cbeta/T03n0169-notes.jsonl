{"id": null, "n": "0411003", "target": "#nkr_note_mod_0411003", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0411004", "target": "#nkr_note_mod_0411004", "type": "mod", "text": "南吳月支國居士支謙譯【大】，吳月氏國優婆塞支謙譯【元】【明】，吳月氏優婆塞支謙譯【宋】"}
{"id": null, "n": "0411005", "target": "#nkr_note_mod_0411005", "type": "mod", "text": "漢【大】，唐【宋】，此【明】"}
{"id": null, "n": "0411006", "target": "#nkr_note_mod_0411006", "type": "mod", "text": "飯【大】，飲【宋】【元】【明】"}
{"id": null, "n": "0411007", "target": "#nkr_note_mod_0411007", "type": "mod", "text": "童子【大】，童男【宋】【元】【明】"}
{"id": null, "n": "0411008", "target": "#nkr_note_mod_0411008", "type": "mod", "text": "鹽【大】，炎【元】【明】"}
{"id": null, "n": "0411009", "target": "#nkr_note_mod_0411009", "type": "mod", "text": "兜術【大】，兜率【宋】【元】【明】"}
{"id": null, "n": "0411010", "target": "#nkr_note_mod_0411010", "type": "mod", "text": "受別【大】，授別【宋】【元】【明】"}
{"id": null, "n": "0411011", "target": "#nkr_note_mod_0411011", "type": "mod", "text": "五十【大】，五千【宋】【元】【明】"}
{"id": null, "n": "0411012", "target": "#nkr_note_mod_0411012", "type": "mod", "text": "未【大】，末【明】"}
{"id": null, "n": "0411013", "target": "#nkr_note_mod_0411013", "type": "mod", "text": "漢【大】＊，此【明】＊"}
{"id": null, "n": "0411014", "target": "#nkr_note_mod_0411014", "type": "mod", "text": "親理【大】，親里【元】【明】"}
