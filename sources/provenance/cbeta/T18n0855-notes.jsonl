{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "四"}
{"id": null, "n": null, "target": null, "type": null, "text": "五"}
{"id": null, "n": null, "target": null, "type": null, "text": "「我從過去世」云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "虛心合掌\n加􆿁字，三業印四所，並三部被甲等，同結用"}
{"id": null, "n": null, "target": null, "type": null, "text": "用三股印"}
{"id": null, "n": null, "target": null, "type": null, "text": "敬白「十方三世佛」云云，如儀軌註"}
{"id": null, "n": null, "target": null, "type": null, "text": "火輪印同金剛界"}
{"id": null, "n": null, "target": null, "type": null, "text": "如文"}
{"id": null, "n": null, "target": null, "type": null, "text": "如常"}
{"id": null, "n": null, "target": null, "type": null, "text": "用金剛合掌"}
{"id": null, "n": null, "target": null, "type": null, "text": "如常"}
{"id": null, "n": null, "target": null, "type": null, "text": "印額、右肩、左肩、心、喉，三轉面門"}
{"id": null, "n": null, "target": null, "type": null, "text": "火輪印如軌"}
{"id": null, "n": null, "target": null, "type": null, "text": "風輪印也"}
{"id": null, "n": null, "target": null, "type": null, "text": "作印已，右風端想􇩂\n唵字，左風端想􈁥砧字，至心上三纏，背後同纏。臍三、右胯一、膝一，左亦同。臍三、腰背三、心嬭、左右肩各一、\n\n喉一、頸後一、額三、腦後三、右左耳上作結髮之勢"}
{"id": null, "n": null, "target": null, "type": null, "text": "號髻明珠"}
{"id": null, "n": null, "target": null, "type": null, "text": "虛心合掌，散舒二水，逆順三轉，加持四處"}
{"id": null, "n": null, "target": null, "type": null, "text": "印真言如軌"}
{"id": null, "n": null, "target": null, "type": null, "text": "如軌"}
{"id": null, "n": null, "target": null, "type": null, "text": "如來拳印三轉加持壇"}
{"id": null, "n": null, "target": null, "type": null, "text": "印如軌"}
{"id": null, "n": null, "target": null, "type": null, "text": "捧香\n爐誦偈「諸佛慈愍等」云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "鉢印，風隨言三招"}
{"id": null, "n": null, "target": null, "type": null, "text": "印如軌"}
{"id": null, "n": null, "target": null, "type": null, "text": "結跏趺座，現前去一肘之間，白蓮華之上觀􄙈字，\n智火燒諸煩惱，及器共清淨"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂二目觀􄙈字也"}
{"id": null, "n": null, "target": null, "type": null, "text": "安心三轉，次仰\n印轉空三，即捨印身前"}
{"id": null, "n": null, "target": null, "type": null, "text": "地水印前向下，火風空前向上，印相如常"}
{"id": null, "n": null, "target": null, "type": null, "text": "五字也"}
{"id": null, "n": null, "target": null, "type": null, "text": "印末\n皆向下"}
{"id": null, "n": null, "target": null, "type": null, "text": "如軌"}
{"id": null, "n": null, "target": null, "type": null, "text": "內縛五股"}
{"id": null, "n": null, "target": null, "type": null, "text": "用羯磨印"}
{"id": null, "n": null, "target": null, "type": null, "text": "在上五輪契中"}
{"id": null, "n": null, "target": null, "type": null, "text": "口授加命阿者羅微㘑"}
{"id": null, "n": null, "target": null, "type": null, "text": "小金剛輪印也"}
{"id": null, "n": null, "target": null, "type": null, "text": "成五色，自內出外，如次"}
{"id": null, "n": null, "target": null, "type": null, "text": "成金剛杵界道"}
{"id": null, "n": null, "target": null, "type": null, "text": "暗阿沒瑜"}
{"id": null, "n": null, "target": null, "type": null, "text": "中初"}
{"id": null, "n": null, "target": null, "type": null, "text": "外五置頂額，誦加命五種阿"}
{"id": null, "n": null, "target": null, "type": null, "text": "等八十四噁剎羅皆用上印"}
{"id": null, "n": null, "target": null, "type": null, "text": "別"}
{"id": null, "n": null, "target": null, "type": null, "text": "在本記"}
{"id": null, "n": null, "target": null, "type": null, "text": "口授"}
{"id": null, "n": null, "target": null, "type": null, "text": "住定印布字，如文普印云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "用金剛掌\n印"}
{"id": null, "n": null, "target": null, "type": null, "text": "用梵篋印，聲聞真言"}
{"id": null, "n": null, "target": null, "type": null, "text": "其印定慧內相叉，二火豎合為峯，風著火上\n節側，空各著風側"}
{"id": null, "n": null, "target": null, "type": null, "text": "用普通印"}
{"id": null, "n": null, "target": null, "type": null, "text": "用普\n通印"}
{"id": null, "n": null, "target": null, "type": null, "text": "普通印"}
{"id": null, "n": null, "target": null, "type": null, "text": "普通印，真言在下"}
{"id": null, "n": null, "target": null, "type": null, "text": "普通印"}
{"id": null, "n": null, "target": null, "type": null, "text": "持地印"}
{"id": null, "n": null, "target": null, "type": null, "text": "內五股"}
{"id": null, "n": null, "target": null, "type": null, "text": "真言如常"}
{"id": null, "n": null, "target": null, "type": null, "text": "根本印如常"}
{"id": null, "n": null, "target": null, "type": null, "text": "在下"}
{"id": null, "n": null, "target": null, "type": null, "text": "如軌"}
{"id": null, "n": null, "target": null, "type": null, "text": "如軌"}
{"id": null, "n": null, "target": null, "type": null, "text": "梵篋印"}
{"id": null, "n": null, "target": null, "type": null, "text": "如軌"}
{"id": null, "n": null, "target": null, "type": null, "text": "皆名不思議童子"}
{"id": null, "n": null, "target": null, "type": null, "text": "如軌"}
{"id": null, "n": null, "target": null, "type": null, "text": "妙成就菩薩也"}
{"id": null, "n": null, "target": null, "type": null, "text": "內五不空庫菩薩也"}
{"id": null, "n": null, "target": null, "type": null, "text": "日天子后也"}
{"id": null, "n": null, "target": null, "type": null, "text": "普印，加命迦羅迦𡁠娑嚩賀"}
{"id": null, "n": null, "target": null, "type": null, "text": "辟除結界，印身五處"}
{"id": null, "n": null, "target": null, "type": null, "text": "加命火輪印"}
{"id": null, "n": null, "target": null, "type": null, "text": "聖不動印明也"}
{"id": null, "n": null, "target": null, "type": null, "text": "不得生聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "商佉印"}
{"id": null, "n": null, "target": null, "type": null, "text": "東北西南，如軌"}
{"id": null, "n": null, "target": null, "type": null, "text": "心略"}
{"id": null, "n": null, "target": null, "type": null, "text": "「種種香花」云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "內縛開掌，風側相柱，空捻風下節。鼻真言：歸命唵\n里儞吽發吒娑嚩賀"}
{"id": null, "n": null, "target": null, "type": null, "text": "內五云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "逆順"}
{"id": null, "n": null, "target": null, "type": null, "text": "心略讚"}
{"id": null, "n": null, "target": null, "type": null, "text": "普印，印五處"}
{"id": null, "n": null, "target": null, "type": null, "text": "左旋解界第二真言"}
{"id": null, "n": null, "target": null, "type": null, "text": "皆左旋解界，但地結拔之"}
{"id": null, "n": null, "target": null, "type": null, "text": "「現前諸如\n來」云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "外縛火輪，末捧花頂上，應穆音投花壇上"}
{"id": null, "n": null, "target": null, "type": null, "text": "如前"}
{"id": null, "n": "0172015", "target": "#nkr_note_mod_0172015", "type": "mod", "text": "業【CB】【校異-原】，葉【大】"}
{"id": null, "n": "0172016", "target": "#nkr_note_mod_0172016", "type": "mod", "text": "驚【大】，警【考偽-原】"}
{"id": null, "n": "0172017", "target": "#nkr_note_mod_0172017", "type": "mod", "text": "􆿁【大】，􄙡【校異-原】"}
{"id": null, "n": "0172018", "target": "#nkr_note_mod_0172018", "type": "mod", "text": "􆿔【大】，􄙖【校異-原】"}
{"id": null, "n": "0172019", "target": "#nkr_note_mod_0172019", "type": "mod", "text": "􇩵【大】，􆿅【校異-原】"}
{"id": null, "n": "0172020", "target": "#nkr_note_mod_0172020", "type": "mod", "text": "胎【大】，臺【考偽-原】"}
{"id": null, "n": "0173001", "target": "#nkr_note_mod_0173001", "type": "mod", "text": "􆿔【大】，􈅺【校異-原】"}
{"id": null, "n": "0173002", "target": "#nkr_note_mod_0173002", "type": "mod", "text": "捨除【大】，除障【考偽-原】"}
{"id": null, "n": "0173003", "target": "#nkr_note_mod_0173003", "type": "mod", "text": "施【大】，旋【校異-原】"}
{"id": null, "n": "0173004", "target": "#nkr_note_mod_0173004", "type": "mod", "text": "掌【大】，手【校異-原】"}
{"id": null, "n": "0173006", "target": "#nkr_note_mod_0173006", "type": "mod", "text": "囉【大】，囉迦囉【校異-原】"}
{"id": null, "n": "0173007", "target": "#nkr_note_mod_0173007", "type": "mod", "text": "趺【大】，跌【校異-原】"}
{"id": null, "n": "0174001", "target": "#nkr_note_mod_0174001", "type": "mod", "text": "請諸【大】，諸世【考偽-原】"}
{"id": null, "n": "0174002", "target": "#nkr_note_mod_0174002", "type": "mod", "text": "敬【大】，啟【考偽-原】"}
{"id": null, "n": "0174003", "target": "#nkr_note_mod_0174003", "type": "mod", "text": "語【大】，悟【校異-原】"}
{"id": null, "n": "0174004", "target": "#nkr_note_mod_0174004", "type": "mod", "text": "二【大】，三【原】"}
{"id": null, "n": "0172014", "target": "#nkr_note_orig_0172014", "type": "orig", "text": "【原】享和元年刊長谷寺藏本"}
{"id": null, "n": "0172015", "target": "#nkr_note_orig_0172015", "type": "orig", "text": "葉＝業ィ【原】"}
{"id": null, "n": "0172016", "target": "#nkr_note_orig_0172016", "type": "orig", "text": "驚＝警ヵ【原】"}
{"id": null, "n": "0172017", "target": "#nkr_note_orig_0172017", "type": "orig", "text": "􆿁＝􄙡ィ【原】"}
{"id": null, "n": "0172018", "target": "#nkr_note_orig_0172018", "type": "orig", "text": "􆿔＝􄙖ィ【原】"}
{"id": null, "n": "0172019", "target": "#nkr_note_orig_0172019", "type": "orig", "text": "􇩵＝􆿅ィ【原】"}
{"id": null, "n": "0172020", "target": "#nkr_note_orig_0172020", "type": "orig", "text": "胎＝臺ヵ【原】"}
{"id": null, "n": "0173001", "target": "#nkr_note_orig_0173001", "type": "orig", "text": "􆿔＝􈅺ィ【原】"}
{"id": null, "n": "0173002", "target": "#nkr_note_orig_0173002", "type": "orig", "text": "捨除＝除障ヵ【原】"}
{"id": null, "n": "0173003", "target": "#nkr_note_orig_0173003", "type": "orig", "text": "施＝旋ィ【原】"}
{"id": null, "n": "0173004", "target": "#nkr_note_orig_0173004", "type": "orig", "text": "掌＝手ィ【原】"}
{"id": null, "n": "0173005", "target": "#nkr_note_orig_0173005", "type": "orig", "text": "原本冠註曰歸命等八字可考"}
{"id": null, "n": "0173006", "target": "#nkr_note_orig_0173006", "type": "orig", "text": "囉＋（迦囉）ィ【原】"}
{"id": null, "n": "0173007", "target": "#nkr_note_orig_0173007", "type": "orig", "text": "趺＝跌ィ【原】"}
{"id": null, "n": "0174001", "target": "#nkr_note_orig_0174001", "type": "orig", "text": "請諸＝諸世ヵ【原】"}
{"id": null, "n": "0174002", "target": "#nkr_note_orig_0174002", "type": "orig", "text": "敬＝啟ヵ【原】"}
{"id": null, "n": "0174003", "target": "#nkr_note_orig_0174003", "type": "orig", "text": "語＝悟ィ【原】"}
{"id": null, "n": "0174004", "target": "#nkr_note_orig_0174004", "type": "orig", "text": "二＝三【原】"}
{"id": null, "n": "0172b2101", "target": "#nkr_note_add_0172b2101", "type": "add", "text": "十【CB】，上【大】"}
{"id": null, "n": "0172b2201", "target": "#nkr_note_add_0172b2201", "type": "add", "text": "輪【CB】，輸【大】"}
{"id": null, "n": "0172b2901", "target": "#nkr_note_add_0172b2901", "type": "add", "text": "想【CB】，［－］【大】"}
{"id": null, "n": "0172b2902", "target": "#nkr_note_add_0172b2902", "type": "add", "text": "［－］【CB】，想【大】"}
{"id": null, "n": "0173b1501", "target": "#nkr_note_add_0173b1501", "type": "add", "text": "在下【CB】，下在【大】"}
