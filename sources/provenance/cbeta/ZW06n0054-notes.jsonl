{"id": null, "n": null, "target": null, "type": null, "text": "願垂哀憫，受請供養。"}
{"id": null, "n": null, "target": null, "type": null, "text": "願垂"}
{"id": null, "n": "0360001", "target": "#nkr_note_orig_0360001", "type": "orig", "text": "「□」，底本無，據文意補。"}
{"id": null, "n": "0362001", "target": "#nkr_note_orig_0362001", "type": "orig", "text": "「乖」，底本作「乘」，據文意改。"}
{"id": null, "n": "0362002", "target": "#nkr_note_orig_0362002", "type": "orig", "text": "「胸藏」，底本作「藏胸」，據文意改。"}
{"id": null, "n": "0363001", "target": "#nkr_note_orig_0363001", "type": "orig", "text": "「眼」，底本無，據文意補。"}
{"id": null, "n": "0363002", "target": "#nkr_note_orig_0363002", "type": "orig", "text": "「位定」，底本作「定位」，據文意改。"}
{"id": null, "n": "0363003", "target": "#nkr_note_orig_0363003", "type": "orig", "text": "「波」，底本作「般」，據文意改。"}
{"id": null, "n": "0364001", "target": "#nkr_note_orig_0364001", "type": "orig", "text": "「別傳」，底本作「傳別」，據文意改。"}
