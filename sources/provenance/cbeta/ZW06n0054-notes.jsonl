{"id": null, "n": "0364003", "target": "#nkr_note_orig_0364003", "type": "orig", "text": "「感」，底本作「交感」，據文意刪。"}
{"id": null, "n": "0365001", "target": "#nkr_note_orig_0365001", "type": "orig", "text": "「謠」，底本作「媱」，據文意改。"}
{"id": null, "n": "0365002", "target": "#nkr_note_orig_0365002", "type": "orig", "text": "「理」，底本作「琁」，據文意改。"}
{"id": null, "n": "0366001", "target": "#nkr_note_orig_0366001", "type": "orig", "text": "「言」，底本無，據文意補。"}
{"id": null, "n": "0367001", "target": "#nkr_note_orig_0367001", "type": "orig", "text": "「噉」，底本作「敢」，據文意改。"}
{"id": null, "n": "0368001", "target": "#nkr_note_orig_0368001", "type": "orig", "text": "「□」，底本無，據文意補。"}
{"id": null, "n": "0368002", "target": "#nkr_note_orig_0368002", "type": "orig", "text": "「瞻」，底本作「膽」，據文意改。"}
{"id": null, "n": "0368003", "target": "#nkr_note_orig_0368003", "type": "orig", "text": "原稿為悉曇體梵文，今改寫作拉丁體。下同。"}
{"id": null, "n": "0369001", "target": "#nkr_note_orig_0369001", "type": "orig", "text": "「錢」，底本殘，據文意補。"}
{"id": null, "n": "0369002", "target": "#nkr_note_orig_0369002", "type": "orig", "text": "「曠」，底本作「擴」，據文意放。"}
{"id": null, "n": "0369003", "target": "#nkr_note_orig_0369003", "type": "orig", "text": "「令」，底本作「領」，據文意改。"}
{"id": null, "n": "0369004", "target": "#nkr_note_orig_0369004", "type": "orig", "text": "「受食，思」，底本殘，據文意補。"}
{"id": null, "n": "0370001", "target": "#nkr_note_orig_0370001", "type": "orig", "text": "「正」，底本作「證」，據文意改。"}
{"id": null, "n": "0370002", "target": "#nkr_note_orig_0370002", "type": "orig", "text": "「願今」，底本難認，據文意錄文。"}
