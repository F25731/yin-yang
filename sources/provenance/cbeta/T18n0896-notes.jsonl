{"id": null, "n": null, "target": null, "type": null, "text": "三遍"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0746005", "target": "#nkr_note_mod_0746005", "type": "mod", "text": "一【大】，一第二同卷【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "第二同卷"}
{"id": null, "n": "0746006", "target": "#nkr_note_mod_0746006", "type": "mod", "text": "西【大】＊，宋西【明】＊"}
{"id": null, "n": "0746007", "target": "#nkr_note_mod_0746007", "type": "mod", "text": "譯經【大】＊，〔－〕【明】＊"}
{"id": null, "n": "0746008", "target": "#nkr_note_mod_0746008", "type": "mod", "text": "臣【大】＊，〔－〕【明】＊"}
{"id": null, "n": "0746009", "target": "#nkr_note_mod_0746009", "type": "mod", "text": "悲【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0746010", "target": "#nkr_note_mod_0746010", "type": "mod", "text": "唯【大】＊，惟【明】＊"}
{"id": null, "n": "0746011", "target": "#nkr_note_mod_0746011", "type": "mod", "text": "修【大】，正【宮】"}
{"id": null, "n": "0746012", "target": "#nkr_note_mod_0746012", "type": "mod", "text": "由【大】，猶【元】【明】【宮】"}
{"id": null, "n": "0747001", "target": "#nkr_note_mod_0747001", "type": "mod", "text": "眾【大】，界【宮】"}
{"id": null, "n": "0747002", "target": "#nkr_note_mod_0747002", "type": "mod", "text": "令【大】，今【元】"}
{"id": null, "n": "0747003", "target": "#nkr_note_mod_0747003", "type": "mod", "text": "實【大】，寶【宮】"}
{"id": null, "n": "0747004", "target": "#nkr_note_mod_0747004", "type": "mod", "text": "由【大】，有【明】"}
{"id": null, "n": "0747005", "target": "#nkr_note_mod_0747005", "type": "mod", "text": "勤【大】，覲【明】"}
{"id": null, "n": "0747006", "target": "#nkr_note_mod_0747006", "type": "mod", "text": "妙臂菩薩所問經【大】＊，〔－〕【明】＊"}
{"id": null, "n": "0747007", "target": "#nkr_note_mod_0747007", "type": "mod", "text": "聖【大】，勝【明】"}
{"id": null, "n": "0747008", "target": "#nkr_note_mod_0747008", "type": "mod", "text": "埿【大】＊，泥【宋】【明】【宮】＊"}
{"id": null, "n": "0747009", "target": "#nkr_note_mod_0747009", "type": "mod", "text": "刻【大】，剋【宋】【宮】"}
