{"id": null, "n": null, "target": null, "type": "cf1", "text": "《福州藏》（日本宮內庁書陵部藏大藏經第1099帖第19圖第10行）"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "《思溪藏》（日本增上寺藏高麗大藏經第18函第8冊第24圖第1行）"}
{"id": null, "n": null, "target": null, "type": "cf3", "text": "T13n0421_p0948a07"}
{"id": null, "n": "0924022", "target": "#nkr_note_mod_0924022", "type": "mod", "text": "藏【大】＊，藏法師【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0924023", "target": "#nkr_note_mod_0924023", "type": "mod", "text": "俱【大】，俱諸【宋】【元】【明】"}
{"id": null, "n": "0924024", "target": "#nkr_note_mod_0924024", "type": "mod", "text": "得大勢【大】，大勢至【宋】【元】【明】【宮】"}
{"id": null, "n": "0924025", "target": "#nkr_note_mod_0924025", "type": "mod", "text": "薩【大】，薩等【元】【明】"}
{"id": null, "n": "0924026", "target": "#nkr_note_mod_0924026", "type": "mod", "text": "敬【大】，敬供養【宋】【元】【明】【宮】"}
{"id": null, "n": "0924027", "target": "#nkr_note_mod_0924027", "type": "mod", "text": "坐【大】，座【宋】【元】【明】"}
{"id": null, "n": "0924028", "target": "#nkr_note_mod_0924028", "type": "mod", "text": "掌【大】，掌長跪【元】【明】"}
{"id": null, "n": "0924029", "target": "#nkr_note_mod_0924029", "type": "mod", "text": "有所見得【大】，所有邪見【宋】【元】【明】【宮】"}
{"id": null, "n": "0924030", "target": "#nkr_note_mod_0924030", "type": "mod", "text": "儀式【大】，威儀【宋】【元】【明】"}
{"id": null, "n": "0925001", "target": "#nkr_note_mod_0925001", "type": "mod", "text": "意【大】，意是【宋】【元】【明】【宮】"}
{"id": null, "n": "0925002", "target": "#nkr_note_mod_0925002", "type": "mod", "text": "行【大】，法【宮】"}
{"id": null, "n": "0925003", "target": "#nkr_note_mod_0925003", "type": "mod", "text": "恚【大】，恚癡【元】【明】"}
{"id": null, "n": "0925004", "target": "#nkr_note_mod_0925004", "type": "mod", "text": "無【大】，無憶【元】【明】"}
{"id": null, "n": "0925005", "target": "#nkr_note_mod_0925005", "type": "mod", "text": "起【大】，趣【宋】【元】【明】【宮】"}
{"id": null, "n": "0925006", "target": "#nkr_note_mod_0925006", "type": "mod", "text": "必【大】，畢竟【宋】【元】【明】【宮】"}
{"id": null, "n": "0925007", "target": "#nkr_note_mod_0925007", "type": "mod", "text": "王【大】，王是【元】【明】"}
{"id": null, "n": "0925008", "target": "#nkr_note_mod_0925008", "type": "mod", "text": "魔【大】，麁【宮】"}
{"id": null, "n": "0925009", "target": "#nkr_note_mod_0925009", "type": "mod", "text": "欲以相怖【大】，現其怖相【元】【明】"}
{"id": null, "n": "0925010", "target": "#nkr_note_mod_0925010", "type": "mod", "text": "須【大】，鬚【宋】【宮】"}
{"id": null, "n": "0925011", "target": "#nkr_note_mod_0925011", "type": "mod", "text": "梨【大】，利【宋】【元】【明】【宮】"}
{"id": null, "n": "0925012", "target": "#nkr_note_mod_0925012", "type": "mod", "text": "與【大】，及【宋】【元】【明】【宮】"}
{"id": null, "n": "0925013", "target": "#nkr_note_mod_0925013", "type": "mod", "text": "王【大】，王是【元】【明】"}
{"id": null, "n": "0925014", "target": "#nkr_note_mod_0925014", "type": "mod", "text": "妙色之【大】，種種色【元】【明】"}
{"id": null, "n": "0925015", "target": "#nkr_note_mod_0925015", "type": "mod", "text": "中【大】，中間【元】【明】"}
{"id": null, "n": "0925016", "target": "#nkr_note_mod_0925016", "type": "mod", "text": "有【大】，〔－〕【元】【明】"}
{"id": null, "n": "0925017", "target": "#nkr_note_mod_0925017", "type": "mod", "text": "脫【大】，解脫【元】【明】"}
{"id": null, "n": "0925018", "target": "#nkr_note_mod_0925018", "type": "mod", "text": "安【大】，安住【宋】【元】【明】【宮】"}
{"id": null, "n": "0925019", "target": "#nkr_note_mod_0925019", "type": "mod", "text": "法【大】，法為【元】【明】"}
{"id": null, "n": "0925020", "target": "#nkr_note_mod_0925020", "type": "mod", "text": "滅【大】，生【宋】【元】【明】【宮】"}
{"id": null, "n": "0925021", "target": "#nkr_note_mod_0925021", "type": "mod", "text": "住【大】，滅【宋】【元】【明】【宮】"}
{"id": null, "n": "0925022", "target": "#nkr_note_mod_0925022", "type": "mod", "text": "於【大】，不趣受想行識住於【宋】【元】【明】【宮】"}
{"id": null, "n": "0925023", "target": "#nkr_note_mod_0925023", "type": "mod", "text": "切【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0925024", "target": "#nkr_note_mod_0925024", "type": "mod", "text": "以【大】，平【元】【明】"}
{"id": null, "n": "0925025", "target": "#nkr_note_mod_0925025", "type": "mod", "text": "等【大】＊，平等【元】【明】＊"}
{"id": null, "n": "0925026", "target": "#nkr_note_mod_0925026", "type": "mod", "text": "夫【大】，又【宋】【元】【明】【宮】"}
{"id": null, "n": "0925027", "target": "#nkr_note_mod_0925027", "type": "mod", "text": "具足【大】，則得具足平【元】【明】"}
{"id": null, "n": "0926001", "target": "#nkr_note_mod_0926001", "type": "mod", "text": "轉【大】，〔－〕【元】"}
{"id": null, "n": "0926002", "target": "#nkr_note_mod_0926002", "type": "mod", "text": "識如【大】，〔－〕【宮】"}
{"id": null, "n": "0926003", "target": "#nkr_note_mod_0926003", "type": "mod", "text": "發【大】，俱發【宋】【元】【明】【宮】"}
{"id": null, "n": "0926004", "target": "#nkr_note_mod_0926004", "type": "mod", "text": "戒【大】，心【元】"}
{"id": null, "n": "0926005", "target": "#nkr_note_mod_0926005", "type": "mod", "text": "不【大】，不可【宋】【元】【明】【宮】"}
{"id": null, "n": "0926006", "target": "#nkr_note_mod_0926006", "type": "mod", "text": "也【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0926007", "target": "#nkr_note_mod_0926007", "type": "mod", "text": "空【大】，虛空【元】【明】"}
{"id": null, "n": "0926008", "target": "#nkr_note_mod_0926008", "type": "mod", "text": "天【大】，大【元】"}
{"id": null, "n": "0926009", "target": "#nkr_note_mod_0926009", "type": "mod", "text": "聲【大】，聲龍聲【宋】【元】【明】【宮】"}
{"id": null, "n": "0926010", "target": "#nkr_note_mod_0926010", "type": "mod", "text": "滅【大】，寂滅【宋】【元】【明】【宮】"}
{"id": null, "n": "0926011", "target": "#nkr_note_mod_0926011", "type": "mod", "text": "問【大】＊，聞【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0926012", "target": "#nkr_note_mod_0926012", "type": "mod", "text": "謂【大】，所謂【宋】【元】【明】【宮】"}
{"id": null, "n": "0927001", "target": "#nkr_note_mod_0927001", "type": "mod", "text": "以相【大】，憶想【宋】【元】【明】【宮】"}
{"id": null, "n": "0927002", "target": "#nkr_note_mod_0927002", "type": "mod", "text": "所【大】，物【元】"}
{"id": null, "n": "0927003", "target": "#nkr_note_mod_0927003", "type": "mod", "text": "說【大】，識【宋】【元】【明】【宮】"}
{"id": null, "n": "0927004", "target": "#nkr_note_mod_0927004", "type": "mod", "text": "生【大】，生如是【宋】【元】【明】【宮】"}
{"id": null, "n": "0927005", "target": "#nkr_note_mod_0927005", "type": "mod", "text": "而【大】，〔－〕【宮】"}
{"id": null, "n": "0927006", "target": "#nkr_note_mod_0927006", "type": "mod", "text": "語【大】，語言若【宋】【元】【明】【宮】"}
{"id": null, "n": "0927007", "target": "#nkr_note_mod_0927007", "type": "mod", "text": "言【大】＊，音【元】【明】＊"}
{"id": null, "n": "0927008", "target": "#nkr_note_mod_0927008", "type": "mod", "text": "深【大】，染【宋】【元】【明】【宮】"}
{"id": null, "n": "0927009", "target": "#nkr_note_mod_0927009", "type": "mod", "text": "中【大】，生【宮】"}
{"id": null, "n": "0927010", "target": "#nkr_note_mod_0927010", "type": "mod", "text": "有【大】，者【宋】【元】【明】【宮】"}
{"id": null, "n": "0927011", "target": "#nkr_note_mod_0927011", "type": "mod", "text": "薩【大】，提【宋】【元】【明】【宮】"}
{"id": null, "n": "0927012", "target": "#nkr_note_mod_0927012", "type": "mod", "text": "後【大】，今【宋】【元】【明】【宮】"}
{"id": null, "n": "0927013", "target": "#nkr_note_mod_0927013", "type": "mod", "text": "先【大】，後【宋】【元】【明】【宮】"}
{"id": null, "n": "0927014", "target": "#nkr_note_mod_0927014", "type": "mod", "text": "達【大】，通達【宋】【元】【明】【宮】"}
{"id": null, "n": "0928001", "target": "#nkr_note_mod_0928001", "type": "mod", "text": "放【大】，於【宋】【元】【明】【宮】"}
{"id": null, "n": "0928002", "target": "#nkr_note_mod_0928002", "type": "mod", "text": "坐【大】，座【宋】【元】【明】"}
{"id": null, "n": "0928003", "target": "#nkr_note_mod_0928003", "type": "mod", "text": "雷震【大】，震雷【元】【明】"}
{"id": null, "n": "0928004", "target": "#nkr_note_mod_0928004", "type": "mod", "text": "霔【大】，澍【宋】【元】【明】【宮】"}
{"id": null, "n": "0928005", "target": "#nkr_note_mod_0928005", "type": "mod", "text": "令其【大】，入身【宋】【元】【明】【宮】"}
{"id": null, "n": "0928006", "target": "#nkr_note_mod_0928006", "type": "mod", "text": "刓【大】，刻【宋】【宮】，割【元】【明】"}
{"id": null, "n": "0928007", "target": "#nkr_note_mod_0928007", "type": "mod", "text": "愧【大】，媿【宋】【元】【明】【宮】"}
{"id": null, "n": "0928008", "target": "#nkr_note_mod_0928008", "type": "mod", "text": "亦成【大】，成其【宋】【元】【明】【宮】"}
{"id": null, "n": "0928009", "target": "#nkr_note_mod_0928009", "type": "mod", "text": "其【大】，有【明】"}
{"id": null, "n": "0928010", "target": "#nkr_note_mod_0928010", "type": "mod", "text": "不【大】，不可【宋】【元】【明】【宮】"}
{"id": null, "n": "0928011", "target": "#nkr_note_mod_0928011", "type": "mod", "text": "想【大】，相【宋】【元】【明】【宮】"}
{"id": null, "n": "0928012", "target": "#nkr_note_mod_0928012", "type": "mod", "text": "養【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0928013", "target": "#nkr_note_mod_0928013", "type": "mod", "text": "心【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0929001", "target": "#nkr_note_mod_0929001", "type": "mod", "text": "識【大】，知識【宋】【元】【明】【宮】"}
{"id": null, "n": "0929002", "target": "#nkr_note_mod_0929002", "type": "mod", "text": "來【大】＊，以來【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0929003", "target": "#nkr_note_mod_0929003", "type": "mod", "text": "已【大】，以【明】"}
{"id": null, "n": "0929004", "target": "#nkr_note_mod_0929004", "type": "mod", "text": "來【大】，已來【宋】【元】【明】【宮】"}
{"id": null, "n": "0929005", "target": "#nkr_note_mod_0929005", "type": "mod", "text": "等【大】，平等【元】【明】"}
{"id": null, "n": "0929006", "target": "#nkr_note_mod_0929006", "type": "mod", "text": "則【大】，者即【宋】【元】【明】【宮】"}
{"id": null, "n": "0929007", "target": "#nkr_note_mod_0929007", "type": "mod", "text": "緣【大】，緣生【宋】【元】【明】【宮】"}
{"id": null, "n": "0929008", "target": "#nkr_note_mod_0929008", "type": "mod", "text": "者【大】，者即【宋】【元】【明】【宮】"}
{"id": null, "n": "0929009", "target": "#nkr_note_mod_0929009", "type": "mod", "text": "無【大】，無作【宋】【元】【明】【宮】"}
{"id": null, "n": "0930001", "target": "#nkr_note_mod_0930001", "type": "mod", "text": "慧【大】＊，慧解脫【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0930002", "target": "#nkr_note_mod_0930002", "type": "mod", "text": "淨【大】，清淨【宋】【元】【明】【宮】"}
{"id": null, "n": "0930003", "target": "#nkr_note_mod_0930003", "type": "mod", "text": "見【大】，以見【宋】【元】【明】【宮】"}
{"id": null, "n": "0930004", "target": "#nkr_note_mod_0930004", "type": "mod", "text": "亦如是【大】，我身亦爾【宋】【元】【明】【宮】"}
{"id": null, "n": "0930005", "target": "#nkr_note_mod_0930005", "type": "mod", "text": "不二不【大】，不二不分【宋】【宮】，身二不分【元】【明】"}
{"id": null, "n": "0930006", "target": "#nkr_note_mod_0930006", "type": "mod", "text": "倒【大】，顛倒【宋】【元】【明】【宮】"}
{"id": null, "n": "0930007", "target": "#nkr_note_mod_0930007", "type": "mod", "text": "知【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "0930008", "target": "#nkr_note_mod_0930008", "type": "mod", "text": "無【大】，集無【宋】【元】【明】【宮】"}
{"id": null, "n": "0930009", "target": "#nkr_note_mod_0930009", "type": "mod", "text": "不至現在世【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0930010", "target": "#nkr_note_mod_0930010", "type": "mod", "text": "離【大】，遠離【宋】【元】【明】【宮】"}
{"id": null, "n": "0930011", "target": "#nkr_note_mod_0930011", "type": "mod", "text": "相【大】，作【宮】"}
{"id": null, "n": "0930012", "target": "#nkr_note_mod_0930012", "type": "mod", "text": "作【大】，所【宮】"}
{"id": null, "n": "0931001", "target": "#nkr_note_mod_0931001", "type": "mod", "text": "相【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0931002", "target": "#nkr_note_mod_0931002", "type": "mod", "text": "等【大】，平等【宋】【元】【明】【宮】"}
{"id": null, "n": "0931003", "target": "#nkr_note_mod_0931003", "type": "mod", "text": "言【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0931004", "target": "#nkr_note_mod_0931004", "type": "mod", "text": "岐【大】，祇【宋】【元】【明】【宮】"}
{"id": null, "n": "0931005", "target": "#nkr_note_mod_0931005", "type": "mod", "text": "奈謳【大】，那優【宋】【元】【明】【宮】"}
{"id": null, "n": "0931006", "target": "#nkr_note_mod_0931006", "type": "mod", "text": "禰【大】，尼【宋】【元】【明】【宮】"}
{"id": null, "n": "0931007", "target": "#nkr_note_mod_0931007", "type": "mod", "text": "法【大】，〔－〕【宮】"}
{"id": null, "n": "0931008", "target": "#nkr_note_mod_0931008", "type": "mod", "text": "閡【大】，礙【宋】【元】【明】【宮】"}
{"id": null, "n": "0931009", "target": "#nkr_note_mod_0931009", "type": "mod", "text": "呪【大】＊，祝【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0931010", "target": "#nkr_note_mod_0931010", "type": "mod", "text": "經【大】，諸經【宋】【宮】，經諸【元】【明】"}
{"id": null, "n": "0932001", "target": "#nkr_note_mod_0932001", "type": "mod", "text": "遑【大】，星【宋】【元】【明】"}
{"id": null, "n": "0932002", "target": "#nkr_note_mod_0932002", "type": "mod", "text": "伎【大】，技【元】【明】"}
{"id": null, "n": "0932003", "target": "#nkr_note_mod_0932003", "type": "mod", "text": "藝【大】，術【宋】【元】【明】"}
{"id": null, "n": "0932004", "target": "#nkr_note_mod_0932004", "type": "mod", "text": "知【大】，如【宋】【元】【明】【宮】"}
{"id": null, "n": "0932005", "target": "#nkr_note_mod_0932005", "type": "mod", "text": "軍【大】，陣【宮】"}
