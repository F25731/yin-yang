{"id": null, "n": "0713008", "target": "#nkr_note_mod_0713008", "type": "mod", "text": "（開府…寺）三十七字【大】，唐北天竺【明】【甲】【乙】"}
{"id": null, "n": "0713009", "target": "#nkr_note_mod_0713009", "type": "mod", "text": "不【大】，大廣智不【明】【乙】"}
{"id": null, "n": "0713010", "target": "#nkr_note_mod_0713010", "type": "mod", "text": "百【大】，五【甲】"}
{"id": null, "n": "0713011", "target": "#nkr_note_mod_0713011", "type": "mod", "text": "見【大】，現【明】【乙】"}
{"id": null, "n": "0713012", "target": "#nkr_note_mod_0713012", "type": "mod", "text": "法無二【大】，無二法【明】"}
{"id": null, "n": "0713013", "target": "#nkr_note_mod_0713013", "type": "mod", "text": "悲【大】，慈【乙】"}
{"id": null, "n": "0713014", "target": "#nkr_note_mod_0713014", "type": "mod", "text": "必【大】，不【明】【甲】"}
{"id": null, "n": "0713015", "target": "#nkr_note_mod_0713015", "type": "mod", "text": "聞【大】，間【甲】"}
{"id": null, "n": "0714001", "target": "#nkr_note_mod_0714001", "type": "mod", "text": "左【大】，右【明】【乙】"}
{"id": null, "n": "0714002", "target": "#nkr_note_mod_0714002", "type": "mod", "text": "右【大】，左【明】【乙】"}
{"id": null, "n": "0714003", "target": "#nkr_note_mod_0714003", "type": "mod", "text": "門【大】，開【明】【乙】"}
{"id": null, "n": "0714004", "target": "#nkr_note_mod_0714004", "type": "mod", "text": "以【大】，已【明】【乙】"}
{"id": null, "n": "0714005", "target": "#nkr_note_mod_0714005", "type": "mod", "text": "常【大】，當【明】"}
{"id": null, "n": "0714006", "target": "#nkr_note_mod_0714006", "type": "mod", "text": "二合【大】，〔－〕【明】【甲】【乙】"}
{"id": null, "n": "0714007", "target": "#nkr_note_mod_0714007", "type": "mod", "text": "當【大】，一句生來現當【明】"}
{"id": null, "n": "0714008", "target": "#nkr_note_mod_0714008", "type": "mod", "text": "默【大】，然【明】"}
{"id": null, "n": "0714009", "target": "#nkr_note_mod_0714009", "type": "mod", "text": "虔【大】，處【甲】"}
{"id": null, "n": "0714010", "target": "#nkr_note_mod_0714010", "type": "mod", "text": "請【大】，誠【乙】"}
{"id": null, "n": "0714011", "target": "#nkr_note_mod_0714011", "type": "mod", "text": "瑟姹二合【大】，〔－〕【明】"}
{"id": null, "n": "0714012", "target": "#nkr_note_mod_0714012", "type": "mod", "text": "法界海【大】，法海內【明】，法法界【甲】"}
{"id": null, "n": "0714013", "target": "#nkr_note_mod_0714013", "type": "mod", "text": "力【大】，故【甲】【乙】"}
{"id": null, "n": "0714014", "target": "#nkr_note_mod_0714014", "type": "mod", "text": "禮【大】，體【甲】"}
{"id": null, "n": "0714015", "target": "#nkr_note_mod_0714015", "type": "mod", "text": "反【大】，切【明】【乙】"}
{"id": null, "n": "0714016", "target": "#nkr_note_mod_0714016", "type": "mod", "text": "言句【大】，密言【明】【甲】【乙】"}
{"id": null, "n": "0714017", "target": "#nkr_note_mod_0714017", "type": "mod", "text": "嚩【大】，縛【甲】【乙】"}
{"id": null, "n": "0714018", "target": "#nkr_note_mod_0714018", "type": "mod", "text": "啟【大】，起【明】"}
{"id": null, "n": "0714019", "target": "#nkr_note_mod_0714019", "type": "mod", "text": "引【大】，〔－〕【甲】"}
{"id": null, "n": "0714020", "target": "#nkr_note_mod_0714020", "type": "mod", "text": "住【大】，作【明】【甲】【乙】"}
{"id": null, "n": "0714021", "target": "#nkr_note_mod_0714021", "type": "mod", "text": "於叱唱【大】，此叱喝【明】，於叱喝【甲】【乙】"}
{"id": null, "n": "0714022", "target": "#nkr_note_mod_0714022", "type": "mod", "text": "吃【大】，屹【明】【乙】，紇【甲】"}
{"id": null, "n": "0714023", "target": "#nkr_note_mod_0714023", "type": "mod", "text": "仡【大】＊，屹【明】【乙】＊，紇【甲】＊"}
{"id": null, "n": "0714024", "target": "#nkr_note_mod_0714024", "type": "mod", "text": "哩【大】，里【明】"}
{"id": null, "n": "0714025", "target": "#nkr_note_mod_0714025", "type": "mod", "text": "合【大】＊，合引【乙】＊"}
{"id": null, "n": "0714026", "target": "#nkr_note_mod_0714026", "type": "mod", "text": "跏【大】，加【明】【乙】"}
{"id": null, "n": "0714027", "target": "#nkr_note_mod_0714027", "type": "mod", "text": "坐【大】，身【明】【甲】"}
{"id": null, "n": "0714028", "target": "#nkr_note_mod_0714028", "type": "mod", "text": "侍立【大】，觀念【乙】"}
{"id": null, "n": "0714029", "target": "#nkr_note_mod_0714029", "type": "mod", "text": "倍【大】，皆【明】【甲】【乙】"}
{"id": null, "n": "0714030", "target": "#nkr_note_mod_0714030", "type": "mod", "text": "三【大】＊，二【明】【乙】＊"}
{"id": null, "n": "0715001", "target": "#nkr_note_mod_0715001", "type": "mod", "text": "劍【大】，斂【乙】"}
{"id": null, "n": "0715002", "target": "#nkr_note_mod_0715002", "type": "mod", "text": "右【大】，左【甲】"}
{"id": null, "n": "0715003", "target": "#nkr_note_mod_0715003", "type": "mod", "text": "己【大】，身【明】【甲】"}
{"id": null, "n": "0715004", "target": "#nkr_note_mod_0715004", "type": "mod", "text": "淡【大】＊，澹【明】【乙】＊"}
{"id": null, "n": "0715005", "target": "#nkr_note_mod_0715005", "type": "mod", "text": "真【大】，身【甲】"}
{"id": null, "n": "0715006", "target": "#nkr_note_mod_0715006", "type": "mod", "text": "怛【CB】【明】【甲】【乙】，恒【大】"}
{"id": null, "n": "0715007", "target": "#nkr_note_mod_0715007", "type": "mod", "text": "二合【大】＊，〔－〕【甲】＊"}
{"id": null, "n": "0715008", "target": "#nkr_note_mod_0715008", "type": "mod", "text": "路【大】，𡀔【甲】"}
{"id": null, "n": "0715009", "target": "#nkr_note_mod_0715009", "type": "mod", "text": "合【大】，合引【甲】"}
{"id": null, "n": "0715010", "target": "#nkr_note_mod_0715010", "type": "mod", "text": "仡【大】＊，紇【明】【甲】【乙】＊"}
{"id": null, "n": "0715011", "target": "#nkr_note_mod_0715011", "type": "mod", "text": "先從壇【大】，前慧禪【甲】"}
{"id": null, "n": "0715012", "target": "#nkr_note_mod_0715012", "type": "mod", "text": "隷【大】，󰖉【明】【甲】"}
{"id": null, "n": "0715013", "target": "#nkr_note_mod_0715013", "type": "mod", "text": "力【大】，中【明】"}
{"id": null, "n": "0715014", "target": "#nkr_note_mod_0715014", "type": "mod", "text": "臍【大】，齊【明】"}
{"id": null, "n": "0715015", "target": "#nkr_note_mod_0715015", "type": "mod", "text": "後【大】，處【明】【甲】【乙】"}
{"id": null, "n": "0715016", "target": "#nkr_note_mod_0715016", "type": "mod", "text": "頸【大】，頰【甲】"}
{"id": null, "n": "0715017", "target": "#nkr_note_mod_0715017", "type": "mod", "text": "於【大】，及【甲】"}
{"id": null, "n": "0715018", "target": "#nkr_note_mod_0715018", "type": "mod", "text": "鉤【大】，劍【甲】"}
{"id": null, "n": "0715019", "target": "#nkr_note_mod_0715019", "type": "mod", "text": "力竪進【大】，進力竪【明】"}
{"id": null, "n": "0715020", "target": "#nkr_note_mod_0715020", "type": "mod", "text": "舍【大】，舍含二合【明】"}
{"id": null, "n": "0715021", "target": "#nkr_note_mod_0715021", "type": "mod", "text": "相拄【大】，指屈【明】"}
{"id": null, "n": "0715022", "target": "#nkr_note_mod_0715022", "type": "mod", "text": "舍【大】，捨【甲】"}
{"id": null, "n": "0715023", "target": "#nkr_note_mod_0715023", "type": "mod", "text": "止【大】，心【明】【甲】"}
{"id": null, "n": "0715024", "target": "#nkr_note_mod_0715024", "type": "mod", "text": "茶【大】，荼【明】【甲】【乙】"}
{"id": null, "n": "0715025", "target": "#nkr_note_mod_0715025", "type": "mod", "text": "坼【大】，岸【甲】"}
{"id": null, "n": "0715026", "target": "#nkr_note_mod_0715026", "type": "mod", "text": "囉【大】，羅【甲】"}
{"id": null, "n": "0715027", "target": "#nkr_note_mod_0715027", "type": "mod", "text": "唵【大】，〔－〕【甲】"}
{"id": null, "n": "0715028", "target": "#nkr_note_mod_0715028", "type": "mod", "text": "𤍜【大】，燥【乙】"}
{"id": null, "n": "0715029", "target": "#nkr_note_mod_0715029", "type": "mod", "text": "以【大】，結【明】"}
{"id": null, "n": "0716001", "target": "#nkr_note_mod_0716001", "type": "mod", "text": "順【大】，須【乙】"}
{"id": null, "n": "0716002", "target": "#nkr_note_mod_0716002", "type": "mod", "text": "引【大】，〔－〕【甲】"}
{"id": null, "n": "0716003", "target": "#nkr_note_mod_0716003", "type": "mod", "text": "朅哩【大】＊，渴㗚【明】【甲】【乙】＊"}
{"id": null, "n": "0716004", "target": "#nkr_note_mod_0716004", "type": "mod", "text": "合【大】，合一【明】【乙】"}
{"id": null, "n": "0716005", "target": "#nkr_note_mod_0716005", "type": "mod", "text": "參【大】，三【明】【甲】【乙】"}
{"id": null, "n": "0716006", "target": "#nkr_note_mod_0716006", "type": "mod", "text": "弩【大】，拏【明】【甲】，努【乙】"}
{"id": null, "n": "0716007", "target": "#nkr_note_mod_0716007", "type": "mod", "text": "攞【大】，羅【甲】"}
