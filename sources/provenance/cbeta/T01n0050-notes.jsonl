{"id": null, "n": "0842010", "target": "#nkr_note_mod_0842010", "type": "mod", "text": "無【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0842011", "target": "#nkr_note_mod_0842011", "type": "mod", "text": "恨【大】，不恨【宋】【元】【明】"}
{"id": null, "n": "0843001", "target": "#nkr_note_mod_0843001", "type": "mod", "text": "亦【大】，亦無【宋】【元】【明】"}
{"id": null, "n": "0843002", "target": "#nkr_note_mod_0843002", "type": "mod", "text": "佛世尊【大】＊，作世尊【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0843003", "target": "#nkr_note_mod_0843003", "type": "mod", "text": "進欲【大】，便欲進【宋】【元】【明】"}
{"id": null, "n": "0843004", "target": "#nkr_note_mod_0843004", "type": "mod", "text": "不【大】，〔－〕【宋】【元】【明】"}
