{"id": null, "n": "0837003", "target": "#nkr_note_mod_0837003", "type": "mod", "text": "大【大】，〔－〕【宋】【明】【宮】"}
{"id": null, "n": "0837004", "target": "#nkr_note_mod_0837004", "type": "mod", "text": "加【大】，跏【明】"}
{"id": null, "n": "0837005", "target": "#nkr_note_mod_0837005", "type": "mod", "text": "說【大】，諸【宋】【元】【明】"}
{"id": null, "n": "0838001", "target": "#nkr_note_mod_0838001", "type": "mod", "text": "預【大】，豫【宮】"}
{"id": null, "n": "0838002", "target": "#nkr_note_mod_0838002", "type": "mod", "text": "名【CB】【麗-CB】【宮】，明【大】"}
{"id": null, "n": "0838003", "target": "#nkr_note_mod_0838003", "type": "mod", "text": "後【大】，復【明】"}
{"id": null, "n": "0838004", "target": "#nkr_note_mod_0838004", "type": "mod", "text": "誨【大】，悔【宮】"}
{"id": null, "n": "0839001", "target": "#nkr_note_mod_0839001", "type": "mod", "text": "悕【大】下同，希【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0839002", "target": "#nkr_note_mod_0839002", "type": "mod", "text": "嶮【大】，險【宮】"}
{"id": null, "n": "0840001", "target": "#nkr_note_mod_0840001", "type": "mod", "text": "長生【大】，生長【宋】【元】【明】"}
{"id": null, "n": "0840002", "target": "#nkr_note_mod_0840002", "type": "mod", "text": "生【大】，生生【宮】"}
{"id": null, "n": "0840003", "target": "#nkr_note_mod_0840003", "type": "mod", "text": "衰【大】，變【元】【明】【宮】"}
{"id": null, "n": "0840004", "target": "#nkr_note_mod_0840004", "type": "mod", "text": "相【大】，想【元】【明】【宮】"}
{"id": null, "n": "0840005", "target": "#nkr_note_mod_0840005", "type": "mod", "text": "大唐【大】，〔－〕【聖乙】，唐【宋】【明】【宮】【聖】"}
{"id": null, "n": "0840006", "target": "#nkr_note_mod_0840006", "type": "mod", "text": "次【大】，言【宋】【元】【明】【宮】【聖】【聖乙】"}
{"id": null, "n": "0840007", "target": "#nkr_note_mod_0840007", "type": "mod", "text": "惟【大】下同，唯【宋】【元】【明】【宮】【聖】【聖乙】下同"}
{"id": null, "n": "0840008", "target": "#nkr_note_mod_0840008", "type": "mod", "text": "有【大】，其【宮】"}
{"id": null, "n": "0841001", "target": "#nkr_note_mod_0841001", "type": "mod", "text": "如【大】，曰如【聖】"}
{"id": null, "n": "0841002", "target": "#nkr_note_mod_0841002", "type": "mod", "text": "緣【大】，緣業【聖】"}
{"id": null, "n": "0841003", "target": "#nkr_note_mod_0841003", "type": "mod", "text": "牙【大】，芽【宋】【元】【明】【宮】"}
{"id": null, "n": "0841004", "target": "#nkr_note_mod_0841004", "type": "mod", "text": "諸【大】，謂【明】"}
{"id": null, "n": "0841005", "target": "#nkr_note_mod_0841005", "type": "mod", "text": "別【大】，引【宋】【元】【明】【宮】【聖乙】"}
{"id": null, "n": "0841006", "target": "#nkr_note_mod_0841006", "type": "mod", "text": "說【大】，〔－〕【聖】"}
{"id": null, "n": "0841007", "target": "#nkr_note_mod_0841007", "type": "mod", "text": "為生【大】，生為【宮】【聖】【聖乙】"}
{"id": null, "n": "0841008", "target": "#nkr_note_mod_0841008", "type": "mod", "text": "起【大】，〔－〕【聖】"}
{"id": null, "n": "0841009", "target": "#nkr_note_mod_0841009", "type": "mod", "text": "發【大】，業【聖】"}
{"id": null, "n": "0842001", "target": "#nkr_note_mod_0842001", "type": "mod", "text": "滅【大】，減【聖乙】"}
{"id": null, "n": "0842002", "target": "#nkr_note_mod_0842002", "type": "mod", "text": "言【大】，應【明】"}
{"id": null, "n": "0842003", "target": "#nkr_note_mod_0842003", "type": "mod", "text": "即【大】，師【明】"}
{"id": null, "n": "0842004", "target": "#nkr_note_mod_0842004", "type": "mod", "text": "思【大】，惡【聖】"}
{"id": null, "n": "0843001", "target": "#nkr_note_mod_0843001", "type": "mod", "text": "趣【大】，起【宋】【元】【明】【宮】【聖乙】"}
{"id": null, "n": "0843002", "target": "#nkr_note_mod_0843002", "type": "mod", "text": "止【大】，正【元】【明】【聖乙】"}
{"id": null, "n": "0843003", "target": "#nkr_note_mod_0843003", "type": "mod", "text": "時【大】，時脩【聖】"}
{"id": null, "n": "0843004", "target": "#nkr_note_mod_0843004", "type": "mod", "text": "彼【大】，〔－〕【聖】"}
{"id": null, "n": "0843005", "target": "#nkr_note_mod_0843005", "type": "mod", "text": "言【大】，說【宋】【元】【明】【宮】【聖】【聖乙】"}
