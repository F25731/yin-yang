{"id": null, "n": "0864004", "target": "#nkr_note_mod_0864004", "type": "mod", "text": "人名【大】，〔－〕【宋】【元】"}
{"id": null, "n": "0864005", "target": "#nkr_note_mod_0864005", "type": "mod", "text": "附【大】，今附【宋】【元】【明】"}
{"id": null, "n": "0864006", "target": "#nkr_note_mod_0864006", "type": "mod", "text": "乾【大】，犍【宋】【元】【明】"}
{"id": null, "n": "0864007", "target": "#nkr_note_mod_0864007", "type": "mod", "text": "汝【大】，魔【宋】【元】【明】"}
{"id": null, "n": "0864008", "target": "#nkr_note_mod_0864008", "type": "mod", "text": "不【大】，亦不【宋】【元】【明】"}
{"id": null, "n": "0864009", "target": "#nkr_note_mod_0864009", "type": "mod", "text": "此【大】，聲【元】【明】"}
{"id": null, "n": "0864010", "target": "#nkr_note_mod_0864010", "type": "mod", "text": "收拭【大】，校飾【宋】【元】【明】"}
{"id": null, "n": "0865001", "target": "#nkr_note_mod_0865001", "type": "mod", "text": "以【大】，已【宋】【元】【明】"}
{"id": null, "n": "0865002", "target": "#nkr_note_mod_0865002", "type": "mod", "text": "此【大】，比【元】"}
{"id": null, "n": "0865003", "target": "#nkr_note_mod_0865003", "type": "mod", "text": "千【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0865004", "target": "#nkr_note_mod_0865004", "type": "mod", "text": "裂【大】，壞裂【宋】【元】【明】"}
{"id": null, "n": "0865005", "target": "#nkr_note_mod_0865005", "type": "mod", "text": "向【大】，尚【明】南藏"}
{"id": null, "n": "0866001", "target": "#nkr_note_mod_0866001", "type": "mod", "text": "男【大】，男子【宋】【元】【明】"}
{"id": null, "n": "0866002", "target": "#nkr_note_mod_0866002", "type": "mod", "text": "血流【大】，流血【宋】【元】【明】"}
{"id": null, "n": "0866003", "target": "#nkr_note_mod_0866003", "type": "mod", "text": "秔【大】，稻【宋】【元】【明】"}
{"id": null, "n": "0866004", "target": "#nkr_note_mod_0866004", "type": "mod", "text": "覩【大】，觀【宋】【元】【明】"}
{"id": null, "n": "0866005", "target": "#nkr_note_mod_0866005", "type": "mod", "text": "昇【大】，升【明】"}
{"id": null, "n": "0866006", "target": "#nkr_note_mod_0866006", "type": "mod", "text": "鹿【大】，此【宋】【元】【明】"}
{"id": null, "n": "0866007", "target": "#nkr_note_mod_0866007", "type": "mod", "text": "褥【大】，辱【宋】"}
{"id": null, "n": "0866008", "target": "#nkr_note_mod_0866008", "type": "mod", "text": "國【大】，園【明】"}
