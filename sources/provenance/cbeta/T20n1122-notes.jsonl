{"id": null, "n": "0523002", "target": "#nkr_note_mod_0523002", "type": "mod", "text": "軌【大】，軌一卷【甲】"}
{"id": null, "n": "0523003", "target": "#nkr_note_mod_0523003", "type": "mod", "text": "唐【大】，〔－〕【甲】"}
{"id": null, "n": "0523004", "target": "#nkr_note_mod_0523004", "type": "mod", "text": "三【大】，大興善寺三【甲】"}
{"id": null, "n": "0523005", "target": "#nkr_note_mod_0523005", "type": "mod", "text": "智【大】，〔－〕【甲】"}
{"id": null, "n": "0524001", "target": "#nkr_note_mod_0524001", "type": "mod", "text": "莎【大】，娑【甲】"}
{"id": null, "n": "0524002", "target": "#nkr_note_mod_0524002", "type": "mod", "text": "性【大】，吽【甲】"}
{"id": null, "n": "0524003", "target": "#nkr_note_mod_0524003", "type": "mod", "text": "祕密【大】，密祕【甲】"}
{"id": null, "n": "0524004", "target": "#nkr_note_mod_0524004", "type": "mod", "text": "拄【大】＊，跓【甲】＊"}
{"id": null, "n": "0524005", "target": "#nkr_note_mod_0524005", "type": "mod", "text": "二【大】＊，三【甲】＊"}
{"id": null, "n": "0524006", "target": "#nkr_note_mod_0524006", "type": "mod", "text": "二合【大】，〔－〕【甲】"}
{"id": null, "n": "0524007", "target": "#nkr_note_mod_0524007", "type": "mod", "text": "受【大】，授【甲】"}
{"id": null, "n": "0524008", "target": "#nkr_note_mod_0524008", "type": "mod", "text": "右【大】＊，又【甲】＊"}
{"id": null, "n": "0524009", "target": "#nkr_note_mod_0524009", "type": "mod", "text": "嚩【大】，一嚩一【甲】"}
{"id": null, "n": "0524010", "target": "#nkr_note_mod_0524010", "type": "mod", "text": "言切【大】，一反【甲】"}
{"id": null, "n": "0524011", "target": "#nkr_note_mod_0524011", "type": "mod", "text": "此【大】＊，以【甲】＊"}
{"id": null, "n": "0524012", "target": "#nkr_note_mod_0524012", "type": "mod", "text": "洛【大】，𠸪【甲】"}
{"id": null, "n": "0524013", "target": "#nkr_note_mod_0524013", "type": "mod", "text": "哆【大】，跢【甲】"}
{"id": null, "n": "0524014", "target": "#nkr_note_mod_0524014", "type": "mod", "text": "𤚥【大】，𬼪【甲】"}
{"id": null, "n": "0524015", "target": "#nkr_note_mod_0524015", "type": "mod", "text": "（次應…故）十四字【大】，為欲成佛事業故次應禮事不空尊【甲】"}
{"id": null, "n": "0524016", "target": "#nkr_note_mod_0524016", "type": "mod", "text": "磨【大】＊，麼【甲】＊"}
{"id": null, "n": "0524017", "target": "#nkr_note_mod_0524017", "type": "mod", "text": "誠【大】，成【甲】"}
{"id": null, "n": "0524018", "target": "#nkr_note_mod_0524018", "type": "mod", "text": "時【大】，喜【甲】"}
{"id": null, "n": "0524019", "target": "#nkr_note_mod_0524019", "type": "mod", "text": "跏坐【大】，結跏【甲】"}
{"id": null, "n": "0525001", "target": "#nkr_note_mod_0525001", "type": "mod", "text": "戒【大】，入【甲】"}
{"id": null, "n": "0525002", "target": "#nkr_note_mod_0525002", "type": "mod", "text": "二合【大】，〔－〕【甲】"}
{"id": null, "n": "0525003", "target": "#nkr_note_mod_0525003", "type": "mod", "text": "音【大】，音三合【甲】"}
{"id": null, "n": "0525004", "target": "#nkr_note_mod_0525004", "type": "mod", "text": "闔【大】，合【甲】"}
{"id": null, "n": "0525005", "target": "#nkr_note_mod_0525005", "type": "mod", "text": "右【大】，左【甲】"}
{"id": null, "n": "0525006", "target": "#nkr_note_mod_0525006", "type": "mod", "text": "發【大】，㗶【甲】"}
{"id": null, "n": "0525007", "target": "#nkr_note_mod_0525007", "type": "mod", "text": "領【大】，顧【甲】"}
{"id": null, "n": "0525008", "target": "#nkr_note_mod_0525008", "type": "mod", "text": "合【大】，合二【甲】"}
{"id": null, "n": "0525009", "target": "#nkr_note_mod_0525009", "type": "mod", "text": "鑁【大】，鑁三合同上【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "三合同上"}
{"id": null, "n": "0525010", "target": "#nkr_note_mod_0525010", "type": "mod", "text": "開【大】，門【甲】"}
{"id": null, "n": "0525011", "target": "#nkr_note_mod_0525011", "type": "mod", "text": "聲【大】，〔－〕【甲】"}
{"id": null, "n": "0525012", "target": "#nkr_note_mod_0525012", "type": "mod", "text": "唵【大】＊，唵一【甲】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": "0525013", "target": "#nkr_note_mod_0525013", "type": "mod", "text": "吠【大】＊，󱕓【甲】＊"}
