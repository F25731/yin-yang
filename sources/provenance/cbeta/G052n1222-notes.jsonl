{"id": null, "n": null, "target": null, "type": null, "text": "光明心者即是菩提心也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即如瑜伽中成身次第也"}
{"id": null, "n": null, "target": null, "type": null, "text": "知族五部明已五部真言也"}
{"id": null, "n": null, "target": null, "type": null, "text": "知已"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂一字頂輪王法也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂大印也"}
{"id": null, "n": null, "target": null, "type": null, "text": "軌儀竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂運為也"}
{"id": null, "n": null, "target": null, "type": null, "text": "决云謂隨眾生意所樂者"}
{"id": null, "n": null, "target": null, "type": null, "text": "西方或以赤麞皮中安氈華而坐"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂入定也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂自建立已來乃至大印等"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂在蓮華上也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂作赤色上有金剛"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂以杓應娑嚩二合訶聲注物便瀉爐中及餘聲未盡還注物"}
{"id": null, "n": null, "target": null, "type": null, "text": "所謂以虛空內所有為一切體"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂體隨意變身"}
{"id": null, "n": null, "target": null, "type": null, "text": "四十八載"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "G052n1222_p1050a12"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T19n0955_p0315a26"}
{"id": null, "n": "1048a1401", "target": "#nkr_note_add_1048a1401", "type": "add", "text": "已【CB】，巳【佛教】"}
{"id": null, "n": "1050a1201", "target": "#nkr_note_add_1050a1201", "type": "add", "text": "縛【CB】，縳【佛教】"}
