{"id": null, "n": null, "target": null, "type": null, "text": "軌"}
{"id": null, "n": null, "target": null, "type": null, "text": "善申比量，獨現己宗，邪歒\n屏言，故曰能立"}
{"id": null, "n": null, "target": null, "type": null, "text": "謬像三支，妄陳偽執，危猶累卵，故名似立"}
{"id": null, "n": null, "target": null, "type": null, "text": "妙斥宗非，\n或彈因喻，威同逐北，故名能破"}
{"id": null, "n": null, "target": null, "type": null, "text": "螳蜋之斧，欲抗〔降〕車，偽難同之，故名似破"}
{"id": null, "n": null, "target": null, "type": null, "text": "證法自相，不帶名言，如鏡鑒形，\n故名現量"}
{"id": null, "n": null, "target": null, "type": null, "text": "目觀玄黃，謂見瓶等，猶觀旋火，名似現量"}
{"id": null, "n": null, "target": null, "type": null, "text": "託驅於顯，\n幽旨可包，類契真宗，故名比量"}
{"id": null, "n": null, "target": null, "type": null, "text": "圖形於影，未盡麗容，擬而失真，名似比量"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": "0680005", "target": "#nkr_note_orig_0680005", "type": "orig", "text": "令一作分"}
{"id": null, "n": "0680006", "target": "#nkr_note_orig_0680006", "type": "orig", "text": "謂一作誦"}
{"id": null, "n": "0680007", "target": "#nkr_note_orig_0680007", "type": "orig", "text": "無八並二字"}
{"id": null, "n": "0680008", "target": "#nkr_note_orig_0680008", "type": "orig", "text": "峰疑鋒"}
{"id": null, "n": "0681001", "target": "#nkr_note_orig_0681001", "type": "orig", "text": "降疑龍"}
{"id": null, "n": "0681002", "target": "#nkr_note_orig_0681002", "type": "orig", "text": "在一作比"}
{"id": null, "n": "0682k01", "target": "#nkr_note_orig_0682k01", "type": "orig", "text": "所別四句"}
{"id": null, "n": "0682k02", "target": "#nkr_note_orig_0682k02", "type": "orig", "text": "能別四句"}
{"id": null, "n": "0682001", "target": "#nkr_note_orig_0682001", "type": "orig", "text": "編疑偏"}
{"id": null, "n": "0682002", "target": "#nkr_note_orig_0682002", "type": "orig", "text": "快道云論本作差別性故今改作為性依之於基疏有其能破可對撿也"}
{"id": null, "n": "0683k01", "target": "#nkr_note_orig_0683k01", "type": "orig", "text": "生因之三"}
{"id": null, "n": "0683k02", "target": "#nkr_note_orig_0683k02", "type": "orig", "text": "了因之三"}
{"id": null, "n": "0683k03", "target": "#nkr_note_orig_0683k03", "type": "orig", "text": "六因兼正門"}
{"id": null, "n": "0683k04", "target": "#nkr_note_orig_0683k04", "type": "orig", "text": "遍是宗法性"}
{"id": null, "n": "0684k01", "target": "#nkr_note_orig_0684k01", "type": "orig", "text": "同品定有性"}
{"id": null, "n": "0684k02", "target": "#nkr_note_orig_0684k02", "type": "orig", "text": "異品遍無性"}
{"id": null, "n": "0686001", "target": "#nkr_note_orig_0686001", "type": "orig", "text": "吒一作以"}
{"id": null, "n": "0686002", "target": "#nkr_note_orig_0686002", "type": "orig", "text": "見一作燒"}
{"id": null, "n": "0688001", "target": "#nkr_note_orig_0688001", "type": "orig", "text": "示一作悟"}
{"id": null, "n": "0689k01", "target": "#nkr_note_orig_0689k01", "type": "orig", "text": "似能立"}
{"id": null, "n": "0689k02", "target": "#nkr_note_orig_0689k02", "type": "orig", "text": "現量"}
{"id": null, "n": "0689001", "target": "#nkr_note_orig_0689001", "type": "orig", "text": "列疑例"}
{"id": null, "n": "0689002", "target": "#nkr_note_orig_0689002", "type": "orig", "text": "故疑彼"}
{"id": null, "n": "0689k03", "target": "#nkr_note_orig_0689k03", "type": "orig", "text": "比量"}
