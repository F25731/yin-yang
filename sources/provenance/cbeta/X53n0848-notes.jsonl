{"id": null, "n": "0690002", "target": "#nkr_note_orig_0690002", "type": "orig", "text": "日疑月"}
{"id": null, "n": "0690k01", "target": "#nkr_note_orig_0690k01", "type": "orig", "text": "自語相違"}
{"id": null, "n": "0690k02", "target": "#nkr_note_orig_0690k02", "type": "orig", "text": "能別不極成"}
{"id": null, "n": "0690k03", "target": "#nkr_note_orig_0690k03", "type": "orig", "text": "所別不極成"}
{"id": null, "n": "0691001", "target": "#nkr_note_orig_0691001", "type": "orig", "text": "師下現流本有對佛弟子四字"}
{"id": null, "n": "0691k01", "target": "#nkr_note_orig_0691k01", "type": "orig", "text": "俱不極成"}
{"id": null, "n": "0691k02", "target": "#nkr_note_orig_0691k02", "type": "orig", "text": "相符極成"}
{"id": null, "n": "0691k03", "target": "#nkr_note_orig_0691k03", "type": "orig", "text": "陳那不立後四"}
{"id": null, "n": "0691k04", "target": "#nkr_note_orig_0691k04", "type": "orig", "text": "天主立後四過"}
{"id": null, "n": "0691k05", "target": "#nkr_note_orig_0691k05", "type": "orig", "text": "因過"}
{"id": null, "n": "0691k06", "target": "#nkr_note_orig_0691k06", "type": "orig", "text": "不成釋名"}
