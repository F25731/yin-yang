{"id": null, "n": "0692k03", "target": "#nkr_note_orig_0692k03", "type": "orig", "text": "兩俱不成"}
{"id": null, "n": "0692k04", "target": "#nkr_note_orig_0692k04", "type": "orig", "text": "隨一不成"}
{"id": null, "n": "0692001", "target": "#nkr_note_orig_0692001", "type": "orig", "text": "許疑計次同"}
{"id": null, "n": "0692k05", "target": "#nkr_note_orig_0692k05", "type": "orig", "text": "猶預不成"}
