{"id": null, "n": null, "target": null, "type": "cf2", "text": "大正藏校勘欄原有校異文字「[9] 𤢌＝擒ィ【原】」，本字參考校異資訊修訂。"}
{"id": null, "n": "0187004", "target": "#nkr_note_mod_0187004", "type": "mod", "text": "境【大】＊，鏡【考偽-原】＊"}
{"id": null, "n": "0187005", "target": "#nkr_note_mod_0187005", "type": "mod", "text": "持【大】，誦【校異-原】"}
{"id": null, "n": "0187006", "target": "#nkr_note_mod_0187006", "type": "mod", "text": "齊【大】＊，齋【考偽-原】＊"}
{"id": null, "n": "0187007", "target": "#nkr_note_mod_0187007", "type": "mod", "text": "是【大】，見【考偽-原】"}
{"id": null, "n": "0187008", "target": "#nkr_note_mod_0187008", "type": "mod", "text": "千【大】，百八【校異-原】"}
{"id": null, "n": "0187009", "target": "#nkr_note_mod_0187009", "type": "mod", "text": "𤢌【CB】，擒【大】，擒【校異-原】"}
{"id": null, "n": "0187010", "target": "#nkr_note_mod_0187010", "type": "mod", "text": "無【大】，不【校異-原】"}
{"id": null, "n": "0187011", "target": "#nkr_note_mod_0187011", "type": "mod", "text": "遍【大】，曰【考偽-原】"}
{"id": null, "n": "0187012", "target": "#nkr_note_mod_0187012", "type": "mod", "text": "又【大】，復【校異-原】"}
{"id": null, "n": "0187013", "target": "#nkr_note_mod_0187013", "type": "mod", "text": "火【大】，火火【原】"}
{"id": null, "n": "0188001", "target": "#nkr_note_mod_0188001", "type": "mod", "text": "意【大】，意取【校異-原】"}
{"id": null, "n": "0188002", "target": "#nkr_note_mod_0188002", "type": "mod", "text": "相【大】，相竪【校異-原】"}
{"id": null, "n": "0188003", "target": "#nkr_note_mod_0188003", "type": "mod", "text": "按壇【大】，如來【校異-原】，智壇【考偽-原】"}
{"id": null, "n": "0187003", "target": "#nkr_note_orig_0187003", "type": "orig", "text": "【原】享和元年刊長谷寺藏本"}
{"id": null, "n": "0187004", "target": "#nkr_note_orig_0187004", "type": "orig", "text": "境＝鏡ヵ【原】＊"}
{"id": null, "n": "0187005", "target": "#nkr_note_orig_0187005", "type": "orig", "text": "持＝誦ィ【原】"}
{"id": null, "n": "0187006", "target": "#nkr_note_orig_0187006", "type": "orig", "text": "齊＝齋ヵ【原】＊"}
{"id": null, "n": "0187007", "target": "#nkr_note_orig_0187007", "type": "orig", "text": "是＝見ヵ【原】"}
{"id": null, "n": "0187008", "target": "#nkr_note_orig_0187008", "type": "orig", "text": "千＝百八ィ【原】"}
{"id": null, "n": "0187009", "target": "#nkr_note_orig_0187009", "type": "orig", "text": "𤢌＝擒ィ【原】"}
{"id": null, "n": "0187010", "target": "#nkr_note_orig_0187010", "type": "orig", "text": "無＝不ィ【原】"}
