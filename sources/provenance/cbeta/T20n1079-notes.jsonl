{"id": null, "n": "0187012", "target": "#nkr_note_orig_0187012", "type": "orig", "text": "又＝復ィ【原】"}
{"id": null, "n": "0187013", "target": "#nkr_note_orig_0187013", "type": "orig", "text": "火＋（火）【原】"}
{"id": null, "n": "0188001", "target": "#nkr_note_orig_0188001", "type": "orig", "text": "意＋（取）ィ【原】"}
{"id": null, "n": "0188002", "target": "#nkr_note_orig_0188002", "type": "orig", "text": "相＋（竪）ィ【原】"}
{"id": null, "n": "0188003", "target": "#nkr_note_orig_0188003", "type": "orig", "text": "按壇＝如來ィ【原】，智壇ヵ【原】"}
