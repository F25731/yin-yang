{"id": null, "n": null, "target": null, "type": null, "text": "即沙彌經"}
{"id": null, "n": null, "target": null, "type": null, "text": "出諸經要集"}
{"id": null, "n": null, "target": null, "type": null, "text": "法苑持戒篇，越度大海，號曰牢船。"}
{"id": null, "n": null, "target": null, "type": null, "text": "即本經也"}
{"id": null, "n": null, "target": null, "type": null, "text": "沙彌盜七果上詳注"}
{"id": null, "n": null, "target": null, "type": null, "text": "六交報文也"}
{"id": null, "n": null, "target": null, "type": null, "text": "見前禪秘要經"}
{"id": null, "n": null, "target": null, "type": null, "text": "詳見上文"}
{"id": null, "n": null, "target": null, "type": null, "text": "賢愚、報恩二經也"}
{"id": null, "n": null, "target": null, "type": null, "text": "法句言語經"}
{"id": null, "n": null, "target": null, "type": null, "text": "呂氏春秋異寶篇詳\n載"}
{"id": null, "n": null, "target": null, "type": null, "text": "出五分"}
{"id": null, "n": null, "target": null, "type": null, "text": "本經"}
{"id": null, "n": null, "target": null, "type": null, "text": "三衣謂五條、七條、二十五條也"}
{"id": null, "n": null, "target": null, "type": null, "text": "見前"}
{"id": null, "n": null, "target": null, "type": null, "text": "詳載下威儀篇"}
{"id": null, "n": null, "target": null, "type": null, "text": "詳載敬大沙門"}
{"id": null, "n": null, "target": null, "type": null, "text": "百丈禪師著也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "笑巖月心老人著也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "宣即南山聖師所著也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此句重在見字，當作敬字觀"}
{"id": null, "n": null, "target": null, "type": null, "text": "此篇原在第十，今置此。"}
{"id": null, "n": null, "target": null, "type": null, "text": "凡睡醒當默念"}
{"id": null, "n": null, "target": null, "type": null, "text": "指授，指語也"}
{"id": null, "n": null, "target": null, "type": null, "text": "若禮別佛，隨換此四字"}
{"id": null, "n": null, "target": null, "type": null, "text": "詳見下文"}
{"id": null, "n": null, "target": null, "type": null, "text": "同前尼寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "尼僧結拜義同"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
