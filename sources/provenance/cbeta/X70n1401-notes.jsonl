{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈一\n下，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "洪新恩"}
{"id": null, "n": null, "target": null, "type": null, "text": "良久，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "良久，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "擲主丈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "以手拍膝一下云"}
{"id": null, "n": null, "target": null, "type": null, "text": "良久，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "良久，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "洪上舍"}
{"id": null, "n": null, "target": null, "type": null, "text": "以拂子"}
{"id": null, "n": null, "target": null, "type": null, "text": "良\n久，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "拈主丈，云"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓一下，云"}
{"id": null, "n": null, "target": null, "type": null, "text": "又卓一下，云"}
{"id": null, "n": null, "target": null, "type": null, "text": "度主丈喚侍者，云"}
{"id": null, "n": null, "target": null, "type": null, "text": "良\n久，喝一喝，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈\n一下，喝一喝，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "以\n\n拂子擊禪床一下，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "拈主丈，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈一下，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "以拂子擊禪\n床兩下，喝兩喝，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "豎拂子云"}
{"id": null, "n": null, "target": null, "type": null, "text": "以拂子作釣魚勢云"}
{"id": null, "n": null, "target": null, "type": null, "text": "某甲"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈拄杖召大眾云"}
{"id": null, "n": null, "target": null, "type": null, "text": "以拄杖卓一下云"}
{"id": null, "n": null, "target": null, "type": null, "text": "以拄杖"}
{"id": null, "n": null, "target": null, "type": null, "text": "以拄杖"}
{"id": null, "n": null, "target": null, "type": null, "text": "以拄杖"}
{"id": null, "n": null, "target": null, "type": null, "text": "靠拄杖下座"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓拄杖一\n下云"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓拄杖一下，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "天明癸卯偶覽朝鮮板本校正。"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃至"}
{"id": null, "n": null, "target": null, "type": null, "text": "通計五十四葉。"}
