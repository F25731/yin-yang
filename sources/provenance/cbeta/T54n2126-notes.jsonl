{"id": null, "n": null, "target": null, "type": "cf1", "text": "X88n1659_p0453b03"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "《舊唐書》（欽定四庫全書本第183卷第27a頁）"}
