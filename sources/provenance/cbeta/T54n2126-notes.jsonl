{"id": null, "n": null, "target": null, "type": null, "text": "禹儞"}
{"id": null, "n": null, "target": null, "type": null, "text": "偊儞"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "贊寧"}
{"id": null, "n": null, "target": null, "type": null, "text": "咸平二年重更修洛"}
{"id": null, "n": null, "target": null, "type": null, "text": "浴佛行像附"}
{"id": null, "n": null, "target": null, "type": null, "text": "別立禪居附"}
{"id": null, "n": null, "target": null, "type": null, "text": "外學附"}
{"id": null, "n": null, "target": null, "type": null, "text": "義準釋名"}
{"id": null, "n": null, "target": null, "type": null, "text": "穢濁不可同居"}
{"id": null, "n": null, "target": null, "type": null, "text": "法食二同界也"}
{"id": null, "n": null, "target": null, "type": null, "text": "修出離世俗之所也"}
{"id": null, "n": null, "target": null, "type": null, "text": "非󱍮暴者所居"}
{"id": null, "n": null, "target": null, "type": null, "text": "三業無染處也"}
{"id": null, "n": null, "target": null, "type": null, "text": "剎土堅固道人所居"}
{"id": null, "n": null, "target": null, "type": null, "text": "祇園有蓮華藏世界。以七寶\n莊嚴。謂之寂滅道場。盧舍那佛說華嚴於此"}
{"id": null, "n": null, "target": null, "type": null, "text": "入其中者。去煩惑遠。與寂滅樂\n近故"}
{"id": null, "n": null, "target": null, "type": null, "text": "如行安樂行。以此中近法故也"}
{"id": null, "n": null, "target": null, "type": null, "text": "今洛陽龍門天竺寺有石窟。有如那羅延金剛佛窟等。是"}
{"id": null, "n": null, "target": null, "type": null, "text": "今禪宗住持多用此名也"}
{"id": null, "n": null, "target": null, "type": null, "text": "律曰。住一林。經中有逝多林也"}
{"id": null, "n": null, "target": null, "type": null, "text": "如善見論中瞿\n曇廟"}
{"id": null, "n": null, "target": null, "type": null, "text": "無院相者"}
{"id": null, "n": null, "target": null, "type": null, "text": "今五臺山有多所也"}
{"id": null, "n": null, "target": null, "type": null, "text": "出楊衒之伽藍記中"}
{"id": null, "n": null, "target": null, "type": null, "text": "西域謂之般遮于瑟"}
{"id": null, "n": null, "target": null, "type": null, "text": "取迦提月名也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此曰和集"}
{"id": null, "n": null, "target": null, "type": null, "text": "此曰法時"}
{"id": null, "n": null, "target": null, "type": null, "text": "即賓頭盧身也"}
{"id": null, "n": null, "target": null, "type": null, "text": "曲躬合掌身也。發言不審口也。心若不生崇重。豈能動身口乎"}
{"id": null, "n": null, "target": null, "type": null, "text": "箋曰。不遵王化。名曰\n叛臣。不繼父蹤。呼為逆子。敢有不循佛說。是謂魔外之徒。所以三世諸佛法無異說。十方眾聖授學同文。夫\n釋迦之經本也。達磨之言末也。背本逐末。良可悲哉。愚素習象胥。力根貝葉。遍問西來三藏。仍閱古今求法\n記文。天竺禪定並稟教乘。所以入正位者繼踵。五天蓋依法務實而行。佛言聖法不誤後學也。敢諮同志。學佛\n修禪。庶幾畢離苦津。高登彼岸。無以利口欺人自瞞於靈府也。經曰。若欲得道。當依佛語。違而得者。無有\n是處。可誣也哉"}
{"id": null, "n": null, "target": null, "type": null, "text": "箋曰。禮樂花伐自天子出。則王道興。為佛寺僧規。稟如來制。則正法住矣"}
{"id": null, "n": null, "target": null, "type": null, "text": "咸平二年重更修理"}
{"id": null, "n": null, "target": null, "type": null, "text": "立尼正附"}
{"id": null, "n": null, "target": null, "type": null, "text": "尼附"}
{"id": null, "n": null, "target": null, "type": null, "text": "祠部牒附"}
{"id": null, "n": null, "target": null, "type": null, "text": "生日道場附"}
{"id": null, "n": null, "target": null, "type": null, "text": "景明年中帝新撰之"}
{"id": null, "n": null, "target": null, "type": null, "text": "字季倫"}
{"id": null, "n": null, "target": null, "type": null, "text": "即億耳也"}
{"id": null, "n": null, "target": null, "type": null, "text": "或曰道䂮"}
{"id": null, "n": null, "target": null, "type": null, "text": "大字異耳"}
{"id": null, "n": null, "target": null, "type": null, "text": "東土即吳會之間也"}
{"id": null, "n": null, "target": null, "type": null, "text": "今贈老壽將軍。皆出此時之勅。知前輔國必是將軍。\n胡靈二字諡也"}
{"id": null, "n": null, "target": null, "type": null, "text": "隋以大字為珠異也"}
{"id": null, "n": null, "target": null, "type": null, "text": "都即沙門都也"}
{"id": null, "n": null, "target": null, "type": null, "text": "一國之僧統也"}
{"id": null, "n": null, "target": null, "type": null, "text": "惟宮人出家勅補尼錄尼統。有至十字師名。比兩國邑號者甚眾"}
{"id": null, "n": null, "target": null, "type": null, "text": "九官曹多以都字為其總攝也"}
{"id": null, "n": null, "target": null, "type": null, "text": "別加大字"}
{"id": null, "n": null, "target": null, "type": null, "text": "左右街自起置功德使所屬。及置僧錄。還用左右街也僧置錄以錄\n之。功德又各轄焉"}
{"id": null, "n": null, "target": null, "type": null, "text": "章晏二公受僧錄見五運圖"}
{"id": null, "n": null, "target": null, "type": null, "text": "知曇曜前曾立副職"}
{"id": null, "n": null, "target": null, "type": null, "text": "即無封署"}
{"id": null, "n": null, "target": null, "type": null, "text": "導師之名而含二義。若法華經中。商人白導師。言此即引路指述也。若唱導之師。此即表白也。故宋\n衡陽王鎮江陵。因齋會無有導師。請曇光為導。及明帝設會。見光唱導稱善。勅賜三衣瓶鉢焉"}
{"id": null, "n": null, "target": null, "type": null, "text": "如節度使劉綐。出家物賜夏臘"}
{"id": null, "n": null, "target": null, "type": null, "text": "此名最勝"}
{"id": null, "n": null, "target": null, "type": null, "text": "後升為統"}
{"id": null, "n": null, "target": null, "type": null, "text": "與延載時不同"}
{"id": null, "n": null, "target": null, "type": null, "text": "又曾見僧五品非官品也"}
{"id": null, "n": null, "target": null, "type": null, "text": "見高僧傳"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐祠部牒皆綾素錦素鈿軸盖綸誥也。非官何謂"}
{"id": null, "n": null, "target": null, "type": null, "text": "告身即戒牒也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此不分前後齊行東西也"}
{"id": null, "n": null, "target": null, "type": null, "text": "尋文。是生日權建法會耳"}
{"id": null, "n": null, "target": null, "type": null, "text": "王縉造寶應寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "咸平二年重更修理"}
{"id": null, "n": null, "target": null, "type": null, "text": "內齋附"}
{"id": null, "n": null, "target": null, "type": null, "text": "德號附"}
{"id": null, "n": null, "target": null, "type": null, "text": "尼附"}
{"id": null, "n": null, "target": null, "type": null, "text": "方袍非綬"}
{"id": null, "n": null, "target": null, "type": null, "text": "新大雲經曰。終後生彌勒宮。不言則天是彌勒"}
{"id": null, "n": null, "target": null, "type": null, "text": "賜緋魚袋唯憲一人"}
{"id": null, "n": null, "target": null, "type": null, "text": "及烈僧名"}
{"id": null, "n": null, "target": null, "type": null, "text": "除魚袋也"}
{"id": null, "n": null, "target": null, "type": null, "text": "尋僧名。未見耳"}
{"id": null, "n": null, "target": null, "type": null, "text": "尋街分。各賜紫衣。自咸通始也"}
{"id": null, "n": null, "target": null, "type": null, "text": "加公一字"}
{"id": null, "n": null, "target": null, "type": null, "text": "止師一字"}
{"id": null, "n": null, "target": null, "type": null, "text": "分明言某大師。見五運圖"}
{"id": null, "n": null, "target": null, "type": null, "text": "比丘五人。尼五人也"}
{"id": null, "n": null, "target": null, "type": null, "text": "去聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "果為沙門統。\n封公爵。追贈胡靈諡也"}
{"id": null, "n": null, "target": null, "type": null, "text": "于時僧道混然大較是令毀戒僧入道也"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡神也。官品令有祆正"}
{"id": null, "n": null, "target": null, "type": null, "text": "火煙切"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "法道"}
{"id": null, "n": null, "target": null, "type": null, "text": "二月日　江州廬山東林大平興龍禪寺住持傳西天法特賜寶覺圓通法濟大師法道剳子"}
{"id": null, "n": null, "target": null, "type": null, "text": "梵安"}
{"id": null, "n": null, "target": null, "type": null, "text": "臨安府僧正慧通無礙大師梵安等"}
{"id": null, "n": null, "target": null, "type": null, "text": "梵安"}
{"id": null, "n": null, "target": null, "type": null, "text": "癸丑十一月二十四日呈訖。當月二十八日遍行天下"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T54n2131_p1145c27"}
