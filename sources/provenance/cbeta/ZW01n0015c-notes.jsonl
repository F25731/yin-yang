{"id": null, "n": "0382001", "target": "#nkr_note_orig_0382001", "type": "orig", "text": "甲本從此始。"}
{"id": null, "n": "0382002", "target": "#nkr_note_orig_0382002", "type": "orig", "text": "丁本從此始。"}
{"id": null, "n": "0382003", "target": "#nkr_note_orig_0382003", "type": "orig", "text": "「臨」，底本作「欲」，據丁本改。"}
{"id": null, "n": "0382004", "target": "#nkr_note_orig_0382004", "type": "orig", "text": "「復次」，甲、丁本作「次復」。"}
{"id": null, "n": "0382005", "target": "#nkr_note_orig_0382005", "type": "orig", "text": "「優波離」，諸本或作「優婆離」、「優波梨」，此處一並改作「優波離」，下同。"}
{"id": null, "n": "0382006", "target": "#nkr_note_orig_0382006", "type": "orig", "text": "「告」，甲、丁本作「報」。"}
{"id": null, "n": "0382007", "target": "#nkr_note_orig_0382007", "type": "orig", "text": "「已受」，底本作「以授」，據文意改。"}
{"id": null, "n": "0382008", "target": "#nkr_note_orig_0382008", "type": "orig", "text": "「吾今已受天魔所請」，丁本無。"}
{"id": null, "n": "0382009", "target": "#nkr_note_orig_0382009", "type": "orig", "text": "「鉢」，底本作「撥」，據甲本改。"}
{"id": null, "n": "0382010", "target": "#nkr_note_orig_0382010", "type": "orig", "text": "「忉」，丁本作「刀」。"}
{"id": null, "n": "0382011", "target": "#nkr_note_orig_0382011", "type": "orig", "text": "乙本從此始。"}
{"id": null, "n": "0383001", "target": "#nkr_note_orig_0383001", "type": "orig", "text": "「流」，丁本無。"}
{"id": null, "n": "0383002", "target": "#nkr_note_orig_0383002", "type": "orig", "text": "「磨」，乙本作「摩」。"}
{"id": null, "n": "0383003", "target": "#nkr_note_orig_0383003", "type": "orig", "text": "「憂愁」，底本作「秋憂」，據甲、乙、丁本改。"}
{"id": null, "n": "0383004", "target": "#nkr_note_orig_0383004", "type": "orig", "text": "丙本從此始。"}
{"id": null, "n": "0383005", "target": "#nkr_note_orig_0383005", "type": "orig", "text": "「德」，底本作「得」，據諸本改。"}
{"id": null, "n": "0383006", "target": "#nkr_note_orig_0383006", "type": "orig", "text": "「佛母」，丙本無。"}
{"id": null, "n": "0383007", "target": "#nkr_note_orig_0383007", "type": "orig", "text": "「聞」，甲、乙、丁本作「聞其」。"}
{"id": null, "n": "0383008", "target": "#nkr_note_orig_0383008", "type": "orig", "text": "「已」，底本作「以」，據文意改。"}
{"id": null, "n": "0383009", "target": "#nkr_note_orig_0383009", "type": "orig", "text": "「大」，甲本作「太」。"}
{"id": null, "n": "0383010", "target": "#nkr_note_orig_0383010", "type": "orig", "text": "「芬葩」，丙本作「妙光」。"}
{"id": null, "n": "0383011", "target": "#nkr_note_orig_0383011", "type": "orig", "text": "「以」，甲、丁本作「以將」，乙本作「將」。"}
{"id": null, "n": "0383012", "target": "#nkr_note_orig_0383012", "type": "orig", "text": "「天」，甲本作「天人」。"}
{"id": null, "n": "0383013", "target": "#nkr_note_orig_0383013", "type": "orig", "text": "「氈」，底、甲、丁本作「疊」，乙本作「𣱃」，丙本作「緤」，據文意改。"}
{"id": null, "n": "0383014", "target": "#nkr_note_orig_0383014", "type": "orig", "text": "「震」，底、甲、丁作「振」，據乙、丙本改。"}
{"id": null, "n": "0383015", "target": "#nkr_note_orig_0383015", "type": "orig", "text": "「剛」，底本作「光」，據諸本改。"}
{"id": null, "n": "0384001", "target": "#nkr_note_orig_0384001", "type": "orig", "text": "「梨」，乙本作「離」。"}
{"id": null, "n": "0384002", "target": "#nkr_note_orig_0384002", "type": "orig", "text": "「手」，乙、丙本作「守」。"}
{"id": null, "n": "0384003", "target": "#nkr_note_orig_0384003", "type": "orig", "text": "「分身」，甲本作「教化」。"}
{"id": null, "n": "0384004", "target": "#nkr_note_orig_0384004", "type": "orig", "text": "「護」，底本無，據諸本補。"}
{"id": null, "n": "0384005", "target": "#nkr_note_orig_0384005", "type": "orig", "text": "「云何」，諸本無。"}
{"id": null, "n": "0384006", "target": "#nkr_note_orig_0384006", "type": "orig", "text": "「悉達」，丙本無。"}
{"id": null, "n": "0384007", "target": "#nkr_note_orig_0384007", "type": "orig", "text": "「豁」，底、丁本作「壑」，據甲、乙、丙本改。"}
{"id": null, "n": "0384008", "target": "#nkr_note_orig_0384008", "type": "orig", "text": "「颯」，乙、丙本作「吸」。"}
{"id": null, "n": "0384009", "target": "#nkr_note_orig_0384009", "type": "orig", "text": "「而」，底本作「如」，據諸本改。"}
{"id": null, "n": "0384010", "target": "#nkr_note_orig_0384010", "type": "orig", "text": "「踴」，諸本皆作「勇」，據文意改。"}
{"id": null, "n": "0384011", "target": "#nkr_note_orig_0384011", "type": "orig", "text": "「間」，乙本無。"}
{"id": null, "n": "0384012", "target": "#nkr_note_orig_0384012", "type": "orig", "text": "「華」，丙本作「花」。"}
{"id": null, "n": "0384013", "target": "#nkr_note_orig_0384013", "type": "orig", "text": "「母！一切諸山，會有崩倒」，乙本無。"}
{"id": null, "n": "0384014", "target": "#nkr_note_orig_0384014", "type": "orig", "text": "「便即復沒」，甲、丁本作「便復沒矣」。"}
{"id": null, "n": "0385001", "target": "#nkr_note_orig_0385001", "type": "orig", "text": "「妙語」，甲、丁本作「妙義」，乙本作「此語」，丙本作「語已」。"}
{"id": null, "n": "0385002", "target": "#nkr_note_orig_0385002", "type": "orig", "text": "「轉」，底本作「輪」，乙本無，據甲、丙、丁本改。"}
{"id": null, "n": "0385003", "target": "#nkr_note_orig_0385003", "type": "orig", "text": "「女」，乙本無。"}
{"id": null, "n": "0385004", "target": "#nkr_note_orig_0385004", "type": "orig", "text": "「諸」，底本作「之」，據諸本改。"}
{"id": null, "n": "0385005", "target": "#nkr_note_orig_0385005", "type": "orig", "text": "「痛哉！苦哉！」，諸本無。"}
{"id": null, "n": "0385006", "target": "#nkr_note_orig_0385006", "type": "orig", "text": "「相」，底本作「想」，據諸本改。"}
{"id": null, "n": "0385007", "target": "#nkr_note_orig_0385007", "type": "orig", "text": "「一卷」，甲、丁本無。又本篇尾題，乙本作「佛母經」，丙本作「佛說佛母經」。"}
