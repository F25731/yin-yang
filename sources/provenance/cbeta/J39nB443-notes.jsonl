{"id": null, "n": null, "target": null, "type": null, "text": "著拈"}
{"id": null, "n": null, "target": null, "type": null, "text": "說甚有無"}
{"id": null, "n": null, "target": null, "type": null, "text": "諾"}
{"id": null, "n": null, "target": null, "type": null, "text": "即今"}
{"id": null, "n": null, "target": null, "type": null, "text": "諾"}
{"id": null, "n": null, "target": null, "type": null, "text": "即今"}
{"id": null, "n": null, "target": null, "type": null, "text": "諾"}
{"id": null, "n": null, "target": null, "type": null, "text": "老不歇心"}
{"id": null, "n": null, "target": null, "type": null, "text": "李四張三"}
{"id": null, "n": null, "target": null, "type": null, "text": "親言出親口"}
{"id": null, "n": null, "target": null, "type": null, "text": "普參聻"}
{"id": null, "n": null, "target": null, "type": null, "text": "恁麼那"}
{"id": null, "n": null, "target": null, "type": null, "text": "賞伊\n罰伊"}
{"id": null, "n": null, "target": null, "type": null, "text": "便好劈口𡎺"}
{"id": null, "n": null, "target": null, "type": null, "text": "此話問者甚多"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈出了也"}
{"id": null, "n": null, "target": null, "type": null, "text": "喚作境得麼"}
{"id": null, "n": null, "target": null, "type": null, "text": "剜心刳腹"}
{"id": null, "n": null, "target": null, "type": null, "text": "這邊向汝道底聻"}
{"id": null, "n": null, "target": null, "type": null, "text": "喏喏"}
{"id": null, "n": null, "target": null, "type": null, "text": "是非只為多開口"}
{"id": null, "n": null, "target": null, "type": null, "text": "不從人大來"}
{"id": null, "n": null, "target": null, "type": null, "text": "將謂目前無"}
{"id": null, "n": null, "target": null, "type": null, "text": "瞞得過阿誰"}
{"id": null, "n": null, "target": null, "type": null, "text": "和尚真同道者"}
{"id": null, "n": null, "target": null, "type": null, "text": "不從雲水\n來"}
{"id": null, "n": null, "target": null, "type": null, "text": "恭敬不如從命"}
{"id": null, "n": null, "target": null, "type": null, "text": "山河大地，如草如木"}
{"id": null, "n": null, "target": null, "type": null, "text": "賢者多勞"}
{"id": null, "n": null, "target": null, "type": null, "text": "問過始得"}
{"id": null, "n": null, "target": null, "type": null, "text": "太相生"}
{"id": null, "n": null, "target": null, "type": null, "text": "口胡\n心反"}
{"id": null, "n": null, "target": null, "type": null, "text": "禮下于人必有所求"}
{"id": null, "n": null, "target": null, "type": null, "text": "放過只不可"}
{"id": null, "n": null, "target": null, "type": null, "text": "莫犯當頭"}
{"id": null, "n": null, "target": null, "type": null, "text": "真門\n一釘"}
{"id": null, "n": null, "target": null, "type": null, "text": "元向你道"}
{"id": null, "n": null, "target": null, "type": null, "text": "苦哉苦哉"}
{"id": null, "n": null, "target": null, "type": null, "text": "冤家路窄"}
{"id": null, "n": null, "target": null, "type": null, "text": "莫針錐好"}
{"id": null, "n": null, "target": null, "type": null, "text": "築著磕著"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒼天蒼天"}
{"id": null, "n": null, "target": null, "type": null, "text": "猛虎口裏失身"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒼天中更加冤苦"}
{"id": null, "n": null, "target": null, "type": null, "text": "者裏恰好會取"}
{"id": null, "n": null, "target": null, "type": null, "text": "蹉過了也！"}
{"id": null, "n": null, "target": null, "type": null, "text": "為要徹"}
{"id": null, "n": null, "target": null, "type": null, "text": "還會\n\n疼麼"}
{"id": null, "n": null, "target": null, "type": null, "text": "作麼作麼"}
{"id": null, "n": null, "target": null, "type": null, "text": "夜叉頭菩薩面"}
{"id": null, "n": null, "target": null, "type": null, "text": "有多少奇特"}
{"id": null, "n": null, "target": null, "type": null, "text": "祗恐入眼成翳"}
{"id": null, "n": null, "target": null, "type": null, "text": "十萬八千程"}
{"id": null, "n": null, "target": null, "type": null, "text": ""}
{"id": null, "n": null, "target": null, "type": null, "text": "喏喏喏"}
{"id": null, "n": null, "target": null, "type": null, "text": "大似開眼說夢"}
{"id": null, "n": null, "target": null, "type": null, "text": "且聽分解"}
{"id": null, "n": null, "target": null, "type": null, "text": "也不得拖敬"}
{"id": null, "n": null, "target": null, "type": null, "text": "無一不辨"}
{"id": null, "n": null, "target": null, "type": null, "text": "油鹽費多少"}
{"id": null, "n": null, "target": null, "type": null, "text": "祗管下口"}
{"id": null, "n": null, "target": null, "type": null, "text": "闡提漢"}
{"id": null, "n": null, "target": null, "type": null, "text": "舉出了也"}
{"id": null, "n": null, "target": null, "type": null, "text": "一場\n懡㦬"}
{"id": null, "n": null, "target": null, "type": null, "text": "便好劈口𡎺"}
{"id": null, "n": null, "target": null, "type": null, "text": "耳根有事"}
{"id": null, "n": null, "target": null, "type": null, "text": "眼裏\n有"}
{"id": null, "n": null, "target": null, "type": null, "text": "鳴啼詩夢醒"}
{"id": null, "n": null, "target": null, "type": null, "text": "茶熟敬人來"}
{"id": null, "n": null, "target": null, "type": null, "text": "水向石邊流出冷"}
{"id": null, "n": null, "target": null, "type": null, "text": "風從花裏過來香"}
{"id": null, "n": null, "target": null, "type": null, "text": "瞞和尚不得"}
{"id": null, "n": null, "target": null, "type": null, "text": "老老大大來處也不識"}
{"id": null, "n": null, "target": null, "type": null, "text": "實實答"}
{"id": null, "n": null, "target": null, "type": null, "text": "一塵俱無何佛之有"}
{"id": null, "n": null, "target": null, "type": null, "text": "太潔白生"}
{"id": null, "n": null, "target": null, "type": null, "text": "只者箇更別有"}
{"id": null, "n": null, "target": null, "type": null, "text": "討甚碗"}
{"id": null, "n": null, "target": null, "type": null, "text": "東水流西澗水"}
{"id": null, "n": null, "target": null, "type": null, "text": "南山風送北山\n雲"}
{"id": null, "n": null, "target": null, "type": null, "text": "直至而今笑殺人"}
{"id": null, "n": null, "target": null, "type": null, "text": "儘力\n道不道"}
{"id": null, "n": null, "target": null, "type": null, "text": ""}
{"id": null, "n": null, "target": null, "type": null, "text": "賺過了也"}
{"id": null, "n": null, "target": null, "type": null, "text": "錯會不少"}
{"id": null, "n": null, "target": null, "type": null, "text": "謝師答話"}
{"id": null, "n": null, "target": null, "type": null, "text": "真實不虛"}
{"id": null, "n": null, "target": null, "type": null, "text": "也須問過"}
{"id": null, "n": null, "target": null, "type": null, "text": "賺過了也"}
{"id": null, "n": null, "target": null, "type": null, "text": "錯會不少"}
{"id": null, "n": null, "target": null, "type": null, "text": "賺過了也"}
{"id": null, "n": null, "target": null, "type": null, "text": "錯會不少"}
{"id": null, "n": null, "target": null, "type": null, "text": "唯唯"}
{"id": null, "n": null, "target": null, "type": null, "text": "唯唯唯"}
{"id": null, "n": null, "target": null, "type": null, "text": "作麼作麼"}
{"id": null, "n": null, "target": null, "type": null, "text": "太尊生"}
{"id": null, "n": null, "target": null, "type": null, "text": "本來無面"}
{"id": null, "n": null, "target": null, "type": null, "text": "作吐勢云不中飽人"}
{"id": null, "n": null, "target": null, "type": null, "text": "善哉善哉"}
{"id": null, "n": null, "target": null, "type": null, "text": "切忌說道理"}
{"id": null, "n": null, "target": null, "type": null, "text": "○"}
{"id": null, "n": null, "target": null, "type": null, "text": "○"}
{"id": null, "n": null, "target": null, "type": null, "text": "○"}
{"id": null, "n": null, "target": null, "type": null, "text": "○"}
{"id": null, "n": null, "target": null, "type": null, "text": "喏喏"}
{"id": null, "n": null, "target": null, "type": null, "text": "一二三四"}
{"id": null, "n": null, "target": null, "type": null, "text": "再道即不堪"}
{"id": null, "n": null, "target": null, "type": null, "text": "良人自斷"}
{"id": null, "n": null, "target": null, "type": null, "text": "不勞拈出"}
{"id": null, "n": null, "target": null, "type": null, "text": "拍掌云一場笑具"}
{"id": null, "n": null, "target": null, "type": null, "text": "有序"}
{"id": null, "n": null, "target": null, "type": null, "text": "亮自嬰孩沾師最，後參叩五雲，失依左右，不勝答"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X79n1557_p0037b19"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "J39nB443_p0335b07"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X79n1557_p0037b19"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "J39nB443_p0335b07"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "JM343_05_0022a04"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "《嘉興藏》（如是佛典徑山藏第200冊 《玉眉亮禪師語錄》第1卷第10頁左欄第1行）"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "《嘉興藏》（如是佛典徑山藏第200冊 《玉眉亮禪師語錄》第1卷第12頁左欄第4行）"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "《嘉興藏》（如是佛典徑山藏第200冊 《玉眉亮禪師語錄》第1卷第12頁左欄第10行）"}
{"id": null, "n": "0333c2401", "target": "#nkr_note_add_0333c2401", "type": "add", "text": "佳【CB】，隹【嘉興】"}
{"id": null, "n": "0334a0601", "target": "#nkr_note_add_0334a0601", "type": "add", "text": "CBETA 按：「」，疑作「聻」。"}
{"id": null, "n": "0334b0701", "target": "#nkr_note_add_0334b0701", "type": "add", "text": "已【CB】，【嘉興】"}
{"id": null, "n": "0334b1901", "target": "#nkr_note_add_0334b1901", "type": "add", "text": "已【CB】，巳【嘉興】"}
{"id": null, "n": "0335a0101", "target": "#nkr_note_add_0335a0101", "type": "add", "text": "蘗【CB】，蘖【嘉興】"}
{"id": null, "n": "0335b0901", "target": "#nkr_note_add_0335b0901", "type": "add", "text": "得問取【CB】，【嘉興】"}
{"id": null, "n": "0335b1001", "target": "#nkr_note_add_0335b1001", "type": "add", "text": "錯【CB】，【嘉興】"}
{"id": null, "n": "0335b1002", "target": "#nkr_note_add_0335b1002", "type": "add", "text": "我到【CB】，【嘉興】"}
{"id": null, "n": "0335b1101", "target": "#nkr_note_add_0335b1101", "type": "add", "text": "錯【CB】，【嘉興】"}
{"id": null, "n": "0335b1801", "target": "#nkr_note_add_0335b1801", "type": "add", "text": "CBETA 按：「」，疑作「喫」。"}
{"id": null, "n": "0335b2401", "target": "#nkr_note_add_0335b2401", "type": "add", "text": "具【CB】【嘉興丙-CB】，【嘉興】"}
{"id": null, "n": "0335c0601", "target": "#nkr_note_add_0335c0601", "type": "add", "text": "已【CB】，巳【嘉興】"}
{"id": null, "n": "0335c1001", "target": "#nkr_note_add_0335c1001", "type": "add", "text": "羨【CB】，羡【嘉興】"}
{"id": null, "n": "0335c1101", "target": "#nkr_note_add_0335c1101", "type": "add", "text": "補【CB】，【嘉興】"}
{"id": null, "n": "0335c3001", "target": "#nkr_note_add_0335c3001", "type": "add", "text": "已【CB】，巳【嘉興】"}
{"id": null, "n": "0336a2401", "target": "#nkr_note_add_0336a2401", "type": "add", "text": "因【CB】，【嘉興】"}
{"id": null, "n": "0336a3001", "target": "#nkr_note_add_0336a3001", "type": "add", "text": "退【CB】，【嘉興】"}
{"id": null, "n": "0336b1301", "target": "#nkr_note_add_0336b1301", "type": "add", "text": "CBETA 按：「」，疑作「今」。"}
{"id": null, "n": "0336c0301", "target": "#nkr_note_add_0336c0301", "type": "add", "text": "弱【CB】，【嘉興】"}
{"id": null, "n": "0337a0101", "target": "#nkr_note_add_0337a0101", "type": "add", "text": "CBETA 按：「」，疑作「登」。"}
