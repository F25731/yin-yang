{"id": null, "n": null, "target": null, "type": "cf1", "text": "K11n0250_p0542b06"}
{"id": null, "n": "0785003", "target": "#nkr_note_mod_0785003", "type": "mod", "text": "最【大】，佛說最【元】【明】"}
{"id": null, "n": "0785004", "target": "#nkr_note_mod_0785004", "type": "mod", "text": "大【大】，〔－〕【宋】【明】【宮】【聖】"}
{"id": null, "n": "0785005", "target": "#nkr_note_mod_0785005", "type": "mod", "text": "唐【大】，〔－〕【聖】"}
{"id": null, "n": "0785006", "target": "#nkr_note_mod_0785006", "type": "mod", "text": "詔【大】，制【聖】"}
{"id": null, "n": "0785007", "target": "#nkr_note_mod_0785007", "type": "mod", "text": "誓【大】，逝【明】"}
{"id": null, "n": "0785008", "target": "#nkr_note_mod_0785008", "type": "mod", "text": "覺【大】，見【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0785009", "target": "#nkr_note_mod_0785009", "type": "mod", "text": "贍【大】，瞻【宋】"}
{"id": null, "n": "0785010", "target": "#nkr_note_mod_0785010", "type": "mod", "text": "縱廣【大】下同，從廣【聖】下同"}
{"id": null, "n": "0785011", "target": "#nkr_note_mod_0785011", "type": "mod", "text": "箱【大】，廂【元】【明】"}
{"id": null, "n": "0785012", "target": "#nkr_note_mod_0785012", "type": "mod", "text": "側塞【大】下同，畟塞【元】【明】下同"}
{"id": null, "n": "0786001", "target": "#nkr_note_mod_0786001", "type": "mod", "text": "末香【大】下同，粖香【宋】【元】【宮】下同"}
{"id": null, "n": "0786002", "target": "#nkr_note_mod_0786002", "type": "mod", "text": "薰【大】下同，熏【宮】下同"}
{"id": null, "n": "0786003", "target": "#nkr_note_mod_0786003", "type": "mod", "text": "逮【大】，建【聖】"}
{"id": null, "n": "0786004", "target": "#nkr_note_mod_0786004", "type": "mod", "text": "圍【大】，園【聖】"}
{"id": null, "n": "0786005", "target": "#nkr_note_mod_0786005", "type": "mod", "text": "後【大】，後如法梵身收其遺骨【聖】"}
{"id": null, "n": "0787001", "target": "#nkr_note_mod_0787001", "type": "mod", "text": "贍【大】，瞻【宋】【元】"}
{"id": null, "n": "0787002", "target": "#nkr_note_mod_0787002", "type": "mod", "text": "天【大】，大【聖】"}
{"id": null, "n": "0787003", "target": "#nkr_note_mod_0787003", "type": "mod", "text": "樂化【大】，化樂【宋】【元】【明】【宮】，樂＋（變）【聖】"}
{"id": null, "n": "0787004", "target": "#nkr_note_mod_0787004", "type": "mod", "text": "可【大】，不【宋】【元】【明】【宮】"}
{"id": null, "n": "0787005", "target": "#nkr_note_mod_0787005", "type": "mod", "text": "若【大】，若有【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0787006", "target": "#nkr_note_mod_0787006", "type": "mod", "text": "一【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0787007", "target": "#nkr_note_mod_0787007", "type": "mod", "text": "妙【大】，妙速證無上正等菩提【宋】【元】【明】【宮】"}
{"id": null, "n": "0788002", "target": "#nkr_note_mod_0788002", "type": "mod", "text": "最【大】，佛說最【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0788003", "target": "#nkr_note_mod_0788003", "type": "mod", "text": "經【大】，經一卷【聖】"}
{"id": null, "n": "0785003", "target": "#nkr_note_orig_0785003", "type": "orig", "text": "（佛說）＋最【元】【明】"}
{"id": null, "n": "0785004", "target": "#nkr_note_orig_0785004", "type": "orig", "text": "〔大〕－【宋】【明】【宮】【聖】"}
{"id": null, "n": "0785005", "target": "#nkr_note_orig_0785005", "type": "orig", "text": "〔唐〕－【聖】"}
{"id": null, "n": "0785006", "target": "#nkr_note_orig_0785006", "type": "orig", "text": "詔＝制【聖】"}
{"id": null, "n": "0785007", "target": "#nkr_note_orig_0785007", "type": "orig", "text": "誓＝逝【明】"}
{"id": null, "n": "0785008", "target": "#nkr_note_orig_0785008", "type": "orig", "text": "覺＝見【三】【宮】【聖】"}
{"id": null, "n": "0785009", "target": "#nkr_note_orig_0785009", "type": "orig", "text": "贍＝瞻【宋】"}
{"id": null, "n": "0785010", "target": "#nkr_note_orig_0785010", "type": "orig", "text": "縱廣＝從廣【聖】下同"}
{"id": null, "n": "0785011", "target": "#nkr_note_orig_0785011", "type": "orig", "text": "箱＝廂【元】【明】"}
{"id": null, "n": "0785012", "target": "#nkr_note_orig_0785012", "type": "orig", "text": "側塞＝畟塞【元】【明】下同"}
{"id": null, "n": "0786001", "target": "#nkr_note_orig_0786001", "type": "orig", "text": "末香＝粖香【宋】【元】【宮】下同"}
{"id": null, "n": "0786002", "target": "#nkr_note_orig_0786002", "type": "orig", "text": "薰＝熏【宮】下同"}
{"id": null, "n": "0786003", "target": "#nkr_note_orig_0786003", "type": "orig", "text": "逮＝建【聖】"}
{"id": null, "n": "0786004", "target": "#nkr_note_orig_0786004", "type": "orig", "text": "圍＝園【聖】"}
{"id": null, "n": "0786005", "target": "#nkr_note_orig_0786005", "type": "orig", "text": "後＋（如法梵身收其遺骨）【聖】"}
{"id": null, "n": "0787001", "target": "#nkr_note_orig_0787001", "type": "orig", "text": "贍＝瞻【宋】【元】"}
{"id": null, "n": "0787002", "target": "#nkr_note_orig_0787002", "type": "orig", "text": "天＝大【聖】"}
{"id": null, "n": "0787003", "target": "#nkr_note_orig_0787003", "type": "orig", "text": "樂化＝化樂【三】【宮】，樂＋（變）【聖】"}
{"id": null, "n": "0787004", "target": "#nkr_note_orig_0787004", "type": "orig", "text": "可＝不【三】【宮】"}
{"id": null, "n": "0787005", "target": "#nkr_note_orig_0787005", "type": "orig", "text": "若＋（有）【三】【宮】【聖】"}
{"id": null, "n": "0787006", "target": "#nkr_note_orig_0787006", "type": "orig", "text": "〔一〕－【三】【宮】"}
{"id": null, "n": "0787007", "target": "#nkr_note_orig_0787007", "type": "orig", "text": "妙＋（速證無上正等菩提）【三】【宮】"}
{"id": null, "n": "0788001", "target": "#nkr_note_orig_0788001", "type": "orig", "text": "此下聖本有光明皇后願文"}
{"id": null, "n": "0788002", "target": "#nkr_note_orig_0788002", "type": "orig", "text": "（佛說）＋最【三】【宮】【聖】"}
