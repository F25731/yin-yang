{"id": null, "n": "0819022", "target": "#nkr_note_mod_0819022", "type": "mod", "text": "猗【大】，倚【宋】【元】【明】"}
{"id": null, "n": "0819023", "target": "#nkr_note_mod_0819023", "type": "mod", "text": "安息…藏【大】，沙門【宋】【元】【明】"}
{"id": null, "n": "0819024", "target": "#nkr_note_mod_0819024", "type": "mod", "text": "亦【大】，本【宋】【元】【明】"}
{"id": null, "n": "0819025", "target": "#nkr_note_mod_0819025", "type": "mod", "text": "有從致【大】，從癡有【宋】【元】【明】"}
{"id": null, "n": "0820001", "target": "#nkr_note_mod_0820001", "type": "mod", "text": "信【大】，信故【宋】【元】【明】"}
{"id": null, "n": "0820002", "target": "#nkr_note_mod_0820002", "type": "mod", "text": "已【大】＊，以【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0820003", "target": "#nkr_note_mod_0820003", "type": "mod", "text": "轉【大】，轉有【宋】【元】【明】"}
{"id": null, "n": "0820004", "target": "#nkr_note_mod_0820004", "type": "mod", "text": "受【大】，奉【宋】【元】【明】"}
{"id": null, "n": "0819022", "target": "#nkr_note_orig_0819022", "type": "orig", "text": "猗＝倚【三】"}
{"id": null, "n": "0819023", "target": "#nkr_note_orig_0819023", "type": "orig", "text": "安息…藏＝沙門【三】"}
{"id": null, "n": "0819024", "target": "#nkr_note_orig_0819024", "type": "orig", "text": "亦＝本【三】"}
{"id": null, "n": "0819025", "target": "#nkr_note_orig_0819025", "type": "orig", "text": "有從致＝從癡有【三】"}
{"id": null, "n": "0820001", "target": "#nkr_note_orig_0820001", "type": "orig", "text": "信＋（故）【三】"}
{"id": null, "n": "0820002", "target": "#nkr_note_orig_0820002", "type": "orig", "text": "已＝以【三】＊"}
{"id": null, "n": "0820003", "target": "#nkr_note_orig_0820003", "type": "orig", "text": "轉＋（有）【三】"}
{"id": null, "n": "0820004", "target": "#nkr_note_orig_0820004", "type": "orig", "text": "受＝奉【三】"}
