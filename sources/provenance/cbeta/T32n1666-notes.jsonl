{"id": null, "n": "0580a0601", "target": "#nkr_note_add_0580a0601", "type": "add", "text": "切【CB】【麗-CB】，初【大】"}
{"id": null, "n": "0582a2301", "target": "#nkr_note_add_0582a2301", "type": "add", "text": "即【CB】【麗-CB】，既【大】"}
{"id": null, "n": "0583a0101", "target": "#nkr_note_add_0583a0101", "type": "add", "text": "己【CB】，已【大】"}
{"id": null, "n": "0576009", "target": "#nkr_note_rest_0576009", "type": "rest", "text": "明註曰疏本無故字"}
{"id": null, "n": "0577005", "target": "#nkr_note_rest_0577005", "type": "rest", "text": "明註曰疏本無真如二字"}
{"id": null, "n": "0577006", "target": "#nkr_note_rest_0577006", "type": "rest", "text": "明註曰義下疏本無故字"}
{"id": null, "n": "0581012", "target": "#nkr_note_rest_0581012", "type": "rest", "text": "明註曰故下疏本無而字"}
{"id": null, "n": "0582010", "target": "#nkr_note_rest_0582010", "type": "rest", "text": "明註曰相疏本作想"}
