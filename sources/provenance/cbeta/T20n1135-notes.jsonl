{"id": null, "n": "0578002", "target": "#nkr_note_mod_0578002", "type": "mod", "text": "（開府…空）四十三字【大】，南天竺國三藏金剛智共沙門智藏【宋】【元】，唐南天竺國三藏金剛智共沙門智藏【明】【甲】"}
{"id": null, "n": "0578003", "target": "#nkr_note_mod_0578003", "type": "mod", "text": "在【大】，住【宋】【元】【明】【甲】"}
{"id": null, "n": "0578004", "target": "#nkr_note_mod_0578004", "type": "mod", "text": "遍【大】，逼【宋】【元】【明】【甲】"}
{"id": null, "n": "0578005", "target": "#nkr_note_mod_0578005", "type": "mod", "text": "唯【大】，惟【宋】【元】【明】【甲】"}
{"id": null, "n": "0578006", "target": "#nkr_note_mod_0578006", "type": "mod", "text": "令【大】，令如是【宋】【元】【明】【甲】"}
{"id": null, "n": "0578007", "target": "#nkr_note_mod_0578007", "type": "mod", "text": "驚【大】，警【宋】【元】【明】【甲】"}
{"id": null, "n": "0578008", "target": "#nkr_note_mod_0578008", "type": "mod", "text": "胵【大】，儞也二合去引【宋】【元】，儞也去聲二合引【明】【甲】"}
{"id": null, "n": "0578009", "target": "#nkr_note_mod_0578009", "type": "mod", "text": "攞【大】，攞引【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0578010", "target": "#nkr_note_mod_0578010", "type": "mod", "text": "彌娜知【大】，尾娜胝【宋】【元】【明】【甲】"}
{"id": null, "n": "0578011", "target": "#nkr_note_mod_0578011", "type": "mod", "text": "南【大】＊，喃【宋】【元】【明】【甲】＊"}
{"id": null, "n": "0578012", "target": "#nkr_note_mod_0578012", "type": "mod", "text": "都【大】，都六【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "六"}
{"id": null, "n": "0578013", "target": "#nkr_note_mod_0578013", "type": "mod", "text": "婆路誐六薩婆【大】，嚩路引誐薩嚩【宋】【元】【明】【甲】"}
{"id": null, "n": "0578014", "target": "#nkr_note_mod_0578014", "type": "mod", "text": "𪘜【大】，𪘨知解反八【宋】【元】，𪘨知解切八【明】【甲】"}
{"id": null, "n": "0578015", "target": "#nkr_note_mod_0578015", "type": "mod", "text": "（遮㘑…反）十一字【大】，摩賀娜𪘨十者㘑者㘑係麼澆【宋】【元】【明】【甲】"}
{"id": null, "n": "0578016", "target": "#nkr_note_mod_0578016", "type": "mod", "text": "尼【大】，尼去【宋】【元】，尼去聲【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "去"}
{"id": null, "n": null, "target": null, "type": null, "text": "去聲"}
{"id": null, "n": "0578017", "target": "#nkr_note_mod_0578017", "type": "mod", "text": "迷【大】，䜝【宋】【元】【明】【甲】"}
{"id": null, "n": "0578018", "target": "#nkr_note_mod_0578018", "type": "mod", "text": "抳【大】，抳麼抳【宋】【元】【明】【甲】"}
{"id": null, "n": "0578019", "target": "#nkr_note_mod_0578019", "type": "mod", "text": "戍戍【大】，戌戌【宋】【元】【明】【甲】"}
{"id": null, "n": "0578020", "target": "#nkr_note_mod_0578020", "type": "mod", "text": "毘【大】，毘引【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0578021", "target": "#nkr_note_mod_0578021", "type": "mod", "text": "覽【大】，囕【宋】【元】【明】【甲】"}
{"id": null, "n": "0578022", "target": "#nkr_note_mod_0578022", "type": "mod", "text": "毛【大】＊，謩【宋】【元】【明】【甲】＊"}
{"id": null, "n": "0578023", "target": "#nkr_note_mod_0578023", "type": "mod", "text": "二十五麼折囉【大】，嚩曰囉二合【宋】【元】【明】【甲】"}
{"id": null, "n": "0578024", "target": "#nkr_note_mod_0578024", "type": "mod", "text": "師【大】，曬【宋】【元】【明】【甲】"}
{"id": null, "n": "0578025", "target": "#nkr_note_mod_0578025", "type": "mod", "text": "二十六【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0578026", "target": "#nkr_note_mod_0578026", "type": "mod", "text": "訶【大】，二合賀引二十五【宋】【元】【明】【甲】"}
{"id": null, "n": "0578027", "target": "#nkr_note_mod_0578027", "type": "mod", "text": "引【大】＊，〔－〕【宋】【元】【明】【甲】＊"}
{"id": null, "n": "0578028", "target": "#nkr_note_mod_0578028", "type": "mod", "text": "二合引【大】，引二合【宋】【元】【明】【甲】"}
{"id": null, "n": "0578029", "target": "#nkr_note_mod_0578029", "type": "mod", "text": "訶引【大】，賀一引【宋】，賀引【元】，賀引一【明】【甲】"}
{"id": null, "n": "0578030", "target": "#nkr_note_mod_0578030", "type": "mod", "text": "亦【大】＊，〔－〕【宋】【元】【明】【甲】＊"}
{"id": null, "n": "0578031", "target": "#nkr_note_mod_0578031", "type": "mod", "text": "尼【大】＊，尼曰【宋】【元】【明】【甲】＊"}
{"id": null, "n": "0578032", "target": "#nkr_note_mod_0578032", "type": "mod", "text": "下同【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0578033", "target": "#nkr_note_mod_0578033", "type": "mod", "text": "尾【大】，尾二合【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0578034", "target": "#nkr_note_mod_0578034", "type": "mod", "text": "利【大】，利三【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": "0578035", "target": "#nkr_note_mod_0578035", "type": "mod", "text": "力【大】，力故【宋】【元】【明】【甲】"}
{"id": null, "n": "0578036", "target": "#nkr_note_mod_0578036", "type": "mod", "text": "囉【大】，羅【宋】【元】【明】【甲】"}
{"id": null, "n": "0578037", "target": "#nkr_note_mod_0578037", "type": "mod", "text": "登【大】，蹬【宋】【元】【明】【甲】"}
{"id": null, "n": "0578038", "target": "#nkr_note_mod_0578038", "type": "mod", "text": "一【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0578039", "target": "#nkr_note_mod_0578039", "type": "mod", "text": "登儗尼二【大】，蹬倪尼一【宋】【元】【明】【甲】"}
{"id": null, "n": "0578040", "target": "#nkr_note_mod_0578040", "type": "mod", "text": "麼輸麼【大】，摩輸【宋】【元】【明】【甲】"}
{"id": null, "n": "0578041", "target": "#nkr_note_mod_0578041", "type": "mod", "text": "三【大】，二【宋】【元】【明】【甲】"}
{"id": null, "n": "0578042", "target": "#nkr_note_mod_0578042", "type": "mod", "text": "𠼐【大】，哩引二【宋】【元】【明】【甲】"}
{"id": null, "n": "0578043", "target": "#nkr_note_mod_0578043", "type": "mod", "text": "麼麼麼【大】，嚩嚩嚩嚩二【宋】【元】【明】【甲】"}
{"id": null, "n": "0578044", "target": "#nkr_note_mod_0578044", "type": "mod", "text": "當【大】，當應【宋】【元】【明】【甲】"}
{"id": null, "n": "0578045", "target": "#nkr_note_mod_0578045", "type": "mod", "text": "讀【大】，誦【宋】【元】【明】【甲】"}
{"id": null, "n": "0578046", "target": "#nkr_note_mod_0578046", "type": "mod", "text": "咀【大】，詛【宋】【元】【明】【甲】"}
{"id": null, "n": "0578047", "target": "#nkr_note_mod_0578047", "type": "mod", "text": "佛說【大】，〔－〕【宋】【元】"}
{"id": null, "n": "0578001", "target": "#nkr_note_orig_0578001", "type": "orig", "text": "【原】麗本，【甲】黃檗版淨嚴等校訂加筆本"}
{"id": null, "n": "0578002", "target": "#nkr_note_orig_0578002", "type": "orig", "text": "（開府…空）四十三字＝（南天竺國三藏金剛智共沙門智藏）十四字【宋】【元】，（唐南天竺國三藏金剛智共沙門智藏）十五字【明】【甲】"}
{"id": null, "n": "0578003", "target": "#nkr_note_orig_0578003", "type": "orig", "text": "在＝住【三】【甲】"}
{"id": null, "n": "0578004", "target": "#nkr_note_orig_0578004", "type": "orig", "text": "遍＝逼【三】【甲】"}
{"id": null, "n": "0578005", "target": "#nkr_note_orig_0578005", "type": "orig", "text": "唯＝惟【三】【甲】"}
{"id": null, "n": "0578006", "target": "#nkr_note_orig_0578006", "type": "orig", "text": "令＋（如是）【三】【甲】"}
{"id": null, "n": "0578007", "target": "#nkr_note_orig_0578007", "type": "orig", "text": "驚＝警【三】【甲】"}
{"id": null, "n": "0578008", "target": "#nkr_note_orig_0578008", "type": "orig", "text": "胵＝儞也二合去引【宋】【元】，儞也去聲二合引【明】【甲】"}
{"id": null, "n": "0578009", "target": "#nkr_note_orig_0578009", "type": "orig", "text": "攞＋（引）細註【三】【甲】"}
{"id": null, "n": "0578010", "target": "#nkr_note_orig_0578010", "type": "orig", "text": "彌娜知＝尾娜胝【三】【甲】"}
{"id": null, "n": "0578011", "target": "#nkr_note_orig_0578011", "type": "orig", "text": "南＝喃【三】【甲】＊"}
{"id": null, "n": "0578012", "target": "#nkr_note_orig_0578012", "type": "orig", "text": "都＋（六）細註【三】【甲】"}
{"id": null, "n": "0578013", "target": "#nkr_note_orig_0578013", "type": "orig", "text": "婆路誐六薩婆＝嚩路引誐薩嚩【三】【甲】"}
{"id": null, "n": "0578014", "target": "#nkr_note_orig_0578014", "type": "orig", "text": "𪘜＝𪘨知解反八【宋】【元】，𪘨知解切八【明】【甲】"}
{"id": null, "n": "0578015", "target": "#nkr_note_orig_0578015", "type": "orig", "text": "（遮㘑…反）十一字＝（摩賀娜𪘨十者㘑者㘑係麼澆）十二字【三】【甲】"}
{"id": null, "n": "0578016", "target": "#nkr_note_orig_0578016", "type": "orig", "text": "尼＋（去）細註【宋】【元】，（去聲）細註【明】【甲】"}
{"id": null, "n": "0578017", "target": "#nkr_note_orig_0578017", "type": "orig", "text": "迷＝䜝【三】【甲】"}
{"id": null, "n": "0578018", "target": "#nkr_note_orig_0578018", "type": "orig", "text": "抳＋（麼抳）【三】【甲】"}
{"id": null, "n": "0578019", "target": "#nkr_note_orig_0578019", "type": "orig", "text": "戍戍＝戌戌【三】【甲】"}
{"id": null, "n": "0578020", "target": "#nkr_note_orig_0578020", "type": "orig", "text": "毘＋（引）細註【三】【甲】"}
{"id": null, "n": "0578021", "target": "#nkr_note_orig_0578021", "type": "orig", "text": "覽＝囕【三】【甲】"}
{"id": null, "n": "0578022", "target": "#nkr_note_orig_0578022", "type": "orig", "text": "毛＝謩【三】【甲】＊"}
{"id": null, "n": "0578023", "target": "#nkr_note_orig_0578023", "type": "orig", "text": "二十五麼折囉＝嚩曰囉二合【三】【甲】"}
