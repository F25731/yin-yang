{"id": null, "n": "0131001", "target": "#nkr_note_mod_0131001", "type": "mod", "text": "龍王【大】，佛說龍王【宋】【元】【明】【宮】"}
{"id": null, "n": "0131002", "target": "#nkr_note_mod_0131002", "type": "mod", "text": "月支【大】，月支國【明】"}
{"id": null, "n": "0131003", "target": "#nkr_note_mod_0131003", "type": "mod", "text": "邠低【大】下同，邠坻【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0131004", "target": "#nkr_note_mod_0131004", "type": "mod", "text": "摩訶【大】，大【宋】【元】【明】【宮】"}
{"id": null, "n": "0131005", "target": "#nkr_note_mod_0131005", "type": "mod", "text": "摩【大】，磨【宋】【元】【明】【宮】"}
{"id": null, "n": "0131006", "target": "#nkr_note_mod_0131006", "type": "mod", "text": "欲【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0131007", "target": "#nkr_note_mod_0131007", "type": "mod", "text": "出【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0131008", "target": "#nkr_note_mod_0131008", "type": "mod", "text": "必【大】，火【宋】【元】【明】【宮】"}
{"id": null, "n": "0131009", "target": "#nkr_note_mod_0131009", "type": "mod", "text": "其【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0131010", "target": "#nkr_note_mod_0131010", "type": "mod", "text": "須止【大】，慎止【宋】【元】【明】【宮】"}
{"id": null, "n": "0131011", "target": "#nkr_note_mod_0131011", "type": "mod", "text": "過【大】，越【宋】【元】【明】【宮】"}
{"id": null, "n": "0131012", "target": "#nkr_note_mod_0131012", "type": "mod", "text": "取劑【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0131013", "target": "#nkr_note_mod_0131013", "type": "mod", "text": "磨【大】，磨及【宋】【元】【明】【宮】"}
{"id": null, "n": "0131014", "target": "#nkr_note_mod_0131014", "type": "mod", "text": "以【大】，已【宋】【元】【明】【宮】"}
{"id": null, "n": "0131015", "target": "#nkr_note_mod_0131015", "type": "mod", "text": "乘【大】，持【宋】【元】【明】【宮】"}
{"id": null, "n": "0131016", "target": "#nkr_note_mod_0131016", "type": "mod", "text": "失【大】，夫【宮】"}
{"id": null, "n": "0131017", "target": "#nkr_note_mod_0131017", "type": "mod", "text": "毫【大】，豪【宋】【元】【明】【宮】"}
{"id": null, "n": "0131018", "target": "#nkr_note_mod_0131018", "type": "mod", "text": "龍王【大】，佛說龍王【明】"}
{"id": null, "n": "0131001", "target": "#nkr_note_orig_0131001", "type": "orig", "text": "（佛說）＋龍王【三】【宮】"}
