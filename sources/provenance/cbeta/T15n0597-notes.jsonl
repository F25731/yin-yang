{"id": null, "n": "0131007", "target": "#nkr_note_orig_0131007", "type": "orig", "text": "〔出〕－【三】【宮】"}
{"id": null, "n": "0131008", "target": "#nkr_note_orig_0131008", "type": "orig", "text": "必＝火【三】【宮】"}
{"id": null, "n": "0131009", "target": "#nkr_note_orig_0131009", "type": "orig", "text": "〔其〕－【三】【宮】"}
{"id": null, "n": "0131010", "target": "#nkr_note_orig_0131010", "type": "orig", "text": "須止＝慎止【三】【宮】"}
{"id": null, "n": "0131011", "target": "#nkr_note_orig_0131011", "type": "orig", "text": "過＝越【三】【宮】"}
{"id": null, "n": "0131012", "target": "#nkr_note_orig_0131012", "type": "orig", "text": "〔取劑〕－【三】【宮】"}
{"id": null, "n": "0131013", "target": "#nkr_note_orig_0131013", "type": "orig", "text": "磨＋（及）【三】【宮】"}
{"id": null, "n": "0131014", "target": "#nkr_note_orig_0131014", "type": "orig", "text": "以＝已【三】【宮】"}
{"id": null, "n": "0131015", "target": "#nkr_note_orig_0131015", "type": "orig", "text": "乘＝持【三】【宮】"}
{"id": null, "n": "0131016", "target": "#nkr_note_orig_0131016", "type": "orig", "text": "失＝夫【宮】"}
{"id": null, "n": "0131017", "target": "#nkr_note_orig_0131017", "type": "orig", "text": "毫＝豪【三】【宮】"}
{"id": null, "n": "0131018", "target": "#nkr_note_orig_0131018", "type": "orig", "text": "（佛說）＋龍王【明】"}
