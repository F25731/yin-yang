{"id": null, "n": "0060005", "target": "#nkr_note_mod_0060005", "type": "mod", "text": "頌【大】，〔－〕【宋】【元】【明】，Triṁśikā vijñaptikārikā."}
{"id": null, "n": "0060006", "target": "#nkr_note_mod_0060006", "type": "mod", "text": "大唐【大】，〔－〕【宋】【元】，唐【明】"}
{"id": null, "n": "0060007", "target": "#nkr_note_mod_0060007", "type": "mod", "text": "詶【大】，以【明】"}
{"id": null, "n": "0060013", "target": "#nkr_note_mod_0060013", "type": "mod", "text": "次【大】，此【宋】【元】【明】"}
{"id": null, "n": "0060015", "target": "#nkr_note_mod_0060015", "type": "mod", "text": "一切種 Sarva-bījaka.【CB】，一切種 Sarva-vījaka.【大】（CBETA 按：「種」字，梵語羅馬拼寫是 bīja，今依理校修訂原書校註 v 作 b。）"}
{"id": null, "n": "0060019", "target": "#nkr_note_mod_0060019", "type": "mod", "text": "了（別） Vijñaptika."}
{"id": null, "n": "0060022", "target": "#nkr_note_mod_0060022", "type": "mod", "text": "受 Vit(vedanā)."}
{"id": null, "n": "0060027", "target": "#nkr_note_mod_0060027", "type": "mod", "text": "瀑【大】，暴【宋】【元】【明】【宮】"}
{"id": null, "n": "0060029", "target": "#nkr_note_mod_0060029", "type": "mod", "text": "云【大】，去【明】"}
{"id": null, "n": "0060049", "target": "#nkr_note_mod_0060049", "type": "mod", "text": "慧 Dhīprajñā."}
{"id": null, "n": null, "target": null, "type": null, "text": "prajñā"}
{"id": null, "n": "0060055", "target": "#nkr_note_mod_0060055", "type": "mod", "text": "安（輕安） Praśrabdhi."}
{"id": null, "n": "0060056", "target": "#nkr_note_mod_0060056", "type": "mod", "text": "不放逸行 Apramāda."}
{"id": null, "n": "0060064", "target": "#nkr_note_mod_0060064", "type": "mod", "text": "惡見 Dṛś(mithyā dṛṣṭi)."}
{"id": null, "n": "0060069", "target": "#nkr_note_mod_0060069", "type": "mod", "text": "嫉Iṛṣyā."}
{"id": null, "n": "0060075", "target": "#nkr_note_mod_0060075", "type": "mod", "text": "無慚 Āhrī(āhrīkya)."}
{"id": null, "n": "0060076", "target": "#nkr_note_mod_0060076", "type": "mod", "text": "無愧 Atrapā(anapatrapāya)."}
{"id": null, "n": "0060078", "target": "#nkr_note_mod_0060078", "type": "mod", "text": "惛【大】，昏【宋】【元】【明】【宮】，惛沈 Styāna."}
{"id": null, "n": "0060085", "target": "#nkr_note_mod_0060085", "type": "mod", "text": "悔（惡作） Kaukṛtya."}
{"id": null, "n": "0060095", "target": "#nkr_note_mod_0060095", "type": "mod", "text": "由【大】，猶【宋】【元】【明】"}
{"id": null, "n": "0061001", "target": "#nkr_note_mod_0061001", "type": "mod", "text": "曰【大】，〔－〕【宋】【元】"}
{"id": null, "n": "0061011", "target": "#nkr_note_mod_0061011", "type": "mod", "text": "圓成實性 Niṣpanna(pariniṣpanna)."}
{"id": null, "n": "0061019", "target": "#nkr_note_mod_0061019", "type": "mod", "text": "常如其性故即唯識實性【大】，Sarvakā'aṁ tathābhāvāt saiva vijñaptimātratā."}
{"id": null, "n": "0061020", "target": "#nkr_note_mod_0061020", "type": "mod", "text": "五【大】，三【元】【明】"}
{"id": null, "n": "0061021", "target": "#nkr_note_mod_0061021", "type": "mod", "text": "等熏習所成【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0061023", "target": "#nkr_note_mod_0061023", "type": "mod", "text": "位【大】，謂【宋】【元】【明】"}
{"id": null, "n": "0061024", "target": "#nkr_note_mod_0061024", "type": "mod", "text": "住【大】，位【宋】【元】【明】"}
{"id": null, "n": "0060005", "target": "#nkr_note_orig_0060005", "type": "orig", "text": "Triṁśikā vijñaptikārikā.〔頌〕－【三】"}
{"id": null, "n": "0060006", "target": "#nkr_note_orig_0060006", "type": "orig", "text": "〔大唐〕－【宋】【元】，〔大〕－【明】"}
{"id": null, "n": "0060007", "target": "#nkr_note_orig_0060007", "type": "orig", "text": "詶＝以【明】"}
{"id": null, "n": "0060008", "target": "#nkr_note_orig_0060008", "type": "orig", "text": "識所變 Vijñāna-pariṇāma."}
{"id": null, "n": "0060009", "target": "#nkr_note_orig_0060009", "type": "orig", "text": "能變 Pariṇāma."}
{"id": null, "n": "0060010", "target": "#nkr_note_orig_0060010", "type": "orig", "text": "異熟 Vipāka."}
{"id": null, "n": "0060011", "target": "#nkr_note_orig_0060011", "type": "orig", "text": "思量 Manana."}
{"id": null, "n": "0060012", "target": "#nkr_note_orig_0060012", "type": "orig", "text": "了別境識 Viṣaya-vijñapti."}
{"id": null, "n": "0060013", "target": "#nkr_note_orig_0060013", "type": "orig", "text": "次＝此【三】"}
{"id": null, "n": "0060014", "target": "#nkr_note_orig_0060014", "type": "orig", "text": "阿賴耶識 Ālaya-vijñāna."}
{"id": null, "n": "0060015", "target": "#nkr_note_orig_0060015", "type": "orig", "text": "一切種 Sarva-vījaka."}
{"id": null, "n": "0060016", "target": "#nkr_note_orig_0060016", "type": "orig", "text": "不可知 Asaṁviditaka."}
{"id": null, "n": "0060017", "target": "#nkr_note_orig_0060017", "type": "orig", "text": "執受 Upādi."}
{"id": null, "n": "0060018", "target": "#nkr_note_orig_0060018", "type": "orig", "text": "處 Sthāna."}
{"id": null, "n": "0060019", "target": "#nkr_note_orig_0060019", "type": "orig", "text": "了（別） Vijñaptika."}
{"id": null, "n": "0060020", "target": "#nkr_note_orig_0060020", "type": "orig", "text": "觸 Sparśa."}
{"id": null, "n": "0060021", "target": "#nkr_note_orig_0060021", "type": "orig", "text": "作意 Manaskāra."}
{"id": null, "n": "0060022", "target": "#nkr_note_orig_0060022", "type": "orig", "text": "受 Vit(vedanā)."}
{"id": null, "n": "0060023", "target": "#nkr_note_orig_0060023", "type": "orig", "text": "想 Saṁjñā."}
{"id": null, "n": "0060024", "target": "#nkr_note_orig_0060024", "type": "orig", "text": "思 Cetanā."}
{"id": null, "n": "0060025", "target": "#nkr_note_orig_0060025", "type": "orig", "text": "捨 Upekṣā."}
{"id": null, "n": "0060026", "target": "#nkr_note_orig_0060026", "type": "orig", "text": "無覆無記 Artivṛtyākṛta."}
{"id": null, "n": "0060027", "target": "#nkr_note_orig_0060027", "type": "orig", "text": "瀑＝暴【三】【宮】"}
{"id": null, "n": "0060028", "target": "#nkr_note_orig_0060028", "type": "orig", "text": "捨 Vyāvṛtti."}
{"id": null, "n": "0060029", "target": "#nkr_note_orig_0060029", "type": "orig", "text": "云＝去【明】"}
{"id": null, "n": "0060030", "target": "#nkr_note_orig_0060030", "type": "orig", "text": "末那 Manas."}
{"id": null, "n": "0060031", "target": "#nkr_note_orig_0060031", "type": "orig", "text": "我癡 Ātma-moha."}
{"id": null, "n": "0060032", "target": "#nkr_note_orig_0060032", "type": "orig", "text": "我見 Ātma-dṛṣṭi."}
{"id": null, "n": "0060033", "target": "#nkr_note_orig_0060033", "type": "orig", "text": "我慢 Ātma-māna."}
{"id": null, "n": "0060034", "target": "#nkr_note_orig_0060034", "type": "orig", "text": "我愛 Ātma-sneha."}
{"id": null, "n": "0060035", "target": "#nkr_note_orig_0060035", "type": "orig", "text": "有覆無記 Nivrtāvyākrta."}
{"id": null, "n": "0060036", "target": "#nkr_note_orig_0060036", "type": "orig", "text": "滅定 Nirodha-samāpatti."}
{"id": null, "n": "0060037", "target": "#nkr_note_orig_0060037", "type": "orig", "text": "出世道 Lokottara-mārga."}
{"id": null, "n": "0060038", "target": "#nkr_note_orig_0060038", "type": "orig", "text": "了境 Viṣaya-upalabdhi."}
{"id": null, "n": "0060039", "target": "#nkr_note_orig_0060039", "type": "orig", "text": "心所 Caitasa."}
{"id": null, "n": "0060040", "target": "#nkr_note_orig_0060040", "type": "orig", "text": "遍行 Sarvatraga."}
{"id": null, "n": "0060041", "target": "#nkr_note_orig_0060041", "type": "orig", "text": "別境 Viniyata."}
{"id": null, "n": "0060042", "target": "#nkr_note_orig_0060042", "type": "orig", "text": "善 Kuśala."}
{"id": null, "n": "0060043", "target": "#nkr_note_orig_0060043", "type": "orig", "text": "煩惱 Kleśa."}
{"id": null, "n": "0060044", "target": "#nkr_note_orig_0060044", "type": "orig", "text": "隨煩惱 Upakleśa."}
{"id": null, "n": "0060045", "target": "#nkr_note_orig_0060045", "type": "orig", "text": "欲 Chanda."}
{"id": null, "n": "0060046", "target": "#nkr_note_orig_0060046", "type": "orig", "text": "勝解 Abhimokṣa."}
{"id": null, "n": "0060047", "target": "#nkr_note_orig_0060047", "type": "orig", "text": "念 Smṛti."}
{"id": null, "n": "0060048", "target": "#nkr_note_orig_0060048", "type": "orig", "text": "定 Samādhi."}
{"id": null, "n": "0060049", "target": "#nkr_note_orig_0060049", "type": "orig", "text": "慧 Dhīprajñā."}
{"id": null, "n": null, "target": null, "type": null, "text": "prajñā"}
{"id": null, "n": "0060050", "target": "#nkr_note_orig_0060050", "type": "orig", "text": "信 Śraddhā."}
{"id": null, "n": "0060051", "target": "#nkr_note_orig_0060051", "type": "orig", "text": "慚 Hrī."}
{"id": null, "n": "0060052", "target": "#nkr_note_orig_0060052", "type": "orig", "text": "愧 Apatrapā."}
{"id": null, "n": "0060053", "target": "#nkr_note_orig_0060053", "type": "orig", "text": "無貪 Alobha，無瞋 Adveśa，無癡 Amoha."}
{"id": null, "n": "0060054", "target": "#nkr_note_orig_0060054", "type": "orig", "text": "勤 Vīrya."}
{"id": null, "n": "0060055", "target": "#nkr_note_orig_0060055", "type": "orig", "text": "安（輕安） Praśrabdhi."}
{"id": null, "n": "0060056", "target": "#nkr_note_orig_0060056", "type": "orig", "text": "不放逸行 Apramāda."}
{"id": null, "n": "0060057", "target": "#nkr_note_orig_0060057", "type": "orig", "text": "捨 (upekṣā)"}
{"id": null, "n": "0060058", "target": "#nkr_note_orig_0060058", "type": "orig", "text": "不害 Ahiṁsā."}
{"id": null, "n": "0060059", "target": "#nkr_note_orig_0060059", "type": "orig", "text": "貪 Rāga."}
{"id": null, "n": "0060060", "target": "#nkr_note_orig_0060060", "type": "orig", "text": "瞋 Pratigha."}
{"id": null, "n": "0060061", "target": "#nkr_note_orig_0060061", "type": "orig", "text": "癡 Mūḍha."}
{"id": null, "n": "0060062", "target": "#nkr_note_orig_0060062", "type": "orig", "text": "慢 Māna."}
{"id": null, "n": "0060063", "target": "#nkr_note_orig_0060063", "type": "orig", "text": "疑 Vicikitsā."}
{"id": null, "n": "0060064", "target": "#nkr_note_orig_0060064", "type": "orig", "text": "惡見 Dṛś(mithyā dṛṣṭi)."}
{"id": null, "n": "0060065", "target": "#nkr_note_orig_0060065", "type": "orig", "text": "忿 Krodha."}
{"id": null, "n": "0060066", "target": "#nkr_note_orig_0060066", "type": "orig", "text": "恨 Upanāha."}
{"id": null, "n": "0060067", "target": "#nkr_note_orig_0060067", "type": "orig", "text": "覆 Mrakṣa."}
{"id": null, "n": "0060068", "target": "#nkr_note_orig_0060068", "type": "orig", "text": "惱 Pradāśa."}
{"id": null, "n": "0060069", "target": "#nkr_note_orig_0060069", "type": "orig", "text": "嫉 IIṛṣyā."}
{"id": null, "n": "0060070", "target": "#nkr_note_orig_0060070", "type": "orig", "text": "慳 Mātsarya."}
{"id": null, "n": "0060071", "target": "#nkr_note_orig_0060071", "type": "orig", "text": "誑 Śāṭhya."}
{"id": null, "n": "0060072", "target": "#nkr_note_orig_0060072", "type": "orig", "text": "諂 (māyā)."}
{"id": null, "n": "0060073", "target": "#nkr_note_orig_0060073", "type": "orig", "text": "害 Vihiṁsā."}
{"id": null, "n": "0060074", "target": "#nkr_note_orig_0060074", "type": "orig", "text": "憍 Mada."}
{"id": null, "n": "0060075", "target": "#nkr_note_orig_0060075", "type": "orig", "text": "無慚 Āhrī(āhrīkya)."}
{"id": null, "n": "0060076", "target": "#nkr_note_orig_0060076", "type": "orig", "text": "無愧 Atrapā(anapatrapāya)."}
{"id": null, "n": "0060077", "target": "#nkr_note_orig_0060077", "type": "orig", "text": "掉舉 Auddhatya."}
{"id": null, "n": "0060078", "target": "#nkr_note_orig_0060078", "type": "orig", "text": "惛＝昏【三】【宮】，惛沈 Styāna."}
{"id": null, "n": "0060079", "target": "#nkr_note_orig_0060079", "type": "orig", "text": "不信 Āśraddhya."}
{"id": null, "n": "0060080", "target": "#nkr_note_orig_0060080", "type": "orig", "text": "懈怠 Kauśīdya."}
{"id": null, "n": "0060081", "target": "#nkr_note_orig_0060081", "type": "orig", "text": "放逸 Pramāda."}
{"id": null, "n": "0060082", "target": "#nkr_note_orig_0060082", "type": "orig", "text": "失念 Muṣṭa-smṛṭati."}
{"id": null, "n": "0060083", "target": "#nkr_note_orig_0060083", "type": "orig", "text": "散亂 Vikṣepa."}
{"id": null, "n": "0060084", "target": "#nkr_note_orig_0060084", "type": "orig", "text": "不正知 Asamprajanya."}
{"id": null, "n": "0060085", "target": "#nkr_note_orig_0060085", "type": "orig", "text": "悔（惡作） Kaukṛtya."}
{"id": null, "n": "0060086", "target": "#nkr_note_orig_0060086", "type": "orig", "text": "眠 Middha."}
{"id": null, "n": "0060087", "target": "#nkr_note_orig_0060087", "type": "orig", "text": "尋 Vitarka."}
{"id": null, "n": "0060088", "target": "#nkr_note_orig_0060088", "type": "orig", "text": "伺 Vicāra."}
{"id": null, "n": "0060089", "target": "#nkr_note_orig_0060089", "type": "orig", "text": "根本識 Mūla-vijñāna"}
{"id": null, "n": "0060090", "target": "#nkr_note_orig_0060090", "type": "orig", "text": "意識 Manas."}
{"id": null, "n": "0060091", "target": "#nkr_note_orig_0060091", "type": "orig", "text": "無想天 Āsaṁjñika."}
{"id": null, "n": "0060092", "target": "#nkr_note_orig_0060092", "type": "orig", "text": "無心二定（無想定） Asaṁjñi-samāpatti.（滅盡定） nirodha-samāpatti."}
{"id": null, "n": "0060093", "target": "#nkr_note_orig_0060093", "type": "orig", "text": "睡眠 (acittaka)."}
{"id": null, "n": "0060094", "target": "#nkr_note_orig_0060094", "type": "orig", "text": "悶絕 Mūrcchā."}
{"id": null, "n": "0060095", "target": "#nkr_note_orig_0060095", "type": "orig", "text": "由＝猶【三】"}
{"id": null, "n": "0061001", "target": "#nkr_note_orig_0061001", "type": "orig", "text": "〔曰〕－【宋】【元】"}
{"id": null, "n": "0061002", "target": "#nkr_note_orig_0061002", "type": "orig", "text": "分別 Vikalpa."}
{"id": null, "n": "0061003", "target": "#nkr_note_orig_0061003", "type": "orig", "text": "唯識 Vijñapti-mātraka."}
{"id": null, "n": "0061004", "target": "#nkr_note_orig_0061004", "type": "orig", "text": "展轉力 Anyo'nyavaśa."}
{"id": null, "n": "0061005", "target": "#nkr_note_orig_0061005", "type": "orig", "text": "業習氣 Karma-vāśanā."}
{"id": null, "n": "0061006", "target": "#nkr_note_orig_0061006", "type": "orig", "text": "二取 Grāhadvaya（我執習氣 grāhya-grāha，名言習氣 grāhaka-grāha）."}
{"id": null, "n": "0061007", "target": "#nkr_note_orig_0061007", "type": "orig", "text": "遍計所執 Parikalpita."}
{"id": null, "n": "0061008", "target": "#nkr_note_orig_0061008", "type": "orig", "text": "自性 Svabhāva."}
{"id": null, "n": "0061009", "target": "#nkr_note_orig_0061009", "type": "orig", "text": "依他起自性 Paratantra-svabhāva."}
{"id": null, "n": "0061010", "target": "#nkr_note_orig_0061010", "type": "orig", "text": "分別緣所生 Vikalpaḥ pratyayodbhavaḥ."}
{"id": null, "n": "0061011", "target": "#nkr_note_orig_0061011", "type": "orig", "text": "圓成實性 Niṣpanna(pariniṣpanna)."}
{"id": null, "n": "0061012", "target": "#nkr_note_orig_0061012", "type": "orig", "text": "非不見此彼 （コレヲミズシテカレチミルモノニアラズ）Nādṛṣṭe asmin(pariniṣpanne)sa (paratantra-svabhāvo)dṛśyate."}
{"id": null, "n": "0061013", "target": "#nkr_note_orig_0061013", "type": "orig", "text": "三無性 Trividhā niḥsvabhāvatā."}
{"id": null, "n": "0061014", "target": "#nkr_note_orig_0061014", "type": "orig", "text": "一切法無性 Sarva-dharmānāṁ niḥsvabhāvatā."}
{"id": null, "n": "0061015", "target": "#nkr_note_orig_0061015", "type": "orig", "text": "相 Lakṣaṇa."}
{"id": null, "n": "0061016", "target": "#nkr_note_orig_0061016", "type": "orig", "text": "自然性 Svayaṁbhāva."}
{"id": null, "n": "0061017", "target": "#nkr_note_orig_0061017", "type": "orig", "text": "諸法勝義 Dharmānām paramārtha."}
{"id": null, "n": "0061018", "target": "#nkr_note_orig_0061018", "type": "orig", "text": "真如 Tathatā."}
{"id": null, "n": "0061019", "target": "#nkr_note_orig_0061019", "type": "orig", "text": "當如其性故即唯識實性 Sarvakā'aṁ tathābhāvāt saiva vijñaptimātratā."}
{"id": null, "n": "0061020", "target": "#nkr_note_orig_0061020", "type": "orig", "text": "五＝三【元】【明】"}
{"id": null, "n": "0061021", "target": "#nkr_note_orig_0061021", "type": "orig", "text": "〔等薰習所成〕－【三】"}
{"id": null, "n": "0061022", "target": "#nkr_note_orig_0061022", "type": "orig", "text": "Yāvad vijñapti-mātratve vijñānaṁ nāvatiṣṭhati | grāhadvayasyānuśayas tāvan vini vartate ||"}
{"id": null, "n": "0061023", "target": "#nkr_note_orig_0061023", "type": "orig", "text": "位＝謂【三】"}
{"id": null, "n": "0061024", "target": "#nkr_note_orig_0061024", "type": "orig", "text": "住＝位【三】"}
{"id": null, "n": "0061025", "target": "#nkr_note_orig_0061025", "type": "orig", "text": "若時於所緣智都無所得 Yadā tv ālambanaṁ vijñānaṁ naivopalabhate tadā."}
{"id": null, "n": "0061026", "target": "#nkr_note_orig_0061026", "type": "orig", "text": "無得不思議 Acintyo'nupalambhaḥ"}
{"id": null, "n": "0061027", "target": "#nkr_note_orig_0061027", "type": "orig", "text": "出世間智 Lakottara-jñāna."}
{"id": null, "n": "0061028", "target": "#nkr_note_orig_0061028", "type": "orig", "text": "捨麁重 Dauṣṭhulyahāni."}
{"id": null, "n": "0061029", "target": "#nkr_note_orig_0061029", "type": "orig", "text": "轉依 Āśrayasya parāvṛttiḥ （變住 mvp. 131）"}
{"id": null, "n": "0061030", "target": "#nkr_note_orig_0061030", "type": "orig", "text": "無漏界 Anāśravī dhātuḥ."}
{"id": null, "n": "0061031", "target": "#nkr_note_orig_0061031", "type": "orig", "text": "善 Kuśala."}
{"id": null, "n": "0061032", "target": "#nkr_note_orig_0061032", "type": "orig", "text": "常 Dhruva."}
{"id": null, "n": "0061033", "target": "#nkr_note_orig_0061033", "type": "orig", "text": "安樂解脫身 Sukhīvimukti-kāyaḥ."}
{"id": null, "n": "0061034", "target": "#nkr_note_orig_0061034", "type": "orig", "text": "大牟尼名法 Dharmākhyo 'yam mahāmuneḥ."}
{"id": null, "n": null, "target": "#nkr_note_foreign_0060005", "type": null, "text": "Triṁśikā vijñaptikārikā."}
{"id": null, "n": null, "target": "#nkr_note_foreign_0061022", "type": null, "text": "Yāvad vijñapti-mātratve vijñānaṁ nāvatiṣṭhati | grāhadvayasyānuśayas tāvan vini vartate ||"}
