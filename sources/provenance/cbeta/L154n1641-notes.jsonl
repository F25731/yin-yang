{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": null, "target": null, "type": null, "text": "他計切音替削髮也"}
{"id": null, "n": null, "target": null, "type": null, "text": "呼侯切吼平聲氣急也"}
{"id": null, "n": null, "target": null, "type": null, "text": "邊迷切音鎞"}
{"id": null, "n": null, "target": null, "type": null, "text": "罔古切音武侵也"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "𭆞時舉上𣗳話"}
{"id": null, "n": null, "target": null, "type": null, "text": "吉岳切音覺草履也"}
{"id": null, "n": null, "target": null, "type": null, "text": "陟慮切音註飛舉也"}
{"id": null, "n": null, "target": null, "type": null, "text": "弦雞切音奚小鼠也"}
{"id": null, "n": null, "target": null, "type": null, "text": "朱惟切音追馬也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上平鏗切咸去聲下疾正切音淨坑坎也"}
{"id": null, "n": null, "target": null, "type": null, "text": "余六切音欲賣也"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": null, "target": null, "type": null, "text": "丑禁切琛去聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡孔切洪上聲水銀"}
{"id": null, "n": null, "target": null, "type": null, "text": "上母黨切茫上聲下\n郎古切音魯莽鹵輕脫苟且也"}
{"id": null, "n": null, "target": null, "type": null, "text": "󵙱故切呼去聲杼水器"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "於歇切音謁食窒氣不通也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上朱倫切音肫下祥亦切音席\n窀穸墓穴幽堂也"}
{"id": null, "n": null, "target": null, "type": null, "text": "下皮賔切音貧眉蹙也又強學人曰效顰"}
{"id": null, "n": null, "target": null, "type": null, "text": "莫胡切音模醜嫗"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": null, "target": null, "type": null, "text": "無暮切音務"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡對切音會"}
{"id": null, "n": null, "target": null, "type": null, "text": "即涉切音接"}
{"id": null, "n": null, "target": null, "type": null, "text": "牀陷切"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒲沒切盆入聲󵙷餑也"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒲靡切音皮"}
{"id": null, "n": null, "target": null, "type": null, "text": "思留切音修"}
{"id": null, "n": null, "target": null, "type": null, "text": "華山蘭若"}
{"id": null, "n": null, "target": null, "type": null, "text": "荊山旅堂"}
{"id": null, "n": null, "target": null, "type": null, "text": "三却竹林"}
{"id": null, "n": null, "target": null, "type": null, "text": "舟次東昌"}
{"id": null, "n": null, "target": null, "type": null, "text": "先錄法濟十咏之一有此名"}
{"id": null, "n": null, "target": null, "type": null, "text": "三首"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "癸丑燈前"}
{"id": null, "n": null, "target": null, "type": null, "text": "菴名船子"}
{"id": null, "n": null, "target": null, "type": null, "text": "通光先磬山親題法名"}
{"id": null, "n": null, "target": null, "type": null, "text": "有引"}
{"id": null, "n": null, "target": null, "type": null, "text": "大士誕舟次下相"}
{"id": null, "n": null, "target": null, "type": null, "text": "懷徐羣玉"}
{"id": null, "n": null, "target": null, "type": null, "text": "尊柴頭一生擇木三遷勤普為眾臨寂撥置後事顓\n持藥師名號數日泊然坐脫"}
{"id": null, "n": null, "target": null, "type": null, "text": "顯圜頭勤樸十年如一日歲饑禾麥而園蔬獨豐一\n眾頼之"}
{"id": null, "n": null, "target": null, "type": null, "text": "老成衣鉢"}
{"id": null, "n": null, "target": null, "type": null, "text": "老成衣鉢"}
{"id": null, "n": null, "target": null, "type": null, "text": "苦臭切傾入聲寂靜也"}
{"id": null, "n": null, "target": null, "type": null, "text": "河干切音寒地名"}
{"id": null, "n": null, "target": null, "type": null, "text": "秦醉切音萃"}
{"id": null, "n": null, "target": null, "type": null, "text": "移亷切音炎步廊"}
