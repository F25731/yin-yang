{"id": null, "n": null, "target": null, "type": null, "text": "慶元府普照戒禪師"}
{"id": null, "n": null, "target": null, "type": null, "text": "機語未見"}
{"id": null, "n": null, "target": null, "type": null, "text": "臨濟十二世黃龍五世"}
