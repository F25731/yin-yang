{"id": null, "n": null, "target": null, "type": null, "text": "上"}
{"id": null, "n": null, "target": null, "type": null, "text": "下安四葉，上著三葉"}
{"id": null, "n": "0778027", "target": "#nkr_note_mod_0778027", "type": "mod", "text": "得【大】，悉得【甲】【乙】"}
{"id": null, "n": "0778028", "target": "#nkr_note_mod_0778028", "type": "mod", "text": "漊【大】，縷【甲】"}
{"id": null, "n": "0778029", "target": "#nkr_note_mod_0778029", "type": "mod", "text": "不【大】，不得【甲】"}
{"id": null, "n": "0778030", "target": "#nkr_note_mod_0778030", "type": "mod", "text": "用【大】，用用【乙】"}
{"id": null, "n": "0778031", "target": "#nkr_note_mod_0778031", "type": "mod", "text": "右【大】，左【考偽-原】"}
{"id": null, "n": "0778032", "target": "#nkr_note_mod_0778032", "type": "mod", "text": "左【大】，右【乙】"}
{"id": null, "n": "0778033", "target": "#nkr_note_mod_0778033", "type": "mod", "text": "像【大】，於像【甲】"}
{"id": null, "n": "0778034", "target": "#nkr_note_mod_0778034", "type": "mod", "text": "畫【大】，於畫【甲】"}
{"id": null, "n": "0778035", "target": "#nkr_note_mod_0778035", "type": "mod", "text": "瞻【大】，膽【乙】"}
{"id": null, "n": "0778036", "target": "#nkr_note_mod_0778036", "type": "mod", "text": "呪一【大】，器【甲】"}
{"id": null, "n": "0778037", "target": "#nkr_note_mod_0778037", "type": "mod", "text": "聲【大】，大聲【甲】"}
{"id": null, "n": "0778038", "target": "#nkr_note_mod_0778038", "type": "mod", "text": "不【大】，〔－〕【乙】"}
{"id": null, "n": "0778039", "target": "#nkr_note_mod_0778039", "type": "mod", "text": "却【大】，劫【甲】"}
{"id": null, "n": "0778040", "target": "#nkr_note_mod_0778040", "type": "mod", "text": "紫【大】，用紫【甲】"}
{"id": null, "n": "0778041", "target": "#nkr_note_mod_0778041", "type": "mod", "text": "剋【大】，刻【考偽-原】，克【甲】"}
{"id": null, "n": "0778042", "target": "#nkr_note_mod_0778042", "type": "mod", "text": "末【大】，未【乙】"}
{"id": null, "n": "0778043", "target": "#nkr_note_mod_0778043", "type": "mod", "text": "至【大】，至于【甲】"}
{"id": null, "n": "0778044", "target": "#nkr_note_mod_0778044", "type": "mod", "text": "兩【大】，雨【乙】"}
{"id": null, "n": "0778045", "target": "#nkr_note_mod_0778045", "type": "mod", "text": "葉花【大】，〔－〕【考偽-原】"}
{"id": null, "n": "0778046", "target": "#nkr_note_mod_0778046", "type": "mod", "text": "蝕【大】＊，食【甲】＊"}
{"id": null, "n": "0778047", "target": "#nkr_note_mod_0778047", "type": "mod", "text": "蒲【大】＊，𮑱【甲】【乙】＊"}
{"id": null, "n": "0778048", "target": "#nkr_note_mod_0778048", "type": "mod", "text": "糞【大】，戴【甲】"}
{"id": null, "n": "0778049", "target": "#nkr_note_mod_0778049", "type": "mod", "text": "果禮【大】，覆【考偽-原】，裏【甲】"}
{"id": null, "n": "0778050", "target": "#nkr_note_mod_0778050", "type": "mod", "text": "壽【大】，壽命【甲】"}
{"id": null, "n": "0779001", "target": "#nkr_note_mod_0779001", "type": "mod", "text": "央【大】，史【甲】【乙】"}
{"id": null, "n": "0779002", "target": "#nkr_note_mod_0779002", "type": "mod", "text": "日【大】，口【甲】"}
{"id": null, "n": "0779003", "target": "#nkr_note_mod_0779003", "type": "mod", "text": "含【大】，口中念【甲】"}
{"id": null, "n": "0779004", "target": "#nkr_note_mod_0779004", "type": "mod", "text": "釘【大】，丁【考偽-原】"}
{"id": null, "n": "0779005", "target": "#nkr_note_mod_0779005", "type": "mod", "text": "口【大】，口中【乙】"}
{"id": null, "n": "0779006", "target": "#nkr_note_mod_0779006", "type": "mod", "text": "含【大】，中念【甲】"}
{"id": null, "n": "0779007", "target": "#nkr_note_mod_0779007", "type": "mod", "text": "滿【大】，誦滿【甲】"}
{"id": null, "n": "0779008", "target": "#nkr_note_mod_0779008", "type": "mod", "text": "蒙【大】，義【甲】"}
{"id": null, "n": "0779009", "target": "#nkr_note_mod_0779009", "type": "mod", "text": "一【大】，一丸【甲】"}
{"id": null, "n": "0779010", "target": "#nkr_note_mod_0779010", "type": "mod", "text": "即【大】，即得【甲】"}
{"id": null, "n": "0779011", "target": "#nkr_note_mod_0779011", "type": "mod", "text": "撮【大】，撮一撮【甲】"}
{"id": null, "n": "0779012", "target": "#nkr_note_mod_0779012", "type": "mod", "text": "呪【大】，地【甲】"}
{"id": null, "n": "0779013", "target": "#nkr_note_mod_0779013", "type": "mod", "text": "耶【大】，邪【乙】"}
{"id": null, "n": "0779014", "target": "#nkr_note_mod_0779014", "type": "mod", "text": "坐【大】，於壇上坐【甲】"}
{"id": null, "n": "0778026", "target": "#nkr_note_orig_0778026", "type": "orig", "text": "【原】享和元年刊豐山大學藏本，【甲】永曆元年寫東寺三密藏本，【乙】久安五年寫高山寺藏本"}
{"id": null, "n": "0778027", "target": "#nkr_note_orig_0778027", "type": "orig", "text": "（悉）＋得【甲】【乙】"}
{"id": null, "n": "0778028", "target": "#nkr_note_orig_0778028", "type": "orig", "text": "漊＝縷【甲】"}
{"id": null, "n": "0778029", "target": "#nkr_note_orig_0778029", "type": "orig", "text": "不＋（得）【甲】"}
{"id": null, "n": "0778030", "target": "#nkr_note_orig_0778030", "type": "orig", "text": "用＋（用）【乙】"}
{"id": null, "n": "0778031", "target": "#nkr_note_orig_0778031", "type": "orig", "text": "右＝左ヵ【原】"}
{"id": null, "n": "0778032", "target": "#nkr_note_orig_0778032", "type": "orig", "text": "左＝右【乙】"}
{"id": null, "n": "0778033", "target": "#nkr_note_orig_0778033", "type": "orig", "text": "（於）＋像【甲】"}
{"id": null, "n": "0778034", "target": "#nkr_note_orig_0778034", "type": "orig", "text": "（於）＋畫【甲】"}
{"id": null, "n": "0778035", "target": "#nkr_note_orig_0778035", "type": "orig", "text": "瞻＝膽【乙】"}
{"id": null, "n": "0778036", "target": "#nkr_note_orig_0778036", "type": "orig", "text": "呪一＝器【甲】"}
{"id": null, "n": "0778037", "target": "#nkr_note_orig_0778037", "type": "orig", "text": "（大）＋聲【甲】"}
{"id": null, "n": "0778038", "target": "#nkr_note_orig_0778038", "type": "orig", "text": "〔不〕－【乙】"}
{"id": null, "n": "0778039", "target": "#nkr_note_orig_0778039", "type": "orig", "text": "却＝劫【甲】"}
{"id": null, "n": "0778040", "target": "#nkr_note_orig_0778040", "type": "orig", "text": "（用）＋紫【甲】"}
{"id": null, "n": "0778041", "target": "#nkr_note_orig_0778041", "type": "orig", "text": "剋＝刻ヵ【原】，克【甲】"}
{"id": null, "n": "0778042", "target": "#nkr_note_orig_0778042", "type": "orig", "text": "末＝未【乙】"}
{"id": null, "n": "0778043", "target": "#nkr_note_orig_0778043", "type": "orig", "text": "至＋（于）【甲】"}
{"id": null, "n": "0778044", "target": "#nkr_note_orig_0778044", "type": "orig", "text": "兩＝雨【乙】"}
{"id": null, "n": "0778045", "target": "#nkr_note_orig_0778045", "type": "orig", "text": "〔葉花〕－ヵ【原】"}
{"id": null, "n": "0778046", "target": "#nkr_note_orig_0778046", "type": "orig", "text": "蝕＝食【甲】＊"}
{"id": null, "n": "0778047", "target": "#nkr_note_orig_0778047", "type": "orig", "text": "蒲＝𮑱【甲】【乙】＊"}
{"id": null, "n": "0778048", "target": "#nkr_note_orig_0778048", "type": "orig", "text": "糞＝戴【甲】"}
{"id": null, "n": "0778049", "target": "#nkr_note_orig_0778049", "type": "orig", "text": "果禮＝覆ヵ【原】，裏【甲】"}
{"id": null, "n": "0778050", "target": "#nkr_note_orig_0778050", "type": "orig", "text": "壽＋（命）【甲】"}
{"id": null, "n": "0779001", "target": "#nkr_note_orig_0779001", "type": "orig", "text": "央＝史【甲】【乙】"}
{"id": null, "n": "0779002", "target": "#nkr_note_orig_0779002", "type": "orig", "text": "日＝口【甲】"}
{"id": null, "n": "0779003", "target": "#nkr_note_orig_0779003", "type": "orig", "text": "含＝口中念【甲】"}
{"id": null, "n": "0779004", "target": "#nkr_note_orig_0779004", "type": "orig", "text": "釘＝丁ヵ【原】"}
{"id": null, "n": "0779005", "target": "#nkr_note_orig_0779005", "type": "orig", "text": "口＋（中）【乙】"}
{"id": null, "n": "0779006", "target": "#nkr_note_orig_0779006", "type": "orig", "text": "含＝中念【甲】"}
{"id": null, "n": "0779007", "target": "#nkr_note_orig_0779007", "type": "orig", "text": "（誦）＋滿【甲】"}
{"id": null, "n": "0779008", "target": "#nkr_note_orig_0779008", "type": "orig", "text": "蒙＝義【甲】"}
{"id": null, "n": "0779009", "target": "#nkr_note_orig_0779009", "type": "orig", "text": "一＋（丸）【甲】"}
{"id": null, "n": "0779010", "target": "#nkr_note_orig_0779010", "type": "orig", "text": "即＋（得）【甲】"}
{"id": null, "n": "0779011", "target": "#nkr_note_orig_0779011", "type": "orig", "text": "撮＋（一撮）【甲】"}
{"id": null, "n": "0779012", "target": "#nkr_note_orig_0779012", "type": "orig", "text": "呪＝地【甲】"}
{"id": null, "n": "0779013", "target": "#nkr_note_orig_0779013", "type": "orig", "text": "耶＝邪【乙】"}
{"id": null, "n": "0779014", "target": "#nkr_note_orig_0779014", "type": "orig", "text": "（於壇上）＋坐【甲】"}
{"id": null, "n": "0779015", "target": "#nkr_note_orig_0779015", "type": "orig", "text": "此下甲本奧云永曆元年十月十四日於勸修寺西山住房書校了興然，乙本奧云久安五年二月五日奉寫了，末流真宗之本"}
{"id": null, "n": "0779016", "target": "#nkr_note_orig_0779016", "type": "orig", "text": "甲本乙本俱以下無之"}
