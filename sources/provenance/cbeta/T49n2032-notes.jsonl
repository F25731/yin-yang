{"id": null, "n": null, "target": null, "type": null, "text": "此言大眾老小\n同會共集律部也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此言老宿唯老宿人同會共出律部也"}
{"id": null, "n": null, "target": null, "type": null, "text": "所執與僧祇同故言一也"}
{"id": null, "n": null, "target": null, "type": null, "text": "稱讚辭也"}
{"id": null, "n": null, "target": null, "type": null, "text": "是出律主姓也"}
{"id": null, "n": null, "target": null, "type": null, "text": "出律主有多聞智也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此山名出律主居處也"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦律主所居處也"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦律主居處"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主執三\n世有故一切所語言也"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦律主行處也"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主姓也"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主名也"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主名也"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主為通人所重也"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主居處也"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主初生母棄之井。父追尋之。雖墜不\n夭。故云不棄也。又名能射"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主名也"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主姓也"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主執修妬路義也"}
{"id": null, "n": null, "target": null, "type": null, "text": "秦言上座部也"}
{"id": null, "n": null, "target": null, "type": null, "text": "稱讚辭也"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T49n2032_p0017c10"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T14n0468_p0501b24"}
{"id": null, "n": null, "target": null, "type": "cf3", "text": "K29n0976_p0563c01"}
{"id": null, "n": "0017013", "target": "#nkr_note_mod_0017013", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0017014", "target": "#nkr_note_mod_0017014", "type": "mod", "text": "陳真諦譯【大】，失譯【宋】【元】【宮】，失譯人名【明】"}
{"id": null, "n": "0017015", "target": "#nkr_note_mod_0017015", "type": "mod", "text": "四【大】，白【明】"}
{"id": null, "n": "0017016", "target": "#nkr_note_mod_0017016", "type": "mod", "text": "密【大】，蜜【宋】【元】【明】【宮】"}
{"id": null, "n": "0017017", "target": "#nkr_note_mod_0017017", "type": "mod", "text": "（此二…百歲）十七字【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0017018", "target": "#nkr_note_mod_0017018", "type": "mod", "text": "（名出…一部）二十三字【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0017019", "target": "#nkr_note_mod_0017019", "type": "mod", "text": "所【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0017020", "target": "#nkr_note_mod_0017020", "type": "mod", "text": "處【大】，處也【宋】【元】【明】【宮】"}
{"id": null, "n": "0017021", "target": "#nkr_note_mod_0017021", "type": "mod", "text": "賢部【大】，名賢【宋】【元】【明】【宮】"}
{"id": null, "n": "0017022", "target": "#nkr_note_mod_0017022", "type": "mod", "text": "義【大】，我【宮】"}
{"id": null, "n": "0017023", "target": "#nkr_note_mod_0017023", "type": "mod", "text": "體【CB】【麗-CB】【宋】【元】【明】【宮】，大【大】"}
{"id": null, "n": "0017024", "target": "#nkr_note_mod_0017024", "type": "mod", "text": "二十【大】，十二【宋】【元】【明】【宮】"}
{"id": null, "n": "0018001", "target": "#nkr_note_mod_0018001", "type": "mod", "text": "得【大】，渴【宋】【元】【宮】"}
{"id": null, "n": "0018002", "target": "#nkr_note_mod_0018002", "type": "mod", "text": "勝【大】，聖【宋】【元】【明】"}
{"id": null, "n": "0018003", "target": "#nkr_note_mod_0018003", "type": "mod", "text": "巴連【大】，已達【宋】【元】【明】【宮】"}
{"id": null, "n": "0018004", "target": "#nkr_note_mod_0018004", "type": "mod", "text": "知【大】，如【宋】【元】【明】【宮】"}
{"id": null, "n": "0019001", "target": "#nkr_note_mod_0019001", "type": "mod", "text": "起【大】，超【明】"}
{"id": null, "n": "0019002", "target": "#nkr_note_mod_0019002", "type": "mod", "text": "世【大】，世世【宋】【元】【明】【宮】"}
{"id": null, "n": "0019003", "target": "#nkr_note_mod_0019003", "type": "mod", "text": "間【大】，聞【元】【明】"}
{"id": null, "n": "0019004", "target": "#nkr_note_mod_0019004", "type": "mod", "text": "入【大】，得【宋】【元】【明】"}
{"id": null, "n": "0019005", "target": "#nkr_note_mod_0019005", "type": "mod", "text": "名【大】，明【元】【明】"}
{"id": null, "n": "0019006", "target": "#nkr_note_mod_0019006", "type": "mod", "text": "記【大】，謂【宋】"}
{"id": null, "n": "0019007", "target": "#nkr_note_mod_0019007", "type": "mod", "text": "太【大】，大【宋】【元】【明】【宮】"}
{"id": null, "n": "0019008", "target": "#nkr_note_mod_0019008", "type": "mod", "text": "（按此論…實錄）二百八字【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0017013", "target": "#nkr_note_orig_0017013", "type": "orig", "text": "〔一卷〕－【三】【宮】"}
{"id": null, "n": "0017014", "target": "#nkr_note_orig_0017014", "type": "orig", "text": "陳真諦譯＝失譯【宋】【元】【宮】，失譯人名【明】"}
{"id": null, "n": "0017015", "target": "#nkr_note_orig_0017015", "type": "orig", "text": "四＝白【明】"}
{"id": null, "n": "0017016", "target": "#nkr_note_orig_0017016", "type": "orig", "text": "密＝蜜【三】【宮】"}
{"id": null, "n": "0017017", "target": "#nkr_note_orig_0017017", "type": "orig", "text": "〔此二…百歲〕十七字－【三】【宮】"}
{"id": null, "n": "0017018", "target": "#nkr_note_orig_0017018", "type": "orig", "text": "〔名出…一部〕二十三字－【三】【宮】"}
{"id": null, "n": "0017019", "target": "#nkr_note_orig_0017019", "type": "orig", "text": "〔所〕－【三】【宮】"}
{"id": null, "n": "0017020", "target": "#nkr_note_orig_0017020", "type": "orig", "text": "處＋（也）【三】【宮】"}
{"id": null, "n": "0017021", "target": "#nkr_note_orig_0017021", "type": "orig", "text": "賢部＝名賢【三】【宮】"}
{"id": null, "n": "0017022", "target": "#nkr_note_orig_0017022", "type": "orig", "text": "義＝我【宮】"}
{"id": null, "n": "0017023", "target": "#nkr_note_orig_0017023", "type": "orig", "text": "大＝體【三】【宮】"}
{"id": null, "n": "0017024", "target": "#nkr_note_orig_0017024", "type": "orig", "text": "二十＝十二【三】【宮】"}
{"id": null, "n": "0018001", "target": "#nkr_note_orig_0018001", "type": "orig", "text": "得＝渴【宋】【元】【宮】"}
{"id": null, "n": "0018002", "target": "#nkr_note_orig_0018002", "type": "orig", "text": "勝＝聖【三】"}
{"id": null, "n": "0018003", "target": "#nkr_note_orig_0018003", "type": "orig", "text": "巴連＝已達【三】【宮】"}
{"id": null, "n": "0018004", "target": "#nkr_note_orig_0018004", "type": "orig", "text": "知＝如【三】【宮】"}
{"id": null, "n": "0019001", "target": "#nkr_note_orig_0019001", "type": "orig", "text": "起＝超【明】"}
{"id": null, "n": "0019002", "target": "#nkr_note_orig_0019002", "type": "orig", "text": "世＋（世）【三】【宮】"}
{"id": null, "n": "0019003", "target": "#nkr_note_orig_0019003", "type": "orig", "text": "間＝聞【元】【明】"}
{"id": null, "n": "0019004", "target": "#nkr_note_orig_0019004", "type": "orig", "text": "入＝得【三】"}
{"id": null, "n": "0019005", "target": "#nkr_note_orig_0019005", "type": "orig", "text": "名＝明【元】【明】"}
{"id": null, "n": "0019006", "target": "#nkr_note_orig_0019006", "type": "orig", "text": "記＝謂【宋】"}
{"id": null, "n": "0019007", "target": "#nkr_note_orig_0019007", "type": "orig", "text": "太＝大【三】【宮】"}
{"id": null, "n": "0019008", "target": "#nkr_note_orig_0019008", "type": "orig", "text": "〔按此論…實錄〕二百八字－【三】【宮】"}
