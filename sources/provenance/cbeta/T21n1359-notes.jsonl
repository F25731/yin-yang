{"id": null, "n": "0877003", "target": null, "type": "orig", "text": "法＝教【明】"}
{"id": null, "n": "0877003", "target": null, "type": "mod", "text": "法【大】，教【明】"}
{"id": null, "n": "0877004", "target": null, "type": "orig", "text": "〔臣〕－【明】"}
{"id": null, "n": "0877004", "target": null, "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0877002", "target": "#nkr_note_mod_0877002", "type": "mod", "text": "西天譯經三藏朝散大夫試鴻臚少卿傳法大師臣【大】，三藏法師【宋】【元】，宋西天譯經三藏朝散大夫試鴻臚少卿傳法大師臣【明】"}
{"id": null, "n": "0877003", "target": "#nkr_note_mod_0877003", "type": "mod", "text": "法【大】，教【明】"}
{"id": null, "n": "0877004", "target": "#nkr_note_mod_0877004", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0877005", "target": "#nkr_note_mod_0877005", "type": "mod", "text": "志【大】＊，至【元】【明】＊"}
{"id": null, "n": "0877006", "target": "#nkr_note_mod_0877006", "type": "mod", "text": "一【大】，〔－〕【宋】【元】"}
{"id": null, "n": "0877007", "target": "#nkr_note_mod_0877007", "type": "mod", "text": "縛【大】，嚩【宋】【元】【明】"}
{"id": null, "n": "0877008", "target": "#nkr_note_mod_0877008", "type": "mod", "text": "三【大】，二【元】【明】"}
{"id": null, "n": "0877009", "target": "#nkr_note_mod_0877009", "type": "mod", "text": "誦【大】，呪【宋】【元】【明】"}
{"id": null, "n": "0877001", "target": "#nkr_note_orig_0877001", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0877002", "target": "#nkr_note_orig_0877002", "type": "orig", "text": "（宋）＋西【明】，（（西天…臣））二十字＝（（三藏法師））四字【宋】【元】"}
{"id": null, "n": "0877003", "target": "#nkr_note_orig_0877003", "type": "orig", "text": "法＝教【明】"}
{"id": null, "n": "0877004", "target": "#nkr_note_orig_0877004", "type": "orig", "text": "〔臣〕－【明】"}
{"id": null, "n": "0877005", "target": "#nkr_note_orig_0877005", "type": "orig", "text": "志＝至【元】【明】＊"}
{"id": null, "n": "0877006", "target": "#nkr_note_orig_0877006", "type": "orig", "text": "〔一〕－【宋】【元】"}
{"id": null, "n": "0877007", "target": "#nkr_note_orig_0877007", "type": "orig", "text": "縛＝嚩【三】"}
