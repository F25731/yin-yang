{"id": null, "n": null, "target": null, "type": null, "text": "說《四阿含》"}
{"id": null, "n": null, "target": null, "type": null, "text": "說《維摩》、《思益》、《楞伽》、《楞嚴三昧》、《金光明》、《勝鬘》等經"}
{"id": null, "n": null, "target": null, "type": null, "text": "說《摩訶般若》、《光讚般若》、《金剛般若》、《大品般若》等諸般若經"}
{"id": null, "n": null, "target": null, "type": null, "text": "第一時"}
{"id": null, "n": null, "target": null, "type": null, "text": "一乳味"}
{"id": null, "n": null, "target": null, "type": null, "text": "此下三時三味總名為\n漸"}
{"id": null, "n": null, "target": null, "type": null, "text": "第二時"}
{"id": null, "n": null, "target": null, "type": null, "text": "二酪味"}
{"id": null, "n": null, "target": null, "type": null, "text": "聲聞、\n緣覺"}
{"id": null, "n": null, "target": null, "type": null, "text": "第三時"}
{"id": null, "n": null, "target": null, "type": null, "text": "三生\n酥味"}
{"id": null, "n": null, "target": null, "type": null, "text": "第四時"}
{"id": null, "n": null, "target": null, "type": null, "text": "四熟酥味"}
{"id": null, "n": null, "target": null, "type": null, "text": "圓實、別權"}
{"id": null, "n": null, "target": null, "type": null, "text": "別教"}
{"id": null, "n": null, "target": null, "type": null, "text": "圓教"}
{"id": null, "n": null, "target": null, "type": null, "text": "藏教"}
{"id": null, "n": null, "target": null, "type": null, "text": "藏、通、別"}
{"id": null, "n": null, "target": null, "type": null, "text": "圓教"}
{"id": null, "n": null, "target": null, "type": null, "text": "通、別"}
{"id": null, "n": null, "target": null, "type": null, "text": "圓教"}
{"id": null, "n": null, "target": null, "type": null, "text": "教一"}
{"id": null, "n": null, "target": null, "type": null, "text": "行一"}
{"id": null, "n": null, "target": null, "type": null, "text": "人一"}
{"id": null, "n": null, "target": null, "type": null, "text": "理一"}
{"id": null, "n": null, "target": null, "type": null, "text": "第五時"}
{"id": null, "n": null, "target": null, "type": null, "text": "五醍醐味"}
{"id": null, "n": null, "target": null, "type": null, "text": "《四阿含》等經"}
{"id": null, "n": null, "target": null, "type": null, "text": "《俱舍》、《婆沙》等論"}
{"id": null, "n": null, "target": null, "type": null, "text": "五部律"}
{"id": null, "n": null, "target": null, "type": null, "text": "四洲四趣成八，六\n欲天并梵王天成十五，四禪、四空處成二十三，無想天及那含天成二十五"}
{"id": null, "n": null, "target": null, "type": null, "text": "壽二百五\n十歲"}
{"id": null, "n": null, "target": null, "type": null, "text": "壽一百歲"}
{"id": null, "n": null, "target": null, "type": null, "text": "壽五百歲"}
{"id": null, "n": null, "target": null, "type": null, "text": "壽一\n千歲，命無中夭，聖人不出其中，即八難之一"}
{"id": null, "n": null, "target": null, "type": null, "text": "欲界六天，色界十八\n天，無色界四天"}
{"id": null, "n": null, "target": null, "type": null, "text": "居須彌山腹"}
{"id": null, "n": null, "target": null, "type": null, "text": "居須彌山頂，自有三十三天。已上二天單修上品十善，得生其中"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上四天空居，修\n上品十善，兼坐未到定，得生其中"}
{"id": null, "n": null, "target": null, "type": null, "text": "梵眾、梵輔、大梵"}
{"id": null, "n": null, "target": null, "type": null, "text": "少光、無量光、光音"}
{"id": null, "n": null, "target": null, "type": null, "text": "少淨、無量\n淨、遍淨"}
{"id": null, "n": null, "target": null, "type": null, "text": "無雲、福生、廣果，已上三天凡夫住處，修上品十善坐禪者得生其中；無想天\n外道所居；無煩、無熱、善見、善現、色究竟，已上五天第三\n果居處。上之九天離欲麁散，未出色籠故名色界，坐得\n禪定故得禪名"}
{"id": null, "n": null, "target": null, "type": null, "text": "空處、識處、無所有處、非非想，已上四天只有四陰而無色\n蘊，故得名也"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上利使"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上鈍使"}
{"id": null, "n": null, "target": null, "type": null, "text": "色蘊"}
{"id": null, "n": null, "target": null, "type": null, "text": "受蘊"}
{"id": null, "n": null, "target": null, "type": null, "text": "識蘊"}
{"id": null, "n": null, "target": null, "type": null, "text": "想行蘊"}
{"id": null, "n": null, "target": null, "type": null, "text": "欲、念、進、慧"}
{"id": null, "n": null, "target": null, "type": null, "text": "信、進、念、定、慧"}
{"id": null, "n": null, "target": null, "type": null, "text": "同上根名"}
{"id": null, "n": null, "target": null, "type": null, "text": "念、擇、進、喜、輕安、定、捨"}
{"id": null, "n": null, "target": null, "type": null, "text": "正見、正思惟、正語、正業、正精進、正定、\n正念、正命"}
{"id": null, "n": null, "target": null, "type": null, "text": "苦果、集因"}
{"id": null, "n": null, "target": null, "type": null, "text": "滅果、道因"}
{"id": null, "n": null, "target": null, "type": null, "text": "如前四念處是"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上三科名外凡，亦名資糧位"}
{"id": null, "n": null, "target": null, "type": null, "text": "此四位為內凡，亦名加行位，又\n名四善根位"}
{"id": null, "n": null, "target": null, "type": null, "text": "初果"}
{"id": null, "n": null, "target": null, "type": null, "text": "二三果"}
{"id": null, "n": null, "target": null, "type": null, "text": "四果"}
{"id": null, "n": null, "target": null, "type": null, "text": "煩惱障、煩惱道"}
{"id": null, "n": null, "target": null, "type": null, "text": "業障、業道，此二支屬過去"}
{"id": null, "n": null, "target": null, "type": null, "text": "託胎一分氣息"}
{"id": null, "n": null, "target": null, "type": null, "text": "名是心，色是質"}
{"id": null, "n": null, "target": null, "type": null, "text": "六根成此胎中"}
{"id": null, "n": null, "target": null, "type": null, "text": "出胎"}
{"id": null, "n": null, "target": null, "type": null, "text": "領納前境好惡等事，從識至受名現在五果"}
{"id": null, "n": null, "target": null, "type": null, "text": "愛色男女金銀錢物等事"}
{"id": null, "n": null, "target": null, "type": null, "text": "凡見一切境，\n皆生取著心，此二未來因，皆屬煩惱，如過去無明"}
{"id": null, "n": null, "target": null, "type": null, "text": "業已成就，是未來因，屬業道，如過去行"}
{"id": null, "n": null, "target": null, "type": null, "text": "未來受生事"}
{"id": null, "n": null, "target": null, "type": null, "text": "無"}
{"id": null, "n": null, "target": null, "type": null, "text": "數"}
{"id": null, "n": null, "target": null, "type": null, "text": "時"}
{"id": null, "n": null, "target": null, "type": null, "text": "外凡"}
{"id": null, "n": null, "target": null, "type": null, "text": "外凡"}
{"id": null, "n": null, "target": null, "type": null, "text": "斷三界見惑盡，與藏教初果，通教八人、見地齊"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上六住斷三界思惑盡，得位不退，與藏\n通二佛齊"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上三住斷界內塵沙，\n伏界外塵沙，前二不知名目"}
{"id": null, "n": null, "target": null, "type": null, "text": "斷界外塵沙惑"}
{"id": null, "n": null, "target": null, "type": null, "text": "伏無明、習中觀"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上三十位為三賢，亦\n名內凡。從八住至此，為行不退位"}
{"id": null, "n": null, "target": null, "type": null, "text": "從此用中道觀破\n一分無明，顯一分三德，乃至等覺，俱名聖種性"}
{"id": null, "n": null, "target": null, "type": null, "text": "已九地，地\n地各斷一品無明，證一分中道"}
{"id": null, "n": null, "target": null, "type": null, "text": "外凡，出《法華經》"}
{"id": null, "n": null, "target": null, "type": null, "text": "內凡"}
{"id": null, "n": null, "target": null, "type": null, "text": "聖初"}
{"id": null, "n": null, "target": null, "type": null, "text": "是因位末"}
{"id": null, "n": null, "target": null, "type": null, "text": "是果位"}
{"id": null, "n": null, "target": null, "type": null, "text": "五品位"}
{"id": null, "n": null, "target": null, "type": null, "text": "十信"}
{"id": null, "n": null, "target": null, "type": null, "text": "從初住至等覺"}
{"id": null, "n": null, "target": null, "type": null, "text": "妙覺位"}
{"id": null, "n": null, "target": null, "type": null, "text": "上根\n正觀此境"}
{"id": null, "n": null, "target": null, "type": null, "text": "車內枕"}
{"id": null, "n": null, "target": null, "type": null, "text": "車外枕"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上五中根"}
{"id": null, "n": null, "target": null, "type": null, "text": "此下為下根"}
{"id": null, "n": null, "target": null, "type": null, "text": "游四十位"}
{"id": null, "n": null, "target": null, "type": null, "text": "妙覺位"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X57n0980_p0944b14"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "X57n0980_p0944b08-09"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "P164n1544_p0708a01"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "P164n1544_p0733a08"}
{"id": null, "n": "0774001", "target": "#nkr_note_mod_0774001", "type": "mod", "text": "甲本四教儀緣起文無"}
{"id": null, "n": "0774002", "target": "#nkr_note_mod_0774002", "type": "mod", "text": "甲本刻天台四教儀引文無"}
{"id": null, "n": "0774003", "target": "#nkr_note_mod_0774003", "type": "mod", "text": "經【大】，教【甲】"}
{"id": null, "n": "0775001", "target": "#nkr_note_mod_0775001", "type": "mod", "text": "旁【大】＊，傍【甲】＊"}
{"id": null, "n": "0775002", "target": "#nkr_note_mod_0775002", "type": "mod", "text": "啞【大】，瘂【甲】"}
{"id": null, "n": "0775003", "target": "#nkr_note_mod_0775003", "type": "mod", "text": "酪【大】＊，酥【甲】＊"}
{"id": null, "n": "0775004", "target": "#nkr_note_mod_0775004", "type": "mod", "text": "此【大】，此諸部【甲】"}
{"id": null, "n": "0775005", "target": "#nkr_note_mod_0775005", "type": "mod", "text": "吾今【大】，今吾【甲】"}
{"id": null, "n": "0776001", "target": "#nkr_note_mod_0776001", "type": "mod", "text": "噉【大】，啖【甲】"}
{"id": null, "n": "0776002", "target": "#nkr_note_mod_0776002", "type": "mod", "text": "二【大】，五【甲】"}
{"id": null, "n": "0776003", "target": "#nkr_note_mod_0776003", "type": "mod", "text": "五十【大】，〔－〕【甲】"}
{"id": null, "n": "0776004", "target": "#nkr_note_mod_0776004", "type": "mod", "text": "瞿【大】，衢【甲】"}
{"id": null, "n": "0776005", "target": "#nkr_note_mod_0776005", "type": "mod", "text": "五百【大】，二百五十【甲】"}
{"id": null, "n": "0776006", "target": "#nkr_note_mod_0776006", "type": "mod", "text": "處【大】，處非想【甲】"}
{"id": null, "n": "0776007", "target": "#nkr_note_mod_0776007", "type": "mod", "text": "識【大】，織【甲】"}
{"id": null, "n": "0777001", "target": "#nkr_note_mod_0777001", "type": "mod", "text": "佛【大】，佛值【甲】"}
{"id": null, "n": "0777002", "target": "#nkr_note_mod_0777002", "type": "mod", "text": "又【大】，有【甲】"}
{"id": null, "n": "0777003", "target": "#nkr_note_mod_0777003", "type": "mod", "text": "辦【大】，辨【甲】"}
{"id": null, "n": "0778001", "target": "#nkr_note_mod_0778001", "type": "mod", "text": "民【大】，民之【甲】"}
{"id": null, "n": "0778002", "target": "#nkr_note_mod_0778002", "type": "mod", "text": "纓絡【大】＊，瓔珞【甲】＊"}
{"id": null, "n": "0778003", "target": "#nkr_note_mod_0778003", "type": "mod", "text": "是【大】，見【甲】"}
{"id": null, "n": "0779001", "target": "#nkr_note_mod_0779001", "type": "mod", "text": "位【大】，位也【甲】"}
{"id": null, "n": "0779002", "target": "#nkr_note_mod_0779002", "type": "mod", "text": "此【大】，是【甲】"}
{"id": null, "n": "0779003", "target": "#nkr_note_mod_0779003", "type": "mod", "text": "言【大】，語【甲】"}
{"id": null, "n": "0779004", "target": "#nkr_note_mod_0779004", "type": "mod", "text": "便【大】，使【甲】"}
{"id": null, "n": "0779005", "target": "#nkr_note_mod_0779005", "type": "mod", "text": "曰【大】，云【甲】"}
{"id": null, "n": "0779006", "target": "#nkr_note_mod_0779006", "type": "mod", "text": "一【大】，二【甲】"}
{"id": null, "n": "0780001", "target": "#nkr_note_mod_0780001", "type": "mod", "text": "者【大】，〔－〕【甲】"}
{"id": null, "n": "0780002", "target": "#nkr_note_mod_0780002", "type": "mod", "text": "閒【大】＊，閑【甲】＊"}
{"id": null, "n": "0780003", "target": "#nkr_note_mod_0780003", "type": "mod", "text": "脣【大】，唇【甲】"}
{"id": null, "n": "0780004", "target": "#nkr_note_mod_0780004", "type": "mod", "text": "慜【大】＊，憫【甲】＊"}
{"id": null, "n": "0780005", "target": "#nkr_note_mod_0780005", "type": "mod", "text": "牛【CB】【北藏-CB】【甲】，車【大】"}
{"id": null, "n": "0780006", "target": "#nkr_note_mod_0780006", "type": "mod", "text": "離【大】，無【甲】"}
{"id": null, "n": "0780007", "target": "#nkr_note_mod_0780007", "type": "mod", "text": "儀【大】，儀終【甲】"}
{"id": null, "n": "0773001", "target": "#nkr_note_orig_0773001", "type": "orig", "text": "【原】萬曆九年刊增上寺報恩藏本，【甲】延寶四年刊宗教大學藏本，甲本四教頌文無"}
{"id": null, "n": "0774001", "target": "#nkr_note_orig_0774001", "type": "orig", "text": "甲本四教儀緣起文無"}
{"id": null, "n": "0774002", "target": "#nkr_note_orig_0774002", "type": "orig", "text": "甲本刻天台四教儀引文無"}
{"id": null, "n": "0774003", "target": "#nkr_note_orig_0774003", "type": "orig", "text": "經＝教【甲】"}
{"id": null, "n": "0775001", "target": "#nkr_note_orig_0775001", "type": "orig", "text": "旁＝傍【甲】＊"}
{"id": null, "n": "0775002", "target": "#nkr_note_orig_0775002", "type": "orig", "text": "啞＝瘂【甲】"}
{"id": null, "n": "0775003", "target": "#nkr_note_orig_0775003", "type": "orig", "text": "酪＝酥【甲】＊"}
{"id": null, "n": "0775004", "target": "#nkr_note_orig_0775004", "type": "orig", "text": "此＋（諸部）【甲】"}
{"id": null, "n": "0775005", "target": "#nkr_note_orig_0775005", "type": "orig", "text": "吾今＝今吾【甲】"}
{"id": null, "n": "0776001", "target": "#nkr_note_orig_0776001", "type": "orig", "text": "噉＝啖【甲】"}
{"id": null, "n": "0776002", "target": "#nkr_note_orig_0776002", "type": "orig", "text": "二＝五【甲】"}
{"id": null, "n": "0776003", "target": "#nkr_note_orig_0776003", "type": "orig", "text": "〔五十〕－【甲】"}
{"id": null, "n": "0776004", "target": "#nkr_note_orig_0776004", "type": "orig", "text": "瞿＝衢【甲】"}
{"id": null, "n": "0776005", "target": "#nkr_note_orig_0776005", "type": "orig", "text": "五百＝二百五十【甲】"}
{"id": null, "n": "0776006", "target": "#nkr_note_orig_0776006", "type": "orig", "text": "處＋（非想）【甲】"}
{"id": null, "n": "0776007", "target": "#nkr_note_orig_0776007", "type": "orig", "text": "識＝織【甲】"}
{"id": null, "n": "0777001", "target": "#nkr_note_orig_0777001", "type": "orig", "text": "佛＋（值）【甲】"}
{"id": null, "n": "0777002", "target": "#nkr_note_orig_0777002", "type": "orig", "text": "又＝有【甲】"}
{"id": null, "n": "0777003", "target": "#nkr_note_orig_0777003", "type": "orig", "text": "辦＝辨【甲】"}
{"id": null, "n": "0778001", "target": "#nkr_note_orig_0778001", "type": "orig", "text": "民＋（之）【甲】"}
{"id": null, "n": "0778002", "target": "#nkr_note_orig_0778002", "type": "orig", "text": "纓絡＝瓔珞【甲】＊"}
{"id": null, "n": "0778003", "target": "#nkr_note_orig_0778003", "type": "orig", "text": "是＝見【甲】"}
{"id": null, "n": "0779001", "target": "#nkr_note_orig_0779001", "type": "orig", "text": "位＋（也）【甲】"}
{"id": null, "n": "0779002", "target": "#nkr_note_orig_0779002", "type": "orig", "text": "此＝是【甲】"}
{"id": null, "n": "0779003", "target": "#nkr_note_orig_0779003", "type": "orig", "text": "言＝語【甲】"}
{"id": null, "n": "0779004", "target": "#nkr_note_orig_0779004", "type": "orig", "text": "便＝使【甲】"}
{"id": null, "n": "0779005", "target": "#nkr_note_orig_0779005", "type": "orig", "text": "曰＝云【甲】"}
{"id": null, "n": "0779006", "target": "#nkr_note_orig_0779006", "type": "orig", "text": "一＝二【甲】"}
{"id": null, "n": "0780001", "target": "#nkr_note_orig_0780001", "type": "orig", "text": "〔者〕－【甲】"}
{"id": null, "n": "0780002", "target": "#nkr_note_orig_0780002", "type": "orig", "text": "閒＝閑【甲】＊"}
