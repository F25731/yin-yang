{"id": null, "n": "0670002", "target": "#nkr_note_mod_0670002", "type": "mod", "text": "礙【大】，破【宋】【元】【明】【宮】"}
{"id": null, "n": "0670003", "target": "#nkr_note_mod_0670003", "type": "mod", "text": "或【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0670004", "target": "#nkr_note_mod_0670004", "type": "mod", "text": "這【大】＊，遮【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0670005", "target": "#nkr_note_mod_0670005", "type": "mod", "text": "邏【大】，羅【宋】【元】【明】【宮】"}
{"id": null, "n": "0670006", "target": "#nkr_note_mod_0670006", "type": "mod", "text": "嘍【大】，嘍尼【宋】【元】【明】【宮】"}
