{"id": null, "n": "0675008", "target": "#nkr_note_mod_0675008", "type": "mod", "text": "蒱【大】＊，蒲【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0675009", "target": "#nkr_note_mod_0675009", "type": "mod", "text": "所【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0675010", "target": "#nkr_note_mod_0675010", "type": "mod", "text": "鞞【大】，鞞貰薩多羅羯囉泥【宮】【宋】【元】【明】"}
{"id": null, "n": "0675011", "target": "#nkr_note_mod_0675011", "type": "mod", "text": "七【大】，八【宋】【元】【明】【宮】"}
