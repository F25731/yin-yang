{"id": null, "n": "0672003", "target": "#nkr_note_mod_0672003", "type": "mod", "text": "啞【大】，瘂【宮】"}
{"id": null, "n": "0672004", "target": "#nkr_note_mod_0672004", "type": "mod", "text": "多【大】，多等【宋】【元】【宮】"}
{"id": null, "n": "0672005", "target": "#nkr_note_mod_0672005", "type": "mod", "text": "說【大】，諸【宋】【元】【明】【宮】"}
{"id": null, "n": "0673001", "target": "#nkr_note_mod_0673001", "type": "mod", "text": "人【大】，仁【宋】【元】【明】【宮】"}
{"id": null, "n": "0673002", "target": "#nkr_note_mod_0673002", "type": "mod", "text": "陀【大】，他【宋】【元】【明】【宮】"}
{"id": null, "n": "0673003", "target": "#nkr_note_mod_0673003", "type": "mod", "text": "耶【大】＊，也【元】【明】＊"}
{"id": null, "n": "0674001", "target": "#nkr_note_mod_0674001", "type": "mod", "text": "依【大】，彼【宋】【元】【明】"}
