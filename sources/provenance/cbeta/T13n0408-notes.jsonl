{"id": null, "n": "0668006", "target": "#nkr_note_mod_0668006", "type": "mod", "text": "解【大】，那【宋】"}
{"id": null, "n": "0669001", "target": "#nkr_note_mod_0669001", "type": "mod", "text": "恭【大】，供【宋】【元】【明】【宮】"}
{"id": null, "n": "0669002", "target": "#nkr_note_mod_0669002", "type": "mod", "text": "峯【大】，降【宮】"}
{"id": null, "n": "0669003", "target": "#nkr_note_mod_0669003", "type": "mod", "text": "得【大】，有【明】"}
{"id": null, "n": "0669004", "target": "#nkr_note_mod_0669004", "type": "mod", "text": "綖【大】，線【宮】"}
{"id": null, "n": "0669005", "target": "#nkr_note_mod_0669005", "type": "mod", "text": "喜【大】，欣【宋】【元】【明】【宮】"}
{"id": null, "n": "0669006", "target": "#nkr_note_mod_0669006", "type": "mod", "text": "踊【大】，湧【元】【明】"}
