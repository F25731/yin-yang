{"id": null, "n": "0671002", "target": "#nkr_note_mod_0671002", "type": "mod", "text": "入【大】，人【元】【明】"}
{"id": null, "n": "0671003", "target": "#nkr_note_mod_0671003", "type": "mod", "text": "押【大】，厭【宮】"}
{"id": null, "n": "0672001", "target": "#nkr_note_mod_0672001", "type": "mod", "text": "現【大】，作【宋】【元】【明】【宮】"}
