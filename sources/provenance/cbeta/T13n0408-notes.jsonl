{"id": null, "n": "0667012", "target": "#nkr_note_mod_0667012", "type": "mod", "text": "唯【大】＊，惟【宮】＊【宋】【元】【明】"}
{"id": null, "n": "0668001", "target": "#nkr_note_mod_0668001", "type": "mod", "text": "修【大】＊，脩【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0668002", "target": "#nkr_note_mod_0668002", "type": "mod", "text": "橛【大】，撅【宋】【元】【明】【宮】"}
{"id": null, "n": "0668003", "target": "#nkr_note_mod_0668003", "type": "mod", "text": "先【大】，光【元】【明】"}
{"id": null, "n": "0668004", "target": "#nkr_note_mod_0668004", "type": "mod", "text": "鉀【大】，甲【宋】【元】【明】【宮】"}
