{"id": null, "n": null, "target": null, "type": null, "text": "予"}
{"id": null, "n": null, "target": null, "type": null, "text": "本"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦號紀衡"}
{"id": null, "n": null, "target": null, "type": null, "text": "下二段疏網註"}
{"id": null, "n": null, "target": null, "type": null, "text": "以上二段無餘記"}
{"id": null, "n": null, "target": null, "type": null, "text": "下三段細註"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上"}
{"id": null, "n": null, "target": null, "type": null, "text": "為言"}
{"id": null, "n": null, "target": null, "type": null, "text": "本"}
{"id": null, "n": null, "target": null, "type": null, "text": "末"}
{"id": null, "n": null, "target": null, "type": null, "text": "末"}
{"id": null, "n": null, "target": null, "type": null, "text": "思之，合在後文中破"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃至"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": "0833004", "target": "#nkr_note_mod_0833004", "type": "mod", "text": "已下之四段牒文非今現疏文"}
{"id": null, "n": "0835002", "target": "#nkr_note_mod_0835002", "type": "mod", "text": "現疏無已下二段牒文"}
{"id": null, "n": "0836001", "target": "#nkr_note_mod_0836001", "type": "mod", "text": "現疏無已下四段牒文"}
{"id": null, "n": "0836004", "target": "#nkr_note_mod_0836004", "type": "mod", "text": "現疏無已下五段牒文"}
{"id": null, "n": "0837004", "target": "#nkr_note_mod_0837004", "type": "mod", "text": "已下三段牒文亦依新疏乎"}
{"id": null, "n": "0839003", "target": "#nkr_note_mod_0839003", "type": "mod", "text": "已下五段牒文亦依新疏乎"}
{"id": null, "n": "0839004", "target": "#nkr_note_mod_0839004", "type": "mod", "text": "已下五段牒文現疏無"}
{"id": null, "n": "0840001", "target": "#nkr_note_mod_0840001", "type": "mod", "text": "現疏無已下三段牒文"}
{"id": null, "n": "0841001", "target": "#nkr_note_mod_0841001", "type": "mod", "text": "已下三段牒文依新注疏乎"}
{"id": null, "n": "0798001", "target": "#nkr_note_orig_0798001", "type": "orig", "text": "及疑乃"}
{"id": null, "n": "0799001", "target": "#nkr_note_orig_0799001", "type": "orig", "text": "子大明一統志作滋"}
{"id": null, "n": "0799002", "target": "#nkr_note_orig_0799002", "type": "orig", "text": "窟作洞"}
{"id": null, "n": "0801001", "target": "#nkr_note_orig_0801001", "type": "orig", "text": "也疑之"}
{"id": null, "n": "0803001", "target": "#nkr_note_orig_0803001", "type": "orig", "text": "其疑共下同"}
{"id": null, "n": "0803002", "target": "#nkr_note_orig_0803002", "type": "orig", "text": "後疑復"}
{"id": null, "n": "0804001", "target": "#nkr_note_orig_0804001", "type": "orig", "text": "淨疑諍"}
{"id": null, "n": "0804002", "target": "#nkr_note_orig_0804002", "type": "orig", "text": "汝疑沙"}
{"id": null, "n": "0804003", "target": "#nkr_note_orig_0804003", "type": "orig", "text": "遍疑偏"}
{"id": null, "n": "0804004", "target": "#nkr_note_orig_0804004", "type": "orig", "text": "狀疑壯"}
{"id": null, "n": "0804005", "target": "#nkr_note_orig_0804005", "type": "orig", "text": "悟疑語"}
{"id": null, "n": "0804006", "target": "#nkr_note_orig_0804006", "type": "orig", "text": "調疑詞"}
{"id": null, "n": "0804007", "target": "#nkr_note_orig_0804007", "type": "orig", "text": "嚴瑜伽作寶"}
{"id": null, "n": "0804008", "target": "#nkr_note_orig_0804008", "type": "orig", "text": "謂疑調"}
{"id": null, "n": "0804009", "target": "#nkr_note_orig_0804009", "type": "orig", "text": "謂等三字疑剩"}
{"id": null, "n": "0804010", "target": "#nkr_note_orig_0804010", "type": "orig", "text": "收疑第次同"}
{"id": null, "n": "0805001", "target": "#nkr_note_orig_0805001", "type": "orig", "text": "非字疑剩"}
{"id": null, "n": "0805002", "target": "#nkr_note_orig_0805002", "type": "orig", "text": "合疑今"}
{"id": null, "n": "0805003", "target": "#nkr_note_orig_0805003", "type": "orig", "text": "性疑怯"}
{"id": null, "n": "0805004", "target": "#nkr_note_orig_0805004", "type": "orig", "text": "復疑彼"}
{"id": null, "n": "0806001", "target": "#nkr_note_orig_0806001", "type": "orig", "text": "問者二字疑剩"}
{"id": null, "n": "0806002", "target": "#nkr_note_orig_0806002", "type": "orig", "text": "門疑問"}
{"id": null, "n": "0806003", "target": "#nkr_note_orig_0806003", "type": "orig", "text": "云疑立"}
{"id": null, "n": "0807001", "target": "#nkr_note_orig_0807001", "type": "orig", "text": "地疑也"}
{"id": null, "n": "0807002", "target": "#nkr_note_orig_0807002", "type": "orig", "text": "比疑此"}
{"id": null, "n": "0808001", "target": "#nkr_note_orig_0808001", "type": "orig", "text": "慰字疑剩"}
{"id": null, "n": "0808002", "target": "#nkr_note_orig_0808002", "type": "orig", "text": "徵疑微"}
{"id": null, "n": "0808003", "target": "#nkr_note_orig_0808003", "type": "orig", "text": "造疑違"}
{"id": null, "n": "0809001", "target": "#nkr_note_orig_0809001", "type": "orig", "text": "上字疑剩"}
{"id": null, "n": "0811001", "target": "#nkr_note_orig_0811001", "type": "orig", "text": "勝論立內聲無常勤勇者新注疏乎"}
{"id": null, "n": "0812001", "target": "#nkr_note_orig_0812001", "type": "orig", "text": "現流疏無不別取等牒文"}
{"id": null, "n": "0814001", "target": "#nkr_note_orig_0814001", "type": "orig", "text": "別一作例"}
{"id": null, "n": "0814002", "target": "#nkr_note_orig_0814002", "type": "orig", "text": "龜毛無彼等者新注疏乎非今疏全文"}
{"id": null, "n": "0815001", "target": "#nkr_note_orig_0815001", "type": "orig", "text": "＊碍一作為（＊印ノ字ハ本文ト異ナル。󴦒）"}
{"id": null, "n": "0819001", "target": "#nkr_note_orig_0819001", "type": "orig", "text": "隨一作墮"}
{"id": null, "n": "0820001", "target": "#nkr_note_orig_0820001", "type": "orig", "text": "或有本作等疑今本疏况作或後人據後記牒文革乎或有本脫下文字"}
{"id": null, "n": "0822001", "target": "#nkr_note_orig_0822001", "type": "orig", "text": "無體因依無體有法者新續疏乎"}
{"id": null, "n": "0823001", "target": "#nkr_note_orig_0823001", "type": "orig", "text": "能今疏作所"}
{"id": null, "n": "0824001", "target": "#nkr_note_orig_0824001", "type": "orig", "text": "所在無者此亦新續疏乎"}
{"id": null, "n": "0824002", "target": "#nkr_note_orig_0824002", "type": "orig", "text": "門疑問"}
{"id": null, "n": "0826001", "target": "#nkr_note_orig_0826001", "type": "orig", "text": "不等現疏作而取他因"}
{"id": null, "n": "0826002", "target": "#nkr_note_orig_0826002", "type": "orig", "text": "勝恐數"}
{"id": null, "n": "0827001", "target": "#nkr_note_orig_0827001", "type": "orig", "text": "現疏無違字"}
{"id": null, "n": "0829001", "target": "#nkr_note_orig_0829001", "type": "orig", "text": "法有大有至法有同異者此亦新續乎"}
{"id": null, "n": "0831001", "target": "#nkr_note_orig_0831001", "type": "orig", "text": "有下一有無動作釋不異所出次下釋義故重不加也十七字"}
{"id": null, "n": "0831002", "target": "#nkr_note_orig_0831002", "type": "orig", "text": "現一作境"}
{"id": null, "n": "0832001", "target": "#nkr_note_orig_0832001", "type": "orig", "text": "違四六一作通二品"}
{"id": null, "n": "0832002", "target": "#nkr_note_orig_0832002", "type": "orig", "text": "相一作因"}
{"id": null, "n": "0832003", "target": "#nkr_note_orig_0832003", "type": "orig", "text": "因一作中"}
{"id": null, "n": "0832004", "target": "#nkr_note_orig_0832004", "type": "orig", "text": "有上一有無字"}
{"id": null, "n": "0832005", "target": "#nkr_note_orig_0832005", "type": "orig", "text": "皆違自等牒文異說現疏文也"}
{"id": null, "n": "0832006", "target": "#nkr_note_orig_0832006", "type": "orig", "text": "無字疑剩"}
{"id": null, "n": "0833001", "target": "#nkr_note_orig_0833001", "type": "orig", "text": "或指如餘等文非于今疏文"}
{"id": null, "n": "0833002", "target": "#nkr_note_orig_0833002", "type": "orig", "text": "因及能立等亦同"}
{"id": null, "n": "0833003", "target": "#nkr_note_orig_0833003", "type": "orig", "text": "此一作且"}
{"id": null, "n": "0833004", "target": "#nkr_note_orig_0833004", "type": "orig", "text": "巳下之四段牒文非今現疏文"}
{"id": null, "n": "0834001", "target": "#nkr_note_orig_0834001", "type": "orig", "text": "約無能別宗等文新續疏乎"}
{"id": null, "n": "0834002", "target": "#nkr_note_orig_0834002", "type": "orig", "text": "今疏無若等牒文"}
{"id": null, "n": "0834003", "target": "#nkr_note_orig_0834003", "type": "orig", "text": "註一作續"}
{"id": null, "n": "0834004", "target": "#nkr_note_orig_0834004", "type": "orig", "text": "現疏無二立二字"}
{"id": null, "n": "0835001", "target": "#nkr_note_orig_0835001", "type": "orig", "text": "現疏無無等牒文"}
{"id": null, "n": "0835002", "target": "#nkr_note_orig_0835002", "type": "orig", "text": "現疏無巳下二段牒文"}
{"id": null, "n": "0836001", "target": "#nkr_note_orig_0836001", "type": "orig", "text": "現疏無巳下四段牒文"}
{"id": null, "n": "0836002", "target": "#nkr_note_orig_0836002", "type": "orig", "text": "說一作諍"}
{"id": null, "n": "0836003", "target": "#nkr_note_orig_0836003", "type": "orig", "text": "所依不成等現疏無"}
{"id": null, "n": "0836004", "target": "#nkr_note_orig_0836004", "type": "orig", "text": "現疏無巳下五段牒文"}
{"id": null, "n": "0836005", "target": "#nkr_note_orig_0836005", "type": "orig", "text": "所等牒文新註疏乎"}
{"id": null, "n": "0836006", "target": "#nkr_note_orig_0836006", "type": "orig", "text": "過上一有諸字"}
{"id": null, "n": "0837001", "target": "#nkr_note_orig_0837001", "type": "orig", "text": "陳那與作等者與今疏文異也"}
{"id": null, "n": "0837002", "target": "#nkr_note_orig_0837002", "type": "orig", "text": "又助難至餘不立故者是亦無現疏瑞源本疏有之"}
{"id": null, "n": "0837003", "target": "#nkr_note_orig_0837003", "type": "orig", "text": "軌二本作盛"}
{"id": null, "n": "0837004", "target": "#nkr_note_orig_0837004", "type": "orig", "text": "巳下三段牒文亦依新疏乎"}
{"id": null, "n": "0837005", "target": "#nkr_note_orig_0837005", "type": "orig", "text": "現疏無此段牒文"}
{"id": null, "n": "0838001", "target": "#nkr_note_orig_0838001", "type": "orig", "text": "既上恐脫問字"}
{"id": null, "n": "0838002", "target": "#nkr_note_orig_0838002", "type": "orig", "text": "吉疑苦"}
{"id": null, "n": "0838003", "target": "#nkr_note_orig_0838003", "type": "orig", "text": "現疏無此一段牒文"}
{"id": null, "n": "0839001", "target": "#nkr_note_orig_0839001", "type": "orig", "text": "若依初解即無此妨者無疏亦依新疏乎"}
{"id": null, "n": "0839002", "target": "#nkr_note_orig_0839002", "type": "orig", "text": "作一作除"}
{"id": null, "n": "0839003", "target": "#nkr_note_orig_0839003", "type": "orig", "text": "巳下五段牒文亦依新疏乎"}
{"id": null, "n": "0839004", "target": "#nkr_note_orig_0839004", "type": "orig", "text": "巳下五段牒文現疏無"}
{"id": null, "n": "0840001", "target": "#nkr_note_orig_0840001", "type": "orig", "text": "現疏無巳下三段牒文"}
{"id": null, "n": "0840002", "target": "#nkr_note_orig_0840002", "type": "orig", "text": "親能明證今疏作能觀能證"}
{"id": null, "n": "0841001", "target": "#nkr_note_orig_0841001", "type": "orig", "text": "巳下三段牒文依新注疏乎"}
