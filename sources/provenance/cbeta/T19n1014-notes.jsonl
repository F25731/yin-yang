{"id": null, "n": "0688003", "target": "#nkr_note_mod_0688003", "type": "mod", "text": "無【大】＊，佛說無【宋】＊【元】＊【明】＊，【原】麗本"}
{"id": null, "n": "0688004", "target": "#nkr_note_mod_0688004", "type": "mod", "text": "宋【大】，宋大明年【宋】"}
{"id": null, "n": "0688005", "target": "#nkr_note_mod_0688005", "type": "mod", "text": "共玄暢【大】，於荊州【宋】，共音陽【元】【明】"}
{"id": null, "n": "0688006", "target": "#nkr_note_mod_0688006", "type": "mod", "text": "乾【大】，揵【宋】【元】【明】"}
{"id": null, "n": "0688007", "target": "#nkr_note_mod_0688007", "type": "mod", "text": "往【大】，往至【宋】【元】【明】"}
{"id": null, "n": "0688008", "target": "#nkr_note_mod_0688008", "type": "mod", "text": "惛【大】，昏【宋】【元】【明】"}
{"id": null, "n": "0688009", "target": "#nkr_note_mod_0688009", "type": "mod", "text": "到【大】，至【宋】【元】【明】"}
{"id": null, "n": "0688010", "target": "#nkr_note_mod_0688010", "type": "mod", "text": "住【大】，坐【宋】【元】【明】"}
{"id": null, "n": "0688011", "target": "#nkr_note_mod_0688011", "type": "mod", "text": "盡【大】，淨【明】"}
{"id": null, "n": "0688012", "target": "#nkr_note_mod_0688012", "type": "mod", "text": "市【大】，帝【宋】【元】【明】"}
{"id": null, "n": "0688013", "target": "#nkr_note_mod_0688013", "type": "mod", "text": "反【大】＊，切【明】＊"}
{"id": null, "n": "0688014", "target": "#nkr_note_mod_0688014", "type": "mod", "text": "企【大】＊，仚【宋】＊"}
{"id": null, "n": "0688015", "target": "#nkr_note_mod_0688015", "type": "mod", "text": "遣【大】，起【宋】【元】【明】"}
{"id": null, "n": "0688016", "target": "#nkr_note_mod_0688016", "type": "mod", "text": "祇【大】，秖【明】"}
{"id": null, "n": "0688017", "target": "#nkr_note_mod_0688017", "type": "mod", "text": "跢【大】，眵【宋】，哆【元】【明】"}
{"id": null, "n": "0688018", "target": "#nkr_note_mod_0688018", "type": "mod", "text": "都【大】＊，覩【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0688019", "target": "#nkr_note_mod_0688019", "type": "mod", "text": "絭【大】，奚【宋】【元】【明】"}
{"id": null, "n": "0688020", "target": "#nkr_note_mod_0688020", "type": "mod", "text": "斯【大】＊，䔮【宋】＊，簸【元】【明】＊"}
{"id": null, "n": "0688021", "target": "#nkr_note_mod_0688021", "type": "mod", "text": "娑【大】，婆【宋】【元】【明】"}
{"id": null, "n": "0688022", "target": "#nkr_note_mod_0688022", "type": "mod", "text": "犁【大】，梨【宋】【元】【明】"}
{"id": null, "n": "0688023", "target": "#nkr_note_mod_0688023", "type": "mod", "text": "恒【大】，怛【元】【明】"}
{"id": null, "n": "0688024", "target": "#nkr_note_mod_0688024", "type": "mod", "text": "呵【大】，呵隸【元】【明】"}
{"id": null, "n": "0688025", "target": "#nkr_note_mod_0688025", "type": "mod", "text": "般【大】，槃【宋】【元】【明】"}
{"id": null, "n": "0688026", "target": "#nkr_note_mod_0688026", "type": "mod", "text": "𭒂【大】，嘙【宋】【元】【明】"}
{"id": null, "n": "0688027", "target": "#nkr_note_mod_0688027", "type": "mod", "text": "𮐡【大】＊，蒲【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0688028", "target": "#nkr_note_mod_0688028", "type": "mod", "text": "提【大】，提提【宋】【元】【明】"}
{"id": null, "n": "0689001", "target": "#nkr_note_mod_0689001", "type": "mod", "text": "耶【大】，邪【宋】【元】【明】"}
{"id": null, "n": "0689002", "target": "#nkr_note_mod_0689002", "type": "mod", "text": "𤙈【大】，挨【宋】，抶【元】【明】"}
{"id": null, "n": "0689003", "target": "#nkr_note_mod_0689003", "type": "mod", "text": "㝹【大】，免【宋】，充【元】【明】"}
{"id": null, "n": "0689004", "target": "#nkr_note_mod_0689004", "type": "mod", "text": "咃【大】，咃勅賀反【宋】【元】，咃勅賀切【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "勅賀反"}
{"id": null, "n": null, "target": null, "type": null, "text": "勅賀切"}
{"id": null, "n": "0689005", "target": "#nkr_note_mod_0689005", "type": "mod", "text": "剌【大】，賴【宋】【元】【明】"}
{"id": null, "n": "0689006", "target": "#nkr_note_mod_0689006", "type": "mod", "text": "姝【大】，昧【宋】"}
{"id": null, "n": "0689007", "target": "#nkr_note_mod_0689007", "type": "mod", "text": "低【大】，𱒿【元】【明】"}
{"id": null, "n": "0689008", "target": "#nkr_note_mod_0689008", "type": "mod", "text": "持【大】，持陀羅尼門【宋】【元】【明】"}
{"id": null, "n": "0689009", "target": "#nkr_note_mod_0689009", "type": "mod", "text": "功【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0689010", "target": "#nkr_note_mod_0689010", "type": "mod", "text": "耀【大】，曜【宋】【元】【明】"}
{"id": null, "n": "0689011", "target": "#nkr_note_mod_0689011", "type": "mod", "text": "獲【大】，得【明】"}
{"id": null, "n": "0689012", "target": "#nkr_note_mod_0689012", "type": "mod", "text": "憶【大】，億【明】"}
{"id": null, "n": "0689013", "target": "#nkr_note_mod_0689013", "type": "mod", "text": "說【大】，記【元】【明】"}
{"id": null, "n": "0689014", "target": "#nkr_note_mod_0689014", "type": "mod", "text": "樂餘【大】，除樂【宋】【元】【明】"}
{"id": null, "n": "0690001", "target": "#nkr_note_mod_0690001", "type": "mod", "text": "精【大】，釋【宋】，修【元】【明】"}
{"id": null, "n": "0690002", "target": "#nkr_note_mod_0690002", "type": "mod", "text": "形【大】，行【明】"}
{"id": null, "n": "0690003", "target": "#nkr_note_mod_0690003", "type": "mod", "text": "救【大】，忍【元】【明】"}
{"id": null, "n": "0690004", "target": "#nkr_note_mod_0690004", "type": "mod", "text": "儲【大】，貯【宋】"}
{"id": null, "n": "0690005", "target": "#nkr_note_mod_0690005", "type": "mod", "text": "法【大】，心【明】"}
{"id": null, "n": "0690006", "target": "#nkr_note_mod_0690006", "type": "mod", "text": "應【大】，當【宋】【元】【明】"}
{"id": null, "n": "0690007", "target": "#nkr_note_mod_0690007", "type": "mod", "text": "阿【大】，波【宋】【元】【明】"}
{"id": null, "n": "0690008", "target": "#nkr_note_mod_0690008", "type": "mod", "text": "攞【大】，羅【宋】【元】【明】"}
{"id": null, "n": "0690009", "target": "#nkr_note_mod_0690009", "type": "mod", "text": "叉【大】，入【宋】"}
{"id": null, "n": "0690010", "target": "#nkr_note_mod_0690010", "type": "mod", "text": "覺【大】，攪【宋】【元】【明】"}
{"id": null, "n": "0690011", "target": "#nkr_note_mod_0690011", "type": "mod", "text": "應【大】，應供【明】"}
{"id": null, "n": "0690012", "target": "#nkr_note_mod_0690012", "type": "mod", "text": "斯【大】，其【宋】【元】【明】"}
{"id": null, "n": "0691001", "target": "#nkr_note_mod_0691001", "type": "mod", "text": "宋【大】，此【明】"}
{"id": null, "n": "0691002", "target": "#nkr_note_mod_0691002", "type": "mod", "text": "復【大】，伏【明】"}
{"id": null, "n": "0691003", "target": "#nkr_note_mod_0691003", "type": "mod", "text": "嘊柴【大】，柴啀【宋】【元】【明】"}
{"id": null, "n": "0691004", "target": "#nkr_note_mod_0691004", "type": "mod", "text": "臂【大】，臂也【元】【明】"}
{"id": null, "n": "0691005", "target": "#nkr_note_mod_0691005", "type": "mod", "text": "綵【大】＊，彩【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0691006", "target": "#nkr_note_mod_0691006", "type": "mod", "text": "爐【大】，鑪【宋】【元】"}
{"id": null, "n": "0691007", "target": "#nkr_note_mod_0691007", "type": "mod", "text": "念【大】，念所行【元】【明】"}
{"id": null, "n": "0691008", "target": "#nkr_note_mod_0691008", "type": "mod", "text": "超【大】，起【宋】"}
{"id": null, "n": "0691009", "target": "#nkr_note_mod_0691009", "type": "mod", "text": "迦【大】，伽【宋】【元】【明】"}
{"id": null, "n": "0692001", "target": "#nkr_note_mod_0692001", "type": "mod", "text": "一切【大】，〔－〕【宋】"}
