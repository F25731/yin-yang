{"id": null, "n": null, "target": null, "type": null, "text": "聖者欝楞迦造"}
{"id": null, "n": null, "target": null, "type": null, "text": "張宿名也"}
{"id": null, "n": null, "target": null, "type": null, "text": "梵本一偈今為一句矣"}
{"id": null, "n": null, "target": null, "type": null, "text": "古譯無明，今無知乃正也"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K36n1337_p1110a21"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K36n1337_p1114b03"}
{"id": null, "n": "0486004", "target": "#nkr_note_mod_0486004", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0486005", "target": "#nkr_note_mod_0486005", "type": "mod", "text": "（開府…譯）四十六字【大】，特進試鴻臚卿大興善寺三藏沙門大廣智不空奉詔譯【宋】【元】【宮】，唐特進試鴻臚卿三藏沙門大廣智不空奉詔譯【明】"}
{"id": null, "n": "0486006", "target": "#nkr_note_mod_0486006", "type": "mod", "text": "知【大】，智【宋】【元】【宮】"}
{"id": null, "n": "0486007", "target": "#nkr_note_mod_0486007", "type": "mod", "text": "領【大】，飲【宋】【元】【宮】"}
{"id": null, "n": "0486008", "target": "#nkr_note_mod_0486008", "type": "mod", "text": "生熟次終【大】，出熟後邊【宋】【元】【明】"}
{"id": null, "n": "0486009", "target": "#nkr_note_mod_0486009", "type": "mod", "text": "空【大】，說【宋】【元】【宮】"}
{"id": null, "n": "0486010", "target": "#nkr_note_mod_0486010", "type": "mod", "text": "果【大】＊，果因果二俱空【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0486011", "target": "#nkr_note_mod_0486011", "type": "mod", "text": "惑發起果【大】，發起果報【宋】【元】【宮】"}
{"id": null, "n": "0486012", "target": "#nkr_note_mod_0486012", "type": "mod", "text": "等【大】，報【明】"}
{"id": null, "n": "0486013", "target": "#nkr_note_mod_0486013", "type": "mod", "text": "故緣生【大】，緣生故【明】"}
{"id": null, "n": "0486014", "target": "#nkr_note_mod_0486014", "type": "mod", "text": "慧以【大】，以慧【宋】【元】【明】【宮】"}
{"id": null, "n": "0486015", "target": "#nkr_note_mod_0486015", "type": "mod", "text": "遇【大】，具【明】"}
{"id": null, "n": "0486016", "target": "#nkr_note_mod_0486016", "type": "mod", "text": "名也【大】，〔－〕【明】"}
{"id": null, "n": "0486017", "target": "#nkr_note_mod_0486017", "type": "mod", "text": "（於蘊…空）十字【大】，則不厭於蘊若有彼無見【明】"}
{"id": null, "n": "0487001", "target": "#nkr_note_mod_0487001", "type": "mod", "text": "具【大】，故【宋】【元】【宮】"}
{"id": null, "n": "0487002", "target": "#nkr_note_mod_0487002", "type": "mod", "text": "先【大】，前【明】"}
{"id": null, "n": "0487003", "target": "#nkr_note_mod_0487003", "type": "mod", "text": "業苦【大】，苦業【宋】【元】【宮】"}
{"id": null, "n": "0487004a", "target": "#nkr_note_mod_0487004a", "type": "mod", "text": "一切皆因果【大】，因果生諸世無別有眾生【明】"}
{"id": null, "n": "0487004b", "target": "#nkr_note_mod_0487004b", "type": "mod", "text": "從空生於空從法生於法【大】，唯是於空法還自生空法【明】"}
{"id": null, "n": "0487005", "target": "#nkr_note_mod_0487005", "type": "mod", "text": "時【大】，轉【明】"}
{"id": null, "n": "0487006", "target": "#nkr_note_mod_0487006", "type": "mod", "text": "謂【大】，一謂【宋】【元】【明】【宮】"}
{"id": null, "n": "0487007", "target": "#nkr_note_mod_0487007", "type": "mod", "text": "從【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0487008", "target": "#nkr_note_mod_0487008", "type": "mod", "text": "一【大】，一生【宋】【元】【明】【宮】"}
{"id": null, "n": "0487009", "target": "#nkr_note_mod_0487009", "type": "mod", "text": "當【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0487010", "target": "#nkr_note_mod_0487010", "type": "mod", "text": "者【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0487011", "target": "#nkr_note_mod_0487011", "type": "mod", "text": "根【大】，相【宋】【元】【明】"}
{"id": null, "n": "0487012", "target": "#nkr_note_mod_0487012", "type": "mod", "text": "七【大】，十【宋】【元】【宮】"}
{"id": null, "n": "0487013", "target": "#nkr_note_mod_0487013", "type": "mod", "text": "言【大】，曰【宋】【元】【明】【宮】"}
{"id": null, "n": "0488001", "target": "#nkr_note_mod_0488001", "type": "mod", "text": "分【大】，支【明】"}
{"id": null, "n": "0488002", "target": "#nkr_note_mod_0488002", "type": "mod", "text": "句矣【大】，偈半【宋】【元】【明】【宮】"}
{"id": null, "n": "0488003", "target": "#nkr_note_mod_0488003", "type": "mod", "text": "分別【大】，別分【宋】【元】【明】【宮】"}
{"id": null, "n": "0488004", "target": "#nkr_note_mod_0488004", "type": "mod", "text": "支【大】，分【明】"}
{"id": null, "n": "0488005", "target": "#nkr_note_mod_0488005", "type": "mod", "text": "節【大】，節此二【宋】【元】【明】【宮】"}
{"id": null, "n": "0488006", "target": "#nkr_note_mod_0488006", "type": "mod", "text": "轉【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0488007", "target": "#nkr_note_mod_0488007", "type": "mod", "text": "故緣生【大】，緣生故【宋】【元】【明】【宮】"}
{"id": null, "n": "0488008", "target": "#nkr_note_mod_0488008", "type": "mod", "text": "此【大】，此此【宋】【元】【明】"}
{"id": null, "n": "0489001", "target": "#nkr_note_mod_0489001", "type": "mod", "text": "已【大】，以【明】"}
{"id": null, "n": "0489002", "target": "#nkr_note_mod_0489002", "type": "mod", "text": "厭【大】，厭者【明】"}
{"id": null, "n": "0489003", "target": "#nkr_note_mod_0489003", "type": "mod", "text": "業【大】，此業【宋】【元】【明】【宮】"}
{"id": null, "n": "0489004", "target": "#nkr_note_mod_0489004", "type": "mod", "text": "又【大】，又問【宋】【元】【明】【宮】"}
{"id": null, "n": "0489005", "target": "#nkr_note_mod_0489005", "type": "mod", "text": "自性【大】，則自性【宋】【元】【明】【宮】"}
{"id": null, "n": "0489006", "target": "#nkr_note_mod_0489006", "type": "mod", "text": "名【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0489007", "target": "#nkr_note_mod_0489007", "type": "mod", "text": "眾【大】，蘊【明】"}
{"id": null, "n": "0489008", "target": "#nkr_note_mod_0489008", "type": "mod", "text": "唌【大】，涎【宋】【元】【明】【宮】"}
{"id": null, "n": "0489009", "target": "#nkr_note_mod_0489009", "type": "mod", "text": "二種【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0489010", "target": "#nkr_note_mod_0489010", "type": "mod", "text": "牙【大】下同，芽【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0489011", "target": "#nkr_note_mod_0489011", "type": "mod", "text": "繼【大】＊，繫【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0489012", "target": "#nkr_note_mod_0489012", "type": "mod", "text": "差【大】，莖【宮】"}
{"id": null, "n": "0489013", "target": "#nkr_note_mod_0489013", "type": "mod", "text": "故【大】，所【元】【明】"}
{"id": null, "n": "0489014", "target": "#nkr_note_mod_0489014", "type": "mod", "text": "繫【CB】【麗-CB】【宋】【元】【明】【宮】，繁【大】"}
{"id": null, "n": "0490001", "target": "#nkr_note_mod_0490001", "type": "mod", "text": "奄【大】，奢【宋】【元】【明】【宮】"}
{"id": null, "n": "0490002", "target": "#nkr_note_mod_0490002", "type": "mod", "text": "勤【大】，斷【宋】【元】【明】【宮】"}
