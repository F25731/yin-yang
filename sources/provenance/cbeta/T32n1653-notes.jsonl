{"id": null, "n": "0489002", "target": "#nkr_note_orig_0489002", "type": "orig", "text": "厭＋（者）【明】"}
{"id": null, "n": "0489003", "target": "#nkr_note_orig_0489003", "type": "orig", "text": "（此）＋業【三】【宮】"}
{"id": null, "n": "0489004", "target": "#nkr_note_orig_0489004", "type": "orig", "text": "又＋（問）【三】【宮】"}
{"id": null, "n": "0489005", "target": "#nkr_note_orig_0489005", "type": "orig", "text": "（則）＋自性【三】【宮】"}
