{"id": null, "n": "0889003", "target": "#nkr_note_orig_0889003", "type": "orig", "text": "實實ハ原本ニ實々ニツクル。"}
{"id": null, "n": "0889004", "target": "#nkr_note_orig_0889004", "type": "orig", "text": "彼ノ字ノ右下ニ原本ニ「」ノ印アリ。彼故ハ故彼ノ倒置カ。"}
{"id": null, "n": "0890001", "target": "#nkr_note_orig_0890001", "type": "orig", "text": "為明ハ原本ニ明為ニツクル。明ノ字ノ右下ニ「」ノ印アリ。"}
{"id": null, "n": "0890002", "target": "#nkr_note_orig_0890002", "type": "orig", "text": "由因ハ原本ニ因由ニツクル。因ノ字ノ右下ニ「」ノ印アリ。"}
{"id": null, "n": "0890003", "target": "#nkr_note_orig_0890003", "type": "orig", "text": "見見ハ原本ニ見々ニツクル。"}
{"id": null, "n": "0890004", "target": "#nkr_note_orig_0890004", "type": "orig", "text": "由由ハ原本ニ由々ニツクル。"}
{"id": null, "n": "0890005", "target": "#nkr_note_orig_0890005", "type": "orig", "text": "如是ハ原本ニ是如ニツクル。是ノ右下ニ「」ノ印アリ。又經文（󴦞12、222頁上）モ如是トス。"}
{"id": null, "n": "0891001", "target": "#nkr_note_orig_0891001", "type": "orig", "text": "耶ハ邪ニ同ジカ。"}
{"id": null, "n": "0891002", "target": "#nkr_note_orig_0891002", "type": "orig", "text": "顛倒顛倒ハ原文ニ顛々倒々ニツクル。"}
{"id": null, "n": "0891003", "target": "#nkr_note_orig_0891003", "type": "orig", "text": "常常ハ原本ニ常々ニツクル。"}
{"id": null, "n": "0891004", "target": "#nkr_note_orig_0891004", "type": "orig", "text": "憣ハ翻ナリ。以下同ジ。"}
{"id": null, "n": "0891005", "target": "#nkr_note_orig_0891005", "type": "orig", "text": "有有ハ原本ニ有々ニツクル。"}
{"id": null, "n": "0891006", "target": "#nkr_note_orig_0891006", "type": "orig", "text": "我我ハ原本ニ我々ニツクル。以下同ジ。"}
{"id": null, "n": "0891007", "target": "#nkr_note_orig_0891007", "type": "orig", "text": "『寶窟』ノ援用部分（󴦞37、77頁下）ニヨリ諸ノ一字ハ衍字トナス。"}
{"id": null, "n": "0891008", "target": "#nkr_note_orig_0891008", "type": "orig", "text": "法餘ハ原本ニ餘法ニツクル。餘ノ字ノ右下ニ「」ノ印アリ。又經文モ法餘トス（󴦞12、222頁上）。"}
{"id": null, "n": "0891009", "target": "#nkr_note_orig_0891009", "type": "orig", "text": "耶ハ『寶窟』中ノ援用部分（󴦞37、78頁上）ニハ邪トツクル。"}
{"id": null, "n": "0891010", "target": "#nkr_note_orig_0891010", "type": "orig", "text": "『寶窟』中ノ援用部分（󴦞37、78頁上）ニハ无ハ不トアリ。"}
{"id": null, "n": "0891011", "target": "#nkr_note_orig_0891011", "type": "orig", "text": "聞聞ハ原本ニ聞々ニツクル。"}
{"id": null, "n": "0892001", "target": "#nkr_note_orig_0892001", "type": "orig", "text": "得ハ『寶窟』中ノ援用部分（󴦞37、78頁中）ニハ說トアリ。"}
{"id": null, "n": "0892002", "target": "#nkr_note_orig_0892002", "type": "orig", "text": "智境ハ原本ニ智境ニツクル。境ノ字ノ右下ニ「」ノ印アリ。"}
{"id": null, "n": "0892003", "target": "#nkr_note_orig_0892003", "type": "orig", "text": "此淨ハ原本ニ淨此ニツクル。淨ノ字ノ右下ニ「」ノ印アリ。又經モ此淨トス（󴦞12、222頁上）"}
{"id": null, "n": "0892004", "target": "#nkr_note_orig_0892004", "type": "orig", "text": "虵虵ハ原本ニ虵々ニツクル。以下同ジ。"}
{"id": null, "n": "0892005", "target": "#nkr_note_orig_0892005", "type": "orig", "text": "情作情作ハ原本ニ情々作々ニツクル。"}
{"id": null, "n": "0893001", "target": "#nkr_note_orig_0893001", "type": "orig", "text": "種種ハ原本ニ種々ニツクル。"}
{"id": null, "n": "0893002", "target": "#nkr_note_orig_0893002", "type": "orig", "text": "沒沒ハ原本ニ沒々ニツクル。"}
{"id": null, "n": "0893003", "target": "#nkr_note_orig_0893003", "type": "orig", "text": "根根ハ原本ニ根々ニツクル。"}
{"id": null, "n": "0893004", "target": "#nkr_note_orig_0893004", "type": "orig", "text": "切明ハ原本ニ明切ニツクル。明ノ字ノ右下ニ「」ノ印アリ。"}
{"id": null, "n": "0893005", "target": "#nkr_note_orig_0893005", "type": "orig", "text": "義ハ議カ。"}
{"id": null, "n": "0893006", "target": "#nkr_note_orig_0893006", "type": "orig", "text": "壽命ハ原本ニ命壽ニツクル。命ノ字ノ右下ニ「」ノ印アリ。"}
{"id": null, "n": "0893007", "target": "#nkr_note_orig_0893007", "type": "orig", "text": "情情ハ原本ニ情々ニツクル。"}
{"id": null, "n": "0893008", "target": "#nkr_note_orig_0893008", "type": "orig", "text": "耶ハ邪カ。"}
{"id": null, "n": "0894001", "target": "#nkr_note_orig_0894001", "type": "orig", "text": "惚惚ハ原本ニ惚々ニツクル。"}
{"id": null, "n": "0894002", "target": "#nkr_note_orig_0894002", "type": "orig", "text": "至ハ云カ。"}
{"id": null, "n": "0894003", "target": "#nkr_note_orig_0894003", "type": "orig", "text": "不染不染ハ原本ニ不々染々ニツクル。"}
{"id": null, "n": "0894004", "target": "#nkr_note_orig_0894004", "type": "orig", "text": "心心ハ原本ニ心々ニツクル。"}
{"id": null, "n": "0894005", "target": "#nkr_note_orig_0894005", "type": "orig", "text": "繩繩ハ原本ニ繩々ニツクル。"}
{"id": null, "n": "0894006", "target": "#nkr_note_orig_0894006", "type": "orig", "text": "至ハ云カ。"}
{"id": null, "n": "0894007", "target": "#nkr_note_orig_0894007", "type": "orig", "text": "勝鬘勝鬘ハ原本ニ勝々鬘々ニツクル。"}
{"id": null, "n": "0895001", "target": "#nkr_note_orig_0895001", "type": "orig", "text": "化化ハ原本ニ化々ニツクル。"}
{"id": null, "n": "0895002", "target": "#nkr_note_orig_0895002", "type": "orig", "text": "鳥ハ『寶窟』中ノ援用部分（󴦞37、88頁下）ニハ象トツクル。"}
{"id": null, "n": "0895003", "target": "#nkr_note_orig_0895003", "type": "orig", "text": "耶ハ『寶窟』中ノ援用部分（󴦞37、88頁下）ニハ邪トツクル。"}
{"id": null, "n": "0895004", "target": "#nkr_note_orig_0895004", "type": "orig", "text": "耶ハ『寶窟』中ノ援用部分（󴦞37、88頁下）ニハ邪トツクル。"}
{"id": null, "n": "0895005", "target": "#nkr_note_orig_0895005", "type": "orig", "text": "耶ハ邪ニ同ジカ。"}
{"id": null, "n": "0895006", "target": "#nkr_note_orig_0895006", "type": "orig", "text": "信信ハ原本ニ信々ニツクル。"}
{"id": null, "n": "0895007", "target": "#nkr_note_orig_0895007", "type": "orig", "text": "耶ハ邪ニ同ジカ。"}
{"id": null, "n": "0895008", "target": "#nkr_note_orig_0895008", "type": "orig", "text": "耶ハ『寶窟』ノ援用部分（󴦞37、89頁上）ニ邪トツクル。"}
{"id": null, "n": "0895009", "target": "#nkr_note_orig_0895009", "type": "orig", "text": "耶ハ『寶窟』ノ援用部分（󴦞37、89頁上）ニ邪トツクル。"}
{"id": null, "n": "0895010", "target": "#nkr_note_orig_0895010", "type": "orig", "text": "耶ハ邪ニ同ジカ。"}
{"id": null, "n": "0896001", "target": "#nkr_note_orig_0896001", "type": "orig", "text": "染ハ深カ。經文モ深トアリ（󴦞12、223頁上）。"}
{"id": null, "n": "0896002", "target": "#nkr_note_orig_0896002", "type": "orig", "text": "耶ハ邪ニ同ジカ。"}
{"id": null, "n": "0896003", "target": "#nkr_note_orig_0896003", "type": "orig", "text": "喜喜ハ原本ニ喜々ニツクル。"}
{"id": null, "n": "0896004", "target": "#nkr_note_orig_0896004", "type": "orig", "text": "人人ハ原本ニ人々ニツクル。"}
{"id": null, "n": "0896005", "target": "#nkr_note_orig_0896005", "type": "orig", "text": "各各ハ原本ニ各々ニツクル。"}
{"id": null, "n": "0896006", "target": "#nkr_note_orig_0896006", "type": "orig", "text": "若復ハ原本ニ復若ニツクル。復ノ右下ニ「」ノ印アリ。"}
{"id": null, "n": "0896007", "target": "#nkr_note_orig_0896007", "type": "orig", "text": "󴔱ハ勸ナリ。"}
{"id": null, "n": "0896008", "target": "#nkr_note_orig_0896008", "type": "orig", "text": "一一ハ原本ニ一々ニツクル。"}
{"id": null, "n": "0897001", "target": "#nkr_note_orig_0897001", "type": "orig", "text": "帝ハ諦カ。"}
