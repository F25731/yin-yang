{"id": null, "n": "0161012", "target": "#nkr_note_mod_0161012", "type": "mod", "text": "之【大】，之說【考偽-原】"}
{"id": null, "n": "0162001", "target": "#nkr_note_mod_0162001", "type": "mod", "text": "雲雨【大】，爾【校異-原】"}
{"id": null, "n": "0162002", "target": "#nkr_note_mod_0162002", "type": "mod", "text": "三【大】，三天【考偽-大】"}
{"id": null, "n": "0162003", "target": "#nkr_note_mod_0162003", "type": "mod", "text": "天【大】，〔－〕【考偽-大】"}
{"id": null, "n": "0162004", "target": "#nkr_note_mod_0162004", "type": "mod", "text": "界【大】，〔－〕【考偽-原】"}
{"id": null, "n": "0163001", "target": "#nkr_note_mod_0163001", "type": "mod", "text": "薩【大】，菩薩【考偽-大】"}
{"id": null, "n": "0163002", "target": "#nkr_note_mod_0163002", "type": "mod", "text": "迴【大】，遍【原】"}
{"id": null, "n": "0163003", "target": "#nkr_note_mod_0163003", "type": "mod", "text": "胝【大】，眠【考偽-原】"}
{"id": null, "n": "0164001", "target": "#nkr_note_mod_0164001", "type": "mod", "text": "丘【CB】【考偽-大】，尼【大】"}
{"id": null, "n": "0164002", "target": "#nkr_note_mod_0164002", "type": "mod", "text": "監文【大】，堅又【考偽-原】"}
{"id": null, "n": "0165001", "target": "#nkr_note_mod_0165001", "type": "mod", "text": "伏【大】＊，仗【考偽-原】＊"}
{"id": null, "n": "0165002", "target": "#nkr_note_mod_0165002", "type": "mod", "text": "與【大】，興【考偽-原】"}
{"id": null, "n": "0161010", "target": "#nkr_note_orig_0161010", "type": "orig", "text": "【原】寬延二年刊豐山大學藏本"}
{"id": null, "n": "0161011", "target": "#nkr_note_orig_0161011", "type": "orig", "text": "校者曰原本罪滅乃至三十三為三張，悉不乃至四天為二張，而案文義二張三張誤前後乎，故今改前後載之"}
{"id": null, "n": "0161012", "target": "#nkr_note_orig_0161012", "type": "orig", "text": "之＋（說）ヵ【原】"}
{"id": null, "n": "0162001", "target": "#nkr_note_orig_0162001", "type": "orig", "text": "雲雨＝爾ィ【原】"}
{"id": null, "n": "0162002", "target": "#nkr_note_orig_0162002", "type": "orig", "text": "三＋（天）？"}
{"id": null, "n": "0162003", "target": "#nkr_note_orig_0162003", "type": "orig", "text": "〔天〕－？"}
{"id": null, "n": "0162004", "target": "#nkr_note_orig_0162004", "type": "orig", "text": "〔界〕－ヵ【原】"}
{"id": null, "n": "0163001", "target": "#nkr_note_orig_0163001", "type": "orig", "text": "（菩）＋薩？"}
{"id": null, "n": "0163002", "target": "#nkr_note_orig_0163002", "type": "orig", "text": "迴＝遍【原】"}
{"id": null, "n": "0163003", "target": "#nkr_note_orig_0163003", "type": "orig", "text": "胝＝眠ヵ【原】"}
{"id": null, "n": "0164001", "target": "#nkr_note_orig_0164001", "type": "orig", "text": "尼＝丘？"}
{"id": null, "n": "0164002", "target": "#nkr_note_orig_0164002", "type": "orig", "text": "監文＝堅又ヵ【原】"}
{"id": null, "n": "0165001", "target": "#nkr_note_orig_0165001", "type": "orig", "text": "伏＝仗ヵ【原】＊"}
{"id": null, "n": "0165002", "target": "#nkr_note_orig_0165002", "type": "orig", "text": "與＝興ヵ【原】"}
{"id": null, "n": "0163c0801", "target": "#nkr_note_add_0163c0801", "type": "add", "text": "［－］【CB】，[04]【大】"}
