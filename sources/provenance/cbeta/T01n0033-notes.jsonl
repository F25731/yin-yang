{"id": null, "n": "0817001", "target": "#nkr_note_mod_0817001", "type": "mod", "text": "三藏法師【大】，沙門釋【宋】【元】【明】"}
{"id": null, "n": "0817002", "target": "#nkr_note_mod_0817002", "type": "mod", "text": "坐【大】＊，座【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0817003", "target": "#nkr_note_mod_0817003", "type": "mod", "text": "正【大】，整【宋】【元】【明】"}
{"id": null, "n": "0817004", "target": "#nkr_note_mod_0817004", "type": "mod", "text": "甚【大】＊，其【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0817005", "target": "#nkr_note_mod_0817005", "type": "mod", "text": "得【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0817006", "target": "#nkr_note_mod_0817006", "type": "mod", "text": "清溷【大】，圊圂【宋】【元】，圊溷【明】"}
{"id": null, "n": "0817007", "target": "#nkr_note_mod_0817007", "type": "mod", "text": "清溷【大】＊，圊溷【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0817008", "target": "#nkr_note_mod_0817008", "type": "mod", "text": "是【大】，彼【宋】【元】【明】"}
{"id": null, "n": "0817009", "target": "#nkr_note_mod_0817009", "type": "mod", "text": "于【大】，千【宋】【元】【明】"}
{"id": null, "n": "0817010", "target": "#nkr_note_mod_0817010", "type": "mod", "text": "愧【大】，貴【宋】【元】【明】"}
{"id": null, "n": "0817011", "target": "#nkr_note_mod_0817011", "type": "mod", "text": "道【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0817012", "target": "#nkr_note_mod_0817012", "type": "mod", "text": "含【大】，含者【宋】【元】【明】"}
{"id": null, "n": "0817013", "target": "#nkr_note_mod_0817013", "type": "mod", "text": "已【大】，以【宋】【元】【明】"}
{"id": null, "n": "0817001", "target": "#nkr_note_orig_0817001", "type": "orig", "text": "三藏法師＝沙門釋【三】"}
{"id": null, "n": "0817002", "target": "#nkr_note_orig_0817002", "type": "orig", "text": "坐＝座【三】＊"}
{"id": null, "n": "0817003", "target": "#nkr_note_orig_0817003", "type": "orig", "text": "正＝整【三】"}
{"id": null, "n": "0817004", "target": "#nkr_note_orig_0817004", "type": "orig", "text": "甚＝其【三】＊"}
{"id": null, "n": "0817005", "target": "#nkr_note_orig_0817005", "type": "orig", "text": "〔得〕－【三】"}
{"id": null, "n": "0817006", "target": "#nkr_note_orig_0817006", "type": "orig", "text": "清溷＝圊圂【宋】【元】，圊溷【明】"}
{"id": null, "n": "0817007", "target": "#nkr_note_orig_0817007", "type": "orig", "text": "清溷＝圊溷【三】＊"}
{"id": null, "n": "0817008", "target": "#nkr_note_orig_0817008", "type": "orig", "text": "是＝彼【三】"}
{"id": null, "n": "0817009", "target": "#nkr_note_orig_0817009", "type": "orig", "text": "于＝千【三】"}
{"id": null, "n": "0817010", "target": "#nkr_note_orig_0817010", "type": "orig", "text": "愧＝貴【三】"}
{"id": null, "n": "0817011", "target": "#nkr_note_orig_0817011", "type": "orig", "text": "〔道〕－【三】"}
{"id": null, "n": "0817012", "target": "#nkr_note_orig_0817012", "type": "orig", "text": "含＋（者）【三】"}
{"id": null, "n": "0817013", "target": "#nkr_note_orig_0817013", "type": "orig", "text": "已＝以【三】"}
