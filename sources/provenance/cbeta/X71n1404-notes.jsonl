{"id": null, "n": null, "target": null, "type": null, "text": "便燒香禮拜"}
{"id": null, "n": null, "target": null, "type": null, "text": "問答不錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "便舉法衣云"}
{"id": null, "n": null, "target": null, "type": null, "text": "便披"}
{"id": null, "n": null, "target": null, "type": null, "text": "便起"}
{"id": null, "n": null, "target": null, "type": null, "text": "問答不錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "著語\n云：癡狂外邊走"}
{"id": null, "n": null, "target": null, "type": null, "text": "曾經霜雪苦"}
{"id": null, "n": null, "target": null, "type": null, "text": "喚鐘作甕"}
{"id": null, "n": null, "target": null, "type": null, "text": "狐狸探水"}
{"id": null, "n": null, "target": null, "type": null, "text": "著語云：板齒如鐵橛。"}
{"id": null, "n": null, "target": null, "type": null, "text": "舌頭拄上腭。"}
{"id": null, "n": null, "target": null, "type": null, "text": "問答不錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "問答不錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "見其語異"}
{"id": null, "n": null, "target": null, "type": null, "text": "問答不錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "問答不錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": null, "target": null, "type": null, "text": "指燭云"}
{"id": null, "n": null, "target": null, "type": null, "text": "咄"}
{"id": null, "n": null, "target": null, "type": null, "text": "以香指祖師云"}
{"id": null, "n": null, "target": null, "type": null, "text": "復自指云"}
{"id": null, "n": null, "target": null, "type": null, "text": "插香\n云"}
{"id": null, "n": null, "target": null, "type": null, "text": "咄！"}
{"id": null, "n": null, "target": null, "type": null, "text": "咄"}
{"id": null, "n": null, "target": null, "type": null, "text": "擲下云"}
{"id": null, "n": null, "target": null, "type": null, "text": "便起"}
{"id": null, "n": null, "target": null, "type": null, "text": "問答不錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "值雪"}
{"id": null, "n": null, "target": null, "type": null, "text": "燒香云"}
{"id": null, "n": null, "target": null, "type": null, "text": "噁"}
{"id": null, "n": null, "target": null, "type": null, "text": "著語云：門內有君子，門外君\n子至。"}
{"id": null, "n": null, "target": null, "type": null, "text": "相見易得\n好，共住難為人。"}
{"id": null, "n": null, "target": null, "type": null, "text": "賊被\n賊捉。"}
{"id": null, "n": null, "target": null, "type": null, "text": "一欵便招。"}
{"id": null, "n": null, "target": null, "type": null, "text": "賊無種相鼓籠。"}
{"id": null, "n": null, "target": null, "type": null, "text": "貧兒\n思舊債。"}
{"id": null, "n": null, "target": null, "type": null, "text": "君向西秦，我\n之東魯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "磚頭來，瓦子報。"}
{"id": null, "n": null, "target": null, "type": null, "text": "檐得一檐懵懂，\n換得一檐骨懂。"}
{"id": null, "n": null, "target": null, "type": null, "text": "第二杓惡水。"}
{"id": null, "n": null, "target": null, "type": null, "text": "一盲引眾盲，相牽入\n火坑。"}
{"id": null, "n": null, "target": null, "type": null, "text": "拾得封皮作信讀。"}
{"id": null, "n": null, "target": null, "type": null, "text": "盡道藥山笑裏有\n\n刀，殊不知怜兒不覺醜。"}
{"id": null, "n": null, "target": null, "type": null, "text": "舌頭拖地。"}
{"id": null, "n": null, "target": null, "type": null, "text": "教休不肯\n休，直待雨霖頭。"}
{"id": null, "n": null, "target": null, "type": null, "text": "為他閑事長無明。"}
{"id": null, "n": null, "target": null, "type": null, "text": "臨袁䖍吉頭上插笔。"}
{"id": null, "n": null, "target": null, "type": null, "text": "同死同生\n為君決。"}
{"id": null, "n": null, "target": null, "type": null, "text": "咄！"}
{"id": null, "n": null, "target": null, "type": null, "text": "禪師號宏覺"}
{"id": null, "n": null, "target": null, "type": null, "text": "咦！"}
{"id": null, "n": null, "target": null, "type": null, "text": "復指侍者云："}
{"id": null, "n": null, "target": null, "type": null, "text": "擲筆噓一聲："}
{"id": null, "n": null, "target": null, "type": null, "text": "復頌曰"}
{"id": null, "n": null, "target": null, "type": null, "text": "呵呵"}
{"id": null, "n": null, "target": null, "type": null, "text": "咄！"}
{"id": null, "n": null, "target": null, "type": null, "text": "咄！"}
{"id": null, "n": null, "target": null, "type": null, "text": "咦！"}
{"id": null, "n": null, "target": null, "type": null, "text": "咦"}
{"id": null, "n": null, "target": null, "type": null, "text": "㘞"}
{"id": null, "n": null, "target": null, "type": null, "text": "佑"}
{"id": null, "n": null, "target": null, "type": null, "text": "出世住戒香"}
{"id": null, "n": null, "target": null, "type": null, "text": "插香云"}
{"id": null, "n": null, "target": null, "type": null, "text": "福州人"}
{"id": null, "n": null, "target": null, "type": null, "text": "浙翁小師在天童死"}
{"id": null, "n": null, "target": null, "type": null, "text": "中秋後"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "B32n0173_p0204a15"}
