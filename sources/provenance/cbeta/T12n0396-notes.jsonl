{"id": null, "n": null, "target": null, "type": "cf1", "text": "K14n0520_p0056a17"}
{"id": null, "n": "1118060", "target": "#nkr_note_mod_1118060", "type": "mod", "text": "（僧祐…錄）十三字【大】，僧祐錄失譯【宋】【宮】，僧祐錄失譯人今附劉宋錄【元】【明】"}
{"id": null, "n": "1118061", "target": "#nkr_note_mod_1118061", "type": "mod", "text": "佛所【大】，如來【宮】"}
{"id": null, "n": "1118062", "target": "#nkr_note_mod_1118062", "type": "mod", "text": "地【大】，地眷屬圍遶渴仰聞法【元】【明】"}
{"id": null, "n": "1118063", "target": "#nkr_note_mod_1118063", "type": "mod", "text": "世尊【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "1118064", "target": "#nkr_note_mod_1118064", "type": "mod", "text": "其必有【大】，必有緣【宋】【元】【明】【宮】"}
{"id": null, "n": "1119001", "target": "#nkr_note_mod_1119001", "type": "mod", "text": "鞠【大】，救【宋】【元】【明】【宮】"}
{"id": null, "n": "1119002", "target": "#nkr_note_mod_1119002", "type": "mod", "text": "恩【大】，思【元】【明】"}
{"id": null, "n": "1119003", "target": "#nkr_note_mod_1119003", "type": "mod", "text": "損【CB】【麗-CB】【宋】【宮】，捐【大】"}
{"id": null, "n": "1119004", "target": "#nkr_note_mod_1119004", "type": "mod", "text": "嫉【大】，疾【宮】"}
{"id": null, "n": "1119005", "target": "#nkr_note_mod_1119005", "type": "mod", "text": "婬妷【大】＊，淫泆【宋】【元】【明】【宮】＊"}
{"id": null, "n": "1119006", "target": "#nkr_note_mod_1119006", "type": "mod", "text": "雖【大】，假【宮】"}
{"id": null, "n": "1119007", "target": "#nkr_note_mod_1119007", "type": "mod", "text": "誦【大】，講【宋】【宮】"}
{"id": null, "n": "1119008", "target": "#nkr_note_mod_1119008", "type": "mod", "text": "抄略前後不肯盡說【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "1119009", "target": "#nkr_note_mod_1119009", "type": "mod", "text": "擇【大】，澤【宋】"}
{"id": null, "n": "1119010", "target": "#nkr_note_mod_1119010", "type": "mod", "text": "乃【大】，能【宋】【宮】"}
{"id": null, "n": "1119011", "target": "#nkr_note_mod_1119011", "type": "mod", "text": "功【大】，福【宋】【元】【明】【宮】"}
{"id": null, "n": "1119012", "target": "#nkr_note_mod_1119012", "type": "mod", "text": "疫氣流行死亡者眾【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "1119013", "target": "#nkr_note_mod_1119013", "type": "mod", "text": "計剋【大】，剋罰【元】【明】"}
{"id": null, "n": "1119014", "target": "#nkr_note_mod_1119014", "type": "mod", "text": "故【大】，處【宋】【元】【明】【宮】"}
{"id": null, "n": "1119015", "target": "#nkr_note_mod_1119015", "type": "mod", "text": "短【大】，促【元】【明】"}
{"id": null, "n": "1119016", "target": "#nkr_note_mod_1119016", "type": "mod", "text": "促【大】，短【宋】【元】【明】【宮】"}
{"id": null, "n": "1119017", "target": "#nkr_note_mod_1119017", "type": "mod", "text": "八【大】，十【宋】【元】【明】【宮】"}
{"id": null, "n": "1119018", "target": "#nkr_note_mod_1119018", "type": "mod", "text": "不問【大】，無有【宋】【元】【明】【宮】"}
{"id": null, "n": "1119019", "target": "#nkr_note_mod_1119019", "type": "mod", "text": "豪【大】，高【宋】【宮】"}
{"id": null, "n": "1119020", "target": "#nkr_note_mod_1119020", "type": "mod", "text": "浮漂【大】，流飄【宋】【元】【明】【宮】"}
{"id": null, "n": "1119021", "target": "#nkr_note_mod_1119021", "type": "mod", "text": "時有【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "1119022", "target": "#nkr_note_mod_1119022", "type": "mod", "text": "預【大】，與【宋】【元】【明】【宮】"}
{"id": null, "n": "1119023", "target": "#nkr_note_mod_1119023", "type": "mod", "text": "怕【大】，泊【宋】【元】【宮】"}
{"id": null, "n": "1119024", "target": "#nkr_note_mod_1119024", "type": "mod", "text": "壽命延長【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "1119025", "target": "#nkr_note_mod_1119025", "type": "mod", "text": "天【大】，王【宋】【元】【明】【宮】"}
{"id": null, "n": "1119026", "target": "#nkr_note_mod_1119026", "type": "mod", "text": "吾【大】，五【宮】"}
{"id": null, "n": "1119027", "target": "#nkr_note_mod_1119027", "type": "mod", "text": "尋【大】，尊【宋】【宮】"}
{"id": null, "n": "1119028", "target": "#nkr_note_mod_1119028", "type": "mod", "text": "（復滅…文字）十字【大】，化滅聖王去後【宋】【元】【明】【宮】"}
{"id": null, "n": "1119029", "target": "#nkr_note_mod_1119029", "type": "mod", "text": "明更盛於是便滅【大】，更明盛【宋】【元】【明】【宮】"}
{"id": null, "n": "1119030", "target": "#nkr_note_mod_1119030", "type": "mod", "text": "之【大】，又【宋】【宮】"}
{"id": null, "n": "1119031", "target": "#nkr_note_mod_1119031", "type": "mod", "text": "云何奉持【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1118060", "target": "#nkr_note_orig_1118060", "type": "orig", "text": "（（僧祐…錄））十三字＝（（僧祐錄失譯））五字【宋】【宮】，（（僧祐錄失譯人今附劉宋錄））十一字【元】【明】"}
