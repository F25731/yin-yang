{"id": null, "n": null, "target": null, "type": "cf1", "text": "T12n0334_p0076c27"}
{"id": null, "n": "0081001", "target": null, "type": "orig", "text": "〔無〕－【明】【宮】"}
{"id": null, "n": "0081001", "target": null, "type": "mod", "text": "無【大】，〔－〕【明】【宮】"}
{"id": null, "n": "0078014", "target": "#nkr_note_mod_0078014", "type": "mod", "text": "往【大】，住【宮】"}
{"id": null, "n": "0079001", "target": "#nkr_note_mod_0079001", "type": "mod", "text": "問【大】，間【元】【明】"}
{"id": null, "n": "0079002", "target": "#nkr_note_mod_0079002", "type": "mod", "text": "本【大】，根【宮】"}
{"id": null, "n": "0079003", "target": "#nkr_note_mod_0079003", "type": "mod", "text": "諭【大】＊，諛【元】【明】＊"}
{"id": null, "n": "0079004", "target": "#nkr_note_mod_0079004", "type": "mod", "text": "若【大】，常【元】【明】"}
{"id": null, "n": "0080001", "target": "#nkr_note_mod_0080001", "type": "mod", "text": "事【大】，義【宮】"}
{"id": null, "n": "0080002", "target": "#nkr_note_mod_0080002", "type": "mod", "text": "講【大】，遘【元】【明】"}
{"id": null, "n": "0081002", "target": "#nkr_note_mod_0081002", "type": "mod", "text": "法【大】，諸法【元】【明】"}
{"id": null, "n": "0081003", "target": "#nkr_note_mod_0081003", "type": "mod", "text": "和【大】，惒【元】【明】"}
{"id": null, "n": "0081004", "target": "#nkr_note_mod_0081004", "type": "mod", "text": "佛說【大】，〔－〕【宮】"}
{"id": null, "n": "0078013", "target": "#nkr_note_orig_0078013", "type": "orig", "text": "麗藏無此經故以【元】【明】對校【宋】"}
{"id": null, "n": "0078014", "target": "#nkr_note_orig_0078014", "type": "orig", "text": "往＝住【宮】"}
{"id": null, "n": "0079001", "target": "#nkr_note_orig_0079001", "type": "orig", "text": "問＝間【元】【明】"}
{"id": null, "n": "0079002", "target": "#nkr_note_orig_0079002", "type": "orig", "text": "本＝根【宮】"}
{"id": null, "n": "0079003", "target": "#nkr_note_orig_0079003", "type": "orig", "text": "諭＝諛【元】【明】＊"}
{"id": null, "n": "0079004", "target": "#nkr_note_orig_0079004", "type": "orig", "text": "若＝常【元】【明】"}
{"id": null, "n": "0080001", "target": "#nkr_note_orig_0080001", "type": "orig", "text": "事＝義【宮】"}
{"id": null, "n": "0080002", "target": "#nkr_note_orig_0080002", "type": "orig", "text": "講＝遘【元】【明】"}
{"id": null, "n": "0081002", "target": "#nkr_note_orig_0081002", "type": "orig", "text": "（諸）＋法【元】【明】"}
{"id": null, "n": "0081003", "target": "#nkr_note_orig_0081003", "type": "orig", "text": "和＝惒【元】【明】"}
{"id": null, "n": "0081004", "target": "#nkr_note_orig_0081004", "type": "orig", "text": "〔佛說〕－【宮】"}
{"id": null, "n": "0079b0801", "target": "#nkr_note_add_0079b0801", "type": "add", "text": "歡【CB】，勸【大】"}
{"id": null, "n": "0079c1301", "target": "#nkr_note_add_0079c1301", "type": "add", "text": "［－］【CB】，滅【大】"}
{"id": null, "n": "0080c1801", "target": "#nkr_note_add_0080c1801", "type": "add", "text": "CBETA 按：此處原有「女意云何法無所住……使立無上正真之道」共 744 字，與竺法護所譯的《梵志女首意經》內容（T14n0567_p0940a10-b27）幾乎相同，然而卻突兀於本經，疑經卷錯簡。對校本經宮本、思溪乙本、新文豐版磧砂本，均同大正藏。今刪除該段文字，相關資訊另可參考《初期大乘佛教之起源與開展》（Y37n0035_p0898a14-p0899a02）。"}
{"id": null, "n": "0080c1802", "target": "#nkr_note_add_0080c1802", "type": "add", "text": "〔－〕【CB】，女意云何法無所住【大】"}
{"id": null, "n": "0080c1901", "target": "#nkr_note_add_0080c1901", "type": "add", "text": "〔－〕【CB】，豈有我名乎【大】"}
{"id": null, "n": "0080c1902", "target": "#nkr_note_add_0080c1902", "type": "add", "text": "〔－〕【CB】，答曰不也天中天【大】"}
{"id": null, "n": "0080c1903", "target": "#nkr_note_add_0080c1903", "type": "add", "text": "〔－〕【CB】，於女意云何【大】"}
{"id": null, "n": "0080c2001", "target": "#nkr_note_add_0080c2001", "type": "add", "text": "〔－〕【CB】，其幻化者豈有到後世復來者乎【大】"}
{"id": null, "n": "0080c2002", "target": "#nkr_note_add_0080c2002", "type": "add", "text": "〔－〕【CB】，答曰不【大】"}
{"id": null, "n": "0080c2101", "target": "#nkr_note_add_0080c2101", "type": "add", "text": "〔－〕【CB】，也天中天【大】"}
{"id": null, "n": "0080c2102", "target": "#nkr_note_add_0080c2102", "type": "add", "text": "〔－〕【CB】，於女意云何其幻化者豈有所【大】"}
{"id": null, "n": "0080c2201", "target": "#nkr_note_add_0080c2201", "type": "add", "text": "〔－〕【CB】，起所滅乎【大】"}
{"id": null, "n": "0080c2202", "target": "#nkr_note_add_0080c2202", "type": "add", "text": "〔－〕【CB】，答曰不也天中天【大】"}
{"id": null, "n": "0080c2203", "target": "#nkr_note_add_0080c2203", "type": "add", "text": "〔－〕【CB】，於女意云何其【大】"}
{"id": null, "n": "0080c2301", "target": "#nkr_note_add_0080c2301", "type": "add", "text": "〔－〕【CB】，幻化者豈有所有有形像乎【大】"}
{"id": null, "n": "0080c2302", "target": "#nkr_note_add_0080c2302", "type": "add", "text": "〔－〕【CB】，答曰不也天【大】"}
{"id": null, "n": "0080c2401", "target": "#nkr_note_add_0080c2401", "type": "add", "text": "〔－〕【CB】，中天【大】"}
{"id": null, "n": "0080c2402", "target": "#nkr_note_add_0080c2402", "type": "add", "text": "〔－〕【CB】，於女意云何其幻化者豈有見聞有幻【大】"}
{"id": null, "n": "0080c2501", "target": "#nkr_note_add_0080c2501", "type": "add", "text": "〔－〕【CB】，無幻乎【大】"}
{"id": null, "n": "0080c2502", "target": "#nkr_note_add_0080c2502", "type": "add", "text": "〔－〕【CB】，答曰不也天中天【大】"}
{"id": null, "n": "0080c2503", "target": "#nkr_note_add_0080c2503", "type": "add", "text": "〔－〕【CB】，其女曰佛言【大】"}
{"id": null, "n": "0080c2601", "target": "#nkr_note_add_0080c2601", "type": "add", "text": "〔－〕【CB】，我曾聞之其幻化者無有見聞有幻無幻【大】"}
{"id": null, "n": "0080c2602", "target": "#nkr_note_add_0080c2602", "type": "add", "text": "〔－〕【CB】，世【大】"}
{"id": null, "n": "0080c2701", "target": "#nkr_note_add_0080c2701", "type": "add", "text": "〔－〕【CB】，尊又問於女意云何其幻化者假使無身豈【大】"}
{"id": null, "n": "0080c2801", "target": "#nkr_note_add_0080c2801", "type": "add", "text": "〔－〕【CB】，能令幻化發起諸行乎【大】"}
{"id": null, "n": "0080c2802", "target": "#nkr_note_add_0080c2802", "type": "add", "text": "〔－〕【CB】，女答曰唯天中天其【大】"}
{"id": null, "n": "0080c2901", "target": "#nkr_note_add_0080c2901", "type": "add", "text": "〔－〕【CB】，幻化者實為如此真無所有【大】"}
{"id": null, "n": "0080c2902", "target": "#nkr_note_add_0080c2902", "type": "add", "text": "〔－〕【CB】，佛言如是其無【大】"}
{"id": null, "n": "0081a0101", "target": "#nkr_note_add_0081a0101", "type": "add", "text": "〔－〕【CB】，明者無內無外計其法者亦無所有亦無字【大】"}
{"id": null, "n": "0081a0201", "target": "#nkr_note_add_0081a0201", "type": "add", "text": "〔－〕【CB】，也其明者不至後世亦無還反其無明者亦【大】"}
{"id": null, "n": "0081a0301", "target": "#nkr_note_add_0081a0301", "type": "add", "text": "〔－〕【CB】，無有起亦無有滅其無明者亦無形像適【大】"}
{"id": null, "n": "0081a0401", "target": "#nkr_note_add_0081a0401", "type": "add", "text": "〔－〕【CB】，興無明緣致眾行名色六入更習痛愛受【大】"}
{"id": null, "n": "0081a0501", "target": "#nkr_note_add_0081a0501", "type": "add", "text": "〔－〕【CB】，有生老病死勤苦愁惱大患集會【大】"}
{"id": null, "n": "0081a0502", "target": "#nkr_note_add_0081a0502", "type": "add", "text": "〔－〕【CB】，明女首意【大】"}
{"id": null, "n": "0081a0601", "target": "#nkr_note_add_0081a0601", "type": "add", "text": "〔－〕【CB】，白佛言甚為可奇至未曾有世尊所興而【大】"}
{"id": null, "n": "0081a0701", "target": "#nkr_note_add_0081a0701", "type": "add", "text": "〔－〕【CB】，不可及所以者何佛天中天於虛空中而【大】"}
{"id": null, "n": "0081a0801", "target": "#nkr_note_add_0081a0801", "type": "add", "text": "〔－〕【CB】，轉法輪法輪不可思議所轉法輪不可稱限【大】"}
{"id": null, "n": "0081a0901", "target": "#nkr_note_add_0081a0901", "type": "add", "text": "〔－〕【CB】，無量法輪無獲法輪無形法輪無生法輪【大】"}
{"id": null, "n": "0081a1001", "target": "#nkr_note_add_0081a1001", "type": "add", "text": "〔－〕【CB】，滅度法輪【大】"}
{"id": null, "n": "0081a1002", "target": "#nkr_note_add_0081a1002", "type": "add", "text": "〔－〕【CB】，世尊告曰如是如是誠如所云【大】"}
{"id": null, "n": "0081a1101", "target": "#nkr_note_add_0081a1101", "type": "add", "text": "〔－〕【CB】，吾所轉輪為轉空輪所轉法輪不可思議所【大】"}
{"id": null, "n": "0081a1201", "target": "#nkr_note_add_0081a1201", "type": "add", "text": "〔－〕【CB】，轉法輪不可稱限其可轉輪無獲無形無生【大】"}
{"id": null, "n": "0081a1301", "target": "#nkr_note_add_0081a1301", "type": "add", "text": "〔－〕【CB】，為滅度也【大】"}
{"id": null, "n": "0081a1302", "target": "#nkr_note_add_0081a1302", "type": "add", "text": "〔－〕【CB】，時首意女歡喜踊躍善心生焉【大】"}
{"id": null, "n": "0081a1401", "target": "#nkr_note_add_0081a1401", "type": "add", "text": "〔－〕【CB】，則以栴檀香擣及諸華香供養散佛唯然世【大】"}
{"id": null, "n": "0081a1501", "target": "#nkr_note_add_0081a1501", "type": "add", "text": "〔－〕【CB】，尊以是德本深致擁護而善救攝降伏諸根【大】"}
{"id": null, "n": "0081a1601", "target": "#nkr_note_add_0081a1601", "type": "add", "text": "〔－〕【CB】，抑制愛欲逮轉法輪轉於空輪不思議輪【大】"}
{"id": null, "n": "0081a1701", "target": "#nkr_note_add_0081a1701", "type": "add", "text": "〔－〕【CB】，不可稱限無量無獲無形無生滅度之輪【大】"}
{"id": null, "n": "0081a1702", "target": "#nkr_note_add_0081a1702", "type": "add", "text": "〔－〕【CB】，佛【大】"}
{"id": null, "n": "0081a1801", "target": "#nkr_note_add_0081a1801", "type": "add", "text": "〔－〕【CB】，尋欣笑五色——青赤黃白綠——光從口而出甚大【大】"}
{"id": null, "n": "0081a1901", "target": "#nkr_note_add_0081a1901", "type": "add", "text": "〔－〕【CB】，光明普照十方無數佛國悉皆覆蔽日月之【大】"}
{"id": null, "n": "0081a2001", "target": "#nkr_note_add_0081a2001", "type": "add", "text": "〔－〕【CB】，明還繞佛身三匝從頂上入【大】"}
{"id": null, "n": "0081a2002", "target": "#nkr_note_add_0081a2002", "type": "add", "text": "〔－〕【CB】，賢者阿難曉【大】"}
{"id": null, "n": "0081a2101", "target": "#nkr_note_add_0081a2101", "type": "add", "text": "〔－〕【CB】，了七法——一曰知誼二曰解法三曰曉時四【大】"}
{"id": null, "n": "0081a2201", "target": "#nkr_note_add_0081a2201", "type": "add", "text": "〔－〕【CB】，曰了節五曰明眾六曰練己七曰深識人本——【大】"}
{"id": null, "n": "0081a2301", "target": "#nkr_note_add_0081a2301", "type": "add", "text": "〔－〕【CB】，即從座起更整衣服偏袒右肩下右膝叉手【大】"}
{"id": null, "n": "0081a2401", "target": "#nkr_note_add_0081a2401", "type": "add", "text": "〔－〕【CB】，白佛今大聖欣笑為何感應願說其意唯【大】"}
{"id": null, "n": "0081a2501", "target": "#nkr_note_add_0081a2501", "type": "add", "text": "〔－〕【CB】，天中天多所愍傷多所安隱哀念諸天世間【大】"}
{"id": null, "n": "0081a2601", "target": "#nkr_note_add_0081a2601", "type": "add", "text": "〔－〕【CB】，人民分別說之【大】"}
{"id": null, "n": "0081a2602", "target": "#nkr_note_add_0081a2602", "type": "add", "text": "〔－〕【CB】，佛告阿難爾見梵志女首意【大】"}
{"id": null, "n": "0081a2701", "target": "#nkr_note_add_0081a2701", "type": "add", "text": "〔－〕【CB】，以末栴檀華香擣香供養散佛乎其心誓願【大】"}
{"id": null, "n": "0081a2801", "target": "#nkr_note_add_0081a2801", "type": "add", "text": "〔－〕【CB】，逮轉法輪【大】"}
{"id": null, "n": "0081a2802", "target": "#nkr_note_add_0081a2802", "type": "add", "text": "〔－〕【CB】，對曰已見【大】"}
{"id": null, "n": "0081a2803", "target": "#nkr_note_add_0081a2803", "type": "add", "text": "〔－〕【CB】，佛言是女以斯德本【大】"}
{"id": null, "n": "0081a2901", "target": "#nkr_note_add_0081a2901", "type": "add", "text": "〔－〕【CB】，護己安人多所救攝壽終之後當轉女身至【大】"}
{"id": null, "n": "0081b0101", "target": "#nkr_note_add_0081b0101", "type": "add", "text": "〔－〕【CB】，八十四億劫不歸惡趣供養六萬諸佛世尊【大】"}
{"id": null, "n": "0081b0201", "target": "#nkr_note_add_0081b0201", "type": "add", "text": "〔－〕【CB】，出家為道志于沙門聽受經法受經法已即【大】"}
{"id": null, "n": "0081b0301", "target": "#nkr_note_add_0081b0301", "type": "add", "text": "〔－〕【CB】，時諷誦將御如來現在正法佛滅度後供養【大】"}
{"id": null, "n": "0081b0401", "target": "#nkr_note_add_0081b0401", "type": "add", "text": "〔－〕【CB】，舍利勸化無數無量眾生不可計會使立無【大】"}
{"id": null, "n": "0081b0501", "target": "#nkr_note_add_0081b0501", "type": "add", "text": "〔－〕【CB】，上正真之道【大】"}
