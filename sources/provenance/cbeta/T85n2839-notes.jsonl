{"id": null, "n": null, "target": null, "type": null, "text": "已上為覺義"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上覺他"}
{"id": null, "n": null, "target": null, "type": null, "text": "是名覺滿"}
{"id": null, "n": null, "target": null, "type": null, "text": "名三覺"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋"}
{"id": null, "n": null, "target": null, "type": null, "text": "廣釋三覺如上側注離念文中"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋"}
{"id": null, "n": null, "target": null, "type": null, "text": "散"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘根准上"}
{"id": null, "n": null, "target": null, "type": null, "text": "若自在並名佛"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋"}
{"id": null, "n": null, "target": null, "type": null, "text": "出大通方廣經中卷末"}
{"id": null, "n": null, "target": null, "type": null, "text": "理佛法性"}
{"id": null, "n": null, "target": null, "type": null, "text": "事佛性"}
{"id": null, "n": null, "target": null, "type": null, "text": "義正通覺傍通云就事理"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋"}
{"id": null, "n": null, "target": null, "type": null, "text": "准上名覺他"}
{"id": null, "n": null, "target": null, "type": null, "text": "准上名覺滿"}
{"id": null, "n": null, "target": null, "type": null, "text": "修斷顯"}
{"id": null, "n": null, "target": null, "type": null, "text": "化報法"}
{"id": null, "n": null, "target": null, "type": null, "text": "財施。無畏施。法施"}
{"id": null, "n": null, "target": null, "type": null, "text": "攝眾生。攝善法。攝律儀"}
{"id": null, "n": null, "target": null, "type": null, "text": "化"}
{"id": null, "n": null, "target": null, "type": null, "text": "報"}
{"id": null, "n": null, "target": null, "type": null, "text": "法"}
{"id": null, "n": null, "target": null, "type": null, "text": "耐怨害忍。安\n受苦忍。諦察法忍"}
{"id": null, "n": null, "target": null, "type": null, "text": "被甲。攝善。利樂"}
{"id": null, "n": null, "target": null, "type": null, "text": "安住靜慮。辯事靜慮。引發靜慮"}
{"id": null, "n": null, "target": null, "type": null, "text": "生空無分別惠。法空無分別惠。俱空無分別惠"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上第一方便正義。傍通語竟\n名總彰佛體"}
{"id": null, "n": null, "target": null, "type": null, "text": "見聞覺知總數通色"}
{"id": null, "n": null, "target": null, "type": null, "text": "第二入維摩經通經"}
{"id": null, "n": null, "target": null, "type": null, "text": "遠塵"}
{"id": null, "n": null, "target": null, "type": null, "text": "離垢"}
{"id": null, "n": null, "target": null, "type": null, "text": "了無"}
{"id": null, "n": null, "target": null, "type": null, "text": "離垢"}
{"id": null, "n": null, "target": null, "type": null, "text": "遠塵"}
{"id": null, "n": null, "target": null, "type": null, "text": "了無異"}
{"id": null, "n": null, "target": null, "type": null, "text": "根不礙塵"}
{"id": null, "n": null, "target": null, "type": null, "text": "塵不礙根。已上。了無異"}
{"id": null, "n": null, "target": null, "type": null, "text": "無礙道"}
{"id": null, "n": null, "target": null, "type": null, "text": "解脫道"}
{"id": null, "n": null, "target": null, "type": null, "text": "妙覺"}
