{"id": null, "n": null, "target": null, "type": null, "text": "准如是釋應云寂因作意，舊云如理作意者，非正翻也"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K17n0633_p0776c03"}
{"id": null, "n": "0774001", "target": "#nkr_note_mod_0774001", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0774002", "target": "#nkr_note_mod_0774002", "type": "mod", "text": "三藏【大】，唐三藏【宋】【元】【明】【宮】"}
{"id": null, "n": "0774003", "target": "#nkr_note_mod_0774003", "type": "mod", "text": "脫【大】，勝【宋】【元】【明】【宮】"}
{"id": null, "n": "0774004", "target": "#nkr_note_mod_0774004", "type": "mod", "text": "除【大】，降【宋】【元】【明】【宮】"}
{"id": null, "n": "0774005", "target": "#nkr_note_mod_0774005", "type": "mod", "text": "脫【大】，解脫【宋】【元】【明】【宮】"}
{"id": null, "n": "0774006", "target": "#nkr_note_mod_0774006", "type": "mod", "text": "串【大】＊，慣【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0774007", "target": "#nkr_note_mod_0774007", "type": "mod", "text": "三【大】，二【宮】"}
{"id": null, "n": "0775001", "target": "#nkr_note_mod_0775001", "type": "mod", "text": "持【大】，於【宋】【元】【明】【宮】"}
{"id": null, "n": "0775002", "target": "#nkr_note_mod_0775002", "type": "mod", "text": "種性【大】，種姓【宮】"}
{"id": null, "n": "0775003", "target": "#nkr_note_mod_0775003", "type": "mod", "text": "今【大】，令【明】"}
{"id": null, "n": "0775004", "target": "#nkr_note_mod_0775004", "type": "mod", "text": "歡【大】，觀【宋】【元】【明】【宮】"}
{"id": null, "n": "0775005", "target": "#nkr_note_mod_0775005", "type": "mod", "text": "功【大】，力【宮】"}
{"id": null, "n": "0775006", "target": "#nkr_note_mod_0775006", "type": "mod", "text": "能【大】，餘【宋】【元】【明】【宮】"}
{"id": null, "n": "0775007", "target": "#nkr_note_mod_0775007", "type": "mod", "text": "扶【大】＊，符【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0775008", "target": "#nkr_note_mod_0775008", "type": "mod", "text": "三界【大】，三果【宋】【元】【明】，一果【宮】"}
{"id": null, "n": "0776001", "target": "#nkr_note_mod_0776001", "type": "mod", "text": "淨【大】，清淨【宋】【元】【明】【宮】"}
{"id": null, "n": "0776002", "target": "#nkr_note_mod_0776002", "type": "mod", "text": "等【大】，等次第【宋】【元】【明】【宮】"}
{"id": null, "n": "0776003", "target": "#nkr_note_mod_0776003", "type": "mod", "text": "應【大】，因【宋】【元】【明】【宮】"}
{"id": null, "n": "0777001", "target": "#nkr_note_mod_0777001", "type": "mod", "text": "一卷【大】，三十七伽他并釋一卷【宋】【元】【宮】，〔－〕【明】"}
