{"id": null, "n": null, "target": null, "type": null, "text": "註出西山讀書記并鳴道集性學辨"}
{"id": null, "n": null, "target": null, "type": null, "text": "註出元城語錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "出孔子家語"}
{"id": null, "n": null, "target": null, "type": null, "text": "出禮記家語莊列史記等"}
{"id": null, "n": null, "target": null, "type": null, "text": "出旧本韓文有註云大宋重刊韓文欲去此三\n\n通書謀夫於歐陽文忠公公曰不可去故存之晦庵挍韓文亦存之不去已後重番晦庵所挍之板剔\n去之不存矣󰨤古畧亦収之"}
{"id": null, "n": null, "target": null, "type": null, "text": "出韓文旧板今\n板皆有之"}
{"id": null, "n": null, "target": null, "type": null, "text": "出韓文旧板今板皆有之"}
{"id": null, "n": null, "target": null, "type": null, "text": "出大宋三教奏議并資鑒"}
{"id": null, "n": null, "target": null, "type": null, "text": "出𭸼中錄并性孝旨要"}
{"id": null, "n": null, "target": null, "type": null, "text": "出佛祖通載"}
{"id": null, "n": null, "target": null, "type": null, "text": "出劉三吳佃鑑惟通鑑畧之"}
{"id": null, "n": null, "target": null, "type": null, "text": "此処\n起首至於"}
{"id": null, "n": null, "target": null, "type": null, "text": "出附章氏家譜"}
{"id": null, "n": null, "target": null, "type": null, "text": "出資鑒并佛卬語錄後跋"}
{"id": null, "n": null, "target": null, "type": null, "text": "出弘益紀聞"}
{"id": null, "n": null, "target": null, "type": null, "text": "劉時中所得東林親筆論易之語又尹氏家塾及蘓季明茟記詳備并有程子𭰹愛\n元包四德之語"}
{"id": null, "n": null, "target": null, "type": null, "text": "出性斈指要并正易心法"}
{"id": null, "n": null, "target": null, "type": null, "text": "無即所依之空"}
{"id": null, "n": null, "target": null, "type": null, "text": "有即二氣交運"}
{"id": null, "n": null, "target": null, "type": null, "text": "真即一真至理"}
{"id": null, "n": null, "target": null, "type": null, "text": "假即萬物化生"}
{"id": null, "n": null, "target": null, "type": null, "text": "出松窓雜記"}
{"id": null, "n": null, "target": null, "type": null, "text": "出尹氏家塾并性學指要"}
{"id": null, "n": null, "target": null, "type": null, "text": "出性理群書并靈山寺留衣亭\n真跡"}
{"id": null, "n": null, "target": null, "type": null, "text": "出鄭谷集"}
{"id": null, "n": null, "target": null, "type": null, "text": "濂溪行狀"}
{"id": null, "n": null, "target": null, "type": null, "text": "弘益紀聞"}
{"id": null, "n": null, "target": null, "type": null, "text": "弘益紀聞"}
{"id": null, "n": null, "target": null, "type": null, "text": "󷱵中錄并性學指要"}
{"id": null, "n": null, "target": null, "type": null, "text": "出後村集"}
{"id": null, "n": null, "target": null, "type": null, "text": "出史畧等"}
{"id": null, "n": null, "target": null, "type": null, "text": "趙說之心學淵源後跋"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲盖寺碑刻墨跡"}
{"id": null, "n": null, "target": null, "type": null, "text": "弘益紀聞"}
{"id": null, "n": null, "target": null, "type": null, "text": "出󷲷源語錄○\n先師即晦堂心禪師也晦堂嘗以心法授伊川"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡氏大同論"}
{"id": null, "n": null, "target": null, "type": null, "text": "歐陽記錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "伊川所作明道行狀"}
{"id": null, "n": null, "target": null, "type": null, "text": "此二句出唐清凉國師華嚴經䟽"}
{"id": null, "n": null, "target": null, "type": null, "text": "此二句出華嚴經法界觀"}
{"id": null, "n": null, "target": null, "type": null, "text": "此句出唐譯大智度論并禪書"}
{"id": null, "n": null, "target": null, "type": null, "text": "出華嚴宝積大集等經"}
{"id": null, "n": null, "target": null, "type": null, "text": "出鐔律集"}
{"id": null, "n": null, "target": null, "type": null, "text": "全是禪語畧󷘓變之"}
{"id": null, "n": null, "target": null, "type": null, "text": "皆是東林口投周子語意"}
{"id": null, "n": null, "target": null, "type": null, "text": "楞嚴經等"}
{"id": null, "n": null, "target": null, "type": null, "text": "皆出禪書并詣經"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云出周易附鑟纂注"}
{"id": null, "n": null, "target": null, "type": null, "text": "出大惠年譜後"}
{"id": null, "n": null, "target": null, "type": null, "text": "出左焴所作大惠語錄序井拱辰集等書"}
{"id": null, "n": null, "target": null, "type": null, "text": "出資鑑拱辰集性理群書"}
{"id": null, "n": null, "target": null, "type": null, "text": "出朱子大全集并道餘錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "字蹟見舊本寒山詩後"}
{"id": null, "n": null, "target": null, "type": null, "text": "出事文類\n聚"}
{"id": null, "n": null, "target": null, "type": null, "text": "出史畧等"}
{"id": null, "n": null, "target": null, "type": null, "text": "朱子語錄并易解歐陽公雜記性理群書"}
{"id": null, "n": null, "target": null, "type": null, "text": "言語煩者不𠬧鳴道集道餘錄割過者亦不𠬧惟竹軒誦佛經之詩簡座亦收於此"}
{"id": null, "n": null, "target": null, "type": null, "text": "出列子註"}
{"id": null, "n": null, "target": null, "type": null, "text": "詩傳序"}
{"id": null, "n": null, "target": null, "type": null, "text": "隂符經註"}
