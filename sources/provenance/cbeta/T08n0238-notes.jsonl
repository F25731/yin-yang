{"id": null, "n": "0766008", "target": "#nkr_note_mod_0766008", "type": "mod", "text": "大業年中【大】，〔－〕【明】"}
{"id": null, "n": "0766009", "target": "#nkr_note_mod_0766009", "type": "mod", "text": "摶【CB】【明】＊，搏【大】＊，󶬒【磧-CB】【洪武-CB】（CBETA 按：「搏」，宮本、金藏乙抄本作󸞜，磧本、洪武本作󶬒，今依文義作「摶」（音、義「團」）。）"}
{"id": null, "n": "0766010", "target": "#nkr_note_mod_0766010", "type": "mod", "text": "給【大】＊，絡【明】＊"}
{"id": null, "n": "0766011", "target": "#nkr_note_mod_0766011", "type": "mod", "text": "遍【大】＊，徧【明】＊"}
{"id": null, "n": "0767001", "target": "#nkr_note_mod_0767001", "type": "mod", "text": "百【CB】【元】【明】＊，十【大】＊"}
{"id": null, "n": "0767002", "target": "#nkr_note_mod_0767002", "type": "mod", "text": "況【大】，何【宮】"}
{"id": null, "n": "0767003", "target": "#nkr_note_mod_0767003", "type": "mod", "text": "聚【大】，福聚【明】"}
{"id": null, "n": "0767004", "target": "#nkr_note_mod_0767004", "type": "mod", "text": "偈【大】，得【元】"}
{"id": null, "n": "0768001", "target": "#nkr_note_mod_0768001", "type": "mod", "text": "莊【大】＊，㽵【宋】【宮】＊"}
{"id": null, "n": "0768002", "target": "#nkr_note_mod_0768002", "type": "mod", "text": "三十二【大】＊，二三十【宋】【宮】＊"}
{"id": null, "n": "0769001", "target": "#nkr_note_mod_0769001", "type": "mod", "text": "仙【大】，遷【明】"}
{"id": null, "n": "0769002", "target": "#nkr_note_mod_0769002", "type": "mod", "text": "若【大】，善【宋】【元】【宮】"}
{"id": null, "n": "0769003", "target": "#nkr_note_mod_0769003", "type": "mod", "text": "繞【大】，遶【宋】【元】【宮】"}
{"id": null, "n": "0769004", "target": "#nkr_note_mod_0769004", "type": "mod", "text": "百【大】，十【宋】【元】【宮】"}
{"id": null, "n": "0769005", "target": "#nkr_note_mod_0769005", "type": "mod", "text": "猛【大】，狂【宋】【元】【明】【宮】"}
{"id": null, "n": "0769006", "target": "#nkr_note_mod_0769006", "type": "mod", "text": "無我【大】，我無【宋】【元】【明】【宮】"}
{"id": null, "n": "0769007", "target": "#nkr_note_mod_0769007", "type": "mod", "text": "彼不【大】，不彼【宋】【元】【明】【宮】"}
{"id": null, "n": "0770001", "target": "#nkr_note_mod_0770001", "type": "mod", "text": "真如【大】，實如【宋】【元】【宮】"}
{"id": null, "n": "0770002", "target": "#nkr_note_mod_0770002", "type": "mod", "text": "名【大】，具【宋】【元】【明】"}
{"id": null, "n": "0770003", "target": "#nkr_note_mod_0770003", "type": "mod", "text": "百【CB】【明】，十【大】"}
{"id": null, "n": "0771001", "target": "#nkr_note_mod_0771001", "type": "mod", "text": "〔－〕【CB】【明】，人【大】"}
{"id": null, "n": "0771002a", "target": "#nkr_note_mod_0771002a", "type": "mod", "text": "故【CB】【元】【明】，〔－〕【大】"}
{"id": null, "n": "0771002b", "target": "#nkr_note_mod_0771002b", "type": "mod", "text": "彼不【大】，不彼【宋】【宮】"}
{"id": null, "n": "0771003", "target": "#nkr_note_mod_0771003", "type": "mod", "text": "摶【CB】【明】＊，搏【大】＊"}
{"id": null, "n": "0771004", "target": "#nkr_note_mod_0771004", "type": "mod", "text": "等【大】，等經【宮】"}
