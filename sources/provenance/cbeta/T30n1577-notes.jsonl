{"id": null, "n": "0265004", "target": "#nkr_note_mod_0265004", "type": "mod", "text": "石【大】，名【宋】【元】【明】"}
{"id": null, "n": "0265005", "target": "#nkr_note_mod_0265005", "type": "mod", "text": "華【大】，悲【宮】"}
{"id": null, "n": "0265006", "target": "#nkr_note_mod_0265006", "type": "mod", "text": "覺【大】，大丈夫論覺【宋】【元】【宮】"}
