{"id": null, "n": "0263008", "target": "#nkr_note_mod_0263008", "type": "mod", "text": "修【大】，佛【宋】【元】【明】【宮】"}
{"id": null, "n": "0263009", "target": "#nkr_note_mod_0263009", "type": "mod", "text": "作【大】，何【宮】"}
