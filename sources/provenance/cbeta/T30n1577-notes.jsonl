{"id": null, "n": "0256011", "target": "#nkr_note_mod_0256011", "type": "mod", "text": "禮【大】，相【宮】"}
{"id": null, "n": "0257001", "target": "#nkr_note_mod_0257001", "type": "mod", "text": "求【大】，水【宋】【元】【明】【宮】"}
