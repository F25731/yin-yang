{"id": null, "n": "0259010", "target": "#nkr_note_mod_0259010", "type": "mod", "text": "使稱【大】，稱彼【宋】【元】【明】【宮】"}
{"id": null, "n": "0259011", "target": "#nkr_note_mod_0259011", "type": "mod", "text": "者【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0259012", "target": "#nkr_note_mod_0259012", "type": "mod", "text": "食者【CB】【磧-CB】【宋】【元】【明】【宮】，食【大】"}
