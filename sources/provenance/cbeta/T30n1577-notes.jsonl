{"id": null, "n": "0263014", "target": "#nkr_note_mod_0263014", "type": "mod", "text": "樂【大】，樂者【宋】【元】【明】【宮】"}
{"id": null, "n": "0264001", "target": "#nkr_note_mod_0264001", "type": "mod", "text": "饒【大】，大丈夫論饒【宋】【元】【宮】"}
{"id": null, "n": "0264002", "target": "#nkr_note_mod_0264002", "type": "mod", "text": "知他【CB】【磧-CB】【宋】【元】【明】【宮】，知【大】"}
{"id": null, "n": "0264003", "target": "#nkr_note_mod_0264003", "type": "mod", "text": "怜【大】，憐【宋】【元】【明】【宮】"}
{"id": null, "n": "0264004", "target": "#nkr_note_mod_0264004", "type": "mod", "text": "人【大】，眾【宋】【元】【明】【宮】"}
{"id": null, "n": "0264005", "target": "#nkr_note_mod_0264005", "type": "mod", "text": "見【大】，現【宮】"}
