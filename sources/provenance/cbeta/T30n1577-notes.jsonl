{"id": null, "n": "0259004", "target": "#nkr_note_mod_0259004", "type": "mod", "text": "之【大】，快【明】"}
{"id": null, "n": "0259005", "target": "#nkr_note_mod_0259005", "type": "mod", "text": "具【大】，是【宮】"}
{"id": null, "n": "0259006", "target": "#nkr_note_mod_0259006", "type": "mod", "text": "勝【大】，大丈夫論勝【宋】【元】【宮】"}
{"id": null, "n": "0259007", "target": "#nkr_note_mod_0259007", "type": "mod", "text": "有【大】，大【宋】"}
{"id": null, "n": "0259008", "target": "#nkr_note_mod_0259008", "type": "mod", "text": "施主【CB】【磧-CB】【宋】【元】【明】【宮】，主【大】"}
