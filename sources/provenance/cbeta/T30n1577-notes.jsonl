{"id": null, "n": "0257003", "target": "#nkr_note_mod_0257003", "type": "mod", "text": "語【大】，諸【宋】【元】【明】【宮】"}
{"id": null, "n": "0257004", "target": "#nkr_note_mod_0257004", "type": "mod", "text": "消【大】，銷【宋】【元】【明】【宮】"}
{"id": null, "n": "0257005", "target": "#nkr_note_mod_0257005", "type": "mod", "text": "施【大】＊，大丈夫論施【宋】【元】【宮】＊"}
{"id": null, "n": "0257006", "target": "#nkr_note_mod_0257006", "type": "mod", "text": "能【大】，若能【宋】【元】【明】【宮】"}
{"id": null, "n": "0257007", "target": "#nkr_note_mod_0257007", "type": "mod", "text": "者【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0258001", "target": "#nkr_note_mod_0258001", "type": "mod", "text": "好【大】，如【宋】【元】【明】【宮】"}
{"id": null, "n": "0258002", "target": "#nkr_note_mod_0258002", "type": "mod", "text": "沃【大】，惡【宮】"}
{"id": null, "n": "0258003", "target": "#nkr_note_mod_0258003", "type": "mod", "text": "淤【大】，於【元】"}
{"id": null, "n": "0258004", "target": "#nkr_note_mod_0258004", "type": "mod", "text": "拯【大】，極【宋】【元】【明】【宮】"}
{"id": null, "n": "0258005", "target": "#nkr_note_mod_0258005", "type": "mod", "text": "齊【大】，濟【元】【明】"}
{"id": null, "n": "0258006", "target": "#nkr_note_mod_0258006", "type": "mod", "text": "〔－〕【CB】【元】【明】，勝【大】"}
{"id": null, "n": "0258007", "target": "#nkr_note_mod_0258007", "type": "mod", "text": "勝處【CB】【元】【明】【宮】，解脫【大】"}
{"id": null, "n": "0258008", "target": "#nkr_note_mod_0258008", "type": "mod", "text": "壞【大】，懷【元】【明】"}
{"id": null, "n": "0258009", "target": "#nkr_note_mod_0258009", "type": "mod", "text": "喜【大】＊，悅【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0258010", "target": "#nkr_note_mod_0258010", "type": "mod", "text": "是【大】，此【宋】【元】【明】【宮】"}
{"id": null, "n": "0258011", "target": "#nkr_note_mod_0258011", "type": "mod", "text": "乞【大】＊，乞求【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0258012", "target": "#nkr_note_mod_0258012", "type": "mod", "text": "則【大】，財【宋】【元】【明】【宮】"}
{"id": null, "n": "0258013", "target": "#nkr_note_mod_0258013", "type": "mod", "text": "其【大】，具【宋】【元】【明】【宮】"}
{"id": null, "n": "0258014", "target": "#nkr_note_mod_0258014", "type": "mod", "text": "壞【大】，懷【宋】【元】【宮】"}
{"id": null, "n": "0258015", "target": "#nkr_note_mod_0258015", "type": "mod", "text": "之【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0258016", "target": "#nkr_note_mod_0258016", "type": "mod", "text": "今【大】，人【宋】【元】【明】【宮】"}
{"id": null, "n": "0259001", "target": "#nkr_note_mod_0259001", "type": "mod", "text": "便【大】，使【宋】【元】【明】【宮】"}
{"id": null, "n": "0259002", "target": "#nkr_note_mod_0259002", "type": "mod", "text": "又【大】，後【宋】【元】【明】【宮】"}
