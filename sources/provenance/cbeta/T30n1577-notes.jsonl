{"id": null, "n": "0260002", "target": "#nkr_note_mod_0260002", "type": "mod", "text": "等【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0260003", "target": "#nkr_note_mod_0260003", "type": "mod", "text": "各【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0260004", "target": "#nkr_note_mod_0260004", "type": "mod", "text": "渡【大】，度【宋】【元】【明】【宮】"}
{"id": null, "n": "0260005", "target": "#nkr_note_mod_0260005", "type": "mod", "text": "釐至【大】，氂至於【宋】【元】【明】【宮】"}
{"id": null, "n": "0260006", "target": "#nkr_note_mod_0260006", "type": "mod", "text": "捨者捨【大】，者施【宋】【元】【明】【宮】"}
{"id": null, "n": "0260007", "target": "#nkr_note_mod_0260007", "type": "mod", "text": "者【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0260008", "target": "#nkr_note_mod_0260008", "type": "mod", "text": "施心況施【大】，心施何況【宋】【元】【明】【宮】"}
{"id": null, "n": "0260009", "target": "#nkr_note_mod_0260009", "type": "mod", "text": "財【大】，大丈夫論財【宋】【元】【宮】"}
{"id": null, "n": "0261001", "target": "#nkr_note_mod_0261001", "type": "mod", "text": "捨【大】＊，大丈夫論捨【宋】【元】【宮】＊"}
