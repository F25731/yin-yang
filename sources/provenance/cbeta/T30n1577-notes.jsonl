{"id": null, "n": "0264008", "target": "#nkr_note_mod_0264008", "type": "mod", "text": "同得【大】，得同【宋】【元】【明】【宮】"}
{"id": null, "n": "0264009", "target": "#nkr_note_mod_0264009", "type": "mod", "text": "一【大】，一切【宋】【元】【明】【宮】"}
{"id": null, "n": "0264010", "target": "#nkr_note_mod_0264010", "type": "mod", "text": "見【大】，是【元】"}
{"id": null, "n": "0264011", "target": "#nkr_note_mod_0264011", "type": "mod", "text": "他【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0265001", "target": "#nkr_note_mod_0265001", "type": "mod", "text": "愛【大】＊，大丈夫論愛【宋】【元】【宮】＊"}
