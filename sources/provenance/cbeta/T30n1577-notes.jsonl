{"id": null, "n": "0261003", "target": "#nkr_note_mod_0261003", "type": "mod", "text": "捨【大】，施【宋】【元】【明】【宮】"}
{"id": null, "n": "0261004", "target": "#nkr_note_mod_0261004", "type": "mod", "text": "悲【大】，非【宋】【元】【明】【宮】"}
{"id": null, "n": "0261005", "target": "#nkr_note_mod_0261005", "type": "mod", "text": "相【大】，想【宋】【元】【明】【宮】"}
{"id": null, "n": "0261006", "target": "#nkr_note_mod_0261006", "type": "mod", "text": "於【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0261007", "target": "#nkr_note_mod_0261007", "type": "mod", "text": "返【大】，反【宋】【元】【明】【宮】"}
{"id": null, "n": "0261008", "target": "#nkr_note_mod_0261008", "type": "mod", "text": "以【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0261009", "target": "#nkr_note_mod_0261009", "type": "mod", "text": "大【大】，太【明】"}
{"id": null, "n": "0261010", "target": "#nkr_note_mod_0261010", "type": "mod", "text": "人【大】，夫【宋】【元】【明】【宮】"}
