{"id": null, "n": "0926003", "target": null, "type": "orig", "text": "〔譯經〕－【明】"}
{"id": null, "n": "0926003", "target": null, "type": "mod", "text": "譯經【大】，〔－〕【明】"}
{"id": null, "n": "0926004", "target": null, "type": "orig", "text": "〔臣〕－【明】"}
{"id": null, "n": "0926004", "target": null, "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0926002", "target": "#nkr_note_mod_0926002", "type": "mod", "text": "西天譯經三藏朝散大夫試鴻臚少卿傳法大師臣【大】，三藏法師【宋】【元】，宋西天譯經三藏朝散大夫試鴻臚少卿傳法大師臣【明】"}
{"id": null, "n": "0926003", "target": "#nkr_note_mod_0926003", "type": "mod", "text": "譯經【大】，〔－〕【明】"}
{"id": null, "n": "0926004", "target": "#nkr_note_mod_0926004", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0926005", "target": "#nkr_note_mod_0926005", "type": "mod", "text": "哆【大】，多【宋】【元】【明】"}
{"id": null, "n": "0926006", "target": "#nkr_note_mod_0926006", "type": "mod", "text": "三【大】，三十【宋】【元】【明】"}
{"id": null, "n": "0926007", "target": "#nkr_note_mod_0926007", "type": "mod", "text": "志【大】，至【元】【明】"}
{"id": null, "n": "0926008", "target": "#nkr_note_mod_0926008", "type": "mod", "text": "鼻【大】，病【明】"}
{"id": null, "n": "0926001", "target": "#nkr_note_orig_0926001", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0926002", "target": "#nkr_note_orig_0926002", "type": "orig", "text": "（（西天…臣））二十字＝（（三藏法師））四字【宋】【元】，（宋）＋西【明】"}
{"id": null, "n": "0926003", "target": "#nkr_note_orig_0926003", "type": "orig", "text": "〔譯經〕－【明】"}
