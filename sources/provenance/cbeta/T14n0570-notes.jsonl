{"id": null, "n": "0943007", "target": "#nkr_note_mod_0943007", "type": "mod", "text": "計【大】，討【元】【明】"}
{"id": null, "n": "0943008", "target": "#nkr_note_mod_0943008", "type": "mod", "text": "有【大】＊，方有【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0943009", "target": "#nkr_note_mod_0943009", "type": "mod", "text": "跋【大】＊，󰉈【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0943010", "target": "#nkr_note_mod_0943010", "type": "mod", "text": "忘【大】，望【宋】【元】【明】【宮】"}
{"id": null, "n": "0943011", "target": "#nkr_note_mod_0943011", "type": "mod", "text": "是【大】，者【宮】"}
{"id": null, "n": "0943012", "target": "#nkr_note_mod_0943012", "type": "mod", "text": "事【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0943013", "target": "#nkr_note_mod_0943013", "type": "mod", "text": "忘【大】，妄【宋】【元】【明】【宮】"}
