{"id": null, "n": "0169005", "target": "#nkr_note_mod_0169005", "type": "mod", "text": "（西天…譯）二十五字【大】，三藏傳教大師法天奉詔譯【宋】【元】【宮】，宋三藏傳教大師法天奉詔譯【明】"}
{"id": null, "n": "0169007", "target": "#nkr_note_mod_0169007", "type": "mod", "text": "無【大】，能【宋】【元】【明】【宮】"}
{"id": null, "n": "0169008", "target": "#nkr_note_mod_0169008", "type": "mod", "text": "娑【大】，婆【宋】【元】【明】【宮】，Daśārṇa."}
{"id": null, "n": "0169009", "target": "#nkr_note_mod_0169009", "type": "mod", "text": "鹿【大】，塵【宋】【元】【明】【宮】"}
{"id": null, "n": "0169012", "target": "#nkr_note_mod_0169012", "type": "mod", "text": "洛【大】，浴【宋】【元】【明】【宮】"}
{"id": null, "n": "0169013", "target": "#nkr_note_mod_0169013", "type": "mod", "text": "Agasti,Agastya."}
{"id": null, "n": "0169015", "target": "#nkr_note_mod_0169015", "type": "mod", "text": "舍【大】，含【明】"}
{"id": null, "n": "0169026", "target": "#nkr_note_mod_0169026", "type": "mod", "text": "所【大】，所說【宋】【元】【明】【宮】"}
{"id": null, "n": "0169029", "target": "#nkr_note_mod_0169029", "type": "mod", "text": "邪【大】下同，耶【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0170001", "target": "#nkr_note_mod_0170001", "type": "mod", "text": "彌𤚥婆【大】，彌𤚥娑【宋】【元】【明】【宮】，Mīmānsā（聲論）"}
{"id": null, "n": "0170002", "target": "#nkr_note_mod_0170002", "type": "mod", "text": "Sāmkhya（數論）"}
{"id": null, "n": "0170003", "target": "#nkr_note_mod_0170003", "type": "mod", "text": "Vaiśesika（勝論）"}
{"id": null, "n": "0170005", "target": "#nkr_note_mod_0170005", "type": "mod", "text": "晚【大】，婆【宋】【元】【明】"}
{"id": null, "n": "0170006", "target": "#nkr_note_mod_0170006", "type": "mod", "text": "Kaṭha, Kaṭhina."}
{"id": null, "n": "0171002", "target": "#nkr_note_mod_0171002", "type": "mod", "text": "仙【大】，〔－〕【宮】"}
{"id": null, "n": "0171003", "target": "#nkr_note_mod_0171003", "type": "mod", "text": "人【大】，入【宋】"}
{"id": null, "n": "0171005", "target": "#nkr_note_mod_0171005", "type": "mod", "text": "又【大】，及【明】"}
{"id": null, "n": "0171007", "target": "#nkr_note_mod_0171007", "type": "mod", "text": "生【大】，先【元】【明】"}
{"id": null, "n": "0171008", "target": "#nkr_note_mod_0171008", "type": "mod", "text": "囉【大】＊，羅【麗-CB】【宋】【元】＊"}
