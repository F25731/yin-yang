{"id": null, "n": null, "target": null, "type": null, "text": "一名金剛清淨經"}
{"id": null, "n": "0697004", "target": "#nkr_note_mod_0697004", "type": "mod", "text": "佛說【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0697005", "target": "#nkr_note_mod_0697005", "type": "mod", "text": "經【大】，經一名金剛清淨經【宋】【元】【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "一名金剛清淨經"}
{"id": null, "n": "0697006", "target": "#nkr_note_mod_0697006", "type": "mod", "text": "失譯經人名今附三秦錄【大】，失譯【宋】【宮】，新附三秦錄失譯師名【元】【明】"}
{"id": null, "n": "0697007", "target": "#nkr_note_mod_0697007", "type": "mod", "text": "其名曰【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0697008", "target": "#nkr_note_mod_0697008", "type": "mod", "text": "也【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0697009", "target": "#nkr_note_mod_0697009", "type": "mod", "text": "復有【大】，〔－〕【宮】"}
{"id": null, "n": "0697010", "target": "#nkr_note_mod_0697010", "type": "mod", "text": "加【大】，跏【宋】【明】【宮】"}
{"id": null, "n": "0697011", "target": "#nkr_note_mod_0697011", "type": "mod", "text": "白【大】，百【宋】【元】【明】"}
{"id": null, "n": "0697012", "target": "#nkr_note_mod_0697012", "type": "mod", "text": "圓滿【大】，團圓【宮】"}
{"id": null, "n": "0697013", "target": "#nkr_note_mod_0697013", "type": "mod", "text": "其心【大】，具心【元】"}
{"id": null, "n": "0698001", "target": "#nkr_note_mod_0698001", "type": "mod", "text": "踴【大】，勇【宋】【宮】，湧【元】【明】"}
{"id": null, "n": "0698002", "target": "#nkr_note_mod_0698002", "type": "mod", "text": "黠【大】，然【宋】【宮】"}
{"id": null, "n": "0698003", "target": "#nkr_note_mod_0698003", "type": "mod", "text": "踊【大】，涌【明】"}
{"id": null, "n": "0698004", "target": "#nkr_note_mod_0698004", "type": "mod", "text": "焰【大】，艷【宋】【元】【明】【宮】"}
{"id": null, "n": "0698005", "target": "#nkr_note_mod_0698005", "type": "mod", "text": "一【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0698006", "target": "#nkr_note_mod_0698006", "type": "mod", "text": "沃【大】，沷【宮】"}
{"id": null, "n": "0698007", "target": "#nkr_note_mod_0698007", "type": "mod", "text": "適【大】，遍【宋】【元】【明】【宮】"}
{"id": null, "n": "0698008", "target": "#nkr_note_mod_0698008", "type": "mod", "text": "滅【大】，除【宋】【元】【明】【宮】"}
{"id": null, "n": "0698009", "target": "#nkr_note_mod_0698009", "type": "mod", "text": "至【大】，王【宋】【元】【明】【宮】"}
{"id": null, "n": "0699001", "target": "#nkr_note_mod_0699001", "type": "mod", "text": "唯【大】，惟【元】【明】"}
{"id": null, "n": "0699002", "target": "#nkr_note_mod_0699002", "type": "mod", "text": "佛勝【大】，勝佛【宋】【元】【明】【宮】"}
{"id": null, "n": "0699003", "target": "#nkr_note_mod_0699003", "type": "mod", "text": "退【大】，去【宋】【元】【明】【宮】"}
{"id": null, "n": "0699004", "target": "#nkr_note_mod_0699004", "type": "mod", "text": "不壞不滅【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0697004", "target": "#nkr_note_orig_0697004", "type": "orig", "text": "〔佛說〕－【三】【宮】＊"}
{"id": null, "n": "0697005", "target": "#nkr_note_orig_0697005", "type": "orig", "text": "經＋（一名金剛清淨經）夾註【三】"}
{"id": null, "n": "0697006", "target": "#nkr_note_orig_0697006", "type": "orig", "text": "失譯…錄（十字）＝失譯【宋】【宮】，新附三秦錄失譯師名【元】【明】"}
{"id": null, "n": "0697007", "target": "#nkr_note_orig_0697007", "type": "orig", "text": "〔其名曰〕－【三】【宮】"}
{"id": null, "n": "0697008", "target": "#nkr_note_orig_0697008", "type": "orig", "text": "〔也〕－【三】"}
{"id": null, "n": "0697009", "target": "#nkr_note_orig_0697009", "type": "orig", "text": "〔復有〕－【宮】"}
{"id": null, "n": "0697010", "target": "#nkr_note_orig_0697010", "type": "orig", "text": "加＝跏【宋】【明】【宮】"}
{"id": null, "n": "0697011", "target": "#nkr_note_orig_0697011", "type": "orig", "text": "白＝百【三】"}
{"id": null, "n": "0697012", "target": "#nkr_note_orig_0697012", "type": "orig", "text": "圓滿＝團圓【宮】"}
{"id": null, "n": "0697013", "target": "#nkr_note_orig_0697013", "type": "orig", "text": "其心＝具心【元】"}
{"id": null, "n": "0698001", "target": "#nkr_note_orig_0698001", "type": "orig", "text": "踴＝勇【宋】【宮】，湧【元】【明】"}
{"id": null, "n": "0698002", "target": "#nkr_note_orig_0698002", "type": "orig", "text": "黠＝然【宋】【宮】"}
{"id": null, "n": "0698003", "target": "#nkr_note_orig_0698003", "type": "orig", "text": "踊＝涌【明】"}
{"id": null, "n": "0698004", "target": "#nkr_note_orig_0698004", "type": "orig", "text": "焰＝艷【三】【宮】"}
{"id": null, "n": "0698005", "target": "#nkr_note_orig_0698005", "type": "orig", "text": "〔一〕－【三】"}
{"id": null, "n": "0698006", "target": "#nkr_note_orig_0698006", "type": "orig", "text": "沃＝沷【宮】"}
{"id": null, "n": "0698007", "target": "#nkr_note_orig_0698007", "type": "orig", "text": "適＝遍【三】【宮】"}
{"id": null, "n": "0698008", "target": "#nkr_note_orig_0698008", "type": "orig", "text": "滅＝除【三】【宮】"}
{"id": null, "n": "0698009", "target": "#nkr_note_orig_0698009", "type": "orig", "text": "至＝王【三】【宮】"}
{"id": null, "n": "0699001", "target": "#nkr_note_orig_0699001", "type": "orig", "text": "唯＝惟【元】【明】"}
{"id": null, "n": "0699002", "target": "#nkr_note_orig_0699002", "type": "orig", "text": "佛勝＝勝佛【三】【宮】"}
{"id": null, "n": "0699003", "target": "#nkr_note_orig_0699003", "type": "orig", "text": "退＝去【三】【宮】"}
{"id": null, "n": "0699004", "target": "#nkr_note_orig_0699004", "type": "orig", "text": "〔不壞不滅〕－【宋】【元】【宮】"}
