{"id": null, "n": "0421007", "target": "#nkr_note_mod_0421007", "type": "mod", "text": "引【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0422001", "target": "#nkr_note_mod_0422001", "type": "mod", "text": "賀【大】，仡囉二合賀【宋】【元】【明】"}
