{"id": null, "n": "0421001", "target": "#nkr_note_orig_0421001", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0421002", "target": "#nkr_note_orig_0421002", "type": "orig", "text": "（（西天…臣））十九字＝（（西天三藏大師））六字【宋】【元】，（（宋西天三藏法師））七字【明】"}
{"id": null, "n": "0421003", "target": "#nkr_note_orig_0421003", "type": "orig", "text": "陰＋（星）【三】"}
{"id": null, "n": "0421004", "target": "#nkr_note_orig_0421004", "type": "orig", "text": "縛＝嚩【宋】【元】"}
{"id": null, "n": "0421005", "target": "#nkr_note_orig_0421005", "type": "orig", "text": "〔引〕－【元】【明】"}
{"id": null, "n": "0421006", "target": "#nkr_note_orig_0421006", "type": "orig", "text": "第＝弟【宋】【元】"}
{"id": null, "n": "0421007", "target": "#nkr_note_orig_0421007", "type": "orig", "text": "〔引〕－【三】＊"}
{"id": null, "n": "0422001", "target": "#nkr_note_orig_0422001", "type": "orig", "text": "（仡囉二合）＋賀【三】"}
