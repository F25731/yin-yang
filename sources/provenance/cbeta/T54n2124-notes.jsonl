{"id": null, "n": null, "target": null, "type": null, "text": "生死因"}
{"id": null, "n": null, "target": null, "type": null, "text": "此二是生死果"}
{"id": null, "n": null, "target": null, "type": null, "text": "生死緣"}
{"id": null, "n": null, "target": null, "type": null, "text": "於有漏見而生取著"}
{"id": null, "n": null, "target": null, "type": null, "text": "執有漏戒以求淨果"}
{"id": null, "n": null, "target": null, "type": null, "text": "遍通三界煩惱"}
{"id": null, "n": null, "target": null, "type": null, "text": "欲界煩惱"}
{"id": null, "n": null, "target": null, "type": null, "text": "無色界煩惱"}
{"id": null, "n": null, "target": null, "type": null, "text": "迴善施物為他求果。名為方便勝智"}
{"id": null, "n": null, "target": null, "type": null, "text": "要期起行名之為願"}
{"id": null, "n": null, "target": null, "type": null, "text": "伏戒斷障名之為力"}
{"id": null, "n": null, "target": null, "type": null, "text": "能知六度法門。名之為智"}
{"id": null, "n": null, "target": null, "type": null, "text": "悉皆妙好。是名咽下六種十好"}
{"id": null, "n": null, "target": null, "type": null, "text": "人無我法無我"}
{"id": null, "n": null, "target": null, "type": null, "text": "五根六塵為分別性"}
{"id": null, "n": null, "target": null, "type": null, "text": "識體為依他性"}
{"id": null, "n": null, "target": null, "type": null, "text": "真如\n為真實性"}
{"id": null, "n": null, "target": null, "type": null, "text": "本音三昧漢言調直"}
{"id": null, "n": null, "target": null, "type": null, "text": "斷闡提不信習\n氣障方便生死果報云得大淨果也"}
{"id": null, "n": null, "target": null, "type": null, "text": "斷外道著我集氣障因緣生死果報。云得大樂果"}
{"id": null, "n": null, "target": null, "type": null, "text": "斷聲聞自利習氣障有生死果報。云得大我果"}
{"id": null, "n": null, "target": null, "type": null, "text": "斷獨覺自愛習\n氣障無有生死報。云得大常果"}
{"id": null, "n": null, "target": null, "type": null, "text": "十解十行是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "十𢌞向是"}
{"id": null, "n": null, "target": null, "type": null, "text": "初地是"}
{"id": null, "n": null, "target": null, "type": null, "text": "二地是"}
{"id": null, "n": null, "target": null, "type": null, "text": "三地是"}
{"id": null, "n": null, "target": null, "type": null, "text": "四地是"}
{"id": null, "n": null, "target": null, "type": null, "text": "五地是"}
{"id": null, "n": null, "target": null, "type": null, "text": "六地是"}
{"id": null, "n": null, "target": null, "type": null, "text": "七地是"}
{"id": null, "n": null, "target": null, "type": null, "text": "八地是"}
{"id": null, "n": null, "target": null, "type": null, "text": "九地是"}
{"id": null, "n": null, "target": null, "type": null, "text": "十地是"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名共相"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名不共相"}
{"id": null, "n": null, "target": null, "type": null, "text": "諸法名想言說。是名隨說因"}
{"id": null, "n": null, "target": null, "type": null, "text": "以有事故有所作。是名\n以有因。以有手故有所作。以有足故有遊行。以有飢渴故求飲食。如此之類名因"}
{"id": null, "n": null, "target": null, "type": null, "text": "種諸\n種子。名種殖因"}
{"id": null, "n": null, "target": null, "type": null, "text": "水土潤澤。是名攝因"}
{"id": null, "n": null, "target": null, "type": null, "text": "種子於芽。是名生因"}
{"id": null, "n": null, "target": null, "type": null, "text": "芽莖\n相續乃至成熟。名長因也"}
{"id": null, "n": null, "target": null, "type": null, "text": "種種種子各各生子。是自種因"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼以\n有因種殖因攝因生因長因自種因。總此因名共事因"}
{"id": null, "n": null, "target": null, "type": null, "text": "障礙於生。名相違因"}
{"id": null, "n": null, "target": null, "type": null, "text": "不障礙者。名不相違因"}
{"id": null, "n": null, "target": null, "type": null, "text": "諸經說十二因緣。其言如此"}
{"id": null, "n": null, "target": null, "type": null, "text": "修中之下品十\n善則生其中"}
{"id": null, "n": null, "target": null, "type": null, "text": "修中之中品善則生其中"}
{"id": null, "n": null, "target": null, "type": null, "text": "修中之上\n品十善則生品十其中"}
{"id": null, "n": null, "target": null, "type": null, "text": "修上之下品十善發願行慈則生其中"}
{"id": null, "n": null, "target": null, "type": null, "text": "修上之中品十善則生其中"}
{"id": null, "n": null, "target": null, "type": null, "text": "威力自在與佛等故\n稱為魔王修上上品十善則生其中"}
{"id": null, "n": null, "target": null, "type": null, "text": "梵天梵眾天大\n梵天"}
{"id": null, "n": null, "target": null, "type": null, "text": "少光天。無量光天。光音天"}
{"id": null, "n": null, "target": null, "type": null, "text": "少淨天。無量淨天。遍淨天"}
{"id": null, "n": null, "target": null, "type": null, "text": "福生天。福受天。廣果天。無極天。此四天是凡夫。無煩惱天。無熱天。善見天。善現天。色究竟天。\n從無煩惱天以後五天是阿那含人。依第四禪修五品動禪生五天中。名五淨居天"}
{"id": null, "n": null, "target": null, "type": null, "text": "凡夫爾時謂心都盡。名為涅槃。聖者以理集之。怛無󱍮想。由有細想具足四心。是以更施後句情理合\n說故。曰非想非非想天。壽命八萬大劫。此三界中最上。名曰有頂。亦名第一有也"}
{"id": null, "n": null, "target": null, "type": null, "text": "為四"}
{"id": null, "n": null, "target": null, "type": null, "text": "并前為八"}
{"id": null, "n": null, "target": null, "type": null, "text": "并前為十四"}
{"id": null, "n": null, "target": null, "type": null, "text": "并前為十五"}
{"id": null, "n": null, "target": null, "type": null, "text": "并前十六"}
{"id": null, "n": null, "target": null, "type": null, "text": "并前十七"}
{"id": null, "n": null, "target": null, "type": null, "text": "并前合二十一"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T12n0374_p0452a11"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T12n0375_p0694a12"}
{"id": null, "n": null, "target": null, "type": "cf3", "text": "X42n0733_p0052c08"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T12n0374_p0452a11"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T12n0375_p0694a13"}
{"id": null, "n": null, "target": null, "type": "cf3", "text": "X42n0733_p0052c09"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T33n1715_p0578c09"}
{"id": null, "n": "0195003", "target": "#nkr_note_mod_0195003", "type": "mod", "text": "常【大】，斷【考偽-大】"}
{"id": null, "n": "0196001", "target": "#nkr_note_mod_0196001", "type": "mod", "text": "為【大】，為九惱【考偽-大】"}
{"id": null, "n": "0196002", "target": "#nkr_note_mod_0196002", "type": "mod", "text": "能【大】，能障【考偽-大】"}
{"id": null, "n": "0196004", "target": "#nkr_note_mod_0196004", "type": "mod", "text": "二【大】，一【考偽-大】"}
{"id": null, "n": "0196005", "target": "#nkr_note_mod_0196005", "type": "mod", "text": "無【大】，二【考偽-大】"}
{"id": null, "n": "0196006", "target": "#nkr_note_mod_0196006", "type": "mod", "text": "切【大】，〔－〕【考偽-大】"}
{"id": null, "n": "0196007", "target": "#nkr_note_mod_0196007", "type": "mod", "text": "無【大】，〔－〕【考偽-大】"}
{"id": null, "n": "0196008", "target": "#nkr_note_mod_0196008", "type": "mod", "text": "小【大】，有愛住地無色界煩惱無明住地小【考偽-大】"}
{"id": null, "n": "0196009", "target": "#nkr_note_mod_0196009", "type": "mod", "text": "變【大】，變易生死【考偽-大】"}
{"id": null, "n": "0197001", "target": "#nkr_note_mod_0197001", "type": "mod", "text": "解【大】，無處有處解【考偽-大】"}
{"id": null, "n": "0197002", "target": "#nkr_note_mod_0197002", "type": "mod", "text": "無【大】，〔－〕【考偽-大】"}
{"id": null, "n": "0198001", "target": "#nkr_note_mod_0198001", "type": "mod", "text": "是【大】，〔－〕【考偽-大】"}
{"id": null, "n": "0198002", "target": "#nkr_note_mod_0198002", "type": "mod", "text": "道處【大】，處道【考偽-大】"}
{"id": null, "n": "0198004", "target": "#nkr_note_mod_0198004", "type": "mod", "text": "伽【大】，伽婆【考偽-大】"}
{"id": null, "n": "0199001", "target": "#nkr_note_mod_0199001", "type": "mod", "text": "王【大】，牛王【考偽-大】"}
{"id": null, "n": "0200001", "target": "#nkr_note_mod_0200001", "type": "mod", "text": "器【CB】，𥰔【大】，𥰔字不詳"}
{"id": null, "n": "0201002", "target": "#nkr_note_mod_0201002", "type": "mod", "text": "無【大】，〔－〕【考偽-大】"}
{"id": null, "n": "0195001", "target": "#nkr_note_orig_0195001", "type": "orig", "text": "【原】佛蘭西國民圖書館藏燉煌本"}
{"id": null, "n": "0195002", "target": "#nkr_note_orig_0195002", "type": "orig", "text": "有字之下脫句乎"}
{"id": null, "n": "0195003", "target": "#nkr_note_orig_0195003", "type": "orig", "text": "常＝斷？"}
{"id": null, "n": "0196001", "target": "#nkr_note_orig_0196001", "type": "orig", "text": "為＋（九惱）？"}
{"id": null, "n": "0196002", "target": "#nkr_note_orig_0196002", "type": "orig", "text": "能＋（障）？"}
{"id": null, "n": "0196003", "target": "#nkr_note_orig_0196003", "type": "orig", "text": "校者曰姤字不詳"}
{"id": null, "n": "0196004", "target": "#nkr_note_orig_0196004", "type": "orig", "text": "二＝一？"}
{"id": null, "n": "0196005", "target": "#nkr_note_orig_0196005", "type": "orig", "text": "無＝二？"}
{"id": null, "n": "0196006", "target": "#nkr_note_orig_0196006", "type": "orig", "text": "〔切〕－？"}
{"id": null, "n": "0196007", "target": "#nkr_note_orig_0196007", "type": "orig", "text": "〔無〕－？"}
{"id": null, "n": "0196008", "target": "#nkr_note_orig_0196008", "type": "orig", "text": "（有愛住地無色界煩惱無明住地）＋小？"}
{"id": null, "n": "0196009", "target": "#nkr_note_orig_0196009", "type": "orig", "text": "變＋（易生死）？"}
{"id": null, "n": "0196010", "target": "#nkr_note_orig_0196010", "type": "orig", "text": "校者曰失字之下脫文乎"}
{"id": null, "n": "0197001", "target": "#nkr_note_orig_0197001", "type": "orig", "text": "（無處有處）＋解？"}
{"id": null, "n": "0197002", "target": "#nkr_note_orig_0197002", "type": "orig", "text": "〔無〕－？"}
{"id": null, "n": "0198001", "target": "#nkr_note_orig_0198001", "type": "orig", "text": "〔是〕－？"}
{"id": null, "n": "0198002", "target": "#nkr_note_orig_0198002", "type": "orig", "text": "道處＝處道？"}
{"id": null, "n": "0198003", "target": "#nkr_note_orig_0198003", "type": "orig", "text": "校者曰行字之下脫口業隨智慧行之文乎"}
{"id": null, "n": "0198004", "target": "#nkr_note_orig_0198004", "type": "orig", "text": "伽＋（婆）？"}
{"id": null, "n": "0199001", "target": "#nkr_note_orig_0199001", "type": "orig", "text": "（牛）＋王？"}
{"id": null, "n": "0199002", "target": "#nkr_note_orig_0199002", "type": "orig", "text": "樂字不詳"}
{"id": null, "n": "0199003", "target": "#nkr_note_orig_0199003", "type": "orig", "text": "山字不詳"}
{"id": null, "n": "0200001", "target": "#nkr_note_orig_0200001", "type": "orig", "text": "𥰔字不詳"}
{"id": null, "n": "0200002", "target": "#nkr_note_orig_0200002", "type": "orig", "text": "根字不詳"}
{"id": null, "n": "0200003", "target": "#nkr_note_orig_0200003", "type": "orig", "text": "巧字不詳"}
{"id": null, "n": "0200004", "target": "#nkr_note_orig_0200004", "type": "orig", "text": "義字不詳"}
{"id": null, "n": "0201001", "target": "#nkr_note_orig_0201001", "type": "orig", "text": "校者曰存字之脫句乎"}
{"id": null, "n": "0201002", "target": "#nkr_note_orig_0201002", "type": "orig", "text": "〔無〕－？"}
{"id": null, "n": "0202001", "target": "#nkr_note_orig_0202001", "type": "orig", "text": "是下脫字乎"}
