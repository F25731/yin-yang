{"id": null, "n": "0575026", "target": "#nkr_note_mod_0575026", "type": "mod", "text": "合【大】，合引【宋】【元】【明】【乙】"}
{"id": null, "n": "0575027", "target": "#nkr_note_mod_0575027", "type": "mod", "text": "欲【大】，欲三【宋】【元】【明】【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": "0575028", "target": "#nkr_note_mod_0575028", "type": "mod", "text": "畫【大】，盡【元】"}
{"id": null, "n": "0575029", "target": "#nkr_note_mod_0575029", "type": "mod", "text": "白【大】，自【宋】"}
{"id": null, "n": "0575030", "target": "#nkr_note_mod_0575030", "type": "mod", "text": "緣【大】，安緣【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0575031", "target": "#nkr_note_mod_0575031", "type": "mod", "text": "莖【大】，〔－〕【宋】【元】【明】【乙】"}
{"id": null, "n": "0575032", "target": "#nkr_note_mod_0575032", "type": "mod", "text": "酥【大】＊，蘇【宋】【甲】＊"}
{"id": null, "n": "0575033", "target": "#nkr_note_mod_0575033", "type": "mod", "text": "擲【大】，擲一莖【宋】【元】【明】【乙】"}
{"id": null, "n": "0576001", "target": "#nkr_note_mod_0576001", "type": "mod", "text": "以【大】，已【甲】"}
{"id": null, "n": "0576002", "target": "#nkr_note_mod_0576002", "type": "mod", "text": "法【大】，法三經同卷【宋】，乙本奧書曰貞享元甲子九月二十日校點了淨嚴四十六載，元祿十六年正月二十九日以淨嚴和上之本再校了尊教"}
{"id": null, "n": "0575008", "target": "#nkr_note_orig_0575008", "type": "orig", "text": "【原】麗本，【甲】三十帖策子第十九，【乙】黃檗版淨嚴等校訂加筆本"}
{"id": null, "n": "0575009", "target": "#nkr_note_orig_0575009", "type": "orig", "text": "（開府…寺）三十七字＝（南天竺國）四字【宋】【元】【甲】，（唐南天竺國）五字【明】【乙】"}
