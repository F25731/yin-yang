{"id": null, "n": "0575016", "target": "#nkr_note_mod_0575016", "type": "mod", "text": "摩【大】，魔【宋】【元】"}
{"id": null, "n": "0575017", "target": "#nkr_note_mod_0575017", "type": "mod", "text": "授【大】，受【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0575018", "target": "#nkr_note_mod_0575018", "type": "mod", "text": "唵【大】＊，唵引一【宋】【元】【明】【乙】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "引一"}
{"id": null, "n": "0575019", "target": "#nkr_note_mod_0575019", "type": "mod", "text": "矖【大】，曬【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0575020", "target": "#nkr_note_mod_0575020", "type": "mod", "text": "引【大】，引二【宋】【元】【明】【乙】"}
{"id": null, "n": "0575021", "target": "#nkr_note_mod_0575021", "type": "mod", "text": "於【大】，〔－〕【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0575022", "target": "#nkr_note_mod_0575022", "type": "mod", "text": "心觀【大】，觀心【宋】【元】【明】【乙】"}
{"id": null, "n": "0575023", "target": "#nkr_note_mod_0575023", "type": "mod", "text": "項【大】，頂【宋】【元】【明】【乙】"}
