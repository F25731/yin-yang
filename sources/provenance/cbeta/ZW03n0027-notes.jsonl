{"id": null, "n": "0219001", "target": "#nkr_note_orig_0219001", "type": "orig", "text": "「具」，丙本作「俱」。"}
{"id": null, "n": "0219002", "target": "#nkr_note_orig_0219002", "type": "orig", "text": "「業」，底本無，據甲、乙、丙、丁、庚本補。"}
{"id": null, "n": "0219003", "target": "#nkr_note_orig_0219003", "type": "orig", "text": "「俱」，戊本作「都」。"}
{"id": null, "n": "0219004", "target": "#nkr_note_orig_0219004", "type": "orig", "text": "「曰」，甲、乙本作「曰為」。"}
{"id": null, "n": "0219005", "target": "#nkr_note_orig_0219005", "type": "orig", "text": "「支」，戊本作「入」。"}
{"id": null, "n": "0219006", "target": "#nkr_note_orig_0219006", "type": "orig", "text": "「仁」，乙本無。"}
{"id": null, "n": "0219007", "target": "#nkr_note_orig_0219007", "type": "orig", "text": "「士」，甲本作「大」，乙、庚本作「丈」，戊本作「土」。"}
{"id": null, "n": "0219008", "target": "#nkr_note_orig_0219008", "type": "orig", "text": "「然」，乙本作「能」。"}
{"id": null, "n": "0219009", "target": "#nkr_note_orig_0219009", "type": "orig", "text": "「主」，乙本作「土」。"}
{"id": null, "n": "0219010", "target": "#nkr_note_orig_0219010", "type": "orig", "text": "「遇」，乙本無。"}
{"id": null, "n": "0219011", "target": "#nkr_note_orig_0219011", "type": "orig", "text": "「此」，庚本作「此彼」。"}
{"id": null, "n": "0219012", "target": "#nkr_note_orig_0219012", "type": "orig", "text": "「依」，甲本作「假」。"}
{"id": null, "n": "0220001", "target": "#nkr_note_orig_0220001", "type": "orig", "text": "「曰」，底本無，據甲、乙、丁、戊、庚本補。"}
{"id": null, "n": "0220002", "target": "#nkr_note_orig_0220002", "type": "orig", "text": "「第」，乙、庚本作「弟」。以下凡「第」、「弟」混用處，均改為正字，不一一出注。"}
{"id": null, "n": "0220003", "target": "#nkr_note_orig_0220003", "type": "orig", "text": "「支」，丁本作「之」。"}
{"id": null, "n": "0220004", "target": "#nkr_note_orig_0220004", "type": "orig", "text": "「識」，乙本作「譏」。"}
{"id": null, "n": "0220005", "target": "#nkr_note_orig_0220005", "type": "orig", "text": "「者，是」，乙本無。"}
{"id": null, "n": "0220006", "target": "#nkr_note_orig_0220006", "type": "orig", "text": "「憎」，庚本作「增」。"}
{"id": null, "n": "0220007", "target": "#nkr_note_orig_0220007", "type": "orig", "text": "自「之辭」至「盡攝」三十一字，乙本無。"}
{"id": null, "n": "0220008", "target": "#nkr_note_orig_0220008", "type": "orig", "text": "「說」，乙本作「攝」。"}
{"id": null, "n": "0220009", "target": "#nkr_note_orig_0220009", "type": "orig", "text": "「此」，己本作「作」。"}
{"id": null, "n": "0220010", "target": "#nkr_note_orig_0220010", "type": "orig", "text": "「問曰：此義已知。彼」，乙本無。"}
{"id": null, "n": "0220011", "target": "#nkr_note_orig_0220011", "type": "orig", "text": "「從三生於二」，乙本無。"}
{"id": null, "n": "0220012", "target": "#nkr_note_orig_0220012", "type": "orig", "text": "「煩惱生」，乙本無。"}
{"id": null, "n": "0220013", "target": "#nkr_note_orig_0220013", "type": "orig", "text": "「上」，戊本作「土」。"}
{"id": null, "n": "0220014", "target": "#nkr_note_orig_0220014", "type": "orig", "text": "「輪」，庚本作「輪恆」。"}
{"id": null, "n": "0221001", "target": "#nkr_note_orig_0221001", "type": "orig", "text": "「作」，底本無，據甲、乙、丙、丁、戊、己、庚本補；乙本作「所作」。"}
{"id": null, "n": "0221002", "target": "#nkr_note_orig_0221002", "type": "orig", "text": "「輪」，乙、丁、戊、庚本作「轉」。"}
{"id": null, "n": "0221003", "target": "#nkr_note_orig_0221003", "type": "orig", "text": "「世間」，乙本無。"}
{"id": null, "n": "0221004", "target": "#nkr_note_orig_0221004", "type": "orig", "text": "「流」，戊本作「流轉」。"}
{"id": null, "n": "0221005", "target": "#nkr_note_orig_0221005", "type": "orig", "text": "「有」，乙本作「謂」。"}
{"id": null, "n": "0221006", "target": "#nkr_note_orig_0221006", "type": "orig", "text": "「即不定」，丁本作「不定也」。"}
{"id": null, "n": "0221007", "target": "#nkr_note_orig_0221007", "type": "orig", "text": "「之」，乙本無。"}
{"id": null, "n": "0221008", "target": "#nkr_note_orig_0221008", "type": "orig", "text": "「耶」，乙本作「取」。"}
{"id": null, "n": "0221009", "target": "#nkr_note_orig_0221009", "type": "orig", "text": "「有」，乙本作「為」。"}
{"id": null, "n": "0221010", "target": "#nkr_note_orig_0221010", "type": "orig", "text": "「於」，乙本作「於於」。"}
{"id": null, "n": "0221011", "target": "#nkr_note_orig_0221011", "type": "orig", "text": "「於」，庚本作「於於」。"}
{"id": null, "n": "0221012", "target": "#nkr_note_orig_0221012", "type": "orig", "text": "乙本至此止。"}
{"id": null, "n": "0221013", "target": "#nkr_note_orig_0221013", "type": "orig", "text": "「從」，底本作「從無」，據甲、丁、戊、己、庚本刪。"}
{"id": null, "n": "0221014", "target": "#nkr_note_orig_0221014", "type": "orig", "text": "「我」，丁、戊本作「我之」。"}
{"id": null, "n": "0222001", "target": "#nkr_note_orig_0222001", "type": "orig", "text": "「及」，庚本無。"}
{"id": null, "n": "0222002", "target": "#nkr_note_orig_0222002", "type": "orig", "text": "「此」，丁、己、庚本無。"}
{"id": null, "n": "0222003", "target": "#nkr_note_orig_0222003", "type": "orig", "text": "「至」，戊本作「生」。"}
{"id": null, "n": "0222004", "target": "#nkr_note_orig_0222004", "type": "orig", "text": "「亦」，戊本作「亦得」。"}
{"id": null, "n": "0222005", "target": "#nkr_note_orig_0222005", "type": "orig", "text": "「過」，丙、丁、戊本作「果」。"}
{"id": null, "n": "0222006", "target": "#nkr_note_orig_0222006", "type": "orig", "text": "「世」，庚本無。"}
{"id": null, "n": "0222007", "target": "#nkr_note_orig_0222007", "type": "orig", "text": "「過」，丁、戊本作「果」。"}
{"id": null, "n": "0222008", "target": "#nkr_note_orig_0222008", "type": "orig", "text": "「設」，戊本作「設如是」。"}
{"id": null, "n": "0222009", "target": "#nkr_note_orig_0222009", "type": "orig", "text": "「像」，甲本無。"}
{"id": null, "n": "0222010", "target": "#nkr_note_orig_0222010", "type": "orig", "text": "「響」，諸本均作「向」，據文意改。"}
{"id": null, "n": "0222011", "target": "#nkr_note_orig_0222011", "type": "orig", "text": "「想」，底、丙、戊本作「相」，據甲、丁、庚改。"}
{"id": null, "n": "0222012", "target": "#nkr_note_orig_0222012", "type": "orig", "text": "「蘊也」，底、甲、丙、戊、己本無，據丁、庚本補。"}
{"id": null, "n": "0222013", "target": "#nkr_note_orig_0222013", "type": "orig", "text": "「移至」，甲本作「至於」。"}
{"id": null, "n": "0222014", "target": "#nkr_note_orig_0222014", "type": "orig", "text": "「轉」，庚本作「輪」。"}
{"id": null, "n": "0222015", "target": "#nkr_note_orig_0222015", "type": "orig", "text": "「後」，甲本無。"}
{"id": null, "n": "0223001", "target": "#nkr_note_orig_0223001", "type": "orig", "text": "「愚」，己本作「遇」。"}
{"id": null, "n": "0223002", "target": "#nkr_note_orig_0223002", "type": "orig", "text": "「愚」，己本作「遇」。"}
{"id": null, "n": "0223003", "target": "#nkr_note_orig_0223003", "type": "orig", "text": "「後」，丁本無。"}
{"id": null, "n": "0223004", "target": "#nkr_note_orig_0223004", "type": "orig", "text": "「後」，丁本無。"}
{"id": null, "n": "0223005", "target": "#nkr_note_orig_0223005", "type": "orig", "text": "「即」，丁本作「則」。"}
{"id": null, "n": "0223006", "target": "#nkr_note_orig_0223006", "type": "orig", "text": "「是」，底、戊、己、本作「是故」，據甲、丙、丁、庚本刪。"}
{"id": null, "n": "0223007", "target": "#nkr_note_orig_0223007", "type": "orig", "text": "「者」，庚本作「等」。"}
{"id": null, "n": "0223008", "target": "#nkr_note_orig_0223008", "type": "orig", "text": "「遣」，庚本作「遺」。"}
