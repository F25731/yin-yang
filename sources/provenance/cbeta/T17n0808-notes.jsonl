{"id": null, "n": null, "target": null, "type": "cf1", "text": "K11n0229_p0445a09"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "Q11_p0125c13"}
{"id": null, "n": "0754001", "target": "#nkr_note_mod_0754001", "type": "mod", "text": "氏【大】，支【宋】【元】【明】【宮】"}
{"id": null, "n": "0754002", "target": "#nkr_note_mod_0754002", "type": "mod", "text": "譯【大】，初譯【元】【明】"}
{"id": null, "n": "0754003", "target": "#nkr_note_mod_0754003", "type": "mod", "text": "洹【大】，桓【宋】【元】【明】【聖】"}
{"id": null, "n": "0754004", "target": "#nkr_note_mod_0754004", "type": "mod", "text": "遇風患【大】，患風【宮】"}
{"id": null, "n": "0754005", "target": "#nkr_note_mod_0754005", "type": "mod", "text": "便【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0754006", "target": "#nkr_note_mod_0754006", "type": "mod", "text": "至【大】，到【宋】【元】【明】【宮】"}
{"id": null, "n": "0754007", "target": "#nkr_note_mod_0754007", "type": "mod", "text": "言【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0754008", "target": "#nkr_note_mod_0754008", "type": "mod", "text": "故遣我【大】，使我來【宋】【元】【明】，故使我來【宮】"}
{"id": null, "n": "0754009", "target": "#nkr_note_mod_0754009", "type": "mod", "text": "群【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0754010", "target": "#nkr_note_mod_0754010", "type": "mod", "text": "有一牸牛性常【大】，牛當【宮】，牸牛性常【宋】【元】【明】"}
{"id": null, "n": "0754011", "target": "#nkr_note_mod_0754011", "type": "mod", "text": "乳【大】＊，乳婆羅門言諾即前以右手捫摸牛乳【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0754012", "target": "#nkr_note_mod_0754012", "type": "mod", "text": "湩【大】，𡦢【宋】【元】【明】【宮】"}
{"id": null, "n": "0754013", "target": "#nkr_note_mod_0754013", "type": "mod", "text": "當【大】，常【宋】【元】【明】【宮】"}
{"id": null, "n": "0754014", "target": "#nkr_note_mod_0754014", "type": "mod", "text": "者【大】，者是【宋】【元】【明】【宮】"}
{"id": null, "n": "0754015", "target": "#nkr_note_mod_0754015", "type": "mod", "text": "當【大】，作畜【宋】【元】【明】【宮】"}
{"id": null, "n": "0754016", "target": "#nkr_note_mod_0754016", "type": "mod", "text": "食【大】，食乳【宋】【元】【明】【宮】"}
{"id": null, "n": "0754017", "target": "#nkr_note_mod_0754017", "type": "mod", "text": "大【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0754018", "target": "#nkr_note_mod_0754018", "type": "mod", "text": "母子【大】，子母【宋】【元】【明】【宮】"}
{"id": null, "n": "0754019", "target": "#nkr_note_mod_0754019", "type": "mod", "text": "世【大】，世之【宋】【元】【明】【宮】"}
{"id": null, "n": "0754020", "target": "#nkr_note_mod_0754020", "type": "mod", "text": "名【大】，〔－〕【宋】【元】，明註曰南藏無名字"}
{"id": null, "n": "0754021", "target": "#nkr_note_mod_0754021", "type": "mod", "text": "便【大】，使【宮】"}
{"id": null, "n": "0754022", "target": "#nkr_note_mod_0754022", "type": "mod", "text": "有【大】，〔－〕【宮】"}
{"id": null, "n": "0754023", "target": "#nkr_note_mod_0754023", "type": "mod", "text": "慈【大】，我慈【宋】【元】【明】"}
{"id": null, "n": "0754024", "target": "#nkr_note_mod_0754024", "type": "mod", "text": "世【大】，身【宋】【元】【明】【宮】"}
{"id": null, "n": "0754025", "target": "#nkr_note_mod_0754025", "type": "mod", "text": "沙門【大】，作沙門【宋】【元】【明】【宮】"}
{"id": null, "n": "0754026", "target": "#nkr_note_mod_0754026", "type": "mod", "text": "善心【大】，心善【宋】【元】【明】【宮】"}
{"id": null, "n": "0754027", "target": "#nkr_note_mod_0754027", "type": "mod", "text": "後【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0754028", "target": "#nkr_note_mod_0754028", "type": "mod", "text": "信【大】，事【宋】【元】【明】【宮】"}
{"id": null, "n": "0754001", "target": "#nkr_note_orig_0754001", "type": "orig", "text": "氏＝支【三】【宮】"}
{"id": null, "n": "0754002", "target": "#nkr_note_orig_0754002", "type": "orig", "text": "（初）＋譯【元】【明】"}
{"id": null, "n": "0754003", "target": "#nkr_note_orig_0754003", "type": "orig", "text": "洹＝桓【三】【聖】"}
{"id": null, "n": "0754004", "target": "#nkr_note_orig_0754004", "type": "orig", "text": "遇風患＝患風【宮】"}
{"id": null, "n": "0754005", "target": "#nkr_note_orig_0754005", "type": "orig", "text": "〔便〕－【三】【宮】"}
{"id": null, "n": "0754006", "target": "#nkr_note_orig_0754006", "type": "orig", "text": "至＝到【三】【宮】"}
{"id": null, "n": "0754007", "target": "#nkr_note_orig_0754007", "type": "orig", "text": "〔言〕－【三】【宮】"}
{"id": null, "n": "0754008", "target": "#nkr_note_orig_0754008", "type": "orig", "text": "故遣我＝使我來【三】，故使我來【宮】"}
{"id": null, "n": "0754009", "target": "#nkr_note_orig_0754009", "type": "orig", "text": "〔群〕－【三】【宮】"}
{"id": null, "n": "0754010", "target": "#nkr_note_orig_0754010", "type": "orig", "text": "〔有一〕－【三】，有一牸牛性常＝牛當【宮】"}
{"id": null, "n": "0754011", "target": "#nkr_note_orig_0754011", "type": "orig", "text": "乳＋（婆羅門言諾即前以右手捫摸牛乳）【三】【宮】＊"}
{"id": null, "n": "0754012", "target": "#nkr_note_orig_0754012", "type": "orig", "text": "湩＝𡦢【三】【宮】"}
{"id": null, "n": "0754013", "target": "#nkr_note_orig_0754013", "type": "orig", "text": "當＝常【三】【宮】"}
{"id": null, "n": "0754014", "target": "#nkr_note_orig_0754014", "type": "orig", "text": "者＋（是）【三】【宮】"}
{"id": null, "n": "0754015", "target": "#nkr_note_orig_0754015", "type": "orig", "text": "當＝作畜【三】【宮】"}
{"id": null, "n": "0754016", "target": "#nkr_note_orig_0754016", "type": "orig", "text": "食＋（乳）【三】【宮】"}
{"id": null, "n": "0754017", "target": "#nkr_note_orig_0754017", "type": "orig", "text": "〔大〕－【三】【宮】"}
{"id": null, "n": "0754018", "target": "#nkr_note_orig_0754018", "type": "orig", "text": "母子＝子母【三】【宮】"}
{"id": null, "n": "0754019", "target": "#nkr_note_orig_0754019", "type": "orig", "text": "世＋（之）【三】【宮】"}
{"id": null, "n": "0754020", "target": "#nkr_note_orig_0754020", "type": "orig", "text": "〔名〕－【宋】【元】，明註曰南藏無名字"}
{"id": null, "n": "0754021", "target": "#nkr_note_orig_0754021", "type": "orig", "text": "便＝使【宮】"}
{"id": null, "n": "0754022", "target": "#nkr_note_orig_0754022", "type": "orig", "text": "〔有〕－【宮】"}
{"id": null, "n": "0754023", "target": "#nkr_note_orig_0754023", "type": "orig", "text": "（我）＋慈【三】"}
{"id": null, "n": "0754024", "target": "#nkr_note_orig_0754024", "type": "orig", "text": "世＝身【三】【宮】"}
{"id": null, "n": "0754025", "target": "#nkr_note_orig_0754025", "type": "orig", "text": "（作）＋沙門【三】【宮】"}
{"id": null, "n": "0754026", "target": "#nkr_note_orig_0754026", "type": "orig", "text": "善心＝心善【三】【宮】"}
{"id": null, "n": "0754027", "target": "#nkr_note_orig_0754027", "type": "orig", "text": "〔後〕－【三】【宮】"}
{"id": null, "n": "0754028", "target": "#nkr_note_orig_0754028", "type": "orig", "text": "信＝事【三】【宮】"}
{"id": null, "n": "0754a1101", "target": "#nkr_note_add_0754a1101", "type": "add", "text": "小【CB】【麗-CB】【磧-CB】，少【大】"}
