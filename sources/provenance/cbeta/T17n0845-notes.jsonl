{"id": null, "n": "0932002", "target": null, "type": "orig", "text": "〔臣〕－【明】"}
{"id": null, "n": "0932002", "target": null, "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0932001", "target": "#nkr_note_mod_0932001", "type": "mod", "text": "西天譯經三藏朝散大夫試光祿卿明教大師臣【大】，三藏法師【宋】【元】【宮】，宋西天譯經三藏朝散大夫試光祿卿明教大師臣【明】"}
{"id": null, "n": "0932002", "target": "#nkr_note_mod_0932002", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0932003", "target": "#nkr_note_mod_0932003", "type": "mod", "text": "志【大】＊，至【元】【明】＊"}
{"id": null, "n": "0933001", "target": "#nkr_note_mod_0933001", "type": "mod", "text": "此【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0933002", "target": "#nkr_note_mod_0933002", "type": "mod", "text": "閻【大】，閣【宋】"}
{"id": null, "n": "0932001", "target": "#nkr_note_orig_0932001", "type": "orig", "text": "（（西天…臣））十九字＝（（三藏法師））四字【宋】【元】【宮】，（宋）＋西天【明】"}
{"id": null, "n": "0932002", "target": "#nkr_note_orig_0932002", "type": "orig", "text": "〔臣〕－【明】"}
{"id": null, "n": "0932003", "target": "#nkr_note_orig_0932003", "type": "orig", "text": "志＝至【元】【明】＊"}
{"id": null, "n": "0933001", "target": "#nkr_note_orig_0933001", "type": "orig", "text": "〔此〕－【三】"}
{"id": null, "n": "0933002", "target": "#nkr_note_orig_0933002", "type": "orig", "text": "閻＝閣【宋】"}
