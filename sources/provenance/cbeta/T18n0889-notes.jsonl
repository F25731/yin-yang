{"id": null, "n": "0541008", "target": "#nkr_note_mod_0541008", "type": "mod", "text": "西【大】＊，宋西【明】＊"}
{"id": null, "n": "0541009", "target": "#nkr_note_mod_0541009", "type": "mod", "text": "譯經【大】＊，〔－〕【明】＊"}
{"id": null, "n": "0541010", "target": "#nkr_note_mod_0541010", "type": "mod", "text": "臣【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0542001", "target": "#nkr_note_mod_0542001", "type": "mod", "text": "（言我今…出生）三百十三字【大】∞（儀有…辛辣）三百十字【宋】【元】【明】【宮】"}
{"id": null, "n": "0542002", "target": "#nkr_note_mod_0542002", "type": "mod", "text": "羅【大】，維【元】"}
{"id": null, "n": "0542003", "target": "#nkr_note_mod_0542003", "type": "mod", "text": "畫【大】，晝【宮】"}
{"id": null, "n": "0542004", "target": "#nkr_note_mod_0542004", "type": "mod", "text": "修【大】，作【宋】【元】【明】【宮】"}
{"id": null, "n": "0542005", "target": "#nkr_note_mod_0542005", "type": "mod", "text": "（儀有…辛辣）三百十字【大】∞（言我今…出生）三百十三字【宋】【元】【明】【宮】"}
{"id": null, "n": "0543001", "target": "#nkr_note_mod_0543001", "type": "mod", "text": "志【大】＊，至【元】【明】＊"}
{"id": null, "n": "0543002", "target": "#nkr_note_mod_0543002", "type": "mod", "text": "不【大】，不不【宋】【元】【宮】，下不【明】"}
{"id": null, "n": "0544001", "target": "#nkr_note_mod_0544001", "type": "mod", "text": "（令持…色）三十五字【大】，〔－〕【宮】"}
{"id": null, "n": "0544002", "target": "#nkr_note_mod_0544002", "type": "mod", "text": "怛【大】，恒【宋】【元】【明】"}
{"id": null, "n": "0544003", "target": "#nkr_note_mod_0544003", "type": "mod", "text": "若【大】，苦【宋】【元】【宮】"}
{"id": null, "n": "0544004", "target": "#nkr_note_mod_0544004", "type": "mod", "text": "囉【大】，羅【宋】【元】【明】【宮】"}
{"id": null, "n": "0545001", "target": "#nkr_note_mod_0545001", "type": "mod", "text": "密【大】，蜜【宋】"}
{"id": null, "n": "0546001", "target": "#nkr_note_mod_0546001", "type": "mod", "text": "二【大】，二第三同卷【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "第三同卷"}
{"id": null, "n": "0546002", "target": "#nkr_note_mod_0546002", "type": "mod", "text": "授【大】＊，受【明】＊"}
{"id": null, "n": "0546003", "target": "#nkr_note_mod_0546003", "type": "mod", "text": "以【大】，〔－〕【明】"}
{"id": null, "n": "0546004", "target": "#nkr_note_mod_0546004", "type": "mod", "text": "令【大】，今【元】"}
{"id": null, "n": "0547001", "target": "#nkr_note_mod_0547001", "type": "mod", "text": "志【大】，至【元】【明】"}
{"id": null, "n": "0548001", "target": "#nkr_note_mod_0548001", "type": "mod", "text": "󰊛【大】，骨【宋】"}
{"id": null, "n": "0548002", "target": "#nkr_note_mod_0548002", "type": "mod", "text": "黎【大】，犁【宋】【元】【明】【宮】"}
{"id": null, "n": "0548003", "target": "#nkr_note_mod_0548003", "type": "mod", "text": "警【大】，驚【宮】"}
{"id": null, "n": "0548004", "target": "#nkr_note_mod_0548004", "type": "mod", "text": "相【大】，想【宋】【元】【明】【宮】"}
{"id": null, "n": "0548005", "target": "#nkr_note_mod_0548005", "type": "mod", "text": "是【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0548006", "target": "#nkr_note_mod_0548006", "type": "mod", "text": "精【大】，精精【宋】【元】【宮】"}
{"id": null, "n": "0549001", "target": "#nkr_note_mod_0549001", "type": "mod", "text": "香【大】，〔－〕【宮】"}
{"id": null, "n": "0549002", "target": "#nkr_note_mod_0549002", "type": "mod", "text": "八【大】，及【明】"}
{"id": null, "n": "0549003", "target": "#nkr_note_mod_0549003", "type": "mod", "text": "由【大】，猶【元】【明】"}
{"id": null, "n": "0550001", "target": "#nkr_note_mod_0550001", "type": "mod", "text": "畫【大】，晝【宮】"}
{"id": null, "n": "0550002", "target": "#nkr_note_mod_0550002", "type": "mod", "text": "道【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0550003", "target": "#nkr_note_mod_0550003", "type": "mod", "text": "南【大】，幸【元】"}
{"id": null, "n": "0551001", "target": "#nkr_note_mod_0551001", "type": "mod", "text": "則【大】，財【宋】【元】"}
{"id": null, "n": "0551002", "target": "#nkr_note_mod_0551002", "type": "mod", "text": "祥【大】，神【元】【明】"}
{"id": null, "n": "0551003", "target": "#nkr_note_mod_0551003", "type": "mod", "text": "尸【大】，戶【元】【明】"}
{"id": null, "n": "0551004", "target": "#nkr_note_mod_0551004", "type": "mod", "text": "刺【大】＊，剌【元】【明】＊"}
{"id": null, "n": "0552001", "target": "#nkr_note_mod_0552001", "type": "mod", "text": "羯【大】，羯磨【宋】【元】【明】"}
{"id": null, "n": "0552002", "target": "#nkr_note_mod_0552002", "type": "mod", "text": "四【大】，四第五同卷【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "第五同卷"}
{"id": null, "n": "0552003", "target": "#nkr_note_mod_0552003", "type": "mod", "text": "吒【大】＊，吒一句【明】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "一句"}
{"id": null, "n": "0553001", "target": "#nkr_note_mod_0553001", "type": "mod", "text": "𤚥【大】，𤚥一句【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "一句"}
{"id": null, "n": "0553002", "target": "#nkr_note_mod_0553002", "type": "mod", "text": "賀【大】，賀一句【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "一句"}
{"id": null, "n": "0553003", "target": "#nkr_note_mod_0553003", "type": "mod", "text": "𠷑【大】＊，𠷑一句【明】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "一句"}
{"id": null, "n": "0553004", "target": "#nkr_note_mod_0553004", "type": "mod", "text": "郝【大】，郝一句【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "一句"}
{"id": null, "n": "0553005", "target": "#nkr_note_mod_0553005", "type": "mod", "text": "盤【大】，槃【宋】【元】【明】【宮】"}
{"id": null, "n": "0553006", "target": "#nkr_note_mod_0553006", "type": "mod", "text": "大【大】，太【宋】【元】【明】"}
{"id": null, "n": "0554001", "target": "#nkr_note_mod_0554001", "type": "mod", "text": "三【大】，二【宋】【元】【明】【宮】"}
{"id": null, "n": "0554002", "target": "#nkr_note_mod_0554002", "type": "mod", "text": "志【大】，至【元】【明】"}
{"id": null, "n": "0554003", "target": "#nkr_note_mod_0554003", "type": "mod", "text": "振【大】，震【宋】【元】【明】【宮】"}
{"id": null, "n": "0554004", "target": "#nkr_note_mod_0554004", "type": "mod", "text": "日【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0554005", "target": "#nkr_note_mod_0554005", "type": "mod", "text": "密【大】，蜜【宮】"}
{"id": null, "n": "0555001", "target": "#nkr_note_mod_0555001", "type": "mod", "text": "臚【大】，〔－〕【宋】【元】"}
{"id": null, "n": "0555002", "target": "#nkr_note_mod_0555002", "type": "mod", "text": "黑【大】，色【宮】"}
{"id": null, "n": "0555003", "target": "#nkr_note_mod_0555003", "type": "mod", "text": "畫【大】，盡【宋】【元】【明】"}
{"id": null, "n": "0556001", "target": "#nkr_note_mod_0556001", "type": "mod", "text": "囉【大】＊，羅【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0556002", "target": "#nkr_note_mod_0556002", "type": "mod", "text": "目【大】，自【宋】【元】"}
{"id": null, "n": "0556003", "target": "#nkr_note_mod_0556003", "type": "mod", "text": "由【大】，猶【元】【明】"}
{"id": null, "n": "0556004", "target": "#nkr_note_mod_0556004", "type": "mod", "text": "又【大】，叉【明】"}
{"id": null, "n": "0557001", "target": "#nkr_note_mod_0557001", "type": "mod", "text": "成【大】，戌【宋】【元】【明】【宮】"}
