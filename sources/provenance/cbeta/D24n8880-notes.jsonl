{"id": null, "n": null, "target": null, "type": null, "text": "乾下乾上"}
{"id": null, "n": null, "target": null, "type": null, "text": "此上下三𦘕合六爻位也是伏󷯵所𦘕時未出文書也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此出莊子"}
{"id": null, "n": null, "target": null, "type": null, "text": "惡"}
{"id": null, "n": null, "target": null, "type": null, "text": "好"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "子罕"}
{"id": null, "n": null, "target": null, "type": null, "text": "仕麥切幽深也"}
{"id": null, "n": null, "target": null, "type": null, "text": "求也"}
{"id": null, "n": null, "target": null, "type": null, "text": "倭言加氣出之"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "日字一本作魯"}
{"id": null, "n": null, "target": null, "type": null, "text": "子鴆切"}
{"id": null, "n": null, "target": null, "type": null, "text": "倭言阿夜末都"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上"}
{"id": null, "n": null, "target": null, "type": null, "text": "於毛比美波"}
{"id": null, "n": null, "target": null, "type": null, "text": "於知𥘾牟\n土須流尒"}
{"id": null, "n": null, "target": null, "type": null, "text": "有美工"}
{"id": null, "n": null, "target": null, "type": null, "text": "比伊天多利"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿土乎"}
{"id": null, "n": null, "target": null, "type": null, "text": "藏一本作識"}
{"id": null, "n": null, "target": null, "type": null, "text": "巚一本作嶽又作嶺"}
{"id": null, "n": null, "target": null, "type": null, "text": "倭云宇加邊多利"}
{"id": null, "n": null, "target": null, "type": null, "text": "倭云米豆良之"}
{"id": null, "n": null, "target": null, "type": null, "text": "合云麻公止尒"}
{"id": null, "n": null, "target": null, "type": null, "text": "落也"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿由美"}
{"id": null, "n": null, "target": null, "type": null, "text": "訓比多多氣"}
{"id": null, "n": null, "target": null, "type": null, "text": "比止餘利乃糸"}
{"id": null, "n": null, "target": null, "type": null, "text": "九夷在東八狄在北七戎在西六蠻在南指四荒也"}
{"id": null, "n": null, "target": null, "type": null, "text": "酒糟可牛喫也"}
{"id": null, "n": null, "target": null, "type": null, "text": "糓皮不牛喫也"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "注二即湯谷也"}
{"id": null, "n": null, "target": null, "type": null, "text": "注云言交會相代"}
{"id": null, "n": null, "target": null, "type": null, "text": "注云日中\n有三足烏"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "可奈倍流"}
{"id": null, "n": null, "target": null, "type": null, "text": "加倍禮利"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "太宗名世民"}
{"id": null, "n": null, "target": null, "type": null, "text": "多牟呂又牟羅加流"}
{"id": null, "n": null, "target": null, "type": null, "text": "倭訓多計久之工"}
{"id": null, "n": null, "target": null, "type": null, "text": "濫一本作監"}
{"id": null, "n": null, "target": null, "type": null, "text": "走也"}
{"id": null, "n": null, "target": null, "type": null, "text": "舌"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本無云字"}
{"id": null, "n": null, "target": null, "type": null, "text": "竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "玄"}
{"id": null, "n": null, "target": null, "type": null, "text": "現本分本末為二十卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "分為五卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦云文義記"}
{"id": null, "n": null, "target": null, "type": null, "text": "或為十三卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "一百行亦云廣釋唯識本母頌"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦云別鈔"}
{"id": null, "n": null, "target": null, "type": null, "text": "廾四葉"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋本論及基䟽"}
{"id": null, "n": null, "target": null, "type": null, "text": "分本末為十四卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或分本末成十卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦云北鈔"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦云東鈔釋基䟽"}
{"id": null, "n": null, "target": null, "type": null, "text": "調卷有異"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋本論及基䟽"}
{"id": null, "n": null, "target": null, "type": null, "text": "善珠本分成廾四卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋論及基䟽"}
{"id": null, "n": null, "target": null, "type": null, "text": "天竺寺蓮峯崇俊撰惟揚禪智寺法清釋"}
{"id": null, "n": null, "target": null, "type": null, "text": "內題云要鈔"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋基䟽序"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋基䟽序"}
{"id": null, "n": null, "target": null, "type": null, "text": "延暦十八年岡寺講"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋基䟽序"}
{"id": null, "n": null, "target": null, "type": null, "text": "或六卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或十四卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "科文四卷大科一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或十卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "南都古本調卷不同又問答有具略"}
{"id": null, "n": null, "target": null, "type": null, "text": "興玄等徒艸創大德編集置今"}
{"id": null, "n": null, "target": null, "type": null, "text": "於明朝雖有智旭等義章稍違基疏故不載此"}
{"id": null, "n": null, "target": null, "type": null, "text": "開為四卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或分四卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "分為三卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "廾二葉"}
{"id": null, "n": null, "target": null, "type": null, "text": "分本末為十三卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "訖燈第六"}
{"id": null, "n": null, "target": null, "type": null, "text": "盡燈第一"}
{"id": null, "n": null, "target": null, "type": null, "text": "此云\n覺賢"}
{"id": null, "n": null, "target": null, "type": null, "text": "即道塲寺也從檀󷘊呼之"}
{"id": null, "n": null, "target": null, "type": null, "text": "此云日照"}
{"id": null, "n": null, "target": null, "type": null, "text": "此云喜學"}
{"id": null, "n": null, "target": null, "type": null, "text": "譯暜賢行願品成四十卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "解節經一卷陳三藏真諦譯是解㴱密經初五品異譯也又相\n續解脫經一卷求那䟦陀羅譯是後二品異譯也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此經凡有四譯今存者三本"}
{"id": null, "n": null, "target": null, "type": null, "text": "彌勒菩薩說無著菩薩造"}
{"id": null, "n": null, "target": null, "type": null, "text": "本頌一卷釋論二十卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "十三卷或十五卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "本頌彌勒菩薩說無著菩薩造釋論世親\n\n菩薩造"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐言作明知識"}
{"id": null, "n": null, "target": null, "type": null, "text": "四卷開元錄為闕本有二譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "有三譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "世親菩薩造無性菩薩造"}
{"id": null, "n": null, "target": null, "type": null, "text": "十二卷或十五卷釋󲘈嚴經中十地品"}
{"id": null, "n": null, "target": null, "type": null, "text": "與真諦所譯無相思塵論同本"}
{"id": null, "n": null, "target": null, "type": null, "text": "與元魏般若流支所譯破色心論又真諦所譯修道不共他論同本"}
{"id": null, "n": null, "target": null, "type": null, "text": "有二譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "本論無著菩薩造釋論覺師子造"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "又名依名釋義論"}
{"id": null, "n": null, "target": null, "type": null, "text": "又云總攝大乘義攴論"}
{"id": null, "n": null, "target": null, "type": null, "text": "又云廣陳大義攴論"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
