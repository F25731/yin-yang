{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "全文"}
{"id": null, "n": null, "target": null, "type": null, "text": "大悲也"}
{"id": null, "n": null, "target": null, "type": null, "text": "大誓也"}
{"id": null, "n": null, "target": null, "type": null, "text": "利智也"}
{"id": null, "n": null, "target": null, "type": null, "text": "方便也"}
{"id": null, "n": null, "target": null, "type": null, "text": "精進也"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔展法配喻也〕"}
{"id": null, "n": null, "target": null, "type": null, "text": "全文"}
{"id": null, "n": null, "target": null, "type": null, "text": "已見上文"}
{"id": null, "n": null, "target": null, "type": null, "text": "平聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "現行本也"}
{"id": null, "n": null, "target": null, "type": null, "text": "空也"}
{"id": null, "n": null, "target": null, "type": null, "text": "假也"}
{"id": null, "n": null, "target": null, "type": null, "text": "中也"}
{"id": null, "n": null, "target": null, "type": null, "text": "去聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "去聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "已見上文，故不繁引"}
{"id": null, "n": null, "target": null, "type": null, "text": "上全彼文"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔此上標攝文也〕"}
{"id": null, "n": null, "target": null, "type": null, "text": "根也"}
{"id": null, "n": null, "target": null, "type": null, "text": "塵也"}
{"id": null, "n": null, "target": null, "type": null, "text": "識也"}
{"id": null, "n": null, "target": null, "type": null, "text": "先觀識陰也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂了一念具三千也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂了一念三千已，故\n云若淨。然後徧歷彼彼諸法，不出我心之三千，故云歷一切法也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂三千無\n外，攝外事境，罄無不盡。"}
{"id": null, "n": null, "target": null, "type": null, "text": "了，即解也。謂三千不出一念等。"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂依解而觀三千法，不出一念也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "當知下，正示觀心之意。諸法既因心分別，是故但觀心耳。雖云唯色，色即是心。"}
{"id": null, "n": null, "target": null, "type": null, "text": "即觀\n三千性，即空假中，即前內心淨是也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "即以淨心徧歷諸法也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "即事即理，攝外歸內。三千三諦，攝無不周也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "若以二觀相扶，事理不二，\n則觀道稍明，可入觀行等位也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "當知謬解僻執之徒，安可\n與之論道。荊谿明誡，可不是乎。"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂初乘觀法有事理也"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "上皆彼文"}
{"id": null, "n": null, "target": null, "type": null, "text": "全文"}
{"id": null, "n": null, "target": null, "type": null, "text": "𤃒音峻，深也"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "此答文中有釋曰之詞者，乃天台大師釋於南\n嶽師偈，非予釋也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "予釋已見上文"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂後心繫於前心，心\n心相續也"}
{"id": null, "n": null, "target": null, "type": null, "text": "心心只是心境俱心，境境只是心境俱境，應以\n上文境智四句來此照之，釋然可曉"}
{"id": null, "n": null, "target": null, "type": null, "text": "指上心境相緣"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂剎那剎那與此心境相緣相注，無塵緣間也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此非大經疏文。"}
{"id": null, "n": null, "target": null, "type": null, "text": "已見上文所傳部別例，具以大車配對十乘，此不再出。"}
{"id": null, "n": null, "target": null, "type": null, "text": "已見上文"}
{"id": null, "n": null, "target": null, "type": null, "text": "荊谿問也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "觀師答也。喻曰者，荊谿喻\n也。下去皆爾。"}
{"id": null, "n": null, "target": null, "type": null, "text": "全文"}
{"id": null, "n": null, "target": null, "type": null, "text": "問：言喻文皆可曉，不復記也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此問答喻亦可見"}
{"id": null, "n": null, "target": null, "type": null, "text": "一也"}
{"id": null, "n": null, "target": null, "type": null, "text": "二也"}
{"id": null, "n": null, "target": null, "type": null, "text": "三也"}
{"id": null, "n": null, "target": null, "type": null, "text": "四也"}
{"id": null, "n": null, "target": null, "type": null, "text": "五也"}
{"id": null, "n": null, "target": null, "type": null, "text": "六也"}
{"id": null, "n": null, "target": null, "type": null, "text": "七也"}
{"id": null, "n": null, "target": null, "type": null, "text": "八也"}
{"id": null, "n": null, "target": null, "type": null, "text": "九也"}
{"id": null, "n": null, "target": null, "type": null, "text": "十也"}
{"id": null, "n": null, "target": null, "type": null, "text": "十一也"}
{"id": null, "n": null, "target": null, "type": null, "text": "文中兩或字并誤。"}
{"id": null, "n": null, "target": null, "type": null, "text": "問、答、喻三顯然，故不釋。"}
{"id": null, "n": null, "target": null, "type": null, "text": "直引彼執"}
{"id": null, "n": null, "target": null, "type": null, "text": "文在不識教體妨中"}
{"id": null, "n": null, "target": null, "type": null, "text": "竅，古弔切"}
{"id": null, "n": null, "target": null, "type": null, "text": "直引彼執"}
{"id": null, "n": null, "target": null, "type": null, "text": "此直引僻解所執也"}
{"id": null, "n": null, "target": null, "type": null, "text": "僻解答也"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": "0152001A", "target": "#nkr_note_mod_0152001A", "type": "mod", "text": "去疑上"}
{"id": null, "n": "0152001B", "target": "#nkr_note_mod_0152001B", "type": "mod", "text": "上疑去"}
{"id": null, "n": "0175002", "target": "#nkr_note_mod_0175002", "type": "mod", "text": "補入又已下三行"}
{"id": null, "n": "0124001", "target": "#nkr_note_orig_0124001", "type": "orig", "text": "曰一作答"}
{"id": null, "n": "0125001", "target": "#nkr_note_orig_0125001", "type": "orig", "text": "談一作說"}
{"id": null, "n": "0125002", "target": "#nkr_note_orig_0125002", "type": "orig", "text": "顯一作說"}
{"id": null, "n": "0125003", "target": "#nkr_note_orig_0125003", "type": "orig", "text": "正一作文"}
{"id": null, "n": "0125004", "target": "#nkr_note_orig_0125004", "type": "orig", "text": "法等四字係釋者所加"}
{"id": null, "n": "0125005", "target": "#nkr_note_orig_0125005", "type": "orig", "text": "說一作華"}
{"id": null, "n": "0126001", "target": "#nkr_note_orig_0126001", "type": "orig", "text": "遠上一有有字"}
{"id": null, "n": "0126002", "target": "#nkr_note_orig_0126002", "type": "orig", "text": "斷一作將"}
{"id": null, "n": "0127001", "target": "#nkr_note_orig_0127001", "type": "orig", "text": "一無不等四字"}
{"id": null, "n": "0128001", "target": "#nkr_note_orig_0128001", "type": "orig", "text": "教一作假"}
{"id": null, "n": "0130001", "target": "#nkr_note_orig_0130001", "type": "orig", "text": "四一作圓"}
{"id": null, "n": "0133001", "target": "#nkr_note_orig_0133001", "type": "orig", "text": "從一作位"}
{"id": null, "n": "0133002", "target": "#nkr_note_orig_0133002", "type": "orig", "text": "顯一作頭下同"}
{"id": null, "n": "0135001", "target": "#nkr_note_orig_0135001", "type": "orig", "text": "初疑其"}
{"id": null, "n": "0136001", "target": "#nkr_note_orig_0136001", "type": "orig", "text": "思一作心"}
{"id": null, "n": "0136002", "target": "#nkr_note_orig_0136002", "type": "orig", "text": "纂要卷第二"}
{"id": null, "n": "0136003", "target": "#nkr_note_orig_0136003", "type": "orig", "text": "展等五字一本大書"}
{"id": null, "n": "0137001", "target": "#nkr_note_orig_0137001", "type": "orig", "text": "乘則准本文應作法則開"}
{"id": null, "n": "0137002", "target": "#nkr_note_orig_0137002", "type": "orig", "text": "四疑五"}
{"id": null, "n": "0138001", "target": "#nkr_note_orig_0138001", "type": "orig", "text": "小上一有若字"}
{"id": null, "n": "0138002", "target": "#nkr_note_orig_0138002", "type": "orig", "text": "擥一作攬下同"}
{"id": null, "n": "0138003", "target": "#nkr_note_orig_0138003", "type": "orig", "text": "顯一作頭下同"}
{"id": null, "n": "0139001", "target": "#nkr_note_orig_0139001", "type": "orig", "text": "四疑五"}
{"id": null, "n": "0140001", "target": "#nkr_note_orig_0140001", "type": "orig", "text": "疏遺一作疎違"}
{"id": null, "n": "0140002", "target": "#nkr_note_orig_0140002", "type": "orig", "text": "疏一作疎"}
{"id": null, "n": "0140003", "target": "#nkr_note_orig_0140003", "type": "orig", "text": "佛上一有一字"}
{"id": null, "n": "0140004", "target": "#nkr_note_orig_0140004", "type": "orig", "text": "如一作故"}
{"id": null, "n": "0141001", "target": "#nkr_note_orig_0141001", "type": "orig", "text": "亦一作並"}
{"id": null, "n": "0142001", "target": "#nkr_note_orig_0142001", "type": "orig", "text": "四疑三"}
{"id": null, "n": "0142002", "target": "#nkr_note_orig_0142002", "type": "orig", "text": "記疑輔行"}
{"id": null, "n": "0142003", "target": "#nkr_note_orig_0142003", "type": "orig", "text": "叢疑𫎇"}
{"id": null, "n": "0142004", "target": "#nkr_note_orig_0142004", "type": "orig", "text": "呵五欲疑棄五蓋"}
{"id": null, "n": "0145001", "target": "#nkr_note_orig_0145001", "type": "orig", "text": "四一作五"}
{"id": null, "n": "0146001", "target": "#nkr_note_orig_0146001", "type": "orig", "text": "期字往義也下同"}
{"id": null, "n": "0148001", "target": "#nkr_note_orig_0148001", "type": "orig", "text": "具一作且"}
{"id": null, "n": "0150001", "target": "#nkr_note_orig_0150001", "type": "orig", "text": "十一作中"}
{"id": null, "n": "0151001", "target": "#nkr_note_orig_0151001", "type": "orig", "text": "纂要卷第三"}
{"id": null, "n": "0152001A", "target": "#nkr_note_orig_0152001A", "type": "orig", "text": "去上疑倒置"}
{"id": null, "n": "0152001B", "target": "#nkr_note_orig_0152001B", "type": "orig", "text": "去上疑倒置"}
{"id": null, "n": "0154001", "target": "#nkr_note_orig_0154001", "type": "orig", "text": "五疑四"}
{"id": null, "n": "0154002", "target": "#nkr_note_orig_0154002", "type": "orig", "text": "諸下入道字見"}
{"id": null, "n": "0156001", "target": "#nkr_note_orig_0156001", "type": "orig", "text": "乾慧疑性地"}
{"id": null, "n": "0156002", "target": "#nkr_note_orig_0156002", "type": "orig", "text": "云字疑剩"}
{"id": null, "n": "0157001", "target": "#nkr_note_orig_0157001", "type": "orig", "text": "眾疑定"}
{"id": null, "n": "0160001", "target": "#nkr_note_orig_0160001", "type": "orig", "text": "無疑元"}
{"id": null, "n": "0160002", "target": "#nkr_note_orig_0160002", "type": "orig", "text": "謂異作言"}
{"id": null, "n": "0161001", "target": "#nkr_note_orig_0161001", "type": "orig", "text": "本無疑無本"}
{"id": null, "n": "0161002", "target": "#nkr_note_orig_0161002", "type": "orig", "text": "纂要卷第四"}
{"id": null, "n": "0162001", "target": "#nkr_note_orig_0162001", "type": "orig", "text": "槩疑既"}
{"id": null, "n": "0164001", "target": "#nkr_note_orig_0164001", "type": "orig", "text": "矣等三字疑衍"}
{"id": null, "n": "0165001", "target": "#nkr_note_orig_0165001", "type": "orig", "text": "此等六字異作也一字"}
{"id": null, "n": "0166001", "target": "#nkr_note_orig_0166001", "type": "orig", "text": "中異作懺"}
{"id": null, "n": "0167001", "target": "#nkr_note_orig_0167001", "type": "orig", "text": "＊印下止觀有具字（＊印ノ字ハ本文ト異ナル。󴦒）"}
{"id": null, "n": "0167002", "target": "#nkr_note_orig_0167002", "type": "orig", "text": "覺下入知字見"}
{"id": null, "n": "0172001", "target": "#nkr_note_orig_0172001", "type": "orig", "text": "如一作引"}
{"id": null, "n": "0172002", "target": "#nkr_note_orig_0172002", "type": "orig", "text": "法疑行"}
{"id": null, "n": "0173001", "target": "#nkr_note_orig_0173001", "type": "orig", "text": "深下異有重字"}
{"id": null, "n": "0173002", "target": "#nkr_note_orig_0173002", "type": "orig", "text": "性上一有法字"}
{"id": null, "n": "0174001", "target": "#nkr_note_orig_0174001", "type": "orig", "text": "纂釋卷第五"}
{"id": null, "n": "0174002", "target": "#nkr_note_orig_0174002", "type": "orig", "text": "以上疑脫不字"}
{"id": null, "n": "0174003", "target": "#nkr_note_orig_0174003", "type": "orig", "text": "三下疑脫三字"}
{"id": null, "n": "0175001", "target": "#nkr_note_orig_0175001", "type": "orig", "text": "體疑對"}
{"id": null, "n": "0175002", "target": "#nkr_note_orig_0175002", "type": "orig", "text": "補入又巳下三行"}
{"id": null, "n": "0176001", "target": "#nkr_note_orig_0176001", "type": "orig", "text": "性下一有無起性名假名起性八字"}
{"id": null, "n": "0176002", "target": "#nkr_note_orig_0176002", "type": "orig", "text": "滅下疑脫即字"}
{"id": null, "n": "0177001", "target": "#nkr_note_orig_0177001", "type": "orig", "text": "并異作合"}
{"id": null, "n": "0178001", "target": "#nkr_note_orig_0178001", "type": "orig", "text": "二一作三"}
{"id": null, "n": "0179001", "target": "#nkr_note_orig_0179001", "type": "orig", "text": "乃一作何"}
{"id": null, "n": "0180001", "target": "#nkr_note_orig_0180001", "type": "orig", "text": "心上異有見字"}
{"id": null, "n": "0180002", "target": "#nkr_note_orig_0180002", "type": "orig", "text": "體一作德"}
{"id": null, "n": "0181001", "target": "#nkr_note_orig_0181001", "type": "orig", "text": "竺一作葉"}
{"id": null, "n": "0184001", "target": "#nkr_note_orig_0184001", "type": "orig", "text": "俱一作但"}
{"id": null, "n": "0184002", "target": "#nkr_note_orig_0184002", "type": "orig", "text": "此上一有致字"}
{"id": null, "n": "0187001", "target": "#nkr_note_orig_0187001", "type": "orig", "text": "反一作及"}
{"id": null, "n": "0188001", "target": "#nkr_note_orig_0188001", "type": "orig", "text": "纂要卷第六"}
{"id": null, "n": "0192001", "target": "#nkr_note_orig_0192001", "type": "orig", "text": "石下一有自字"}
{"id": null, "n": "0195001", "target": "#nkr_note_orig_0195001", "type": "orig", "text": "別異作異．別下有登住則同四字"}
{"id": null, "n": "0195002", "target": "#nkr_note_orig_0195002", "type": "orig", "text": "也下異有登住則同者五字佚失可惜可借"}
{"id": null, "n": "0195003", "target": "#nkr_note_orig_0195003", "type": "orig", "text": "四下一有時字"}
{"id": null, "n": "0198001", "target": "#nkr_note_orig_0198001", "type": "orig", "text": "同一作圓"}
{"id": null, "n": "0200001", "target": "#nkr_note_orig_0200001", "type": "orig", "text": "依異本補入觀等七字"}
