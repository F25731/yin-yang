{"id": null, "n": "0939008", "target": "#nkr_note_orig_0939008", "type": "orig", "text": "泆＝洗【聖】"}
{"id": null, "n": "0939009", "target": "#nkr_note_orig_0939009", "type": "orig", "text": "視＝示【三】【宮】"}
