{"id": null, "n": "0938020", "target": "#nkr_note_orig_0938020", "type": "orig", "text": "畫＝晝【明】，盡【聖】"}
{"id": null, "n": "0938021", "target": "#nkr_note_orig_0938021", "type": "orig", "text": "〔夷〕－【聖】"}
{"id": null, "n": "0938022", "target": "#nkr_note_orig_0938022", "type": "orig", "text": "匿＝𧏾【三】【宮】"}
{"id": null, "n": "0938023", "target": "#nkr_note_orig_0938023", "type": "orig", "text": "〔經〕－【聖】"}
{"id": null, "n": "0938024", "target": "#nkr_note_orig_0938024", "type": "orig", "text": "左右＝右左【聖】"}
{"id": null, "n": "0938025", "target": "#nkr_note_orig_0938025", "type": "orig", "text": "論＝語【聖】"}
{"id": null, "n": "0939001", "target": "#nkr_note_orig_0939001", "type": "orig", "text": "傴＝歐【聖】"}
{"id": null, "n": "0939002", "target": "#nkr_note_orig_0939002", "type": "orig", "text": "〔得〕－【聖】"}
{"id": null, "n": "0939003", "target": "#nkr_note_orig_0939003", "type": "orig", "text": "婢＝婦【聖】"}
{"id": null, "n": "0939004", "target": "#nkr_note_orig_0939004", "type": "orig", "text": "當長＝隻【聖】"}
{"id": null, "n": "0939005", "target": "#nkr_note_orig_0939005", "type": "orig", "text": "〔燥〕－【宮】"}
{"id": null, "n": "0939006", "target": "#nkr_note_orig_0939006", "type": "orig", "text": "大＝太【宋】【元】"}
