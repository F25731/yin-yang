{"id": null, "n": "0938017", "target": "#nkr_note_orig_0938017", "type": "orig", "text": "於＝與【明】"}
{"id": null, "n": "0938018", "target": "#nkr_note_orig_0938018", "type": "orig", "text": "避＝僻【三】【宮】"}
