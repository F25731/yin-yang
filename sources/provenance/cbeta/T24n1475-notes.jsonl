{"id": null, "n": "0938009", "target": "#nkr_note_mod_0938009", "type": "mod", "text": "沙彌尼戒經【大】，〔－〕【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0938010", "target": "#nkr_note_mod_0938010", "type": "mod", "text": "東晉失譯【大】，失譯【宋】【宮】，〔－〕【聖】，失譯人名【元】，東晉失譯＝失譯【元】"}
{"id": null, "n": "0938011", "target": "#nkr_note_mod_0938011", "type": "mod", "text": "字【大】，目【聖】"}
{"id": null, "n": "0938012", "target": "#nkr_note_mod_0938012", "type": "mod", "text": "離【大】＊，尼【明】＊"}
{"id": null, "n": "0938013", "target": "#nkr_note_mod_0938013", "type": "mod", "text": "吹笛【大】，𮆀【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0938014", "target": "#nkr_note_mod_0938014", "type": "mod", "text": "臥【大】，狀【聖】"}
{"id": null, "n": "0938015", "target": "#nkr_note_mod_0938015", "type": "mod", "text": "不得【大】，〔－〕【聖】"}
{"id": null, "n": "0938016", "target": "#nkr_note_mod_0938016", "type": "mod", "text": "急【大】，善【宋】【元】【明】【宮】"}
{"id": null, "n": "0938017", "target": "#nkr_note_mod_0938017", "type": "mod", "text": "於【大】，與【明】"}
{"id": null, "n": "0938018", "target": "#nkr_note_mod_0938018", "type": "mod", "text": "避【大】，僻【宋】【元】【明】【宮】"}
{"id": null, "n": "0938019", "target": "#nkr_note_mod_0938019", "type": "mod", "text": "抆【大】，挍【聖】"}
{"id": null, "n": "0938020", "target": "#nkr_note_mod_0938020", "type": "mod", "text": "畫【大】，晝【明】，盡【聖】"}
{"id": null, "n": "0938021", "target": "#nkr_note_mod_0938021", "type": "mod", "text": "夷【大】，〔－〕【聖】"}
{"id": null, "n": "0938022", "target": "#nkr_note_mod_0938022", "type": "mod", "text": "匿【大】，𧏾【宋】【元】【明】【宮】"}
{"id": null, "n": "0938023", "target": "#nkr_note_mod_0938023", "type": "mod", "text": "經【大】，〔－〕【聖】"}
{"id": null, "n": "0938024", "target": "#nkr_note_mod_0938024", "type": "mod", "text": "左右【大】，右左【聖】"}
{"id": null, "n": "0938025", "target": "#nkr_note_mod_0938025", "type": "mod", "text": "論【大】，語【聖】"}
{"id": null, "n": "0939001", "target": "#nkr_note_mod_0939001", "type": "mod", "text": "傴【大】，歐【聖】"}
{"id": null, "n": "0939002", "target": "#nkr_note_mod_0939002", "type": "mod", "text": "得【大】，〔－〕【聖】"}
{"id": null, "n": "0939003", "target": "#nkr_note_mod_0939003", "type": "mod", "text": "婢【大】，婦【聖】"}
{"id": null, "n": "0939004", "target": "#nkr_note_mod_0939004", "type": "mod", "text": "當長【大】，隻【聖】"}
{"id": null, "n": "0939005", "target": "#nkr_note_mod_0939005", "type": "mod", "text": "燥【大】，〔－〕【宮】"}
{"id": null, "n": "0939006", "target": "#nkr_note_mod_0939006", "type": "mod", "text": "大【大】，太【宋】【元】"}
{"id": null, "n": "0939007", "target": "#nkr_note_mod_0939007", "type": "mod", "text": "姿【大】＊，恣【宋】【元】【明】【宮】【聖】＊"}
{"id": null, "n": "0939008", "target": "#nkr_note_mod_0939008", "type": "mod", "text": "泆【大】，洗【聖】"}
