{"id": null, "n": null, "target": null, "type": null, "text": "著拈"}
{"id": null, "n": null, "target": null, "type": null, "text": "眾等"}
{"id": null, "n": null, "target": null, "type": null, "text": "著拈"}
{"id": null, "n": null, "target": null, "type": null, "text": "這問從甚處來"}
{"id": null, "n": null, "target": null, "type": null, "text": "半邊內煮乾坤"}
{"id": null, "n": null, "target": null, "type": null, "text": "一微門華藏"}
{"id": null, "n": null, "target": null, "type": null, "text": "年老成精"}
{"id": null, "n": null, "target": null, "type": null, "text": "止徒\n口快"}
{"id": null, "n": null, "target": null, "type": null, "text": "討甚麼碗"}
{"id": null, "n": null, "target": null, "type": null, "text": "不妨疑著"}
{"id": null, "n": null, "target": null, "type": null, "text": "作麼作麼"}
{"id": null, "n": null, "target": null, "type": null, "text": "我到這裏卻不會"}
{"id": null, "n": null, "target": null, "type": null, "text": "切忌引壞人家男女"}
{"id": null, "n": null, "target": null, "type": null, "text": "猶恐棒頭無眼"}
{"id": null, "n": null, "target": null, "type": null, "text": "師兄師兄"}
{"id": null, "n": null, "target": null, "type": null, "text": "切莫造次"}
{"id": null, "n": null, "target": null, "type": null, "text": "放過即不可"}
{"id": null, "n": null, "target": null, "type": null, "text": "手足分中勤勞些"}
{"id": null, "n": null, "target": null, "type": null, "text": "草鞋錢費多少"}
{"id": null, "n": null, "target": null, "type": null, "text": "恁麼那"}
{"id": null, "n": null, "target": null, "type": null, "text": "不妨疑著"}
{"id": null, "n": null, "target": null, "type": null, "text": "是野干鳴是獅子吼"}
{"id": null, "n": null, "target": null, "type": null, "text": "賞伊罰伊"}
{"id": null, "n": null, "target": null, "type": null, "text": "只這是更別有"}
{"id": null, "n": null, "target": null, "type": null, "text": "賞罰分明"}
{"id": null, "n": null, "target": null, "type": null, "text": "婆心太切"}
{"id": null, "n": null, "target": null, "type": null, "text": "真語耶實\n語耶"}
{"id": null, "n": null, "target": null, "type": null, "text": "執著作麼"}
{"id": null, "n": null, "target": null, "type": null, "text": "有勞用"}
{"id": null, "n": null, "target": null, "type": null, "text": "再來不直錢"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒼天蒼天"}
{"id": null, "n": null, "target": null, "type": null, "text": "禮下于人必有所求"}
{"id": null, "n": null, "target": null, "type": null, "text": "作麼"}
{"id": null, "n": null, "target": null, "type": null, "text": "咄"}
{"id": null, "n": null, "target": null, "type": null, "text": "何幸如之"}
{"id": null, "n": null, "target": null, "type": null, "text": "何不向神廟裏去"}
{"id": null, "n": null, "target": null, "type": null, "text": "師弟也不識"}
{"id": null, "n": null, "target": null, "type": null, "text": "對親不說假"}
{"id": null, "n": null, "target": null, "type": null, "text": "頓斷掛心鉤"}
{"id": null, "n": null, "target": null, "type": null, "text": "過在甚麼處"}
{"id": null, "n": null, "target": null, "type": null, "text": "斬新日月特地乾坤"}
{"id": null, "n": null, "target": null, "type": null, "text": "別圖方便"}
{"id": null, "n": null, "target": null, "type": null, "text": "坐著即不可"}
{"id": null, "n": null, "target": null, "type": null, "text": "也不得放過"}
{"id": null, "n": null, "target": null, "type": null, "text": "又恁麼道"}
{"id": null, "n": null, "target": null, "type": null, "text": "無事討事"}
{"id": null, "n": null, "target": null, "type": null, "text": "問阿誰"}
{"id": null, "n": null, "target": null, "type": null, "text": "中央聻"}
{"id": null, "n": null, "target": null, "type": null, "text": "討甚麼碗"}
{"id": null, "n": null, "target": null, "type": null, "text": "丙丁童子去討火"}
{"id": null, "n": null, "target": null, "type": null, "text": "西來意聻"}
{"id": null, "n": null, "target": null, "type": null, "text": "莫會好"}
{"id": null, "n": null, "target": null, "type": null, "text": "適纔道甚麼"}
{"id": null, "n": null, "target": null, "type": null, "text": "再問即不\n堪"}
{"id": null, "n": null, "target": null, "type": null, "text": "不是詩人莫獻詩"}
{"id": null, "n": null, "target": null, "type": null, "text": "火因風發"}
{"id": null, "n": null, "target": null, "type": null, "text": "蘇魯㗭哩娑婆訶"}
{"id": null, "n": null, "target": null, "type": null, "text": "失火難逃三窟兔"}
{"id": null, "n": null, "target": null, "type": null, "text": "焚枝驚散一林鳥"}
{"id": null, "n": null, "target": null, "type": null, "text": "伯牙遇子期"}
{"id": null, "n": null, "target": null, "type": null, "text": "龍門變化\n三春浪，鵬路逍遙萬里天"}
{"id": null, "n": null, "target": null, "type": null, "text": "又悔雙出早，特恨獨歸遲"}
{"id": null, "n": null, "target": null, "type": null, "text": "婆心太切"}
{"id": null, "n": null, "target": null, "type": null, "text": "裏著不得火"}
{"id": null, "n": null, "target": null, "type": null, "text": "著不得沙"}
{"id": null, "n": null, "target": null, "type": null, "text": "說破不直錢"}
{"id": null, "n": null, "target": null, "type": null, "text": "一二三四五"}
{"id": null, "n": null, "target": null, "type": null, "text": "五四三二一"}
{"id": null, "n": null, "target": null, "type": null, "text": "開口為甚麼不著舌頭"}
{"id": null, "n": null, "target": null, "type": null, "text": "窮思煎"}
{"id": null, "n": null, "target": null, "type": null, "text": "不勞拈出"}
{"id": null, "n": null, "target": null, "type": null, "text": "某甲不喜\n一味禪"}
{"id": null, "n": null, "target": null, "type": null, "text": "落他坑陷"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒼天蒼天"}
{"id": null, "n": null, "target": null, "type": null, "text": "白日說鬼"}
{"id": null, "n": null, "target": null, "type": null, "text": "貨賣當時"}
{"id": null, "n": null, "target": null, "type": null, "text": "家親作祟"}
{"id": null, "n": null, "target": null, "type": null, "text": "冤家路窄"}
{"id": null, "n": null, "target": null, "type": null, "text": "早知今日，悔莫當初"}
{"id": null, "n": null, "target": null, "type": null, "text": "作麼作麼"}
{"id": null, "n": null, "target": null, "type": null, "text": "咄"}
{"id": null, "n": null, "target": null, "type": null, "text": "漏逗不少"}
{"id": null, "n": null, "target": null, "type": null, "text": "無可不可"}
{"id": null, "n": null, "target": null, "type": null, "text": "不可喚作拄杖子"}
{"id": null, "n": null, "target": null, "type": null, "text": "拄杖\n拄杖"}
{"id": null, "n": null, "target": null, "type": null, "text": "寐語作麼"}
{"id": null, "n": null, "target": null, "type": null, "text": "眉毛眼上橫"}
{"id": null, "n": null, "target": null, "type": null, "text": "一破三關"}
{"id": null, "n": null, "target": null, "type": null, "text": "切莫眼花"}
{"id": null, "n": null, "target": null, "type": null, "text": "錯過了也"}
{"id": null, "n": null, "target": null, "type": null, "text": "搭梯設階"}
{"id": null, "n": null, "target": null, "type": null, "text": "婆心太切"}
{"id": null, "n": null, "target": null, "type": null, "text": "萬象森羅非他物"}
{"id": null, "n": null, "target": null, "type": null, "text": "收來\n只在一毫端"}
{"id": null, "n": null, "target": null, "type": null, "text": "吞不人吐不出"}
{"id": null, "n": null, "target": null, "type": null, "text": "事窮必變"}
{"id": null, "n": null, "target": null, "type": null, "text": "是箇甚麼"}
{"id": null, "n": null, "target": null, "type": null, "text": "朝朝共起夜夜同眠"}
{"id": null, "n": null, "target": null, "type": null, "text": "舉步踏著"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "《嘉興藏》（如是佛典徑山藏第200冊《大笑崇禪師語錄》卷之上第1頁左欄第10行）"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "J39nB445_p0353a11"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "J39nB445_p0353a16"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "《嘉興藏》（如是佛典徑山藏第200冊《大笑崇禪師語錄》卷之下第3頁左欄第9行）"}
