{"id": null, "n": "0398008", "target": "#nkr_note_mod_0398008", "type": "mod", "text": "主【大】，王【甲】"}
{"id": null, "n": "0399001", "target": "#nkr_note_mod_0399001", "type": "mod", "text": "此大乃至清淨四十字甲本作五言八偈"}
{"id": null, "n": "0399002", "target": "#nkr_note_mod_0399002", "type": "mod", "text": "波【大】，波塞怖二合吒【考偽-原】，婆【甲】"}
{"id": null, "n": "0399003", "target": "#nkr_note_mod_0399003", "type": "mod", "text": "授【大】，受【考偽-原】"}
{"id": null, "n": "0399004", "target": "#nkr_note_mod_0399004", "type": "mod", "text": "三【大】，大三【甲】"}
{"id": null, "n": "0399005", "target": "#nkr_note_mod_0399005", "type": "mod", "text": "出【大】，生【考偽-原】"}
{"id": null, "n": "0399006", "target": "#nkr_note_mod_0399006", "type": "mod", "text": "低【大】＊，胝【甲】＊"}
{"id": null, "n": "0399007", "target": "#nkr_note_mod_0399007", "type": "mod", "text": "以【大】，以二【考偽-原】"}
{"id": null, "n": "0399008", "target": "#nkr_note_mod_0399008", "type": "mod", "text": "平【大】，乎【甲】"}
{"id": null, "n": "0399009", "target": "#nkr_note_mod_0399009", "type": "mod", "text": "摜【大】，持【考偽-原】，慣【甲】"}
{"id": null, "n": "0399010", "target": "#nkr_note_mod_0399010", "type": "mod", "text": "陵【大】，淩【甲】"}
{"id": null, "n": "0399011", "target": "#nkr_note_mod_0399011", "type": "mod", "text": "曰【大】＊，〔－〕【甲】＊"}
{"id": null, "n": "0399012", "target": "#nkr_note_mod_0399012", "type": "mod", "text": "祇【大】，〔－〕【甲】"}
{"id": null, "n": "0399013", "target": "#nkr_note_mod_0399013", "type": "mod", "text": "切【大】，反【甲】"}
{"id": null, "n": "0399015", "target": "#nkr_note_mod_0399015", "type": "mod", "text": "澁【大】，灑【甲】"}
{"id": null, "n": "0399016", "target": "#nkr_note_mod_0399016", "type": "mod", "text": "二【大】，二合【甲】"}
{"id": null, "n": "0399017", "target": "#nkr_note_mod_0399017", "type": "mod", "text": "引【大】＊，〔－〕【甲】＊"}
{"id": null, "n": "0399018", "target": "#nkr_note_mod_0399018", "type": "mod", "text": "娑【大】，娑引【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0399019", "target": "#nkr_note_mod_0399019", "type": "mod", "text": "妬【大】，姤【甲】"}
{"id": null, "n": "0399020", "target": "#nkr_note_mod_0399020", "type": "mod", "text": "膩【大】，膩二合【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0399021", "target": "#nkr_note_mod_0399021", "type": "mod", "text": "儒【大】，縛【甲】"}
{"id": null, "n": "0399022", "target": "#nkr_note_mod_0399022", "type": "mod", "text": "馱【大】，捺【考偽-原】"}
{"id": null, "n": "0399023", "target": "#nkr_note_mod_0399023", "type": "mod", "text": "泮【大】＊，伴【甲】＊"}
{"id": null, "n": "0399024", "target": "#nkr_note_mod_0399024", "type": "mod", "text": "然【大】，〔－〕【甲】"}
{"id": null, "n": "0400001", "target": "#nkr_note_mod_0400001", "type": "mod", "text": "點【大】，墨【考偽-原】"}
{"id": null, "n": "0400002", "target": "#nkr_note_mod_0400002", "type": "mod", "text": "滅【大】，威【甲】"}
{"id": null, "n": "0400003", "target": "#nkr_note_mod_0400003", "type": "mod", "text": "諸【大】，諸障【甲】"}
{"id": null, "n": "0400004", "target": "#nkr_note_mod_0400004", "type": "mod", "text": "捻【大】，恰【甲】"}
{"id": null, "n": "0400005", "target": "#nkr_note_mod_0400005", "type": "mod", "text": "一【大】，〔－〕【甲】"}
{"id": null, "n": "0400006", "target": "#nkr_note_mod_0400006", "type": "mod", "text": "𤚥【大】，𤚥二【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": "0400007", "target": "#nkr_note_mod_0400007", "type": "mod", "text": "三【大】，〔－〕【甲】"}
{"id": null, "n": "0400008", "target": "#nkr_note_mod_0400008", "type": "mod", "text": "四【大】，〔－〕【甲】"}
{"id": null, "n": "0400009", "target": "#nkr_note_mod_0400009", "type": "mod", "text": "五【大】，〔－〕【甲】"}
{"id": null, "n": "0400010", "target": "#nkr_note_mod_0400010", "type": "mod", "text": "六【大】，〔－〕【甲】"}
{"id": null, "n": "0400011", "target": "#nkr_note_mod_0400011", "type": "mod", "text": "八【大】，〔－〕【甲】"}
{"id": null, "n": "0400012", "target": "#nkr_note_mod_0400012", "type": "mod", "text": "鉢囉二合【大】，〔－〕【甲】"}
{"id": null, "n": "0400013", "target": "#nkr_note_mod_0400013", "type": "mod", "text": "於【大】，〔－〕【甲】"}
{"id": null, "n": "0400014", "target": "#nkr_note_mod_0400014", "type": "mod", "text": "鬪【大】，〔－〕【甲】"}
{"id": null, "n": "0400015", "target": "#nkr_note_mod_0400015", "type": "mod", "text": "（曩莫…南）八字【大】，〔－〕【甲】"}
{"id": null, "n": "0400016", "target": "#nkr_note_mod_0400016", "type": "mod", "text": "沮【大】＊，爼【甲】＊"}
{"id": null, "n": "0400017", "target": "#nkr_note_mod_0400017", "type": "mod", "text": "屈相【大】，相屈【考偽-原】"}
{"id": null, "n": "0400018", "target": "#nkr_note_mod_0400018", "type": "mod", "text": "印【大】，密印【甲】"}
{"id": null, "n": "0400019", "target": "#nkr_note_mod_0400019", "type": "mod", "text": "請【大】，諸【甲】"}
{"id": null, "n": "0400020", "target": "#nkr_note_mod_0400020", "type": "mod", "text": "通【大】，遍【考偽-原】"}
{"id": null, "n": "0400021", "target": "#nkr_note_mod_0400021", "type": "mod", "text": "義【大】，戈【甲】"}
{"id": null, "n": "0400022", "target": "#nkr_note_mod_0400022", "type": "mod", "text": "佛【大】，鑠【考偽-甲】"}
{"id": null, "n": "0401001", "target": "#nkr_note_mod_0401001", "type": "mod", "text": "加【大】，解時云刎惹除滿馱字句加【甲】"}
{"id": null, "n": "0401002", "target": "#nkr_note_mod_0401002", "type": "mod", "text": "弟【大】，悉弟【甲】"}
{"id": null, "n": "0401003", "target": "#nkr_note_mod_0401003", "type": "mod", "text": "合【大】，合引【甲】"}
{"id": null, "n": "0401004", "target": "#nkr_note_mod_0401004", "type": "mod", "text": "誦【大】，誦法【甲】"}
{"id": null, "n": "0401005", "target": "#nkr_note_mod_0401005", "type": "mod", "text": "（時延…誌）三十三字【大】，〔－〕【甲】"}
{"id": null, "n": "0398007", "target": "#nkr_note_orig_0398007", "type": "orig", "text": "【原】延享元年刊豐山大學藏本，【甲】高山寺藏古寫本"}
{"id": null, "n": "0398008", "target": "#nkr_note_orig_0398008", "type": "orig", "text": "主＝王【甲】"}
{"id": null, "n": "0399001", "target": "#nkr_note_orig_0399001", "type": "orig", "text": "此大乃至清淨四十字甲本作五言八偈"}
{"id": null, "n": "0399002", "target": "#nkr_note_orig_0399002", "type": "orig", "text": "波＋（塞怖二合吒）ヵ【原】，波＝婆【甲】"}
{"id": null, "n": "0399003", "target": "#nkr_note_orig_0399003", "type": "orig", "text": "授＝受ヵ【原】"}
{"id": null, "n": "0399004", "target": "#nkr_note_orig_0399004", "type": "orig", "text": "（大）＋三【甲】"}
{"id": null, "n": "0399005", "target": "#nkr_note_orig_0399005", "type": "orig", "text": "出＝生ヵ【原】"}
{"id": null, "n": "0399006", "target": "#nkr_note_orig_0399006", "type": "orig", "text": "低＝胝【甲】＊"}
{"id": null, "n": "0399007", "target": "#nkr_note_orig_0399007", "type": "orig", "text": "以＋（二）ヵ【原】"}
{"id": null, "n": "0399008", "target": "#nkr_note_orig_0399008", "type": "orig", "text": "平＝乎【甲】"}
{"id": null, "n": "0399009", "target": "#nkr_note_orig_0399009", "type": "orig", "text": "摜＝持ヵ【原】，慣【甲】"}
{"id": null, "n": "0399010", "target": "#nkr_note_orig_0399010", "type": "orig", "text": "陵＝淩【甲】"}
{"id": null, "n": "0399011", "target": "#nkr_note_orig_0399011", "type": "orig", "text": "〔曰〕－【甲】＊"}
{"id": null, "n": "0399012", "target": "#nkr_note_orig_0399012", "type": "orig", "text": "〔祇〕－【甲】"}
{"id": null, "n": "0399013", "target": "#nkr_note_orig_0399013", "type": "orig", "text": "切＝反【甲】"}
{"id": null, "n": "0399014", "target": "#nkr_note_orig_0399014", "type": "orig", "text": "原本冠註曰結印乃至言十八字若夾註"}
{"id": null, "n": "0399015", "target": "#nkr_note_orig_0399015", "type": "orig", "text": "澁＝灑【甲】"}
{"id": null, "n": "0399016", "target": "#nkr_note_orig_0399016", "type": "orig", "text": "二＋（合）【甲】"}
{"id": null, "n": "0399017", "target": "#nkr_note_orig_0399017", "type": "orig", "text": "〔引〕－【甲】＊"}
{"id": null, "n": "0399018", "target": "#nkr_note_orig_0399018", "type": "orig", "text": "娑＋（引）夾註【甲】"}
{"id": null, "n": "0399019", "target": "#nkr_note_orig_0399019", "type": "orig", "text": "妬＝姤【甲】"}
{"id": null, "n": "0399020", "target": "#nkr_note_orig_0399020", "type": "orig", "text": "膩＋（二合）夾註【甲】"}
{"id": null, "n": "0399021", "target": "#nkr_note_orig_0399021", "type": "orig", "text": "儒＝縛【甲】"}
{"id": null, "n": "0399022", "target": "#nkr_note_orig_0399022", "type": "orig", "text": "馱＝捺ヵ【原】"}
{"id": null, "n": "0399023", "target": "#nkr_note_orig_0399023", "type": "orig", "text": "泮＝伴【甲】＊"}
{"id": null, "n": "0399024", "target": "#nkr_note_orig_0399024", "type": "orig", "text": "〔然〕－【甲】"}
