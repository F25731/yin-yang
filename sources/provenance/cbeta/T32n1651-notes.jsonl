{"id": null, "n": "0480011", "target": "#nkr_note_mod_0480011", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0480012", "target": "#nkr_note_mod_0480012", "type": "mod", "text": "後魏北印度三藏【大】，元魏三藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0480013", "target": "#nkr_note_mod_0480013", "type": "mod", "text": "流支【大】，留支【元】，多摩【宮】"}
{"id": null, "n": "0480014", "target": "#nkr_note_mod_0480014", "type": "mod", "text": "苦【大】，若【宮】"}
{"id": null, "n": "0481001", "target": "#nkr_note_mod_0481001", "type": "mod", "text": "有弟子【大】，復第子【宮】"}
{"id": null, "n": "0481002", "target": "#nkr_note_mod_0481002", "type": "mod", "text": "諸【大】，攝【明】"}
{"id": null, "n": "0481003", "target": "#nkr_note_mod_0481003", "type": "mod", "text": "知請問【大】，請知故【宋】【元】【明】"}
{"id": null, "n": "0481004", "target": "#nkr_note_mod_0481004", "type": "mod", "text": "仰【大】，如【宮】"}
{"id": null, "n": "0481005", "target": "#nkr_note_mod_0481005", "type": "mod", "text": "攝【大】，說【明】"}
{"id": null, "n": "0481007", "target": "#nkr_note_mod_0481007", "type": "mod", "text": "為【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0481008", "target": "#nkr_note_mod_0481008", "type": "mod", "text": "假名【大】，假名說【宋】【元】【明】【宮】"}
{"id": null, "n": "0481009", "target": "#nkr_note_mod_0481009", "type": "mod", "text": "二【大】，二者【宋】【元】【明】【宮】"}
{"id": null, "n": "0481010", "target": "#nkr_note_mod_0481010", "type": "mod", "text": "（是苦…惱）二十三字【大】，謂苦從七生三【宋】【元】【明】【宮】"}
{"id": null, "n": "0481011", "target": "#nkr_note_mod_0481011", "type": "mod", "text": "不定以【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0481012", "target": "#nkr_note_mod_0481012", "type": "mod", "text": "而彼心識【大】，〔－〕【明】"}
{"id": null, "n": "0481013", "target": "#nkr_note_mod_0481013", "type": "mod", "text": "像【大】，有像【宋】【元】【明】【宮】"}
{"id": null, "n": "0481014", "target": "#nkr_note_mod_0481014", "type": "mod", "text": "於【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0481015", "target": "#nkr_note_mod_0481015", "type": "mod", "text": "無有【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0481016", "target": "#nkr_note_mod_0481016", "type": "mod", "text": "等【大】，業【宋】【元】【明】【宮】"}
{"id": null, "n": "0481017", "target": "#nkr_note_mod_0481017", "type": "mod", "text": "則【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0481018", "target": "#nkr_note_mod_0481018", "type": "mod", "text": "減【大】，滅【宋】【元】【明】【宮】"}
{"id": null, "n": "0481019", "target": "#nkr_note_mod_0481019", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0480011", "target": "#nkr_note_orig_0480011", "type": "orig", "text": "〔一卷〕－【三】【宮】"}
{"id": null, "n": "0480012", "target": "#nkr_note_orig_0480012", "type": "orig", "text": "後魏北印度三藏＝元魏三藏法師【三】【宮】"}
{"id": null, "n": "0480013", "target": "#nkr_note_orig_0480013", "type": "orig", "text": "流支＝留支【元】，多摩【宮】"}
{"id": null, "n": "0480014", "target": "#nkr_note_orig_0480014", "type": "orig", "text": "苦＝若【宮】"}
{"id": null, "n": "0481001", "target": "#nkr_note_orig_0481001", "type": "orig", "text": "有弟子＝復第子【宮】"}
{"id": null, "n": "0481002", "target": "#nkr_note_orig_0481002", "type": "orig", "text": "諸＝攝【明】"}
{"id": null, "n": "0481003", "target": "#nkr_note_orig_0481003", "type": "orig", "text": "知請問＝請知故【三】"}
{"id": null, "n": "0481004", "target": "#nkr_note_orig_0481004", "type": "orig", "text": "仰＝如【宮】"}
{"id": null, "n": "0481005", "target": "#nkr_note_orig_0481005", "type": "orig", "text": "攝＝說【明】"}
{"id": null, "n": "0481006", "target": "#nkr_note_orig_0481006", "type": "orig", "text": "是中乃至知三十字宋元明三本俱作長行"}
{"id": null, "n": "0481007", "target": "#nkr_note_orig_0481007", "type": "orig", "text": "〔為〕－【三】【宮】"}
{"id": null, "n": "0481008", "target": "#nkr_note_orig_0481008", "type": "orig", "text": "假名＋（說）【三】【宮】"}
{"id": null, "n": "0481009", "target": "#nkr_note_orig_0481009", "type": "orig", "text": "二＋（者）【三】【宮】"}
{"id": null, "n": "0481010", "target": "#nkr_note_orig_0481010", "type": "orig", "text": "（（是苦…惱））二十三字＝（（謂苦從七生三））六字【三】【宮】"}
{"id": null, "n": "0481011", "target": "#nkr_note_orig_0481011", "type": "orig", "text": "〔不定以〕－【三】【宮】"}
{"id": null, "n": "0481012", "target": "#nkr_note_orig_0481012", "type": "orig", "text": "〔而彼心識〕－【明】"}
{"id": null, "n": "0481013", "target": "#nkr_note_orig_0481013", "type": "orig", "text": "（有）＋像【三】【宮】"}
{"id": null, "n": "0481014", "target": "#nkr_note_orig_0481014", "type": "orig", "text": "〔於〕－【三】【宮】"}
{"id": null, "n": "0481015", "target": "#nkr_note_orig_0481015", "type": "orig", "text": "〔無有〕－【三】【宮】"}
{"id": null, "n": "0481016", "target": "#nkr_note_orig_0481016", "type": "orig", "text": "等＝業【三】【宮】"}
{"id": null, "n": "0481017", "target": "#nkr_note_orig_0481017", "type": "orig", "text": "〔則〕－【三】【宮】"}
{"id": null, "n": "0481018", "target": "#nkr_note_orig_0481018", "type": "orig", "text": "減＝滅【三】【宮】"}
{"id": null, "n": "0481019", "target": "#nkr_note_orig_0481019", "type": "orig", "text": "〔一卷〕－【三】【宮】"}
