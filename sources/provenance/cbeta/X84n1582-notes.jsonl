{"id": null, "n": null, "target": null, "type": null, "text": "遠嗣五祖演"}
{"id": null, "n": null, "target": null, "type": null, "text": "此後無傳"}
{"id": null, "n": null, "target": null, "type": null, "text": "寧嗣五祖演"}
{"id": null, "n": null, "target": null, "type": null, "text": "靜嗣五祖演"}
{"id": null, "n": null, "target": null, "type": null, "text": "此後無傳"}
{"id": null, "n": null, "target": null, "type": null, "text": "自嗣五祖演"}
{"id": null, "n": null, "target": null, "type": null, "text": "齊嗣五祖演"}
