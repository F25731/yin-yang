{"id": null, "n": null, "target": "#nkr_note_foreign_0198006", "type": null, "text": "Yo pana bhikkhu rañño khattiyassa muddhāvasittassa anikkhantarājake anībhataratanake pubbe appaṭisaṃvidito indakhīlaṃ atikkameyya pācittiyaṃ."}
{"id": null, "n": null, "target": "#nkr_note_foreign_0198007", "type": null, "text": "Tūla."}
{"id": null, "n": null, "target": "#nkr_note_foreign_0198008", "type": null, "text": "Vassikasāṭika."}
{"id": null, "n": null, "target": "#nkr_note_foreign_0198009", "type": null, "text": "Pāṭidesaniy."}
{"id": null, "n": null, "target": "#nkr_note_foreign_0198010", "type": null, "text": "Sikkhā karaṇīyā."}
{"id": null, "n": null, "target": "#nkr_note_foreign_0199001", "type": null, "text": "Satta adhikaraṇasamathā dhammā.(1. sammukhāvinaya. 2. sativinaya. 3. amūḷhavinaya. 4. paṭiññāya kāretabba. 5. yebhuy. yasikā. 6. tassapāpiyyasikā. 7. tiṇavatthāraka.)"}
