{"id": null, "n": null, "target": null, "type": null, "text": "名闕"}
{"id": null, "n": null, "target": null, "type": null, "text": "峯在棲賢"}
{"id": null, "n": null, "target": null, "type": null, "text": "名宗智"}
{"id": null, "n": null, "target": null, "type": null, "text": "大慧"}
{"id": null, "n": null, "target": null, "type": null, "text": "嗣法道吾"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃至"}
{"id": null, "n": null, "target": null, "type": null, "text": "此拆願做閑人四字也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱道昌"}
{"id": null, "n": null, "target": null, "type": null, "text": "即馬祖大師"}
{"id": null, "n": null, "target": null, "type": null, "text": "法雲寺圓通法秀"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱應真，嗣南陽。"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛果克勤、佛鑑慧懃、佛眼清遠"}
{"id": null, "n": null, "target": null, "type": null, "text": "大慧"}
{"id": null, "n": null, "target": null, "type": null, "text": "東林常總"}
{"id": null, "n": null, "target": null, "type": null, "text": "闡提惟照"}
{"id": null, "n": null, "target": null, "type": null, "text": "晦堂祖心"}
{"id": null, "n": null, "target": null, "type": null, "text": "清涼文益之號，\n又諡大法眼禪師。"}
{"id": null, "n": null, "target": null, "type": null, "text": "事出浮山傳"}
{"id": null, "n": null, "target": null, "type": null, "text": "張商英，字天覺"}
{"id": null, "n": null, "target": null, "type": null, "text": "名從悅"}
{"id": null, "n": null, "target": null, "type": null, "text": "宋"}
{"id": null, "n": null, "target": null, "type": null, "text": "法雲、佛照"}
{"id": null, "n": null, "target": null, "type": null, "text": "真如慕󳭷"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
