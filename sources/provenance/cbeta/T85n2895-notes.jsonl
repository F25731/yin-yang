{"id": null, "n": "1415002", "target": "#nkr_note_mod_1415002", "type": "mod", "text": "王【大】，位【甲】"}
{"id": null, "n": "1415003", "target": "#nkr_note_mod_1415003", "type": "mod", "text": "不【大】，不生【甲】"}
{"id": null, "n": "1415004", "target": "#nkr_note_mod_1415004", "type": "mod", "text": "即【大】，即作【甲】"}
{"id": null, "n": "1415005", "target": "#nkr_note_mod_1415005", "type": "mod", "text": "施【大】，布施【甲】"}
{"id": null, "n": "1415006", "target": "#nkr_note_mod_1415006", "type": "mod", "text": "子【大】，兒【甲】"}
{"id": null, "n": "1415007", "target": "#nkr_note_mod_1415007", "type": "mod", "text": "施【大】，〔－〕【甲】"}
{"id": null, "n": "1415008", "target": "#nkr_note_mod_1415008", "type": "mod", "text": "放【大】，波【甲】"}
{"id": null, "n": "1415009", "target": "#nkr_note_mod_1415009", "type": "mod", "text": "功德無量【大】，無量功德【甲】"}
{"id": null, "n": "1415010", "target": "#nkr_note_mod_1415010", "type": "mod", "text": "婆【大】，訶【甲】"}
{"id": null, "n": "1415011", "target": "#nkr_note_mod_1415011", "type": "mod", "text": "悉【大】，志【甲】"}
{"id": null, "n": "1415012", "target": "#nkr_note_mod_1415012", "type": "mod", "text": "方【大】，方三世【甲】"}
{"id": null, "n": "1415013", "target": "#nkr_note_mod_1415013", "type": "mod", "text": "鬼【大】，鬼多【甲】"}
{"id": null, "n": "1415014", "target": "#nkr_note_mod_1415014", "type": "mod", "text": "中【大】，〔－〕【甲】"}
{"id": null, "n": "1415015", "target": "#nkr_note_mod_1415015", "type": "mod", "text": "以【大】，以故【甲】"}
{"id": null, "n": "1415016", "target": "#nkr_note_mod_1415016", "type": "mod", "text": "至【大】，及【甲】"}
{"id": null, "n": "1415017", "target": "#nkr_note_mod_1415017", "type": "mod", "text": "烏【大】＊，鄔【甲】＊"}
{"id": null, "n": "1415018", "target": "#nkr_note_mod_1415018", "type": "mod", "text": "等正【大】，上等【甲】"}
{"id": null, "n": "1415019", "target": "#nkr_note_mod_1415019", "type": "mod", "text": "洛【大】，洛等【甲】"}
{"id": null, "n": "1414004", "target": "#nkr_note_orig_1414004", "type": "orig", "text": "【原】龍谷大學藏燉煌本，【甲】大英博物館藏燉煌本, S. 2044, 甲本首缺"}
