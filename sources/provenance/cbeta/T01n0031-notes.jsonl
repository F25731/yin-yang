{"id": null, "n": "0813001", "target": "#nkr_note_mod_0813001", "type": "mod", "text": "安息…藏【大】，沙門【宋】【元】【明】"}
{"id": null, "n": "0813002", "target": "#nkr_note_mod_0813002", "type": "mod", "text": "便【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0813003", "target": "#nkr_note_mod_0813003", "type": "mod", "text": "亦癡【大】＊，流亦癡流【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0813004", "target": "#nkr_note_mod_0813004", "type": "mod", "text": "不【大】，所【宋】【元】"}
{"id": null, "n": "0813005", "target": "#nkr_note_mod_0813005", "type": "mod", "text": "念便愛流生已愛流生【大】，不念以應念法不念不應法者便念便愛法生已愛流亦【宋】【元】，念便未生愛流便生已生愛流【明】"}
{"id": null, "n": "0813006", "target": "#nkr_note_mod_0813006", "type": "mod", "text": "流【大】＊，〔－〕【宋】【元】＊"}
{"id": null, "n": "0813007", "target": "#nkr_note_mod_0813007", "type": "mod", "text": "不【大】，有不【宋】【元】"}
{"id": null, "n": "0813008", "target": "#nkr_note_mod_0813008", "type": "mod", "text": "知【大】，如【宋】【元】"}
{"id": null, "n": "0813009", "target": "#nkr_note_mod_0813009", "type": "mod", "text": "便所法【大】，所【明】"}
{"id": null, "n": "0813010", "target": "#nkr_note_mod_0813010", "type": "mod", "text": "念【大】，念法【明】"}
{"id": null, "n": "0813011", "target": "#nkr_note_mod_0813011", "type": "mod", "text": "念法【大】，法念【宋】【元】"}
{"id": null, "n": "0813012", "target": "#nkr_note_mod_0813012", "type": "mod", "text": "者【大】，者便【宋】【元】【明】"}
{"id": null, "n": "0813013", "target": "#nkr_note_mod_0813013", "type": "mod", "text": "惱生【大】，生惱【宋】【元】【明】"}
{"id": null, "n": "0813014", "target": "#nkr_note_mod_0813014", "type": "mod", "text": "攝【大】，守【明】"}
{"id": null, "n": "0813015", "target": "#nkr_note_mod_0813015", "type": "mod", "text": "更【大】，用【明】"}
{"id": null, "n": "0813016", "target": "#nkr_note_mod_0813016", "type": "mod", "text": "曉【大】＊，嘵【元】【明】＊"}
{"id": null, "n": "0813017", "target": "#nkr_note_mod_0813017", "type": "mod", "text": "念【大】，增【明】"}
{"id": null, "n": "0813018", "target": "#nkr_note_mod_0813018", "type": "mod", "text": "我【大】，我當【宋】【元】【明】"}
{"id": null, "n": "0813019", "target": "#nkr_note_mod_0813019", "type": "mod", "text": "跳【大】，掉【元】【明】"}
{"id": null, "n": "0813020", "target": "#nkr_note_mod_0813020", "type": "mod", "text": "習【大】＊，集【元】【明】＊"}
{"id": null, "n": "0813021", "target": "#nkr_note_mod_0813021", "type": "mod", "text": "從見流【大】，流從見【明】"}
{"id": null, "n": "0813022", "target": "#nkr_note_mod_0813022", "type": "mod", "text": "虺【大】，𮓸【宋】"}
