{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "時戰切音膳補也"}
{"id": null, "n": null, "target": null, "type": null, "text": "祁堯切音䎗企也"}
{"id": null, "n": null, "target": null, "type": null, "text": "所流切音搜風聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "上模朗切音蟒下籠五切音魯莽鹵猶粗率也"}
{"id": null, "n": null, "target": null, "type": null, "text": "牛刀切音熬煎也"}
{"id": null, "n": null, "target": null, "type": null, "text": "魚音切音義同"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒲登切音朋大鵬鳥也鯤魚所化"}
{"id": null, "n": null, "target": null, "type": null, "text": "逸職切音弋羽翼"}
{"id": null, "n": null, "target": null, "type": null, "text": "罔甫切音\n武鸚䳇能言鳥鵡同"}
{"id": null, "n": null, "target": null, "type": null, "text": "七慮切朔去聲同視也言作𥋖"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡千切音賢船邊也"}
{"id": null, "n": null, "target": null, "type": null, "text": "力灼切音略奪取也"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "問答不錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "息七切音悉膝同人之節也"}
{"id": null, "n": null, "target": null, "type": null, "text": "徒孫切音屯髀也"}
{"id": null, "n": null, "target": null, "type": null, "text": "匹角切音璞聲\n也一作𡄗"}
{"id": null, "n": null, "target": null, "type": null, "text": "楚絞切音吵熬也"}
{"id": null, "n": null, "target": null, "type": null, "text": "󳑧慢切音半覊絆也"}
{"id": null, "n": null, "target": null, "type": null, "text": "古暗切音贛元\n色"}
{"id": null, "n": null, "target": null, "type": null, "text": "鄂格切音額顙也"}
{"id": null, "n": null, "target": null, "type": null, "text": "紆物切音罻木叢生者"}
{"id": null, "n": null, "target": null, "type": null, "text": "必刃切音儐頰髮也"}
{"id": null, "n": null, "target": null, "type": null, "text": "楚蒐切音篘手搊也"}
{"id": null, "n": null, "target": null, "type": null, "text": "待可切音柁與柁與柂同正船木"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "匹歷切音霹破也"}
{"id": null, "n": null, "target": null, "type": null, "text": "兵臂切音秘馬轡也牽引拂戻以制馬也"}
{"id": null, "n": null, "target": null, "type": null, "text": "以兩\n切音養同庠膚欲搔也"}
{"id": null, "n": null, "target": null, "type": null, "text": "託恊切音帖服也靜也"}
{"id": null, "n": null, "target": null, "type": null, "text": "直例切音彘凝也"}
{"id": null, "n": null, "target": null, "type": null, "text": "郎丁切音𤫊剖物也"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱天香"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱鴻穎"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱次仲"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱燦"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱行英"}
{"id": null, "n": null, "target": null, "type": null, "text": "古巧切音絞撓也亂也"}
{"id": null, "n": null, "target": null, "type": null, "text": "彌列切音蔑竹皮也"}
{"id": null, "n": null, "target": null, "type": null, "text": "楚委切音欀量度也"}
{"id": null, "n": null, "target": null, "type": null, "text": "訛瑚切音吾鼠屬"}
{"id": null, "n": null, "target": null, "type": null, "text": "杜歷切音狄入米也"}
{"id": null, "n": null, "target": null, "type": null, "text": "方遇切音付同拊以手著\n物也"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "移章切音陽風所飛揚也"}
{"id": null, "n": null, "target": null, "type": null, "text": "居月切音厥菜也初生無葉可食"}
{"id": null, "n": null, "target": null, "type": null, "text": "式夜\n切音舍姓也"}
{"id": null, "n": null, "target": null, "type": null, "text": "桑才切音鰓頰顋一作揌"}
{"id": null, "n": null, "target": null, "type": null, "text": "逆各切音㖾齒齗也"}
{"id": null, "n": null, "target": null, "type": null, "text": "五各\n切音咢雕鶚也"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣"}
{"id": null, "n": null, "target": null, "type": null, "text": "實印禪人請"}
{"id": null, "n": null, "target": null, "type": null, "text": "有序"}
{"id": null, "n": null, "target": null, "type": null, "text": "費隱容請"}
{"id": null, "n": null, "target": null, "type": null, "text": "朝宗忍請"}
{"id": null, "n": null, "target": null, "type": null, "text": "萬如徵請"}
{"id": null, "n": null, "target": null, "type": null, "text": "木陳忞請"}
{"id": null, "n": null, "target": null, "type": null, "text": "牧雲門請"}
{"id": null, "n": null, "target": null, "type": null, "text": "林野奇請"}
{"id": null, "n": null, "target": null, "type": null, "text": "禹門大眾請"}
{"id": null, "n": null, "target": null, "type": null, "text": "金如玉居士請"}
{"id": null, "n": null, "target": null, "type": null, "text": "一生禪人請"}
{"id": null, "n": null, "target": null, "type": null, "text": "淳甫程居士請"}
{"id": null, "n": null, "target": null, "type": null, "text": "敬橋張居士請"}
{"id": null, "n": null, "target": null, "type": null, "text": "冶堂孫居士請"}
{"id": null, "n": null, "target": null, "type": null, "text": "定甫萬居士請"}
{"id": null, "n": null, "target": null, "type": null, "text": "魚開切音暟癡也"}
{"id": null, "n": null, "target": null, "type": null, "text": "設職切音識抆拭揩也"}
{"id": null, "n": null, "target": null, "type": null, "text": "其呂切音巨朿葦燒\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "取亂切音㸑擲也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上巨錡切音芰下里養切音兩伎倆巧也"}
{"id": null, "n": null, "target": null, "type": null, "text": "於莖切音󴂍黃鸝也"}
{"id": null, "n": null, "target": null, "type": null, "text": "矢忍切音哂况也"}
{"id": null, "n": null, "target": null, "type": null, "text": "行狀附"}
{"id": null, "n": null, "target": null, "type": null, "text": "即報恩和尚"}
{"id": null, "n": null, "target": null, "type": null, "text": "葢漂陽方語以傳漂陽人也"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱\n鶴徵"}
{"id": null, "n": null, "target": null, "type": null, "text": "僧為興建東林擊鐸募眾聲聞數里故俗\n號大梆云"}
{"id": null, "n": null, "target": null, "type": null, "text": "字子穀"}
{"id": null, "n": null, "target": null, "type": null, "text": "去冀切音器棄同捐也"}
{"id": null, "n": null, "target": null, "type": null, "text": "農都切音奴子也"}
{"id": null, "n": null, "target": null, "type": null, "text": "汝朱切音儒鮮澤也"}
{"id": null, "n": null, "target": null, "type": null, "text": "七入切音緝修補也"}
{"id": null, "n": null, "target": null, "type": null, "text": "口很切音懇齦齦齧也"}
{"id": null, "n": null, "target": null, "type": null, "text": "居案切音幹󷗿脛也"}
{"id": null, "n": null, "target": null, "type": null, "text": "呼官切音歡與歡同"}
{"id": null, "n": null, "target": null, "type": null, "text": "年譜附"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "其棲久燬"}
{"id": null, "n": null, "target": null, "type": null, "text": "通玄峰四\n山變白"}
