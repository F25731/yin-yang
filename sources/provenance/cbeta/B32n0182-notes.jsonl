{"id": null, "n": null, "target": null, "type": null, "text": "104"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上"}
{"id": null, "n": null, "target": null, "type": null, "text": "也"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "或二十卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "元承俊芿"}
{"id": null, "n": null, "target": null, "type": null, "text": "疇公四人高足之一"}
{"id": null, "n": null, "target": null, "type": null, "text": "本是已講"}
{"id": null, "n": null, "target": null, "type": null, "text": "兼本經圓"}
{"id": null, "n": null, "target": null, "type": null, "text": "兼稟覺遍"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦稟專英。英玄"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦稟緣圓"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦承幸憲"}
{"id": null, "n": null, "target": null, "type": null, "text": "承于勝詮"}
{"id": null, "n": null, "target": null, "type": null, "text": "稟于定真"}
{"id": null, "n": null, "target": null, "type": null, "text": "教允弟子"}
{"id": null, "n": null, "target": null, "type": null, "text": "順高弟子"}
{"id": null, "n": null, "target": null, "type": null, "text": "承于良盛。定真"}
{"id": null, "n": null, "target": null, "type": null, "text": "英玄弟子"}
{"id": null, "n": null, "target": null, "type": null, "text": "承于英禪。"}
{"id": null, "n": null, "target": null, "type": null, "text": "辨玄弟子"}
{"id": null, "n": null, "target": null, "type": null, "text": "稟于圓憲。專英。"}
{"id": null, "n": null, "target": null, "type": null, "text": "稟于宗懷。\n訓實奘實。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】而恐衍"}
{"id": null, "n": null, "target": null, "type": null, "text": "本元興寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "唯密宗也"}
{"id": null, "n": null, "target": null, "type": null, "text": "法圓【考】圓恐緣　澄心。俱承觀理。勝賢不稟先師等也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "兼承乘信。"}
{"id": null, "n": null, "target": null, "type": null, "text": "良源"}
{"id": null, "n": null, "target": null, "type": null, "text": "也"}
{"id": null, "n": null, "target": null, "type": null, "text": "竹林房"}
{"id": null, "n": null, "target": null, "type": null, "text": "寶地房"}
{"id": null, "n": null, "target": null, "type": null, "text": "圓珍"}
{"id": null, "n": null, "target": null, "type": null, "text": "東大寺羂索堂"}
{"id": null, "n": null, "target": null, "type": null, "text": "此據院務次第。若據受學。道澄光曉有功。"}
{"id": null, "n": null, "target": null, "type": null, "text": "受學亦是道澄。光曉。"}
{"id": null, "n": null, "target": null, "type": null, "text": "受法即是宗性僧正"}
{"id": null, "n": null, "target": null, "type": null, "text": "高信已下丹州弘宗"}
{"id": null, "n": null, "target": null, "type": null, "text": "紹公承于真雅。"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名觀音院"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上付法藏傳二十四祖"}
{"id": null, "n": null, "target": null, "type": null, "text": "由良開山"}
{"id": null, "n": null, "target": null, "type": null, "text": "道號無準"}
{"id": null, "n": null, "target": null, "type": null, "text": "人名大法眼禪師故"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上"}
{"id": null, "n": null, "target": null, "type": null, "text": "一念之義"}
{"id": null, "n": null, "target": null, "type": null, "text": "長樂寺是多念之義"}
{"id": null, "n": null, "target": null, "type": null, "text": "西山"}
{"id": null, "n": null, "target": null, "type": null, "text": "鎮西"}
{"id": null, "n": null, "target": null, "type": null, "text": "九品寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "天台學者"}
{"id": null, "n": null, "target": null, "type": null, "text": "法相"}
{"id": null, "n": null, "target": null, "type": null, "text": "三論真言"}
{"id": null, "n": null, "target": null, "type": null, "text": "律并法相"}
