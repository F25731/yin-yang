{"id": null, "n": null, "target": null, "type": null, "text": "徒本切音囤混沌元氣未判也"}
{"id": null, "n": null, "target": null, "type": null, "text": "口很切音懇力治也"}
{"id": null, "n": null, "target": null, "type": null, "text": "郎丁切跉𨂲行\n貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "而琰切荏苒猶展轉也"}
{"id": null, "n": null, "target": null, "type": null, "text": "兵媚切神也密也藏也"}
{"id": null, "n": null, "target": null, "type": null, "text": "奴罪切音鮾餓也"}
{"id": null, "n": null, "target": null, "type": null, "text": "呂角切音䃕卓犖超絕也"}
{"id": null, "n": null, "target": null, "type": null, "text": "渠龜切鍾馗人名"}
{"id": null, "n": null, "target": null, "type": null, "text": "上乙角切音渥下測角切音娖齷齪迫也"}
{"id": null, "n": null, "target": null, "type": null, "text": "朱芮切音󵙋最也得也"}
{"id": null, "n": null, "target": null, "type": null, "text": "側立切音輯藏兵也又斂也"}
{"id": null, "n": null, "target": null, "type": null, "text": "鴉蟹切隘上聲短人也"}
{"id": null, "n": null, "target": null, "type": null, "text": "口浪切音\n伉舉也"}
{"id": null, "n": null, "target": null, "type": null, "text": "古活切音括聒聒無知貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "即恊切音浹徹也"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒲官切音\n槃瘡痕也"}
{"id": null, "n": null, "target": null, "type": null, "text": "倪制切音乂芟草也"}
{"id": null, "n": null, "target": null, "type": null, "text": "夷益切音睪悅也"}
{"id": null, "n": null, "target": null, "type": null, "text": "許候切吼去聲恥辱也又\n怒也"}
{"id": null, "n": null, "target": null, "type": null, "text": "陟立切音執繫也又絆也"}
{"id": null, "n": null, "target": null, "type": null, "text": "側羊切音莊粉飾也"}
{"id": null, "n": null, "target": null, "type": null, "text": "羊益切音亦道\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "疾各切音昨以意穿鑿"}
{"id": null, "n": null, "target": null, "type": null, "text": "新於切音湑皆也"}
{"id": null, "n": null, "target": null, "type": null, "text": "於容切音邕熟食也"}
{"id": null, "n": null, "target": null, "type": null, "text": "苦骨切音窟矻矻榮極也"}
{"id": null, "n": null, "target": null, "type": null, "text": "息勇切音悚推也"}
{"id": null, "n": null, "target": null, "type": null, "text": "魚乞切音𢖴壯勇貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "師莊切音霜嫠婦曰孀"}
{"id": null, "n": null, "target": null, "type": null, "text": "鳥浩切音襖懊惱也"}
{"id": null, "n": null, "target": null, "type": null, "text": "居閑切音艱視貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "他果切音㟎安也民去愁歎而就安妥"}
{"id": null, "n": null, "target": null, "type": null, "text": "必郢切音丙除也"}
{"id": null, "n": null, "target": null, "type": null, "text": "力為切音𡰟瘦也"}
{"id": null, "n": null, "target": null, "type": null, "text": "尺允切音惷󲈀動也"}
{"id": null, "n": null, "target": null, "type": null, "text": "弋亮切音樣水搖動貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "古幸切音𦵸光也與炯通"}
{"id": null, "n": null, "target": null, "type": null, "text": "力霽切音例烈也猛也"}
{"id": null, "n": null, "target": null, "type": null, "text": "請續末後\n句"}
{"id": null, "n": null, "target": null, "type": null, "text": "古屑切音結健也"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡對切音繪散也"}
{"id": null, "n": null, "target": null, "type": null, "text": "尺栗切音䲧訶也大訶曰\n叱"}
{"id": null, "n": null, "target": null, "type": null, "text": "知鴆切砧去聲擬擊也"}
{"id": null, "n": null, "target": null, "type": null, "text": "取亂切音爨擲也"}
{"id": null, "n": null, "target": null, "type": null, "text": "乙黠切音軋󳫠也宋人有閔其苗之不長而揠之者"}
{"id": null, "n": null, "target": null, "type": null, "text": "五巧切同咬齧也"}
{"id": null, "n": null, "target": null, "type": null, "text": "莫厚切音某大指也"}
{"id": null, "n": null, "target": null, "type": null, "text": "亡遇切音敄州名隋唐置婺州"}
{"id": null, "n": null, "target": null, "type": null, "text": "許容切音凶眾語也"}
{"id": null, "n": null, "target": null, "type": null, "text": "熒絹切音眩耀\n光也"}
{"id": null, "n": null, "target": null, "type": null, "text": "楚禁切㞚去聲驗也凡讖緯皆言將來之驗也"}
{"id": null, "n": null, "target": null, "type": null, "text": "所晏切刪去聲謗也"}
{"id": null, "n": null, "target": null, "type": null, "text": "七豔切音槧坑也"}
{"id": null, "n": null, "target": null, "type": null, "text": "附來書"}
{"id": null, "n": null, "target": null, "type": null, "text": "師答你還跳得出麼"}
{"id": null, "n": null, "target": null, "type": null, "text": "答西天東土亦如是"}
{"id": null, "n": null, "target": null, "type": null, "text": "答你那裏摸索"}
{"id": null, "n": null, "target": null, "type": null, "text": "答你不達古人方便死了不得活"}
{"id": null, "n": null, "target": null, "type": null, "text": "答自生分別"}
{"id": null, "n": null, "target": null, "type": null, "text": "答將謂你鑿壁偷光"}
{"id": null, "n": null, "target": null, "type": null, "text": "答呵呵大笑"}
{"id": null, "n": null, "target": null, "type": null, "text": "答未舉先知"}
{"id": null, "n": null, "target": null, "type": null, "text": "答瞎漢"}
{"id": null, "n": null, "target": null, "type": null, "text": "答尚且不會"}
{"id": null, "n": null, "target": null, "type": null, "text": "答可見你有人我相"}
{"id": null, "n": null, "target": null, "type": null, "text": "答則恐你\n還不識"}
{"id": null, "n": null, "target": null, "type": null, "text": "答未到你在"}
{"id": null, "n": null, "target": null, "type": null, "text": "答從來不妄語"}
{"id": null, "n": null, "target": null, "type": null, "text": "答諸方早已見矣"}
{"id": null, "n": null, "target": null, "type": null, "text": "答何曾隱晦來"}
{"id": null, "n": null, "target": null, "type": null, "text": "答不識好惡在"}
{"id": null, "n": null, "target": null, "type": null, "text": "答諜諜迷\n源話頭也不識"}
{"id": null, "n": null, "target": null, "type": null, "text": "答待\n你腳跟點地方知"}
{"id": null, "n": null, "target": null, "type": null, "text": "答你也出不得"}
{"id": null, "n": null, "target": null, "type": null, "text": "答看取老僧上下文"}
{"id": null, "n": null, "target": null, "type": null, "text": "答錯"}
{"id": null, "n": null, "target": null, "type": null, "text": "答錯錯"}
{"id": null, "n": null, "target": null, "type": null, "text": "答你未夢見在"}
{"id": null, "n": null, "target": null, "type": null, "text": "答云轉見\n不堪"}
{"id": null, "n": null, "target": null, "type": null, "text": "答放你三十棒"}
{"id": null, "n": null, "target": null, "type": null, "text": "答自領去"}
{"id": null, "n": null, "target": null, "type": null, "text": "答𧄼"}
{"id": null, "n": null, "target": null, "type": null, "text": "答以\n\n楔出楔"}
{"id": null, "n": null, "target": null, "type": null, "text": "答我\n也知你作實法會"}
{"id": null, "n": null, "target": null, "type": null, "text": "答以己防人埋沒先聖"}
{"id": null, "n": null, "target": null, "type": null, "text": "答親言出親口"}
{"id": null, "n": null, "target": null, "type": null, "text": "答你未知落處在"}
{"id": null, "n": null, "target": null, "type": null, "text": "答待你徹後見"}
{"id": null, "n": null, "target": null, "type": null, "text": "答再叅三十年與你道"}
{"id": null, "n": null, "target": null, "type": null, "text": "答照顧腳下"}
{"id": null, "n": null, "target": null, "type": null, "text": "答賞罰分明"}
{"id": null, "n": null, "target": null, "type": null, "text": "答闍𥠖切忌道著"}
{"id": null, "n": null, "target": null, "type": null, "text": "答老僧決不謾你"}
{"id": null, "n": null, "target": null, "type": null, "text": "答想你不識"}
{"id": null, "n": null, "target": null, "type": null, "text": "答門外漢"}
{"id": null, "n": null, "target": null, "type": null, "text": "答恐你顢頇"}
{"id": null, "n": null, "target": null, "type": null, "text": "答倚天長劍"}
{"id": null, "n": null, "target": null, "type": null, "text": "答威風凜凜"}
{"id": null, "n": null, "target": null, "type": null, "text": "答全提正令誰敢當\n鋒"}
{"id": null, "n": null, "target": null, "type": null, "text": "答杲日當天"}
{"id": null, "n": null, "target": null, "type": null, "text": "答虛空霹靂"}
{"id": null, "n": null, "target": null, "type": null, "text": "答風馳電捲不留剩迹"}
{"id": null, "n": null, "target": null, "type": null, "text": "答恰是"}
{"id": null, "n": null, "target": null, "type": null, "text": "答面皮厚多少"}
{"id": null, "n": null, "target": null, "type": null, "text": "答掩耳偷鈴"}
{"id": null, "n": null, "target": null, "type": null, "text": "答一分少你不得"}
{"id": null, "n": null, "target": null, "type": null, "text": "答簡了也"}
{"id": null, "n": null, "target": null, "type": null, "text": "答寐語在"}
{"id": null, "n": null, "target": null, "type": null, "text": "答謗佛謗法謗僧"}
{"id": null, "n": null, "target": null, "type": null, "text": "答老僧不如你音者聲之外者也"}
{"id": null, "n": null, "target": null, "type": null, "text": "答扯東蓋西"}
{"id": null, "n": null, "target": null, "type": null, "text": "答劍去久矣"}
{"id": null, "n": null, "target": null, "type": null, "text": "答果然"}
{"id": null, "n": null, "target": null, "type": null, "text": "答未知之咎也"}
{"id": null, "n": null, "target": null, "type": null, "text": "答可憐生"}
{"id": null, "n": null, "target": null, "type": null, "text": "答可知禮也"}
{"id": null, "n": null, "target": null, "type": null, "text": "答難道"}
{"id": null, "n": null, "target": null, "type": null, "text": "答墮也"}
{"id": null, "n": null, "target": null, "type": null, "text": "答負也"}
{"id": null, "n": null, "target": null, "type": null, "text": "答大妄語漢"}
{"id": null, "n": null, "target": null, "type": null, "text": "答昧"}
{"id": null, "n": null, "target": null, "type": null, "text": "答你還跳得出麼"}
{"id": null, "n": null, "target": null, "type": null, "text": "答下士聞道"}
{"id": null, "n": null, "target": null, "type": null, "text": "答自語相違漢"}
{"id": null, "n": null, "target": null, "type": null, "text": "答遏"}
{"id": null, "n": null, "target": null, "type": null, "text": "答你那見他著實處"}
{"id": null, "n": null, "target": null, "type": null, "text": "答作賊人心虛"}
{"id": null, "n": null, "target": null, "type": null, "text": "答也不消得"}
{"id": null, "n": null, "target": null, "type": null, "text": "答青天白日"}
{"id": null, "n": null, "target": null, "type": null, "text": "答放過則不可"}
{"id": null, "n": null, "target": null, "type": null, "text": "士連切音潺弱也"}
{"id": null, "n": null, "target": null, "type": null, "text": "都鄧切音磴薨𧄼新睡起貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡困切音慁亂\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "伊力切音億胷臆"}
{"id": null, "n": null, "target": null, "type": null, "text": "伊盈切音纓觸也迫近也"}
{"id": null, "n": null, "target": null, "type": null, "text": "比用切音博與\n駮同論列是非謂之駮"}
{"id": null, "n": null, "target": null, "type": null, "text": "弭盡切音泯勉也刀所不堪心所不欲而勉強為之曰黽"}
{"id": null, "n": null, "target": null, "type": null, "text": "特計切音弟結\n不解也"}
{"id": null, "n": null, "target": null, "type": null, "text": "丘於切音墟遣也逐也散也"}
{"id": null, "n": null, "target": null, "type": null, "text": "古衡切音庚賡續也乃賡載歌"}
{"id": null, "n": null, "target": null, "type": null, "text": "如羊切音穰穰穰眾也"}
{"id": null, "n": null, "target": null, "type": null, "text": "楚簡切音鏟削也平也"}
{"id": null, "n": null, "target": null, "type": null, "text": "頻彌切音脾卑也小也"}
{"id": null, "n": null, "target": null, "type": null, "text": "許茄切音𢪎鞮\n屬亦作靴"}
{"id": null, "n": null, "target": null, "type": null, "text": "呼侯切音呴鼻怠也"}
{"id": null, "n": null, "target": null, "type": null, "text": "當沒切敦入聲呵也又咄咄驚怪聲也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即涉切音接舟櫂也刳木為舟剡木為楫舟楫之利以濟並通"}
{"id": null, "n": null, "target": null, "type": null, "text": "而兗切音軟柔也人柔弱亦謂之輭"}
{"id": null, "n": null, "target": null, "type": null, "text": "則旰切音讚逼使走也"}
{"id": null, "n": null, "target": null, "type": null, "text": "杜結\n切音耋日昃也言日蹉跌而下謂未時也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上力盇切音臘下吐盍切音榻\n邋遢行貌又邋遢不謹事也"}
{"id": null, "n": null, "target": null, "type": null, "text": "烏故切音惡喑噁怒貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "克盍切音榼擊也"}
{"id": null, "n": null, "target": null, "type": null, "text": "蘇朗切音顙柱下石"}
{"id": null, "n": null, "target": null, "type": null, "text": "烏困切溫去聲指按也"}
{"id": null, "n": null, "target": null, "type": null, "text": "許其切音熙嘻嘻和樂聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "荀勇切音竦高\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "郎丁切音靈亦作羚羚羊似羊而大角有圓繞蹙文夜則懸角木上以防患"}
{"id": null, "n": null, "target": null, "type": null, "text": "所流切音搜颼颼風聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "雖遂切音𥚢罵也詬也"}
{"id": null, "n": null, "target": null, "type": null, "text": "五故切音誤寐\n覺而有言曰寤"}
{"id": null, "n": null, "target": null, "type": null, "text": "初銜切音毚扶也"}
{"id": null, "n": null, "target": null, "type": null, "text": "公五切音古盲也"}
{"id": null, "n": null, "target": null, "type": null, "text": "乞洽切音恰爪按曰掐"}
{"id": null, "n": null, "target": null, "type": null, "text": "牛刀切音敖海中大鼈也"}
{"id": null, "n": null, "target": null, "type": null, "text": "古巧切音絞亂也繞也又手動也"}
{"id": null, "n": null, "target": null, "type": null, "text": "七句\n切蛆去聲何視也"}
{"id": null, "n": null, "target": null, "type": null, "text": "他刀切音叨藏也"}
{"id": null, "n": null, "target": null, "type": null, "text": "鋤銜切音讒巉巖高也"}
{"id": null, "n": null, "target": null, "type": null, "text": "蘇后切音叟大澤也"}
{"id": null, "n": null, "target": null, "type": null, "text": "居縛切音矍大鉏也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上烏為切委平聲下唐何切音駝逶迤行貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "虛吕切音詡栩栩喜貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "洞在磬山前有水從洞出至谿"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "吐盍切音榻嗒然忘懷也"}
{"id": null, "n": null, "target": null, "type": null, "text": "古禫切音感覆頭也"}
{"id": null, "n": null, "target": null, "type": null, "text": "師銜切音衫刈草也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此芮切音脃獸細毛也"}
{"id": null, "n": null, "target": null, "type": null, "text": "鋤銜切音巉銳器也"}
{"id": null, "n": null, "target": null, "type": null, "text": "所右切音瘦此水曰\n漱"}
{"id": null, "n": null, "target": null, "type": null, "text": "安古切音鄔村隖也與塢同"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "時起龕"}
{"id": null, "n": null, "target": null, "type": null, "text": "郎括切鸞入聲手捋也"}
{"id": null, "n": null, "target": null, "type": null, "text": "猪孟切音倀開張畫繪也"}
{"id": null, "n": null, "target": null, "type": null, "text": "魚開切音皚癡\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "牋西切音𩐎持也遺也"}
{"id": null, "n": null, "target": null, "type": null, "text": "除留切音儔籌筭也又籌第"}
{"id": null, "n": null, "target": null, "type": null, "text": "相倫\n切音荀信也"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "B22n0118_p0736a01"}
{"id": null, "n": "0097a0401", "target": "#nkr_note_add_0097a0401", "type": "add", "text": "已【CB】，巳【龍】"}
