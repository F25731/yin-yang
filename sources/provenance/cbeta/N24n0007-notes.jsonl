{"id": null, "n": null, "target": null, "type": "cf1", "text": "N24n0007_p0043a02"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "N19n0007_p0091a04"}
{"id": null, "n": "0098002", "target": "#nkr_note_mod_0098002", "type": "mod", "text": "「空無邊處」下面，原本有（jhānaṁ）一語，當除掉。（CBETA 按：漢譯南傳大藏經此頁中缺相對應之註標[02]，今於此處加上[02]之註標。）"}
{"id": null, "n": "0001001", "target": "#nkr_note_orig_0001001", "type": "orig", "text": "漢譯中阿含五七（大正藏一．四九二a）。"}
{"id": null, "n": "0005001", "target": "#nkr_note_orig_0005001", "type": "orig", "text": "漢譯中阿含五六（大正藏一．四九一a）。"}
{"id": null, "n": "0010001", "target": "#nkr_note_orig_0010001", "type": "orig", "text": "漢譯雜阿含一一、三（大正藏二．七三a）。"}
{"id": null, "n": "0018001", "target": "#nkr_note_orig_0018001", "type": "orig", "text": "參照漢譯增一阿含四五、三（大正藏二．七七一c）。"}
{"id": null, "n": "0019002", "target": "#nkr_note_orig_0019002", "type": "orig", "text": "「不問」。底本是 āpucchā。依異本改為 anāpucchā。"}
{"id": null, "n": "0019003", "target": "#nkr_note_orig_0019003", "type": "orig", "text": "「苦惱」。底本是 appakasireṇa。依異本改為 kasireṇa。"}
{"id": null, "n": "0025001", "target": "#nkr_note_orig_0025001", "type": "orig", "text": "漢譯增一阿含四四、八（大正藏二．七六七b）。"}
{"id": null, "n": "0026001", "target": "#nkr_note_orig_0026001", "type": "orig", "text": "漢譯增一阿含三七、二、六（大正藏二．七一二c）、中阿含二四（大正藏一．四五二b）。"}
{"id": null, "n": "0029002", "target": "#nkr_note_orig_0029002", "type": "orig", "text": "「󰆠」（rajoharaṇa）或「雜中」。漢譯中阿含是前者，巴利原註是採用後者。漢譯南傳律藏第四卷三九〇頁（原典第二卷二九一頁）也是依後者之解為用例。"}
{"id": null, "n": "0036001", "target": "#nkr_note_orig_0036001", "type": "orig", "text": "漢譯中阿含二九（大正藏一．四六一b）。"}
{"id": null, "n": "0040001", "target": "#nkr_note_orig_0040001", "type": "orig", "text": "參照八集八十四（漢釋南傳大藏經第二十三卷二六三頁）。"}
{"id": null, "n": "0043001", "target": "#nkr_note_orig_0043001", "type": "orig", "text": "「自然口」（abhedanamukha）。若依原註，非由任何物所破之……而生起瘡口。"}
{"id": null, "n": "0044001", "target": "#nkr_note_orig_0044001", "type": "orig", "text": "七集四十五（漢譯南傳大藏經第二十二卷二四五頁）。"}
{"id": null, "n": "0044001-1", "target": "#nkr_note_orig_0044001-1", "type": "orig", "text": "參照七集十三（漢譯南傳大藏經第二十二卷二〇五頁）。"}
{"id": null, "n": "0045001", "target": "#nkr_note_orig_0045001", "type": "orig", "text": "參照八集四十一（漢譯南傳大藏經第二十四卷一一六頁）。"}
{"id": null, "n": "0046002", "target": "#nkr_note_orig_0046002", "type": "orig", "text": "以下至第九節，各節每一冒頭有「……乃至……」恐怕是衍生。"}
{"id": null, "n": "0046003", "target": "#nkr_note_orig_0046003", "type": "orig", "text": "「修行遠離」云云，原本有 ārācāraviratā 以類似前文故改為 ārācārī vīratā。次亦同。"}
{"id": null, "n": "0047004", "target": "#nkr_note_orig_0047004", "type": "orig", "text": "「不夜食」云云，原本有 rattūparatā 之下補 viratā 一語，次亦同此。"}
{"id": null, "n": "0051001", "target": "#nkr_note_orig_0051001", "type": "orig", "text": "漢譯增一阿含二七．三（大正藏二．六四四b）、中阿含一五五（大正藏一．六七七a）。"}
{"id": null, "n": "0056001", "target": "#nkr_note_orig_0056001", "type": "orig", "text": "參照漢譯雜阿含三二．一三-一四．三三．一（大正藏二．二三三b）。三集百三十八（底本百三十七）-百三十九（漢譯南傳大藏經第十七卷四一三頁）。"}
{"id": null, "n": "0062001", "target": "#nkr_note_orig_0062001", "type": "orig", "text": "長部經典原典第三卷二八九頁（南傳大藏經第八卷三七七頁）。"}
{"id": null, "n": "0062002", "target": "#nkr_note_orig_0062002", "type": "orig", "text": "「守護」。原本及暹羅本於（ārakkhādhikaraṇaṁ）之前皆缺 ārakkho 一語，今由異本補之。"}
{"id": null, "n": "0063001", "target": "#nkr_note_orig_0063001", "type": "orig", "text": "長部經典原典第三卷二六三、二八八頁（南傳大藏經第八卷三四三、三七七頁）漢譯增一阿含四四．一（大正藏二．七六四c）、同上四四．一一（大正藏二．七六九a）。參照荻原博士編「梵漢對照佛教辭典」第一一九節。"}
{"id": null, "n": "0064001", "target": "#nkr_note_orig_0064001", "type": "orig", "text": "參照次經。"}
{"id": null, "n": "0065001", "target": "#nkr_note_orig_0065001", "type": "orig", "text": "漢譯雜阿含一八．一〇（大正藏二．一三一a）。"}
{"id": null, "n": "0066002", "target": "#nkr_note_orig_0066002", "type": "orig", "text": "「積習」原本及暹羅本皆有 suparicitaṁ 但見以下之文脈，而改為 paricitaṁ 以下同此。"}
{"id": null, "n": "0074001", "target": "#nkr_note_orig_0074001", "type": "orig", "text": "長部經典原典第三卷二六二、二八九頁（南傳大藏經第八卷四四二．三七八頁）。"}
{"id": null, "n": "0075001", "target": "#nkr_note_orig_0075001", "type": "orig", "text": "參照前經註。"}
{"id": null, "n": "0076001", "target": "#nkr_note_orig_0076001", "type": "orig", "text": "長部經典原典第三卷二六六、二九〇頁（南傳大藏經第八卷三四六、三七九頁）。"}
{"id": null, "n": "0077001", "target": "#nkr_note_orig_0077001", "type": "orig", "text": "「慧」。將底本 saññā 依異本改為 paññā。"}
{"id": null, "n": "0078001", "target": "#nkr_note_orig_0078001", "type": "orig", "text": "原本有「……乃至……」應是衍生。"}
{"id": null, "n": "0084001", "target": "#nkr_note_orig_0084001", "type": "orig", "text": "參照四十一經。"}
{"id": null, "n": "0087001", "target": "#nkr_note_orig_0087001", "type": "orig", "text": "清淨道論原典一五三頁（南傳大藏經第六十二卷三〇五頁）。"}
{"id": null, "n": "0094001", "target": "#nkr_note_orig_0094001", "type": "orig", "text": "「能射而不誤」（akkhanavedhi）。依別辭者「射如電光」。"}
{"id": null, "n": "0098002", "target": "#nkr_note_orig_0098002", "type": "orig", "text": "「空無邊處」下面，原本有（jhānaṁ）一語，當除掉。"}
{"id": null, "n": "0102003", "target": "#nkr_note_orig_0102003", "type": "orig", "text": "「於彼處云云」，於原本有誤，應知如前面。"}
{"id": null, "n": "0102001", "target": "#nkr_note_orig_0102001", "type": "orig", "text": "漢譯雜阿含二〇．二一（大正藏二．一四六a）。"}
{"id": null, "n": "0105001", "target": "#nkr_note_orig_0105001", "type": "orig", "text": "「無邊之」。原本為 antavantena 由異本改為 anantena. 同 antavantaṁ 改為 anantam。"}
{"id": null, "n": "0105002", "target": "#nkr_note_orig_0105002", "type": "orig", "text": "「速行」。原本為 gatiyā ca. 由異本除掉 ca。"}
{"id": null, "n": "0115001", "target": "#nkr_note_orig_0115001", "type": "orig", "text": "參照三十四經。"}
{"id": null, "n": "0128001", "target": "#nkr_note_orig_0128001", "type": "orig", "text": "此偈出於相應部經典原典第一卷四八頁（漢譯南傳大藏經第十二卷八九頁）。"}
{"id": null, "n": "0149001", "target": "#nkr_note_orig_0149001", "type": "orig", "text": "參照五集二百五經（漢譯南傳大藏經第十九卷二八八頁）十集十四經。"}
{"id": null, "n": "0151001", "target": "#nkr_note_orig_0151001", "type": "orig", "text": "參照五集二百六經（漢譯南傳大藏經第二十一卷二八九頁）。"}
{"id": null, "n": "0154001", "target": "#nkr_note_orig_0154001", "type": "orig", "text": "七十三經乃至八十二經至前第八正勤品似同前之第七念處品。第九神足品亦然。"}
{"id": null, "n": "0157001", "target": "#nkr_note_orig_0157001", "type": "orig", "text": "原本不出此品名，暹羅本本文及目次「第五品」（若從第九集之初算則成為第十品）。應知類同八集之末（漢譯南傳大藏經第二十三卷二七三頁以下）。然於原本雖算為第九十三～百經，今以八集之和譯分章節。"}
{"id": null, "n": "0161001", "target": "#nkr_note_orig_0161001", "type": "orig", "text": "參照漢譯中阿四二（大正藏一．四八五a）。十一集一經（次卷所收）。"}
{"id": null, "n": "0163001", "target": "#nkr_note_orig_0163001", "type": "orig", "text": "參照漢譯中阿四三（大正藏一．四八五b）。十一集二經（次卷所收）。"}
{"id": null, "n": "0164001", "target": "#nkr_note_orig_0164001", "type": "orig", "text": "參照漢譯中阿四七（大正藏一．四八六b）。十一集三經（次卷所收）。"}
{"id": null, "n": "0166001", "target": "#nkr_note_orig_0166001", "type": "orig", "text": "漢譯雜阿含一八．六（大正藏二．一二九a）。十一集第四經（次卷所收）、五集第一六八經（漢譯南傳大藏經第二十一卷二三二頁）。"}
{"id": null, "n": "0168001", "target": "#nkr_note_orig_0168001", "type": "orig", "text": "參照十一集第五經（次卷所收）。"}
{"id": null, "n": "0170001", "target": "#nkr_note_orig_0170001", "type": "orig", "text": "參照十一卷七經（次卷所收）。"}
{"id": null, "n": "0171002", "target": "#nkr_note_orig_0171002", "type": "orig", "text": "「如是」。把底本 yathārūpo 改為 tathārūpo。"}
{"id": null, "n": "0171001", "target": "#nkr_note_orig_0171001", "type": "orig", "text": "參照十一集八經（後半是不同）。"}
{"id": null, "n": "0173001", "target": "#nkr_note_orig_0173001", "type": "orig", "text": "參照八集第七十一經（漢譯南傳大藏經第二十三卷二三〇頁）。"}
{"id": null, "n": "0177001", "target": "#nkr_note_orig_0177001", "type": "orig", "text": "參照增支部經典八集第七十二經（漢譯南傳大藏經第二十三卷二三〇頁）。"}
{"id": null, "n": "0185001", "target": "#nkr_note_orig_0185001", "type": "orig", "text": "參照五集第一三五經（漢譯南傳大藏經第二十一卷一五四頁）。"}
{"id": null, "n": "0188001", "target": "#nkr_note_orig_0188001", "type": "orig", "text": "九集六十七經。"}
{"id": null, "n": "0188002", "target": "#nkr_note_orig_0188002", "type": "orig", "text": "九集七十經。"}
{"id": null, "n": "0189001", "target": "#nkr_note_orig_0189001", "type": "orig", "text": "五集二百五～二百六經（漢譯南傳大藏經第二十一卷二四一頁）九集七十一～七十二經（本卷所收）。"}
{"id": null, "n": "0189001", "target": "#nkr_note_mod_0189001", "type": "mod", "text": "五集二百五【南傳】，～二百六經（漢譯南傳大藏經第二十一卷二四一頁）九集七十一～七十二經（本卷所收）。"}
{"id": null, "n": "0197001", "target": "#nkr_note_orig_0197001", "type": "orig", "text": "參照七集第十四經（漢譯南傳大藏經第二十二卷一七三頁）、九集第十經（本卷所收）等。"}
{"id": null, "n": "0198001", "target": "#nkr_note_orig_0198001", "type": "orig", "text": "參照本經及次經、漢譯中阿含（大正藏一．五七七b）。"}
{"id": null, "n": "0205001", "target": "#nkr_note_orig_0205001", "type": "orig", "text": "本經及次經漢譯增一阿含（大正藏二．七七五c）。"}
{"id": null, "n": "0210001", "target": "#nkr_note_orig_0210001", "type": "orig", "text": "參照無礙解道原典第二卷一七四頁（漢譯南傳大藏經第四十四卷俱存品集九九論）。六集第六十四經（漢譯南傳大藏經第二十二卷一二七頁）。漢譯增一阿含（大正藏二．七七六b）、雜阿含（大正藏二．一八九a）。"}
{"id": null, "n": "0218001", "target": "#nkr_note_orig_0218001", "type": "orig", "text": "「侍者」。疑原語 upavāsa 有此意義。暫依原註謂：「依止、近住者」而譯之。"}
{"id": null, "n": "0220001", "target": "#nkr_note_orig_0220001", "type": "orig", "text": "漢譯中阿含九十（大正藏一．五七二c）。"}
{"id": null, "n": "0223001", "target": "#nkr_note_orig_0223001", "type": "orig", "text": "集異門足論卷二十（大正藏二六．四四七a）、荻原博士梵漢對譯佛教辭典七二．一-一二。"}
{"id": null, "n": "0225001", "target": "#nkr_note_orig_0225001", "type": "orig", "text": "漢譯雜阿含二〇．一三（大正藏二．一四三a）。"}
{"id": null, "n": "0225002", "target": "#nkr_note_orig_0225002", "type": "orig", "text": "出相應部原典第一卷一二六頁（漢譯南傳大藏經第十二卷二一〇頁）（以下省略）。"}
{"id": null, "n": "0226003", "target": "#nkr_note_orig_0226003", "type": "orig", "text": "「本」。異本作嘗味（assādaṁ）為非，於原註「本」釋集苦滅道四諦：「過患」、「出離」、「道、非道智」。"}
{"id": null, "n": "0227001", "target": "#nkr_note_orig_0227001", "type": "orig", "text": "漢譯增一阿含四六．八（大正藏二．七七八b）。"}
{"id": null, "n": "0232002", "target": "#nkr_note_orig_0232002", "type": "orig", "text": "七集四一經（漢譯南傳大藏經第二十二卷二三九頁）。"}
{"id": null, "n": "0233003", "target": "#nkr_note_orig_0233003", "type": "orig", "text": "八集五～六經（漢譯南傳大藏經第二十三卷九頁）。"}
{"id": null, "n": "0233003", "target": "#nkr_note_mod_0233003", "type": "mod", "text": "八集五【南傳】，～六經（漢譯南傳大藏經第二十三卷九頁）。"}
{"id": null, "n": "0233004", "target": "#nkr_note_orig_0233004", "type": "orig", "text": "九集二四經（本書所收）。"}
{"id": null, "n": "0234005", "target": "#nkr_note_orig_0234005", "type": "orig", "text": "十集一七六經（次卷所收）。"}
{"id": null, "n": "0238001", "target": "#nkr_note_orig_0238001", "type": "orig", "text": "六集一三經（漢譯南傳大藏經第二十二卷一七頁）。"}
{"id": null, "n": "0240002", "target": "#nkr_note_orig_0240002", "type": "orig", "text": "十集一七六經。"}
{"id": null, "n": "0241001", "target": "#nkr_note_orig_0241001", "type": "orig", "text": "漢譯中阿含二一五（大正藏一．七九九b）。"}
{"id": null, "n": "0242002", "target": "#nkr_note_orig_0242002", "type": "orig", "text": "長部經典原典第一卷一七頁。O. Franke, Dighanikāya. S. 25 Anm. 5。"}
{"id": null, "n": "0242003", "target": "#nkr_note_orig_0242003", "type": "orig", "text": "十集二五經（本卷所收）。"}
{"id": null, "n": "0243004", "target": "#nkr_note_orig_0243004", "type": "orig", "text": "八集六五經（漢譯南傳大藏經第二十三卷二一二頁）。"}
{"id": null, "n": "0246005", "target": "#nkr_note_orig_0246005", "type": "orig", "text": "「無我」云云。出相應部（漢譯南傳大藏經第十四卷二七七頁其他）。於原註言：「若我過去無者，則無現。現此我體；若我未來無，則無少分之障礙。」"}
{"id": null, "n": "0246006", "target": "#nkr_note_orig_0246006", "type": "orig", "text": "沙門、婆羅門以下於原本「……乃至……」依暹羅本即無任何之省略。"}
{"id": null, "n": "0253001", "target": "#nkr_note_orig_0253001", "type": "orig", "text": "參照第二～三節、二集十七品（漢譯南傳大藏經第十七卷一四六頁）、漢譯增一阿含四六．一（大正藏二．七七五c）。"}
{"id": null, "n": "0253001", "target": "#nkr_note_mod_0253001", "type": "mod", "text": "參照第二【南傳】，～三節、二集十七品（漢譯南傳大藏經第十七卷一四六頁）、漢譯增一阿含四六．一（大正藏二．七七五c）。"}
{"id": null, "n": "0253002", "target": "#nkr_note_orig_0253002", "type": "orig", "text": "「如來」。底本 tathāgatassa 是 tathāgatena 之誤。"}
{"id": null, "n": "0254003", "target": "#nkr_note_orig_0254003", "type": "orig", "text": "參照第四～五節律藏原典第二卷二四三頁（南傳大藏經第四卷三二六頁）。"}
{"id": null, "n": "0254003", "target": "#nkr_note_mod_0254003", "type": "mod", "text": "參照第四【南傳】，～五節律藏原典第二卷二四三頁（南傳大藏經第四卷三二六頁）。"}
{"id": null, "n": "0254001", "target": "#nkr_note_orig_0254001", "type": "orig", "text": "律藏原典第二卷九五頁（漢譯南傳大藏經第四卷一三〇頁）。"}
{"id": null, "n": "0255001", "target": "#nkr_note_orig_0255001", "type": "orig", "text": "參照律藏原典第一卷六四頁（南傳大藏經第三卷八四頁）第五卷一八一頁（南傳大藏經第五卷二八四頁）。"}
{"id": null, "n": "0256001", "target": "#nkr_note_orig_0256001", "type": "orig", "text": "參照前經。"}
{"id": null, "n": "0257001", "target": "#nkr_note_orig_0257001", "type": "orig", "text": "律藏原典第二卷二〇四頁（漢譯南傳大藏經第四卷二七八頁）。"}
{"id": null, "n": "0258001", "target": "#nkr_note_orig_0258001", "type": "orig", "text": "律藏原典第二卷二〇四頁（漢譯南傳大藏經第四卷二七九頁）。"}
{"id": null, "n": "0260001", "target": "#nkr_note_orig_0260001", "type": "orig", "text": "參照律藏原典第二卷二〇頁（漢譯南傳大藏經第四卷二七九頁）。"}
{"id": null, "n": "0261001", "target": "#nkr_note_orig_0261001", "type": "orig", "text": "律藏原典第二卷二〇五頁（漢譯南傳大藏經第四卷二七九頁）。"}
{"id": null, "n": "0264001", "target": "#nkr_note_orig_0264001", "type": "orig", "text": "參照一集十二品（漢譯南傳大藏經第十七卷一一六頁）律藏原典第二卷二四八頁（漢譯南傳大藏經第四卷三二八頁）。"}
{"id": null, "n": "0265001", "target": "#nkr_note_orig_0265001", "type": "orig", "text": "參照律藏原典第二卷二四八頁（漢譯南傳大藏經第四卷三三一頁）第五卷一九〇頁（漢譯南傳大藏經第五卷二九八頁）。"}
{"id": null, "n": "0268001", "target": "#nkr_note_orig_0268001", "type": "orig", "text": "參照律藏原典第四卷一五九頁（漢譯南傳大藏經第二卷二一五頁）。漢譯增一阿含四六．六（大正藏二．七七七a）。"}
{"id": null, "n": "0269002", "target": "#nkr_note_orig_0269002", "type": "orig", "text": "「象之馳驅」等底本 sammada 是 sammadda 之誤。"}
{"id": null, "n": "0270001", "target": "#nkr_note_orig_0270001", "type": "orig", "text": "漢譯雜阿含四一二（大正藏二．二九七b）。"}
{"id": null, "n": "0270002", "target": "#nkr_note_orig_0270002", "type": "orig", "text": "「八分成就之布薩」。出三集七十經（漢譯南傳大藏經第十七卷二九一頁）其他。"}
{"id": null, "n": "0271003", "target": "#nkr_note_orig_0271003", "type": "orig", "text": "「活百歲」vassastajivi 之前的 vassatāyuko 由暹羅本除去。若存在者，應讀為 vassasatāyuko。"}
{"id": null, "n": "0275001", "target": "#nkr_note_orig_0275001", "type": "orig", "text": "「棄彩色」（vevaṇṇiya）原註舉對身斷鬚髮，對資具、衣、食、住、藥等之出家前後不同。"}
{"id": null, "n": "0276002", "target": "#nkr_note_orig_0276002", "type": "orig", "text": "底本 kacci no 是 kacci nu 之誤。"}
{"id": null, "n": "0281001", "target": "#nkr_note_orig_0281001", "type": "orig", "text": "漢譯中阿含一一〇（大正藏一．五九八c）。"}
{"id": null, "n": "0282002", "target": "#nkr_note_orig_0282002", "type": "orig", "text": "「多饒益」。於原本及暹羅皆為 bhikkuno paccavekkhanā bahukārā hoti kusalesudhammesu 皆甚難解，今北傳漢譯：「比丘者若有比觀必多所饒益。」故由此改為 bahukārā 為 bahūpakārā。以下五十五經皆同此。"}
{"id": null, "n": "0285001", "target": "#nkr_note_orig_0285001", "type": "orig", "text": "漢譯中阿含九五（大正藏一．五七七b）。"}
{"id": null, "n": "0286002", "target": "#nkr_note_orig_0286002", "type": "orig", "text": "「他心」，底本 paricitta 是 paracitta 之誤。下文也是一樣。"}
{"id": null, "n": "0288001", "target": "#nkr_note_orig_0288001", "type": "orig", "text": "漢譯中阿含一〇九（大正藏一．五七八b）。"}
{"id": null, "n": "0293001", "target": "#nkr_note_orig_0293001", "type": "orig", "text": "漢譯中阿含九六（大正藏一．五七七c）。"}
{"id": null, "n": "0296001", "target": "#nkr_note_orig_0296001", "type": "orig", "text": "本經及次經、漢譯增一阿含四六．九（大正藏二．七八〇a）。"}
{"id": null, "n": "0297001", "target": "#nkr_note_orig_0297001", "type": "orig", "text": "參照八集八十三經（漢譯南傳大藏經第二十三卷二六一頁）、九集十四經（本卷所收）。"}
{"id": null, "n": "0299001", "target": "#nkr_note_orig_0299001", "type": "orig", "text": "「是故」，在文脈上應有前文。在註釋「是故」是不如是心積習者，不具足沙門之義故而言「是故」。"}
{"id": null, "n": "0299002", "target": "#nkr_note_orig_0299002", "type": "orig", "text": "「世間之平等、不平等」。原註解釋為「有情世間之善行、惡行」。"}
{"id": null, "n": "0299003", "target": "#nkr_note_orig_0299003", "type": "orig", "text": "「其想」。原本足暹羅本俱有 taṁ-saññā。當改為 taṁ saññā。"}
{"id": null, "n": "0302001", "target": "#nkr_note_orig_0302001", "type": "orig", "text": "通例「尿」之下，加「頭中之腦髓」為三十二身分，現在之個處任何版本皆缺此第三十二。"}
{"id": null, "n": "0302002", "target": "#nkr_note_orig_0302002", "type": "orig", "text": "「爬傷」（rakhasā）巴利聖典無此語，註釋：「有以瓜爬之病病但處」。"}
{"id": null, "n": "0302003", "target": "#nkr_note_orig_0302003", "type": "orig", "text": "「麻痺」（aṁsā）此語不明。暫依德語 Nyāṇatiloka，亦不明其根據。"}
{"id": null, "n": "0304004", "target": "#nkr_note_orig_0304004", "type": "orig", "text": "「出入息念」。以下文及其釋義「出無礙解道」原典第一卷一七五頁（南傳大藏經第四十卷二八五頁）。"}
{"id": null, "n": "0042a0501", "target": "#nkr_note_add_0042a0501", "type": "add", "text": "竟【CB】，意【南傳】"}
{"id": null, "n": "0103a0401", "target": "#nkr_note_add_0103a0401", "type": "add", "text": "知【CB】，智【南傳】"}
{"id": null, "n": "0111a1301", "target": "#nkr_note_add_0111a1301", "type": "add", "text": "旬【CB】，甸【南傳】"}
{"id": null, "n": "0207a1301", "target": "#nkr_note_add_0207a1301", "type": "add", "text": "祛【CB】，袪【南傳】"}
