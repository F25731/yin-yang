{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "更起三拜"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "次第答能。"}
{"id": null, "n": null, "target": null, "type": null, "text": "便散席"}
{"id": null, "n": null, "target": null, "type": null, "text": "恐性地已上，方能此制也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：能。三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "便散席"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "凡十問"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "答能。三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "便散席"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "答能"}
{"id": null, "n": null, "target": null, "type": null, "text": "有十五問"}
{"id": null, "n": null, "target": null, "type": null, "text": "以此三歸發戒"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦以羯磨發戒"}
{"id": null, "n": null, "target": null, "type": null, "text": "古作陳，今以車始，晉王逸少也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "與寤同，古文通用。"}
{"id": null, "n": null, "target": null, "type": null, "text": "許誑切，矧也。作兩點，非也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "陟交切，與謿同，言相調也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "昌戀切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "旃，諸延切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "古杏切，鳩屬。"}
{"id": null, "n": null, "target": null, "type": null, "text": "神與\n切，與杼同，挹也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "長音場。"}
{"id": null, "n": null, "target": null, "type": null, "text": "宅加切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "逆角切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "盧拙切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "力涉切，田\n獵也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "傳，除緣切，字以專，不作甫。"}
{"id": null, "n": null, "target": null, "type": null, "text": "沮子余渠求於。沮渠，姓也。又匈奴宮名。"}
{"id": null, "n": null, "target": null, "type": null, "text": "方六切，重也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "梵語也，此云大自在。醯，許兮切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "楚懈切，與瘥同，病除也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "牛代切，與礙同。"}
{"id": null, "n": null, "target": null, "type": null, "text": "迷浮切，與矛同。"}
{"id": null, "n": null, "target": null, "type": null, "text": "七迹切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "蘇貫切，與蒜同。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音格，作革非也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上津夷切，\n訪問也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "古泫切，繫也，與羂同。"}
{"id": null, "n": null, "target": null, "type": null, "text": "方願切，販賣也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "夷益切，貿易也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "之亷切，占視也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上音空，下音侯，樂器也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上抽居切，博器也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上音賽。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上普陌切，下渠竹切，毬子也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "直炙切，投也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "升脂切，蒿屬。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上音獨，下音婁，\n首骨。"}
{"id": null, "n": null, "target": null, "type": null, "text": "下時世切，龜為卜，箸為筮。"}
{"id": null, "n": null, "target": null, "type": null, "text": "仕衫切，針刺。"}
{"id": null, "n": null, "target": null, "type": null, "text": "許救切，俗作嗅。"}
{"id": null, "n": null, "target": null, "type": null, "text": "除醉切，取\n火木也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "尼輒切，箝也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "雖遂切，深也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上救九切，下下戒切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "蘇果切，與\n鎻同。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上尺類切，出之也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "七逆中殺，並式吏切，下殺上也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上百各切，削也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "先的切，與析同。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音白"}
{"id": null, "n": null, "target": null, "type": null, "text": "其亮切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "補靡切，陋也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "升人切，孕也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "誣也，欺也，以是為非。"}
{"id": null, "n": null, "target": null, "type": null, "text": "古賣切，猶\n豫也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音坐。"}
{"id": null, "n": null, "target": null, "type": null, "text": "靡幼切，猶錯亂誤也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "五倒切，不敬也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "徒亶切，欺也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "伊甸切，吞\n也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "如銑切，小蚊也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上許云切，辛臭也。下尺救切，與臰同。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音械。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上音\n胡，下音雖，與荽同。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上私力切，下音疾。"}
{"id": null, "n": null, "target": null, "type": null, "text": "忍止切，所食物曰餌。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音增，魚網有機\n者。"}
{"id": null, "n": null, "target": null, "type": null, "text": "告丁切，纏也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "香衣切，與悕同。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音僅，固也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "居候切，猶結搆也，合集也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "渠尤切，讎也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上稱人切，怒而張目也；下音頂。"}
{"id": null, "n": null, "target": null, "type": null, "text": "初覲切，施也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "下神六切，\n貿也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音列，火猛也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上年題切，水和也；下將先切，香木名。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音焰，美也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "與礙\n同。"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T40n1811_p0576c24"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T40n1811_p0578b01"}
