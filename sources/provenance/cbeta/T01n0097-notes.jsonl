{"id": null, "n": null, "target": null, "type": null, "text": "出中阿含經一品"}
{"id": null, "n": "0919011", "target": "#nkr_note_mod_0919011", "type": "mod", "text": "廣【大】，佛說廣【宋】【元】【明】"}
{"id": null, "n": "0919012", "target": "#nkr_note_mod_0919012", "type": "mod", "text": "一卷【大】＊，〔－〕【宋】【元】【明】＊"}
{"id": null, "n": "0919013", "target": "#nkr_note_mod_0919013", "type": "mod", "text": "出【大】，此經出【明】"}
{"id": null, "n": "0919014", "target": "#nkr_note_mod_0919014", "type": "mod", "text": "天竺三藏【大】，三藏法師【宋】【元】【明】"}
{"id": null, "n": "0919015", "target": "#nkr_note_mod_0919015", "type": "mod", "text": "門【大】，如【宋】"}
{"id": null, "n": "0919016", "target": "#nkr_note_mod_0919016", "type": "mod", "text": "一心【大】，注心【宋】"}
{"id": null, "n": "0920001", "target": "#nkr_note_mod_0920001", "type": "mod", "text": "察【大】，察一不淨想者【宋】【元】【明】"}
{"id": null, "n": "0920002", "target": "#nkr_note_mod_0920002", "type": "mod", "text": "大【大】，太【宋】【元】【明】"}
{"id": null, "n": "0920003", "target": "#nkr_note_mod_0920003", "type": "mod", "text": "相【大】，想【元】【明】"}
{"id": null, "n": "0920004", "target": "#nkr_note_mod_0920004", "type": "mod", "text": "聞【大】＊，問【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0920005", "target": "#nkr_note_mod_0920005", "type": "mod", "text": "得【大】，得非【宋】【元】【明】"}
{"id": null, "n": "0920007", "target": "#nkr_note_mod_0920007", "type": "mod", "text": "土【大】＊，士【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0921001", "target": "#nkr_note_mod_0921001", "type": "mod", "text": "然【大】，律【宋】【元】【明】"}
{"id": null, "n": "0921002", "target": "#nkr_note_mod_0921002", "type": "mod", "text": "相【大】，想【宋】【元】【明】"}
{"id": null, "n": "0921003", "target": "#nkr_note_mod_0921003", "type": "mod", "text": "如【大】，老【元】【明】"}
{"id": null, "n": "0921004", "target": "#nkr_note_mod_0921004", "type": "mod", "text": "今【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0921005", "target": "#nkr_note_mod_0921005", "type": "mod", "text": "不【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0921006", "target": "#nkr_note_mod_0921006", "type": "mod", "text": "恒喜【大】＊，恒戲【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0922001", "target": "#nkr_note_mod_0922001", "type": "mod", "text": "二心猗【大】，三心猗【宋】【元】【明】"}
{"id": null, "n": "0922002", "target": "#nkr_note_mod_0922002", "type": "mod", "text": "永【大】，永斷【宋】【元】【明】"}
{"id": null, "n": "0922003", "target": "#nkr_note_mod_0922003", "type": "mod", "text": "廣【大】，佛說廣【明】"}
{"id": null, "n": "0919011", "target": "#nkr_note_orig_0919011", "type": "orig", "text": "（佛說）＋廣【三】"}
{"id": null, "n": "0919012", "target": "#nkr_note_orig_0919012", "type": "orig", "text": "〔一卷〕－【三】"}
{"id": null, "n": "0919013", "target": "#nkr_note_orig_0919013", "type": "orig", "text": "（此經）＋出【明】"}
{"id": null, "n": "0919014", "target": "#nkr_note_orig_0919014", "type": "orig", "text": "天竺三藏＝三藏法師【三】"}
{"id": null, "n": "0919015", "target": "#nkr_note_orig_0919015", "type": "orig", "text": "門＝如【宋】"}
{"id": null, "n": "0919016", "target": "#nkr_note_orig_0919016", "type": "orig", "text": "一心＝注心【宋】"}
{"id": null, "n": "0920001", "target": "#nkr_note_orig_0920001", "type": "orig", "text": "察＋（一不淨想者）五字【三】"}
{"id": null, "n": "0920002", "target": "#nkr_note_orig_0920002", "type": "orig", "text": "大＝太【三】"}
{"id": null, "n": "0920003", "target": "#nkr_note_orig_0920003", "type": "orig", "text": "相＝想【元】【明】"}
{"id": null, "n": "0920004", "target": "#nkr_note_orig_0920004", "type": "orig", "text": "聞＝問【三】＊"}
{"id": null, "n": "0920005", "target": "#nkr_note_orig_0920005", "type": "orig", "text": "得＋（非）【三】"}
{"id": null, "n": "0920006", "target": "#nkr_note_orig_0920006", "type": "orig", "text": "隨上麗本字闕"}
{"id": null, "n": "0920007", "target": "#nkr_note_orig_0920007", "type": "orig", "text": "土＝士【三】＊"}
{"id": null, "n": "0921001", "target": "#nkr_note_orig_0921001", "type": "orig", "text": "然＝律【三】"}
{"id": null, "n": "0921002", "target": "#nkr_note_orig_0921002", "type": "orig", "text": "相＝想【三】"}
{"id": null, "n": "0921003", "target": "#nkr_note_orig_0921003", "type": "orig", "text": "如＝老【元】【明】"}
{"id": null, "n": "0921004", "target": "#nkr_note_orig_0921004", "type": "orig", "text": "〔今〕－【三】"}
{"id": null, "n": "0921005", "target": "#nkr_note_orig_0921005", "type": "orig", "text": "〔不〕－【三】"}
{"id": null, "n": "0921006", "target": "#nkr_note_orig_0921006", "type": "orig", "text": "恒喜＝恒戲【三】＊"}
{"id": null, "n": "0922001", "target": "#nkr_note_orig_0922001", "type": "orig", "text": "二心猗＝三心猗【三】"}
{"id": null, "n": "0922002", "target": "#nkr_note_orig_0922002", "type": "orig", "text": "永＋（斷）【三】"}
{"id": null, "n": "0922003", "target": "#nkr_note_orig_0922003", "type": "orig", "text": "（佛說）＋廣【明】"}
{"id": null, "n": "0922004", "target": "#nkr_note_orig_0922004", "type": "orig", "text": "此經…為譯三十七字在於末題前行【宋】【元】"}
