{"id": null, "n": "0867006", "target": "#nkr_note_mod_0867006", "type": "mod", "text": "出無相論【大】，〔－〕【明】"}
{"id": null, "n": "0867007", "target": "#nkr_note_mod_0867007", "type": "mod", "text": "（真諦…譯）十二字【大】，陳世三藏真諦於廣州制旨寺譯【宋】【元】【宮】，陳三藏真諦譯【明】"}
{"id": null, "n": "0867008", "target": "#nkr_note_mod_0867008", "type": "mod", "text": "一【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0867009", "target": "#nkr_note_mod_0867009", "type": "mod", "text": "內【大】，外【明】"}
{"id": null, "n": "0867010", "target": "#nkr_note_mod_0867010", "type": "mod", "text": "法【大】，如法如【宋】【元】【明】【宮】"}
{"id": null, "n": "0867011", "target": "#nkr_note_mod_0867011", "type": "mod", "text": "生【大】，生性【宋】【元】【明】【宮】"}
{"id": null, "n": "0867012", "target": "#nkr_note_mod_0867012", "type": "mod", "text": "別【大】，別性【宋】【元】【明】【宮】"}
{"id": null, "n": "0868001", "target": "#nkr_note_mod_0868001", "type": "mod", "text": "此【大】，如此【宋】【元】【明】【宮】"}
{"id": null, "n": "0868002", "target": "#nkr_note_mod_0868002", "type": "mod", "text": "知【大】，如【宋】【元】【明】【宮】"}
{"id": null, "n": "0868003", "target": "#nkr_note_mod_0868003", "type": "mod", "text": "照【大】，燈照【宋】【元】【明】【宮】"}
{"id": null, "n": "0868004", "target": "#nkr_note_mod_0868004", "type": "mod", "text": "熏習【大】，熏習心【宋】【元】【明】【宮】"}
{"id": null, "n": "0868005", "target": "#nkr_note_mod_0868005", "type": "mod", "text": "他【大】，他性【宋】【元】【明】【宮】"}
{"id": null, "n": "0868006", "target": "#nkr_note_mod_0868006", "type": "mod", "text": "隨【大】，墮【宋】【元】【明】【宮】"}
{"id": null, "n": "0868007", "target": "#nkr_note_mod_0868007", "type": "mod", "text": "憎【大】，增【宋】【元】【明】【宮】"}
{"id": null, "n": "0868008", "target": "#nkr_note_mod_0868008", "type": "mod", "text": "名【大】，名字【宋】【元】【明】【宮】"}
{"id": null, "n": "0869001", "target": "#nkr_note_mod_0869001", "type": "mod", "text": "為【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0869002", "target": "#nkr_note_mod_0869002", "type": "mod", "text": "覓【大】＊，覺【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0869003", "target": "#nkr_note_mod_0869003", "type": "mod", "text": "一【大】，二【明】"}
{"id": null, "n": "0869004", "target": "#nkr_note_mod_0869004", "type": "mod", "text": "故【大】，致【宋】【元】【明】【宮】"}
{"id": null, "n": "0869005", "target": "#nkr_note_mod_0869005", "type": "mod", "text": "已【大】，也【宋】【元】【明】【宮】"}
{"id": null, "n": "0869006", "target": "#nkr_note_mod_0869006", "type": "mod", "text": "串【大】下同，慣【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0869007", "target": "#nkr_note_mod_0869007", "type": "mod", "text": "梨【大】，黎【宋】【元】【明】【宮】"}
{"id": null, "n": "0869008", "target": "#nkr_note_mod_0869008", "type": "mod", "text": "現【大】，現在【宋】【元】【明】【宮】"}
{"id": null, "n": "0869009", "target": "#nkr_note_mod_0869009", "type": "mod", "text": "說【大】，記【宋】【元】【明】【宮】"}
{"id": null, "n": "0869010", "target": "#nkr_note_mod_0869010", "type": "mod", "text": "止【大】，上【元】【明】"}
{"id": null, "n": "0869011", "target": "#nkr_note_mod_0869011", "type": "mod", "text": "方【大】，六【宋】【元】【明】【宮】"}
{"id": null, "n": "0869012", "target": "#nkr_note_mod_0869012", "type": "mod", "text": "六【大】，名六【元】"}
{"id": null, "n": "0869013", "target": "#nkr_note_mod_0869013", "type": "mod", "text": "憎【大】＊，增【宋】【宮】＊"}
{"id": null, "n": "0870001", "target": "#nkr_note_mod_0870001", "type": "mod", "text": "釋【大】，一釋【宮】"}
{"id": null, "n": "0870002", "target": "#nkr_note_mod_0870002", "type": "mod", "text": "云【大】，云何【宋】【元】【明】【宮】"}
{"id": null, "n": "0870003", "target": "#nkr_note_mod_0870003", "type": "mod", "text": "明【大】，名【明】"}
{"id": null, "n": "0870004", "target": "#nkr_note_mod_0870004", "type": "mod", "text": "本【大】，本事【宋】【元】【明】【宮】"}
{"id": null, "n": "0870005", "target": "#nkr_note_mod_0870005", "type": "mod", "text": "慢【大】，慢本【宋】【元】【明】【宮】"}
{"id": null, "n": "0870006", "target": "#nkr_note_mod_0870006", "type": "mod", "text": "兩【大】＊，二【元】【明】＊"}
{"id": null, "n": "0870007", "target": "#nkr_note_mod_0870007", "type": "mod", "text": "境【大】，境界【宋】【元】【明】【宮】"}
{"id": null, "n": "0870008", "target": "#nkr_note_mod_0870008", "type": "mod", "text": "差【大】，分【宋】【元】【明】【宮】"}
{"id": null, "n": "0870009", "target": "#nkr_note_mod_0870009", "type": "mod", "text": "依【大】，〔－〕【明】"}
{"id": null, "n": "0870010", "target": "#nkr_note_mod_0870010", "type": "mod", "text": "云【大】，亦【宋】，言【元】【明】"}
{"id": null, "n": "0871001", "target": "#nkr_note_mod_0871001", "type": "mod", "text": "也【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0871002", "target": "#nkr_note_mod_0871002", "type": "mod", "text": "生【大】，生性【宋】【元】【明】【宮】"}
{"id": null, "n": "0871003", "target": "#nkr_note_mod_0871003", "type": "mod", "text": "無因無體【大】，無自無他體【宋】【元】【明】【宮】"}
{"id": null, "n": "0871004", "target": "#nkr_note_mod_0871004", "type": "mod", "text": "三【大】，二【宋】【元】"}
{"id": null, "n": "0871005", "target": "#nkr_note_mod_0871005", "type": "mod", "text": "問【大】，問曰【宋】【元】【明】【宮】"}
{"id": null, "n": "0871006", "target": "#nkr_note_mod_0871006", "type": "mod", "text": "二【大】，一【元】"}
{"id": null, "n": "0871007", "target": "#nkr_note_mod_0871007", "type": "mod", "text": "二【CB】【麗-CB】【宋】【元】【明】【宮】，一【大】"}
{"id": null, "n": "0871008", "target": "#nkr_note_mod_0871008", "type": "mod", "text": "更無【大】，無更【宋】【元】【明】【宮】"}
{"id": null, "n": "0871009", "target": "#nkr_note_mod_0871009", "type": "mod", "text": "討【大】，計【宋】【元】【明】【宮】"}
{"id": null, "n": "0872001", "target": "#nkr_note_mod_0872001", "type": "mod", "text": "無倒故【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0872002", "target": "#nkr_note_mod_0872002", "type": "mod", "text": "決【大】，定【宋】【元】【明】【宮】"}
{"id": null, "n": "0872003", "target": "#nkr_note_mod_0872003", "type": "mod", "text": "為【大】，為體【宋】【元】【明】【宮】"}
{"id": null, "n": "0872004", "target": "#nkr_note_mod_0872004", "type": "mod", "text": "決【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0872005", "target": "#nkr_note_mod_0872005", "type": "mod", "text": "惑【大】＊，或【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0872006", "target": "#nkr_note_mod_0872006", "type": "mod", "text": "集【大】＊，執【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0872007", "target": "#nkr_note_mod_0872007", "type": "mod", "text": "如【大】，〔－〕【宮】"}
{"id": null, "n": "0872008", "target": "#nkr_note_mod_0872008", "type": "mod", "text": "淨【大】，淨本來清淨【宋】【元】【明】【宮】"}
{"id": null, "n": "0872009", "target": "#nkr_note_mod_0872009", "type": "mod", "text": "名正【大】，正名【明】"}
{"id": null, "n": "0872010", "target": "#nkr_note_mod_0872010", "type": "mod", "text": "三無【大】，無三【宋】【元】【明】【宮】"}
{"id": null, "n": "0872011", "target": "#nkr_note_mod_0872011", "type": "mod", "text": "同【大】，何【元】【明】"}
{"id": null, "n": "0873001", "target": "#nkr_note_mod_0873001", "type": "mod", "text": "二【大】，一【宋】【元】【明】"}
{"id": null, "n": "0873002", "target": "#nkr_note_mod_0873002", "type": "mod", "text": "惑【大】，感【宋】"}
{"id": null, "n": "0873003", "target": "#nkr_note_mod_0873003", "type": "mod", "text": "出無相論【大】，〔－〕【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0873004", "target": "#nkr_note_mod_0873004", "type": "mod", "text": "真諦三藏於廣州制旨寺翻譯【大】，陳世三藏真諦於廣州制旨寺譯【宋】【元】【宮】，陳三藏真諦譯【明】，〔－〕【聖】"}
{"id": null, "n": "0873005", "target": "#nkr_note_mod_0873005", "type": "mod", "text": "七【大】，七種【宋】【元】【明】"}
{"id": null, "n": "0873006", "target": "#nkr_note_mod_0873006", "type": "mod", "text": "智【大】，〔－〕【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0873007", "target": "#nkr_note_mod_0873007", "type": "mod", "text": "或【大】，惑【宋】【元】【明】【宮】"}
{"id": null, "n": "0873008", "target": "#nkr_note_mod_0873008", "type": "mod", "text": "他【大】，也【宮】"}
{"id": null, "n": "0873009", "target": "#nkr_note_mod_0873009", "type": "mod", "text": "兩【大】＊，二【元】【明】＊"}
{"id": null, "n": "0873010", "target": "#nkr_note_mod_0873010", "type": "mod", "text": "說【大】，脫【宮】"}
{"id": null, "n": "0873011", "target": "#nkr_note_mod_0873011", "type": "mod", "text": "兩【大】，而【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0873012", "target": "#nkr_note_mod_0873012", "type": "mod", "text": "真【大】，具【聖】"}
{"id": null, "n": "0873013", "target": "#nkr_note_mod_0873013", "type": "mod", "text": "相【大】，相二相【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0873014", "target": "#nkr_note_mod_0873014", "type": "mod", "text": "作【大】，衣【宋】【元】【明】【宮】"}
{"id": null, "n": "0873015", "target": "#nkr_note_mod_0873015", "type": "mod", "text": "真【大】，真實【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0874001", "target": "#nkr_note_mod_0874001", "type": "mod", "text": "入【大】，但入【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0874002", "target": "#nkr_note_mod_0874002", "type": "mod", "text": "上【大】，一【元】，立【明】"}
{"id": null, "n": "0874003", "target": "#nkr_note_mod_0874003", "type": "mod", "text": "以【大】，已【宋】【元】【明】【宮】"}
{"id": null, "n": "0874004", "target": "#nkr_note_mod_0874004", "type": "mod", "text": "名【大】，〔－〕【宮】"}
{"id": null, "n": "0874005", "target": "#nkr_note_mod_0874005", "type": "mod", "text": "中【大】，中已【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0874006", "target": "#nkr_note_mod_0874006", "type": "mod", "text": "故於諸陰【大】，〔－〕【宮】"}
{"id": null, "n": "0874007", "target": "#nkr_note_mod_0874007", "type": "mod", "text": "我及【大】，〔－〕【宮】"}
{"id": null, "n": "0874008", "target": "#nkr_note_mod_0874008", "type": "mod", "text": "已【大】，〔－〕【聖】"}
{"id": null, "n": "0874009", "target": "#nkr_note_mod_0874009", "type": "mod", "text": "辦【大】，辯【聖】"}
{"id": null, "n": "0874010", "target": "#nkr_note_mod_0874010", "type": "mod", "text": "住【大】，主【聖】"}
{"id": null, "n": "0874011", "target": "#nkr_note_mod_0874011", "type": "mod", "text": "想【大】，相【宋】【宮】【聖】"}
{"id": null, "n": "0875001", "target": "#nkr_note_mod_0875001", "type": "mod", "text": "智【CB】【麗-CB】【宋】【元】【明】【宮】【聖】＊，知【大】＊"}
{"id": null, "n": "0875002", "target": "#nkr_note_mod_0875002", "type": "mod", "text": "趣【大】，境【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0875003", "target": "#nkr_note_mod_0875003", "type": "mod", "text": "益【大】，益利【宋】【元】【明】【宮】"}
{"id": null, "n": "0875004", "target": "#nkr_note_mod_0875004", "type": "mod", "text": "憎【大】，增【聖】"}
{"id": null, "n": "0875005", "target": "#nkr_note_mod_0875005", "type": "mod", "text": "曰【大】，曰四尋思四如實智【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0875006", "target": "#nkr_note_mod_0875006", "type": "mod", "text": "謂【CB】【麗-CB】【宋】【元】【明】【宮】【聖】，諸【大】"}
{"id": null, "n": "0875007", "target": "#nkr_note_mod_0875007", "type": "mod", "text": "兎【大】，菟【聖】"}
{"id": null, "n": "0875008", "target": "#nkr_note_mod_0875008", "type": "mod", "text": "唯【CB】【麗-CB】【聖】，惟【大】"}
{"id": null, "n": "0875009", "target": "#nkr_note_mod_0875009", "type": "mod", "text": "性【大】，〔－〕【宋】【元】"}
{"id": null, "n": "0875010", "target": "#nkr_note_mod_0875010", "type": "mod", "text": "見【大】，見自性故言不見【宮】【聖】"}
{"id": null, "n": "0875011", "target": "#nkr_note_mod_0875011", "type": "mod", "text": "一【大】，〔－〕【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0875012", "target": "#nkr_note_mod_0875012", "type": "mod", "text": "唯【CB】【麗-CB】【宋】【元】【宮】【聖】，惟【大】"}
{"id": null, "n": "0875013", "target": "#nkr_note_mod_0875013", "type": "mod", "text": "無【大】，〔－〕【宮】【聖】"}
{"id": null, "n": "0875014", "target": "#nkr_note_mod_0875014", "type": "mod", "text": "俱【大】，但【宋】【元】【明】【宮】"}
{"id": null, "n": "0875015", "target": "#nkr_note_mod_0875015", "type": "mod", "text": "味【大】，咮【明】"}
{"id": null, "n": "0875016", "target": "#nkr_note_mod_0875016", "type": "mod", "text": "已【大】，也【明】"}
{"id": null, "n": "0875017", "target": "#nkr_note_mod_0875017", "type": "mod", "text": "各【大】，若【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0876001", "target": "#nkr_note_mod_0876001", "type": "mod", "text": "就【大】，〔－〕【宋】【元】【明】【宮】"}
