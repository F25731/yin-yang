{"id": null, "n": "0386001", "target": "#nkr_note_orig_0386001", "type": "orig", "text": "【原】大日本續藏經"}
{"id": null, "n": "0386002", "target": "#nkr_note_orig_0386002", "type": "orig", "text": "原本冠註曰那下文作邢"}
