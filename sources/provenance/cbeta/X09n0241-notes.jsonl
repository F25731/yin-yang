{"id": null, "n": "0304002", "target": "#nkr_note_orig_0304002", "type": "orig", "text": "十疑千"}
{"id": null, "n": "0305001", "target": "#nkr_note_orig_0305001", "type": "orig", "text": "顯等十八字疑衍文"}
{"id": null, "n": "0306001", "target": "#nkr_note_orig_0306001", "type": "orig", "text": "思字更勘"}
{"id": null, "n": "0307001", "target": "#nkr_note_orig_0307001", "type": "orig", "text": "佛字疑剩"}
{"id": null, "n": "0310001", "target": "#nkr_note_orig_0310001", "type": "orig", "text": "叢疑蕞"}
{"id": null, "n": "0311001", "target": "#nkr_note_orig_0311001", "type": "orig", "text": "區疑漚"}
{"id": null, "n": "0311002", "target": "#nkr_note_orig_0311002", "type": "orig", "text": "抑一作叩次同"}
{"id": null, "n": "0311003", "target": "#nkr_note_orig_0311003", "type": "orig", "text": "寶或實歟"}
{"id": null, "n": "0311004", "target": "#nkr_note_orig_0311004", "type": "orig", "text": "＊善疑善（善ハ本文ニ菩トツクル。󴦒）"}
