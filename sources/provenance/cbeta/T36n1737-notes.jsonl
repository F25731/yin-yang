{"id": null, "n": "0702002", "target": "#nkr_note_mod_0702002", "type": "mod", "text": "行門【CB】【考偽-原】，門行【大】"}
{"id": null, "n": "0703001", "target": "#nkr_note_mod_0703001", "type": "mod", "text": "品【大】，〔－〕【甲】"}
{"id": null, "n": "0703005", "target": "#nkr_note_mod_0703005", "type": "mod", "text": "袪【大】，衽【甲】"}
{"id": null, "n": "0703006", "target": "#nkr_note_mod_0703006", "type": "mod", "text": "劫【大】＊，却【甲】＊"}
{"id": null, "n": "0703007", "target": "#nkr_note_mod_0703007", "type": "mod", "text": "狹【大】，狡【甲】"}
{"id": null, "n": "0703008", "target": "#nkr_note_mod_0703008", "type": "mod", "text": "敘【大】，劒【甲】"}
{"id": null, "n": "0704004", "target": "#nkr_note_mod_0704004", "type": "mod", "text": "［－］【CB】，功德【大】，冠註曰功德經無"}
{"id": null, "n": "0704005", "target": "#nkr_note_mod_0704005", "type": "mod", "text": "界【大】，〔－〕【甲】"}
{"id": null, "n": "0704006", "target": "#nkr_note_mod_0704006", "type": "mod", "text": "等無【CB】，無差【大】，冠註曰經無差作等無"}
{"id": null, "n": "0704007", "target": "#nkr_note_mod_0704007", "type": "mod", "text": "極【CB】，悉【大】，冠註曰經悉作極"}
{"id": null, "n": "0704008", "target": "#nkr_note_mod_0704008", "type": "mod", "text": "士【大】，〔－〕【甲】"}
{"id": null, "n": "0705001", "target": "#nkr_note_mod_0705001", "type": "mod", "text": "反【大】，返【甲】"}
{"id": null, "n": "0705002", "target": "#nkr_note_mod_0705002", "type": "mod", "text": "倏【大】，𭛹【甲】"}
{"id": null, "n": "0705004", "target": "#nkr_note_mod_0705004", "type": "mod", "text": "位【大】，何【甲】"}
{"id": null, "n": "0705005", "target": "#nkr_note_mod_0705005", "type": "mod", "text": "止【大】，〔－〕【考偽-原】"}
{"id": null, "n": "0706001", "target": "#nkr_note_mod_0706001", "type": "mod", "text": "十【大】，下【甲】"}
{"id": null, "n": "0706002", "target": "#nkr_note_mod_0706002", "type": "mod", "text": "劫【大】，却【甲】"}
{"id": null, "n": "0707001", "target": "#nkr_note_mod_0707001", "type": "mod", "text": "目【大】，因【甲】"}
{"id": null, "n": "0707003", "target": "#nkr_note_mod_0707003", "type": "mod", "text": "狹【大】，狡【甲】"}
{"id": null, "n": "0707004", "target": "#nkr_note_mod_0707004", "type": "mod", "text": "顯俱【大】，俱顯【甲】"}
{"id": null, "n": "0707005", "target": "#nkr_note_mod_0707005", "type": "mod", "text": "豎【大】，竪【甲】"}
{"id": null, "n": "0707006", "target": "#nkr_note_mod_0707006", "type": "mod", "text": "一【大】，〔－〕【甲】"}
{"id": null, "n": "0707007", "target": "#nkr_note_mod_0707007", "type": "mod", "text": "域【大】，城【甲】"}
{"id": null, "n": "0708001", "target": "#nkr_note_mod_0708001", "type": "mod", "text": "耳【大】，耶【甲】"}
{"id": null, "n": "0708002", "target": "#nkr_note_mod_0708002", "type": "mod", "text": "亡【大】＊，忘【甲】＊"}
{"id": null, "n": "0708003", "target": "#nkr_note_mod_0708003", "type": "mod", "text": "通【大】，〔－〕【考偽-原】"}
{"id": null, "n": "0708004", "target": "#nkr_note_mod_0708004", "type": "mod", "text": "住無【CB】，無礙【大】，冠註曰無礙經作住無"}
{"id": null, "n": "0708005", "target": "#nkr_note_mod_0708005", "type": "mod", "text": "［－］【CB】，入【大】，冠註曰入字經無"}
{"id": null, "n": "0708006", "target": "#nkr_note_mod_0708006", "type": "mod", "text": "申【大】，伸【甲】"}
{"id": null, "n": "0708007", "target": "#nkr_note_mod_0708007", "type": "mod", "text": "道【CB】【考偽-原】，同【大】"}
{"id": null, "n": "0709001", "target": "#nkr_note_mod_0709001", "type": "mod", "text": "篙【大】＊，槁【甲】＊"}
{"id": null, "n": "0709002", "target": "#nkr_note_mod_0709002", "type": "mod", "text": "規【大】，觀【甲】"}
{"id": null, "n": "0709003", "target": "#nkr_note_mod_0709003", "type": "mod", "text": "帙【大】，秩【甲】"}
{"id": null, "n": "0709004", "target": "#nkr_note_mod_0709004", "type": "mod", "text": "阿【大】，〔－〕【甲】"}
{"id": null, "n": "0701001", "target": "#nkr_note_orig_0701001", "type": "orig", "text": "【原】大日本續藏經，【甲】慶安五年刊宗教大學藏本，但甲本再刊序無"}
{"id": null, "n": "0702001", "target": "#nkr_note_orig_0702001", "type": "orig", "text": "冠註曰性經作相"}
{"id": null, "n": "0702002", "target": "#nkr_note_orig_0702002", "type": "orig", "text": "門行＝行門ヵ【原】"}
{"id": null, "n": "0702003", "target": "#nkr_note_orig_0702003", "type": "orig", "text": "冠註曰剎塵指歸作別塵"}
{"id": null, "n": "0703001", "target": "#nkr_note_orig_0703001", "type": "orig", "text": "〔品〕－【甲】"}
{"id": null, "n": "0703002", "target": "#nkr_note_orig_0703002", "type": "orig", "text": "冠註曰調冠真宗玄談作條貫真詮"}
{"id": null, "n": "0703003", "target": "#nkr_note_orig_0703003", "type": "orig", "text": "冠註曰及於妙覺四字疏無"}
{"id": null, "n": "0703004", "target": "#nkr_note_orig_0703004", "type": "orig", "text": "冠註曰六疏作五"}
{"id": null, "n": "0703005", "target": "#nkr_note_orig_0703005", "type": "orig", "text": "袪＝衽【甲】"}
{"id": null, "n": "0703006", "target": "#nkr_note_orig_0703006", "type": "orig", "text": "劫＝却【甲】＊"}
{"id": null, "n": "0703007", "target": "#nkr_note_orig_0703007", "type": "orig", "text": "狹＝狡【甲】"}
{"id": null, "n": "0703008", "target": "#nkr_note_orig_0703008", "type": "orig", "text": "敘＝劒【甲】"}
{"id": null, "n": "0704001", "target": "#nkr_note_orig_0704001", "type": "orig", "text": "冠註曰度傳作陀"}
{"id": null, "n": "0704002", "target": "#nkr_note_orig_0704002", "type": "orig", "text": "冠註曰喜學傳作學喜"}
{"id": null, "n": "0704003", "target": "#nkr_note_orig_0704003", "type": "orig", "text": "冠註曰裏疏作臺"}
{"id": null, "n": "0704004", "target": "#nkr_note_orig_0704004", "type": "orig", "text": "冠註曰功德經無"}
{"id": null, "n": "0704005", "target": "#nkr_note_orig_0704005", "type": "orig", "text": "〔界〕－【甲】"}
{"id": null, "n": "0704006", "target": "#nkr_note_orig_0704006", "type": "orig", "text": "冠註曰經無差作等無"}
{"id": null, "n": "0704007", "target": "#nkr_note_orig_0704007", "type": "orig", "text": "冠註曰經悉作極"}
{"id": null, "n": "0704008", "target": "#nkr_note_orig_0704008", "type": "orig", "text": "〔士〕－【甲】"}
{"id": null, "n": "0705001", "target": "#nkr_note_orig_0705001", "type": "orig", "text": "反＝返【甲】"}
{"id": null, "n": "0705002", "target": "#nkr_note_orig_0705002", "type": "orig", "text": "倏＝𭛹【甲】"}
{"id": null, "n": "0705003", "target": "#nkr_note_orig_0705003", "type": "orig", "text": "冠註曰無所位次楞伽玄作無所有何次"}
{"id": null, "n": "0705004", "target": "#nkr_note_orig_0705004", "type": "orig", "text": "位＝何【甲】"}
{"id": null, "n": "0705005", "target": "#nkr_note_orig_0705005", "type": "orig", "text": "〔止〕－ヵ【原】"}
{"id": null, "n": "0706001", "target": "#nkr_note_orig_0706001", "type": "orig", "text": "十＝下【甲】"}
{"id": null, "n": "0706002", "target": "#nkr_note_orig_0706002", "type": "orig", "text": "劫＝却【甲】"}
{"id": null, "n": "0707001", "target": "#nkr_note_orig_0707001", "type": "orig", "text": "目＝因【甲】"}
{"id": null, "n": "0707002", "target": "#nkr_note_orig_0707002", "type": "orig", "text": "宣公者旁註曰南山律師【甲】"}
{"id": null, "n": "0707003", "target": "#nkr_note_orig_0707003", "type": "orig", "text": "狹＝狡【甲】"}
{"id": null, "n": "0707004", "target": "#nkr_note_orig_0707004", "type": "orig", "text": "顯俱＝俱顯【甲】"}
{"id": null, "n": "0707005", "target": "#nkr_note_orig_0707005", "type": "orig", "text": "豎＝竪【甲】"}
{"id": null, "n": "0707006", "target": "#nkr_note_orig_0707006", "type": "orig", "text": "〔一〕－【甲】"}
{"id": null, "n": "0707007", "target": "#nkr_note_orig_0707007", "type": "orig", "text": "域＝城【甲】"}
{"id": null, "n": "0708001", "target": "#nkr_note_orig_0708001", "type": "orig", "text": "耳＝耶【甲】"}
{"id": null, "n": "0708002", "target": "#nkr_note_orig_0708002", "type": "orig", "text": "亡＝忘【甲】＊"}
{"id": null, "n": "0708003", "target": "#nkr_note_orig_0708003", "type": "orig", "text": "〔通〕－ヵ【原】"}
{"id": null, "n": "0708004", "target": "#nkr_note_orig_0708004", "type": "orig", "text": "冠註曰無礙經作住無"}
{"id": null, "n": "0708005", "target": "#nkr_note_orig_0708005", "type": "orig", "text": "冠註曰入字經無"}
{"id": null, "n": "0708006", "target": "#nkr_note_orig_0708006", "type": "orig", "text": "申＝伸【甲】"}
{"id": null, "n": "0708007", "target": "#nkr_note_orig_0708007", "type": "orig", "text": "同＝道ヵ【原】"}
{"id": null, "n": "0709001", "target": "#nkr_note_orig_0709001", "type": "orig", "text": "篙＝槁【甲】＊"}
{"id": null, "n": "0709002", "target": "#nkr_note_orig_0709002", "type": "orig", "text": "規＝觀【甲】"}
{"id": null, "n": "0709003", "target": "#nkr_note_orig_0709003", "type": "orig", "text": "帙＝秩【甲】"}
{"id": null, "n": "0709004", "target": "#nkr_note_orig_0709004", "type": "orig", "text": "〔阿〕－【甲】"}
{"id": null, "n": "0703c1901", "target": "#nkr_note_add_0703c1901", "type": "add", "text": "CBETA 按：「非」，〔唐〕澄觀撰《大方廣佛華嚴經疏》（T35n1735_p0523b14）作「根」。"}
{"id": null, "n": "0705c0701", "target": "#nkr_note_add_0705c0701", "type": "add", "text": "歡【CB】，歎【大】"}
