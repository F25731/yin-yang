{"id": null, "n": "0848005", "target": "#nkr_note_mod_0848005", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0848006", "target": "#nkr_note_mod_0848006", "type": "mod", "text": "三藏【大】，唐三藏【宋】【元】【明】【宮】"}
{"id": null, "n": "0848007", "target": "#nkr_note_mod_0848007", "type": "mod", "text": "為【大】，名為【宋】【元】【明】【宮】"}
{"id": null, "n": "0848008", "target": "#nkr_note_mod_0848008", "type": "mod", "text": "串【大】，慣【宋】【元】【明】【宮】"}
{"id": null, "n": "0848009", "target": "#nkr_note_mod_0848009", "type": "mod", "text": "寶【大】＊，實【宋】【元】【宮】＊"}
{"id": null, "n": "0849001", "target": "#nkr_note_mod_0849001", "type": "mod", "text": "德【大】，得【明】"}
{"id": null, "n": "0849002", "target": "#nkr_note_mod_0849002", "type": "mod", "text": "唯【大】，惟【宋】【元】【明】【宮】"}
{"id": null, "n": "0849003", "target": "#nkr_note_mod_0849003", "type": "mod", "text": "今【大】，令【宋】【元】【宮】"}
{"id": null, "n": "0849004", "target": "#nkr_note_mod_0849004", "type": "mod", "text": "採【大】＊，積【元】【明】＊，采【宮】＊"}
{"id": null, "n": "0850001", "target": "#nkr_note_mod_0850001", "type": "mod", "text": "與【大】，與我慢【宋】【元】【明】【宮】"}
{"id": null, "n": "0850002", "target": "#nkr_note_mod_0850002", "type": "mod", "text": "我慢【大】，〔－〕【宋】【元】【明】【宮】"}
