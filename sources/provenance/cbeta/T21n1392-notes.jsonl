{"id": null, "n": "0908008", "target": "#nkr_note_mod_0908008", "type": "mod", "text": "西【大】，宋西【明】"}
{"id": null, "n": "0908009", "target": "#nkr_note_mod_0908009", "type": "mod", "text": "那爛陀寺【大】，〔－〕【明】"}
{"id": null, "n": "0908010", "target": "#nkr_note_mod_0908010", "type": "mod", "text": "沙門【大】，〔－〕【明】"}
{"id": null, "n": "0908011", "target": "#nkr_note_mod_0908011", "type": "mod", "text": "臣【大】，〔－〕【宋】【元】"}
{"id": null, "n": "0908013", "target": "#nkr_note_mod_0908013", "type": "mod", "text": "聽【大】，德【元】【明】"}
{"id": null, "n": "0908014", "target": "#nkr_note_mod_0908014", "type": "mod", "text": "得【大】，〔－〕【元】【明】"}
{"id": null, "n": "0908016", "target": "#nkr_note_mod_0908016", "type": "mod", "text": "於肯反【大】，〔－〕【明】"}
{"id": null, "n": "0908017", "target": "#nkr_note_mod_0908017", "type": "mod", "text": "反【大】下同，切【明】下同"}
{"id": null, "n": "0908018", "target": "#nkr_note_mod_0908018", "type": "mod", "text": "引【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0908019", "target": "#nkr_note_mod_0908019", "type": "mod", "text": "囉【大】，羅【宋】【元】【明】"}
{"id": null, "n": "0909001", "target": "#nkr_note_mod_0909001", "type": "mod", "text": "努【大】，弩【明】"}
{"id": null, "n": "0909002", "target": "#nkr_note_mod_0909002", "type": "mod", "text": "上【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0909003", "target": "#nkr_note_mod_0909003", "type": "mod", "text": "魯【大】＊，嚕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0909004", "target": "#nkr_note_mod_0909004", "type": "mod", "text": "嚕【大】，〔－〕【明】"}
{"id": null, "n": "0909005", "target": "#nkr_note_mod_0909005", "type": "mod", "text": "麌【大】，虞【宋】【元】【明】"}
{"id": null, "n": "0909006", "target": "#nkr_note_mod_0909006", "type": "mod", "text": "禰【大】，袪【宋】【元】【明】"}
{"id": null, "n": "0909007", "target": "#nkr_note_mod_0909007", "type": "mod", "text": "志【大】，主【元】，至【明】"}
{"id": null, "n": "0909008", "target": "#nkr_note_mod_0909008", "type": "mod", "text": "及【大】，又【明】"}
{"id": null, "n": "0910001", "target": "#nkr_note_mod_0910001", "type": "mod", "text": "志【大】，至【元】【明】"}
{"id": null, "n": "0908007", "target": "#nkr_note_orig_0908007", "type": "orig", "text": "【原】麗本，東京帝國大學所藏梵本 No. 246, 276, 286, 288, 289, 291, 334, 439, 445. Ārya-mahā-śitavatī."}
{"id": null, "n": "0908008", "target": "#nkr_note_orig_0908008", "type": "orig", "text": "（宋）＋西【明】"}
{"id": null, "n": "0908009", "target": "#nkr_note_orig_0908009", "type": "orig", "text": "〔那爛陀寺〕－【明】"}
{"id": null, "n": "0908010", "target": "#nkr_note_orig_0908010", "type": "orig", "text": "〔沙門〕－【明】"}
{"id": null, "n": "0908011", "target": "#nkr_note_orig_0908011", "type": "orig", "text": "〔臣〕－【宋】【元】"}
{"id": null, "n": "0908012", "target": "#nkr_note_orig_0908012", "type": "orig", "text": "ingikāyatana."}
{"id": null, "n": "0908013", "target": "#nkr_note_orig_0908013", "type": "orig", "text": "聽＝德【元】【明】"}
{"id": null, "n": "0908014", "target": "#nkr_note_orig_0908014", "type": "orig", "text": "〔得〕－【元】【明】"}
{"id": null, "n": "0908015", "target": "#nkr_note_orig_0908015", "type": "orig", "text": "梵語真言 cf. P. 909c"}
{"id": null, "n": "0908016", "target": "#nkr_note_orig_0908016", "type": "orig", "text": "〔於肯反〕－【明】"}
{"id": null, "n": "0908017", "target": "#nkr_note_orig_0908017", "type": "orig", "text": "反＝切【明】下同"}
{"id": null, "n": "0908018", "target": "#nkr_note_orig_0908018", "type": "orig", "text": "〔引〕－【三】"}
{"id": null, "n": "0908019", "target": "#nkr_note_orig_0908019", "type": "orig", "text": "囉＝羅【三】"}
{"id": null, "n": "0909001", "target": "#nkr_note_orig_0909001", "type": "orig", "text": "努＝弩【明】"}
{"id": null, "n": "0909002", "target": "#nkr_note_orig_0909002", "type": "orig", "text": "〔上〕－【三】"}
{"id": null, "n": "0909003", "target": "#nkr_note_orig_0909003", "type": "orig", "text": "魯＝嚕【三】＊"}
{"id": null, "n": "0909004", "target": "#nkr_note_orig_0909004", "type": "orig", "text": "〔嚕〕－【明】"}
{"id": null, "n": "0909005", "target": "#nkr_note_orig_0909005", "type": "orig", "text": "麌＝虞【三】"}
{"id": null, "n": "0909006", "target": "#nkr_note_orig_0909006", "type": "orig", "text": "禰＝袪【三】"}
{"id": null, "n": "0909009", "target": "#nkr_note_orig_0909009", "type": "orig", "text": "cf. P. 908c"}
{"id": null, "n": "0909007", "target": "#nkr_note_orig_0909007", "type": "orig", "text": "志＝主【元】，至【明】"}
{"id": null, "n": "0909008", "target": "#nkr_note_orig_0909008", "type": "orig", "text": "及＝又【明】"}
{"id": null, "n": "0910001", "target": "#nkr_note_orig_0910001", "type": "orig", "text": "志＝至【元】【明】"}
