{"id": null, "n": null, "target": null, "type": null, "text": "六"}
{"id": null, "n": null, "target": null, "type": null, "text": "七"}
{"id": null, "n": null, "target": null, "type": null, "text": "八"}
{"id": null, "n": null, "target": null, "type": null, "text": "月小則前一日"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂慧皎日菴"}
{"id": null, "n": null, "target": null, "type": null, "text": "廣賓《輯略》云：淨行社，後為慈雲懺主教觀道場。"}
{"id": null, "n": null, "target": null, "type": null, "text": "四明所著"}
{"id": null, "n": null, "target": null, "type": null, "text": "見〈慧雲大律師本傳〉"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦作戒山"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦稱大巗"}
{"id": null, "n": null, "target": null, "type": null, "text": "見《宗師記》"}
{"id": null, "n": null, "target": null, "type": null, "text": "即九蓮蕩"}
{"id": null, "n": null, "target": null, "type": null, "text": "修止居士"}
{"id": null, "n": null, "target": null, "type": null, "text": "龍眠山人"}
{"id": null, "n": null, "target": null, "type": null, "text": "我菴在西溪馬家塢，宋時名永福，亦名崇禎院，漚住之師履素重葺居之。"}
{"id": null, "n": null, "target": null, "type": null, "text": "萬歷乙卯"}
{"id": null, "n": null, "target": null, "type": null, "text": "名中行，七才子之一"}
{"id": null, "n": null, "target": null, "type": null, "text": "案：戒壇即昭慶"}
