{"id": null, "n": null, "target": null, "type": null, "text": "結社及戒壇，詳見後卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "天聖八年"}
{"id": null, "n": null, "target": null, "type": null, "text": "三十年"}
{"id": null, "n": null, "target": null, "type": null, "text": "勒石明末始毀"}
{"id": null, "n": null, "target": null, "type": null, "text": "二語\n承誤"}
{"id": null, "n": null, "target": null, "type": null, "text": "數語承誤"}
{"id": null, "n": null, "target": null, "type": null, "text": "萬歷丙戌，按察僉事丁應詔重修牌坊。應詔，曜之孫也"}
{"id": null, "n": null, "target": null, "type": null, "text": "林鳳書"}
{"id": null, "n": null, "target": null, "type": null, "text": "後勒\n石，毀於兵"}
{"id": null, "n": null, "target": null, "type": null, "text": "董其昌書額"}
{"id": null, "n": null, "target": null, "type": null, "text": "六百七十八函，一萬五千四十八卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "端伯，別號海岸道人"}
{"id": null, "n": null, "target": null, "type": null, "text": "即法乳堂"}
{"id": null, "n": null, "target": null, "type": null, "text": "高六丈一尺六寸"}
{"id": null, "n": null, "target": null, "type": null, "text": "鐵像三身，火後存一，\n\n今為主佛"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣僧果證"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣于敏中"}
{"id": null, "n": null, "target": null, "type": null, "text": "高六丈六尺六寸"}
{"id": null, "n": null, "target": null, "type": null, "text": "高三丈六尺六寸"}
{"id": null, "n": null, "target": null, "type": null, "text": "彌勒、韋馱，舊皆銅像，火後并鑄彌勒一身"}
{"id": null, "n": null, "target": null, "type": null, "text": "一名仙池，又名放生池"}
{"id": null, "n": null, "target": null, "type": null, "text": "宋時名廣濟橋"}
{"id": null, "n": null, "target": null, "type": null, "text": "淨明、曰唯二師遺貲"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋篆玉書\n額。"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋隆樹書額"}
{"id": null, "n": null, "target": null, "type": null, "text": "宋時，昭慶山門\n與菩提附近"}
{"id": null, "n": null, "target": null, "type": null, "text": "此下序南宋重建後事"}
{"id": null, "n": null, "target": null, "type": null, "text": "與昭慶同為兵所毀"}
{"id": null, "n": null, "target": null, "type": null, "text": "自注：菩提寺為臨安人火葬之地。"}
{"id": null, "n": null, "target": null, "type": null, "text": "導湖水入城作池井者，名\n水口"}
{"id": null, "n": null, "target": null, "type": null, "text": "五年，恐二年之訛。見首卷〈興建〉注中。"}
{"id": null, "n": null, "target": null, "type": null, "text": "神宗陵號"}
{"id": null, "n": null, "target": null, "type": null, "text": "今稱武林門為北關門"}
{"id": null, "n": null, "target": null, "type": null, "text": "即西湖"}
{"id": null, "n": null, "target": null, "type": null, "text": "《錢唐縣志》云：中閘橋，一名溜水"}
{"id": null, "n": null, "target": null, "type": null, "text": "二字衍文"}
{"id": null, "n": null, "target": null, "type": null, "text": "康熙十一\n年。"}
{"id": null, "n": null, "target": null, "type": null, "text": "康熙二十年。"}
{"id": null, "n": null, "target": null, "type": null, "text": "導水而入"}
{"id": null, "n": null, "target": null, "type": null, "text": "即西湖"}
{"id": null, "n": null, "target": null, "type": null, "text": "《咸淳志》稱下湖河"}
{"id": null, "n": null, "target": null, "type": null, "text": "長慶四年。"}
{"id": null, "n": null, "target": null, "type": null, "text": "今松木場下河"}
{"id": null, "n": null, "target": null, "type": null, "text": "案：《林和靖集》有〈送思齊上人之\n宣城詩〉，即其人也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "白公〈湖石記〉云：「水漲兼於石函南筧泄之，防隄潰也。」即此\n隄。"}
{"id": null, "n": null, "target": null, "type": null, "text": "泛地卒"}
{"id": null, "n": null, "target": null, "type": null, "text": "似即新建鐘板堂之基址"}
{"id": null, "n": null, "target": null, "type": null, "text": "淳化至天禧初"}
{"id": null, "n": null, "target": null, "type": null, "text": "即師之弟子虛白也"}
{"id": null, "n": null, "target": null, "type": null, "text": "孫何〈記〉所云在密地日"}
{"id": null, "n": null, "target": null, "type": null, "text": "〈記〉故稱相國"}
{"id": null, "n": null, "target": null, "type": null, "text": "后乃公之曾孫女"}
