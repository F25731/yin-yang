{"id": null, "n": "0904007", "target": "#nkr_note_mod_0904007", "type": "mod", "text": "西天譯經三藏朝散大夫試光祿卿明教大師【大】，三藏法師【宋】【元】，宋西天譯經三藏朝散大夫試光祿卿明教大師【明】"}
{"id": null, "n": "0904008", "target": "#nkr_note_mod_0904008", "type": "mod", "text": "臣【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0904009", "target": "#nkr_note_mod_0904009", "type": "mod", "text": "志【大】，至【元】【明】"}
{"id": null, "n": "0904010", "target": "#nkr_note_mod_0904010", "type": "mod", "text": "滅【大】，除【明】"}
{"id": null, "n": "0904012", "target": "#nkr_note_mod_0904012", "type": "mod", "text": "囉【大】，羅【元】【明】"}
{"id": null, "n": "0904006", "target": "#nkr_note_orig_0904006", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0904007", "target": "#nkr_note_orig_0904007", "type": "orig", "text": "（（西天…師））十八字＝（（三藏法師））四字【宋】【元】，（宋）＋西【明】"}
{"id": null, "n": "0904008", "target": "#nkr_note_orig_0904008", "type": "orig", "text": "〔臣〕－【三】"}
{"id": null, "n": "0904009", "target": "#nkr_note_orig_0904009", "type": "orig", "text": "志＝至【元】【明】"}
{"id": null, "n": "0904010", "target": "#nkr_note_orig_0904010", "type": "orig", "text": "滅＝除【明】"}
{"id": null, "n": "0904011", "target": "#nkr_note_orig_0904011", "type": "orig", "text": "梵字載於卷末"}
{"id": null, "n": "0904012", "target": "#nkr_note_orig_0904012", "type": "orig", "text": "囉＝羅【元】【明】"}
{"id": null, "n": "0904013", "target": "#nkr_note_orig_0904013", "type": "orig", "text": "此梵字真言依靈雲寺版普通真言藏載之"}
