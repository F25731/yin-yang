{"id": null, "n": "0916003", "target": null, "type": "orig", "text": "〔臣〕－【明】"}
{"id": null, "n": "0916003", "target": null, "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K34n1224_p0476b09"}
{"id": null, "n": "0916002", "target": "#nkr_note_mod_0916002", "type": "mod", "text": "西天譯經三藏朝散大夫試光祿卿明教大師臣【大】，三藏法師【宋】【元】，宋西天譯經三藏朝散大夫試光祿卿明教大師臣【明】"}
{"id": null, "n": "0916003", "target": "#nkr_note_mod_0916003", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0916004", "target": "#nkr_note_mod_0916004", "type": "mod", "text": "暮【大】＊，慕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0916005", "target": "#nkr_note_mod_0916005", "type": "mod", "text": "囉【大】，羅【宋】【元】【明】"}
{"id": null, "n": "0916006", "target": "#nkr_note_mod_0916006", "type": "mod", "text": "蜜【大】，密【明】"}
{"id": null, "n": "0916007", "target": "#nkr_note_mod_0916007", "type": "mod", "text": "尼【大】，尾【宋】【元】【明】"}
{"id": null, "n": "0916008", "target": "#nkr_note_mod_0916008", "type": "mod", "text": "𭔞【大】，𩕳【宋】【元】【明】"}
{"id": null, "n": "0917001", "target": "#nkr_note_mod_0917001", "type": "mod", "text": "志【大】，至【元】【明】"}
{"id": null, "n": "0916001", "target": "#nkr_note_orig_0916001", "type": "orig", "text": "【原】麗本"}
