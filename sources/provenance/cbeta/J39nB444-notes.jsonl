{"id": null, "n": null, "target": null, "type": null, "text": "著拈"}
{"id": null, "n": null, "target": null, "type": null, "text": "討甚麼碗？"}
{"id": null, "n": null, "target": null, "type": null, "text": "有口說不得。"}
{"id": null, "n": null, "target": null, "type": null, "text": "到來谷愁中月。"}
{"id": null, "n": null, "target": null, "type": null, "text": "歸去蟠溪夢裏山。"}
{"id": null, "n": null, "target": null, "type": null, "text": "且莫匆匆草草。"}
{"id": null, "n": null, "target": null, "type": null, "text": "遠。"}
{"id": null, "n": null, "target": null, "type": null, "text": "平空捏謊。"}
{"id": null, "n": null, "target": null, "type": null, "text": "穿衣喫飯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "喫飯穿衣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "張三李四。"}
{"id": null, "n": null, "target": null, "type": null, "text": "屎沸作麼？"}
{"id": null, "n": null, "target": null, "type": null, "text": "呸！"}
{"id": null, "n": null, "target": null, "type": null, "text": "忍禁不過。"}
{"id": null, "n": null, "target": null, "type": null, "text": "落花有意隨流\n水。"}
{"id": null, "n": null, "target": null, "type": null, "text": "流水無心送落花。"}
{"id": null, "n": null, "target": null, "type": null, "text": "謾得過阿\n誰？"}
{"id": null, "n": null, "target": null, "type": null, "text": "多嘴生。"}
{"id": null, "n": null, "target": null, "type": null, "text": "隔礙作麼？"}
{"id": null, "n": null, "target": null, "type": null, "text": "快馬更加鞭。"}
{"id": null, "n": null, "target": null, "type": null, "text": "一月普現\n一切水。"}
{"id": null, "n": null, "target": null, "type": null, "text": "一切水月一月挕。"}
{"id": null, "n": null, "target": null, "type": null, "text": "切忌口快。"}
{"id": null, "n": null, "target": null, "type": null, "text": "親切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "親切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "親切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "親切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "法爾如然。"}
{"id": null, "n": null, "target": null, "type": null, "text": "作麼生？"}
{"id": null, "n": null, "target": null, "type": null, "text": "窮則變。"}
{"id": null, "n": null, "target": null, "type": null, "text": "千聖跳不出。"}
{"id": null, "n": null, "target": null, "type": null, "text": "一任鑽龜打瓦。"}
{"id": null, "n": null, "target": null, "type": null, "text": "打鼓弄琶。"}
{"id": null, "n": null, "target": null, "type": null, "text": "驗過始得。"}
{"id": null, "n": null, "target": null, "type": null, "text": "和尚記得\n分明。"}
{"id": null, "n": null, "target": null, "type": null, "text": "不妨疑著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "坐著即不可。"}
{"id": null, "n": null, "target": null, "type": null, "text": "順風倒。"}
{"id": null, "n": null, "target": null, "type": null, "text": "弄琶打鼓。"}
{"id": null, "n": null, "target": null, "type": null, "text": "本分為人。"}
{"id": null, "n": null, "target": null, "type": null, "text": "和尚分明記得。"}
{"id": null, "n": null, "target": null, "type": null, "text": "疑著不妨。"}
{"id": null, "n": null, "target": null, "type": null, "text": "且莫匆匆草草。"}
{"id": null, "n": null, "target": null, "type": null, "text": "剜心刳腹。"}
{"id": null, "n": null, "target": null, "type": null, "text": "且莫草草匆匆。"}
{"id": null, "n": null, "target": null, "type": null, "text": "剖腹剜心。"}
{"id": null, "n": null, "target": null, "type": null, "text": "冤家路窄。"}
{"id": null, "n": null, "target": null, "type": null, "text": "殺人要見血。"}
{"id": null, "n": null, "target": null, "type": null, "text": "處。"}
{"id": null, "n": null, "target": null, "type": null, "text": "恁麼又爭得？"}
{"id": null, "n": null, "target": null, "type": null, "text": "再來不直錢。"}
{"id": null, "n": null, "target": null, "type": null, "text": "不恁麼又爭得？"}
{"id": null, "n": null, "target": null, "type": null, "text": "將謂將謂。"}
{"id": null, "n": null, "target": null, "type": null, "text": "元來，元來。"}
{"id": null, "n": null, "target": null, "type": null, "text": "求人不如求己。"}
{"id": null, "n": null, "target": null, "type": null, "text": "如實通供。"}
{"id": null, "n": null, "target": null, "type": null, "text": "不恁麼又爭得？"}
{"id": null, "n": null, "target": null, "type": null, "text": "婆心太切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "見個甚麼？"}
{"id": null, "n": null, "target": null, "type": null, "text": "若不同床\n睡，焉知被底穿？"}
{"id": null, "n": null, "target": null, "type": null, "text": "且恁麼問。"}
{"id": null, "n": null, "target": null, "type": null, "text": "在。"}
{"id": null, "n": null, "target": null, "type": null, "text": "莫管屋上。"}
{"id": null, "n": null, "target": null, "type": null, "text": "無。"}
{"id": null, "n": null, "target": null, "type": null, "text": "又恁麼問。"}
{"id": null, "n": null, "target": null, "type": null, "text": "曲則全。"}
{"id": null, "n": null, "target": null, "type": null, "text": "各人自掃門前雪。"}
{"id": null, "n": null, "target": null, "type": null, "text": "有。"}
{"id": null, "n": null, "target": null, "type": null, "text": "以楔出楔。"}
{"id": null, "n": null, "target": null, "type": null, "text": "以空投空。"}
{"id": null, "n": null, "target": null, "type": null, "text": "休錯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "婆心太切。"}
{"id": null, "n": null, "target": null, "type": null, "text": "也要大家知。"}
{"id": null, "n": null, "target": null, "type": null, "text": "答云：『不會，不會。』"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "J29nB238_p0462a30"}
{"id": null, "n": "0339c2001", "target": "#nkr_note_add_0339c2001", "type": "add", "text": "陝【CB】，陜【嘉興】"}
