{"id": null, "n": "0340b1801", "target": "#nkr_note_add_0340b1801", "type": "add", "text": "己【CB】，已【嘉興】"}
{"id": null, "n": "0341a1801", "target": "#nkr_note_add_0341a1801", "type": "add", "text": "猿【CB】，【嘉興】"}
{"id": null, "n": "0341b0901", "target": "#nkr_note_add_0341b0901", "type": "add", "text": "CBETA 按：「」，疑作「汝」。"}
{"id": null, "n": "0341b2401", "target": "#nkr_note_add_0341b2401", "type": "add", "text": "番【CB】，【嘉興】"}
{"id": null, "n": "0341c0201", "target": "#nkr_note_add_0341c0201", "type": "add", "text": "揖【CB】，【嘉興】"}
{"id": null, "n": "0342b1101", "target": "#nkr_note_add_0342b1101", "type": "add", "text": "己【CB】，巳【嘉興】"}
{"id": null, "n": "0342b1601", "target": "#nkr_note_add_0342b1601", "type": "add", "text": "個【CB】，【嘉興】"}
{"id": null, "n": "0342b1901", "target": "#nkr_note_add_0342b1901", "type": "add", "text": "CBETA 按：「」，疑作「他家」。"}
{"id": null, "n": "0342b1902", "target": "#nkr_note_add_0342b1902", "type": "add", "text": "CBETA 按：「」，疑作「霜」。"}
{"id": null, "n": "0343a0901", "target": "#nkr_note_add_0343a0901", "type": "add", "text": "師【CB】，帥【嘉興】"}
{"id": null, "n": "0343a1801", "target": "#nkr_note_add_0343a1801", "type": "add", "text": "已【CB】，巳【嘉興】"}
