{"id": null, "n": "0862002", "target": "#nkr_note_mod_0862002", "type": "mod", "text": "三藏法師【大】，沙門釋【宋】【元】【明】"}
{"id": null, "n": "0862003", "target": "#nkr_note_mod_0862003", "type": "mod", "text": "上【大】，卜【宋】【元】【明】"}
{"id": null, "n": "0862004", "target": "#nkr_note_mod_0862004", "type": "mod", "text": "坐【大】，座【宋】【元】【明】"}
{"id": null, "n": "0862005", "target": "#nkr_note_mod_0862005", "type": "mod", "text": "向【大】，面【宋】【元】【明】"}
{"id": null, "n": "0862006", "target": "#nkr_note_mod_0862006", "type": "mod", "text": "唯【大】＊，惟【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0862007", "target": "#nkr_note_mod_0862007", "type": "mod", "text": "願【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0862008", "target": "#nkr_note_mod_0862008", "type": "mod", "text": "乾【大】＊，揵【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0862009", "target": "#nkr_note_mod_0862009", "type": "mod", "text": "其【大】，是【宋】【元】【明】"}
{"id": null, "n": "0862010", "target": "#nkr_note_mod_0862010", "type": "mod", "text": "閉【大】，關【宋】【元】【明】"}
{"id": null, "n": "0862011", "target": "#nkr_note_mod_0862011", "type": "mod", "text": "申【大】＊，伸【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0863001", "target": "#nkr_note_mod_0863001", "type": "mod", "text": "積【大】，𧂐【宋】【元】【明】"}
{"id": null, "n": "0863002", "target": "#nkr_note_mod_0863002", "type": "mod", "text": "是目乾連若愚人作是行過已過觀【大】，掃之在中掃令淨何以故恐壞餘淨【元】【明】"}
{"id": null, "n": "0863003", "target": "#nkr_note_mod_0863003", "type": "mod", "text": "㭬【大】，󱋋【宋】【元】【明】"}
{"id": null, "n": "0863004", "target": "#nkr_note_mod_0863004", "type": "mod", "text": "所有【大】，有所【明】"}
{"id": null, "n": "0863005", "target": "#nkr_note_mod_0863005", "type": "mod", "text": "自【大】，目【明】"}
{"id": null, "n": "0863006", "target": "#nkr_note_mod_0863006", "type": "mod", "text": "曰【大】，言【宋】【元】【明】"}
{"id": null, "n": "0863007", "target": "#nkr_note_mod_0863007", "type": "mod", "text": "莊【大】，在【宋】【元】【明】"}
{"id": null, "n": "0863008", "target": "#nkr_note_mod_0863008", "type": "mod", "text": "具【大】，俱【明】"}
{"id": null, "n": "0863009", "target": "#nkr_note_mod_0863009", "type": "mod", "text": "集會【大】，會集【宋】【元】【明】"}
