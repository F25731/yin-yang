{"id": null, "n": null, "target": null, "type": "cf1", "text": "K05n0011_p0961b24"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K05n0011_p0961c18"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K05n0011_p0962c15"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T08n0223_p0302b05"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K05n0011_p0962c20"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "Q05_p0403a07"}
{"id": null, "n": "0732014", "target": "#nkr_note_mod_0732014", "type": "mod", "text": "國【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0732015", "target": "#nkr_note_mod_0732015", "type": "mod", "text": "才【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0733001", "target": "#nkr_note_mod_0733001", "type": "mod", "text": "頗梨【大】，玻𭹳【宋】【元】【明】【宮】"}
{"id": null, "n": "0733002", "target": "#nkr_note_mod_0733002", "type": "mod", "text": "外【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0733003", "target": "#nkr_note_mod_0733003", "type": "mod", "text": "加【大】，跏【宋】【元】【明】"}
{"id": null, "n": "0733004", "target": "#nkr_note_mod_0733004", "type": "mod", "text": "非無【大】，有【宋】【元】【宮】"}
{"id": null, "n": "0733005", "target": "#nkr_note_mod_0733005", "type": "mod", "text": "等【大】，等故【宋】【元】【明】【宮】"}
{"id": null, "n": "0733006a", "target": "#nkr_note_mod_0733006a", "type": "mod", "text": "云何諸佛教化眾生【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0733006b", "target": "#nkr_note_mod_0733006b", "type": "mod", "text": "舍利弗言【大】，舍利弗白文殊師利【宋】【元】【明】【宮】"}
{"id": null, "n": "0733007", "target": "#nkr_note_mod_0733007", "type": "mod", "text": "觀【大】，覩【宋】【元】【明】【宮】"}
{"id": null, "n": "0733008", "target": "#nkr_note_mod_0733008", "type": "mod", "text": "想【大】，相【宋】【元】【明】【宮】"}
{"id": null, "n": "0733009", "target": "#nkr_note_mod_0733009", "type": "mod", "text": "汝【大】，爾【宋】【元】【明】【宮】"}
{"id": null, "n": "0733010", "target": "#nkr_note_mod_0733010", "type": "mod", "text": "文【大】，佛告文【元】【明】【宮】"}
{"id": null, "n": "0733011", "target": "#nkr_note_mod_0733011", "type": "mod", "text": "復【大】，人【明】【元】"}
{"id": null, "n": "0734001", "target": "#nkr_note_mod_0734001", "type": "mod", "text": "云【大】，汝云【宋】【元】【明】【宮】"}
{"id": null, "n": "0734002", "target": "#nkr_note_mod_0734002", "type": "mod", "text": "則【大】，我無所修我【元】【明】"}
{"id": null, "n": "0734003", "target": "#nkr_note_mod_0734003", "type": "mod", "text": "修【大】，學【元】【明】"}
{"id": null, "n": "0734004", "target": "#nkr_note_mod_0734004", "type": "mod", "text": "修【大】，修學【元】【明】"}
{"id": null, "n": "0734005", "target": "#nkr_note_mod_0734005", "type": "mod", "text": "世尊【大】，〔－〕【元】"}
{"id": null, "n": "0734006", "target": "#nkr_note_mod_0734006", "type": "mod", "text": "修【大】，修是修【宋】【元】【明】【宮】"}
{"id": null, "n": "0734007", "target": "#nkr_note_mod_0734007", "type": "mod", "text": "法【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0734008", "target": "#nkr_note_mod_0734008", "type": "mod", "text": "凡【大】，佛法凡【宋】【元】【明】【宮】"}
{"id": null, "n": "0734009", "target": "#nkr_note_mod_0734009", "type": "mod", "text": "上無【大】，生死【宋】【元】【明】【宮】"}
{"id": null, "n": "0734010", "target": "#nkr_note_mod_0734010", "type": "mod", "text": "法【大】，等法乎【元】【明】"}
{"id": null, "n": "0734011", "target": "#nkr_note_mod_0734011", "type": "mod", "text": "我【大】，我當【元】【明】【宮】"}
{"id": null, "n": "0734012", "target": "#nkr_note_mod_0734012", "type": "mod", "text": "無有生【大】，無有性【元】【明】，無性【宋】【宮】"}
{"id": null, "n": "0734013", "target": "#nkr_note_mod_0734013", "type": "mod", "text": "法【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "0734014", "target": "#nkr_note_mod_0734014", "type": "mod", "text": "法【大】，不得法【元】【明】"}
{"id": null, "n": "0734015", "target": "#nkr_note_mod_0734015", "type": "mod", "text": "淨【大】，不見淨【元】【宮】"}
{"id": null, "n": "0734016", "target": "#nkr_note_mod_0734016", "type": "mod", "text": "法【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0735001", "target": "#nkr_note_mod_0735001", "type": "mod", "text": "佛【大】，佛言世尊【元】【明】"}
{"id": null, "n": "0735002", "target": "#nkr_note_mod_0735002", "type": "mod", "text": "法可得【大】，佛法可住【元】【明】"}
{"id": null, "n": "0735003", "target": "#nkr_note_mod_0735003", "type": "mod", "text": "汝【大】，汝今【元】【明】"}
{"id": null, "n": "0735004", "target": "#nkr_note_mod_0735004", "type": "mod", "text": "師利【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0735005", "target": "#nkr_note_mod_0735005", "type": "mod", "text": "深法【大】＊，深般若波羅蜜【元】【明】＊"}
{"id": null, "n": "0735006", "target": "#nkr_note_mod_0735006", "type": "mod", "text": "若【大】，若有【元】【明】"}
{"id": null, "n": "0735007", "target": "#nkr_note_mod_0735007", "type": "mod", "text": "勝施主【大】，勝施主無等施主【元】【明】"}
{"id": null, "n": "0735008", "target": "#nkr_note_mod_0735008", "type": "mod", "text": "文殊【大】，文殊師利【元】【明】"}
{"id": null, "n": "0735009", "target": "#nkr_note_mod_0735009", "type": "mod", "text": "白佛【大】，白佛言【元】【明】"}
{"id": null, "n": "0735010", "target": "#nkr_note_mod_0735010", "type": "mod", "text": "如是【大】，〔－〕【元】【明】"}
{"id": null, "n": "0735011", "target": "#nkr_note_mod_0735011", "type": "mod", "text": "若【大】，〔－〕【元】【明】"}
{"id": null, "n": "0735012", "target": "#nkr_note_mod_0735012", "type": "mod", "text": "菩提【大】，菩提者【元】【明】"}
{"id": null, "n": "0735013", "target": "#nkr_note_mod_0735013", "type": "mod", "text": "是【大】，相【宮】"}
{"id": null, "n": "0735014", "target": "#nkr_note_mod_0735014", "type": "mod", "text": "應如汝【大】，樂深法應當如所說學如【元】【明】"}
{"id": null, "n": "0735015", "target": "#nkr_note_mod_0735015", "type": "mod", "text": "不【大】，不於無量佛所深【元】【明】"}
{"id": null, "n": "0735016", "target": "#nkr_note_mod_0735016", "type": "mod", "text": "修【大】，久修【元】【明】"}
{"id": null, "n": "0735017", "target": "#nkr_note_mod_0735017", "type": "mod", "text": "何以故一切眾生則梵行相【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0735018", "target": "#nkr_note_mod_0735018", "type": "mod", "text": "見【大】，不見【宋】【宮】"}
{"id": null, "n": "0735019", "target": "#nkr_note_mod_0735019", "type": "mod", "text": "文殊【大】＊，文殊師利【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0735020", "target": "#nkr_note_mod_0735020", "type": "mod", "text": "我【大】，〔－〕【元】【明】"}
{"id": null, "n": "0735021", "target": "#nkr_note_mod_0735021", "type": "mod", "text": "不【大】，以不【宋】【元】【明】【宮】"}
{"id": null, "n": "0735022", "target": "#nkr_note_mod_0735022", "type": "mod", "text": "覺【大】，而覺【宋】【元】【明】【宮】"}
{"id": null, "n": "0735023", "target": "#nkr_note_mod_0735023", "type": "mod", "text": "法【大】，當有法【元】"}
{"id": null, "n": "0735024", "target": "#nkr_note_mod_0735024", "type": "mod", "text": "涅槃【大】，泥洹【宋】【元】【明】【宮】"}
{"id": null, "n": "0735025", "target": "#nkr_note_mod_0735025", "type": "mod", "text": "若【大】，答【宮】，若人【元】【明】"}
{"id": null, "n": "0735026", "target": "#nkr_note_mod_0735026", "type": "mod", "text": "菩提【大】，菩提道【宋】【元】【明】"}
{"id": null, "n": "0736001", "target": "#nkr_note_mod_0736001", "type": "mod", "text": "善【大】，善哉善【元】【明】"}
{"id": null, "n": "0736002", "target": "#nkr_note_mod_0736002", "type": "mod", "text": "（菩提心…可得）十四字【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "0736003", "target": "#nkr_note_mod_0736003", "type": "mod", "text": "無間【大】，無間罪【宋】【元】【明】【宮】"}
{"id": null, "n": "0736004", "target": "#nkr_note_mod_0736004", "type": "mod", "text": "眼【大】，眼非眼【元】【明】"}
{"id": null, "n": "0736005", "target": "#nkr_note_mod_0736005", "type": "mod", "text": "意【大】，意非意【元】【明】"}
{"id": null, "n": "0736006", "target": "#nkr_note_mod_0736006", "type": "mod", "text": "色【大】，色非色【元】【明】"}
{"id": null, "n": "0736007", "target": "#nkr_note_mod_0736007", "type": "mod", "text": "法【大】，法非法【元】【明】"}
{"id": null, "n": "0736008", "target": "#nkr_note_mod_0736008", "type": "mod", "text": "眼界【大】，眼界非眼界【元】【明】"}
{"id": null, "n": "0736009", "target": "#nkr_note_mod_0736009", "type": "mod", "text": "亦【大】，亦非法界【元】【明】"}
{"id": null, "n": "0736010", "target": "#nkr_note_mod_0736010", "type": "mod", "text": "生【大】，生非生【元】【明】"}
{"id": null, "n": "0736011", "target": "#nkr_note_mod_0736011", "type": "mod", "text": "老死【大】，老死非老死【元】【明】"}
{"id": null, "n": "0736012", "target": "#nkr_note_mod_0736012", "type": "mod", "text": "蜜【大】，蜜非檀波羅蜜【元】【明】"}
{"id": null, "n": "0736013", "target": "#nkr_note_mod_0736013", "type": "mod", "text": "蜜【大】，蜜非般若波羅蜜【元】【明】"}
{"id": null, "n": "0736014", "target": "#nkr_note_mod_0736014", "type": "mod", "text": "佛十力【大】，佛十力非佛十力【元】【明】"}
{"id": null, "n": "0736015", "target": "#nkr_note_mod_0736015", "type": "mod", "text": "法【大】，法非十八不共法【元】【明】"}
{"id": null, "n": "0736016", "target": "#nkr_note_mod_0736016", "type": "mod", "text": "（我無…故）十二字【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0736017", "target": "#nkr_note_mod_0736017", "type": "mod", "text": "師利【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0736018", "target": "#nkr_note_mod_0736018", "type": "mod", "text": "言【大】＊，語【元】【明】＊"}
{"id": null, "n": "0736019", "target": "#nkr_note_mod_0736019", "type": "mod", "text": "信【大】，信當【宋】【元】【明】【宮】"}
{"id": null, "n": "0736020", "target": "#nkr_note_mod_0736020", "type": "mod", "text": "優婆塞【大】，優婆塞眾【宋】【元】【明】【宮】"}
{"id": null, "n": "0736021", "target": "#nkr_note_mod_0736021", "type": "mod", "text": "震【大】，振【宋】【元】【宮】"}
{"id": null, "n": "0736022", "target": "#nkr_note_mod_0736022", "type": "mod", "text": "（佛言…斯義）九百十一字【宋】【元】【明】，【宮】大異卷末出之"}
{"id": null, "n": "0737001", "target": "#nkr_note_mod_0737001", "type": "mod", "text": "今【大】，後【宋】【元】【明】【宮】"}
{"id": null, "n": "0737002", "target": "#nkr_note_mod_0737002", "type": "mod", "text": "我於來世必得此法【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0737003", "target": "#nkr_note_mod_0737003", "type": "mod", "text": "串【大】，慣【宋】【元】【明】【宮】"}
{"id": null, "n": "0737004", "target": "#nkr_note_mod_0737004", "type": "mod", "text": "（我本行…無作故）六百四字【宋】【元】【明】【宮】大異卷末出之"}
{"id": null, "n": "0738001", "target": "#nkr_note_mod_0738001", "type": "mod", "text": "提【大】，跋提【元】【明】"}
{"id": null, "n": "0738002", "target": "#nkr_note_mod_0738002", "type": "mod", "text": "性【大】，性眾生行無所有故【宋】【元】【明】"}
{"id": null, "n": "0738003", "target": "#nkr_note_mod_0738003", "type": "mod", "text": "照【大】，滿【宋】【元】【明】【宮】"}
{"id": null, "n": "0738004", "target": "#nkr_note_mod_0738004", "type": "mod", "text": "〔－〕【CB】【宋】【元】【明】【宮】，當【大】"}
{"id": null, "n": "0738005", "target": "#nkr_note_mod_0738005", "type": "mod", "text": "〔－〕【CB】【宋】【元】【明】【宮】，知【大】"}
{"id": null, "n": "0738006", "target": "#nkr_note_mod_0738006", "type": "mod", "text": "善女【大】，若【宋】【元】【明】【宮】"}
{"id": null, "n": "0739001", "target": "#nkr_note_mod_0739001", "type": "mod", "text": "（佛告…善說）六百十九字【大】，本文（佛言…斯義）九百十字【宋】【元】【明】【宮】"}
{"id": null, "n": "0739002", "target": "#nkr_note_mod_0739002", "type": "mod", "text": "住【大】，我住【元】"}
{"id": null, "n": "0739003", "target": "#nkr_note_mod_0739003", "type": "mod", "text": "此文（善男子…故）五百二十七字【大】，本文（我本行…故）六百四字【宋】【元】【明】【宮】"}
{"id": null, "n": "0739004", "target": "#nkr_note_mod_0739004", "type": "mod", "text": "（若善男子…波羅蜜）八十一字【大】，〔－〕【宮】"}
{"id": null, "n": "0739005", "target": "#nkr_note_mod_0739005", "type": "mod", "text": "若人不樂【大】，人樂不【宋】"}
{"id": null, "n": "0739006", "target": "#nkr_note_mod_0739006", "type": "mod", "text": "聽【大】，學【宋】"}
{"id": null, "n": "0732014", "target": "#nkr_note_orig_0732014", "type": "orig", "text": "〔國〕－【三】【宮】"}
{"id": null, "n": "0732015", "target": "#nkr_note_orig_0732015", "type": "orig", "text": "〔才〕－【三】【宮】"}
{"id": null, "n": "0733001", "target": "#nkr_note_orig_0733001", "type": "orig", "text": "頗梨＝玻𭹳【三】【宮】"}
{"id": null, "n": "0733002", "target": "#nkr_note_orig_0733002", "type": "orig", "text": "〔外〕－【三】【宮】"}
{"id": null, "n": "0733003", "target": "#nkr_note_orig_0733003", "type": "orig", "text": "加＝跏【三】"}
{"id": null, "n": "0733004", "target": "#nkr_note_orig_0733004", "type": "orig", "text": "非無＝有【宋】【元】【宮】"}
{"id": null, "n": "0733005", "target": "#nkr_note_orig_0733005", "type": "orig", "text": "等＋（故）【三】【宮】"}
{"id": null, "n": "0733006", "target": "#nkr_note_orig_0733006", "type": "orig", "text": "（云何…言）十二字＝舍利弗白文殊師利【三】【宮】"}
{"id": null, "n": "0733007", "target": "#nkr_note_orig_0733007", "type": "orig", "text": "觀＝覩【三】【宮】"}
{"id": null, "n": "0733008", "target": "#nkr_note_orig_0733008", "type": "orig", "text": "想＝相【三】【宮】"}
{"id": null, "n": "0733009", "target": "#nkr_note_orig_0733009", "type": "orig", "text": "汝＝爾【三】【宮】"}
{"id": null, "n": "0733010", "target": "#nkr_note_orig_0733010", "type": "orig", "text": "（佛告）＋文【元】【明】【宮】"}
{"id": null, "n": "0733011", "target": "#nkr_note_orig_0733011", "type": "orig", "text": "復＝人【明】【元】"}
{"id": null, "n": "0734001", "target": "#nkr_note_orig_0734001", "type": "orig", "text": "（汝）＋云【三】【宮】"}
{"id": null, "n": "0734002", "target": "#nkr_note_orig_0734002", "type": "orig", "text": "則＝我無所修我【元】【明】"}
{"id": null, "n": "0734003", "target": "#nkr_note_orig_0734003", "type": "orig", "text": "修＝學【元】【明】"}
{"id": null, "n": "0734004", "target": "#nkr_note_orig_0734004", "type": "orig", "text": "修＋（學）【元】【明】"}
{"id": null, "n": "0734005", "target": "#nkr_note_orig_0734005", "type": "orig", "text": "〔世尊〕－【元】"}
{"id": null, "n": "0734006", "target": "#nkr_note_orig_0734006", "type": "orig", "text": "修＋（是修）【三】【宮】"}
{"id": null, "n": "0734007", "target": "#nkr_note_orig_0734007", "type": "orig", "text": "〔法〕－【三】【宮】"}
{"id": null, "n": "0734008", "target": "#nkr_note_orig_0734008", "type": "orig", "text": "（佛法）＋凡【三】【宮】"}
{"id": null, "n": "0734009", "target": "#nkr_note_orig_0734009", "type": "orig", "text": "上無＝生死【三】【宮】"}
{"id": null, "n": "0734010", "target": "#nkr_note_orig_0734010", "type": "orig", "text": "法＝等法乎【元】【明】"}
{"id": null, "n": "0734011", "target": "#nkr_note_orig_0734011", "type": "orig", "text": "我＋（當）【元】【明】【宮】"}
{"id": null, "n": "0734012", "target": "#nkr_note_orig_0734012", "type": "orig", "text": "無有生＝無有性【元】【明】，無性【宋】【宮】"}
{"id": null, "n": "0734013", "target": "#nkr_note_orig_0734013", "type": "orig", "text": "〔法〕－【宋】【宮】"}
{"id": null, "n": "0734014", "target": "#nkr_note_orig_0734014", "type": "orig", "text": "（不得）＋法【元】【明】"}
{"id": null, "n": "0734015", "target": "#nkr_note_orig_0734015", "type": "orig", "text": "（不見）＋淨【元】【宮】"}
{"id": null, "n": "0734016", "target": "#nkr_note_orig_0734016", "type": "orig", "text": "〔法〕－【三】【宮】"}
{"id": null, "n": "0735001", "target": "#nkr_note_orig_0735001", "type": "orig", "text": "佛＋（言世尊）【元】【明】"}
{"id": null, "n": "0735002", "target": "#nkr_note_orig_0735002", "type": "orig", "text": "法可得＝佛法可住【元】【明】"}
{"id": null, "n": "0735003", "target": "#nkr_note_orig_0735003", "type": "orig", "text": "汝＋（今）【元】【明】"}
{"id": null, "n": "0735004", "target": "#nkr_note_orig_0735004", "type": "orig", "text": "〔師利〕－【三】【宮】＊"}
{"id": null, "n": "0735005", "target": "#nkr_note_orig_0735005", "type": "orig", "text": "深法＝深般若波羅蜜【元】【明】＊"}
{"id": null, "n": "0735006", "target": "#nkr_note_orig_0735006", "type": "orig", "text": "若＋（有）【元】【明】"}
{"id": null, "n": "0735007", "target": "#nkr_note_orig_0735007", "type": "orig", "text": "勝施主＋（無等施主）【元】【明】"}
{"id": null, "n": "0735008", "target": "#nkr_note_orig_0735008", "type": "orig", "text": "文殊＋（師利）【元】【明】"}
{"id": null, "n": "0735009", "target": "#nkr_note_orig_0735009", "type": "orig", "text": "白佛＋（言）【元】【明】"}
{"id": null, "n": "0735010", "target": "#nkr_note_orig_0735010", "type": "orig", "text": "〔如是〕－【元】【明】"}
{"id": null, "n": "0735011", "target": "#nkr_note_orig_0735011", "type": "orig", "text": "〔若〕－【元】【明】"}
{"id": null, "n": "0735012", "target": "#nkr_note_orig_0735012", "type": "orig", "text": "菩提＋（者）【元】【明】"}
{"id": null, "n": "0735013", "target": "#nkr_note_orig_0735013", "type": "orig", "text": "是＝相【宮】"}
{"id": null, "n": "0735014", "target": "#nkr_note_orig_0735014", "type": "orig", "text": "應如汝＝樂深法應當如所說學如【元】【明】"}
{"id": null, "n": "0735015", "target": "#nkr_note_orig_0735015", "type": "orig", "text": "不＋（於無量佛所深）【元】【明】"}
{"id": null, "n": "0735016", "target": "#nkr_note_orig_0735016", "type": "orig", "text": "（久）＋修【元】【明】"}
{"id": null, "n": "0735017", "target": "#nkr_note_orig_0735017", "type": "orig", "text": "〔何以故一切眾生則梵行相〕－【三】【宮】"}
{"id": null, "n": "0735018", "target": "#nkr_note_orig_0735018", "type": "orig", "text": "（不）＋見【宋】【宮】"}
{"id": null, "n": "0735019", "target": "#nkr_note_orig_0735019", "type": "orig", "text": "文殊＋（師利）【三】【宮】＊"}
{"id": null, "n": "0735020", "target": "#nkr_note_orig_0735020", "type": "orig", "text": "〔我〕－【元】【明】"}
{"id": null, "n": "0735021", "target": "#nkr_note_orig_0735021", "type": "orig", "text": "（以）＋不【三】【宮】"}
{"id": null, "n": "0735022", "target": "#nkr_note_orig_0735022", "type": "orig", "text": "（而）＋覺【三】【宮】"}
{"id": null, "n": "0735023", "target": "#nkr_note_orig_0735023", "type": "orig", "text": "（當有）＋法【元】重"}
