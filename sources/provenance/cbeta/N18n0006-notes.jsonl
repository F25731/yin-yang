{"id": null, "n": "0237001", "target": "#nkr_note_mod_0237001", "type": "mod", "text": "參照前經。（CBETA 按：漢譯南傳大藏經此頁中缺相對應之註標[01]，今於此處加上[01]之註標。）"}
{"id": null, "n": "0001001", "target": "#nkr_note_orig_0001001", "type": "orig", "text": "雜阿含二六．二（大正藏二．一八二a）。"}
{"id": null, "n": "0002001", "target": "#nkr_note_orig_0002001", "type": "orig", "text": "雜阿含二六．三（大正藏二．一八二b）。"}
{"id": null, "n": "0002001-1", "target": "#nkr_note_orig_0002001-1", "type": "orig", "text": "參照前經。"}
{"id": null, "n": "0003001", "target": "#nkr_note_orig_0003001", "type": "orig", "text": "雜阿含二六．四（大正藏二．一八二b）。"}
{"id": null, "n": "0003001-1", "target": "#nkr_note_orig_0003001-1", "type": "orig", "text": "參照前經。"}
{"id": null, "n": "0004001", "target": "#nkr_note_orig_0004001", "type": "orig", "text": "雜阿含二六．九（大正藏二．一八二c）。"}
{"id": null, "n": "0005001", "target": "#nkr_note_orig_0005001", "type": "orig", "text": "參照前經。"}
{"id": null, "n": "0006001", "target": "#nkr_note_orig_0006001", "type": "orig", "text": "雜阿含二六．五（大正藏二．一八二b），二六．三四（大正藏二．一八五c）。"}
{"id": null, "n": "0006001-1", "target": "#nkr_note_orig_0006001-1", "type": "orig", "text": "雜阿含二六．六（大正藏二．一八二b），二六．一四（大正藏二．一八三b）。"}
{"id": null, "n": "0007002", "target": "#nkr_note_orig_0007002", "type": "orig", "text": "不懼辛勞之重擔。"}
{"id": null, "n": "0008001", "target": "#nkr_note_orig_0008001", "type": "orig", "text": "參照前經。"}
{"id": null, "n": "0012001", "target": "#nkr_note_orig_0012001", "type": "orig", "text": "雜阿含二六．七（大正藏二．一八二c），二七．二四、二八（大正藏二．一九六c）。"}
{"id": null, "n": "0013001", "target": "#nkr_note_orig_0013001", "type": "orig", "text": "雜阿含二六．一二（大正藏二．一八三b）。"}
{"id": null, "n": "0014001", "target": "#nkr_note_orig_0014001", "type": "orig", "text": "雜阿含二六．一一（大正藏二．一八三a）。"}
{"id": null, "n": "0017001", "target": "#nkr_note_orig_0017001", "type": "orig", "text": "雜阿含二六．一一（大正藏二．一八三a）。"}
{"id": null, "n": "0018001", "target": "#nkr_note_orig_0018001", "type": "orig", "text": "雜阿含二六．八（大正藏二．一八二c）。"}
{"id": null, "n": "0019001", "target": "#nkr_note_orig_0019001", "type": "orig", "text": "雜阿含二六．九（大正藏二．一八二c）。"}
{"id": null, "n": "0020001", "target": "#nkr_note_orig_0020001", "type": "orig", "text": "雜阿含二六．一（大正藏二．一八二a）。其他參照大正藏一．五〇b、二二八a。"}
{"id": null, "n": "0020001-1", "target": "#nkr_note_orig_0020001-1", "type": "orig", "text": "雜阿含二六．一二（大正藏二．一八三b）。"}
{"id": null, "n": "0024001", "target": "#nkr_note_orig_0024001", "type": "orig", "text": "「知」，原本 ñāya 由暹羅本改為 aññāya。"}
{"id": null, "n": "0030001", "target": "#nkr_note_orig_0030001", "type": "orig", "text": "三六受相應第十經，參照（漢譯南傳大藏經第十五卷頁）。"}
{"id": null, "n": "0039001", "target": "#nkr_note_orig_0039001", "type": "orig", "text": "「信根即信力」，由原註：依勝解相之增上義的信根，不動於不信故為信力。比較過洲而東流之河，洲之東西水，唯一流水，而比南北之水，即如見為二流。"}
{"id": null, "n": "0050001", "target": "#nkr_note_orig_0050001", "type": "orig", "text": "雜阿含二六．一三（大正藏二．一八三b），二六．一五（同上二．一八三c）。"}
{"id": null, "n": "0060001", "target": "#nkr_note_orig_0060001", "type": "orig", "text": "雜阿含二七．二三、二七（大正藏二．一九六b）。"}
{"id": null, "n": "0065001", "target": "#nkr_note_orig_0065001", "type": "orig", "text": "漢譯南傳大藏經第十七卷一七九頁以下參照。"}
{"id": null, "n": "0067001", "target": "#nkr_note_orig_0067001", "type": "orig", "text": "此本之經數為十一經，原本之算法有誤，以下於原本註之算法多錯誤不能一一訂正。"}
{"id": null, "n": "0091001", "target": "#nkr_note_orig_0091001", "type": "orig", "text": "增一阿含二一．七（大正藏二．六五八a）。"}
{"id": null, "n": "0130001", "target": "#nkr_note_orig_0130001", "type": "orig", "text": "參照上第十五經目犍連之後半。"}
{"id": null, "n": "0140001", "target": "#nkr_note_orig_0140001", "type": "orig", "text": "雜阿含一九．三二（大正藏二．一三九a）。"}
{"id": null, "n": "0143001", "target": "#nkr_note_orig_0143001", "type": "orig", "text": "雜阿含一九．三三（大正藏二．一三九b）。"}
{"id": null, "n": "0144001", "target": "#nkr_note_orig_0144001", "type": "orig", "text": "雜阿含二〇．一（大正藏二．一三九c）。"}
{"id": null, "n": "0145001", "target": "#nkr_note_orig_0145001", "type": "orig", "text": "雜阿含二〇．六（大正藏二．一四〇c）。"}
{"id": null, "n": "0146001", "target": "#nkr_note_orig_0146001", "type": "orig", "text": "雜阿含二〇．七（大正藏二．一四一a）。"}
{"id": null, "n": "0147001", "target": "#nkr_note_orig_0147001", "type": "orig", "text": "雜阿含二〇．二（大正藏二．一四〇a）。"}
{"id": null, "n": "0147002", "target": "#nkr_note_orig_0147002", "type": "orig", "text": "「千世間」，此乃說長老之殊勝住。長老早晨洗顏，憶念過去未來一千劫，現在思念一千鐵圍山（出原註）。"}
{"id": null, "n": "0148001", "target": "#nkr_note_orig_0148001", "type": "orig", "text": "相應部經典原典五．五三頁（漢譯南傳大藏經第十七卷一九九頁），雜阿含二〇．九（大正藏二．一四一b）。"}
{"id": null, "n": "0151001", "target": "#nkr_note_orig_0151001", "type": "orig", "text": "雜阿含二〇．四、五（大正藏二．一四〇b）。"}
{"id": null, "n": "0153001", "target": "#nkr_note_orig_0153001", "type": "orig", "text": "雜阿含二〇．三（大正藏二．一四〇a）。"}
{"id": null, "n": "0156001", "target": "#nkr_note_orig_0156001", "type": "orig", "text": "括弧內相當於原文部分，不明瞭。"}
{"id": null, "n": "0164001", "target": "#nkr_note_orig_0164001", "type": "orig", "text": "雜阿含二九．七（大正藏二．二〇六a），別雜阿含一五（大正藏二．四九七a）。"}
{"id": null, "n": "0166001", "target": "#nkr_note_orig_0166001", "type": "orig", "text": "雜阿含二九．九（大正藏二．二〇六b）。"}
{"id": null, "n": "0166001-1", "target": "#nkr_note_orig_0166001-1", "type": "orig", "text": "參照上第一經。"}
{"id": null, "n": "0169001", "target": "#nkr_note_orig_0169001", "type": "orig", "text": "雜阿含二九．九（大正藏二．二〇六b）。"}
{"id": null, "n": "0170001", "target": "#nkr_note_orig_0170001", "type": "orig", "text": "雜阿含二九．一〇（大正藏二．二〇六c）。"}
{"id": null, "n": "0171001", "target": "#nkr_note_orig_0171001", "type": "orig", "text": "雜阿含二九．一八（大正藏二．二〇九a）。"}
{"id": null, "n": "0175001", "target": "#nkr_note_orig_0175001", "type": "orig", "text": "雜阿含二九．一三（大正藏二．二〇七b）。"}
{"id": null, "n": "0178001", "target": "#nkr_note_orig_0178001", "type": "orig", "text": "雜阿含二九．一七（大正藏二．二〇八c）。"}
{"id": null, "n": "0182001", "target": "#nkr_note_orig_0182001", "type": "orig", "text": "雜阿含二九．一一（大正藏二．二〇七a）。"}
{"id": null, "n": "0184001", "target": "#nkr_note_orig_0184001", "type": "orig", "text": "雜阿含二九．一二（大正藏二．二〇七b）。"}
{"id": null, "n": "0186001", "target": "#nkr_note_orig_0186001", "type": "orig", "text": "雜阿含二九．一四（大正藏二．二〇八a）。"}
{"id": null, "n": "0188002", "target": "#nkr_note_orig_0188002", "type": "orig", "text": "以下之文，原典六七以下（漢譯南傳大藏經第十七卷二二一頁）比較之。"}
{"id": null, "n": "0198001", "target": "#nkr_note_orig_0198001", "type": "orig", "text": "「行路」，參照漢譯南傳大藏經第十七卷一六〇頁。"}
{"id": null, "n": "0199001", "target": "#nkr_note_orig_0199001", "type": "orig", "text": "原文剩餘一行，非屬本文故省略之。"}
{"id": null, "n": "0199001-1", "target": "#nkr_note_orig_0199001-1", "type": "orig", "text": "本文經名，參照註。"}
{"id": null, "n": "0201001", "target": "#nkr_note_orig_0201001", "type": "orig", "text": "雜阿含三〇．六（大正藏二．二一四a）。"}
{"id": null, "n": "0202001", "target": "#nkr_note_orig_0202001", "type": "orig", "text": "雜阿含四一．七、八（大正藏二．二九八c）。"}
{"id": null, "n": "0204001", "target": "#nkr_note_orig_0204001", "type": "orig", "text": "雜阿含三七．一二（大正藏二．二七〇a）。"}
{"id": null, "n": "0207001", "target": "#nkr_note_orig_0207001", "type": "orig", "text": "雜阿含三〇．一五（大正藏二．二一五c）。"}
{"id": null, "n": "0208001", "target": "#nkr_note_orig_0208001", "type": "orig", "text": "雜阿含三〇．一四（大正藏二．二一五b）。"}
{"id": null, "n": "0209001", "target": "#nkr_note_orig_0209001", "type": "orig", "text": "雜阿含三〇．三一（大正藏二．二一八c）。"}
{"id": null, "n": "0209002", "target": "#nkr_note_orig_0209002", "type": "orig", "text": "「工匠」，此原語 thapati 有異解，今依原註（協會本三．七九頁）vaddhaki jeṭṭhako。"}
{"id": null, "n": "0213003", "target": "#nkr_note_orig_0213003", "type": "orig", "text": "「無有差別」，沒有「此是我們的，那是諸比丘的」之分別，其義為一切皆是布施物。"}
{"id": null, "n": "0214001", "target": "#nkr_note_orig_0214001", "type": "orig", "text": "雜阿含三七．二二（大正藏二．二七三b）。"}
{"id": null, "n": "0219001", "target": "#nkr_note_orig_0219001", "type": "orig", "text": "雜阿含三〇．二三．二四（大正藏二．二一七a）。長部經典原典第二卷九一頁以下參照。"}
{"id": null, "n": "0221001", "target": "#nkr_note_orig_0221001", "type": "orig", "text": "參照前經。"}
{"id": null, "n": "0222001", "target": "#nkr_note_orig_0222001", "type": "orig", "text": "雜阿含三〇．二五（大正藏二．二一七b）。"}
{"id": null, "n": "0225001", "target": "#nkr_note_orig_0225001", "type": "orig", "text": "雜阿含三〇．一三（大正藏二．二一五b）。"}
{"id": null, "n": "0229001", "target": "#nkr_note_orig_0229001", "type": "orig", "text": "雜阿含三〇．七（大正藏二．二一四b）。"}
{"id": null, "n": "0230001", "target": "#nkr_note_orig_0230001", "type": "orig", "text": "參照前經。"}
{"id": null, "n": "0231001", "target": "#nkr_note_orig_0231001", "type": "orig", "text": "參照其次之二經。"}
{"id": null, "n": "0233001", "target": "#nkr_note_orig_0233001", "type": "orig", "text": "同前經。但「生善趣、天界」，改為「生善趣、天世」。"}
{"id": null, "n": "0233001-1", "target": "#nkr_note_orig_0233001-1", "type": "orig", "text": "雜阿含四一．一五（大正藏二．二九九b）。"}
{"id": null, "n": "0235001", "target": "#nkr_note_orig_0235001", "type": "orig", "text": "雜阿含三三．一二（大正藏二．二三七b），別雜阿含八．二四（大正藏二．四三二b），增一阿含四一．一（大正藏二．七四四a）。"}
{"id": null, "n": "0237001", "target": "#nkr_note_orig_0237001", "type": "orig", "text": "參照前經。"}
{"id": null, "n": "0238001", "target": "#nkr_note_orig_0238001", "type": "orig", "text": "雜阿含三三．一七（大正藏二．二三九b）。別雜阿含八．二八（大正藏二．四三四a）。"}
{"id": null, "n": "0242001", "target": "#nkr_note_orig_0242001", "type": "orig", "text": "雜阿含三三．一八（大正藏二．二三九c）。別雜阿含八．二九（大正藏二．四三四b）。"}
{"id": null, "n": "0246001", "target": "#nkr_note_orig_0246001", "type": "orig", "text": "參照前經。"}
{"id": null, "n": "0250001", "target": "#nkr_note_orig_0250001", "type": "orig", "text": "雜阿含三七．一〇（大正藏二．二六九c）。"}
{"id": null, "n": "0255001", "target": "#nkr_note_orig_0255001", "type": "orig", "text": "雜阿含三七．九（大正藏二．二六九b）。"}
{"id": null, "n": "0258001", "target": "#nkr_note_orig_0258001", "type": "orig", "text": "雜阿含三〇．一七（大正藏二．二一六a）。增支部經典十集第九二經略為一致。"}
{"id": null, "n": "0261001", "target": "#nkr_note_orig_0261001", "type": "orig", "text": "參照前經。雜阿含三〇．一六（大正藏二．二一五c）。"}
{"id": null, "n": "0262001", "target": "#nkr_note_orig_0262001", "type": "orig", "text": "雜阿含三〇．四（大正藏二．二一三c）。"}
{"id": null, "n": "0264001", "target": "#nkr_note_orig_0264001", "type": "orig", "text": "雜阿含三〇．九（大正藏二．二一四c），四一．一一（大正藏二．二九九a）。"}
{"id": null, "n": "0266001", "target": "#nkr_note_orig_0266001", "type": "orig", "text": "雜阿含三〇．一一（大正藏二．二一五a），四一．一二、一三（大正藏二．二九九a）。"}
{"id": null, "n": "0267001", "target": "#nkr_note_orig_0267001", "type": "orig", "text": "雜阿含三〇．一一（大正藏二．二一五a），四一．一四、一五（大正藏二．二九九b）。"}
{"id": null, "n": "0267001-1", "target": "#nkr_note_orig_0267001-1", "type": "orig", "text": "雜阿含三〇．一八（大正藏二．二一六a）。"}
{"id": null, "n": "0269001", "target": "#nkr_note_orig_0269001", "type": "orig", "text": "雜阿含三〇．一九．二一（大正藏二．二一六b）。"}
{"id": null, "n": "0270001", "target": "#nkr_note_orig_0270001", "type": "orig", "text": "雜阿含經四一．四（大正藏二．二九八b）。"}
{"id": null, "n": "0270002", "target": "#nkr_note_orig_0270002", "type": "orig", "text": "「來」，原本及暹羅本俱作 ehi ti（ehiti），改為 ehiti（eti）之未來形。原本其語之前之 hoti 是衍字。"}
{"id": null, "n": "0271001", "target": "#nkr_note_orig_0271001", "type": "orig", "text": "雜阿含三三．九（大正藏二．二三六b）。別雜阿含八．二一（大正藏二．四三一b）。"}
{"id": null, "n": "0273001", "target": "#nkr_note_orig_0273001", "type": "orig", "text": "此譬如出增支部經典（原典一．二四三頁、二．一四〇頁、五．一一四頁）。"}
{"id": null, "n": "0273001-1", "target": "#nkr_note_orig_0273001-1", "type": "orig", "text": "雜阿含三七．一四（大正藏二．二七〇七b）。"}
{"id": null, "n": "0275001", "target": "#nkr_note_orig_0275001", "type": "orig", "text": "雜阿含三〇．二六（大正藏二．二一七c）。"}
{"id": null, "n": "0278001", "target": "#nkr_note_orig_0278001", "type": "orig", "text": "雜阿含三〇．一二（大正藏二．二一五a）。"}
{"id": null, "n": "0279002", "target": "#nkr_note_orig_0279002", "type": "orig", "text": "次偈出增支部四集第五一經。"}
{"id": null, "n": "0280001", "target": "#nkr_note_orig_0280001", "type": "orig", "text": "參照前經。"}
{"id": null, "n": "0282001", "target": "#nkr_note_orig_0282001", "type": "orig", "text": "此偈第四行尋原註皆不獲，漢譯北傳亦未詳，故暫以原本譯之。"}
{"id": null, "n": "0283001", "target": "#nkr_note_orig_0283001", "type": "orig", "text": "雜阿含經三〇．六（大正藏二．二一四a）。"}
{"id": null, "n": "0283001-1", "target": "#nkr_note_orig_0283001-1", "type": "orig", "text": "原本及暹羅本俱與前經完全一致，故不別出。"}
{"id": null, "n": "0284001", "target": "#nkr_note_orig_0284001", "type": "orig", "text": "雜阿含四一．六（大正藏二．二九八c）。"}
{"id": null, "n": "0284001-1", "target": "#nkr_note_orig_0284001-1", "type": "orig", "text": "雜阿含三〇．二七（大正藏二．二一八a）。"}
{"id": null, "n": "0285001", "target": "#nkr_note_orig_0285001", "type": "orig", "text": "雜阿含四一．三（大正藏二．二九八b）。"}
{"id": null, "n": "0286001", "target": "#nkr_note_orig_0286001", "type": "orig", "text": "雜阿含三三．一〇（大正藏二．二三六c）。別雜八．二二（大正藏二．四三一b）。"}
{"id": null, "n": "0287001", "target": "#nkr_note_orig_0287001", "type": "orig", "text": "雜阿含四一．五（大正藏二．二九八c）。"}
{"id": null, "n": "0291001", "target": "#nkr_note_orig_0291001", "type": "orig", "text": "雜阿含三七．一一（大正藏二．二七〇a）。"}
{"id": null, "n": "0293001", "target": "#nkr_note_orig_0293001", "type": "orig", "text": "雜阿含四一．二（大正藏二．二九七c）。"}
{"id": null, "n": "0301001", "target": "#nkr_note_orig_0301001", "type": "orig", "text": "雜阿含一六．二三（大正藏二．一一二a）。"}
{"id": null, "n": "0302001", "target": "#nkr_note_orig_0302001", "type": "orig", "text": "雜阿含一六．二二（大正藏二．一一二a）。"}
{"id": null, "n": "0302001-1", "target": "#nkr_note_orig_0302001-1", "type": "orig", "text": "雜阿含一五．二九（大正藏二．一〇六a）。"}
{"id": null, "n": "0303001", "target": "#nkr_note_orig_0303001", "type": "orig", "text": "參照前經。"}
{"id": null, "n": "0304001", "target": "#nkr_note_orig_0304001", "type": "orig", "text": "雜阿含一五．二六（大正藏二．一〇五b）。"}
{"id": null, "n": "0305001", "target": "#nkr_note_orig_0305001", "type": "orig", "text": "雜阿含一五．二七（大正藏二．一〇五c）。"}
{"id": null, "n": "0306001", "target": "#nkr_note_orig_0306001", "type": "orig", "text": "雜阿含一六．三、四（大正藏二．一〇九b）。"}
{"id": null, "n": "0307001", "target": "#nkr_note_orig_0307001", "type": "orig", "text": "雜阿含一六．二（大正藏二．一〇九a）。"}
{"id": null, "n": "0308001", "target": "#nkr_note_orig_0308001", "type": "orig", "text": "雜阿含一六．六（大正藏二．一〇九c）。"}
{"id": null, "n": "0309001", "target": "#nkr_note_orig_0309001", "type": "orig", "text": "雜阿含一六．五（大正藏二．一〇九c）此經列舉論之項目，是長部經典第一卷七頁、一七八頁，第三卷三六頁、五四頁，中部經典第一卷五一三頁，第二卷一頁、二三頁、三〇頁，第三卷一一三頁，增支部經典第五卷一二八頁，律藏第一卷一一八頁，第四卷一六四頁等（皆指原典）。"}
{"id": null, "n": "0311001", "target": "#nkr_note_orig_0311001", "type": "orig", "text": "律藏大品一．六（原典一〇頁以下），雜阿含一五．一五（大正藏二．一〇三c），轉法輪經（大正藏二．五〇三），三轉法輪經（大正藏二．五〇四），四分律三二（大正藏二二．七八八），五分律一五（大正藏二二．一〇四），法蘊足論六（大正藏二六．四七九b）等。其他亦有梵本。"}
{"id": null, "n": "0315001", "target": "#nkr_note_orig_0315001", "type": "orig", "text": "參照前經。"}
{"id": null, "n": "0316001", "target": "#nkr_note_orig_0316001", "type": "orig", "text": "雜阿含一五．二四（大正藏二．一〇五a）。"}
{"id": null, "n": "0318001", "target": "#nkr_note_orig_0318001", "type": "orig", "text": "參照前經。"}
{"id": null, "n": "0319001", "target": "#nkr_note_orig_0319001", "type": "orig", "text": "雜阿含一六．一〇（大正藏二．一一〇b）。"}
{"id": null, "n": "0320001", "target": "#nkr_note_orig_0320001", "type": "orig", "text": "雜阿含一六．一二（大正藏二．一一〇c）。"}
{"id": null, "n": "0324001", "target": "#nkr_note_orig_0324001", "type": "orig", "text": "雜阿含經一六．一一（大正藏二．一一〇b）。"}
{"id": null, "n": "0325001", "target": "#nkr_note_orig_0325001", "type": "orig", "text": "長部經典（原典二．九〇頁），律藏大品（原典二．三〇頁），雜阿含一五．三九（大正藏二．一〇八a），其他長部經典（原典二．一二二頁）。"}
{"id": null, "n": "0327001", "target": "#nkr_note_orig_0327001", "type": "orig", "text": "雜阿含一五．二八（大正藏二．一〇五c）。"}
{"id": null, "n": "0327002", "target": "#nkr_note_orig_0327002", "type": "orig", "text": "此偈與經集第七二四～七二七同。"}
{"id": null, "n": "0327002", "target": "#nkr_note_mod_0327002", "type": "mod", "text": "此偈與經集第七二四【南傳】，～七二七同。"}
{"id": null, "n": "0329001", "target": "#nkr_note_orig_0329001", "type": "orig", "text": "雜阿含一五．三八（大正藏二．一〇七c）。"}
{"id": null, "n": "0330001", "target": "#nkr_note_orig_0330001", "type": "orig", "text": "前經參照。"}
{"id": null, "n": "0331001", "target": "#nkr_note_orig_0331001", "type": "orig", "text": "雜阿含經一五．二〇（大正藏二．一〇四b）。"}
{"id": null, "n": "0331001-1", "target": "#nkr_note_orig_0331001-1", "type": "orig", "text": "雜阿含三〇．七（大正藏二．二一四b）。"}
{"id": null, "n": "0332001", "target": "#nkr_note_orig_0332001", "type": "orig", "text": "雜阿含一六．一一（大正藏二．一一〇b）。"}
{"id": null, "n": "0333001", "target": "#nkr_note_orig_0333001", "type": "orig", "text": "雜阿含一六．二一（大正藏二．一一二a）。"}
{"id": null, "n": "0336001", "target": "#nkr_note_orig_0336001", "type": "orig", "text": "雜阿含一五．四〇（大正藏二．一〇八a）。"}
{"id": null, "n": "0337001", "target": "#nkr_note_orig_0337001", "type": "orig", "text": "雜阿含一五．三三（大正藏二．一〇七a）。"}
{"id": null, "n": "0338001", "target": "#nkr_note_orig_0338001", "type": "orig", "text": "雜阿含一六．二五（大正藏二．一一二b）。"}
{"id": null, "n": "0339001", "target": "#nkr_note_orig_0339001", "type": "orig", "text": "雜阿含一五．三六（大正藏二．一〇七b）。"}
{"id": null, "n": "0340001", "target": "#nkr_note_orig_0340001", "type": "orig", "text": "雜阿含一五．三七（大正藏二．一〇七c）。"}
{"id": null, "n": "0341001", "target": "#nkr_note_orig_0341001", "type": "orig", "text": "雜阿含一六．三二（大正藏二．一一三b）。"}
{"id": null, "n": "0342001", "target": "#nkr_note_orig_0342001", "type": "orig", "text": "雜阿含一五．三〇（大正藏二．一〇六b）。"}
{"id": null, "n": "0342001-1", "target": "#nkr_note_orig_0342001-1", "type": "orig", "text": "雜阿含一五．三一（大正藏二．一〇六c）。"}
{"id": null, "n": "0343001", "target": "#nkr_note_orig_0343001", "type": "orig", "text": "雜阿含一五．三四（大正藏二．一〇七a）。"}
{"id": null, "n": "0345001", "target": "#nkr_note_orig_0345001", "type": "orig", "text": "雜阿含一五．三五（大正藏二．一〇七b）。"}
{"id": null, "n": "0347001", "target": "#nkr_note_orig_0347001", "type": "orig", "text": "雜阿含一六．一（大正藏二．一〇八c）。"}
{"id": null, "n": "0348002", "target": "#nkr_note_orig_0348002", "type": "orig", "text": "「怖畏」，從原本之讀法。異本有 mohayamānā 原註由此譯為「欺諸天之心」。"}
{"id": null, "n": "0350001", "target": "#nkr_note_orig_0350001", "type": "orig", "text": "雜阿含一六．一五（大正藏二．一一一a）。"}
{"id": null, "n": "0350002", "target": "#nkr_note_orig_0350002", "type": "orig", "text": "「辯才峯」，原註言似於山之一大巖石。非固有名詞，我取其字義之試譯。"}
{"id": null, "n": "0352001", "target": "#nkr_note_orig_0352001", "type": "orig", "text": "雜阿含一六．一六（大正藏二．一一一b）。"}
{"id": null, "n": "0354001", "target": "#nkr_note_orig_0354001", "type": "orig", "text": "雜阿含一六．三〇、三一（大正藏二．一一三a）。原本節號重復，訂正之。"}
{"id": null, "n": "0356001", "target": "#nkr_note_orig_0356001", "type": "orig", "text": "雜阿含一五．四一（大正藏二．一〇八b）。此經名參照品末之攝頌。"}
{"id": null, "n": "0357001", "target": "#nkr_note_orig_0357001", "type": "orig", "text": "雜阿含一六．一七（大正藏二．二一b）。"}
{"id": null, "n": "0359001", "target": "#nkr_note_orig_0359001", "type": "orig", "text": "雜阿含一五．四二（大正藏二．一〇八c）中部經典原典三．一六九頁。漢譯南傳大藏經第十二頁。"}
{"id": null, "n": "0361001", "target": "#nkr_note_orig_0361001", "type": "orig", "text": "參照前經。"}
{"id": null, "n": "0361002", "target": "#nkr_note_orig_0361002", "type": "orig", "text": "「悉是水」，漢譯北傳相當於此，有大地悉成大海。"}
{"id": null, "n": "0361003", "target": "#nkr_note_orig_0361003", "type": "orig", "text": "難得，adhicca 是有緣而生，原註：若軛不腐、海水不乾、龜不死者。"}
{"id": null, "n": "0362001", "target": "#nkr_note_orig_0362001", "type": "orig", "text": "雜阿含一六．三三（大正藏二．一一三b）。"}
{"id": null, "n": "0365001", "target": "#nkr_note_orig_0365001", "type": "orig", "text": "本品十經，比較第八現觀相應（漢譯南傳大藏經典）相應部二〔一三〕。"}
{"id": null, "n": "0365002", "target": "#nkr_note_orig_0365002", "type": "orig", "text": "雜阿含一六．三六（大正藏二．一一四a）。"}
{"id": null, "n": "0366001", "target": "#nkr_note_orig_0366001", "type": "orig", "text": "雜阿含一六．三四（大正藏二．一一三c）。"}
{"id": null, "n": "0366001-1", "target": "#nkr_note_orig_0366001-1", "type": "orig", "text": "雜阿含一六．三五（大正藏二．一一三c）。"}
{"id": null, "n": "0368001", "target": "#nkr_note_orig_0368001", "type": "orig", "text": "雜阿含一六．三五（大正藏二．一一四a）。"}
{"id": null, "n": "0372001", "target": "#nkr_note_orig_0372001", "type": "orig", "text": "以下，品之名目從暹羅本。"}
{"id": null, "n": "0372002", "target": "#nkr_note_orig_0372002", "type": "orig", "text": "以下至卷末皆是雜阿含一六．三六（大正藏二．一一四b）。"}
{"id": null, "n": "0381001", "target": "#nkr_note_orig_0381001", "type": "orig", "text": "見原本省去六經，而舉此一經，據會令誤解品末之攝頌，今怕增麻煩，不敢改經號，但實可數為一經。"}
{"id": null, "n": "0382001", "target": "#nkr_note_orig_0382001", "type": "orig", "text": "原本以下為第十一「五趣品，以暹羅分之，後者亦然」。"}
{"id": null, "n": "0386001", "target": "#nkr_note_orig_0386001", "type": "orig", "text": "此攝頌暹羅本沒有。"}
