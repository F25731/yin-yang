{"id": null, "n": null, "target": null, "type": null, "text": "脩六度萬行三心圓發得證法身佛"}
{"id": null, "n": null, "target": null, "type": null, "text": "脩次第觀行六度行得成大乘菩薩"}
{"id": null, "n": null, "target": null, "type": null, "text": "脩躰法空觀十二因緣行道成緣覺"}
{"id": null, "n": null, "target": null, "type": null, "text": "脩析法空觀依四諦行道成阿羅漢"}
{"id": null, "n": null, "target": null, "type": null, "text": "脩上品十善兼脩禪定故得生天趣"}
{"id": null, "n": null, "target": null, "type": null, "text": "脩中品十善五戒五常故得為人倫"}
{"id": null, "n": null, "target": null, "type": null, "text": "脩下品十善五常欲勝他故為修羅"}
{"id": null, "n": null, "target": null, "type": null, "text": "作下等十惡正作能悔故為餓鬼趣"}
{"id": null, "n": null, "target": null, "type": null, "text": "作中等十惡作已能悔故為畜生類"}
{"id": null, "n": null, "target": null, "type": null, "text": "作上等十惡作已不悔故墮地獄趣"}
{"id": null, "n": null, "target": null, "type": null, "text": "出詠史詩"}
{"id": null, "n": null, "target": null, "type": null, "text": "出莊子"}
{"id": null, "n": null, "target": null, "type": null, "text": "出史記"}
{"id": null, "n": null, "target": null, "type": null, "text": "出法數畧要"}
{"id": null, "n": null, "target": null, "type": null, "text": "出旧吳書并宗炳明佛論編年通載等書"}
{"id": null, "n": null, "target": null, "type": null, "text": "出漢書西域傳"}
{"id": null, "n": null, "target": null, "type": null, "text": "出魏書佛老志"}
{"id": null, "n": null, "target": null, "type": null, "text": "出史\n畧等"}
