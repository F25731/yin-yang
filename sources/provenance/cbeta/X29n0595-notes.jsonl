{"id": null, "n": null, "target": null, "type": null, "text": "即滅化城，語眾人言，向下釋也。疏同喻文末也"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋入經文"}
{"id": null, "n": null, "target": null, "type": null, "text": "三又音盡，又不對，烏卦反也"}
{"id": null, "n": null, "target": null, "type": null, "text": "多音"}
{"id": null, "n": null, "target": null, "type": null, "text": "上呼天也"}
{"id": null, "n": null, "target": null, "type": null, "text": "云\n云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "慈呂反"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "或本云此下別破五師繁不寫，今依唐本寫之"}
{"id": null, "n": null, "target": null, "type": null, "text": "據本門字問理論，應門字固定"}
{"id": null, "n": null, "target": null, "type": null, "text": "對一〔對〕，是故云無也。即能非無，無不而能，句無\n不無，四句無方即是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "正法華名師子孔菩薩"}
{"id": null, "n": null, "target": null, "type": null, "text": "文中有種寶"}
{"id": null, "n": null, "target": null, "type": null, "text": "一身即世三身"}
{"id": null, "n": null, "target": null, "type": null, "text": "三身即一身"}
{"id": null, "n": null, "target": null, "type": null, "text": "無性故"}
{"id": null, "n": null, "target": null, "type": null, "text": "從因\n緣生"}
{"id": null, "n": null, "target": null, "type": null, "text": "涌出品後"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X29n0596_p0396c22"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X29n0596_p0396c22"}
{"id": null, "n": "0143001", "target": "#nkr_note_mod_0143001", "type": "mod", "text": "也疑已"}
{"id": null, "n": "0118001", "target": "#nkr_note_orig_0118001", "type": "orig", "text": "聞疑開"}
{"id": null, "n": "0120001", "target": "#nkr_note_orig_0120001", "type": "orig", "text": "遂疑逐下同"}
{"id": null, "n": "0120002", "target": "#nkr_note_orig_0120002", "type": "orig", "text": "輿疑與下同"}
{"id": null, "n": "0121001", "target": "#nkr_note_orig_0121001", "type": "orig", "text": "論疑淪"}
{"id": null, "n": "0122001", "target": "#nkr_note_orig_0122001", "type": "orig", "text": "凸疑亞"}
{"id": null, "n": "0123001", "target": "#nkr_note_orig_0123001", "type": "orig", "text": "窂疑罕下同"}
{"id": null, "n": "0124001", "target": "#nkr_note_orig_0124001", "type": "orig", "text": "熾疑幟"}
{"id": null, "n": "0131001", "target": "#nkr_note_orig_0131001 #note_star_1 #note_star_2", "type": "orig", "text": "微疑徵下同"}
{"id": null, "n": "0133001", "target": "#nkr_note_orig_0133001", "type": "orig", "text": "唯疑准"}
{"id": null, "n": "0137001", "target": "#nkr_note_orig_0137001", "type": "orig", "text": "踊應作涌"}
{"id": null, "n": "0137002", "target": "#nkr_note_orig_0137002", "type": "orig", "text": "瞙疑瞑"}
{"id": null, "n": "0138001", "target": "#nkr_note_orig_0138001", "type": "orig", "text": "＊祥應作詳（詳ハ本文ニ祥トツクル。󴦒）"}
{"id": null, "n": "0138002", "target": "#nkr_note_orig_0138002", "type": "orig", "text": "或疑哉"}
{"id": null, "n": "0139001", "target": "#nkr_note_orig_0139001", "type": "orig", "text": "名疑各"}
{"id": null, "n": "0140001", "target": "#nkr_note_orig_0140001", "type": "orig", "text": "監應作濫"}
{"id": null, "n": "0142001", "target": "#nkr_note_orig_0142001", "type": "orig", "text": "次疑初"}
{"id": null, "n": "0142002", "target": "#nkr_note_orig_0142002", "type": "orig", "text": "人恐入更勘"}
{"id": null, "n": "0143001", "target": "#nkr_note_orig_0143001", "type": "orig", "text": "也疑巳"}
{"id": null, "n": "0143002", "target": "#nkr_note_orig_0143002", "type": "orig", "text": "對疑諦"}
{"id": null, "n": "0144001", "target": "#nkr_note_orig_0144001", "type": "orig", "text": "也疑之"}
{"id": null, "n": "0144002", "target": "#nkr_note_orig_0144002 #note_star_3", "type": "orig", "text": "久疑文次同"}
