{"id": null, "n": null, "target": null, "type": null, "text": "四十八"}
{"id": null, "n": "0299017", "target": null, "type": "orig", "text": "丙本奧墨書云元祿八年三月十五日點寫畢尊教同九年五月二日一校畢尊教元祿十五年十二月二日以和上御本再校了尊教"}
{"id": null, "n": null, "target": null, "type": null, "text": "四十八"}
{"id": null, "n": null, "target": null, "type": null, "text": "四十八"}
{"id": null, "n": "0297020", "target": "#nkr_note_mod_0297020", "type": "mod", "text": "（特進…譯）二十一字【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0297021", "target": "#nkr_note_mod_0297021", "type": "mod", "text": "都【大】，覩【甲】【乙】"}
{"id": null, "n": "0297022", "target": "#nkr_note_mod_0297022", "type": "mod", "text": "生【大】，生于【乙】"}
{"id": null, "n": "0297023", "target": "#nkr_note_mod_0297023", "type": "mod", "text": "起【大】，赴【乙】"}
{"id": null, "n": "0297024", "target": "#nkr_note_mod_0297024", "type": "mod", "text": "姓【大】，性【乙】"}
{"id": null, "n": "0297025", "target": "#nkr_note_mod_0297025", "type": "mod", "text": "意【大】，密【甲】【乙】"}
{"id": null, "n": "0297026", "target": "#nkr_note_mod_0297026", "type": "mod", "text": "剛【大】，〔－〕【考偽-原】"}
{"id": null, "n": "0298001", "target": "#nkr_note_mod_0298001", "type": "mod", "text": "故是【大】，皆【乙】"}
{"id": null, "n": "0298002", "target": "#nkr_note_mod_0298002", "type": "mod", "text": "智【大】，廣智【甲】"}
{"id": null, "n": "0298003", "target": "#nkr_note_mod_0298003", "type": "mod", "text": "心【大】，心色【乙】【丙】"}
{"id": null, "n": "0298005", "target": "#nkr_note_mod_0298005", "type": "mod", "text": "現等【大】，〔－〕【乙】"}
{"id": null, "n": "0298006", "target": "#nkr_note_mod_0298006", "type": "mod", "text": "方【大】，方之【甲】【乙】"}
{"id": null, "n": "0298007", "target": "#nkr_note_mod_0298007", "type": "mod", "text": "即【大】下同，則【甲】【乙】下同"}
{"id": null, "n": "0298008", "target": "#nkr_note_mod_0298008", "type": "mod", "text": "蜜【大】下同，密【乙】下同"}
{"id": null, "n": "0298009", "target": "#nkr_note_mod_0298009", "type": "mod", "text": "是【大】，是乎【乙】"}
{"id": null, "n": "0298010", "target": "#nkr_note_mod_0298010", "type": "mod", "text": "智【大】，〔－〕【乙】"}
{"id": null, "n": "0298011", "target": "#nkr_note_mod_0298011", "type": "mod", "text": "舍【大】＊，遮【乙】＊"}
{"id": null, "n": "0298012", "target": "#nkr_note_mod_0298012", "type": "mod", "text": "護【大】，〔－〕【乙】"}
{"id": null, "n": "0298013", "target": "#nkr_note_mod_0298013", "type": "mod", "text": "來【大】，來菩提【甲】【乙】"}
{"id": null, "n": "0298014", "target": "#nkr_note_mod_0298014", "type": "mod", "text": "如來【大】，〔－〕【乙】"}
{"id": null, "n": "0298015", "target": "#nkr_note_mod_0298015", "type": "mod", "text": "戲【大】，無戲【丙】"}
{"id": null, "n": "0298016", "target": "#nkr_note_mod_0298016", "type": "mod", "text": "藏【大】，〔－〕【乙】"}
{"id": null, "n": "0298017", "target": "#nkr_note_mod_0298017", "type": "mod", "text": "工【大】，〔－〕【乙】"}
{"id": null, "n": "0298018", "target": "#nkr_note_mod_0298018", "type": "mod", "text": "幖【大】，標【乙】"}
{"id": null, "n": "0298020", "target": "#nkr_note_mod_0298020", "type": "mod", "text": "操蘗本作摻＊"}
{"id": null, "n": "0298021", "target": "#nkr_note_mod_0298021", "type": "mod", "text": "雲海【大】，海雲【乙】【丙】"}
{"id": null, "n": "0298022", "target": "#nkr_note_mod_0298022", "type": "mod", "text": "也如此【大】，如此也【考偽-丙】"}
{"id": null, "n": "0298023", "target": "#nkr_note_mod_0298023", "type": "mod", "text": "耳【大】，多【乙】"}
{"id": null, "n": "0298024", "target": "#nkr_note_mod_0298024", "type": "mod", "text": "五【大】，五頂【乙】"}
{"id": null, "n": "0298025", "target": "#nkr_note_mod_0298025", "type": "mod", "text": "方不【大】，不可【乙】，方不可【校異-丙】"}
{"id": null, "n": "0298027", "target": "#nkr_note_mod_0298027", "type": "mod", "text": "慧【大】＊，惠【乙】＊"}
{"id": null, "n": "0298030", "target": "#nkr_note_mod_0298030", "type": "mod", "text": "則【大】，〔－〕【乙】"}
{"id": null, "n": "0298032", "target": "#nkr_note_mod_0298032", "type": "mod", "text": "滴【大】，海【乙】，蘗本同之"}
{"id": null, "n": "0298033", "target": "#nkr_note_mod_0298033", "type": "mod", "text": "住【大】，位【乙】"}
{"id": null, "n": "0298035", "target": "#nkr_note_mod_0298035", "type": "mod", "text": "率【大】，窣【丙】"}
{"id": null, "n": "0298036", "target": "#nkr_note_mod_0298036", "type": "mod", "text": "婆【大】，波【乙】"}
{"id": null, "n": "0298037", "target": "#nkr_note_mod_0298037", "type": "mod", "text": "何況【大】，佛地【乙】"}
{"id": null, "n": "0298038", "target": "#nkr_note_mod_0298038", "type": "mod", "text": "現【大】，賢【乙】"}
{"id": null, "n": "0298039", "target": "#nkr_note_mod_0298039", "type": "mod", "text": "理【大】，功【考偽-丙】"}
{"id": null, "n": "0299001", "target": "#nkr_note_mod_0299001", "type": "mod", "text": "既【大】，既異【乙】"}
{"id": null, "n": "0299002", "target": "#nkr_note_mod_0299002", "type": "mod", "text": "壇【大】，檀【乙】"}
{"id": null, "n": "0299003", "target": "#nkr_note_mod_0299003", "type": "mod", "text": "持【大】，持以【乙】"}
{"id": null, "n": "0299005", "target": "#nkr_note_mod_0299005", "type": "mod", "text": "自【大】，曰【甲】"}
{"id": null, "n": "0299006", "target": "#nkr_note_mod_0299006", "type": "mod", "text": "數【大】，又數【乙】"}
{"id": null, "n": "0299007", "target": "#nkr_note_mod_0299007", "type": "mod", "text": "力【大】，方【甲】【乙】"}
{"id": null, "n": "0299008", "target": "#nkr_note_mod_0299008", "type": "mod", "text": "後【大】，〔－〕【乙】"}
{"id": null, "n": "0299009", "target": "#nkr_note_mod_0299009", "type": "mod", "text": "󰂋嶠【大】，家嫡【乙】"}
{"id": null, "n": "0299010", "target": "#nkr_note_mod_0299010", "type": "mod", "text": "准【大】，唯【考偽-原】"}
{"id": null, "n": "0299011", "target": "#nkr_note_mod_0299011", "type": "mod", "text": "藩【大】，蕃【乙】"}
{"id": null, "n": "0299012", "target": "#nkr_note_mod_0299012", "type": "mod", "text": "墮【大】，隨【乙】"}
{"id": null, "n": "0299013", "target": "#nkr_note_mod_0299013", "type": "mod", "text": "觀【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0299014", "target": "#nkr_note_mod_0299014", "type": "mod", "text": "金剛頂瑜伽三十七尊【大】，〔－〕【甲】"}
{"id": null, "n": "0299016", "target": "#nkr_note_mod_0299016", "type": "mod", "text": "（靈雲…八）四十二字【大】，〔－〕【甲】【乙】，〔靈雲…云〕六字－【丙】"}
{"id": null, "n": "0297018", "target": "#nkr_note_orig_0297018", "type": "orig", "text": "【原】縮刷大藏經，【甲】保延三年寫高山寺藏本，【乙】鎌倉時代寫仁和寺藏本，【丙】黃蘗版淨嚴等校訂加筆本塚本賢曉氏藏"}
{"id": null, "n": "0297019", "target": "#nkr_note_orig_0297019", "type": "orig", "text": "義蘗本作儀"}
{"id": null, "n": "0297020", "target": "#nkr_note_orig_0297020", "type": "orig", "text": "〔特進…譯〕二十一字－【甲】【乙】"}
{"id": null, "n": "0297021", "target": "#nkr_note_orig_0297021", "type": "orig", "text": "都＝覩【甲】【乙】"}
{"id": null, "n": "0297022", "target": "#nkr_note_orig_0297022", "type": "orig", "text": "生＋（于）【乙】"}
{"id": null, "n": "0297023", "target": "#nkr_note_orig_0297023", "type": "orig", "text": "起＝赴【乙】"}
{"id": null, "n": "0297024", "target": "#nkr_note_orig_0297024", "type": "orig", "text": "姓＝性【乙】"}
{"id": null, "n": "0297025", "target": "#nkr_note_orig_0297025", "type": "orig", "text": "意＝密【甲】【乙】"}
{"id": null, "n": "0297026", "target": "#nkr_note_orig_0297026", "type": "orig", "text": "〔剛〕－ヵ【原】"}
{"id": null, "n": "0298001", "target": "#nkr_note_orig_0298001", "type": "orig", "text": "故是＝皆【乙】"}
{"id": null, "n": "0298002", "target": "#nkr_note_orig_0298002", "type": "orig", "text": "（廣）＋智【甲】"}
{"id": null, "n": "0298003", "target": "#nkr_note_orig_0298003", "type": "orig", "text": "心＋（色）【乙】【丙】"}
{"id": null, "n": "0298004", "target": "#nkr_note_orig_0298004", "type": "orig", "text": "藏蘗本作機"}
{"id": null, "n": "0298005", "target": "#nkr_note_orig_0298005", "type": "orig", "text": "〔現等〕－【乙】"}
{"id": null, "n": "0298006", "target": "#nkr_note_orig_0298006", "type": "orig", "text": "方＋（之）【甲】【乙】"}
{"id": null, "n": "0298007", "target": "#nkr_note_orig_0298007", "type": "orig", "text": "即＝則【甲】【乙】下同"}
{"id": null, "n": "0298008", "target": "#nkr_note_orig_0298008", "type": "orig", "text": "蜜＝密【乙】下同"}
{"id": null, "n": "0298009", "target": "#nkr_note_orig_0298009", "type": "orig", "text": "是＋（乎）【乙】"}
{"id": null, "n": "0298010", "target": "#nkr_note_orig_0298010", "type": "orig", "text": "〔智〕－【乙】"}
{"id": null, "n": "0298011", "target": "#nkr_note_orig_0298011", "type": "orig", "text": "舍＝遮【乙】＊"}
{"id": null, "n": "0298012", "target": "#nkr_note_orig_0298012", "type": "orig", "text": "〔護〕－【乙】"}
{"id": null, "n": "0298013", "target": "#nkr_note_orig_0298013", "type": "orig", "text": "來＋（菩提）【甲】【乙】"}
{"id": null, "n": "0298014", "target": "#nkr_note_orig_0298014", "type": "orig", "text": "〔如來〕－【乙】"}
{"id": null, "n": "0298015", "target": "#nkr_note_orig_0298015", "type": "orig", "text": "（無）＋戲【丙】"}
{"id": null, "n": "0298016", "target": "#nkr_note_orig_0298016", "type": "orig", "text": "〔藏〕－【乙】"}
{"id": null, "n": "0298017", "target": "#nkr_note_orig_0298017", "type": "orig", "text": "〔工〕－【乙】"}
{"id": null, "n": "0298018", "target": "#nkr_note_orig_0298018", "type": "orig", "text": "幖＝標【乙】"}
{"id": null, "n": "0298019", "target": "#nkr_note_orig_0298019", "type": "orig", "text": "堅蘗本作竪"}
{"id": null, "n": "0298020", "target": "#nkr_note_orig_0298020", "type": "orig", "text": "操蘗本作摻＊"}
{"id": null, "n": "0298021", "target": "#nkr_note_orig_0298021", "type": "orig", "text": "雲海＝海雲【乙】【丙】"}
{"id": null, "n": "0298022", "target": "#nkr_note_orig_0298022", "type": "orig", "text": "也如此＝如此也ヵ【丙】"}
{"id": null, "n": "0298023", "target": "#nkr_note_orig_0298023", "type": "orig", "text": "耳＝多【乙】"}
{"id": null, "n": "0298024", "target": "#nkr_note_orig_0298024", "type": "orig", "text": "五＋（頂）【乙】"}
{"id": null, "n": "0298025", "target": "#nkr_note_orig_0298025", "type": "orig", "text": "方不＝不可【乙】，方不可ィ【丙】"}
{"id": null, "n": "0298026", "target": "#nkr_note_orig_0298026", "type": "orig", "text": "孰蘗本作熟"}
{"id": null, "n": "0298027", "target": "#nkr_note_orig_0298027", "type": "orig", "text": "慧＝惠【乙】"}
{"id": null, "n": "0298028", "target": "#nkr_note_orig_0298028", "type": "orig", "text": "吒蘗本作叱"}
{"id": null, "n": "0298029", "target": "#nkr_note_orig_0298029", "type": "orig", "text": "指顧蘗本作指頤"}
{"id": null, "n": "0298030", "target": "#nkr_note_orig_0298030", "type": "orig", "text": "〔則〕－【乙】"}
{"id": null, "n": "0298031", "target": "#nkr_note_orig_0298031", "type": "orig", "text": "懾蘗本作攝"}
{"id": null, "n": "0298032", "target": "#nkr_note_orig_0298032", "type": "orig", "text": "滴＝海【乙】，蘗本同之"}
{"id": null, "n": "0298033", "target": "#nkr_note_orig_0298033", "type": "orig", "text": "住＝位【乙】"}
{"id": null, "n": "0298034", "target": "#nkr_note_orig_0298034", "type": "orig", "text": "蘗本無數字"}
{"id": null, "n": "0298035", "target": "#nkr_note_orig_0298035", "type": "orig", "text": "率＝窣【丙】"}
{"id": null, "n": "0298036", "target": "#nkr_note_orig_0298036", "type": "orig", "text": "婆＝波【乙】"}
{"id": null, "n": "0298037", "target": "#nkr_note_orig_0298037", "type": "orig", "text": "何況＝佛地【乙】"}
{"id": null, "n": "0298038", "target": "#nkr_note_orig_0298038", "type": "orig", "text": "現＝賢【乙】"}
{"id": null, "n": "0298039", "target": "#nkr_note_orig_0298039", "type": "orig", "text": "理＝功ヵ【丙】"}
{"id": null, "n": "0299001", "target": "#nkr_note_orig_0299001", "type": "orig", "text": "既＋（異）【乙】"}
{"id": null, "n": "0299002", "target": "#nkr_note_orig_0299002", "type": "orig", "text": "壇＝檀【乙】"}
{"id": null, "n": "0299003", "target": "#nkr_note_orig_0299003", "type": "orig", "text": "持＋（以）【乙】"}
{"id": null, "n": "0299004", "target": "#nkr_note_orig_0299004", "type": "orig", "text": "閫閾蘗本作𡈀國"}
{"id": null, "n": "0299005", "target": "#nkr_note_orig_0299005", "type": "orig", "text": "自＝曰【甲】"}
{"id": null, "n": "0299006", "target": "#nkr_note_orig_0299006", "type": "orig", "text": "（又）＋數【乙】"}
{"id": null, "n": "0299007", "target": "#nkr_note_orig_0299007", "type": "orig", "text": "力＝方【甲】【乙】"}
{"id": null, "n": "0299008", "target": "#nkr_note_orig_0299008", "type": "orig", "text": "〔後〕－【乙】"}
{"id": null, "n": "0299009", "target": "#nkr_note_orig_0299009", "type": "orig", "text": "󰂋嶠＝家嫡【乙】"}
{"id": null, "n": "0299010", "target": "#nkr_note_orig_0299010", "type": "orig", "text": "准＝唯ヵ【原】"}
{"id": null, "n": "0299011", "target": "#nkr_note_orig_0299011", "type": "orig", "text": "藩＝蕃【乙】"}
{"id": null, "n": "0299012", "target": "#nkr_note_orig_0299012", "type": "orig", "text": "墮＝隨【乙】"}
{"id": null, "n": "0299013", "target": "#nkr_note_orig_0299013", "type": "orig", "text": "〔觀〕－【甲】【乙】"}
{"id": null, "n": "0299014", "target": "#nkr_note_orig_0299014", "type": "orig", "text": "〔金剛頂瑜伽三十七尊〕－【甲】"}
{"id": null, "n": "0299015", "target": "#nkr_note_orig_0299015", "type": "orig", "text": "甲本奧書云保延三年正月十八日中川書寫了，□□緣之僧仁□書"}
{"id": null, "n": "0299016", "target": "#nkr_note_orig_0299016", "type": "orig", "text": "〔靈雲…八〕三十五字－【甲】【乙】，〔靈雲…云〕六字－【丙】"}
{"id": null, "n": "0299017", "target": "#nkr_note_orig_0299017", "type": "orig", "text": "丙本奧墨書云元祿八年三月十五日點寫畢尊教同九年五月二日一校畢尊教元祿十五年十二月二日以和上御本再校了尊教"}
{"id": null, "n": "0298032", "target": "#nkr_note_rest_0298032", "type": "rest", "text": "滴蘗本亦作海"}
