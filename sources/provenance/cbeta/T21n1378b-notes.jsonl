{"id": null, "n": null, "target": null, "type": null, "text": "亦云玄師颰陀所說神呪經"}
{"id": null, "n": "0902001", "target": "#nkr_note_mod_0902001", "type": "mod", "text": "幻【大】，佛說幻【宋】，【原】明本，此經與麗本大異故別載之"}
{"id": null, "n": "0902002", "target": "#nkr_note_mod_0902002", "type": "mod", "text": "術【大】，迷【宋】"}
{"id": null, "n": "0902003", "target": "#nkr_note_mod_0902003", "type": "mod", "text": "術【大】，述【宋】"}
{"id": null, "n": "0902004", "target": "#nkr_note_mod_0902004", "type": "mod", "text": "來【大】，〔－〕【宋】"}
{"id": null, "n": "0902001", "target": "#nkr_note_orig_0902001", "type": "orig", "text": "【原】明本，此經與麗本大異故別載之，（佛說）＋幻【宋】"}
{"id": null, "n": "0902002", "target": "#nkr_note_orig_0902002", "type": "orig", "text": "術＝迷【宋】"}
{"id": null, "n": "0902003", "target": "#nkr_note_orig_0902003", "type": "orig", "text": "術＝述【宋】"}
{"id": null, "n": "0902004", "target": "#nkr_note_orig_0902004", "type": "orig", "text": "〔來〕－【宋】"}
{"id": null, "n": "0902001", "target": "#nkr_note_rest_0902001", "type": "rest", "text": "【原】明本，此經與麗本大異故別載之"}
