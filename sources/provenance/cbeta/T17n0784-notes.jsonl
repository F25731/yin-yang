{"id": null, "n": "0722006", "target": null, "type": "orig", "text": "（竺）＋法蘭【明】"}
{"id": null, "n": "0722006", "target": null, "type": "mod", "text": "法蘭【大】，竺法蘭【明】"}
{"id": null, "n": "0722007", "target": null, "type": "orig", "text": "（奉詔）＋譯【明】"}
{"id": null, "n": "0722007", "target": null, "type": "mod", "text": "譯【大】，奉詔譯【明】"}
{"id": null, "n": "0722009", "target": null, "type": "orig", "text": "張騫＝蔡愔【元】"}
{"id": null, "n": "0722009", "target": null, "type": "mod", "text": "張騫【大】，蔡愔【元】"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K19n0778_p0865c04"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T39n1794_p0518c17"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K19n0778_p0865c18"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T53n2122_p0655b21"}
{"id": null, "n": "0722033", "target": null, "type": "orig", "text": "教＋（親）【三】【宮】"}
{"id": null, "n": "0722033", "target": null, "type": "mod", "text": "教親【CB】【麗-CB】【宋】【元】【明】【宮】，教【大】"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K19n0778_p0865c18"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T53n2122_p0655b21"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K19n0778_p0867a24"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T39n1794_p0521c20"}
{"id": null, "n": "0722003", "target": "#nkr_note_mod_0722003", "type": "mod", "text": "四【大】，佛說四【明】"}
{"id": null, "n": "0722004", "target": "#nkr_note_mod_0722004", "type": "mod", "text": "經【大】，經序【宋】【元】【宮】"}
{"id": null, "n": "0722005", "target": "#nkr_note_mod_0722005", "type": "mod", "text": "後漢西域沙門迦葉摩騰共法蘭譯【大】，〔－〕【宋】【元】【宮】，迦葉摩騰共法蘭譯【明】"}
{"id": null, "n": "0722006", "target": "#nkr_note_mod_0722006", "type": "mod", "text": "法蘭【大】，竺法蘭【明】"}
{"id": null, "n": "0722007", "target": "#nkr_note_mod_0722007", "type": "mod", "text": "譯【大】，奉詔譯【明】"}
{"id": null, "n": "0722008", "target": "#nkr_note_mod_0722008", "type": "mod", "text": "（昔漢…也）百六十一字【大】，〔－〕【明】"}
{"id": null, "n": "0722009", "target": "#nkr_note_mod_0722009", "type": "mod", "text": "張騫【大】，蔡愔【元】"}
{"id": null, "n": "0722010", "target": "#nkr_note_mod_0722010", "type": "mod", "text": "佛【大】，四十二章經後漢沙門迦葉摩騰共竺法蘭譯佛【宋】【元】【宮】，（爾時世尊，既成道已，作是思惟，離欲寂靜，是最為勝，住大禪定，降諸魔道今轉法輪度眾生於鹿野苑中，為憍陳如等五人，轉四諦法輪，而證道果，時復有比丘所說諸疑，陳佛進止，世尊教詔，一一開悟，合掌敬諾而順尊勅，爾時世尊，為說真經四十二章）九十七字＋佛【明】"}
{"id": null, "n": "0722011", "target": "#nkr_note_mod_0722011", "type": "mod", "text": "出家【大】，去家【宮】"}
{"id": null, "n": "0722012", "target": "#nkr_note_mod_0722012", "type": "mod", "text": "道【大】，道識心達本解無為法【明】"}
{"id": null, "n": "0722013", "target": "#nkr_note_mod_0722013", "type": "mod", "text": "阿羅漢【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0722014", "target": "#nkr_note_mod_0722014", "type": "mod", "text": "阿【大】，佛言阿【明】"}
{"id": null, "n": "0722015", "target": "#nkr_note_mod_0722015", "type": "mod", "text": "上【大】，生【宮】"}
{"id": null, "n": "0722016", "target": "#nkr_note_mod_0722016", "type": "mod", "text": "（佛言，出家沙門者，斷欲去愛，識自心源，達佛深理，悟佛無為，內無所得，外無所求，心不繫道，亦不結業，無念無作，無修無證不，歷諸位而自崇最，名之為道）五十九字＋佛【明】"}
{"id": null, "n": "0722017", "target": "#nkr_note_mod_0722017", "type": "mod", "text": "除【大】，剃除【明】"}
{"id": null, "n": "0722018", "target": "#nkr_note_mod_0722018", "type": "mod", "text": "髮【大】，髮而【明】"}
{"id": null, "n": "0722019", "target": "#nkr_note_mod_0722019", "type": "mod", "text": "道法【大】，佛法者【明】"}
{"id": null, "n": "0722020", "target": "#nkr_note_mod_0722020", "type": "mod", "text": "身【大】，何者為十身【明】"}
{"id": null, "n": "0722021", "target": "#nkr_note_mod_0722021", "type": "mod", "text": "矣【大】，何能免離【明】"}
{"id": null, "n": "0722022", "target": "#nkr_note_mod_0722022", "type": "mod", "text": "愚【大】，遇【宮】"}
{"id": null, "n": "0722023", "target": "#nkr_note_mod_0722023", "type": "mod", "text": "吾以【大】，以吾【明】"}
{"id": null, "n": "0722024", "target": "#nkr_note_mod_0722024", "type": "mod", "text": "吾【大】，善【宮】"}
{"id": null, "n": "0722025", "target": "#nkr_note_mod_0722025", "type": "mod", "text": "人【大】，愚人【明】"}
{"id": null, "n": "0722026", "target": "#nkr_note_mod_0722026", "type": "mod", "text": "佛【大】，佛佛【明】"}
{"id": null, "n": "0722027", "target": "#nkr_note_mod_0722027", "type": "mod", "text": "實【大】，寶【宋】【元】【宮】"}
{"id": null, "n": "0722028", "target": "#nkr_note_mod_0722028", "type": "mod", "text": "禮【大】，理【明】"}
{"id": null, "n": "0722029", "target": "#nkr_note_mod_0722029", "type": "mod", "text": "可【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0722030", "target": "#nkr_note_mod_0722030", "type": "mod", "text": "減【大】，滅【宋】【宮】"}
{"id": null, "n": "0722031", "target": "#nkr_note_mod_0722031", "type": "mod", "text": "若【大】，如【明】"}
{"id": null, "n": "0722032", "target": "#nkr_note_mod_0722032", "type": "mod", "text": "（不如…千億）十六字【大】，〔－〕【明】"}
{"id": null, "n": "0722033", "target": "#nkr_note_mod_0722033", "type": "mod", "text": "教親【CB】【麗-CB】【宋】【元】【明】【宮】，教【大】"}
{"id": null, "n": "0722034", "target": "#nkr_note_mod_0722034", "type": "mod", "text": "親矣【大】，二親【明】"}
{"id": null, "n": "0722035", "target": "#nkr_note_mod_0722035", "type": "mod", "text": "制【大】，利【宋】【元】，判【明】【宮】"}
{"id": null, "n": "0722036", "target": "#nkr_note_mod_0722036", "type": "mod", "text": "難＋（忍色離欲難，見好不求難，有勢不臨難，被辱不瞋難，觸事無心難，廣學博究難，不輕未學難，除滅我慢難，會善知識難，見性學道難，對境不動難，隨化度人難，心行平等難，不說是非難）七十字【明】"}
{"id": null, "n": "0722037", "target": "#nkr_note_mod_0722037", "type": "mod", "text": "形【大】，形相【明】"}
{"id": null, "n": "0722038", "target": "#nkr_note_mod_0722038", "type": "mod", "text": "存【大】，在【宋】【元】【宮】"}
{"id": null, "n": "0722039", "target": "#nkr_note_mod_0722039", "type": "mod", "text": "唯【大】，惟【宋】【元】【明】"}
{"id": null, "n": "0722040", "target": "#nkr_note_mod_0722040", "type": "mod", "text": "怨【大】，惡【宋】【元】【明】【宮】"}
{"id": null, "n": "0722041", "target": "#nkr_note_mod_0722041", "type": "mod", "text": "人【大】，最【宋】"}
{"id": null, "n": "0722042", "target": "#nkr_note_mod_0722042", "type": "mod", "text": "見之萌【大】，甞不見【明】"}
{"id": null, "n": "0723001", "target": "#nkr_note_mod_0723001", "type": "mod", "text": "道【大】，道者【明】"}
{"id": null, "n": "0723002", "target": "#nkr_note_mod_0723002", "type": "mod", "text": "攪【大】，捁【宋】，梏【宮】"}
{"id": null, "n": "0723003", "target": "#nkr_note_mod_0723003", "type": "mod", "text": "者【大】，〔－〕【明】"}
{"id": null, "n": "0723004", "target": "#nkr_note_mod_0723004", "type": "mod", "text": "道【大】，道若人漸解懺悔來近知識【明】"}
{"id": null, "n": "0723005", "target": "#nkr_note_mod_0723005", "type": "mod", "text": "踊【大】，涌【宋】【元】【宮】"}
{"id": null, "n": "0723006", "target": "#nkr_note_mod_0723006", "type": "mod", "text": "涌【大】，踊【宋】【宮】"}
{"id": null, "n": "0723007", "target": "#nkr_note_mod_0723007", "type": "mod", "text": "要【大】，惡【宋】【元】【明】【宮】"}
{"id": null, "n": "0723008", "target": "#nkr_note_mod_0723008", "type": "mod", "text": "在【大】，存【宋】【元】【明】【宮】"}
{"id": null, "n": "0723009", "target": "#nkr_note_mod_0723009", "type": "mod", "text": "得無不見【大】，無不明矣【明】"}
{"id": null, "n": "0723010", "target": "#nkr_note_mod_0723010", "type": "mod", "text": "忽【大】，忘【宋】【元】【明】【宮】"}
{"id": null, "n": "0723011", "target": "#nkr_note_mod_0723011", "type": "mod", "text": "万【大】，方【宋】"}
{"id": null, "n": "0723012", "target": "#nkr_note_mod_0723012", "type": "mod", "text": "生【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0723013", "target": "#nkr_note_mod_0723013", "type": "mod", "text": "鋃鐺【大】，郎當【宋】【宮】，桹檔【明】"}
{"id": null, "n": "0723014", "target": "#nkr_note_mod_0723014", "type": "mod", "text": "其【大】，甚【宮】"}
{"id": null, "n": "0723015", "target": "#nkr_note_mod_0723015", "type": "mod", "text": "二【大】，二同【明】"}
{"id": null, "n": "0723016", "target": "#nkr_note_mod_0723016", "type": "mod", "text": "殃【大】，歎【宮】"}
{"id": null, "n": "0723017", "target": "#nkr_note_mod_0723017", "type": "mod", "text": "也【大】，也時有【明】"}
{"id": null, "n": "0723018", "target": "#nkr_note_mod_0723018", "type": "mod", "text": "斯【大】，誑【元】【明】"}
{"id": null, "n": "0723019", "target": "#nkr_note_mod_0723019", "type": "mod", "text": "踰【大】，愈【明】"}
{"id": null, "n": "0723020", "target": "#nkr_note_mod_0723020", "type": "mod", "text": "洄【大】，迴【宋】【元】【宮】"}
{"id": null, "n": "0723021", "target": "#nkr_note_mod_0723021", "type": "mod", "text": "意【大】，意汝【明】"}
{"id": null, "n": "0723022", "target": "#nkr_note_mod_0723022", "type": "mod", "text": "與【大】，〔－〕【明】"}
{"id": null, "n": "0723023", "target": "#nkr_note_mod_0723023", "type": "mod", "text": "視【大】，見【宋】【元】【明】"}
{"id": null, "n": "0723024", "target": "#nkr_note_mod_0723024", "type": "mod", "text": "為【大】，以為【明】，如【宋】【元】【宮】"}
{"id": null, "n": "0723025", "target": "#nkr_note_mod_0723025", "type": "mod", "text": "子【大】，如女【宋】【元】【宮】，予【明】"}
{"id": null, "n": "0723026", "target": "#nkr_note_mod_0723026", "type": "mod", "text": "唯【大】，惟【宋】【元】【宮】"}
{"id": null, "n": "0723027", "target": "#nkr_note_mod_0723027", "type": "mod", "text": "意【大】，音【宋】【元】"}
{"id": null, "n": "0723028", "target": "#nkr_note_mod_0723028", "type": "mod", "text": "矣【大】，〔－〕【明】"}
{"id": null, "n": "0723029", "target": "#nkr_note_mod_0723029", "type": "mod", "text": "火【大】，大【宋】【元】【明】【宮】"}
{"id": null, "n": "0723030", "target": "#nkr_note_mod_0723030", "type": "mod", "text": "却【大】，劫【明】"}
{"id": null, "n": "0723031", "target": "#nkr_note_mod_0723031", "type": "mod", "text": "若【大】，若使【明】"}
{"id": null, "n": "0723032", "target": "#nkr_note_mod_0723032", "type": "mod", "text": "道【大】，速【元】"}
{"id": null, "n": "0723033", "target": "#nkr_note_mod_0723033", "type": "mod", "text": "鉀【大】，甲【明】"}
{"id": null, "n": "0723034", "target": "#nkr_note_mod_0723034", "type": "mod", "text": "膽【大】，曕【宋】【宮】"}
{"id": null, "n": "0723035", "target": "#nkr_note_mod_0723035", "type": "mod", "text": "于【大】，於【明】"}
{"id": null, "n": "0723036", "target": "#nkr_note_mod_0723036", "type": "mod", "text": "（甚悲…思歸）十字【大】，其聲悲緊欲悔思返【明】"}
{"id": null, "n": "0723037", "target": "#nkr_note_mod_0723037", "type": "mod", "text": "恒【大】，常【明】"}
{"id": null, "n": "0723038", "target": "#nkr_note_mod_0723038", "type": "mod", "text": "絃【大】＊，弦【明】＊"}
{"id": null, "n": "0723039", "target": "#nkr_note_mod_0723039", "type": "mod", "text": "如【大】，如曰【明】"}
{"id": null, "n": "0723040", "target": "#nkr_note_mod_0723040", "type": "mod", "text": "悲【大】，矣【宋】【元】【宮】，調【明】"}
{"id": null, "n": "0723041", "target": "#nkr_note_mod_0723041", "type": "mod", "text": "棄【大】，垂【明】"}
{"id": null, "n": "0723042", "target": "#nkr_note_mod_0723042", "type": "mod", "text": "暴【大】，異【明】"}
{"id": null, "n": "0723043", "target": "#nkr_note_mod_0723043", "type": "mod", "text": "難【大】，難既值有道之君【明】"}
{"id": null, "n": "0724001", "target": "#nkr_note_mod_0724001", "type": "mod", "text": "佛言【大】，去【宋】【元】【明】【宮】"}
{"id": null, "n": "0724002", "target": "#nkr_note_mod_0724002", "type": "mod", "text": "在吾左側【大】，若在吾側【明】"}
{"id": null, "n": "0724003", "target": "#nkr_note_mod_0724003", "type": "mod", "text": "諸【大】，王【明】"}
{"id": null, "n": "0724004", "target": "#nkr_note_mod_0724004", "type": "mod", "text": "過客【大】，塵隙【明】"}
{"id": null, "n": "0724005", "target": "#nkr_note_mod_0724005", "type": "mod", "text": "礫石【大】，瓦礫【明】"}
{"id": null, "n": "0724006", "target": "#nkr_note_mod_0724006", "type": "mod", "text": "㲲【大】，紈【明】"}
{"id": null, "n": "0724007", "target": "#nkr_note_mod_0724007", "type": "mod", "text": "好【大】，服【明】"}
{"id": null, "n": "0724008", "target": "#nkr_note_mod_0724008", "type": "mod", "text": "帛＋（視大千世界如一訶子，視四耨水如塗足油，視方便如筏寶聚，視無上乘如夢金帛，視求佛道如眼前花，視求禪定如須彌柱，視求涅槃如晝夜寤，視倒正者如六龍舞，視平等者如一真地，視興化者如四時木，諸大比丘，聞佛所說，歡喜奉行）九十二字【明】"}
{"id": null, "n": "0722003", "target": "#nkr_note_orig_0722003", "type": "orig", "text": "（佛說）＋四【明】"}
{"id": null, "n": "0722004", "target": "#nkr_note_orig_0722004", "type": "orig", "text": "經＋（序）【宋】【元】【宮】"}
{"id": null, "n": "0722005", "target": "#nkr_note_orig_0722005", "type": "orig", "text": "〔後漢…譯〕十四字【宋】【元】【宮】，〔後漢西域沙門〕－【明】"}
{"id": null, "n": "0722006", "target": "#nkr_note_orig_0722006", "type": "orig", "text": "（竺）＋法蘭【明】"}
{"id": null, "n": "0722007", "target": "#nkr_note_orig_0722007", "type": "orig", "text": "（奉詔）＋譯【明】"}
{"id": null, "n": "0722008", "target": "#nkr_note_orig_0722008", "type": "orig", "text": "〔昔漢…也〕百六十一字－【明】"}
{"id": null, "n": "0722009", "target": "#nkr_note_orig_0722009", "type": "orig", "text": "張騫＝蔡愔【元】"}
{"id": null, "n": "0722010", "target": "#nkr_note_orig_0722010", "type": "orig", "text": "（四十二章經後漢沙門迦葉摩騰共竺法蘭譯）＋佛【宋】【元】【宮】，（爾時世尊，既成道已，作是思惟，離欲寂靜，是最為勝，住大禪定，降諸魔道今轉法輪度眾生於鹿野苑中，為憍陳如等五人，轉四諦法輪，而證道果，時復有比丘所說諸疑，陳佛進止，世尊教詔，一一開悟，合掌敬諾而順尊勅，爾時世尊，為說真經四十二章）九十七字＋佛【明】"}
{"id": null, "n": "0722011", "target": "#nkr_note_orig_0722011", "type": "orig", "text": "出家＝去家【宮】"}
{"id": null, "n": "0722012", "target": "#nkr_note_orig_0722012", "type": "orig", "text": "道＋（識心達本解無為法）【明】"}
{"id": null, "n": "0722013", "target": "#nkr_note_orig_0722013", "type": "orig", "text": "〔阿羅漢〕－【宋】【元】【宮】"}
{"id": null, "n": "0722014", "target": "#nkr_note_orig_0722014", "type": "orig", "text": "（佛言）＋阿【明】"}
{"id": null, "n": "0722015", "target": "#nkr_note_orig_0722015", "type": "orig", "text": "上＝生【宮】"}
