{"id": null, "n": "0813008", "target": "#nkr_note_mod_0813008", "type": "mod", "text": "人【大】，〔－〕【宋】【元】【宮】，人名【明】"}
{"id": null, "n": "0813009", "target": "#nkr_note_mod_0813009", "type": "mod", "text": "東晉【大】，三秦【宋】【元】【明】【宮】"}
{"id": null, "n": "0813010", "target": "#nkr_note_mod_0813010", "type": "mod", "text": "車【大】，車子【宋】【元】【明】【宮】"}
{"id": null, "n": "0813011", "target": "#nkr_note_mod_0813011", "type": "mod", "text": "秦言勇軍【大】，秦言勇軍【宋】【宮】，此言勇軍【明】"}
