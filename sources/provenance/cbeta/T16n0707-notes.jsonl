{"id": null, "n": "0813012", "target": "#nkr_note_mod_0813012", "type": "mod", "text": "如【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0813013", "target": "#nkr_note_mod_0813013", "type": "mod", "text": "呵【大】，阿【明】"}
{"id": null, "n": "0813014", "target": "#nkr_note_mod_0813014", "type": "mod", "text": "聽【大】，德【明】"}
{"id": null, "n": "0814001", "target": "#nkr_note_mod_0814001", "type": "mod", "text": "毘【大】，鞞【明】"}
{"id": null, "n": "0814002", "target": "#nkr_note_mod_0814002", "type": "mod", "text": "沙門【大】，妙【宮】"}
{"id": null, "n": "0814003", "target": "#nkr_note_mod_0814003", "type": "mod", "text": "財【大】，財人【宋】【元】【明】【宮】"}
{"id": null, "n": "0814004", "target": "#nkr_note_mod_0814004", "type": "mod", "text": "就【大】，就無量【宋】【元】【明】【宮】"}
