{"id": null, "n": "0814006", "target": "#nkr_note_mod_0814006", "type": "mod", "text": "出家【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0814007", "target": "#nkr_note_mod_0814007", "type": "mod", "text": "誰【大】，謂【宋】【元】【明】【宮】"}
{"id": null, "n": "0815001", "target": "#nkr_note_mod_0815001", "type": "mod", "text": "此【大】，眾【宮】"}
{"id": null, "n": "0815002", "target": "#nkr_note_mod_0815002", "type": "mod", "text": "大【大】，天【宋】【元】【明】【宮】"}
