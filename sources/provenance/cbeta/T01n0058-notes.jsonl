{"id": null, "n": "0853003", "target": "#nkr_note_mod_0853003", "type": "mod", "text": "風【大】＊，颰【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0853004", "target": "#nkr_note_mod_0853004", "type": "mod", "text": "西域沙門【大】，三藏法師【宋】【元】【明】"}
{"id": null, "n": "0854001", "target": "#nkr_note_mod_0854001", "type": "mod", "text": "禘【大】＊，提【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0854002", "target": "#nkr_note_mod_0854002", "type": "mod", "text": "邪偽【大】，耶為【元】【明】"}
{"id": null, "n": "0854003", "target": "#nkr_note_mod_0854003", "type": "mod", "text": "今【大】，令【宋】【元】【明】"}
{"id": null, "n": "0854004", "target": "#nkr_note_mod_0854004", "type": "mod", "text": "故【大】，從【宋】【元】【明】"}
{"id": null, "n": "0854005", "target": "#nkr_note_mod_0854005", "type": "mod", "text": "善【大】，善思【宋】【元】【明】"}
{"id": null, "n": "0854006", "target": "#nkr_note_mod_0854006", "type": "mod", "text": "暗冥【大】＊，闇瞑【宋】【元】＊，闇冥【明】＊"}
{"id": null, "n": "0854007", "target": "#nkr_note_mod_0854007", "type": "mod", "text": "割【大】＊，剖【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0854008", "target": "#nkr_note_mod_0854008", "type": "mod", "text": "行【大】，所行【宋】【元】【明】"}
{"id": null, "n": "0854009", "target": "#nkr_note_mod_0854009", "type": "mod", "text": "〔－〕【CB】【元】【明】，相【大】"}
{"id": null, "n": "0855001", "target": "#nkr_note_mod_0855001", "type": "mod", "text": "下【大】，不【明】"}
{"id": null, "n": "0855002", "target": "#nkr_note_mod_0855002", "type": "mod", "text": "曰【大】，告曰【宋】【元】【明】"}
{"id": null, "n": "0855003", "target": "#nkr_note_mod_0855003", "type": "mod", "text": "若【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0855004", "target": "#nkr_note_mod_0855004", "type": "mod", "text": "已【大】，以【元】【明】"}
{"id": null, "n": "0855005", "target": "#nkr_note_mod_0855005", "type": "mod", "text": "黑【大】，異【宋】【元】【明】"}
{"id": null, "n": "0855006", "target": "#nkr_note_mod_0855006", "type": "mod", "text": "現【大】，見【宋】【元】【明】"}
