{"id": null, "n": "0129004", "target": "#nkr_note_mod_0129004", "type": "mod", "text": "兩【大】，而【考偽-大】"}
{"id": null, "n": "0129005", "target": "#nkr_note_mod_0129005", "type": "mod", "text": "苦【大】，共【考偽-大】"}
{"id": null, "n": "0130001", "target": "#nkr_note_mod_0130001", "type": "mod", "text": "也【大】，心【考偽-大】"}
{"id": null, "n": "0129002", "target": "#nkr_note_orig_0129002", "type": "orig", "text": "【原】大英博物館藏燉煌本, S. 2050, 首題新加"}
{"id": null, "n": "0129003", "target": "#nkr_note_orig_0129003", "type": "orig", "text": "首闕"}
{"id": null, "n": "0129004", "target": "#nkr_note_orig_0129004", "type": "orig", "text": "兩＝而？"}
{"id": null, "n": "0129005", "target": "#nkr_note_orig_0129005", "type": "orig", "text": "苦＝共？"}
{"id": null, "n": "0130001", "target": "#nkr_note_orig_0130001", "type": "orig", "text": "也＝心？"}
{"id": null, "n": "0132001", "target": "#nkr_note_orig_0132001", "type": "orig", "text": "以下闕"}
