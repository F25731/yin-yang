{"id": null, "n": "0775030", "target": "#nkr_note_mod_0775030", "type": "mod", "text": "猗【大】，倚【元】【明】"}
{"id": null, "n": "0775031", "target": "#nkr_note_mod_0775031", "type": "mod", "text": "響【大】，聲【宋】【元】【明】【宮】"}
