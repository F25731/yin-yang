{"id": null, "n": null, "target": null, "type": null, "text": "此云情計"}
{"id": null, "n": null, "target": null, "type": null, "text": "因"}
{"id": null, "n": null, "target": null, "type": null, "text": "宗"}
{"id": null, "n": null, "target": null, "type": null, "text": "喻"}
{"id": null, "n": null, "target": null, "type": null, "text": "有法"}
{"id": null, "n": null, "target": null, "type": null, "text": "即極微也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即大乘也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即阿含此\n云教"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘乘"}
{"id": null, "n": null, "target": null, "type": null, "text": "所謂或執"}
{"id": null, "n": null, "target": null, "type": null, "text": "或執"}
{"id": null, "n": null, "target": null, "type": null, "text": "今以"}
{"id": null, "n": null, "target": null, "type": null, "text": "以各"}
{"id": null, "n": null, "target": null, "type": null, "text": "蓋必"}
{"id": null, "n": null, "target": null, "type": null, "text": "各自"}
{"id": null, "n": null, "target": null, "type": null, "text": "即各\n各"}
{"id": null, "n": null, "target": null, "type": null, "text": "之"}
{"id": null, "n": null, "target": null, "type": null, "text": "以總聚相"}
{"id": null, "n": null, "target": null, "type": null, "text": "以極微相"}
{"id": null, "n": null, "target": null, "type": null, "text": "更"}
{"id": null, "n": null, "target": null, "type": null, "text": "勝"}
{"id": null, "n": null, "target": null, "type": null, "text": "而實"}
{"id": null, "n": null, "target": null, "type": null, "text": "我且問汝"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘乘答曰"}
{"id": null, "n": null, "target": null, "type": null, "text": "一一微上"}
{"id": null, "n": null, "target": null, "type": null, "text": "各各"}
{"id": null, "n": null, "target": null, "type": null, "text": "各各"}
{"id": null, "n": null, "target": null, "type": null, "text": "今更難曰"}
{"id": null, "n": null, "target": null, "type": null, "text": "微狀及和集之"}
{"id": null, "n": null, "target": null, "type": null, "text": "極微"}
{"id": null, "n": null, "target": null, "type": null, "text": "豈可"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃令一微"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘乘答曰"}
{"id": null, "n": null, "target": null, "type": null, "text": "如地有堅性。水有濕性。火有煖性。風有動性。地能任持。水能沃\n潤。火能變化。風能鼓動。于"}
{"id": null, "n": null, "target": null, "type": null, "text": "黃赤白"}
{"id": null, "n": null, "target": null, "type": null, "text": "惡"}
{"id": null, "n": null, "target": null, "type": null, "text": "其"}
{"id": null, "n": null, "target": null, "type": null, "text": "物而為五塵"}
{"id": null, "n": null, "target": null, "type": null, "text": "其五"}
{"id": null, "n": null, "target": null, "type": null, "text": "極微"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦堅。亦潤。亦煖。亦動。目觀之而\n為色。耳聽之而為聲。鼻取之而為香。舌甞之而為味。身覺之而為觸。可見"}
{"id": null, "n": null, "target": null, "type": null, "text": "各各"}
{"id": null, "n": null, "target": null, "type": null, "text": "極微上總聚之"}
{"id": null, "n": null, "target": null, "type": null, "text": "今更難曰"}
{"id": null, "n": null, "target": null, "type": null, "text": "上亦應見"}
{"id": null, "n": null, "target": null, "type": null, "text": "既所緣"}
{"id": null, "n": null, "target": null, "type": null, "text": "各"}
{"id": null, "n": null, "target": null, "type": null, "text": "能緣之"}
{"id": null, "n": null, "target": null, "type": null, "text": "上亦"}
{"id": null, "n": null, "target": null, "type": null, "text": "其"}
{"id": null, "n": null, "target": null, "type": null, "text": "勿相分境不同質故。餘乘答曰"}
{"id": null, "n": null, "target": null, "type": null, "text": "所緣"}
{"id": null, "n": null, "target": null, "type": null, "text": "能緣"}
{"id": null, "n": null, "target": null, "type": null, "text": "上兼"}
{"id": null, "n": null, "target": null, "type": null, "text": "并"}
{"id": null, "n": null, "target": null, "type": null, "text": "也。今\n更難曰"}
{"id": null, "n": null, "target": null, "type": null, "text": "則不待集時。先有集相"}
{"id": null, "n": null, "target": null, "type": null, "text": "夫"}
{"id": null, "n": null, "target": null, "type": null, "text": "是"}
{"id": null, "n": null, "target": null, "type": null, "text": "而"}
{"id": null, "n": null, "target": null, "type": null, "text": "是"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃"}
{"id": null, "n": null, "target": null, "type": null, "text": "中之"}
{"id": null, "n": null, "target": null, "type": null, "text": "縱"}
{"id": null, "n": null, "target": null, "type": null, "text": "諸極微。由"}
{"id": null, "n": null, "target": null, "type": null, "text": "離總聚外別無極微。離極微外\n別無總聚。所以"}
{"id": null, "n": null, "target": null, "type": null, "text": "極微是其"}
{"id": null, "n": null, "target": null, "type": null, "text": "極微"}
{"id": null, "n": null, "target": null, "type": null, "text": "非眼所見"}
{"id": null, "n": null, "target": null, "type": null, "text": "則但"}
{"id": null, "n": null, "target": null, "type": null, "text": "安得謂極微之\n上。更自各有一集相哉"}
{"id": null, "n": null, "target": null, "type": null, "text": "一一皆有"}
{"id": null, "n": null, "target": null, "type": null, "text": "就彼"}
{"id": null, "n": null, "target": null, "type": null, "text": "之上。\n圜微相與和集相"}
{"id": null, "n": null, "target": null, "type": null, "text": "勝能隱劣。所以今且"}
{"id": null, "n": null, "target": null, "type": null, "text": "而蒼色之總聚相勝。地界之極微相劣。所以但見蒼色。即知地界"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂所見和集。即是極微自體"}
{"id": null, "n": null, "target": null, "type": null, "text": "則"}
{"id": null, "n": null, "target": null, "type": null, "text": "無有差別。蓋以"}
{"id": null, "n": null, "target": null, "type": null, "text": "極微"}
{"id": null, "n": null, "target": null, "type": null, "text": "但"}
{"id": null, "n": null, "target": null, "type": null, "text": "極微之實"}
{"id": null, "n": null, "target": null, "type": null, "text": "果則"}
{"id": null, "n": null, "target": null, "type": null, "text": "同是極微之所和集"}
{"id": null, "n": null, "target": null, "type": null, "text": "瓶甌差別"}
{"id": null, "n": null, "target": null, "type": null, "text": "之"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦"}
{"id": null, "n": null, "target": null, "type": null, "text": "差"}
{"id": null, "n": null, "target": null, "type": null, "text": "得作"}
{"id": null, "n": null, "target": null, "type": null, "text": "既"}
{"id": null, "n": null, "target": null, "type": null, "text": "時之自"}
{"id": null, "n": null, "target": null, "type": null, "text": "極微"}
{"id": null, "n": null, "target": null, "type": null, "text": "極微"}
{"id": null, "n": null, "target": null, "type": null, "text": "集"}
{"id": null, "n": null, "target": null, "type": null, "text": "上或"}
{"id": null, "n": null, "target": null, "type": null, "text": "極微"}
{"id": null, "n": null, "target": null, "type": null, "text": "則"}
{"id": null, "n": null, "target": null, "type": null, "text": "之"}
{"id": null, "n": null, "target": null, "type": null, "text": "瓶甌果無差殊"}
{"id": null, "n": null, "target": null, "type": null, "text": "得"}
{"id": null, "n": null, "target": null, "type": null, "text": "微"}
{"id": null, "n": null, "target": null, "type": null, "text": "可令差別"}
{"id": null, "n": null, "target": null, "type": null, "text": "畢竟是青。終不作黃赤等解。今若果緣瓶甌等之眾多極微。亦應畢竟仍是眾多極微。不應別作瓶\n甌等異解也。又"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂"}
{"id": null, "n": null, "target": null, "type": null, "text": "然所云"}
{"id": null, "n": null, "target": null, "type": null, "text": "但"}
{"id": null, "n": null, "target": null, "type": null, "text": "此則"}
{"id": null, "n": null, "target": null, "type": null, "text": "然據汝所執。仍以極微為境。則斷斷"}
{"id": null, "n": null, "target": null, "type": null, "text": "差別之"}
{"id": null, "n": null, "target": null, "type": null, "text": "何以故"}
{"id": null, "n": null, "target": null, "type": null, "text": "之"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦"}
{"id": null, "n": null, "target": null, "type": null, "text": "故"}
{"id": null, "n": null, "target": null, "type": null, "text": "但"}
{"id": null, "n": null, "target": null, "type": null, "text": "假有"}
{"id": null, "n": null, "target": null, "type": null, "text": "必"}
{"id": null, "n": null, "target": null, "type": null, "text": "現量所緣之"}
{"id": null, "n": null, "target": null, "type": null, "text": "何勞再說"}
{"id": null, "n": null, "target": null, "type": null, "text": "可謂"}
{"id": null, "n": null, "target": null, "type": null, "text": "因"}
{"id": null, "n": null, "target": null, "type": null, "text": "之"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦"}
{"id": null, "n": null, "target": null, "type": null, "text": "也"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘乘問曰"}
{"id": null, "n": null, "target": null, "type": null, "text": "大乘答曰"}
{"id": null, "n": null, "target": null, "type": null, "text": "便屬假法"}
{"id": null, "n": null, "target": null, "type": null, "text": "前五"}
{"id": null, "n": null, "target": null, "type": null, "text": "現量"}
{"id": null, "n": null, "target": null, "type": null, "text": "識上"}
{"id": null, "n": null, "target": null, "type": null, "text": "當知"}
{"id": null, "n": null, "target": null, "type": null, "text": "決"}
{"id": null, "n": null, "target": null, "type": null, "text": "極微和集之"}
{"id": null, "n": null, "target": null, "type": null, "text": "量等故。乃"}
{"id": null, "n": null, "target": null, "type": null, "text": "之"}
{"id": null, "n": null, "target": null, "type": null, "text": "眼等五識所緣"}
{"id": null, "n": null, "target": null, "type": null, "text": "今"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘乘之"}
{"id": null, "n": null, "target": null, "type": null, "text": "大乘則謂"}
{"id": null, "n": null, "target": null, "type": null, "text": "形別惟在假句。乃"}
{"id": null, "n": null, "target": null, "type": null, "text": "非在極微。是故小乘妄云極微亦有差別"}
{"id": null, "n": null, "target": null, "type": null, "text": "有"}
{"id": null, "n": null, "target": null, "type": null, "text": "瓶甌"}
{"id": null, "n": null, "target": null, "type": null, "text": "者"}
{"id": null, "n": null, "target": null, "type": null, "text": "析"}
{"id": null, "n": null, "target": null, "type": null, "text": "瓶甌至極微"}
{"id": null, "n": null, "target": null, "type": null, "text": "瓶甌等"}
{"id": null, "n": null, "target": null, "type": null, "text": "即"}
{"id": null, "n": null, "target": null, "type": null, "text": "也"}
{"id": null, "n": null, "target": null, "type": null, "text": "瓶等"}
{"id": null, "n": null, "target": null, "type": null, "text": "故"}
{"id": null, "n": null, "target": null, "type": null, "text": "即"}
{"id": null, "n": null, "target": null, "type": null, "text": "得"}
{"id": null, "n": null, "target": null, "type": null, "text": "所執"}
{"id": null, "n": null, "target": null, "type": null, "text": "能"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃"}
{"id": null, "n": null, "target": null, "type": null, "text": "假"}
{"id": null, "n": null, "target": null, "type": null, "text": "定可分析。然未析時。但見瓶等。不見極微。\n已分析後。瓶相亦無。是則瓶既非實。極微復非所緣。故彼"}
{"id": null, "n": null, "target": null, "type": null, "text": "及違"}
{"id": null, "n": null, "target": null, "type": null, "text": "以"}
{"id": null, "n": null, "target": null, "type": null, "text": "是"}
{"id": null, "n": null, "target": null, "type": null, "text": "大乘"}
{"id": null, "n": null, "target": null, "type": null, "text": "中"}
{"id": null, "n": null, "target": null, "type": null, "text": "色"}
{"id": null, "n": null, "target": null, "type": null, "text": "之"}
{"id": null, "n": null, "target": null, "type": null, "text": "分"}
{"id": null, "n": null, "target": null, "type": null, "text": "此相分"}
{"id": null, "n": null, "target": null, "type": null, "text": "所緣緣"}
{"id": null, "n": null, "target": null, "type": null, "text": "雖得不違自宗。而于"}
{"id": null, "n": null, "target": null, "type": null, "text": "故今"}
{"id": null, "n": null, "target": null, "type": null, "text": "以免違世\n之過也。然"}
{"id": null, "n": null, "target": null, "type": null, "text": "相分實"}
{"id": null, "n": null, "target": null, "type": null, "text": "愚夫不達"}
{"id": null, "n": null, "target": null, "type": null, "text": "於外"}
{"id": null, "n": null, "target": null, "type": null, "text": "見執"}
{"id": null, "n": null, "target": null, "type": null, "text": "然而"}
{"id": null, "n": null, "target": null, "type": null, "text": "惟是"}
{"id": null, "n": null, "target": null, "type": null, "text": "內所變相"}
{"id": null, "n": null, "target": null, "type": null, "text": "空中"}
{"id": null, "n": null, "target": null, "type": null, "text": "豈有識外之實髮哉"}
{"id": null, "n": null, "target": null, "type": null, "text": "凡愚妄計"}
{"id": null, "n": null, "target": null, "type": null, "text": "今大乘正欲遣"}
{"id": null, "n": null, "target": null, "type": null, "text": "所執"}
{"id": null, "n": null, "target": null, "type": null, "text": "以"}
{"id": null, "n": null, "target": null, "type": null, "text": "根識所"}
{"id": null, "n": null, "target": null, "type": null, "text": "決"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂"}
{"id": null, "n": null, "target": null, "type": null, "text": "者"}
{"id": null, "n": null, "target": null, "type": null, "text": "姑無論心外的確無境"}
{"id": null, "n": null, "target": null, "type": null, "text": "既在外。決"}
{"id": null, "n": null, "target": null, "type": null, "text": "所能"}
{"id": null, "n": null, "target": null, "type": null, "text": "以"}
{"id": null, "n": null, "target": null, "type": null, "text": "識之"}
{"id": null, "n": null, "target": null, "type": null, "text": "於識\n上曾有"}
{"id": null, "n": null, "target": null, "type": null, "text": "豈得以極微為所緣哉。今必"}
{"id": null, "n": null, "target": null, "type": null, "text": "相分"}
{"id": null, "n": null, "target": null, "type": null, "text": "識所\n變"}
{"id": null, "n": null, "target": null, "type": null, "text": "親"}
{"id": null, "n": null, "target": null, "type": null, "text": "緣"}
{"id": null, "n": null, "target": null, "type": null, "text": "決不離識"}
{"id": null, "n": null, "target": null, "type": null, "text": "自識\n變起"}
{"id": null, "n": null, "target": null, "type": null, "text": "不同"}
{"id": null, "n": null, "target": null, "type": null, "text": "也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即彼"}
{"id": null, "n": null, "target": null, "type": null, "text": "之"}
{"id": null, "n": null, "target": null, "type": null, "text": "心外\n有境其實"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦必"}
{"id": null, "n": null, "target": null, "type": null, "text": "的確"}
{"id": null, "n": null, "target": null, "type": null, "text": "故"}
{"id": null, "n": null, "target": null, "type": null, "text": "頌"}
{"id": null, "n": null, "target": null, "type": null, "text": "但"}
{"id": null, "n": null, "target": null, "type": null, "text": "耳"}
{"id": null, "n": null, "target": null, "type": null, "text": "識"}
{"id": null, "n": null, "target": null, "type": null, "text": "之境"}
{"id": null, "n": null, "target": null, "type": null, "text": "能緣之識"}
{"id": null, "n": null, "target": null, "type": null, "text": "相分境"}
{"id": null, "n": null, "target": null, "type": null, "text": "以"}
{"id": null, "n": null, "target": null, "type": null, "text": "相分"}
{"id": null, "n": null, "target": null, "type": null, "text": "見分故"}
{"id": null, "n": null, "target": null, "type": null, "text": "之言"}
{"id": null, "n": null, "target": null, "type": null, "text": "識與前"}
{"id": null, "n": null, "target": null, "type": null, "text": "識"}
{"id": null, "n": null, "target": null, "type": null, "text": "第七非我計我。緣於非量。今前五是現量\n識。但緣性境"}
{"id": null, "n": null, "target": null, "type": null, "text": "於性"}
{"id": null, "n": null, "target": null, "type": null, "text": "相分性境"}
{"id": null, "n": null, "target": null, "type": null, "text": "蓋第七緣帶質境。其相分從兩頭生。故名為二法合"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦是"}
{"id": null, "n": null, "target": null, "type": null, "text": "與帶相分能生二支"}
{"id": null, "n": null, "target": null, "type": null, "text": "方"}
{"id": null, "n": null, "target": null, "type": null, "text": "真"}
{"id": null, "n": null, "target": null, "type": null, "text": "本識中"}
{"id": null, "n": null, "target": null, "type": null, "text": "而顯五識不緣外境"}
{"id": null, "n": null, "target": null, "type": null, "text": "即可"}
{"id": null, "n": null, "target": null, "type": null, "text": "一者"}
{"id": null, "n": null, "target": null, "type": null, "text": "二者"}
{"id": null, "n": null, "target": null, "type": null, "text": "猶如鏡中"}
{"id": null, "n": null, "target": null, "type": null, "text": "然"}
{"id": null, "n": null, "target": null, "type": null, "text": "既即"}
{"id": null, "n": null, "target": null, "type": null, "text": "識之"}
{"id": null, "n": null, "target": null, "type": null, "text": "而"}
{"id": null, "n": null, "target": null, "type": null, "text": "時"}
{"id": null, "n": null, "target": null, "type": null, "text": "識"}
{"id": null, "n": null, "target": null, "type": null, "text": "是識"}
{"id": null, "n": null, "target": null, "type": null, "text": "而"}
{"id": null, "n": null, "target": null, "type": null, "text": "於"}
{"id": null, "n": null, "target": null, "type": null, "text": "喻"}
{"id": null, "n": null, "target": null, "type": null, "text": "之"}
