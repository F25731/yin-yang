{"id": null, "n": null, "target": null, "type": null, "text": "此中應說三種般若"}
{"id": null, "n": null, "target": null, "type": null, "text": "如《瑜伽》說"}
{"id": null, "n": null, "target": null, "type": null, "text": "如諸教說"}
{"id": null, "n": null, "target": null, "type": null, "text": "如《攝大乘論》說"}
{"id": null, "n": null, "target": null, "type": null, "text": "如《勝鬘》等"}
{"id": null, "n": null, "target": null, "type": null, "text": "此亦《勝》等"}
{"id": null, "n": null, "target": null, "type": null, "text": "一切智、一切種智"}
{"id": null, "n": null, "target": null, "type": null, "text": "煩惱、所知"}
{"id": null, "n": null, "target": null, "type": null, "text": "一切法、一切種法"}
{"id": null, "n": null, "target": null, "type": null, "text": "自利、利他"}
{"id": null, "n": null, "target": null, "type": null, "text": "如睡夢覺、如蓮華開"}
{"id": null, "n": null, "target": null, "type": null, "text": "如《金光明經》及《佛地經》等"}
{"id": null, "n": null, "target": null, "type": null, "text": "如《攝大乘》說得自性，《攝論》、《莊嚴》皆轉第八得圓鏡智"}
{"id": null, "n": null, "target": null, "type": null, "text": "更勘說處"}
{"id": null, "n": null, "target": null, "type": null, "text": "更勘說處"}
{"id": null, "n": null, "target": null, "type": null, "text": "如《莊嚴論》說"}
{"id": null, "n": null, "target": null, "type": null, "text": "如《攝大乘論》說"}
{"id": null, "n": null, "target": null, "type": null, "text": "如《攝大乘》中殊勝也"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": "0547001", "target": "#nkr_note_mod_0547001", "type": "mod", "text": "名【大】，明【考偽-大】"}
{"id": null, "n": "0548001", "target": "#nkr_note_mod_0548001", "type": "mod", "text": "（而發…經）二十三字【大】，〔－〕【考偽-大】"}
{"id": null, "n": "0550001", "target": "#nkr_note_mod_0550001", "type": "mod", "text": "正【大】，〔－〕【考偽-大】"}
{"id": null, "n": "0542018", "target": "#nkr_note_orig_0542018", "type": "orig", "text": "【原】大日本續藏經"}
{"id": null, "n": "0547001", "target": "#nkr_note_orig_0547001", "type": "orig", "text": "名＝明？"}
{"id": null, "n": "0548001", "target": "#nkr_note_orig_0548001", "type": "orig", "text": "〔而發…經〕二十三字－？"}
{"id": null, "n": "0550001", "target": "#nkr_note_orig_0550001", "type": "orig", "text": "〔正〕－？"}
