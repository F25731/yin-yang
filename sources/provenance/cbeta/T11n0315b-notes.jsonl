{"id": null, "n": "0778006", "target": "#nkr_note_orig_0778006", "type": "orig", "text": "與＝興【元】【宮】"}
{"id": null, "n": "0779001", "target": "#nkr_note_orig_0779001", "type": "orig", "text": "著＝者【宋】【元】【宮】"}
{"id": null, "n": "0779002", "target": "#nkr_note_orig_0779002", "type": "orig", "text": "涯＝崖【宋】【宮】"}
{"id": null, "n": "0780001", "target": "#nkr_note_orig_0780001", "type": "orig", "text": "建＝逮【宮】"}
{"id": null, "n": "0780002", "target": "#nkr_note_orig_0780002", "type": "orig", "text": "今＝令【宮】"}
{"id": null, "n": "0780003", "target": "#nkr_note_orig_0780003", "type": "orig", "text": "告＝教【宋】【元】【宮】"}
{"id": null, "n": "0780004", "target": "#nkr_note_orig_0780004", "type": "orig", "text": "〔佛〕－【宮】"}
