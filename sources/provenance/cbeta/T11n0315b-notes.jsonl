{"id": null, "n": "0777002", "target": "#nkr_note_mod_0777002", "type": "mod", "text": "晉【大】，晉太康年【宋】【元】【宮】"}
{"id": null, "n": "0777003", "target": "#nkr_note_mod_0777003", "type": "mod", "text": "憶【大】，想【元】【宮】"}
{"id": null, "n": "0777004", "target": "#nkr_note_mod_0777004", "type": "mod", "text": "垓【大】＊，姟【宋】【元】【宮】＊"}
{"id": null, "n": "0778001", "target": "#nkr_note_mod_0778001", "type": "mod", "text": "所【大】，有【宋】【元】【宮】"}
{"id": null, "n": "0778002", "target": "#nkr_note_mod_0778002", "type": "mod", "text": "拔【大】，枝【宮】"}
{"id": null, "n": "0778003", "target": "#nkr_note_mod_0778003", "type": "mod", "text": "苶【大】，荼【宋】"}
{"id": null, "n": "0778004", "target": "#nkr_note_mod_0778004", "type": "mod", "text": "興【大】，與【元】"}
{"id": null, "n": "0778005", "target": "#nkr_note_mod_0778005", "type": "mod", "text": "龍【大】，觀【宮】"}
{"id": null, "n": "0778006", "target": "#nkr_note_mod_0778006", "type": "mod", "text": "與【大】，興【元】【宮】"}
{"id": null, "n": "0779001", "target": "#nkr_note_mod_0779001", "type": "mod", "text": "著【大】，者【宋】【元】【宮】"}
{"id": null, "n": "0779002", "target": "#nkr_note_mod_0779002", "type": "mod", "text": "涯【大】，崖【宋】【宮】"}
{"id": null, "n": "0780001", "target": "#nkr_note_mod_0780001", "type": "mod", "text": "建【大】，逮【宮】"}
{"id": null, "n": "0780002", "target": "#nkr_note_mod_0780002", "type": "mod", "text": "今【大】，令【宮】"}
{"id": null, "n": "0780003", "target": "#nkr_note_mod_0780003", "type": "mod", "text": "告【大】，教【宋】【元】【宮】"}
{"id": null, "n": "0780004", "target": "#nkr_note_mod_0780004", "type": "mod", "text": "佛【大】，〔－〕【宮】"}
{"id": null, "n": "0777001", "target": "#nkr_note_orig_0777001", "type": "orig", "text": "此經明本今以宋元宮三本對校之"}
{"id": null, "n": "0777002", "target": "#nkr_note_orig_0777002", "type": "orig", "text": "晉＋（太康年）【宋】【元】【宮】"}
