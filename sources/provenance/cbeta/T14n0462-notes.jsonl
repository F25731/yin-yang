{"id": null, "n": "0474009", "target": "#nkr_note_mod_0474009", "type": "mod", "text": "或【大】，或現【元】【明】"}
{"id": null, "n": "0474010", "target": "#nkr_note_mod_0474010", "type": "mod", "text": "讁【大】，謫【宮】"}
{"id": null, "n": "0474011", "target": "#nkr_note_mod_0474011", "type": "mod", "text": "竟【大】，定【宋】【元】【明】【宮】"}
{"id": null, "n": "0474012", "target": "#nkr_note_mod_0474012", "type": "mod", "text": "佛【大】，弗【宮】"}
{"id": null, "n": "0474013", "target": "#nkr_note_mod_0474013", "type": "mod", "text": "蘇【大】，酥【宋】【元】【明】【宮】"}
{"id": null, "n": "0474014", "target": "#nkr_note_mod_0474014", "type": "mod", "text": "執著【大】，熱著【宮】"}
{"id": null, "n": "0475001", "target": "#nkr_note_mod_0475001", "type": "mod", "text": "想【大】，相【宋】【元】【明】【宮】"}
{"id": null, "n": "0475002", "target": "#nkr_note_mod_0475002", "type": "mod", "text": "相【大】，想【宋】【元】【明】【宮】"}
{"id": null, "n": "0475003", "target": "#nkr_note_mod_0475003", "type": "mod", "text": "四【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0475004", "target": "#nkr_note_mod_0475004", "type": "mod", "text": "知【大】，如【宋】【元】【明】【宮】"}
{"id": null, "n": "0475005", "target": "#nkr_note_mod_0475005", "type": "mod", "text": "窟【大】，窟相【宋】【元】【明】【宮】"}
{"id": null, "n": "0475006", "target": "#nkr_note_mod_0475006", "type": "mod", "text": "疾【大】，病【宋】【元】【明】【宮】"}
{"id": null, "n": "0475007", "target": "#nkr_note_mod_0475007", "type": "mod", "text": "導【大】，道【宋】【元】【明】【宮】"}
{"id": null, "n": "0475008", "target": "#nkr_note_mod_0475008", "type": "mod", "text": "文殊【大】，又文殊【宋】【元】【明】【宮】"}
{"id": null, "n": "0475009", "target": "#nkr_note_mod_0475009", "type": "mod", "text": "陀【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0475010", "target": "#nkr_note_mod_0475010", "type": "mod", "text": "以【大】，已【元】【明】"}
{"id": null, "n": "0475011", "target": "#nkr_note_mod_0475011", "type": "mod", "text": "尼揵【大】，尼乾【宋】【元】【明】【宮】"}
{"id": null, "n": "0476001", "target": "#nkr_note_mod_0476001", "type": "mod", "text": "不分卷【宋】【元】【明】【宮】"}
{"id": null, "n": "0476002", "target": "#nkr_note_mod_0476002", "type": "mod", "text": "不分卷【宋】【元】【明】【宮】"}
{"id": null, "n": "0476003", "target": "#nkr_note_mod_0476003", "type": "mod", "text": "外【大】，於外【宋】【元】【明】【宮】"}
