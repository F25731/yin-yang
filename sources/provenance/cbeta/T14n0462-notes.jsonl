{"id": null, "n": "0466008", "target": "#nkr_note_mod_0466008", "type": "mod", "text": "宋【大】，劉宋【元】【明】【宮】"}
{"id": null, "n": "0466009", "target": "#nkr_note_mod_0466009", "type": "mod", "text": "藏【大】，藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0466010", "target": "#nkr_note_mod_0466010", "type": "mod", "text": "國【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0466011", "target": "#nkr_note_mod_0466011", "type": "mod", "text": "至【大】，到【宋】【元】【明】【宮】"}
{"id": null, "n": "0466012", "target": "#nkr_note_mod_0466012", "type": "mod", "text": "放【大】，於【宋】【元】【明】【宮】"}
{"id": null, "n": "0466013", "target": "#nkr_note_mod_0466013", "type": "mod", "text": "為【大】，無【明】"}
{"id": null, "n": "0466014", "target": "#nkr_note_mod_0466014", "type": "mod", "text": "示現【大】，是現【宮】"}
{"id": null, "n": "0466015", "target": "#nkr_note_mod_0466015", "type": "mod", "text": "三昧【大】，三明【宋】【元】【明】【宮】"}
{"id": null, "n": "0466016", "target": "#nkr_note_mod_0466016", "type": "mod", "text": "蘇【大】下同，酥【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0466017", "target": "#nkr_note_mod_0466017", "type": "mod", "text": "如是【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0466018", "target": "#nkr_note_mod_0466018", "type": "mod", "text": "不淨【大】，盛不淨【宋】【元】【明】【宮】"}
{"id": null, "n": "0466019", "target": "#nkr_note_mod_0466019", "type": "mod", "text": "為何【大】，何為【明】"}
{"id": null, "n": "0466020", "target": "#nkr_note_mod_0466020", "type": "mod", "text": "（大德…是器）十七字【大】，〔－〕【宮】"}
{"id": null, "n": "0466021", "target": "#nkr_note_mod_0466021", "type": "mod", "text": "大德【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0467001", "target": "#nkr_note_mod_0467001", "type": "mod", "text": "云【大】，言【宮】"}
{"id": null, "n": "0467002", "target": "#nkr_note_mod_0467002", "type": "mod", "text": "熟【大】，〔－〕【宮】"}
{"id": null, "n": "0467003", "target": "#nkr_note_mod_0467003", "type": "mod", "text": "者【大】，〔－〕【宮】"}
{"id": null, "n": "0467004", "target": "#nkr_note_mod_0467004", "type": "mod", "text": "因【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0467005", "target": "#nkr_note_mod_0467005", "type": "mod", "text": "春【大】，夏【明】"}
{"id": null, "n": "0467006", "target": "#nkr_note_mod_0467006", "type": "mod", "text": "降【大】，隆【宋】【元】【明】【宮】"}
{"id": null, "n": "0467007", "target": "#nkr_note_mod_0467007", "type": "mod", "text": "樔窟【大】，巢窟【宋】【元】【明】【宮】"}
{"id": null, "n": "0467008", "target": "#nkr_note_mod_0467008", "type": "mod", "text": "筏【大】，栰【宋】【宮】"}
{"id": null, "n": "0467009", "target": "#nkr_note_mod_0467009", "type": "mod", "text": "唯【大】，雖【宋】【元】【明】【宮】"}
{"id": null, "n": "0468001", "target": "#nkr_note_mod_0468001", "type": "mod", "text": "生【大】，莖【元】【明】"}
{"id": null, "n": "0468002", "target": "#nkr_note_mod_0468002", "type": "mod", "text": "觚【大】，孤【宮】"}
{"id": null, "n": "0468003", "target": "#nkr_note_mod_0468003", "type": "mod", "text": "利【大】，利言【宋】【元】【明】【宮】"}
{"id": null, "n": "0468004", "target": "#nkr_note_mod_0468004", "type": "mod", "text": "應聞【大】，聞應【宋】【元】【明】【宮】"}
{"id": null, "n": "0468005", "target": "#nkr_note_mod_0468005", "type": "mod", "text": "意【大】，憶【宋】【元】【明】【宮】"}
{"id": null, "n": "0468006", "target": "#nkr_note_mod_0468006", "type": "mod", "text": "好鳥善護【大】，好馬善調【宮】"}
{"id": null, "n": "0468007", "target": "#nkr_note_mod_0468007", "type": "mod", "text": "氄【大】，子【宋】【元】【明】，柔【宮】"}
{"id": null, "n": "0468008", "target": "#nkr_note_mod_0468008", "type": "mod", "text": "護【大】，調【宋】【元】【明】【宮】"}
{"id": null, "n": "0468009", "target": "#nkr_note_mod_0468009", "type": "mod", "text": "現便【大】，便能【宮】"}
{"id": null, "n": "0468010", "target": "#nkr_note_mod_0468010", "type": "mod", "text": "想【大】，相【宋】【元】【明】【宮】"}
{"id": null, "n": "0468011", "target": "#nkr_note_mod_0468011", "type": "mod", "text": "時【大】，將【宮】"}
{"id": null, "n": "0468012", "target": "#nkr_note_mod_0468012", "type": "mod", "text": "呵【大】，可【宮】"}
{"id": null, "n": "0468013", "target": "#nkr_note_mod_0468013", "type": "mod", "text": "墮【大】，隨【元】【明】"}
{"id": null, "n": "0469001", "target": "#nkr_note_mod_0469001", "type": "mod", "text": "無【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0469002", "target": "#nkr_note_mod_0469002", "type": "mod", "text": "法【大】，境【宋】【元】【明】【宮】"}
{"id": null, "n": "0469003", "target": "#nkr_note_mod_0469003", "type": "mod", "text": "須菩提【大】，須菩薩【元】"}
{"id": null, "n": "0469004", "target": "#nkr_note_mod_0469004", "type": "mod", "text": "弗【大】，弗言【宋】【元】【明】【宮】"}
{"id": null, "n": "0469005", "target": "#nkr_note_mod_0469005", "type": "mod", "text": "常【大】，當【明】"}
{"id": null, "n": "0470001", "target": "#nkr_note_mod_0470001", "type": "mod", "text": "于【大】，乎【宮】"}
{"id": null, "n": "0470002", "target": "#nkr_note_mod_0470002", "type": "mod", "text": "至【大】，詣【宋】【元】【明】【宮】"}
{"id": null, "n": "0470003", "target": "#nkr_note_mod_0470003", "type": "mod", "text": "見【大】，曰【宮】"}
{"id": null, "n": "0470004", "target": "#nkr_note_mod_0470004", "type": "mod", "text": "無量【大】，無數【宋】【元】【明】【宮】"}
{"id": null, "n": "0470005", "target": "#nkr_note_mod_0470005", "type": "mod", "text": "云【大】，言【宋】【元】【明】【宮】"}
{"id": null, "n": "0470006", "target": "#nkr_note_mod_0470006", "type": "mod", "text": "所【大】，而【宋】【元】【明】【宮】"}
{"id": null, "n": "0470007", "target": "#nkr_note_mod_0470007", "type": "mod", "text": "殊【大】，殊師利【宋】【元】【明】【宮】"}
{"id": null, "n": "0470008", "target": "#nkr_note_mod_0470008", "type": "mod", "text": "謂【大】，說【宮】"}
{"id": null, "n": "0470009", "target": "#nkr_note_mod_0470009", "type": "mod", "text": "所【大】，佛答言若見所【宋】【元】【明】【宮】"}
{"id": null, "n": "0470010", "target": "#nkr_note_mod_0470010", "type": "mod", "text": "白【大】，白佛【宋】【元】【明】【宮】"}
{"id": null, "n": "0470011", "target": "#nkr_note_mod_0470011", "type": "mod", "text": "於【大】，在【明】"}
{"id": null, "n": "0471001", "target": "#nkr_note_mod_0471001", "type": "mod", "text": "堅䩕【大】，堅硬【宋】【元】【明】【宮】"}
{"id": null, "n": "0471002", "target": "#nkr_note_mod_0471002", "type": "mod", "text": "迮【大】，窄【宋】【元】【明】【宮】"}
{"id": null, "n": "0471003", "target": "#nkr_note_mod_0471003", "type": "mod", "text": "不分卷【宋】【元】【明】【宮】"}
{"id": null, "n": "0471004", "target": "#nkr_note_mod_0471004", "type": "mod", "text": "不分卷【宋】【元】【明】【宮】"}
{"id": null, "n": "0471005", "target": "#nkr_note_mod_0471005", "type": "mod", "text": "時即【大】，即時【明】"}
{"id": null, "n": "0471006", "target": "#nkr_note_mod_0471006", "type": "mod", "text": "汝【大】，汝之【宋】【元】【明】【宮】"}
{"id": null, "n": "0471007", "target": "#nkr_note_mod_0471007", "type": "mod", "text": "是時【大】，時是【宋】【元】【明】【宮】"}
{"id": null, "n": "0471008", "target": "#nkr_note_mod_0471008", "type": "mod", "text": "大【大】，文【宋】【元】【明】【宮】"}
{"id": null, "n": "0472001", "target": "#nkr_note_mod_0472001", "type": "mod", "text": "非時雲雨【大】，非雲時雨【宋】【元】【明】，悲雲時雨【宮】"}
{"id": null, "n": "0472002", "target": "#nkr_note_mod_0472002", "type": "mod", "text": "夜【大】，七夜【宋】【元】【明】【宮】"}
{"id": null, "n": "0472003", "target": "#nkr_note_mod_0472003", "type": "mod", "text": "苦【大】，善【宮】"}
{"id": null, "n": "0472004", "target": "#nkr_note_mod_0472004", "type": "mod", "text": "楗槌【大】下同，揵搥【宋】，揵㨖【宮】，揵椎【元】【明】下同"}
{"id": null, "n": "0472005", "target": "#nkr_note_mod_0472005", "type": "mod", "text": "甫【大】，普【宋】【元】【明】【宮】"}
{"id": null, "n": "0472006", "target": "#nkr_note_mod_0472006", "type": "mod", "text": "爪【大】＊，指【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0472007", "target": "#nkr_note_mod_0472007", "type": "mod", "text": "若減若滿【大】，若滿若減【宋】【元】【明】【宮】"}
{"id": null, "n": "0472008", "target": "#nkr_note_mod_0472008", "type": "mod", "text": "汝【大】，以【元】【明】"}
{"id": null, "n": "0472009", "target": "#nkr_note_mod_0472009", "type": "mod", "text": "卷上終【宋】【元】【明】【宮】"}
{"id": null, "n": "0472010", "target": "#nkr_note_mod_0472010", "type": "mod", "text": "卷下首【宋】【元】【明】【宮】經末題及經題如上，譯號三本俱宋字上有劉字"}
{"id": null, "n": "0472011", "target": "#nkr_note_mod_0472011", "type": "mod", "text": "天眾【大】，大眾【宋】【元】【明】【宮】"}
{"id": null, "n": "0473001", "target": "#nkr_note_mod_0473001", "type": "mod", "text": "園【大】，園中【宋】【元】【明】【宮】"}
{"id": null, "n": "0473002", "target": "#nkr_note_mod_0473002", "type": "mod", "text": "一【大】，十【宮】"}
{"id": null, "n": "0473003", "target": "#nkr_note_mod_0473003", "type": "mod", "text": "揵槌【大】下同，揵椎【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0473004", "target": "#nkr_note_mod_0473004", "type": "mod", "text": "捲手【大】，拳手【宋】【宮】，手拳【元】【明】"}
{"id": null, "n": "0473005", "target": "#nkr_note_mod_0473005", "type": "mod", "text": "賦【大】，傳【宋】【元】【明】【宮】"}
{"id": null, "n": "0473006", "target": "#nkr_note_mod_0473006", "type": "mod", "text": "樔【大】＊，巢【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0473007", "target": "#nkr_note_mod_0473007", "type": "mod", "text": "使流【大】，駛流【元】【明】"}
{"id": null, "n": "0473008", "target": "#nkr_note_mod_0473008", "type": "mod", "text": "依【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0473009", "target": "#nkr_note_mod_0473009", "type": "mod", "text": "洲【大】，作洲【宋】【元】【明】"}
{"id": null, "n": "0473010", "target": "#nkr_note_mod_0473010", "type": "mod", "text": "逼【大】，逼切【宋】【元】【明】【宮】"}
{"id": null, "n": "0473011", "target": "#nkr_note_mod_0473011", "type": "mod", "text": "來【大】，求【宋】【元】【明】【宮】"}
{"id": null, "n": "0473012", "target": "#nkr_note_mod_0473012", "type": "mod", "text": "齊【大】，齊整【宋】【元】【明】，齊正【宮】"}
{"id": null, "n": "0473013", "target": "#nkr_note_mod_0473013", "type": "mod", "text": "結使【大】，給使【宋】【元】【明】【宮】"}
{"id": null, "n": "0473014", "target": "#nkr_note_mod_0473014", "type": "mod", "text": "正直【大】，正真【元】【明】"}
{"id": null, "n": "0474001", "target": "#nkr_note_mod_0474001", "type": "mod", "text": "踊【大】，涌【宋】【元】【明】【宮】"}
{"id": null, "n": "0474002", "target": "#nkr_note_mod_0474002", "type": "mod", "text": "離塵【大】，塵離【宋】【元】【明】【宮】"}
{"id": null, "n": "0474003", "target": "#nkr_note_mod_0474003", "type": "mod", "text": "親【大】，視【宋】【元】【明】【宮】"}
{"id": null, "n": "0474004", "target": "#nkr_note_mod_0474004", "type": "mod", "text": "時【大】，是【明】"}
{"id": null, "n": "0474005", "target": "#nkr_note_mod_0474005", "type": "mod", "text": "童子【大】，量子【宋】"}
{"id": null, "n": "0474006", "target": "#nkr_note_mod_0474006", "type": "mod", "text": "時【大】，已【宋】【元】【明】，〔－〕【宮】"}
{"id": null, "n": "0474007", "target": "#nkr_note_mod_0474007", "type": "mod", "text": "數【大】，等【宋】【元】【明】【宮】"}
