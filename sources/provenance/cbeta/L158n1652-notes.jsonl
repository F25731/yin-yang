{"id": null, "n": null, "target": null, "type": null, "text": "簡"}
{"id": null, "n": null, "target": null, "type": null, "text": "簡"}
{"id": null, "n": null, "target": null, "type": null, "text": "漺"}
{"id": null, "n": null, "target": null, "type": null, "text": "榮"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "五"}
{"id": null, "n": null, "target": null, "type": null, "text": "眉庚切音萌民也"}
{"id": null, "n": null, "target": null, "type": null, "text": "去冀切音噐舉踵而望也"}
{"id": null, "n": null, "target": null, "type": null, "text": "以律切雲入聲\n遂也"}
{"id": null, "n": null, "target": null, "type": null, "text": "止忍切音軫田間道也"}
{"id": null, "n": null, "target": null, "type": null, "text": "于求切音由與攸同"}
{"id": null, "n": null, "target": null, "type": null, "text": "俗燮字"}
{"id": null, "n": null, "target": null, "type": null, "text": "霍國切音畫剖也"}
{"id": null, "n": null, "target": null, "type": null, "text": "息良切音湘馬低昂騰躍也"}
{"id": null, "n": null, "target": null, "type": null, "text": "居候切音姤矢持滿也"}
{"id": null, "n": null, "target": null, "type": null, "text": "苦弔切音竅不安妥也"}
{"id": null, "n": null, "target": null, "type": null, "text": "武粉切音刎口脣邊曰吻"}
{"id": null, "n": null, "target": null, "type": null, "text": "弼各切音\n薄陂澤也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上職日切音質足械也下古祿切音谷手械也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上夷然切音延下于求切音尤蜒蚰蟲名"}
{"id": null, "n": null, "target": null, "type": null, "text": "子淺切音剪福祥也"}
{"id": null, "n": null, "target": null, "type": null, "text": "傾入聲寂靜貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "匡入聲爪持也撲取也"}
{"id": null, "n": null, "target": null, "type": null, "text": "初救切篘去聲衝也"}
{"id": null, "n": null, "target": null, "type": null, "text": "渠為切音逵人名也"}
{"id": null, "n": null, "target": null, "type": null, "text": "渠上聲鐘架也"}
{"id": null, "n": null, "target": null, "type": null, "text": "徒協切音牒細毛布也"}
{"id": null, "n": null, "target": null, "type": null, "text": "於宜切音伊聲也"}
{"id": null, "n": null, "target": null, "type": null, "text": "呼光切音󵙱心上鬲也"}
{"id": null, "n": null, "target": null, "type": null, "text": "偶許切音語垂\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "都木切臀也"}
{"id": null, "n": null, "target": null, "type": null, "text": "同步舶船埠頭水瀕也"}
{"id": null, "n": null, "target": null, "type": null, "text": "鄰溪切音離薄酒也"}
{"id": null, "n": null, "target": null, "type": null, "text": "波上聲揚米去\n糠也"}
{"id": null, "n": null, "target": null, "type": null, "text": "治據切音住匙筯也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上古坎切音感下魯敢切音覽果名"}
{"id": null, "n": null, "target": null, "type": null, "text": "虛訝切去聲裂也孔嘑\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即宕切音浪曬㫰也"}
{"id": null, "n": null, "target": null, "type": null, "text": "徒耐切音代青黛似空青而色深也"}
{"id": null, "n": null, "target": null, "type": null, "text": "渠尤切音求龍無角者也"}
{"id": null, "n": null, "target": null, "type": null, "text": "符分切音汾氣也"}
{"id": null, "n": null, "target": null, "type": null, "text": "與莅同臨也"}
{"id": null, "n": null, "target": null, "type": null, "text": "熒絹切音眩耀光也"}
{"id": null, "n": null, "target": null, "type": null, "text": "逸職切音弋輔也"}
{"id": null, "n": null, "target": null, "type": null, "text": "杜結切音絰㼎蔓也"}
{"id": null, "n": null, "target": null, "type": null, "text": "丁亥切音愷甲也"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒲巴切音琶搔也"}
{"id": null, "n": null, "target": null, "type": null, "text": "允律切音聿知天將\n雨鳥也"}
{"id": null, "n": null, "target": null, "type": null, "text": "他各切音拓囊也"}
{"id": null, "n": null, "target": null, "type": null, "text": "歸謂切音貴目無精也"}
{"id": null, "n": null, "target": null, "type": null, "text": "呈延切音廛踐也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謨還切音獌南\n夷也"}
{"id": null, "n": null, "target": null, "type": null, "text": "委粉切音縕積也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上罔甫切音武下甫無切音膚碔砆石次玉也"}
{"id": null, "n": null, "target": null, "type": null, "text": "虛訝切音赫嗁\n聲也"}
{"id": null, "n": null, "target": null, "type": null, "text": "丑邁切音慸螫󲈀"}
{"id": null, "n": null, "target": null, "type": null, "text": "苦夬切音快姓漢有蒯通"}
{"id": null, "n": null, "target": null, "type": null, "text": "郎古切音魯鹵莽輕脫苟且也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謨官\n切音瞞顢頇大面也"}
{"id": null, "n": null, "target": null, "type": null, "text": "渠追切音逵牛名"}
{"id": null, "n": null, "target": null, "type": null, "text": "津私切咨口上毛曰髭"}
{"id": null, "n": null, "target": null, "type": null, "text": "音烏楚人謂虎為菸菟"}
{"id": null, "n": null, "target": null, "type": null, "text": "虛宜切音希山相對而危險也"}
{"id": null, "n": null, "target": null, "type": null, "text": "呼訝切音嚇裂也"}
{"id": null, "n": null, "target": null, "type": null, "text": "士減切音劖山高峻貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "其淹切音箝矛\n其柄謂之鈐"}
{"id": null, "n": null, "target": null, "type": null, "text": "吁句切音昫魚相呴以濕又吐沫也"}
{"id": null, "n": null, "target": null, "type": null, "text": "狼敵切音歷骨病"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡隈切音回逆流而上也"}
{"id": null, "n": null, "target": null, "type": null, "text": "莫候切音謀齊\n等也"}
{"id": null, "n": null, "target": null, "type": null, "text": "壁吉切音必羗人所吹以驚馬者"}
{"id": null, "n": null, "target": null, "type": null, "text": "七入切音緝修補也"}
{"id": null, "n": null, "target": null, "type": null, "text": "茲消切音焦鷦鷯小鳥也"}
{"id": null, "n": null, "target": null, "type": null, "text": "都故切音妒木中蟲也"}
{"id": null, "n": null, "target": null, "type": null, "text": "徐醉切音\n遂禾成秀也"}
{"id": null, "n": null, "target": null, "type": null, "text": "他刀切音叨弓衣也"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡鷄切音奚小鼠也"}
{"id": null, "n": null, "target": null, "type": null, "text": "徒本\n切音囤混沌元氣未分也"}
{"id": null, "n": null, "target": null, "type": null, "text": "某"}
{"id": null, "n": null, "target": null, "type": null, "text": "某"}
{"id": null, "n": null, "target": null, "type": null, "text": "某"}
{"id": null, "n": null, "target": null, "type": null, "text": "某"}
{"id": null, "n": null, "target": null, "type": null, "text": "某"}
{"id": null, "n": null, "target": null, "type": null, "text": "某"}
{"id": null, "n": null, "target": null, "type": null, "text": "某"}
{"id": null, "n": null, "target": null, "type": null, "text": "某"}
{"id": null, "n": null, "target": null, "type": null, "text": "某"}
{"id": null, "n": null, "target": null, "type": null, "text": "某"}
{"id": null, "n": null, "target": null, "type": null, "text": "某"}
{"id": null, "n": null, "target": null, "type": null, "text": "落蓋切音賴凡孔竅機括皆曰籟"}
{"id": null, "n": null, "target": null, "type": null, "text": "古巧切音攪好也"}
{"id": null, "n": null, "target": null, "type": null, "text": "丑居\n切音攄惡木也"}
{"id": null, "n": null, "target": null, "type": null, "text": "爰救切音又寬也"}
{"id": null, "n": null, "target": null, "type": null, "text": "匪父切音甫低頭也"}
{"id": null, "n": null, "target": null, "type": null, "text": "虛尤\n切音休庇蔭也"}
{"id": null, "n": null, "target": null, "type": null, "text": "俞戍切音預呼也"}
{"id": null, "n": null, "target": null, "type": null, "text": "以智切音易習也"}
{"id": null, "n": null, "target": null, "type": null, "text": "某"}
{"id": null, "n": null, "target": null, "type": null, "text": "在燕京鷲峰寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "秋月禪人請"}
{"id": null, "n": null, "target": null, "type": null, "text": "送子"}
{"id": null, "n": null, "target": null, "type": null, "text": "馬郎婦"}
{"id": null, "n": null, "target": null, "type": null, "text": "螃蛤相"}
{"id": null, "n": null, "target": null, "type": null, "text": "李如滿居士請"}
{"id": null, "n": null, "target": null, "type": null, "text": "達元禪人\n請送子"}
{"id": null, "n": null, "target": null, "type": null, "text": "魚籃"}
{"id": null, "n": null, "target": null, "type": null, "text": "道岸禪人請"}
{"id": null, "n": null, "target": null, "type": null, "text": "淡夫禪人請"}
{"id": null, "n": null, "target": null, "type": null, "text": "古宗禪人請"}
{"id": null, "n": null, "target": null, "type": null, "text": "月庵禪人請"}
{"id": null, "n": null, "target": null, "type": null, "text": "悟本西堂請"}
{"id": null, "n": null, "target": null, "type": null, "text": "洞玄知藏請"}
{"id": null, "n": null, "target": null, "type": null, "text": "印心\n禪人請"}
{"id": null, "n": null, "target": null, "type": null, "text": "傍有神光"}
{"id": null, "n": null, "target": null, "type": null, "text": "逸雲禪人請"}
{"id": null, "n": null, "target": null, "type": null, "text": "居候切音姤遇見也"}
{"id": null, "n": null, "target": null, "type": null, "text": "力涉切廉入聲踐也踰跨也"}
{"id": null, "n": null, "target": null, "type": null, "text": "祥亦切音\n席墓宂幽堂也"}
{"id": null, "n": null, "target": null, "type": null, "text": "力涉切音獵馬領毛也"}
{"id": null, "n": null, "target": null, "type": null, "text": "普弭切音痞覆也又毀也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上徒結切音迭高也下於交切音㕭窊也"}
{"id": null, "n": null, "target": null, "type": null, "text": "訖約切音脚草履也"}
{"id": null, "n": null, "target": null, "type": null, "text": "新字沈居士五旬請"}
{"id": null, "n": null, "target": null, "type": null, "text": "養慧禪人請"}
{"id": null, "n": null, "target": null, "type": null, "text": "毓顛禪人請"}
{"id": null, "n": null, "target": null, "type": null, "text": "清可禪人請"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃徒楷石請"}
{"id": null, "n": null, "target": null, "type": null, "text": "寶印侍者請"}
{"id": null, "n": null, "target": null, "type": null, "text": "耕月維那請"}
{"id": null, "n": null, "target": null, "type": null, "text": "悟本\n維那請"}
{"id": null, "n": null, "target": null, "type": null, "text": "印心書記\n請"}
{"id": null, "n": null, "target": null, "type": null, "text": "吼林侍者請"}
{"id": null, "n": null, "target": null, "type": null, "text": "慈吉後堂請"}
{"id": null, "n": null, "target": null, "type": null, "text": "語石西堂請"}
{"id": null, "n": null, "target": null, "type": null, "text": "尼濶玄慧上座請"}
{"id": null, "n": null, "target": null, "type": null, "text": "遯機法姪\n請"}
{"id": null, "n": null, "target": null, "type": null, "text": "蕭仲俊請"}
{"id": null, "n": null, "target": null, "type": null, "text": "戒善金居士請"}
{"id": null, "n": null, "target": null, "type": null, "text": "尼慈善道\n人請"}
{"id": null, "n": null, "target": null, "type": null, "text": "海慈禪人請"}
{"id": null, "n": null, "target": null, "type": null, "text": "雪紅西堂請"}
{"id": null, "n": null, "target": null, "type": null, "text": "天皷\n知藏請"}
{"id": null, "n": null, "target": null, "type": null, "text": "于候切音陬小魚也"}
{"id": null, "n": null, "target": null, "type": null, "text": "紆勿切氳入聲木叢生也"}
{"id": null, "n": null, "target": null, "type": null, "text": "直陵切音澄㣻\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "逡綠切音詮改也"}
{"id": null, "n": null, "target": null, "type": null, "text": "某"}
{"id": null, "n": null, "target": null, "type": null, "text": "某"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "口狠切音墾至誠所求也"}
{"id": null, "n": null, "target": null, "type": null, "text": "顆羽切音齲䟽行也"}
{"id": null, "n": null, "target": null, "type": null, "text": "盧谷切音祿籍\n也帝王興膺籙受圖順天行誅"}
{"id": null, "n": null, "target": null, "type": null, "text": "古玩切音貫以盤水沃洗曰盥"}
