{"id": null, "n": "0158003", "target": "#nkr_note_orig_0158003", "type": "orig", "text": "〔從五穀〕－【明】"}
{"id": null, "n": "0158004", "target": "#nkr_note_orig_0158004", "type": "orig", "text": "〔故〕－【三】【宮】"}
