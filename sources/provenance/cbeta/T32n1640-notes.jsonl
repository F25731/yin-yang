{"id": null, "n": "0156010", "target": "#nkr_note_orig_0156010", "type": "orig", "text": "犍＝揵【三】【宮】"}
{"id": null, "n": "0157001", "target": "#nkr_note_orig_0157001", "type": "orig", "text": "跟＝根【宮】"}
{"id": null, "n": "0157002", "target": "#nkr_note_orig_0157002", "type": "orig", "text": "（離）＋散【三】【宮】"}
{"id": null, "n": "0157003", "target": "#nkr_note_orig_0157003", "type": "orig", "text": "作＝生【明】"}
{"id": null, "n": "0157004", "target": "#nkr_note_orig_0157004", "type": "orig", "text": "說＝論【三】"}
{"id": null, "n": "0157005", "target": "#nkr_note_orig_0157005", "type": "orig", "text": "遞＝迭【三】【宮】"}
{"id": null, "n": "0157006", "target": "#nkr_note_orig_0157006", "type": "orig", "text": "犍＝揵【宋】【元】【宮】＊，建【明】"}
{"id": null, "n": "0157007", "target": "#nkr_note_orig_0157007", "type": "orig", "text": "〔師〕－【明】"}
{"id": null, "n": "0157008", "target": "#nkr_note_orig_0157008", "type": "orig", "text": "〔何等〕－【三】"}
{"id": null, "n": "0157009", "target": "#nkr_note_orig_0157009", "type": "orig", "text": "〔是〕－【明】"}
{"id": null, "n": "0157010", "target": "#nkr_note_orig_0157010", "type": "orig", "text": "虫＝蟲【元】【明】"}
{"id": null, "n": "0158001", "target": "#nkr_note_orig_0158001", "type": "orig", "text": "〔諸〕－【三】【宮】"}
