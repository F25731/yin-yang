{"id": null, "n": "0156003", "target": "#nkr_note_mod_0156003", "type": "mod", "text": "提婆菩薩造【CB】【麗-CB】，提波菩薩造【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0156004", "target": "#nkr_note_mod_0156004", "type": "mod", "text": "後魏北印度三藏【大】，元魏三藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0156005", "target": "#nkr_note_mod_0156005", "type": "mod", "text": "流【大】，留【宋】【元】【宮】"}
{"id": null, "n": "0156006", "target": "#nkr_note_mod_0156006", "type": "mod", "text": "謂【大】，說【宋】【元】【明】【宮】"}
{"id": null, "n": "0156007", "target": "#nkr_note_mod_0156007", "type": "mod", "text": "諸【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0156008", "target": "#nkr_note_mod_0156008", "type": "mod", "text": "風【大】，風仙【宋】【元】【明】【宮】"}
{"id": null, "n": "0156009", "target": "#nkr_note_mod_0156009", "type": "mod", "text": "違【大】＊，圍【宋】【元】【宮】，韋【明】＊"}
{"id": null, "n": "0156010", "target": "#nkr_note_mod_0156010", "type": "mod", "text": "犍【大】，揵【宋】【元】【明】【宮】"}
{"id": null, "n": "0157001", "target": "#nkr_note_mod_0157001", "type": "mod", "text": "跟【大】，根【宮】"}
{"id": null, "n": "0157002", "target": "#nkr_note_mod_0157002", "type": "mod", "text": "散【大】，離散【宋】【元】【明】【宮】"}
{"id": null, "n": "0157003", "target": "#nkr_note_mod_0157003", "type": "mod", "text": "作【大】，生【明】"}
{"id": null, "n": "0157004", "target": "#nkr_note_mod_0157004", "type": "mod", "text": "說【大】，論【宋】【元】【明】"}
{"id": null, "n": "0157005", "target": "#nkr_note_mod_0157005", "type": "mod", "text": "遞【大】，迭【宋】【元】【明】【宮】"}
{"id": null, "n": "0157006", "target": "#nkr_note_mod_0157006", "type": "mod", "text": "犍【大】＊，揵【宋】【元】【宮】＊，建【明】"}
{"id": null, "n": "0157007", "target": "#nkr_note_mod_0157007", "type": "mod", "text": "師【大】，〔－〕【明】"}
{"id": null, "n": "0157008", "target": "#nkr_note_mod_0157008", "type": "mod", "text": "何等【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0157009", "target": "#nkr_note_mod_0157009", "type": "mod", "text": "是【大】，〔－〕【明】"}
{"id": null, "n": "0157010", "target": "#nkr_note_mod_0157010", "type": "mod", "text": "虫【大】，蟲【元】【明】"}
{"id": null, "n": "0158001", "target": "#nkr_note_mod_0158001", "type": "mod", "text": "諸【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0158002", "target": "#nkr_note_mod_0158002", "type": "mod", "text": "散【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0158003", "target": "#nkr_note_mod_0158003", "type": "mod", "text": "從五穀【大】，〔－〕【明】"}
{"id": null, "n": "0158004", "target": "#nkr_note_mod_0158004", "type": "mod", "text": "故【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0158005", "target": "#nkr_note_mod_0158005", "type": "mod", "text": "釋【大】，破【宋】【元】【宮】"}
{"id": null, "n": "0156003", "target": "#nkr_note_orig_0156003", "type": "orig", "text": "〔提波菩薩造〕－【三】【宮】"}
