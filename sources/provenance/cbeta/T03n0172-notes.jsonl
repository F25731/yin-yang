{"id": null, "n": "0427035", "target": "#nkr_note_orig_0427035", "type": "orig", "text": "徒跣＝蹠踐【聖】"}
{"id": null, "n": "0427036", "target": "#nkr_note_orig_0427036", "type": "orig", "text": "飴＝飼【三】，食【聖】"}
{"id": null, "n": "0427037", "target": "#nkr_note_orig_0427037", "type": "orig", "text": "唯餘＝餘骸【三】"}
{"id": null, "n": "0427038", "target": "#nkr_note_orig_0427038", "type": "orig", "text": "屍＝尸【聖】＊"}
{"id": null, "n": "0427039", "target": "#nkr_note_orig_0427039", "type": "orig", "text": "大＝太【三】【聖】"}
{"id": null, "n": "0427040", "target": "#nkr_note_orig_0427040", "type": "orig", "text": "󰦐＝噎【三】【聖】"}
{"id": null, "n": "0427041", "target": "#nkr_note_orig_0427041", "type": "orig", "text": "使＝令【三】【聖】"}
{"id": null, "n": "0427042", "target": "#nkr_note_orig_0427042", "type": "orig", "text": "天＝夫【宋】【明】"}
{"id": null, "n": "0427043", "target": "#nkr_note_orig_0427043", "type": "orig", "text": "奄＝淹【宋】"}
{"id": null, "n": "0427044", "target": "#nkr_note_orig_0427044", "type": "orig", "text": "（非）＋無【聖】"}
{"id": null, "n": "0427045", "target": "#nkr_note_orig_0427045", "type": "orig", "text": "及未＝未及【三】【聖】"}
{"id": null, "n": "0427046", "target": "#nkr_note_orig_0427046", "type": "orig", "text": "〔口〕－【聖】"}
{"id": null, "n": "0427047", "target": "#nkr_note_orig_0427047", "type": "orig", "text": "〔薪〕－【三】【聖】"}
{"id": null, "n": "0427048", "target": "#nkr_note_orig_0427048", "type": "orig", "text": "〔香〕－【宋】"}
{"id": null, "n": "0427049", "target": "#nkr_note_orig_0427049", "type": "orig", "text": "蘇＝酥【明】"}
{"id": null, "n": "0427050", "target": "#nkr_note_orig_0427050", "type": "orig", "text": "種種＝眾【聖】"}
{"id": null, "n": "0427051", "target": "#nkr_note_orig_0427051", "type": "orig", "text": "（爾）＋時【三】"}
{"id": null, "n": "0427052", "target": "#nkr_note_orig_0427052", "type": "orig", "text": "是＋（也）【三】【聖】"}
{"id": null, "n": "0427053", "target": "#nkr_note_orig_0427053", "type": "orig", "text": "〔我〕－【三】"}
{"id": null, "n": "0427054", "target": "#nkr_note_orig_0427054", "type": "orig", "text": "閱＝悅【三】【聖】"}
{"id": null, "n": "0427055", "target": "#nkr_note_orig_0427055", "type": "orig", "text": "〔者〕－【三】【聖】"}
{"id": null, "n": "0427056", "target": "#nkr_note_orig_0427056", "type": "orig", "text": "〔者〕－【聖】"}
{"id": null, "n": "0427057", "target": "#nkr_note_orig_0427057", "type": "orig", "text": "〔也〕－【聖】"}
{"id": null, "n": "0427058", "target": "#nkr_note_orig_0427058", "type": "orig", "text": "懸＝玄【聖】"}
{"id": null, "n": "0427059", "target": "#nkr_note_orig_0427059", "type": "orig", "text": "挍＝較【元】【明】"}
{"id": null, "n": "0427060", "target": "#nkr_note_orig_0427060", "type": "orig", "text": "與＝及【三】【聖】"}
{"id": null, "n": "0428001", "target": "#nkr_note_orig_0428001", "type": "orig", "text": "所說＝說法【三】【聖】"}
{"id": null, "n": "0428002", "target": "#nkr_note_orig_0428002", "type": "orig", "text": "禮佛而去次行元明俱在下末題"}
{"id": null, "n": "0428003", "target": "#nkr_note_orig_0428003", "type": "orig", "text": "〔丹鄉本續有〕－【三】"}
{"id": null, "n": "0428004", "target": "#nkr_note_orig_0428004", "type": "orig", "text": "爾時…絕時百二十七字【宋】連續禮佛而去"}
{"id": null, "n": "0428005", "target": "#nkr_note_orig_0428005", "type": "orig", "text": "顛＝癲【三】"}
{"id": null, "n": "0428006", "target": "#nkr_note_orig_0428006", "type": "orig", "text": "埿＝泥【元】【明】【聖】"}
{"id": null, "n": "0428007", "target": "#nkr_note_orig_0428007", "type": "orig", "text": "〔佛說〕－【三】"}
{"id": null, "n": "0428008", "target": "#nkr_note_orig_0428008", "type": "orig", "text": "飴餓＝餓【宋】【聖】，飼餓【元】【明】"}
{"id": null, "n": "0426c1401", "target": "#nkr_note_add_0426c1401", "type": "add", "text": "迴【CB】【麗-CB】，回【大】"}
