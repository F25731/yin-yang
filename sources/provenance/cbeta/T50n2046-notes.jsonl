{"id": null, "n": null, "target": null, "type": null, "text": "馬嗜浮流故以浮流草與之也"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K30n1035_p0653a05"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K30n1035_p0653b13"}
{"id": null, "n": "0183007", "target": "#nkr_note_mod_0183007", "type": "mod", "text": "後秦三藏【大】，姚秦三藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0183008", "target": "#nkr_note_mod_0183008", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】，又【宮】"}
{"id": null, "n": "0183009", "target": "#nkr_note_mod_0183009", "type": "mod", "text": "聰【大】，慧【宋】【元】【明】【宮】"}
{"id": null, "n": "0183010", "target": "#nkr_note_mod_0183010", "type": "mod", "text": "論議【大】，言論【宋】【元】【明】【宮】"}
{"id": null, "n": "0183011", "target": "#nkr_note_mod_0183011", "type": "mod", "text": "提【大】，捉【宋】【元】【明】【宮】"}
{"id": null, "n": "0183012", "target": "#nkr_note_mod_0183012", "type": "mod", "text": "嫐【大】，嬈【元】【明】"}
{"id": null, "n": "0183013", "target": "#nkr_note_mod_0183013", "type": "mod", "text": "輒【大】，轉【宋】【元】【明】【宮】"}
{"id": null, "n": "0183014", "target": "#nkr_note_mod_0183014", "type": "mod", "text": "忤【大】，計【宋】【元】【明】【宮】"}
{"id": null, "n": "0183015", "target": "#nkr_note_mod_0183015", "type": "mod", "text": "量【大】，重【宋】【元】【明】【宮】"}
{"id": null, "n": "0183016", "target": "#nkr_note_mod_0183016", "type": "mod", "text": "犍【大】下同，揵【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0183017", "target": "#nkr_note_mod_0183017", "type": "mod", "text": "辦【CB】【麗-CB】，辨【大】，辯【宋】【元】【明】【宮】"}
{"id": null, "n": "0183018", "target": "#nkr_note_mod_0183018", "type": "mod", "text": "聖【大】，近【宋】【元】【明】【宮】"}
{"id": null, "n": "0183019", "target": "#nkr_note_mod_0183019", "type": "mod", "text": "泰【大】，太【宋】【元】【明】【宮】"}
{"id": null, "n": "0183020", "target": "#nkr_note_mod_0183020", "type": "mod", "text": "固【大】＊，故【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0184001", "target": "#nkr_note_mod_0184001", "type": "mod", "text": "便【大】，使【宋】【元】【明】【宮】"}
{"id": null, "n": "0184002", "target": "#nkr_note_mod_0184002", "type": "mod", "text": "請【大】，諸【宮】"}
{"id": null, "n": "0183007", "target": "#nkr_note_orig_0183007", "type": "orig", "text": "（（後秦三藏））四字＝（（姚秦三藏法師））六字【三】【宮】"}
{"id": null, "n": "0183008", "target": "#nkr_note_orig_0183008", "type": "orig", "text": "〔有〕－【三】，有＝又【宮】"}
{"id": null, "n": "0183009", "target": "#nkr_note_orig_0183009", "type": "orig", "text": "聰＝慧【三】【宮】"}
{"id": null, "n": "0183010", "target": "#nkr_note_orig_0183010", "type": "orig", "text": "論議＝言論【三】【宮】"}
{"id": null, "n": "0183011", "target": "#nkr_note_orig_0183011", "type": "orig", "text": "提＝捉【三】【宮】"}
{"id": null, "n": "0183012", "target": "#nkr_note_orig_0183012", "type": "orig", "text": "嫐＝嬈【元】【明】"}
{"id": null, "n": "0183013", "target": "#nkr_note_orig_0183013", "type": "orig", "text": "輒＝轉【三】【宮】"}
{"id": null, "n": "0183014", "target": "#nkr_note_orig_0183014", "type": "orig", "text": "忤＝計【三】【宮】"}
{"id": null, "n": "0183015", "target": "#nkr_note_orig_0183015", "type": "orig", "text": "量＝重【三】【宮】"}
{"id": null, "n": "0183016", "target": "#nkr_note_orig_0183016", "type": "orig", "text": "犍＝揵【三】【宮】下同"}
{"id": null, "n": "0183017", "target": "#nkr_note_orig_0183017", "type": "orig", "text": "辨＝辯【三】【宮】"}
{"id": null, "n": "0183018", "target": "#nkr_note_orig_0183018", "type": "orig", "text": "聖＝近【三】【宮】"}
{"id": null, "n": "0183019", "target": "#nkr_note_orig_0183019", "type": "orig", "text": "泰＝太【三】【宮】"}
{"id": null, "n": "0183020", "target": "#nkr_note_orig_0183020", "type": "orig", "text": "固＝故【三】【宮】＊"}
{"id": null, "n": "0184001", "target": "#nkr_note_orig_0184001", "type": "orig", "text": "便＝使【三】【宮】"}
{"id": null, "n": "0184002", "target": "#nkr_note_orig_0184002", "type": "orig", "text": "請＝諸【宮】"}
{"id": null, "n": "0183c1301", "target": "#nkr_note_add_0183c1301", "type": "add", "text": "直【CB】【麗-CB】，真【大】"}
