{"id": null, "n": "0192017", "target": null, "type": "orig", "text": "妄＝忌【甲】【乙】"}
{"id": null, "n": "0192017", "target": null, "type": "mod", "text": "妄【大】，忌【甲】【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "行年二十五"}
{"id": null, "n": "0189024", "target": "#nkr_note_mod_0189024", "type": "mod", "text": "此【大】，是【校異-原】"}
{"id": null, "n": "0189026", "target": "#nkr_note_mod_0189026", "type": "mod", "text": "囉【大】，羅【丙】"}
{"id": null, "n": "0189027", "target": "#nkr_note_mod_0189027", "type": "mod", "text": "囉【大】＊，羅【甲】【乙】【丙】＊"}
{"id": null, "n": "0189028", "target": "#nkr_note_mod_0189028", "type": "mod", "text": "無【大】＊，牟【甲】【乙】【丙】＊"}
{"id": null, "n": "0189029", "target": "#nkr_note_mod_0189029", "type": "mod", "text": "綱【大】，網【丙】"}
{"id": null, "n": "0189030", "target": "#nkr_note_mod_0189030", "type": "mod", "text": "護【大】，〔－〕【甲】"}
{"id": null, "n": "0189031", "target": "#nkr_note_mod_0189031", "type": "mod", "text": "囉【大】＊，羅【丙】＊"}
{"id": null, "n": "0189032", "target": "#nkr_note_mod_0189032", "type": "mod", "text": "二合【大】，〔－〕【丙】"}
{"id": null, "n": "0189033", "target": "#nkr_note_mod_0189033", "type": "mod", "text": "弟【大】，第【丙】"}
{"id": null, "n": "0189034", "target": "#nkr_note_mod_0189034", "type": "mod", "text": "加【大】，〔－〕【甲】【乙】【丙】"}
{"id": null, "n": "0190001", "target": "#nkr_note_mod_0190001", "type": "mod", "text": "唵【大】，唵引【校異-原】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0190002", "target": "#nkr_note_mod_0190002", "type": "mod", "text": "劍【大】＊，釰【丙】＊"}
{"id": null, "n": "0190004", "target": "#nkr_note_mod_0190004", "type": "mod", "text": "嚧【大】，瀘【甲】【乙】【丙】"}
{"id": null, "n": "0190005", "target": "#nkr_note_mod_0190005", "type": "mod", "text": "訶【大】，賀【甲】【乙】【丙】"}
{"id": null, "n": "0190006", "target": "#nkr_note_mod_0190006", "type": "mod", "text": "陀【大】＊，他【丙】＊"}
{"id": null, "n": "0190007", "target": "#nkr_note_mod_0190007", "type": "mod", "text": "熏【大】，熏香【校異-原】"}
{"id": null, "n": "0190008", "target": "#nkr_note_mod_0190008", "type": "mod", "text": "於【大】，〔－〕【甲】"}
{"id": null, "n": "0190009", "target": "#nkr_note_mod_0190009", "type": "mod", "text": "奉【大】，拳奉【丙】"}
{"id": null, "n": "0190010", "target": "#nkr_note_mod_0190010", "type": "mod", "text": "受【大】，授【丙】"}
{"id": null, "n": "0190011", "target": "#nkr_note_mod_0190011", "type": "mod", "text": "坐【大】＊，座【甲】【乙】【丙】＊"}
{"id": null, "n": "0190012", "target": "#nkr_note_mod_0190012", "type": "mod", "text": "向【大】，北向【丙】"}
{"id": null, "n": "0190013", "target": "#nkr_note_mod_0190013", "type": "mod", "text": "夾【大】，來不【甲】【乙】【丙】"}
{"id": null, "n": "0190014", "target": "#nkr_note_mod_0190014", "type": "mod", "text": "萬行【大】，行人【甲】，行【乙】【丙】"}
{"id": null, "n": "0190015", "target": "#nkr_note_mod_0190015", "type": "mod", "text": "行【大】，以【考偽-原】，取【校異-原】"}
{"id": null, "n": "0190016", "target": "#nkr_note_mod_0190016", "type": "mod", "text": "言【大】，言王【甲】"}
{"id": null, "n": "0190017", "target": "#nkr_note_mod_0190017", "type": "mod", "text": "授【大】，受【校異-丙】"}
{"id": null, "n": "0190018", "target": "#nkr_note_mod_0190018", "type": "mod", "text": "昧【大】＊，摩【丙】＊"}
{"id": null, "n": "0190019", "target": "#nkr_note_mod_0190019", "type": "mod", "text": "合【大】，反【甲】【乙】"}
{"id": null, "n": "0190020", "target": "#nkr_note_mod_0190020", "type": "mod", "text": "鉤【大】，劍【甲】【乙】"}
{"id": null, "n": "0190021", "target": "#nkr_note_mod_0190021", "type": "mod", "text": "堅【大】，竪【丙】"}
{"id": null, "n": "0190022", "target": "#nkr_note_mod_0190022", "type": "mod", "text": "慧【大】＊，惠【丙】＊"}
{"id": null, "n": "0190023", "target": "#nkr_note_mod_0190023", "type": "mod", "text": "夭【大】，󱄉【丙】"}
{"id": null, "n": "0190024", "target": "#nkr_note_mod_0190024", "type": "mod", "text": "引【大】，〔－〕【校異-原】"}
{"id": null, "n": "0190025", "target": "#nkr_note_mod_0190025", "type": "mod", "text": "噁【大】，惡【丙】"}
{"id": null, "n": "0190027", "target": "#nkr_note_mod_0190027", "type": "mod", "text": "眾【大】，眾生【丙】"}
{"id": null, "n": "0190028", "target": "#nkr_note_mod_0190028", "type": "mod", "text": "求【大】，得【丙】"}
{"id": null, "n": "0190029", "target": "#nkr_note_mod_0190029", "type": "mod", "text": "蜜【大】，密【丙】"}
{"id": null, "n": "0190030", "target": "#nkr_note_mod_0190030", "type": "mod", "text": "呼【大】，〔－〕【甲】【乙】【丙】"}
{"id": null, "n": "0190031", "target": "#nkr_note_mod_0190031", "type": "mod", "text": "􇩴【大】，􈅼【乙】"}
{"id": null, "n": "0190032", "target": "#nkr_note_mod_0190032", "type": "mod", "text": "師【大】，即【校異-原】"}
{"id": null, "n": "0190033", "target": "#nkr_note_mod_0190033", "type": "mod", "text": "扶【大】，符【甲】【乙】【丙】，丙本冠註曰符略出經作扶，六卷經作赴"}
{"id": null, "n": "0190034", "target": "#nkr_note_mod_0190034", "type": "mod", "text": "是【大】，此【甲】【乙】【丙】"}
{"id": null, "n": "0190035", "target": "#nkr_note_mod_0190035", "type": "mod", "text": "􆿔【大】，􆿆【校異-原】"}
{"id": null, "n": "0190036", "target": "#nkr_note_mod_0190036", "type": "mod", "text": "字【大】，噁字【校異-原】"}
{"id": null, "n": "0190037", "target": "#nkr_note_mod_0190037", "type": "mod", "text": "拄【大】，跓【甲】【乙】【丙】"}
{"id": null, "n": "0190038", "target": "#nkr_note_mod_0190038", "type": "mod", "text": "授【大】，受【甲】【乙】【丙】"}
{"id": null, "n": "0190039", "target": "#nkr_note_mod_0190039", "type": "mod", "text": "不應【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0190040", "target": "#nkr_note_mod_0190040", "type": "mod", "text": "為【大】，〔－〕【甲】【乙】【丙】"}
{"id": null, "n": "0190041", "target": "#nkr_note_mod_0190041", "type": "mod", "text": "耶【大】，〔－〕【甲】【乙】【丙】"}
{"id": null, "n": "0190042", "target": "#nkr_note_mod_0190042", "type": "mod", "text": "授【大】，受【丙】"}
