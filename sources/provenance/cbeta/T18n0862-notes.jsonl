{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": null, "target": null, "type": null, "text": "此下有摧罪明等記之"}
{"id": null, "n": null, "target": null, "type": null, "text": "上呼"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合、引"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": null, "target": null, "type": null, "text": "花墮佛面、佛眼等尊成就，墮佛中分成\n就心真言，花墮佛下分成就使者真言"}
{"id": null, "n": null, "target": null, "type": null, "text": "願金剛薩埵常住堅固，加持我心，願授與我一切悉地"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
