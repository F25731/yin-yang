{"id": null, "n": "1041001", "target": "#nkr_note_orig_1041001", "type": "orig", "text": "忍澂師校刻本曰言白眾集疑集眾白言"}
{"id": null, "n": "1042001", "target": "#nkr_note_orig_1042001", "type": "orig", "text": "忍澂師校刻本曰眾疑象"}
{"id": null, "n": "1043001", "target": "#nkr_note_orig_1043001", "type": "orig", "text": "忍澂師校刻本曰百一羯磨曰若曾嫁女年滿十二若童女滿十八等准之十二上疑脫會嫁女年滿五字"}
{"id": null, "n": "1043002", "target": "#nkr_note_orig_1043002", "type": "orig", "text": "忍澂師校刻本曰置疑致"}
{"id": null, "n": "1044001", "target": "#nkr_note_orig_1044001", "type": "orig", "text": "忍澂師校刻本曰束疑勅"}
{"id": null, "n": "1042b0201", "target": "#nkr_note_add_1042b0201", "type": "add", "text": "箄【CB】【麗-CB】，算【大】"}
{"id": null, "n": "1042c0101", "target": "#nkr_note_add_1042c0101", "type": "add", "text": "繕【CB】，𮜖【大】【麗-CB】"}
{"id": null, "n": "1043a1801", "target": "#nkr_note_add_1043a1801", "type": "add", "text": "波【CB】【麗-CB】，婆【大】"}
{"id": null, "n": "1043b1001", "target": "#nkr_note_add_1043b1001", "type": "add", "text": "摩【CB】【麗-CB】，麾【大】"}
{"id": null, "n": "1043c0801", "target": "#nkr_note_add_1043c0801", "type": "add", "text": "忽【大】，怱【麗-CB】"}
