{"id": null, "n": "0459030", "target": "#nkr_note_mod_0459030", "type": "mod", "text": "行【大】，行也【宋】【元】【明】"}
{"id": null, "n": "0459031", "target": "#nkr_note_mod_0459031", "type": "mod", "text": "於是【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0459032", "target": "#nkr_note_mod_0459032", "type": "mod", "text": "佛【大】，〔－〕【宋】【元】【明】"}
