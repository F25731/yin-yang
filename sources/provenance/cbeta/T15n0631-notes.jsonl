{"id": null, "n": "0459034", "target": "#nkr_note_mod_0459034", "type": "mod", "text": "各【大】，名【宋】【元】【明】"}
{"id": null, "n": "0459035", "target": "#nkr_note_mod_0459035", "type": "mod", "text": "本【大】，〔－〕【宋】【元】【明】"}
