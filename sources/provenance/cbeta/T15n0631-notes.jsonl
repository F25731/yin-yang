{"id": null, "n": "0460017", "target": "#nkr_note_mod_0460017", "type": "mod", "text": "白佛【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0460018", "target": "#nkr_note_mod_0460018", "type": "mod", "text": "有【大】，者【宋】【元】【明】"}
{"id": null, "n": "0460019", "target": "#nkr_note_mod_0460019", "type": "mod", "text": "天【大】，天人【宋】【元】【明】"}
{"id": null, "n": "0460020", "target": "#nkr_note_mod_0460020", "type": "mod", "text": "諸【大】，〔－〕【宋】【元】【明】"}
