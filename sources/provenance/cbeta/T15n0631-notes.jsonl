{"id": null, "n": "0459015", "target": "#nkr_note_mod_0459015", "type": "mod", "text": "佛【大】，是【宋】【元】【明】"}
{"id": null, "n": "0459016", "target": "#nkr_note_mod_0459016", "type": "mod", "text": "自知惡【大】，有自知者【宋】【元】【明】"}
{"id": null, "n": "0459017", "target": "#nkr_note_mod_0459017", "type": "mod", "text": "悉【大】，迷【宋】【元】【明】"}
{"id": null, "n": "0459018", "target": "#nkr_note_mod_0459018", "type": "mod", "text": "我【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0459019", "target": "#nkr_note_mod_0459019", "type": "mod", "text": "知【大】，〔－〕【宋】【元】【明】"}
