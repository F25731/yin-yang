{"id": null, "n": "0458023", "target": "#nkr_note_mod_0458023", "type": "mod", "text": "他【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0458024", "target": "#nkr_note_mod_0458024", "type": "mod", "text": "不【大】，〔－〕【宮】"}
{"id": null, "n": "0458025", "target": "#nkr_note_mod_0458025", "type": "mod", "text": "有但【大】，但有【宋】【元】【明】"}
{"id": null, "n": "0459001", "target": "#nkr_note_mod_0459001", "type": "mod", "text": "作【大】，住【宋】【元】【明】【宮】"}
{"id": null, "n": "0459002", "target": "#nkr_note_mod_0459002", "type": "mod", "text": "長【大】，忘其本意長【宋】【元】【明】"}
