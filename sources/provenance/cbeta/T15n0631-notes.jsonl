{"id": null, "n": "0459022", "target": "#nkr_note_mod_0459022", "type": "mod", "text": "故【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0459023", "target": "#nkr_note_mod_0459023", "type": "mod", "text": "我【大】，〔－〕【宋】【元】【明】"}
