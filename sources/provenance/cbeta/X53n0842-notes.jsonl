{"id": null, "n": null, "target": null, "type": null, "text": "此云小山"}
{"id": null, "n": null, "target": null, "type": null, "text": "婆抱梨，此\n云棗，父母怜子，目此棗名也"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿世耶，此云意樂"}
{"id": null, "n": null, "target": null, "type": null, "text": "此云犢子"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": "0521001", "target": "#nkr_note_orig_0521001", "type": "orig", "text": "婆抱梨論作波遮利"}
{"id": null, "n": "0521002", "target": "#nkr_note_orig_0521002", "type": "orig", "text": "棗光記作󴧨󴧨同棗"}
{"id": null, "n": "0522001", "target": "#nkr_note_orig_0522001", "type": "orig", "text": "質一作責"}
{"id": null, "n": "0522002", "target": "#nkr_note_orig_0522002", "type": "orig", "text": "容一作寧"}
{"id": null, "n": "0523001", "target": "#nkr_note_orig_0523001", "type": "orig", "text": "銜論作衘．光記作銜．疏作啣"}
{"id": null, "n": "0523002", "target": "#nkr_note_orig_0523002", "type": "orig", "text": "恐一作況"}
{"id": null, "n": "0523003", "target": "#nkr_note_orig_0523003", "type": "orig", "text": "云上疑脫一字"}
{"id": null, "n": "0524001", "target": "#nkr_note_orig_0524001", "type": "orig", "text": "斯須光記作須臾"}
