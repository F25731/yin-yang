{"id": null, "n": null, "target": null, "type": null, "text": "續法"}
{"id": null, "n": null, "target": null, "type": null, "text": "今潯陽郡大蛇村是。"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
{"id": null, "n": null, "target": null, "type": null, "text": "念知足也"}
{"id": null, "n": null, "target": null, "type": null, "text": "貧樂道也"}
{"id": null, "n": null, "target": null, "type": null, "text": "惟以二空觀慧為事業也"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "九容切，音恭。亭名。"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡瞎切，音鎋。"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "《乾隆藏》（佛陀教育基金會印贈版第163冊第1662經第648頁上欄第2行）"}
