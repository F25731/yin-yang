{"id": null, "n": "0918008", "target": "#nkr_note_mod_0918008", "type": "mod", "text": "西【大】，宋西【明】"}
{"id": null, "n": "0918009", "target": "#nkr_note_mod_0918009", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0918010", "target": "#nkr_note_mod_0918010", "type": "mod", "text": "慜【大】，愍【宋】【元】【明】"}
{"id": null, "n": "0918011", "target": "#nkr_note_mod_0918011", "type": "mod", "text": "天上人間【大】，〔－〕【宋】"}
{"id": null, "n": "0918012", "target": "#nkr_note_mod_0918012", "type": "mod", "text": "宋言【大】下同，此言【明】下同"}
{"id": null, "n": "0918013", "target": "#nkr_note_mod_0918013", "type": "mod", "text": "捺【大】＊，𭡠【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0918014", "target": "#nkr_note_mod_0918014", "type": "mod", "text": "反【大】＊，切【明】＊"}
{"id": null, "n": "0918015", "target": "#nkr_note_mod_0918015", "type": "mod", "text": "十六【大】，上【宋】【元】，上十六【明】"}
{"id": null, "n": "0918016", "target": "#nkr_note_mod_0918016", "type": "mod", "text": "夭【大】，天【宋】"}
{"id": null, "n": "0919001", "target": "#nkr_note_mod_0919001", "type": "mod", "text": "三【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0919002", "target": "#nkr_note_mod_0919002", "type": "mod", "text": "二【大】，三【明】"}
{"id": null, "n": "0919003", "target": "#nkr_note_mod_0919003", "type": "mod", "text": "引【大】，上【宋】【元】【明】"}
{"id": null, "n": "0919004", "target": "#nkr_note_mod_0919004", "type": "mod", "text": "㘓【大】，瀾【宋】【元】【明】"}
{"id": null, "n": "0919005", "target": "#nkr_note_mod_0919005", "type": "mod", "text": "電【大】，電障難【明】"}
{"id": null, "n": "0918007", "target": "#nkr_note_orig_0918007", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0918008", "target": "#nkr_note_orig_0918008", "type": "orig", "text": "（宋）＋西【明】"}
{"id": null, "n": "0918009", "target": "#nkr_note_orig_0918009", "type": "orig", "text": "〔臣〕－【明】"}
{"id": null, "n": "0918010", "target": "#nkr_note_orig_0918010", "type": "orig", "text": "慜＝愍【三】"}
