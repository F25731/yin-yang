{"id": null, "n": "0180030", "target": "#nkr_note_mod_0180030", "type": "mod", "text": "安息國三藏【大】，沙門【宋】【元】【明】【宮】"}
{"id": null, "n": "0180031", "target": "#nkr_note_mod_0180031", "type": "mod", "text": "國【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0180032", "target": "#nkr_note_mod_0180032", "type": "mod", "text": "言【大】，告【宋】【元】【明】【宮】"}
{"id": null, "n": "0180033", "target": "#nkr_note_mod_0180033", "type": "mod", "text": "取【大】，〔－〕【宮】"}
{"id": null, "n": "0180034", "target": "#nkr_note_mod_0180034", "type": "mod", "text": "止【大】，正【宮】"}
{"id": null, "n": "0180035", "target": "#nkr_note_mod_0180035", "type": "mod", "text": "已【大】，以【宮】"}
{"id": null, "n": "0180036", "target": "#nkr_note_mod_0180036", "type": "mod", "text": "得【大】，時【宮】"}
{"id": null, "n": "0181001", "target": "#nkr_note_mod_0181001", "type": "mod", "text": "事【大】，喜【宋】【元】【明】【宮】"}
{"id": null, "n": "0181002", "target": "#nkr_note_mod_0181002", "type": "mod", "text": "志【大】，悉【宋】【元】【明】【宮】"}
{"id": null, "n": "0181003", "target": "#nkr_note_mod_0181003", "type": "mod", "text": "其意經經【大】，某經某經【宋】【元】【明】【宮】"}
{"id": null, "n": "0181004", "target": "#nkr_note_mod_0181004", "type": "mod", "text": "為【大】，令【宋】【元】【明】"}
{"id": null, "n": "0181005", "target": "#nkr_note_mod_0181005", "type": "mod", "text": "古【大】，故【宮】"}
{"id": null, "n": "0181006", "target": "#nkr_note_mod_0181006", "type": "mod", "text": "知【大】，知今知【宋】【元】【明】【宮】"}
{"id": null, "n": "0181007", "target": "#nkr_note_mod_0181007", "type": "mod", "text": "佛說【大】，〔－〕【宋】【元】【宮】"}
