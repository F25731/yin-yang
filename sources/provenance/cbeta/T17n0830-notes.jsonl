{"id": null, "n": "0874001", "target": "#nkr_note_mod_0874001", "type": "mod", "text": "大【大】，〔－〕【明】"}
{"id": null, "n": "0874002", "target": "#nkr_note_mod_0874002", "type": "mod", "text": "天竺【大】，中天竺【宋】【元】【明】【宮】"}
{"id": null, "n": "0874003", "target": "#nkr_note_mod_0874003", "type": "mod", "text": "三藏【大】，三藏法師【宋】【元】【明】【宮】"}
