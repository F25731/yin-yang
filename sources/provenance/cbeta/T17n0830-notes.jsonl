{"id": null, "n": "0874006", "target": "#nkr_note_mod_0874006", "type": "mod", "text": "婁【大】＊，樓【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0874007", "target": "#nkr_note_mod_0874007", "type": "mod", "text": "惟【大】＊，唯【宋】【元】【明】【宮】＊"}
