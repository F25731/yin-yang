{"id": null, "n": "0440030", "target": "#nkr_note_mod_0440030", "type": "mod", "text": "麋【大】，度【聖】"}
{"id": null, "n": "0440031", "target": "#nkr_note_mod_0440031", "type": "mod", "text": "食【大】，飲食【明】【聖】【甲】【乙】"}
{"id": null, "n": "0440032", "target": "#nkr_note_mod_0440032", "type": "mod", "text": "爾【大】＊，𭇧【明】【乙】＊"}
{"id": null, "n": "0440033", "target": "#nkr_note_mod_0440033", "type": "mod", "text": "漿【大】，將水【聖】"}
{"id": null, "n": "0440034", "target": "#nkr_note_mod_0440034", "type": "mod", "text": "沙【大】，砂【明】【聖】【乙】"}
{"id": null, "n": "0440035", "target": "#nkr_note_mod_0440035", "type": "mod", "text": "酥【大】＊，蘇【聖】【甲】＊"}
{"id": null, "n": "0440036", "target": "#nkr_note_mod_0440036", "type": "mod", "text": "唯【大】，准【聖】"}
{"id": null, "n": "0440037", "target": "#nkr_note_mod_0440037", "type": "mod", "text": "是【大】，界【聖】"}
{"id": null, "n": "0440038", "target": "#nkr_note_mod_0440038", "type": "mod", "text": "香【大】，〔－〕【甲】"}
{"id": null, "n": "0440039", "target": "#nkr_note_mod_0440039", "type": "mod", "text": "白【大】，自【聖】"}
{"id": null, "n": "0440040", "target": "#nkr_note_mod_0440040", "type": "mod", "text": "及【大】，〔－〕【聖】"}
{"id": null, "n": "0440041", "target": "#nkr_note_mod_0440041", "type": "mod", "text": "悉【大】，息【明】【乙】"}
{"id": null, "n": "0440042", "target": "#nkr_note_mod_0440042", "type": "mod", "text": "（之供…眾）七字【大】，〔－〕【聖】"}
{"id": null, "n": "0440043", "target": "#nkr_note_mod_0440043", "type": "mod", "text": "之【大】，〔－〕【甲】"}
{"id": null, "n": "0440044", "target": "#nkr_note_mod_0440044", "type": "mod", "text": "誦【大】，讀【聖】"}
{"id": null, "n": "0440045", "target": "#nkr_note_mod_0440045", "type": "mod", "text": "面【大】，〔－〕【明】【乙】"}
{"id": null, "n": "0440046", "target": "#nkr_note_mod_0440046", "type": "mod", "text": "卑【大】，厘【明】，厚【聖】，庳【乙】"}
{"id": null, "n": "0440047", "target": "#nkr_note_mod_0440047", "type": "mod", "text": "人【大】＊，〔－〕【明】【聖】【甲】【乙】＊"}
{"id": null, "n": "0440048", "target": "#nkr_note_mod_0440048", "type": "mod", "text": "乃至【大】，〔－〕【聖】【甲】"}
{"id": null, "n": "0440049", "target": "#nkr_note_mod_0440049", "type": "mod", "text": "替【大】，贊【聖】"}
{"id": null, "n": "0440050a", "target": "#nkr_note_mod_0440050a", "type": "mod", "text": "（要在…法）十四字【大】，〔－〕【聖】【甲】"}
{"id": null, "n": "0440050b", "target": "#nkr_note_mod_0440050b", "type": "mod", "text": "（呪師…場）四十八字【大】，〔－〕【聖】【甲】"}
{"id": null, "n": "0440051", "target": "#nkr_note_mod_0440051", "type": "mod", "text": "祇【大】，祗【明】"}
{"id": null, "n": "0440052", "target": "#nkr_note_mod_0440052", "type": "mod", "text": "初【大】，禍【聖】"}
{"id": null, "n": "0440053", "target": "#nkr_note_mod_0440053", "type": "mod", "text": "天【大】，大【聖】【甲】"}
{"id": null, "n": "0440054", "target": "#nkr_note_mod_0440054", "type": "mod", "text": "右【大】，〔－〕【聖】"}
{"id": null, "n": "0440055", "target": "#nkr_note_mod_0440055", "type": "mod", "text": "拄【大】＊，跓【聖】【甲】＊"}
{"id": null, "n": "0440056", "target": "#nkr_note_mod_0440056", "type": "mod", "text": "唵【大】＊，唵引一【明】【乙】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "引一"}
{"id": null, "n": "0440057", "target": "#nkr_note_mod_0440057", "type": "mod", "text": "去【大】，去聲【明】【乙】，〔－〕【聖】【甲】"}
{"id": null, "n": "0440058", "target": "#nkr_note_mod_0440058", "type": "mod", "text": "麼【大】＊，摩【聖】＊"}
{"id": null, "n": "0440059", "target": "#nkr_note_mod_0440059", "type": "mod", "text": "上【大】，上聲【明】【乙】，上二【聖】"}
{"id": null, "n": "0440060", "target": "#nkr_note_mod_0440060", "type": "mod", "text": "三合【大】，二合三【聖】"}
{"id": null, "n": "0440061", "target": "#nkr_note_mod_0440061", "type": "mod", "text": "喉頂【大】，唯項【聖】"}
{"id": null, "n": "0440062", "target": "#nkr_note_mod_0440062", "type": "mod", "text": "招【大】，招之【聖】【甲】"}
{"id": null, "n": "0440063", "target": "#nkr_note_mod_0440063", "type": "mod", "text": "普【大】，善【聖】"}
{"id": null, "n": "0440064", "target": "#nkr_note_mod_0440064", "type": "mod", "text": "曰【大】，〔－〕【聖】"}
