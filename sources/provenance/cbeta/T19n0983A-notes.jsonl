{"id": null, "n": "0439018", "target": "#nkr_note_mod_0439018", "type": "mod", "text": "佛說【大】，〔－〕【明】【乙】，【原】麗本，【甲】仁和寺藏古寫本，【乙】黃檗版淨嚴等加筆本，此軌宋元二本缺"}
{"id": null, "n": "0439019", "target": "#nkr_note_mod_0439019", "type": "mod", "text": "說【大】＊，母【聖】【甲】＊"}
{"id": null, "n": "0439020", "target": "#nkr_note_mod_0439020", "type": "mod", "text": "軌【大】，軌法【聖】【甲】"}
{"id": null, "n": "0439021", "target": "#nkr_note_mod_0439021", "type": "mod", "text": "（開府…寺）三十七字【大】，唐北天竺【明】【乙】，特進試鴻臚卿大興善寺【聖】【甲】"}
{"id": null, "n": "0439022", "target": "#nkr_note_mod_0439022", "type": "mod", "text": "門【大】，門大廣智【明】【聖】【甲】【乙】"}
{"id": null, "n": "0439023", "target": "#nkr_note_mod_0439023", "type": "mod", "text": "惱【大】，苦【聖】【甲】"}
{"id": null, "n": "0439024", "target": "#nkr_note_mod_0439024", "type": "mod", "text": "皆【大】，背【聖】"}
{"id": null, "n": "0439025", "target": "#nkr_note_mod_0439025", "type": "mod", "text": "感招【大】，敢柖【聖】【甲】"}
{"id": null, "n": "0439026", "target": "#nkr_note_mod_0439026", "type": "mod", "text": "經【大】，終【聖】"}
{"id": null, "n": "0439027", "target": "#nkr_note_mod_0439027", "type": "mod", "text": "及一切災厄眾生【大】，〔－〕【聖】【甲】"}
{"id": null, "n": "0440001", "target": "#nkr_note_mod_0440001", "type": "mod", "text": "泥拭【大】，埿穢【聖】，埿拭【甲】"}
{"id": null, "n": "0440002", "target": "#nkr_note_mod_0440002", "type": "mod", "text": "心【大】，〔－〕【明】"}
{"id": null, "n": "0440003", "target": "#nkr_note_mod_0440003", "type": "mod", "text": "胎【大】，〔－〕【明】"}
{"id": null, "n": "0440004", "target": "#nkr_note_mod_0440004", "type": "mod", "text": "繒【大】，增【聖】"}
{"id": null, "n": "0440005", "target": "#nkr_note_mod_0440005", "type": "mod", "text": "瓔珞【大】，纓絡【聖】【甲】"}
{"id": null, "n": "0440006", "target": "#nkr_note_mod_0440006", "type": "mod", "text": "璫【大】，蟷【聖】"}
{"id": null, "n": "0440007", "target": "#nkr_note_mod_0440007", "type": "mod", "text": "王【大】，〔－〕【聖】【甲】"}
{"id": null, "n": "0440008", "target": "#nkr_note_mod_0440008", "type": "mod", "text": "或青綠花上【大】，〔－〕【聖】【甲】"}
{"id": null, "n": "0440009", "target": "#nkr_note_mod_0440009", "type": "mod", "text": "綠【大】，蓮【明】【乙】"}
{"id": null, "n": "0440010", "target": "#nkr_note_mod_0440010", "type": "mod", "text": "相【大】，〔－〕【明】【聖】【甲】【乙】"}
{"id": null, "n": "0440011", "target": "#nkr_note_mod_0440011", "type": "mod", "text": "如桃李形【大】，〔－〕【聖】【甲】"}
{"id": null, "n": "0440012", "target": "#nkr_note_mod_0440012", "type": "mod", "text": "李【大】，子【考偽-乙】"}
{"id": null, "n": "0440013", "target": "#nkr_note_mod_0440013", "type": "mod", "text": "乃【大】，次第布列乃【聖】【甲】"}
{"id": null, "n": "0440014", "target": "#nkr_note_mod_0440014", "type": "mod", "text": "頭【大】，顧【聖】"}
{"id": null, "n": "0440015", "target": "#nkr_note_mod_0440015", "type": "mod", "text": "施【大】，〔－〕【聖】【甲】"}
{"id": null, "n": "0440016", "target": "#nkr_note_mod_0440016", "type": "mod", "text": "（又於…從）十字【大】，〔－〕【聖】"}
{"id": null, "n": "0440017", "target": "#nkr_note_mod_0440017", "type": "mod", "text": "畫【大】，〔－〕【聖】"}
{"id": null, "n": "0440018", "target": "#nkr_note_mod_0440018", "type": "mod", "text": "揵【大】＊，乾【明】【聖】【甲】＊"}
{"id": null, "n": "0440019", "target": "#nkr_note_mod_0440019", "type": "mod", "text": "天【大】，天王【聖】【甲】"}
{"id": null, "n": "0440020", "target": "#nkr_note_mod_0440020", "type": "mod", "text": "界【大】，〔－〕【乙】"}
{"id": null, "n": "0440021", "target": "#nkr_note_mod_0440021", "type": "mod", "text": "鬼【大】，〔－〕【聖】【甲】"}
{"id": null, "n": "0440022", "target": "#nkr_note_mod_0440022", "type": "mod", "text": "王【大】，主【明】【聖】【甲】"}
{"id": null, "n": "0440023", "target": "#nkr_note_mod_0440023", "type": "mod", "text": "天【大】，天王【校異-乙】"}
{"id": null, "n": "0440024", "target": "#nkr_note_mod_0440024", "type": "mod", "text": "寶棒【大】，實持【聖】"}
{"id": null, "n": "0440025", "target": "#nkr_note_mod_0440025", "type": "mod", "text": "是【大】，〔－〕【乙】"}
{"id": null, "n": "0440026", "target": "#nkr_note_mod_0440026", "type": "mod", "text": "飾【大】，拭【明】【甲】【乙】，滅【聖】"}
{"id": null, "n": "0440027", "target": "#nkr_note_mod_0440027", "type": "mod", "text": "葉【大】，〔－〕【聖】【甲】"}
{"id": null, "n": "0440028", "target": "#nkr_note_mod_0440028", "type": "mod", "text": "安【大】，〔－〕【聖】【甲】"}
