{"id": null, "n": "0440066", "target": "#nkr_note_mod_0440066", "type": "mod", "text": "二合引【大】＊，引二合【聖】＊"}
{"id": null, "n": "0440067", "target": "#nkr_note_mod_0440067", "type": "mod", "text": "一【大】，三【明】，二【乙】"}
{"id": null, "n": "0440068", "target": "#nkr_note_mod_0440068", "type": "mod", "text": "重【大】，序【聖】"}
{"id": null, "n": "0440069", "target": "#nkr_note_mod_0440069", "type": "mod", "text": "茶【大】＊，荼【明】【聖】【乙】＊，茶三【明】【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": "0440070", "target": "#nkr_note_mod_0440070", "type": "mod", "text": "訶【大】＊，訶引四【明】【乙】，訶引【聖】，賀【聖】【甲】＊"}
