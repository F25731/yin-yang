{"id": null, "n": "0883015", "target": "#nkr_note_mod_0883015", "type": "mod", "text": "陳西印度三藏真諦譯【大】，陳三藏法師真諦譯【宋】【元】【明】【宮】"}
{"id": null, "n": "0883016", "target": "#nkr_note_mod_0883016", "type": "mod", "text": "簡【大】＊，揀【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0883017", "target": "#nkr_note_mod_0883017", "type": "mod", "text": "知【大】，智【宋】【元】【明】【宮】"}
