{"id": null, "n": "0883019", "target": "#nkr_note_mod_0883019", "type": "mod", "text": "瓦【大】，瓶【宋】【元】【明】【宮】"}
{"id": null, "n": "0883020", "target": "#nkr_note_mod_0883020", "type": "mod", "text": "隣【大】＊，凌【宋】【元】【宮】＊"}
{"id": null, "n": "0884001", "target": "#nkr_note_mod_0884001", "type": "mod", "text": "若【大】，惟【明】"}
