{"id": null, "n": "0689002", "target": "#nkr_note_mod_0689002", "type": "mod", "text": "上【大】，上乾【甲】"}
{"id": null, "n": "0689003", "target": "#nkr_note_mod_0689003", "type": "mod", "text": "請【大】，翻【校異-原】"}
{"id": null, "n": "0689004", "target": "#nkr_note_mod_0689004", "type": "mod", "text": "也【大】，此【甲】"}
{"id": null, "n": "0691001", "target": "#nkr_note_mod_0691001", "type": "mod", "text": "說【大】，談【校異-原】"}
{"id": null, "n": "0691002", "target": "#nkr_note_mod_0691002", "type": "mod", "text": "中【大】，〔－〕【甲】"}
{"id": null, "n": "0693001", "target": "#nkr_note_mod_0693001", "type": "mod", "text": "之【大】，也【甲】"}
{"id": null, "n": "0694001", "target": "#nkr_note_mod_0694001", "type": "mod", "text": "執【大】，瓶【甲】"}
{"id": null, "n": "0696001", "target": "#nkr_note_mod_0696001", "type": "mod", "text": "身【大】，〔－〕【甲】"}
{"id": null, "n": "0700001", "target": "#nkr_note_mod_0700001", "type": "mod", "text": "上【大】，上坤終【甲】"}
{"id": null, "n": "0714001", "target": "#nkr_note_mod_0714001", "type": "mod", "text": "譯【大】，釋【考偽-大】"}
{"id": null, "n": "0689001", "target": "#nkr_note_orig_0689001", "type": "orig", "text": "【原】寬文八年刊宗教大學藏本，【甲】元祿二年刊藥師寺藏本"}
{"id": null, "n": "0689002", "target": "#nkr_note_orig_0689002", "type": "orig", "text": "上＋（乾）【甲】"}
{"id": null, "n": "0689003", "target": "#nkr_note_orig_0689003", "type": "orig", "text": "請＝翻ィ【原】"}
{"id": null, "n": "0689004", "target": "#nkr_note_orig_0689004", "type": "orig", "text": "也＝此【甲】"}
{"id": null, "n": "0691001", "target": "#nkr_note_orig_0691001", "type": "orig", "text": "說＝談ィ【原】"}
{"id": null, "n": "0691002", "target": "#nkr_note_orig_0691002", "type": "orig", "text": "〔中〕－【甲】"}
{"id": null, "n": "0693001", "target": "#nkr_note_orig_0693001", "type": "orig", "text": "之＝也【甲】"}
{"id": null, "n": "0694001", "target": "#nkr_note_orig_0694001", "type": "orig", "text": "執＝瓶【甲】"}
{"id": null, "n": "0695001", "target": "#nkr_note_orig_0695001", "type": "orig", "text": "卷上乾終【甲】"}
{"id": null, "n": "0695002", "target": "#nkr_note_orig_0695002", "type": "orig", "text": "卷上坤首【甲】"}
{"id": null, "n": "0696001", "target": "#nkr_note_orig_0696001", "type": "orig", "text": "〔身〕－【甲】"}
{"id": null, "n": "0697001", "target": "#nkr_note_orig_0697001", "type": "orig", "text": "甲本冠註曰網義云知所二字寫倒歟名義集作所知"}
{"id": null, "n": "0698001", "target": "#nkr_note_orig_0698001", "type": "orig", "text": "甲本冠註曰私曰至無量意者恐傳寫誤當作至海一渧也文勢不然乎"}
{"id": null, "n": "0700001", "target": "#nkr_note_orig_0700001", "type": "orig", "text": "上＋（坤終）【甲】"}
{"id": null, "n": "0700002", "target": "#nkr_note_orig_0700002", "type": "orig", "text": "【原】延寶六年刊宗教大學藏本"}
{"id": null, "n": "0700003", "target": "#nkr_note_orig_0700003", "type": "orig", "text": "自下牒經置至字中間省略"}
{"id": null, "n": "0714001", "target": "#nkr_note_orig_0714001", "type": "orig", "text": "譯＝釋？"}
