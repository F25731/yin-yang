{"id": null, "n": "0847014", "target": "#nkr_note_orig_0847014", "type": "orig", "text": "彼＝後【元】【明】"}
{"id": null, "n": "0847015", "target": "#nkr_note_orig_0847015", "type": "orig", "text": "後＝彼【三】"}
{"id": null, "n": "0847016", "target": "#nkr_note_orig_0847016", "type": "orig", "text": "鮐＝傴【三】"}
{"id": null, "n": "0847017", "target": "#nkr_note_orig_0847017", "type": "orig", "text": "痛＝病【三】"}
{"id": null, "n": "0847018", "target": "#nkr_note_orig_0847018", "type": "orig", "text": "啄＝喙【宋】【元】"}
{"id": null, "n": "0848001", "target": "#nkr_note_orig_0848001", "type": "orig", "text": "而與住居＝如與住俱【三】＊"}
