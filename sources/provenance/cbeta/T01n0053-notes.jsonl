{"id": null, "n": "0847008", "target": "#nkr_note_orig_0847008", "type": "orig", "text": "杖＝仗【三】"}
{"id": null, "n": "0847009", "target": "#nkr_note_orig_0847009", "type": "orig", "text": "鏚＝銊【三】"}
{"id": null, "n": "0847010", "target": "#nkr_note_orig_0847010", "type": "orig", "text": "首＝手＋（或截其足）【三】"}
