{"id": null, "n": "0846001", "target": "#nkr_note_mod_0846001", "type": "mod", "text": "人名【大】，〔－〕【宋】【元】"}
{"id": null, "n": "0846002", "target": "#nkr_note_mod_0846002", "type": "mod", "text": "今附【大】，在【宋】【元】【明】"}
{"id": null, "n": "0846003", "target": "#nkr_note_mod_0846003", "type": "mod", "text": "道【大】，異道【宋】【元】【明】"}
{"id": null, "n": "0846004", "target": "#nkr_note_mod_0846004", "type": "mod", "text": "呰蔑【大】＊，訾懱【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0846005", "target": "#nkr_note_mod_0846005", "type": "mod", "text": "曰此諸比丘【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0846006", "target": "#nkr_note_mod_0846006", "type": "mod", "text": "污【大】，汗【宋】【元】【明】"}
{"id": null, "n": "0846007", "target": "#nkr_note_mod_0846007", "type": "mod", "text": "坐【大】，座【宋】【元】【明】"}
{"id": null, "n": "0847001", "target": "#nkr_note_mod_0847001", "type": "mod", "text": "功【大】，工【宋】【元】【明】"}
{"id": null, "n": "0847002", "target": "#nkr_note_mod_0847002", "type": "mod", "text": "伎【大】，技【元】【明】"}
{"id": null, "n": "0847003", "target": "#nkr_note_mod_0847003", "type": "mod", "text": "彼【大】，使【宋】【元】【明】"}
{"id": null, "n": "0847004", "target": "#nkr_note_mod_0847004", "type": "mod", "text": "椎【大】＊，槌【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0847005", "target": "#nkr_note_mod_0847005", "type": "mod", "text": "不使【大】，子便【宋】【元】【明】"}
{"id": null, "n": "0847006", "target": "#nkr_note_mod_0847006", "type": "mod", "text": "今【大】，令【宋】【元】【明】"}
{"id": null, "n": "0847007", "target": "#nkr_note_mod_0847007", "type": "mod", "text": "拳【大】，棒【宋】【元】【明】"}
{"id": null, "n": "0847008", "target": "#nkr_note_mod_0847008", "type": "mod", "text": "杖【大】，仗【宋】【元】【明】"}
{"id": null, "n": "0847009", "target": "#nkr_note_mod_0847009", "type": "mod", "text": "鏚【大】，銊【宋】【元】【明】"}
{"id": null, "n": "0847010", "target": "#nkr_note_mod_0847010", "type": "mod", "text": "首【大】，手＋（或截其足）【宋】【元】【明】"}
{"id": null, "n": "0847011", "target": "#nkr_note_mod_0847011", "type": "mod", "text": "撾打【大】，杖撾【宋】【元】【明】"}
{"id": null, "n": "0847012", "target": "#nkr_note_mod_0847012", "type": "mod", "text": "捲捲【大】，拳棒【宋】【元】，棒棒【明】"}
{"id": null, "n": "0847013", "target": "#nkr_note_mod_0847013", "type": "mod", "text": "現【大】，視【宋】"}
{"id": null, "n": "0847014", "target": "#nkr_note_mod_0847014", "type": "mod", "text": "彼【大】，後【元】【明】"}
{"id": null, "n": "0847015", "target": "#nkr_note_mod_0847015", "type": "mod", "text": "後【大】，彼【宋】【元】【明】"}
{"id": null, "n": "0847016", "target": "#nkr_note_mod_0847016", "type": "mod", "text": "鮐【大】，傴【宋】【元】【明】"}
{"id": null, "n": "0847017", "target": "#nkr_note_mod_0847017", "type": "mod", "text": "痛【大】，病【宋】【元】【明】"}
{"id": null, "n": "0847018", "target": "#nkr_note_mod_0847018", "type": "mod", "text": "啄【大】，喙【宋】【元】"}
{"id": null, "n": "0848001", "target": "#nkr_note_mod_0848001", "type": "mod", "text": "而與住居【大】＊，如與住俱【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0848002", "target": "#nkr_note_mod_0848002", "type": "mod", "text": "味【大】，味長【宋】【元】【明】"}
{"id": null, "n": "0846001", "target": "#nkr_note_orig_0846001", "type": "orig", "text": "〔人名〕－【宋】【元】"}
{"id": null, "n": "0846002", "target": "#nkr_note_orig_0846002", "type": "orig", "text": "今附＝在【三】"}
{"id": null, "n": "0846003", "target": "#nkr_note_orig_0846003", "type": "orig", "text": "（異）＋道【三】"}
