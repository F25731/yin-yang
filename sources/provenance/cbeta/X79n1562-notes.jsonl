{"id": null, "n": null, "target": null, "type": null, "text": "拾遺"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "英嗣九峯韶，為雲門六世。"}
{"id": null, "n": null, "target": null, "type": null, "text": "誾號悅堂，後嗣介石朋。"}
{"id": null, "n": null, "target": null, "type": null, "text": "有本云：涅槃堂裡看。"}
{"id": null, "n": null, "target": null, "type": null, "text": "即南宋光宗紹熈四年癸丑"}
{"id": null, "n": null, "target": null, "type": null, "text": "即南宗景定元年"}
{"id": null, "n": null, "target": null, "type": null, "text": "即南宋度宋三年"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云末後"}
{"id": null, "n": null, "target": null, "type": null, "text": "常號梅屋，著佛祖通載行世"}
{"id": null, "n": null, "target": null, "type": null, "text": "倫號仲方，後住保寧"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本云：動定不關，是甚磨人？"}
{"id": null, "n": null, "target": null, "type": null, "text": "有本名萬金"}
{"id": null, "n": null, "target": null, "type": null, "text": "訛作普慈"}
{"id": null, "n": null, "target": null, "type": null, "text": "訛作常熟錢氏"}
{"id": null, "n": null, "target": null, "type": null, "text": "訛作破山"}
{"id": null, "n": null, "target": null, "type": null, "text": "作明瑄，訛也"}
{"id": null, "n": null, "target": null, "type": null, "text": "安號懶雲"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本云：安稱極則。"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本纔禮拜，瑞\n便打"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本云豈能勘破"}
{"id": null, "n": null, "target": null, "type": null, "text": "即曇芝上\n座"}
{"id": null, "n": null, "target": null, "type": null, "text": "有正錄三卷，并師下三世語錄若干卷，屬四川向化侯譚養元捐俸梓板，附嘉興楞嚴藏流通。"}
