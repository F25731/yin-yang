{"id": null, "n": null, "target": null, "type": "cf1", "text": "X01n0021_p0409b12"}
{"id": null, "n": "0324001", "target": "#nkr_note_orig_0324001", "type": "orig", "text": "「念」，原碑漫漶，據文意補。"}
{"id": null, "n": "0324002", "target": "#nkr_note_orig_0324002", "type": "orig", "text": "「陀佛」，原碑漫漶，按文意補。"}
{"id": null, "n": "0325001", "target": "#nkr_note_orig_0325001", "type": "orig", "text": "此段文字刊刻在裝置碓啄的木槓面上。"}
{"id": null, "n": "0325002", "target": "#nkr_note_orig_0325002", "type": "orig", "text": "此段文字豎刻石碓啄上。"}
{"id": null, "n": "0326001", "target": "#nkr_note_orig_0326001", "type": "orig", "text": "「義」，應為「叉」之誤。"}
{"id": null, "n": "0326002", "target": "#nkr_note_orig_0326002", "type": "orig", "text": "「詓」，應為「訖」之誤。"}
{"id": null, "n": "0327001", "target": "#nkr_note_orig_0327001", "type": "orig", "text": "此處約殘2行字。"}
{"id": null, "n": "0328001", "target": "#nkr_note_orig_0328001", "type": "orig", "text": "「各名自家」四字依稀可辨。"}
{"id": null, "n": "0321a1901", "target": "#nkr_note_add_0321a1901", "type": "add", "text": "遣【CB】，遺【藏外】"}
{"id": null, "n": "0327a2201", "target": "#nkr_note_add_0327a2201", "type": "add", "text": "挾【CB】，俠【藏外】"}
