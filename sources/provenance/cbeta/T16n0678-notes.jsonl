{"id": null, "n": null, "target": null, "type": null, "text": "丹鄉本有彼"}
{"id": null, "n": null, "target": null, "type": null, "text": "行音衡"}
{"id": null, "n": null, "target": null, "type": null, "text": "三（丹\n鄉本二）月為一節、一節名離兜"}
{"id": null, "n": null, "target": null, "type": null, "text": "丹鄉本有彼"}
{"id": null, "n": null, "target": null, "type": null, "text": "行音衡"}
{"id": null, "n": null, "target": null, "type": null, "text": "音衡"}
{"id": null, "n": "0714011", "target": "#nkr_note_mod_0714011", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0714012", "target": "#nkr_note_mod_0714012", "type": "mod", "text": "宋【大】，劉宋【元】【明】"}
{"id": null, "n": "0714013", "target": "#nkr_note_mod_0714013", "type": "mod", "text": "藏【大】，藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0714014", "target": "#nkr_note_mod_0714014", "type": "mod", "text": "悕【大】下同，希【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0715001", "target": "#nkr_note_mod_0715001", "type": "mod", "text": "癡【大】，疑【宋】【元】【明】【宮】"}
{"id": null, "n": "0715002", "target": "#nkr_note_mod_0715002", "type": "mod", "text": "謂【大】，謂增【宋】【元】【明】【宮】"}
{"id": null, "n": "0715003", "target": "#nkr_note_mod_0715003", "type": "mod", "text": "唯【大】下同，惟【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0716001", "target": "#nkr_note_mod_0716001", "type": "mod", "text": "生【大】，不【宋】【元】【明】【宮】"}
{"id": null, "n": "0716002", "target": "#nkr_note_mod_0716002", "type": "mod", "text": "不【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0716003", "target": "#nkr_note_mod_0716003", "type": "mod", "text": "戒【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0717001", "target": "#nkr_note_mod_0717001", "type": "mod", "text": "大【大】，入【元】【明】"}
{"id": null, "n": "0717002", "target": "#nkr_note_mod_0717002", "type": "mod", "text": "二【大】，〔－〕【宋】"}
{"id": null, "n": "0717003", "target": "#nkr_note_mod_0717003", "type": "mod", "text": "閡【大】，礙【宮】"}
{"id": null, "n": "0717004", "target": "#nkr_note_mod_0717004", "type": "mod", "text": "常【大】，當【元】【明】"}
{"id": null, "n": "0717005", "target": "#nkr_note_mod_0717005", "type": "mod", "text": "攝【大】，攝取【宋】【元】【明】【宮】"}
{"id": null, "n": "0717006", "target": "#nkr_note_mod_0717006", "type": "mod", "text": "而【大】，不【元】【明】"}
{"id": null, "n": "0717007", "target": "#nkr_note_mod_0717007", "type": "mod", "text": "非【大】，而為非【宋】【宮】，而為【元】【明】"}
{"id": null, "n": "0717008", "target": "#nkr_note_mod_0717008", "type": "mod", "text": "斷【大】，伏【元】【明】"}
{"id": null, "n": "0717009", "target": "#nkr_note_mod_0717009", "type": "mod", "text": "伴丹鄉本有彼【大】，伴彼【宋】【元】【明】【宮】"}
{"id": null, "n": null, "target": null, "type": null, "text": "丹鄉本有彼"}
{"id": null, "n": "0717010", "target": "#nkr_note_mod_0717010", "type": "mod", "text": "行音衡【大】，〔－〕【明】，音衡【元】"}
{"id": null, "n": "0717011", "target": "#nkr_note_mod_0717011", "type": "mod", "text": "三【大】，二【宋】【元】【明】【宮】"}
{"id": null, "n": "0717012", "target": "#nkr_note_mod_0717012", "type": "mod", "text": "（丹鄉本二）【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0718001", "target": "#nkr_note_mod_0718001", "type": "mod", "text": "令【大】，今【宋】【元】【明】【宮】"}
{"id": null, "n": "0718002", "target": "#nkr_note_mod_0718002", "type": "mod", "text": "想【大】，相【宋】【元】【明】【宮】"}
{"id": null, "n": "0714011", "target": "#nkr_note_orig_0714011", "type": "orig", "text": "〔一卷〕－【三】【宮】"}
{"id": null, "n": "0714012", "target": "#nkr_note_orig_0714012", "type": "orig", "text": "（劉）＋宋【元】【明】"}
{"id": null, "n": "0714013", "target": "#nkr_note_orig_0714013", "type": "orig", "text": "藏＋（法師）【三】【宮】"}
{"id": null, "n": "0714014", "target": "#nkr_note_orig_0714014", "type": "orig", "text": "悕＝希【三】【宮】下同"}
{"id": null, "n": "0715001", "target": "#nkr_note_orig_0715001", "type": "orig", "text": "癡＝疑【三】【宮】"}
{"id": null, "n": "0715002", "target": "#nkr_note_orig_0715002", "type": "orig", "text": "謂＋（增）【三】【宮】"}
{"id": null, "n": "0715003", "target": "#nkr_note_orig_0715003", "type": "orig", "text": "唯＝惟【三】【宮】下同"}
{"id": null, "n": "0716001", "target": "#nkr_note_orig_0716001", "type": "orig", "text": "生＝不【三】【宮】"}
{"id": null, "n": "0716002", "target": "#nkr_note_orig_0716002", "type": "orig", "text": "〔不〕－【三】【宮】"}
{"id": null, "n": "0716003", "target": "#nkr_note_orig_0716003", "type": "orig", "text": "〔戒〕－【三】【宮】"}
{"id": null, "n": "0717001", "target": "#nkr_note_orig_0717001", "type": "orig", "text": "大＝入【元】【明】"}
{"id": null, "n": "0717002", "target": "#nkr_note_orig_0717002", "type": "orig", "text": "〔二〕－【宋】"}
{"id": null, "n": "0717003", "target": "#nkr_note_orig_0717003", "type": "orig", "text": "閡＝礙【宮】"}
{"id": null, "n": "0717004", "target": "#nkr_note_orig_0717004", "type": "orig", "text": "常＝當【元】【明】"}
{"id": null, "n": "0717005", "target": "#nkr_note_orig_0717005", "type": "orig", "text": "攝＋（取）【三】【宮】"}
{"id": null, "n": "0717006", "target": "#nkr_note_orig_0717006", "type": "orig", "text": "而＝不【元】【明】"}
{"id": null, "n": "0717007", "target": "#nkr_note_orig_0717007", "type": "orig", "text": "非＝而為非【宋】【宮】，而為【元】【明】"}
{"id": null, "n": "0717008", "target": "#nkr_note_orig_0717008", "type": "orig", "text": "斷＝伏【元】【明】"}
{"id": null, "n": "0717009", "target": "#nkr_note_orig_0717009", "type": "orig", "text": "伴下宋元明三本及宮本俱無夾註而有彼字"}
{"id": null, "n": "0717010", "target": "#nkr_note_orig_0717010", "type": "orig", "text": "〔行〕－【元】，〔行音衡〕－【明】"}
{"id": null, "n": "0717011", "target": "#nkr_note_orig_0717011", "type": "orig", "text": "三＝二【三】【宮】"}
{"id": null, "n": "0717012", "target": "#nkr_note_orig_0717012", "type": "orig", "text": "〔丹鄉本二〕－【三】【宮】"}
{"id": null, "n": "0718001", "target": "#nkr_note_orig_0718001", "type": "orig", "text": "令＝今【三】【宮】"}
{"id": null, "n": "0718002", "target": "#nkr_note_orig_0718002", "type": "orig", "text": "想＝相【三】【宮】"}
{"id": null, "n": "0718003", "target": "#nkr_note_orig_0718003", "type": "orig", "text": "三昧之次行明本有相續解脫地波羅蜜了義經之十一字"}
