{"id": null, "n": "0769003", "target": "#nkr_note_mod_0769003", "type": "mod", "text": "味【大】，未【甲】"}
{"id": null, "n": "0770001", "target": "#nkr_note_mod_0770001", "type": "mod", "text": "又【大】，叉【甲】"}
{"id": null, "n": "0769002", "target": "#nkr_note_orig_0769002", "type": "orig", "text": "【原】順治十八年刊增上寺報恩藏本，【甲】延寶三年刊大谷大學藏本"}
{"id": null, "n": "0769003", "target": "#nkr_note_orig_0769003", "type": "orig", "text": "味＝未【甲】"}
{"id": null, "n": "0770001", "target": "#nkr_note_orig_0770001", "type": "orig", "text": "又＝叉【甲】"}
{"id": null, "n": "0772001", "target": "#nkr_note_orig_0772001", "type": "orig", "text": "甲本冠註曰此知準四教儀合作知此"}
