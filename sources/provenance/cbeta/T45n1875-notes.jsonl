{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "有本云無生之理，菩提涅槃為家"}
{"id": null, "n": null, "target": null, "type": null, "text": "鴻\n緒"}
{"id": null, "n": null, "target": null, "type": null, "text": "陞"}
{"id": null, "n": "0627002", "target": "#nkr_note_mod_0627002", "type": "mod", "text": "開【大】，則【甲】"}
{"id": null, "n": "0633001", "target": "#nkr_note_mod_0633001", "type": "mod", "text": "彰【大】，影【甲】"}
{"id": null, "n": "0633002", "target": "#nkr_note_mod_0633002", "type": "mod", "text": "葉【大】，業【甲】"}
{"id": null, "n": "0634001", "target": "#nkr_note_mod_0634001", "type": "mod", "text": "愛【CB】，受【大】，愛【考偽-大】"}
{"id": null, "n": "0635001", "target": "#nkr_note_mod_0635001", "type": "mod", "text": "性【大】，生【甲】"}
{"id": null, "n": "0635003", "target": "#nkr_note_mod_0635003", "type": "mod", "text": "以【大】，此【甲】"}
{"id": null, "n": "0636001", "target": "#nkr_note_mod_0636001", "type": "mod", "text": "淨【大】，法【甲】"}
{"id": null, "n": "0636002", "target": "#nkr_note_mod_0636002", "type": "mod", "text": "門【大】，門終【甲】"}
{"id": null, "n": "0636003", "target": "#nkr_note_mod_0636003", "type": "mod", "text": "句【大】，勾【甲】"}
{"id": null, "n": "0627001", "target": "#nkr_note_orig_0627001", "type": "orig", "text": "【原】德川時代刊大谷大學藏本，【甲】大日本續藏經"}
{"id": null, "n": "0627002", "target": "#nkr_note_orig_0627002", "type": "orig", "text": "開＝則【甲】"}
{"id": null, "n": "0633001", "target": "#nkr_note_orig_0633001", "type": "orig", "text": "彰＝影【甲】"}
{"id": null, "n": "0633002", "target": "#nkr_note_orig_0633002", "type": "orig", "text": "葉＝業【甲】"}
{"id": null, "n": "0634001", "target": "#nkr_note_orig_0634001", "type": "orig", "text": "受＝愛？"}
{"id": null, "n": "0634002", "target": "#nkr_note_orig_0634002", "type": "orig", "text": "甲本冠註曰變下疑有脫文"}
{"id": null, "n": "0635001", "target": "#nkr_note_orig_0635001", "type": "orig", "text": "性＝生【甲】"}
{"id": null, "n": "0635002", "target": "#nkr_note_orig_0635002", "type": "orig", "text": "甲本冠註曰眼上疑脫法佛肉天等字"}
{"id": null, "n": "0635003", "target": "#nkr_note_orig_0635003", "type": "orig", "text": "以＝此【甲】"}
{"id": null, "n": "0636001", "target": "#nkr_note_orig_0636001", "type": "orig", "text": "淨＝法【甲】"}
{"id": null, "n": "0636002", "target": "#nkr_note_orig_0636002", "type": "orig", "text": "門＋（終）【甲】"}
{"id": null, "n": "0636003", "target": "#nkr_note_orig_0636003", "type": "orig", "text": "句＝勾【甲】"}
