{"id": null, "n": "0200010", "target": "#nkr_note_mod_0200010", "type": "mod", "text": "唐【大】，唐北【元】【明】"}
{"id": null, "n": "0200011", "target": "#nkr_note_mod_0200011", "type": "mod", "text": "藏【大】，藏法師【宋】【元】【明】"}
{"id": null, "n": "0200012", "target": "#nkr_note_mod_0200012", "type": "mod", "text": "熙【大】，希【宋】【元】【明】"}
{"id": null, "n": "0200013", "target": "#nkr_note_mod_0200013", "type": "mod", "text": "二合【大】＊，〔－〕【宋】＊"}
{"id": null, "n": "0200014", "target": "#nkr_note_mod_0200014", "type": "mod", "text": "靺【大】，靺音末【宋】"}
{"id": null, "n": null, "target": null, "type": null, "text": "音末"}
{"id": null, "n": "0200015", "target": "#nkr_note_mod_0200015", "type": "mod", "text": "二合【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0200016", "target": "#nkr_note_mod_0200016", "type": "mod", "text": "耶【大】，吔【宋】"}
{"id": null, "n": "0200017", "target": "#nkr_note_mod_0200017", "type": "mod", "text": "平【大】，平聲【明】"}
{"id": null, "n": "0200018", "target": "#nkr_note_mod_0200018", "type": "mod", "text": "天【大】，大【明】"}
{"id": null, "n": "0200019", "target": "#nkr_note_mod_0200019", "type": "mod", "text": "加【大】，迦【明】"}
{"id": null, "n": "0200020", "target": "#nkr_note_mod_0200020", "type": "mod", "text": "印【大】，即【宋】【元】【明】"}
{"id": null, "n": "0201001", "target": "#nkr_note_mod_0201001", "type": "mod", "text": "能【大】，德【宋】【元】【明】"}
{"id": null, "n": "0201002", "target": "#nkr_note_mod_0201002", "type": "mod", "text": "若【大】，者【明】"}
{"id": null, "n": "0201003", "target": "#nkr_note_mod_0201003", "type": "mod", "text": "十【大】，七【宋】【元】【明】"}
{"id": null, "n": "0201004", "target": "#nkr_note_mod_0201004", "type": "mod", "text": "觀【大】，觀世【宋】【元】【明】"}
{"id": null, "n": "0201005", "target": "#nkr_note_mod_0201005", "type": "mod", "text": "輪【大】，輪王【宋】【元】【明】"}
{"id": null, "n": "0201006", "target": "#nkr_note_mod_0201006", "type": "mod", "text": "子汁【大】，子汁【宋】【元】【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "子汁"}
{"id": null, "n": "0201007", "target": "#nkr_note_mod_0201007", "type": "mod", "text": "畢撥【大】，蓽茇【宋】【元】【明】"}
{"id": null, "n": "0201008", "target": "#nkr_note_mod_0201008", "type": "mod", "text": "以【大】，已【宋】【元】【明】"}
{"id": null, "n": "0201009", "target": "#nkr_note_mod_0201009", "type": "mod", "text": "病【大】，痛【宋】【元】【明】"}
{"id": null, "n": "0201010", "target": "#nkr_note_mod_0201010", "type": "mod", "text": "皆悉【大】，悉階【明】"}
{"id": null, "n": "0201011", "target": "#nkr_note_mod_0201011", "type": "mod", "text": "羅【大】，羅剎及羅【宋】【元】【明】"}
{"id": null, "n": "0201012", "target": "#nkr_note_mod_0201012", "type": "mod", "text": "藏【大】，伏藏【宋】【元】【明】"}
{"id": null, "n": "0201013", "target": "#nkr_note_mod_0201013", "type": "mod", "text": "至【大】，至無有【宋】【元】【明】"}
{"id": null, "n": "0201014", "target": "#nkr_note_mod_0201014", "type": "mod", "text": "入【大】，入十四七日塗【宋】【元】【明】"}
{"id": null, "n": "0201015", "target": "#nkr_note_mod_0201015", "type": "mod", "text": "（十四…見）十九字【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0201016", "target": "#nkr_note_mod_0201016", "type": "mod", "text": "最【大】，眾【明】"}
{"id": null, "n": "0202001", "target": "#nkr_note_mod_0202001", "type": "mod", "text": "取【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0200009", "target": "#nkr_note_orig_0200009", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0200010", "target": "#nkr_note_orig_0200010", "type": "orig", "text": "唐＋（北）【元】【明】"}
{"id": null, "n": "0200011", "target": "#nkr_note_orig_0200011", "type": "orig", "text": "藏＋（法師）【三】"}
{"id": null, "n": "0200012", "target": "#nkr_note_orig_0200012", "type": "orig", "text": "熙＝希【三】"}
{"id": null, "n": "0200013", "target": "#nkr_note_orig_0200013", "type": "orig", "text": "〔二合〕－【宋】＊"}
{"id": null, "n": "0200014", "target": "#nkr_note_orig_0200014", "type": "orig", "text": "靺＋（音末）夾註【宋】"}
{"id": null, "n": "0200015", "target": "#nkr_note_orig_0200015", "type": "orig", "text": "〔二合〕－【三】"}
{"id": null, "n": "0200016", "target": "#nkr_note_orig_0200016", "type": "orig", "text": "耶＝吔【宋】"}
{"id": null, "n": "0200017", "target": "#nkr_note_orig_0200017", "type": "orig", "text": "平＋（聲）【明】"}
{"id": null, "n": "0200018", "target": "#nkr_note_orig_0200018", "type": "orig", "text": "天＝大【明】"}
{"id": null, "n": "0200019", "target": "#nkr_note_orig_0200019", "type": "orig", "text": "加＝迦【明】"}
{"id": null, "n": "0200020", "target": "#nkr_note_orig_0200020", "type": "orig", "text": "印＝即【三】"}
{"id": null, "n": "0201001", "target": "#nkr_note_orig_0201001", "type": "orig", "text": "能＝德【三】"}
{"id": null, "n": "0201002", "target": "#nkr_note_orig_0201002", "type": "orig", "text": "若＝者【明】"}
{"id": null, "n": "0201003", "target": "#nkr_note_orig_0201003", "type": "orig", "text": "十＝七【三】"}
{"id": null, "n": "0201004", "target": "#nkr_note_orig_0201004", "type": "orig", "text": "觀＋（世）【三】"}
{"id": null, "n": "0201005", "target": "#nkr_note_orig_0201005", "type": "orig", "text": "輪＋（王）【三】"}
{"id": null, "n": "0201006", "target": "#nkr_note_orig_0201006", "type": "orig", "text": "子汁宋元明三本俱作細註"}
{"id": null, "n": "0201007", "target": "#nkr_note_orig_0201007", "type": "orig", "text": "畢撥＝蓽茇【三】"}
{"id": null, "n": "0201008", "target": "#nkr_note_orig_0201008", "type": "orig", "text": "以＝已【三】"}
{"id": null, "n": "0201009", "target": "#nkr_note_orig_0201009", "type": "orig", "text": "病＝痛【三】"}
{"id": null, "n": "0201010", "target": "#nkr_note_orig_0201010", "type": "orig", "text": "皆悉＝悉階【明】"}
{"id": null, "n": "0201011", "target": "#nkr_note_orig_0201011", "type": "orig", "text": "（羅剎及）＋羅【三】"}
{"id": null, "n": "0201012", "target": "#nkr_note_orig_0201012", "type": "orig", "text": "（伏）＋藏【三】"}
{"id": null, "n": "0201013", "target": "#nkr_note_orig_0201013", "type": "orig", "text": "至＋（無有）【三】"}
{"id": null, "n": "0201014", "target": "#nkr_note_orig_0201014", "type": "orig", "text": "入＋（十四七日塗）【三】"}
{"id": null, "n": "0201015", "target": "#nkr_note_orig_0201015", "type": "orig", "text": "〔十四…見〕十九字－【三】"}
{"id": null, "n": "0201016", "target": "#nkr_note_orig_0201016", "type": "orig", "text": "最＝眾【明】"}
{"id": null, "n": "0202001", "target": "#nkr_note_orig_0202001", "type": "orig", "text": "〔取〕－【三】"}
