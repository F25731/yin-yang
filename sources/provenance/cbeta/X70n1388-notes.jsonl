{"id": null, "n": null, "target": null, "type": null, "text": "問答不錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "問答不錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "問答不錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "師着語云：妄起兵端。"}
{"id": null, "n": null, "target": null, "type": null, "text": "一鏃不施，折衝千里。"}
{"id": null, "n": null, "target": null, "type": null, "text": "討兵救援。"}
{"id": null, "n": null, "target": null, "type": null, "text": "挾天子令\n諸侯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "一擒一縱。"}
{"id": null, "n": null, "target": null, "type": null, "text": "詐納降欵。"}
{"id": null, "n": null, "target": null, "type": null, "text": "夫\n人既降，殺之不祥。"}
{"id": null, "n": null, "target": null, "type": null, "text": "其然\n〔次〕，豈其然乎？"}
{"id": null, "n": null, "target": null, "type": null, "text": "恭而無禮，克由叵耐。"}
{"id": null, "n": null, "target": null, "type": null, "text": "師着語云：更\n須行脚始得。"}
{"id": null, "n": null, "target": null, "type": null, "text": "箭不虛\n發。"}
{"id": null, "n": null, "target": null, "type": null, "text": "門庭施設，似則也似。"}
{"id": null, "n": null, "target": null, "type": null, "text": "性命\n已在夾山手裏。"}
{"id": null, "n": null, "target": null, "type": null, "text": "強惺惺，棺木裏瞠眼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "四十斤鐵槌劈頭一下。"}
{"id": null, "n": null, "target": null, "type": null, "text": "一欵便招。"}
{"id": null, "n": null, "target": null, "type": null, "text": "再下一槌。"}
{"id": null, "n": null, "target": null, "type": null, "text": "伎倆已盡。"}
{"id": null, "n": null, "target": null, "type": null, "text": "截斷命根。"}
{"id": null, "n": null, "target": null, "type": null, "text": "一死更不\n再活。"}
{"id": null, "n": null, "target": null, "type": null, "text": "成始成終，不打也好。"}
{"id": null, "n": null, "target": null, "type": null, "text": "師着語云：答得甚諦當，切忌怕人\n笑。"}
{"id": null, "n": null, "target": null, "type": null, "text": "不是好笑，貪他底，著他底。"}
{"id": null, "n": null, "target": null, "type": null, "text": "果然。"}
{"id": null, "n": null, "target": null, "type": null, "text": "殺人刀，活人劒。"}
{"id": null, "n": null, "target": null, "type": null, "text": "實\n頭人難得。"}
{"id": null, "n": null, "target": null, "type": null, "text": "為人須為徹，一舉兩得。"}
{"id": null, "n": null, "target": null, "type": null, "text": "未見已前，不妨疑着。"}
{"id": null, "n": null, "target": null, "type": null, "text": "莫謗船子好。"}
{"id": null, "n": null, "target": null, "type": null, "text": "教人作竊，禮合如是。"}
{"id": null, "n": null, "target": null, "type": null, "text": "丈夫志氣，不因楊得意，爭\n見馬相如。"}
{"id": null, "n": null, "target": null, "type": null, "text": "從苗辨地。"}
{"id": null, "n": null, "target": null, "type": null, "text": "熟處難忘。"}
{"id": null, "n": null, "target": null, "type": null, "text": "雖然船裏無魚，明月也須搜過。"}
{"id": null, "n": null, "target": null, "type": null, "text": "瞞別人即得。"}
{"id": null, "n": null, "target": null, "type": null, "text": "將來擒之，必先\n縱之。"}
{"id": null, "n": null, "target": null, "type": null, "text": "伎倆已盡。"}
{"id": null, "n": null, "target": null, "type": null, "text": "肺腑間病，一時透見了也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "門上一針。"}
{"id": null, "n": null, "target": null, "type": null, "text": "砒霜狼毒。"}
{"id": null, "n": null, "target": null, "type": null, "text": "巴豆黃連"}
{"id": null, "n": null, "target": null, "type": null, "text": "慚愧慚愧，通身白汗，藥不瞑眩，厥疾弗廖"}
{"id": null, "n": null, "target": null, "type": null, "text": "大斧斫了手摩\n挲，去砭劑，進膏肓"}
{"id": null, "n": null, "target": null, "type": null, "text": "妙訣\n丹方，不容不問"}
{"id": null, "n": null, "target": null, "type": null, "text": "草本\n不勞拈出"}
{"id": null, "n": null, "target": null, "type": null, "text": "開得\n眼來天□曉"}
{"id": null, "n": null, "target": null, "type": null, "text": "得箇魚兒便\n喜歡，費力不少"}
{"id": null, "n": null, "target": null, "type": null, "text": "滿面慚惶無著處"}
{"id": null, "n": null, "target": null, "type": null, "text": "龍頭蛇尾，竹篙在什麼處"}
{"id": null, "n": null, "target": null, "type": null, "text": "鬼家活計"}
{"id": null, "n": null, "target": null, "type": null, "text": "鈍根阿師"}
{"id": null, "n": null, "target": null, "type": null, "text": "前頭驚殺人，後頭笑殺人"}
{"id": null, "n": null, "target": null, "type": null, "text": "半是思君半恨君"}
{"id": null, "n": null, "target": null, "type": null, "text": "老婆心切，着甚來由"}
{"id": null, "n": null, "target": null, "type": null, "text": "却較些子，已遲八刻"}
{"id": null, "n": null, "target": null, "type": null, "text": "能誦法華"}
{"id": null, "n": null, "target": null, "type": null, "text": "問答不錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "是夜雷雨"}
{"id": null, "n": null, "target": null, "type": null, "text": "問答不錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "視其所以。"}
{"id": null, "n": null, "target": null, "type": null, "text": "詣實供通。"}
{"id": null, "n": null, "target": null, "type": null, "text": "觀其所由。"}
{"id": null, "n": null, "target": null, "type": null, "text": "文殊，文\n殊。"}
{"id": null, "n": null, "target": null, "type": null, "text": "察其所安。"}
{"id": null, "n": null, "target": null, "type": null, "text": "不可更有二文殊。"}
{"id": null, "n": null, "target": null, "type": null, "text": "人焉廋哉？人焉廋哉？"}
{"id": null, "n": null, "target": null, "type": null, "text": "不可放過。"}
{"id": null, "n": null, "target": null, "type": null, "text": "形\n於未兆，見於未然，狼藉不少。"}
{"id": null, "n": null, "target": null, "type": null, "text": "克由\n叵耐。"}
{"id": null, "n": null, "target": null, "type": null, "text": "前倨後恭，是何心行？"}
{"id": null, "n": null, "target": null, "type": null, "text": "作家，作家。"}
{"id": null, "n": null, "target": null, "type": null, "text": "放過不可。"}
{"id": null, "n": null, "target": null, "type": null, "text": "相見之初，不容不問。"}
{"id": null, "n": null, "target": null, "type": null, "text": "着實祗對。"}
{"id": null, "n": null, "target": null, "type": null, "text": "就身打劫。"}
{"id": null, "n": null, "target": null, "type": null, "text": "披襟承當。"}
{"id": null, "n": null, "target": null, "type": null, "text": "恐未真實，難為模邈。"}
{"id": null, "n": null, "target": null, "type": null, "text": "道\n地所產，宛爾不同，果然。"}
{"id": null, "n": null, "target": null, "type": null, "text": "隨身受用。"}
{"id": null, "n": null, "target": null, "type": null, "text": "已傾出了也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "猶\n嫌少在。"}
{"id": null, "n": null, "target": null, "type": null, "text": "滿地狼藉，好與三十棒。"}
{"id": null, "n": null, "target": null, "type": null, "text": "惡水潑人，掀倒\n禪床。"}
{"id": null, "n": null, "target": null, "type": null, "text": "賓主歷然。"}
{"id": null, "n": null, "target": null, "type": null, "text": "賓則\n始終賓，主則始終主。"}
{"id": null, "n": null, "target": null, "type": null, "text": "賓中有主，主中有賓。"}
{"id": null, "n": null, "target": null, "type": null, "text": "全賓全主，全主全賓。"}
{"id": null, "n": null, "target": null, "type": null, "text": "易開終始\n口，難保歲寒心"}
{"id": null, "n": null, "target": null, "type": null, "text": "果然"}
{"id": null, "n": null, "target": null, "type": null, "text": "舊病再發"}
{"id": null, "n": null, "target": null, "type": null, "text": "只好棒\n打趁出"}
{"id": null, "n": null, "target": null, "type": null, "text": "姦人多詐"}
{"id": null, "n": null, "target": null, "type": null, "text": "醍醐毒藥"}
{"id": null, "n": null, "target": null, "type": null, "text": "棺\n木裏瞠眼"}
{"id": null, "n": null, "target": null, "type": null, "text": "惜乎太遲"}
{"id": null, "n": null, "target": null, "type": null, "text": "敗也敗也"}
{"id": null, "n": null, "target": null, "type": null, "text": "美\n食不中飽人喫"}
{"id": null, "n": null, "target": null, "type": null, "text": "果然"}
{"id": null, "n": null, "target": null, "type": null, "text": "不可放過"}
{"id": null, "n": null, "target": null, "type": null, "text": "從來疑着\n這漢"}
{"id": null, "n": null, "target": null, "type": null, "text": "放過不可"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "明曾做維那"}
{"id": null, "n": null, "target": null, "type": null, "text": "元宵"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "茲"}
{"id": null, "n": null, "target": null, "type": null, "text": "甫"}
{"id": null, "n": null, "target": null, "type": null, "text": "恪"}
{"id": null, "n": null, "target": null, "type": null, "text": "應孫"}
{"id": null, "n": null, "target": null, "type": null, "text": "壽"}
{"id": null, "n": null, "target": null, "type": null, "text": "孝慶"}
{"id": null, "n": null, "target": null, "type": null, "text": "震"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒙"}
{"id": null, "n": null, "target": null, "type": null, "text": "普明"}
{"id": null, "n": null, "target": null, "type": null, "text": "覺性"}
{"id": null, "n": "0365001", "target": "#nkr_note_orig_0365001", "type": "orig", "text": "云一作之次同"}
{"id": null, "n": "0365002", "target": "#nkr_note_orig_0365002", "type": "orig", "text": "將字更勘"}
{"id": null, "n": "0365003", "target": "#nkr_note_orig_0365003", "type": "orig", "text": "率字更勘"}
{"id": null, "n": "0365004", "target": "#nkr_note_orig_0365004", "type": "orig", "text": "□疑之"}
{"id": null, "n": "0367001", "target": "#nkr_note_orig_0367001", "type": "orig", "text": "東一作束"}
{"id": null, "n": "0369001", "target": "#nkr_note_orig_0369001", "type": "orig", "text": "霶疑𩃱"}
{"id": null, "n": "0372001", "target": "#nkr_note_orig_0372001", "type": "orig", "text": "次疑矣"}
{"id": null, "n": "0373001", "target": "#nkr_note_orig_0373001", "type": "orig", "text": "浮疑懸"}
{"id": null, "n": "0378001", "target": "#nkr_note_orig_0378001", "type": "orig", "text": "若少二字似衍"}
{"id": null, "n": "0378002", "target": "#nkr_note_orig_0378002", "type": "orig", "text": "□疑者"}
{"id": null, "n": "0380001", "target": "#nkr_note_orig_0380001", "type": "orig", "text": "忘疑妄"}
{"id": null, "n": "0386001", "target": "#nkr_note_orig_0386001", "type": "orig", "text": "行疑拙"}
{"id": null, "n": "0387001", "target": "#nkr_note_orig_0387001", "type": "orig", "text": "寉疑虎"}
{"id": null, "n": "0390001", "target": "#nkr_note_orig_0390001", "type": "orig", "text": "化疑他"}
{"id": null, "n": "0390002", "target": "#nkr_note_orig_0390002", "type": "orig", "text": "一疑必"}
{"id": null, "n": "0392001", "target": "#nkr_note_orig_0392001", "type": "orig", "text": "崧一作嵩"}
{"id": null, "n": "0392002", "target": "#nkr_note_orig_0392002", "type": "orig", "text": "韻一作韶"}
{"id": null, "n": "0393001", "target": "#nkr_note_orig_0393001", "type": "orig", "text": "如一作加"}
{"id": null, "n": "0396001", "target": "#nkr_note_orig_0396001", "type": "orig", "text": "今一作令"}
{"id": null, "n": "0396002", "target": "#nkr_note_orig_0396002", "type": "orig", "text": "頂一作項"}
{"id": null, "n": "0396003", "target": "#nkr_note_orig_0396003", "type": "orig", "text": "撥一作揆"}
