{"id": null, "n": "0902003", "target": "#nkr_note_mod_0902003", "type": "mod", "text": "令【大】，令今【宋】【元】【明】"}
{"id": null, "n": "0902004", "target": "#nkr_note_mod_0902004", "type": "mod", "text": "法【大】，法樂法【宋】【元】【明】"}
{"id": null, "n": "0902005", "target": "#nkr_note_mod_0902005", "type": "mod", "text": "無【大】，智【宋】【元】【明】"}
{"id": null, "n": "0902006", "target": "#nkr_note_mod_0902006", "type": "mod", "text": "行【大】，行彼【宋】【元】【明】"}
{"id": null, "n": "0903001", "target": "#nkr_note_mod_0903001", "type": "mod", "text": "此【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0903002", "target": "#nkr_note_mod_0903002", "type": "mod", "text": "便【大】，更【宋】【元】【明】"}
{"id": null, "n": "0903003", "target": "#nkr_note_mod_0903003", "type": "mod", "text": "酥【大】，蘇【宋】【元】【明】"}
{"id": null, "n": "0903004", "target": "#nkr_note_mod_0903004", "type": "mod", "text": "者【大】，有【宋】【元】【明】"}
{"id": null, "n": "0902003", "target": "#nkr_note_orig_0902003", "type": "orig", "text": "令＋（今）【三】"}
