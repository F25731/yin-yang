{"id": null, "n": "0903a1901", "target": "#nkr_note_add_0903a1901", "type": "add", "text": "如【CB】【麗-CB】，此【大】"}
{"id": null, "n": "0903a2601", "target": "#nkr_note_add_0903a2601", "type": "add", "text": "行【CB】【麗-CB】，已【大】"}
{"id": null, "n": "0903b0501", "target": "#nkr_note_add_0903b0501", "type": "add", "text": "彼【CB】，不【大】"}
