{"id": null, "n": "0092a1401", "target": "#nkr_note_add_0092a1401", "type": "add", "text": "有【CB】，無【大】"}
{"id": null, "n": "0092b1401", "target": "#nkr_note_add_0092b1401", "type": "add", "text": "北【CB】，先【大】"}
{"id": null, "n": "0092b1501", "target": "#nkr_note_add_0092b1501", "type": "add", "text": "啼【CB】，蹄【大】"}
