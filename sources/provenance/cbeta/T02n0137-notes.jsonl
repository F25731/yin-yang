{"id": null, "n": "0860001", "target": "#nkr_note_mod_0860001", "type": "mod", "text": "舍【大】＊，佛說舍【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0860002", "target": "#nkr_note_mod_0860002", "type": "mod", "text": "摩訶目連【大】＊，目犍連【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0860003", "target": "#nkr_note_mod_0860003", "type": "mod", "text": "外國三藏【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0860004", "target": "#nkr_note_mod_0860004", "type": "mod", "text": "乾【大】＊，犍【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0860005", "target": "#nkr_note_mod_0860005", "type": "mod", "text": "至【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0860006", "target": "#nkr_note_mod_0860006", "type": "mod", "text": "驗【大】，𭘩【宋】【元】【明】"}
{"id": null, "n": "0860007", "target": "#nkr_note_mod_0860007", "type": "mod", "text": "溢【大】，逸【宋】【元】【明】"}
{"id": null, "n": "0860008", "target": "#nkr_note_mod_0860008", "type": "mod", "text": "坐【大】＊，座【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0860009", "target": "#nkr_note_mod_0860009", "type": "mod", "text": "唯【大】＊，惟【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0860010", "target": "#nkr_note_mod_0860010", "type": "mod", "text": "所【大】，有【明】"}
{"id": null, "n": "0860011", "target": "#nkr_note_mod_0860011", "type": "mod", "text": "小【大】＊，少【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0860012", "target": "#nkr_note_mod_0860012", "type": "mod", "text": "於【大】，少於【宋】【元】【明】"}
{"id": null, "n": "0860013", "target": "#nkr_note_mod_0860013", "type": "mod", "text": "住【大】，任【宋】【元】【明】"}
{"id": null, "n": "0860014", "target": "#nkr_note_mod_0860014", "type": "mod", "text": "求【大】，來【宋】【元】【明】"}
{"id": null, "n": "0861001", "target": "#nkr_note_mod_0861001", "type": "mod", "text": "渡【大】＊，度【宋】＊【元】＊【明】＊"}
