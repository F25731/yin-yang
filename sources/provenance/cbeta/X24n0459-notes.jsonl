{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X24n0461_p0547b07"}
{"id": null, "n": "0524001", "target": "#nkr_note_mod_0524001", "type": "mod", "text": "若【CB】，者【卍續】，者一本作若"}
{"id": null, "n": "0517001", "target": "#nkr_note_orig_0517001", "type": "orig", "text": "一本慧下有者字"}
{"id": null, "n": "0517002", "target": "#nkr_note_orig_0517002", "type": "orig", "text": "一本此字下有經字"}
{"id": null, "n": "0517003", "target": "#nkr_note_orig_0517003", "type": "orig", "text": "羚羊本綱云按寰宇志云安南高石山出羚羊一角極堅能碎金剛石則羚固有一角者矣金剛石出西域狀如紫石英百鍊不消物莫能擊惟羚羊角扣之則自然氷泮也．羚羊一本作羖羊本綱云時珍曰牡羊曰羖弘景曰羊有三四種入藥以青色羖羊為勝又本草曰羊頭骨能消鐵也故誤吞銅鉄者用之"}
{"id": null, "n": "0517004", "target": "#nkr_note_orig_0517004", "type": "orig", "text": "賓鐵本草綱目八卷曰錠鐵色黑性堅宜作刀劍西番出賓鐵尤勝"}
{"id": null, "n": "0517005", "target": "#nkr_note_orig_0517005", "type": "orig", "text": "唐本無也字"}
{"id": null, "n": "0517006", "target": "#nkr_note_orig_0517006", "type": "orig", "text": "自一本作是"}
{"id": null, "n": "0517007", "target": "#nkr_note_orig_0517007", "type": "orig", "text": "路下一本有也字"}
{"id": null, "n": "0517008", "target": "#nkr_note_orig_0517008", "type": "orig", "text": "撰號唐本在於題下"}
{"id": null, "n": "0517009", "target": "#nkr_note_orig_0517009", "type": "orig", "text": "撰作序"}
{"id": null, "n": "0517010", "target": "#nkr_note_orig_0517010", "type": "orig", "text": "梵語筏匝羅華言金梵跋折那華剛梵般若華智慧梵波羅蜜華到彼岸梵修多羅華經"}
{"id": null, "n": "0517011", "target": "#nkr_note_orig_0517011", "type": "orig", "text": "嘉其唐本作蕭統"}
{"id": null, "n": "0517012", "target": "#nkr_note_orig_0517012", "type": "orig", "text": "目作章"}
{"id": null, "n": "0518001", "target": "#nkr_note_orig_0518001", "type": "orig", "text": "時下一本有也字"}
{"id": null, "n": "0518002", "target": "#nkr_note_orig_0518002", "type": "orig", "text": "諸一本作知"}
{"id": null, "n": "0518003", "target": "#nkr_note_orig_0518003", "type": "orig", "text": "意唐作立"}
{"id": null, "n": "0519001", "target": "#nkr_note_orig_0519001", "type": "orig", "text": "導一本作度"}
{"id": null, "n": "0519002", "target": "#nkr_note_orig_0519002", "type": "orig", "text": "亂一本作虛"}
{"id": null, "n": "0519003", "target": "#nkr_note_orig_0519003", "type": "orig", "text": "多偏墜一本作多淪墜云多淪墜一作墮阿鼻也"}
{"id": null, "n": "0519004", "target": "#nkr_note_orig_0519004", "type": "orig", "text": "諸下一本有法字"}
{"id": null, "n": "0520001", "target": "#nkr_note_orig_0520001", "type": "orig", "text": "含一本作蒼"}
{"id": null, "n": "0521001", "target": "#nkr_note_orig_0521001", "type": "orig", "text": "動下一本有於字"}
{"id": null, "n": "0522001", "target": "#nkr_note_orig_0522001", "type": "orig", "text": "收一本作皎"}
{"id": null, "n": "0522002", "target": "#nkr_note_orig_0522002", "type": "orig", "text": "以一本作持"}
{"id": null, "n": "0522003", "target": "#nkr_note_orig_0522003", "type": "orig", "text": "一本無死字"}
{"id": null, "n": "0522004", "target": "#nkr_note_orig_0522004", "type": "orig", "text": "來上唐有不字"}
{"id": null, "n": "0523001", "target": "#nkr_note_orig_0523001", "type": "orig", "text": "疑一本作蔽"}
{"id": null, "n": "0523002", "target": "#nkr_note_orig_0523002", "type": "orig", "text": "未唐作末"}
{"id": null, "n": "0523003", "target": "#nkr_note_orig_0523003", "type": "orig", "text": "常一本作長"}
{"id": null, "n": "0524001", "target": "#nkr_note_orig_0524001", "type": "orig", "text": "者一本作若"}
{"id": null, "n": "0524002", "target": "#nkr_note_orig_0524002", "type": "orig", "text": "意一本作義"}
{"id": null, "n": "0525001", "target": "#nkr_note_orig_0525001", "type": "orig", "text": "積等十字異作積集無量業結覆蓋佛性"}
{"id": null, "n": "0525002", "target": "#nkr_note_orig_0525002", "type": "orig", "text": "云下一有上字"}
{"id": null, "n": "0525003", "target": "#nkr_note_orig_0525003", "type": "orig", "text": "法一本作多"}
{"id": null, "n": "0526001", "target": "#nkr_note_orig_0526001", "type": "orig", "text": "在一本作任"}
{"id": null, "n": "0527001", "target": "#nkr_note_orig_0527001", "type": "orig", "text": "提下一有若字"}
{"id": null, "n": "0527002", "target": "#nkr_note_orig_0527002", "type": "orig", "text": "一本無百字"}
{"id": null, "n": "0527003", "target": "#nkr_note_orig_0527003", "type": "orig", "text": "羅下一有蜜字"}
{"id": null, "n": "0528001", "target": "#nkr_note_orig_0528001", "type": "orig", "text": "乃一本作文"}
{"id": null, "n": "0529001", "target": "#nkr_note_orig_0529001", "type": "orig", "text": "數一本作土"}
{"id": null, "n": "0529002", "target": "#nkr_note_orig_0529002", "type": "orig", "text": "潛一本作瞥"}
{"id": null, "n": "0529003", "target": "#nkr_note_orig_0529003", "type": "orig", "text": "言一本作告"}
{"id": null, "n": "0530001", "target": "#nkr_note_orig_0530001", "type": "orig", "text": "得一本作了"}
{"id": null, "n": "0530002", "target": "#nkr_note_orig_0530002", "type": "orig", "text": "來下一有即字"}
{"id": null, "n": "0530003", "target": "#nkr_note_orig_0530003", "type": "orig", "text": "百一本作一"}
{"id": null, "n": "0531001", "target": "#nkr_note_orig_0531001", "type": "orig", "text": "樞一本作本"}
{"id": null, "n": "0531002", "target": "#nkr_note_orig_0531002", "type": "orig", "text": "存一本作有"}
{"id": null, "n": "0531003", "target": "#nkr_note_orig_0531003", "type": "orig", "text": "得一本作壞"}
