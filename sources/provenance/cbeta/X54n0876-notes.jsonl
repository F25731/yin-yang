{"id": null, "n": "0836004", "target": "#nkr_note_orig_0836004", "type": "orig", "text": "生上疑脫出字"}
{"id": null, "n": "0836005", "target": "#nkr_note_orig_0836005", "type": "orig", "text": "後疑從"}
{"id": null, "n": "0836006", "target": "#nkr_note_orig_0836006", "type": "orig", "text": "万疑方"}
{"id": null, "n": "0836007", "target": "#nkr_note_orig_0836007", "type": "orig", "text": "俗上疑脫照字"}
{"id": null, "n": "0836008", "target": "#nkr_note_orig_0836008", "type": "orig", "text": "照下疑脫俗字"}
