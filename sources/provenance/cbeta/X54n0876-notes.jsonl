{"id": null, "n": "0837002", "target": "#nkr_note_orig_0837002", "type": "orig", "text": "󴊤疑法"}
{"id": null, "n": "0837003", "target": "#nkr_note_orig_0837003", "type": "orig", "text": "其疑具"}
{"id": null, "n": "0837004", "target": "#nkr_note_orig_0837004", "type": "orig", "text": "般若二字疑衍"}
