{"id": null, "n": "0836001", "target": "#nkr_note_orig_0836001", "type": "orig", "text": "明疑妙"}
{"id": null, "n": "0836002", "target": "#nkr_note_orig_0836002", "type": "orig", "text": "俱疑但"}
