{"id": null, "n": "0838006", "target": "#nkr_note_orig_0838006", "type": "orig", "text": "有疑其"}
{"id": null, "n": "0838007", "target": "#nkr_note_orig_0838007", "type": "orig", "text": "也疑是"}
