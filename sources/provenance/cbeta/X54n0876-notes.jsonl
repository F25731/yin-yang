{"id": null, "n": "0834002", "target": "#nkr_note_orig_0834002", "type": "orig", "text": "二已下原本作理內外義"}
{"id": null, "n": "0834003", "target": "#nkr_note_orig_0834003", "type": "orig", "text": "說下疑脫有字"}
{"id": null, "n": "0834004", "target": "#nkr_note_orig_0834004", "type": "orig", "text": "其疑真"}
{"id": null, "n": "0835001", "target": "#nkr_note_orig_0835001", "type": "orig", "text": "之字疑剩"}
