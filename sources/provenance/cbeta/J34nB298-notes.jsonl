{"id": null, "n": null, "target": null, "type": null, "text": "智質　智原"}
{"id": null, "n": null, "target": null, "type": null, "text": "謝詞不錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "智質　智原"}
{"id": null, "n": null, "target": null, "type": null, "text": "智質　智原"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈香謝辭，不錄。"}
{"id": null, "n": null, "target": null, "type": null, "text": "智質　智原"}
{"id": null, "n": null, "target": null, "type": null, "text": "藥師長期中佛事"}
{"id": null, "n": null, "target": null, "type": null, "text": "智質　智原"}
{"id": null, "n": null, "target": null, "type": null, "text": "謝詞不錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "是日日蝕"}
{"id": null, "n": null, "target": null, "type": null, "text": "前一日，師誕辰；後一日，夏至節。"}
{"id": null, "n": null, "target": null, "type": null, "text": "智質　智原"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "智質　智原"}
{"id": null, "n": null, "target": null, "type": null, "text": "上元日"}
{"id": null, "n": null, "target": null, "type": null, "text": "智質　智原"}
{"id": null, "n": null, "target": null, "type": null, "text": "是日風雨驟止，故云。"}
{"id": null, "n": null, "target": null, "type": null, "text": "智質　智原"}
{"id": null, "n": null, "target": null, "type": null, "text": "有從者持函經錫杖"}
{"id": null, "n": null, "target": null, "type": null, "text": "手提魚籃斗笠"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "騎吼，有善財"}
{"id": null, "n": null, "target": null, "type": null, "text": "鄒孟翁請題"}
{"id": null, "n": null, "target": null, "type": null, "text": "請\n贊者乃梵公外甥。"}
