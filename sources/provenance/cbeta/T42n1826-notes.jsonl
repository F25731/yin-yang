{"id": null, "n": "0212002", "target": "#nkr_note_mod_0212002", "type": "mod", "text": "揮【大】，輝【甲】"}
{"id": null, "n": "0212003", "target": "#nkr_note_mod_0212003", "type": "mod", "text": "楞【大】＊，棱【甲】＊"}
{"id": null, "n": "0213001", "target": "#nkr_note_mod_0213001", "type": "mod", "text": "言【大】，音【甲】"}
{"id": null, "n": "0213002", "target": "#nkr_note_mod_0213002", "type": "mod", "text": "真為【大】，為真【甲】"}
{"id": null, "n": "0214001", "target": "#nkr_note_mod_0214001", "type": "mod", "text": "化【大】，故【甲】"}
{"id": null, "n": "0214002", "target": "#nkr_note_mod_0214002", "type": "mod", "text": "何【大】，未【甲】"}
{"id": null, "n": "0214003", "target": "#nkr_note_mod_0214003", "type": "mod", "text": "並【大】，亦【甲】"}
{"id": null, "n": "0215001", "target": "#nkr_note_mod_0215001", "type": "mod", "text": "是【大】，故【甲】"}
{"id": null, "n": "0217001", "target": "#nkr_note_mod_0217001", "type": "mod", "text": "柰【大】＊，捺【甲】＊"}
{"id": null, "n": "0217002", "target": "#nkr_note_mod_0217002", "type": "mod", "text": "瓜【大】，苽【甲】"}
{"id": null, "n": "0217003", "target": "#nkr_note_mod_0217003", "type": "mod", "text": "虛【大】，並【甲】"}
{"id": null, "n": "0217004", "target": "#nkr_note_mod_0217004", "type": "mod", "text": "種【大】，相【甲】"}
{"id": null, "n": "0217005", "target": "#nkr_note_mod_0217005", "type": "mod", "text": "絕【大】，絕亦絕【甲】"}
{"id": null, "n": "0217006", "target": "#nkr_note_mod_0217006", "type": "mod", "text": "釐【大】，氂【甲】"}
{"id": null, "n": "0218001", "target": "#nkr_note_mod_0218001", "type": "mod", "text": "此【大】，幻【甲】"}
{"id": null, "n": "0218002", "target": "#nkr_note_mod_0218002", "type": "mod", "text": "黎【大】，梨【甲】"}
{"id": null, "n": "0218003", "target": "#nkr_note_mod_0218003", "type": "mod", "text": "往【CB】【甲】，住【大】"}
{"id": null, "n": "0218004", "target": "#nkr_note_mod_0218004", "type": "mod", "text": "遺【大】，違【甲】"}
{"id": null, "n": "0219001", "target": "#nkr_note_mod_0219001", "type": "mod", "text": "實【大】，寔【甲】"}
{"id": null, "n": "0219002", "target": "#nkr_note_mod_0219002", "type": "mod", "text": "方【大】，力【甲】"}
{"id": null, "n": "0219003", "target": "#nkr_note_mod_0219003", "type": "mod", "text": "（觀因…之）二十二字【大】，〔－〕【甲】"}
{"id": null, "n": "0219004", "target": "#nkr_note_mod_0219004", "type": "mod", "text": "在【大】，定也【考偽-甲】"}
{"id": null, "n": "0219005", "target": "#nkr_note_mod_0219005", "type": "mod", "text": "中【大】，中二先問答辨意後大分下會意歸宗前中【甲】"}
{"id": null, "n": "0219006", "target": "#nkr_note_mod_0219006", "type": "mod", "text": "以辨其意【大】，〔－〕【甲】"}
{"id": null, "n": "0220001", "target": "#nkr_note_mod_0220001", "type": "mod", "text": "（為深…十二）二百四十字【大】，〔－〕【甲】"}
{"id": null, "n": "0220002", "target": "#nkr_note_mod_0220002", "type": "mod", "text": "（觀因…一）六字【大】，〔－〕【甲】"}
{"id": null, "n": "0220003", "target": "#nkr_note_mod_0220003", "type": "mod", "text": "縱【CB】【甲】，緣【大】"}
{"id": null, "n": "0220004", "target": "#nkr_note_mod_0220004", "type": "mod", "text": "因【大】，同【甲】"}
{"id": null, "n": "0221001", "target": "#nkr_note_mod_0221001", "type": "mod", "text": "搆【大】，稱【甲】"}
{"id": null, "n": "0221002", "target": "#nkr_note_mod_0221002", "type": "mod", "text": "（齊破…以自體）二百四十字【大】，〔－〕【甲】"}
{"id": null, "n": "0223001", "target": "#nkr_note_mod_0223001", "type": "mod", "text": "疏【大】＊，疎【甲】＊"}
{"id": null, "n": "0224001", "target": "#nkr_note_mod_0224001", "type": "mod", "text": "次下【CB】【甲】，下次【大】"}
{"id": null, "n": "0224002", "target": "#nkr_note_mod_0224002", "type": "mod", "text": "得【大】，〔－〕【甲】"}
{"id": null, "n": "0225001", "target": "#nkr_note_mod_0225001", "type": "mod", "text": "無【大】，無所【甲】"}
{"id": null, "n": "0226001", "target": "#nkr_note_mod_0226001", "type": "mod", "text": "意【CB】【甲】，異【大】"}
{"id": null, "n": "0226002", "target": "#nkr_note_mod_0226002", "type": "mod", "text": "若【CB】【考偽-甲】，者【大】"}
{"id": null, "n": "0226003", "target": "#nkr_note_mod_0226003", "type": "mod", "text": "三【大】，二【甲】"}
{"id": null, "n": "0228001", "target": "#nkr_note_mod_0228001", "type": "mod", "text": "眾【大】，緣【甲】"}
{"id": null, "n": "0228002", "target": "#nkr_note_mod_0228002", "type": "mod", "text": "中【大】，下【甲】"}
{"id": null, "n": "0230001", "target": "#nkr_note_mod_0230001", "type": "mod", "text": "持【大】，將【甲】"}
{"id": null, "n": "0231001", "target": "#nkr_note_mod_0231001", "type": "mod", "text": "時【大】，此【甲】"}
{"id": null, "n": "0231002", "target": "#nkr_note_mod_0231002", "type": "mod", "text": "下【大】，下本是一卷開為上下【甲】"}
{"id": null, "n": "0212001", "target": "#nkr_note_orig_0212001", "type": "orig", "text": "【原】大日本續藏經，【甲】正德元年刊前田慧雲氏藏本"}
