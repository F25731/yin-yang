{"id": null, "n": "0219001", "target": "#nkr_note_orig_0219001", "type": "orig", "text": "實＝寔【甲】"}
{"id": null, "n": "0219002", "target": "#nkr_note_orig_0219002", "type": "orig", "text": "方＝力【甲】"}
