{"id": null, "n": "0218001", "target": "#nkr_note_orig_0218001", "type": "orig", "text": "此＝幻【甲】"}
{"id": null, "n": "0218002", "target": "#nkr_note_orig_0218002", "type": "orig", "text": "黎＝梨【甲】"}
{"id": null, "n": "0218003", "target": "#nkr_note_orig_0218003", "type": "orig", "text": "住＝往【甲】"}
