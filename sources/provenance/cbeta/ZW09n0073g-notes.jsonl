{"id": null, "n": "0131001", "target": "#nkr_note_orig_0131001", "type": "orig", "text": "「對」，庚本作「答」。"}
{"id": null, "n": "0131002", "target": "#nkr_note_orig_0131002", "type": "orig", "text": "「自」，庚本作「吾不解講，自」。"}
{"id": null, "n": "0131003", "target": "#nkr_note_orig_0131003", "type": "orig", "text": "「對」，庚本無。"}
{"id": null, "n": "0131004", "target": "#nkr_note_orig_0131004", "type": "orig", "text": "「魚」，庚本作「莫」。"}
{"id": null, "n": "0131005", "target": "#nkr_note_orig_0131005", "type": "orig", "text": "「詔」，甲本作「照」，庚本作「詔傅」。"}
{"id": null, "n": "0131006", "target": "#nkr_note_orig_0131006", "type": "orig", "text": "「士」，庚本作「士曰」。"}
{"id": null, "n": "0131007", "target": "#nkr_note_orig_0131007", "type": "orig", "text": "「欲請大士講金剛經」，庚本作「講經」。"}
{"id": null, "n": "0131008", "target": "#nkr_note_orig_0131008", "type": "orig", "text": "「座」，甲、庚本作「坐」。"}
{"id": null, "n": "0131009", "target": "#nkr_note_orig_0131009", "type": "orig", "text": "「對曰」，庚本作「答言」。"}
{"id": null, "n": "0131010", "target": "#nkr_note_orig_0131010", "type": "orig", "text": "「用」，庚本作「要」。"}
{"id": null, "n": "0131011", "target": "#nkr_note_orig_0131011", "type": "orig", "text": "「座」，庚本作「坐」。"}
{"id": null, "n": "0131012", "target": "#nkr_note_orig_0131012", "type": "orig", "text": "「拍」，甲、乙、庚本作「柏」。"}
{"id": null, "n": "0131013", "target": "#nkr_note_orig_0131013", "type": "orig", "text": "「便」，庚本無。"}
{"id": null, "n": "0131014", "target": "#nkr_note_orig_0131014", "type": "orig", "text": "「武」，庚本無。"}
{"id": null, "n": "0131015", "target": "#nkr_note_orig_0131015", "type": "orig", "text": "「不」，庚本作「否」。"}
{"id": null, "n": "0131016", "target": "#nkr_note_orig_0131016", "type": "orig", "text": "「告帝曰」，底、乙、戊本作「告帝」，庚本作「言」，據甲本補。"}
{"id": null, "n": "0132001", "target": "#nkr_note_orig_0132001", "type": "orig", "text": "「彌勒」，乙本作「沙彌」。"}
{"id": null, "n": "0132002", "target": "#nkr_note_orig_0132002", "type": "orig", "text": "「揚」，甲、乙、戊本作「楊」。"}
{"id": null, "n": "0132003", "target": "#nkr_note_orig_0132003", "type": "orig", "text": "「忽」，庚本無。"}
{"id": null, "n": "0132004", "target": "#nkr_note_orig_0132004", "type": "orig", "text": "「情」，庚本無。"}
{"id": null, "n": "0132005", "target": "#nkr_note_orig_0132005", "type": "orig", "text": "「大」，乙本無。"}
{"id": null, "n": "0132006", "target": "#nkr_note_orig_0132006", "type": "orig", "text": "「題」，庚本作「提」。"}
{"id": null, "n": "0132007", "target": "#nkr_note_orig_0132007", "type": "orig", "text": "「荊」，戊本作「經」。"}
{"id": null, "n": "0132008", "target": "#nkr_note_orig_0132008", "type": "orig", "text": "「現」，底、乙、戊本作「見」，據甲本改。"}
{"id": null, "n": "0132009", "target": "#nkr_note_orig_0132009", "type": "orig", "text": "「測」，諸本作「惻」，據石本改。"}
{"id": null, "n": "0132010", "target": "#nkr_note_orig_0132010", "type": "orig", "text": "「茲」，甲本作「慈」。"}
{"id": null, "n": "0132011", "target": "#nkr_note_orig_0132011", "type": "orig", "text": "「遂」，庚本作「若」。"}
{"id": null, "n": "0132012", "target": "#nkr_note_orig_0132012", "type": "orig", "text": "「列」，甲、庚本作「烈」。"}
{"id": null, "n": "0132013", "target": "#nkr_note_orig_0132013", "type": "orig", "text": "「魔」，甲本作「磨」。"}
{"id": null, "n": "0132014", "target": "#nkr_note_orig_0132014", "type": "orig", "text": "「有無」，甲本無。"}
{"id": null, "n": "0132015", "target": "#nkr_note_orig_0132015", "type": "orig", "text": "「以」，底本作「以故」，戊本作「次」，據甲本刪。"}
{"id": null, "n": "0132016", "target": "#nkr_note_orig_0132016", "type": "orig", "text": "「所謂慧日流空，照如來之淨土；禪刀入手，破生死之魔軍。既而人法雙祛，有無俱遣，快哉斯義，何以加焉」，庚本無。"}
{"id": null, "n": "0132017", "target": "#nkr_note_orig_0132017", "type": "orig", "text": "「有」，庚本作「更有」。"}
{"id": null, "n": "0133001", "target": "#nkr_note_orig_0133001", "type": "orig", "text": "「資揚」，甲、乙本作「資楊」，庚本作「制歌」。"}
{"id": null, "n": "0133002", "target": "#nkr_note_orig_0133002", "type": "orig", "text": "「以」，庚本作「都合成五十四篇，以」。"}
{"id": null, "n": "0133003", "target": "#nkr_note_orig_0133003", "type": "orig", "text": "「助」，庚本作「智」。"}
{"id": null, "n": "0133004", "target": "#nkr_note_orig_0133004", "type": "orig", "text": "「其」，庚本作「全久處之情莫已，長居生滅之性彌增，實未由若遇善友，遂使玄宗旨教妙義，真言開心悟智。其」。"}
{"id": null, "n": "0133005", "target": "#nkr_note_orig_0133005", "type": "orig", "text": "「恐文隳」，甲本作「恐文隨」，庚本作「文將」。"}
{"id": null, "n": "0133006", "target": "#nkr_note_orig_0133006", "type": "orig", "text": "「墮」，乙本作「墜」，戊本無。"}
{"id": null, "n": "0133007", "target": "#nkr_note_orig_0133007", "type": "orig", "text": "「請」，庚本作「更請」。"}
{"id": null, "n": "0133008", "target": "#nkr_note_orig_0133008", "type": "orig", "text": "「若有人持誦」，底、乙、戊本無，庚本作「凡欲受持」，據甲本補。"}
{"id": null, "n": "0133009", "target": "#nkr_note_orig_0133009", "type": "orig", "text": "「金剛般若波羅蜜經者」，底、乙、戊本無，庚本作「金剛般若波羅蜜經」，據甲本補。"}
{"id": null, "n": "0133010", "target": "#nkr_note_orig_0133010", "type": "orig", "text": "「先須至心念淨口業真言，然後啟請八金剛、四菩薩名號所在之處常當擁護。淨口業真言：修唎修唎摩訶修唎修修唎薩婆訶。虛空菩薩普供養真言：唵誐誐曩三婆嚩襪日囉斛。」以上一段，底、乙、戊本無，據甲、庚本補。"}
{"id": null, "n": "0134001", "target": "#nkr_note_orig_0134001", "type": "orig", "text": "「云何梵：云何得長壽？金剛不壞身。復以何因緣，得大堅固力？云何於此經，究竟到彼岸？願佛開微蜜，廣為眾生說」，諸本無，據甲本補。"}
{"id": null, "n": "0134002", "target": "#nkr_note_orig_0134002", "type": "orig", "text": "「我今發弘願」，戊本無。"}
{"id": null, "n": "0134003", "target": "#nkr_note_orig_0134003", "type": "orig", "text": "「報」，甲、戊本作「寶」。"}
{"id": null, "n": "0134004", "target": "#nkr_note_orig_0134004", "type": "orig", "text": "「濟」，底本作「齊」，據甲、乙、戊本改。"}
{"id": null, "n": "0134005", "target": "#nkr_note_orig_0134005", "type": "orig", "text": "「報」，甲本作「寶」。"}
{"id": null, "n": "0134006", "target": "#nkr_note_orig_0134006", "type": "orig", "text": "「發願文：稽首三界尊，十方無量佛。我今發弘願，持此金剛經。上報四重恩，下濟三塗苦。若有見聞者，悉發菩提心。盡此一報身，同生極樂國」，庚本無。"}
{"id": null, "n": "0134007", "target": "#nkr_note_orig_0134007", "type": "orig", "text": "「奉請八金剛：第一奉請青除災金剛第二奉請辟毒金剛第三奉請黃隨求金剛第四奉請白淨水金剛第五奉請赤聲金剛」一段，底、乙、戊本無，庚本作「奉請八金剛：第一奉請青除災金剛3（能除一切眾生宿殃，悉令消滅，主大海）第二奉請辟毒金剛（形能除一切溫毒病苦除盡，主災毒）第三奉請黃隨求金剛（能令一切眾生所求如願，主功德）第四奉請白淨水金剛第一青除災金剛（赤色能除一切溫毒病）」，據甲本補。庚本到此結束。"}
{"id": null, "n": "0135001", "target": "#nkr_note_orig_0135001", "type": "orig", "text": "「奉請四大菩薩」，諸本無，據文意補。"}
{"id": null, "n": "0135002", "target": "#nkr_note_orig_0135002", "type": "orig", "text": "「第六奉請定除災金剛第七奉請紫賢金剛第八奉請大神金剛第一奉請金剛眷菩薩第二奉請金剛索菩薩第三奉請金剛愛菩薩第四奉請金剛語菩薩」一段，底、乙、戊本無，據甲本補。"}
{"id": null, "n": "0135003", "target": "#nkr_note_orig_0135003", "type": "orig", "text": "「金」，丙本自此開始。"}
{"id": null, "n": "0135004", "target": "#nkr_note_orig_0135004", "type": "orig", "text": "「樹」，底本無，據諸本補。"}
{"id": null, "n": "0135005", "target": "#nkr_note_orig_0135005", "type": "orig", "text": "「慟」，乙本作「動」。"}
{"id": null, "n": "0135006", "target": "#nkr_note_orig_0135006", "type": "orig", "text": "「波」甲本作「婆」。"}
{"id": null, "n": "0135007", "target": "#nkr_note_orig_0135007", "type": "orig", "text": "「如」，丙本作「女」。"}
{"id": null, "n": "0136001", "target": "#nkr_note_orig_0136001", "type": "orig", "text": "「須」，丙本自此斷。"}
{"id": null, "n": "0136002", "target": "#nkr_note_orig_0136002", "type": "orig", "text": "「發」，丁本自此開始。"}
{"id": null, "n": "0137001", "target": "#nkr_note_orig_0137001", "type": "orig", "text": "「善逝應機酬」，底本缺，據諸本補。"}
{"id": null, "n": "0137002", "target": "#nkr_note_orig_0137002", "type": "orig", "text": "「檀」，丁本作「頌檀」。"}
{"id": null, "n": "0137003", "target": "#nkr_note_orig_0137003", "type": "orig", "text": "「蜜」，戊本作「密」。"}
{"id": null, "n": "0137004", "target": "#nkr_note_orig_0137004", "type": "orig", "text": "「檀波羅蜜布施」，底本無，據諸本補。"}
{"id": null, "n": "0137005", "target": "#nkr_note_orig_0137005", "type": "orig", "text": "「檀」，戊本作「壇」。"}
{"id": null, "n": "0137006", "target": "#nkr_note_orig_0137006", "type": "orig", "text": "「法」，甲本作「地」。"}
{"id": null, "n": "0137007", "target": "#nkr_note_orig_0137007", "type": "orig", "text": "「勿」，乙、丁本作「物」。"}
{"id": null, "n": "0137008", "target": "#nkr_note_orig_0137008", "type": "orig", "text": "「尸」，丁本作「頌尸」。"}
{"id": null, "n": "0137009", "target": "#nkr_note_orig_0137009", "type": "orig", "text": "「蜜」，戊本作「密」。"}
{"id": null, "n": "0138001", "target": "#nkr_note_orig_0138001", "type": "orig", "text": "「依」，甲、乙本作「於」，戊本作「衣」。"}
{"id": null, "n": "0138002", "target": "#nkr_note_orig_0138002", "type": "orig", "text": "「羼」，丁本作「頌羼」。"}
{"id": null, "n": "0138003", "target": "#nkr_note_orig_0138003", "type": "orig", "text": "「蜜」，戊本作「密」。"}
{"id": null, "n": "0138004", "target": "#nkr_note_orig_0138004", "type": "orig", "text": "「曰」，戊本無。"}
{"id": null, "n": "0138005", "target": "#nkr_note_orig_0138005", "type": "orig", "text": "「欲」，丁本作「若」。"}
{"id": null, "n": "0138006", "target": "#nkr_note_orig_0138006", "type": "orig", "text": "丁本到此結束。"}
{"id": null, "n": "0138007", "target": "#nkr_note_orig_0138007", "type": "orig", "text": "「蜜」，戊本作「密」。"}
{"id": null, "n": "0138008", "target": "#nkr_note_orig_0138008", "type": "orig", "text": "「智」，戊本作「知」。"}
{"id": null, "n": "0138009", "target": "#nkr_note_orig_0138009", "type": "orig", "text": "「除」，甲本作「知」。"}
{"id": null, "n": "0138010", "target": "#nkr_note_orig_0138010", "type": "orig", "text": "「餘」，甲本作「為」。"}
{"id": null, "n": "0138011", "target": "#nkr_note_orig_0138011", "type": "orig", "text": "「蜜」，戊本作「密」。"}
{"id": null, "n": "0139001", "target": "#nkr_note_orig_0139001", "type": "orig", "text": "「圓」，戊本作「終」。"}
{"id": null, "n": "0139002", "target": "#nkr_note_orig_0139002", "type": "orig", "text": "「蜜」，戊本作「密」。"}
{"id": null, "n": "0139003", "target": "#nkr_note_orig_0139003", "type": "orig", "text": "「城」，甲本作「成」。"}
{"id": null, "n": "0139004", "target": "#nkr_note_orig_0139004", "type": "orig", "text": "「妄」，甲本作「忘」。"}
{"id": null, "n": "0139005", "target": "#nkr_note_orig_0139005", "type": "orig", "text": "「三」，丙本自此續。"}
{"id": null, "n": "0139006", "target": "#nkr_note_orig_0139006", "type": "orig", "text": "「大」，諸本作「代」，據《房山石經．梁朝傅大士夾頌金剛經》改。"}
{"id": null, "n": "0139007", "target": "#nkr_note_orig_0139007", "type": "orig", "text": "「遨」，戊本作「敖」。"}
{"id": null, "n": "0139008", "target": "#nkr_note_orig_0139008", "type": "orig", "text": "「常樂遂忘憂」，甲本作「常樂逐忘憂」，乙本無。"}
{"id": null, "n": "0140001", "target": "#nkr_note_orig_0140001", "type": "orig", "text": "「施」，丙本自此斷。"}
{"id": null, "n": "0140002", "target": "#nkr_note_orig_0140002", "type": "orig", "text": "「略」，乙本作「毗」。"}
{"id": null, "n": "0140003", "target": "#nkr_note_orig_0140003", "type": "orig", "text": "「揚」，諸本作「楊」，據石本改。"}
{"id": null, "n": "0140004", "target": "#nkr_note_orig_0140004", "type": "orig", "text": "「知」，底本作「智」，據諸本改。"}
{"id": null, "n": "0141001", "target": "#nkr_note_orig_0141001", "type": "orig", "text": "「密」，乙本作「蜜」。"}
{"id": null, "n": "0141002", "target": "#nkr_note_orig_0141002", "type": "orig", "text": "「空」，丙本自此續。"}
{"id": null, "n": "0141003", "target": "#nkr_note_orig_0141003", "type": "orig", "text": "「大」，諸本作「代」，據石本改。"}
{"id": null, "n": "0141004", "target": "#nkr_note_orig_0141004", "type": "orig", "text": "「施」，丙本自此斷。"}
{"id": null, "n": "0141005", "target": "#nkr_note_orig_0141005", "type": "orig", "text": "「熏」，戊本作「董」。"}
{"id": null, "n": "0141006", "target": "#nkr_note_orig_0141006", "type": "orig", "text": "「漏種」，戊本作「滿眾」。"}
{"id": null, "n": "0142001", "target": "#nkr_note_orig_0142001", "type": "orig", "text": "「礙不」，甲本作「不礙」。"}
{"id": null, "n": "0142002", "target": "#nkr_note_orig_0142002", "type": "orig", "text": "「性」，甲本作「忍」。"}
{"id": null, "n": "0142003", "target": "#nkr_note_orig_0142003", "type": "orig", "text": "「有」，甲本作「乃」，戊本作「無」。"}
{"id": null, "n": "0142004", "target": "#nkr_note_orig_0142004", "type": "orig", "text": "「有」，丙本自此續。"}
{"id": null, "n": "0142005", "target": "#nkr_note_orig_0142005", "type": "orig", "text": "「汙」，乙、丙、戊本作「汙」。"}
{"id": null, "n": "0144001", "target": "#nkr_note_orig_0144001", "type": "orig", "text": "「業」，丙本自此斷。"}
{"id": null, "n": "0144002", "target": "#nkr_note_orig_0144002", "type": "orig", "text": "「今」，戊本作「人」。"}
{"id": null, "n": "0144003", "target": "#nkr_note_orig_0144003", "type": "orig", "text": "「返」，戊本作「送」。"}
{"id": null, "n": "0144004", "target": "#nkr_note_orig_0144004", "type": "orig", "text": "「漢」，丙本自此續。"}
{"id": null, "n": "0145001", "target": "#nkr_note_orig_0145001", "type": "orig", "text": "「蕭」，甲本作「業」。"}
{"id": null, "n": "0145002", "target": "#nkr_note_orig_0145002", "type": "orig", "text": "「無悲空有智，蕭然獨任真」二句，丙本無。"}
{"id": null, "n": "0145003", "target": "#nkr_note_orig_0145003", "type": "orig", "text": "「仁」，甲本作「人」。"}
{"id": null, "n": "0146001", "target": "#nkr_note_orig_0146001", "type": "orig", "text": "「嗔」，丙本自此斷。"}
{"id": null, "n": "0146002", "target": "#nkr_note_orig_0146002", "type": "orig", "text": "「不」，底本作「人」，據甲本改。"}
{"id": null, "n": "0146003", "target": "#nkr_note_orig_0146003", "type": "orig", "text": "「塵」，戊本至此結束。"}
{"id": null, "n": "0148001", "target": "#nkr_note_orig_0148001", "type": "orig", "text": "「堅」，底本作「賢」，據甲、乙本改。"}
{"id": null, "n": "0148002", "target": "#nkr_note_orig_0148002", "type": "orig", "text": "「析」，甲、乙本作「折」。"}
{"id": null, "n": "0148003", "target": "#nkr_note_orig_0148003", "type": "orig", "text": "「塵因」，諸本作「因塵」，據石本改。"}
{"id": null, "n": "0149001", "target": "#nkr_note_orig_0149001", "type": "orig", "text": "「持」，乙本至此結束。"}
{"id": null, "n": "0150001", "target": "#nkr_note_orig_0150001", "type": "orig", "text": "「境無侵」，甲本作「無境心」，丙本自此續。"}
{"id": null, "n": "0150002", "target": "#nkr_note_orig_0150002", "type": "orig", "text": "「諸」，底本作「知」，據甲、丙本改。"}
{"id": null, "n": "0151001", "target": "#nkr_note_orig_0151001", "type": "orig", "text": "「有」，丙本自此斷。"}
{"id": null, "n": "0152001", "target": "#nkr_note_orig_0152001", "type": "orig", "text": "「精」，底本作「情」，據甲本改。"}
{"id": null, "n": "0152002", "target": "#nkr_note_orig_0152002", "type": "orig", "text": "「者」,丙本自此續。"}
{"id": null, "n": "0152003", "target": "#nkr_note_orig_0152003", "type": "orig", "text": "「虛」，甲本作「空」。"}
{"id": null, "n": "0152004", "target": "#nkr_note_orig_0152004", "type": "orig", "text": "「證」，己本自此開始。"}
{"id": null, "n": "0152005", "target": "#nkr_note_orig_0152005", "type": "orig", "text": "「我乃成虛。非空亦非有，誰有復誰無」，己本殘。"}
{"id": null, "n": "0153001", "target": "#nkr_note_orig_0153001", "type": "orig", "text": "「入」，底本作「人」，據甲、丙本改。"}
{"id": null, "n": "0153002", "target": "#nkr_note_orig_0153002", "type": "orig", "text": "「依二空理，穎脫入無餘」，己本殘。"}
{"id": null, "n": "0153003", "target": "#nkr_note_orig_0153003", "type": "orig", "text": "「名。如龜毛不實」，己本殘。"}
{"id": null, "n": "0153004", "target": "#nkr_note_orig_0153004", "type": "orig", "text": "「兔」，己本作「土」。"}
{"id": null, "n": "0154001", "target": "#nkr_note_orig_0154001", "type": "orig", "text": "「群」，己本作「郡」。"}
{"id": null, "n": "0154002", "target": "#nkr_note_orig_0154002", "type": "orig", "text": "「利」，己本作「理」。"}
{"id": null, "n": "0154003", "target": "#nkr_note_orig_0154003", "type": "orig", "text": "「能」，己本作「勘」。"}
{"id": null, "n": "0154004", "target": "#nkr_note_orig_0154004", "type": "orig", "text": "「所」，丙本自此斷。"}
{"id": null, "n": "0155001", "target": "#nkr_note_orig_0155001", "type": "orig", "text": "「空」，丙本自此續。"}
{"id": null, "n": "0156001", "target": "#nkr_note_orig_0156001", "type": "orig", "text": "「須」，丙本至此結束。"}
{"id": null, "n": "0156002", "target": "#nkr_note_orig_0156002", "type": "orig", "text": "「待」，諸本作「侍」，據石本改。"}
{"id": null, "n": "0156003", "target": "#nkr_note_orig_0156003", "type": "orig", "text": "「來」，底本無，據諸本補。"}
{"id": null, "n": "0156004", "target": "#nkr_note_orig_0156004", "type": "orig", "text": "「人」，底本作「入」，據諸本改。"}
{"id": null, "n": "0156005", "target": "#nkr_note_orig_0156005", "type": "orig", "text": "「授」，甲本作「受」。"}
{"id": null, "n": "0157001", "target": "#nkr_note_orig_0157001", "type": "orig", "text": "「直」，己本作「真」。"}
{"id": null, "n": "0157002", "target": "#nkr_note_orig_0157002", "type": "orig", "text": "「無處不鑒容」，己本殘。"}
{"id": null, "n": "0157003", "target": "#nkr_note_orig_0157003", "type": "orig", "text": "「容」，底本作「客」，己本殘，據甲本改。"}
{"id": null, "n": "0157004", "target": "#nkr_note_orig_0157004", "type": "orig", "text": "「橫」，己本至此結束。"}
{"id": null, "n": "0159001", "target": "#nkr_note_orig_0159001", "type": "orig", "text": "「平」，底、甲本作「中」，據石本改。"}
{"id": null, "n": "0161001", "target": "#nkr_note_orig_0161001", "type": "orig", "text": "「能」，甲本作「難」。"}
{"id": null, "n": "0162001", "target": "#nkr_note_orig_0162001", "type": "orig", "text": "「異」，甲本作「以」。"}
{"id": null, "n": "0164001", "target": "#nkr_note_orig_0164001", "type": "orig", "text": "「茲」，甲本作「慈」。"}
{"id": null, "n": "0164002", "target": "#nkr_note_orig_0164002", "type": "orig", "text": "「謝」，底、甲本作「榭」，據文意改。"}
{"id": null, "n": "0164003", "target": "#nkr_note_orig_0164003", "type": "orig", "text": "「智」，甲本作「知」。"}
{"id": null, "n": "0164004", "target": "#nkr_note_orig_0164004", "type": "orig", "text": "「筏」，甲本作「跋」。"}
{"id": null, "n": "0165001", "target": "#nkr_note_orig_0165001", "type": "orig", "text": "「婆」，甲本作「波」。"}
{"id": null, "n": "0165002", "target": "#nkr_note_orig_0165002", "type": "orig", "text": "「金剛經一卷」，底本無，據甲本補。"}
{"id": null, "n": "0143a2501", "target": "#nkr_note_add_0143a2501", "type": "add", "text": "羅【CB】，難【藏外】"}
{"id": null, "n": "0145a2401", "target": "#nkr_note_add_0145a2401", "type": "add", "text": "土【CB】，士【藏外】"}
{"id": null, "n": "0151a1301", "target": "#nkr_note_add_0151a1301", "type": "add", "text": "忍【CB】，忽【藏外】"}
{"id": null, "n": "0156a1301", "target": "#nkr_note_add_0156a1301", "type": "add", "text": "土【CB】，士【藏外】"}
{"id": null, "n": "0156a1401", "target": "#nkr_note_add_0156a1401", "type": "add", "text": "土【CB】，士【藏外】"}
{"id": null, "n": "0161a1301", "target": "#nkr_note_add_0161a1301", "type": "add", "text": "念【CB】，說【藏外】"}
