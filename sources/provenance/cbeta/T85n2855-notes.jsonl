{"id": null, "n": null, "target": null, "type": "cf1", "text": "見《漢語大詞典》第三卷第435"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T11n0310_p0247c04"}
{"id": null, "n": "1305001", "target": "#nkr_note_mod_1305001", "type": "mod", "text": "過【大】，果【考偽-大】"}
{"id": null, "n": "1305002", "target": "#nkr_note_mod_1305002", "type": "mod", "text": "及食五辛【大】，〔－〕【考偽-大】"}
{"id": null, "n": "1304002", "target": "#nkr_note_orig_1304002", "type": "orig", "text": "【原】中村不折氏藏燉煌本，首題新加"}
{"id": null, "n": "1304003", "target": "#nkr_note_orig_1304003", "type": "orig", "text": "首缺"}
{"id": null, "n": "1305001", "target": "#nkr_note_orig_1305001", "type": "orig", "text": "過＝果？"}
{"id": null, "n": "1305002", "target": "#nkr_note_orig_1305002", "type": "orig", "text": "〔及食五辛〕－？"}
{"id": null, "n": "1304c0401", "target": "#nkr_note_add_1304c0401", "type": "add", "text": "腦【CB】，惱【大】"}
{"id": null, "n": "1305b2501", "target": "#nkr_note_add_1305b2501", "type": "add", "text": "喑【CB】，暗【大】"}
