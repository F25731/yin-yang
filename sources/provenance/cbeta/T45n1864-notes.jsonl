{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "辛未"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T45n1864_p0463a17"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": "0449005", "target": "#nkr_note_mod_0449005", "type": "mod", "text": "達【大】，達位【乙】"}
{"id": null, "n": "0450001", "target": "#nkr_note_mod_0450001", "type": "mod", "text": "間【大】，聞【甲】"}
{"id": null, "n": "0450002", "target": "#nkr_note_mod_0450002", "type": "mod", "text": "音【大】，普【甲】【乙】"}
{"id": null, "n": "0450003", "target": "#nkr_note_mod_0450003", "type": "mod", "text": "此【大】，此位【甲】【乙】"}
{"id": null, "n": "0450004", "target": "#nkr_note_mod_0450004", "type": "mod", "text": "頂【大】，項【考偽-原】"}
{"id": null, "n": "0450005", "target": "#nkr_note_mod_0450005", "type": "mod", "text": "相前【大】，之前相【甲】，前相【乙】"}
{"id": null, "n": "0451001", "target": "#nkr_note_mod_0451001", "type": "mod", "text": "此【大】，此地【考偽-原】"}
{"id": null, "n": "0451002", "target": "#nkr_note_mod_0451002", "type": "mod", "text": "辦【大】＊，辨【甲】【乙】＊"}
{"id": null, "n": "0451003", "target": "#nkr_note_mod_0451003", "type": "mod", "text": "也【大】＊，〔－〕【甲】＊"}
{"id": null, "n": "0452001", "target": "#nkr_note_mod_0452001", "type": "mod", "text": "資【大】，實【甲】"}
{"id": null, "n": "0453001", "target": "#nkr_note_mod_0453001", "type": "mod", "text": "匱【大】，遺【甲】【乙】"}
{"id": null, "n": "0453002", "target": "#nkr_note_mod_0453002", "type": "mod", "text": "險徑【大】，󳖥侄【甲】【乙】"}
{"id": null, "n": "0453003", "target": "#nkr_note_mod_0453003", "type": "mod", "text": "火【大】，大【甲】"}
{"id": null, "n": "0454001", "target": "#nkr_note_mod_0454001", "type": "mod", "text": "則【大】，則是【考偽-原】"}
{"id": null, "n": "0455001", "target": "#nkr_note_mod_0455001", "type": "mod", "text": "推【大】，堆【甲】"}
{"id": null, "n": "0455002", "target": "#nkr_note_mod_0455002", "type": "mod", "text": "名【大】，稱【甲】"}
{"id": null, "n": "0457001", "target": "#nkr_note_mod_0457001", "type": "mod", "text": "特【大】，恃【甲】"}
{"id": null, "n": "0460001", "target": "#nkr_note_mod_0460001", "type": "mod", "text": "謂【大】，諸【乙】"}
{"id": null, "n": "0466001", "target": "#nkr_note_mod_0466001", "type": "mod", "text": "乘【大】，眾【乙】"}
{"id": null, "n": "0467001", "target": "#nkr_note_mod_0467001", "type": "mod", "text": "終【大】，〔－〕【乙】"}
{"id": null, "n": "0449004", "target": "#nkr_note_orig_0449004", "type": "orig", "text": "【原】大日本續藏經，【甲】鎌倉時代刊藥師寺藏本，【乙】寶永二年刊大谷大學藏本"}
{"id": null, "n": "0449005", "target": "#nkr_note_orig_0449005", "type": "orig", "text": "達＋（位）【乙】"}
{"id": null, "n": "0450001", "target": "#nkr_note_orig_0450001", "type": "orig", "text": "間＝聞【甲】"}
{"id": null, "n": "0450002", "target": "#nkr_note_orig_0450002", "type": "orig", "text": "音＝普【甲】【乙】"}
{"id": null, "n": "0450003", "target": "#nkr_note_orig_0450003", "type": "orig", "text": "此＋（位）【甲】【乙】"}
{"id": null, "n": "0450004", "target": "#nkr_note_orig_0450004", "type": "orig", "text": "頂＝項ヵ【原】"}
{"id": null, "n": "0450005", "target": "#nkr_note_orig_0450005", "type": "orig", "text": "相前＝之前相【甲】，前相【乙】"}
{"id": null, "n": "0451001", "target": "#nkr_note_orig_0451001", "type": "orig", "text": "此＋（地）ヵ【原】"}
{"id": null, "n": "0451002", "target": "#nkr_note_orig_0451002", "type": "orig", "text": "辦＝辨【甲】【乙】＊"}
{"id": null, "n": "0451003", "target": "#nkr_note_orig_0451003", "type": "orig", "text": "〔也〕－【甲】＊"}
{"id": null, "n": "0452001", "target": "#nkr_note_orig_0452001", "type": "orig", "text": "資＝實【甲】"}
{"id": null, "n": "0453001", "target": "#nkr_note_orig_0453001", "type": "orig", "text": "匱＝遺【甲】【乙】"}
{"id": null, "n": "0453002", "target": "#nkr_note_orig_0453002", "type": "orig", "text": "險徑＝󳖥侄【甲】【乙】"}
{"id": null, "n": "0453003", "target": "#nkr_note_orig_0453003", "type": "orig", "text": "火＝大【甲】"}
{"id": null, "n": "0454001", "target": "#nkr_note_orig_0454001", "type": "orig", "text": "則＋（是）ヵ【原】"}
{"id": null, "n": "0455001", "target": "#nkr_note_orig_0455001", "type": "orig", "text": "推＝堆【甲】"}
{"id": null, "n": "0455002", "target": "#nkr_note_orig_0455002", "type": "orig", "text": "名＝稱【甲】"}
{"id": null, "n": "0457001", "target": "#nkr_note_orig_0457001", "type": "orig", "text": "特＝恃【甲】"}
{"id": null, "n": "0458001", "target": "#nkr_note_orig_0458001", "type": "orig", "text": "以下至終甲本缺之"}
{"id": null, "n": "0460001", "target": "#nkr_note_orig_0460001", "type": "orig", "text": "謂＝諸【乙】"}
{"id": null, "n": "0466001", "target": "#nkr_note_orig_0466001", "type": "orig", "text": "乘＝眾【乙】"}
{"id": null, "n": "0467001", "target": "#nkr_note_orig_0467001", "type": "orig", "text": "〔終〕－【乙】"}
{"id": null, "n": "0462c2101", "target": "#nkr_note_add_0462c2101", "type": "add", "text": "少【CB】，小【大】"}
