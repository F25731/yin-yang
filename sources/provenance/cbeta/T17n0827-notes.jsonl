{"id": null, "n": "0870007", "target": "#nkr_note_mod_0870007", "type": "mod", "text": "宋沙門惠簡譯【大】，宋居士沮渠京聲譯【宋】【元】【明】【宮】"}
{"id": null, "n": "0870008", "target": "#nkr_note_mod_0870008", "type": "mod", "text": "妙【大】，好【宋】【元】【明】【宮】"}
{"id": null, "n": "0870009", "target": "#nkr_note_mod_0870009", "type": "mod", "text": "喜【大】，欣【宋】【元】【明】【宮】"}
{"id": null, "n": "0870010", "target": "#nkr_note_mod_0870010", "type": "mod", "text": "諮【大】，資【宋】【宮】"}
{"id": null, "n": "0870011", "target": "#nkr_note_mod_0870011", "type": "mod", "text": "義【大】＊，誼【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0870012", "target": "#nkr_note_mod_0870012", "type": "mod", "text": "放【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0870013", "target": "#nkr_note_mod_0870013", "type": "mod", "text": "神【大】，來【宋】【元】【明】【宮】"}
{"id": null, "n": "0870014", "target": "#nkr_note_mod_0870014", "type": "mod", "text": "唯【大】，惟【宋】【元】【明】【宮】"}
{"id": null, "n": "0870015", "target": "#nkr_note_mod_0870015", "type": "mod", "text": "無上【大】，無上心【宋】【元】【明】【宮】"}
{"id": null, "n": "0870016", "target": "#nkr_note_mod_0870016", "type": "mod", "text": "動有劫數【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0870017", "target": "#nkr_note_mod_0870017", "type": "mod", "text": "倫【大】，輪【宋】【元】【宮】"}
{"id": null, "n": "0870018", "target": "#nkr_note_mod_0870018", "type": "mod", "text": "王【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0870007", "target": "#nkr_note_orig_0870007", "type": "orig", "text": "宋沙門惠簡譯＝宋居士沮渠京聲譯【三】【宮】"}
{"id": null, "n": "0870008", "target": "#nkr_note_orig_0870008", "type": "orig", "text": "妙＝好【三】【宮】"}
{"id": null, "n": "0870009", "target": "#nkr_note_orig_0870009", "type": "orig", "text": "喜＝欣【三】【宮】"}
{"id": null, "n": "0870010", "target": "#nkr_note_orig_0870010", "type": "orig", "text": "諮＝資【宋】【宮】"}
{"id": null, "n": "0870011", "target": "#nkr_note_orig_0870011", "type": "orig", "text": "義＝誼【三】【宮】＊"}
{"id": null, "n": "0870012", "target": "#nkr_note_orig_0870012", "type": "orig", "text": "〔放〕－【三】【宮】"}
{"id": null, "n": "0870013", "target": "#nkr_note_orig_0870013", "type": "orig", "text": "神＝來【三】【宮】"}
{"id": null, "n": "0870014", "target": "#nkr_note_orig_0870014", "type": "orig", "text": "唯＝惟【三】【宮】"}
{"id": null, "n": "0870015", "target": "#nkr_note_orig_0870015", "type": "orig", "text": "無上＋（心）【三】【宮】"}
{"id": null, "n": "0870016", "target": "#nkr_note_orig_0870016", "type": "orig", "text": "〔動有劫數〕－【三】【宮】"}
{"id": null, "n": "0870017", "target": "#nkr_note_orig_0870017", "type": "orig", "text": "倫＝輪【宋】【元】【宮】"}
{"id": null, "n": "0870018", "target": "#nkr_note_orig_0870018", "type": "orig", "text": "〔王〕－【三】【宮】"}
{"id": null, "n": "0870b2001", "target": "#nkr_note_add_0870b2001", "type": "add", "text": "標點重校者按：根據《前世三轉經》（西晉法炬譯）、《佛說心明經》（西晉竺法護譯）及《七知經》（吳．支謙譯），後句中應落「暢眾會事」或「明眾」、「知眾」一種。"}
