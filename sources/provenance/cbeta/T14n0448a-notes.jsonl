{"id": null, "n": "0388009", "target": "#nkr_note_mod_0388009", "type": "mod", "text": "巖【大】＊，嚴【元】＊"}
{"id": null, "n": "0388010", "target": "#nkr_note_mod_0388010", "type": "mod", "text": "好【大】，好光明【宋】【元】"}
{"id": null, "n": "0388011", "target": "#nkr_note_mod_0388011", "type": "mod", "text": "如來【大】，佛【宋】【元】【宮】"}
{"id": null, "n": "0388012", "target": "#nkr_note_mod_0388012", "type": "mod", "text": "類【大】，律【宋】【元】"}
