{"id": null, "n": "0912001", "target": "#nkr_note_mod_0912001", "type": "mod", "text": "苗【大】，茅【宋】【元】【明】【宮】"}
{"id": null, "n": "0912002", "target": "#nkr_note_mod_0912002", "type": "mod", "text": "賈【大】，〔－〕【宮】"}
{"id": null, "n": "0912003", "target": "#nkr_note_mod_0912003", "type": "mod", "text": "諛諂【大】＊，諂諛【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0912004", "target": "#nkr_note_mod_0912004", "type": "mod", "text": "不持戒【大】，四事沙門不應【宋】【元】【明】【宮】"}
{"id": null, "n": "0912005", "target": "#nkr_note_mod_0912005", "type": "mod", "text": "效承【大】，於【宋】【元】【明】【宮】"}
{"id": null, "n": "0912006", "target": "#nkr_note_mod_0912006", "type": "mod", "text": "如【大】，於【明】"}
{"id": null, "n": "0912007", "target": "#nkr_note_mod_0912007", "type": "mod", "text": "欲【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0912008", "target": "#nkr_note_mod_0912008", "type": "mod", "text": "善【大】，入【宋】【元】【明】【宮】"}
{"id": null, "n": "0912009", "target": "#nkr_note_mod_0912009", "type": "mod", "text": "常【大】，識【宋】【元】【明】【宮】"}
{"id": null, "n": "0912010", "target": "#nkr_note_mod_0912010", "type": "mod", "text": "我無【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0912011", "target": "#nkr_note_mod_0912011", "type": "mod", "text": "稱【大】，種【宋】【元】【明】【宮】"}
{"id": null, "n": "0912012", "target": "#nkr_note_mod_0912012", "type": "mod", "text": "教【大】，敦【宋】【元】【明】【宮】"}
{"id": null, "n": "0912001", "target": "#nkr_note_orig_0912001", "type": "orig", "text": "苗＝茅【三】【宮】"}
{"id": null, "n": "0912002", "target": "#nkr_note_orig_0912002", "type": "orig", "text": "〔賈〕－【宮】"}
{"id": null, "n": "0912003", "target": "#nkr_note_orig_0912003", "type": "orig", "text": "諛諂＝諂諛【三】【宮】＊"}
{"id": null, "n": "0912004", "target": "#nkr_note_orig_0912004", "type": "orig", "text": "不持戒＝四事沙門不應【三】【宮】"}
{"id": null, "n": "0912005", "target": "#nkr_note_orig_0912005", "type": "orig", "text": "效承＝於【三】【宮】"}
{"id": null, "n": "0912006", "target": "#nkr_note_orig_0912006", "type": "orig", "text": "如＝於【明】"}
{"id": null, "n": "0912007", "target": "#nkr_note_orig_0912007", "type": "orig", "text": "〔欲〕－【三】【宮】"}
{"id": null, "n": "0912008", "target": "#nkr_note_orig_0912008", "type": "orig", "text": "善＝入【三】【宮】"}
{"id": null, "n": "0912009", "target": "#nkr_note_orig_0912009", "type": "orig", "text": "常＝識【三】【宮】"}
{"id": null, "n": "0912010", "target": "#nkr_note_orig_0912010", "type": "orig", "text": "〔我無〕－【三】【宮】"}
{"id": null, "n": "0912011", "target": "#nkr_note_orig_0912011", "type": "orig", "text": "稱＝種【三】【宮】"}
{"id": null, "n": "0912012", "target": "#nkr_note_orig_0912012", "type": "orig", "text": "教＝敦【三】【宮】"}
