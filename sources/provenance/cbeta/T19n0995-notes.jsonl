{"id": null, "n": "0520001", "target": "#nkr_note_mod_0520001", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0520002", "target": "#nkr_note_mod_0520002", "type": "mod", "text": "（開府…門）四十一字【大】，大興善寺三藏沙門大廣智【宋】【元】，唐三藏沙門大廣智【明】【甲】"}
{"id": null, "n": "0520003", "target": "#nkr_note_mod_0520003", "type": "mod", "text": "法【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0520004", "target": "#nkr_note_mod_0520004", "type": "mod", "text": "跏【大】＊，加【宋】【元】＊"}
{"id": null, "n": "0520005", "target": "#nkr_note_mod_0520005", "type": "mod", "text": "曰【大】，〔－〕【元】"}
{"id": null, "n": "0520006", "target": "#nkr_note_mod_0520006", "type": "mod", "text": "唵【大】＊，唵一【宋】【元】【明】【甲】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": "0520007", "target": "#nkr_note_mod_0520007", "type": "mod", "text": "入【大】，入聲【明】【甲】"}
{"id": null, "n": "0520008", "target": "#nkr_note_mod_0520008", "type": "mod", "text": "引【大】＊，引二【宋】【元】【明】【甲】＊"}
{"id": null, "n": "0520009", "target": "#nkr_note_mod_0520009", "type": "mod", "text": "引【大】，引上三【宋】【元】，上聲聲三【明】，上聲引三【甲】"}
{"id": null, "n": "0520010", "target": "#nkr_note_mod_0520010", "type": "mod", "text": "婆【大】，婆引【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0520011", "target": "#nkr_note_mod_0520011", "type": "mod", "text": "撼【大】，憾四【宋】【元】【明】【甲】"}
{"id": null, "n": "0520012", "target": "#nkr_note_mod_0520012", "type": "mod", "text": "兩手當【大】，以兩當手【元】，以兩手當【明】【甲】"}
{"id": null, "n": "0520013", "target": "#nkr_note_mod_0520013", "type": "mod", "text": "拳【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0520014", "target": "#nkr_note_mod_0520014", "type": "mod", "text": "去【大】，去聲【明】【甲】"}
{"id": null, "n": "0520016", "target": "#nkr_note_mod_0520016", "type": "mod", "text": "行【大】，行法行【宋】【元】【明】【甲】"}
{"id": null, "n": "0520017", "target": "#nkr_note_mod_0520017", "type": "mod", "text": "去【大】，去引二【宋】【元】，去聲引二【明】【甲】"}
{"id": null, "n": "0520018", "target": "#nkr_note_mod_0520018", "type": "mod", "text": "準【大】，唯【元】"}
{"id": null, "n": "0520019", "target": "#nkr_note_mod_0520019", "type": "mod", "text": "訶【大】＊，訶引二【宋】＊【元】＊【明】＊，訶二合【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引二"}
{"id": null, "n": "0520020", "target": "#nkr_note_mod_0520020", "type": "mod", "text": "令【大】，彼【元】"}
{"id": null, "n": "0520021", "target": "#nkr_note_mod_0520021", "type": "mod", "text": "若有隱【大】，善隱顯【宋】【元】【明】"}
{"id": null, "n": "0520023", "target": "#nkr_note_mod_0520023", "type": "mod", "text": "他【大】，地【宋】【元】【明】"}
{"id": null, "n": "0520024", "target": "#nkr_note_mod_0520024", "type": "mod", "text": "持捧【大】，捧持【明】【甲】"}
{"id": null, "n": "0520025", "target": "#nkr_note_mod_0520025", "type": "mod", "text": "上【大】，前【明】【甲】"}
{"id": null, "n": "0520026", "target": "#nkr_note_mod_0520026", "type": "mod", "text": "布【大】，大【元】【明】"}
{"id": null, "n": "0520027", "target": "#nkr_note_mod_0520027", "type": "mod", "text": "佛【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0520028", "target": "#nkr_note_mod_0520028", "type": "mod", "text": "頂【大】，頂者【宋】【元】【明】【甲】"}
{"id": null, "n": "0520029", "target": "#nkr_note_mod_0520029", "type": "mod", "text": "真【大】，誦真【考偽-甲】"}
{"id": null, "n": "0520030", "target": "#nkr_note_mod_0520030", "type": "mod", "text": "寶【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0521001", "target": "#nkr_note_mod_0521001", "type": "mod", "text": "押【大】＊，壓【元】【明】【甲】＊"}
{"id": null, "n": "0521002", "target": "#nkr_note_mod_0521002", "type": "mod", "text": "引【大】，引一【宋】【元】【明】【甲】"}
{"id": null, "n": "0521003", "target": "#nkr_note_mod_0521003", "type": "mod", "text": "他【大】，他引【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0521004", "target": "#nkr_note_mod_0521004", "type": "mod", "text": "平【大】，平二【宋】【元】，平聲二【明】【甲】"}
{"id": null, "n": "0521005", "target": "#nkr_note_mod_0521005", "type": "mod", "text": "𤚥【大】，𤚥三【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": "0521006", "target": "#nkr_note_mod_0521006", "type": "mod", "text": "上【大】，二【宋】【元】"}
{"id": null, "n": "0521007", "target": "#nkr_note_mod_0521007", "type": "mod", "text": "訶【大】，訶引四【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引四"}
{"id": null, "n": "0521008", "target": "#nkr_note_mod_0521008", "type": "mod", "text": "蓮【大】，運【宋】【元】【明】【甲】"}
{"id": null, "n": "0521009", "target": "#nkr_note_mod_0521009", "type": "mod", "text": "於【大】，如【明】"}
{"id": null, "n": "0521010", "target": "#nkr_note_mod_0521010", "type": "mod", "text": "又【大】，當【元】【明】"}
{"id": null, "n": "0521011", "target": "#nkr_note_mod_0521011", "type": "mod", "text": "夾【大】，筴【明】"}
{"id": null, "n": "0521012", "target": "#nkr_note_mod_0521012", "type": "mod", "text": "王【大】，者【明】【甲】"}
{"id": null, "n": "0521013", "target": "#nkr_note_mod_0521013", "type": "mod", "text": "夜【大】＊，夜引【甲】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0521014", "target": "#nkr_note_mod_0521014", "type": "mod", "text": "引阿【大】，阿引【甲】"}
{"id": null, "n": "0521015", "target": "#nkr_note_mod_0521015", "type": "mod", "text": "反【大】＊，切【明】【甲】＊"}
{"id": null, "n": "0521016", "target": "#nkr_note_mod_0521016", "type": "mod", "text": "𡀔【大】，𡀔引【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0521017", "target": "#nkr_note_mod_0521017", "type": "mod", "text": "娜【大】，娜引【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0521018", "target": "#nkr_note_mod_0521018", "type": "mod", "text": "󰋲【大】，𦽆【宋】【元】【明】【甲】"}
{"id": null, "n": "0521019", "target": "#nkr_note_mod_0521019", "type": "mod", "text": "賀【大】＊，賀引【甲】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
