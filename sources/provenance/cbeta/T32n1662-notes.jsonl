{"id": null, "n": "0543007", "target": "#nkr_note_mod_0543007", "type": "mod", "text": "西天【大】＊，宋西天【明】＊"}
{"id": null, "n": "0543008", "target": "#nkr_note_mod_0543008", "type": "mod", "text": "密林寺【大】＊，〔－〕【明】＊"}
{"id": null, "n": "0543009", "target": "#nkr_note_mod_0543009", "type": "mod", "text": "賜紫沙門【大】＊，〔－〕【明】＊"}
{"id": null, "n": "0543010", "target": "#nkr_note_mod_0543010", "type": "mod", "text": "臣【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0544001", "target": "#nkr_note_mod_0544001", "type": "mod", "text": "彼【大】，心【宋】【元】【明】"}
{"id": null, "n": "0544002", "target": "#nkr_note_mod_0544002", "type": "mod", "text": "菩提行經【大】＊，〔－〕【明】＊，II. Pāpadeśanā."}
{"id": null, "n": "0545001", "target": "#nkr_note_mod_0545001", "type": "mod", "text": "普賢…觀自在. Samantabhadrâjitamañjughoṣalokeśvara."}
{"id": null, "n": "0545004", "target": "#nkr_note_mod_0545004", "type": "mod", "text": "故【大】，今【元】"}
{"id": null, "n": "0545005", "target": "#nkr_note_mod_0545005", "type": "mod", "text": "菩【大】，善【明】"}
{"id": null, "n": "0546001", "target": "#nkr_note_mod_0546001", "type": "mod", "text": "實語【大】，語實【元】【明】"}
{"id": null, "n": "0546002", "target": "#nkr_note_mod_0546002", "type": "mod", "text": "求【大】，來【明】"}
{"id": null, "n": "0547001", "target": "#nkr_note_mod_0547001", "type": "mod", "text": "痢【大】，利【明】【宮】"}
{"id": null, "n": "0547002", "target": "#nkr_note_mod_0547002", "type": "mod", "text": "垂【大】，搖【宮】"}
{"id": null, "n": "0547003", "target": "#nkr_note_mod_0547003", "type": "mod", "text": "挑【大】，掉【元】【明】"}
{"id": null, "n": "0547004", "target": "#nkr_note_mod_0547004", "type": "mod", "text": "虛空藏經 Ākāśagarbha-sūlra."}
{"id": null, "n": "0547006", "target": "#nkr_note_mod_0547006", "type": "mod", "text": "見【大】，是【明】"}
{"id": null, "n": "0547008", "target": "#nkr_note_mod_0547008", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0548001", "target": "#nkr_note_mod_0548001", "type": "mod", "text": "何【大】，尚【宋】【元】"}
{"id": null, "n": "0548002", "target": "#nkr_note_mod_0548002", "type": "mod", "text": "雖【大】，須【宋】【元】【明】"}
{"id": null, "n": "0548003", "target": "#nkr_note_mod_0548003", "type": "mod", "text": "活命【大】，破壞【宋】【元】【明】"}
{"id": null, "n": "0549001", "target": "#nkr_note_mod_0549001", "type": "mod", "text": "於忍【大】，忍於【宋】【元】【明】"}
{"id": null, "n": "0549002", "target": "#nkr_note_mod_0549002", "type": "mod", "text": "讚【大】，實【宋】【元】【明】"}
{"id": null, "n": "0549003", "target": "#nkr_note_mod_0549003", "type": "mod", "text": "而【大】，自【宋】【元】【明】"}
{"id": null, "n": "0549004", "target": "#nkr_note_mod_0549004", "type": "mod", "text": "得【大】，緣【宋】【元】"}
{"id": null, "n": "0549005", "target": "#nkr_note_mod_0549005", "type": "mod", "text": "由【大】，猶【元】【明】"}
{"id": null, "n": "0549006", "target": "#nkr_note_mod_0549006", "type": "mod", "text": "受【大】，愛【宋】"}
{"id": null, "n": "0549007", "target": "#nkr_note_mod_0549007", "type": "mod", "text": "令【大】，今【明】"}
{"id": null, "n": "0550001", "target": "#nkr_note_mod_0550001", "type": "mod", "text": "我復【大】，復我【宋】【元】"}
{"id": null, "n": "0550002", "target": "#nkr_note_mod_0550002", "type": "mod", "text": "常【大】，當【宋】【元】【明】【宮】"}
{"id": null, "n": "0550003", "target": "#nkr_note_mod_0550003", "type": "mod", "text": "此作【大】，作此【宋】【元】【明】"}
{"id": null, "n": "0550004", "target": "#nkr_note_mod_0550004", "type": "mod", "text": "慜【大】，愍【明】【宮】"}
{"id": null, "n": "0550005", "target": "#nkr_note_mod_0550005", "type": "mod", "text": "慜【大】下同，愍【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0550006", "target": "#nkr_note_mod_0550006", "type": "mod", "text": "為奉【大】，奉事【宋】【元】【明】"}
{"id": null, "n": "0550007", "target": "#nkr_note_mod_0550007", "type": "mod", "text": "善【大】，喜【宋】【元】【明】【宮】"}
{"id": null, "n": "0550008", "target": "#nkr_note_mod_0550008", "type": "mod", "text": "菩提行經【大】，〔－〕【明】"}
{"id": null, "n": "0551001", "target": "#nkr_note_mod_0551001", "type": "mod", "text": "謝【大】，榭【宋】【元】"}
{"id": null, "n": "0551002", "target": "#nkr_note_mod_0551002", "type": "mod", "text": "貧【大】，貪【宋】【元】"}
{"id": null, "n": "0551003", "target": "#nkr_note_mod_0551003", "type": "mod", "text": "杖【大】，仗【宋】【元】【明】"}
{"id": null, "n": "0551004", "target": "#nkr_note_mod_0551004", "type": "mod", "text": "斤【大】，觔【明】"}
{"id": null, "n": "0551005", "target": "#nkr_note_mod_0551005", "type": "mod", "text": "烏【CB】【麗-CB】【宋】【元】【明】【宮】，鳥【大】"}
{"id": null, "n": "0552002", "target": "#nkr_note_mod_0552002", "type": "mod", "text": "馱【CB】【麗-CB】，駄【大】，〔－〕【宮】"}
{"id": null, "n": "0552004", "target": "#nkr_note_mod_0552004", "type": "mod", "text": "慜【大】，愍【宋】【元】【明】【宮】"}
{"id": null, "n": "0552005", "target": "#nkr_note_mod_0552005", "type": "mod", "text": "芽【大】，牙【元】，世【明】"}
{"id": null, "n": "0553001", "target": "#nkr_note_mod_0553001", "type": "mod", "text": "精進【大】，進精【宋】"}
{"id": null, "n": "0553002", "target": "#nkr_note_mod_0553002", "type": "mod", "text": "壞【大】＊，懷【宋】＊"}
{"id": null, "n": "0553003", "target": "#nkr_note_mod_0553003", "type": "mod", "text": "直【大】，真【宋】【元】【明】【宮】"}
{"id": null, "n": "0553004", "target": "#nkr_note_mod_0553004", "type": "mod", "text": "直【大】，真【元】【明】【宮】"}
{"id": null, "n": "0553005", "target": "#nkr_note_mod_0553005", "type": "mod", "text": "偏【大】，遍【宋】【元】【明】【宮】"}
{"id": null, "n": "0553006", "target": "#nkr_note_mod_0553006", "type": "mod", "text": "慾【大】，欲【宋】【元】【明】【宮】"}
{"id": null, "n": "0553007", "target": "#nkr_note_mod_0553007", "type": "mod", "text": "若【大】，苦【明】"}
{"id": null, "n": "0553008", "target": "#nkr_note_mod_0553008", "type": "mod", "text": "身【大】，見【宋】"}
{"id": null, "n": "0553009", "target": "#nkr_note_mod_0553009", "type": "mod", "text": "今【大】，〔－〕【明】"}
{"id": null, "n": "0554001", "target": "#nkr_note_mod_0554001", "type": "mod", "text": "受【CB】【麗-CB】【宋】【元】【明】【宮】，愛【大】"}
{"id": null, "n": "0554002", "target": "#nkr_note_mod_0554002", "type": "mod", "text": "先【大】，見【宋】"}
{"id": null, "n": "0554003", "target": "#nkr_note_mod_0554003", "type": "mod", "text": "苦【大】，若【宋】"}
{"id": null, "n": "0554004", "target": "#nkr_note_mod_0554004", "type": "mod", "text": "苦【大】，若【宮】"}
{"id": null, "n": "0554005", "target": "#nkr_note_mod_0554005", "type": "mod", "text": "令【大】，今【宋】【元】【明】【宮】"}
{"id": null, "n": "0554006", "target": "#nkr_note_mod_0554006", "type": "mod", "text": "何【大】，同【元】"}
{"id": null, "n": "0555001", "target": "#nkr_note_mod_0555001", "type": "mod", "text": "住【大】，行【宮】"}
{"id": null, "n": "0555002", "target": "#nkr_note_mod_0555002", "type": "mod", "text": "由【大】，猶【元】【明】【宮】"}
{"id": null, "n": "0555004", "target": "#nkr_note_mod_0555004", "type": "mod", "text": "財【大】，報【宮】"}
{"id": null, "n": "0556001", "target": "#nkr_note_mod_0556001", "type": "mod", "text": "壞【大】，懷【宋】【元】【宮】"}
{"id": null, "n": "0556003", "target": "#nkr_note_mod_0556003", "type": "mod", "text": "真如 Paramārtha."}
{"id": null, "n": "0556004", "target": "#nkr_note_mod_0556004", "type": "mod", "text": "世間 Sṃvaṛti."}
{"id": null, "n": "0557001", "target": "#nkr_note_mod_0557001", "type": "mod", "text": "喻於【大】，如喻【明】"}
{"id": null, "n": "0557002", "target": "#nkr_note_mod_0557002", "type": "mod", "text": "知【大】，如【宋】【元】【明】【宮】"}
{"id": null, "n": "0557003", "target": "#nkr_note_mod_0557003", "type": "mod", "text": "劫樹 Kalpataru."}
{"id": null, "n": "0557004", "target": "#nkr_note_mod_0557004", "type": "mod", "text": "Cintāmaṇi（如意摩尼）."}
{"id": null, "n": "0557005", "target": "#nkr_note_mod_0557005", "type": "mod", "text": "法呪. Gāruḍika（呪者）."}
{"id": null, "n": "0557006", "target": "#nkr_note_mod_0557006", "type": "mod", "text": "外道論 Vedādi."}
{"id": null, "n": "0558001", "target": "#nkr_note_mod_0558001", "type": "mod", "text": "痢汗【大】，利污【明】"}
{"id": null, "n": "0558002", "target": "#nkr_note_mod_0558002", "type": "mod", "text": "有情塵所翳. Sattva-rajas-tamas.（喜，憂，暗）"}
{"id": null, "n": "0558003", "target": "#nkr_note_mod_0558003", "type": "mod", "text": "自性 Svabhāva."}
{"id": null, "n": "0558004", "target": "#nkr_note_mod_0558004", "type": "mod", "text": "我慢 Ahaṃkāra."}
{"id": null, "n": "0558005", "target": "#nkr_note_mod_0558005", "type": "mod", "text": "愛【大】，受【宮】"}
{"id": null, "n": "0559001", "target": "#nkr_note_mod_0559001", "type": "mod", "text": "和合 Saṃsarga."}
{"id": null, "n": "0559002", "target": "#nkr_note_mod_0559002", "type": "mod", "text": "二【大】，者【宮】"}
{"id": null, "n": "0559003", "target": "#nkr_note_mod_0559003", "type": "mod", "text": "自在 IIśvara."}
{"id": null, "n": "0559004", "target": "#nkr_note_mod_0559004", "type": "mod", "text": "有情塵闇蔽. Sattva-rajas-tamas.（喜，憂，暗）"}
{"id": null, "n": "0559005", "target": "#nkr_note_mod_0559005", "type": "mod", "text": "功德. Guṇa.（德）."}
{"id": null, "n": "0559008", "target": "#nkr_note_mod_0559008", "type": "mod", "text": "微細 Sūkṣma."}
{"id": null, "n": "0560002", "target": "#nkr_note_mod_0560002", "type": "mod", "text": "真如 Tattva."}
{"id": null, "n": "0560003", "target": "#nkr_note_mod_0560003", "type": "mod", "text": "量 Pramāṇa."}
{"id": null, "n": "0560004", "target": "#nkr_note_mod_0560004", "type": "mod", "text": "著【CB】【麗-CB】【宋】【元】【明】【宮】，者【大】"}
{"id": null, "n": "0560005", "target": "#nkr_note_mod_0560005", "type": "mod", "text": "因緣 Pratyaya."}
{"id": null, "n": "0560006", "target": "#nkr_note_mod_0560006", "type": "mod", "text": "性 Bhāva."}
{"id": null, "n": "0560007", "target": "#nkr_note_mod_0560007", "type": "mod", "text": "菩提行經【大】，〔－〕【明】，梵 X. Pariṇāmanā."}
{"id": null, "n": "0560008", "target": "#nkr_note_mod_0560008", "type": "mod", "text": "菩提【大】，菩薩【明】【宮】"}
{"id": null, "n": "0561001", "target": "#nkr_note_mod_0561001", "type": "mod", "text": "金剛手 Vajrapāṇi."}
{"id": null, "n": "0561002", "target": "#nkr_note_mod_0561002", "type": "mod", "text": "觀自在 Kamalapāṇi."}
{"id": null, "n": "0561007", "target": "#nkr_note_mod_0561007", "type": "mod", "text": "飢【大】，饑【明】"}
{"id": null, "n": "0561008", "target": "#nkr_note_mod_0561008", "type": "mod", "text": "我【大】，得【宮】"}
{"id": null, "n": "0561009", "target": "#nkr_note_mod_0561009", "type": "mod", "text": "常【大】，當【明】"}
{"id": null, "n": "0561010", "target": "#nkr_note_mod_0561010", "type": "mod", "text": "受【大】，授【明】"}
{"id": null, "n": "0561011", "target": "#nkr_note_mod_0561011", "type": "mod", "text": "明 Mantra."}
{"id": null, "n": "0543006", "target": "#nkr_note_orig_0543006", "type": "orig", "text": "梵名 Bodhicaryâvatāra."}
{"id": null, "n": "0543007", "target": "#nkr_note_orig_0543007", "type": "orig", "text": "（宋）＋西天【明】＊"}
{"id": null, "n": "0543008", "target": "#nkr_note_orig_0543008", "type": "orig", "text": "〔密林寺〕－【明】＊"}
{"id": null, "n": "0543009", "target": "#nkr_note_orig_0543009", "type": "orig", "text": "〔賜紫沙門〕－【明】＊"}
{"id": null, "n": "0543010", "target": "#nkr_note_orig_0543010", "type": "orig", "text": "〔臣〕－【三】【宮】＊"}
{"id": null, "n": "0543011", "target": "#nkr_note_orig_0543011", "type": "orig", "text": "I. Bodhicittânuśaṃsā."}
{"id": null, "n": "0544001", "target": "#nkr_note_orig_0544001", "type": "orig", "text": "彼＝心【三】"}
{"id": null, "n": "0544002", "target": "#nkr_note_orig_0544002", "type": "orig", "text": "〔菩提行經〕－【明】＊; II. Pāpadeśanā."}
{"id": null, "n": "0545001", "target": "#nkr_note_orig_0545001", "type": "orig", "text": "普賢…觀自在. Samantabhadrâjitamañjughoṣalokeśvara."}
{"id": null, "n": "0545002", "target": "#nkr_note_orig_0545002", "type": "orig", "text": "以下梵有五十三偈及持品 (Bodhicittaparigraha) 三十二偈不放逸品 (Bodhicittâpramāda) 四十九偈。"}
{"id": null, "n": "0545003", "target": "#nkr_note_orig_0545003", "type": "orig", "text": "梵. V. Samprajanyarakṣaṇa."}
{"id": null, "n": "0545004", "target": "#nkr_note_orig_0545004", "type": "orig", "text": "故＝今【元】"}
{"id": null, "n": "0545005", "target": "#nkr_note_orig_0545005", "type": "orig", "text": "菩＝善【明】"}
{"id": null, "n": "0546001", "target": "#nkr_note_orig_0546001", "type": "orig", "text": "實語＝語實【元】【明】"}
{"id": null, "n": "0546002", "target": "#nkr_note_orig_0546002", "type": "orig", "text": "求＝來【明】"}
{"id": null, "n": "0547001", "target": "#nkr_note_orig_0547001", "type": "orig", "text": "痢＝利【明】【宮】"}
{"id": null, "n": "0547002", "target": "#nkr_note_orig_0547002", "type": "orig", "text": "垂＝搖【宮】"}
{"id": null, "n": "0547003", "target": "#nkr_note_orig_0547003", "type": "orig", "text": "挑＝掉【元】【明】"}
{"id": null, "n": "0547004", "target": "#nkr_note_orig_0547004", "type": "orig", "text": "虛空藏經, Ākāśagarbha-sūlra."}
{"id": null, "n": "0547005", "target": "#nkr_note_orig_0547005", "type": "orig", "text": "Mūlāpatti."}
{"id": null, "n": "0547006", "target": "#nkr_note_orig_0547006", "type": "orig", "text": "見＝是【明】"}
{"id": null, "n": "0547007", "target": "#nkr_note_orig_0547007", "type": "orig", "text": "Nāgārjuna."}
{"id": null, "n": "0547008", "target": "#nkr_note_orig_0547008", "type": "orig", "text": "〔臣〕－【明】"}
{"id": null, "n": "0547009", "target": "#nkr_note_orig_0547009", "type": "orig", "text": "梵 VI. Kṣāntipāramitā."}
{"id": null, "n": "0547010", "target": "#nkr_note_orig_0547010", "type": "orig", "text": "Durgāputraka."}
{"id": null, "n": "0548001", "target": "#nkr_note_orig_0548001", "type": "orig", "text": "何＝尚【宋】【元】"}
{"id": null, "n": "0548002", "target": "#nkr_note_orig_0548002", "type": "orig", "text": "雖＝須【三】"}
{"id": null, "n": "0548003", "target": "#nkr_note_orig_0548003", "type": "orig", "text": "活命＝破壞【三】"}
{"id": null, "n": "0549001", "target": "#nkr_note_orig_0549001", "type": "orig", "text": "於忍＝忍於【三】"}
