{"id": null, "n": "0669007", "target": "#nkr_note_mod_0669007", "type": "mod", "text": "（西天…譯）二十九字【大】，宋中天西印度摩伽陀國三藏傳教大師法天奉詔譯【明】"}
{"id": null, "n": "0670001", "target": "#nkr_note_mod_0670001", "type": "mod", "text": "硨磲【大】，𤥭璖【宋】【明】"}
{"id": null, "n": "0670002", "target": "#nkr_note_mod_0670002", "type": "mod", "text": "囉【大】，羅【宋】【元】【明】"}
{"id": null, "n": "0670003", "target": "#nkr_note_mod_0670003", "type": "mod", "text": "去【大】下同，去聲【明】下同"}
{"id": null, "n": "0670004", "target": "#nkr_note_mod_0670004", "type": "mod", "text": "反【大】下同，切【明】下同"}
{"id": null, "n": "0670005", "target": "#nkr_note_mod_0670005", "type": "mod", "text": "准【大】＊，同【明】＊"}
{"id": null, "n": "0670006", "target": "#nkr_note_mod_0670006", "type": "mod", "text": "引【大】，引下賀反【宋】【元】【明】"}
{"id": null, "n": "0670007", "target": "#nkr_note_mod_0670007", "type": "mod", "text": "黎【大】，嚟【宋】【元】【明】"}
{"id": null, "n": "0670008", "target": "#nkr_note_mod_0670008", "type": "mod", "text": "壹【大】，里【明】"}
{"id": null, "n": "0670009", "target": "#nkr_note_mod_0670009", "type": "mod", "text": "上【大】＊，上聲【明】＊"}
{"id": null, "n": "0670010", "target": "#nkr_note_mod_0670010", "type": "mod", "text": "逸【大】，吉【明】"}
{"id": null, "n": "0671001", "target": "#nkr_note_mod_0671001", "type": "mod", "text": "三【大】，二【宋】【元】【明】"}
{"id": null, "n": "0671002", "target": "#nkr_note_mod_0671002", "type": "mod", "text": "反【大】＊，〔－〕【明】＊"}
{"id": null, "n": "0671003", "target": "#nkr_note_mod_0671003", "type": "mod", "text": "娑【大】，婆【明】"}
{"id": null, "n": "0671004", "target": "#nkr_note_mod_0671004", "type": "mod", "text": "乎【大】，呼【宋】【元】，〔－〕【明】"}
{"id": null, "n": "0671005", "target": "#nkr_note_mod_0671005", "type": "mod", "text": "上同【大】＊，同上【明】＊"}
{"id": null, "n": "0671006", "target": "#nkr_note_mod_0671006", "type": "mod", "text": "縛【大】，嚩【宋】【元】【明】"}
{"id": null, "n": "0671007", "target": "#nkr_note_mod_0671007", "type": "mod", "text": "里【大】，哩【宋】【元】【明】"}
{"id": null, "n": "0671008", "target": "#nkr_note_mod_0671008", "type": "mod", "text": "二合反【大】，寧也切【明】"}
{"id": null, "n": "0671009", "target": "#nkr_note_mod_0671009", "type": "mod", "text": "若【大】，老【元】"}
{"id": null, "n": "0669006", "target": "#nkr_note_orig_0669006", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0669007", "target": "#nkr_note_orig_0669007", "type": "orig", "text": "（西天…譯）二十九字＝（宋中天西印度摩伽陀國三藏傳教大師法天奉詔譯）二十一字【明】"}
{"id": null, "n": "0670001", "target": "#nkr_note_orig_0670001", "type": "orig", "text": "硨磲＝𤥭璖【宋】【明】"}
{"id": null, "n": "0670002", "target": "#nkr_note_orig_0670002", "type": "orig", "text": "囉＝羅【三】"}
{"id": null, "n": "0670003", "target": "#nkr_note_orig_0670003", "type": "orig", "text": "去＋（聲）【明】下同"}
{"id": null, "n": "0670004", "target": "#nkr_note_orig_0670004", "type": "orig", "text": "反＝切【明】下同"}
{"id": null, "n": "0670005", "target": "#nkr_note_orig_0670005", "type": "orig", "text": "准＝同【明】＊"}
{"id": null, "n": "0670006", "target": "#nkr_note_orig_0670006", "type": "orig", "text": "引＋（下賀反）【三】"}
{"id": null, "n": "0670007", "target": "#nkr_note_orig_0670007", "type": "orig", "text": "黎＝嚟【三】"}
{"id": null, "n": "0670008", "target": "#nkr_note_orig_0670008", "type": "orig", "text": "壹＝里【明】"}
{"id": null, "n": "0670009", "target": "#nkr_note_orig_0670009", "type": "orig", "text": "上＋（聲）【明】＊"}
{"id": null, "n": "0670010", "target": "#nkr_note_orig_0670010", "type": "orig", "text": "逸＝吉【明】"}
{"id": null, "n": "0671001", "target": "#nkr_note_orig_0671001", "type": "orig", "text": "三＝二【三】"}
{"id": null, "n": "0671002", "target": "#nkr_note_orig_0671002", "type": "orig", "text": "〔反〕－【明】＊"}
{"id": null, "n": "0671003", "target": "#nkr_note_orig_0671003", "type": "orig", "text": "娑＝婆【明】"}
{"id": null, "n": "0671004", "target": "#nkr_note_orig_0671004", "type": "orig", "text": "乎＝呼【宋】【元】，〔乎〕－【明】"}
{"id": null, "n": "0671005", "target": "#nkr_note_orig_0671005", "type": "orig", "text": "上同＝同上【明】＊"}
{"id": null, "n": "0671006", "target": "#nkr_note_orig_0671006", "type": "orig", "text": "縛＝嚩【三】"}
{"id": null, "n": "0671007", "target": "#nkr_note_orig_0671007", "type": "orig", "text": "里＝哩【三】"}
{"id": null, "n": "0671008", "target": "#nkr_note_orig_0671008", "type": "orig", "text": "二合反＝寧也切【明】"}
{"id": null, "n": "0671009", "target": "#nkr_note_orig_0671009", "type": "orig", "text": "若＝老【元】"}
