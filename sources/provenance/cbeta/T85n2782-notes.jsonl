{"id": null, "n": "0556004", "target": "#nkr_note_orig_0556004", "type": "orig", "text": "物＝總【甲】"}
{"id": null, "n": "0556005", "target": "#nkr_note_orig_0556005", "type": "orig", "text": "〔時〕－【甲】"}
