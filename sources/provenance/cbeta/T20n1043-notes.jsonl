{"id": null, "n": "0034006", "target": "#nkr_note_mod_0034006", "type": "mod", "text": "晉言法喜【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0034007", "target": "#nkr_note_mod_0034007", "type": "mod", "text": "皆【大】，皆是【宋】【元】【明】"}
