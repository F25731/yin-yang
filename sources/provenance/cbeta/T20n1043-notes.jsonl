{"id": null, "n": "0035073", "target": "#nkr_note_mod_0035073", "type": "mod", "text": "常【大】，當【元】【明】"}
{"id": null, "n": "0035074", "target": "#nkr_note_mod_0035074", "type": "mod", "text": "焚【大】，燒【宋】【元】【明】"}
{"id": null, "n": "0035075", "target": "#nkr_note_mod_0035075", "type": "mod", "text": "此【大】，誦此【宋】【元】【明】"}
{"id": null, "n": "0035076", "target": "#nkr_note_mod_0035076", "type": "mod", "text": "此【大】，〔－〕【宋】【元】【明】"}
