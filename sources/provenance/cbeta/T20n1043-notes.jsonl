{"id": null, "n": "0037025", "target": "#nkr_note_mod_0037025", "type": "mod", "text": "名尾鬼【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0037026", "target": "#nkr_note_mod_0037026", "type": "mod", "text": "得【大】，見【宋】【元】【明】"}
{"id": null, "n": "0038001", "target": "#nkr_note_mod_0038001", "type": "mod", "text": "所不能害【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0038002", "target": "#nkr_note_mod_0038002", "type": "mod", "text": "千【大】，十【元】【明】"}
{"id": null, "n": "0038003", "target": "#nkr_note_mod_0038003", "type": "mod", "text": "㸌【大】，霍【宋】【元】【明】"}
{"id": null, "n": "0038004", "target": "#nkr_note_mod_0038004", "type": "mod", "text": "呪【大】，〔－〕【宋】【元】【明】"}
