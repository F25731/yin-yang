{"id": null, "n": "0036021", "target": "#nkr_note_mod_0036021", "type": "mod", "text": "普教一切眾【大】∞無上勝方便【宋】【元】【明】"}
{"id": null, "n": "0036022", "target": "#nkr_note_mod_0036022", "type": "mod", "text": "無上勝方便【大】∞普教一切眾【宋】【元】【明】"}
{"id": null, "n": "0036023", "target": "#nkr_note_mod_0036023", "type": "mod", "text": "使想【大】，繫念【明】"}
{"id": null, "n": "0036024", "target": "#nkr_note_mod_0036024", "type": "mod", "text": "細【大】，散【宋】【元】【明】"}
{"id": null, "n": "0036025", "target": "#nkr_note_mod_0036025", "type": "mod", "text": "祥【大】，詳【宋】【元】【明】"}
