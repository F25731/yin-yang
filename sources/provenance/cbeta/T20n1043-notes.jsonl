{"id": null, "n": "0036003", "target": "#nkr_note_mod_0036003", "type": "mod", "text": "名著瓔珞鬼【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0036004", "target": "#nkr_note_mod_0036004", "type": "mod", "text": "名捉鐵捧鬼【大】，〔－〕【宋】【元】【明】"}
