{"id": null, "n": "0034009", "target": "#nkr_note_mod_0034009", "type": "mod", "text": "羅【大】，邏【宋】【元】【明】"}
{"id": null, "n": "0034010", "target": "#nkr_note_mod_0034010", "type": "mod", "text": "白【大】，白佛【宋】【元】【明】"}
{"id": null, "n": "0034011", "target": "#nkr_note_mod_0034011", "type": "mod", "text": "天【大】，世【明】"}
{"id": null, "n": "0034012", "target": "#nkr_note_mod_0034012", "type": "mod", "text": "主【大】，立【宋】【元】【明】"}
{"id": null, "n": "0034013", "target": "#nkr_note_mod_0034013", "type": "mod", "text": "免【大】＊，勉【宋】＊"}
{"id": null, "n": "0034014", "target": "#nkr_note_mod_0034014", "type": "mod", "text": "殺【大】，毒【元】【明】"}
{"id": null, "n": "0035001", "target": "#nkr_note_mod_0035001", "type": "mod", "text": "必【大】，畢【宋】【元】【明】"}
{"id": null, "n": "0035002", "target": "#nkr_note_mod_0035002", "type": "mod", "text": "耶【大】，㖿【宋】【元】【明】"}
