{"id": null, "n": "0035048", "target": "#nkr_note_mod_0035048", "type": "mod", "text": "此鬼身白名曰白鬼【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0035049", "target": "#nkr_note_mod_0035049", "type": "mod", "text": "名極白鬼【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0035050", "target": "#nkr_note_mod_0035050", "type": "mod", "text": "休樓【大】，樓休【元】【明】"}
{"id": null, "n": "0035051", "target": "#nkr_note_mod_0035051", "type": "mod", "text": "三頭鬼【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0035052", "target": "#nkr_note_mod_0035052", "type": "mod", "text": "兜樓【大】，樓兜【元】【明】"}
{"id": null, "n": "0035053", "target": "#nkr_note_mod_0035053", "type": "mod", "text": "名母黑兒白鬼【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0035054", "target": "#nkr_note_mod_0035054", "type": "mod", "text": "周樓【大】，樓周【元】【明】"}
{"id": null, "n": "0035055", "target": "#nkr_note_mod_0035055", "type": "mod", "text": "（入山…鬼）二十字【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0035056", "target": "#nkr_note_mod_0035056", "type": "mod", "text": "槃【大】，般【宋】【元】【明】"}
{"id": null, "n": "0035057", "target": "#nkr_note_mod_0035057", "type": "mod", "text": "名出白鬼【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0035058", "target": "#nkr_note_mod_0035058", "type": "mod", "text": "豆富【大】，富豆【元】【明】"}
{"id": null, "n": "0035059", "target": "#nkr_note_mod_0035059", "type": "mod", "text": "（豆豆…鬼）十四字【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0035060", "target": "#nkr_note_mod_0035060", "type": "mod", "text": "殯資反【大】，〔－〕【明】，殞資反【宋】，殖資反【元】"}
{"id": null, "n": "0035061", "target": "#nkr_note_mod_0035061", "type": "mod", "text": "名億鬼【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0035062", "target": "#nkr_note_mod_0035062", "type": "mod", "text": "跈【大】，跈徐殄反【元】，跈徐殄切【明】"}
