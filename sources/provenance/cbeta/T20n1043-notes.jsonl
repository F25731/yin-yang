{"id": null, "n": "0037012", "target": "#nkr_note_mod_0037012", "type": "mod", "text": "名住山外鬼【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0037013", "target": "#nkr_note_mod_0037013", "type": "mod", "text": "名住山窟鬼【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0037014", "target": "#nkr_note_mod_0037014", "type": "mod", "text": "名爛目鬼【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0037015", "target": "#nkr_note_mod_0037015", "type": "mod", "text": "羅【大】，邏【宋】【元】【明】"}
