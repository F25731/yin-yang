{"id": null, "n": null, "target": null, "type": null, "text": "徐殄切"}
{"id": null, "n": "0035063", "target": "#nkr_note_mod_0035063", "type": "mod", "text": "乃軫反【大】，〔－〕【元】【明】"}
{"id": null, "n": "0035064", "target": "#nkr_note_mod_0035064", "type": "mod", "text": "名不億鬼【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0035065", "target": "#nkr_note_mod_0035065", "type": "mod", "text": "名最憶鬼【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0035066", "target": "#nkr_note_mod_0035066", "type": "mod", "text": "涅【大】，恒【宋】，𠷐【元】【明】"}
{"id": null, "n": "0035067", "target": "#nkr_note_mod_0035067", "type": "mod", "text": "婆【大】，娑【宋】【元】【明】"}
