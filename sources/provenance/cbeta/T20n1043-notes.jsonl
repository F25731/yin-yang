{"id": null, "n": "0035042", "target": "#nkr_note_mod_0035042", "type": "mod", "text": "虛抵反【大】，虛祇反【宋】【元】，〔－〕【明】"}
{"id": null, "n": "0035043", "target": "#nkr_note_mod_0035043", "type": "mod", "text": "名人嗔鬼【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0035044", "target": "#nkr_note_mod_0035044", "type": "mod", "text": "膩【大】，脂【宋】【元】【明】"}
{"id": null, "n": "0035045", "target": "#nkr_note_mod_0035045", "type": "mod", "text": "（此鬼…鬼）九字【大】，〔－〕【宋】【元】【明】"}
