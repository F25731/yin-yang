{"id": null, "n": "0315001", "target": "#nkr_note_orig_0315001", "type": "orig", "text": "「儀」，底、丙本無，據甲、乙本補。"}
{"id": null, "n": "0315002", "target": "#nkr_note_orig_0315002", "type": "orig", "text": "「隆興府百福院宗鏡禪師述」，底、乙、丙本無，據甲本補。"}
{"id": null, "n": "0315003", "target": "#nkr_note_orig_0315003", "type": "orig", "text": "「得」，甲、乙本無，丙本作「若」。"}
{"id": null, "n": "0315004", "target": "#nkr_note_orig_0315004", "type": "orig", "text": "「導」，底本作「身」，甲、乙本無，據丙本改。"}
{"id": null, "n": "0315005", "target": "#nkr_note_orig_0315005", "type": "orig", "text": "「歎」，甲、乙本無，丙本作「誦」。"}
{"id": null, "n": "0316001", "target": "#nkr_note_orig_0316001", "type": "orig", "text": "「䭾」，底本作「駛」，甲、乙本無，據丙本改。"}
{"id": null, "n": "0316002", "target": "#nkr_note_orig_0316002", "type": "orig", "text": "「蒙師已問」，甲、乙本無，丙本作「明師若問」。"}
{"id": null, "n": "0316003", "target": "#nkr_note_orig_0316003", "type": "orig", "text": "「眾等皈依……一卷經」，甲、乙本無。"}
{"id": null, "n": "0316004", "target": "#nkr_note_orig_0316004", "type": "orig", "text": "「恭白」，甲本作「某甲恭白」。"}
{"id": null, "n": "0316005", "target": "#nkr_note_orig_0316005", "type": "orig", "text": "「悲」，甲、乙本作「慈」。"}
{"id": null, "n": "0316006", "target": "#nkr_note_orig_0316006", "type": "orig", "text": "「悲」，甲、乙本無。"}
{"id": null, "n": "0317001", "target": "#nkr_note_orig_0317001", "type": "orig", "text": "「具」，乙本作「其」。"}
{"id": null, "n": "0317002", "target": "#nkr_note_orig_0317002", "type": "orig", "text": "「法眼」，乙本作「眼法」。"}
{"id": null, "n": "0317003", "target": "#nkr_note_orig_0317003", "type": "orig", "text": "甲本「略」字前有一「而」字。"}
{"id": null, "n": "0317004", "target": "#nkr_note_orig_0317004", "type": "orig", "text": "「咸」，底、丙本作「感」，據甲、乙本改。"}
{"id": null, "n": "0317005", "target": "#nkr_note_orig_0317005", "type": "orig", "text": "「有」，乙本「有」後另有「咦！將此身心奉塵剎，是則名為報佛恩。金剛寶卷纔展開，龍天八部降臨來。薦資亡者超昇去，現存人眷又消炎。謂其有說皆名謗，今日分疏謗更多。外護不忘親付囑，三千里外定聲訛。戒香、定香、解脫明香、解脫知見香、一辨信香，爇在爐上，香煙起處，遍滿十方。請諸佛菩薩，赴壇中受供養。拈起金剛正令，一句殞超千聖。揭開般若法門，智慧不離自性。」"}
{"id": null, "n": "0317006", "target": "#nkr_note_orig_0317006", "type": "orig", "text": "「關」，乙本作「開」。"}
{"id": null, "n": "0318001", "target": "#nkr_note_orig_0318001", "type": "orig", "text": "「邦」，底本作「宮」，據諸本改。"}
{"id": null, "n": "0318002", "target": "#nkr_note_orig_0318002", "type": "orig", "text": "「阿彌陀佛法中王……毫光接引」，甲本作「彌陀如來」，乙本作「彌陀如來，九品導師」。"}
{"id": null, "n": "0318003", "target": "#nkr_note_orig_0318003", "type": "orig", "text": "「盡」，底本作「進」，據諸本改。"}
{"id": null, "n": "0318004", "target": "#nkr_note_orig_0318004", "type": "orig", "text": "「為」，乙本作「無」。"}
{"id": null, "n": "0318005", "target": "#nkr_note_orig_0318005", "type": "orig", "text": "「宮」，甲、乙本無，丙本作「武」。"}
{"id": null, "n": "0318006", "target": "#nkr_note_orig_0318006", "type": "orig", "text": "「釋迦文佛大奇哉……證盟功德」，甲本作「釋迦如來」，乙本作「斯辰緣由，香煙起處云云。釋迦如來，證明功德」。"}
{"id": null, "n": "0318007", "target": "#nkr_note_orig_0318007", "type": "orig", "text": "「畢」，底、丙本作「必」，據甲、乙本改。"}
{"id": null, "n": "0319001", "target": "#nkr_note_orig_0319001", "type": "orig", "text": "「綠」，乙本作「緣」。"}
{"id": null, "n": "0319002", "target": "#nkr_note_orig_0319002", "type": "orig", "text": "「而」，底本無，據諸本補。"}
{"id": null, "n": "0319003", "target": "#nkr_note_orig_0319003", "type": "orig", "text": "「包」，乙本作「色」，丙本作「泡」。"}
{"id": null, "n": "0319004", "target": "#nkr_note_orig_0319004", "type": "orig", "text": "「來」，丙本作「明」。"}
{"id": null, "n": "0319005", "target": "#nkr_note_orig_0319005", "type": "orig", "text": "「祇」，底、甲本作「只」，據乙、丙本改。"}
{"id": null, "n": "0319006", "target": "#nkr_note_orig_0319006", "type": "orig", "text": "「欺」，乙本作「期」。"}
{"id": null, "n": "0319007", "target": "#nkr_note_orig_0319007", "type": "orig", "text": "「刀」，乙本作「力」。"}
{"id": null, "n": "0319008", "target": "#nkr_note_orig_0319008", "type": "orig", "text": "「銜」，甲本作「𠾑」，乙本作「御」，丙本作「啣」。"}
{"id": null, "n": "0319009", "target": "#nkr_note_orig_0319009", "type": "orig", "text": "「死」，底、甲、丙本作「活」，據乙本改。"}
{"id": null, "n": "0319010", "target": "#nkr_note_orig_0319010", "type": "orig", "text": "「惟」，底本作「微」，據諸本改。"}
{"id": null, "n": "0320001", "target": "#nkr_note_orig_0320001", "type": "orig", "text": "「終禮」，乙本作「禮終」。"}
{"id": null, "n": "0320002", "target": "#nkr_note_orig_0320002", "type": "orig", "text": "「花」，甲、乙本作「華」。"}
{"id": null, "n": "0320003", "target": "#nkr_note_orig_0320003", "type": "orig", "text": "「摩」，底、丙本作「麼」，甲本作「磨」，據乙本改。"}
{"id": null, "n": "0320004", "target": "#nkr_note_orig_0320004", "type": "orig", "text": "「隻」，甲、乙、丙本作「執」。"}
{"id": null, "n": "0320005", "target": "#nkr_note_orig_0320005", "type": "orig", "text": "「供」，丙本作「拱」。"}
{"id": null, "n": "0320006", "target": "#nkr_note_orig_0320006", "type": "orig", "text": "「頓」，甲、乙本作「領」。"}
{"id": null, "n": "0320007", "target": "#nkr_note_orig_0320007", "type": "orig", "text": "「辨」，底本作「辦」，據諸本改。"}
{"id": null, "n": "0320008", "target": "#nkr_note_orig_0320008", "type": "orig", "text": "「易」，底本作「異」，據諸本改。"}
{"id": null, "n": "0321001", "target": "#nkr_note_orig_0321001", "type": "orig", "text": "「沉」，乙本作「說」。"}
{"id": null, "n": "0321002", "target": "#nkr_note_orig_0321002", "type": "orig", "text": "「後」，乙本作「縱」。"}
{"id": null, "n": "0321003", "target": "#nkr_note_orig_0321003", "type": "orig", "text": "「事」，甲本作「是」。"}
{"id": null, "n": "0321004", "target": "#nkr_note_orig_0321004", "type": "orig", "text": "「道」，底本作「到」，據諸本改。"}
{"id": null, "n": "0321005", "target": "#nkr_note_orig_0321005", "type": "orig", "text": "「提」，底、甲本作「隄」，據乙、丙本改。"}
{"id": null, "n": "0321006", "target": "#nkr_note_orig_0321006", "type": "orig", "text": "「貧」，乙本作「貪」。"}
{"id": null, "n": "0321007", "target": "#nkr_note_orig_0321007", "type": "orig", "text": "「將欲誦經，先安」，乙本作「梵王帝釋，監壇」。"}
{"id": null, "n": "0321008", "target": "#nkr_note_orig_0321008", "type": "orig", "text": "「擁」，甲本作「永」。"}
{"id": null, "n": "0322001", "target": "#nkr_note_orig_0322001", "type": "orig", "text": "「《金剛經》啟請……常當擁護」，乙本無。"}
{"id": null, "n": "0322002", "target": "#nkr_note_orig_0322002", "type": "orig", "text": "「薩婆訶」，乙本作「薩婆訶。淨三業真言：唵。娑嚩婆嚩秫馱。娑嚩達摩娑。嚩娑嚩秫度憾。」"}
{"id": null, "n": "0322003", "target": "#nkr_note_orig_0322003", "type": "orig", "text": "「哆」，乙本作「多」。"}
{"id": null, "n": "0322004", "target": "#nkr_note_orig_0322004", "type": "orig", "text": "「喃」，乙本作「南」。"}
{"id": null, "n": "0322005", "target": "#nkr_note_orig_0322005", "type": "orig", "text": "「虛空藏菩薩」，甲、乙本無。"}
{"id": null, "n": "0322006", "target": "#nkr_note_orig_0322006", "type": "orig", "text": "甲本「囉斛」後依次接「請八金剛、請四菩薩、發愿文、云何梵、開經偈」。從法事程序來看，在次序上有誤。"}
{"id": null, "n": "0322007", "target": "#nkr_note_orig_0322007", "type": "orig", "text": "「恭」，乙本作「蓋」。"}
{"id": null, "n": "0322008", "target": "#nkr_note_orig_0322008", "type": "orig", "text": "「低」，底、丙本作「抵」，據甲、乙本改。"}
{"id": null, "n": "0322009", "target": "#nkr_note_orig_0322009", "type": "orig", "text": "「久」，乙本作「少」。"}
{"id": null, "n": "0322010", "target": "#nkr_note_orig_0322010", "type": "orig", "text": "「關」，丙本作「觀」。"}
{"id": null, "n": "0323001", "target": "#nkr_note_orig_0323001", "type": "orig", "text": "「魔」，乙本作「摩」。"}
{"id": null, "n": "0323002", "target": "#nkr_note_orig_0323002", "type": "orig", "text": "「今」，乙本作「令」。"}
{"id": null, "n": "0323003", "target": "#nkr_note_orig_0323003", "type": "orig", "text": "「六朝翻譯……四句」，乙本無。"}
{"id": null, "n": "0323004", "target": "#nkr_note_orig_0323004", "type": "orig", "text": "「奉請八金剛至四菩薩」，甲本無，乙本作「請八金剛，請四菩薩」。"}
{"id": null, "n": "0323005", "target": "#nkr_note_orig_0323005", "type": "orig", "text": "「教」，乙本無。"}
{"id": null, "n": "0324001", "target": "#nkr_note_orig_0324001", "type": "orig", "text": "「間」，乙本作「問」。"}
{"id": null, "n": "0324002", "target": "#nkr_note_orig_0324002", "type": "orig", "text": "「花」，甲、乙本作「華」。"}
{"id": null, "n": "0324003", "target": "#nkr_note_orig_0324003", "type": "orig", "text": "「發願文……云何梵」，甲本無。"}
{"id": null, "n": "0324004", "target": "#nkr_note_orig_0324004", "type": "orig", "text": "「置」，底本無，據諸本補。"}
{"id": null, "n": "0325001", "target": "#nkr_note_orig_0325001", "type": "orig", "text": "「旨」，底本作「指」，據諸本改。"}
{"id": null, "n": "0325002", "target": "#nkr_note_orig_0325002", "type": "orig", "text": "「花」，甲、乙本作「華」。"}
{"id": null, "n": "0325003", "target": "#nkr_note_orig_0325003", "type": "orig", "text": "「發」，丙本作「開」。"}
{"id": null, "n": "0325004", "target": "#nkr_note_orig_0325004", "type": "orig", "text": "「持」，底本作「行」，據諸本改。"}
{"id": null, "n": "0325005", "target": "#nkr_note_orig_0325005", "type": "orig", "text": "「念」，丙本作「願」。"}
{"id": null, "n": "0325006", "target": "#nkr_note_orig_0325006", "type": "orig", "text": "「宣」，乙本作「在」。"}
{"id": null, "n": "0325007", "target": "#nkr_note_orig_0325007", "type": "orig", "text": "「然」，乙本作「禪」。"}
{"id": null, "n": "0326001", "target": "#nkr_note_orig_0326001", "type": "orig", "text": "「法會因由分第一」，乙本無。"}
{"id": null, "n": "0326002", "target": "#nkr_note_orig_0326002", "type": "orig", "text": "「息」，底本作「夕」，據諸本改。"}
{"id": null, "n": "0326003", "target": "#nkr_note_orig_0326003", "type": "orig", "text": "「疑」，底本作「凝」，據諸本改。"}
{"id": null, "n": "0326004", "target": "#nkr_note_orig_0326004", "type": "orig", "text": "「仔」，乙本作「子」。"}
{"id": null, "n": "0326005", "target": "#nkr_note_orig_0326005", "type": "orig", "text": "「冰」，乙本作「永」。"}
{"id": null, "n": "0326006", "target": "#nkr_note_orig_0326006", "type": "orig", "text": "「花」，乙本作「華」。"}
{"id": null, "n": "0326007", "target": "#nkr_note_orig_0326007", "type": "orig", "text": "「請問」，乙本作「問我」。"}
{"id": null, "n": "0327001", "target": "#nkr_note_orig_0327001", "type": "orig", "text": "「啟」，乙本作「起」。"}
{"id": null, "n": "0327002", "target": "#nkr_note_orig_0327002", "type": "orig", "text": "「憐」，乙本作「憫」。"}
{"id": null, "n": "0327003", "target": "#nkr_note_orig_0327003", "type": "orig", "text": "「決」，底本作「快」，據諸本改。"}
{"id": null, "n": "0327004", "target": "#nkr_note_orig_0327004", "type": "orig", "text": "「扁」，乙本作「偏」。"}
{"id": null, "n": "0327005", "target": "#nkr_note_orig_0327005", "type": "orig", "text": "「潞」，乙、丙本作「路」。"}
{"id": null, "n": "0327006", "target": "#nkr_note_orig_0327006", "type": "orig", "text": "「人」，底本作「賢」，據諸本改。"}
{"id": null, "n": "0327007", "target": "#nkr_note_orig_0327007", "type": "orig", "text": "「起」，底本作「啟」，據諸本改。"}
{"id": null, "n": "0328001", "target": "#nkr_note_orig_0328001", "type": "orig", "text": "「殼」，底本作「卻」，據諸本改。"}
{"id": null, "n": "0328002", "target": "#nkr_note_orig_0328002", "type": "orig", "text": "「辨」，底本、乙本作「辯」，據甲、丙本改。"}
{"id": null, "n": "0328003", "target": "#nkr_note_orig_0328003", "type": "orig", "text": "「花」，乙本作「華」。"}
{"id": null, "n": "0328004", "target": "#nkr_note_orig_0328004", "type": "orig", "text": "「光歸」，乙本作「歸光」。"}
{"id": null, "n": "0328005", "target": "#nkr_note_orig_0328005", "type": "orig", "text": "「受」，丙本作「授」。"}
{"id": null, "n": "0328006", "target": "#nkr_note_orig_0328006", "type": "orig", "text": "「蹤」，乙本作「縱」。"}
{"id": null, "n": "0329001", "target": "#nkr_note_orig_0329001", "type": "orig", "text": "「雖然」，甲、乙本作「然雖」。"}
{"id": null, "n": "0329002", "target": "#nkr_note_orig_0329002", "type": "orig", "text": "「何」，乙本作「何處」。"}
{"id": null, "n": "0329003", "target": "#nkr_note_orig_0329003", "type": "orig", "text": "「妄」，丙本作「萬」。"}
{"id": null, "n": "0329004", "target": "#nkr_note_orig_0329004", "type": "orig", "text": "「首」，底本作「手」，據諸本改。"}
{"id": null, "n": "0330001", "target": "#nkr_note_orig_0330001", "type": "orig", "text": "「內」，甲、乙本無。"}
{"id": null, "n": "0330002", "target": "#nkr_note_orig_0330002", "type": "orig", "text": "「若」，底本作「然」，據諸本改。"}
{"id": null, "n": "0330003", "target": "#nkr_note_orig_0330003", "type": "orig", "text": "「花」，甲、乙本作「華」。"}
{"id": null, "n": "0330004", "target": "#nkr_note_orig_0330004", "type": "orig", "text": "「疑」，底本作「凝」，據諸本改。"}
{"id": null, "n": "0330005", "target": "#nkr_note_orig_0330005", "type": "orig", "text": "「捨」，乙本作「舍」。"}
{"id": null, "n": "0330006", "target": "#nkr_note_orig_0330006", "type": "orig", "text": "「度」，丙本作「渡」。"}
{"id": null, "n": "0331001", "target": "#nkr_note_orig_0331001", "type": "orig", "text": "「機」，底本作「幾」，據諸本改。"}
