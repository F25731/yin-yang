{"id": null, "n": "0250001", "target": "#nkr_note_mod_0250001", "type": "mod", "text": "佛說尸迦羅越六方禮經【大】，佛說尸迦羅越六方禮經長阿含善生經別譯【明】，（長阿含善生經別譯）八字【宋】【元】俱在譯號下"}
{"id": null, "n": "0250002", "target": "#nkr_note_mod_0250002", "type": "mod", "text": "安息國三藏【大】，沙門【宋】【元】【明】"}
{"id": null, "n": "0250003", "target": "#nkr_note_mod_0250003", "type": "mod", "text": "向天【大】，仰向【宋】【元】【明】"}
{"id": null, "n": "0251001", "target": "#nkr_note_mod_0251001", "type": "mod", "text": "其征彸【大】，甚怔忪【宋】【元】【明】"}
{"id": null, "n": "0251002", "target": "#nkr_note_mod_0251002", "type": "mod", "text": "當【大】＊，常【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0251003", "target": "#nkr_note_mod_0251003", "type": "mod", "text": "善【大】，言【宋】【元】"}
{"id": null, "n": "0251004", "target": "#nkr_note_mod_0251004", "type": "mod", "text": "卒【大】，悴【宋】【元】【明】"}
{"id": null, "n": "0251005", "target": "#nkr_note_mod_0251005", "type": "mod", "text": "斂【大】，殮【明】"}
{"id": null, "n": "0251006", "target": "#nkr_note_mod_0251006", "type": "mod", "text": "書【大】，盡【宋】"}
{"id": null, "n": "0251007", "target": "#nkr_note_mod_0251007", "type": "mod", "text": "謂【大】，諸【宋】【元】【明】"}
{"id": null, "n": "0251008", "target": "#nkr_note_mod_0251008", "type": "mod", "text": "難【大】＊，歎【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0251009", "target": "#nkr_note_mod_0251009", "type": "mod", "text": "盖【大】，善【宋】【元】【明】"}
{"id": null, "n": "0251010", "target": "#nkr_note_mod_0251010", "type": "mod", "text": "傳【大】，傅【明】"}
{"id": null, "n": "0251011", "target": "#nkr_note_mod_0251011", "type": "mod", "text": "北【大】，比【宋】"}
{"id": null, "n": "0251012", "target": "#nkr_note_mod_0251012", "type": "mod", "text": "視【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0251013", "target": "#nkr_note_mod_0251013", "type": "mod", "text": "意【大】，憶【宋】【元】【明】"}
{"id": null, "n": "0251014", "target": "#nkr_note_mod_0251014", "type": "mod", "text": "色【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0251015", "target": "#nkr_note_mod_0251015", "type": "mod", "text": "知【大】，如【宋】【元】【明】"}
{"id": null, "n": "0251016", "target": "#nkr_note_mod_0251016", "type": "mod", "text": "著【大】，者【宋】【元】【明】"}
{"id": null, "n": "0251017", "target": "#nkr_note_mod_0251017", "type": "mod", "text": "自【大】，有【元】【明】"}
{"id": null, "n": "0252001", "target": "#nkr_note_mod_0252001", "type": "mod", "text": "命【大】，今【宋】【元】【明】"}
{"id": null, "n": "0250001", "target": "#nkr_note_orig_0250001", "type": "orig", "text": "佛說…經＋（長阿含善生經別譯）八字【明】，其八字【宋】【元】俱在譯號下"}
