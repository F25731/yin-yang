{"id": null, "n": null, "target": null, "type": null, "text": "音釋河河也飢須留"}
{"id": null, "n": null, "target": null, "type": null, "text": "善也"}
{"id": null, "n": null, "target": null, "type": null, "text": "實也"}
{"id": null, "n": null, "target": null, "type": null, "text": "衣良布"}
{"id": null, "n": null, "target": null, "type": null, "text": "可爾反"}
{"id": null, "n": null, "target": null, "type": null, "text": "四姓\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "妓伊反乃留"}
{"id": null, "n": null, "target": null, "type": null, "text": "婆句反川萬太久"}
{"id": null, "n": null, "target": null, "type": null, "text": "許其反"}
{"id": null, "n": null, "target": null, "type": null, "text": "鬼爾反"}
{"id": null, "n": null, "target": null, "type": null, "text": "知益反止良加須"}
{"id": null, "n": null, "target": null, "type": null, "text": "須留"}
{"id": null, "n": null, "target": null, "type": null, "text": "志憶反川波久"}
{"id": null, "n": null, "target": null, "type": null, "text": "梵語，此云壇也"}
{"id": null, "n": null, "target": null, "type": null, "text": "波伊反川於布毛乃"}
{"id": null, "n": null, "target": null, "type": null, "text": "布久無"}
{"id": null, "n": null, "target": null, "type": null, "text": "梵語，此云相應"}
{"id": null, "n": null, "target": null, "type": null, "text": "果和反奈太良爾"}
{"id": null, "n": null, "target": null, "type": null, "text": "祖波無"}
{"id": null, "n": null, "target": null, "type": null, "text": "於須"}
{"id": null, "n": null, "target": null, "type": null, "text": "上止加利，下止\n志"}
{"id": null, "n": null, "target": null, "type": null, "text": "上白也"}
{"id": null, "n": null, "target": null, "type": null, "text": "於保由比"}
{"id": null, "n": null, "target": null, "type": null, "text": "左左布"}
{"id": null, "n": null, "target": null, "type": null, "text": "能也"}
{"id": null, "n": null, "target": null, "type": null, "text": "比太比音加久反"}
{"id": null, "n": null, "target": null, "type": null, "text": "太布\n左江牟反"}
{"id": null, "n": null, "target": null, "type": null, "text": "布都毛毛"}
{"id": null, "n": null, "target": null, "type": null, "text": "千奈久保"}
{"id": null, "n": null, "target": null, "type": null, "text": "毛毛"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿左布"}
{"id": null, "n": null, "target": null, "type": null, "text": "比左"}
{"id": null, "n": null, "target": null, "type": null, "text": "口也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此云成就"}
{"id": null, "n": null, "target": null, "type": null, "text": "左爾反川加左"}
{"id": null, "n": null, "target": null, "type": null, "text": "上禪反下捐反太乎也加奈留狀也"}
{"id": null, "n": null, "target": null, "type": null, "text": "甚也"}
{"id": null, "n": null, "target": null, "type": null, "text": "志良部"}
{"id": null, "n": null, "target": null, "type": null, "text": "奈止止"}
{"id": null, "n": null, "target": null, "type": null, "text": "無也"}
{"id": null, "n": null, "target": null, "type": null, "text": "和加奴"}
{"id": null, "n": null, "target": null, "type": null, "text": "取也"}
{"id": null, "n": null, "target": null, "type": null, "text": "猶也"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒬反阿太"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿志太"}
{"id": null, "n": null, "target": null, "type": null, "text": "馬時"}
{"id": null, "n": null, "target": null, "type": null, "text": "由布戶"}
{"id": null, "n": null, "target": null, "type": null, "text": "油布戶"}
{"id": null, "n": null, "target": null, "type": null, "text": "毛江久比"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿萬子久"}
{"id": null, "n": null, "target": null, "type": null, "text": "於久"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿奈久留"}
{"id": null, "n": null, "target": null, "type": null, "text": "左加布"}
{"id": null, "n": null, "target": null, "type": null, "text": "保祖"}
{"id": null, "n": null, "target": null, "type": null, "text": "鄙列反"}
{"id": null, "n": null, "target": null, "type": null, "text": "保沒反"}
{"id": null, "n": null, "target": null, "type": null, "text": "川伊久左"}
{"id": null, "n": null, "target": null, "type": null, "text": "音水\n伊川伊久左公"}
{"id": null, "n": null, "target": null, "type": null, "text": "以土高作，此云臺"}
{"id": null, "n": null, "target": null, "type": null, "text": "以木高搆云爾"}
{"id": null, "n": null, "target": null, "type": null, "text": "與祖比"}
{"id": null, "n": null, "target": null, "type": null, "text": "所謂以􆿁字，手三遍、舌三遍、心密三遍誦了"}
{"id": null, "n": null, "target": null, "type": null, "text": "立右足誦云"}
{"id": null, "n": null, "target": null, "type": null, "text": "又名一字頂輪密言"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名御身密言"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂頂輪印，又加此作御身印。雖爾，先作本言印"}
{"id": null, "n": null, "target": null, "type": null, "text": "各以二印印四處"}
{"id": null, "n": null, "target": null, "type": null, "text": "重加三字\n加持"}
{"id": null, "n": null, "target": null, "type": null, "text": "印言數如前二十一遍"}
{"id": null, "n": null, "target": null, "type": null, "text": "但一遍左旋解之"}
{"id": null, "n": null, "target": null, "type": null, "text": "數如前"}
