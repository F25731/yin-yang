{"id": null, "n": "0327006", "target": "#nkr_note_mod_0327006", "type": "mod", "text": "讚【大】，贊【校異-原】"}
{"id": null, "n": "0327007", "target": "#nkr_note_mod_0327007", "type": "mod", "text": "佛【大】，佛顯勝【考偽-原】"}
