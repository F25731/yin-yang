{"id": null, "n": "0950005", "target": "#nkr_note_mod_0950005", "type": "mod", "text": "後魏中印度三藏【大】，元魏婆羅門【宋】【元】【明】【宮】"}
{"id": null, "n": "0950006", "target": "#nkr_note_mod_0950006", "type": "mod", "text": "心【大】，以【宋】【元】【明】【宮】"}
{"id": null, "n": "0950007", "target": "#nkr_note_mod_0950007", "type": "mod", "text": "耶【大】，也【宋】【宮】"}
{"id": null, "n": "0950008", "target": "#nkr_note_mod_0950008", "type": "mod", "text": "圓【大】，員【宮】"}
{"id": null, "n": "0951001", "target": "#nkr_note_mod_0951001", "type": "mod", "text": "炎【大】，焰【宋】【元】【明】【宮】"}
{"id": null, "n": "0950005", "target": "#nkr_note_orig_0950005", "type": "orig", "text": "後魏中印度三藏＝元魏婆羅門【三】【宮】"}
{"id": null, "n": "0950006", "target": "#nkr_note_orig_0950006", "type": "orig", "text": "心＝以【三】【宮】"}
{"id": null, "n": "0950007", "target": "#nkr_note_orig_0950007", "type": "orig", "text": "耶＝也【宋】【宮】"}
{"id": null, "n": "0950008", "target": "#nkr_note_orig_0950008", "type": "orig", "text": "圓＝員【宮】"}
{"id": null, "n": "0951001", "target": "#nkr_note_orig_0951001", "type": "orig", "text": "炎＝焰【三】【宮】"}
