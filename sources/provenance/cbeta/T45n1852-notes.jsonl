{"id": null, "n": "0003002", "target": "#nkr_note_mod_0003002", "type": "mod", "text": "犍【大】，揵【甲】"}
{"id": null, "n": "0003003", "target": "#nkr_note_mod_0003003", "type": "mod", "text": "亡【大】＊，忘【甲】＊"}
{"id": null, "n": "0003004", "target": "#nkr_note_mod_0003004", "type": "mod", "text": "舊序證第一【大】，〔－〕【甲】"}
{"id": null, "n": "0004001", "target": "#nkr_note_mod_0004001", "type": "mod", "text": "般【大】下同，波【甲】下同"}
