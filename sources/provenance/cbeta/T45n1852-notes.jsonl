{"id": null, "n": "0005002", "target": "#nkr_note_mod_0005002", "type": "mod", "text": "忘【大】＊，亡【校異-原】＊"}
{"id": null, "n": "0005003", "target": "#nkr_note_mod_0005003", "type": "mod", "text": "密【大】，察【校異-原】"}
{"id": null, "n": "0006001", "target": "#nkr_note_mod_0006001", "type": "mod", "text": "國【大】，國一國【考偽-原】"}
{"id": null, "n": "0007001", "target": "#nkr_note_mod_0007001", "type": "mod", "text": "有【大】，在【甲】"}
{"id": null, "n": "0007002", "target": "#nkr_note_mod_0007002", "type": "mod", "text": "令【大】，合【甲】"}
{"id": null, "n": "0008001", "target": "#nkr_note_mod_0008001", "type": "mod", "text": "上【大】，上座【校異-原】"}
{"id": null, "n": "0008002", "target": "#nkr_note_mod_0008002", "type": "mod", "text": "私【大】，移【甲】"}
