{"id": null, "n": null, "target": null, "type": null, "text": "隨戒師三徧唱念。"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "一說"}
{"id": null, "n": null, "target": null, "type": null, "text": "隨戒師口高聲\n導，遇某甲處，各自稱名"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "一說"}
{"id": null, "n": null, "target": null, "type": null, "text": "三字三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "答：能。向下依此。"}
{"id": null, "n": null, "target": null, "type": null, "text": "如是問竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "應教懺悔三業語云："}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "答云：無。向下依此答。"}
{"id": null, "n": null, "target": null, "type": null, "text": "請諸俗弟子，若男若女，起披袈裟，大有因果。更不具述，臨時為\n說也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔既緣覺為發戒〕"}
{"id": null, "n": null, "target": null, "type": null, "text": "次秉法者，白三羯磨，應語云："}
{"id": null, "n": null, "target": null, "type": null, "text": "至"}
{"id": null, "n": null, "target": null, "type": null, "text": "至"}
{"id": null, "n": null, "target": null, "type": null, "text": "答云：能持。向下依此。"}
{"id": null, "n": null, "target": null, "type": null, "text": "請戒師為受戒者作白云："}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": "0350001", "target": "#nkr_note_orig_0350001", "type": "orig", "text": "亡疑忘"}
{"id": null, "n": "0350002", "target": "#nkr_note_orig_0350002", "type": "orig", "text": "疾一作速"}
{"id": null, "n": "0350003", "target": "#nkr_note_orig_0350003", "type": "orig", "text": "破下一有故字"}
{"id": null, "n": "0351001", "target": "#nkr_note_orig_0351001", "type": "orig", "text": "薩下疑脫戒字"}
{"id": null, "n": "0351002", "target": "#nkr_note_orig_0351002", "type": "orig", "text": "沾一作霑下同"}
{"id": null, "n": "0351003", "target": "#nkr_note_orig_0351003", "type": "orig", "text": "授恐受"}
{"id": null, "n": "0352001", "target": "#nkr_note_orig_0352001", "type": "orig", "text": "於一作于"}
{"id": null, "n": "0352002", "target": "#nkr_note_orig_0352002", "type": "orig", "text": "既等六字一作大書"}
{"id": null, "n": "0352003", "target": "#nkr_note_orig_0352003", "type": "orig", "text": "即今疑寫倒"}
{"id": null, "n": "0352004", "target": "#nkr_note_orig_0352004", "type": "orig", "text": "受疑授"}
{"id": null, "n": "0352005", "target": "#nkr_note_orig_0352005", "type": "orig", "text": "慾一作欲"}
{"id": null, "n": "0352006", "target": "#nkr_note_orig_0352006", "type": "orig", "text": "導一作道"}
{"id": null, "n": "0353001", "target": "#nkr_note_orig_0353001", "type": "orig", "text": "此一作是"}
{"id": null, "n": "0353002", "target": "#nkr_note_orig_0353002", "type": "orig", "text": "即下有是字"}
{"id": null, "n": "0353003", "target": "#nkr_note_orig_0353003", "type": "orig", "text": "戒下一有不得二字"}
{"id": null, "n": "0353004", "target": "#nkr_note_orig_0353004", "type": "orig", "text": "及下一有作字"}
{"id": null, "n": "0353005", "target": "#nkr_note_orig_0353005", "type": "orig", "text": "大元一作某"}
{"id": null, "n": "0353006", "target": "#nkr_note_orig_0353006", "type": "orig", "text": "欲一作歎"}
{"id": null, "n": "0353007", "target": "#nkr_note_orig_0353007", "type": "orig", "text": "無上一有十字"}
{"id": null, "n": "0353008", "target": "#nkr_note_orig_0353008", "type": "orig", "text": "然一作竝"}
{"id": null, "n": "0353009", "target": "#nkr_note_orig_0353009", "type": "orig", "text": "八上一本有三塗二字"}
{"id": null, "n": "0353010", "target": "#nkr_note_orig_0353010", "type": "orig", "text": "應一作忘"}
{"id": null, "n": "0354001", "target": "#nkr_note_orig_0354001", "type": "orig", "text": "子一作女"}
