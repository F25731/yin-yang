{"id": null, "n": "0726002", "target": "#nkr_note_mod_0726002", "type": "mod", "text": "佛說【大】＊，〔－〕【縮】＊"}
{"id": null, "n": "0726003", "target": "#nkr_note_mod_0726003", "type": "mod", "text": "木槵子【大】＊，木槵【宋】【元】【明】【縮】＊，木患【宮】＊"}
{"id": null, "n": "0726004", "target": "#nkr_note_mod_0726004", "type": "mod", "text": "子【大】，〔－〕【和】【縮】"}
{"id": null, "n": "0726005", "target": "#nkr_note_mod_0726005", "type": "mod", "text": "（失譯…晉錄）八字【大】，大興善寺三藏沙門大廣智不空奉詔譯【和】【縮】"}
{"id": null, "n": "0726006", "target": "#nkr_note_mod_0726006", "type": "mod", "text": "人【大】，〔－〕【宋】【元】，人名【明】"}
{"id": null, "n": "0726007", "target": "#nkr_note_mod_0726007", "type": "mod", "text": "聞如是【大】，聞如是我聞【和】，如是我聞【縮】"}
{"id": null, "n": "0726008", "target": "#nkr_note_mod_0726008", "type": "mod", "text": "耆闍【CB】【麗-CB】，闍耆【大】，闍【和】，嗜闍【縮】"}
{"id": null, "n": "0726009", "target": "#nkr_note_mod_0726009", "type": "mod", "text": "天人【大】，人天【縮】"}
{"id": null, "n": "0726010", "target": "#nkr_note_mod_0726010", "type": "mod", "text": "波流離【大】，波瑠璃【宋】【元】【明】【宮】，波琉璃【和】，波瑠璃遣【縮】"}
{"id": null, "n": "0726011", "target": "#nkr_note_mod_0726011", "type": "mod", "text": "小【大】，少【縮】"}
{"id": null, "n": "0726012", "target": "#nkr_note_mod_0726012", "type": "mod", "text": "歲【大】，年【縮】"}
{"id": null, "n": "0726013", "target": "#nkr_note_mod_0726013", "type": "mod", "text": "勇【大】，踴【縮】"}
{"id": null, "n": "0726014", "target": "#nkr_note_mod_0726014", "type": "mod", "text": "疾病【大】，疫疾【宋】【元】【明】【宮】，疾疫【和】【縮】"}
{"id": null, "n": "0726015", "target": "#nkr_note_mod_0726015", "type": "mod", "text": "憂務【大】，憂勞【宮】"}
{"id": null, "n": "0726016", "target": "#nkr_note_mod_0726016", "type": "mod", "text": "慈愍【大】，矜愍【宋】【元】【明】【宮】【和】，㥤愍【縮】"}
{"id": null, "n": "0726017", "target": "#nkr_note_mod_0726017", "type": "mod", "text": "要法【大】，法要【縮】"}
{"id": null, "n": "0726018", "target": "#nkr_note_mod_0726018", "type": "mod", "text": "木槵【大】下同，木患【宮】下同"}
