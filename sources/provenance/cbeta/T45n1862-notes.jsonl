{"id": null, "n": null, "target": null, "type": null, "text": "瑜伽四十四"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘煩不述。更檢文"}
{"id": null, "n": null, "target": null, "type": null, "text": "此次三門如《法華．安樂品》"}
{"id": null, "n": null, "target": null, "type": null, "text": "此三流至下諸門"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
