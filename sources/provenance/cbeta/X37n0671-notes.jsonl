{"id": null, "n": null, "target": null, "type": null, "text": "迦旃延尊者答也"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名\n阿育，此云無憂"}
{"id": null, "n": null, "target": null, "type": null, "text": "此云除憂"}
{"id": null, "n": null, "target": null, "type": null, "text": "文"}
