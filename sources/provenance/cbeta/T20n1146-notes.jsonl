{"id": null, "n": "0603042", "target": "#nkr_note_mod_0603042", "type": "mod", "text": "引【大】，〔－〕【丁】"}
{"id": null, "n": "0603043", "target": "#nkr_note_mod_0603043", "type": "mod", "text": "二合引【大】＊，〔－〕【甲】＊"}
{"id": null, "n": "0603044", "target": "#nkr_note_mod_0603044", "type": "mod", "text": "吒【大】，荼【丙】【丁】"}
{"id": null, "n": "0603045", "target": "#nkr_note_mod_0603045", "type": "mod", "text": "頭【大】，〔－〕【甲】"}
{"id": null, "n": "0603046", "target": "#nkr_note_mod_0603046", "type": "mod", "text": "股【大】，鈷【宋】"}
{"id": null, "n": "0604001", "target": "#nkr_note_mod_0604001", "type": "mod", "text": "姹【大】＊，吒【甲】【丁】＊"}
{"id": null, "n": "0604002", "target": "#nkr_note_mod_0604002", "type": "mod", "text": "密【大】，蜜【宋】【元】"}
