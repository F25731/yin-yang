{"id": null, "n": "0603005", "target": "#nkr_note_mod_0603005", "type": "mod", "text": "開府儀同三司特進試鴻臚卿肅國公食邑三千戶賜紫贈司空諡大鑒正號大廣智大興善寺【大】，唐【明】【乙】，大興善寺【宋】【元】【甲】【丙】【丁】"}
{"id": null, "n": "0603006", "target": "#nkr_note_mod_0603006", "type": "mod", "text": "門【大】，門大廣智【宋】【元】【明】【甲】【乙】【丙】【丁】"}
{"id": null, "n": "0603007", "target": "#nkr_note_mod_0603007", "type": "mod", "text": "山【大】，出【宋】【元】【明】【甲】【乙】【丙】【丁】"}
{"id": null, "n": "0603008", "target": "#nkr_note_mod_0603008", "type": "mod", "text": "世【大】，世間【宋】【元】【明】【甲】【乙】【丙】【丁】"}
{"id": null, "n": "0603009", "target": "#nkr_note_mod_0603009", "type": "mod", "text": "尚【大】，當【丁】"}
{"id": null, "n": "0603010", "target": "#nkr_note_mod_0603010", "type": "mod", "text": "行【大】，持【宋】【元】【明】【甲】【乙】【丙】"}
{"id": null, "n": "0603011", "target": "#nkr_note_mod_0603011", "type": "mod", "text": "應【大】，〔－〕【甲】"}
{"id": null, "n": "0603012", "target": "#nkr_note_mod_0603012", "type": "mod", "text": "入【大】，〔－〕【甲】【丙】"}
{"id": null, "n": "0603013", "target": "#nkr_note_mod_0603013", "type": "mod", "text": "前【大】，〔－〕【甲】【丙】【丁】"}
{"id": null, "n": "0603014", "target": "#nkr_note_mod_0603014", "type": "mod", "text": "精室【大】，〔－〕【丙】"}
{"id": null, "n": "0603015", "target": "#nkr_note_mod_0603015", "type": "mod", "text": "茶【大】＊，荼【宋】【元】【明】【甲】【乙】【丙】＊"}
{"id": null, "n": "0603016", "target": "#nkr_note_mod_0603016", "type": "mod", "text": "於【大】，〔－〕【宋】【元】【明】【乙】【丙】【丁】"}
{"id": null, "n": "0603017", "target": "#nkr_note_mod_0603017", "type": "mod", "text": "辦【大】，辨【宋】"}
{"id": null, "n": "0603018", "target": "#nkr_note_mod_0603018", "type": "mod", "text": "跏【大】，加【宋】【元】"}
{"id": null, "n": "0603019", "target": "#nkr_note_mod_0603019", "type": "mod", "text": "跏【大】，加趺【宋】【元】，趺跏【明】【乙】，跏坐【丙】，跏趺【丁】"}
{"id": null, "n": "0603020", "target": "#nkr_note_mod_0603020", "type": "mod", "text": "用【大】，〔－〕【丁】"}
{"id": null, "n": "0603021", "target": "#nkr_note_mod_0603021", "type": "mod", "text": "未敷蓮華【大】，來敷花【丁】"}
{"id": null, "n": "0603022", "target": "#nkr_note_mod_0603022", "type": "mod", "text": "唵【大】，唵一【丁】"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": "0603023", "target": "#nkr_note_mod_0603023", "type": "mod", "text": "入【大】，入聲【明】【乙】"}
{"id": null, "n": "0603024", "target": "#nkr_note_mod_0603024", "type": "mod", "text": "引【大】＊，〔－〕【甲】【丙】【丁】＊"}
{"id": null, "n": "0603025", "target": "#nkr_note_mod_0603025", "type": "mod", "text": "掌【大】，掌中【丙】"}
{"id": null, "n": "0603026", "target": "#nkr_note_mod_0603026", "type": "mod", "text": "印【大】，即【宋】【元】【明】【乙】【丙】【丁】"}
{"id": null, "n": "0603027", "target": "#nkr_note_mod_0603027", "type": "mod", "text": "上【大】，〔－〕【宋】【元】【明】【甲】【乙】【丙】【丁】"}
{"id": null, "n": "0603028", "target": "#nkr_note_mod_0603028", "type": "mod", "text": "去【大】＊，去聲【明】【乙】＊，去引【丁】"}
{"id": null, "n": "0603029", "target": "#nkr_note_mod_0603029", "type": "mod", "text": "音【大】＊，音呼【宋】【元】【明】【乙】＊，〔－〕【丁】"}
{"id": null, "n": "0603030", "target": "#nkr_note_mod_0603030", "type": "mod", "text": "賀【大】，賀引【宋】【元】【明】【乙】"}
{"id": null, "n": "0603031", "target": "#nkr_note_mod_0603031", "type": "mod", "text": "橫【大】，撗【宋】【元】【丙】"}
{"id": null, "n": "0603032", "target": "#nkr_note_mod_0603032", "type": "mod", "text": "戒檀【大】，檀戒【宋】【元】【明】【乙】"}
{"id": null, "n": "0603033", "target": "#nkr_note_mod_0603033", "type": "mod", "text": "右肩左肩【大】，左右肩【丁】"}
{"id": null, "n": "0603034", "target": "#nkr_note_mod_0603034", "type": "mod", "text": "肩左【大】，右【甲】"}
{"id": null, "n": "0603035", "target": "#nkr_note_mod_0603035", "type": "mod", "text": "羅【大】，囉【明】【乙】【丁】"}
{"id": null, "n": "0603036", "target": "#nkr_note_mod_0603036", "type": "mod", "text": "印【大】，耶【明】【乙】"}
