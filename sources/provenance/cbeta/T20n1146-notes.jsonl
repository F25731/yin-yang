{"id": null, "n": "0604014", "target": "#nkr_note_mod_0604014", "type": "mod", "text": "去【大】，〔－〕【宋】【元】【明】【甲】【乙】【丙】【丁】"}
{"id": null, "n": "0604015", "target": "#nkr_note_mod_0604015", "type": "mod", "text": "引【大】，〔－〕【宋】【元】【明】【乙】【丁】"}
