{"id": null, "n": null, "target": null, "type": null, "text": "正報即自身，依報即所住屋宅"}
{"id": null, "n": null, "target": null, "type": null, "text": "如海一滴，味具百川"}
{"id": null, "n": null, "target": null, "type": null, "text": "一尺之鏡，現千重影"}
{"id": null, "n": null, "target": null, "type": null, "text": "一室之燈，光光涉入"}
{"id": null, "n": null, "target": null, "type": null, "text": "如金與色，二不\n相離"}
{"id": null, "n": null, "target": null, "type": null, "text": "片月澄空，晦明相並"}
{"id": null, "n": null, "target": null, "type": null, "text": "如琉璃瓶，盛多芥子"}
{"id": null, "n": null, "target": null, "type": null, "text": "兩鏡互照，傳輝相瀉"}
{"id": null, "n": null, "target": null, "type": null, "text": "立像竪臂，觸目皆道"}
{"id": null, "n": null, "target": null, "type": null, "text": "一夕之夢，翱翔\n百年"}
{"id": null, "n": null, "target": null, "type": null, "text": "北辰所居，眾星皆拱"}
{"id": null, "n": null, "target": null, "type": null, "text": "諸佛菩薩"}
{"id": null, "n": null, "target": null, "type": null, "text": "凡夫一身之上有我法二執"}
{"id": null, "n": null, "target": null, "type": null, "text": "理法界"}
{"id": null, "n": null, "target": null, "type": null, "text": "事法界、理事無礙法界、事事無\n礙法界"}
{"id": null, "n": null, "target": null, "type": null, "text": "此經普賢\n為長子，文殊為幼男"}
{"id": null, "n": null, "target": null, "type": null, "text": "此二品乃佛親證法門"}
{"id": null, "n": null, "target": null, "type": null, "text": "南即虛明之地，乃自己也"}
{"id": null, "n": null, "target": null, "type": null, "text": "當發心住"}
{"id": null, "n": null, "target": null, "type": null, "text": "善財得普見法門"}
{"id": null, "n": null, "target": null, "type": null, "text": "表法無所住"}
{"id": null, "n": null, "target": null, "type": null, "text": "表不離當處"}
{"id": null, "n": null, "target": null, "type": null, "text": "表攝用歸體，又表理絕門戶"}
{"id": null, "n": null, "target": null, "type": null, "text": "初悟似有能所證，悟了能所俱亡"}
{"id": null, "n": "0567001", "target": "#nkr_note_orig_0567001", "type": "orig", "text": "門疑聞"}
{"id": null, "n": "0567002", "target": "#nkr_note_orig_0567002 #note_star_1", "type": "orig", "text": "壞疑還次同"}
{"id": null, "n": "0567003", "target": "#nkr_note_orig_0567003", "type": "orig", "text": "膈疑隔"}
{"id": null, "n": "0568001", "target": "#nkr_note_orig_0568001", "type": "orig", "text": "智疑知"}
{"id": null, "n": "0568002", "target": "#nkr_note_orig_0568002", "type": "orig", "text": "臂疑劈"}
{"id": null, "n": "0568003", "target": "#nkr_note_orig_0568003", "type": "orig", "text": "月疑肉"}
{"id": null, "n": "0568004", "target": "#nkr_note_orig_0568004", "type": "orig", "text": "綠疑緣"}
