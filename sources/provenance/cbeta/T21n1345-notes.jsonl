{"id": null, "n": "0854004", "target": "#nkr_note_mod_0854004", "type": "mod", "text": "隋【大】，隋天竺【宋】，隋北天竺【元】【明】，〔－〕【聖】"}
{"id": null, "n": "0854005", "target": "#nkr_note_mod_0854005", "type": "mod", "text": "譯【大】，譯備【聖】"}
{"id": null, "n": "0854006", "target": "#nkr_note_mod_0854006", "type": "mod", "text": "加趺【大】下同，跏趺【明】【聖】下同"}
{"id": null, "n": "0854007", "target": "#nkr_note_mod_0854007", "type": "mod", "text": "相【大】，相入【聖】"}
{"id": null, "n": "0854008", "target": "#nkr_note_mod_0854008", "type": "mod", "text": "刃【大】，仞【元】【明】"}
{"id": null, "n": "0854009", "target": "#nkr_note_mod_0854009", "type": "mod", "text": "自在【大】，世音【宋】【元】【明】"}
{"id": null, "n": "0854010", "target": "#nkr_note_mod_0854010", "type": "mod", "text": "優【大】，憂【聖】"}
{"id": null, "n": "0854011", "target": "#nkr_note_mod_0854011", "type": "mod", "text": "頗梨【大】，玻瓈【明】"}
{"id": null, "n": "0854012", "target": "#nkr_note_mod_0854012", "type": "mod", "text": "惟【大】，唯【元】【明】"}
{"id": null, "n": "0855001", "target": "#nkr_note_mod_0855001", "type": "mod", "text": "善【大】，善法【元】【明】"}
{"id": null, "n": "0855002", "target": "#nkr_note_mod_0855002", "type": "mod", "text": "迨【大】，怠【宋】【元】【明】【聖】"}
{"id": null, "n": "0855003", "target": "#nkr_note_mod_0855003", "type": "mod", "text": "煩【大】，瞋【宋】【元】【明】【聖】"}
{"id": null, "n": "0855004", "target": "#nkr_note_mod_0855004", "type": "mod", "text": "癡【大】，癡惱【聖】"}
{"id": null, "n": "0855005", "target": "#nkr_note_mod_0855005", "type": "mod", "text": "煩【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0856001", "target": "#nkr_note_mod_0856001", "type": "mod", "text": "唯【大】，惟【宋】"}
{"id": null, "n": "0856002", "target": "#nkr_note_mod_0856002", "type": "mod", "text": "悟【大】，寤【宋】【元】【明】"}
{"id": null, "n": "0857001", "target": "#nkr_note_mod_0857001", "type": "mod", "text": "法【大】，法是諸法【宋】【元】【明】"}
{"id": null, "n": "0857002", "target": "#nkr_note_mod_0857002", "type": "mod", "text": "相【大】，想【宋】【元】【明】"}
{"id": null, "n": "0857003", "target": "#nkr_note_mod_0857003", "type": "mod", "text": "讚【大】，諸【宋】"}
{"id": null, "n": "0857004", "target": "#nkr_note_mod_0857004", "type": "mod", "text": "忍法【大】，法忍【宋】【元】【明】"}
{"id": null, "n": "0857005", "target": "#nkr_note_mod_0857005", "type": "mod", "text": "入【大】，人【宋】"}
{"id": null, "n": "0857006", "target": "#nkr_note_mod_0857006", "type": "mod", "text": "令【大】，今【宋】【元】【明】"}
{"id": null, "n": "0857007", "target": "#nkr_note_mod_0857007", "type": "mod", "text": "急【大】，疾【宋】【元】【明】"}
{"id": null, "n": "0857008", "target": "#nkr_note_mod_0857008", "type": "mod", "text": "明【大】，相【宋】【元】【明】"}
{"id": null, "n": "0857009", "target": "#nkr_note_mod_0857009", "type": "mod", "text": "如【大】，是【明】"}
{"id": null, "n": "0857010", "target": "#nkr_note_mod_0857010", "type": "mod", "text": "門【大】，門文殊師利言世尊云何六入是菩提佛告【宋】【元】【明】"}
{"id": null, "n": "0857011", "target": "#nkr_note_mod_0857011", "type": "mod", "text": "作【大】＊，〔－〕【宋】【元】【明】【聖】＊"}
{"id": null, "n": "0858001", "target": "#nkr_note_mod_0858001", "type": "mod", "text": "如【大】，相【聖】"}
{"id": null, "n": "0858002", "target": "#nkr_note_mod_0858002", "type": "mod", "text": "亦【大】，示【宋】【元】【明】"}
{"id": null, "n": "0858003", "target": "#nkr_note_mod_0858003", "type": "mod", "text": "盡【大】，礙【宋】【元】【明】"}
{"id": null, "n": "0854003", "target": "#nkr_note_orig_0854003", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0854004", "target": "#nkr_note_orig_0854004", "type": "orig", "text": "隋＋（天竺）【宋】，（北天竺）【元】【明】，〔隋〕－【聖】"}
