{"id": null, "n": "0338008", "target": "#nkr_note_mod_0338008", "type": "mod", "text": "覩【大】，都【明】【甲】"}
{"id": null, "n": "0338009", "target": "#nkr_note_mod_0338009", "type": "mod", "text": "無去【大】，謨去聲【明】【甲】"}
