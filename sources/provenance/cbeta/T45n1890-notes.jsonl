{"id": null, "n": "0782008", "target": "#nkr_note_orig_0782008", "type": "orig", "text": "役＝沒ヵ【原】"}
{"id": null, "n": "0782009", "target": "#nkr_note_orig_0782009", "type": "orig", "text": "原本冠註曰如孔目作知"}
{"id": null, "n": "0782010", "target": "#nkr_note_orig_0782010", "type": "orig", "text": "更＝受ヵ【原】"}
{"id": null, "n": "0783001", "target": "#nkr_note_orig_0783001", "type": "orig", "text": "悲＝非ヵ【原】＊"}
{"id": null, "n": "0783002", "target": "#nkr_note_orig_0783002", "type": "orig", "text": "〔如是…智〕十七字－？"}
{"id": null, "n": "0783003", "target": "#nkr_note_orig_0783003", "type": "orig", "text": "我＝阿ヵ【原】"}
{"id": null, "n": "0783004", "target": "#nkr_note_orig_0783004", "type": "orig", "text": "經＝疏ヵ【原】"}
{"id": null, "n": "0784001", "target": "#nkr_note_orig_0784001", "type": "orig", "text": "命＝令ヵ【原】"}
{"id": null, "n": "0784002", "target": "#nkr_note_orig_0784002", "type": "orig", "text": "（究）ヵ＋竟【原】"}
{"id": null, "n": "0784003", "target": "#nkr_note_orig_0784003", "type": "orig", "text": "雖＝還ヵ【原】"}
{"id": null, "n": "0786001", "target": "#nkr_note_orig_0786001", "type": "orig", "text": "冠註曰耳字更勘"}
{"id": null, "n": "0786002", "target": "#nkr_note_orig_0786002", "type": "orig", "text": "冠註曰孔目無十地二字"}
{"id": null, "n": "0786003", "target": "#nkr_note_orig_0786003", "type": "orig", "text": "冠註曰彼孔目作修"}
{"id": null, "n": "0786004", "target": "#nkr_note_orig_0786004", "type": "orig", "text": "冠註曰孔目佛上有其字"}
{"id": null, "n": "0786005", "target": "#nkr_note_orig_0786005", "type": "orig", "text": "冠註曰孔目無忍字"}
{"id": null, "n": "0786006", "target": "#nkr_note_orig_0786006", "type": "orig", "text": "因＝用ヵ【原】"}
{"id": null, "n": "0787001", "target": "#nkr_note_orig_0787001", "type": "orig", "text": "（成）ヵ＋其【原】"}
{"id": null, "n": "0787002", "target": "#nkr_note_orig_0787002", "type": "orig", "text": "梵＋（網）ヵ【原】"}
{"id": null, "n": "0787003", "target": "#nkr_note_orig_0787003", "type": "orig", "text": "亦＋（名）ヵ【原】"}
{"id": null, "n": "0787004", "target": "#nkr_note_orig_0787004", "type": "orig", "text": "〔槃〕－ヵ【原】"}
{"id": null, "n": "0788001", "target": "#nkr_note_orig_0788001", "type": "orig", "text": "樂＝意ヵ【原】"}
{"id": null, "n": "0788002", "target": "#nkr_note_orig_0788002", "type": "orig", "text": "所＋（生）ヵ【原】"}
{"id": null, "n": "0788003", "target": "#nkr_note_orig_0788003", "type": "orig", "text": "後＝復ヵ【原】＊"}
{"id": null, "n": "0788004", "target": "#nkr_note_orig_0788004", "type": "orig", "text": "八＝入ヵ【原】"}
{"id": null, "n": "0788005", "target": "#nkr_note_orig_0788005", "type": "orig", "text": "（問）ヵ＋約【原】"}
{"id": null, "n": "0788006", "target": "#nkr_note_orig_0788006", "type": "orig", "text": "冠註曰攝或招歟原字不明"}
{"id": null, "n": "0789001", "target": "#nkr_note_orig_0789001", "type": "orig", "text": "〔人〕－ヵ【原】"}
{"id": null, "n": "0789002", "target": "#nkr_note_orig_0789002", "type": "orig", "text": "冠註曰准字更勘"}
{"id": null, "n": "0789003", "target": "#nkr_note_orig_0789003", "type": "orig", "text": "冠註曰補入問字"}
{"id": null, "n": "0789004", "target": "#nkr_note_orig_0789004", "type": "orig", "text": "冠註曰是下問答有一佛二字"}
{"id": null, "n": "0789005", "target": "#nkr_note_orig_0789005", "type": "orig", "text": "冠註曰教問答作後"}
{"id": null, "n": "0789006", "target": "#nkr_note_orig_0789006", "type": "orig", "text": "冠註曰行上孔目有一字"}
{"id": null, "n": "0789007", "target": "#nkr_note_orig_0789007", "type": "orig", "text": "一＋（行三）ヵ【原】"}
{"id": null, "n": "0789008", "target": "#nkr_note_orig_0789008", "type": "orig", "text": "冠註曰亦上孔目有佛字，下有如字"}
{"id": null, "n": "0789009", "target": "#nkr_note_orig_0789009", "type": "orig", "text": "〔等〕－ヵ【原】"}
{"id": null, "n": "0789010", "target": "#nkr_note_orig_0789010", "type": "orig", "text": "冠註曰後孔目作解"}
{"id": null, "n": "0789011", "target": "#nkr_note_orig_0789011", "type": "orig", "text": "右＝古ヵ【原】"}
{"id": null, "n": "0790001", "target": "#nkr_note_orig_0790001", "type": "orig", "text": "今＝令ヵ【原】"}
{"id": null, "n": "0790002", "target": "#nkr_note_orig_0790002", "type": "orig", "text": "救＝校ヵ【原】"}
{"id": null, "n": "0790003", "target": "#nkr_note_orig_0790003", "type": "orig", "text": "相非＝非相ヵ【原】"}
{"id": null, "n": "0790004", "target": "#nkr_note_orig_0790004", "type": "orig", "text": "悟＝修ヵ【原】"}
{"id": null, "n": "0790005", "target": "#nkr_note_orig_0790005", "type": "orig", "text": "〔成〕－ヵ【原】"}
{"id": null, "n": "0790006", "target": "#nkr_note_orig_0790006", "type": "orig", "text": "展生＝轉生時ヵ【原】"}
{"id": null, "n": "0790007", "target": "#nkr_note_orig_0790007", "type": "orig", "text": "聞既＝既聞ヵ【原】"}
{"id": null, "n": "0791001", "target": "#nkr_note_orig_0791001", "type": "orig", "text": "〔念〕－ヵ【原】"}
{"id": null, "n": "0791002", "target": "#nkr_note_orig_0791002", "type": "orig", "text": "答＋（文）ヵ【原】"}
{"id": null, "n": "0791003", "target": "#nkr_note_orig_0791003", "type": "orig", "text": "（問）ヵ＋共【原】"}
{"id": null, "n": "0791004", "target": "#nkr_note_orig_0791004", "type": "orig", "text": "畢＝異ヵ【原】"}
{"id": null, "n": "0792001", "target": "#nkr_note_orig_0792001", "type": "orig", "text": "借＝惜ヵ【原】"}
{"id": null, "n": "0792002", "target": "#nkr_note_orig_0792002", "type": "orig", "text": "冠註曰佛祖下恐文錯亂"}
{"id": null, "n": "0792003", "target": "#nkr_note_orig_0792003", "type": "orig", "text": "性＝惟ヵ【原】"}
{"id": null, "n": "0792004", "target": "#nkr_note_orig_0792004", "type": "orig", "text": "〔無一處中〕－ヵ【原】"}
{"id": null, "n": "0792005", "target": "#nkr_note_orig_0792005", "type": "orig", "text": "（問）ヵ＋答【原】"}
{"id": null, "n": "0792006", "target": "#nkr_note_orig_0792006", "type": "orig", "text": "云＝乎ヵ【原】"}
{"id": null, "n": "0792007", "target": "#nkr_note_orig_0792007", "type": "orig", "text": "冠註曰其問答作聖"}
{"id": null, "n": "0784a2101", "target": "#nkr_note_add_0784a2101", "type": "add", "text": "贍【CB】，瞻【大】"}
