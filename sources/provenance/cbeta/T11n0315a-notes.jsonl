{"id": null, "n": "0770007", "target": "#nkr_note_orig_0770007", "type": "orig", "text": "此經與宋元明三本大異對校甚難故今以宋元二本對校明本別附卷末"}
{"id": null, "n": "0771c1201", "target": "#nkr_note_add_0771c1201", "type": "add", "text": "授【CB】【麗-CB】，受【大】"}
{"id": null, "n": "0773a1601", "target": "#nkr_note_add_0773a1601", "type": "add", "text": "自【CB】【麗-CB】，言【大】"}
{"id": null, "n": "0773c2101", "target": "#nkr_note_add_0773c2101", "type": "add", "text": "告【CB】【麗-CB】，吾【大】"}
{"id": null, "n": "0774b1501", "target": "#nkr_note_add_0774b1501", "type": "add", "text": "相【CB】【麗-CB】，想【大】"}
{"id": null, "n": "0775b0101", "target": "#nkr_note_add_0775b0101", "type": "add", "text": "視【CB】【麗-CB】，親【大】"}
{"id": null, "n": "0776a1401", "target": "#nkr_note_add_0776a1401", "type": "add", "text": "為【CB】【磧乙-CB】，等【大】【麗-CB】"}
{"id": null, "n": "0776b2401", "target": "#nkr_note_add_0776b2401", "type": "add", "text": "昧【CB】【麗-CB】，味【大】"}
{"id": null, "n": "0776b2801", "target": "#nkr_note_add_0776b2801", "type": "add", "text": "解【CB】【麗-CB】，［－］【大】"}
{"id": null, "n": "0776b2802", "target": "#nkr_note_add_0776b2802", "type": "add", "text": "［－］【CB】【麗-CB】，解【大】"}
