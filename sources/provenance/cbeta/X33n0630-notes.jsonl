{"id": null, "n": "0471a0801", "target": "#nkr_note_add_0471a0801", "type": "add", "text": "曠【CB】，嚝【卍續】"}
{"id": null, "n": "0471a1001", "target": "#nkr_note_add_0471a1001", "type": "add", "text": "已【CB】，巳【卍續】"}
{"id": null, "n": "0471b2301", "target": "#nkr_note_add_0471b2301", "type": "add", "text": "已【CB】，巳【卍續】"}
{"id": null, "n": "0471c0201", "target": "#nkr_note_add_0471c0201", "type": "add", "text": "興【CB】，［－］【卍續】"}
{"id": null, "n": "0473c0501", "target": "#nkr_note_add_0473c0501", "type": "add", "text": "已【CB】，巳【卍續】"}
{"id": null, "n": "0474a2001", "target": "#nkr_note_add_0474a2001", "type": "add", "text": "已【CB】，巳【卍續】"}
{"id": null, "n": "0474b2401", "target": "#nkr_note_add_0474b2401", "type": "add", "text": "已【CB】，巳【卍續】"}
{"id": null, "n": "0474c2101", "target": "#nkr_note_add_0474c2101", "type": "add", "text": "已【CB】，巳【卍續】"}
{"id": null, "n": "0475b1701", "target": "#nkr_note_add_0475b1701", "type": "add", "text": "已【CB】，巳【卍續】"}
{"id": null, "n": "0475c1501", "target": "#nkr_note_add_0475c1501", "type": "add", "text": "已【CB】，巳【卍續】"}
{"id": null, "n": "0476c2001", "target": "#nkr_note_add_0476c2001", "type": "add", "text": "但【CB】，伹【卍續】"}
{"id": null, "n": "0477a0101", "target": "#nkr_note_add_0477a0101", "type": "add", "text": "囑【CB】，曯【卍續】"}
