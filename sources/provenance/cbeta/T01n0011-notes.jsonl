{"id": null, "n": "0222002", "target": "#nkr_note_mod_0222002", "type": "mod", "text": "西天譯經【大】，宋西天【明】"}
{"id": null, "n": "0222003", "target": "#nkr_note_mod_0222003", "type": "mod", "text": "賜紫沙門臣施護等【大】，施護【明】"}
{"id": null, "n": "0222004", "target": "#nkr_note_mod_0222004", "type": "mod", "text": "憒【大】＊，漬【明】＊"}
{"id": null, "n": "0222005", "target": "#nkr_note_mod_0222005", "type": "mod", "text": "邪【大】，耶【明】"}
{"id": null, "n": "0222006", "target": "#nkr_note_mod_0222006", "type": "mod", "text": "座【大】，屋【宋】【元】"}
{"id": null, "n": "0223001", "target": "#nkr_note_mod_0223001", "type": "mod", "text": "尼拘【大】，拘尼【明】"}
{"id": null, "n": "0223002", "target": "#nkr_note_mod_0223002", "type": "mod", "text": "邪【大】＊，耶【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0224001", "target": "#nkr_note_mod_0224001", "type": "mod", "text": "篾【大】，懱【元】【明】"}
{"id": null, "n": "0224002", "target": "#nkr_note_mod_0224002", "type": "mod", "text": "電【大】，雷【宋】【元】【明】"}
{"id": null, "n": "0224003", "target": "#nkr_note_mod_0224003", "type": "mod", "text": "西天譯經三藏朝奉大夫試光祿卿傳法大師賜紫沙門臣施護等奉詔譯【大】，宋西天三藏朝奉大夫試光祿卿傳法大師施護奉詔譯【明】"}
{"id": null, "n": "0225001", "target": "#nkr_note_mod_0225001", "type": "mod", "text": "而【大】，面【元】"}
{"id": null, "n": "0225002", "target": "#nkr_note_mod_0225002", "type": "mod", "text": "此【CB】【麗-CB】【宋】【元】【明】，比【大】"}
{"id": null, "n": "0225003", "target": "#nkr_note_mod_0225003", "type": "mod", "text": "邪【大】＊，耶【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0225004", "target": "#nkr_note_mod_0225004", "type": "mod", "text": "數【大】，故【宋】"}
{"id": null, "n": "0222002", "target": "#nkr_note_orig_0222002", "type": "orig", "text": "西天譯經＝宋西天【明】"}
{"id": null, "n": "0222003", "target": "#nkr_note_orig_0222003", "type": "orig", "text": "賜紫沙門臣施護等＝施護【明】"}
{"id": null, "n": "0222004", "target": "#nkr_note_orig_0222004", "type": "orig", "text": "憒＝漬【明】＊"}
{"id": null, "n": "0222005", "target": "#nkr_note_orig_0222005", "type": "orig", "text": "邪＝耶【明】"}
{"id": null, "n": "0222006", "target": "#nkr_note_orig_0222006", "type": "orig", "text": "座＝屋【宋】【元】"}
{"id": null, "n": "0223001", "target": "#nkr_note_orig_0223001", "type": "orig", "text": "尼拘＝拘尼【明】"}
{"id": null, "n": "0223002", "target": "#nkr_note_orig_0223002", "type": "orig", "text": "邪＝耶【三】＊"}
{"id": null, "n": "0224001", "target": "#nkr_note_orig_0224001", "type": "orig", "text": "篾＝懱【元】【明】"}
{"id": null, "n": "0224002", "target": "#nkr_note_orig_0224002", "type": "orig", "text": "電＝雷【三】"}
{"id": null, "n": "0224003", "target": "#nkr_note_orig_0224003", "type": "orig", "text": "譯號同異如上卷"}
{"id": null, "n": "0225001", "target": "#nkr_note_orig_0225001", "type": "orig", "text": "而＝面【元】"}
{"id": null, "n": "0225002", "target": "#nkr_note_orig_0225002", "type": "orig", "text": "比＝此【三】"}
{"id": null, "n": "0225003", "target": "#nkr_note_orig_0225003", "type": "orig", "text": "邪＝耶【三】＊"}
{"id": null, "n": "0225004", "target": "#nkr_note_orig_0225004", "type": "orig", "text": "數＝故【宋】"}
