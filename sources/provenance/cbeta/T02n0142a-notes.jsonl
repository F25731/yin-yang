{"id": null, "n": "0863014", "target": "#nkr_note_orig_0863014", "type": "orig", "text": "此經與宋元明大異對校甚難故今以宋元對校明本別附載卷末"}
{"id": null, "n": "0863c2301", "target": "#nkr_note_add_0863c2301", "type": "add", "text": "辦【CB】，辨【大】"}
{"id": null, "n": "0864a2001", "target": "#nkr_note_add_0864a2001", "type": "add", "text": "是【CB】【麗-CB】，最【大】"}
{"id": null, "n": "0864b0501", "target": "#nkr_note_add_0864b0501", "type": "add", "text": "得【CB】【麗-CB】，復【大】"}
{"id": null, "n": "0864b2601", "target": "#nkr_note_add_0864b2601", "type": "add", "text": "惻【CB】【麗-CB】，側【大】"}
