{"id": null, "n": "0799004", "target": null, "type": "orig", "text": "居士＝優婆塞【明】"}
{"id": null, "n": "0799004", "target": null, "type": "mod", "text": "居士【大】，優婆塞【明】"}
{"id": null, "n": "0799002", "target": "#nkr_note_mod_0799002", "type": "mod", "text": "佛說【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0799003", "target": "#nkr_note_mod_0799003", "type": "mod", "text": "月支國居士【大】，〔－〕【宋】【元】"}
{"id": null, "n": "0799004", "target": "#nkr_note_mod_0799004", "type": "mod", "text": "居士【大】，優婆塞【明】"}
{"id": null, "n": "0799005", "target": "#nkr_note_mod_0799005", "type": "mod", "text": "曚【大】，蒙【宋】【元】【明】"}
{"id": null, "n": "0799006", "target": "#nkr_note_mod_0799006", "type": "mod", "text": "主【大】，至【宋】【元】【明】"}
{"id": null, "n": "0800001", "target": "#nkr_note_mod_0800001", "type": "mod", "text": "了【大】，不了【宋】【元】【明】"}
{"id": null, "n": "0800002", "target": "#nkr_note_mod_0800002", "type": "mod", "text": "湔【大】，懺【宋】【元】【明】"}
{"id": null, "n": "0800003", "target": "#nkr_note_mod_0800003", "type": "mod", "text": "是為【大】，為是【宋】【元】【明】"}
{"id": null, "n": "0799002", "target": "#nkr_note_orig_0799002", "type": "orig", "text": "〔佛說〕－【三】"}
{"id": null, "n": "0799003", "target": "#nkr_note_orig_0799003", "type": "orig", "text": "〔月支國居士〕－【宋】【元】"}
{"id": null, "n": "0799004", "target": "#nkr_note_orig_0799004", "type": "orig", "text": "居士＝優婆塞【明】"}
{"id": null, "n": "0799005", "target": "#nkr_note_orig_0799005", "type": "orig", "text": "曚＝蒙【三】"}
{"id": null, "n": "0799006", "target": "#nkr_note_orig_0799006", "type": "orig", "text": "主＝至【三】"}
{"id": null, "n": "0800001", "target": "#nkr_note_orig_0800001", "type": "orig", "text": "（不）＋了【三】"}
{"id": null, "n": "0800002", "target": "#nkr_note_orig_0800002", "type": "orig", "text": "湔＝懺【三】"}
{"id": null, "n": "0800003", "target": "#nkr_note_orig_0800003", "type": "orig", "text": "是為＝為是【三】"}
