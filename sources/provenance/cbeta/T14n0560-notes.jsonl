{"id": null, "n": "0912034", "target": "#nkr_note_mod_0912034", "type": "mod", "text": "華【大】，化【宋】【元】【明】【宮】"}
{"id": null, "n": "0912035", "target": "#nkr_note_mod_0912035", "type": "mod", "text": "食【大】，服【宋】【元】【明】【宮】"}
{"id": null, "n": "0912036", "target": "#nkr_note_mod_0912036", "type": "mod", "text": "苦勤【大】，勤苦【元】【明】"}
{"id": null, "n": "0912037", "target": "#nkr_note_mod_0912037", "type": "mod", "text": "（八萬…意）十一字【大】，〔－〕【元】【明】"}
