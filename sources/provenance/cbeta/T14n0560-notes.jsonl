{"id": null, "n": "0912006", "target": "#nkr_note_mod_0912006", "type": "mod", "text": "宋【大】，劉宋【元】【明】"}
{"id": null, "n": "0912007", "target": "#nkr_note_mod_0912007", "type": "mod", "text": "藏【大】，藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0912008", "target": "#nkr_note_mod_0912008", "type": "mod", "text": "羅【大】，羅第三【元】【明】"}
{"id": null, "n": "0912009", "target": "#nkr_note_mod_0912009", "type": "mod", "text": "佛為世尊【大】，〔－〕【宮】"}
{"id": null, "n": "0912010", "target": "#nkr_note_mod_0912010", "type": "mod", "text": "傴僂【大】，惸惸【宮】"}
{"id": null, "n": "0912011", "target": "#nkr_note_mod_0912011", "type": "mod", "text": "會合【大】，合會【宋】【元】【明】【宮】"}
{"id": null, "n": "0912012", "target": "#nkr_note_mod_0912012", "type": "mod", "text": "惟願【大】，母言【宋】【元】【明】【宮】"}
{"id": null, "n": "0912013", "target": "#nkr_note_mod_0912013", "type": "mod", "text": "其【大】，是【宮】"}
{"id": null, "n": "0912014", "target": "#nkr_note_mod_0912014", "type": "mod", "text": "幾【大】，已【宋】【元】【明】【宮】"}
{"id": null, "n": "0912015", "target": "#nkr_note_mod_0912015", "type": "mod", "text": "輝【大】，暉【宮】"}
{"id": null, "n": "0912016", "target": "#nkr_note_mod_0912016", "type": "mod", "text": "搥【大】，撾【宋】【元】【明】【宮】"}
{"id": null, "n": "0912017", "target": "#nkr_note_mod_0912017", "type": "mod", "text": "搥【大】，椎【宋】【元】【明】【宮】"}
{"id": null, "n": "0912018", "target": "#nkr_note_mod_0912018", "type": "mod", "text": "亦【大】，譬【宋】【元】【明】【宮】"}
{"id": null, "n": "0912019", "target": "#nkr_note_mod_0912019", "type": "mod", "text": "雷電【大】，電雷【宋】【元】【明】【宮】"}
{"id": null, "n": "0912020", "target": "#nkr_note_mod_0912020", "type": "mod", "text": "文【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0912021", "target": "#nkr_note_mod_0912021", "type": "mod", "text": "是【大】，是非【宋】【元】【明】，是作【宮】"}
{"id": null, "n": "0912022", "target": "#nkr_note_mod_0912022", "type": "mod", "text": "加【大】，如【宋】【元】【明】【宮】"}
{"id": null, "n": "0912023", "target": "#nkr_note_mod_0912023", "type": "mod", "text": "喜【大】＊，欣【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0912024", "target": "#nkr_note_mod_0912024", "type": "mod", "text": "啟【大】，披【宋】【元】【明】【宮】"}
{"id": null, "n": "0912025", "target": "#nkr_note_mod_0912025", "type": "mod", "text": "問佛諸【大】，聞佛說【宋】【元】【明】【宮】"}
{"id": null, "n": "0912026", "target": "#nkr_note_mod_0912026", "type": "mod", "text": "開意【大】，意開【宋】【元】【明】【宮】"}
{"id": null, "n": "0912027", "target": "#nkr_note_mod_0912027", "type": "mod", "text": "樓秦【大】，留秦佛【宋】【元】【明】【宮】"}
{"id": null, "n": "0912028", "target": "#nkr_note_mod_0912028", "type": "mod", "text": "戀【大】，孿【宮】"}
{"id": null, "n": "0912029", "target": "#nkr_note_mod_0912029", "type": "mod", "text": "不食【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0912030", "target": "#nkr_note_mod_0912030", "type": "mod", "text": "此【大】，是【宋】【元】【明】【宮】"}
{"id": null, "n": "0912031", "target": "#nkr_note_mod_0912031", "type": "mod", "text": "前【大】，道【宋】【元】【明】"}
{"id": null, "n": "0912032", "target": "#nkr_note_mod_0912032", "type": "mod", "text": "億【大】，一【宋】【元】【明】【宮】"}
