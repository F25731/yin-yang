{"id": null, "n": null, "target": null, "type": null, "text": "起置名不同終正配初篇"}
{"id": null, "n": null, "target": null, "type": null, "text": "除懺主單白"}
{"id": null, "n": null, "target": null, "type": null, "text": "此二結罪同上"}
{"id": null, "n": null, "target": null, "type": null, "text": "五分佛手二尺"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛指二寸"}
{"id": null, "n": null, "target": null, "type": null, "text": "是不識犯句也"}
{"id": null, "n": null, "target": null, "type": null, "text": "是疑\n犯句"}
{"id": null, "n": null, "target": null, "type": null, "text": "此皆九句"}
{"id": null, "n": null, "target": null, "type": null, "text": "此但八句，除識法識犯也"}
{"id": null, "n": null, "target": null, "type": null, "text": "取猶共也。鹿牡曰〔鹿〕"}
{"id": null, "n": null, "target": null, "type": null, "text": "許交切"}
{"id": null, "n": null, "target": null, "type": null, "text": "士板、昨閑二切"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上正文"}
{"id": null, "n": null, "target": null, "type": null, "text": "以上證有任運"}
{"id": null, "n": null, "target": null, "type": null, "text": "是律不定"}
