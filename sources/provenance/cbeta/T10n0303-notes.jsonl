{"id": null, "n": null, "target": null, "type": "cf1", "text": "K08n0082_p0999a14"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K08n0082_p1000c07"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "Q08_p0315a17"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "Q08_p0315a20"}
{"id": null, "n": "0917008", "target": "#nkr_note_mod_0917008", "type": "mod", "text": "卷上【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0917009", "target": "#nkr_note_mod_0917009", "type": "mod", "text": "隋天…譯【大】，〔－〕【聖】【聖乙】"}
{"id": null, "n": "0917010", "target": "#nkr_note_mod_0917010", "type": "mod", "text": "三藏【大】，三藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0917011", "target": "#nkr_note_mod_0917011", "type": "mod", "text": "處【大】，礙【宋】【元】【明】【宮】"}
{"id": null, "n": "0917012", "target": "#nkr_note_mod_0917012", "type": "mod", "text": "囉【大】下同，羅【宋】下同【元】下同【明】下同"}
{"id": null, "n": "0917013", "target": "#nkr_note_mod_0917013", "type": "mod", "text": "隋【大】＊，此【明】＊"}
{"id": null, "n": "0917014", "target": "#nkr_note_mod_0917014", "type": "mod", "text": "鸜鵒【大】，鸚鴿【宋】【元】【明】【宮】"}
{"id": null, "n": "0917015", "target": "#nkr_note_mod_0917015", "type": "mod", "text": "一【大】，〔－〕【宋】【元】【宮】【聖】【聖乙】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": "0917016", "target": "#nkr_note_mod_0917016", "type": "mod", "text": "耶【大】＊，邪【聖乙】＊"}
{"id": null, "n": "0917017", "target": "#nkr_note_mod_0917017", "type": "mod", "text": "黎【大】，梨【聖】【聖乙】"}
{"id": null, "n": "0917018", "target": "#nkr_note_mod_0917018", "type": "mod", "text": "摩【大】，夜【聖】【聖乙】"}
{"id": null, "n": "0917019", "target": "#nkr_note_mod_0917019", "type": "mod", "text": "下【大】，不【宋】【元】【明】"}
{"id": null, "n": "0918001", "target": "#nkr_note_mod_0918001", "type": "mod", "text": "十【大】，千【元】【明】"}
{"id": null, "n": "0918002", "target": "#nkr_note_mod_0918002", "type": "mod", "text": "日【大】，目【宋】【元】【明】【宮】，月【聖】【聖乙】"}
{"id": null, "n": "0918003", "target": "#nkr_note_mod_0918003", "type": "mod", "text": "主【大】，王【宋】【元】【明】【宮】"}
{"id": null, "n": "0918004", "target": "#nkr_note_mod_0918004", "type": "mod", "text": "休息【大】，息休【明】"}
{"id": null, "n": "0918005", "target": "#nkr_note_mod_0918005", "type": "mod", "text": "姓【大】，性【宋】【元】【明】【宮】"}
{"id": null, "n": "0918006", "target": "#nkr_note_mod_0918006", "type": "mod", "text": "加【大】，跏【聖】【聖乙】"}
{"id": null, "n": "0919001", "target": "#nkr_note_mod_0919001", "type": "mod", "text": "就【大】，熟【聖】【聖乙】"}
{"id": null, "n": "0919002", "target": "#nkr_note_mod_0919002", "type": "mod", "text": "闥【大】＊，達【聖】【聖乙】＊"}
{"id": null, "n": "0919003", "target": "#nkr_note_mod_0919003", "type": "mod", "text": "睺【大】，候【聖】【聖乙】"}
{"id": null, "n": "0919004", "target": "#nkr_note_mod_0919004", "type": "mod", "text": "大【大】＊，太【聖】【聖乙】＊"}
{"id": null, "n": "0919005", "target": "#nkr_note_mod_0919005", "type": "mod", "text": "波【大】，婆【聖乙】"}
{"id": null, "n": "0919006", "target": "#nkr_note_mod_0919006", "type": "mod", "text": "告【大】，造【宋】【宮】"}
{"id": null, "n": "0919007", "target": "#nkr_note_mod_0919007", "type": "mod", "text": "勝【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0920001", "target": "#nkr_note_mod_0920001", "type": "mod", "text": "大【大】，天【宋】【元】【明】【宮】"}
{"id": null, "n": "0920002", "target": "#nkr_note_mod_0920002", "type": "mod", "text": "囉【大】，羅【宮】"}
{"id": null, "n": "0920003", "target": "#nkr_note_mod_0920003", "type": "mod", "text": "炎【大】＊，燈【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0920004", "target": "#nkr_note_mod_0920004", "type": "mod", "text": "甘【大】，苷【聖乙】"}
{"id": null, "n": "0920005", "target": "#nkr_note_mod_0920005", "type": "mod", "text": "麻【大】，摩【聖】【聖乙】"}
{"id": null, "n": "0920007", "target": "#nkr_note_mod_0920007", "type": "mod", "text": "不分卷【宋】【元】【明】"}
{"id": null, "n": "0920008", "target": "#nkr_note_mod_0920008", "type": "mod", "text": "佛【大】，佛說【聖】【聖乙】"}
{"id": null, "n": "0920009", "target": "#nkr_note_mod_0920009", "type": "mod", "text": "境界【大】，〔－〕【聖】【聖乙】"}
{"id": null, "n": "0920010", "target": "#nkr_note_mod_0920010", "type": "mod", "text": "不分卷【宋】【元】【明】"}
{"id": null, "n": "0920011", "target": "#nkr_note_mod_0920011", "type": "mod", "text": "然復【大】，然後【宋】【元】【明】【宮】，復後【聖】【聖乙】"}
{"id": null, "n": "0920012", "target": "#nkr_note_mod_0920012", "type": "mod", "text": "黃【大】，莫【聖】"}
{"id": null, "n": "0921001", "target": "#nkr_note_mod_0921001", "type": "mod", "text": "莫【大】，若【宋】【元】【明】"}
{"id": null, "n": "0921002", "target": "#nkr_note_mod_0921002", "type": "mod", "text": "唯【大】＊，惟【宋】【宮】＊"}
{"id": null, "n": "0921003", "target": "#nkr_note_mod_0921003", "type": "mod", "text": "殊【大】，利【明】"}
{"id": null, "n": "0922001", "target": "#nkr_note_mod_0922001", "type": "mod", "text": "種種【大】，福福【聖】【聖乙】"}
{"id": null, "n": "0922002", "target": "#nkr_note_mod_0922002", "type": "mod", "text": "今【大】，令【宋】【元】【明】【宮】"}
{"id": null, "n": "0922003", "target": "#nkr_note_mod_0922003", "type": "mod", "text": "想【大】＊，相【聖】＊"}
{"id": null, "n": "0922004", "target": "#nkr_note_mod_0922004", "type": "mod", "text": "彼【大】，後【宮】"}
{"id": null, "n": "0922005", "target": "#nkr_note_mod_0922005", "type": "mod", "text": "覺【大】，學【聖】"}
{"id": null, "n": "0922006", "target": "#nkr_note_mod_0922006", "type": "mod", "text": "循【大】＊，修【宋】【元】【明】【宮】【聖】【聖乙】＊"}
{"id": null, "n": "0922007", "target": "#nkr_note_mod_0922007", "type": "mod", "text": "有【大】，有知【宋】【元】【明】【宮】【聖】"}
{"id": null, "n": "0922008", "target": "#nkr_note_mod_0922008", "type": "mod", "text": "四【大】＊，回【宋】【宮】＊"}
{"id": null, "n": "0922009", "target": "#nkr_note_mod_0922009", "type": "mod", "text": "知【大】，〔－〕【聖】"}
{"id": null, "n": "0922010", "target": "#nkr_note_mod_0922010", "type": "mod", "text": "有【大】，有知【宋】【元】【明】【宮】"}
{"id": null, "n": "0922011", "target": "#nkr_note_mod_0922011", "type": "mod", "text": "攀【大】，舉【聖】"}
{"id": null, "n": "0922012", "target": "#nkr_note_mod_0922012", "type": "mod", "text": "泊【大】，灤【元】【明】"}
