{"id": null, "n": null, "target": null, "type": null, "text": "勝造八万四千七寶塔"}
{"id": null, "n": null, "target": null, "type": null, "text": "名目如何"}
{"id": null, "n": null, "target": null, "type": null, "text": "何名一躰三寶何名別相三寶何名住持三寶"}
{"id": null, "n": null, "target": null, "type": null, "text": "真身故無漏羅漢故得寶名"}
{"id": null, "n": null, "target": null, "type": null, "text": "自合親"}
{"id": null, "n": null, "target": null, "type": null, "text": "入定自合見何假問於佛無身亦合救"}
{"id": null, "n": null, "target": null, "type": null, "text": "變苦合安樂"}
{"id": null, "n": null, "target": null, "type": null, "text": "乞聞夕死无𨐌"}
{"id": null, "n": "0001a0401", "target": "#nkr_note_add_0001a0401", "type": "add", "text": "摧【CB】，墔【國圖】"}
{"id": null, "n": "0002a0301", "target": "#nkr_note_add_0002a0301", "type": "add", "text": "坰【CB】，垧【國圖】（CBETA 按：此處參考《教育部異體字字典》，「垧」為「坰」之俗訛，故改為「坰」。）"}
{"id": null, "n": "0002a0901", "target": "#nkr_note_add_0002a0901", "type": "add", "text": "果【CB】，杲【國圖】"}
{"id": null, "n": "0002a1001", "target": "#nkr_note_add_0002a1001", "type": "add", "text": "第【CB】，弟【國圖】"}
{"id": null, "n": "0003a0301", "target": "#nkr_note_add_0003a0301", "type": "add", "text": "［－］【CB】，法師【國圖】"}
