{"id": null, "n": null, "target": null, "type": null, "text": "五"}
{"id": null, "n": null, "target": null, "type": null, "text": "六"}
{"id": null, "n": null, "target": null, "type": null, "text": "平聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "七迹反"}
{"id": null, "n": null, "target": null, "type": null, "text": "出輔行記"}
{"id": null, "n": null, "target": null, "type": null, "text": "遵式"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "附智者疏末"}
{"id": null, "n": null, "target": null, "type": null, "text": "亡本"}
{"id": null, "n": null, "target": null, "type": null, "text": "亡本"}
