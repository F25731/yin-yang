{"id": null, "n": "0551062", "target": "#nkr_note_orig_0551062", "type": "orig", "text": "〔譬如磨鏡〕－【宮】"}
{"id": null, "n": "0551063", "target": "#nkr_note_orig_0551063", "type": "orig", "text": "端自＝諦【三】【宮】"}
{"id": null, "n": "0551064", "target": "#nkr_note_orig_0551064", "type": "orig", "text": "無有＝有無【三】"}
{"id": null, "n": "0551065", "target": "#nkr_note_orig_0551065", "type": "orig", "text": "〔墮〕－【宮】"}
{"id": null, "n": "0551066", "target": "#nkr_note_orig_0551066", "type": "orig", "text": "（亦）＋不【三】【宮】"}
{"id": null, "n": "0551067", "target": "#nkr_note_orig_0551067", "type": "orig", "text": "消＝銷【三】【宮】"}
{"id": null, "n": "0551068", "target": "#nkr_note_orig_0551068", "type": "orig", "text": "動＝起【三】【宮】"}
{"id": null, "n": "0551069", "target": "#nkr_note_orig_0551069", "type": "orig", "text": "〔佛言〕－【三】【宮】"}
{"id": null, "n": "0551070", "target": "#nkr_note_orig_0551070", "type": "orig", "text": "〔有〕－【三】【宮】"}
{"id": null, "n": "0551071", "target": "#nkr_note_orig_0551071", "type": "orig", "text": "顧＝須【宋】"}
{"id": null, "n": "0551072", "target": "#nkr_note_orig_0551072", "type": "orig", "text": "（能）＋知【三】【宮】"}
{"id": null, "n": "0551073", "target": "#nkr_note_orig_0551073", "type": "orig", "text": "意定乃有一心＝如人念飯食道定【三】【宮】"}
{"id": null, "n": "0551074", "target": "#nkr_note_orig_0551074", "type": "orig", "text": "便＋（更）【三】【宮】"}
{"id": null, "n": "0551075", "target": "#nkr_note_orig_0551075", "type": "orig", "text": "蜎飛蠕動之類坐獨自歎已＝虫蛾六畜坐獨自笑以【宮】"}
{"id": null, "n": "0551076", "target": "#nkr_note_orig_0551076", "type": "orig", "text": "生＋（虫蛾）【宮】"}
{"id": null, "n": "0551077", "target": "#nkr_note_orig_0551077", "type": "orig", "text": "已得羅漢道＝為羅漢【三】【宮】"}
{"id": null, "n": "0551078", "target": "#nkr_note_orig_0551078", "type": "orig", "text": "便＝即【三】【宮】"}
{"id": null, "n": "0551079", "target": "#nkr_note_orig_0551079", "type": "orig", "text": "變＝戀【宋】，〔變化〕－【宮】"}
{"id": null, "n": "0551080", "target": "#nkr_note_orig_0551080", "type": "orig", "text": "〔能〕－【三】【宮】＊"}
{"id": null, "n": "0551081", "target": "#nkr_note_orig_0551081", "type": "orig", "text": "（今）＋吾【三】【宮】"}
{"id": null, "n": "0550b1801", "target": "#nkr_note_add_0550b1801", "type": "add", "text": "暝【CB】【麗-CB】，瞑【大】"}
