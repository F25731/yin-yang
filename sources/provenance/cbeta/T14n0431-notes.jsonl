{"id": null, "n": "0076001", "target": "#nkr_note_mod_0076001", "type": "mod", "text": "八佛【大】＊，佛說八佛【元】【明】＊"}
{"id": null, "n": "0076002", "target": "#nkr_note_mod_0076002", "type": "mod", "text": "隋天竺三藏【大】，隋三藏法師【宋】【宮】，隋北天竺三藏法師【元】"}
{"id": null, "n": "0076003", "target": "#nkr_note_mod_0076003", "type": "mod", "text": "惟【大】，唯【宋】【宮】"}
{"id": null, "n": "0076004", "target": "#nkr_note_mod_0076004", "type": "mod", "text": "側【大】，畟【元】【明】"}
{"id": null, "n": "0076005", "target": "#nkr_note_mod_0076005", "type": "mod", "text": "蓮【大】，〔－〕【宋】【元】【明】，華【宮】"}
{"id": null, "n": "0076006", "target": "#nkr_note_mod_0076006", "type": "mod", "text": "惟【大】，唯【宋】【元】【明】【宮】"}
{"id": null, "n": "0077001", "target": "#nkr_note_mod_0077001", "type": "mod", "text": "成【大】，速【宋】【元】【明】【宮】"}
{"id": null, "n": "0077002", "target": "#nkr_note_mod_0077002", "type": "mod", "text": "七【大】，十【宋】【元】【明】【宮】"}
{"id": null, "n": "0077003", "target": "#nkr_note_mod_0077003", "type": "mod", "text": "刀杖【大】，刀仗【宮】"}
{"id": null, "n": "0077004", "target": "#nkr_note_mod_0077004", "type": "mod", "text": "及【大】，水【元】【明】"}
{"id": null, "n": "0076001", "target": "#nkr_note_orig_0076001", "type": "orig", "text": "（佛說）＋八佛【元】【明】＊"}
{"id": null, "n": "0076002", "target": "#nkr_note_orig_0076002", "type": "orig", "text": "隋天竺三藏＝隋三藏法師【宋】【宮】，隋北天竺三藏法師【元】"}
{"id": null, "n": "0076003", "target": "#nkr_note_orig_0076003", "type": "orig", "text": "惟＝唯【宋】【宮】"}
{"id": null, "n": "0076004", "target": "#nkr_note_orig_0076004", "type": "orig", "text": "側＝畟【元】【明】"}
{"id": null, "n": "0076005", "target": "#nkr_note_orig_0076005", "type": "orig", "text": "〔蓮〕－【三】，蓮＝華【宮】"}
{"id": null, "n": "0076006", "target": "#nkr_note_orig_0076006", "type": "orig", "text": "惟＝唯【三】【宮】"}
{"id": null, "n": "0077001", "target": "#nkr_note_orig_0077001", "type": "orig", "text": "成＝速【三】【宮】"}
{"id": null, "n": "0077002", "target": "#nkr_note_orig_0077002", "type": "orig", "text": "七＝十【三】【宮】"}
{"id": null, "n": "0077003", "target": "#nkr_note_orig_0077003", "type": "orig", "text": "刀杖＝刀仗【宮】"}
{"id": null, "n": "0077004", "target": "#nkr_note_orig_0077004", "type": "orig", "text": "及＝水【元】【明】"}
