{"id": null, "n": null, "target": null, "type": null, "text": "亦名聞城\n十二因緣經"}
{"id": null, "n": "0826001", "target": "#nkr_note_mod_0826001", "type": "mod", "text": "貝多【大】＊，佛說貝多【宋】【明】【宮】＊"}
{"id": null, "n": "0826002", "target": "#nkr_note_mod_0826002", "type": "mod", "text": "經【大】，〔－〕【明】"}
{"id": null, "n": "0826003", "target": "#nkr_note_mod_0826003", "type": "mod", "text": "氏【大】，支【宋】【元】【明】【宮】，氏國【元】【明】"}
{"id": null, "n": "0826004", "target": "#nkr_note_mod_0826004", "type": "mod", "text": "說【大】，記【宋】【元】【宮】"}
{"id": null, "n": "0826005", "target": "#nkr_note_mod_0826005", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0826006", "target": "#nkr_note_mod_0826006", "type": "mod", "text": "無【大】，無有【宋】【元】【明】【宮】"}
{"id": null, "n": "0826007", "target": "#nkr_note_mod_0826007", "type": "mod", "text": "何【大】，何等【元】【明】"}
{"id": null, "n": "0827001", "target": "#nkr_note_mod_0827001", "type": "mod", "text": "應【大】，應意【宋】【元】【明】【宮】"}
{"id": null, "n": "0827002", "target": "#nkr_note_mod_0827002", "type": "mod", "text": "盡【大】，盡復【宋】【元】【明】【宮】"}
{"id": null, "n": "0827003", "target": "#nkr_note_mod_0827003", "type": "mod", "text": "意應【大】，應意【宋】【元】【明】"}
{"id": null, "n": "0827004", "target": "#nkr_note_mod_0827004", "type": "mod", "text": "何【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0827005", "target": "#nkr_note_mod_0827005", "type": "mod", "text": "好【大】，好足【宋】【元】【明】【宮】"}
{"id": null, "n": "0827006", "target": "#nkr_note_mod_0827006", "type": "mod", "text": "宜【大】，誼【宋】【元】【明】【宮】"}
{"id": null, "n": "0827007", "target": "#nkr_note_mod_0827007", "type": "mod", "text": "佛【大】，佛說【宋】【元】【明】【宮】"}
{"id": null, "n": "0826001", "target": "#nkr_note_orig_0826001", "type": "orig", "text": "（佛說）＋貝多【宋】【明】【宮】＊"}
{"id": null, "n": "0826002", "target": "#nkr_note_orig_0826002", "type": "orig", "text": "〔經〕－【明】"}
{"id": null, "n": "0826003", "target": "#nkr_note_orig_0826003", "type": "orig", "text": "氏＝支【三】【宮】，氏＋（國）【元】【明】"}
{"id": null, "n": "0826004", "target": "#nkr_note_orig_0826004", "type": "orig", "text": "說＝記【宋】【元】【宮】"}
{"id": null, "n": "0826005", "target": "#nkr_note_orig_0826005", "type": "orig", "text": "〔有〕－【三】【宮】"}
{"id": null, "n": "0826006", "target": "#nkr_note_orig_0826006", "type": "orig", "text": "無＋（有）【三】【宮】"}
{"id": null, "n": "0826007", "target": "#nkr_note_orig_0826007", "type": "orig", "text": "何＋（等）【元】【明】"}
{"id": null, "n": "0827001", "target": "#nkr_note_orig_0827001", "type": "orig", "text": "應＋（意）【三】【宮】"}
{"id": null, "n": "0827002", "target": "#nkr_note_orig_0827002", "type": "orig", "text": "盡＋（復）【三】【宮】"}
{"id": null, "n": "0827003", "target": "#nkr_note_orig_0827003", "type": "orig", "text": "意應＝應意【三】"}
{"id": null, "n": "0827004", "target": "#nkr_note_orig_0827004", "type": "orig", "text": "〔何〕－【三】【宮】"}
{"id": null, "n": "0827005", "target": "#nkr_note_orig_0827005", "type": "orig", "text": "好＋（足）【三】【宮】"}
{"id": null, "n": "0827006", "target": "#nkr_note_orig_0827006", "type": "orig", "text": "宜＝誼【三】【宮】"}
{"id": null, "n": "0827007", "target": "#nkr_note_orig_0827007", "type": "orig", "text": "佛＋（說）【三】【宮】"}
