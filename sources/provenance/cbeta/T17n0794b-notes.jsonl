{"id": null, "n": null, "target": null, "type": null, "text": "冬四月竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "春四月竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "夏四月竟"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T17n0794ap0738c22"}
{"id": null, "n": "0739033", "target": null, "type": "orig", "text": "梵＝胡【宋】【元】【宮】"}
{"id": null, "n": "0739033", "target": null, "type": "mod", "text": "梵【大】，胡【宋】【元】【宮】"}
{"id": null, "n": "0739034", "target": null, "type": "orig", "text": "于闐＝釬𬎞【宮】"}
{"id": null, "n": "0739034", "target": null, "type": "mod", "text": "于闐【大】，釬𬎞【宮】"}
{"id": null, "n": "0739001", "target": "#nkr_note_mod_0739001", "type": "mod", "text": "（佛說…經）六字【大】，〔－〕【知】，此經明本也以宋本元本宮本知本對校"}
{"id": null, "n": "0739002", "target": "#nkr_note_mod_0739002", "type": "mod", "text": "天竺三藏法師若羅嚴譯【大】，〔－〕【知】，外國法師若羅嚴譯【宮】"}
{"id": null, "n": "0739003", "target": "#nkr_note_mod_0739003", "type": "mod", "text": "林【大】，〔－〕【知】"}
{"id": null, "n": "0739004", "target": "#nkr_note_mod_0739004", "type": "mod", "text": "時【大】，是時【知】"}
{"id": null, "n": "0739005", "target": "#nkr_note_mod_0739005", "type": "mod", "text": "非【大】，與非【知】"}
{"id": null, "n": "0739006", "target": "#nkr_note_mod_0739006", "type": "mod", "text": "念之【大】，憶念【知】"}
{"id": null, "n": "0739007", "target": "#nkr_note_mod_0739007", "type": "mod", "text": "如是【大】，〔－〕【宮】"}
{"id": null, "n": "0739008", "target": "#nkr_note_mod_0739008", "type": "mod", "text": "當【大】，謹【知】"}
{"id": null, "n": "0739009", "target": "#nkr_note_mod_0739009", "type": "mod", "text": "分【大】＊，〔－〕【知】＊"}
{"id": null, "n": "0739010", "target": "#nkr_note_mod_0739010", "type": "mod", "text": "第一【大】＊，〔－〕【知】＊"}
{"id": null, "n": "0739011", "target": "#nkr_note_mod_0739011", "type": "mod", "text": "非時【大】下同，為非時【知】下同"}
{"id": null, "n": "0739012", "target": "#nkr_note_mod_0739012", "type": "mod", "text": "（從…日）十字【大】，〔－〕【知】，以下知恩院本非時下總無從乃至等期日"}
{"id": null, "n": "0739013", "target": "#nkr_note_mod_0739013", "type": "mod", "text": "四指【大】，〔－〕【知】"}
{"id": null, "n": "0739014", "target": "#nkr_note_mod_0739014", "type": "mod", "text": "時【大】，時冬四月竟【知】"}
{"id": null, "n": null, "target": null, "type": null, "text": "冬四月竟"}
{"id": null, "n": "0739015", "target": "#nkr_note_mod_0739015", "type": "mod", "text": "少【大】，〔－〕【知】"}
{"id": null, "n": "0739016", "target": "#nkr_note_mod_0739016", "type": "mod", "text": "少三指【大】，〔－〕【知】"}
{"id": null, "n": "0739017", "target": "#nkr_note_mod_0739017", "type": "mod", "text": "三【大】，四【知】"}
{"id": null, "n": "0739018", "target": "#nkr_note_mod_0739018", "type": "mod", "text": "時【大】，時春四月竟【知】"}
{"id": null, "n": null, "target": null, "type": null, "text": "春四月竟"}
{"id": null, "n": "0739019", "target": "#nkr_note_mod_0739019", "type": "mod", "text": "少三指【大】，半【知】"}
{"id": null, "n": "0739020", "target": "#nkr_note_mod_0739020", "type": "mod", "text": "六【大】，五【宋】【元】【宮】"}
{"id": null, "n": "0739021", "target": "#nkr_note_mod_0739021", "type": "mod", "text": "半【大】，〔－〕【知】"}
{"id": null, "n": "0739022", "target": "#nkr_note_mod_0739022", "type": "mod", "text": "時【大】，時夏四月竟【知】"}
{"id": null, "n": null, "target": null, "type": null, "text": "夏四月竟"}
{"id": null, "n": "0739023", "target": "#nkr_note_mod_0739023", "type": "mod", "text": "之【大】，〔－〕【知】"}
{"id": null, "n": "0739024", "target": "#nkr_note_mod_0739024", "type": "mod", "text": "行【大】，作【知】"}
{"id": null, "n": "0739025", "target": "#nkr_note_mod_0739025", "type": "mod", "text": "作【大】，〔－〕【知】"}
{"id": null, "n": "0739026", "target": "#nkr_note_mod_0739026", "type": "mod", "text": "下【CB】【宮】，上【大】"}
{"id": null, "n": "0739027", "target": "#nkr_note_mod_0739027", "type": "mod", "text": "經竟【大】，是法【知】"}
{"id": null, "n": "0739028", "target": "#nkr_note_mod_0739028", "type": "mod", "text": "勸助【大】，〔－〕【知】"}
{"id": null, "n": "0739029", "target": "#nkr_note_mod_0739029", "type": "mod", "text": "受持【大】，奉行【知】"}
{"id": null, "n": "0739030", "target": "#nkr_note_mod_0739030", "type": "mod", "text": "地獄【大】，惡道【知】"}
{"id": null, "n": "0739031", "target": "#nkr_note_mod_0739031", "type": "mod", "text": "欲【大】，觀【知】"}
{"id": null, "n": "0739032", "target": "#nkr_note_mod_0739032", "type": "mod", "text": "天竺三藏法師若羅嚴手執梵本口自宣譯涼州道人于闐城中寫訖【大】，〔－〕【知】，外國法師若羅嚴手執梵本口自宣譯涼州道人于闐城中寫訖【宮】"}
{"id": null, "n": "0739033", "target": "#nkr_note_mod_0739033", "type": "mod", "text": "梵【大】，胡【宋】【元】【宮】"}
{"id": null, "n": "0739034", "target": "#nkr_note_mod_0739034", "type": "mod", "text": "于闐【大】，釬𬎞【宮】"}
{"id": null, "n": "0739001", "target": "#nkr_note_orig_0739001", "type": "orig", "text": "此經明本也以宋本元本宮本知本對校，〔佛說…經〕六字－【知】"}
{"id": null, "n": "0739002", "target": "#nkr_note_orig_0739002", "type": "orig", "text": "天竺三藏＝外國【宮】，〔天竺…譯〕十字－【知】"}
{"id": null, "n": "0739003", "target": "#nkr_note_orig_0739003", "type": "orig", "text": "〔林〕－【知】"}
{"id": null, "n": "0739004", "target": "#nkr_note_orig_0739004", "type": "orig", "text": "（是）＋時【知】"}
{"id": null, "n": "0739005", "target": "#nkr_note_orig_0739005", "type": "orig", "text": "（與）＋非【知】"}
{"id": null, "n": "0739006", "target": "#nkr_note_orig_0739006", "type": "orig", "text": "念之＝憶念【知】"}
{"id": null, "n": "0739007", "target": "#nkr_note_orig_0739007", "type": "orig", "text": "〔如是〕－【宮】"}
{"id": null, "n": "0739008", "target": "#nkr_note_orig_0739008", "type": "orig", "text": "當＝謹【知】"}
{"id": null, "n": "0739009", "target": "#nkr_note_orig_0739009", "type": "orig", "text": "〔分〕－【知】＊"}
{"id": null, "n": "0739010", "target": "#nkr_note_orig_0739010", "type": "orig", "text": "〔第一〕－【知】＊"}
{"id": null, "n": "0739011", "target": "#nkr_note_orig_0739011", "type": "orig", "text": "（為）＋非時【知】下同"}
{"id": null, "n": "0739012", "target": "#nkr_note_orig_0739012", "type": "orig", "text": "〔從…日〕十字－【知】，以下知恩院本非時下總無從乃至等期日"}
{"id": null, "n": "0739013", "target": "#nkr_note_orig_0739013", "type": "orig", "text": "〔四指〕－【知】"}
{"id": null, "n": "0739014", "target": "#nkr_note_orig_0739014", "type": "orig", "text": "時＋（冬四月竟）夾註【知】"}
{"id": null, "n": "0739015", "target": "#nkr_note_orig_0739015", "type": "orig", "text": "〔少〕－【知】"}
{"id": null, "n": "0739016", "target": "#nkr_note_orig_0739016", "type": "orig", "text": "〔少三指〕－【知】"}
{"id": null, "n": "0739017", "target": "#nkr_note_orig_0739017", "type": "orig", "text": "三＝四【知】"}
{"id": null, "n": "0739018", "target": "#nkr_note_orig_0739018", "type": "orig", "text": "時＋（春四月竟）夾註【知】"}
{"id": null, "n": "0739019", "target": "#nkr_note_orig_0739019", "type": "orig", "text": "少三指＝半【知】"}
{"id": null, "n": "0739020", "target": "#nkr_note_orig_0739020", "type": "orig", "text": "六＝五【宋】【元】【宮】"}
{"id": null, "n": "0739021", "target": "#nkr_note_orig_0739021", "type": "orig", "text": "〔半〕－【知】"}
{"id": null, "n": "0739022", "target": "#nkr_note_orig_0739022", "type": "orig", "text": "時＋（夏四月竟）夾註【知】"}
{"id": null, "n": "0739023", "target": "#nkr_note_orig_0739023", "type": "orig", "text": "〔之〕－【知】"}
{"id": null, "n": "0739024", "target": "#nkr_note_orig_0739024", "type": "orig", "text": "行＝作【知】"}
{"id": null, "n": "0739025", "target": "#nkr_note_orig_0739025", "type": "orig", "text": "〔作〕－【知】"}
{"id": null, "n": "0739026", "target": "#nkr_note_orig_0739026", "type": "orig", "text": "上＝下【宮】"}
{"id": null, "n": "0739027", "target": "#nkr_note_orig_0739027", "type": "orig", "text": "經竟＝是法【知】"}
{"id": null, "n": "0739028", "target": "#nkr_note_orig_0739028", "type": "orig", "text": "〔勸助〕－【知】"}
{"id": null, "n": "0739029", "target": "#nkr_note_orig_0739029", "type": "orig", "text": "受持＝奉行【知】"}
{"id": null, "n": "0739030", "target": "#nkr_note_orig_0739030", "type": "orig", "text": "地獄＝惡道【知】"}
{"id": null, "n": "0739031", "target": "#nkr_note_orig_0739031", "type": "orig", "text": "欲＝觀【知】"}
{"id": null, "n": "0739032", "target": "#nkr_note_orig_0739032", "type": "orig", "text": "天竺三藏＝外國【宮】，〔天竺…訖〕二十七字－【知】"}
{"id": null, "n": "0739033", "target": "#nkr_note_orig_0739033", "type": "orig", "text": "梵＝胡【宋】【元】【宮】"}
{"id": null, "n": "0739034", "target": "#nkr_note_orig_0739034", "type": "orig", "text": "于闐＝釬𬎞【宮】"}
{"id": null, "n": "0739035", "target": "#nkr_note_orig_0739035", "type": "orig", "text": "此下知恩院本有經題並光明皇后願文"}
{"id": null, "n": "0739001", "target": "#nkr_note_rest_0739001", "type": "rest", "text": "此經明本也以宋本元本宮本知本對校"}
{"id": null, "n": "0739012", "target": "#nkr_note_rest_0739012", "type": "rest", "text": "以下知恩院本非時下總無從乃至　等期日"}
