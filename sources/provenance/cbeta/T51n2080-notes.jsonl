{"id": null, "n": "0777005", "target": "#nkr_note_mod_0777005", "type": "mod", "text": "上【大】，十一【宮】"}
{"id": null, "n": "0777006", "target": "#nkr_note_mod_0777006", "type": "mod", "text": "下【大】，十二【宮】"}
{"id": null, "n": "0777007", "target": "#nkr_note_mod_0777007", "type": "mod", "text": "按【大】＊，桉【宮】＊"}
{"id": null, "n": "0778001", "target": "#nkr_note_mod_0778001", "type": "mod", "text": "常【大】，當【宮】"}
{"id": null, "n": "0778002", "target": "#nkr_note_mod_0778002", "type": "mod", "text": "以【大】，已【宮】"}
{"id": null, "n": "0778003", "target": "#nkr_note_mod_0778003", "type": "mod", "text": "只【大】，秖【宮】"}
{"id": null, "n": "0778004", "target": "#nkr_note_mod_0778004", "type": "mod", "text": "其【大】，真【宮】"}
