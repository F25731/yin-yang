{"id": null, "n": "0289022", "target": null, "type": "orig", "text": "及善女人＝善女人等及男女故ィ【乙】"}
{"id": null, "n": "0289022", "target": null, "type": "mod", "text": "及善女人【大】，善女人等及男女故【校異-乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引一"}
{"id": null, "n": null, "target": null, "type": null, "text": "引一"}
{"id": null, "n": null, "target": null, "type": null, "text": "引二"}
{"id": null, "n": "0289017", "target": "#nkr_note_mod_0289017", "type": "mod", "text": "經【大】，法【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0289018", "target": "#nkr_note_mod_0289018", "type": "mod", "text": "（開府…門）四十一字【大】，特進試鴻臚卿大廣善寺三藏沙門大廣智【宋】【元】【甲】，唐特進試鴻臚卿三藏沙門大廣智【明】【乙】"}
{"id": null, "n": "0289019", "target": "#nkr_note_mod_0289019", "type": "mod", "text": "帝【大】，帝母【乙】"}
{"id": null, "n": "0289020", "target": "#nkr_note_mod_0289020", "type": "mod", "text": "由【大】，猶【元】【明】【乙】"}
{"id": null, "n": "0289021", "target": "#nkr_note_mod_0289021", "type": "mod", "text": "男子及善女人【大】，女人及男女故【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0289022", "target": "#nkr_note_mod_0289022", "type": "mod", "text": "及善女人【大】，善女人等及男女故【校異-乙】"}
{"id": null, "n": "0289023", "target": "#nkr_note_mod_0289023", "type": "mod", "text": "唯【大】，惟【宋】【元】【明】【乙】"}
{"id": null, "n": "0289024", "target": "#nkr_note_mod_0289024", "type": "mod", "text": "唵【大】，唵引一【宋】【元】【明】【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引一"}
{"id": null, "n": "0289025", "target": "#nkr_note_mod_0289025", "type": "mod", "text": "引【大】，引二【宋】【元】【明】【乙】"}
{"id": null, "n": "0289026", "target": "#nkr_note_mod_0289026", "type": "mod", "text": "緒【大】，敘【宋】【元】【明】【甲】"}
{"id": null, "n": "0289027", "target": "#nkr_note_mod_0289027", "type": "mod", "text": "不【大】，不宜男女【宋】【元】【明】【甲】"}
{"id": null, "n": "0289028", "target": "#nkr_note_mod_0289028", "type": "mod", "text": "或【大】，此【明】【乙】"}
{"id": null, "n": "0289029", "target": "#nkr_note_mod_0289029", "type": "mod", "text": "搩【大】，磔【宋】【元】【明】【乙】"}
{"id": null, "n": "0289030", "target": "#nkr_note_mod_0289030", "type": "mod", "text": "隨【大】，或隨【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0289031", "target": "#nkr_note_mod_0289031", "type": "mod", "text": "純【大】，像【宋】【元】【明】【乙】"}
{"id": null, "n": "0289032", "target": "#nkr_note_mod_0289032", "type": "mod", "text": "宣【大】＊，寶【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0289033", "target": "#nkr_note_mod_0289033", "type": "mod", "text": "手【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0289034", "target": "#nkr_note_mod_0289034", "type": "mod", "text": "塗【大】，泥【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0289035", "target": "#nkr_note_mod_0289035", "type": "mod", "text": "一【大】，〔－〕【宋】【元】【明】【甲】【乙】"}
