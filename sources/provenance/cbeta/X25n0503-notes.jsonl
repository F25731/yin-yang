{"id": null, "n": null, "target": null, "type": null, "text": "閩總戎，號泰一"}
{"id": null, "n": null, "target": null, "type": null, "text": "音梭"}
{"id": null, "n": null, "target": null, "type": null, "text": "音娃"}
{"id": null, "n": null, "target": null, "type": null, "text": "音述"}
{"id": null, "n": null, "target": null, "type": null, "text": "音陀"}
{"id": null, "n": null, "target": null, "type": null, "text": "音酣"}
{"id": null, "n": null, "target": null, "type": null, "text": "音□"}
{"id": null, "n": null, "target": null, "type": null, "text": "音陀"}
{"id": null, "n": null, "target": null, "type": null, "text": "音寨"}
{"id": null, "n": null, "target": null, "type": null, "text": "音耶"}
{"id": null, "n": null, "target": null, "type": null, "text": "囊上聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "音娃"}
{"id": null, "n": null, "target": null, "type": null, "text": "音子"}
{"id": null, "n": null, "target": null, "type": null, "text": "音楋"}
{"id": null, "n": null, "target": null, "type": null, "text": "音吽"}
{"id": null, "n": null, "target": null, "type": null, "text": "除一切眾生宿世災殃主大海"}
{"id": null, "n": null, "target": null, "type": null, "text": "除一切眾生瘟毒病患主災毒"}
{"id": null, "n": null, "target": null, "type": null, "text": "令一切眾生所求如願主功德"}
{"id": null, "n": null, "target": null, "type": null, "text": "除一切眾生熟惱苦主一切寶"}
{"id": null, "n": null, "target": null, "type": null, "text": "除一切眾生無明見主生風"}
{"id": null, "n": null, "target": null, "type": null, "text": "除一切眾生灾難苦主琉璃"}
{"id": null, "n": null, "target": null, "type": null, "text": "令一切眾生開解悟主堅牢"}
{"id": null, "n": null, "target": null, "type": null, "text": "令一切眾生智芽成就主龍"}
{"id": null, "n": null, "target": null, "type": null, "text": "慈也"}
{"id": null, "n": null, "target": null, "type": null, "text": "悲也"}
{"id": null, "n": null, "target": null, "type": null, "text": "喜也"}
{"id": null, "n": null, "target": null, "type": null, "text": "捨也"}
{"id": null, "n": null, "target": null, "type": null, "text": "般若音鉢惹，下倣此"}
{"id": null, "n": null, "target": null, "type": null, "text": "說法聚會，由此起因"}
{"id": null, "n": null, "target": null, "type": null, "text": "著音酌，鉢音撥，飯食音反四"}
{"id": null, "n": null, "target": null, "type": null, "text": "善現長老啟請佛訓"}
{"id": null, "n": null, "target": null, "type": null, "text": "樂音要"}
{"id": null, "n": null, "target": null, "type": null, "text": "最大之乘，至正之宗"}
{"id": null, "n": null, "target": null, "type": null, "text": "涅槃音扛盤"}
{"id": null, "n": null, "target": null, "type": null, "text": "奧妙之行，本無住著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "不音否，不音弗，下倣\n此。"}
{"id": null, "n": null, "target": null, "type": null, "text": "自如之理，乃見真實"}
{"id": null, "n": null, "target": null, "type": null, "text": "生正信心，最為希有"}
{"id": null, "n": null, "target": null, "type": null, "text": "空則無得，寂則無說"}
{"id": null, "n": null, "target": null, "type": null, "text": "差音雌"}
{"id": null, "n": null, "target": null, "type": null, "text": "諸佛之法依此生出"}
{"id": null, "n": null, "target": null, "type": null, "text": "偈音忌"}
{"id": null, "n": null, "target": null, "type": null, "text": "只此一相，本自無形"}
{"id": null, "n": null, "target": null, "type": null, "text": "洹，音完；那，音奴"}
{"id": null, "n": null, "target": null, "type": null, "text": "成就莊嚴淨明心地"}
{"id": null, "n": null, "target": null, "type": null, "text": "修無為福，勝於布施"}
{"id": null, "n": null, "target": null, "type": null, "text": "受持正教，天人尊重"}
{"id": null, "n": null, "target": null, "type": null, "text": "當如此法承受行持"}
{"id": null, "n": null, "target": null, "type": null, "text": "離諸形相，自得寂滅"}
{"id": null, "n": null, "target": null, "type": null, "text": "受持此經，功德無量"}
{"id": null, "n": null, "target": null, "type": null, "text": "若能清淨，業障盡消"}
{"id": null, "n": null, "target": null, "type": null, "text": "成佛究竟本無我相"}
{"id": null, "n": null, "target": null, "type": null, "text": "萬法歸一，更無異觀"}
{"id": null, "n": null, "target": null, "type": null, "text": "法身徧界，通化無邊"}
{"id": null, "n": null, "target": null, "type": null, "text": "色相皆妄，離妄見性"}
{"id": null, "n": null, "target": null, "type": null, "text": "法無可說，所說非法"}
{"id": null, "n": null, "target": null, "type": null, "text": "悟性空故，無法可得"}
{"id": null, "n": null, "target": null, "type": null, "text": "以清淨心行諸善法"}
{"id": null, "n": null, "target": null, "type": null, "text": "福智甚大，無物可比"}
{"id": null, "n": null, "target": null, "type": null, "text": "聖凡同性，化無所化"}
{"id": null, "n": null, "target": null, "type": null, "text": "清淨法身，非屬相貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "依法修持，不應斷滅"}
{"id": null, "n": null, "target": null, "type": null, "text": "一塵不染，何貪何受"}
{"id": null, "n": null, "target": null, "type": null, "text": "真性寂淨，不假威儀"}
{"id": null, "n": null, "target": null, "type": null, "text": "一合之理，實無有相"}
{"id": null, "n": null, "target": null, "type": null, "text": "如是知見法相不生"}
{"id": null, "n": null, "target": null, "type": null, "text": "應現設化，亦非真實"}
{"id": null, "n": null, "target": null, "type": null, "text": "音梭"}
{"id": null, "n": null, "target": null, "type": null, "text": "三稱"}
{"id": null, "n": null, "target": null, "type": null, "text": "畢"}
{"id": null, "n": "0734001", "target": "#nkr_note_orig_0734001", "type": "orig", "text": "人字可疑或是入之寫誤"}
{"id": null, "n": "0734002", "target": "#nkr_note_orig_0734002", "type": "orig", "text": "昔疑若"}
{"id": null, "n": "0734003", "target": "#nkr_note_orig_0734003", "type": "orig", "text": "解疑鮮"}
{"id": null, "n": "0734004", "target": "#nkr_note_orig_0734004", "type": "orig", "text": "各疑大"}
{"id": null, "n": "0737001", "target": "#nkr_note_orig_0737001", "type": "orig", "text": "維惟通歟"}
{"id": null, "n": "0744001", "target": "#nkr_note_orig_0744001", "type": "orig", "text": "日疑口"}
{"id": null, "n": "0746001", "target": "#nkr_note_orig_0746001", "type": "orig", "text": "來下當有說字"}
{"id": null, "n": "0747001", "target": "#nkr_note_orig_0747001", "type": "orig", "text": "稍字可疑"}
{"id": null, "n": "0749001", "target": "#nkr_note_orig_0749001", "type": "orig", "text": "食疑貪"}
{"id": null, "n": "0750001", "target": "#nkr_note_orig_0750001", "type": "orig", "text": "九字可疑"}
{"id": null, "n": "0750002", "target": "#nkr_note_orig_0750002", "type": "orig", "text": "波疑渡"}
{"id": null, "n": "0750003", "target": "#nkr_note_orig_0750003", "type": "orig", "text": "謂疑為"}
