{"id": null, "n": "0886014", "target": "#nkr_note_mod_0886014", "type": "mod", "text": "月氏國【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0886015", "target": "#nkr_note_mod_0886015", "type": "mod", "text": "釋【大】，獨【宋】"}
{"id": null, "n": "0886016", "target": "#nkr_note_mod_0886016", "type": "mod", "text": "瘦【大】＊，疲【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0886017", "target": "#nkr_note_mod_0886017", "type": "mod", "text": "露【大】＊，路【宋】【元】＊"}
{"id": null, "n": "0886018", "target": "#nkr_note_mod_0886018", "type": "mod", "text": "檀【大】＊，壇【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0886019", "target": "#nkr_note_mod_0886019", "type": "mod", "text": "加【大】，跏【宋】【元】【明】"}
{"id": null, "n": "0886020", "target": "#nkr_note_mod_0886020", "type": "mod", "text": "彼【大】，波【宋】【元】"}
{"id": null, "n": "0886021", "target": "#nkr_note_mod_0886021", "type": "mod", "text": "偈【大】，偈言【宋】【元】【明】"}
{"id": null, "n": "0886022", "target": "#nkr_note_mod_0886022", "type": "mod", "text": "心【大】，必【宋】【元】【明】"}
{"id": null, "n": "0886023", "target": "#nkr_note_mod_0886023", "type": "mod", "text": "三月【大】，二月【宋】【元】【明】"}
{"id": null, "n": "0886024", "target": "#nkr_note_mod_0886024", "type": "mod", "text": "加【CB】【麗-CB】【宋】【元】，跏【大】"}
{"id": null, "n": "0886025", "target": "#nkr_note_mod_0886025", "type": "mod", "text": "是【大】，是法【宋】【元】【明】"}
{"id": null, "n": "0886026", "target": "#nkr_note_mod_0886026", "type": "mod", "text": "等【大】，尊【宋】【元】【明】"}
{"id": null, "n": "0887001", "target": "#nkr_note_mod_0887001", "type": "mod", "text": "不【大】，不而【宋】【元】【明】"}
{"id": null, "n": "0887002", "target": "#nkr_note_mod_0887002", "type": "mod", "text": "住【大】，住痛【宋】【元】【明】"}
