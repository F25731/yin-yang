{"id": null, "n": "0522007", "target": "#nkr_note_mod_0522007", "type": "mod", "text": "佛說【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0522008", "target": "#nkr_note_mod_0522008", "type": "mod", "text": "月支【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0522009", "target": "#nkr_note_mod_0522009", "type": "mod", "text": "眾【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "0522010", "target": "#nkr_note_mod_0522010", "type": "mod", "text": "天【大】，天於【宋】【元】【明】【宮】"}
{"id": null, "n": "0522011", "target": "#nkr_note_mod_0522011", "type": "mod", "text": "音【大】，言【宋】"}
{"id": null, "n": "0523001", "target": "#nkr_note_mod_0523001", "type": "mod", "text": "時【大】，是【明】"}
{"id": null, "n": "0523002", "target": "#nkr_note_mod_0523002", "type": "mod", "text": "唯【大】，惟【宮】"}
{"id": null, "n": "0523003", "target": "#nkr_note_mod_0523003", "type": "mod", "text": "好【大】，妙【元】【明】"}
{"id": null, "n": "0523004", "target": "#nkr_note_mod_0523004", "type": "mod", "text": "輒【大】，輕【宋】【元】【明】【宮】"}
{"id": null, "n": "0523005", "target": "#nkr_note_mod_0523005", "type": "mod", "text": "殖【大】＊，植【明】＊"}
{"id": null, "n": "0523006", "target": "#nkr_note_mod_0523006", "type": "mod", "text": "抱【大】，懷抱【宋】【元】【明】【宮】"}
{"id": null, "n": "0523007", "target": "#nkr_note_mod_0523007", "type": "mod", "text": "稱【大】，稱計【宋】【元】【明】【宮】"}
{"id": null, "n": "0523008", "target": "#nkr_note_mod_0523008", "type": "mod", "text": "象【大】＊，像【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0523009", "target": "#nkr_note_mod_0523009", "type": "mod", "text": "揵【大】，犍【明】"}
{"id": null, "n": "0523010", "target": "#nkr_note_mod_0523010", "type": "mod", "text": "加【大】，跏【明】"}
{"id": null, "n": "0523011", "target": "#nkr_note_mod_0523011", "type": "mod", "text": "見【大】，現【宋】【元】【明】【宮】"}
{"id": null, "n": "0523012", "target": "#nkr_note_mod_0523012", "type": "mod", "text": "其【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0523013", "target": "#nkr_note_mod_0523013", "type": "mod", "text": "反【大】＊，返【宋】＊【元】"}
{"id": null, "n": "0523014", "target": "#nkr_note_mod_0523014", "type": "mod", "text": "於【大】，於其【宋】【元】【明】【宮】"}
{"id": null, "n": "0523015", "target": "#nkr_note_mod_0523015", "type": "mod", "text": "與【大】，與諸【宋】【元】【明】【宮】"}
{"id": null, "n": "0523016", "target": "#nkr_note_mod_0523016", "type": "mod", "text": "施【大】，於【元】【明】"}
{"id": null, "n": "0523017", "target": "#nkr_note_mod_0523017", "type": "mod", "text": "想【大】，相【宋】【元】【明】【宮】"}
{"id": null, "n": "0524001", "target": "#nkr_note_mod_0524001", "type": "mod", "text": "心【大】，意【宋】【宮】"}
{"id": null, "n": "0524002", "target": "#nkr_note_mod_0524002", "type": "mod", "text": "謂【大】，為【明】"}
{"id": null, "n": "0524003", "target": "#nkr_note_mod_0524003", "type": "mod", "text": "志【大】，去【宋】【元】【明】"}
{"id": null, "n": "0524004", "target": "#nkr_note_mod_0524004", "type": "mod", "text": "亹亹【大】，重疊【宮】"}
{"id": null, "n": "0524005", "target": "#nkr_note_mod_0524005", "type": "mod", "text": "見【大】，覩【元】【明】"}
{"id": null, "n": "0524006", "target": "#nkr_note_mod_0524006", "type": "mod", "text": "施【大】，世【明】"}
{"id": null, "n": "0524007", "target": "#nkr_note_mod_0524007", "type": "mod", "text": "是【大】，是是【宋】【元】【明】【宮】"}
{"id": null, "n": "0524008", "target": "#nkr_note_mod_0524008", "type": "mod", "text": "惡【大】，惡言【宋】【元】【明】【宮】"}
{"id": null, "n": "0524009", "target": "#nkr_note_mod_0524009", "type": "mod", "text": "懅【大】，懼【明】"}
{"id": null, "n": "0524010", "target": "#nkr_note_mod_0524010", "type": "mod", "text": "猛勇【大】，勇猛【明】"}
{"id": null, "n": "0524011", "target": "#nkr_note_mod_0524011", "type": "mod", "text": "若人曉了此【大】，於境常不動【宋】【元】【明】【宮】"}
{"id": null, "n": "0524012", "target": "#nkr_note_mod_0524012", "type": "mod", "text": "愛【大】，受【宮】"}
{"id": null, "n": "0524013", "target": "#nkr_note_mod_0524013", "type": "mod", "text": "所【大】，不【宮】"}
{"id": null, "n": "0524014", "target": "#nkr_note_mod_0524014", "type": "mod", "text": "猛勇【大】，勇猛【宋】【元】【明】【宮】"}
{"id": null, "n": "0524015", "target": "#nkr_note_mod_0524015", "type": "mod", "text": "反【大】＊，返【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0525001", "target": "#nkr_note_mod_0525001", "type": "mod", "text": "曰【大】，名曰【宋】【元】【明】【宮】"}
{"id": null, "n": "0525002", "target": "#nkr_note_mod_0525002", "type": "mod", "text": "不【大】，彼【元】【明】"}
{"id": null, "n": "0525003", "target": "#nkr_note_mod_0525003", "type": "mod", "text": "班【大】＊，頒【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0525004", "target": "#nkr_note_mod_0525004", "type": "mod", "text": "與【大】，興【宋】【元】【明】【宮】"}
{"id": null, "n": "0525005", "target": "#nkr_note_mod_0525005", "type": "mod", "text": "等【大】，能【明】"}
{"id": null, "n": "0525006", "target": "#nkr_note_mod_0525006", "type": "mod", "text": "可【大】，思【宋】【元】【明】【宮】"}
{"id": null, "n": "0525007", "target": "#nkr_note_mod_0525007", "type": "mod", "text": "來【大】，是【宋】【元】【明】【宮】"}
{"id": null, "n": "0525008", "target": "#nkr_note_mod_0525008", "type": "mod", "text": "是【大】，具【宋】【元】【明】【宮】"}
{"id": null, "n": "0525009", "target": "#nkr_note_mod_0525009", "type": "mod", "text": "語【大】，諸【宋】【元】【明】【宮】"}
{"id": null, "n": "0525010", "target": "#nkr_note_mod_0525010", "type": "mod", "text": "住【大】，主【宮】"}
{"id": null, "n": "0525011", "target": "#nkr_note_mod_0525011", "type": "mod", "text": "主【大】，王【宋】【元】【明】【宮】"}
{"id": null, "n": "0525012", "target": "#nkr_note_mod_0525012", "type": "mod", "text": "想【大】，起眾生想【宋】【元】【明】【宮】"}
{"id": null, "n": "0525013", "target": "#nkr_note_mod_0525013", "type": "mod", "text": "我【大】，吾我【宋】【元】【明】【宮】"}
{"id": null, "n": "0525014", "target": "#nkr_note_mod_0525014", "type": "mod", "text": "霑【大】，點【宋】【元】【明】【宮】"}
{"id": null, "n": "0525015", "target": "#nkr_note_mod_0525015", "type": "mod", "text": "觀【大】，覩【宋】【元】【明】【宮】"}
{"id": null, "n": "0526001", "target": "#nkr_note_mod_0526001", "type": "mod", "text": "鬼【大】，鬼神【元】【明】"}
{"id": null, "n": "0526002", "target": "#nkr_note_mod_0526002", "type": "mod", "text": "乾【大】，犍【明】"}
{"id": null, "n": "0526003", "target": "#nkr_note_mod_0526003", "type": "mod", "text": "何【大】，何謂【宋】【元】【明】【宮】"}
{"id": null, "n": "0526004", "target": "#nkr_note_mod_0526004", "type": "mod", "text": "見【大】＊，見也【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0526005", "target": "#nkr_note_mod_0526005", "type": "mod", "text": "化【大】，他【宋】【宮】"}
{"id": null, "n": "0526006", "target": "#nkr_note_mod_0526006", "type": "mod", "text": "弘【大】，加【宮】"}
{"id": null, "n": "0526007", "target": "#nkr_note_mod_0526007", "type": "mod", "text": "惟【大】，無【宮】"}
{"id": null, "n": "0526008", "target": "#nkr_note_mod_0526008", "type": "mod", "text": "所【大】，如所【宋】【元】【明】【宮】"}
{"id": null, "n": "0526009", "target": "#nkr_note_mod_0526009", "type": "mod", "text": "崖【大】，涯【元】【明】"}
{"id": null, "n": "0526010", "target": "#nkr_note_mod_0526010", "type": "mod", "text": "之【大】，道【宋】【元】【明】【宮】"}
{"id": null, "n": "0526011", "target": "#nkr_note_mod_0526011", "type": "mod", "text": "從【大】，順從【宋】【元】【明】【宮】"}
{"id": null, "n": "0526012", "target": "#nkr_note_mod_0526012", "type": "mod", "text": "所【大】，所說【宋】【元】【明】【宮】"}
{"id": null, "n": "0526013", "target": "#nkr_note_mod_0526013", "type": "mod", "text": "力【大】，法力【宋】【元】【明】【宮】"}
{"id": null, "n": "0526014", "target": "#nkr_note_mod_0526014", "type": "mod", "text": "刀【大】，力【宮】"}
{"id": null, "n": "0526015", "target": "#nkr_note_mod_0526015", "type": "mod", "text": "目【大】，自【元】【明】"}
{"id": null, "n": "0527001", "target": "#nkr_note_mod_0527001", "type": "mod", "text": "受【大】，即受【宋】【元】【明】【宮】"}
{"id": null, "n": "0527002", "target": "#nkr_note_mod_0527002", "type": "mod", "text": "也【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0527003", "target": "#nkr_note_mod_0527003", "type": "mod", "text": "曉【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "0527004", "target": "#nkr_note_mod_0527004", "type": "mod", "text": "性【大】，法【宋】【宮】"}
{"id": null, "n": "0527005", "target": "#nkr_note_mod_0527005", "type": "mod", "text": "一【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0527006", "target": "#nkr_note_mod_0527006", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0527007", "target": "#nkr_note_mod_0527007", "type": "mod", "text": "奉【大】，奏【宋】【宮】，湊【元】【明】"}
{"id": null, "n": "0527008", "target": "#nkr_note_mod_0527008", "type": "mod", "text": "諸【大】，說【宋】【宮】"}
{"id": null, "n": "0527009", "target": "#nkr_note_mod_0527009", "type": "mod", "text": "以【大】＊，已【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0527010", "target": "#nkr_note_mod_0527010", "type": "mod", "text": "本【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0527011", "target": "#nkr_note_mod_0527011", "type": "mod", "text": "起【大】＊，趣【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0527012", "target": "#nkr_note_mod_0527012", "type": "mod", "text": "芽【大】＊，牙【宋】【宮】＊"}
{"id": null, "n": "0527013", "target": "#nkr_note_mod_0527013", "type": "mod", "text": "然【大】，自然【宋】【元】【明】【宮】"}
{"id": null, "n": "0527014", "target": "#nkr_note_mod_0527014", "type": "mod", "text": "至【大】，〔－〕【元】【明】"}
{"id": null, "n": "0527015", "target": "#nkr_note_mod_0527015", "type": "mod", "text": "惟【大】，進【宋】"}
{"id": null, "n": "0527016", "target": "#nkr_note_mod_0527016", "type": "mod", "text": "是【大】，是則【元】【明】"}
{"id": null, "n": "0527017", "target": "#nkr_note_mod_0527017", "type": "mod", "text": "唯【大】，惟【宋】【元】【明】"}
{"id": null, "n": "0527018", "target": "#nkr_note_mod_0527018", "type": "mod", "text": "作【大】，所【宮】"}
{"id": null, "n": "0527019", "target": "#nkr_note_mod_0527019", "type": "mod", "text": "念【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0528001", "target": "#nkr_note_mod_0528001", "type": "mod", "text": "若【大】，則【宋】【元】【明】【宮】"}
{"id": null, "n": "0528002", "target": "#nkr_note_mod_0528002", "type": "mod", "text": "住【大】，徑【宋】【元】【明】【宮】"}
{"id": null, "n": "0528003", "target": "#nkr_note_mod_0528003", "type": "mod", "text": "顧【大】，墮【宋】【元】【明】【宮】"}
{"id": null, "n": "0528004", "target": "#nkr_note_mod_0528004", "type": "mod", "text": "有【大】，無【宋】【宮】"}
{"id": null, "n": "0528005", "target": "#nkr_note_mod_0528005", "type": "mod", "text": "行不有【大】，造證則【宋】"}
