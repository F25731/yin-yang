{"id": null, "n": "0855011", "target": "#nkr_note_mod_0855011", "type": "mod", "text": "已【大】＊，以【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0855012", "target": "#nkr_note_mod_0855012", "type": "mod", "text": "桓【大】＊，洹【宋】＊【元】＊【明】＊"}
