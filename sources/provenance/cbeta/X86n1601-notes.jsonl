{"id": null, "n": null, "target": null, "type": null, "text": "韶州"}
{"id": null, "n": null, "target": null, "type": null, "text": "連州"}
{"id": null, "n": null, "target": null, "type": null, "text": "廣州"}
{"id": null, "n": null, "target": null, "type": null, "text": "法裔別見"}
{"id": null, "n": null, "target": null, "type": null, "text": "法裔別見"}
{"id": null, "n": null, "target": null, "type": null, "text": "卍夾山等進本，為元封育王、開聖、上方、四明、夾山、靈峯、公安之列次。"}
{"id": null, "n": null, "target": null, "type": null, "text": "廬山"}
{"id": null, "n": null, "target": null, "type": null, "text": "眉州"}
{"id": null, "n": null, "target": null, "type": null, "text": "法裔別見"}
{"id": null, "n": null, "target": null, "type": null, "text": "法裔別見"}
{"id": null, "n": null, "target": null, "type": null, "text": "西川"}
{"id": null, "n": null, "target": null, "type": null, "text": "十世"}
{"id": null, "n": null, "target": null, "type": null, "text": "卍進本十世為四世，已下遞次準之。"}
{"id": null, "n": null, "target": null, "type": null, "text": "十一世"}
{"id": null, "n": null, "target": null, "type": null, "text": "十二世"}
{"id": null, "n": null, "target": null, "type": null, "text": "十三世"}
{"id": null, "n": null, "target": null, "type": null, "text": "卍進本雪竇為四世，已下遞次準之。"}
{"id": null, "n": null, "target": null, "type": null, "text": "十世"}
{"id": null, "n": null, "target": null, "type": null, "text": "卍進本十世為四世，已下󳯝次準之。"}
{"id": null, "n": null, "target": null, "type": null, "text": "十一世"}
{"id": null, "n": null, "target": null, "type": null, "text": "十二世"}
{"id": null, "n": null, "target": null, "type": null, "text": "十三世"}
{"id": null, "n": null, "target": null, "type": null, "text": "十四世"}
{"id": null, "n": null, "target": null, "type": null, "text": "十四世"}
{"id": null, "n": null, "target": null, "type": null, "text": "卍進本不附世代"}
{"id": null, "n": null, "target": null, "type": null, "text": "十五世"}
{"id": null, "n": null, "target": null, "type": null, "text": "十六世"}
