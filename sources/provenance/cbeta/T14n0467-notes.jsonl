{"id": null, "n": "0489005", "target": "#nkr_note_mod_0489005", "type": "mod", "text": "大【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0489006", "target": "#nkr_note_mod_0489006", "type": "mod", "text": "天竺三藏【大】，南天竺國三藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0489007", "target": "#nkr_note_mod_0489007", "type": "mod", "text": "流【大】，留【宋】【宮】"}
{"id": null, "n": "0489008", "target": "#nkr_note_mod_0489008", "type": "mod", "text": "志【大】，志等【宋】【元】【明】【宮】"}
{"id": null, "n": "0489009", "target": "#nkr_note_mod_0489009", "type": "mod", "text": "譯【大】，第四譯【元】【明】"}
{"id": null, "n": "0490001", "target": "#nkr_note_mod_0490001", "type": "mod", "text": "惟【大】，唯【元】【明】"}
{"id": null, "n": "0490002", "target": "#nkr_note_mod_0490002", "type": "mod", "text": "人【大】，又【宋】"}
{"id": null, "n": "0490003", "target": "#nkr_note_mod_0490003", "type": "mod", "text": "爾【大】，又爾【宋】"}
{"id": null, "n": "0490004", "target": "#nkr_note_mod_0490004", "type": "mod", "text": "牙【大】，芽【元】【明】【宮】"}
{"id": null, "n": "0490005", "target": "#nkr_note_mod_0490005", "type": "mod", "text": "善【大】，善知【宋】【元】【明】【宮】"}
{"id": null, "n": "0491001", "target": "#nkr_note_mod_0491001", "type": "mod", "text": "辯【大】，辨【宋】【元】【明】【宮】"}
{"id": null, "n": "0491002", "target": "#nkr_note_mod_0491002", "type": "mod", "text": "惟【大】，唯【宋】【元】【明】【宮】"}
{"id": null, "n": "0492001", "target": "#nkr_note_mod_0492001", "type": "mod", "text": "失【大】，去【宋】【宮】"}
