{"id": null, "n": null, "target": null, "type": null, "text": "圖矣"}
{"id": null, "n": null, "target": null, "type": null, "text": "清徹"}
{"id": null, "n": null, "target": null, "type": null, "text": "山也"}
{"id": null, "n": null, "target": null, "type": null, "text": "特舊蜀王"}
{"id": null, "n": null, "target": null, "type": null, "text": "休息"}
{"id": null, "n": null, "target": null, "type": null, "text": "自取而食亦同盜相"}
{"id": null, "n": null, "target": null, "type": null, "text": "倘有失脫\n不干比丘"}
{"id": null, "n": null, "target": null, "type": null, "text": "出家自取非是高勝"}
{"id": null, "n": null, "target": null, "type": null, "text": "若當不受非同儉素"}
{"id": null, "n": null, "target": null, "type": null, "text": "見受而食外道生信"}
{"id": null, "n": null, "target": null, "type": null, "text": "第四百四十三"}
{"id": null, "n": null, "target": null, "type": null, "text": "所之"}
{"id": null, "n": null, "target": null, "type": null, "text": "以日"}
{"id": null, "n": null, "target": null, "type": null, "text": "故知空祭鬼神欲求現福難可得力也"}
{"id": null, "n": null, "target": null, "type": null, "text": "又治故塔亦得延命又治補伽藍墻\n壁泥孔亦得延命也"}
{"id": null, "n": null, "target": null, "type": null, "text": "苦也"}
{"id": null, "n": null, "target": null, "type": null, "text": "知識"}
{"id": null, "n": null, "target": null, "type": null, "text": "異生舊名凢夫"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
