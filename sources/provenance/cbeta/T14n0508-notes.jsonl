{"id": null, "n": "0775020", "target": "#nkr_note_mod_0775020", "type": "mod", "text": "沙門【大】，釋【宋】【元】【明】【宮】"}
{"id": null, "n": "0775021", "target": "#nkr_note_mod_0775021", "type": "mod", "text": "王【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0776001", "target": "#nkr_note_mod_0776001", "type": "mod", "text": "毱【大】，鞠【宮】"}
{"id": null, "n": "0776002", "target": "#nkr_note_mod_0776002", "type": "mod", "text": "劫中【大】，中劫【宋】【元】【宮】"}
{"id": null, "n": "0776003", "target": "#nkr_note_mod_0776003", "type": "mod", "text": "𣽈【大】，鈍【宋】【元】【明】【宮】"}
{"id": null, "n": "0776004", "target": "#nkr_note_mod_0776004", "type": "mod", "text": "何【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0776005", "target": "#nkr_note_mod_0776005", "type": "mod", "text": "日到時【大】，時到【宋】【元】【明】【宮】"}
{"id": null, "n": "0776006", "target": "#nkr_note_mod_0776006", "type": "mod", "text": "毱【大】，鞠【宋】【元】【宮】"}
{"id": null, "n": "0776007", "target": "#nkr_note_mod_0776007", "type": "mod", "text": "而【大】，面【宋】【元】【明】"}
{"id": null, "n": "0776008", "target": "#nkr_note_mod_0776008", "type": "mod", "text": "言【大】，言言【宋】【元】【明】【宮】"}
{"id": null, "n": "0776009", "target": "#nkr_note_mod_0776009", "type": "mod", "text": "毱【大】，鞠【宮】"}
{"id": null, "n": "0776010", "target": "#nkr_note_mod_0776010", "type": "mod", "text": "天【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0776011", "target": "#nkr_note_mod_0776011", "type": "mod", "text": "汝往耆域【大】，耆域汝往【宋】【元】【明】"}
{"id": null, "n": "0777001", "target": "#nkr_note_mod_0777001", "type": "mod", "text": "日【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0777002", "target": "#nkr_note_mod_0777002", "type": "mod", "text": "阿【大】，佛說阿【宋】【元】【宮】"}
{"id": null, "n": "0775020", "target": "#nkr_note_orig_0775020", "type": "orig", "text": "沙門＝釋【三】【宮】"}
{"id": null, "n": "0775021", "target": "#nkr_note_orig_0775021", "type": "orig", "text": "〔王〕－【三】【宮】"}
{"id": null, "n": "0776001", "target": "#nkr_note_orig_0776001", "type": "orig", "text": "毱＝鞠【宮】"}
{"id": null, "n": "0776002", "target": "#nkr_note_orig_0776002", "type": "orig", "text": "劫中＝中劫【宋】【元】【宮】"}
{"id": null, "n": "0776003", "target": "#nkr_note_orig_0776003", "type": "orig", "text": "𣽈＝鈍【三】【宮】"}
{"id": null, "n": "0776004", "target": "#nkr_note_orig_0776004", "type": "orig", "text": "〔何〕－【三】【宮】"}
{"id": null, "n": "0776005", "target": "#nkr_note_orig_0776005", "type": "orig", "text": "日到時＝時到【三】【宮】"}
{"id": null, "n": "0776006", "target": "#nkr_note_orig_0776006", "type": "orig", "text": "毱＝鞠【宋】【元】【宮】"}
{"id": null, "n": "0776007", "target": "#nkr_note_orig_0776007", "type": "orig", "text": "而＝面【三】"}
{"id": null, "n": "0776008", "target": "#nkr_note_orig_0776008", "type": "orig", "text": "言＋（言）【三】【宮】"}
{"id": null, "n": "0776009", "target": "#nkr_note_orig_0776009", "type": "orig", "text": "毱＝鞠【宮】"}
{"id": null, "n": "0776010", "target": "#nkr_note_orig_0776010", "type": "orig", "text": "〔天〕－【三】【宮】"}
{"id": null, "n": "0776011", "target": "#nkr_note_orig_0776011", "type": "orig", "text": "汝往耆域＝耆域汝往【三】"}
{"id": null, "n": "0777001", "target": "#nkr_note_orig_0777001", "type": "orig", "text": "〔日〕－【三】【宮】"}
{"id": null, "n": "0777002", "target": "#nkr_note_orig_0777002", "type": "orig", "text": "（佛說）＋阿【宋】【元】【宮】"}
