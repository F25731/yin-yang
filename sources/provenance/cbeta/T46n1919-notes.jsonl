{"id": null, "n": "0581002", "target": "#nkr_note_mod_0581002", "type": "mod", "text": "還【大】，遠【甲】"}
{"id": null, "n": "0582001", "target": "#nkr_note_mod_0582001", "type": "mod", "text": "太【大】，大【甲】"}
{"id": null, "n": "0582002", "target": "#nkr_note_mod_0582002", "type": "mod", "text": "趣【大】，輙【甲】"}
{"id": null, "n": "0583001", "target": "#nkr_note_mod_0583001", "type": "mod", "text": "知【大】，如【甲】"}
{"id": null, "n": "0584001", "target": "#nkr_note_mod_0584001", "type": "mod", "text": "和【大】，於【甲】"}
{"id": null, "n": "0584002", "target": "#nkr_note_mod_0584002", "type": "mod", "text": "訣【大】，訣終【甲】"}
{"id": null, "n": "0581001", "target": "#nkr_note_orig_0581001", "type": "orig", "text": "【原】萬曆十八年刊增上寺報恩藏本，【甲】延寶三年刊大谷大學藏本"}
{"id": null, "n": "0581002", "target": "#nkr_note_orig_0581002", "type": "orig", "text": "還＝遠【甲】"}
{"id": null, "n": "0582001", "target": "#nkr_note_orig_0582001", "type": "orig", "text": "太＝大【甲】"}
{"id": null, "n": "0582002", "target": "#nkr_note_orig_0582002", "type": "orig", "text": "趣＝輙【甲】"}
{"id": null, "n": "0582003", "target": "#nkr_note_orig_0582003", "type": "orig", "text": "原本註曰跋南藏作提"}
{"id": null, "n": "0583001", "target": "#nkr_note_orig_0583001", "type": "orig", "text": "知＝如【甲】"}
{"id": null, "n": "0584001", "target": "#nkr_note_orig_0584001", "type": "orig", "text": "和＝於【甲】"}
{"id": null, "n": "0584002", "target": "#nkr_note_orig_0584002", "type": "orig", "text": "訣＋（終）【甲】"}
