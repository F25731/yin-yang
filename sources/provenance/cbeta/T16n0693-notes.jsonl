{"id": null, "n": "0788018", "target": "#nkr_note_mod_0788018", "type": "mod", "text": "闕【大】，失【宋】【元】【明】【宮】"}
{"id": null, "n": "0788019", "target": "#nkr_note_mod_0788019", "type": "mod", "text": "人名【大】，〔－〕【宋】【宮】，師名【元】【明】"}
{"id": null, "n": "0788020", "target": "#nkr_note_mod_0788020", "type": "mod", "text": "懼【大】，瞿【宋】【元】【明】【宮】"}
{"id": null, "n": "0788021", "target": "#nkr_note_mod_0788021", "type": "mod", "text": "主【大】，王【元】【明】"}
{"id": null, "n": "0789001", "target": "#nkr_note_mod_0789001", "type": "mod", "text": "也【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0789002", "target": "#nkr_note_mod_0789002", "type": "mod", "text": "年少【大】，少年【宋】【元】【明】【宮】"}
{"id": null, "n": "0789003", "target": "#nkr_note_mod_0789003", "type": "mod", "text": "政【大】＊，正【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0789004", "target": "#nkr_note_mod_0789004", "type": "mod", "text": "濡【大】，軟【宋】【元】【明】【宮】"}
{"id": null, "n": "0789005", "target": "#nkr_note_mod_0789005", "type": "mod", "text": "復【大】，復於【宋】【元】【明】【宮】"}
{"id": null, "n": "0789006", "target": "#nkr_note_mod_0789006", "type": "mod", "text": "共【大】，恭【宋】【元】【明】【宮】"}
{"id": null, "n": "0789007", "target": "#nkr_note_mod_0789007", "type": "mod", "text": "在【大】，生【宋】【元】【明】【宮】"}
{"id": null, "n": "0789008", "target": "#nkr_note_mod_0789008", "type": "mod", "text": "來下【大】，下來【宋】【元】【明】【宮】"}
{"id": null, "n": "0789009", "target": "#nkr_note_mod_0789009", "type": "mod", "text": "妙【大】，好【宋】【元】【明】【宮】"}
{"id": null, "n": "0789010", "target": "#nkr_note_mod_0789010", "type": "mod", "text": "護【大】，求【明】"}
{"id": null, "n": "0789011", "target": "#nkr_note_mod_0789011", "type": "mod", "text": "土【大】，士【宋】【元】【明】【宮】"}
{"id": null, "n": "0789012", "target": "#nkr_note_mod_0789012", "type": "mod", "text": "報【大】，視【宋】【元】【明】【宮】"}
{"id": null, "n": "0789013", "target": "#nkr_note_mod_0789013", "type": "mod", "text": "妙【大】，如【宋】【元】【明】【宮】"}
{"id": null, "n": "0789014", "target": "#nkr_note_mod_0789014", "type": "mod", "text": "時苦【大】，苦時【宋】【元】【宮】"}
{"id": null, "n": "0789015", "target": "#nkr_note_mod_0789015", "type": "mod", "text": "稱【大】，秤【宋】【元】【明】【宮】"}
