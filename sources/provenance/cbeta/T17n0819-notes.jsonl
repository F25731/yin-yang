{"id": null, "n": "0833005", "target": "#nkr_note_mod_0833005", "type": "mod", "text": "佛說【大】＊，〔－〕【宋】【宮】＊"}
{"id": null, "n": "0833006", "target": "#nkr_note_mod_0833006", "type": "mod", "text": "（僧祐…錄）十六字【大】，失譯【宋】，出安祐二錄開元錄云今附西晉錄【元】【明】，安公失譯【宮】"}
{"id": null, "n": "0833007", "target": "#nkr_note_mod_0833007", "type": "mod", "text": "在【大】，存【宋】【元】【明】【宮】"}
{"id": null, "n": "0833008", "target": "#nkr_note_mod_0833008", "type": "mod", "text": "習【大】，集【明】"}
{"id": null, "n": "0833009", "target": "#nkr_note_mod_0833009", "type": "mod", "text": "滅【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0833010", "target": "#nkr_note_mod_0833010", "type": "mod", "text": "輒【大】，轉【明】"}
{"id": null, "n": "0834001", "target": "#nkr_note_mod_0834001", "type": "mod", "text": "以【大】，更以【宋】【元】【明】【宮】"}
{"id": null, "n": "0834002", "target": "#nkr_note_mod_0834002", "type": "mod", "text": "聞佛所說歡喜奉行【大】，阿須倫聞經歡喜皆前為佛作禮而去【宋】【元】【明】【宮】"}
{"id": null, "n": "0833005", "target": "#nkr_note_orig_0833005", "type": "orig", "text": "〔佛說〕－【宋】【宮】＊"}
{"id": null, "n": "0833006", "target": "#nkr_note_orig_0833006", "type": "orig", "text": "（（僧祐…錄））十六字＝（（失譯））二字【宋】，（（出安祐二錄開元錄云今附西晉錄））十四字【元】【明】，（（安公失譯））四字【宮】"}
{"id": null, "n": "0833007", "target": "#nkr_note_orig_0833007", "type": "orig", "text": "在＝存【三】【宮】"}
{"id": null, "n": "0833008", "target": "#nkr_note_orig_0833008", "type": "orig", "text": "習＝集【明】"}
{"id": null, "n": "0833009", "target": "#nkr_note_orig_0833009", "type": "orig", "text": "〔滅〕－【三】【宮】"}
{"id": null, "n": "0833010", "target": "#nkr_note_orig_0833010", "type": "orig", "text": "輒＝轉【明】"}
{"id": null, "n": "0834001", "target": "#nkr_note_orig_0834001", "type": "orig", "text": "（更）＋以【三】【宮】"}
{"id": null, "n": "0834002", "target": "#nkr_note_orig_0834002", "type": "orig", "text": "聞佛所說歡喜奉行＝阿須倫聞經歡喜皆前為佛作禮而去【三】【宮】"}
