{"id": null, "n": "0176006", "target": "#nkr_note_mod_0176006", "type": "mod", "text": "（亦名…譯）五十八字【大】，〔－〕【甲】"}
{"id": null, "n": "0176007", "target": "#nkr_note_mod_0176007", "type": "mod", "text": "一卷【大】，〔－〕【明】【甲】【乙】"}
{"id": null, "n": "0176008", "target": "#nkr_note_mod_0176008", "type": "mod", "text": "（開府…譯）四十六字【大】，唐北天竺三藏沙門大廣智不空奉詔譯【明】【乙】【丙】"}
{"id": null, "n": "0176009", "target": "#nkr_note_mod_0176009", "type": "mod", "text": "曩莫【大】＊，南麼【甲】＊"}
{"id": null, "n": "0176010", "target": "#nkr_note_mod_0176010", "type": "mod", "text": "難唵【大】，南一唵二【明】，南唵【甲】，南一【乙】【丙】"}
{"id": null, "n": "0176011", "target": "#nkr_note_mod_0176011", "type": "mod", "text": "三【大】，〔－〕【甲】"}
{"id": null, "n": "0176012", "target": "#nkr_note_mod_0176012", "type": "mod", "text": "三摩曳【大】，三摩耶【明】，三麼曳【甲】"}
{"id": null, "n": "0176013", "target": "#nkr_note_mod_0176013", "type": "mod", "text": "（娑嚩…引）七字【大】，莎訶【甲】"}
{"id": null, "n": "0176014", "target": "#nkr_note_mod_0176014", "type": "mod", "text": "引【大】，引四【明】"}
{"id": null, "n": "0176015", "target": "#nkr_note_mod_0176015", "type": "mod", "text": "齊【大】＊，臍【明】【乙】【丙】＊"}
{"id": null, "n": "0176016", "target": "#nkr_note_mod_0176016", "type": "mod", "text": "不動聖【大】，無動尊【甲】【乙】"}
{"id": null, "n": "0176017", "target": "#nkr_note_mod_0176017", "type": "mod", "text": "嚩日囉二合【大】，伐折囉【甲】"}
{"id": null, "n": "0176018", "target": "#nkr_note_mod_0176018", "type": "mod", "text": "引一【大】，〔－〕【甲】"}
{"id": null, "n": "0176019", "target": "#nkr_note_mod_0176019", "type": "mod", "text": "摩賀引【大】，摩訶【甲】"}
{"id": null, "n": "0176020", "target": "#nkr_note_mod_0176020", "type": "mod", "text": "曬【大】，灑【甲】【乙】【丙】"}
{"id": null, "n": "0176021", "target": "#nkr_note_mod_0176021", "type": "mod", "text": "二【大】，〔－〕【甲】"}
{"id": null, "n": "0176022", "target": "#nkr_note_mod_0176022", "type": "mod", "text": "娑頗【大】，薩頗【甲】，頗字下甲本夾註二字不明"}
{"id": null, "n": "0176023", "target": "#nkr_note_mod_0176023", "type": "mod", "text": "吒野三【大】，吒耶【甲】"}
{"id": null, "n": "0176024", "target": "#nkr_note_mod_0176024", "type": "mod", "text": "（吒半…五）九字【大】，唅引𤚥引【甲】"}
{"id": null, "n": "0176025", "target": "#nkr_note_mod_0176025", "type": "mod", "text": "是【大】，之【甲】"}
{"id": null, "n": "0176026", "target": "#nkr_note_mod_0176026", "type": "mod", "text": "說【大】，以【甲】"}
{"id": null, "n": "0176027", "target": "#nkr_note_mod_0176027", "type": "mod", "text": "（一切眾聖主）【大】∞（依本誓而來）【甲】，一＝上ィ【甲】"}
{"id": null, "n": "0176028", "target": "#nkr_note_mod_0176028", "type": "mod", "text": "聖【大】，生【明】"}
{"id": null, "n": "0176029", "target": "#nkr_note_mod_0176029", "type": "mod", "text": "（依本誓而來）【大】∞（一切眾聖主）【甲】，依＝下ィ【甲】"}
{"id": null, "n": "0176030", "target": "#nkr_note_mod_0176030", "type": "mod", "text": "南【大】，南一【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": "0176031", "target": "#nkr_note_mod_0176031", "type": "mod", "text": "薩嚩【大】，薩娑【甲】"}
{"id": null, "n": "0176032", "target": "#nkr_note_mod_0176032", "type": "mod", "text": "合【大】，合二【明】"}
{"id": null, "n": "0176033", "target": "#nkr_note_mod_0176033", "type": "mod", "text": "引【大】，〔－〕【甲】"}
{"id": null, "n": "0176034", "target": "#nkr_note_mod_0176034", "type": "mod", "text": "囉【大】，剌【甲】"}
{"id": null, "n": "0176035", "target": "#nkr_note_mod_0176035", "type": "mod", "text": "賀【大】，喝【甲】"}
{"id": null, "n": "0176036", "target": "#nkr_note_mod_0176036", "type": "mod", "text": "多【大】，多三【明】，帝【乙】【丙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": "0176037", "target": "#nkr_note_mod_0176037", "type": "mod", "text": "薩【大】，孽【明】【乙】【丙】，揭【甲】"}
{"id": null, "n": "0176038", "target": "#nkr_note_mod_0176038", "type": "mod", "text": "四【大】，〔－〕【甲】"}
{"id": null, "n": "0176039", "target": "#nkr_note_mod_0176039", "type": "mod", "text": "冒地拶【大】，菩地遮【甲】"}
{"id": null, "n": "0176040", "target": "#nkr_note_mod_0176040", "type": "mod", "text": "唎【大】，利【甲】"}
{"id": null, "n": "0176041", "target": "#nkr_note_mod_0176041", "type": "mod", "text": "聲【大】，〔－〕【甲】"}
{"id": null, "n": "0176042", "target": "#nkr_note_mod_0176042", "type": "mod", "text": "半音【大】，〔－〕【甲】"}
{"id": null, "n": "0176043", "target": "#nkr_note_mod_0176043", "type": "mod", "text": "引【大】，引五【明】，〔－〕【甲】"}
{"id": null, "n": "0176044", "target": "#nkr_note_mod_0176044", "type": "mod", "text": "現【大】，視【乙】"}
{"id": null, "n": "0176045", "target": "#nkr_note_mod_0176045", "type": "mod", "text": "時【大】，切【甲】【乙】"}
{"id": null, "n": "0176046", "target": "#nkr_note_mod_0176046", "type": "mod", "text": "一【大】，〔－〕【甲】"}
{"id": null, "n": "0176047", "target": "#nkr_note_mod_0176047", "type": "mod", "text": "平聲【大】，平聲二【明】，〔－〕【甲】"}
{"id": null, "n": "0176048", "target": "#nkr_note_mod_0176048", "type": "mod", "text": "嗢【大】，溫【明】【乙】【丙】"}
{"id": null, "n": "0176049", "target": "#nkr_note_mod_0176049", "type": "mod", "text": "孽二合【大】，薩【甲】"}
{"id": null, "n": "0176050", "target": "#nkr_note_mod_0176050", "type": "mod", "text": "諦【大】，諦三【明】，底【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": "0176051", "target": "#nkr_note_mod_0176051", "type": "mod", "text": "二合【大】，〔－〕【明】"}
{"id": null, "n": "0176052", "target": "#nkr_note_mod_0176052", "type": "mod", "text": "呬【大】，〔－〕【明】【甲】【乙】【丙】"}
{"id": null, "n": "0176053", "target": "#nkr_note_mod_0176053", "type": "mod", "text": "𤚥【大】，𤚥四【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "四"}
{"id": null, "n": "0176054", "target": "#nkr_note_mod_0176054", "type": "mod", "text": "平聲呼【大】，平聲【明】，〔－〕【甲】"}
{"id": null, "n": "0176055", "target": "#nkr_note_mod_0176055", "type": "mod", "text": "（娑嚩…訶）六字【大】，娑嚩訶引五【明】，莎訶【甲】"}
{"id": null, "n": "0176056", "target": "#nkr_note_mod_0176056", "type": "mod", "text": "言【大】，言曰【明】"}
{"id": null, "n": "0176057", "target": "#nkr_note_mod_0176057", "type": "mod", "text": "嚩【大】，嚩日【明】【乙】【丙】，伐折【甲】"}
{"id": null, "n": "0176058", "target": "#nkr_note_mod_0176058", "type": "mod", "text": "二合【大】，〔－〕【甲】"}
{"id": null, "n": "0176059", "target": "#nkr_note_mod_0176059", "type": "mod", "text": "𧹞【大】，𧹞一【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": "0176060", "target": "#nkr_note_mod_0176060", "type": "mod", "text": "嚩日囉二合【大】，伐折囉【甲】"}
{"id": null, "n": "0176061", "target": "#nkr_note_mod_0176061", "type": "mod", "text": "者【大】，啫【明】"}
{"id": null, "n": "0176062", "target": "#nkr_note_mod_0176062", "type": "mod", "text": "吽【大】，吽二【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": "0176063", "target": "#nkr_note_mod_0176063", "type": "mod", "text": "右【大】，左【甲】"}
{"id": null, "n": "0176064", "target": "#nkr_note_mod_0176064", "type": "mod", "text": "備【大】，被【明】"}
{"id": null, "n": "0176065", "target": "#nkr_note_mod_0176065", "type": "mod", "text": "真言及本契【大】，真語母陀羅【甲】"}
{"id": null, "n": "0176066", "target": "#nkr_note_mod_0176066", "type": "mod", "text": "如前【大】，前如【明】"}
{"id": null, "n": "0176067", "target": "#nkr_note_mod_0176067", "type": "mod", "text": "再【大】，載【明】"}
{"id": null, "n": "0176068", "target": "#nkr_note_mod_0176068", "type": "mod", "text": "跏【大】，加【明】【甲】"}
{"id": null, "n": "0176069", "target": "#nkr_note_mod_0176069", "type": "mod", "text": "方【大】，力【甲】"}
{"id": null, "n": "0177001", "target": "#nkr_note_mod_0177001", "type": "mod", "text": "覩【大】，現【明】【乙】【丙】"}
{"id": null, "n": "0177002", "target": "#nkr_note_mod_0177002", "type": "mod", "text": "瑕玷【大】，假照【甲】"}
{"id": null, "n": "0177003", "target": "#nkr_note_mod_0177003", "type": "mod", "text": "如【大】，妙【明】【甲】【乙】【丙】"}
{"id": null, "n": "0177004", "target": "#nkr_note_mod_0177004", "type": "mod", "text": "妙縠【大】，絹縠【甲】"}
{"id": null, "n": "0177005", "target": "#nkr_note_mod_0177005", "type": "mod", "text": "顏【大】，形【甲】"}
{"id": null, "n": "0177006", "target": "#nkr_note_mod_0177006", "type": "mod", "text": "等【大】，尊【甲】"}
{"id": null, "n": "0177007", "target": "#nkr_note_mod_0177007", "type": "mod", "text": "無相淨法體【大】，無法相淨體【甲】"}
{"id": null, "n": "0177008", "target": "#nkr_note_mod_0177008", "type": "mod", "text": "限數既終畢【大】∞懈極後方已【明】【甲】"}
{"id": null, "n": "0177009", "target": "#nkr_note_mod_0177009", "type": "mod", "text": "懈極後方已【大】∞限數既終畢【明】【甲】"}
{"id": null, "n": "0177010", "target": "#nkr_note_mod_0177010", "type": "mod", "text": "慇【大】，殷【乙】【丙】"}
{"id": null, "n": "0177011", "target": "#nkr_note_mod_0177011", "type": "mod", "text": "禮【大】，辭【甲】【乙】"}
{"id": null, "n": "0177012", "target": "#nkr_note_mod_0177012", "type": "mod", "text": "力【大】，刀【校異-甲】，刀【乙】【丙】"}
{"id": null, "n": "0177013", "target": "#nkr_note_mod_0177013", "type": "mod", "text": "（心送…初）二十字【大】，〔－〕【甲】"}
{"id": null, "n": "0177014", "target": "#nkr_note_mod_0177014", "type": "mod", "text": "讚【大】，瀆【甲】，讀【校異-甲】，讀【乙】【丙】"}
{"id": null, "n": "0177015", "target": "#nkr_note_mod_0177015", "type": "mod", "text": "飾【大】，拭【明】【乙】【丙】，成【甲】"}
{"id": null, "n": "0177016", "target": "#nkr_note_mod_0177016", "type": "mod", "text": "注【大】，住【甲】"}
{"id": null, "n": "0177017", "target": "#nkr_note_mod_0177017", "type": "mod", "text": "成【大】，威【明】"}
{"id": null, "n": "0177018", "target": "#nkr_note_mod_0177018", "type": "mod", "text": "伽【大】，祇【明】【甲】【乙】【丙】"}
{"id": null, "n": "0177020", "target": "#nkr_note_mod_0177020", "type": "mod", "text": "（大日…法）十字【大】，大日瑜伽經【甲】"}
{"id": null, "n": "0177021", "target": "#nkr_note_mod_0177021", "type": "mod", "text": "一卷【大】，〔－〕【明】【乙】【丙】"}
{"id": null, "n": "0176005", "target": "#nkr_note_orig_0176005", "type": "orig", "text": "【原】麗本，【甲】平安時代寫高山寺藏本，【乙】黃蘗板淨嚴等校訂加筆本，【丙】縮冊大藏經"}
