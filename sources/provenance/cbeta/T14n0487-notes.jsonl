{"id": null, "n": "0698005", "target": "#nkr_note_mod_0698005", "type": "mod", "text": "（終南…撰）八字【大】，宣律師製序綴文【宋】【宮】，唐終南山沙門釋宣撰【元】【明】"}
{"id": null, "n": "0698006", "target": "#nkr_note_mod_0698006", "type": "mod", "text": "籍【大】，藉【宋】【元】【明】【宮】"}
{"id": null, "n": "0698007", "target": "#nkr_note_mod_0698007", "type": "mod", "text": "三【大】，二【元】【明】"}
{"id": null, "n": "0698008", "target": "#nkr_note_mod_0698008", "type": "mod", "text": "云【大】，示【宮】"}
{"id": null, "n": "0698009", "target": "#nkr_note_mod_0698009", "type": "mod", "text": "大唐三藏【大】，唐天竺三藏【宋】【宮】，唐中天竺三藏法師【元】【明】"}
{"id": null, "n": "0699001", "target": "#nkr_note_mod_0699001", "type": "mod", "text": "唯【大】＊，惟【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0699002", "target": "#nkr_note_mod_0699002", "type": "mod", "text": "誷【大】，惘【宋】【宮】"}
{"id": null, "n": "0699003", "target": "#nkr_note_mod_0699003", "type": "mod", "text": "上【大】，尚【明】"}
{"id": null, "n": "0699004", "target": "#nkr_note_mod_0699004", "type": "mod", "text": "行【大】，有【宮】"}
{"id": null, "n": "0700001", "target": "#nkr_note_mod_0700001", "type": "mod", "text": "重【大】，而【宋】【元】【明】【宮】"}
{"id": null, "n": "0700002", "target": "#nkr_note_mod_0700002", "type": "mod", "text": "伎【大】，技【元】【明】"}
{"id": null, "n": "0700003", "target": "#nkr_note_mod_0700003", "type": "mod", "text": "戒【大】，威【宋】【元】【明】【宮】"}
{"id": null, "n": "0700004", "target": "#nkr_note_mod_0700004", "type": "mod", "text": "念受【CB】【麗-CB】【宮】，受念【大】"}
