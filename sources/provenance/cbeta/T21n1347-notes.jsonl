{"id": null, "n": null, "target": null, "type": null, "text": "如來形像如胡麻量遍滿一切又彼十方一一如來同共發聲乃說呪曰"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0860002", "target": "#nkr_note_mod_0860002", "type": "mod", "text": "西【大】，宋西【明】"}
{"id": null, "n": "0860003", "target": "#nkr_note_mod_0860003", "type": "mod", "text": "帝釋宮寺【大】，〔－〕【明】"}
{"id": null, "n": "0860004", "target": "#nkr_note_mod_0860004", "type": "mod", "text": "沙門臣【大】，〔－〕【明】"}
{"id": null, "n": "0860005", "target": "#nkr_note_mod_0860005", "type": "mod", "text": "各【大】，名【宋】【元】"}
{"id": null, "n": "0860006", "target": "#nkr_note_mod_0860006", "type": "mod", "text": "說【大】，語【宋】【元】【明】"}
{"id": null, "n": "0860007", "target": "#nkr_note_mod_0860007", "type": "mod", "text": "踴【大】，踊【宋】【元】【明】"}
{"id": null, "n": "0860008", "target": "#nkr_note_mod_0860008", "type": "mod", "text": "如來形像如胡麻量遍滿一切又彼十方一一如來同共發聲乃說呪曰【大】，如來形像如胡麻量遍滿一切又彼十方一一如來同共發聲乃說呪曰【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "如來形像如胡麻量遍滿一切又彼十方一一如來同共發聲乃說呪曰"}
{"id": null, "n": "0860009", "target": "#nkr_note_mod_0860009", "type": "mod", "text": "傑【大】，搩【宋】【元】【明】"}
{"id": null, "n": "0860010", "target": "#nkr_note_mod_0860010", "type": "mod", "text": "反【大】＊，切【明】＊"}
{"id": null, "n": "0860011", "target": "#nkr_note_mod_0860011", "type": "mod", "text": "注【大】，跓【宋】【元】【明】"}
{"id": null, "n": "0860012", "target": "#nkr_note_mod_0860012", "type": "mod", "text": "夭【大】，矢【明】"}
{"id": null, "n": "0860013", "target": "#nkr_note_mod_0860013", "type": "mod", "text": "面【大】，而【明】"}
{"id": null, "n": "0860014", "target": "#nkr_note_mod_0860014", "type": "mod", "text": "二合去【大】，去二合【明】"}
{"id": null, "n": "0860015", "target": "#nkr_note_mod_0860015", "type": "mod", "text": "引【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0860016", "target": "#nkr_note_mod_0860016", "type": "mod", "text": "志【大】，至【元】【明】"}
{"id": null, "n": "0860017", "target": "#nkr_note_mod_0860017", "type": "mod", "text": "蟲【大】，虫【宋】【元】"}
{"id": null, "n": "0860001", "target": "#nkr_note_orig_0860001", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0860002", "target": "#nkr_note_orig_0860002", "type": "orig", "text": "（宋）＋西【明】"}
{"id": null, "n": "0860003", "target": "#nkr_note_orig_0860003", "type": "orig", "text": "〔帝釋宮寺〕－【明】"}
{"id": null, "n": "0860004", "target": "#nkr_note_orig_0860004", "type": "orig", "text": "〔沙門臣〕－【明】"}
{"id": null, "n": "0860005", "target": "#nkr_note_orig_0860005", "type": "orig", "text": "各＝名【宋】【元】"}
{"id": null, "n": "0860006", "target": "#nkr_note_orig_0860006", "type": "orig", "text": "說＝語【三】"}
{"id": null, "n": "0860007", "target": "#nkr_note_orig_0860007", "type": "orig", "text": "踴＝踊【三】"}
{"id": null, "n": "0860008", "target": "#nkr_note_orig_0860008", "type": "orig", "text": "如來乃至曰二十八字明本作夾註"}
{"id": null, "n": "0860009", "target": "#nkr_note_orig_0860009", "type": "orig", "text": "傑＝搩【三】"}
{"id": null, "n": "0860010", "target": "#nkr_note_orig_0860010", "type": "orig", "text": "反＝切【明】＊"}
{"id": null, "n": "0860011", "target": "#nkr_note_orig_0860011", "type": "orig", "text": "注＝跓【三】"}
{"id": null, "n": "0860012", "target": "#nkr_note_orig_0860012", "type": "orig", "text": "夭＝矢【明】"}
{"id": null, "n": "0860013", "target": "#nkr_note_orig_0860013", "type": "orig", "text": "面＝而【明】"}
{"id": null, "n": "0860014", "target": "#nkr_note_orig_0860014", "type": "orig", "text": "二合去＝去二合【明】"}
{"id": null, "n": "0860015", "target": "#nkr_note_orig_0860015", "type": "orig", "text": "〔引〕－【三】"}
{"id": null, "n": "0860016", "target": "#nkr_note_orig_0860016", "type": "orig", "text": "志＝至【元】【明】"}
{"id": null, "n": "0860017", "target": "#nkr_note_orig_0860017", "type": "orig", "text": "蟲＝虫【宋】【元】"}
