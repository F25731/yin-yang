{"id": null, "n": "0233005", "target": "#nkr_note_mod_0233005", "type": "mod", "text": "臀【大】，臍【宮】"}
{"id": null, "n": "0233006", "target": "#nkr_note_mod_0233006", "type": "mod", "text": "竪【大】，堅【宋】【元】【明】【宮】"}
{"id": null, "n": "0233007", "target": "#nkr_note_mod_0233007", "type": "mod", "text": "計【大】，討【宋】"}
{"id": null, "n": "0233008", "target": "#nkr_note_mod_0233008", "type": "mod", "text": "治【大】，活【宋】【元】【明】【宮】"}
{"id": null, "n": "0233009", "target": "#nkr_note_mod_0233009", "type": "mod", "text": "鶣【大】，扁【明】"}
{"id": null, "n": "0233010", "target": "#nkr_note_mod_0233010", "type": "mod", "text": "痛【大】，病【宮】"}
