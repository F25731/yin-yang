{"id": null, "n": "0230022", "target": "#nkr_note_mod_0230022", "type": "mod", "text": "一卷【大】，〔－〕【明】"}
{"id": null, "n": "0230023", "target": "#nkr_note_mod_0230023", "type": "mod", "text": "天竺須賴拏國三藏僧伽羅剎漢言眾護造【大】，天竺三藏僧伽剎造【宋】【元】【明】，〔－〕【宮】"}
{"id": null, "n": "0230024", "target": "#nkr_note_mod_0230024", "type": "mod", "text": "國【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0230025", "target": "#nkr_note_mod_0230025", "type": "mod", "text": "散種章第一【大】＊，〔－〕【宮】，觀種章第一【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0230026", "target": "#nkr_note_mod_0230026", "type": "mod", "text": "甘蔗【大】，甘露【宋】【元】【明】【宮】"}
{"id": null, "n": "0230027", "target": "#nkr_note_mod_0230027", "type": "mod", "text": "安【大】，要【宋】【元】【明】【宮】"}
{"id": null, "n": "0231001", "target": "#nkr_note_mod_0231001", "type": "mod", "text": "住【大】，但【宋】【元】【明】【宮】"}
{"id": null, "n": "0231002", "target": "#nkr_note_mod_0231002", "type": "mod", "text": "著【大】，者【宮】"}
{"id": null, "n": "0231003", "target": "#nkr_note_mod_0231003", "type": "mod", "text": "若【大】，苦【宋】【元】【明】【宮】"}
{"id": null, "n": "0231004", "target": "#nkr_note_mod_0231004", "type": "mod", "text": "戒【大】，誡【宮】"}
{"id": null, "n": "0231005", "target": "#nkr_note_mod_0231005", "type": "mod", "text": "斯【大】＊，期【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0231006", "target": "#nkr_note_mod_0231006", "type": "mod", "text": "並【大】，共【宋】【元】【明】【宮】"}
{"id": null, "n": "0231007", "target": "#nkr_note_mod_0231007", "type": "mod", "text": "從【大】，教【宋】【元】【明】【宮】"}
{"id": null, "n": "0231008", "target": "#nkr_note_mod_0231008", "type": "mod", "text": "自【大】，曰【宋】【元】【明】【宮】"}
{"id": null, "n": "0231009", "target": "#nkr_note_mod_0231009", "type": "mod", "text": "便【大】，使【宋】【元】【明】【宮】"}
{"id": null, "n": "0231010", "target": "#nkr_note_mod_0231010", "type": "mod", "text": "德【大】，惡【宋】【元】【明】"}
{"id": null, "n": "0231011", "target": "#nkr_note_mod_0231011", "type": "mod", "text": "致【大】，欲【宋】【元】【明】，故【宮】"}
{"id": null, "n": "0231012", "target": "#nkr_note_mod_0231012", "type": "mod", "text": "致【大】，故【宋】【元】【明】【宮】"}
{"id": null, "n": "0231013", "target": "#nkr_note_mod_0231013", "type": "mod", "text": "斂【大】，歛【元】【明】"}
{"id": null, "n": "0231014", "target": "#nkr_note_mod_0231014", "type": "mod", "text": "聽【大】，德【宋】【元】【明】"}
{"id": null, "n": "0231015", "target": "#nkr_note_mod_0231015", "type": "mod", "text": "學者【大】，〔－〕【宮】"}
{"id": null, "n": "0231016", "target": "#nkr_note_mod_0231016", "type": "mod", "text": "常【大】，〔－〕【宮】"}
{"id": null, "n": "0231017", "target": "#nkr_note_mod_0231017", "type": "mod", "text": "亡苦【大】，苦亡【宋】【元】【明】【宮】"}
{"id": null, "n": "0231018", "target": "#nkr_note_mod_0231018", "type": "mod", "text": "穿【大】，冥【宋】【元】【明】"}
{"id": null, "n": "0231019", "target": "#nkr_note_mod_0231019", "type": "mod", "text": "道地經【大】＊，〔－〕【明】＊"}
{"id": null, "n": "0231020", "target": "#nkr_note_mod_0231020", "type": "mod", "text": "蒦【大】，捉【宋】【元】【明】，篌【宮】"}
{"id": null, "n": "0231021", "target": "#nkr_note_mod_0231021", "type": "mod", "text": "牽【大】，𭻈【宮】"}
{"id": null, "n": "0231022", "target": "#nkr_note_mod_0231022", "type": "mod", "text": "故【大】，欲【宋】【元】【明】"}
{"id": null, "n": "0231023", "target": "#nkr_note_mod_0231023", "type": "mod", "text": "菰【大】，慈【宋】【元】【明】，叢【宮】"}
{"id": null, "n": "0231024", "target": "#nkr_note_mod_0231024", "type": "mod", "text": "歡【大】，觀【宋】【元】【明】【宮】"}
{"id": null, "n": "0231025", "target": "#nkr_note_mod_0231025", "type": "mod", "text": "葉【大】，多葉【宋】【元】【明】【宮】"}
{"id": null, "n": "0231026", "target": "#nkr_note_mod_0231026", "type": "mod", "text": "品【大】，句【宮】"}
{"id": null, "n": "0231027", "target": "#nkr_note_mod_0231027", "type": "mod", "text": "道【大】，導【宋】【元】【明】【宮】"}
{"id": null, "n": "0231028", "target": "#nkr_note_mod_0231028", "type": "mod", "text": "篌【大】，擭【宋】【元】【明】"}
{"id": null, "n": "0231029", "target": "#nkr_note_mod_0231029", "type": "mod", "text": "相【大】，想【宋】【元】【明】【宮】"}
{"id": null, "n": "0231030", "target": "#nkr_note_mod_0231030", "type": "mod", "text": "于【大】，不【宋】【元】【明】【宮】"}
{"id": null, "n": "0231031", "target": "#nkr_note_mod_0231031", "type": "mod", "text": "份【大】，分【宋】【元】【明】【宮】"}
{"id": null, "n": "0231032", "target": "#nkr_note_mod_0231032", "type": "mod", "text": "叉手【大】，又我【宋】【元】【明】【宮】"}
{"id": null, "n": "0232001", "target": "#nkr_note_mod_0232001", "type": "mod", "text": "見【大】，現【宋】【元】【明】【宮】"}
{"id": null, "n": "0232002", "target": "#nkr_note_mod_0232002", "type": "mod", "text": "衢【大】，街【宋】【元】【明】【宮】"}
{"id": null, "n": "0232003", "target": "#nkr_note_mod_0232003", "type": "mod", "text": "是【大】，見【宋】【元】【明】【宮】"}
{"id": null, "n": "0232004", "target": "#nkr_note_mod_0232004", "type": "mod", "text": "如【大】，知【宋】【元】【明】【宮】"}
{"id": null, "n": "0232005", "target": "#nkr_note_mod_0232005", "type": "mod", "text": "說【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0232006", "target": "#nkr_note_mod_0232006", "type": "mod", "text": "當要【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0232007", "target": "#nkr_note_mod_0232007", "type": "mod", "text": "名【大】，多【元】【明】"}
{"id": null, "n": "0232008", "target": "#nkr_note_mod_0232008", "type": "mod", "text": "腦【大】，惱【宋】【元】【明】【宮】"}
{"id": null, "n": "0232009", "target": "#nkr_note_mod_0232009", "type": "mod", "text": "烏鵄【CB】【麗-CB】，烏鵶【大】，鳥鵛【宮】"}
{"id": null, "n": "0232010", "target": "#nkr_note_mod_0232010", "type": "mod", "text": "牧䭷【大】，抆髦【宋】【元】【明】【宮】"}
{"id": null, "n": "0232011", "target": "#nkr_note_mod_0232011", "type": "mod", "text": "枕【大】，杭【宮】"}
{"id": null, "n": "0232012", "target": "#nkr_note_mod_0232012", "type": "mod", "text": "飲【大】，欲【宋】【元】【明】【宮】"}
{"id": null, "n": "0232013", "target": "#nkr_note_mod_0232013", "type": "mod", "text": "斂【大】，歛【元】"}
{"id": null, "n": "0232014", "target": "#nkr_note_mod_0232014", "type": "mod", "text": "胆【大】＊，袓【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0232015", "target": "#nkr_note_mod_0232015", "type": "mod", "text": "或【大】，或時【宋】，時【元】【明】"}
{"id": null, "n": "0232016", "target": "#nkr_note_mod_0232016", "type": "mod", "text": "間【大】，聞【宮】"}
{"id": null, "n": "0232017", "target": "#nkr_note_mod_0232017", "type": "mod", "text": "水【大】，氷【宋】【元】【明】【宮】"}
{"id": null, "n": "0232018", "target": "#nkr_note_mod_0232018", "type": "mod", "text": "茅【大】，葇【宮】"}
{"id": null, "n": "0232019", "target": "#nkr_note_mod_0232019", "type": "mod", "text": "美【大】，芬菼【宋】【元】【明】【宮】（CBETA 按：韓小荊（2019）指出：「美」當是「笑」之俗訛。「笑」俗書可寫作「𫟈」，與「美」之手寫體同形。又，有近似「美」之異體字，如：𭉋、𠸍。另可參考異譯本《修行道地經》對應段落：「獨樂其中欣欣大笑」（T15n0606_p0183c27-p0184a01））"}
{"id": null, "n": "0232020", "target": "#nkr_note_mod_0232020", "type": "mod", "text": "塵【大】，塵塵【宋】【元】【明】【宮】"}
{"id": null, "n": "0232021", "target": "#nkr_note_mod_0232021", "type": "mod", "text": "鹽【大】＊，檻【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0232022", "target": "#nkr_note_mod_0232022", "type": "mod", "text": "促【大】，從【宋】【元】【明】【宮】"}
{"id": null, "n": "0232023", "target": "#nkr_note_mod_0232023", "type": "mod", "text": "入【大】，人【宋】【元】【明】【宮】"}
{"id": null, "n": "0232024", "target": "#nkr_note_mod_0232024", "type": "mod", "text": "著【大】，者【宋】【元】【明】【宮】"}
{"id": null, "n": "0232025", "target": "#nkr_note_mod_0232025", "type": "mod", "text": "抆【大】，拔【宋】【元】【明】【宮】"}
{"id": null, "n": "0232026", "target": "#nkr_note_mod_0232026", "type": "mod", "text": "得復【大】，復得【宋】【元】【明】【宮】"}
{"id": null, "n": "0232027", "target": "#nkr_note_mod_0232027", "type": "mod", "text": "日【大】＊，曰【宮】＊"}
{"id": null, "n": "0232028", "target": "#nkr_note_mod_0232028", "type": "mod", "text": "喚【大】＊，呼【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0232029", "target": "#nkr_note_mod_0232029", "type": "mod", "text": "刻【大】＊，剋【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0232030", "target": "#nkr_note_mod_0232030", "type": "mod", "text": "治【大】＊，活【宮】＊"}
{"id": null, "n": "0232031", "target": "#nkr_note_mod_0232031", "type": "mod", "text": "歷【大】，曆【宋】【元】【明】【宮】"}
{"id": null, "n": "0232032", "target": "#nkr_note_mod_0232032", "type": "mod", "text": "束【大】，來【宋】【元】【明】"}
{"id": null, "n": "0232033", "target": "#nkr_note_mod_0232033", "type": "mod", "text": "鵄【大】，鵶【宋】【元】【明】，鵛【宮】"}
{"id": null, "n": "0232034", "target": "#nkr_note_mod_0232034", "type": "mod", "text": "挽【大】，勉【宮】"}
{"id": null, "n": "0232035", "target": "#nkr_note_mod_0232035", "type": "mod", "text": "盆【大】，瓮【宋】【元】【明】【宮】"}
{"id": null, "n": "0232036", "target": "#nkr_note_mod_0232036", "type": "mod", "text": "瓦【大】，見【宮】"}
{"id": null, "n": "0232037", "target": "#nkr_note_mod_0232037", "type": "mod", "text": "甌【大】，𤭛【宋】【元】【明】，𤮋【宮】"}
{"id": null, "n": "0232038", "target": "#nkr_note_mod_0232038", "type": "mod", "text": "延【大】，涎【宋】【元】【明】【宮】"}
{"id": null, "n": "0232039", "target": "#nkr_note_mod_0232039", "type": "mod", "text": "戾【大】，脣【宋】【元】【明】"}
{"id": null, "n": "0232040", "target": "#nkr_note_mod_0232040", "type": "mod", "text": "喉【大】，唯【宋】【元】【明】【宮】"}
{"id": null, "n": "0232041", "target": "#nkr_note_mod_0232041", "type": "mod", "text": "背【大】，偕【宋】【元】【明】【宮】"}
{"id": null, "n": "0232042", "target": "#nkr_note_mod_0232042", "type": "mod", "text": "無【大】，死【宋】【元】【明】"}
{"id": null, "n": "0233001", "target": "#nkr_note_mod_0233001", "type": "mod", "text": "肌【大】，肥【宋】【元】【明】【宮】"}
{"id": null, "n": "0233002", "target": "#nkr_note_mod_0233002", "type": "mod", "text": "狖【大】，猶【宮】"}
{"id": null, "n": "0233003", "target": "#nkr_note_mod_0233003", "type": "mod", "text": "澁【大】＊，忽【宮】＊"}
