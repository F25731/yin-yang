{"id": null, "n": "0233017", "target": "#nkr_note_mod_0233017", "type": "mod", "text": "為【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0233018", "target": "#nkr_note_mod_0233018", "type": "mod", "text": "視【大】，親【明】"}
{"id": null, "n": "0233019", "target": "#nkr_note_mod_0233019", "type": "mod", "text": "收【大】，牧【宋】【元】【明】"}
{"id": null, "n": "0233020", "target": "#nkr_note_mod_0233020", "type": "mod", "text": "𮉄【大】，潔【宮】"}
{"id": null, "n": "0233021", "target": "#nkr_note_mod_0233021", "type": "mod", "text": "㵪洟【大】，涎涕【宋】【元】【明】【宮】"}
{"id": null, "n": "0233022", "target": "#nkr_note_mod_0233022", "type": "mod", "text": "傷【大】，󳒭【宋】【元】【明】，腦【宮】"}
{"id": null, "n": "0233023", "target": "#nkr_note_mod_0233023", "type": "mod", "text": "復上【大】，腹止【宋】【元】【明】【宮】"}
{"id": null, "n": "0233024", "target": "#nkr_note_mod_0233024", "type": "mod", "text": "澁【大】，𬾌【宋】【元】【明】【宮】"}
{"id": null, "n": "0233025", "target": "#nkr_note_mod_0233025", "type": "mod", "text": "號【大】，鶣【宋】【元】【明】【宮】"}
{"id": null, "n": "0233026", "target": "#nkr_note_mod_0233026", "type": "mod", "text": "哭【大】，笑【宋】【元】【明】【宮】"}
