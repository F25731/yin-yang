{"id": null, "n": "0373001", "target": "#nkr_note_orig_0373001", "type": "orig", "text": "「俱」，底本作「具」，據文意改。"}
{"id": null, "n": "0373002", "target": "#nkr_note_orig_0373002", "type": "orig", "text": "「於」，底本殘，據文意補。"}
{"id": null, "n": "0374001", "target": "#nkr_note_orig_0374001", "type": "orig", "text": "「鉞」，底本作「越」，據文意改。"}
{"id": null, "n": "0374002", "target": "#nkr_note_orig_0374002", "type": "orig", "text": "「智」，疑作「持」或「捧」。"}
{"id": null, "n": "0375001", "target": "#nkr_note_orig_0375001", "type": "orig", "text": "「五光」，底本作「五色光」，據文意刪。"}
{"id": null, "n": "0375002", "target": "#nkr_note_orig_0375002", "type": "orig", "text": "「而」，底本作「亦而」，據文意刪。"}
{"id": null, "n": "0375003", "target": "#nkr_note_orig_0375003", "type": "orig", "text": "「晃曜」，底本作「融混晃曜」，據文意刪。"}
{"id": null, "n": "0375004", "target": "#nkr_note_orig_0375004", "type": "orig", "text": "「淨」，底本作「清淨」，據文意刪。"}
{"id": null, "n": "0375005", "target": "#nkr_note_orig_0375005", "type": "orig", "text": "「刑」，底本作「形」，據文意改。"}
{"id": null, "n": "0376001", "target": "#nkr_note_orig_0376001", "type": "orig", "text": "「覺場」，底本作「正覺場」，據文意刪。"}
{"id": null, "n": "0376002", "target": "#nkr_note_orig_0376002", "type": "orig", "text": "「階」，底本作「陛階」，據文意刪。"}
{"id": null, "n": "0377001", "target": "#nkr_note_orig_0377001", "type": "orig", "text": "「紅塵」，底本作「紅視之塵」，據文意刪。"}
{"id": null, "n": "0377002", "target": "#nkr_note_orig_0377002", "type": "orig", "text": "「於」，底本無，據文意補。"}
{"id": null, "n": "0377003", "target": "#nkr_note_orig_0377003", "type": "orig", "text": "「手」，底本無，據文意補。"}
{"id": null, "n": "0377004", "target": "#nkr_note_orig_0377004", "type": "orig", "text": "「而」，底本殘，據文意補。"}
{"id": null, "n": "0377005", "target": "#nkr_note_orig_0377005", "type": "orig", "text": "「陽」，底本殘，據文意補。"}
{"id": null, "n": "0378001", "target": "#nkr_note_orig_0378001", "type": "orig", "text": "原稿為悉曇體梵文，今改寫作拉丁體。下同。"}
{"id": null, "n": "0378002", "target": "#nkr_note_orig_0378002", "type": "orig", "text": "「覺心」，底本作「明覺心」，據文意刪。"}
{"id": null, "n": "0378003", "target": "#nkr_note_orig_0378003", "type": "orig", "text": "「華」，底本無，據文意補。"}
{"id": null, "n": "0378004", "target": "#nkr_note_orig_0378004", "type": "orig", "text": "「白姐」，底本無，據文意補。"}
{"id": null, "n": "0378005", "target": "#nkr_note_orig_0378005", "type": "orig", "text": "「真言」，底本無，據文意補。"}
{"id": null, "n": "0379001", "target": "#nkr_note_orig_0379001", "type": "orig", "text": "「之」，底本無，據文意補。"}
{"id": null, "n": "0379002", "target": "#nkr_note_orig_0379002", "type": "orig", "text": "「現青色」，底本作「色現青」，據文意改。"}
{"id": null, "n": "0380001", "target": "#nkr_note_orig_0380001", "type": "orig", "text": "「依」，底本作「堪依」，據文意刪。"}
{"id": null, "n": "0380002", "target": "#nkr_note_orig_0380002", "type": "orig", "text": "「中圍伴繞真言」，底本無，據文意補。"}
{"id": null, "n": "0380003", "target": "#nkr_note_orig_0380003", "type": "orig", "text": "「有」，底本在「界」字前，據文意改。"}
{"id": null, "n": "0381001", "target": "#nkr_note_orig_0381001", "type": "orig", "text": "「魔」，底本無，據文意補。"}
