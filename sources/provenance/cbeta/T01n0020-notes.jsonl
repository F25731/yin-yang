{"id": null, "n": "0260002", "target": "#nkr_note_mod_0260002", "type": "mod", "text": "紀【大】，記【宋】"}
{"id": null, "n": "0260003", "target": "#nkr_note_mod_0260003", "type": "mod", "text": "菩【大】，善【元】"}
