{"id": null, "n": "0259007", "target": "#nkr_note_mod_0259007", "type": "mod", "text": "肯【大】，有【宋】【元】【明】"}
{"id": null, "n": "0259008", "target": "#nkr_note_mod_0259008", "type": "mod", "text": "杖【大】，仗【宋】【元】【明】"}
{"id": null, "n": "0259009", "target": "#nkr_note_mod_0259009", "type": "mod", "text": "為化度【大】，化度度【宋】【元】【明】"}
