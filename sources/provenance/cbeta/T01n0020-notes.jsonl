{"id": null, "n": "0260027", "target": "#nkr_note_mod_0260027", "type": "mod", "text": "貴【大】，素【宋】【元】【明】"}
{"id": null, "n": "0260028", "target": "#nkr_note_mod_0260028", "type": "mod", "text": "政【大】，正【宋】【元】【明】"}
{"id": null, "n": "0260029", "target": "#nkr_note_mod_0260029", "type": "mod", "text": "後【大】，復【元】【明】"}
{"id": null, "n": "0260030", "target": "#nkr_note_mod_0260030", "type": "mod", "text": "追相戀焉【大】，相追戀而【宋】【元】【明】"}
{"id": null, "n": "0260031", "target": "#nkr_note_mod_0260031", "type": "mod", "text": "離苦【大】，苦離【宋】"}
{"id": null, "n": "0260032", "target": "#nkr_note_mod_0260032", "type": "mod", "text": "痛【大】，當【宋】【元】【明】"}
{"id": null, "n": "0260033", "target": "#nkr_note_mod_0260033", "type": "mod", "text": "娶妻【大】，取婦【宋】【元】【明】"}
{"id": null, "n": "0260034", "target": "#nkr_note_mod_0260034", "type": "mod", "text": "獸【大】，獸蟲蟻【宋】【元】【明】"}
{"id": null, "n": "0261001", "target": "#nkr_note_mod_0261001", "type": "mod", "text": "己【大】，身【宋】【元】【明】"}
{"id": null, "n": "0261002", "target": "#nkr_note_mod_0261002", "type": "mod", "text": "殆【大】，殘【宋】【元】【明】"}
