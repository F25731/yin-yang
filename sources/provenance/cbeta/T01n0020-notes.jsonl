{"id": null, "n": "0261004", "target": "#nkr_note_mod_0261004", "type": "mod", "text": "語【大】，證【宋】"}
{"id": null, "n": "0261005", "target": "#nkr_note_mod_0261005", "type": "mod", "text": "時【大】，笑【宋】【元】【明】"}
{"id": null, "n": "0261006", "target": "#nkr_note_mod_0261006", "type": "mod", "text": "人【大】，人仁【宋】【元】【明】"}
{"id": null, "n": "0261007", "target": "#nkr_note_mod_0261007", "type": "mod", "text": "十【大】，十戒【宋】【元】【明】"}
{"id": null, "n": "0261008", "target": "#nkr_note_mod_0261008", "type": "mod", "text": "故【大】，固【宋】【元】【明】"}
{"id": null, "n": "0261009", "target": "#nkr_note_mod_0261009", "type": "mod", "text": "欺【大】，餘【宋】【元】【明】"}
{"id": null, "n": "0261010", "target": "#nkr_note_mod_0261010", "type": "mod", "text": "周【大】，賙【元】【明】"}
{"id": null, "n": "0261011", "target": "#nkr_note_mod_0261011", "type": "mod", "text": "次【大】，次者【宋】【元】【明】"}
{"id": null, "n": "0261012", "target": "#nkr_note_mod_0261012", "type": "mod", "text": "綺【大】，訛【宋】【元】【明】"}
