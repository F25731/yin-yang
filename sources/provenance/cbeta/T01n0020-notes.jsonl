{"id": null, "n": "0260005", "target": "#nkr_note_mod_0260005", "type": "mod", "text": "垢【大】，蟠【宋】【元】【明】"}
{"id": null, "n": "0260006", "target": "#nkr_note_mod_0260006", "type": "mod", "text": "上正真【大】，為【宋】【元】【明】"}
{"id": null, "n": "0260007", "target": "#nkr_note_mod_0260007", "type": "mod", "text": "雖【大】，數雖【宋】【元】【明】"}
{"id": null, "n": "0260008", "target": "#nkr_note_mod_0260008", "type": "mod", "text": "殺【大】，不殺【元】【明】"}
{"id": null, "n": "0260009", "target": "#nkr_note_mod_0260009", "type": "mod", "text": "狀【大】，姓【元】【明】"}
{"id": null, "n": "0260010", "target": "#nkr_note_mod_0260010", "type": "mod", "text": "冤【大】＊，怨【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0260011", "target": "#nkr_note_mod_0260011", "type": "mod", "text": "我【大】，義【宋】【元】【明】"}
{"id": null, "n": "0260012", "target": "#nkr_note_mod_0260012", "type": "mod", "text": "古【大】，故【宋】【元】【明】"}
{"id": null, "n": "0260013", "target": "#nkr_note_mod_0260013", "type": "mod", "text": "床【大】，休【宋】【元】【明】"}
{"id": null, "n": "0260014", "target": "#nkr_note_mod_0260014", "type": "mod", "text": "爭位【大】，諍立【宋】【元】【明】"}
{"id": null, "n": "0260015", "target": "#nkr_note_mod_0260015", "type": "mod", "text": "爭【大】，諍【宋】【元】【明】"}
{"id": null, "n": "0260016", "target": "#nkr_note_mod_0260016", "type": "mod", "text": "無【大】，而【宋】【元】【明】"}
{"id": null, "n": "0260017", "target": "#nkr_note_mod_0260017", "type": "mod", "text": "乃【大】，久【宋】，反【元】【明】"}
{"id": null, "n": "0260018", "target": "#nkr_note_mod_0260018", "type": "mod", "text": "北【大】，此【明】"}
{"id": null, "n": "0260019", "target": "#nkr_note_mod_0260019", "type": "mod", "text": "顏【大】，顯【宋】【元】【明】"}
{"id": null, "n": "0260020", "target": "#nkr_note_mod_0260020", "type": "mod", "text": "哉【大】，我【宋】【元】【明】"}
{"id": null, "n": "0260021", "target": "#nkr_note_mod_0260021", "type": "mod", "text": "能【大】，能得【宋】【元】【明】"}
{"id": null, "n": "0260022", "target": "#nkr_note_mod_0260022", "type": "mod", "text": "伎【大】，技【元】【明】"}
{"id": null, "n": "0260023", "target": "#nkr_note_mod_0260023", "type": "mod", "text": "獨【大】，去彼獨【宋】【元】【明】"}
