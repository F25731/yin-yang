{"id": null, "n": null, "target": null, "type": null, "text": "光明心即菩提心也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即如瑜伽中成身次第也"}
{"id": null, "n": null, "target": null, "type": null, "text": "族五部明五部真言也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂一字頂輪也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂大印也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂運為也"}
{"id": null, "n": null, "target": null, "type": null, "text": "決云謂隨眾生意所樂者"}
{"id": null, "n": null, "target": null, "type": null, "text": "西方\n或以赤麞皮中安氈花而坐"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂入定也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂自建立已來乃至大印等"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂在花上也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂作赤色\n上有金剛"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂以杓應薩嚩拄物便\n瀉爐中及餘聲未盡還拄物"}
{"id": null, "n": null, "target": null, "type": null, "text": "所謂以虛空內有所為一體也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂體隨意變身也"}
{"id": null, "n": null, "target": null, "type": null, "text": "知已"}
{"id": null, "n": "0313007", "target": "#nkr_note_mod_0313007", "type": "mod", "text": "一【大】＊，瑜伽翳迦訖沙囉烏瑟尼沙斫訖囉真言安怛陀那儀則一【宋】＊【元】＊【明】＊，【原】麗本，【甲】三十帖策子第五帖，（瑜伽翳訖沙囉烏瑟尼沙斫囉真言安怛陀那儀則）二十一字＋一【甲】"}
{"id": null, "n": "0313008", "target": "#nkr_note_mod_0313008", "type": "mod", "text": "觀行儀軌【大】，經【宋】【元】【明】【甲】"}
{"id": null, "n": "0313009", "target": "#nkr_note_mod_0313009", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0313010", "target": "#nkr_note_mod_0313010", "type": "mod", "text": "（開府…門）四十一字【大】，大興善寺三藏沙門大廣智【宋】【元】【甲】，唐大興善寺三藏沙門大廣智【明】"}
{"id": null, "n": "0313011", "target": "#nkr_note_mod_0313011", "type": "mod", "text": "娜【大】＊，那【宋】【元】【明】【甲】＊"}
{"id": null, "n": "0313012", "target": "#nkr_note_mod_0313012", "type": "mod", "text": "我云何【大】，云何我【宋】【元】【明】，云我何【甲】"}
{"id": null, "n": "0313013", "target": "#nkr_note_mod_0313013", "type": "mod", "text": "治【大】，持【宋】【元】【明】【甲】"}
{"id": null, "n": "0313014", "target": "#nkr_note_mod_0313014", "type": "mod", "text": "花【大】，蓮【宋】【元】【明】【甲】"}
{"id": null, "n": "0313015", "target": "#nkr_note_mod_0313015", "type": "mod", "text": "飾【大】，嚴【宋】【元】【明】【甲】"}
{"id": null, "n": "0313016", "target": "#nkr_note_mod_0313016", "type": "mod", "text": "嚴【大】，飾【宋】【元】【明】【甲】"}
{"id": null, "n": "0313017", "target": "#nkr_note_mod_0313017", "type": "mod", "text": "明【大】，相【宋】【元】【明】【甲】"}
{"id": null, "n": "0313018", "target": "#nkr_note_mod_0313018", "type": "mod", "text": "諸【大】，持【甲】"}
{"id": null, "n": "0313019", "target": "#nkr_note_mod_0313019", "type": "mod", "text": "憂死【大】，死憂【宋】【元】【明】【甲】"}
{"id": null, "n": "0314001", "target": "#nkr_note_mod_0314001", "type": "mod", "text": "心【大】，心者【宋】【元】【明】【甲】"}
{"id": null, "n": "0314002", "target": "#nkr_note_mod_0314002", "type": "mod", "text": "即【大】，即是【宋】【元】【明】【甲】"}
{"id": null, "n": "0314003", "target": "#nkr_note_mod_0314003", "type": "mod", "text": "滿【大】，皓【宋】【元】【明】【甲】"}
{"id": null, "n": "0314004", "target": "#nkr_note_mod_0314004", "type": "mod", "text": "知已【大】，知已【宋】【元】【明】【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "知已"}
{"id": null, "n": "0314005", "target": "#nkr_note_mod_0314005", "type": "mod", "text": "族【大】，知族【宋】【元】【明】【甲】"}
{"id": null, "n": "0314006", "target": "#nkr_note_mod_0314006", "type": "mod", "text": "知【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0314007", "target": "#nkr_note_mod_0314007", "type": "mod", "text": "輪【大】，輪王法【宋】【元】【明】【甲】"}
{"id": null, "n": "0314008", "target": "#nkr_note_mod_0314008", "type": "mod", "text": "王【大】，主【宋】【元】【明】【甲】"}
{"id": null, "n": "0314009", "target": "#nkr_note_mod_0314009", "type": "mod", "text": "想【大】，觀【宋】【元】【明】【甲】"}
{"id": null, "n": "0314010", "target": "#nkr_note_mod_0314010", "type": "mod", "text": "無垢猶如佛【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0314011", "target": "#nkr_note_mod_0314011", "type": "mod", "text": "掌【大】，常【甲】"}
{"id": null, "n": "0314012", "target": "#nkr_note_mod_0314012", "type": "mod", "text": "鬘【大】，慢【宋】【元】【明】【甲】"}
{"id": null, "n": "0314013", "target": "#nkr_note_mod_0314013", "type": "mod", "text": "見【大】，思【宋】【元】【明】【甲】"}
{"id": null, "n": "0314014", "target": "#nkr_note_mod_0314014", "type": "mod", "text": "已【大】，以【宋】【元】【明】【甲】"}
{"id": null, "n": "0314015", "target": "#nkr_note_mod_0314015", "type": "mod", "text": "供養【大】，奉獻【宋】【元】【明】【甲】"}
{"id": null, "n": "0314016", "target": "#nkr_note_mod_0314016", "type": "mod", "text": "切【大】，字【宋】【元】【明】"}
{"id": null, "n": "0314018", "target": "#nkr_note_mod_0314018", "type": "mod", "text": "摩醯首羅【大】，大自在【宋】【元】【明】【甲】"}
{"id": null, "n": "0314019", "target": "#nkr_note_mod_0314019", "type": "mod", "text": "念【大】，作念【宋】【元】【明】【甲】"}
{"id": null, "n": "0314020", "target": "#nkr_note_mod_0314020", "type": "mod", "text": "如【大】，如擊【宋】【元】【明】【甲】"}
{"id": null, "n": "0314021", "target": "#nkr_note_mod_0314021", "type": "mod", "text": "聲【大】＊，〔－〕【宋】【元】【明】【甲】＊"}
{"id": null, "n": "0314022", "target": "#nkr_note_mod_0314022", "type": "mod", "text": "珞【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0314023", "target": "#nkr_note_mod_0314023", "type": "mod", "text": "一切【大】，諸【宋】【元】【明】【甲】"}
{"id": null, "n": "0314024", "target": "#nkr_note_mod_0314024", "type": "mod", "text": "作【大】，作於【宋】【元】【明】【甲】"}
{"id": null, "n": "0314025", "target": "#nkr_note_mod_0314025", "type": "mod", "text": "此【大】＊，〔－〕【宋】【元】【明】【甲】＊"}
{"id": null, "n": "0314026", "target": "#nkr_note_mod_0314026", "type": "mod", "text": "軌【大】，二軌竟【宋】【元】【明】【甲】"}
{"id": null, "n": "0314027", "target": "#nkr_note_mod_0314027", "type": "mod", "text": "謂【大】，詣【明】"}
{"id": null, "n": "0314028", "target": "#nkr_note_mod_0314028", "type": "mod", "text": "其【大】，於【宋】【元】【明】【甲】"}
{"id": null, "n": "0314029", "target": "#nkr_note_mod_0314029", "type": "mod", "text": "色念誦【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0314030", "target": "#nkr_note_mod_0314030", "type": "mod", "text": "成就【大】，我【宋】【元】【明】，成【甲】"}
{"id": null, "n": "0314031", "target": "#nkr_note_mod_0314031", "type": "mod", "text": "我【大】，我今【宋】【元】【明】【甲】"}
{"id": null, "n": "0314032", "target": "#nkr_note_mod_0314032", "type": "mod", "text": "所【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0314033", "target": "#nkr_note_mod_0314033", "type": "mod", "text": "𭊯【大】，及與齶處【宋】【元】【明】【甲】"}
{"id": null, "n": "0314034", "target": "#nkr_note_mod_0314034", "type": "mod", "text": "耳【大】，爾【宋】【元】【明】【甲】"}
{"id": null, "n": "0314035", "target": "#nkr_note_mod_0314035", "type": "mod", "text": "當【大】，悉【宋】【元】【明】【甲】"}
{"id": null, "n": "0314036", "target": "#nkr_note_mod_0314036", "type": "mod", "text": "安怛陀娜【大】，道成【宋】【元】【明】【甲】"}
{"id": null, "n": "0314037", "target": "#nkr_note_mod_0314037", "type": "mod", "text": "益更【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0314038", "target": "#nkr_note_mod_0314038", "type": "mod", "text": "遍【大】，通【宋】【元】【明】【甲】"}
{"id": null, "n": "0314039", "target": "#nkr_note_mod_0314039", "type": "mod", "text": "暉【大】，澤【宋】【元】【明】【甲】"}
{"id": null, "n": "0314040", "target": "#nkr_note_mod_0314040", "type": "mod", "text": "四【大】，內【宋】【明】"}
{"id": null, "n": "0314041", "target": "#nkr_note_mod_0314041", "type": "mod", "text": "法【大】，法於【宋】【元】【明】【甲】"}
{"id": null, "n": "0314042", "target": "#nkr_note_mod_0314042", "type": "mod", "text": "辯【大】，辨【甲】"}
{"id": null, "n": "0314043", "target": "#nkr_note_mod_0314043", "type": "mod", "text": "中【大】，身中【宋】【元】【明】"}
{"id": null, "n": "0314044", "target": "#nkr_note_mod_0314044", "type": "mod", "text": "其所【大】，可【宋】【元】【明】【甲】"}
{"id": null, "n": "0314045", "target": "#nkr_note_mod_0314045", "type": "mod", "text": "荼【大】＊，茶【明】＊"}
{"id": null, "n": "0314046", "target": "#nkr_note_mod_0314046", "type": "mod", "text": "辦【大】，辨【宋】【元】【明】【甲】"}
{"id": null, "n": "0314047", "target": "#nkr_note_mod_0314047", "type": "mod", "text": "真言者住與慧念【大】，〔－〕【甲】"}
{"id": null, "n": "0314048", "target": "#nkr_note_mod_0314048", "type": "mod", "text": "或三更或明相【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0314049", "target": "#nkr_note_mod_0314049", "type": "mod", "text": "是【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0315001", "target": "#nkr_note_mod_0315001", "type": "mod", "text": "烟【大】，焰【宋】【元】【明】"}
{"id": null, "n": "0315002", "target": "#nkr_note_mod_0315002", "type": "mod", "text": "昇【大】，升【宋】【元】【明】"}
{"id": null, "n": "0315003", "target": "#nkr_note_mod_0315003", "type": "mod", "text": "花【大】，蓮花【宋】【元】【明】【甲】"}
{"id": null, "n": "0315004", "target": "#nkr_note_mod_0315004", "type": "mod", "text": "加【大】，跏【明】【甲】"}
{"id": null, "n": "0315005", "target": "#nkr_note_mod_0315005", "type": "mod", "text": "次【大】，次又【宋】【元】【明】"}
{"id": null, "n": "0315006", "target": "#nkr_note_mod_0315006", "type": "mod", "text": "焰【大】，熾【宋】【元】【明】【甲】"}
{"id": null, "n": "0315007", "target": "#nkr_note_mod_0315007", "type": "mod", "text": "徑【大】，住【宋】【元】【明】【甲】"}
{"id": null, "n": "0315008", "target": "#nkr_note_mod_0315008", "type": "mod", "text": "應【大】，應成就【宋】【元】【明】【甲】"}
{"id": null, "n": "0315009", "target": "#nkr_note_mod_0315009", "type": "mod", "text": "當【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0315010", "target": "#nkr_note_mod_0315010", "type": "mod", "text": "出【大】，山中【宋】【元】【明】【甲】"}
{"id": null, "n": "0315011", "target": "#nkr_note_mod_0315011", "type": "mod", "text": "多【大】，哆【明】"}
{"id": null, "n": "0315012", "target": "#nkr_note_mod_0315012", "type": "mod", "text": "薩【大】，娑【宋】【元】【明】【甲】"}
{"id": null, "n": "0315013", "target": "#nkr_note_mod_0315013", "type": "mod", "text": "嚩【大】，嚩二合訶聲【宋】【元】【明】【甲】"}
{"id": null, "n": "0315014", "target": "#nkr_note_mod_0315014", "type": "mod", "text": "拄【大】＊，住【宋】【元】【明】【甲】＊"}
{"id": null, "n": "0315015", "target": "#nkr_note_mod_0315015", "type": "mod", "text": "物【大】，物物【宋】【元】【明】【甲】"}
{"id": null, "n": "0315016", "target": "#nkr_note_mod_0315016", "type": "mod", "text": "善【大】，繕【明】"}
{"id": null, "n": "0315017", "target": "#nkr_note_mod_0315017", "type": "mod", "text": "大【大】，大大【宋】【元】【明】【甲】"}
{"id": null, "n": "0315018", "target": "#nkr_note_mod_0315018", "type": "mod", "text": "就【大】，就故【甲】"}
{"id": null, "n": "0315019", "target": "#nkr_note_mod_0315019", "type": "mod", "text": "宮【大】，天宮【宋】【元】【明】"}
{"id": null, "n": "0315020", "target": "#nkr_note_mod_0315020", "type": "mod", "text": "有所【大】，所有【宋】【元】【明】【甲】"}
{"id": null, "n": "0315021", "target": "#nkr_note_mod_0315021", "type": "mod", "text": "體也【大】，切體【宋】【元】【明】【甲】"}
{"id": null, "n": "0315022", "target": "#nkr_note_mod_0315022", "type": "mod", "text": "間【大】，〔－〕【甲】"}
{"id": null, "n": "0315023", "target": "#nkr_note_mod_0315023", "type": "mod", "text": "力【大】，人【宋】【元】【明】"}
{"id": null, "n": "0315024", "target": "#nkr_note_mod_0315024", "type": "mod", "text": "也【大】，〔－〕【宋】【元】【明】【甲】"}
{"id": null, "n": "0315025", "target": "#nkr_note_mod_0315025", "type": "mod", "text": "慾【大】，欲【宋】【元】【明】【甲】"}
{"id": null, "n": "0315026", "target": "#nkr_note_mod_0315026", "type": "mod", "text": "怛【大】，〔－〕【宋】【元】【甲】"}
{"id": null, "n": "0315027", "target": "#nkr_note_mod_0315027", "type": "mod", "text": "住【大】，注【甲】"}
{"id": null, "n": "0315028", "target": "#nkr_note_mod_0315028", "type": "mod", "text": "烟【大】，焰【宋】【元】【明】【甲】"}
{"id": null, "n": "0315029", "target": "#nkr_note_mod_0315029", "type": "mod", "text": "遊【大】，遊戲【宋】【元】【明】【甲】"}
{"id": null, "n": "0315030", "target": "#nkr_note_mod_0315030", "type": "mod", "text": "道【大】，〔－〕【甲】"}
{"id": null, "n": "0315031", "target": "#nkr_note_mod_0315031", "type": "mod", "text": "賊王【大】，王賊【宋】【元】【明】"}
{"id": null, "n": "0315032", "target": "#nkr_note_mod_0315032", "type": "mod", "text": "憫【大】，愍【宋】【元】【明】"}
{"id": null, "n": "0315033", "target": "#nkr_note_mod_0315033", "type": "mod", "text": "於【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0315034", "target": "#nkr_note_mod_0315034", "type": "mod", "text": "月【大】，日【宋】【元】【明】"}
{"id": null, "n": "0315035", "target": "#nkr_note_mod_0315035", "type": "mod", "text": "具【大】，見【宋】【元】【明】【甲】"}
{"id": null, "n": "0315036", "target": "#nkr_note_mod_0315036", "type": "mod", "text": "疑【大】，言【甲】"}
{"id": null, "n": "0315037", "target": "#nkr_note_mod_0315037", "type": "mod", "text": "大【大】，大乘【宋】【元】【明】【甲】"}
{"id": null, "n": "0315038", "target": "#nkr_note_mod_0315038", "type": "mod", "text": "小【大】，小乘【宋】【元】【明】【甲】"}
{"id": null, "n": "0315039", "target": "#nkr_note_mod_0315039", "type": "mod", "text": "樂【大】，〔－〕【甲】"}
{"id": null, "n": "0315040", "target": "#nkr_note_mod_0315040", "type": "mod", "text": "觀行儀軌【大】，經【宋】【元】【明】，究竟儀則【甲】"}
