{"id": null, "n": null, "target": null, "type": null, "text": "四十九載"}
{"id": null, "n": "0925001", "target": "#nkr_note_mod_0925001", "type": "mod", "text": "黃【大】，元【考偽-原】【考偽-甲】"}
{"id": null, "n": "0925002", "target": "#nkr_note_mod_0925002", "type": "mod", "text": "州【大】，翊【校異-原】"}
{"id": null, "n": "0925003", "target": "#nkr_note_mod_0925003", "type": "mod", "text": "鹿【大】，虎【考偽-原】【考偽-甲】，兔【考偽-原】【考偽-甲】"}
{"id": null, "n": "0925004", "target": "#nkr_note_mod_0925004", "type": "mod", "text": "目送【大】，自遂【校異-原】"}
{"id": null, "n": "0925005", "target": "#nkr_note_mod_0925005", "type": "mod", "text": "間【大】，問【考偽-甲】"}
{"id": null, "n": "0925006", "target": "#nkr_note_mod_0925006", "type": "mod", "text": "聲【大】，磬【校異-原】，磬【甲】，聲【校異-甲】"}
{"id": null, "n": "0925007", "target": "#nkr_note_mod_0925007", "type": "mod", "text": "山【大】，山中【甲】"}
{"id": null, "n": "0925008", "target": "#nkr_note_mod_0925008", "type": "mod", "text": "若喚【大】，喚若【甲】"}
{"id": null, "n": "0925009", "target": "#nkr_note_mod_0925009", "type": "mod", "text": "入【大】，人【甲】，入【考偽-甲】"}
{"id": null, "n": "0925010", "target": "#nkr_note_mod_0925010", "type": "mod", "text": "黑【大】，異【校異-原】"}
{"id": null, "n": "0925011", "target": "#nkr_note_mod_0925011", "type": "mod", "text": "澡【大】，滲【校異-原】"}
{"id": null, "n": "0926001", "target": "#nkr_note_mod_0926001", "type": "mod", "text": "若【大】，每【甲】，若【考偽-甲】"}
{"id": null, "n": "0926002", "target": "#nkr_note_mod_0926002", "type": "mod", "text": "轉【大】，〔－〕【甲】"}
{"id": null, "n": "0926003", "target": "#nkr_note_mod_0926003", "type": "mod", "text": "若【大】，𣳬【甲】，若【考偽-甲】"}
{"id": null, "n": "0926004", "target": "#nkr_note_mod_0926004", "type": "mod", "text": "作【大】，〔－〕【校異-甲】"}
{"id": null, "n": "0926005", "target": "#nkr_note_mod_0926005", "type": "mod", "text": "（靈…云）六字【大】，〔－〕【甲】"}
{"id": null, "n": "0926006", "target": "#nkr_note_mod_0926006", "type": "mod", "text": "載【大】，載元祿十六年二月十六日以淨嚴和上之本再校了尊敬【甲】"}
{"id": null, "n": "0924018", "target": "#nkr_note_orig_0924018", "type": "orig", "text": "【原】縮刷大藏經，【甲】黃蘗版淨嚴等校訂加筆本塚本賢曉氏藏"}
{"id": null, "n": "0925001", "target": "#nkr_note_orig_0925001", "type": "orig", "text": "黃＝元ヵ【原】【甲】"}
{"id": null, "n": "0925002", "target": "#nkr_note_orig_0925002", "type": "orig", "text": "州＝翊ィ【原】"}
{"id": null, "n": "0925003", "target": "#nkr_note_orig_0925003", "type": "orig", "text": "鹿＝虎ヵ【原】【甲】，兔ヵ【原】【甲】"}
{"id": null, "n": "0925004", "target": "#nkr_note_orig_0925004", "type": "orig", "text": "目送＝自遂ィ【原】"}
{"id": null, "n": "0925005", "target": "#nkr_note_orig_0925005", "type": "orig", "text": "間＝問ヵ【甲】"}
{"id": null, "n": "0925006", "target": "#nkr_note_orig_0925006", "type": "orig", "text": "聲＝磬ィ【原】，聲＝磬【甲】，聲ィ【甲】"}
{"id": null, "n": "0925007", "target": "#nkr_note_orig_0925007", "type": "orig", "text": "山＋（中）【甲】"}
{"id": null, "n": "0925008", "target": "#nkr_note_orig_0925008", "type": "orig", "text": "若喚＝喚若【甲】"}
{"id": null, "n": "0925009", "target": "#nkr_note_orig_0925009", "type": "orig", "text": "入＝人【甲】，入ヵ【甲】"}
{"id": null, "n": "0925010", "target": "#nkr_note_orig_0925010", "type": "orig", "text": "黑＝異ィ【原】"}
{"id": null, "n": "0925011", "target": "#nkr_note_orig_0925011", "type": "orig", "text": "澡＝滲ィ【原】"}
{"id": null, "n": "0926001", "target": "#nkr_note_orig_0926001", "type": "orig", "text": "若＝每【甲】，若ヵ【甲】"}
{"id": null, "n": "0926002", "target": "#nkr_note_orig_0926002", "type": "orig", "text": "〔轉〕－【甲】"}
{"id": null, "n": "0926003", "target": "#nkr_note_orig_0926003", "type": "orig", "text": "若＝𣳬【甲】，若ヵ【甲】"}
{"id": null, "n": "0926004", "target": "#nkr_note_orig_0926004", "type": "orig", "text": "〔作〕ィ－【甲】"}
{"id": null, "n": "0926005", "target": "#nkr_note_orig_0926005", "type": "orig", "text": "〔靈…云〕六字－【甲】"}
{"id": null, "n": "0926006", "target": "#nkr_note_orig_0926006", "type": "orig", "text": "載＋（元祿十六年二月十六日以淨嚴和上之本再校了尊敬）二十二字【甲】"}
