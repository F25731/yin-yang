{"id": null, "n": "0190040", "target": "#nkr_note_mod_0190040", "type": "mod", "text": "受【大】，授【甲】"}
{"id": null, "n": "0190041", "target": "#nkr_note_mod_0190041", "type": "mod", "text": "普【大】，並【甲】"}
{"id": null, "n": "0190042", "target": "#nkr_note_mod_0190042", "type": "mod", "text": "浴澡【大】，澡浴【甲】"}
{"id": null, "n": "0190043", "target": "#nkr_note_mod_0190043", "type": "mod", "text": "言【大】，言曰【甲】"}
{"id": null, "n": "0190044", "target": "#nkr_note_mod_0190044", "type": "mod", "text": "嚩【大】＊，縛【甲】＊"}
{"id": null, "n": "0190045", "target": "#nkr_note_mod_0190045", "type": "mod", "text": "一【大】，〔－〕【甲】"}
{"id": null, "n": "0190046", "target": "#nkr_note_mod_0190046", "type": "mod", "text": "引【大】＊，〔－〕【甲】＊"}
{"id": null, "n": "0190047", "target": "#nkr_note_mod_0190047", "type": "mod", "text": "屈左【大】，次屈【甲】"}
{"id": null, "n": "0190048", "target": "#nkr_note_mod_0190048", "type": "mod", "text": "念【大】，仰【甲】"}
{"id": null, "n": "0191001", "target": "#nkr_note_mod_0191001", "type": "mod", "text": "賀【大】＊，賀引【甲】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0191002", "target": "#nkr_note_mod_0191002", "type": "mod", "text": "諸【大】，諸持【甲】"}
{"id": null, "n": "0191004", "target": "#nkr_note_mod_0191004", "type": "mod", "text": "心【大】，誠【甲】"}
{"id": null, "n": "0191005", "target": "#nkr_note_mod_0191005", "type": "mod", "text": "𭊘【大】，部【甲】"}
{"id": null, "n": "0191006", "target": "#nkr_note_mod_0191006", "type": "mod", "text": "蠱【大】，毒虫【甲】"}
{"id": null, "n": "0191007", "target": "#nkr_note_mod_0191007", "type": "mod", "text": "事【大】，事辟除【甲】"}
{"id": null, "n": "0191008", "target": "#nkr_note_mod_0191008", "type": "mod", "text": "捨【大】，捧【甲】"}
{"id": null, "n": "0191009", "target": "#nkr_note_mod_0191009", "type": "mod", "text": "修【大】，滌【甲】"}
{"id": null, "n": "0191010", "target": "#nkr_note_mod_0191010", "type": "mod", "text": "盟【大】，𭽾【甲】"}
{"id": null, "n": "0191011", "target": "#nkr_note_mod_0191011", "type": "mod", "text": "（印流出…明照一切）三百四十字【大】，〔－〕【甲】"}
{"id": null, "n": "0191012", "target": "#nkr_note_mod_0191012", "type": "mod", "text": "眉【大】，肩【甲】"}
{"id": null, "n": "0192001", "target": "#nkr_note_mod_0192001", "type": "mod", "text": "引【大】，二合引【甲】"}
{"id": null, "n": "0192002", "target": "#nkr_note_mod_0192002", "type": "mod", "text": "二合二【大】，〔－〕【甲】"}
{"id": null, "n": "0192003", "target": "#nkr_note_mod_0192003", "type": "mod", "text": "合【大】，合二【甲】"}
{"id": null, "n": "0192004", "target": "#nkr_note_mod_0192004", "type": "mod", "text": "普嚕二合【大】，普二合嚕五【甲】"}
{"id": null, "n": "0192005", "target": "#nkr_note_mod_0192005", "type": "mod", "text": "𡃤【大】，喇【甲】"}
{"id": null, "n": "0192006", "target": "#nkr_note_mod_0192006", "type": "mod", "text": "失本心乃至證悉地三百十三字甲本欠"}
{"id": null, "n": "0192007", "target": "#nkr_note_mod_0192007", "type": "mod", "text": "甲本有進力屈上節一句"}
{"id": null, "n": "0192008", "target": "#nkr_note_mod_0192008", "type": "mod", "text": "𠺶𭊘【大】，納部【甲】"}
{"id": null, "n": "0192009", "target": "#nkr_note_mod_0192009", "type": "mod", "text": "𡃤二合【大】，賴【甲】"}
{"id": null, "n": "0192010", "target": "#nkr_note_mod_0192010", "type": "mod", "text": "數【大】，珠【甲】"}
{"id": null, "n": "0192011", "target": "#nkr_note_mod_0192011", "type": "mod", "text": "注【大】，住【甲】"}
{"id": null, "n": "0192012", "target": "#nkr_note_mod_0192012", "type": "mod", "text": "聲咳及頻申【大】，𭌏吹及𩓙呻【甲】"}
{"id": null, "n": "0192013", "target": "#nkr_note_mod_0192013", "type": "mod", "text": "忘【大】，妄【明】"}
{"id": null, "n": "0192014", "target": "#nkr_note_mod_0192014", "type": "mod", "text": "當【大】，常【甲】"}
{"id": null, "n": "0192015", "target": "#nkr_note_mod_0192015", "type": "mod", "text": "要略一卷【大】，念誦要略儀軌【甲】"}
{"id": null, "n": "0190039", "target": "#nkr_note_orig_0190039", "type": "orig", "text": "【原】東寺三密藏古寫本，【甲】石山寺藏古寫本"}
{"id": null, "n": "0190040", "target": "#nkr_note_orig_0190040", "type": "orig", "text": "受＝授【甲】"}
{"id": null, "n": "0190041", "target": "#nkr_note_orig_0190041", "type": "orig", "text": "普＝並【甲】"}
{"id": null, "n": "0190042", "target": "#nkr_note_orig_0190042", "type": "orig", "text": "浴澡＝澡浴【甲】"}
{"id": null, "n": "0190043", "target": "#nkr_note_orig_0190043", "type": "orig", "text": "言＋（曰）【甲】"}
{"id": null, "n": "0190044", "target": "#nkr_note_orig_0190044", "type": "orig", "text": "嚩＝縛【甲】＊"}
{"id": null, "n": "0190045", "target": "#nkr_note_orig_0190045", "type": "orig", "text": "〔一〕－【甲】"}
{"id": null, "n": "0190046", "target": "#nkr_note_orig_0190046", "type": "orig", "text": "〔引〕－【甲】＊"}
{"id": null, "n": "0190047", "target": "#nkr_note_orig_0190047", "type": "orig", "text": "屈左＝次屈【甲】"}
{"id": null, "n": "0190048", "target": "#nkr_note_orig_0190048", "type": "orig", "text": "念＝仰【甲】"}
{"id": null, "n": "0191001", "target": "#nkr_note_orig_0191001", "type": "orig", "text": "賀＋（引）細註【甲】＊"}
{"id": null, "n": "0191002", "target": "#nkr_note_orig_0191002", "type": "orig", "text": "諸＋（持）【甲】"}
{"id": null, "n": "0191003", "target": "#nkr_note_orig_0191003", "type": "orig", "text": "次下甲本有遍想金剛藏王眾一句"}
{"id": null, "n": "0191004", "target": "#nkr_note_orig_0191004", "type": "orig", "text": "心＝誠【甲】"}
{"id": null, "n": "0191005", "target": "#nkr_note_orig_0191005", "type": "orig", "text": "𭊘＝部【甲】"}
{"id": null, "n": "0191006", "target": "#nkr_note_orig_0191006", "type": "orig", "text": "蠱＝毒虫【甲】"}
{"id": null, "n": "0191007", "target": "#nkr_note_orig_0191007", "type": "orig", "text": "事＋（辟除）【甲】"}
{"id": null, "n": "0191008", "target": "#nkr_note_orig_0191008", "type": "orig", "text": "捨＝捧【甲】"}
{"id": null, "n": "0191009", "target": "#nkr_note_orig_0191009", "type": "orig", "text": "修＝滌【甲】"}
{"id": null, "n": "0191010", "target": "#nkr_note_orig_0191010", "type": "orig", "text": "盟＝𭽾【甲】"}
{"id": null, "n": "0191011", "target": "#nkr_note_orig_0191011", "type": "orig", "text": "印流出乃至明照一切三百四十字甲本欠"}
{"id": null, "n": "0191012", "target": "#nkr_note_orig_0191012", "type": "orig", "text": "眉＝肩【甲】"}
{"id": null, "n": "0192001", "target": "#nkr_note_orig_0192001", "type": "orig", "text": "（二合）＋引【甲】"}
{"id": null, "n": "0192002", "target": "#nkr_note_orig_0192002", "type": "orig", "text": "〔二合二〕－【甲】"}
{"id": null, "n": "0192003", "target": "#nkr_note_orig_0192003", "type": "orig", "text": "合＋（二）【甲】"}
{"id": null, "n": "0192004", "target": "#nkr_note_orig_0192004", "type": "orig", "text": "普嚕二合＝普二合嚕五【甲】"}
{"id": null, "n": "0192005", "target": "#nkr_note_orig_0192005", "type": "orig", "text": "𡃤＝喇【甲】"}
{"id": null, "n": "0192006", "target": "#nkr_note_orig_0192006", "type": "orig", "text": "失本心乃至證悉地三百十三字甲本欠"}
{"id": null, "n": "0192007", "target": "#nkr_note_orig_0192007", "type": "orig", "text": "甲本有進力屈上節一句"}
{"id": null, "n": "0192008", "target": "#nkr_note_orig_0192008", "type": "orig", "text": "𠺶𭊘＝納部【甲】"}
{"id": null, "n": "0192009", "target": "#nkr_note_orig_0192009", "type": "orig", "text": "𡃤二合＝賴【甲】"}
{"id": null, "n": "0192010", "target": "#nkr_note_orig_0192010", "type": "orig", "text": "數＝珠【甲】"}
{"id": null, "n": "0192011", "target": "#nkr_note_orig_0192011", "type": "orig", "text": "注＝住【甲】"}
{"id": null, "n": "0192012", "target": "#nkr_note_orig_0192012", "type": "orig", "text": "聲咳及頻申＝𭌏吹及𩓙呻【甲】"}
{"id": null, "n": "0192013", "target": "#nkr_note_orig_0192013", "type": "orig", "text": "忘＝妄【明】"}
{"id": null, "n": "0192014", "target": "#nkr_note_orig_0192014", "type": "orig", "text": "當＝常【甲】"}
{"id": null, "n": "0192015", "target": "#nkr_note_orig_0192015", "type": "orig", "text": "要略一卷＝念誦要略儀軌【甲】"}
{"id": null, "n": "0192016", "target": "#nkr_note_orig_0192016", "type": "orig", "text": "以下甲本無之，此行原本朱書"}
{"id": null, "n": "0192017", "target": "#nkr_note_orig_0192017", "type": "orig", "text": "此行原本朱書"}
{"id": null, "n": "0192018", "target": "#nkr_note_orig_0192018", "type": "orig", "text": "此陀羅尼梵字原本朱書"}
