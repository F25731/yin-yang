{"id": null, "n": "0509007", "target": "#nkr_note_mod_0509007", "type": "mod", "text": "第十四【大】，〔－〕【明】"}
{"id": null, "n": "0509008", "target": "#nkr_note_mod_0509008", "type": "mod", "text": "開府…沙門【大】，大興善寺三藏沙門大廣智【宋】【元】【宮】，唐特進試鴻臚卿三藏沙門大廣智【明】"}
{"id": null, "n": "0509009", "target": "#nkr_note_mod_0509009", "type": "mod", "text": "去【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0509010", "target": "#nkr_note_mod_0509010", "type": "mod", "text": "引【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0509011", "target": "#nkr_note_mod_0509011", "type": "mod", "text": "起【大】，超【宋】【元】【明】【宮】"}
{"id": null, "n": "0509012", "target": "#nkr_note_mod_0509012", "type": "mod", "text": "之【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0509013", "target": "#nkr_note_mod_0509013", "type": "mod", "text": "聲【大】，〔－〕【宮】"}
{"id": null, "n": "0509014", "target": "#nkr_note_mod_0509014", "type": "mod", "text": "磋【大】，蹉【宋】【元】【明】【宮】"}
{"id": null, "n": "0509015", "target": "#nkr_note_mod_0509015", "type": "mod", "text": "荼【大】，茶【宮】"}
{"id": null, "n": "0509016", "target": "#nkr_note_mod_0509016", "type": "mod", "text": "隱聲【大】，〔－〕【宮】"}
{"id": null, "n": "0509017", "target": "#nkr_note_mod_0509017", "type": "mod", "text": "婆＋（去）音註【元】【明】"}
{"id": null, "n": "0509018", "target": "#nkr_note_mod_0509018", "type": "mod", "text": "反【大】＊，功【明】＊"}
{"id": null, "n": "0510001", "target": "#nkr_note_mod_0510001", "type": "mod", "text": "上【大】，〔－〕【宮】"}
{"id": null, "n": "0510002", "target": "#nkr_note_mod_0510002", "type": "mod", "text": "品【大】，品第十四【宋】【元】【宮】"}
{"id": null, "n": "0509007", "target": "#nkr_note_orig_0509007", "type": "orig", "text": "〔第十四〕－【明】"}
{"id": null, "n": "0509008", "target": "#nkr_note_orig_0509008", "type": "orig", "text": "開府…沙門＝大興善寺三藏沙門大廣智【宋】【元】【宮】，唐特進試鴻臚卿三藏沙門大廣智【明】"}
{"id": null, "n": "0509009", "target": "#nkr_note_orig_0509009", "type": "orig", "text": "〔去〕－【三】【宮】"}
{"id": null, "n": "0509010", "target": "#nkr_note_orig_0509010", "type": "orig", "text": "〔引〕－【三】"}
{"id": null, "n": "0509011", "target": "#nkr_note_orig_0509011", "type": "orig", "text": "起＝超【三】【宮】"}
{"id": null, "n": "0509012", "target": "#nkr_note_orig_0509012", "type": "orig", "text": "〔之〕－【三】【宮】"}
{"id": null, "n": "0509013", "target": "#nkr_note_orig_0509013", "type": "orig", "text": "〔聲〕－【宮】"}
{"id": null, "n": "0509014", "target": "#nkr_note_orig_0509014", "type": "orig", "text": "磋＝蹉【三】【宮】"}
{"id": null, "n": "0509015", "target": "#nkr_note_orig_0509015", "type": "orig", "text": "荼＝茶【宮】"}
{"id": null, "n": "0509016", "target": "#nkr_note_orig_0509016", "type": "orig", "text": "〔隱聲〕－【宮】"}
{"id": null, "n": "0509017", "target": "#nkr_note_orig_0509017", "type": "orig", "text": "婆＋（去）音註【元】【明】"}
{"id": null, "n": "0509018", "target": "#nkr_note_orig_0509018", "type": "orig", "text": "反＝功【明】＊"}
