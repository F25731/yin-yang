{"id": null, "n": null, "target": null, "type": null, "text": "震孫"}
{"id": null, "n": null, "target": null, "type": null, "text": "心月"}
{"id": null, "n": null, "target": null, "type": null, "text": "普濟"}
{"id": null, "n": null, "target": null, "type": null, "text": "問答提綱不錄。"}
{"id": null, "n": null, "target": null, "type": null, "text": "良久，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "良久，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "喝一喝"}
{"id": null, "n": null, "target": null, "type": null, "text": "顧大眾云"}
{"id": null, "n": null, "target": null, "type": null, "text": "問答不錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "問答不錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "良久，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈，下座。"}
{"id": null, "n": null, "target": null, "type": null, "text": "良久，云"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主\n丈一下，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "喝一喝"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈一下云"}
{"id": null, "n": null, "target": null, "type": null, "text": "良久，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "驀拈主丈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "顧視大眾云："}
{"id": null, "n": null, "target": null, "type": null, "text": "良\n\n久，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "擲主丈，下座。"}
{"id": null, "n": null, "target": null, "type": null, "text": "顧視大眾云："}
{"id": null, "n": null, "target": null, "type": null, "text": "以䟽付僧云"}
{"id": null, "n": null, "target": null, "type": null, "text": "良\n久，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "良久，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "良久，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "顧視大眾云"}
{"id": null, "n": null, "target": null, "type": null, "text": "指禪床云"}
{"id": null, "n": null, "target": null, "type": null, "text": "擲主丈，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "良久，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "喝一喝"}
{"id": null, "n": null, "target": null, "type": null, "text": "擲主丈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "拈起示眾云"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈云："}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "擲\n主丈下座"}
{"id": null, "n": null, "target": null, "type": null, "text": "良久，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "喝一喝"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "以手拍禪床，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "靠主丈，下\n座："}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "休使奉化"}
{"id": null, "n": null, "target": null, "type": null, "text": "破衫袖"}
{"id": null, "n": null, "target": null, "type": null, "text": "賊贓不受"}
{"id": null, "n": null, "target": null, "type": null, "text": "又使奉化也"}
{"id": null, "n": null, "target": null, "type": null, "text": "喝一喝"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈，下座"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主\n丈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈，下座。"}
{"id": null, "n": null, "target": null, "type": null, "text": "以手作結布袋勢"}
{"id": null, "n": null, "target": null, "type": null, "text": "徹底\n老婆心"}
{"id": null, "n": null, "target": null, "type": null, "text": "慚愧慚愧"}
{"id": null, "n": null, "target": null, "type": null, "text": "又與麼去"}
{"id": null, "n": null, "target": null, "type": null, "text": "舌頭拖地"}
{"id": null, "n": null, "target": null, "type": null, "text": "三顆也有"}
{"id": null, "n": null, "target": null, "type": null, "text": "作賊人心虛"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "以拂子擊禪床，云"}
{"id": null, "n": null, "target": null, "type": null, "text": "良久，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈云"}
{"id": null, "n": null, "target": null, "type": null, "text": "以主丈畫一畫，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "卓主丈，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "良久，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "竪起拂子，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "良久，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "曾聽請"}
{"id": null, "n": null, "target": null, "type": null, "text": "得華嚴閣下朝旨歸"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "天童彌藏主"}
{"id": null, "n": null, "target": null, "type": null, "text": "十二"}
{"id": null, "n": null, "target": null, "type": null, "text": "看月象"}
{"id": null, "n": null, "target": null, "type": null, "text": "提魚籃像"}
{"id": null, "n": null, "target": null, "type": null, "text": "六"}
{"id": null, "n": null, "target": null, "type": null, "text": "嵓雪巢索，以三脚驢、金剛圈、栗棘蓬三物為犯禁，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "倚松看經象"}
