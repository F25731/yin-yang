{"id": null, "n": null, "target": null, "type": null, "text": "廿五帖有外題五帖無外題一帖無表紙"}
{"id": null, "n": null, "target": null, "type": null, "text": "每帖複各十卷但第四帖末有南天竺王進梵本經願文"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "金剛智譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯　後題云一字頂輪王瑜伽究竟儀軌一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯　後題云觀自在多羅菩薩儀軌經"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "複十卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "複十卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯端有灑淨等胎藏界諸\n尊真言菩薩護摩真言金剛歌讚等"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯　末有十八道頸次第"}
{"id": null, "n": null, "target": null, "type": null, "text": "複四卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "複三卷不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "複三卷不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "複三卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "第六第廿末有諸經儀軌等策子目錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "下卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空\n譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "般若三藏譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "註云於十萬廣頌中略出云云　不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "注云出烏波離所問經云云　不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "末有施不動尊殘食真言菩薩\n消息"}
{"id": null, "n": null, "target": null, "type": null, "text": "注云通頂諸佛不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空\n譯有梵字"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "注云亦名訶利帝母法不\n空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "金剛智與不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "注云出不空羂索經二十八卷有梵字不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "注云出吉祥勝初教王瑜\n伽經不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "注云此禮出大乘一切佛境界\n智光明莊嚴經不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "無畏一行譯末有毘盧遮那悉地流出相應句陀羅\n尼"}
{"id": null, "n": null, "target": null, "type": null, "text": "內有段段廣於恒例本"}
{"id": null, "n": null, "target": null, "type": null, "text": "題下注云一名難勝奮怒王真言"}
{"id": null, "n": null, "target": null, "type": null, "text": "金剛\n智譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "般若斫揭羅譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "末云上元縣高公寺摩訶衍和尚授"}
{"id": null, "n": null, "target": null, "type": null, "text": "此策子初有􄗦􄙖􄕯􅚤等六行梵真言後勘可知又尊勝真言初有\n爾時世尊知帝釋意心之所念等一行餘長行與恒例本少異"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空遍知譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "聖者欝楞迦造不空譯以朱科段也"}
{"id": null, "n": null, "target": null, "type": null, "text": "有第二十\n二帙中疑前本歟"}
{"id": null, "n": null, "target": null, "type": null, "text": "有梵字"}
{"id": null, "n": null, "target": null, "type": null, "text": "但自恣頌與恒例異是菩提自恣頌歟"}
{"id": null, "n": null, "target": null, "type": null, "text": "以墨斷句"}
{"id": null, "n": null, "target": null, "type": null, "text": "願此音聲對物變改等等等"}
{"id": null, "n": null, "target": null, "type": null, "text": "有點"}
{"id": null, "n": null, "target": null, "type": null, "text": "有梵字"}
{"id": null, "n": null, "target": null, "type": null, "text": "有梵字"}
{"id": null, "n": null, "target": null, "type": null, "text": "有梵字"}
{"id": null, "n": null, "target": null, "type": null, "text": "內有三部小呪梵字私云與前同歟"}
{"id": null, "n": null, "target": null, "type": null, "text": "有梵字私云與前同歟"}
{"id": null, "n": null, "target": null, "type": null, "text": "私云是與\n前本同歟"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯私云與前同歟"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯私云與前同歟但末不足"}
{"id": null, "n": null, "target": null, "type": null, "text": "有梵字"}
{"id": null, "n": null, "target": null, "type": null, "text": "有梵字"}
{"id": null, "n": null, "target": null, "type": null, "text": "有梵字私云與前同本歟"}
{"id": null, "n": null, "target": null, "type": null, "text": "私云與前本同歟但以有梵字字輪可為異"}
{"id": null, "n": null, "target": null, "type": null, "text": "有朱點後題云仁王般若波羅密多釋真\n言"}
{"id": null, "n": null, "target": null, "type": null, "text": "􄖩􄗦􄕗􄗙􄩞􄗱􄗲"}
{"id": null, "n": null, "target": null, "type": null, "text": "若隨求歟可知勘之"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云勘可知之"}
{"id": null, "n": null, "target": null, "type": null, "text": "下有功能義"}
{"id": null, "n": null, "target": null, "type": null, "text": "勘可知之"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "末云長安三年正月二十三日北天竺國三藏僧阿儞真那宣譯梵本婆羅門大首領臣李無\n諂譯語僧尸利秣哆證譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "私云例少異"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上二十九帖皆有紫色表紙"}
{"id": null, "n": null, "target": null, "type": null, "text": "不空譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "之中二十九帖有黑紫絹表紙一帖無表紙"}
{"id": null, "n": "1066002", "target": "#nkr_note_mod_1066002", "type": "mod", "text": "瑜【大】，准【校異-原】"}
{"id": null, "n": "1066003", "target": "#nkr_note_mod_1066003", "type": "mod", "text": "毘【大】，略【考偽-原】"}
{"id": null, "n": "1066004", "target": "#nkr_note_mod_1066004", "type": "mod", "text": "母【大】，女【校異-原】"}
{"id": null, "n": "1066001", "target": "#nkr_note_orig_1066001", "type": "orig", "text": "【原】大日本佛教全書"}
