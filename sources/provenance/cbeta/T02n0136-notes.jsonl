{"id": null, "n": "0859008", "target": "#nkr_note_mod_0859008", "type": "mod", "text": "藏【大】，藏法師【宋】【元】【明】"}
{"id": null, "n": "0859009", "target": "#nkr_note_mod_0859009", "type": "mod", "text": "聞【大】，間【明】"}
{"id": null, "n": "0859010", "target": "#nkr_note_mod_0859010", "type": "mod", "text": "處【大】，眾【宋】【元】【明】"}
{"id": null, "n": "0859011", "target": "#nkr_note_mod_0859011", "type": "mod", "text": "所【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0859012", "target": "#nkr_note_mod_0859012", "type": "mod", "text": "有【大】，有法【宋】【元】【明】"}
{"id": null, "n": "0859013", "target": "#nkr_note_mod_0859013", "type": "mod", "text": "（右一經…耳）此記【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0859008", "target": "#nkr_note_orig_0859008", "type": "orig", "text": "藏＋（法師）【三】"}
{"id": null, "n": "0859009", "target": "#nkr_note_orig_0859009", "type": "orig", "text": "聞＝間【明】"}
{"id": null, "n": "0859010", "target": "#nkr_note_orig_0859010", "type": "orig", "text": "處＝眾【三】"}
{"id": null, "n": "0859011", "target": "#nkr_note_orig_0859011", "type": "orig", "text": "〔所〕－【三】"}
{"id": null, "n": "0859012", "target": "#nkr_note_orig_0859012", "type": "orig", "text": "有＋（法）【三】"}
{"id": null, "n": "0859013", "target": "#nkr_note_orig_0859013", "type": "orig", "text": "〔右一經…耳〕此記－【三】"}
