{"id": null, "n": null, "target": null, "type": null, "text": "四十九載"}
{"id": null, "n": "0726002", "target": "#nkr_note_mod_0726002", "type": "mod", "text": "利【大】，壽【甲】"}
{"id": null, "n": "0726003", "target": "#nkr_note_mod_0726003", "type": "mod", "text": "摧【大】，握【校異-原】，擁【甲】"}
{"id": null, "n": "0726004", "target": "#nkr_note_mod_0726004", "type": "mod", "text": "至【大】，乃至【校異-原】"}
{"id": null, "n": "0726005", "target": "#nkr_note_mod_0726005", "type": "mod", "text": "莂【大】，別【甲】"}
{"id": null, "n": "0726006", "target": "#nkr_note_mod_0726006", "type": "mod", "text": "作【大】，〔－〕【校異-原】"}
{"id": null, "n": "0726007", "target": "#nkr_note_mod_0726007", "type": "mod", "text": "感【大】，感得【校異-原】"}
{"id": null, "n": "0726008", "target": "#nkr_note_mod_0726008", "type": "mod", "text": "導【大】，道【校異-原】"}
{"id": null, "n": "0726010", "target": "#nkr_note_mod_0726010", "type": "mod", "text": "跛【大】，跋【甲】"}
{"id": null, "n": "0726011", "target": "#nkr_note_mod_0726011", "type": "mod", "text": "迷【大】，迷二合【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0726012", "target": "#nkr_note_mod_0726012", "type": "mod", "text": "閉【大】，閉二合【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0726013", "target": "#nkr_note_mod_0726013", "type": "mod", "text": "合【大】＊，合引【甲】＊"}
{"id": null, "n": "0726014", "target": "#nkr_note_mod_0726014", "type": "mod", "text": "􆿅【大】，〔－〕【校異-原】"}
{"id": null, "n": "0726015", "target": "#nkr_note_mod_0726015", "type": "mod", "text": "二合【大】，〔－〕【甲】"}
{"id": null, "n": "0726016", "target": "#nkr_note_mod_0726016", "type": "mod", "text": "難【大】，難上【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "上"}
{"id": null, "n": "0726017", "target": "#nkr_note_mod_0726017", "type": "mod", "text": "彌【大】，弭【甲】"}
{"id": null, "n": "0726018", "target": "#nkr_note_mod_0726018", "type": "mod", "text": "阿【大】，何【甲】"}
{"id": null, "n": "0726019", "target": "#nkr_note_mod_0726019", "type": "mod", "text": "引【大】，〔－〕【甲】"}
{"id": null, "n": "0727001", "target": "#nkr_note_mod_0727001", "type": "mod", "text": "嚩【大】＊，嚩入【甲】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "入"}
{"id": null, "n": "0727002", "target": "#nkr_note_mod_0727002", "type": "mod", "text": "曩【大】，曩十二【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "十二"}
{"id": null, "n": "0727003", "target": "#nkr_note_mod_0727003", "type": "mod", "text": "􆷱【大】，〔－〕【校異-原】"}
{"id": null, "n": "0727004", "target": "#nkr_note_mod_0727004", "type": "mod", "text": "娑【大】，婆【校異-原】"}
{"id": null, "n": "0727005", "target": "#nkr_note_mod_0727005", "type": "mod", "text": "􄚲【大】，〔－〕【校異-原】"}
{"id": null, "n": "0727006", "target": "#nkr_note_mod_0727006", "type": "mod", "text": "賀【大】＊，賀引【甲】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0727007", "target": "#nkr_note_mod_0727007", "type": "mod", "text": "嚩【大】，嚩二合引【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合引"}
{"id": null, "n": "0727008", "target": "#nkr_note_mod_0727008", "type": "mod", "text": "椎【大】＊，推【校異-原】＊"}
{"id": null, "n": "0727009", "target": "#nkr_note_mod_0727009", "type": "mod", "text": "曬【大】，曬二合【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0727010", "target": "#nkr_note_mod_0727010", "type": "mod", "text": "塔【大】，塔了塔【甲】"}
{"id": null, "n": "0727011", "target": "#nkr_note_mod_0727011", "type": "mod", "text": "入【大】，〔－〕【甲】"}
{"id": null, "n": "0727012", "target": "#nkr_note_mod_0727012", "type": "mod", "text": "微【大】，〔－〕【校異-原】"}
{"id": null, "n": "0727013", "target": "#nkr_note_mod_0727013", "type": "mod", "text": "永離【大】，〔－〕【甲】"}
{"id": null, "n": "0727014", "target": "#nkr_note_mod_0727014", "type": "mod", "text": "空【大】，空處【校異-原】，高【甲】"}
{"id": null, "n": "0727015", "target": "#nkr_note_mod_0727015", "type": "mod", "text": "告【大】，旨【校異-原】，示【甲】"}
{"id": null, "n": "0727016", "target": "#nkr_note_mod_0727016", "type": "mod", "text": "造塔功德【大】，而興造塔【甲】"}
{"id": null, "n": "0727018", "target": "#nkr_note_mod_0727018", "type": "mod", "text": "說【大】，證【甲】"}
{"id": null, "n": "0728001", "target": "#nkr_note_mod_0728001", "type": "mod", "text": "教【大】，敬【甲】"}
{"id": null, "n": "0728003", "target": "#nkr_note_mod_0728003", "type": "mod", "text": "靈雲校本云貞享四丁卯稔中春二十三日一校了淨嚴四十九載【大】，〔－〕【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "四十九載"}
{"id": null, "n": "0726001", "target": "#nkr_note_orig_0726001", "type": "orig", "text": "【原】縮刷大藏經，原本冠註曰此經麗宋元明四本俱欠今對校檗本，【甲】三十帖策子第十七帖"}
{"id": null, "n": "0726002", "target": "#nkr_note_orig_0726002", "type": "orig", "text": "利＝壽【甲】"}
{"id": null, "n": "0726003", "target": "#nkr_note_orig_0726003", "type": "orig", "text": "摧＝握ィ【原】，擁【甲】"}
{"id": null, "n": "0726004", "target": "#nkr_note_orig_0726004", "type": "orig", "text": "（乃）ィ＋至【原】"}
{"id": null, "n": "0726005", "target": "#nkr_note_orig_0726005", "type": "orig", "text": "莂＝別【甲】"}
{"id": null, "n": "0726006", "target": "#nkr_note_orig_0726006", "type": "orig", "text": "〔作〕ィ－【原】"}
{"id": null, "n": "0726007", "target": "#nkr_note_orig_0726007", "type": "orig", "text": "感＋（得）ィ【原】"}
{"id": null, "n": "0726008", "target": "#nkr_note_orig_0726008", "type": "orig", "text": "導＝道ィ【原】"}
{"id": null, "n": "0726009", "target": "#nkr_note_orig_0726009", "type": "orig", "text": "甲本梵字總無之"}
{"id": null, "n": "0726010", "target": "#nkr_note_orig_0726010", "type": "orig", "text": "跛＝跋【甲】"}
{"id": null, "n": "0726011", "target": "#nkr_note_orig_0726011", "type": "orig", "text": "迷＋（二合）細註【甲】"}
{"id": null, "n": "0726012", "target": "#nkr_note_orig_0726012", "type": "orig", "text": "閉＋（二合）細註【甲】"}
{"id": null, "n": "0726013", "target": "#nkr_note_orig_0726013", "type": "orig", "text": "合＋（引）【甲】＊"}
{"id": null, "n": "0726014", "target": "#nkr_note_orig_0726014", "type": "orig", "text": "〔􆿅〕ィ－【原】"}
{"id": null, "n": "0726015", "target": "#nkr_note_orig_0726015", "type": "orig", "text": "〔二合〕－【甲】"}
{"id": null, "n": "0726016", "target": "#nkr_note_orig_0726016", "type": "orig", "text": "難＋（上）細註【甲】"}
{"id": null, "n": "0726017", "target": "#nkr_note_orig_0726017", "type": "orig", "text": "彌＝弭【甲】"}
{"id": null, "n": "0726018", "target": "#nkr_note_orig_0726018", "type": "orig", "text": "阿＝何【甲】"}
{"id": null, "n": "0726019", "target": "#nkr_note_orig_0726019", "type": "orig", "text": "〔引〕－【甲】"}
{"id": null, "n": "0727001", "target": "#nkr_note_orig_0727001", "type": "orig", "text": "嚩＋（入）細註【甲】＊"}
{"id": null, "n": "0727002", "target": "#nkr_note_orig_0727002", "type": "orig", "text": "曩＋（十二）細註【甲】"}
{"id": null, "n": "0727003", "target": "#nkr_note_orig_0727003", "type": "orig", "text": "〔􆷱〕ィ－【原】"}
{"id": null, "n": "0727004", "target": "#nkr_note_orig_0727004", "type": "orig", "text": "娑＝婆ィ【原】"}
{"id": null, "n": "0727005", "target": "#nkr_note_orig_0727005", "type": "orig", "text": "〔􄚲〕ィ－【原】"}
{"id": null, "n": "0727006", "target": "#nkr_note_orig_0727006", "type": "orig", "text": "賀＋（引）細註【甲】＊"}
{"id": null, "n": "0727007", "target": "#nkr_note_orig_0727007", "type": "orig", "text": "嚩＋（二合引）細註【甲】"}
{"id": null, "n": "0727008", "target": "#nkr_note_orig_0727008", "type": "orig", "text": "椎＝推ィ【原】＊"}
{"id": null, "n": "0727009", "target": "#nkr_note_orig_0727009", "type": "orig", "text": "曬＋（二合）細註【甲】"}
{"id": null, "n": "0727010", "target": "#nkr_note_orig_0727010", "type": "orig", "text": "塔＋（了塔）【甲】"}
{"id": null, "n": "0727011", "target": "#nkr_note_orig_0727011", "type": "orig", "text": "〔入〕－【甲】"}
{"id": null, "n": "0727012", "target": "#nkr_note_orig_0727012", "type": "orig", "text": "〔微〕ィ－【原】"}
{"id": null, "n": "0727013", "target": "#nkr_note_orig_0727013", "type": "orig", "text": "〔永離〕－【甲】"}
{"id": null, "n": "0727014", "target": "#nkr_note_orig_0727014", "type": "orig", "text": "空＋（處）ィ【原】，空＝高【甲】"}
{"id": null, "n": "0727015", "target": "#nkr_note_orig_0727015", "type": "orig", "text": "告＝旨ィ【原】，示【甲】"}
{"id": null, "n": "0727016", "target": "#nkr_note_orig_0727016", "type": "orig", "text": "造塔功德＝而興造塔【甲】"}
{"id": null, "n": "0727017", "target": "#nkr_note_orig_0727017", "type": "orig", "text": "以下檗本無之"}
{"id": null, "n": "0727018", "target": "#nkr_note_orig_0727018", "type": "orig", "text": "說＝證【甲】"}
{"id": null, "n": "0728001", "target": "#nkr_note_orig_0728001", "type": "orig", "text": "教＝敬【甲】"}
{"id": null, "n": "0728002", "target": "#nkr_note_orig_0728002", "type": "orig", "text": "此次行甲本有貞元二十年十一月三日譯畢八日進上十六字"}
{"id": null, "n": "0728003", "target": "#nkr_note_orig_0728003", "type": "orig", "text": "以下甲本無之"}
{"id": null, "n": "0727a1401", "target": "#nkr_note_add_0727a1401", "type": "add", "text": "為配合悉漢對照，故將 p727a14 中文與 p727a15 悉曇字前後對調。"}
{"id": null, "n": "0727b0501", "target": "#nkr_note_add_0727b0501", "type": "add", "text": "􄑄􄓚􄗱【CB】，􇥗【大】"}
{"id": null, "n": "0727c0101", "target": "#nkr_note_add_0727c0101", "type": "add", "text": "􄗹【CB】，􈉂【大】"}
