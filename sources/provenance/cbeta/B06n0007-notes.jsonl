{"id": null, "n": "0369a1501", "target": "#nkr_note_add_0369a1501", "type": "add", "text": "緣於善及不善法【CB】，［－］【補編】"}
{"id": null, "n": "0369a1601", "target": "#nkr_note_add_0369a1601", "type": "add", "text": "善及不善法生【CB】，［－］【補編】"}
{"id": null, "n": "0369a1602", "target": "#nkr_note_add_0369a1602", "type": "add", "text": "法【CB】，［－］【補編】"}
