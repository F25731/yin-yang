{"id": null, "n": "1339001", "target": "#nkr_note_mod_1339001", "type": "mod", "text": "常【大】，〔－〕【考偽-原】"}
{"id": null, "n": "1339002", "target": "#nkr_note_mod_1339002", "type": "mod", "text": "波頭華【大】，〔－〕【考偽-原】"}
{"id": null, "n": "1340001", "target": "#nkr_note_mod_1340001", "type": "mod", "text": "九【大】，鬼【考偽-原】"}
{"id": null, "n": "1340002", "target": "#nkr_note_mod_1340002", "type": "mod", "text": "持【大】，掃【考偽-原】"}
{"id": null, "n": "1342001", "target": "#nkr_note_mod_1342001", "type": "mod", "text": "戒【CB】，式【大】，戒【考偽-原】"}
{"id": null, "n": "1342002", "target": "#nkr_note_mod_1342002", "type": "mod", "text": "聲【CB】【考偽-原】，散【大】"}
{"id": null, "n": "1345002", "target": "#nkr_note_mod_1345002", "type": "mod", "text": "首缺（CBETA 按：今參考「《大通方廣懺悔滅罪莊嚴成佛經》敦煌寶藏校勘版．法護編校增補．大藏文化出版社, 2004」已補足闕漏文字。）"}
{"id": null, "n": "1347001", "target": "#nkr_note_mod_1347001", "type": "mod", "text": "所說【CB】，所【大】，所說【考偽-大】"}
{"id": null, "n": "1352002", "target": "#nkr_note_mod_1352002", "type": "mod", "text": "以是故名佛【大】，〔－〕【甲】"}
{"id": null, "n": "1352003", "target": "#nkr_note_mod_1352003", "type": "mod", "text": "見【大】，是【甲】"}
{"id": null, "n": "1352004", "target": "#nkr_note_mod_1352004", "type": "mod", "text": "悔【大】，懺悔【甲】"}
{"id": null, "n": "1352005", "target": "#nkr_note_mod_1352005", "type": "mod", "text": "等【大】，俱【甲】"}
{"id": null, "n": "1352006", "target": "#nkr_note_mod_1352006", "type": "mod", "text": "佛【大】，佛願得普賢金剛力【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "願得普賢金剛力"}
{"id": null, "n": "1352007", "target": "#nkr_note_mod_1352007", "type": "mod", "text": "普【大】，首【甲】"}
{"id": null, "n": "1352008", "target": "#nkr_note_mod_1352008", "type": "mod", "text": "諸【大】，〔－〕【甲】"}
{"id": null, "n": "1353001", "target": "#nkr_note_mod_1353001", "type": "mod", "text": "訟【大】，誦【甲】"}
{"id": null, "n": "1353002", "target": "#nkr_note_mod_1353002", "type": "mod", "text": "滅罪【CB】【甲】，滅【大】"}
{"id": null, "n": "1353003", "target": "#nkr_note_mod_1353003", "type": "mod", "text": "有【大】，有有【甲】"}
{"id": null, "n": "1353004", "target": "#nkr_note_mod_1353004", "type": "mod", "text": "廣開【大】，開廣【甲】"}
{"id": null, "n": "1353005", "target": "#nkr_note_mod_1353005", "type": "mod", "text": "是皆【大】，皆是【甲】"}
{"id": null, "n": "1353006", "target": "#nkr_note_mod_1353006", "type": "mod", "text": "杈【大】，叉【甲】"}
