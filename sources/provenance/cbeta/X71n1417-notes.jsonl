{"id": null, "n": "0446001", "target": "#nkr_note_orig_0446001", "type": "orig", "text": "□□疑則高"}
{"id": null, "n": "0447001", "target": "#nkr_note_orig_0447001", "type": "orig", "text": "妙上疑脫求字"}
{"id": null, "n": "0447002", "target": "#nkr_note_orig_0447002", "type": "orig", "text": "錢疑鉄"}
