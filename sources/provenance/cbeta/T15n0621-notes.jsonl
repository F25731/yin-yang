{"id": null, "n": "0343003", "target": null, "type": "orig", "text": "〔國〕－【元】"}
{"id": null, "n": "0343003", "target": null, "type": "mod", "text": "國【大】，〔－〕【元】"}
{"id": null, "n": "0343001", "target": "#nkr_note_mod_0343001", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0343002", "target": "#nkr_note_mod_0343002", "type": "mod", "text": "安息國【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "0343003", "target": "#nkr_note_mod_0343003", "type": "mod", "text": "國【大】，〔－〕【元】"}
{"id": null, "n": "0343004", "target": "#nkr_note_mod_0343004", "type": "mod", "text": "安【大】，法師安【明】"}
{"id": null, "n": "0343005", "target": "#nkr_note_mod_0343005", "type": "mod", "text": "百【大】，百千【元】【明】"}
{"id": null, "n": "0343006", "target": "#nkr_note_mod_0343006", "type": "mod", "text": "現【大】＊，見【元】【明】＊"}
{"id": null, "n": "0343007", "target": "#nkr_note_mod_0343007", "type": "mod", "text": "四【大】，三【元】【明】"}
{"id": null, "n": "0343008", "target": "#nkr_note_mod_0343008", "type": "mod", "text": "向【大】，白【元】"}
{"id": null, "n": "0343009", "target": "#nkr_note_mod_0343009", "type": "mod", "text": "疑【大】，設【宮】"}
{"id": null, "n": "0343010", "target": "#nkr_note_mod_0343010", "type": "mod", "text": "且【大】，旦【宋】【元】【明】【宮】"}
{"id": null, "n": "0343011", "target": "#nkr_note_mod_0343011", "type": "mod", "text": "復【大】，復前【元】【明】"}
{"id": null, "n": "0343012", "target": "#nkr_note_mod_0343012", "type": "mod", "text": "聞【大】，〔－〕【元】【明】"}
{"id": null, "n": "0343013", "target": "#nkr_note_mod_0343013", "type": "mod", "text": "劇【大】，處【元】【明】"}
{"id": null, "n": "0343014", "target": "#nkr_note_mod_0343014", "type": "mod", "text": "皆【大】，不【宮】"}
{"id": null, "n": "0343015", "target": "#nkr_note_mod_0343015", "type": "mod", "text": "如行【大】，行何如【元】【明】"}
{"id": null, "n": "0343016", "target": "#nkr_note_mod_0343016", "type": "mod", "text": "間【大】，聞【宋】【元】【明】【宮】"}
{"id": null, "n": "0343017", "target": "#nkr_note_mod_0343017", "type": "mod", "text": "經【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0343018", "target": "#nkr_note_mod_0343018", "type": "mod", "text": "終【大】，無【宋】"}
{"id": null, "n": "0343019", "target": "#nkr_note_mod_0343019", "type": "mod", "text": "四【大】，三【元】【明】【宮】"}
{"id": null, "n": "0343020", "target": "#nkr_note_mod_0343020", "type": "mod", "text": "等【大】，〔－〕【元】【明】"}
{"id": null, "n": "0343021", "target": "#nkr_note_mod_0343021", "type": "mod", "text": "經【大】，經六【宋】【元】【宮】"}
