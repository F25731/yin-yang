{"id": null, "n": "0303002", "target": "#nkr_note_mod_0303002", "type": "mod", "text": "奉詔【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0303003", "target": "#nkr_note_mod_0303003", "type": "mod", "text": "迦【大】，加【甲】，伽【乙】"}
{"id": null, "n": "0303004", "target": "#nkr_note_mod_0303004", "type": "mod", "text": "蘭【大】，蘭陀【考偽-原】"}
{"id": null, "n": "0303005", "target": "#nkr_note_mod_0303005", "type": "mod", "text": "大【大】，大會【甲】【乙】"}
{"id": null, "n": "0303006", "target": "#nkr_note_mod_0303006", "type": "mod", "text": "屬【大】，付屬【甲】【乙】"}
{"id": null, "n": "0303007", "target": "#nkr_note_mod_0303007", "type": "mod", "text": "率【大】＊，𡨧【甲】【乙】＊"}
{"id": null, "n": "0303008", "target": "#nkr_note_mod_0303008", "type": "mod", "text": "都【大】＊，覩【乙】＊"}
{"id": null, "n": "0303009", "target": "#nkr_note_mod_0303009", "type": "mod", "text": "底【大】，摩【甲】，麼【乙】"}
{"id": null, "n": "0303010", "target": "#nkr_note_mod_0303010", "type": "mod", "text": "摩【大】，麼【乙】"}
{"id": null, "n": "0303011", "target": "#nkr_note_mod_0303011", "type": "mod", "text": "起【大】＊，䞘【乙】＊"}
