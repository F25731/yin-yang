{"id": null, "n": "0303013", "target": "#nkr_note_mod_0303013", "type": "mod", "text": "捺【大】，捺羅【甲】【乙】"}
{"id": null, "n": "0303014", "target": "#nkr_note_mod_0303014", "type": "mod", "text": "縛【大】，嚩二合【甲】【乙】"}
{"id": null, "n": "0303015", "target": "#nkr_note_mod_0303015", "type": "mod", "text": "浪拏【大】，泥弩【甲】【乙】"}
{"id": null, "n": "0303016", "target": "#nkr_note_mod_0303016", "type": "mod", "text": "質【大】，𤚥質【乙】"}
{"id": null, "n": "0303017", "target": "#nkr_note_mod_0303017", "type": "mod", "text": "羅【大】，囉【甲】"}
{"id": null, "n": "0303018", "target": "#nkr_note_mod_0303018", "type": "mod", "text": "娑【大】，娑引娑【甲】，婆引娑【乙】"}
{"id": null, "n": "0303019", "target": "#nkr_note_mod_0303019", "type": "mod", "text": "訶【大】，賀訶【甲】【乙】"}
{"id": null, "n": "0303020", "target": "#nkr_note_mod_0303020", "type": "mod", "text": "諾【大】，語【甲】"}
{"id": null, "n": "0303021", "target": "#nkr_note_mod_0303021", "type": "mod", "text": "乞【大】，乞叉【考偽-原】，乞使【甲】【乙】"}
{"id": null, "n": "0303022", "target": "#nkr_note_mod_0303022", "type": "mod", "text": "謨嚕【大】，〔－〕【乙】"}
{"id": null, "n": "0303023", "target": "#nkr_note_mod_0303023", "type": "mod", "text": "謨【大】，莫【甲】，謨曩莫【乙】"}
{"id": null, "n": "0303024", "target": "#nkr_note_mod_0303024", "type": "mod", "text": "一【大】，一娑嚩二合賀二十二【甲】【乙】"}
{"id": null, "n": "0303025", "target": "#nkr_note_mod_0303025", "type": "mod", "text": "若【大】，若有【甲】【乙】"}
{"id": null, "n": "0303026", "target": "#nkr_note_mod_0303026", "type": "mod", "text": "無【大】，〔－〕【乙】"}
{"id": null, "n": "0303027", "target": "#nkr_note_mod_0303027", "type": "mod", "text": "大【大】，大願【乙】"}
{"id": null, "n": "0303028", "target": "#nkr_note_mod_0303028", "type": "mod", "text": "某【大】，其【甲】【乙】"}
{"id": null, "n": "0303029", "target": "#nkr_note_mod_0303029", "type": "mod", "text": "奴婢【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0303030", "target": "#nkr_note_mod_0303030", "type": "mod", "text": "從【大】，僕從【甲】【乙】"}
{"id": null, "n": "0303031", "target": "#nkr_note_mod_0303031", "type": "mod", "text": "不舊【大】，給足不令【甲】【乙】"}
{"id": null, "n": "0303032", "target": "#nkr_note_mod_0303032", "type": "mod", "text": "成所作就【大】，成就所作【甲】【乙】"}
{"id": null, "n": "0303033", "target": "#nkr_note_mod_0303033", "type": "mod", "text": "㲲【大】，疊【乙】"}
{"id": null, "n": "0303034", "target": "#nkr_note_mod_0303034", "type": "mod", "text": "畫【大】，書【乙】"}
{"id": null, "n": "0303035", "target": "#nkr_note_mod_0303035", "type": "mod", "text": "用【大】，亦【甲】【乙】"}
{"id": null, "n": "0303036", "target": "#nkr_note_mod_0303036", "type": "mod", "text": "若【大】，若畫【甲】【乙】"}
{"id": null, "n": "0303037", "target": "#nkr_note_mod_0303037", "type": "mod", "text": "右【大】，外【甲】"}
{"id": null, "n": "0303038", "target": "#nkr_note_mod_0303038", "type": "mod", "text": "劍【大】，劍右上手把【甲】【乙】"}
{"id": null, "n": "0303039", "target": "#nkr_note_mod_0303039", "type": "mod", "text": "俱【大】，〔－〕【甲】"}
{"id": null, "n": "0303040", "target": "#nkr_note_mod_0303040", "type": "mod", "text": "淨軍【大】，軍眾【甲】【乙】，將軍【考偽-原】"}
{"id": null, "n": "0303041", "target": "#nkr_note_mod_0303041", "type": "mod", "text": "阿【大】，〔－〕【甲】"}
{"id": null, "n": "0303042", "target": "#nkr_note_mod_0303042", "type": "mod", "text": "畫【大】，畫天【甲】【乙】"}
{"id": null, "n": "0303043", "target": "#nkr_note_mod_0303043", "type": "mod", "text": "大【大】，〔－〕【乙】"}
{"id": null, "n": "0303044", "target": "#nkr_note_mod_0303044", "type": "mod", "text": "仗【大】，伏【甲】"}
{"id": null, "n": "0303045", "target": "#nkr_note_mod_0303045", "type": "mod", "text": "半【大】，羊【甲】【乙】"}
{"id": null, "n": "0303046", "target": "#nkr_note_mod_0303046", "type": "mod", "text": "猪【大】，諸【乙】"}
{"id": null, "n": "0303047", "target": "#nkr_note_mod_0303047", "type": "mod", "text": "見【大】，〔－〕【乙】"}
{"id": null, "n": "0303048", "target": "#nkr_note_mod_0303048", "type": "mod", "text": "等書畢【大】，見【甲】【乙】"}
{"id": null, "n": "0303049", "target": "#nkr_note_mod_0303049", "type": "mod", "text": "辛【大】，辛畫像了【甲】【乙】"}
{"id": null, "n": "0303050", "target": "#nkr_note_mod_0303050", "type": "mod", "text": "用【大】，食用【甲】【乙】"}
{"id": null, "n": "0303051", "target": "#nkr_note_mod_0303051", "type": "mod", "text": "搓【大】，左搓【甲】【乙】"}
{"id": null, "n": "0303052", "target": "#nkr_note_mod_0303052", "type": "mod", "text": "滿【大】，〔－〕【乙】"}
{"id": null, "n": "0303053", "target": "#nkr_note_mod_0303053", "type": "mod", "text": "繫【大】，繫在【甲】【乙】"}
{"id": null, "n": "0303054", "target": "#nkr_note_mod_0303054", "type": "mod", "text": "鬼【大】，鬼神【甲】【乙】"}
{"id": null, "n": "0303055", "target": "#nkr_note_mod_0303055", "type": "mod", "text": "一【大】，其【甲】【乙】"}
{"id": null, "n": "0303056", "target": "#nkr_note_mod_0303056", "type": "mod", "text": "不須【大】，須斷【甲】【乙】"}
{"id": null, "n": "0303057", "target": "#nkr_note_mod_0303057", "type": "mod", "text": "已止【大】，忘【甲】，忌【乙】"}
{"id": null, "n": "0303058", "target": "#nkr_note_mod_0303058", "type": "mod", "text": "故【大】，故不得【考偽-原】"}
{"id": null, "n": "0303059", "target": "#nkr_note_mod_0303059", "type": "mod", "text": "色【大】，不【考偽-原】，喪【甲】【乙】"}
{"id": null, "n": "0303060", "target": "#nkr_note_mod_0303060", "type": "mod", "text": "孝【大】，老【乙】"}
{"id": null, "n": "0303061", "target": "#nkr_note_mod_0303061", "type": "mod", "text": "處【大】，家【乙】"}
{"id": null, "n": "0303062", "target": "#nkr_note_mod_0303062", "type": "mod", "text": "親【大】，視【甲】，現【乙】"}
{"id": null, "n": "0303063", "target": "#nkr_note_mod_0303063", "type": "mod", "text": "經【大】，經一卷【甲】，經法一卷【乙】，乙本奧書曰六月二十九日未時移點了，交了，保延元年五月六日午剋執筆生年十八才，保延二年三月二十二日交了"}
{"id": null, "n": "0303001", "target": "#nkr_note_orig_0303001", "type": "orig", "text": "【原】享保年間刊豐山大學藏本，【甲】高山寺藏古寫本，【乙】保延元年寫東寺三密藏本"}
