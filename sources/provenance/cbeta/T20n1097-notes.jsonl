{"id": null, "n": "0422004", "target": "#nkr_note_mod_0422004", "type": "mod", "text": "像【大】，幀【宋】【元】【明】"}
{"id": null, "n": "0422005", "target": "#nkr_note_mod_0422005", "type": "mod", "text": "瑿【大】，毉【宋】【元】【明】"}
{"id": null, "n": "0422006", "target": "#nkr_note_mod_0422006", "type": "mod", "text": "珍【大】，珠【宋】【元】【明】"}
{"id": null, "n": "0422007", "target": "#nkr_note_mod_0422007", "type": "mod", "text": "星【大】，皇【甲】"}
{"id": null, "n": "0422008", "target": "#nkr_note_mod_0422008", "type": "mod", "text": "萬【大】，卍【明】"}
{"id": null, "n": "0422009", "target": "#nkr_note_mod_0422009", "type": "mod", "text": "酥【大】，蘇【宋】【甲】"}
{"id": null, "n": "0422010", "target": "#nkr_note_mod_0422010", "type": "mod", "text": "粆【大】，沙【宋】【元】【明】【甲】"}
{"id": null, "n": "0422011", "target": "#nkr_note_mod_0422011", "type": "mod", "text": "二【大】，二護身呪【宋】【元】【明】【甲】"}
{"id": null, "n": "0422012", "target": "#nkr_note_mod_0422012", "type": "mod", "text": "叉【大】，〔－〕【宋】"}
{"id": null, "n": "0423001", "target": "#nkr_note_mod_0423001", "type": "mod", "text": "呪曰【大】，〔－〕【元】【明】"}
{"id": null, "n": "0423002", "target": "#nkr_note_mod_0423002", "type": "mod", "text": "三【大】，三呪【宋】【元】【明】【甲】"}
{"id": null, "n": "0423003", "target": "#nkr_note_mod_0423003", "type": "mod", "text": "呪曰第四【大】，第四呪【宋】【元】【明】"}
{"id": null, "n": "0423004", "target": "#nkr_note_mod_0423004", "type": "mod", "text": "呪曰【大】＊，〔－〕【宋】【元】【明】【甲】＊"}
{"id": null, "n": "0423005", "target": "#nkr_note_mod_0423005", "type": "mod", "text": "五【大】，五呪【元】【明】，下至十皆同"}
{"id": null, "n": "0423006", "target": "#nkr_note_mod_0423006", "type": "mod", "text": "鬼【大】，惡【宋】【元】【明】"}
{"id": null, "n": "0423007", "target": "#nkr_note_mod_0423007", "type": "mod", "text": "曷【大】，喝【宋】【元】【明】"}
{"id": null, "n": "0423008", "target": "#nkr_note_mod_0423008", "type": "mod", "text": "乏【大】，之【元】"}
{"id": null, "n": "0423009", "target": "#nkr_note_mod_0423009", "type": "mod", "text": "次頁[05]不分卷【元】【明】"}
{"id": null, "n": "0424002", "target": "#nkr_note_mod_0424002", "type": "mod", "text": "陀羅尼自在王呪【大】＊，心呪王【宋】＊"}
{"id": null, "n": "0424003", "target": "#nkr_note_mod_0424003", "type": "mod", "text": "唐【大】，唐天后代【宋】"}
{"id": null, "n": "0424004", "target": "#nkr_note_mod_0424004", "type": "mod", "text": "奉詔【大】，〔－〕【宋】"}
{"id": null, "n": "0424005", "target": "#nkr_note_mod_0424005", "type": "mod", "text": "前頁[08]不分卷【元】【明】"}
{"id": null, "n": "0424006", "target": "#nkr_note_mod_0424006", "type": "mod", "text": "猶【大】＊，由【宋】＊"}
{"id": null, "n": "0424007", "target": "#nkr_note_mod_0424007", "type": "mod", "text": "燕【大】，烟【宋】【元】【明】"}
{"id": null, "n": "0424008", "target": "#nkr_note_mod_0424008", "type": "mod", "text": "槃【大】＊，盤【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0424009", "target": "#nkr_note_mod_0424009", "type": "mod", "text": "十一【大】，十一呪【元】【明】，下至十七皆同"}
{"id": null, "n": "0424010", "target": "#nkr_note_mod_0424010", "type": "mod", "text": "叉【大】，〔－〕【元】"}
{"id": null, "n": "0424011", "target": "#nkr_note_mod_0424011", "type": "mod", "text": "半音【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0424012", "target": "#nkr_note_mod_0424012", "type": "mod", "text": "伴【大】，泮【明】"}
{"id": null, "n": "0424013", "target": "#nkr_note_mod_0424013", "type": "mod", "text": "恐【大】，驚【宋】【元】【明】"}
{"id": null, "n": "0424014", "target": "#nkr_note_mod_0424014", "type": "mod", "text": "復【大】，後【元】【明】"}
{"id": null, "n": "0424015", "target": "#nkr_note_mod_0424015", "type": "mod", "text": "曰【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0425001", "target": "#nkr_note_mod_0425001", "type": "mod", "text": "加【大】＊，跏【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0425002", "target": "#nkr_note_mod_0425002", "type": "mod", "text": "愛【大】，受【宋】【元】【明】"}
{"id": null, "n": "0425003", "target": "#nkr_note_mod_0425003", "type": "mod", "text": "為【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0425004", "target": "#nkr_note_mod_0425004", "type": "mod", "text": "麋【大】，糜【宋】【元】【明】"}
{"id": null, "n": "0426001", "target": "#nkr_note_mod_0426001", "type": "mod", "text": "酥【大】，蘇【宋】"}
{"id": null, "n": "0426002", "target": "#nkr_note_mod_0426002", "type": "mod", "text": "卷上終【元】【明】"}
{"id": null, "n": "0426003", "target": "#nkr_note_mod_0426003", "type": "mod", "text": "卷中首【元】【明】，譯號同異如卷上"}
{"id": null, "n": "0426004", "target": "#nkr_note_mod_0426004", "type": "mod", "text": "練【大】，煉【明】"}
{"id": null, "n": "0426005", "target": "#nkr_note_mod_0426005", "type": "mod", "text": "撥【大】，發【明】"}
{"id": null, "n": "0426006", "target": "#nkr_note_mod_0426006", "type": "mod", "text": "得【大】，能【宋】【元】【明】"}
{"id": null, "n": "0426007", "target": "#nkr_note_mod_0426007", "type": "mod", "text": "鑌【大】，賓【宋】"}
{"id": null, "n": "0426008", "target": "#nkr_note_mod_0426008", "type": "mod", "text": "雜【大】，新【宋】【元】【明】"}
{"id": null, "n": "0426009", "target": "#nkr_note_mod_0426009", "type": "mod", "text": "泮吒【大】，呪曰【宋】，呪【元】【明】"}
{"id": null, "n": "0426010", "target": "#nkr_note_mod_0426010", "type": "mod", "text": "（半丹…呪）十八字【大】，唵一阿謨伽二鉢囉二合底訶跢三囉上叉羅上叉稱彼名四薩皤婆曳比也二合六盤陀七泮吒半音八莎訶【宋】【元】，唵一阿謨伽二鉢囉二合底訶跢三囉上叉羅上叉稱彼名四薩皤婆曳比也二合五盤陀六泮吒半音莎訶【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "半丹…呪"}
{"id": null, "n": "0427001", "target": "#nkr_note_mod_0427001", "type": "mod", "text": "〔丹本…段〕十字夾註－【宋】＊【元】＊【明】＊"}
