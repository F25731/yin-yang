{"id": null, "n": "0421004", "target": "#nkr_note_mod_0421004", "type": "mod", "text": "羂索【大】＊，〔－〕【甲】＊"}
{"id": null, "n": "0421005", "target": "#nkr_note_mod_0421005", "type": "mod", "text": "（陀羅…呪）七字【大】，心呪王【宋】【元】【明】"}
{"id": null, "n": "0421006", "target": "#nkr_note_mod_0421006", "type": "mod", "text": "唐天竺三藏寶思惟奉詔譯【大】＊，〔－〕【甲】＊，唐＋（天后代）【宋】【元】＊"}
{"id": null, "n": "0421007", "target": "#nkr_note_mod_0421007", "type": "mod", "text": "奉詔【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0421008", "target": "#nkr_note_mod_0421008", "type": "mod", "text": "唎【大】＊，利【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0421009", "target": "#nkr_note_mod_0421009", "type": "mod", "text": "藥【大】，夜【甲】"}
{"id": null, "n": "0421010", "target": "#nkr_note_mod_0421010", "type": "mod", "text": "茶【大】，荼【甲】"}
{"id": null, "n": "0421011", "target": "#nkr_note_mod_0421011", "type": "mod", "text": "茶【大】＊，荼【宋】【元】【明】【甲】＊"}
{"id": null, "n": "0422001", "target": "#nkr_note_mod_0422001", "type": "mod", "text": "直【大】，真【宋】【元】【明】"}
{"id": null, "n": "0422002", "target": "#nkr_note_mod_0422002", "type": "mod", "text": "萬【大】，一【宋】【元】【明】【甲】"}
