{"id": null, "n": null, "target": null, "type": null, "text": "二十五菩薩各舉所證"}
{"id": null, "n": null, "target": null, "type": null, "text": "見華嚴大論"}
{"id": null, "n": null, "target": null, "type": null, "text": "心動於內\n曰情，意緣於外曰想"}
{"id": null, "n": null, "target": null, "type": null, "text": "連上虗字集"}
{"id": null, "n": null, "target": null, "type": null, "text": "此云非天福力等天而無天行為多瞋故"}
{"id": null, "n": null, "target": null, "type": null, "text": "其目有十"}
{"id": null, "n": null, "target": null, "type": null, "text": "最初一念，空見不分，名為劫濁。"}
{"id": null, "n": null, "target": null, "type": null, "text": "見濁妄起見覺，泪擾湛性"}
{"id": null, "n": null, "target": null, "type": null, "text": "其目有十"}
{"id": null, "n": null, "target": null, "type": null, "text": "憶識誦習發知現塵"}
{"id": null, "n": null, "target": null, "type": null, "text": "其目有十"}
{"id": null, "n": null, "target": null, "type": null, "text": "生滅不停，業運常遷，曰眾生濁"}
{"id": null, "n": null, "target": null, "type": null, "text": "動元即行元"}
{"id": null, "n": null, "target": null, "type": null, "text": "其目有十"}
{"id": null, "n": null, "target": null, "type": null, "text": "吠琉璃寶能隔山見物"}
{"id": null, "n": null, "target": null, "type": null, "text": "永滅依外道之涅槃也"}
{"id": null, "n": null, "target": null, "type": null, "text": "勞謂\n苦心修煉，勤勞不休"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": "0614001", "target": "#nkr_note_orig_0614001", "type": "orig", "text": "與疑興"}
{"id": null, "n": "0615001", "target": "#nkr_note_orig_0615001", "type": "orig", "text": "日疑目"}
{"id": null, "n": "0616001", "target": "#nkr_note_orig_0616001", "type": "orig", "text": "誑疑誰"}
{"id": null, "n": "0616002", "target": "#nkr_note_orig_0616002", "type": "orig", "text": "還疑遷"}
{"id": null, "n": "0616003", "target": "#nkr_note_orig_0616003", "type": "orig", "text": "人疑入"}
{"id": null, "n": "0617001", "target": "#nkr_note_orig_0617001", "type": "orig", "text": "惟疑性"}
