{"id": null, "n": null, "target": null, "type": null, "text": "附"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "楚懈切音衩疾愈也"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒲巴切音琶搔也"}
{"id": null, "n": null, "target": null, "type": null, "text": "余󴎯切音邪作枒椰子木\n名出交州其葉背面相似"}
{"id": null, "n": null, "target": null, "type": null, "text": "徒監切音談病液"}
{"id": null, "n": null, "target": null, "type": null, "text": "奚夷切音橀酸也酢末也"}
{"id": null, "n": null, "target": null, "type": null, "text": "虎猥切音悔財也財帛總名"}
{"id": null, "n": null, "target": null, "type": null, "text": "張瓜切音撾擊也"}
{"id": null, "n": null, "target": null, "type": null, "text": "區願切勸契也"}
{"id": null, "n": null, "target": null, "type": null, "text": "乞洽切音恰爪刺也爪按\n曰掐"}
{"id": null, "n": null, "target": null, "type": null, "text": "上居拜切音戒下當葢切音帶與𧀱同蔕芥小鯁也"}
{"id": null, "n": null, "target": null, "type": null, "text": "子了切焦\n上聲絕也"}
{"id": null, "n": null, "target": null, "type": null, "text": "食證切音乘長也"}
{"id": null, "n": null, "target": null, "type": null, "text": "古滑切音鴰刮削"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃殄切音涊以手撚物也"}
{"id": null, "n": null, "target": null, "type": null, "text": "香句切音姁亦作昫日光也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上莫官切音瞞下許干切音鼾顢頇\n大面貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "居代切音溉大概大率也"}
{"id": null, "n": null, "target": null, "type": null, "text": "五巧切與齩同齧骨也"}
{"id": null, "n": null, "target": null, "type": null, "text": "茲郎切音臧藏也納賄曰贓"}
{"id": null, "n": null, "target": null, "type": null, "text": "吉恊切音\n頰蛺蝶也"}
{"id": null, "n": null, "target": null, "type": null, "text": "鄰溪切音黎黑也"}
{"id": null, "n": null, "target": null, "type": null, "text": "方馮切音風頭瘋病"}
{"id": null, "n": null, "target": null, "type": null, "text": "各核切音隔塞\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "渠玉切音𢩁曲也"}
{"id": null, "n": null, "target": null, "type": null, "text": "誾員切戀平聲係也凡物牽連繫者皆曰󵙈"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "虛嚴切音薟鍬屬"}
{"id": null, "n": null, "target": null, "type": null, "text": "五割切音嶭語相呵拒也"}
{"id": null, "n": null, "target": null, "type": null, "text": "他丹切音灘開也"}
{"id": null, "n": null, "target": null, "type": null, "text": "居隘切音解公廨也"}
{"id": null, "n": null, "target": null, "type": null, "text": "初覲切音櫬近身衣也取名於襯近尸也"}
{"id": null, "n": null, "target": null, "type": null, "text": "延知\n切音夷大呼曰咦"}
{"id": null, "n": null, "target": null, "type": null, "text": "別言神鼎\n昭覺徑山諸語"}
{"id": null, "n": null, "target": null, "type": null, "text": "吉恊切音筴面旁也"}
{"id": null, "n": null, "target": null, "type": null, "text": "簿陌切音白海中大船"}
{"id": null, "n": null, "target": null, "type": null, "text": "馬刮切音斡挑挖也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上母總切音蠓下多動切音董心亂也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上杜谷切音獨下落\n侯切音樓髑髏頂也"}
{"id": null, "n": null, "target": null, "type": null, "text": "于求切音由贅也結肉也"}
{"id": null, "n": null, "target": null, "type": null, "text": "側立切音輯止也"}
{"id": null, "n": null, "target": null, "type": null, "text": "卑吉切音必火聲也"}
{"id": null, "n": null, "target": null, "type": null, "text": "他弔切音眺出穀也"}
{"id": null, "n": null, "target": null, "type": null, "text": "楚簡切音剗鏶也與剗同"}
{"id": null, "n": null, "target": null, "type": null, "text": "必駕切音霸刀柄名"}
{"id": null, "n": null, "target": null, "type": null, "text": "魚駕切音訝齰齖齒不相\n值"}
{"id": null, "n": null, "target": null, "type": null, "text": "式亮切與餉同"}
{"id": null, "n": null, "target": null, "type": null, "text": "之饍切音戰頭不正也"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃版切音戁靣慚赤也"}
{"id": null, "n": null, "target": null, "type": null, "text": "尸羊切音商未成人䘮也"}
{"id": null, "n": null, "target": null, "type": null, "text": "將先切音箋姓也老彭姓籛名鏗在商為守藏\n吏在周為柱下史"}
{"id": null, "n": null, "target": null, "type": null, "text": "同駮論列是非謂之駮"}
{"id": null, "n": null, "target": null, "type": null, "text": "陟栗切音窒與𢯶通擣也"}
{"id": null, "n": null, "target": null, "type": null, "text": "盧瞰切音󳮪竊\n也漬也又失實曰濫"}
{"id": null, "n": null, "target": null, "type": null, "text": "具位切音匱也籠也"}
{"id": null, "n": null, "target": null, "type": null, "text": "多寒切音單殛盡也又凡盡皆\n殫"}
{"id": null, "n": null, "target": null, "type": null, "text": "同喋喋喋多言也"}
{"id": null, "n": null, "target": null, "type": null, "text": "以九切音酉教也相勸也"}
{"id": null, "n": null, "target": null, "type": null, "text": "其虐切音大笑也"}
{"id": null, "n": null, "target": null, "type": null, "text": "朱芮切音󵙋煩言也"}
{"id": null, "n": null, "target": null, "type": null, "text": "之亮切音障瘴癘也"}
{"id": null, "n": null, "target": null, "type": null, "text": "方煩切音翻籬也又域也"}
{"id": null, "n": null, "target": null, "type": null, "text": "房啖切音犯法也式也模也"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T54n2128_p0623b17"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "《嘉興藏》（日本東京大學綜合圖書館藏續編第192帙第1冊第102圖右欄第7行）"}
