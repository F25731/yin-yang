{"id": null, "n": "0028009", "target": "#nkr_note_mod_0028009", "type": "mod", "text": "反質難品一卷【大】，〔－〕【宋】【元】【宮】，一卷【明】"}
{"id": null, "n": "0028011", "target": "#nkr_note_mod_0028011", "type": "mod", "text": "天竺三藏【大】，三藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0029001", "target": "#nkr_note_mod_0029001", "type": "mod", "text": "智【大】，知【宮】"}
{"id": null, "n": "0029002", "target": "#nkr_note_mod_0029002", "type": "mod", "text": "在【大】，有【宋】【元】【明】"}
{"id": null, "n": "0029003", "target": "#nkr_note_mod_0029003", "type": "mod", "text": "共【大】，異【宋】【元】【明】"}
{"id": null, "n": "0029004", "target": "#nkr_note_mod_0029004", "type": "mod", "text": "說【大】，所說【宋】【元】【明】【宮】"}
{"id": null, "n": "0029005", "target": "#nkr_note_mod_0029005", "type": "mod", "text": "說【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0029006", "target": "#nkr_note_mod_0029006", "type": "mod", "text": "難【大】，〔－〕【宮】"}
{"id": null, "n": "0029007", "target": "#nkr_note_mod_0029007", "type": "mod", "text": "我【大】，不【宋】【元】【明】"}
{"id": null, "n": "0029008", "target": "#nkr_note_mod_0029008", "type": "mod", "text": "從【大】，後【宋】【元】【明】"}
{"id": null, "n": "0029009", "target": "#nkr_note_mod_0029009", "type": "mod", "text": "說難【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0030001", "target": "#nkr_note_mod_0030001", "type": "mod", "text": "別因【大】，別因故若汝立別因不墮負處我故汝亦捨前因立別因【明】"}
{"id": null, "n": "0030002", "target": "#nkr_note_mod_0030002", "type": "mod", "text": "（故汝…我）二十字【大】，〔－〕【明】"}
{"id": null, "n": "0030003", "target": "#nkr_note_mod_0030003", "type": "mod", "text": "無【大】，不【宋】【元】【明】【宮】"}
{"id": null, "n": "0030004", "target": "#nkr_note_mod_0030004", "type": "mod", "text": "說【大】，語【宋】【元】【明】【宮】"}
{"id": null, "n": "0030005", "target": "#nkr_note_mod_0030005", "type": "mod", "text": "（則自…汝）十七字【大】，〔－〕【明】"}
{"id": null, "n": "0030006", "target": "#nkr_note_mod_0030006", "type": "mod", "text": "不入【大】，不入義則是汝則自不許汝所說若自不許者我【明】"}
{"id": null, "n": "0030007", "target": "#nkr_note_mod_0030007", "type": "mod", "text": "反質難品【大】＊，如實論反質難品【宋】【元】【宮】＊"}
{"id": null, "n": "0030008", "target": "#nkr_note_mod_0030008", "type": "mod", "text": "兩【大】＊，二【元】【明】＊"}
{"id": null, "n": "0031001", "target": "#nkr_note_mod_0031001", "type": "mod", "text": "因【大】，四【宮】"}
{"id": null, "n": "0031002", "target": "#nkr_note_mod_0031002", "type": "mod", "text": "一【大】，一切【宋】【元】【明】【宮】"}
{"id": null, "n": "0031003", "target": "#nkr_note_mod_0031003", "type": "mod", "text": "是【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0032001", "target": "#nkr_note_mod_0032001", "type": "mod", "text": "次【大】，欲【宋】【元】【明】"}
{"id": null, "n": "0033001", "target": "#nkr_note_mod_0033001", "type": "mod", "text": "故【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0033002", "target": "#nkr_note_mod_0033002", "type": "mod", "text": "義【大】，物【宮】"}
{"id": null, "n": "0033003", "target": "#nkr_note_mod_0033003", "type": "mod", "text": "惟【大】，唯【宋】【元】【明】【宮】"}
{"id": null, "n": "0033004", "target": "#nkr_note_mod_0033004", "type": "mod", "text": "我【大】，義【明】"}
{"id": null, "n": "0033005", "target": "#nkr_note_mod_0033005", "type": "mod", "text": "異唯【大】，思惟【宋】【元】【明】【宮】"}
{"id": null, "n": "0033006", "target": "#nkr_note_mod_0033006", "type": "mod", "text": "難【大】，對【宋】【元】【明】【宮】"}
{"id": null, "n": "0033007", "target": "#nkr_note_mod_0033007", "type": "mod", "text": "譬【大】，空【宋】【元】【明】"}
{"id": null, "n": "0033008", "target": "#nkr_note_mod_0033008", "type": "mod", "text": "不【大】，非【明】"}
{"id": null, "n": "0033009", "target": "#nkr_note_mod_0033009", "type": "mod", "text": "可【大】，故【宋】【元】【明】【宮】"}
{"id": null, "n": "0033010", "target": "#nkr_note_mod_0033010", "type": "mod", "text": "若干【大】，〔－〕【明】"}
{"id": null, "n": "0033011", "target": "#nkr_note_mod_0033011", "type": "mod", "text": "十【大】，十若干【明】"}
{"id": null, "n": "0034001", "target": "#nkr_note_mod_0034001", "type": "mod", "text": "芽【大】，牙【宋】"}
{"id": null, "n": "0034002", "target": "#nkr_note_mod_0034002", "type": "mod", "text": "定【大】，是【明】"}
{"id": null, "n": "0034003", "target": "#nkr_note_mod_0034003", "type": "mod", "text": "汝若【CB】【麗-CB】【宋】【元】【明】【宮】，若汝【大】"}
{"id": null, "n": "0034004", "target": "#nkr_note_mod_0034004", "type": "mod", "text": "兒【大】，女兒【宋】【元】【明】【宮】"}
{"id": null, "n": "0034005", "target": "#nkr_note_mod_0034005", "type": "mod", "text": "兒【大】，男兒【宋】【元】【明】【宮】"}
{"id": null, "n": "0034006", "target": "#nkr_note_mod_0034006", "type": "mod", "text": "執【大】，熱【宋】【元】【明】"}
{"id": null, "n": "0034007", "target": "#nkr_note_mod_0034007", "type": "mod", "text": "不【大】，我不【宋】【元】【明】【宮】"}
