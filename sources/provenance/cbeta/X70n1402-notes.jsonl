{"id": null, "n": null, "target": null, "type": null, "text": "十首"}
{"id": null, "n": null, "target": null, "type": null, "text": "春夏秋冬"}
{"id": null, "n": null, "target": null, "type": null, "text": "客東林"}
{"id": null, "n": null, "target": null, "type": null, "text": "避大覺寺請"}
{"id": null, "n": null, "target": null, "type": null, "text": "春夏秋冬"}
