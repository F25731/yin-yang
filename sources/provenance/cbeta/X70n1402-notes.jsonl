{"id": null, "n": "0746005", "target": "#nkr_note_orig_0746005", "type": "orig", "text": "糧一作財"}
{"id": null, "n": "0746006", "target": "#nkr_note_orig_0746006", "type": "orig", "text": "噓一作吁"}
