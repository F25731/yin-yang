{"id": null, "n": "0746008", "target": "#nkr_note_orig_0746008", "type": "orig", "text": "河作汀"}
{"id": null, "n": "0747001", "target": "#nkr_note_orig_0747001", "type": "orig", "text": "舡一作船下同"}
{"id": null, "n": "0747002", "target": "#nkr_note_orig_0747002", "type": "orig", "text": "然作前"}
{"id": null, "n": "0747003", "target": "#nkr_note_orig_0747003", "type": "orig", "text": "撥作推"}
