{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": "0204001", "target": "#nkr_note_mod_0204001", "type": "mod", "text": "二下有種字"}
{"id": null, "n": "0196001", "target": "#nkr_note_orig_0196001", "type": "orig", "text": "賊疑贓"}
{"id": null, "n": "0196002", "target": "#nkr_note_orig_0196002", "type": "orig", "text": "玄義一本脫誤似多今依再治本照出其相違"}
{"id": null, "n": "0201001", "target": "#nkr_note_orig_0201001", "type": "orig", "text": "知作識"}
{"id": null, "n": "0202001", "target": "#nkr_note_orig_0202001", "type": "orig", "text": "果下有而大佛頂性又是如來所證果即名果果十六字"}
{"id": null, "n": "0203001", "target": "#nkr_note_orig_0203001", "type": "orig", "text": "覺作學"}
{"id": null, "n": "0203002", "target": "#nkr_note_orig_0203002", "type": "orig", "text": "墮作隨"}
{"id": null, "n": "0203003", "target": "#nkr_note_orig_0203003", "type": "orig", "text": "得下有一切法亦不可得七字"}
{"id": null, "n": "0204001", "target": "#nkr_note_orig_0204001", "type": "orig", "text": "二下有種宇"}
{"id": null, "n": "0204002", "target": "#nkr_note_orig_0204002", "type": "orig", "text": "湛上有妙字"}
{"id": null, "n": "0205001", "target": "#nkr_note_orig_0205001", "type": "orig", "text": "徧下有拔字"}
{"id": null, "n": "0206001", "target": "#nkr_note_orig_0206001", "type": "orig", "text": "於作放"}
{"id": null, "n": "0207001", "target": "#nkr_note_orig_0207001", "type": "orig", "text": "二作一"}
{"id": null, "n": "0207002", "target": "#nkr_note_orig_0207002", "type": "orig", "text": "檀下有行指為人對治二種悉檀理指第一義悉檀十七字"}
{"id": null, "n": "0208001", "target": "#nkr_note_orig_0208001", "type": "orig", "text": "字作宗"}
{"id": null, "n": "0208002", "target": "#nkr_note_orig_0208002", "type": "orig", "text": "駕作架"}
{"id": null, "n": "0208003", "target": "#nkr_note_orig_0208003", "type": "orig", "text": "體禮作禮體"}
{"id": null, "n": "0209001", "target": "#nkr_note_orig_0209001", "type": "orig", "text": "如作智"}
{"id": null, "n": "0209002", "target": "#nkr_note_orig_0209002", "type": "orig", "text": "惟上有而如來藏四字"}
{"id": null, "n": "0209003", "target": "#nkr_note_orig_0209003", "type": "orig", "text": "性作惟"}
{"id": null, "n": "0209004", "target": "#nkr_note_orig_0209004", "type": "orig", "text": "果下有因果二字"}
{"id": null, "n": "0209005", "target": "#nkr_note_orig_0209005", "type": "orig", "text": "云下有云"}
{"id": null, "n": "0210001", "target": "#nkr_note_orig_0210001", "type": "orig", "text": "根上有利"}
{"id": null, "n": "0211001", "target": "#nkr_note_orig_0211001", "type": "orig", "text": "滅上有生"}
{"id": null, "n": "0211002", "target": "#nkr_note_orig_0211002", "type": "orig", "text": "二作一"}
{"id": null, "n": "0211003", "target": "#nkr_note_orig_0211003", "type": "orig", "text": "就上有三"}
{"id": null, "n": "0212001", "target": "#nkr_note_orig_0212001", "type": "orig", "text": "枝疑技"}
{"id": null, "n": "0215001", "target": "#nkr_note_orig_0215001", "type": "orig", "text": "均下有用"}
{"id": null, "n": "0216001", "target": "#nkr_note_orig_0216001", "type": "orig", "text": "性上有濕"}
{"id": null, "n": "0216002", "target": "#nkr_note_orig_0216002", "type": "orig", "text": "異下有不異二字"}
{"id": null, "n": "0217001", "target": "#nkr_note_orig_0217001", "type": "orig", "text": "性作惟"}
{"id": null, "n": "0218001", "target": "#nkr_note_orig_0218001", "type": "orig", "text": "非上有便"}
{"id": null, "n": "0218002", "target": "#nkr_note_orig_0218002", "type": "orig", "text": "如上有譬"}
{"id": null, "n": "0219001", "target": "#nkr_note_orig_0219001", "type": "orig", "text": "灌上有於"}
{"id": null, "n": "0220001", "target": "#nkr_note_orig_0220001", "type": "orig", "text": "最作勗"}
