{"id": null, "n": "0698001", "target": "#nkr_note_mod_0698001", "type": "mod", "text": "清【大】，法【甲】"}
{"id": null, "n": "0698002", "target": "#nkr_note_mod_0698002", "type": "mod", "text": "湛【大】，甚【甲】"}
{"id": null, "n": "0699001", "target": "#nkr_note_mod_0699001", "type": "mod", "text": "生【大】，如【甲】"}
{"id": null, "n": "0700001", "target": "#nkr_note_mod_0700001", "type": "mod", "text": "相【CB】【甲】，想【大】"}
{"id": null, "n": "0700002", "target": "#nkr_note_mod_0700002", "type": "mod", "text": "如【CB】【甲】，知【大】"}
{"id": null, "n": "0700003", "target": "#nkr_note_mod_0700003", "type": "mod", "text": "等【大】，儀【甲】"}
{"id": null, "n": "0700004", "target": "#nkr_note_mod_0700004", "type": "mod", "text": "而【大】，面【甲】"}
{"id": null, "n": "0700005", "target": "#nkr_note_mod_0700005", "type": "mod", "text": "被【CB】【甲】，破【大】"}
{"id": null, "n": "0701001", "target": "#nkr_note_mod_0701001", "type": "mod", "text": "俱【大】，但【甲】"}
{"id": null, "n": "0701002", "target": "#nkr_note_mod_0701002", "type": "mod", "text": "墮【大】，隨【甲】"}
{"id": null, "n": "0702001", "target": "#nkr_note_mod_0702001", "type": "mod", "text": "名為大忍【大】，〔－〕【甲】"}
{"id": null, "n": "0702002", "target": "#nkr_note_mod_0702002", "type": "mod", "text": "住【大】，生【甲】"}
{"id": null, "n": "0697009", "target": "#nkr_note_orig_0697009", "type": "orig", "text": "【原】崇禎十四年刊增上寺報恩藏本，【甲】延寶五年刊宗教大學藏本"}
