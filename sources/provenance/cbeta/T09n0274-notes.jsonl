{"id": null, "n": "0374013", "target": "#nkr_note_mod_0374013", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0374014", "target": "#nkr_note_mod_0374014", "type": "mod", "text": "月氏三藏【大】，三藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0374015", "target": "#nkr_note_mod_0374015", "type": "mod", "text": "臨滅度【大】，爾時世尊臨滅度【宋】【元】【明】【宮】"}
{"id": null, "n": "0374016", "target": "#nkr_note_mod_0374016", "type": "mod", "text": "億【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0374017", "target": "#nkr_note_mod_0374017", "type": "mod", "text": "遷【大】，還【宋】【元】【明】【宮】"}
{"id": null, "n": "0374018", "target": "#nkr_note_mod_0374018", "type": "mod", "text": "二【大】，三【宋】【元】【明】【宮】"}
{"id": null, "n": "0374019", "target": "#nkr_note_mod_0374019", "type": "mod", "text": "是【大】，時【宋】【元】【明】【宮】"}
{"id": null, "n": "0375001", "target": "#nkr_note_mod_0375001", "type": "mod", "text": "質【大】，白【宋】【元】【明】【宮】"}
{"id": null, "n": "0375002", "target": "#nkr_note_mod_0375002", "type": "mod", "text": "經【大】，法【宋】【元】【明】【宮】"}
{"id": null, "n": "0375003", "target": "#nkr_note_mod_0375003", "type": "mod", "text": "比【大】，此【明】"}
{"id": null, "n": "0375004", "target": "#nkr_note_mod_0375004", "type": "mod", "text": "惟【大】，唯【元】【明】"}
{"id": null, "n": "0375005", "target": "#nkr_note_mod_0375005", "type": "mod", "text": "知【大】，智【宋】【元】【明】【宮】"}
{"id": null, "n": "0375006", "target": "#nkr_note_mod_0375006", "type": "mod", "text": "聰【大】，聰明【宋】【元】【明】【宮】"}
{"id": null, "n": "0375007", "target": "#nkr_note_mod_0375007", "type": "mod", "text": "智【大】，〔－〕【宮】"}
{"id": null, "n": "0375008", "target": "#nkr_note_mod_0375008", "type": "mod", "text": "猗【大】，倚【元】【明】"}
{"id": null, "n": "0375009", "target": "#nkr_note_mod_0375009", "type": "mod", "text": "犍【大】＊，揵【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0375010", "target": "#nkr_note_mod_0375010", "type": "mod", "text": "煮【大】，者【宋】【元】【明】【宮】"}
{"id": null, "n": "0375011", "target": "#nkr_note_mod_0375011", "type": "mod", "text": "本【大】，今【宋】【元】【明】"}
{"id": null, "n": "0375012", "target": "#nkr_note_mod_0375012", "type": "mod", "text": "㷿【大】，焰【宋】【元】【明】【宮】"}
{"id": null, "n": "0375013", "target": "#nkr_note_mod_0375013", "type": "mod", "text": "功稱【大】＊，功德【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0375014", "target": "#nkr_note_mod_0375014", "type": "mod", "text": "柔軟【大】，柔和【宋】【元】【明】【宮】"}
{"id": null, "n": "0376001", "target": "#nkr_note_mod_0376001", "type": "mod", "text": "行來【大】，往來【明】"}
{"id": null, "n": "0376002", "target": "#nkr_note_mod_0376002", "type": "mod", "text": "法【大】，為法【宋】【元】【明】"}
{"id": null, "n": "0376003", "target": "#nkr_note_mod_0376003", "type": "mod", "text": "猗【大】下同，倚【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0376004", "target": "#nkr_note_mod_0376004", "type": "mod", "text": "取眾華【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0376005", "target": "#nkr_note_mod_0376005", "type": "mod", "text": "誡【大】，戒【宋】【元】【明】【宮】"}
{"id": null, "n": "0376006", "target": "#nkr_note_mod_0376006", "type": "mod", "text": "逮【大】，環【宋】【元】【明】【宮】"}
{"id": null, "n": "0376008", "target": "#nkr_note_mod_0376008", "type": "mod", "text": "後於【大】，於後【宋】【元】【明】【宮】"}
{"id": null, "n": "0376009", "target": "#nkr_note_mod_0376009", "type": "mod", "text": "郁【大】，噢【元】【明】"}
{"id": null, "n": "0376010", "target": "#nkr_note_mod_0376010", "type": "mod", "text": "地【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0376011", "target": "#nkr_note_mod_0376011", "type": "mod", "text": "如是【大】，如是如是【宋】【元】【明】【宮】"}
{"id": null, "n": "0376012", "target": "#nkr_note_mod_0376012", "type": "mod", "text": "建【大】，逮【宋】【元】【明】【宮】"}
{"id": null, "n": "0376013", "target": "#nkr_note_mod_0376013", "type": "mod", "text": "以【大】下同，已【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0376014", "target": "#nkr_note_mod_0376014", "type": "mod", "text": "披【大】，跋【宋】【元】【明】【宮】"}
{"id": null, "n": "0376015", "target": "#nkr_note_mod_0376015", "type": "mod", "text": "由【大】，油【宋】【元】【明】【宮】"}
{"id": null, "n": "0376016", "target": "#nkr_note_mod_0376016", "type": "mod", "text": "今【大】，令【宋】【元】【明】"}
{"id": null, "n": "0376017", "target": "#nkr_note_mod_0376017", "type": "mod", "text": "瞋【CB】【麗-CB】【宮】，慎【大】"}
{"id": null, "n": "0376018", "target": "#nkr_note_mod_0376018", "type": "mod", "text": "為說法要【大】，而為說法【宋】【元】【明】【宮】"}
{"id": null, "n": "0376019", "target": "#nkr_note_mod_0376019", "type": "mod", "text": "憃【大】，戅【宋】【元】【明】【宮】"}
{"id": null, "n": "0376020", "target": "#nkr_note_mod_0376020", "type": "mod", "text": "堅【大】，釁【宋】，竪【元】【明】【宮】"}
{"id": null, "n": "0376021", "target": "#nkr_note_mod_0376021", "type": "mod", "text": "侏𫣖【大】，侏張【宋】【宮】，譸張【元】【明】"}
{"id": null, "n": "0376022", "target": "#nkr_note_mod_0376022", "type": "mod", "text": "支體【大】，肢體【宋】【元】【明】【宮】"}
{"id": null, "n": "0376023", "target": "#nkr_note_mod_0376023", "type": "mod", "text": "恚【大】，恨【宋】【元】【明】【宮】"}
{"id": null, "n": "0376024", "target": "#nkr_note_mod_0376024", "type": "mod", "text": "故【大】，欲【宋】【元】【明】【宮】"}
{"id": null, "n": "0376025", "target": "#nkr_note_mod_0376025", "type": "mod", "text": "反【大】下同，返【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0377001", "target": "#nkr_note_mod_0377001", "type": "mod", "text": "故【大】，〔－〕【宮】"}
{"id": null, "n": "0377002", "target": "#nkr_note_mod_0377002", "type": "mod", "text": "乏短【大】，短乏【宋】【元】【明】【宮】"}
{"id": null, "n": "0377003", "target": "#nkr_note_mod_0377003", "type": "mod", "text": "口【大】，中【元】"}
{"id": null, "n": "0377004", "target": "#nkr_note_mod_0377004", "type": "mod", "text": "敬【大】，恪【宋】【元】【明】【宮】"}
{"id": null, "n": "0377005", "target": "#nkr_note_mod_0377005", "type": "mod", "text": "原【大】，源【元】【明】"}
{"id": null, "n": "0377006", "target": "#nkr_note_mod_0377006", "type": "mod", "text": "望【大】，妄【宋】【元】【明】【宮】"}
{"id": null, "n": "0377007", "target": "#nkr_note_mod_0377007", "type": "mod", "text": "福【大】，攝【宮】"}
{"id": null, "n": "0377008", "target": "#nkr_note_mod_0377008", "type": "mod", "text": "然【大】，〔－〕【宮】"}
{"id": null, "n": "0377009", "target": "#nkr_note_mod_0377009", "type": "mod", "text": "印【大】，取【宮】"}
{"id": null, "n": "0377010", "target": "#nkr_note_mod_0377010", "type": "mod", "text": "已【大】＊，以【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0377011", "target": "#nkr_note_mod_0377011", "type": "mod", "text": "嶮路【大】，險谷【宋】【元】【明】【宮】"}
{"id": null, "n": "0377012", "target": "#nkr_note_mod_0377012", "type": "mod", "text": "趣【大】，超【宋】【元】【明】【宮】"}
{"id": null, "n": "0377013", "target": "#nkr_note_mod_0377013", "type": "mod", "text": "怨【大】，恐【宋】【元】【明】【宮】"}
{"id": null, "n": "0377014", "target": "#nkr_note_mod_0377014", "type": "mod", "text": "手【大】，首【宋】【元】【明】【宮】"}
{"id": null, "n": "0377015", "target": "#nkr_note_mod_0377015", "type": "mod", "text": "陰【大】，蔭【宋】【宮】"}
{"id": null, "n": "0377016", "target": "#nkr_note_mod_0377016", "type": "mod", "text": "英幢【大】，憧英【宋】【元】【明】【宮】"}
{"id": null, "n": "0378001", "target": "#nkr_note_mod_0378001", "type": "mod", "text": "說【大】，法【宋】【元】【明】【宮】"}
{"id": null, "n": "0378002", "target": "#nkr_note_mod_0378002", "type": "mod", "text": "正士【大】，開士【宋】【元】【明】【宮】"}
{"id": null, "n": "0378003", "target": "#nkr_note_mod_0378003", "type": "mod", "text": "謗【大】，論【宋】【元】【明】【宮】"}
{"id": null, "n": "0378004", "target": "#nkr_note_mod_0378004", "type": "mod", "text": "嘉【大】＊，往【宋】【宮】，佳【元】【明】＊"}
{"id": null, "n": "0378005", "target": "#nkr_note_mod_0378005", "type": "mod", "text": "性【大】＊，姓【宋】【元】＊"}
{"id": null, "n": "0378006", "target": "#nkr_note_mod_0378006", "type": "mod", "text": "所逮總持【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0378007", "target": "#nkr_note_mod_0378007", "type": "mod", "text": "則【大】，為【明】"}
{"id": null, "n": "0378008", "target": "#nkr_note_mod_0378008", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0378009", "target": "#nkr_note_mod_0378009", "type": "mod", "text": "義【大】，經【宋】【元】【明】【宮】"}
{"id": null, "n": "0378010", "target": "#nkr_note_mod_0378010", "type": "mod", "text": "某【大】，其【明】【宮】"}
{"id": null, "n": "0378011", "target": "#nkr_note_mod_0378011", "type": "mod", "text": "是不應行【大】，〔－〕【宮】"}
{"id": null, "n": "0378012", "target": "#nkr_note_mod_0378012", "type": "mod", "text": "裹【大】，畏【宋】【元】【明】【宮】"}
{"id": null, "n": "0378013", "target": "#nkr_note_mod_0378013", "type": "mod", "text": "唯【大】，惟【宋】【宮】"}
{"id": null, "n": "0378014", "target": "#nkr_note_mod_0378014", "type": "mod", "text": "厚【大】，友【宋】【元】【明】【宮】"}
{"id": null, "n": "0378015", "target": "#nkr_note_mod_0378015", "type": "mod", "text": "沒【大】，及【宋】【元】【明】【宮】"}
{"id": null, "n": "0378016", "target": "#nkr_note_mod_0378016", "type": "mod", "text": "想【大】，相【宋】【元】【明】【宮】"}
{"id": null, "n": "0378017", "target": "#nkr_note_mod_0378017", "type": "mod", "text": "樂【大】，愚【宋】【元】【明】【宮】"}
{"id": null, "n": "0378018", "target": "#nkr_note_mod_0378018", "type": "mod", "text": "逮【大】，達【宮】"}
{"id": null, "n": "0378019", "target": "#nkr_note_mod_0378019", "type": "mod", "text": "河【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0379001", "target": "#nkr_note_mod_0379001", "type": "mod", "text": "濟諸方等學經【大】，佛說濟諸方等學經【元】【明】"}
{"id": null, "n": "0374013", "target": "#nkr_note_orig_0374013", "type": "orig", "text": "〔一卷〕－【三】【宮】"}
{"id": null, "n": "0374014", "target": "#nkr_note_orig_0374014", "type": "orig", "text": "月氏三藏＝三藏法師【三】【宮】"}
