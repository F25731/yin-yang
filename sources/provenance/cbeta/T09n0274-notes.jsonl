{"id": null, "n": "0375003", "target": "#nkr_note_orig_0375003", "type": "orig", "text": "比＝此【明】"}
{"id": null, "n": "0375004", "target": "#nkr_note_orig_0375004", "type": "orig", "text": "惟＝唯【元】【明】"}
{"id": null, "n": "0375005", "target": "#nkr_note_orig_0375005", "type": "orig", "text": "知＝智【三】【宮】"}
{"id": null, "n": "0375006", "target": "#nkr_note_orig_0375006", "type": "orig", "text": "聰＋（明）【三】【宮】"}
{"id": null, "n": "0375007", "target": "#nkr_note_orig_0375007", "type": "orig", "text": "〔智〕－【宮】"}
{"id": null, "n": "0375008", "target": "#nkr_note_orig_0375008", "type": "orig", "text": "猗＝倚【元】【明】"}
{"id": null, "n": "0375009", "target": "#nkr_note_orig_0375009", "type": "orig", "text": "犍＝揵【三】【宮】＊"}
{"id": null, "n": "0375010", "target": "#nkr_note_orig_0375010", "type": "orig", "text": "煮＝者【三】【宮】"}
{"id": null, "n": "0375011", "target": "#nkr_note_orig_0375011", "type": "orig", "text": "本＝今【三】"}
{"id": null, "n": "0375012", "target": "#nkr_note_orig_0375012", "type": "orig", "text": "㷿＝焰【三】【宮】"}
{"id": null, "n": "0375013", "target": "#nkr_note_orig_0375013", "type": "orig", "text": "功稱＝功德【三】【宮】＊"}
{"id": null, "n": "0375014", "target": "#nkr_note_orig_0375014", "type": "orig", "text": "柔軟＝柔和【三】【宮】"}
{"id": null, "n": "0376001", "target": "#nkr_note_orig_0376001", "type": "orig", "text": "行來＝往來【明】"}
{"id": null, "n": "0376002", "target": "#nkr_note_orig_0376002", "type": "orig", "text": "（為）＋法【三】"}
{"id": null, "n": "0376003", "target": "#nkr_note_orig_0376003", "type": "orig", "text": "猗＝倚【三】【宮】下同"}
{"id": null, "n": "0376004", "target": "#nkr_note_orig_0376004", "type": "orig", "text": "〔取眾華〕－【三】【宮】"}
{"id": null, "n": "0376005", "target": "#nkr_note_orig_0376005", "type": "orig", "text": "誡＝戒【三】【宮】"}
{"id": null, "n": "0376006", "target": "#nkr_note_orig_0376006", "type": "orig", "text": "逮＝環【三】【宮】"}
{"id": null, "n": "0376007", "target": "#nkr_note_orig_0376007", "type": "orig", "text": "行南藏作世"}
{"id": null, "n": "0376008", "target": "#nkr_note_orig_0376008", "type": "orig", "text": "後於＝於後【三】【宮】"}
{"id": null, "n": "0376009", "target": "#nkr_note_orig_0376009", "type": "orig", "text": "郁＝噢【元】【明】"}
{"id": null, "n": "0376010", "target": "#nkr_note_orig_0376010", "type": "orig", "text": "〔地〕－【三】【宮】"}
{"id": null, "n": "0376011", "target": "#nkr_note_orig_0376011", "type": "orig", "text": "如是＋（如是）【三】【宮】"}
{"id": null, "n": "0376012", "target": "#nkr_note_orig_0376012", "type": "orig", "text": "建＝逮【三】【宮】"}
{"id": null, "n": "0376013", "target": "#nkr_note_orig_0376013", "type": "orig", "text": "以＝已【三】【宮】下同"}
{"id": null, "n": "0376014", "target": "#nkr_note_orig_0376014", "type": "orig", "text": "披＝跋【三】【宮】"}
