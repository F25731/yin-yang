{"id": null, "n": "0869002", "target": "#nkr_note_mod_0869002", "type": "mod", "text": "學【大】，嶽【考偽-原】，嶽【甲】"}
{"id": null, "n": "0869003", "target": "#nkr_note_mod_0869003", "type": "mod", "text": "於【大】，〔－〕【校異-原】【甲】"}
{"id": null, "n": "0869004", "target": "#nkr_note_mod_0869004", "type": "mod", "text": "理【大】，〔－〕【考偽-原】【考偽-甲】"}
{"id": null, "n": "0869005", "target": "#nkr_note_mod_0869005", "type": "mod", "text": "之【大】，之於【校異-原】，於之【甲】"}
{"id": null, "n": "0869006", "target": "#nkr_note_mod_0869006", "type": "mod", "text": "五【大】，六【考偽-原】，六【甲】"}
{"id": null, "n": "0870001", "target": "#nkr_note_mod_0870001", "type": "mod", "text": "長【大】，須【考偽-原】，須【甲】"}
{"id": null, "n": "0870002", "target": "#nkr_note_mod_0870002", "type": "mod", "text": "根【大】，踉【考偽-原】，踉【甲】"}
{"id": null, "n": "0870004", "target": "#nkr_note_mod_0870004", "type": "mod", "text": "如【大】，加【考偽-原】，加【甲】"}
{"id": null, "n": "0870005", "target": "#nkr_note_mod_0870005", "type": "mod", "text": "復【大】，須【考偽-原】，須【甲】"}
{"id": null, "n": "0871001", "target": "#nkr_note_mod_0871001", "type": "mod", "text": "得【大】，〔－〕【考偽-原】【考偽-甲】"}
{"id": null, "n": "0871002", "target": "#nkr_note_mod_0871002", "type": "mod", "text": "行住坐【大】，〔－〕【考偽-原】【考偽-甲】"}
{"id": null, "n": "0871003", "target": "#nkr_note_mod_0871003", "type": "mod", "text": "鉀【大】，形【考偽-原】"}
{"id": null, "n": "0871004", "target": "#nkr_note_mod_0871004", "type": "mod", "text": "瘡【大】，癢【校異-原】【甲】"}
{"id": null, "n": "0871005", "target": "#nkr_note_mod_0871005", "type": "mod", "text": "令須【大】，須令【考偽-原】，須令【甲】"}
{"id": null, "n": "0872001", "target": "#nkr_note_mod_0872001", "type": "mod", "text": "座【大】，座未得食下座【校異-原】，座未得食下座【甲】"}
{"id": null, "n": "0872002", "target": "#nkr_note_mod_0872002", "type": "mod", "text": "放【大】，於【校異-原】，於【甲】"}
{"id": null, "n": "0873003", "target": "#nkr_note_mod_0873003", "type": "mod", "text": "缾【大】，鉢【考偽-原】，鉢【甲】"}
{"id": null, "n": "0873004", "target": "#nkr_note_mod_0873004", "type": "mod", "text": "共【大】，與【考偽-原】，與【甲】"}
{"id": null, "n": "0869001", "target": "#nkr_note_orig_0869001", "type": "orig", "text": "【原】安政五年刊宗教大學藏本，【甲】大日本續藏經"}
{"id": null, "n": "0869002", "target": "#nkr_note_orig_0869002", "type": "orig", "text": "學＝嶽ヵ【原】，嶽【甲】"}
{"id": null, "n": "0869003", "target": "#nkr_note_orig_0869003", "type": "orig", "text": "〔於〕ィ－【原】【甲】"}
{"id": null, "n": "0869004", "target": "#nkr_note_orig_0869004", "type": "orig", "text": "〔理〕－ヵ【原】【甲】"}
{"id": null, "n": "0869005", "target": "#nkr_note_orig_0869005", "type": "orig", "text": "之＋（於）ィ【原】，（於）＋之【甲】"}
{"id": null, "n": "0869006", "target": "#nkr_note_orig_0869006", "type": "orig", "text": "五＝六ヵ【原】，六【甲】"}
{"id": null, "n": "0870001", "target": "#nkr_note_orig_0870001", "type": "orig", "text": "長＝須ヵ【原】，須【甲】"}
{"id": null, "n": "0870002", "target": "#nkr_note_orig_0870002", "type": "orig", "text": "根＝踉ヵ【原】，踉【甲】"}
{"id": null, "n": "0870003", "target": "#nkr_note_orig_0870003", "type": "orig", "text": "原本并甲本冠註曰情下護律儀有不惱他也四字"}
{"id": null, "n": "0870004", "target": "#nkr_note_orig_0870004", "type": "orig", "text": "如＝加ヵ【原】，加【甲】"}
{"id": null, "n": "0870005", "target": "#nkr_note_orig_0870005", "type": "orig", "text": "復＝須ヵ【原】，須【甲】"}
{"id": null, "n": "0871001", "target": "#nkr_note_orig_0871001", "type": "orig", "text": "〔得〕－ヵ【原】【甲】"}
{"id": null, "n": "0871002", "target": "#nkr_note_orig_0871002", "type": "orig", "text": "〔行住坐〕－ヵ【原】【甲】"}
{"id": null, "n": "0871003", "target": "#nkr_note_orig_0871003", "type": "orig", "text": "鉀＝形ヵ【原】"}
{"id": null, "n": "0871004", "target": "#nkr_note_orig_0871004", "type": "orig", "text": "瘡＝癢ィ【原】【甲】"}
{"id": null, "n": "0871005", "target": "#nkr_note_orig_0871005", "type": "orig", "text": "令須＝須令ヵ【原】，須令【甲】"}
{"id": null, "n": "0872001", "target": "#nkr_note_orig_0872001", "type": "orig", "text": "座＋（未得食下座）ィ【原】，（未得食下座）【甲】"}
{"id": null, "n": "0872002", "target": "#nkr_note_orig_0872002", "type": "orig", "text": "放＝於ィ【原】，於【甲】"}
{"id": null, "n": "0873001", "target": "#nkr_note_orig_0873001", "type": "orig", "text": "原本冠註曰若廁下準護律儀寫脫外字"}
{"id": null, "n": "0873002", "target": "#nkr_note_orig_0873002", "type": "orig", "text": "原本并甲本冠註曰著字準護律儀恐寫剩"}
{"id": null, "n": "0873003", "target": "#nkr_note_orig_0873003", "type": "orig", "text": "缾＝鉢ヵ【原】，鉢【甲】"}
{"id": null, "n": "0873004", "target": "#nkr_note_orig_0873004", "type": "orig", "text": "共＝與ヵ【原】，與【甲】"}
{"id": null, "n": "0874001", "target": "#nkr_note_orig_0874001", "type": "orig", "text": "原本及甲本冠註曰得下準護律儀合有獨字"}
{"id": null, "n": "0871a0601", "target": "#nkr_note_add_0871a0601", "type": "add", "text": "己【CB】，已【大】"}
