{"id": null, "n": null, "target": null, "type": null, "text": "一、明經論遊意；二、明四論大歸；三、明中觀宗者；四、明無方問難也"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": "0116002", "target": "#nkr_note_mod_0116002", "type": "mod", "text": "有【大】，明【考偽-原】"}
{"id": null, "n": "0116003", "target": "#nkr_note_mod_0116003", "type": "mod", "text": "不【大】，亦【考偽-原】"}
{"id": null, "n": "0116004", "target": "#nkr_note_mod_0116004", "type": "mod", "text": "忘【大】，妄【考偽-原】"}
{"id": null, "n": "0116005", "target": "#nkr_note_mod_0116005", "type": "mod", "text": "八【大】，四【考偽-原】"}
{"id": null, "n": "0116006", "target": "#nkr_note_mod_0116006", "type": "mod", "text": "論【大】，淪【考偽-原】"}
{"id": null, "n": "0116007", "target": "#nkr_note_mod_0116007", "type": "mod", "text": "意【大】，意一【考偽-大】"}
{"id": null, "n": "0117001", "target": "#nkr_note_mod_0117001", "type": "mod", "text": "有【大】，〔－〕【考偽-原】"}
{"id": null, "n": "0117002", "target": "#nkr_note_mod_0117002", "type": "mod", "text": "必【大】，心【考偽-原】，意【考偽-原】"}
{"id": null, "n": "0117003", "target": "#nkr_note_mod_0117003", "type": "mod", "text": "者【大】，明【考偽-原】"}
{"id": null, "n": "0117004", "target": "#nkr_note_mod_0117004", "type": "mod", "text": "秤【大】，〔－〕【考偽-原】"}
{"id": null, "n": "0117005", "target": "#nkr_note_mod_0117005", "type": "mod", "text": "四【大】，〔－〕【考偽-原】"}
{"id": null, "n": "0118001", "target": "#nkr_note_mod_0118001", "type": "mod", "text": "故【大】，彼【考偽-原】，〔－〕【考偽-原】"}
{"id": null, "n": "0118002", "target": "#nkr_note_mod_0118002", "type": "mod", "text": "宗【大】，〔－〕【考偽-原】"}
{"id": null, "n": "0118003", "target": "#nkr_note_mod_0118003", "type": "mod", "text": "里【大】，理【考偽-原】"}
{"id": null, "n": "0118004", "target": "#nkr_note_mod_0118004", "type": "mod", "text": "兩【大】，兩論【考偽-原】"}
{"id": null, "n": "0118005", "target": "#nkr_note_mod_0118005", "type": "mod", "text": "故【大】，〔－〕【考偽-大】"}
{"id": null, "n": "0119002", "target": "#nkr_note_mod_0119002", "type": "mod", "text": "中【大】，百【考偽-大】"}
{"id": null, "n": "0120001", "target": "#nkr_note_mod_0120001", "type": "mod", "text": "申【大】，中【考偽-原】"}
{"id": null, "n": "0120002", "target": "#nkr_note_mod_0120002", "type": "mod", "text": "言【大】，〔－〕【考偽-原】"}
{"id": null, "n": "0120003", "target": "#nkr_note_mod_0120003", "type": "mod", "text": "由【大】，〔－〕【考偽-原】"}
{"id": null, "n": "0120004", "target": "#nkr_note_mod_0120004", "type": "mod", "text": "□【大】，若【考偽-原】"}
{"id": null, "n": "0120005", "target": "#nkr_note_mod_0120005", "type": "mod", "text": "為【大】，〔－〕【考偽-原】"}
{"id": null, "n": "0120006", "target": "#nkr_note_mod_0120006", "type": "mod", "text": "□【大】，為【考偽-原】"}
{"id": null, "n": "0120007", "target": "#nkr_note_mod_0120007", "type": "mod", "text": "□【大】，〔－〕【考偽-大】"}
{"id": null, "n": "0121001", "target": "#nkr_note_mod_0121001", "type": "mod", "text": "有【大】，〔－〕【考偽-原】"}
{"id": null, "n": "0121002", "target": "#nkr_note_mod_0121002", "type": "mod", "text": "者【大】，言【考偽-原】"}
{"id": null, "n": "0121003", "target": "#nkr_note_mod_0121003", "type": "mod", "text": "理【大】，匡【考偽-原】"}
{"id": null, "n": "0116001", "target": "#nkr_note_orig_0116001", "type": "orig", "text": "【原】大日本續藏經"}
{"id": null, "n": "0116002", "target": "#nkr_note_orig_0116002", "type": "orig", "text": "有＝明ヵ【原】"}
{"id": null, "n": "0116003", "target": "#nkr_note_orig_0116003", "type": "orig", "text": "不＝亦ヵ【原】"}
{"id": null, "n": "0116004", "target": "#nkr_note_orig_0116004", "type": "orig", "text": "忘＝妄ヵ【原】"}
{"id": null, "n": "0116005", "target": "#nkr_note_orig_0116005", "type": "orig", "text": "八＝四ヵ【原】"}
{"id": null, "n": "0116006", "target": "#nkr_note_orig_0116006", "type": "orig", "text": "論＝淪ヵ【原】"}
{"id": null, "n": "0116007", "target": "#nkr_note_orig_0116007", "type": "orig", "text": "意＋（一）？"}
{"id": null, "n": "0117001", "target": "#nkr_note_orig_0117001", "type": "orig", "text": "〔有〕－ヵ【原】"}
{"id": null, "n": "0117002", "target": "#nkr_note_orig_0117002", "type": "orig", "text": "必＝心ヵ【原】，意ヵ【原】"}
{"id": null, "n": "0117003", "target": "#nkr_note_orig_0117003", "type": "orig", "text": "者＝明ヵ【原】"}
{"id": null, "n": "0117004", "target": "#nkr_note_orig_0117004", "type": "orig", "text": "〔秤〕－ヵ【原】"}
{"id": null, "n": "0117005", "target": "#nkr_note_orig_0117005", "type": "orig", "text": "〔四〕－ヵ【原】"}
{"id": null, "n": "0118001", "target": "#nkr_note_orig_0118001", "type": "orig", "text": "故＝彼ヵ【原】，〔故〕－ヵ【原】"}
{"id": null, "n": "0118002", "target": "#nkr_note_orig_0118002", "type": "orig", "text": "〔宗〕－ヵ【原】"}
{"id": null, "n": "0118003", "target": "#nkr_note_orig_0118003", "type": "orig", "text": "里＝理ヵ【原】"}
{"id": null, "n": "0118004", "target": "#nkr_note_orig_0118004", "type": "orig", "text": "兩＋（論）ヵ【原】"}
{"id": null, "n": "0118005", "target": "#nkr_note_orig_0118005", "type": "orig", "text": "〔故〕－？"}
{"id": null, "n": "0119001", "target": "#nkr_note_orig_0119001", "type": "orig", "text": "冠註曰人下疑有脫文"}
{"id": null, "n": "0119002", "target": "#nkr_note_orig_0119002", "type": "orig", "text": "中＝百？"}
{"id": null, "n": "0119003", "target": "#nkr_note_orig_0119003", "type": "orig", "text": "冠註曰候字恐寫誤"}
{"id": null, "n": "0120001", "target": "#nkr_note_orig_0120001", "type": "orig", "text": "申＝中ヵ【原】"}
{"id": null, "n": "0120002", "target": "#nkr_note_orig_0120002", "type": "orig", "text": "〔言〕－ヵ【原】"}
{"id": null, "n": "0120003", "target": "#nkr_note_orig_0120003", "type": "orig", "text": "〔由〕－ヵ【原】"}
{"id": null, "n": "0120004", "target": "#nkr_note_orig_0120004", "type": "orig", "text": "□＝若ヵ【原】"}
{"id": null, "n": "0120005", "target": "#nkr_note_orig_0120005", "type": "orig", "text": "〔為〕－ヵ【原】"}
{"id": null, "n": "0120006", "target": "#nkr_note_orig_0120006", "type": "orig", "text": "□＝為ヵ【原】"}
{"id": null, "n": "0120007", "target": "#nkr_note_orig_0120007", "type": "orig", "text": "〔□〕－？"}
{"id": null, "n": "0121001", "target": "#nkr_note_orig_0121001", "type": "orig", "text": "〔有〕－ヵ【原】"}
{"id": null, "n": "0121002", "target": "#nkr_note_orig_0121002", "type": "orig", "text": "者＝言ヵ【原】"}
{"id": null, "n": "0121003", "target": "#nkr_note_orig_0121003", "type": "orig", "text": "理＝匡ヵ【原】"}
{"id": null, "n": "0121004", "target": "#nkr_note_orig_0121004", "type": "orig", "text": "冠註曰年字原本不明"}
{"id": null, "n": "0122001", "target": "#nkr_note_orig_0122001", "type": "orig", "text": "冠註曰巨字原本不明"}
