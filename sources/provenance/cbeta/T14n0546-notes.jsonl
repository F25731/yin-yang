{"id": null, "n": "0850009", "target": "#nkr_note_mod_0850009", "type": "mod", "text": "（西天…詔譯）三十字【大】，西天譯經三藏朝散大夫試鴻臚卿明教大師臣天息災奉詔譯【宋】【元】【宮】，宋西天三藏朝散大夫試鴻臚卿明教大師天息災奉詔譯【明】"}
{"id": null, "n": "0850010", "target": "#nkr_note_mod_0850010", "type": "mod", "text": "此【大】，比【宋】【元】"}
{"id": null, "n": "0851001", "target": "#nkr_note_mod_0851001", "type": "mod", "text": "時【大】，明【宮】"}
{"id": null, "n": "0851002", "target": "#nkr_note_mod_0851002", "type": "mod", "text": "疱【大】＊，炮【明】＊"}
{"id": null, "n": "0851003", "target": "#nkr_note_mod_0851003", "type": "mod", "text": "遣【大】，造【宋】【元】"}
{"id": null, "n": "0851004", "target": "#nkr_note_mod_0851004", "type": "mod", "text": "受【大】＊，授【元】【明】＊"}
{"id": null, "n": "0851005", "target": "#nkr_note_mod_0851005", "type": "mod", "text": "輪【大】，轉【宮】"}
{"id": null, "n": "0851006", "target": "#nkr_note_mod_0851006", "type": "mod", "text": "入欲【大】，欲入【宮】"}
{"id": null, "n": "0852001", "target": "#nkr_note_mod_0852001", "type": "mod", "text": "志【大】＊，至【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0852002", "target": "#nkr_note_mod_0852002", "type": "mod", "text": "于【大】，子【明】"}
{"id": null, "n": "0852003", "target": "#nkr_note_mod_0852003", "type": "mod", "text": "告【大】，佛告【宋】【元】【明】【宮】"}
{"id": null, "n": "0850009", "target": "#nkr_note_orig_0850009", "type": "orig", "text": "（西天…詔譯）三十字＝西天譯經三藏朝散大夫試鴻臚卿明教大師臣天息災奉詔譯【宋】【元】【宮】，宋西天三藏朝散大夫試鴻臚卿明教大師天息災奉詔譯【明】"}
{"id": null, "n": "0850010", "target": "#nkr_note_orig_0850010", "type": "orig", "text": "此＝比【宋】【元】"}
{"id": null, "n": "0851001", "target": "#nkr_note_orig_0851001", "type": "orig", "text": "時＝明【宮】"}
{"id": null, "n": "0851002", "target": "#nkr_note_orig_0851002", "type": "orig", "text": "疱＝炮【明】＊"}
{"id": null, "n": "0851003", "target": "#nkr_note_orig_0851003", "type": "orig", "text": "遣＝造【宋】【元】"}
{"id": null, "n": "0851004", "target": "#nkr_note_orig_0851004", "type": "orig", "text": "受＝授【元】【明】＊"}
{"id": null, "n": "0851005", "target": "#nkr_note_orig_0851005", "type": "orig", "text": "輪＝轉【宮】"}
{"id": null, "n": "0851006", "target": "#nkr_note_orig_0851006", "type": "orig", "text": "入欲＝欲入【宮】"}
{"id": null, "n": "0852001", "target": "#nkr_note_orig_0852001", "type": "orig", "text": "志＝至【三】＊"}
{"id": null, "n": "0852002", "target": "#nkr_note_orig_0852002", "type": "orig", "text": "于＝子【明】"}
{"id": null, "n": "0852003", "target": "#nkr_note_orig_0852003", "type": "orig", "text": "（佛）＋告【三】【宮】"}
