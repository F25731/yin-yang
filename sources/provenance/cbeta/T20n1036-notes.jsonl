{"id": null, "n": "0018009", "target": null, "type": "orig", "text": "法大師臣＝教大師【明】"}
{"id": null, "n": "0018009", "target": null, "type": "mod", "text": "法大師臣【大】，教大師【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "十七"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": null, "target": null, "type": null, "text": "引九"}
{"id": null, "n": "0018008", "target": "#nkr_note_mod_0018008", "type": "mod", "text": "西天譯經三藏朝散大夫試鴻臚少卿傳法大師臣【大】，三藏法師【宋】【元】，宋西天譯經三藏朝散大夫試鴻臚少卿傳法大師臣【明】"}
{"id": null, "n": "0018009", "target": "#nkr_note_mod_0018009", "type": "mod", "text": "法大師臣【大】，教大師【明】"}
{"id": null, "n": "0018010", "target": "#nkr_note_mod_0018010", "type": "mod", "text": "十七【大】，〔－〕【元】"}
{"id": null, "n": "0018011", "target": "#nkr_note_mod_0018011", "type": "mod", "text": "鬪【大】，闡【宋】"}
{"id": null, "n": "0019001", "target": "#nkr_note_mod_0019001", "type": "mod", "text": "嚕【大】，嚕引【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0019002", "target": "#nkr_note_mod_0019002", "type": "mod", "text": "囉【大】，羅【宋】【元】【明】"}
{"id": null, "n": "0019003", "target": "#nkr_note_mod_0019003", "type": "mod", "text": "怛【大】，哩【明】"}
{"id": null, "n": "0019004", "target": "#nkr_note_mod_0019004", "type": "mod", "text": "引【大】，引九【宋】【元】【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "九"}
{"id": null, "n": "0019005", "target": "#nkr_note_mod_0019005", "type": "mod", "text": "把讀【大】，一把【宋】【元】【明】"}
{"id": null, "n": "0018007", "target": "#nkr_note_orig_0018007", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0018008", "target": "#nkr_note_orig_0018008", "type": "orig", "text": "（宋）＋西【明】，（西天…臣）二十字＝（三藏法師）四字【宋】【元】"}
{"id": null, "n": "0018009", "target": "#nkr_note_orig_0018009", "type": "orig", "text": "法大師臣＝教大師【明】"}
{"id": null, "n": "0018010", "target": "#nkr_note_orig_0018010", "type": "orig", "text": "〔十七〕－【元】"}
{"id": null, "n": "0018011", "target": "#nkr_note_orig_0018011", "type": "orig", "text": "鬪＝闡【宋】"}
{"id": null, "n": "0019001", "target": "#nkr_note_orig_0019001", "type": "orig", "text": "嚕＋（引）細註【明】"}
{"id": null, "n": "0019002", "target": "#nkr_note_orig_0019002", "type": "orig", "text": "囉＝羅【三】"}
{"id": null, "n": "0019003", "target": "#nkr_note_orig_0019003", "type": "orig", "text": "怛＝哩【明】"}
{"id": null, "n": "0019004", "target": "#nkr_note_orig_0019004", "type": "orig", "text": "引＋（九）細註【三】"}
{"id": null, "n": "0019005", "target": "#nkr_note_orig_0019005", "type": "orig", "text": "把讀＝一把【三】"}
{"id": null, "n": "0019006", "target": "#nkr_note_orig_0019006", "type": "orig", "text": "明本無末題"}
