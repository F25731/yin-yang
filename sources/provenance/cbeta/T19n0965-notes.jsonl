{"id": null, "n": "0339021", "target": "#nkr_note_mod_0339021", "type": "mod", "text": "二【大】，三【考偽-原】"}
{"id": null, "n": "0339022", "target": "#nkr_note_mod_0339022", "type": "mod", "text": "帝【大】，帝四【考偽-原】"}
{"id": null, "n": null, "target": null, "type": null, "text": "四"}
{"id": null, "n": "0339023", "target": "#nkr_note_mod_0339023", "type": "mod", "text": "此偈【大】，誐他【考偽-原】"}
{"id": null, "n": "0339024", "target": "#nkr_note_mod_0339024", "type": "mod", "text": "遠【大】，遠振【校異-原】"}
{"id": null, "n": "0339025", "target": "#nkr_note_mod_0339025", "type": "mod", "text": "剎【大】，〔－〕【校異-原】"}
{"id": null, "n": "0339026", "target": "#nkr_note_mod_0339026", "type": "mod", "text": "黃蓮【大】，黃色蓮花【校異-原】"}
{"id": null, "n": "0339027", "target": "#nkr_note_mod_0339027", "type": "mod", "text": "於【大】，於如來【校異-原】"}
{"id": null, "n": "0339028", "target": "#nkr_note_mod_0339028", "type": "mod", "text": "中【大】，〔－〕【校異-原】"}
{"id": null, "n": "0340001", "target": "#nkr_note_mod_0340001", "type": "mod", "text": "色【大】，色色【校異-原】"}
{"id": null, "n": "0340002", "target": "#nkr_note_mod_0340002", "type": "mod", "text": "於後隅【大】，於如來後左隅【校異-原】"}
{"id": null, "n": "0340003", "target": "#nkr_note_mod_0340003", "type": "mod", "text": "勝【大】，勝佛【校異-原】"}
{"id": null, "n": "0340004", "target": "#nkr_note_mod_0340004", "type": "mod", "text": "時【大】，時攝【校異-原】"}
{"id": null, "n": "0340005", "target": "#nkr_note_mod_0340005", "type": "mod", "text": "施【大】，於【考偽-原】"}
{"id": null, "n": "0340006", "target": "#nkr_note_mod_0340006", "type": "mod", "text": "寶雨【大】，〔－〕【校異-原】"}
{"id": null, "n": "0340007", "target": "#nkr_note_mod_0340007", "type": "mod", "text": "說【大】，謂【校異-原】"}
{"id": null, "n": "0340008", "target": "#nkr_note_mod_0340008", "type": "mod", "text": "又有【大】，（爾時佛頂輪王復說真言曰曩莫三滿多重沒馱喃引阿鉢囉二合底賀哆上捨娑曩南引佉佉佉呬吽吽入嚩二合攞入嚩二合攞鉢囉二合入嚩二合攞底瑟吒瑟置哩二合娑頗二合吒娑嚩二合賀若誦此真言者所有執曜惡星陵逼本命胎業等皆悉變為吉祥速離生死流輪疾成無上菩提是時）百十九字【校異-原】"}
{"id": null, "n": "0340009", "target": "#nkr_note_mod_0340009", "type": "mod", "text": "密【大】，頌【校異-原】"}
{"id": null, "n": "0340010", "target": "#nkr_note_mod_0340010", "type": "mod", "text": "合【大】，合八【考偽-原】"}
{"id": null, "n": "0340011", "target": "#nkr_note_mod_0340011", "type": "mod", "text": "已【大】，已爾時八大菩薩復說八大密印及一字真言【校異-原】"}
{"id": null, "n": "0340012", "target": "#nkr_note_mod_0340012", "type": "mod", "text": "薩【大】，薩復【校異-原】"}
{"id": null, "n": "0340013", "target": "#nkr_note_mod_0340013", "type": "mod", "text": "現【大】，現作【校異-原】"}
{"id": null, "n": "0340014", "target": "#nkr_note_mod_0340014", "type": "mod", "text": "輪【大】，輪王【校異-原】"}
{"id": null, "n": "0340015", "target": "#nkr_note_mod_0340015", "type": "mod", "text": "以【大】，以持【校異-原】"}
{"id": null, "n": "0340016", "target": "#nkr_note_mod_0340016", "type": "mod", "text": "作【大】，作作【校異-原】"}
{"id": null, "n": "0340017", "target": "#nkr_note_mod_0340017", "type": "mod", "text": "火【大】，光明【校異-原】"}
{"id": null, "n": "0341001", "target": "#nkr_note_mod_0341001", "type": "mod", "text": "王【大】，王遍身【校異-原】"}
{"id": null, "n": "0341002", "target": "#nkr_note_mod_0341002", "type": "mod", "text": "十【大】，八【考偽-原】"}
{"id": null, "n": "0341003", "target": "#nkr_note_mod_0341003", "type": "mod", "text": "馳【大】，馱【校異-原】"}
{"id": null, "n": "0341004", "target": "#nkr_note_mod_0341004", "type": "mod", "text": "心【大】，〔－〕【校異-原】"}
{"id": null, "n": "0341005", "target": "#nkr_note_mod_0341005", "type": "mod", "text": "我【大】，我等【校異-原】"}
{"id": null, "n": "0341006", "target": "#nkr_note_mod_0341006", "type": "mod", "text": "上【大】，上智【校異-原】"}
{"id": null, "n": "0341007", "target": "#nkr_note_mod_0341007", "type": "mod", "text": "佛【大】，〔－〕【校異-原】"}
{"id": null, "n": "0341008", "target": "#nkr_note_mod_0341008", "type": "mod", "text": "身【大】，我身【校異-原】"}
{"id": null, "n": "0341009", "target": "#nkr_note_mod_0341009", "type": "mod", "text": "中【大】，霧中【校異-原】"}
{"id": null, "n": "0341010", "target": "#nkr_note_mod_0341010", "type": "mod", "text": "傳【大】，法【校異-原】"}
{"id": null, "n": "0341011", "target": "#nkr_note_mod_0341011", "type": "mod", "text": "心【大】，自心月【校異-原】"}
{"id": null, "n": "0341012", "target": "#nkr_note_mod_0341012", "type": "mod", "text": "金輪【大】，金剛焰輪【校異-原】"}
{"id": null, "n": "0341013", "target": "#nkr_note_mod_0341013", "type": "mod", "text": "剛【大】，剛焰【校異-原】"}
{"id": null, "n": "0341014", "target": "#nkr_note_mod_0341014", "type": "mod", "text": "頂【大】，攝一切佛頂【校異-原】"}
{"id": null, "n": "0341015", "target": "#nkr_note_mod_0341015", "type": "mod", "text": "印【大】，此印【校異-原】"}
{"id": null, "n": "0341016", "target": "#nkr_note_mod_0341016", "type": "mod", "text": "輪【大】，輪九度旋輪【校異-原】"}
{"id": null, "n": "0341017", "target": "#nkr_note_mod_0341017", "type": "mod", "text": "婀字心【大】，〔－〕【校異-原】"}
{"id": null, "n": "0341018", "target": "#nkr_note_mod_0341018", "type": "mod", "text": "惡字【大】，部嚕吽三合【校異-原】"}
{"id": null, "n": "0341019", "target": "#nkr_note_mod_0341019", "type": "mod", "text": "佛形【大】，伴頂輪王形【校異-原】"}
{"id": null, "n": "0341020", "target": "#nkr_note_mod_0341020", "type": "mod", "text": "空【大】，空法界【校異-原】"}
{"id": null, "n": "0341021", "target": "#nkr_note_mod_0341021", "type": "mod", "text": "為【大】，為彼【校異-原】"}
{"id": null, "n": "0341022", "target": "#nkr_note_mod_0341022", "type": "mod", "text": "輪【大】，輪從彼頂入【校異-原】"}
{"id": null, "n": "0341023", "target": "#nkr_note_mod_0341023", "type": "mod", "text": "法【大】，是法【校異-原】"}
{"id": null, "n": "0342001", "target": "#nkr_note_mod_0342001", "type": "mod", "text": "說【大】，是說【校異-原】"}
{"id": null, "n": "0342002", "target": "#nkr_note_mod_0342002", "type": "mod", "text": "佛【大】，佛等對於佛【校異-原】"}
{"id": null, "n": "0342003", "target": "#nkr_note_mod_0342003", "type": "mod", "text": "八【大】，時八【校異-原】"}
{"id": null, "n": "0342004", "target": "#nkr_note_mod_0342004", "type": "mod", "text": "佛【大】，香【校異-原】"}
{"id": null, "n": "0342005", "target": "#nkr_note_mod_0342005", "type": "mod", "text": "有【大】，一切有【校異-原】"}
{"id": null, "n": "0342006", "target": "#nkr_note_mod_0342006", "type": "mod", "text": "時【大】，爾時【校異-原】"}
{"id": null, "n": "0342007", "target": "#nkr_note_mod_0342007", "type": "mod", "text": "讚【大】，讚曰【校異-原】"}
{"id": null, "n": "0342008", "target": "#nkr_note_mod_0342008", "type": "mod", "text": "法界位【大】，中【校異-原】"}
{"id": null, "n": "0342009", "target": "#nkr_note_mod_0342009", "type": "mod", "text": "言【大】，言答【校異-原】"}
