{"id": null, "n": "0339018", "target": "#nkr_note_mod_0339018", "type": "mod", "text": "以【大】，已【校異-原】"}
{"id": null, "n": "0339019", "target": "#nkr_note_mod_0339019", "type": "mod", "text": "定【大】，定起【考偽-原】"}
{"id": null, "n": "0339020", "target": "#nkr_note_mod_0339020", "type": "mod", "text": "曇【大】，曇二【考偽-原】"}
