{"id": null, "n": "0776001", "target": "#nkr_note_mod_0776001", "type": "mod", "text": "唐【大】，〔－〕【宋】【宮】，唐武周【元】"}
{"id": null, "n": "0776002", "target": "#nkr_note_mod_0776002", "type": "mod", "text": "天【大】，南天【宋】【元】【明】【宮】"}
{"id": null, "n": "0776003", "target": "#nkr_note_mod_0776003", "type": "mod", "text": "竺【大】，竺國【宋】【宮】"}
{"id": null, "n": "0776004", "target": "#nkr_note_mod_0776004", "type": "mod", "text": "三藏【大】，沙門【宋】【元】【明】【宮】"}
{"id": null, "n": "0776005", "target": "#nkr_note_mod_0776005", "type": "mod", "text": "流志【大】，留志【宋】【宮】"}
{"id": null, "n": "0776006", "target": "#nkr_note_mod_0776006", "type": "mod", "text": "譯【大】，等奉制譯【宋】【元】【明】【宮】"}
{"id": null, "n": "0776007", "target": "#nkr_note_mod_0776007", "type": "mod", "text": "猶【大】，獲【宮】"}
{"id": null, "n": "0776008", "target": "#nkr_note_mod_0776008", "type": "mod", "text": "常【大】，甞【宮】"}
{"id": null, "n": "0776009", "target": "#nkr_note_mod_0776009", "type": "mod", "text": "深【大】，染【宮】"}
{"id": null, "n": "0776010", "target": "#nkr_note_mod_0776010", "type": "mod", "text": "利【大】，唎【元】【明】"}
{"id": null, "n": "0777001", "target": "#nkr_note_mod_0777001", "type": "mod", "text": "烏舸反【大】，〔－〕【明】，音烏舸反【宮】"}
{"id": null, "n": "0778001", "target": "#nkr_note_mod_0778001", "type": "mod", "text": "修【大】，脩【宋】【元】【明】"}
{"id": null, "n": "0776001", "target": "#nkr_note_orig_0776001", "type": "orig", "text": "〔唐〕－【宋】【宮】，唐＋（武周）【元】"}
{"id": null, "n": "0776002", "target": "#nkr_note_orig_0776002", "type": "orig", "text": "（南）＋天【三】【宮】"}
{"id": null, "n": "0776003", "target": "#nkr_note_orig_0776003", "type": "orig", "text": "竺＋（國）【宋】【宮】"}
{"id": null, "n": "0776004", "target": "#nkr_note_orig_0776004", "type": "orig", "text": "三藏＝沙門【三】【宮】"}
{"id": null, "n": "0776005", "target": "#nkr_note_orig_0776005", "type": "orig", "text": "流志＝留志【宋】【宮】"}
{"id": null, "n": "0776006", "target": "#nkr_note_orig_0776006", "type": "orig", "text": "（等奉制）＋譯【三】【宮】"}
{"id": null, "n": "0776007", "target": "#nkr_note_orig_0776007", "type": "orig", "text": "猶＝獲【宮】"}
{"id": null, "n": "0776008", "target": "#nkr_note_orig_0776008", "type": "orig", "text": "常＝甞【宮】"}
{"id": null, "n": "0776009", "target": "#nkr_note_orig_0776009", "type": "orig", "text": "深＝染【宮】"}
{"id": null, "n": "0776010", "target": "#nkr_note_orig_0776010", "type": "orig", "text": "利＝唎【元】【明】"}
{"id": null, "n": "0777001", "target": "#nkr_note_orig_0777001", "type": "orig", "text": "〔烏舸反〕－【明】，（音）＋烏【宮】"}
{"id": null, "n": "0778001", "target": "#nkr_note_orig_0778001", "type": "orig", "text": "修＝脩【三】"}
