{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕四，恐回"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕䛷，恐該"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕牧，恐收"}
{"id": null, "n": null, "target": null, "type": null, "text": "二金標為險道之津梁，永作後\n來之龜鏡。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕二金以下至終十六字，當入前行釧無下。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕圓恐國"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕婁恐韋"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕勸恐歡"}
{"id": null, "n": null, "target": null, "type": null, "text": "附見十五人"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛陀耶舍惠特〔考〕特，寶珠集作持，曇順附。"}
{"id": null, "n": null, "target": null, "type": null, "text": "僧光、惠堪、惠蘭附"}
{"id": null, "n": null, "target": null, "type": null, "text": "道海、曇源、逍廣、道元附"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕法恐浩誤歟？"}
{"id": null, "n": null, "target": null, "type": null, "text": "法音附"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕安恐要"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕米，寶集作未。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕已，戒傳作亡。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕千，寶集作十。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕三觀勝，寶集作二覩聖。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕尤，恐至。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕設，寶集作說。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕苦字缼歟。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕成，恐我。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕共，恐\n\n告。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕未，寶集作來。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕邪，恐耶。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕自，恐目。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕吉，恐告。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕右，寶集作居。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕代，寶集作岱。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕傳，寶集作縛。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕西，寶\n集作而。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕逮，寶集作迎。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕訛，寶\n集作說。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕未，寶集作示。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕西，恐而。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕淡，寶集作從。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕訛，寶集作說。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕定，寶集作室。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕又來伏一字恐\n衍。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕而，寶集作西。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕物，寶集作初。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕乘，寶集作業。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕背，寶集作皆。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕乘，寶集作業。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕塊，寶集作愧。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕䅎，寶集作誘。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕𫦀，寶集作剋。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕尤，寶集作至。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕王，寶集作玉。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕寶集作復。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕左，寶集作尼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕憶蓋，寶集作幢。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕犬恐大。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕公下，寶集有耳䖍。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕千，寶集作于。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕次安，寶集作深要。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕違，寶集作建。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕枚，寶集作授。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕千，恐于。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕寶集作引。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕犬若，寶集作大慈。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕尤，寶集作至。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕未，寶集作來。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕頗，寶集作\n顧。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕室，寶集作豈。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕說，寶集作悅。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕年，寶集作日。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕艮，寶集作即。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕宛生，寶集作死。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕赴，寶集作哉。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕注，寶集作泣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕千，恐于。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕睹，寶集作覩。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕尤，寶集作至。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕立，寶集作意。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕徒，寶集作空。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕證，寶集作\n䛑。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕齊，寶集作督。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕公下，寶集有遠公，此書恐脫。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕𮱶，寶集作旌。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕忌，寶集作忘。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕寫，寶集作焉。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕議，寶集作誌。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕眾，寶集作永。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕間，寶集作澗。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕具待，寶集作且持。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕艮，寶集作即。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕大，寶集作又。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕真，寶集欠。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕󴄦，寶集作悅。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕乎，寶集作手。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕愧，寶集作慰。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕曰，寶集作日。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕柏，寶集作指。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕月，寶\n集作甘。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕及，寶集作乃。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕然，寶集作佛後。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕七，寶集作九。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕田恐白"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕󴄯恐非"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕虔恐虞"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕與恐歟"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕光恐先"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕子下，寶集有巾寫之外四字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "荐"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕晴，寶集作時。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕難，寶集欠。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕謂下，寶集有賢。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕誡，寶集作也識。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕皆，寶集作北。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕地下至學地二十字，恐衍。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕均，恐衍。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕開，戒傳作關。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕安，恐要。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕仍，寶集作得。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕禪，寶集作譯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕求，寶集作子相。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕滅，恐威。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕座下，寶集有臥。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕有，寶集作存。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕在，寶集作生。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕朋，寶集作明，誠也，明\n也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕㝡，恐叡。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕旁，寶集作房。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕西，寶集作而。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕雅，寶集作稚。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕開枝，寶集作入關林。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕言，寶集作亡。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕謹下，寶集有甞字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕故下，寶集有雖字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕恙，寶集作悉。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕曰，寶集作日。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕爰，寶集作嚴。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕性，寶集缼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕驅，寶集作區。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕業下，寶集有有字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕得，寶集作復。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕英，寶集作莫。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕序，寶集作廊。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕愈，寶集作逾。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕已，寶集作亡。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕淮，寶集作維。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕言自，寶集作目。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕命命，寶集作共命。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕弘，寶集作泓，下同。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕自廣陵至山寺，寶集作黃龍人\n也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕崦，寶集作山。唵。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕又，寶集作為。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕舁之，寶集缺。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕󴄸，寶集作已爛。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕故，寶集作此。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕月，寶集作日。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕或飲\n谷取水，寶集作巖谷聚。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕奔，寶集作犇。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕已，寶集作\n亡。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕進，寶集缼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕收，寶集作取。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕道，寶\n集作遺。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕右，寶集作石。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕再問之，寶集缼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕惟，寶集作唯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕自謂群至人主，寶集作有言。凡\n人之生。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕無常，恐衍。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕乎，寶集作手。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕無贊，寶集作不替。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕束，寶集作來。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕魏寶集缺"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕於，寶集作阿。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕見，寶集作兄。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕左，寶集作尼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕清下，寶集有河字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕逾扗，寶集作途壯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕救，寶集作󳫠。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕今，寶集作\n分。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕入，寶集作八。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕糸，寶集作系。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕時，寶集缺。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕再，寶集作丹。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕聽，寶集考聰。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕三莊，寶集作二藏。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕造下，寶集有佛字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕皷，寶集作彭。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕違，恐\n建。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕接量，寶集作接至。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕缺字，寶集有寺寺內三字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕於，寶集作捨。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕曰，恐日。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕惠，寶集作慧。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕惟，寶集作唯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕𧹞，寶集作報。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕袟，寶集作帙。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕辨下，寶集有願字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕誰下，寶集有進字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕如，寶集作品。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕惠，寶集？戒傳作慧。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕必下寶集有能字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕已，恐己。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕曰，寶集作日。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕判，寶集作淵。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕宥，寶集作宿。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕曰，寶集作日。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕恙，寶集作悉。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕者，寶集作著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕缺字，\n寶集作盡。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕及病大漸，寶集作一日有疾。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕乃，寶集作及。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕願，寶集作顙。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕朱，寶集作木。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕且下寶集有見字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕惟，寶集作\n唯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕缺字，寶集有厚人也三字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕權，寶集作指。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕未甞出諸\n口，惟，寶集作不曾出口，唯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕竟，恐兒。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕缺字，恐樹。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕艮，寶集作即。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕尒，寶集作耳。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕艮，寶集作即。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕缺字，寶集有至於二字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕舟，寶集作丹。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕曰，寶集作日。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕仗，寶集作伏充。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕缺字，寶集有且迎矣三字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕果下，寶集有至字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕缺字，寶集有吾為鬼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕父，寶集作文。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕熊，寶集作態。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕咸襄，寶集作盛衰。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕淨土之業著，寶集作淨業者。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕客，寶集作容。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕已，寶集作願其亡。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕缺字，\n寶集作日。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕擁下，寶集有護字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕於，寶集作于。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕艮，恐即。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕䙴，集作遷。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕川，寶集作門。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕缼字，寶集\n作就。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕枚，寶集作授。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕缺字，寶集有必然也三字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕過，寶集作遇。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕文，寶集作支。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕攸，寶集作長。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕眹，寶集作至。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕右，寶集作石。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕其下，寶集有義字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕陀，寶集作雖。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕千，寶集作\n于。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕并下，寶集有州字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕軒昇，寶集作掀昂。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕來下，寶集有世字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕缺字，寶集作難。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕談，寶集作訖。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕缺字，寶集有期屆二字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕咸，寶集作盛。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕曰，寶集作日。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕乃，寶集作而。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕珎，寶集作伱，以下同。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕監，寶集作鑒。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕願下有將隨。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕之下，寶集有及末曾修設，沐浴因緣九字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕虛，寶集作室，缺字作戶。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕缺字，寶集\n有當得金三字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕可，寶集作耳。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕缺字，寶集作能。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕莊□干莊，寶集作藏之於坐。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕已，寶集作亡。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕󴄱，寶集作壑。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕已，寶集作亡。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕結像，恐浩誤象歟？"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕其恐篤。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕獨下恐坐\n字缺。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕忌恐衍。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕惠，寶集作慧。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕文，寶集作\n又。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕寶集作謂。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕忠恐思。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕𫘕，寶集作願。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕年，寶集作手。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕雨格，寶集作兩指。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕目，寶集作見。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕曰，寶集作日。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕權□□，寶集作擁之人。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕痛，寶集作病。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕章，寶集作帝。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕限□，寶集作恨無。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕捨，寶集作施。"}
{"id": null, "n": null, "target": null, "type": null, "text": "中卷歟出類聚淨土五祖傳"}
{"id": null, "n": null, "target": null, "type": null, "text": "同前傳。通玄義分記卷一云：中卷三十三人，其二十五、二十六有善導二人。此傳盍中卷第二十五人。"}
{"id": null, "n": null, "target": null, "type": null, "text": "同前中卷第二十六人歟"}
{"id": null, "n": null, "target": null, "type": null, "text": "附見八人"}
{"id": null, "n": null, "target": null, "type": null, "text": "啟芳、圓果附"}
{"id": null, "n": null, "target": null, "type": null, "text": "張鍾馗附"}
{"id": null, "n": null, "target": null, "type": null, "text": "衡州尼悟性附"}
{"id": null, "n": null, "target": null, "type": null, "text": "靈巋附"}
{"id": null, "n": null, "target": null, "type": null, "text": "侍女附"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "後漢月支三藏譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "曹魏康僧鎧譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "大寶積第十七、十八，唐菩提流志譯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "吳\n支謙譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "宋元嘉中譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "姚秦什法師譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐奘三藏譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "縣"}
{"id": null, "n": null, "target": null, "type": null, "text": "沙門飛錫撰"}
{"id": null, "n": null, "target": null, "type": null, "text": "沙門飛錫撰"}
{"id": null, "n": null, "target": null, "type": null, "text": "神棲安養賦"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛陀耶舍與慧持曇順附"}
{"id": null, "n": null, "target": null, "type": null, "text": "慧持等三人附"}
{"id": null, "n": null, "target": null, "type": null, "text": "尼淨嚴附"}
{"id": null, "n": null, "target": null, "type": null, "text": "僧光慧堪慧蘭附"}
{"id": null, "n": null, "target": null, "type": null, "text": "僧光等三人附"}
{"id": null, "n": null, "target": null, "type": null, "text": "道海曇泓道廣道光附"}
{"id": null, "n": null, "target": null, "type": null, "text": "道海等四人附"}
{"id": null, "n": null, "target": null, "type": null, "text": "親族四人"}
{"id": null, "n": null, "target": null, "type": null, "text": "宋世子親屬四人"}
{"id": null, "n": null, "target": null, "type": null, "text": "翼讚"}
{"id": null, "n": null, "target": null, "type": null, "text": "龍樹附"}
{"id": null, "n": null, "target": null, "type": null, "text": "五祖傳"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔考〕浩象誤"}
{"id": null, "n": null, "target": null, "type": null, "text": "止"}
{"id": null, "n": null, "target": null, "type": null, "text": "法音附"}
{"id": null, "n": null, "target": null, "type": null, "text": "法音附"}
{"id": null, "n": null, "target": null, "type": null, "text": "止"}
{"id": null, "n": null, "target": null, "type": null, "text": "尼大明附"}
{"id": null, "n": null, "target": null, "type": null, "text": "通弟子頂蓋母王氏附"}
{"id": null, "n": null, "target": null, "type": null, "text": "王氏道慧附"}
{"id": null, "n": null, "target": null, "type": null, "text": "道撫附"}
{"id": null, "n": null, "target": null, "type": null, "text": "出于五祖傳"}
{"id": null, "n": null, "target": null, "type": null, "text": "出于五祖傳"}
{"id": null, "n": null, "target": null, "type": null, "text": "出于五祖傳"}
{"id": null, "n": null, "target": null, "type": null, "text": "小童子附"}
{"id": null, "n": null, "target": null, "type": null, "text": "啟芳圓果附"}
{"id": null, "n": null, "target": null, "type": null, "text": "止"}
{"id": null, "n": null, "target": null, "type": null, "text": "五祖傳"}
{"id": null, "n": null, "target": null, "type": null, "text": "張鐘馗附"}
{"id": null, "n": null, "target": null, "type": null, "text": "靈巋附"}
{"id": null, "n": null, "target": null, "type": null, "text": "靈巋附"}
{"id": null, "n": null, "target": null, "type": null, "text": "翼讚"}
{"id": null, "n": null, "target": null, "type": null, "text": "侍女附"}
{"id": null, "n": null, "target": null, "type": null, "text": "止"}
{"id": null, "n": null, "target": null, "type": null, "text": "正傳五十六人附見十九人"}
{"id": null, "n": null, "target": null, "type": null, "text": "正傳三十八人附見十八人"}
{"id": null, "n": null, "target": null, "type": null, "text": "正傳三十三人"}
{"id": null, "n": null, "target": null, "type": null, "text": "正傳卅一人附見八人"}
