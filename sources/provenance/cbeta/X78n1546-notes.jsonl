{"id": null, "n": "0147001", "target": "#nkr_note_orig_0147001", "type": "orig", "text": "旧版ハ下卷ノミ。今󴥺淨土宗全書第十六所收新修往生傳ヨリ上卷及中卷佚文ヲ補卷ス。併テ同全書所收人名對照表モ附ス。󴦒"}
{"id": null, "n": "0154001", "target": "#nkr_note_orig_0154001", "type": "orig", "text": "不疑即"}
{"id": null, "n": "0154002", "target": "#nkr_note_orig_0154002", "type": "orig", "text": "元疑無"}
{"id": null, "n": "0154003", "target": "#nkr_note_orig_0154003", "type": "orig", "text": "十字疑剩"}
{"id": null, "n": "0154004", "target": "#nkr_note_orig_0154004", "type": "orig", "text": "修下疑脫行字"}
{"id": null, "n": "0155001", "target": "#nkr_note_orig_0155001", "type": "orig", "text": "了達真如性疑速斷諸煩惱"}
{"id": null, "n": "0156001", "target": "#nkr_note_orig_0156001", "type": "orig", "text": "百疑日"}
{"id": null, "n": "0156002", "target": "#nkr_note_orig_0156002", "type": "orig", "text": "發疑登"}
{"id": null, "n": "0156003", "target": "#nkr_note_orig_0156003", "type": "orig", "text": "乘疑垂"}
{"id": null, "n": "0157001", "target": "#nkr_note_orig_0157001", "type": "orig", "text": "天上下疑有脫字"}
{"id": null, "n": "0157002", "target": "#nkr_note_orig_0157002", "type": "orig", "text": "月疑日"}
{"id": null, "n": "0157003", "target": "#nkr_note_orig_0157003", "type": "orig", "text": "毗下疑脫尼字"}
{"id": null, "n": "0158001", "target": "#nkr_note_orig_0158001", "type": "orig", "text": "切疑功"}
{"id": null, "n": "0158002", "target": "#nkr_note_orig_0158002", "type": "orig", "text": "速疑連"}
{"id": null, "n": "0158003", "target": "#nkr_note_orig_0158003", "type": "orig", "text": "宜疑宣"}
{"id": null, "n": "0158004", "target": "#nkr_note_orig_0158004", "type": "orig", "text": "時中疑倒"}
{"id": null, "n": "0158005", "target": "#nkr_note_orig_0158005", "type": "orig", "text": "搆疑攝"}
{"id": null, "n": "0158006", "target": "#nkr_note_orig_0158006", "type": "orig", "text": "九字疑剩"}
{"id": null, "n": "0159001", "target": "#nkr_note_orig_0159001", "type": "orig", "text": "異下疑脫香字"}
{"id": null, "n": "0159002", "target": "#nkr_note_orig_0159002", "type": "orig", "text": "往疑住"}
{"id": null, "n": "0159003", "target": "#nkr_note_orig_0159003", "type": "orig", "text": "痛疑病"}
{"id": null, "n": "0159004", "target": "#nkr_note_orig_0159004 #note_star_1", "type": "orig", "text": "歸疑巋次同"}
{"id": null, "n": "0160001", "target": "#nkr_note_orig_0160001", "type": "orig", "text": "其疑甚"}
{"id": null, "n": "0160002", "target": "#nkr_note_orig_0160002", "type": "orig", "text": "身字疑剩"}
