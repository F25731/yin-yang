{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "起鈔文總題，終轉業變根"}
{"id": null, "n": null, "target": null, "type": null, "text": "允堪"}
{"id": null, "n": null, "target": null, "type": null, "text": "星名也，或曰泥土，非。"}
{"id": null, "n": null, "target": null, "type": null, "text": "菩薩徃於甘蔗園遊止修道，因園命\n氏。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此云能仁，因父之嘆。"}
{"id": null, "n": null, "target": null, "type": null, "text": "律云佛舍夷種，亦國號也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "律云父姓名為目也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "人無異執"}
{"id": null, "n": null, "target": null, "type": null, "text": "有疑皆決，\n法無異執"}
{"id": null, "n": null, "target": null, "type": null, "text": "即委切"}
{"id": null, "n": null, "target": null, "type": null, "text": "此言大眾老少同會共集律部也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此言老宿淳、老宿人\n同會共出律部也"}
{"id": null, "n": null, "target": null, "type": null, "text": "言雞足也"}
{"id": null, "n": null, "target": null, "type": null, "text": "言尊足也"}
{"id": null, "n": null, "target": null, "type": null, "text": "準此，木蘭色也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上疏文。"}
{"id": null, "n": null, "target": null, "type": null, "text": "即陳如等"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘句如大鈔中"}
{"id": null, "n": null, "target": null, "type": null, "text": "即四分須提那"}
{"id": null, "n": null, "target": null, "type": null, "text": "論師自定"}
{"id": null, "n": null, "target": null, "type": null, "text": "殺支佛是"}
{"id": null, "n": null, "target": null, "type": null, "text": "鈔引此句，故曰是逆亦根本也"}
{"id": null, "n": null, "target": null, "type": null, "text": "於法誹謗，出其過惡等是"}
{"id": null, "n": null, "target": null, "type": null, "text": "殺餘類是"}
{"id": null, "n": null, "target": null, "type": null, "text": "起破僧科意，終時非時門"}
{"id": null, "n": null, "target": null, "type": null, "text": "允堪"}
{"id": null, "n": null, "target": null, "type": null, "text": "法想破僧，以非邪故。鈔中法想下，指此。"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂殺\n母、殺父、殺阿羅漢，惡心出如來血是。"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂調達也。此句是總。"}
{"id": null, "n": null, "target": null, "type": null, "text": "除是句。"}
{"id": null, "n": null, "target": null, "type": null, "text": "法想破僧，論開\n此受。"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂六師等。"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂調達也。亦是\n總句。"}
{"id": null, "n": null, "target": null, "type": null, "text": "除是句。"}
{"id": null, "n": null, "target": null, "type": null, "text": "去聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "文略出罪二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上本文"}
{"id": null, "n": null, "target": null, "type": null, "text": "此為正解。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此為非解。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云\n云"}
{"id": null, "n": null, "target": null, "type": null, "text": "上六時義，備如發揮，引文為解。"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上律文"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上本文"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上本文"}
{"id": null, "n": null, "target": null, "type": null, "text": "非時現前但改七月等作，\n非時但現前及除前安居之言作之"}
{"id": null, "n": null, "target": null, "type": null, "text": "或講食堂，隨界大少，皆有擲石界，比丘入\n皆得分也"}
{"id": null, "n": null, "target": null, "type": null, "text": "王臣為比丘作住止\n竟，或十由旬，若竪柱，若標相齊，此內有布施，皆屬我等"}
{"id": null, "n": null, "target": null, "type": null, "text": "有市名聚，\n無市名村"}
{"id": null, "n": null, "target": null, "type": null, "text": "有城邑也"}
{"id": null, "n": null, "target": null, "type": null, "text": "蘭若界也"}
{"id": null, "n": null, "target": null, "type": null, "text": "船界是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "隨城東西名鄉"}
{"id": null, "n": null, "target": null, "type": null, "text": "國土界"}
{"id": null, "n": null, "target": null, "type": null, "text": "一王所領國土"}
{"id": null, "n": null, "target": null, "type": null, "text": "海中一洲"}
{"id": null, "n": null, "target": null, "type": null, "text": "是一鐵圍"}
{"id": null, "n": null, "target": null, "type": null, "text": "今師取此古德，律鈔記中乃以第二為第\n三，與此列異"}
{"id": null, "n": null, "target": null, "type": null, "text": "羯磨準此，至時\n牒用"}
{"id": null, "n": null, "target": null, "type": null, "text": "即指善見"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上就事。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此句心虗故重"}
{"id": null, "n": null, "target": null, "type": null, "text": "證心實也"}
{"id": null, "n": null, "target": null, "type": null, "text": "鈔闕後二故曰等也"}
{"id": null, "n": null, "target": null, "type": null, "text": "今鈔闕此，在下科明。"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上疏文"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上疏文。"}
{"id": null, "n": null, "target": null, "type": null, "text": "准此，後衣無染。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此證迦絺在後"}
{"id": null, "n": null, "target": null, "type": null, "text": "此為一分，\n收鈔中若前下至應作來文"}
{"id": null, "n": null, "target": null, "type": null, "text": "此第\n二分，收鈔中十亦爾一句"}
{"id": null, "n": null, "target": null, "type": null, "text": "此第三分，收鈔後十至望衣文"}
{"id": null, "n": null, "target": null, "type": null, "text": "此第四分，收鈔乃至迄即日作來文。鈔略前三，\n故曰乃至"}
{"id": null, "n": null, "target": null, "type": null, "text": "上有文像"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上示求中攝閏得不也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上示用中攝閏也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "尼弱闕此"}
{"id": null, "n": null, "target": null, "type": null, "text": "此為一問"}
{"id": null, "n": null, "target": null, "type": null, "text": "此為一問"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上正文"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂通明施\n僧，而未分僧別二異，此𢌞犯捨也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂俗家為僧作牀褥器具\n供僧之物，此𢌞得吉羅也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此決施於僧，不\n許別屬𢌞犯弃"}
{"id": null, "n": null, "target": null, "type": null, "text": "在經說戒日十五日後三日"}
{"id": null, "n": null, "target": null, "type": null, "text": "去布薩日二日"}
{"id": null, "n": null, "target": null, "type": null, "text": "即一時受請，各去、各受、各食是也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此云不正"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上\n正文"}
{"id": null, "n": null, "target": null, "type": null, "text": "是正而足也"}
{"id": null, "n": null, "target": null, "type": null, "text": "煞生等戒，倣上而作"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上正文"}
{"id": null, "n": null, "target": null, "type": null, "text": "即四分度之一"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上約十八年中算得六月二十二日半也"}
{"id": null, "n": null, "target": null, "type": null, "text": "計一百九十六箇月"}
{"id": null, "n": null, "target": null, "type": null, "text": "初兩頻大皆至十七月，後一頻大但至十五月，以一章月盡故。已上一章既得三日，四章則得\n一十二日"}
{"id": null, "n": null, "target": null, "type": null, "text": "共成\n三百四十二日"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂頻大中十四日，又前胎閏中分三日，在十七日數"}
{"id": null, "n": null, "target": null, "type": null, "text": "由三十二分為日故"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼約實滿二十兩，謂言不滿，故言結\n吉。"}
{"id": null, "n": null, "target": null, "type": null, "text": "允堪"}
{"id": null, "n": null, "target": null, "type": null, "text": "此謂尼等容生彼染心，故滅僧二指。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此覔諍中\n共用四藥"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂無學，斷煩惱盡故"}
{"id": null, "n": null, "target": null, "type": null, "text": "三、果人，能以正\n法示人令學故"}
{"id": null, "n": null, "target": null, "type": null, "text": "初、果向已下，欲受聖道在身故"}
{"id": null, "n": null, "target": null, "type": null, "text": "犯戒人也"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T02n0120_p0512c28"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T02n0120_p0514a01"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T53n2121_p0042b03"}
{"id": null, "n": null, "target": null, "type": "cf3", "text": "T46n1912_p0377a04"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T40n1804_p0071a07"}
{"id": null, "n": "0824001", "target": "#nkr_note_mod_0824001", "type": "mod", "text": "竟【CB】，意【卍續】，意疑竟"}
{"id": null, "n": "0798001", "target": "#nkr_note_orig_0798001", "type": "orig", "text": "妍疑研"}
{"id": null, "n": "0801001", "target": "#nkr_note_orig_0801001", "type": "orig", "text": "億疑隱"}
{"id": null, "n": "0803001", "target": "#nkr_note_orig_0803001", "type": "orig", "text": "歸通嫁"}
{"id": null, "n": "0804001", "target": "#nkr_note_orig_0804001", "type": "orig", "text": "彰疑影"}
{"id": null, "n": "0806001", "target": "#nkr_note_orig_0806001", "type": "orig", "text": "蹤疑縱"}
{"id": null, "n": "0806002", "target": "#nkr_note_orig_0806002", "type": "orig", "text": "故疑敬"}
{"id": null, "n": "0814001", "target": "#nkr_note_orig_0814001", "type": "orig", "text": "鈔卷上之二"}
{"id": null, "n": "0815001", "target": "#nkr_note_orig_0815001", "type": "orig", "text": "於疑戒"}
{"id": null, "n": "0820001", "target": "#nkr_note_orig_0820001", "type": "orig", "text": "猶鈔作由"}
{"id": null, "n": "0823001", "target": "#nkr_note_orig_0823001", "type": "orig", "text": "罪煞疑倒"}
{"id": null, "n": "0824001", "target": "#nkr_note_orig_0824001", "type": "orig", "text": "意疑竟"}
{"id": null, "n": "0824002", "target": "#nkr_note_orig_0824002", "type": "orig", "text": "如疑加"}
{"id": null, "n": "0826001", "target": "#nkr_note_orig_0826001", "type": "orig", "text": "半疑羊"}
{"id": null, "n": "0827001", "target": "#nkr_note_orig_0827001", "type": "orig", "text": "鈔卷中之一"}
{"id": null, "n": "0835001", "target": "#nkr_note_orig_0835001", "type": "orig", "text": "可鈔一作不"}
{"id": null, "n": "0841001", "target": "#nkr_note_orig_0841001 #note_star_1", "type": "orig", "text": "氀鈔作毹"}
{"id": null, "n": "0843001", "target": "#nkr_note_orig_0843001", "type": "orig", "text": "鈔卷中之二"}
{"id": null, "n": "0846001", "target": "#nkr_note_orig_0846001", "type": "orig", "text": "言字疑衍"}
{"id": null, "n": "0846002", "target": "#nkr_note_orig_0846002", "type": "orig", "text": "情字更勘"}
{"id": null, "n": "0847001", "target": "#nkr_note_orig_0847001", "type": "orig", "text": "＊着疑看（＊ノ字ハ本文ト異ナル。󴦒）"}
{"id": null, "n": "0851001", "target": "#nkr_note_orig_0851001", "type": "orig", "text": "住鈔作往"}
{"id": null, "n": "0855001", "target": "#nkr_note_orig_0855001", "type": "orig", "text": "反疑犯"}
{"id": null, "n": "0856001", "target": "#nkr_note_orig_0856001", "type": "orig", "text": "粟疑栗"}
