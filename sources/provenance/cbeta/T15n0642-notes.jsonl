{"id": null, "n": "0629001", "target": "#nkr_note_mod_0629001", "type": "mod", "text": "卷【大】，〔－〕【宋】【元】"}
{"id": null, "n": "0629002", "target": "#nkr_note_mod_0629002", "type": "mod", "text": "後【大】，姚【宋】【元】【明】"}
{"id": null, "n": "0629003", "target": "#nkr_note_mod_0629003", "type": "mod", "text": "龜茲國【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0629004", "target": "#nkr_note_mod_0629004", "type": "mod", "text": "以【大】，已【元】【明】"}
{"id": null, "n": "0629005", "target": "#nkr_note_mod_0629005", "type": "mod", "text": "退【大】，退轉【元】【明】"}
{"id": null, "n": "0629006", "target": "#nkr_note_mod_0629006", "type": "mod", "text": "淨【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0629007", "target": "#nkr_note_mod_0629007", "type": "mod", "text": "獲【大】，得【元】【明】"}
{"id": null, "n": "0630001", "target": "#nkr_note_mod_0630001", "type": "mod", "text": "如【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0630002", "target": "#nkr_note_mod_0630002", "type": "mod", "text": "聞【大】，間【宋】"}
{"id": null, "n": "0630003", "target": "#nkr_note_mod_0630003", "type": "mod", "text": "上【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0630004", "target": "#nkr_note_mod_0630004", "type": "mod", "text": "種【大】，重【明】"}
{"id": null, "n": "0630005", "target": "#nkr_note_mod_0630005", "type": "mod", "text": "作【大】，住【宋】【元】【明】"}
{"id": null, "n": "0630006", "target": "#nkr_note_mod_0630006", "type": "mod", "text": "實【大】，實坐【元】【明】"}
{"id": null, "n": "0630007", "target": "#nkr_note_mod_0630007", "type": "mod", "text": "後亦無【大】，亦無滅【元】【明】"}
{"id": null, "n": "0631001", "target": "#nkr_note_mod_0631001", "type": "mod", "text": "間【大】，界【宋】【元】【明】"}
{"id": null, "n": "0631002", "target": "#nkr_note_mod_0631002", "type": "mod", "text": "順【大】，隨順【元】【明】"}
{"id": null, "n": "0631003", "target": "#nkr_note_mod_0631003", "type": "mod", "text": "生【大】，生三十一【宋】"}
{"id": null, "n": null, "target": null, "type": null, "text": "三十一"}
{"id": null, "n": "0631004", "target": "#nkr_note_mod_0631004", "type": "mod", "text": "三十一【大】，〔－〕【宋】"}
{"id": null, "n": "0631005", "target": "#nkr_note_mod_0631005", "type": "mod", "text": "發【大】，能於現世發【元】【明】"}
{"id": null, "n": "0631006", "target": "#nkr_note_mod_0631006", "type": "mod", "text": "測【大】，惻【宋】"}
{"id": null, "n": "0631007", "target": "#nkr_note_mod_0631007", "type": "mod", "text": "力通【大】，力遍【宋】，力遍示【元】【明】"}
{"id": null, "n": "0631008", "target": "#nkr_note_mod_0631008", "type": "mod", "text": "受【大】，現【元】【明】"}
{"id": null, "n": "0632001", "target": "#nkr_note_mod_0632001", "type": "mod", "text": "嚴【大】，嚴三昧【元】【明】"}
{"id": null, "n": "0632002", "target": "#nkr_note_mod_0632002", "type": "mod", "text": "上【大】，尚【宋】【元】【明】"}
{"id": null, "n": "0632003", "target": "#nkr_note_mod_0632003", "type": "mod", "text": "為【大】，於【明】"}
{"id": null, "n": "0632004", "target": "#nkr_note_mod_0632004", "type": "mod", "text": "伎【大】，技【元】【明】"}
{"id": null, "n": "0632005", "target": "#nkr_note_mod_0632005", "type": "mod", "text": "嶮【大】，險【明】"}
{"id": null, "n": "0632006", "target": "#nkr_note_mod_0632006", "type": "mod", "text": "於【大】，〔－〕【宋】"}
{"id": null, "n": "0632007", "target": "#nkr_note_mod_0632007", "type": "mod", "text": "墮【大】，隨【宋】【元】【明】"}
{"id": null, "n": "0632008", "target": "#nkr_note_mod_0632008", "type": "mod", "text": "就【大】，熟【宋】【元】【明】"}
{"id": null, "n": "0633001", "target": "#nkr_note_mod_0633001", "type": "mod", "text": "得【大】，見【元】【明】"}
{"id": null, "n": "0633002", "target": "#nkr_note_mod_0633002", "type": "mod", "text": "彼岸【大】，術算【元】【明】"}
{"id": null, "n": "0633003", "target": "#nkr_note_mod_0633003", "type": "mod", "text": "菩薩住【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0633004", "target": "#nkr_note_mod_0633004", "type": "mod", "text": "除愈【大】，愈病【元】【明】"}
{"id": null, "n": "0633005", "target": "#nkr_note_mod_0633005", "type": "mod", "text": "欲【大】，用【宋】【元】【明】"}
{"id": null, "n": "0633006", "target": "#nkr_note_mod_0633006", "type": "mod", "text": "如【大】，誠如【元】【明】"}
{"id": null, "n": "0633007", "target": "#nkr_note_mod_0633007", "type": "mod", "text": "準【大】＊，堆【宋】，准【元】【明】＊"}
{"id": null, "n": "0634001", "target": "#nkr_note_mod_0634001", "type": "mod", "text": "生【大】＊，生王【元】【明】＊"}
{"id": null, "n": "0634002", "target": "#nkr_note_mod_0634002", "type": "mod", "text": "姓【大】，姓入胎出生【宋】【元】【明】"}
{"id": null, "n": "0634003", "target": "#nkr_note_mod_0634003", "type": "mod", "text": "能【大】，〔－〕【宋】"}
{"id": null, "n": "0634004", "target": "#nkr_note_mod_0634004", "type": "mod", "text": "已入胎出生【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0634005", "target": "#nkr_note_mod_0634005", "type": "mod", "text": "分【大】，分已【宋】【元】【明】"}
{"id": null, "n": "0634006", "target": "#nkr_note_mod_0634006", "type": "mod", "text": "頂【大】，山【宋】【元】【明】"}
{"id": null, "n": "0634007", "target": "#nkr_note_mod_0634007", "type": "mod", "text": "卷上終，卷中首【宋】【元】【明】"}
{"id": null, "n": "0634008", "target": "#nkr_note_mod_0634008", "type": "mod", "text": "卷上終，卷中首【宋】【元】【明】"}
{"id": null, "n": "0634009", "target": "#nkr_note_mod_0634009", "type": "mod", "text": "如【大】，〔－〕【元】【明】"}
{"id": null, "n": "0634010", "target": "#nkr_note_mod_0634010", "type": "mod", "text": "域【大】＊，或【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0635001", "target": "#nkr_note_mod_0635001", "type": "mod", "text": "中【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0635002", "target": "#nkr_note_mod_0635002", "type": "mod", "text": "采【大】，婇【宋】【元】【明】"}
{"id": null, "n": "0635003", "target": "#nkr_note_mod_0635003", "type": "mod", "text": "愛【大】，受【宋】【元】【明】"}
{"id": null, "n": "0635004", "target": "#nkr_note_mod_0635004", "type": "mod", "text": "住【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0635005", "target": "#nkr_note_mod_0635005", "type": "mod", "text": "守【大】，〔－〕【元】【明】"}
{"id": null, "n": "0635006", "target": "#nkr_note_mod_0635006", "type": "mod", "text": "伎【大】，妓【元】【明】"}
{"id": null, "n": "0635007", "target": "#nkr_note_mod_0635007", "type": "mod", "text": "是【大】，為【明】"}
{"id": null, "n": "0635008", "target": "#nkr_note_mod_0635008", "type": "mod", "text": "現皆【大】，悉現【宋】【元】【明】"}
{"id": null, "n": "0636001", "target": "#nkr_note_mod_0636001", "type": "mod", "text": "夫【大】，人【宋】"}
{"id": null, "n": "0636002", "target": "#nkr_note_mod_0636002", "type": "mod", "text": "集【大】，習【宋】【元】【明】"}
{"id": null, "n": "0636003", "target": "#nkr_note_mod_0636003", "type": "mod", "text": "答言【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0636004", "target": "#nkr_note_mod_0636004", "type": "mod", "text": "而【大】，如【宋】【元】【明】"}
{"id": null, "n": "0636005", "target": "#nkr_note_mod_0636005", "type": "mod", "text": "言【大】，曰【宋】【元】【明】"}
{"id": null, "n": "0636006", "target": "#nkr_note_mod_0636006", "type": "mod", "text": "說【大】，諸【宋】【元】【明】"}
{"id": null, "n": "0636007", "target": "#nkr_note_mod_0636007", "type": "mod", "text": "向【CB】【房山-CB】【金藏乙-CB】【宋】【元】【明】，何【大】"}
{"id": null, "n": "0637001", "target": "#nkr_note_mod_0637001", "type": "mod", "text": "種【大】，種種【宋】【元】【明】"}
{"id": null, "n": "0637002", "target": "#nkr_note_mod_0637002", "type": "mod", "text": "法【大】，語【宋】【元】【明】"}
{"id": null, "n": "0637003", "target": "#nkr_note_mod_0637003", "type": "mod", "text": "殖【大】，植【宋】【元】【明】"}
{"id": null, "n": "0637004", "target": "#nkr_note_mod_0637004", "type": "mod", "text": "不分卷【宋】【元】【明】"}
{"id": null, "n": "0637005", "target": "#nkr_note_mod_0637005", "type": "mod", "text": "不分卷【宋】【元】【明】"}
