{"id": null, "n": "0376001", "target": "#nkr_note_mod_0376001", "type": "mod", "text": "現在【大】，〔－〕【宋】【宮】，現在賢劫千佛名經【明】大異與【麗】【宋】【元】【宮】對校甚難故別【明】附卷末 p. 383. (9) 參照"}
{"id": null, "n": "0376002", "target": "#nkr_note_mod_0376002", "type": "mod", "text": "經【大】，經卷中【宋】【元】【宮】"}
{"id": null, "n": "0376003", "target": "#nkr_note_mod_0376003", "type": "mod", "text": "（亦名…山）九字【大】，〔－〕【宋】【宮】，（亦名…山）九字＝錄云出賢劫經今以類編通單本部【元】"}
{"id": null, "n": "0376004", "target": "#nkr_note_mod_0376004", "type": "mod", "text": "爾【大】，現在賢劫千佛名經爾【元】"}
{"id": null, "n": "0376005", "target": "#nkr_note_mod_0376005", "type": "mod", "text": "惟【大】，唯【宋】【宮】"}
{"id": null, "n": "0376006", "target": "#nkr_note_mod_0376006", "type": "mod", "text": "護【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0376007", "target": "#nkr_note_mod_0376007", "type": "mod", "text": "拘【大】，南無拘【宋】【元】【宮】"}
{"id": null, "n": "0376008", "target": "#nkr_note_mod_0376008", "type": "mod", "text": "華妙【大】，妙華【宋】【元】【宮】"}
{"id": null, "n": "0376009", "target": "#nkr_note_mod_0376009", "type": "mod", "text": "丹本妙華【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0376010", "target": "#nkr_note_mod_0376010", "type": "mod", "text": "鬘【大】＊，鬚【宋】【元】【宮】＊"}
{"id": null, "n": "0376011", "target": "#nkr_note_mod_0376011", "type": "mod", "text": "南無華目佛【大】∞南無珍寶佛【宋】【元】【宮】"}
{"id": null, "n": "0376012", "target": "#nkr_note_mod_0376012", "type": "mod", "text": "南無珍寶佛【大】∞南無華目佛【宋】【元】【宮】"}
{"id": null, "n": "0376013", "target": "#nkr_note_mod_0376013", "type": "mod", "text": "南無無量明佛【大】∞南無梵王佛【宮】"}
{"id": null, "n": "0376014", "target": "#nkr_note_mod_0376014", "type": "mod", "text": "南無梵王佛【大】∞南無無量明佛【宮】"}
{"id": null, "n": "0376015", "target": "#nkr_note_mod_0376015", "type": "mod", "text": "南無歡喜佛【大】∞南無善守佛【宮】"}
{"id": null, "n": "0376016", "target": "#nkr_note_mod_0376016", "type": "mod", "text": "南無善守佛【大】∞南無歡喜佛【宮】"}
{"id": null, "n": "0376017", "target": "#nkr_note_mod_0376017", "type": "mod", "text": "無【大】，〔－〕【宮】"}
{"id": null, "n": "0376018", "target": "#nkr_note_mod_0376018", "type": "mod", "text": "丹本觀擇【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0376019", "target": "#nkr_note_mod_0376019", "type": "mod", "text": "（從此…百佛）七字【大】，一百佛竟【宋】【元】【宮】"}
{"id": null, "n": "0376020", "target": "#nkr_note_mod_0376020", "type": "mod", "text": "（歸命…諸佛）四百十六字【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0376021", "target": "#nkr_note_mod_0376021", "type": "mod", "text": "南無華天佛【大】∞南無寶積佛【宮】"}
{"id": null, "n": "0376022", "target": "#nkr_note_mod_0376022", "type": "mod", "text": "南無寶積佛【大】∞南無華天佛【宮】"}
{"id": null, "n": "0376023", "target": "#nkr_note_mod_0376023", "type": "mod", "text": "丹本有相【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0377001", "target": "#nkr_note_mod_0377001", "type": "mod", "text": "丹香【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0377002", "target": "#nkr_note_mod_0377002", "type": "mod", "text": "〔南無滅過佛…南無寶眾…佛〕十二佛名－【元】，（註[14]參照）"}
{"id": null, "n": "0377003", "target": "#nkr_note_mod_0377003", "type": "mod", "text": "佛【大】，佛南無人月佛【宋】【元】【宮】，（【元】註[14]參照）"}
{"id": null, "n": "0377004", "target": "#nkr_note_mod_0377004", "type": "mod", "text": "南無人月佛【大】，〔－〕【宋】【元】【宮】，（【元】註[14]參照）"}
{"id": null, "n": "0377005", "target": "#nkr_note_mod_0377005", "type": "mod", "text": "丹本眾寶【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0377006", "target": "#nkr_note_mod_0377006", "type": "mod", "text": "南無大名佛【大】∞南無龍喜佛【宋】【元】【宮】"}
{"id": null, "n": "0377007", "target": "#nkr_note_mod_0377007", "type": "mod", "text": "南無龍喜佛【大】∞南無大名佛【宋】【元】【宮】"}
{"id": null, "n": "0377008", "target": "#nkr_note_mod_0377008", "type": "mod", "text": "南無目明佛【大】∞南無實語佛【宋】【元】【宮】"}
{"id": null, "n": "0377009", "target": "#nkr_note_mod_0377009", "type": "mod", "text": "丹日【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0377010", "target": "#nkr_note_mod_0377010", "type": "mod", "text": "南無實語佛【大】∞南無目明佛【宋】【元】【宮】"}
{"id": null, "n": "0377011", "target": "#nkr_note_mod_0377011", "type": "mod", "text": "丹本照明【CB】，丹本明【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0377012", "target": "#nkr_note_mod_0377012", "type": "mod", "text": "南無遍見佛【大】∞南無大威德佛【宋】【元】【宮】"}
{"id": null, "n": "0377013", "target": "#nkr_note_mod_0377013", "type": "mod", "text": "南無大威德佛【大】∞南無遍見佛【宋】【元】【宮】"}
{"id": null, "n": "0377014", "target": "#nkr_note_mod_0377014", "type": "mod", "text": "佛＋（南無滅過佛…南無寶眾佛）十二佛名【元】（註[02]參照）"}
{"id": null, "n": "0377015", "target": "#nkr_note_mod_0377015", "type": "mod", "text": "丹相【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0377016", "target": "#nkr_note_mod_0377016", "type": "mod", "text": "佛【大】，佛二百佛竟【宋】【元】【宮】"}
{"id": null, "n": "0377017", "target": "#nkr_note_mod_0377017", "type": "mod", "text": "（從此…三寶）四百六十七字【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0377018", "target": "#nkr_note_mod_0377018", "type": "mod", "text": "能【大】，無能【宮】"}
{"id": null, "n": "0377019", "target": "#nkr_note_mod_0377019", "type": "mod", "text": "佛【大】，佛南無慶音佛【宋】【元】【宮】"}
{"id": null, "n": "0377020", "target": "#nkr_note_mod_0377020", "type": "mod", "text": "南無名德佛【大】∞南無無熱佛【宋】【元】【宮】"}
{"id": null, "n": "0377021", "target": "#nkr_note_mod_0377021", "type": "mod", "text": "南無無熱佛【大】∞南無名德佛【宋】【元】【宮】"}
{"id": null, "n": "0377022", "target": "#nkr_note_mod_0377022", "type": "mod", "text": "南無治怨賊佛【大】∞南無蓮花佛【宋】【元】【宮】"}
{"id": null, "n": "0377023", "target": "#nkr_note_mod_0377023", "type": "mod", "text": "南無蓮花佛【大】∞南無治怨賊佛【宋】【元】【宮】"}
{"id": null, "n": "0377024", "target": "#nkr_note_mod_0377024", "type": "mod", "text": "南無應讚佛【大】∞南無離憍佛【宋】【元】，（南無應…次佛）二佛【大】∞南無離憍佛【宮】"}
{"id": null, "n": "0377025", "target": "#nkr_note_mod_0377025", "type": "mod", "text": "丹知【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0377026", "target": "#nkr_note_mod_0377026", "type": "mod", "text": "南無應讚佛【大】∞南無離憍佛【宋】【元】，（南無應…次佛）二佛【大】∞南無離憍佛【宮】"}
{"id": null, "n": "0377027", "target": "#nkr_note_mod_0377027", "type": "mod", "text": "延【大】，達【宋】【元】【宮】"}
{"id": null, "n": "0377028", "target": "#nkr_note_mod_0377028", "type": "mod", "text": "南無甚良佛【大】，南無見有邊佛【宋】【元】【宮】"}
