{"id": null, "n": "0880002", "target": "#nkr_note_mod_0880002", "type": "mod", "text": "讚【大】，讚六十二頌頌別四句每句七字除題目外計有一千七百三十六字【宋】【元】【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "六十二頌頌別四句每句七字除題目外計有一千七百三十六字"}
{"id": null, "n": "0880004", "target": "#nkr_note_mod_0880004", "type": "mod", "text": "大供【大】，供養【宋】【元】【明】"}
{"id": null, "n": "0880005", "target": "#nkr_note_mod_0880005", "type": "mod", "text": "今【大】，皆【宋】【元】【明】"}
{"id": null, "n": "0880006", "target": "#nkr_note_mod_0880006", "type": "mod", "text": "唯【大】，惟【宋】【元】【明】"}
{"id": null, "n": "0880007", "target": "#nkr_note_mod_0880007", "type": "mod", "text": "生中【大】，眾中【元】【明】"}
{"id": null, "n": "0880008", "target": "#nkr_note_mod_0880008", "type": "mod", "text": "常得咸【大】，咸得常【明】"}
{"id": null, "n": "0880009", "target": "#nkr_note_mod_0880009", "type": "mod", "text": "般若方便定解脫 Prajñā-upāya-samāddhi-vimokṣa."}
{"id": null, "n": "0880010", "target": "#nkr_note_mod_0880010", "type": "mod", "text": "量【大】，盡【宋】【元】【明】"}
{"id": null, "n": "0880011", "target": "#nkr_note_mod_0880011", "type": "mod", "text": "今【大】，令【宋】【元】"}
{"id": null, "n": "0880013", "target": "#nkr_note_mod_0880013", "type": "mod", "text": "得【大】，德【宋】【元】【明】"}
{"id": null, "n": "0881001", "target": "#nkr_note_mod_0881001", "type": "mod", "text": "普賢 Samantatabhadra."}
{"id": null, "n": "0881003", "target": "#nkr_note_mod_0881003", "type": "mod", "text": "須【大】，修【宋】【元】【明】"}
{"id": null, "n": "0881004", "target": "#nkr_note_mod_0881004", "type": "mod", "text": "求【大】，生【明】"}
{"id": null, "n": "0881005", "target": "#nkr_note_mod_0881005", "type": "mod", "text": "已【大】，以【元】【明】"}
{"id": null, "n": "0881006", "target": "#nkr_note_mod_0881006", "type": "mod", "text": "無量光 Amitābha."}
{"id": null, "n": "0881007", "target": "#nkr_note_mod_0881007", "type": "mod", "text": "極樂 Sukhāvatī."}
{"id": null, "n": "0881008", "target": "#nkr_note_mod_0881008", "type": "mod", "text": "受【大】，授【宋】【元】"}
{"id": null, "n": "0881009", "target": "#nkr_note_mod_0881009", "type": "mod", "text": "莂【大】，別【宋】"}
{"id": null, "n": "0881010", "target": "#nkr_note_mod_0881010", "type": "mod", "text": "受【大】，授【宋】【元】【明】"}
{"id": null, "n": "0881011", "target": "#nkr_note_mod_0881011", "type": "mod", "text": "（八大菩薩讚…器）二百十五字【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0881013", "target": "#nkr_note_mod_0881013", "type": "mod", "text": "襄【大】，曩【宋】【元】"}
{"id": null, "n": "0881014", "target": "#nkr_note_mod_0881014", "type": "mod", "text": "二【大】，一【宋】【元】"}
{"id": null, "n": "0881015", "target": "#nkr_note_mod_0881015", "type": "mod", "text": "三【大】，修三【宋】【元】"}
{"id": null, "n": "0880001", "target": "#nkr_note_orig_0880001", "type": "orig", "text": "梵名. Bhadracarīpraṇidhāna."}
{"id": null, "n": "0880002", "target": "#nkr_note_orig_0880002", "type": "orig", "text": "讚＋（六十二頌頌別四句每句七字除題目外計有一千七百三十六字）二十六字夾註【三】，〔頌〕夾註－【宋】"}
{"id": null, "n": "0880003", "target": "#nkr_note_orig_0880003", "type": "orig", "text": "宋本元本共作特進試鴻臚卿大興善寺三藏沙日大廣智不空奉詔譯二十二字，特字上明本有唐字而無大興善寺四字"}
{"id": null, "n": "0880004", "target": "#nkr_note_orig_0880004", "type": "orig", "text": "大供＝供養【三】"}
{"id": null, "n": "0880005", "target": "#nkr_note_orig_0880005", "type": "orig", "text": "今＝皆【三】"}
{"id": null, "n": "0880006", "target": "#nkr_note_orig_0880006", "type": "orig", "text": "唯＝惟【三】"}
{"id": null, "n": "0880007", "target": "#nkr_note_orig_0880007", "type": "orig", "text": "生中＝眾中【元】【明】"}
{"id": null, "n": "0880008", "target": "#nkr_note_orig_0880008", "type": "orig", "text": "常得咸＝咸得常【明】"}
{"id": null, "n": "0880009", "target": "#nkr_note_orig_0880009", "type": "orig", "text": "般若方便定解脫. Prajñā-upāya-samāddhi-vimokṣa."}
{"id": null, "n": "0880010", "target": "#nkr_note_orig_0880010", "type": "orig", "text": "量＝盡【三】"}
{"id": null, "n": "0880011", "target": "#nkr_note_orig_0880011", "type": "orig", "text": "今＝令【宋】【元】"}
{"id": null, "n": "0880012", "target": "#nkr_note_orig_0880012", "type": "orig", "text": "Māra."}
{"id": null, "n": "0880013", "target": "#nkr_note_orig_0880013", "type": "orig", "text": "得＝德【三】"}
{"id": null, "n": "0881001", "target": "#nkr_note_orig_0881001", "type": "orig", "text": "普賢. Samantatabhadra."}
{"id": null, "n": "0881002", "target": "#nkr_note_orig_0881002", "type": "orig", "text": "Mañjuśirī."}
{"id": null, "n": "0881003", "target": "#nkr_note_orig_0881003", "type": "orig", "text": "須＝修【三】"}
{"id": null, "n": "0881004", "target": "#nkr_note_orig_0881004", "type": "orig", "text": "求＝生【明】"}
{"id": null, "n": "0881005", "target": "#nkr_note_orig_0881005", "type": "orig", "text": "已＝以【元】【明】"}
{"id": null, "n": "0881006", "target": "#nkr_note_orig_0881006", "type": "orig", "text": "無量光. Amitābha."}
{"id": null, "n": "0881007", "target": "#nkr_note_orig_0881007", "type": "orig", "text": "極樂. Sukhāvatī."}
{"id": null, "n": "0881008", "target": "#nkr_note_orig_0881008", "type": "orig", "text": "受＝授【宋】【元】"}
{"id": null, "n": "0881009", "target": "#nkr_note_orig_0881009", "type": "orig", "text": "莂＝別【宋】"}
{"id": null, "n": "0881010", "target": "#nkr_note_orig_0881010", "type": "orig", "text": "受＝授【三】"}
{"id": null, "n": "0881011", "target": "#nkr_note_orig_0881011", "type": "orig", "text": "〔八大菩薩讚…器〕二百十五字－【三】"}
{"id": null, "n": "0881012", "target": "#nkr_note_orig_0881012", "type": "orig", "text": "此陀羅尼及功能依三本載今以宋本元本對校明本"}
{"id": null, "n": "0881013", "target": "#nkr_note_orig_0881013", "type": "orig", "text": "襄＝曩【宋】【元】"}
{"id": null, "n": "0881014", "target": "#nkr_note_orig_0881014", "type": "orig", "text": "二＝一【宋】【元】"}
{"id": null, "n": "0881015", "target": "#nkr_note_orig_0881015", "type": "orig", "text": "（修）＋三【宋】【元】"}
