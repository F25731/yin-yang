{"id": null, "n": "0410009", "target": "#nkr_note_mod_0410009", "type": "mod", "text": "（舍頭…經）十五字【大】，（舍頭諫經四字）四字【宋】【元】【明】，【原】麗本"}
{"id": null, "n": "0410010", "target": "#nkr_note_mod_0410010", "type": "mod", "text": "（西晉…譯）八字【大】，晉永嘉年三藏竺法護譯【宋】【元】"}
{"id": null, "n": "0410011", "target": "#nkr_note_mod_0410011", "type": "mod", "text": "呪【大】下同，祝【宋】下同【元】下同【明】下同"}
{"id": null, "n": "0410012", "target": "#nkr_note_mod_0410012", "type": "mod", "text": "晉曰【大】＊，此言【明】＊"}
{"id": null, "n": "0410013", "target": "#nkr_note_mod_0410013", "type": "mod", "text": "唯【大】下同，惟【宋】下同【元】下同【明】下同"}
{"id": null, "n": "0410014", "target": "#nkr_note_mod_0410014", "type": "mod", "text": "呪【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0410015", "target": "#nkr_note_mod_0410015", "type": "mod", "text": "而歎【大】，散而【宋】【元】【明】"}
{"id": null, "n": "0410016", "target": "#nkr_note_mod_0410016", "type": "mod", "text": "門【大】，閉【宋】【元】【明】"}
{"id": null, "n": "0410017", "target": "#nkr_note_mod_0410017", "type": "mod", "text": "伽耶【大】，迦邪【宋】【元】【明】"}
{"id": null, "n": "0410018", "target": "#nkr_note_mod_0410018", "type": "mod", "text": "揵【大】，犍【宋】【元】【明】"}
{"id": null, "n": "0410019", "target": "#nkr_note_mod_0410019", "type": "mod", "text": "唐突【大】，搪揬【宋】【元】【明】"}
{"id": null, "n": "0410020", "target": "#nkr_note_mod_0410020", "type": "mod", "text": "已今【大】，今已【宋】【元】【明】"}
{"id": null, "n": "0411001", "target": "#nkr_note_mod_0411001", "type": "mod", "text": "抵【大】＊，氐【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0411002", "target": "#nkr_note_mod_0411002", "type": "mod", "text": "煌灼【大】，惶灼【宋】"}
{"id": null, "n": "0411003", "target": "#nkr_note_mod_0411003", "type": "mod", "text": "曜【大】，曜【宋】【元】"}
{"id": null, "n": "0411004", "target": "#nkr_note_mod_0411004", "type": "mod", "text": "反【大】下同，返【宋】下同【元】下同【明】下同"}
{"id": null, "n": "0411005", "target": "#nkr_note_mod_0411005", "type": "mod", "text": "習【大】，集【宋】【元】【明】"}
