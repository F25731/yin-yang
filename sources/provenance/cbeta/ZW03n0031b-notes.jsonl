{"id": null, "n": "0414002", "target": "#nkr_note_orig_0414002", "type": "orig", "text": "「猶」，底本作「由」，據北245號改。"}
{"id": null, "n": "0414003", "target": "#nkr_note_orig_0414003", "type": "orig", "text": "「如」，底本無，據北245號補。"}
{"id": null, "n": "0414004", "target": "#nkr_note_orig_0414004", "type": "orig", "text": "「三念」，底本殘缺，據文意補。"}
{"id": null, "n": "0414005", "target": "#nkr_note_orig_0414005", "type": "orig", "text": "「萬」，底本作「方」，據文意改。"}
{"id": null, "n": "0414006", "target": "#nkr_note_orig_0414006", "type": "orig", "text": "「一一發長」，底本作「一一發長，一一發長」，據文意刪。"}
{"id": null, "n": "0414007", "target": "#nkr_note_orig_0414007", "type": "orig", "text": "「五寸，猶如黑絲」，底本殘缺，據北245號補。"}
{"id": null, "n": "0414008", "target": "#nkr_note_orig_0414008", "type": "orig", "text": "「旋」，底本無，據北245號補。"}
{"id": null, "n": "0415001", "target": "#nkr_note_orig_0415001", "type": "orig", "text": "「稠稀」，甲本作「稀稠」。"}
{"id": null, "n": "0415002", "target": "#nkr_note_orig_0415002", "type": "orig", "text": "「紫紺」，甲本作「紫艷紫紺」。"}
{"id": null, "n": "0415003", "target": "#nkr_note_orig_0415003", "type": "orig", "text": "「猶」，甲本作「由」。"}
{"id": null, "n": "0415004", "target": "#nkr_note_orig_0415004", "type": "orig", "text": "「上」，甲本作「皆上」。"}
{"id": null, "n": "0415005", "target": "#nkr_note_orig_0415005", "type": "orig", "text": "「生」，底本無，據甲本補。"}
{"id": null, "n": "0415006", "target": "#nkr_note_orig_0415006", "type": "orig", "text": "「相」，底本無，據甲本補。"}
{"id": null, "n": "0416001", "target": "#nkr_note_orig_0416001", "type": "orig", "text": "「欠」，甲本作「肷」。"}
{"id": null, "n": "0416002", "target": "#nkr_note_orig_0416002", "type": "orig", "text": "「出」，底本無，據甲本補。"}
{"id": null, "n": "0416003", "target": "#nkr_note_orig_0416003", "type": "orig", "text": "「光」，甲本無。"}
{"id": null, "n": "0416004", "target": "#nkr_note_orig_0416004", "type": "orig", "text": "「猶」，甲本作「由」。"}
{"id": null, "n": "0416005", "target": "#nkr_note_orig_0416005", "type": "orig", "text": "「影」，甲本作「映」。"}
{"id": null, "n": "0416006", "target": "#nkr_note_orig_0416006", "type": "orig", "text": "「碧」，甲本作「碧色」。"}
{"id": null, "n": "0416007", "target": "#nkr_note_orig_0416007", "type": "orig", "text": "「影」，甲本作「映」。"}
{"id": null, "n": "0416008", "target": "#nkr_note_orig_0416008", "type": "orig", "text": "「有」，底本無，據甲本補。"}
{"id": null, "n": "0417001", "target": "#nkr_note_orig_0417001", "type": "orig", "text": "「葉」，底本無，據甲本補。"}
{"id": null, "n": "0417002", "target": "#nkr_note_orig_0417002", "type": "orig", "text": "「覆」，底本作「霞」，據甲本改。"}
{"id": null, "n": "0417003", "target": "#nkr_note_orig_0417003", "type": "orig", "text": "「舌」，底本作「射」，據文意改。"}
{"id": null, "n": "0417004", "target": "#nkr_note_orig_0417004", "type": "orig", "text": "「影」，甲本作「映」。"}
{"id": null, "n": "0417005", "target": "#nkr_note_orig_0417005", "type": "orig", "text": "「佛」，底本無，據甲本補。"}
{"id": null, "n": "0417006", "target": "#nkr_note_orig_0417006", "type": "orig", "text": "「猶」，甲本作「由」。"}
{"id": null, "n": "0417007", "target": "#nkr_note_orig_0417007", "type": "orig", "text": "「金剛臺」，甲本無。"}
{"id": null, "n": "0417008", "target": "#nkr_note_orig_0417008", "type": "orig", "text": "「二光」，甲本作「二種光」。"}
{"id": null, "n": "0417009", "target": "#nkr_note_orig_0417009", "type": "orig", "text": "「猶」，甲本作「由」。"}
{"id": null, "n": "0417010", "target": "#nkr_note_orig_0417010", "type": "orig", "text": "「處」，甲本作「寶」。"}
{"id": null, "n": "0418001", "target": "#nkr_note_orig_0418001", "type": "orig", "text": "「見」，甲本作「現」。"}
{"id": null, "n": "0418002", "target": "#nkr_note_orig_0418002", "type": "orig", "text": "「宮」，底本作「官」，據甲本改。"}
{"id": null, "n": "0418003", "target": "#nkr_note_orig_0418003", "type": "orig", "text": "「佛手內外握」，甲本無。"}
{"id": null, "n": "0418004", "target": "#nkr_note_orig_0418004", "type": "orig", "text": "「厚」，底本無，據北8299號補。"}
{"id": null, "n": "0418005", "target": "#nkr_note_orig_0418005", "type": "orig", "text": "「佛上身胸臆廣厚如師子王」，甲本無。"}
{"id": null, "n": "0418006", "target": "#nkr_note_orig_0418006", "type": "orig", "text": "「尼」，甲本無。"}
{"id": null, "n": "0419001", "target": "#nkr_note_orig_0419001", "type": "orig", "text": "「如來脅肋大小正等，婉轉相著」，甲本無。"}
{"id": null, "n": "0419002", "target": "#nkr_note_orig_0419002", "type": "orig", "text": "「如來諸骨枝節蟠龍相結，其間密緻」，甲本無。"}
{"id": null, "n": "0419003", "target": "#nkr_note_orig_0419003", "type": "orig", "text": "「液」，底本作「亦」，據北8299號改。"}
{"id": null, "n": "0419004", "target": "#nkr_note_orig_0419004", "type": "orig", "text": "「脂」，底本作「之」，據北8299號改。"}
{"id": null, "n": "0419005", "target": "#nkr_note_orig_0419005", "type": "orig", "text": "「出」，甲本無。"}
{"id": null, "n": "0419006", "target": "#nkr_note_orig_0419006", "type": "orig", "text": "「猶」，甲本作「由」。"}
{"id": null, "n": "0419007", "target": "#nkr_note_orig_0419007", "type": "orig", "text": "「猶」，甲本作「由」。"}
{"id": null, "n": "0419008", "target": "#nkr_note_orig_0419008", "type": "orig", "text": "「見」，甲本作「現」。"}
{"id": null, "n": "0419009", "target": "#nkr_note_orig_0419009", "type": "orig", "text": "「佛足高平相」，甲本作「佛兩足膊高平相」，並置於「佛兩足踝不見相」前。"}
{"id": null, "n": "0420001", "target": "#nkr_note_orig_0420001", "type": "orig", "text": "「如」，底本無，據甲本補。"}
{"id": null, "n": "0420002", "target": "#nkr_note_orig_0420002", "type": "orig", "text": "「剛」，底本作「則」，據甲本改。"}
{"id": null, "n": "0420003", "target": "#nkr_note_orig_0420003", "type": "orig", "text": "「坐」，甲本作「坐坐」。"}
{"id": null, "n": "0420004", "target": "#nkr_note_orig_0420004", "type": "orig", "text": "「看」，底本無，據甲本補。"}
{"id": null, "n": "0420005", "target": "#nkr_note_orig_0420005", "type": "orig", "text": "「在」，底本作「左」，據文意改。"}
{"id": null, "n": "0420006", "target": "#nkr_note_orig_0420006", "type": "orig", "text": "「項光」，底本無，據甲本補。"}
{"id": null, "n": "0421001", "target": "#nkr_note_orig_0421001", "type": "orig", "text": "「略」，底本作「毗」，據甲本改。"}
{"id": null, "n": "0421002", "target": "#nkr_note_orig_0421002", "type": "orig", "text": "「會大眾」，甲本作「大眾會」。"}
{"id": null, "n": "0421003", "target": "#nkr_note_orig_0421003", "type": "orig", "text": "「種」，底本無，據甲本補。"}
{"id": null, "n": "0421004", "target": "#nkr_note_orig_0421004", "type": "orig", "text": "「說」，甲本無。"}
{"id": null, "n": "0421005", "target": "#nkr_note_orig_0421005", "type": "orig", "text": "「實」，甲本作「寶」。"}
{"id": null, "n": "0421006", "target": "#nkr_note_orig_0421006", "type": "orig", "text": "「尊」，甲本作「等」。"}
{"id": null, "n": "0421007", "target": "#nkr_note_orig_0421007", "type": "orig", "text": "「部」，底本無，據甲本補。"}
{"id": null, "n": "0421008", "target": "#nkr_note_orig_0421008", "type": "orig", "text": "「能」，底本作「有能」，據甲本刪。"}
{"id": null, "n": "0421009", "target": "#nkr_note_orig_0421009", "type": "orig", "text": "「陀」，底本作「馱」，據文意改。"}
{"id": null, "n": "0421010", "target": "#nkr_note_orig_0421010", "type": "orig", "text": "本錄文尾題甲本作「佛相好經一卷」。"}
{"id": null, "n": "0421011", "target": "#nkr_note_orig_0421011", "type": "orig", "text": "底本卷尾有題記一則，為「清信佛弟子敦煌郡司法參軍馮如皂在住所自寫記之」。"}
{"id": null, "n": "0419a1301", "target": "#nkr_note_add_0419a1301", "type": "add", "text": "三念佛【CB】，三念佛【藏外】"}
{"id": null, "n": null, "target": null, "type": null, "text": "三念佛"}
