{"id": null, "n": null, "target": null, "type": null, "text": "清師"}
{"id": null, "n": null, "target": null, "type": null, "text": "見《南北史》。"}
{"id": null, "n": null, "target": null, "type": null, "text": "劉知過著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "董楷錄。臨海人，寓天台。"}
{"id": null, "n": null, "target": null, "type": null, "text": "黃宜著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "徐大受著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "周伯煥著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "徐一夔著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "曹文晦著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "俱陶宗儀著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "桑澤卿著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "杜甯著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "夏塤著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "魯穆著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "杜甯著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "范理著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "潘禎著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "龐泮著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "夏鍭著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "王𦙍東著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "陸淞著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "曹祺著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "賈蒙著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "奚國賢著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "許嗣著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "朱文中著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "朱思平著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "曹宜約著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "曹筠軒著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "夏塤著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "楊澤著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "范理著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "陳宏著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "朱雪著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "俱潘球著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "潘淵著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "貢士裘致中妻著，自號碧天道人。"}
{"id": null, "n": null, "target": null, "type": null, "text": "葛玄授從孫洪。"}
{"id": null, "n": null, "target": null, "type": null, "text": "陶弘景隱台東閬風里（屬甯海）。"}
{"id": null, "n": null, "target": null, "type": null, "text": "陶弘景撰。"}
{"id": null, "n": null, "target": null, "type": null, "text": "吳筠撰。"}
{"id": null, "n": null, "target": null, "type": null, "text": "司馬\n承禎著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "同上。吳立夫序，見吳集及《文章辯體》"}
{"id": null, "n": null, "target": null, "type": null, "text": "徐靈府著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "閭丘方遠。"}
{"id": null, "n": null, "target": null, "type": null, "text": "杜光庭著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "俱張伯端著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "王茂端著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "祝通玄撰。"}
{"id": null, "n": null, "target": null, "type": null, "text": "王中立著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "見《崇文總目》附。"}
{"id": null, "n": null, "target": null, "type": null, "text": "王佺著。佺，松門人，少瞽，遇華頂異人以祿命，馳聲江湖八十餘年，刻期而化。"}
{"id": null, "n": null, "target": null, "type": null, "text": "王良明著。臨海人，嘗至天姥寺，遇白衣僊致書，尋化為鶴，醫道遂通神。"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐僧神邕著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "陳耆卿修。"}
{"id": null, "n": null, "target": null, "type": null, "text": "宋之瑞著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "陳𥿈、陳木修。"}
{"id": null, "n": null, "target": null, "type": null, "text": "潘瑊輯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "龐櫟輯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "王士性著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "曹宜約著。"}
{"id": null, "n": null, "target": null, "type": null, "text": "王亮撰。"}
{"id": null, "n": null, "target": null, "type": null, "text": "邑令李素輯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "不知修者姓氏。《圖經》所引。今亡。"}
