{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "其次題目本文開章"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "第八門竟，後有所詮義理矣。二門成中下二卷，畢十門。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "畢"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T36n1736_p0195b28"}
{"id": null, "n": "0186001", "target": "#nkr_note_orig_0186001", "type": "orig", "text": "階此疏第三初并纂釋作附字"}
{"id": null, "n": "0189001", "target": "#nkr_note_orig_0189001", "type": "orig", "text": "外疑內"}
{"id": null, "n": "0189002", "target": "#nkr_note_orig_0189002", "type": "orig", "text": "終疑同"}
{"id": null, "n": "0192001", "target": "#nkr_note_orig_0192001", "type": "orig", "text": "故一作也"}
{"id": null, "n": "0203001", "target": "#nkr_note_orig_0203001", "type": "orig", "text": "之一作攝"}
{"id": null, "n": "0205001", "target": "#nkr_note_orig_0205001", "type": "orig", "text": "各一作則"}
{"id": null, "n": "0206001", "target": "#nkr_note_orig_0206001", "type": "orig", "text": "作等六字或本作法華經同教者是"}
{"id": null, "n": "0206002", "target": "#nkr_note_orig_0206002", "type": "orig", "text": "觀一作覩"}
{"id": null, "n": "0207001", "target": "#nkr_note_orig_0207001", "type": "orig", "text": "聖一作勝"}
{"id": null, "n": "0207002", "target": "#nkr_note_orig_0207002", "type": "orig", "text": "准下一有前字或之字"}
{"id": null, "n": "0208001", "target": "#nkr_note_orig_0208001", "type": "orig", "text": "偏疑徧"}
{"id": null, "n": "0213001", "target": "#nkr_note_orig_0213001", "type": "orig", "text": "曾疑憎"}
{"id": null, "n": "0215001", "target": "#nkr_note_orig_0215001", "type": "orig", "text": "步字更勘"}
{"id": null, "n": "0215002", "target": "#nkr_note_orig_0215002", "type": "orig", "text": "慧疑思"}
{"id": null, "n": "0216001", "target": "#nkr_note_orig_0216001", "type": "orig", "text": "訖下釋作說"}
{"id": null, "n": "0216002", "target": "#nkr_note_orig_0216002", "type": "orig", "text": "備下疑脫三中云云"}
{"id": null, "n": "0217001", "target": "#nkr_note_orig_0217001", "type": "orig", "text": "生上疑脫離字"}
{"id": null, "n": "0218001", "target": "#nkr_note_orig_0218001", "type": "orig", "text": "智字下疑衍"}
{"id": null, "n": "0218002", "target": "#nkr_note_orig_0218002", "type": "orig", "text": "此上入故字見"}
{"id": null, "n": "0220001", "target": "#nkr_note_orig_0220001", "type": "orig", "text": "舍疑含"}
{"id": null, "n": "0221001", "target": "#nkr_note_orig_0221001", "type": "orig", "text": "千疑于"}
{"id": null, "n": "0222001", "target": "#nkr_note_orig_0222001", "type": "orig", "text": "梵或作逝"}
{"id": null, "n": "0222002", "target": "#nkr_note_orig_0222002", "type": "orig", "text": "經疑結"}
{"id": null, "n": "0227001", "target": "#nkr_note_orig_0227001", "type": "orig", "text": "為一作有"}
{"id": null, "n": "0227002", "target": "#nkr_note_orig_0227002", "type": "orig", "text": "似一作假"}
{"id": null, "n": "0228001", "target": "#nkr_note_orig_0228001", "type": "orig", "text": "割一作部"}
{"id": null, "n": "0228002", "target": "#nkr_note_orig_0228002", "type": "orig", "text": "違疑遠"}
{"id": null, "n": "0228003", "target": "#nkr_note_orig_0228003", "type": "orig", "text": "主疑三更勘"}
{"id": null, "n": "0228004", "target": "#nkr_note_orig_0228004", "type": "orig", "text": "知與智通"}
{"id": null, "n": "0228005", "target": "#nkr_note_orig_0228005", "type": "orig", "text": "本疑木"}
{"id": null, "n": "0229001", "target": "#nkr_note_orig_0229001", "type": "orig", "text": "如處二字疑衍"}
{"id": null, "n": "0229002", "target": "#nkr_note_orig_0229002", "type": "orig", "text": "使疑便下同"}
{"id": null, "n": "0231001", "target": "#nkr_note_orig_0231001", "type": "orig", "text": "議徹一作緣微"}
{"id": null, "n": "0233001", "target": "#nkr_note_orig_0233001", "type": "orig", "text": "耶一作也"}
{"id": null, "n": "0233002", "target": "#nkr_note_orig_0233002", "type": "orig", "text": "體下一有亦字"}
{"id": null, "n": "0234001", "target": "#nkr_note_orig_0234001", "type": "orig", "text": "耶一作也"}
{"id": null, "n": "0235001", "target": "#nkr_note_orig_0235001", "type": "orig", "text": "經疑註"}
{"id": null, "n": "0238001", "target": "#nkr_note_orig_0238001", "type": "orig", "text": "無疑乘"}
{"id": null, "n": "0241001", "target": "#nkr_note_orig_0241001", "type": "orig", "text": "他下一有故字"}
{"id": null, "n": "0241002", "target": "#nkr_note_orig_0241002", "type": "orig", "text": "此下一有即字"}
{"id": null, "n": "0242001", "target": "#nkr_note_orig_0242001", "type": "orig", "text": "則疑即"}
{"id": null, "n": "0243001", "target": "#nkr_note_orig_0243001", "type": "orig", "text": "巳一作亡"}
{"id": null, "n": "0244001", "target": "#nkr_note_orig_0244001", "type": "orig", "text": "想疑總"}
{"id": null, "n": "0246001", "target": "#nkr_note_orig_0246001", "type": "orig", "text": "節上一有時字"}
{"id": null, "n": "0246002", "target": "#nkr_note_orig_0246002", "type": "orig", "text": "起下一有全字"}
{"id": null, "n": "0250001", "target": "#nkr_note_orig_0250001", "type": "orig", "text": "即一作印"}
{"id": null, "n": "0250002", "target": "#nkr_note_orig_0250002", "type": "orig", "text": "合一作令"}
{"id": null, "n": "0250003", "target": "#nkr_note_orig_0250003", "type": "orig", "text": "義下一有門字"}
{"id": null, "n": "0250004", "target": "#nkr_note_orig_0250004", "type": "orig", "text": "視疑觀次同"}
{"id": null, "n": "0250005", "target": "#nkr_note_orig_0250005", "type": "orig", "text": "下下一有七字"}
{"id": null, "n": "0256001", "target": "#nkr_note_orig_0256001", "type": "orig", "text": "偏疑徧下同"}
{"id": null, "n": "0256002", "target": "#nkr_note_orig_0256002", "type": "orig", "text": "識疑議"}
{"id": null, "n": "0256003", "target": "#nkr_note_orig_0256003", "type": "orig", "text": "偈疑遇"}
