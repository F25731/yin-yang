{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "音原，為也，於也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音岳。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音直，小槖也，書衣也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音部草名。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音鎸，鑽也。尖□，錐也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音因安和㒵悅㒵。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音□，毛布。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音作，穿也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音󴖥，沮類也，又鑽上聲。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音臣，\n草名也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音石，天也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音墾，悲也，誠也，信也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音士，水涯也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音帚，臂節也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音浪。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音遠，養禽獸園也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音矮，推也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音雜，逼〡也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音撇，目〡也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音勝，\n不啻也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音肴，言不恭謹也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音囮，謬也，舛也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音利。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音吻，割也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "勤經二音。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音說〡湲流㒵。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音獨〡婁頭也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音婁，髑婁也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音願，玉名也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音致，凝也，\n淹也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音斤，肉之力。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音皮，乏也，勞也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音活，鼎〡也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音魚，樂也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音徹，挽也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音焚。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音習，下濕也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音淡。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音貴，魚膾細切肉也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音鄂，花鄂也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音袍"}
{"id": null, "n": null, "target": null, "type": null, "text": "音迷，牛迷也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音辨。覊，〡也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音別，俗鼈也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音卓，鳥食也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音掉。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音摺，剝也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音𢍉，澤鄣也，池也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音滂，雪盛㒵。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音欠，謫問也，責也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音救。〡，馬\n舍也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音罩，篱也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音恊，身左右腋下也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音旦，大也。天子生曰降旦。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音貳，食也，餅也，\n餻也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音零。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音惡，口中上惡也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音乞，治也，問罪也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音式，車前𨋩，又兵車也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音基。皇帝居其水以為姓。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音葦。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音結，攻人之陰私也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音悟，相觸也，逆也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音煩，茲也，息也。又音番，屏也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音聶，踐也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音窮，竹名為杖。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音逡，皵也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音軍，足折\n裂也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音米，息也，忘也，止也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音委，葭也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音示，謙行之號，又音益笑㒵。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音鐸，補鐸，\n被衣裳也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音五，村五也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音褲，󴖫衣也。亦作。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音威。迱也。行㒵。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音以，邐也，又音\n移。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音蘊，大風也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音啾，水多，又音秋。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音霍，水竭也，盡也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音講。〡褓，負兒\n衣也。織縷為之，廣八寸，長二尺，以負兒於背，二也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音保，小兒衣也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音褶，車行迹也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音凶。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音編〡蝠，亦名蠟䘃，亦名仙鼠，又名服翼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音幅，蝙〡也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音被，仆也，斃也，止也，\n敗也，壞也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音轟，王逝也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音到，惧也。儀禮云：七，一曰悼也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音雜。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音交，齧也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音支，黑色也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音密，靜也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音束，光動也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音節。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音廬。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音移，玄□也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音痴。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音縛。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音襪。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音爛。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音那，上聲，美㒵。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音模，議謀也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音肴，饌也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音業，妖也。又姓也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音絹，佳也。係，取也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音乞，壁孔也，裂也，門也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音泣，明也，聖也，\n\n智也，與睿同。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音略，利也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音婆。豫章有鄱陽縣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音离旬傳有谷离主谷又音鹿。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音巨，鷄距也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "醋昨二音。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音畾，累也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音長。詩曰：隰有長楚，蔓生如桃。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音由。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音連，香車也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音迍，真也，正也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音衠，誡衠正也。"}
