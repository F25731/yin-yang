{"id": null, "n": null, "target": null, "type": null, "text": "於上藥中用者是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此云婆羅門參"}
{"id": null, "n": "0325006", "target": null, "type": "orig", "text": "門＋（大廣智）【明】【乙】"}
{"id": null, "n": "0325006", "target": null, "type": "mod", "text": "門【大】，門大廣智【明】【乙】"}
{"id": null, "n": "0329005", "target": null, "type": "orig", "text": "（灰）＋火【乙】"}
{"id": null, "n": "0329005", "target": null, "type": "mod", "text": "火【大】，灰火【乙】"}
{"id": null, "n": "0329009", "target": null, "type": "orig", "text": "此下乙本奧書曰貞享四年中春十九日校之點之淨嚴四十九歲，元祿十六年二月十六日以淨嚴和尚之本再校了，寶永三丙之春得此軌戊子十月二十二日三更一校了性寂"}
{"id": null, "n": "0325002", "target": "#nkr_note_mod_0325002", "type": "mod", "text": "菩薩【大】，〔－〕【甲】"}
{"id": null, "n": "0325003", "target": "#nkr_note_mod_0325003", "type": "mod", "text": "經【大】，〔－〕【明】【甲】【乙】"}
{"id": null, "n": "0325004", "target": "#nkr_note_mod_0325004", "type": "mod", "text": "一卷【大】，〔－〕【明】【甲】【乙】"}
{"id": null, "n": "0325005", "target": "#nkr_note_mod_0325005", "type": "mod", "text": "開府儀同三司特進試鴻臚卿肅國公食邑三千戶賜紫贈司空諡大鑒正號大廣智大興善寺三藏沙門不空奉詔譯【大】，〔－〕【甲】，唐北天竺三藏沙門不空奉詔譯【明】【乙】"}
{"id": null, "n": "0325006", "target": "#nkr_note_mod_0325006", "type": "mod", "text": "門【大】，門大廣智【明】【乙】"}
{"id": null, "n": "0325007", "target": "#nkr_note_mod_0325007", "type": "mod", "text": "傍【大】，旁【明】【乙】"}
{"id": null, "n": "0325008", "target": "#nkr_note_mod_0325008", "type": "mod", "text": "唯【大】，惟【明】【甲】【乙】"}
{"id": null, "n": "0325009", "target": "#nkr_note_mod_0325009", "type": "mod", "text": "其【大】，甚【明】【甲】"}
{"id": null, "n": "0325010", "target": "#nkr_note_mod_0325010", "type": "mod", "text": "莫【大】，謨【明】"}
{"id": null, "n": "0325011", "target": "#nkr_note_mod_0325011", "type": "mod", "text": "合【大】，合引【明】【乙】"}
{"id": null, "n": "0326001", "target": "#nkr_note_mod_0326001", "type": "mod", "text": "野【大】，〔－〕【明】"}
{"id": null, "n": "0326002", "target": "#nkr_note_mod_0326002", "type": "mod", "text": "摩【大】，麼【明】【乙】"}
{"id": null, "n": "0326003", "target": "#nkr_note_mod_0326003", "type": "mod", "text": "末【大】，粖【明】【甲】【乙】"}
{"id": null, "n": "0326004", "target": "#nkr_note_mod_0326004", "type": "mod", "text": "悉【大】＊，息【明】【乙】＊"}
{"id": null, "n": "0326005", "target": "#nkr_note_mod_0326005", "type": "mod", "text": "帖【大】，貼【明】【乙】"}
{"id": null, "n": "0326006", "target": "#nkr_note_mod_0326006", "type": "mod", "text": "枚【大】，〔－〕【甲】"}
{"id": null, "n": "0326007", "target": "#nkr_note_mod_0326007", "type": "mod", "text": "遍【大】，〔－〕【甲】"}
{"id": null, "n": "0326008", "target": "#nkr_note_mod_0326008", "type": "mod", "text": "鳥【大】，烏【明】【乙】"}
{"id": null, "n": "0326009", "target": "#nkr_note_mod_0326009", "type": "mod", "text": "狂【大】，住【明】"}
{"id": null, "n": "0326010", "target": "#nkr_note_mod_0326010", "type": "mod", "text": "順【大】，愛【甲】"}
{"id": null, "n": "0326011", "target": "#nkr_note_mod_0326011", "type": "mod", "text": "瘥【大】，差【乙】"}
{"id": null, "n": "0326012", "target": "#nkr_note_mod_0326012", "type": "mod", "text": "取【大】，即【明】"}
{"id": null, "n": "0326013", "target": "#nkr_note_mod_0326013", "type": "mod", "text": "被【大】，彼【明】"}
{"id": null, "n": "0326014", "target": "#nkr_note_mod_0326014", "type": "mod", "text": "遙【大】，搖【明】"}
{"id": null, "n": "0326015", "target": "#nkr_note_mod_0326015", "type": "mod", "text": "破【大】，即破【乙】"}
{"id": null, "n": "0326016", "target": "#nkr_note_mod_0326016", "type": "mod", "text": "取【大】，〔－〕【甲】"}
{"id": null, "n": "0326017", "target": "#nkr_note_mod_0326017", "type": "mod", "text": "練【大】，棟【明】【乙】"}
{"id": null, "n": "0326018", "target": "#nkr_note_mod_0326018", "type": "mod", "text": "即【大】，〔－〕【甲】"}
{"id": null, "n": "0326019", "target": "#nkr_note_mod_0326019", "type": "mod", "text": "億【大】，倍【明】【甲】【乙】"}
{"id": null, "n": "0326020", "target": "#nkr_note_mod_0326020", "type": "mod", "text": "屋【大】，窟【甲】"}
{"id": null, "n": "0326021", "target": "#nkr_note_mod_0326021", "type": "mod", "text": "也【大】，〔－〕【甲】"}
{"id": null, "n": "0326022", "target": "#nkr_note_mod_0326022", "type": "mod", "text": "應【大】，集【甲】"}
{"id": null, "n": "0326023", "target": "#nkr_note_mod_0326023", "type": "mod", "text": "上【大】，上即【明】【甲】【乙】"}
{"id": null, "n": "0326024", "target": "#nkr_note_mod_0326024", "type": "mod", "text": "銜【大】＊，㘅【明】【乙】＊"}
{"id": null, "n": "0326025", "target": "#nkr_note_mod_0326025", "type": "mod", "text": "即【大】，其被啃者毒即【乙】"}
{"id": null, "n": "0326026", "target": "#nkr_note_mod_0326026", "type": "mod", "text": "四【大】，凶【明】"}
{"id": null, "n": "0327001", "target": "#nkr_note_mod_0327001", "type": "mod", "text": "水【大】，水灑【考偽-乙】"}
{"id": null, "n": "0327002", "target": "#nkr_note_mod_0327002", "type": "mod", "text": "其【大】，〔－〕【明】"}
{"id": null, "n": "0327003", "target": "#nkr_note_mod_0327003", "type": "mod", "text": "花【大】，〔－〕【明】【甲】【乙】"}
{"id": null, "n": "0327004", "target": "#nkr_note_mod_0327004", "type": "mod", "text": "人【大】，仁【明】【乙】"}
{"id": null, "n": "0327005", "target": "#nkr_note_mod_0327005", "type": "mod", "text": "知【大】，和【明】【甲】【乙】"}
{"id": null, "n": "0327006", "target": "#nkr_note_mod_0327006", "type": "mod", "text": "持【大】，持令彼人互相憎【校異-乙】"}
{"id": null, "n": "0327007", "target": "#nkr_note_mod_0327007", "type": "mod", "text": "荳【大】，豆【明】【甲】【乙】"}
{"id": null, "n": "0327008", "target": "#nkr_note_mod_0327008", "type": "mod", "text": "成【大】，稱【明】"}
{"id": null, "n": "0327009", "target": "#nkr_note_mod_0327009", "type": "mod", "text": "香【大】，〔－〕【校異-乙】"}
{"id": null, "n": "0327010", "target": "#nkr_note_mod_0327010", "type": "mod", "text": "十【大】，〔－〕【校異-乙】"}
{"id": null, "n": "0327011", "target": "#nkr_note_mod_0327011", "type": "mod", "text": "（又法…愛）二十五字【大】，〔－〕【明】"}
