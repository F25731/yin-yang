{"id": null, "n": "0328003", "target": "#nkr_note_mod_0328003", "type": "mod", "text": "當【大】，〔－〕【甲】"}
{"id": null, "n": "0328004", "target": "#nkr_note_mod_0328004", "type": "mod", "text": "酥【大】，蘇【明】【甲】"}
{"id": null, "n": "0328005", "target": "#nkr_note_mod_0328005", "type": "mod", "text": "白【大】，〔－〕【明】"}
{"id": null, "n": "0328006", "target": "#nkr_note_mod_0328006", "type": "mod", "text": "灰【大】，火【明】"}
{"id": null, "n": "0328007", "target": "#nkr_note_mod_0328007", "type": "mod", "text": "也【大】，〔－〕【明】【甲】【乙】"}
{"id": null, "n": "0328008", "target": "#nkr_note_mod_0328008", "type": "mod", "text": "觸【大】，觸無【甲】"}
{"id": null, "n": "0328009", "target": "#nkr_note_mod_0328009", "type": "mod", "text": "翊【大】，翼【明】【乙】，〔－〕【甲】"}
