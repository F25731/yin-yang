{"id": null, "n": "0328022", "target": "#nkr_note_mod_0328022", "type": "mod", "text": "成【大】，成我【甲】"}
{"id": null, "n": "0328023", "target": "#nkr_note_mod_0328023", "type": "mod", "text": "此【大】，此印【甲】"}
{"id": null, "n": "0328024", "target": "#nkr_note_mod_0328024", "type": "mod", "text": "此即【大】，即此【明】"}
{"id": null, "n": "0328025", "target": "#nkr_note_mod_0328025", "type": "mod", "text": "入【大】，入掌【乙】"}
{"id": null, "n": "0329001", "target": "#nkr_note_mod_0329001", "type": "mod", "text": "上【大】，尚【明】【乙】"}
{"id": null, "n": "0329002", "target": "#nkr_note_mod_0329002", "type": "mod", "text": "鶘【大】，護【明】"}
{"id": null, "n": "0329003", "target": "#nkr_note_mod_0329003", "type": "mod", "text": "毛【大】，七【明】"}
