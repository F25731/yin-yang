{"id": null, "n": "0328017", "target": "#nkr_note_mod_0328017", "type": "mod", "text": "鳥【大】，烏【明】"}
{"id": null, "n": "0328018", "target": "#nkr_note_mod_0328018", "type": "mod", "text": "上毛【大】，身上【甲】，身上毛【乙】"}
{"id": null, "n": "0328019", "target": "#nkr_note_mod_0328019", "type": "mod", "text": "時【大】，日【考偽-乙】"}
