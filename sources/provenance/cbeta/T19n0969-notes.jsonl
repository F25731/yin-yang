{"id": null, "n": "0355010", "target": "#nkr_note_orig_0355010", "type": "orig", "text": "祺＝棋【宋】【明】"}
{"id": null, "n": "0355011", "target": "#nkr_note_orig_0355011", "type": "orig", "text": "掌＝常【明】"}
