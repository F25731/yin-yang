{"id": null, "n": "0355013", "target": "#nkr_note_orig_0355013", "type": "orig", "text": "土＝士【宋】【明】"}
{"id": null, "n": "0355014", "target": "#nkr_note_orig_0355014", "type": "orig", "text": "大唐＝唐中【宋】【明】"}
{"id": null, "n": "0355015", "target": "#nkr_note_orig_0355015", "type": "orig", "text": "藏＋（法明）【明】"}
{"id": null, "n": "0355016", "target": "#nkr_note_orig_0355016", "type": "orig", "text": "戰＝顫【宋】【明】"}
{"id": null, "n": "0356001", "target": "#nkr_note_orig_0356001", "type": "orig", "text": "發＝登【宋】【明】"}
{"id": null, "n": "0356002", "target": "#nkr_note_orig_0356002", "type": "orig", "text": "惟＝唯【宋】【明】＊"}
{"id": null, "n": "0356003", "target": "#nkr_note_orig_0356003", "type": "orig", "text": "坼＝拆【明】"}
{"id": null, "n": "0356004", "target": "#nkr_note_orig_0356004", "type": "orig", "text": "去＋（聲）【明】下同"}
{"id": null, "n": "0356005", "target": "#nkr_note_orig_0356005", "type": "orig", "text": "婆＝嘙【宋】【明】＊"}
{"id": null, "n": "0356006", "target": "#nkr_note_orig_0356006", "type": "orig", "text": "薩＝󰷍【宋】【明】＊"}
