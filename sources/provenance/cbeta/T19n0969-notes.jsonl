{"id": null, "n": "0356008", "target": "#nkr_note_orig_0356008", "type": "orig", "text": "阿＝啊【宋】【明】＊"}
{"id": null, "n": "0356009", "target": "#nkr_note_orig_0356009", "type": "orig", "text": "上＋（聲）夾註【明】"}
{"id": null, "n": "0356010", "target": "#nkr_note_orig_0356010", "type": "orig", "text": "十四上＝上十四【宋】【明】"}
{"id": null, "n": "0356011", "target": "#nkr_note_orig_0356011", "type": "orig", "text": "跋囉＝羅跋【明】"}
{"id": null, "n": "0356012", "target": "#nkr_note_orig_0356012", "type": "orig", "text": "曷＝喝【明】"}
{"id": null, "n": "0356013", "target": "#nkr_note_orig_0356013", "type": "orig", "text": "已＝七【宋】"}
{"id": null, "n": "0356014", "target": "#nkr_note_orig_0356014", "type": "orig", "text": "反＝切【明】下同"}
{"id": null, "n": "0356015", "target": "#nkr_note_orig_0356015", "type": "orig", "text": "符＝宿【明】"}
{"id": null, "n": "0356016", "target": "#nkr_note_orig_0356016", "type": "orig", "text": "呵＋（四十八）夾註【明】"}
{"id": null, "n": "0356017", "target": "#nkr_note_orig_0356017", "type": "orig", "text": "耀＝明【宋】【明】"}
{"id": null, "n": "0356018", "target": "#nkr_note_orig_0356018", "type": "orig", "text": "法＝天【宋】"}
{"id": null, "n": "0356019", "target": "#nkr_note_orig_0356019", "type": "orig", "text": "苦＝若【明】"}
{"id": null, "n": "0357001", "target": "#nkr_note_orig_0357001", "type": "orig", "text": "摩＝磨【宋】【明】"}
{"id": null, "n": "0357002", "target": "#nkr_note_orig_0357002", "type": "orig", "text": "令＝今【明】"}
{"id": null, "n": "0357003", "target": "#nkr_note_orig_0357003", "type": "orig", "text": "〔佛頂…經〕八字－【宋】"}
{"id": null, "n": "0357004", "target": "#nkr_note_orig_0357004", "type": "orig", "text": "以下明本無之"}
{"id": null, "n": "0357005", "target": "#nkr_note_orig_0357005", "type": "orig", "text": "此次行宋本有末題佛頂最勝陀羅尼經八字"}
