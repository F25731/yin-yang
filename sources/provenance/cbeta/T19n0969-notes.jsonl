{"id": null, "n": "0356016", "target": "#nkr_note_mod_0356016", "type": "mod", "text": "呵【大】，呵四十八【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "四十八"}
{"id": null, "n": "0356017", "target": "#nkr_note_mod_0356017", "type": "mod", "text": "耀【大】，明【宋】【明】"}
{"id": null, "n": "0356018", "target": "#nkr_note_mod_0356018", "type": "mod", "text": "法【大】，天【宋】"}
{"id": null, "n": "0356019", "target": "#nkr_note_mod_0356019", "type": "mod", "text": "苦【大】，若【明】"}
{"id": null, "n": "0357001", "target": "#nkr_note_mod_0357001", "type": "mod", "text": "摩【大】，磨【宋】【明】"}
{"id": null, "n": "0357002", "target": "#nkr_note_mod_0357002", "type": "mod", "text": "令【大】，今【明】"}
{"id": null, "n": "0357003", "target": "#nkr_note_mod_0357003", "type": "mod", "text": "（佛頂…經）八字【大】，〔－〕【宋】"}
{"id": null, "n": "0355003", "target": "#nkr_note_orig_0355003", "type": "orig", "text": "【原】麗本，此經增上寺元本闕"}
{"id": null, "n": "0355004", "target": "#nkr_note_orig_0355004", "type": "orig", "text": "（弘福寺）＋沙【明】"}
{"id": null, "n": "0355005", "target": "#nkr_note_orig_0355005", "type": "orig", "text": "序＝述【宋】【明】"}
{"id": null, "n": "0355006", "target": "#nkr_note_orig_0355006", "type": "orig", "text": "恍惚＝惚恍【宋】【明】"}
{"id": null, "n": "0355007", "target": "#nkr_note_orig_0355007", "type": "orig", "text": "介＝分【宋】，芥【明】"}
