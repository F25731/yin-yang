{"id": null, "n": "0355004", "target": "#nkr_note_mod_0355004", "type": "mod", "text": "沙【大】，弘福寺沙【明】"}
{"id": null, "n": "0355005", "target": "#nkr_note_mod_0355005", "type": "mod", "text": "序【大】，述【宋】【明】"}
{"id": null, "n": "0355006", "target": "#nkr_note_mod_0355006", "type": "mod", "text": "恍惚【大】，惚恍【宋】【明】"}
{"id": null, "n": "0355007", "target": "#nkr_note_mod_0355007", "type": "mod", "text": "介【大】，分【宋】，芥【明】"}
{"id": null, "n": "0355008", "target": "#nkr_note_mod_0355008", "type": "mod", "text": "揮【大】，撝【宋】【明】"}
{"id": null, "n": "0355009", "target": "#nkr_note_mod_0355009", "type": "mod", "text": "齬【大】，〔－〕【宋】【明】"}
{"id": null, "n": "0355010", "target": "#nkr_note_mod_0355010", "type": "mod", "text": "祺【大】，棋【宋】【明】"}
{"id": null, "n": "0355011", "target": "#nkr_note_mod_0355011", "type": "mod", "text": "掌【大】，常【明】"}
{"id": null, "n": "0355012", "target": "#nkr_note_mod_0355012", "type": "mod", "text": "便【大】，俗【明】"}
{"id": null, "n": "0355013", "target": "#nkr_note_mod_0355013", "type": "mod", "text": "土【大】，士【宋】【明】"}
{"id": null, "n": "0355014", "target": "#nkr_note_mod_0355014", "type": "mod", "text": "大唐【大】，唐中【宋】【明】"}
{"id": null, "n": "0355015", "target": "#nkr_note_mod_0355015", "type": "mod", "text": "藏【大】，藏法明【明】"}
{"id": null, "n": "0355016", "target": "#nkr_note_mod_0355016", "type": "mod", "text": "戰【大】，顫【宋】【明】"}
{"id": null, "n": "0356001", "target": "#nkr_note_mod_0356001", "type": "mod", "text": "發【大】，登【宋】【明】"}
{"id": null, "n": "0356002", "target": "#nkr_note_mod_0356002", "type": "mod", "text": "惟【大】＊，唯【宋】【明】＊"}
{"id": null, "n": "0356003", "target": "#nkr_note_mod_0356003", "type": "mod", "text": "坼【大】，拆【明】"}
{"id": null, "n": "0356004", "target": "#nkr_note_mod_0356004", "type": "mod", "text": "去【大】下同，去聲【明】下同"}
{"id": null, "n": "0356005", "target": "#nkr_note_mod_0356005", "type": "mod", "text": "婆【大】＊，嘙【宋】【明】＊"}
{"id": null, "n": "0356006", "target": "#nkr_note_mod_0356006", "type": "mod", "text": "薩【大】＊，󰷍【宋】【明】＊"}
{"id": null, "n": "0356007", "target": "#nkr_note_mod_0356007", "type": "mod", "text": "罽平十三【大】，罽十三平【宋】，雞平聲呼罽十三【明】"}
{"id": null, "n": "0356008", "target": "#nkr_note_mod_0356008", "type": "mod", "text": "阿【大】＊，啊【宋】【明】＊"}
{"id": null, "n": "0356009", "target": "#nkr_note_mod_0356009", "type": "mod", "text": "上【大】，上聲【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "聲"}
{"id": null, "n": "0356010", "target": "#nkr_note_mod_0356010", "type": "mod", "text": "十四上【大】，上十四【宋】【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "十四"}
{"id": null, "n": null, "target": null, "type": null, "text": "上"}
{"id": null, "n": "0356011", "target": "#nkr_note_mod_0356011", "type": "mod", "text": "跋囉【大】，羅跋【明】"}
{"id": null, "n": "0356012", "target": "#nkr_note_mod_0356012", "type": "mod", "text": "曷【大】，喝【明】"}
{"id": null, "n": "0356013", "target": "#nkr_note_mod_0356013", "type": "mod", "text": "已【大】，七【宋】"}
{"id": null, "n": "0356014", "target": "#nkr_note_mod_0356014", "type": "mod", "text": "反【大】下同，切【明】下同"}
