{"id": null, "n": "0801006", "target": null, "type": "orig", "text": "照＋（奉勅）【三】【宮】"}
{"id": null, "n": "0801006", "target": null, "type": "mod", "text": "照【大】，照奉勅【宋】【元】【明】【宮】"}
{"id": null, "n": "0800006", "target": "#nkr_note_mod_0800006", "type": "mod", "text": "鈐【大】，鉢【宮】"}
{"id": null, "n": "0800007", "target": "#nkr_note_mod_0800007", "type": "mod", "text": "砂【大】，沙【明】"}
{"id": null, "n": "0800008", "target": "#nkr_note_mod_0800008", "type": "mod", "text": "振【大】，震【宋】【元】【明】【宮】"}
{"id": null, "n": "0801001", "target": "#nkr_note_mod_0801001", "type": "mod", "text": "羅【大】，羅唐言日照【元】，羅此言日照【明】"}
{"id": null, "n": "0801002", "target": "#nkr_note_mod_0801002", "type": "mod", "text": "佛說【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "0801003", "target": "#nkr_note_mod_0801003", "type": "mod", "text": "經【大】，經一卷【宮】"}
{"id": null, "n": "0801004", "target": "#nkr_note_mod_0801004", "type": "mod", "text": "大唐【大】，〔－〕【宋】【宮】，唐【元】【明】"}
{"id": null, "n": "0801005", "target": "#nkr_note_mod_0801005", "type": "mod", "text": "唐言日照【大】，〔－〕【元】【明】"}
{"id": null, "n": "0801006", "target": "#nkr_note_mod_0801006", "type": "mod", "text": "照【大】，照奉勅【宋】【元】【明】【宮】"}
{"id": null, "n": "0801007", "target": "#nkr_note_mod_0801007", "type": "mod", "text": "唯【大】＊，惟【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0801008", "target": "#nkr_note_mod_0801008", "type": "mod", "text": "下【大】，下下【宋】【元】【明】【宮】"}
{"id": null, "n": "0800005", "target": "#nkr_note_orig_0800005", "type": "orig", "text": "翻經沙門釋圓測撰【元】【明】"}
{"id": null, "n": "0800006", "target": "#nkr_note_orig_0800006", "type": "orig", "text": "鈐＝鉢【宮】"}
{"id": null, "n": "0800007", "target": "#nkr_note_orig_0800007", "type": "orig", "text": "砂＝沙【明】"}
{"id": null, "n": "0800008", "target": "#nkr_note_orig_0800008", "type": "orig", "text": "振＝震【三】【宮】"}
{"id": null, "n": "0801001", "target": "#nkr_note_orig_0801001", "type": "orig", "text": "羅＋（唐言日照）【元】，（此言日照）【明】"}
{"id": null, "n": "0801002", "target": "#nkr_note_orig_0801002", "type": "orig", "text": "〔佛說〕－【宋】【宮】"}
{"id": null, "n": "0801003", "target": "#nkr_note_orig_0801003", "type": "orig", "text": "經＋（一卷）【宮】"}
{"id": null, "n": "0801004", "target": "#nkr_note_orig_0801004", "type": "orig", "text": "〔大唐〕－【宋】【宮】，大唐＝唐【元】【明】"}
{"id": null, "n": "0801005", "target": "#nkr_note_orig_0801005", "type": "orig", "text": "〔唐言日照〕－【元】【明】"}
{"id": null, "n": "0801006", "target": "#nkr_note_orig_0801006", "type": "orig", "text": "照＋（奉勅）【三】【宮】"}
{"id": null, "n": "0801007", "target": "#nkr_note_orig_0801007", "type": "orig", "text": "唯＝惟【三】【宮】＊"}
{"id": null, "n": "0801008", "target": "#nkr_note_orig_0801008", "type": "orig", "text": "（下）＋下【三】【宮】"}
