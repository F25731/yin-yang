{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": "0395003", "target": "#nkr_note_mod_0395003", "type": "mod", "text": "證【大】，真覺大師證【甲】"}
{"id": null, "n": "0395004", "target": "#nkr_note_mod_0395004", "type": "mod", "text": "（唐慎…撰）八字【大】，〔－〕【甲】"}
{"id": null, "n": "0395005", "target": "#nkr_note_mod_0395005", "type": "mod", "text": "析【大】，折【甲】"}
{"id": null, "n": "0396001", "target": "#nkr_note_mod_0396001", "type": "mod", "text": "冤【大】＊，怨【甲】＊"}
{"id": null, "n": "0396002", "target": "#nkr_note_mod_0396002", "type": "mod", "text": "既能【大】，我今【甲】"}
{"id": null, "n": "0396003", "target": "#nkr_note_mod_0396003", "type": "mod", "text": "法東流【大】，歷江海【甲】"}
{"id": null, "n": "0396004", "target": "#nkr_note_mod_0396004", "type": "mod", "text": "騃【大】，駭【甲】"}
{"id": null, "n": "0396005", "target": "#nkr_note_mod_0396005", "type": "mod", "text": "應【大】，還【甲】"}
{"id": null, "n": "0396006", "target": "#nkr_note_mod_0396006", "type": "mod", "text": "還夙【大】，償宿【甲】"}
{"id": null, "n": "0396007", "target": "#nkr_note_mod_0396007", "type": "mod", "text": "瘥【大】，愈【甲】"}
{"id": null, "n": "0396008", "target": "#nkr_note_mod_0396008", "type": "mod", "text": "螗蜋【大】，螳螂【甲】"}
{"id": null, "n": "0396009", "target": "#nkr_note_mod_0396009", "type": "mod", "text": "訣【大】，決【甲】"}
{"id": null, "n": "0396010", "target": "#nkr_note_mod_0396010", "type": "mod", "text": "永嘉證道歌【大】，證道歌之【甲】"}
{"id": null, "n": "0395002", "target": "#nkr_note_orig_0395002", "type": "orig", "text": "【原】增上寺報恩藏明本，【甲】元祿七年刊宗教大學藏本"}
{"id": null, "n": "0395003", "target": "#nkr_note_orig_0395003", "type": "orig", "text": "（真覺大師）＋證【甲】"}
{"id": null, "n": "0395004", "target": "#nkr_note_orig_0395004", "type": "orig", "text": "〔唐慎…撰〕八字－【甲】"}
{"id": null, "n": "0395005", "target": "#nkr_note_orig_0395005", "type": "orig", "text": "析＝折【甲】"}
{"id": null, "n": "0396001", "target": "#nkr_note_orig_0396001", "type": "orig", "text": "冤＝怨【甲】＊"}
{"id": null, "n": "0396002", "target": "#nkr_note_orig_0396002", "type": "orig", "text": "既能＝我今【甲】"}
{"id": null, "n": "0396003", "target": "#nkr_note_orig_0396003", "type": "orig", "text": "法東流＝歷江海【甲】"}
{"id": null, "n": "0396004", "target": "#nkr_note_orig_0396004", "type": "orig", "text": "騃＝駭【甲】"}
{"id": null, "n": "0396005", "target": "#nkr_note_orig_0396005", "type": "orig", "text": "應＝還【甲】"}
{"id": null, "n": "0396006", "target": "#nkr_note_orig_0396006", "type": "orig", "text": "還夙＝償宿【甲】"}
{"id": null, "n": "0396007", "target": "#nkr_note_orig_0396007", "type": "orig", "text": "瘥＝愈【甲】"}
{"id": null, "n": "0396008", "target": "#nkr_note_orig_0396008", "type": "orig", "text": "螗蜋＝螳螂【甲】"}
{"id": null, "n": "0396009", "target": "#nkr_note_orig_0396009", "type": "orig", "text": "訣＝決【甲】"}
{"id": null, "n": "0396010", "target": "#nkr_note_orig_0396010", "type": "orig", "text": "永嘉證道歌＝證道歌之【甲】"}
{"id": null, "n": "0395c0901", "target": "#nkr_note_add_0395c0901", "type": "add", "text": "閒【CB】，間【大】"}
{"id": null, "n": "0395c1201", "target": "#nkr_note_add_0395c1201", "type": "add", "text": "人【CB】，入【大】"}
{"id": null, "n": "0396a1201", "target": "#nkr_note_add_0396a1201", "type": "add", "text": "閒閒【CB】，間間【大】"}
{"id": null, "n": "0396b1701", "target": "#nkr_note_add_0396b1701", "type": "add", "text": "閒【CB】，間【大】"}
{"id": null, "n": "0396c2601", "target": "#nkr_note_add_0396c2601", "type": "add", "text": "見【CB】，［－］【大】"}
{"id": null, "n": "0397a1401", "target": "#nkr_note_add_0397a1401", "type": "add", "text": "CBETA 按：本句另在《祖堂集》卷3作：「何不體取無生，達本無速乎？」（B25n0144_p0368b14-369a01）。"}
