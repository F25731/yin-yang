{"id": null, "n": null, "target": null, "type": null, "text": "補遺附"}
{"id": null, "n": null, "target": null, "type": null, "text": "岠，音巨，山宏大；岟，音央，山高也"}
{"id": null, "n": null, "target": null, "type": null, "text": "屹，音乙；崪，音碎。山高貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "岦，音立；岌，音及。\n山危險貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "嵔，音畏；嶉，音嘴。嵔嶉：山曲也"}
{"id": null, "n": null, "target": null, "type": null, "text": "嶄，音斬，平聲，山高也"}
{"id": null, "n": null, "target": null, "type": null, "text": "峆，音合；崉，音沓。峆崉：山貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "聿，即筆也。楚謂之「聿」，吳謂\n\n之「不聿」，燕謂之「弗」，秦謂之「筆」"}
{"id": null, "n": null, "target": null, "type": null, "text": "《前漢\n書》：「滇中分野，在天屬井鬼，入參七度。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "《宋書》：「滇分野，麗中台上位北斗開陽一星。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "畨，西畨；緬，即緬國也"}
{"id": null, "n": null, "target": null, "type": null, "text": "犍，音乾，乃犍為\n郡，在川南；牂，音贓，牂牁江，在滇黔之界"}
{"id": null, "n": null, "target": null, "type": null, "text": "㟎，音腿；㠑，音罪。㟎㠑：山高\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "嶜，音爭；崟，音吟。嶜崟：高銳也"}
{"id": null, "n": null, "target": null, "type": null, "text": "𡷞，音起，高也"}
{"id": null, "n": null, "target": null, "type": null, "text": "嵥，音桀"}
{"id": null, "n": null, "target": null, "type": null, "text": "屻，音刃；屽，音岸。山高貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "𡵗，音食，山貌；岊，音節，山之陬隅高處\n曰岊"}
{"id": null, "n": null, "target": null, "type": null, "text": "峉，音額，山高大也"}
{"id": null, "n": null, "target": null, "type": null, "text": "崎，音奇；砑，音牙。石相格貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "𡻪，音\n聊；𡻙，音郭。𡻪𡻙：㴱谷貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "𡺫，音坎，山險也"}
{"id": null, "n": null, "target": null, "type": null, "text": "叶胡沃切"}
{"id": null, "n": null, "target": null, "type": null, "text": "洕，音\n引，小水也"}
{"id": null, "n": null, "target": null, "type": null, "text": "㳹，音往，大水也"}
{"id": null, "n": null, "target": null, "type": null, "text": "汭，音芮，曲流也；渦，音窩，水瀠洄"}
{"id": null, "n": null, "target": null, "type": null, "text": "𡶋，音掬；𡶮，音郁。𡶋𡶮：山之閫奧也"}
{"id": null, "n": null, "target": null, "type": null, "text": "岥，音坡；岮，音陀。岥岮：山不平也"}
{"id": null, "n": null, "target": null, "type": null, "text": "音彭"}
{"id": null, "n": null, "target": null, "type": null, "text": "汹與洶同"}
{"id": null, "n": null, "target": null, "type": null, "text": "㟽，音票，山巔也"}
{"id": null, "n": null, "target": null, "type": null, "text": "渟，音亭"}
{"id": null, "n": null, "target": null, "type": null, "text": "飈，音標，飃風也"}
{"id": null, "n": null, "target": null, "type": null, "text": "澎，音彭；泙，音平。澎泙：水聲也"}
{"id": null, "n": null, "target": null, "type": null, "text": "篔，音云；簹，音當。篔簹：大竹也"}
{"id": null, "n": null, "target": null, "type": null, "text": "竹之大者曰桂，小者曰箭"}
{"id": null, "n": null, "target": null, "type": null, "text": "㟹，音聊；嶆，音曹。㟹嶆：山㴱空也"}
{"id": null, "n": null, "target": null, "type": null, "text": "㮑，音柝；𣖭，音濕。\n㮑𣖭：林木㴱貌"}
{"id": null, "n": null, "target": null, "type": null, "text": "𥝈與萬同，\n音吠。周成王時，州靡國獻𥝈，人身，反踵，能食人。得人即笑，笑即唇掩其目，人因而擒之。左太冲〈吳都\n賦〉云：「猩猩啼而就擒，萬萬笑而被格。」《爾雅》云：「萬如人，被髮迅走，一名裊羊。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲精，雲母也，入地萬歲不朽"}
{"id": null, "n": null, "target": null, "type": null, "text": "山中老樹\n有絲蘿懸綴，謂之樹衣；土人取而佩之，以辟不祥"}
{"id": null, "n": null, "target": null, "type": null, "text": "兩阜之間曰隧。左思〈蜀都賦〉云：「開高軒以臨山，列綺窓而瞰江。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "㢍，音影，長廊也"}
{"id": null, "n": null, "target": null, "type": null, "text": "永昌府，古「哀牢國」也。蒼山、洱水之間，古名「鶴拓」"}
{"id": null, "n": null, "target": null, "type": null, "text": "猓，音魯；僰，音白；卭，音窮。皆彝種。酋，君長也"}
{"id": null, "n": null, "target": null, "type": null, "text": "白，白國也，阿育王第二子王鶴拓，奉佛不茹葷，日食白飯，人稱\n為「白飯王」，是為白國之祖，今地名白崖即其舊都也。濮，音僕，大理地曰：「百濮，春秋時屬楚。」《國語》曰：「叔\n熊逃難于濮而蠻。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "冉、駹、卭、笮，皆西南彝，見《前漢書》"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒲，蒲蠻也，與猓玀皆南彝"}
{"id": null, "n": null, "target": null, "type": null, "text": "緱，音溝，劍頭纏絲也"}
{"id": null, "n": null, "target": null, "type": null, "text": "交，交趾也；緬，即緬國"}
{"id": null, "n": null, "target": null, "type": null, "text": "四觀者，山頂名四觀峰：東曰日觀，西曰海觀，北曰雪觀，南曰雲觀"}
{"id": null, "n": null, "target": null, "type": null, "text": "𡷧，音吟；峗，音危。𡷧峗：山高聳而險也"}
{"id": null, "n": null, "target": null, "type": null, "text": "遝，音踏。雜遝：行相及也"}
{"id": null, "n": null, "target": null, "type": null, "text": "日正中曰亭午"}
{"id": null, "n": null, "target": null, "type": null, "text": "皛，音杳，明\n顕也"}
{"id": null, "n": null, "target": null, "type": null, "text": "岣，音苟；嵧，音留。岣嵧：大山高峰也"}
{"id": null, "n": null, "target": null, "type": null, "text": "《管子》云：「凡天下名山五千三百七十。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "《河圖括地象》云：「地下有八柱，柱廣十萬里，有三\n千六百軸，互相牽制，名山大川，孔穴相通。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "叶，圭玄切"}
{"id": null, "n": null, "target": null, "type": null, "text": "𡸘，音疽。𡸘嵎：高崖也"}
{"id": null, "n": null, "target": null, "type": null, "text": "續"}
{"id": null, "n": null, "target": null, "type": null, "text": "維揚"}
{"id": null, "n": null, "target": null, "type": null, "text": "魯人"}
{"id": null, "n": null, "target": null, "type": null, "text": "寺內有湧泉，名\n「篆烟泉」"}
{"id": null, "n": null, "target": null, "type": null, "text": "雞山佛光，人人皆見己像，故名「攝身光」云。"}
{"id": null, "n": null, "target": null, "type": null, "text": "蒼山積雪，盛暑不消，故云。"}
{"id": null, "n": null, "target": null, "type": null, "text": "其塔粉堊，瑩然潔白，故云。"}
