{"id": null, "n": null, "target": null, "type": null, "text": "附"}
{"id": null, "n": null, "target": null, "type": null, "text": "附"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "姑回切，音傀。瑰瑋，琦玩也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "于鬼切，音韙。人才傀偉。"}
{"id": null, "n": null, "target": null, "type": null, "text": "之涉切，音讋。摺疊也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "旻悲\n切，音眉。鹿屬。"}
{"id": null, "n": null, "target": null, "type": null, "text": "密北切，音墨。與默同。"}
{"id": null, "n": null, "target": null, "type": null, "text": "力忌切，音吏。語餘聲。"}
{"id": null, "n": null, "target": null, "type": null, "text": "郎擊切，音歷。淩也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上他紺切，舑去聲。下悉盍切，音靸。󳱥，\n惡也。一曰不謹貌。"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡郭切，音獲。釜屬。"}
{"id": null, "n": null, "target": null, "type": null, "text": "側持切，音緇。不耕田也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "所景切，生上聲。目病生翳也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "里弟切，音禮。彭蠡，澤名。"}
{"id": null, "n": null, "target": null, "type": null, "text": "側救切，音皺。布也，纖也，聚\n文也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "類墮"}
{"id": null, "n": null, "target": null, "type": null, "text": "隨墮"}
{"id": null, "n": null, "target": null, "type": null, "text": "尊貴墮"}
{"id": null, "n": null, "target": null, "type": null, "text": "圅昰請"}
{"id": null, "n": null, "target": null, "type": null, "text": "圅可請"}
{"id": null, "n": null, "target": null, "type": null, "text": "圅濟請"}
{"id": null, "n": null, "target": null, "type": null, "text": "圅卍請"}
{"id": null, "n": null, "target": null, "type": null, "text": "圅具請　卍具侍側"}
{"id": null, "n": null, "target": null, "type": null, "text": "圅蔭請"}
{"id": null, "n": null, "target": null, "type": null, "text": "華首請"}
{"id": null, "n": null, "target": null, "type": null, "text": "海幢請"}
{"id": null, "n": null, "target": null, "type": null, "text": "張瓜切，音髽。擊鼓也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "他恊切，音貼。妥帖，定也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡光切，音黃。鐘鼓聲。鍠鍠，樂之聲也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "古淵字。物萌於囦。深廣貌。"}
{"id": null, "n": null, "target": null, "type": null, "text": "披教切，音砲。󳳑然聲也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "附來書"}
{"id": null, "n": null, "target": null, "type": null, "text": "附來書"}
{"id": null, "n": null, "target": null, "type": null, "text": "附來書"}
{"id": null, "n": null, "target": null, "type": null, "text": "式竹切，音叔。眾豆之總名。"}
{"id": null, "n": null, "target": null, "type": null, "text": "烏結切，音咽。咽喉蔽塞之名。"}
{"id": null, "n": null, "target": null, "type": null, "text": "支義切，音觶。置也。猶言安\n著也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "力制切，音例。磨石也。崦嵫山礪石，可磨刃。"}
{"id": null, "n": null, "target": null, "type": null, "text": "武粉切，音𢪛。口邊也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "福州萬歲寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "長慶寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "法海寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "長慶寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "上呂下切，音碕。下千餘切，音蛆。草枯不芳貌。"}
{"id": null, "n": null, "target": null, "type": null, "text": "息淺切，音鮮。野火也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "止忍切，音\n軫。緻也。縝密以栗。"}
{"id": null, "n": null, "target": null, "type": null, "text": "求於切，音渠。瘠也。山澤間形容甚癯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "昌召切，超去聲。"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "J38nB407_p0219a20"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "B16n0088_p0647a01"}
{"id": null, "n": "0747001", "target": "#nkr_note_orig_0747001", "type": "orig", "text": "若下疑脫不字"}
