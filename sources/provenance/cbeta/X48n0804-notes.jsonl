{"id": null, "n": null, "target": null, "type": null, "text": "本地分中略錄名數"}
{"id": null, "n": null, "target": null, "type": null, "text": "名義互言"}
{"id": null, "n": null, "target": null, "type": null, "text": "梵語瑜伽，此云相應，即本論名也"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦可謂帶數依主"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦帶數依主釋也"}
{"id": null, "n": null, "target": null, "type": null, "text": "作十釋竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "破即分也"}
{"id": null, "n": null, "target": null, "type": null, "text": "老小同會，共集律部"}
{"id": null, "n": null, "target": null, "type": null, "text": "唯老宿人同會，\n共出律部"}
{"id": null, "n": null, "target": null, "type": null, "text": "所執與大眾部同，故云一也"}
{"id": null, "n": null, "target": null, "type": null, "text": "說諸佛世尊皆是出世"}
{"id": null, "n": null, "target": null, "type": null, "text": "是謂律主姓也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂律主有多聞智也"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂蘊處界皆非實有"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主居處也"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦律主居\n處也"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦律主居處也"}
{"id": null, "n": null, "target": null, "type": null, "text": "又名一切語言，謂律主執三世有，名一切語言也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即律主行處也"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主姓也"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主名也"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主\n名也"}
{"id": null, "n": null, "target": null, "type": null, "text": "又名一切所貴，律主為通人所重也"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主居處\n也"}
{"id": null, "n": null, "target": null, "type": null, "text": "名能射，又名不可棄。律主初生，母棄於井，父追尋之，雖墜不夭，故云不可\n棄"}
{"id": null, "n": null, "target": null, "type": null, "text": "律主名也"}
{"id": null, "n": null, "target": null, "type": null, "text": "又名迦葉，律主姓也"}
{"id": null, "n": null, "target": null, "type": null, "text": "又名修妬路，律主執修妬路義也"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼以名、色為法。"}
{"id": null, "n": null, "target": null, "type": null, "text": "觀即毗鉢舍那"}
{"id": null, "n": null, "target": null, "type": null, "text": "止即奢麼他"}
{"id": null, "n": null, "target": null, "type": null, "text": "此四實"}
{"id": null, "n": null, "target": null, "type": null, "text": "此相狀假"}
{"id": null, "n": null, "target": null, "type": null, "text": "此分位假"}
{"id": null, "n": null, "target": null, "type": null, "text": "是益"}
{"id": null, "n": null, "target": null, "type": null, "text": "是損"}
{"id": null, "n": null, "target": null, "type": null, "text": "通二"}
{"id": null, "n": null, "target": null, "type": null, "text": "語等"}
{"id": null, "n": null, "target": null, "type": null, "text": "樹等聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "手鼓等聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "六識"}
{"id": null, "n": null, "target": null, "type": null, "text": "依士釋也"}
{"id": null, "n": null, "target": null, "type": null, "text": "因也"}
{"id": null, "n": null, "target": null, "type": null, "text": "果也"}
{"id": null, "n": null, "target": null, "type": null, "text": "雙證\n二無我理"}
{"id": null, "n": null, "target": null, "type": null, "text": "指毗曇"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
