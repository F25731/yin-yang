{"id": null, "n": "0216001", "target": "#nkr_note_mod_0216001", "type": "mod", "text": "西天譯經【大】，宋西天【明】"}
{"id": null, "n": "0216002", "target": "#nkr_note_mod_0216002", "type": "mod", "text": "賜紫沙門臣施護等【大】，施護【明】"}
{"id": null, "n": "0216003", "target": "#nkr_note_mod_0216003", "type": "mod", "text": "若【大】，苦【宋】【元】【明】"}
{"id": null, "n": "0216004", "target": "#nkr_note_mod_0216004", "type": "mod", "text": "邪【大】＊，耶【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0218001", "target": "#nkr_note_mod_0218001", "type": "mod", "text": "譯號（西天譯經）【大】，宋西天【明】"}
{"id": null, "n": "0218002", "target": "#nkr_note_mod_0218002", "type": "mod", "text": "賜紫沙門臣施護等【大】，施護【明】"}
{"id": null, "n": "0218003", "target": "#nkr_note_mod_0218003", "type": "mod", "text": "之【大】，沒【宋】"}
{"id": null, "n": "0219001", "target": "#nkr_note_mod_0219001", "type": "mod", "text": "邪【大】，耶【宋】【元】【明】"}
{"id": null, "n": "0219002", "target": "#nkr_note_mod_0219002", "type": "mod", "text": "一【大】，亦【明】"}
{"id": null, "n": "0220001", "target": "#nkr_note_mod_0220001", "type": "mod", "text": "密【大】＊，蜜【明】＊"}
{"id": null, "n": "0220002", "target": "#nkr_note_mod_0220002", "type": "mod", "text": "主【大】，王【元】"}
{"id": null, "n": "0220003", "target": "#nkr_note_mod_0220003", "type": "mod", "text": "西天譯經三藏朝奉大夫試光祿卿傳法大師賜紫沙門臣施護等奉詔譯【大】，宋西天三藏朝奉大夫試光祿卿傳法大師施護奉詔譯【明】"}
{"id": null, "n": "0221001", "target": "#nkr_note_mod_0221001", "type": "mod", "text": "一【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0222001", "target": "#nkr_note_mod_0222001", "type": "mod", "text": "正知【大】，知正【明】"}
{"id": null, "n": "0216001", "target": "#nkr_note_orig_0216001", "type": "orig", "text": "西天譯經＝宋西天【明】"}
{"id": null, "n": "0216002", "target": "#nkr_note_orig_0216002", "type": "orig", "text": "賜紫沙門臣施護等＝施護【明】"}
{"id": null, "n": "0216003", "target": "#nkr_note_orig_0216003", "type": "orig", "text": "若＝苦【三】"}
{"id": null, "n": "0216004", "target": "#nkr_note_orig_0216004", "type": "orig", "text": "邪＝耶【三】＊"}
{"id": null, "n": "0218001", "target": "#nkr_note_orig_0218001", "type": "orig", "text": "譯號（西天譯經）＝（宋西天）【明】"}
{"id": null, "n": "0218002", "target": "#nkr_note_orig_0218002", "type": "orig", "text": "賜紫沙門臣施護等＝施護【明】"}
{"id": null, "n": "0218003", "target": "#nkr_note_orig_0218003", "type": "orig", "text": "之＝沒【宋】"}
{"id": null, "n": "0219001", "target": "#nkr_note_orig_0219001", "type": "orig", "text": "邪＝耶【三】"}
{"id": null, "n": "0219002", "target": "#nkr_note_orig_0219002", "type": "orig", "text": "一＝亦【明】"}
{"id": null, "n": "0220001", "target": "#nkr_note_orig_0220001", "type": "orig", "text": "密＝蜜【明】＊"}
{"id": null, "n": "0220002", "target": "#nkr_note_orig_0220002", "type": "orig", "text": "主＝王【元】"}
{"id": null, "n": "0220003", "target": "#nkr_note_orig_0220003", "type": "orig", "text": "譯號同異如卷第一【明】"}
{"id": null, "n": "0221001", "target": "#nkr_note_orig_0221001", "type": "orig", "text": "〔一〕－【三】"}
{"id": null, "n": "0222001", "target": "#nkr_note_orig_0222001", "type": "orig", "text": "正知＝知正【明】"}
{"id": null, "n": "0216b2101", "target": "#nkr_note_add_0216b2101", "type": "add", "text": "［－］【CB】【麗-CB】，悉【大】"}
{"id": null, "n": "0217b0301", "target": "#nkr_note_add_0217b0301", "type": "add", "text": "此是【CB】【麗-CB】，是此【大】"}
{"id": null, "n": "0219a2701", "target": "#nkr_note_add_0219a2701", "type": "add", "text": "但【CB】【麗-CB】，怛【大】"}
{"id": null, "n": "0221a2101", "target": "#nkr_note_add_0221a2101", "type": "add", "text": "由【CB】【麗-CB】，山【大】"}
{"id": null, "n": "0221c2801", "target": "#nkr_note_add_0221c2801", "type": "add", "text": "正【CB】【麗-CB】，［－］【大】"}
