{"id": null, "n": "0889010", "target": "#nkr_note_mod_0889010", "type": "mod", "text": "西【大】，宋西【明】"}
{"id": null, "n": "0889011", "target": "#nkr_note_mod_0889011", "type": "mod", "text": "譯經【大】，〔－〕【明】"}
{"id": null, "n": "0889012", "target": "#nkr_note_mod_0889012", "type": "mod", "text": "賜紫臣【大】，〔－〕【明】"}
{"id": null, "n": "0889013", "target": "#nkr_note_mod_0889013", "type": "mod", "text": "言【大】，曰【明】，言字元本白缺"}
{"id": null, "n": "0890001", "target": "#nkr_note_mod_0890001", "type": "mod", "text": "切身下同【大】，寧也切【明】"}
{"id": null, "n": "0890002", "target": "#nkr_note_mod_0890002", "type": "mod", "text": "句【大】，〔－〕【明】"}
{"id": null, "n": "0890003", "target": "#nkr_note_mod_0890003", "type": "mod", "text": "三【大】，二【明】"}
{"id": null, "n": "0890004", "target": "#nkr_note_mod_0890004", "type": "mod", "text": "踊【大】，踴【宋】【元】"}
{"id": null, "n": "0889009", "target": "#nkr_note_orig_0889009", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0889010", "target": "#nkr_note_orig_0889010", "type": "orig", "text": "（宋）＋西【明】"}
{"id": null, "n": "0889011", "target": "#nkr_note_orig_0889011", "type": "orig", "text": "〔譯經〕－【明】"}
{"id": null, "n": "0889012", "target": "#nkr_note_orig_0889012", "type": "orig", "text": "〔賜紫臣〕－【明】"}
{"id": null, "n": "0889013", "target": "#nkr_note_orig_0889013", "type": "orig", "text": "言字元本白缺，言＝曰【明】"}
{"id": null, "n": "0890001", "target": "#nkr_note_orig_0890001", "type": "orig", "text": "切身下同＝寧也切【明】"}
{"id": null, "n": "0890002", "target": "#nkr_note_orig_0890002", "type": "orig", "text": "〔句〕－【明】"}
{"id": null, "n": "0890003", "target": "#nkr_note_orig_0890003", "type": "orig", "text": "三＝二【明】"}
{"id": null, "n": "0890004", "target": "#nkr_note_orig_0890004", "type": "orig", "text": "踊＝踴【宋】【元】"}
{"id": null, "n": "0889013", "target": "#nkr_note_rest_0889013", "type": "rest", "text": "言字元本白缺"}
