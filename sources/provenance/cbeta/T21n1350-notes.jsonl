{"id": null, "n": "0864001", "target": "#nkr_note_mod_0864001", "type": "mod", "text": "佛說【大】，〔－〕【明】，【原】麗本"}
{"id": null, "n": "0864002", "target": "#nkr_note_mod_0864002", "type": "mod", "text": "西【大】，宋西【明】"}
{"id": null, "n": "0864003", "target": "#nkr_note_mod_0864003", "type": "mod", "text": "譯經【大】，〔－〕【明】"}
{"id": null, "n": "0864004", "target": "#nkr_note_mod_0864004", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0864005", "target": "#nkr_note_mod_0864005", "type": "mod", "text": "音【大】，等【宋】【元】【明】"}
{"id": null, "n": "0864006", "target": "#nkr_note_mod_0864006", "type": "mod", "text": "佛說【大】，〔－〕【明】"}
{"id": null, "n": "0864007", "target": "#nkr_note_mod_0864007", "type": "mod", "text": "經【大】，〔－〕【宋】"}
{"id": null, "n": "0864001", "target": "#nkr_note_orig_0864001", "type": "orig", "text": "【原】麗本，〔佛說〕－【明】"}
{"id": null, "n": "0864002", "target": "#nkr_note_orig_0864002", "type": "orig", "text": "（宋）＋西【明】"}
{"id": null, "n": "0864003", "target": "#nkr_note_orig_0864003", "type": "orig", "text": "〔譯經〕－【明】"}
{"id": null, "n": "0864004", "target": "#nkr_note_orig_0864004", "type": "orig", "text": "〔臣〕－【明】"}
{"id": null, "n": "0864005", "target": "#nkr_note_orig_0864005", "type": "orig", "text": "音＝等【三】"}
{"id": null, "n": "0864006", "target": "#nkr_note_orig_0864006", "type": "orig", "text": "〔佛說〕－【明】"}
