{"id": null, "n": "0573003", "target": "#nkr_note_mod_0573003", "type": "mod", "text": "返【大】＊，反【宋】【元】＊"}
{"id": null, "n": "0574001", "target": "#nkr_note_mod_0574001", "type": "mod", "text": "散【大】，散失【宋】【元】"}
{"id": null, "n": "0574002", "target": "#nkr_note_mod_0574002", "type": "mod", "text": "非【大】，亦【宋】【元】"}
{"id": null, "n": "0574003", "target": "#nkr_note_mod_0574003", "type": "mod", "text": "無【CB】【宋】【元】，有【大】"}
{"id": null, "n": "0573002", "target": "#nkr_note_orig_0573002", "type": "orig", "text": "此經明本以宋本元本對校之 cf. A段"}
{"id": null, "n": "0573003", "target": "#nkr_note_orig_0573003", "type": "orig", "text": "返＝反【宋】【元】＊"}
{"id": null, "n": "0574001", "target": "#nkr_note_orig_0574001", "type": "orig", "text": "散＋（失）【宋】【元】"}
{"id": null, "n": "0574002", "target": "#nkr_note_orig_0574002", "type": "orig", "text": "非＝亦【宋】【元】"}
{"id": null, "n": "0574003", "target": "#nkr_note_orig_0574003", "type": "orig", "text": "有＝無【宋】【元】"}
{"id": null, "n": "0574a2301", "target": "#nkr_note_add_0574a2301", "type": "add", "text": "何【CB】，可【大】"}
