{"id": null, "n": null, "target": null, "type": null, "text": "法名智顗"}
{"id": null, "n": null, "target": null, "type": null, "text": "六祖法名慧能"}
{"id": null, "n": null, "target": null, "type": null, "text": "法名宗密"}
{"id": null, "n": null, "target": null, "type": null, "text": "法名子󱈜"}
{"id": null, "n": null, "target": null, "type": null, "text": "法名德清"}
{"id": null, "n": null, "target": null, "type": null, "text": "法名如󰃗又名曉月"}
{"id": null, "n": null, "target": null, "type": null, "text": "號大圓居士"}
{"id": null, "n": null, "target": null, "type": null, "text": "法名廣伸"}
{"id": null, "n": null, "target": null, "type": null, "text": "號如如居士鈔本"}
{"id": null, "n": null, "target": null, "type": null, "text": "採集五十三家"}
{"id": null, "n": null, "target": null, "type": null, "text": "本朝"}
{"id": null, "n": null, "target": null, "type": null, "text": "鈔本"}
{"id": null, "n": null, "target": null, "type": null, "text": "經旨提要俱摘大圓居士"}
{"id": null, "n": null, "target": null, "type": null, "text": "據註云此書甚佳購之未得"}
{"id": null, "n": null, "target": null, "type": null, "text": "附記"}
{"id": null, "n": null, "target": null, "type": null, "text": "降乩筆"}
{"id": null, "n": null, "target": null, "type": null, "text": "應云何住，與後文云何應住不同。蓋前問功夫下手，後問有法示人\n也。經意自別。"}
{"id": null, "n": null, "target": null, "type": null, "text": "別本非無想上有若字。舊本經中凡\n即通作則，因避高麗諱稷，改即為則。凡兩合之義為即，相仍之義為則。即可用之相仍，則不可用之合兩。今從\n之。"}
{"id": null, "n": null, "target": null, "type": null, "text": "三字盛釋及各正本俱定為衍文"}
{"id": null, "n": null, "target": null, "type": null, "text": "五字較訂補正"}
{"id": null, "n": null, "target": null, "type": null, "text": "四字較訂補正"}
{"id": null, "n": null, "target": null, "type": null, "text": "今本是故名阿那含，無故字"}
{"id": null, "n": null, "target": null, "type": null, "text": "古本無是名般若波羅蜜句"}
{"id": null, "n": null, "target": null, "type": null, "text": "石本\n非第一上無即字"}
{"id": null, "n": null, "target": null, "type": null, "text": "古本無是名忍辱波羅蜜句"}
{"id": null, "n": null, "target": null, "type": null, "text": "利益眾生句下，古本無故字"}
{"id": null, "n": null, "target": null, "type": null, "text": "卷上"}
{"id": null, "n": null, "target": null, "type": null, "text": "卷下"}
{"id": null, "n": null, "target": null, "type": null, "text": "此段經文，秦譯無、魏譯有"}
{"id": null, "n": null, "target": null, "type": null, "text": "非善法上別本無即字"}
{"id": null, "n": null, "target": null, "type": null, "text": "石本無讀\n誦字，千萬億分上無百字"}
{"id": null, "n": null, "target": null, "type": null, "text": "古本俱無是名\n凡夫句"}
{"id": null, "n": null, "target": null, "type": null, "text": "別本第三句如來以具足相故，無不字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "菩提或作菩薩"}
{"id": null, "n": "0878001", "target": "#nkr_note_orig_0878001", "type": "orig", "text": "阿疑陀"}
{"id": null, "n": "0880b01", "target": "#nkr_note_orig_0880b01", "type": "orig", "text": "法會因由分第一"}
{"id": null, "n": "0880b02", "target": "#nkr_note_orig_0880b02", "type": "orig", "text": "善現啟請分第二"}
{"id": null, "n": "0881b01", "target": "#nkr_note_orig_0881b01", "type": "orig", "text": "大乘正宗分第三"}
{"id": null, "n": "0882b01", "target": "#nkr_note_orig_0882b01", "type": "orig", "text": "妙行無住分第四"}
{"id": null, "n": "0883b01", "target": "#nkr_note_orig_0883b01", "type": "orig", "text": "如理實見分第五"}
{"id": null, "n": "0883b02", "target": "#nkr_note_orig_0883b02", "type": "orig", "text": "正信希有分第六"}
{"id": null, "n": "0884b01", "target": "#nkr_note_orig_0884b01", "type": "orig", "text": "無得無說分第七"}
{"id": null, "n": "0885b01", "target": "#nkr_note_orig_0885b01", "type": "orig", "text": "依法出生分第八"}
{"id": null, "n": "0885b02", "target": "#nkr_note_orig_0885b02", "type": "orig", "text": "一相無相分第九"}
{"id": null, "n": "0885b03", "target": "#nkr_note_orig_0885b03", "type": "orig", "text": "莊嚴淨土分第十"}
{"id": null, "n": "0887b01", "target": "#nkr_note_orig_0887b01", "type": "orig", "text": "無為福勝分第十一"}
{"id": null, "n": "0888b01", "target": "#nkr_note_orig_0888b01", "type": "orig", "text": "尊重正教分第十二"}
{"id": null, "n": "0888b02", "target": "#nkr_note_orig_0888b02", "type": "orig", "text": "如法受持分第十三"}
{"id": null, "n": "0890b01", "target": "#nkr_note_orig_0890b01", "type": "orig", "text": "離相寂滅分第十四"}
{"id": null, "n": "0893b01", "target": "#nkr_note_orig_0893b01", "type": "orig", "text": "持經功德分第十五"}
{"id": null, "n": "0894b01", "target": "#nkr_note_orig_0894b01", "type": "orig", "text": "能淨業障分第十六"}
{"id": null, "n": "0895b01", "target": "#nkr_note_orig_0895b01", "type": "orig", "text": "究竟無我分第十七"}
{"id": null, "n": "0897b01", "target": "#nkr_note_orig_0897b01", "type": "orig", "text": "一體同觀分第十八"}
{"id": null, "n": "0898b01", "target": "#nkr_note_orig_0898b01", "type": "orig", "text": "法界通化分第十九"}
{"id": null, "n": "0898b02", "target": "#nkr_note_orig_0898b02", "type": "orig", "text": "離色離相分第二十"}
{"id": null, "n": "0898b03", "target": "#nkr_note_orig_0898b03", "type": "orig", "text": "非說所說分第二十一"}
{"id": null, "n": "0899b01", "target": "#nkr_note_orig_0899b01", "type": "orig", "text": "無法可得分第二十二"}
{"id": null, "n": "0899b02", "target": "#nkr_note_orig_0899b02", "type": "orig", "text": "淨心行善分第二十三"}
{"id": null, "n": "0900b01", "target": "#nkr_note_orig_0900b01", "type": "orig", "text": "福智無比分第二十四"}
{"id": null, "n": "0900b02", "target": "#nkr_note_orig_0900b02", "type": "orig", "text": "化無所化分第二十五"}
{"id": null, "n": "0900b03", "target": "#nkr_note_orig_0900b03", "type": "orig", "text": "法身非相分第二十六"}
{"id": null, "n": "0901b01", "target": "#nkr_note_orig_0901b01", "type": "orig", "text": "無斷無滅分第二十七"}
{"id": null, "n": "0901b02", "target": "#nkr_note_orig_0901b02", "type": "orig", "text": "不受不貪分第二十八"}
{"id": null, "n": "0902b01", "target": "#nkr_note_orig_0902b01", "type": "orig", "text": "威儀寂靜分第二十九"}
{"id": null, "n": "0902b02", "target": "#nkr_note_orig_0902b02", "type": "orig", "text": "一合理相分第三十"}
{"id": null, "n": "0903b01", "target": "#nkr_note_orig_0903b01", "type": "orig", "text": "知見不生分第三十一"}
{"id": null, "n": "0903b02", "target": "#nkr_note_orig_0903b02", "type": "orig", "text": "應化非真分第三十二"}
{"id": null, "n": "0904001", "target": "#nkr_note_orig_0904001", "type": "orig", "text": "聲疑色"}
