{"id": null, "n": null, "target": null, "type": null, "text": "余"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "此三取照臨於下。"}
{"id": null, "n": null, "target": null, "type": null, "text": "興雲致雨。"}
{"id": null, "n": null, "target": null, "type": null, "text": "變化無窮。"}
{"id": null, "n": null, "target": null, "type": null, "text": "即雉也，取耿介。此六畫於衣，法\n天之陽也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "文章。"}
{"id": null, "n": null, "target": null, "type": null, "text": "炎上以助其德。"}
{"id": null, "n": null, "target": null, "type": null, "text": "潔白。"}
{"id": null, "n": null, "target": null, "type": null, "text": "能養。"}
{"id": null, "n": null, "target": null, "type": null, "text": "斷害。"}
{"id": null, "n": null, "target": null, "type": null, "text": "背惡向善。此六繡於\n裳，法地之陰也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "結使不出見思，怨仇即四魔怨"}
{"id": null, "n": null, "target": null, "type": null, "text": "通使四方"}
{"id": null, "n": null, "target": null, "type": null, "text": "仰觀星宿"}
{"id": null, "n": null, "target": null, "type": null, "text": "耕墾種植"}
{"id": null, "n": null, "target": null, "type": null, "text": "習小呪術"}
{"id": null, "n": null, "target": null, "type": null, "text": "徒眾皆爾，則知非獨禪師。"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂所施者"}
{"id": null, "n": null, "target": null, "type": null, "text": "孟子作五十者"}
{"id": null, "n": null, "target": null, "type": null, "text": "孟子作狗󴎄"}
{"id": null, "n": null, "target": null, "type": null, "text": "色似銅也"}
{"id": null, "n": null, "target": null, "type": null, "text": "鈔云：彼翻律者，不見木蘭故"}
{"id": null, "n": null, "target": null, "type": null, "text": "隔明諸律同犯"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘律是犯，僧祇獨開"}
{"id": null, "n": null, "target": null, "type": null, "text": "通皆無犯"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T52n2103_p0292b23"}
