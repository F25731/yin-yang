{"id": null, "n": null, "target": null, "type": null, "text": "五分法身名解脫，梵音云毘尼木叉，涅槃解脫梵音云木叉也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此一經即解深密經第四第五卷別譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "五〔分〕－【元】分【大】，〔－〕【元】分法身名解脫，梵音云毘〔尼〕－【宋】【宮】，尼木＝木分【元】尼木【大】，木分【元】，木【宋】【宮】尼木木分木叉，涅槃解脫梵＝胡【宋】【宮】梵【大】，胡【宋】【宮】梵胡音云木叉〔也〕－【宮】也【大】，〔－〕【宮】也"}
{"id": null, "n": "0718006", "target": null, "type": "orig", "text": "〔分〕－【元】"}
{"id": null, "n": "0718006", "target": null, "type": "mod", "text": "分【大】，〔－〕【元】"}
{"id": null, "n": "0718007", "target": null, "type": "orig", "text": "〔尼〕－【宋】【宮】，尼木＝木分【元】"}
{"id": null, "n": "0718007", "target": null, "type": "mod", "text": "尼木【大】，木分【元】，木【宋】【宮】"}
{"id": null, "n": "0718008", "target": null, "type": "orig", "text": "梵＝胡【宋】【宮】"}
{"id": null, "n": "0718008", "target": null, "type": "mod", "text": "梵【大】，胡【宋】【宮】"}
{"id": null, "n": "0718009", "target": null, "type": "orig", "text": "〔也〕－【宮】"}
{"id": null, "n": "0718009", "target": null, "type": "mod", "text": "也【大】，〔－〕【宮】"}
{"id": null, "n": "0718004", "target": "#nkr_note_mod_0718004", "type": "mod", "text": "經【大】，經此一經即解深密經第四第五卷別譯劉宋天竺三藏法師求那跋陀羅譯【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "此一經即解深密經第四第五卷別譯"}
{"id": null, "n": "0718005", "target": "#nkr_note_mod_0718005", "type": "mod", "text": "（五分…也）二十四字【大】，〔－〕【明】"}
{"id": null, "n": "0718006", "target": "#nkr_note_mod_0718006", "type": "mod", "text": "分【大】，〔－〕【元】"}
{"id": null, "n": "0718007", "target": "#nkr_note_mod_0718007", "type": "mod", "text": "尼木【大】，木分【元】，木【宋】【宮】"}
{"id": null, "n": "0718008", "target": "#nkr_note_mod_0718008", "type": "mod", "text": "梵【大】，胡【宋】【宮】"}
{"id": null, "n": "0718009", "target": "#nkr_note_mod_0718009", "type": "mod", "text": "也【大】，〔－〕【宮】"}
{"id": null, "n": "0718010", "target": "#nkr_note_mod_0718010", "type": "mod", "text": "唯【大】＊，惟【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0719001", "target": "#nkr_note_mod_0719001", "type": "mod", "text": "清淨【大】，清淨法【宋】【元】【明】【宮】"}
{"id": null, "n": "0719002", "target": "#nkr_note_mod_0719002", "type": "mod", "text": "等得【大】，得等【宋】【元】【明】【宮】"}
{"id": null, "n": "0719003", "target": "#nkr_note_mod_0719003", "type": "mod", "text": "以【大】，似【宋】【元】【明】【宮】"}
{"id": null, "n": "0719004", "target": "#nkr_note_mod_0719004", "type": "mod", "text": "以【大】，似【明】"}
{"id": null, "n": "0719005", "target": "#nkr_note_mod_0719005", "type": "mod", "text": "說【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0719006", "target": "#nkr_note_mod_0719006", "type": "mod", "text": "食【大】，實【宮】"}
{"id": null, "n": "0719007", "target": "#nkr_note_mod_0719007", "type": "mod", "text": "身【大】，化【宋】【元】【明】【宮】"}
{"id": null, "n": "0720001", "target": "#nkr_note_mod_0720001", "type": "mod", "text": "頗梨【大】下同，玻瓈【宋】【元】【宮】，玻瓈【明】下同"}
{"id": null, "n": "0720002", "target": "#nkr_note_mod_0720002", "type": "mod", "text": "悕【大】＊，希【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0720003", "target": "#nkr_note_mod_0720003", "type": "mod", "text": "事【大】，者【宋】【元】【明】【宮】"}
{"id": null, "n": "0720004", "target": "#nkr_note_mod_0720004", "type": "mod", "text": "說【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0720005", "target": "#nkr_note_mod_0720005", "type": "mod", "text": "如來【大】，相續解脫如來【明】"}
{"id": null, "n": "0720006", "target": "#nkr_note_mod_0720006", "type": "mod", "text": "說【大】，〔－〕【明】"}
{"id": null, "n": "0718004", "target": "#nkr_note_orig_0718004", "type": "orig", "text": "經＋（此一經即解深密經第四第五卷別譯）夾註【明】，（劉宋天竺三藏法師求那跋陀羅譯）【明】"}
{"id": null, "n": "0718005", "target": "#nkr_note_orig_0718005", "type": "orig", "text": "〔五分…也〕二十四字－【明】"}
{"id": null, "n": "0718006", "target": "#nkr_note_orig_0718006", "type": "orig", "text": "〔分〕－【元】"}
{"id": null, "n": "0718007", "target": "#nkr_note_orig_0718007", "type": "orig", "text": "〔尼〕－【宋】【宮】，尼木＝木分【元】"}
{"id": null, "n": "0718008", "target": "#nkr_note_orig_0718008", "type": "orig", "text": "梵＝胡【宋】【宮】"}
{"id": null, "n": "0718009", "target": "#nkr_note_orig_0718009", "type": "orig", "text": "〔也〕－【宮】"}
{"id": null, "n": "0718010", "target": "#nkr_note_orig_0718010", "type": "orig", "text": "唯＝惟【三】【宮】＊"}
{"id": null, "n": "0719001", "target": "#nkr_note_orig_0719001", "type": "orig", "text": "清淨＋（法）【三】【宮】"}
{"id": null, "n": "0719002", "target": "#nkr_note_orig_0719002", "type": "orig", "text": "等得＝得等【三】【宮】"}
{"id": null, "n": "0719003", "target": "#nkr_note_orig_0719003", "type": "orig", "text": "以＝似【三】【宮】"}
{"id": null, "n": "0719004", "target": "#nkr_note_orig_0719004", "type": "orig", "text": "以＝似【明】"}
{"id": null, "n": "0719005", "target": "#nkr_note_orig_0719005", "type": "orig", "text": "〔說〕－【三】【宮】"}
{"id": null, "n": "0719006", "target": "#nkr_note_orig_0719006", "type": "orig", "text": "食＝實【宮】"}
{"id": null, "n": "0719007", "target": "#nkr_note_orig_0719007", "type": "orig", "text": "身＝化【三】【宮】"}
{"id": null, "n": "0720001", "target": "#nkr_note_orig_0720001", "type": "orig", "text": "頗梨＝玻瓈【宋】【元】【宮】，玻瓈【明】下同"}
{"id": null, "n": "0720002", "target": "#nkr_note_orig_0720002", "type": "orig", "text": "悕＝希【三】【宮】＊"}
{"id": null, "n": "0720003", "target": "#nkr_note_orig_0720003", "type": "orig", "text": "事＝者【三】【宮】"}
{"id": null, "n": "0720004", "target": "#nkr_note_orig_0720004", "type": "orig", "text": "〔說〕－【三】【宮】"}
{"id": null, "n": "0720005", "target": "#nkr_note_orig_0720005", "type": "orig", "text": "（相續解脫）＋如來【明】"}
{"id": null, "n": "0720006", "target": "#nkr_note_orig_0720006", "type": "orig", "text": "〔說〕－【明】"}
