{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "道通"}
{"id": null, "n": null, "target": null, "type": null, "text": "處也"}
{"id": null, "n": null, "target": null, "type": null, "text": "果也"}
{"id": null, "n": null, "target": null, "type": null, "text": "過慢類"}
{"id": null, "n": null, "target": null, "type": null, "text": "慢類"}
{"id": null, "n": null, "target": null, "type": null, "text": "𢍉慢類"}
{"id": null, "n": null, "target": null, "type": null, "text": "𢍉慢"}
{"id": null, "n": null, "target": null, "type": null, "text": "過慢\n類"}
{"id": null, "n": null, "target": null, "type": null, "text": "慢類"}
{"id": null, "n": null, "target": null, "type": null, "text": "𢍉慢類"}
{"id": null, "n": null, "target": null, "type": null, "text": "過慢類"}
{"id": null, "n": null, "target": null, "type": null, "text": "遍行五"}
{"id": null, "n": null, "target": null, "type": null, "text": "別境五，不定四，有遍行五俱"}
{"id": null, "n": null, "target": null, "type": null, "text": "癡八，大隨遍行"}
{"id": null, "n": null, "target": null, "type": null, "text": "善十，小三，貪、慢、疑與五見"}
{"id": null, "n": null, "target": null, "type": null, "text": "輕安、無慚、無愧、癡，遍行五法，大隨八，中隨二，善十，有輕安并遍行五十\n六"}
{"id": null, "n": null, "target": null, "type": null, "text": "小七，如起一時有；中二，大八，癡及遍行五"}
{"id": null, "n": null, "target": null, "type": null, "text": "自性立名，見分斷惑"}
{"id": null, "n": null, "target": null, "type": null, "text": "倣法解義"}
{"id": null, "n": null, "target": null, "type": null, "text": "倣法立名，見分證理"}
{"id": null, "n": null, "target": null, "type": null, "text": "倣法解義"}
{"id": null, "n": null, "target": null, "type": null, "text": "自性立名，自證證斷"}
{"id": null, "n": null, "target": null, "type": null, "text": "通自性倣法解\n義立名"}
{"id": null, "n": null, "target": null, "type": null, "text": "自性立名，自證分證，見分證理"}
{"id": null, "n": null, "target": null, "type": null, "text": "思現觀，不依九地定生"}
{"id": null, "n": null, "target": null, "type": null, "text": "後三未至定及\n四禪根本"}
{"id": null, "n": null, "target": null, "type": null, "text": "信現觀也"}
{"id": null, "n": null, "target": null, "type": null, "text": "戒現觀，不依九地定\n生"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋名"}
{"id": null, "n": null, "target": null, "type": null, "text": "歎德"}
{"id": null, "n": null, "target": null, "type": null, "text": "揀因位二乘也"}
{"id": null, "n": null, "target": null, "type": null, "text": "羅漢亦具"}
{"id": null, "n": null, "target": null, "type": null, "text": "前三果亦\n具此"}
{"id": null, "n": null, "target": null, "type": null, "text": "凡夫亦具"}
{"id": null, "n": null, "target": null, "type": null, "text": "無學亦具"}
{"id": null, "n": null, "target": null, "type": null, "text": "菩薩亦具"}
{"id": null, "n": null, "target": null, "type": null, "text": "能迷󳢂心謂人之心"}
{"id": null, "n": null, "target": null, "type": null, "text": "所迷󳢂相謂人之執"}
{"id": null, "n": null, "target": null, "type": null, "text": "能迷\n心謂人心"}
{"id": null, "n": null, "target": null, "type": null, "text": "所迷󳢂法空理謂人之執起我"}
{"id": null, "n": null, "target": null, "type": null, "text": "上品別報"}
{"id": null, "n": null, "target": null, "type": null, "text": "上品總報"}
{"id": null, "n": null, "target": null, "type": null, "text": "中品有闕"}
{"id": null, "n": null, "target": null, "type": null, "text": "悔所損無知造"}
{"id": null, "n": null, "target": null, "type": null, "text": "非計所執為緣，能引生心"}
{"id": null, "n": null, "target": null, "type": null, "text": "己者，境也。見能\n變相，相能帶境"}
{"id": null, "n": null, "target": null, "type": null, "text": "是所引能\n緣義"}
{"id": null, "n": null, "target": null, "type": null, "text": "是所緣能帶義"}
{"id": null, "n": null, "target": null, "type": null, "text": "眼耳鼻舌身意"}
{"id": null, "n": null, "target": null, "type": null, "text": "男女二根"}
{"id": null, "n": null, "target": null, "type": null, "text": "命根"}
{"id": null, "n": null, "target": null, "type": null, "text": "五受根也"}
{"id": null, "n": null, "target": null, "type": null, "text": "信等五也"}
{"id": null, "n": null, "target": null, "type": null, "text": "三無漏根"}
{"id": null, "n": null, "target": null, "type": null, "text": "眼等六男女二"}
{"id": null, "n": null, "target": null, "type": null, "text": "命根"}
{"id": null, "n": null, "target": null, "type": null, "text": "五受"}
{"id": null, "n": null, "target": null, "type": null, "text": "信等五三無漏"}
{"id": null, "n": null, "target": null, "type": null, "text": "男、女、憂、苦"}
{"id": null, "n": null, "target": null, "type": null, "text": "除三無漏"}
{"id": null, "n": null, "target": null, "type": null, "text": "十五少分"}
{"id": null, "n": null, "target": null, "type": null, "text": "信等五，意、命、捨"}
{"id": null, "n": null, "target": null, "type": null, "text": "男、女、憂、苦"}
{"id": null, "n": null, "target": null, "type": null, "text": "信等五，三無漏，\n一向不繫，侵二根"}
{"id": null, "n": null, "target": null, "type": null, "text": "三無漏，信等五"}
{"id": null, "n": null, "target": null, "type": null, "text": "眼等五，男、女、命"}
{"id": null, "n": null, "target": null, "type": null, "text": "五，受、意、根"}
{"id": null, "n": null, "target": null, "type": null, "text": "同事"}
{"id": null, "n": null, "target": null, "type": null, "text": "隨說引發定異"}
{"id": null, "n": null, "target": null, "type": null, "text": "觀待牽引，生起攝受，相違不相違"}
{"id": null, "n": null, "target": null, "type": null, "text": "任運無明不發行支"}
{"id": null, "n": null, "target": null, "type": null, "text": "無漏行依正智"}
{"id": null, "n": null, "target": null, "type": null, "text": "正智真如"}
{"id": null, "n": null, "target": null, "type": null, "text": "分別無明發正行支"}
{"id": null, "n": null, "target": null, "type": null, "text": "如生望老死支"}
{"id": null, "n": null, "target": null, "type": null, "text": "如無明望行"}
{"id": null, "n": null, "target": null, "type": null, "text": "增上所"}
{"id": null, "n": null, "target": null, "type": null, "text": "如色望識"}
{"id": null, "n": null, "target": null, "type": null, "text": "有附死立"}
{"id": null, "n": null, "target": null, "type": null, "text": "入定只資二十小劫"}
{"id": null, "n": null, "target": null, "type": null, "text": "入定資一大劫"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "道通"}
{"id": null, "n": "0516001", "target": "#nkr_note_orig_0516001", "type": "orig", "text": "一無減字"}
{"id": null, "n": "0517001", "target": "#nkr_note_orig_0517001", "type": "orig", "text": "□疑於"}
{"id": null, "n": "0517002", "target": "#nkr_note_orig_0517002", "type": "orig", "text": "計隨之間佚失唐紙一張三折三十行"}
{"id": null, "n": "0517003", "target": "#nkr_note_orig_0517003", "type": "orig", "text": "理一作現"}
{"id": null, "n": "0518001", "target": "#nkr_note_orig_0518001", "type": "orig", "text": "而一作品"}
{"id": null, "n": "0518002", "target": "#nkr_note_orig_0518002", "type": "orig", "text": "親下疑脫二文字"}
{"id": null, "n": "0518003", "target": "#nkr_note_orig_0518003", "type": "orig", "text": "理一作現下同"}
{"id": null, "n": "0521001", "target": "#nkr_note_orig_0521001", "type": "orig", "text": "東一作果"}
{"id": null, "n": "0521002", "target": "#nkr_note_orig_0521002", "type": "orig", "text": "起一作超"}
{"id": null, "n": "0522001", "target": "#nkr_note_orig_0522001", "type": "orig", "text": "便一作使"}
{"id": null, "n": "0522002", "target": "#nkr_note_orig_0522002", "type": "orig", "text": "體下一有體字"}
{"id": null, "n": "0526001", "target": "#nkr_note_orig_0526001", "type": "orig", "text": "增疑憎"}
