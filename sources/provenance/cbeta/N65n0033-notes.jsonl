{"id": null, "n": "0174002", "target": "#nkr_note_mod_0174002", "type": "mod", "text": "不遠死於梵天界。"}
{"id": null, "n": "0148001", "target": "#nkr_note_orig_0148001", "type": "orig", "text": "當為印度曆之第二月。"}
{"id": null, "n": "0148002", "target": "#nkr_note_orig_0148002", "type": "orig", "text": "作三十名友人之童子等一團體稱跋陀羅〔善賢〕組。"}
{"id": null, "n": "0148003", "target": "#nkr_note_orig_0148003", "type": "orig", "text": "有優樓頻羅、那提、伽耶之三兄弟迦葉導一千之結鬘行者。"}
{"id": null, "n": "0148004", "target": "#nkr_note_orig_0148004", "type": "orig", "text": "印度曆之第一月。"}
{"id": null, "n": "0148005", "target": "#nkr_note_orig_0148005", "type": "orig", "text": "今之錫蘭島。"}
{"id": null, "n": "0150006", "target": "#nkr_note_orig_0150006", "type": "orig", "text": "協會本為鬱達求羅波耶。"}
{"id": null, "n": "0150007", "target": "#nkr_note_orig_0150007", "type": "orig", "text": "印度曆之第一月。"}
{"id": null, "n": "0151008", "target": "#nkr_note_orig_0151008", "type": "orig", "text": "註為水生類、陸生類、及為龍蛇之類。"}
{"id": null, "n": "0152009", "target": "#nkr_note_orig_0152009", "type": "orig", "text": "或為高價。"}
{"id": null, "n": "0153010", "target": "#nkr_note_orig_0153010", "type": "orig", "text": "以下總就現在而言。即今之摩訶眉伽林園所立之意。"}
{"id": null, "n": "0154001", "target": "#nkr_note_orig_0154001", "type": "orig", "text": "Mahāsammatarāja 譯為世界最初之王，卡許摩訶，卡所許，大平等、大同意、民主、大王等。"}
{"id": null, "n": "0154002", "target": "#nkr_note_orig_0154002", "type": "orig", "text": "卡魯利耶尼與瓦羅卡魯利耶尼。"}
{"id": null, "n": "0154003", "target": "#nkr_note_orig_0154003", "type": "orig", "text": "協會本，為卡魯耶那迦。"}
{"id": null, "n": "0155004", "target": "#nkr_note_orig_0155004", "type": "orig", "text": "梵語 Ikṣvāku 懿摩〔師〕，伊摩，甘庶、為釋迦族之祖次摩訶三摩多為重要之王。"}
{"id": null, "n": "0155005", "target": "#nkr_note_orig_0155005", "type": "orig", "text": "釋尊之祖父。星賀賀努。"}
{"id": null, "n": "0155006", "target": "#nkr_note_orig_0155006", "type": "orig", "text": "釋迦族之分族拘利族之都城。"}
{"id": null, "n": "0155007", "target": "#nkr_note_orig_0155007", "type": "orig", "text": "協會本，為安迦那。"}
{"id": null, "n": "0156008", "target": "#nkr_note_orig_0156008", "type": "orig", "text": "師子頰有四王八子，他書不出此名。"}
{"id": null, "n": "0159001", "target": "#nkr_note_orig_0159001", "type": "orig", "text": "印度曆之第四月。"}
{"id": null, "n": "0160002", "target": "#nkr_note_orig_0160002", "type": "orig", "text": "成阿羅漢果。"}
{"id": null, "n": "0160003", "target": "#nkr_note_orig_0160003", "type": "orig", "text": "於夜明臥於臥牀，頭安枕之剎那而得阿羅漢果故皆非行住坐臥任何之一。"}
{"id": null, "n": "0161004", "target": "#nkr_note_orig_0161004", "type": "orig", "text": "依提伽之解釋。"}
{"id": null, "n": "0162001", "target": "#nkr_note_orig_0162001", "type": "orig", "text": "無妨為適當。"}
{"id": null, "n": "0163002", "target": "#nkr_note_orig_0163002", "type": "orig", "text": "行此羯磨者於信者之面前應取消謝罪言予之言是非法。"}
{"id": null, "n": "0163003", "target": "#nkr_note_orig_0163003", "type": "orig", "text": "akhila，無障礙，除煩惱邪障之自由人，阿羅漢等。"}
{"id": null, "n": "0166004", "target": "#nkr_note_orig_0166004", "type": "orig", "text": "法、義、辭、樂說此四者謂無礙智。"}
{"id": null, "n": "0169001", "target": "#nkr_note_orig_0169001", "type": "orig", "text": "提伽本之二七-二八之間插入次之二偈。但此二偈之一語亦未加註解之點察看，或想非後日之竄入耶？（一）於彼都有死處之鹿豬鳥類，行大斷食而彼等自行死去。（二）此處牛等導欄伴來豹等，而護侍鹿與豬之畑池。"}
{"id": null, "n": "0169002", "target": "#nkr_note_orig_0169002", "type": "orig", "text": "以下之偈號數有二之齟齬。"}
{"id": null, "n": "0172003", "target": "#nkr_note_orig_0172003", "type": "orig", "text": "法句經之不放逸品。"}
{"id": null, "n": "0174001", "target": "#nkr_note_orig_0174001", "type": "orig", "text": "於錫蘭本九七上半偈，攝於「阿育王之轉教」章中。然考前後之關係雖為各半偈故見無分之要，隨協會本讓於次章。"}
{"id": null, "n": "0174002", "target": "#nkr_note_orig_0174002", "type": "orig", "text": "不遠死於於梵天界。"}
{"id": null, "n": "0175003", "target": "#nkr_note_orig_0175003", "type": "orig", "text": "謂未參與第二結集事。"}
{"id": null, "n": "0177004", "target": "#nkr_note_orig_0177004", "type": "orig", "text": "婆羅門謂再生者。"}
{"id": null, "n": "0178005", "target": "#nkr_note_orig_0178005", "type": "orig", "text": "於錫蘭本一五四偈只上半存而下半缺。隨以下之半偈有各各之齟齬，一五五偈之上半，屬於目犍連子帝須長老之出世章，下半則屬於次之章。余如此訂正。"}
{"id": null, "n": "0181006", "target": "#nkr_note_orig_0181006", "type": "orig", "text": "此一偈之上半為錫蘭本。由 PTS 之原典補之。"}
{"id": null, "n": "0182007", "target": "#nkr_note_orig_0182007", "type": "orig", "text": "六學處是受式沙摩那戒法，謂不婬、不盜、不殺、不虛誑語、不飲諸酒，不非時食之六者。而年大之婦女出家者亦受此六戒，二年間守此檢胎之有無，然後授比丘尼大戒。"}
{"id": null, "n": "0182008", "target": "#nkr_note_orig_0182008", "type": "orig", "text": "協會本有阿優波羅。"}
{"id": null, "n": "0183009", "target": "#nkr_note_orig_0183009", "type": "orig", "text": "協會本有昆提。"}
{"id": null, "n": "0186010", "target": "#nkr_note_orig_0186010", "type": "orig", "text": "本生經第三一九話。"}
{"id": null, "n": "0191001", "target": "#nkr_note_orig_0191001", "type": "orig", "text": "二〇節參照。"}
{"id": null, "n": "0192002", "target": "#nkr_note_orig_0192002", "type": "orig", "text": "協會本則為摩西羅提波伽。"}
{"id": null, "n": "0194001", "target": "#nkr_note_orig_0194001", "type": "orig", "text": "協會本為庫宛那。"}
{"id": null, "n": "0196002", "target": "#nkr_note_orig_0196002", "type": "orig", "text": "名阿努羅是侍臣。"}
{"id": null, "n": "0199001", "target": "#nkr_note_orig_0199001", "type": "orig", "text": "是毘闍耶王之弟。"}
{"id": null, "n": "0200002", "target": "#nkr_note_orig_0200002", "type": "orig", "text": "甘露飯王，是淨飯王之弟。"}
{"id": null, "n": "0200003", "target": "#nkr_note_orig_0200003", "type": "orig", "text": "協會本為溝那伽摩伽。"}
{"id": null, "n": "0204001", "target": "#nkr_note_orig_0204001", "type": "orig", "text": "協會本為頓波羅。"}
{"id": null, "n": "0209002", "target": "#nkr_note_orig_0209002", "type": "orig", "text": "母方之祖父兄弟之意。"}
{"id": null, "n": "0210003", "target": "#nkr_note_orig_0210003", "type": "orig", "text": "此偈原文為種種甚難定譯，改用錫蘭本譯出。"}
{"id": null, "n": "0212001", "target": "#nkr_note_orig_0212001", "type": "orig", "text": "協會本為木達西瓦。"}
{"id": null, "n": "0214002", "target": "#nkr_note_orig_0214002", "type": "orig", "text": "印度曆之第九月。"}
{"id": null, "n": "0216001", "target": "#nkr_note_orig_0216001", "type": "orig", "text": "協會本為阿羅瓦羅。"}
{"id": null, "n": "0217002", "target": "#nkr_note_orig_0217002", "type": "orig", "text": "中部第一三〇經（漢譯南傳藏十二．一七二頁）。"}
{"id": null, "n": "0217003", "target": "#nkr_note_orig_0217003", "type": "orig", "text": "相應部因緣篇第四（同十四．二二二頁）。"}
{"id": null, "n": "0217004", "target": "#nkr_note_orig_0217004", "type": "orig", "text": "增支部七集六八（二二．三一九頁）。"}
{"id": null, "n": "0218005", "target": "#nkr_note_orig_0218005", "type": "orig", "text": "同四集二四（同二〇．四六頁）。"}
{"id": null, "n": "0218006", "target": "#nkr_note_orig_0218006", "type": "orig", "text": "律大品一．六（同三．一〇頁）。"}
{"id": null, "n": "0219007", "target": "#nkr_note_orig_0219007", "type": "orig", "text": "長部一（同六．一頁）。"}
{"id": null, "n": "0221001", "target": "#nkr_note_orig_0221001", "type": "orig", "text": "印度曆之第三月。"}
{"id": null, "n": "0221002", "target": "#nkr_note_orig_0221002", "type": "orig", "text": "協會本為西羅峰。"}
{"id": null, "n": "0224001", "target": "#nkr_note_orig_0224001", "type": "orig", "text": "中部第二七經（漢譯南傳藏九．二四三頁）。"}
{"id": null, "n": "0225002", "target": "#nkr_note_orig_0225002", "type": "orig", "text": "增支部二集第四（同一九．八三頁）。"}
{"id": null, "n": "0226003", "target": "#nkr_note_orig_0226003", "type": "orig", "text": "相應部五六。"}
{"id": null, "n": "0227001", "target": "#nkr_note_orig_0227001", "type": "orig", "text": "相應部一二．一九（漢譯南傳藏一四．二七頁）？"}
{"id": null, "n": "0232002", "target": "#nkr_note_orig_0232002", "type": "orig", "text": "協會本為魯奢蘭陀。"}
{"id": null, "n": "0233003", "target": "#nkr_note_orig_0233003", "type": "orig", "text": "協會本為摩訶諾瑪。"}
{"id": null, "n": "0234004", "target": "#nkr_note_orig_0234004", "type": "orig", "text": "協會本為康陀伽蘭陀。"}
{"id": null, "n": "0235005", "target": "#nkr_note_orig_0235005", "type": "orig", "text": "協會本為摩訶孫波。"}
{"id": null, "n": "0237006", "target": "#nkr_note_orig_0237006", "type": "orig", "text": "協會本為沙波難陀。"}
{"id": null, "n": "0239007", "target": "#nkr_note_orig_0239007", "type": "orig", "text": "錫蘭本之一九一-一二〇之二十偈於協會本無，協會本之一九一及二一〇之兩偈於錫蘭本中無。此部分依協會本。"}
{"id": null, "n": "0239008", "target": "#nkr_note_orig_0239008", "type": "orig", "text": "本譯及協會本之一九二偈是錫蘭本二一一偈。即有一九之齟齬。"}
{"id": null, "n": "0239009", "target": "#nkr_note_orig_0239009", "type": "orig", "text": "相應部三．七八、七九師子品（漢譯南傳一五．一二六～一二七頁）？"}
{"id": null, "n": "0239009", "target": "#nkr_note_mod_0239009", "type": "mod", "text": "相應部三．七八、七九師子品（漢譯南傳一五．一二六【南傳】，～一二七頁）？"}
{"id": null, "n": "0240010", "target": "#nkr_note_orig_0240010", "type": "orig", "text": "相應部三之九六。（同一五．二〇三頁）"}
{"id": null, "n": "0240011", "target": "#nkr_note_orig_0240011", "type": "orig", "text": "此一偈錫蘭本中無，故以下之章末為一八之齟齬。"}
{"id": null, "n": "0240012", "target": "#nkr_note_orig_0240012", "type": "orig", "text": "協會本為提伽桑達那。"}
{"id": null, "n": "0242001", "target": "#nkr_note_orig_0242001", "type": "orig", "text": "印度曆之第四月。"}
{"id": null, "n": "0242002", "target": "#nkr_note_orig_0242002", "type": "orig", "text": "相應部中有數經，其中指何者不得考。"}
{"id": null, "n": "0243003", "target": "#nkr_note_orig_0243003", "type": "orig", "text": "指律藏中之犍度篇。入安居犍度章是大品第三章。"}
{"id": null, "n": "0244001", "target": "#nkr_note_orig_0244001", "type": "orig", "text": "印度曆之第八月。"}
{"id": null, "n": "0245002", "target": "#nkr_note_orig_0245002", "type": "orig", "text": "協會本有：「傳語由王得云云。」"}
{"id": null, "n": "0249001", "target": "#nkr_note_orig_0249001", "type": "orig", "text": "印度曆之第七月。"}
{"id": null, "n": "0252002", "target": "#nkr_note_orig_0252002", "type": "orig", "text": "印度曆之第八月。"}
{"id": null, "n": "0253001", "target": "#nkr_note_orig_0253001", "type": "orig", "text": "「有惡印者」之意，指何而不明。"}
{"id": null, "n": "0254002", "target": "#nkr_note_orig_0254002", "type": "orig", "text": "印度曆之第九月。"}
{"id": null, "n": "0256003", "target": "#nkr_note_orig_0256003", "type": "orig", "text": "畢宿。"}
{"id": null, "n": "0260001", "target": "#nkr_note_orig_0260001", "type": "orig", "text": "協會本為提莎羅伽。"}
{"id": null, "n": "0260002", "target": "#nkr_note_orig_0260002", "type": "orig", "text": "三十七年應是阿育王在位之年數。然合上記之十八、十二、四、三、四為四十一年。此繼目中間之年為一年與為二年所生之差。"}
{"id": null, "n": "0261003", "target": "#nkr_note_orig_0261003", "type": "orig", "text": "協會本為摩訶波利。"}
{"id": null, "n": "0262004", "target": "#nkr_note_orig_0262004", "type": "orig", "text": "依協會本，三三偈於「阿濕縛庾闍月之白分第八日，〔長老〕入滅。由此之日而冠彼之名」。而此相當錫蘭本之三三、三四兩偈。而錫蘭本之三六偈之上句，為「六十夏〔彼〕又提耶山已雨安居」而不全之意義，由此如省此，至以下章終止，生一偈半之齟齬。"}
{"id": null, "n": "0263005", "target": "#nkr_note_orig_0263005", "type": "orig", "text": "五八偈由三句而成。"}
{"id": null, "n": "0264001", "target": "#nkr_note_orig_0264001", "type": "orig", "text": "協會本為摩訶西瓦。"}
{"id": null, "n": "0265002", "target": "#nkr_note_orig_0265002", "type": "orig", "text": "協會本為摩庫羅伽。"}
{"id": null, "n": "0265003", "target": "#nkr_note_orig_0265003", "type": "orig", "text": "協會本為吉利內羅瓦哈那伽。"}
{"id": null, "n": "0267004", "target": "#nkr_note_orig_0267004", "type": "orig", "text": "此章，協會本為五王章，錫蘭本為六王章。此前者為摩訶西瓦，蘇羅提薩、塞那、古達伽、阿塞羅，耶羅羅之中塞那、古達伽之二王名為一王之名處理。"}
{"id": null, "n": "0269001", "target": "#nkr_note_orig_0269001", "type": "orig", "text": "協會本為寇陀。"}
{"id": null, "n": "0271002", "target": "#nkr_note_orig_0271002", "type": "orig", "text": "次章八六偈以下參照。"}
{"id": null, "n": "0274001", "target": "#nkr_note_orig_0274001", "type": "orig", "text": "協會本為羅美耶越沙婆。"}
{"id": null, "n": "0274002", "target": "#nkr_note_orig_0274002", "type": "orig", "text": "於外被藏皮膜之意，佛之三十二相之一。"}
{"id": null, "n": "0275003", "target": "#nkr_note_orig_0275003", "type": "orig", "text": "協會本為昆陀利。"}
{"id": null, "n": "0277004", "target": "#nkr_note_orig_0277004", "type": "orig", "text": "「蘇羅」是勇敢之意，起此名於四一隅尼密羅因塞所表現的事實，提伽註此。"}
{"id": null, "n": "0277005", "target": "#nkr_note_orig_0277005", "type": "orig", "text": "協會本為尼多羅義提伽。"}
{"id": null, "n": "0278006", "target": "#nkr_note_orig_0278006", "type": "orig", "text": "協會本為庫頓毘揚伽那。"}
{"id": null, "n": "0279007", "target": "#nkr_note_orig_0279007", "type": "orig", "text": "協會本為那庫羅那伽。"}
{"id": null, "n": "0279008", "target": "#nkr_note_orig_0279008", "type": "orig", "text": "協會本為伽義陀。"}
{"id": null, "n": "0280009", "target": "#nkr_note_orig_0280009", "type": "orig", "text": "協會本為睹羅達羅。"}
{"id": null, "n": "0283001", "target": "#nkr_note_orig_0283001", "type": "orig", "text": "協會本為奢瓦摩羅。"}
{"id": null, "n": "0284002", "target": "#nkr_note_orig_0284002", "type": "orig", "text": "協會本為「皮膚」。"}
{"id": null, "n": "0285003", "target": "#nkr_note_orig_0285003", "type": "orig", "text": "年少之僧等推舉臥塌於頭上，如斯擔出。"}
{"id": null, "n": "0290001", "target": "#nkr_note_orig_0290001", "type": "orig", "text": "單謂同逝瑟多月。"}
{"id": null, "n": "0290002", "target": "#nkr_note_orig_0290002", "type": "orig", "text": "協會本為波周陀。"}
{"id": null, "n": "0291003", "target": "#nkr_note_orig_0291003", "type": "orig", "text": "於一本中有庫蘭達瓦毘。協會本、錫蘭本共為庫羅達瓦毘。"}
{"id": null, "n": "0297001", "target": "#nkr_note_orig_0297001", "type": "orig", "text": "在提伽有「百四十六年」。協會本為「百三十六年」。"}
{"id": null, "n": "0297002", "target": "#nkr_note_orig_0297002", "type": "orig", "text": "以籌食卷交換而給食。隨八籌食是八人分之食。"}
{"id": null, "n": "0297003", "target": "#nkr_note_orig_0297003", "type": "orig", "text": "協會本為毘羅尼。"}
{"id": null, "n": "0299004", "target": "#nkr_note_orig_0299004", "type": "orig", "text": "言獅子、牛、象、水瓶、扇、幡、螺、燈之八種。"}
{"id": null, "n": "0301001", "target": "#nkr_note_orig_0301001", "type": "orig", "text": "依提伽，先植大菩提樹之日，來大精舍之摩魯毘耶帝須與摩訶哂陀兩長老之間交談之傳說，為刻於金牒之古傳說。"}
{"id": null, "n": "0303002", "target": "#nkr_note_orig_0303002", "type": "orig", "text": "在協會本，於此之上有「信士！今汝亦行此之道」之半偈，隨以下錫蘭本之半偈為齟齬。"}
{"id": null, "n": "0303003", "target": "#nkr_note_orig_0303003", "type": "orig", "text": "上之九偈參照。"}
{"id": null, "n": "0303004", "target": "#nkr_note_orig_0303004", "type": "orig", "text": "五-八偈以下參照。"}
{"id": null, "n": "0305001", "target": "#nkr_note_orig_0305001", "type": "orig", "text": "由阿耨達地流出之河〔註〕。"}
{"id": null, "n": "0305002", "target": "#nkr_note_orig_0305002", "type": "orig", "text": "五味中之第三為生酥。"}
{"id": null, "n": "0305003", "target": "#nkr_note_orig_0305003", "type": "orig", "text": "上之三、四偈參照。"}
{"id": null, "n": "0305004", "target": "#nkr_note_orig_0305004", "type": "orig", "text": "原語 rasodaka 雖為〔味水〕，隨原書舊英譯為椰子樹液，與伽毘陀樹液相混合則成為如塑膠堅固之物。"}
{"id": null, "n": "0305005", "target": "#nkr_note_orig_0305005", "type": "orig", "text": "行定礎式。"}
{"id": null, "n": "0308006", "target": "#nkr_note_orig_0308006", "type": "orig", "text": "註為金甎。"}
{"id": null, "n": "0308007", "target": "#nkr_note_orig_0308007", "type": "orig", "text": "經集第二品第四經。"}
{"id": null, "n": "0312001", "target": "#nkr_note_orig_0312001", "type": "orig", "text": "王雖對一塊土不付代價亦不用來建造此塔，然此比丘（二一以下）持來一握之土塊奉獻。王以素馨花獻與比丘，比丘由受此花之供養為支付土塊代價。"}
{"id": null, "n": "0312002", "target": "#nkr_note_orig_0312002", "type": "orig", "text": "協會本為寇提瓦羅。"}
{"id": null, "n": "0313003", "target": "#nkr_note_orig_0313003", "type": "orig", "text": "四二～五〇提伽亦未加註，非後日之入竈四一偈完畢，雖有「傳王命之言」，以下應有彼王命，却沒有。概為逸脫耶？"}
{"id": null, "n": "0316004", "target": "#nkr_note_orig_0316004", "type": "orig", "text": "長部第二〇經（漢譯南傳藏七．二一二頁）。"}
{"id": null, "n": "0316005", "target": "#nkr_note_orig_0316005", "type": "orig", "text": "中部第六一經（同一〇．一七二頁）。"}
{"id": null, "n": "0316006", "target": "#nkr_note_orig_0316006", "type": "orig", "text": "經集第二小品第四經（同二七．七〇頁）。"}
{"id": null, "n": "0316007", "target": "#nkr_note_orig_0316007", "type": "orig", "text": "大般涅槃經第三誦品之九（同七．五七頁），自說經六．七（同二六．一三四）參照。"}
{"id": null, "n": "0316008", "target": "#nkr_note_orig_0316008", "type": "orig", "text": "大般涅槃經四．六（同七．七九頁）自說經八．五（同二六．一五八頁）參照。"}
{"id": null, "n": "0316009", "target": "#nkr_note_orig_0316009", "type": "orig", "text": "大般涅槃經四．三五（同七．八七頁）參照。"}
{"id": null, "n": "0316010", "target": "#nkr_note_orig_0316010", "type": "orig", "text": "大般涅槃經三．二一（同七．八一頁）自說經八．五（同二六．一六〇頁）參照。"}
{"id": null, "n": "0316011", "target": "#nkr_note_orig_0316011", "type": "orig", "text": "本生經第五四七（同四二．一七四頁）參照。"}
{"id": null, "n": "0319001", "target": "#nkr_note_orig_0319001", "type": "orig", "text": "協會本為難多多羅。"}
{"id": null, "n": "0322002", "target": "#nkr_note_orig_0322002", "type": "orig", "text": "nāga〔那伽〕是龍、象，人中殊勝者等之意，此兩那伽之戰是瓦蘇羅多陀〔龍〕與蘇努陀羅〔人〕舍利之爭。"}
{"id": null, "n": "0323003", "target": "#nkr_note_orig_0323003", "type": "orig", "text": "般闍西迦為五髻天子。見天子之名提波魯。然此一偈得譯為「般奢西迦續彈奏琵琶而立於彼所，奏樂器之提波魯化作音樂堂」。"}
{"id": null, "n": "0326004", "target": "#nkr_note_orig_0326004", "type": "orig", "text": "於協會本為一二五偈，加入「如斯諸佛不可思議，諸佛之法〔亦〕不可思議。不可思議持淨信心者，果報亦不可思議」。一七章五六偈參照。"}
{"id": null, "n": "0328001", "target": "#nkr_note_orig_0328001", "type": "orig", "text": "提羅弗陀阿婆耶長老此為大戰士之後身。「長老子無畏」之意，一三偈之提羅陀阿婆耶亦同義。"}
{"id": null, "n": "0329002", "target": "#nkr_note_orig_0329002", "type": "orig", "text": "協會本為寇陀。"}
{"id": null, "n": "0330003", "target": "#nkr_note_orig_0330003", "type": "orig", "text": "協會本為摩羅耶摩訶提婆長老。"}
{"id": null, "n": "0331004", "target": "#nkr_note_orig_0331004", "type": "orig", "text": "協會本為鬱伽那伽羅。"}
{"id": null, "n": "0334001", "target": "#nkr_note_orig_0334001", "type": "orig", "text": "協會本為伽羅伽雷那。"}
{"id": null, "n": "0334002", "target": "#nkr_note_orig_0334002", "type": "orig", "text": "協會本為伽蘭波伽。"}
{"id": null, "n": "0334003", "target": "#nkr_note_orig_0334003", "type": "orig", "text": "協會本為蘭伽提沙。"}
{"id": null, "n": "0335004", "target": "#nkr_note_orig_0335004", "type": "orig", "text": "協會本為蘭伽加。"}
{"id": null, "n": "0335005", "target": "#nkr_note_orig_0335005", "type": "orig", "text": "協會本為六衣。"}
{"id": null, "n": "0335006", "target": "#nkr_note_orig_0335006", "type": "orig", "text": "協會本為昆奢羅喜那加。"}
{"id": null, "n": "0335007", "target": "#nkr_note_orig_0335007", "type": "orig", "text": "施捨比丘尼等所欲之米穀。"}
{"id": null, "n": "0335008", "target": "#nkr_note_orig_0335008", "type": "orig", "text": "協會本為庫倫達瓦蘇伽。"}
{"id": null, "n": "0336009", "target": "#nkr_note_orig_0336009", "type": "orig", "text": "協會本為康摩訶羅他伽。"}
{"id": null, "n": "0336010", "target": "#nkr_note_orig_0336010", "type": "orig", "text": "協會本為羅哈那庫羅。"}
{"id": null, "n": "0336011", "target": "#nkr_note_orig_0336011", "type": "orig", "text": "協會本為提沙。"}
{"id": null, "n": "0336012", "target": "#nkr_note_orig_0336012", "type": "orig", "text": "四三、四四上之一偈半協會本中無。"}
{"id": null, "n": "0337013", "target": "#nkr_note_orig_0337013", "type": "orig", "text": "協會本為窟毘羅伽羅摩訶提沙。"}
{"id": null, "n": "0337014", "target": "#nkr_note_orig_0337014", "type": "orig", "text": "托鉢所得食物不觸，而給在家人食是非法。然此長老先自食少分，餘施王。"}
{"id": null, "n": "0337015", "target": "#nkr_note_orig_0337015", "type": "orig", "text": "協會本為尸羅蘇波康達伽。"}
{"id": null, "n": "0337016", "target": "#nkr_note_orig_0337016", "type": "orig", "text": "協會本為普羅哈陀。"}
{"id": null, "n": "0337017", "target": "#nkr_note_orig_0337017", "type": "orig", "text": "協會本為達提伽。"}
{"id": null, "n": "0339018", "target": "#nkr_note_orig_0339018", "type": "orig", "text": "第十章九七偈參照。"}
{"id": null, "n": "0343001", "target": "#nkr_note_orig_0343001", "type": "orig", "text": "協會本為洽羅伽瑪。"}
{"id": null, "n": "0343002", "target": "#nkr_note_orig_0343002", "type": "orig", "text": "在協會本之一四偈上句，有「謂與己妻飲毒而死」隨以下半偈之有齟齬，至二六偈之上句。"}
{"id": null, "n": "0344003", "target": "#nkr_note_orig_0344003", "type": "orig", "text": "協會本為尼利耶。"}
{"id": null, "n": "0344004", "target": "#nkr_note_orig_0344004", "type": "orig", "text": "二六偈之下句在協會本無。"}
{"id": null, "n": "0344005", "target": "#nkr_note_orig_0344005", "type": "orig", "text": "協會本為具達康那．達沙。"}
{"id": null, "n": "0344006", "target": "#nkr_note_orig_0344006", "type": "orig", "text": "協會本為安巴頭伽。"}
{"id": null, "n": "0346007", "target": "#nkr_note_orig_0346007", "type": "orig", "text": "協會本為姆奢羅。"}
{"id": null, "n": "0347008", "target": "#nkr_note_orig_0347008", "type": "orig", "text": "協會本為摩訶達提伽。"}
{"id": null, "n": "0348009", "target": "#nkr_note_orig_0348009", "type": "orig", "text": "協會本為具普康達。"}
{"id": null, "n": "0348010", "target": "#nkr_note_orig_0348010", "type": "orig", "text": "協會本為福瓦奢。"}
{"id": null, "n": "0348011", "target": "#nkr_note_orig_0348011", "type": "orig", "text": "協會本為曼多瓦毘。"}
{"id": null, "n": "0350001", "target": "#nkr_note_orig_0350001", "type": "orig", "text": "協會本為摩訶伽門提池。"}
{"id": null, "n": "0350002", "target": "#nkr_note_orig_0350002", "type": "orig", "text": "協會本為伽尼羅伽努．提沙。"}
{"id": null, "n": "0350003", "target": "#nkr_note_orig_0350003", "type": "orig", "text": "協會本為後那伽。"}
{"id": null, "n": "0350004", "target": "#nkr_note_orig_0350004", "type": "orig", "text": "協會本為秋羅伽羅伽。"}
{"id": null, "n": "0351005", "target": "#nkr_note_orig_0351005", "type": "orig", "text": "協會本為月面西瓦。"}
{"id": null, "n": "0351006", "target": "#nkr_note_orig_0351006", "type": "orig", "text": "本生經第二五〇與第四〇四均有。"}
{"id": null, "n": "0352007", "target": "#nkr_note_orig_0352007", "type": "orig", "text": "協會本為漢伽羅毘提伽。"}
{"id": null, "n": "0353008", "target": "#nkr_note_orig_0353008", "type": "orig", "text": "阿巴耶吉利伊哈羅與摩訶伊哈羅。"}
{"id": null, "n": "0353009", "target": "#nkr_note_orig_0353009", "type": "orig", "text": "蒟醬在熱帶地常嚙口之物，葛草之葉，檳榔子實作碎之物，加入少量石灰。"}
{"id": null, "n": "0354010", "target": "#nkr_note_orig_0354010", "type": "orig", "text": "協會本為波達。"}
{"id": null, "n": "0355011", "target": "#nkr_note_orig_0355011", "type": "orig", "text": "協會本為阿努羅園。"}
{"id": null, "n": "0355012", "target": "#nkr_note_orig_0355012", "type": "orig", "text": "協會本為波達。"}
{"id": null, "n": "0355013", "target": "#nkr_note_orig_0355013", "type": "orig", "text": "協會本為洽央提。"}
{"id": null, "n": "0355014", "target": "#nkr_note_orig_0355014", "type": "orig", "text": "協會本為摩訶尼伽瓦提。"}
{"id": null, "n": "0355015", "target": "#nkr_note_orig_0355015", "type": "orig", "text": "協會本為摩訶羅霉提。"}
{"id": null, "n": "0355016", "target": "#nkr_note_orig_0355016", "type": "orig", "text": "協會本為庫哈羅。"}
{"id": null, "n": "0355017", "target": "#nkr_note_orig_0355017", "type": "orig", "text": "協會本為洽耶達曼伽那。"}
{"id": null, "n": "0355018", "target": "#nkr_note_orig_0355018", "type": "orig", "text": "協會本為阿吉瓦達摩那伽。"}
{"id": null, "n": "0357019", "target": "#nkr_note_orig_0357019", "type": "orig", "text": "協會本為後那。"}
{"id": null, "n": "0357020", "target": "#nkr_note_orig_0357020", "type": "orig", "text": "協會本為羅姆伽。"}
{"id": null, "n": "0357021", "target": "#nkr_note_orig_0357021", "type": "orig", "text": "協會本為賽伽羅伽。"}
{"id": null, "n": "0357022", "target": "#nkr_note_orig_0357022", "type": "orig", "text": "協會本為構達巴巴達。"}
{"id": null, "n": "0357023", "target": "#nkr_note_orig_0357023", "type": "orig", "text": "協會本為達那威利。"}
{"id": null, "n": "0357024", "target": "#nkr_note_orig_0357024", "type": "orig", "text": "協會本為吉利哈利伽。"}
{"id": null, "n": "0360001", "target": "#nkr_note_orig_0360001", "type": "orig", "text": "協會本為摩訶摩尼。"}
{"id": null, "n": "0360002", "target": "#nkr_note_orig_0360002", "type": "orig", "text": "協會本為波提、提沙。"}
{"id": null, "n": "0360003", "target": "#nkr_note_orig_0360003", "type": "orig", "text": "協會本十八年。"}
{"id": null, "n": "0361004", "target": "#nkr_note_orig_0361004", "type": "orig", "text": "協會本為難達提沙。"}
{"id": null, "n": "0361005", "target": "#nkr_note_orig_0361005", "type": "orig", "text": "協會本為庫奢那伽。"}
{"id": null, "n": "0361006", "target": "#nkr_note_orig_0361006", "type": "orig", "text": "協會本為昆奢那伽。"}
{"id": null, "n": "0361007", "target": "#nkr_note_orig_0361007", "type": "orig", "text": "一那利伽量謂四掌量。飢饉人人之一日食量一那利伽謂為被減之事耶？"}
{"id": null, "n": "0362008", "target": "#nkr_note_orig_0362008", "type": "orig", "text": "協會本為加普伽。"}
{"id": null, "n": "0362009", "target": "#nkr_note_orig_0362009", "type": "orig", "text": "協會本為庫羅提沙。"}
{"id": null, "n": "0362010", "target": "#nkr_note_orig_0362010", "type": "orig", "text": "協會本為姆羅那伽。"}
{"id": null, "n": "0363011", "target": "#nkr_note_orig_0363011", "type": "orig", "text": "協會本為耶多魯耶。"}
{"id": null, "n": "0364012", "target": "#nkr_note_orig_0364012", "type": "orig", "text": "協會本為達摩哈羅伽。"}
{"id": null, "n": "0364013", "target": "#nkr_note_orig_0364013", "type": "orig", "text": "Andhaka-vinda-sutta 雜阿含四四卷一四經空閑處。"}
{"id": null, "n": "0367014", "target": "#nkr_note_orig_0367014", "type": "orig", "text": "Padhānabhūmi 入於三昧真實修行場所之意。"}
{"id": null, "n": "0373001", "target": "#nkr_note_orig_0373001", "type": "orig", "text": "協會本為耶羅伽乞羅。"}
{"id": null, "n": "0373002", "target": "#nkr_note_orig_0373002", "type": "orig", "text": "協會本為塔園。"}
{"id": null, "n": "0373003", "target": "#nkr_note_orig_0373003", "type": "orig", "text": "協會本為富羅毘提。"}
{"id": null, "n": "0373004", "target": "#nkr_note_orig_0373004", "type": "orig", "text": "協會本為瑪尼喜羅．摩訶伽瑪。"}
{"id": null, "n": "0373005", "target": "#nkr_note_orig_0373005", "type": "orig", "text": "協會本為洽魯羅。"}
{"id": null, "n": "0373006", "target": "#nkr_note_orig_0373006", "type": "orig", "text": "協會本為丹瑪蘭瑪。"}
{"id": null, "n": "0373007", "target": "#nkr_note_orig_0373007", "type": "orig", "text": "協會本缺。"}
{"id": null, "n": "0373008", "target": "#nkr_note_orig_0373008", "type": "orig", "text": "協會本為瓦哈那。"}
{"id": null, "n": "0373009", "target": "#nkr_note_orig_0373009", "type": "orig", "text": "協會本為摩訶伽羅伽。"}
