{"id": null, "n": null, "target": null, "type": "cf1", "text": "《嘉興藏》（日本東京大學綜合圖書館藏正編第201帙第5冊第61圖左欄第9行）"}
{"id": null, "n": "0681001", "target": "#nkr_note_orig_0681001", "type": "orig", "text": "【原】增上寺報恩藏明本"}
{"id": null, "n": "0683b0101", "target": "#nkr_note_add_0683b0101", "type": "add", "text": "用【CB】，月【大】"}
{"id": null, "n": "0684a0801", "target": "#nkr_note_add_0684a0801", "type": "add", "text": "醍醐【CB】，醐醍【大】"}
{"id": null, "n": "0688a0101", "target": "#nkr_note_add_0688a0101", "type": "add", "text": "𣀇【CB】，󱅯【大】"}
{"id": null, "n": "0708c0501", "target": "#nkr_note_add_0708c0501", "type": "add", "text": "苦【CB】，忍【大】"}
{"id": null, "n": "0719b2801", "target": "#nkr_note_add_0719b2801", "type": "add", "text": "趺【CB】，跌【大】"}
{"id": null, "n": "0719b2802", "target": "#nkr_note_add_0719b2802", "type": "add", "text": "󰈷【CB】，𬧅【大】"}
{"id": null, "n": "0745c1701", "target": "#nkr_note_add_0745c1701", "type": "add", "text": "住【CB】，在【大】"}
{"id": null, "n": "0753a2401", "target": "#nkr_note_add_0753a2401", "type": "add", "text": "󰈷【CB】，𬧅【大】"}
{"id": null, "n": "0755b2901", "target": "#nkr_note_add_0755b2901", "type": "add", "text": "三【CB】，二【大】"}
{"id": null, "n": "0755c1701", "target": "#nkr_note_add_0755c1701", "type": "add", "text": "CBETA 按：「喜根」應作「勝意」，相關典故可參考《諸法無行經》（T15n0650_p0759a23-p0761a26）。宋．從義撰《法華經三大部補注》載：「《妙玄》下文云『喜根雖謗』者，誤也，應云『勝意』也。」（X28n0586_p0169b05-06）"}
{"id": null, "n": "0759b1401", "target": "#nkr_note_add_0759b1401", "type": "add", "text": "諂【CB】，謟【大】"}
{"id": null, "n": "0760a1001", "target": "#nkr_note_add_0760a1001", "type": "add", "text": "若【CB】，苦【大】"}
{"id": null, "n": "0775a2301", "target": "#nkr_note_add_0775a2301", "type": "add", "text": "流【CB】，泒【大】"}
{"id": null, "n": "0779b2601", "target": "#nkr_note_add_0779b2601", "type": "add", "text": "二【CB】，三【大】"}
{"id": null, "n": "0781c1001", "target": "#nkr_note_add_0781c1001", "type": "add", "text": "五【CB】，正【大】"}
{"id": null, "n": "0790a1001", "target": "#nkr_note_add_0790a1001", "type": "add", "text": "苦【CB】，若【大】"}
{"id": null, "n": "0804b2101", "target": "#nkr_note_add_0804b2101", "type": "add", "text": "宗【CB】【嘉興乙-CB】，經【大】"}
{"id": null, "n": "0810b0301", "target": "#nkr_note_add_0810b0301", "type": "add", "text": "說【CB】，脫【大】"}
