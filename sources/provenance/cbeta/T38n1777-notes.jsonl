{"id": null, "n": "0538001", "target": "#nkr_note_mod_0538001", "type": "mod", "text": "二【大】，三【考偽-大】"}
{"id": null, "n": "0544001", "target": "#nkr_note_mod_0544001", "type": "mod", "text": "在【大】，此【考偽-大】"}
{"id": null, "n": "0546001", "target": "#nkr_note_mod_0546001", "type": "mod", "text": "明【大】，約【考偽-大】"}
{"id": null, "n": "0553001", "target": "#nkr_note_mod_0553001", "type": "mod", "text": "九【大】，也【考偽-大】"}
{"id": null, "n": "0553002", "target": "#nkr_note_mod_0553002", "type": "mod", "text": "不【大】，〔－〕【考偽-大】"}
{"id": null, "n": "0558001", "target": "#nkr_note_mod_0558001", "type": "mod", "text": "起【大】，赴【考偽-大】"}
{"id": null, "n": "0562001", "target": "#nkr_note_mod_0562001", "type": "mod", "text": "修【大】，種【考偽-大】"}
{"id": null, "n": "0562002", "target": "#nkr_note_mod_0562002", "type": "mod", "text": "（維摩…六）八字【大】，〔－〕【甲】"}
{"id": null, "n": "0519001", "target": "#nkr_note_orig_0519001", "type": "orig", "text": "【原】正保五年刊龍谷大學藏本，【甲】貞享三年刊宗教大學藏本"}
{"id": null, "n": "0538001", "target": "#nkr_note_orig_0538001", "type": "orig", "text": "二＝三？"}
{"id": null, "n": "0544001", "target": "#nkr_note_orig_0544001", "type": "orig", "text": "在＝此？"}
{"id": null, "n": "0546001", "target": "#nkr_note_orig_0546001", "type": "orig", "text": "明＝約？"}
{"id": null, "n": "0553001", "target": "#nkr_note_orig_0553001", "type": "orig", "text": "九＝也？"}
{"id": null, "n": "0553002", "target": "#nkr_note_orig_0553002", "type": "orig", "text": "〔不〕－？"}
{"id": null, "n": "0557001", "target": "#nkr_note_orig_0557001", "type": "orig", "text": "名下恐有脫字"}
{"id": null, "n": "0558001", "target": "#nkr_note_orig_0558001", "type": "orig", "text": "起＝赴？"}
{"id": null, "n": "0562001", "target": "#nkr_note_orig_0562001", "type": "orig", "text": "修＝種？"}
{"id": null, "n": "0562002", "target": "#nkr_note_orig_0562002", "type": "orig", "text": "〔維摩…六〕八字－【甲】"}
