{"id": null, "n": null, "target": null, "type": "cf1", "text": "K11n0262_p0580a20"}
{"id": null, "n": "0799011", "target": "#nkr_note_mod_0799011", "type": "mod", "text": "佛【大】＊，像【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0799012", "target": "#nkr_note_mod_0799012", "type": "mod", "text": "大唐沙門釋義淨【大】，唐三藏法師義淨奉詔【宋】【元】【明】，唐三藏法師義靜奉詔【宮】"}
{"id": null, "n": "0800001", "target": "#nkr_note_mod_0800001", "type": "mod", "text": "荼【大】，茶【宋】【元】【宮】"}
{"id": null, "n": "0800002", "target": "#nkr_note_mod_0800002", "type": "mod", "text": "土【大】，二【明】"}
{"id": null, "n": "0800003", "target": "#nkr_note_mod_0800003", "type": "mod", "text": "香【大】，熏【元】【明】"}
{"id": null, "n": "0800004", "target": "#nkr_note_mod_0800004", "type": "mod", "text": "淨智【大】，智淨【宋】【宮】"}
{"id": null, "n": "0799011", "target": "#nkr_note_orig_0799011", "type": "orig", "text": "佛＝像【三】【宮】＊"}
{"id": null, "n": "0799012", "target": "#nkr_note_orig_0799012", "type": "orig", "text": "大唐沙門釋義淨＝唐三藏法師義淨奉詔【三】【宮】，但宮本淨作靜"}
{"id": null, "n": "0800001", "target": "#nkr_note_orig_0800001", "type": "orig", "text": "荼＝茶【宋】【元】【宮】"}
{"id": null, "n": "0800002", "target": "#nkr_note_orig_0800002", "type": "orig", "text": "土＝二【明】"}
{"id": null, "n": "0800003", "target": "#nkr_note_orig_0800003", "type": "orig", "text": "香＝熏【元】【明】"}
{"id": null, "n": "0800004", "target": "#nkr_note_orig_0800004", "type": "orig", "text": "淨智＝智淨【宋】【宮】"}
{"id": null, "n": "0800b2201", "target": "#nkr_note_add_0800b2201", "type": "add", "text": "濾【CB】【麗-CB】，瀘【大】"}
