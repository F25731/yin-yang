{"id": null, "n": "0888004", "target": "#nkr_note_mod_0888004", "type": "mod", "text": "西【大】，宋西【明】"}
{"id": null, "n": "0888005", "target": "#nkr_note_mod_0888005", "type": "mod", "text": "譯經【大】，〔－〕【明】"}
{"id": null, "n": "0888006", "target": "#nkr_note_mod_0888006", "type": "mod", "text": "法【大】，教【宋】【元】【明】"}
{"id": null, "n": "0888007", "target": "#nkr_note_mod_0888007", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0888008", "target": "#nkr_note_mod_0888008", "type": "mod", "text": "值【大】，直【明】"}
{"id": null, "n": "0888009", "target": "#nkr_note_mod_0888009", "type": "mod", "text": "志【大】＊，至【元】【明】＊"}
{"id": null, "n": "0888010", "target": "#nkr_note_mod_0888010", "type": "mod", "text": "茶【大】，荼【宋】【元】"}
{"id": null, "n": "0888011", "target": "#nkr_note_mod_0888011", "type": "mod", "text": "引一【大】，一引【宋】【元】，引【明】"}
{"id": null, "n": "0888012", "target": "#nkr_note_mod_0888012", "type": "mod", "text": "桉【大】，按【宋】【元】【明】"}
{"id": null, "n": "0888013", "target": "#nkr_note_mod_0888013", "type": "mod", "text": "二【大】，三【宋】【元】"}
{"id": null, "n": "0889001", "target": "#nkr_note_mod_0889001", "type": "mod", "text": "由【大】，猶【元】【明】"}
{"id": null, "n": "0889002", "target": "#nkr_note_mod_0889002", "type": "mod", "text": "陀【大】，此陀【宋】【元】【明】"}
{"id": null, "n": "0889003", "target": "#nkr_note_mod_0889003", "type": "mod", "text": "信【大】，敬【宋】【元】【明】"}
{"id": null, "n": "0888003", "target": "#nkr_note_orig_0888003", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0888004", "target": "#nkr_note_orig_0888004", "type": "orig", "text": "（宋）＋西【明】"}
{"id": null, "n": "0888005", "target": "#nkr_note_orig_0888005", "type": "orig", "text": "〔譯經〕－【明】"}
{"id": null, "n": "0888006", "target": "#nkr_note_orig_0888006", "type": "orig", "text": "法＝教【三】"}
{"id": null, "n": "0888007", "target": "#nkr_note_orig_0888007", "type": "orig", "text": "〔臣〕－【明】"}
{"id": null, "n": "0888008", "target": "#nkr_note_orig_0888008", "type": "orig", "text": "值＝直【明】"}
{"id": null, "n": "0888009", "target": "#nkr_note_orig_0888009", "type": "orig", "text": "志＝至【元】【明】＊"}
{"id": null, "n": "0888010", "target": "#nkr_note_orig_0888010", "type": "orig", "text": "茶＝荼【宋】【元】"}
{"id": null, "n": "0888011", "target": "#nkr_note_orig_0888011", "type": "orig", "text": "引一＝一引【宋】【元】，〔一〕－【明】"}
{"id": null, "n": "0888012", "target": "#nkr_note_orig_0888012", "type": "orig", "text": "桉＝按【三】"}
{"id": null, "n": "0888013", "target": "#nkr_note_orig_0888013", "type": "orig", "text": "二＝三【宋】【元】"}
{"id": null, "n": "0889001", "target": "#nkr_note_orig_0889001", "type": "orig", "text": "由＝猶【元】【明】"}
{"id": null, "n": "0889002", "target": "#nkr_note_orig_0889002", "type": "orig", "text": "（此）＋陀【三】"}
{"id": null, "n": "0889003", "target": "#nkr_note_orig_0889003", "type": "orig", "text": "信＝敬【三】"}
