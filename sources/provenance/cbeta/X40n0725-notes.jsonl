{"id": null, "n": null, "target": null, "type": null, "text": "除病"}
{"id": null, "n": null, "target": null, "type": null, "text": "除病"}
{"id": null, "n": null, "target": null, "type": null, "text": "除病"}
{"id": null, "n": null, "target": null, "type": null, "text": "除病○二百五十"}
{"id": null, "n": null, "target": null, "type": null, "text": "除病"}
{"id": null, "n": null, "target": null, "type": null, "text": "富羅是短脛靴，佛聽寒雪國著之"}
{"id": null, "n": null, "target": null, "type": null, "text": "二百六十"}
{"id": null, "n": null, "target": null, "type": null, "text": "二百七十"}
{"id": null, "n": null, "target": null, "type": null, "text": "除病"}
{"id": null, "n": null, "target": null, "type": null, "text": "除病○二百八十"}
{"id": null, "n": null, "target": null, "type": null, "text": "除病"}
{"id": null, "n": null, "target": null, "type": null, "text": "除病"}
{"id": null, "n": null, "target": null, "type": null, "text": "除病"}
{"id": null, "n": null, "target": null, "type": null, "text": "除病"}
{"id": null, "n": null, "target": null, "type": null, "text": "除難因緣"}
{"id": null, "n": null, "target": null, "type": null, "text": "除病"}
{"id": null, "n": null, "target": null, "type": null, "text": "除病"}
{"id": null, "n": null, "target": null, "type": null, "text": "除病"}
{"id": null, "n": null, "target": null, "type": null, "text": "除病"}
{"id": null, "n": null, "target": null, "type": null, "text": "除病○二百九十法竟"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說而去。○阿梨耶，此言聖者。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此云親教師"}
{"id": null, "n": null, "target": null, "type": null, "text": "此云軌範師"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘二百九十一法中有犯，隨所犯事稱之"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說。彼尼答言："}
{"id": null, "n": null, "target": null, "type": null, "text": "自答言："}
{"id": null, "n": null, "target": null, "type": null, "text": "若非二師，應稱大姊或阿姨。"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "音既。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音牒。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上音瘡，下音有。"}
{"id": null, "n": null, "target": null, "type": null, "text": "閃字入聲。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音域。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音窄。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音燮"}
{"id": null, "n": null, "target": null, "type": null, "text": "八卷"}
{"id": null, "n": "0778001", "target": "#nkr_note_orig_0778001", "type": "orig", "text": "目錄新作"}
