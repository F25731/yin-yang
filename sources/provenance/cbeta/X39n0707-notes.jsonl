{"id": null, "n": null, "target": null, "type": null, "text": "答云：「僧已集。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "答云：「和合。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "若有，即遣出。答\n云：「未受具戒者已出。」若無，即云：「此眾無未受具戒者。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "若有人說欲，即云：「說欲及清淨已。」若無人傳欲，即云：「此眾無說欲及清淨者。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "答云：「此眾無尼來請教誡。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "答云：「說戒羯磨。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "或黑月十五日、或十四日，不定"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "三說"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "連。"}
{"id": null, "n": null, "target": null, "type": null, "text": "女久。"}
{"id": null, "n": null, "target": null, "type": null, "text": "作管。"}
{"id": null, "n": null, "target": null, "type": null, "text": "七入。"}
{"id": null, "n": null, "target": null, "type": null, "text": "符分。"}
{"id": null, "n": null, "target": null, "type": null, "text": "市流。"}
{"id": null, "n": null, "target": null, "type": null, "text": "陟革。"}
{"id": null, "n": null, "target": null, "type": null, "text": "尺氏。"}
{"id": null, "n": null, "target": null, "type": null, "text": "毗至。"}
{"id": null, "n": null, "target": null, "type": null, "text": "澂。"}
{"id": null, "n": null, "target": null, "type": null, "text": "去魚。"}
{"id": null, "n": null, "target": null, "type": null, "text": "直列。"}
{"id": null, "n": null, "target": null, "type": null, "text": "衫。"}
{"id": null, "n": null, "target": null, "type": null, "text": "餘制。"}
{"id": null, "n": null, "target": null, "type": null, "text": "崖亦通牙。"}
{"id": null, "n": null, "target": null, "type": null, "text": "戶瞎。"}
{"id": null, "n": null, "target": null, "type": null, "text": "去劫。"}
{"id": null, "n": null, "target": null, "type": null, "text": "連下三說，下同。"}
{"id": null, "n": null, "target": null, "type": null, "text": "力為。"}
{"id": null, "n": null, "target": null, "type": null, "text": "頂。"}
{"id": null, "n": null, "target": null, "type": null, "text": "句絕。"}
{"id": null, "n": null, "target": null, "type": null, "text": "陟格。"}
{"id": null, "n": null, "target": null, "type": null, "text": "中平呼，有作去呼非，下同。"}
{"id": null, "n": null, "target": null, "type": null, "text": "二竝去呼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡經。"}
{"id": null, "n": null, "target": null, "type": null, "text": "朔。"}
{"id": null, "n": null, "target": null, "type": null, "text": "其兩。"}
{"id": null, "n": null, "target": null, "type": null, "text": "丑飢。"}
{"id": null, "n": null, "target": null, "type": null, "text": "有以上三字為句者非。"}
{"id": null, "n": null, "target": null, "type": null, "text": "丑六。"}
{"id": null, "n": null, "target": null, "type": null, "text": "茂。"}
{"id": null, "n": null, "target": null, "type": null, "text": "奴䤮"}
{"id": null, "n": null, "target": null, "type": null, "text": "莫江。"}
{"id": null, "n": null, "target": null, "type": null, "text": "平呼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "音貼不出字書。"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡怪下同。"}
{"id": null, "n": null, "target": null, "type": null, "text": "補革。"}
{"id": null, "n": null, "target": null, "type": null, "text": "去呼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "陟衛。"}
{"id": null, "n": null, "target": null, "type": null, "text": "刀主"}
{"id": null, "n": null, "target": null, "type": null, "text": "直利。"}
{"id": null, "n": null, "target": null, "type": null, "text": "戶頂。"}
{"id": null, "n": null, "target": null, "type": null, "text": "紫。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上怪。"}
{"id": null, "n": null, "target": null, "type": null, "text": "有云：嫌罵僧者，非也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "側格。"}
{"id": null, "n": null, "target": null, "type": null, "text": "毗義。"}
{"id": null, "n": null, "target": null, "type": null, "text": "失簾"}
{"id": null, "n": null, "target": null, "type": null, "text": "為字平呼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "尺沼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "連上為句。"}
{"id": null, "n": null, "target": null, "type": null, "text": "張略。"}
{"id": null, "n": null, "target": null, "type": null, "text": "分字去呼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "郎擊。"}
{"id": null, "n": null, "target": null, "type": null, "text": "隻。"}
{"id": null, "n": null, "target": null, "type": null, "text": "俱位有云惱鬼者非。"}
{"id": null, "n": null, "target": null, "type": null, "text": "上丁貫。"}
{"id": null, "n": null, "target": null, "type": null, "text": "補各。"}
{"id": null, "n": null, "target": null, "type": null, "text": "有云剎利水者非。"}
{"id": null, "n": null, "target": null, "type": null, "text": "雨逼\n況逼二音。"}
{"id": null, "n": null, "target": null, "type": null, "text": "傍禮。"}
{"id": null, "n": null, "target": null, "type": null, "text": "當侯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "丁呂。"}
{"id": null, "n": null, "target": null, "type": null, "text": "枯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "古滑。"}
{"id": null, "n": null, "target": null, "type": null, "text": "楚交初󴜜二音竝通。"}
{"id": null, "n": null, "target": null, "type": null, "text": "直連。"}
{"id": null, "n": null, "target": null, "type": null, "text": "居郢。"}
{"id": null, "n": null, "target": null, "type": null, "text": "修。"}
{"id": null, "n": null, "target": null, "type": null, "text": "存。"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼弔。"}
{"id": null, "n": null, "target": null, "type": null, "text": "吐凋"}
{"id": null, "n": null, "target": null, "type": null, "text": "上毗。"}
{"id": null, "n": null, "target": null, "type": null, "text": "古協。"}
{"id": null, "n": null, "target": null, "type": null, "text": "許及。"}
{"id": null, "n": null, "target": null, "type": null, "text": "神紙。"}
{"id": null, "n": null, "target": null, "type": null, "text": "博下有云手爬者非。"}
{"id": null, "n": null, "target": null, "type": null, "text": "所綺。"}
{"id": null, "n": null, "target": null, "type": null, "text": "奇逆。"}
{"id": null, "n": null, "target": null, "type": null, "text": "謀。"}
{"id": null, "n": null, "target": null, "type": null, "text": "直略。"}
{"id": null, "n": null, "target": null, "type": null, "text": "郎計。"}
{"id": null, "n": null, "target": null, "type": null, "text": "莫交。"}
{"id": null, "n": null, "target": null, "type": null, "text": "平呼。"}
{"id": null, "n": null, "target": null, "type": null, "text": "威切"}
{"id": null, "n": null, "target": null, "type": null, "text": "以律切"}
{"id": null, "n": null, "target": null, "type": null, "text": "武切"}
{"id": null, "n": null, "target": null, "type": null, "text": "臣吉切許吉切"}
{"id": null, "n": null, "target": null, "type": null, "text": "于今\n切"}
{"id": null, "n": null, "target": null, "type": null, "text": "二同呼今切"}
