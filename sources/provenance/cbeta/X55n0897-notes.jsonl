{"id": null, "n": null, "target": null, "type": null, "text": "只為真性不明，便生許多妄性"}
{"id": null, "n": null, "target": null, "type": null, "text": "誰能少得這個五識"}
{"id": null, "n": null, "target": null, "type": null, "text": "果然許多妄想"}
{"id": null, "n": null, "target": null, "type": null, "text": "妄想到這極處"}
{"id": null, "n": null, "target": null, "type": null, "text": "本來元自清淨"}
{"id": null, "n": null, "target": null, "type": null, "text": "爭奈被他所擾"}
{"id": null, "n": null, "target": null, "type": null, "text": "除非就向五根中看破他根的用處"}
{"id": null, "n": null, "target": null, "type": null, "text": "却誰曉得這個"}
{"id": null, "n": null, "target": null, "type": null, "text": "若能使識不著緣擾，還只\n救得一半"}
{"id": null, "n": null, "target": null, "type": null, "text": "佛果位中不說他到極處"}
{"id": null, "n": null, "target": null, "type": null, "text": "這個纔是轉識成智"}
{"id": null, "n": null, "target": null, "type": null, "text": "將五識還他妙用度生矣"}
{"id": null, "n": null, "target": null, "type": null, "text": "若人能了心，大地無寸土"}
{"id": null, "n": null, "target": null, "type": null, "text": "畢竟\n境從心造"}
{"id": null, "n": null, "target": null, "type": null, "text": "都在裏許"}
{"id": null, "n": null, "target": null, "type": null, "text": "各從其類"}
{"id": null, "n": null, "target": null, "type": null, "text": "念念不停"}
{"id": null, "n": null, "target": null, "type": null, "text": "一機所轉"}
{"id": null, "n": null, "target": null, "type": null, "text": "這是魁首"}
{"id": null, "n": null, "target": null, "type": null, "text": "便受感報"}
{"id": null, "n": null, "target": null, "type": null, "text": "能破煩惱"}
{"id": null, "n": null, "target": null, "type": null, "text": "法執猶在"}
{"id": null, "n": null, "target": null, "type": null, "text": "心花粲發"}
{"id": null, "n": null, "target": null, "type": null, "text": "無法不悟"}
{"id": null, "n": null, "target": null, "type": null, "text": "捏恠多般"}
{"id": null, "n": null, "target": null, "type": null, "text": "聽人穿鼻"}
{"id": null, "n": null, "target": null, "type": null, "text": "諸業俱生"}
{"id": null, "n": null, "target": null, "type": null, "text": "四惑尤固"}
{"id": null, "n": null, "target": null, "type": null, "text": "果自俱生我執"}
{"id": null, "n": null, "target": null, "type": null, "text": "安得不墮生死"}
{"id": null, "n": null, "target": null, "type": null, "text": "業性不停"}
{"id": null, "n": null, "target": null, "type": null, "text": "牽連六根"}
{"id": null, "n": null, "target": null, "type": null, "text": "不是帶質有覆"}
{"id": null, "n": null, "target": null, "type": null, "text": "不是恒審思量"}
{"id": null, "n": null, "target": null, "type": null, "text": "傳送俱妙"}
{"id": null, "n": null, "target": null, "type": null, "text": "法雲普覆"}
{"id": null, "n": null, "target": null, "type": null, "text": "好個記性"}
{"id": null, "n": null, "target": null, "type": null, "text": "又却無記"}
{"id": null, "n": null, "target": null, "type": null, "text": "不悟八識"}
{"id": null, "n": null, "target": null, "type": null, "text": "具眼方知"}
{"id": null, "n": null, "target": null, "type": null, "text": "流注生滅"}
{"id": null, "n": null, "target": null, "type": null, "text": "無盡因緣"}
{"id": null, "n": null, "target": null, "type": null, "text": "身世由他"}
{"id": null, "n": null, "target": null, "type": null, "text": "這是生死"}
{"id": null, "n": null, "target": null, "type": null, "text": "一悟\n方了"}
{"id": null, "n": null, "target": null, "type": null, "text": "悟後境界"}
{"id": null, "n": null, "target": null, "type": null, "text": "還他無垢"}
{"id": null, "n": null, "target": null, "type": null, "text": "纔了唯識"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T26n1541_p0634a28"}
