{"id": null, "n": null, "target": null, "type": "cf1", "text": "K19n0782_p0875a18"}
{"id": null, "n": "0896011", "target": "#nkr_note_mod_0896011", "type": "mod", "text": "祇域【大】下同，耆域【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0896012", "target": "#nkr_note_mod_0896012", "type": "mod", "text": "安息國三藏【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0896013", "target": "#nkr_note_mod_0896013", "type": "mod", "text": "佛在世時【大】，爾時【宮】"}
{"id": null, "n": "0896014", "target": "#nkr_note_mod_0896014", "type": "mod", "text": "維【大】，羅【宋】【元】【明】"}
{"id": null, "n": "0897001", "target": "#nkr_note_mod_0897001", "type": "mod", "text": "超【大】，映【宮】"}
{"id": null, "n": "0897002", "target": "#nkr_note_mod_0897002", "type": "mod", "text": "王【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0897003", "target": "#nkr_note_mod_0897003", "type": "mod", "text": "王【大】，主【元】"}
{"id": null, "n": "0897004", "target": "#nkr_note_mod_0897004", "type": "mod", "text": "唯【大】＊，惟【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0897005", "target": "#nkr_note_mod_0897005", "type": "mod", "text": "即【大】，既【宋】【元】【明】【宮】"}
{"id": null, "n": "0897006", "target": "#nkr_note_mod_0897006", "type": "mod", "text": "更【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0897007", "target": "#nkr_note_mod_0897007", "type": "mod", "text": "乳【大】＊，湩【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0897008", "target": "#nkr_note_mod_0897008", "type": "mod", "text": "此【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0897009", "target": "#nkr_note_mod_0897009", "type": "mod", "text": "㮈【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0897010", "target": "#nkr_note_mod_0897010", "type": "mod", "text": "巔【大】，頭【宋】【元】【明】【宮】"}
{"id": null, "n": "0897011", "target": "#nkr_note_mod_0897011", "type": "mod", "text": "旁【大】，傍【宋】【元】【明】【宮】"}
{"id": null, "n": "0897012", "target": "#nkr_note_mod_0897012", "type": "mod", "text": "下【大】，中【元】【明】"}
{"id": null, "n": "0897013", "target": "#nkr_note_mod_0897013", "type": "mod", "text": "水【大】，華【元】【明】"}
{"id": null, "n": "0897014", "target": "#nkr_note_mod_0897014", "type": "mod", "text": "養長【大】，長養【宋】【元】【明】【宮】"}
{"id": null, "n": "0897015", "target": "#nkr_note_mod_0897015", "type": "mod", "text": "女【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0897016", "target": "#nkr_note_mod_0897016", "type": "mod", "text": "亦【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0897017", "target": "#nkr_note_mod_0897017", "type": "mod", "text": "七王【大】，七王俱來【宋】【元】【明】【宮】"}
{"id": null, "n": "0897018", "target": "#nkr_note_mod_0897018", "type": "mod", "text": "夜【大】，夕夜【宋】【元】【明】【宮】"}
{"id": null, "n": "0897019", "target": "#nkr_note_mod_0897019", "type": "mod", "text": "瓶沙王【大】下同，萍沙王【宋】【元】【明】，洴沙王【宮】下同"}
{"id": null, "n": "0897020", "target": "#nkr_note_mod_0897020", "type": "mod", "text": "瀆【大】，竇【宋】【元】【明】【宮】"}
{"id": null, "n": "0897021", "target": "#nkr_note_mod_0897021", "type": "mod", "text": "接逮【大】，接待【宮】"}
{"id": null, "n": "0897022", "target": "#nkr_note_mod_0897022", "type": "mod", "text": "付【大】，與【宋】【元】【明】【宮】"}
{"id": null, "n": "0897023", "target": "#nkr_note_mod_0897023", "type": "mod", "text": "與【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0897024", "target": "#nkr_note_mod_0897024", "type": "mod", "text": "娠【大】，身【宋】【元】【宮】"}
{"id": null, "n": "0897025", "target": "#nkr_note_mod_0897025", "type": "mod", "text": "即【大】，是【宋】【元】【明】【宮】"}
{"id": null, "n": "0897026", "target": "#nkr_note_mod_0897026", "type": "mod", "text": "小【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0897027", "target": "#nkr_note_mod_0897027", "type": "mod", "text": "子【大】，之【宮】"}
{"id": null, "n": "0897028", "target": "#nkr_note_mod_0897028", "type": "mod", "text": "若【大】，即【宋】【元】【明】【宮】"}
{"id": null, "n": "0897029", "target": "#nkr_note_mod_0897029", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0897030", "target": "#nkr_note_mod_0897030", "type": "mod", "text": "後【大】，會【宋】【元】【明】【宮】"}
{"id": null, "n": "0897031", "target": "#nkr_note_mod_0897031", "type": "mod", "text": "阿闍世【大】，阿闍貰【宮】"}
{"id": null, "n": "0897032", "target": "#nkr_note_mod_0897032", "type": "mod", "text": "王【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0897033", "target": "#nkr_note_mod_0897033", "type": "mod", "text": "曾【大】，嘗【宋】【元】【明】【宮】"}
{"id": null, "n": "0897034", "target": "#nkr_note_mod_0897034", "type": "mod", "text": "號【大】，豪【宋】【元】【明】【宮】"}
{"id": null, "n": "0897035", "target": "#nkr_note_mod_0897035", "type": "mod", "text": "煩【大】，須【宋】【元】【明】"}
{"id": null, "n": "0898001", "target": "#nkr_note_mod_0898001", "type": "mod", "text": "聞彼【大】，彼聞【宋】【元】【明】【宮】"}
{"id": null, "n": "0898002", "target": "#nkr_note_mod_0898002", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0898003", "target": "#nkr_note_mod_0898003", "type": "mod", "text": "復【大】，後【明】"}
{"id": null, "n": "0898004", "target": "#nkr_note_mod_0898004", "type": "mod", "text": "藏【大】＊，臟【明】＊"}
{"id": null, "n": "0898005", "target": "#nkr_note_mod_0898005", "type": "mod", "text": "縷悉【大】，縷述【宮】"}
{"id": null, "n": "0898006", "target": "#nkr_note_mod_0898006", "type": "mod", "text": "白【大】，曰【宋】【元】【明】"}
{"id": null, "n": "0898007", "target": "#nkr_note_mod_0898007", "type": "mod", "text": "闇【大】，便闇【宋】【元】【明】【宮】"}
{"id": null, "n": "0898008", "target": "#nkr_note_mod_0898008", "type": "mod", "text": "又【大】，及【宋】【元】【明】"}
{"id": null, "n": "0898009", "target": "#nkr_note_mod_0898009", "type": "mod", "text": "差【大】，瘥【明】"}
{"id": null, "n": "0898010", "target": "#nkr_note_mod_0898010", "type": "mod", "text": "差【大】下同，瘥【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0898011", "target": "#nkr_note_mod_0898011", "type": "mod", "text": "可【大】，更【宋】【元】【明】"}
{"id": null, "n": "0898012", "target": "#nkr_note_mod_0898012", "type": "mod", "text": "如【大】，爾來【宋】【元】【明】，來爾【宮】"}
{"id": null, "n": "0898013", "target": "#nkr_note_mod_0898013", "type": "mod", "text": "承【大】，水【宮】"}
{"id": null, "n": "0898014", "target": "#nkr_note_mod_0898014", "type": "mod", "text": "腹【大】，腸【宋】【元】【明】【宮】"}
{"id": null, "n": "0899001", "target": "#nkr_note_mod_0899001", "type": "mod", "text": "致【大】，至【明】"}
{"id": null, "n": "0899002", "target": "#nkr_note_mod_0899002", "type": "mod", "text": "痛【大】，痛疾【宋】【元】【明】，瘡疾【宮】"}
{"id": null, "n": "0899003", "target": "#nkr_note_mod_0899003", "type": "mod", "text": "披【大】＊，㓟【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0899004", "target": "#nkr_note_mod_0899004", "type": "mod", "text": "神【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0899005", "target": "#nkr_note_mod_0899005", "type": "mod", "text": "十【大】，七【宋】【元】【明】【宮】"}
{"id": null, "n": "0899006", "target": "#nkr_note_mod_0899006", "type": "mod", "text": "其【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0899007", "target": "#nkr_note_mod_0899007", "type": "mod", "text": "那爾【大】，爾耶【宋】【元】【明】【宮】"}
{"id": null, "n": "0899008", "target": "#nkr_note_mod_0899008", "type": "mod", "text": "命【大】，人命【宋】【元】【明】【宮】"}
{"id": null, "n": "0899009", "target": "#nkr_note_mod_0899009", "type": "mod", "text": "太便【大】，大更【宋】【元】【明】【宮】"}
{"id": null, "n": "0899010", "target": "#nkr_note_mod_0899010", "type": "mod", "text": "慶幸【大】，僥倖【宋】【元】【明】【宮】"}
{"id": null, "n": "0899011", "target": "#nkr_note_mod_0899011", "type": "mod", "text": "作禮【大】，禮足【宋】【元】【明】【宮】"}
{"id": null, "n": "0899012", "target": "#nkr_note_mod_0899012", "type": "mod", "text": "甞【大】，當【宮】"}
{"id": null, "n": "0899013", "target": "#nkr_note_mod_0899013", "type": "mod", "text": "上【大】，至【宮】"}
{"id": null, "n": "0899014", "target": "#nkr_note_mod_0899014", "type": "mod", "text": "落【大】，躃【宋】【元】【明】【宮】"}
{"id": null, "n": "0899015", "target": "#nkr_note_mod_0899015", "type": "mod", "text": "獲【大】，攫【宋】【元】【明】【宮】"}
{"id": null, "n": "0899016", "target": "#nkr_note_mod_0899016", "type": "mod", "text": "生【大】，主【宋】【元】【明】【宮】"}
{"id": null, "n": "0899017", "target": "#nkr_note_mod_0899017", "type": "mod", "text": "恩者【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0899018", "target": "#nkr_note_mod_0899018", "type": "mod", "text": "四人【大】，兩八【宮】"}
{"id": null, "n": "0899019", "target": "#nkr_note_mod_0899019", "type": "mod", "text": "病疾【大】，疾病【宋】【元】【明】【宮】"}
{"id": null, "n": "0899020", "target": "#nkr_note_mod_0899020", "type": "mod", "text": "差【大】，瘥【明】"}
{"id": null, "n": "0899021", "target": "#nkr_note_mod_0899021", "type": "mod", "text": "睚眥【大】，睨眥【宮】"}
{"id": null, "n": "0899022", "target": "#nkr_note_mod_0899022", "type": "mod", "text": "勝【大】，稱【宋】【元】【明】【宮】"}
{"id": null, "n": "0899023", "target": "#nkr_note_mod_0899023", "type": "mod", "text": "懣【大】，滿【宋】【元】【明】【宮】"}
{"id": null, "n": "0899024", "target": "#nkr_note_mod_0899024", "type": "mod", "text": "怜【大】＊，憐【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0899025", "target": "#nkr_note_mod_0899025", "type": "mod", "text": "惡性【大】，惡性惟【宋】【元】【明】，性惡惟【宮】"}
{"id": null, "n": "0899026", "target": "#nkr_note_mod_0899026", "type": "mod", "text": "趍【大】，好【宋】【元】【明】【宮】"}
{"id": null, "n": "0899027", "target": "#nkr_note_mod_0899027", "type": "mod", "text": "蟒【大】下同，蠆【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0899028", "target": "#nkr_note_mod_0899028", "type": "mod", "text": "去【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0899029", "target": "#nkr_note_mod_0899029", "type": "mod", "text": "省【大】，向省【宋】【元】【明】【宮】"}
{"id": null, "n": "0899030", "target": "#nkr_note_mod_0899030", "type": "mod", "text": "王病則【大】，我則不治病【宋】【元】【明】，我則治病【宮】"}
{"id": null, "n": "0899031", "target": "#nkr_note_mod_0899031", "type": "mod", "text": "可【大】，得【宋】【元】【明】【宮】"}
{"id": null, "n": "0899032", "target": "#nkr_note_mod_0899032", "type": "mod", "text": "厭【大】，魘【宋】【元】【宮】，壓【明】"}
{"id": null, "n": "0899033", "target": "#nkr_note_mod_0899033", "type": "mod", "text": "軀【大】，身【宋】，娠【元】【明】"}
{"id": null, "n": "0900001", "target": "#nkr_note_mod_0900001", "type": "mod", "text": "（若病…治之）十六字【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0900002", "target": "#nkr_note_mod_0900002", "type": "mod", "text": "噵【大】＊，道【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0900003", "target": "#nkr_note_mod_0900003", "type": "mod", "text": "坐【大】，出【宋】【元】【明】"}
{"id": null, "n": "0900004", "target": "#nkr_note_mod_0900004", "type": "mod", "text": "是也【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0900005", "target": "#nkr_note_mod_0900005", "type": "mod", "text": "遍【大】，匝【宋】【元】【明】，王【宮】"}
{"id": null, "n": "0900006", "target": "#nkr_note_mod_0900006", "type": "mod", "text": "煉【大】＊，練【宋】【元】【宮】，鍊【明】＊"}
{"id": null, "n": "0900007", "target": "#nkr_note_mod_0900007", "type": "mod", "text": "門【大】，宮門門【宋】【元】【明】【宮】"}
{"id": null, "n": "0900008", "target": "#nkr_note_mod_0900008", "type": "mod", "text": "兒【大】下同，鼠【宮】下同"}
{"id": null, "n": "0900009", "target": "#nkr_note_mod_0900009", "type": "mod", "text": "作【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0900010", "target": "#nkr_note_mod_0900010", "type": "mod", "text": "出【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0900011", "target": "#nkr_note_mod_0900011", "type": "mod", "text": "事【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0900012", "target": "#nkr_note_mod_0900012", "type": "mod", "text": "齊【大】，劑【宋】【元】【明】"}
{"id": null, "n": "0900013", "target": "#nkr_note_mod_0900013", "type": "mod", "text": "我【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0900014", "target": "#nkr_note_mod_0900014", "type": "mod", "text": "劑【大】，齊【宮】"}
{"id": null, "n": "0900015", "target": "#nkr_note_mod_0900015", "type": "mod", "text": "氣【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0900016", "target": "#nkr_note_mod_0900016", "type": "mod", "text": "草【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0900017", "target": "#nkr_note_mod_0900017", "type": "mod", "text": "預【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0900018", "target": "#nkr_note_mod_0900018", "type": "mod", "text": "清【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0900019", "target": "#nkr_note_mod_0900019", "type": "mod", "text": "王后【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0900020", "target": "#nkr_note_mod_0900020", "type": "mod", "text": "我【大】，我我【宋】【元】【明】【宮】"}
{"id": null, "n": "0900021", "target": "#nkr_note_mod_0900021", "type": "mod", "text": "來【大】，眾【元】"}
{"id": null, "n": "0900022", "target": "#nkr_note_mod_0900022", "type": "mod", "text": "食【大】，飲食【宋】【元】【明】【宮】"}
{"id": null, "n": "0900023", "target": "#nkr_note_mod_0900023", "type": "mod", "text": "雖作【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0900024", "target": "#nkr_note_mod_0900024", "type": "mod", "text": "喫【大】，齧【宋】【元】【明】【宮】"}
