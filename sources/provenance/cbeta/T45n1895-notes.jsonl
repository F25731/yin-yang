{"id": null, "n": "0842002", "target": "#nkr_note_mod_0842002", "type": "mod", "text": "皆【大】，〔－〕【校異-原】"}
{"id": null, "n": "0844001", "target": "#nkr_note_mod_0844001", "type": "mod", "text": "足【大】，定【考偽-原】"}
{"id": null, "n": "0846001", "target": "#nkr_note_mod_0846001", "type": "mod", "text": "禮【大】，札【考偽-原】"}
{"id": null, "n": "0852001", "target": "#nkr_note_mod_0852001", "type": "mod", "text": "徒【大】，從【考偽-原】"}
{"id": null, "n": "0853001", "target": "#nkr_note_mod_0853001", "type": "mod", "text": "跛【大】，跋【考偽-原】"}
{"id": null, "n": "0839001", "target": "#nkr_note_orig_0839001", "type": "orig", "text": "【原】貞享五年刊大谷大學藏本"}
{"id": null, "n": "0842001", "target": "#nkr_note_orig_0842001", "type": "orig", "text": "竦＝疎ヵ【原】"}
{"id": null, "n": "0842002", "target": "#nkr_note_orig_0842002", "type": "orig", "text": "〔皆〕ィ－【原】"}
{"id": null, "n": "0844001", "target": "#nkr_note_orig_0844001", "type": "orig", "text": "足＝定ヵ【原】"}
{"id": null, "n": "0846001", "target": "#nkr_note_orig_0846001", "type": "orig", "text": "禮＝札ヵ【原】"}
{"id": null, "n": "0852001", "target": "#nkr_note_orig_0852001", "type": "orig", "text": "徒＝從ヵ【原】"}
{"id": null, "n": "0853001", "target": "#nkr_note_orig_0853001", "type": "orig", "text": "跛＝跋ヵ【原】"}
