{"id": null, "n": "0839c2701", "target": "#nkr_note_add_0839c2701", "type": "add", "text": "贍【CB】，瞻【大】"}
{"id": null, "n": "0841b2901", "target": "#nkr_note_add_0841b2901", "type": "add", "text": "圮【CB】，𡉏【大】，圯【麗-CB】"}
{"id": null, "n": "0842c0301", "target": "#nkr_note_add_0842c0301", "type": "add", "text": "籀【CB】，籕【大】"}
{"id": null, "n": "0844a0301", "target": "#nkr_note_add_0844a0301", "type": "add", "text": "璃【CB】，瑠【大】"}
{"id": null, "n": "0844c1301", "target": "#nkr_note_add_0844c1301", "type": "add", "text": "󰈷【CB】，𬧅【大】"}
{"id": null, "n": "0844c1401", "target": "#nkr_note_add_0844c1401", "type": "add", "text": "󰈷【CB】，𬧅【大】"}
{"id": null, "n": "0850b2801", "target": "#nkr_note_add_0850b2801", "type": "add", "text": "鎖【CB】，瑣【大】"}
{"id": null, "n": "0850c2001", "target": "#nkr_note_add_0850c2001", "type": "add", "text": "筯【CB】，筋【大】"}
