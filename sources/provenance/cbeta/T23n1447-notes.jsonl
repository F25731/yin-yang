{"id": null, "n": "1052a1101", "target": "#nkr_note_add_1052a1101", "type": "add", "text": "于【CB】，干【大】"}
{"id": null, "n": "1052a1901", "target": "#nkr_note_add_1052a1901", "type": "add", "text": "末【大】，未【麗-CB】"}
{"id": null, "n": "1056c0301", "target": "#nkr_note_add_1056c0301", "type": "add", "text": "你你【CB】【麗-CB】，爾爾【大】"}
{"id": null, "n": "1056c0302", "target": "#nkr_note_add_1056c0302", "type": "add", "text": "你你【CB】【麗-CB】，爾爾【大】"}
{"id": null, "n": "1056c1301", "target": "#nkr_note_add_1056c1301", "type": "add", "text": "屣【大】，履【麗-CB】"}
{"id": null, "n": "1057a2501", "target": "#nkr_note_add_1057a2501", "type": "add", "text": "猶【大】，由【麗-CB】"}
