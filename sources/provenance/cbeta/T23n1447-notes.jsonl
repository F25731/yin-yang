{"id": null, "n": "1048001", "target": "#nkr_note_orig_1048001", "type": "orig", "text": "忍澂師校刻本曰所為疑所謂"}
{"id": null, "n": "1050001", "target": "#nkr_note_orig_1050001", "type": "orig", "text": "忍澂師校刻本曰故疑飲"}
{"id": null, "n": "1052001", "target": "#nkr_note_orig_1052001", "type": "orig", "text": "忍澂師校刻本曰為疑謂"}
{"id": null, "n": "1052002", "target": "#nkr_note_orig_1052002", "type": "orig", "text": "忍澂師校刻本曰請疑諸"}
{"id": null, "n": "1054001", "target": "#nkr_note_orig_1054001", "type": "orig", "text": "忍澂師校刻本曰具疑以"}
{"id": null, "n": "1055001", "target": "#nkr_note_orig_1055001", "type": "orig", "text": "忍澂師校刻本曰當疑常"}
{"id": null, "n": "1055002", "target": "#nkr_note_orig_1055002", "type": "orig", "text": "忍澂師校刻本曰見疑前"}
{"id": null, "n": "1056001", "target": "#nkr_note_orig_1056001", "type": "orig", "text": "忍澂師校刻本曰辰疑晨"}
{"id": null, "n": "1056002", "target": "#nkr_note_orig_1056002", "type": "orig", "text": "忍澂師校刻本曰量疑重"}
{"id": null, "n": "1056003", "target": "#nkr_note_orig_1056003", "type": "orig", "text": "忍澂師校刻本曰更不能去可疑"}
{"id": null, "n": "1056004", "target": "#nkr_note_orig_1056004", "type": "orig", "text": "忍澂師校刻本曰多施疑倒"}
{"id": null, "n": "1057001", "target": "#nkr_note_orig_1057001", "type": "orig", "text": "忍澂師校刻本曰雪寒疑倒"}
{"id": null, "n": "1049c0201", "target": "#nkr_note_add_1049c0201", "type": "add", "text": "載【CB】【麗-CB】，戴【大】"}
