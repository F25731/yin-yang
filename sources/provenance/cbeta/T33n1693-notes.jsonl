{"id": null, "n": "0001001", "target": "#nkr_note_orig_0001001", "type": "orig", "text": "【原】增上寺藏麗本"}
{"id": null, "n": "0001c1801", "target": "#nkr_note_add_0001c1801", "type": "add", "text": "惱【CB】，腦【大】"}
{"id": null, "n": "0003a1701", "target": "#nkr_note_add_0003a1701", "type": "add", "text": "令【CB】，受【大】"}
{"id": null, "n": "0004a0401", "target": "#nkr_note_add_0004a0401", "type": "add", "text": "此【CB】，比【大】"}
{"id": null, "n": "0004a1701", "target": "#nkr_note_add_0004a1701", "type": "add", "text": "令【CB】，今【大】"}
{"id": null, "n": "0006c1401", "target": "#nkr_note_add_0006c1401", "type": "add", "text": "少【CB】，小【大】"}
