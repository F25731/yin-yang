{"id": null, "n": "0017035", "target": "#nkr_note_mod_0017035", "type": "mod", "text": "呪【大】，呪經【明】"}
{"id": null, "n": "0017036", "target": "#nkr_note_mod_0017036", "type": "mod", "text": "（大唐…譯）十字【大】，唐大總持寺大德法師智通奉制譯【宋】，唐大德法師智通奉詔譯【明】"}
{"id": null, "n": "0017037", "target": "#nkr_note_mod_0017037", "type": "mod", "text": "上【大】＊，上聲【明】＊"}
{"id": null, "n": "0017038", "target": "#nkr_note_mod_0017038", "type": "mod", "text": "囉【大】，囉上【元】，囉上聲【明】"}
{"id": null, "n": "0017039", "target": "#nkr_note_mod_0017039", "type": "mod", "text": "反【大】＊，切【明】＊"}
{"id": null, "n": "0017040", "target": "#nkr_note_mod_0017040", "type": "mod", "text": "我【大】，我反【元】，我切【明】"}
{"id": null, "n": "0017041", "target": "#nkr_note_mod_0017041", "type": "mod", "text": "唎【大】，利【明】"}
{"id": null, "n": "0017042", "target": "#nkr_note_mod_0017042", "type": "mod", "text": "羅【大】，羅上聲【明】"}
