{"id": null, "n": null, "target": null, "type": null, "text": "三十二"}
{"id": null, "n": null, "target": null, "type": null, "text": "唯足不同"}
{"id": null, "n": null, "target": null, "type": null, "text": "手印與觀世音心印同，唯身脚法用別"}
{"id": null, "n": null, "target": null, "type": null, "text": "此印是阿地多崛多師譯出"}
{"id": null, "n": null, "target": null, "type": null, "text": "紫檀木是"}
{"id": null, "n": null, "target": null, "type": null, "text": "拘無子少者是"}
{"id": null, "n": null, "target": null, "type": null, "text": "赤棗木代亦得"}
{"id": null, "n": null, "target": null, "type": null, "text": "此是先相，即知當生淨土"}
