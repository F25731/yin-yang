{"id": null, "n": null, "target": null, "type": null, "text": "晝夜八時"}
{"id": null, "n": null, "target": null, "type": null, "text": "准此嗔戒，\n惡打方犯。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此一時重也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此二時重也"}
{"id": null, "n": null, "target": null, "type": null, "text": "三時俱重也"}
{"id": null, "n": null, "target": null, "type": null, "text": "三時俱輕"}
{"id": null, "n": null, "target": null, "type": null, "text": "殺果"}
{"id": null, "n": null, "target": null, "type": null, "text": "盜果"}
{"id": null, "n": null, "target": null, "type": null, "text": "邪行果"}
{"id": null, "n": null, "target": null, "type": null, "text": "妄果"}
{"id": null, "n": null, "target": null, "type": null, "text": "兩舌果"}
{"id": null, "n": null, "target": null, "type": null, "text": "惡口果"}
{"id": null, "n": null, "target": null, "type": null, "text": "綺語果也，上等流果也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此增上果"}
{"id": null, "n": null, "target": null, "type": null, "text": "現報"}
{"id": null, "n": null, "target": null, "type": null, "text": "後生報也，人作天受"}
{"id": null, "n": null, "target": null, "type": null, "text": "約第一義，無自性故也"}
{"id": null, "n": null, "target": null, "type": null, "text": "二地菩薩"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T24n1484_p0997c20"}
{"id": null, "n": "0536005", "target": "#nkr_note_mod_0536005", "type": "mod", "text": "堅【CB】，賢【卍續】，賢一作堅"}
{"id": null, "n": "0534001", "target": "#nkr_note_orig_0534001", "type": "orig", "text": "撰號新加"}
{"id": null, "n": "0534002", "target": "#nkr_note_orig_0534002", "type": "orig", "text": "將一作正"}
{"id": null, "n": "0534003", "target": "#nkr_note_orig_0534003", "type": "orig", "text": "隨字疑衍"}
{"id": null, "n": "0534004", "target": "#nkr_note_orig_0534004", "type": "orig", "text": "斛疑解"}
{"id": null, "n": "0534005", "target": "#nkr_note_orig_0534005", "type": "orig", "text": "一無之益初勸受五疑"}
{"id": null, "n": "0534006", "target": "#nkr_note_orig_0534006", "type": "orig", "text": "復一作後"}
{"id": null, "n": "0534007", "target": "#nkr_note_orig_0534007", "type": "orig", "text": "法疑往"}
{"id": null, "n": "0534008", "target": "#nkr_note_orig_0534008", "type": "orig", "text": "持疑待"}
{"id": null, "n": "0534009", "target": "#nkr_note_orig_0534009", "type": "orig", "text": "一無不字"}
{"id": null, "n": "0534010", "target": "#nkr_note_orig_0534010", "type": "orig", "text": "復一作後"}
{"id": null, "n": "0534011", "target": "#nkr_note_orig_0534011", "type": "orig", "text": "思一作恩"}
{"id": null, "n": "0535001", "target": "#nkr_note_orig_0535001", "type": "orig", "text": "眾多一作多眾"}
{"id": null, "n": "0535002", "target": "#nkr_note_orig_0535002", "type": "orig", "text": "一無制即止三字"}
{"id": null, "n": "0535003", "target": "#nkr_note_orig_0535003", "type": "orig", "text": "現一作觀"}
{"id": null, "n": "0535004", "target": "#nkr_note_orig_0535004", "type": "orig", "text": "先作眾"}
{"id": null, "n": "0535005", "target": "#nkr_note_orig_0535005", "type": "orig", "text": "所一作行"}
{"id": null, "n": "0535006", "target": "#nkr_note_orig_0535006", "type": "orig", "text": "號或作欲次同"}
{"id": null, "n": "0535007", "target": "#nkr_note_orig_0535007", "type": "orig", "text": "無上一有無字"}
{"id": null, "n": "0535008", "target": "#nkr_note_orig_0535008", "type": "orig", "text": "一無地字"}
{"id": null, "n": "0536001", "target": "#nkr_note_orig_0536001", "type": "orig", "text": "超一作趣"}
{"id": null, "n": "0536002", "target": "#nkr_note_orig_0536002", "type": "orig", "text": "師字恐誤"}
{"id": null, "n": "0536003", "target": "#nkr_note_orig_0536003", "type": "orig", "text": "一無智等四字"}
{"id": null, "n": "0536004", "target": "#nkr_note_orig_0536004", "type": "orig", "text": "洞一作同"}
{"id": null, "n": "0536005", "target": "#nkr_note_orig_0536005", "type": "orig", "text": "賢一作堅"}
{"id": null, "n": "0536006", "target": "#nkr_note_orig_0536006", "type": "orig", "text": "家下一有法中二字"}
{"id": null, "n": "0537001", "target": "#nkr_note_orig_0537001", "type": "orig", "text": "涅槃疑炎"}
{"id": null, "n": "0537002", "target": "#nkr_note_orig_0537002", "type": "orig", "text": "行一作願"}
{"id": null, "n": "0537003", "target": "#nkr_note_orig_0537003", "type": "orig", "text": "乳疑吼"}
{"id": null, "n": "0537004", "target": "#nkr_note_orig_0537004", "type": "orig", "text": "薩疑提"}
{"id": null, "n": "0537005", "target": "#nkr_note_orig_0537005", "type": "orig", "text": "脩一作備"}
{"id": null, "n": "0537006", "target": "#nkr_note_orig_0537006", "type": "orig", "text": "薩疑提次同"}
{"id": null, "n": "0538001", "target": "#nkr_note_orig_0538001", "type": "orig", "text": "學上一有勸字"}
{"id": null, "n": "0538002", "target": "#nkr_note_orig_0538002", "type": "orig", "text": "慢字疑剩"}
{"id": null, "n": "0538003", "target": "#nkr_note_orig_0538003", "type": "orig", "text": "報或作根下同"}
{"id": null, "n": "0538004", "target": "#nkr_note_orig_0538004", "type": "orig", "text": "死或作充"}
{"id": null, "n": "0538005", "target": "#nkr_note_orig_0538005", "type": "orig", "text": "與上一有施字"}
{"id": null, "n": "0538006", "target": "#nkr_note_orig_0538006", "type": "orig", "text": "引下一有起於邪見四字"}
{"id": null, "n": "0538007", "target": "#nkr_note_orig_0538007", "type": "orig", "text": "齊疑高"}
{"id": null, "n": "0538008", "target": "#nkr_note_orig_0538008", "type": "orig", "text": "戒一作或"}
{"id": null, "n": "0538009", "target": "#nkr_note_orig_0538009", "type": "orig", "text": "妄一作然"}
{"id": null, "n": "0539001", "target": "#nkr_note_orig_0539001", "type": "orig", "text": "句一作󳎺"}
{"id": null, "n": "0539002", "target": "#nkr_note_orig_0539002", "type": "orig", "text": "若作居"}
{"id": null, "n": "0539003", "target": "#nkr_note_orig_0539003", "type": "orig", "text": "族一作強"}
{"id": null, "n": "0539004", "target": "#nkr_note_orig_0539004", "type": "orig", "text": "一無知字"}
{"id": null, "n": "0539005", "target": "#nkr_note_orig_0539005", "type": "orig", "text": "而一作即"}
{"id": null, "n": "0539006", "target": "#nkr_note_orig_0539006", "type": "orig", "text": "容疑客"}
{"id": null, "n": "0539007", "target": "#nkr_note_orig_0539007", "type": "orig", "text": "名字疑剩"}
{"id": null, "n": "0539008", "target": "#nkr_note_orig_0539008", "type": "orig", "text": "是下一有佛母故三字"}
{"id": null, "n": "0540001", "target": "#nkr_note_orig_0540001", "type": "orig", "text": "定疑足"}
{"id": null, "n": "0540002", "target": "#nkr_note_orig_0540002", "type": "orig", "text": "攝一作接"}
{"id": null, "n": "0540003", "target": "#nkr_note_orig_0540003", "type": "orig", "text": "之下疑脫人字"}
{"id": null, "n": "0541001", "target": "#nkr_note_orig_0541001", "type": "orig", "text": "是一作即"}
{"id": null, "n": "0541002", "target": "#nkr_note_orig_0541002", "type": "orig", "text": "若一作差"}
{"id": null, "n": "0541003", "target": "#nkr_note_orig_0541003", "type": "orig", "text": "無造字"}
{"id": null, "n": "0541004", "target": "#nkr_note_orig_0541004", "type": "orig", "text": "思一作恩"}
{"id": null, "n": "0541005", "target": "#nkr_note_orig_0541005", "type": "orig", "text": "壞一作懷"}
{"id": null, "n": "0541006", "target": "#nkr_note_orig_0541006", "type": "orig", "text": "一無犯字"}
{"id": null, "n": "0541007", "target": "#nkr_note_orig_0541007", "type": "orig", "text": "通一作逼"}
{"id": null, "n": "0541008", "target": "#nkr_note_orig_0541008", "type": "orig", "text": "苦一作共"}
{"id": null, "n": "0541009", "target": "#nkr_note_orig_0541009", "type": "orig", "text": "七疑十"}
{"id": null, "n": "0541010", "target": "#nkr_note_orig_0541010", "type": "orig", "text": "常疑當"}
{"id": null, "n": "0541011", "target": "#nkr_note_orig_0541011", "type": "orig", "text": "耶通邪"}
{"id": null, "n": "0541012", "target": "#nkr_note_orig_0541012", "type": "orig", "text": "戒或作於"}
{"id": null, "n": "0542001", "target": "#nkr_note_orig_0542001", "type": "orig", "text": "名下一有多字"}
{"id": null, "n": "0542002", "target": "#nkr_note_orig_0542002", "type": "orig", "text": "生一作教故"}
{"id": null, "n": "0542003", "target": "#nkr_note_orig_0542003", "type": "orig", "text": "肉或內歟"}
{"id": null, "n": "0543001", "target": "#nkr_note_orig_0543001", "type": "orig", "text": "一無想字"}
{"id": null, "n": "0543002", "target": "#nkr_note_orig_0543002", "type": "orig", "text": "意一作惡"}
{"id": null, "n": "0543003", "target": "#nkr_note_orig_0543003", "type": "orig", "text": "廢疑還（廢ハ本文ニ癈トツクル。󴦒）"}
{"id": null, "n": "0543004", "target": "#nkr_note_orig_0543004", "type": "orig", "text": "今一作令"}
{"id": null, "n": "0543005", "target": "#nkr_note_orig_0543005", "type": "orig", "text": "見下一有便字"}
{"id": null, "n": "0543006", "target": "#nkr_note_orig_0543006", "type": "orig", "text": "可一作多"}
{"id": null, "n": "0544001", "target": "#nkr_note_orig_0544001", "type": "orig", "text": "一無次字"}
{"id": null, "n": "0544002", "target": "#nkr_note_orig_0544002", "type": "orig", "text": "祇下一有犯字"}
{"id": null, "n": "0544003", "target": "#nkr_note_orig_0544003", "type": "orig", "text": "約作初"}
{"id": null, "n": "0544004", "target": "#nkr_note_orig_0544004", "type": "orig", "text": "一無心字"}
{"id": null, "n": "0544005", "target": "#nkr_note_orig_0544005", "type": "orig", "text": "謂一作經"}
{"id": null, "n": "0544006", "target": "#nkr_note_orig_0544006", "type": "orig", "text": "婬字疑剩"}
{"id": null, "n": "0544007", "target": "#nkr_note_orig_0544007", "type": "orig", "text": "讚作護"}
{"id": null, "n": "0545001", "target": "#nkr_note_orig_0545001", "type": "orig", "text": "輪力疑刀輪"}
{"id": null, "n": "0545002", "target": "#nkr_note_orig_0545002", "type": "orig", "text": "世疑女"}
{"id": null, "n": "0545003", "target": "#nkr_note_orig_0545003", "type": "orig", "text": "一無心字"}
{"id": null, "n": "0545004", "target": "#nkr_note_orig_0545004", "type": "orig", "text": "生下一有男字"}
{"id": null, "n": "0545005", "target": "#nkr_note_orig_0545005", "type": "orig", "text": "夫一作文"}
{"id": null, "n": "0546001", "target": "#nkr_note_orig_0546001", "type": "orig", "text": "之下一有人字"}
{"id": null, "n": "0546002", "target": "#nkr_note_orig_0546002", "type": "orig", "text": "命一作令"}
