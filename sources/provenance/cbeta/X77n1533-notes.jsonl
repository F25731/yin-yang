{"id": null, "n": "0637001", "target": "#nkr_note_orig_0637001", "type": "orig", "text": "業疑葉"}
{"id": null, "n": "0640001", "target": "#nkr_note_orig_0640001", "type": "orig", "text": "誨疑悔"}
