{"id": null, "n": null, "target": null, "type": null, "text": "天讚"}
{"id": null, "n": null, "target": null, "type": null, "text": "取髻提也"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合訶定行利垢"}
{"id": null, "n": null, "target": null, "type": null, "text": "行除彼邪術之垢也"}
{"id": null, "n": null, "target": null, "type": null, "text": "名降三世降伏義"}
{"id": null, "n": null, "target": null, "type": null, "text": "又云黑闇"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": null, "target": null, "type": null, "text": "可加散杖"}
{"id": null, "n": null, "target": null, "type": null, "text": "若無者用茶"}
{"id": null, "n": null, "target": null, "type": null, "text": "若飯"}
{"id": null, "n": null, "target": null, "type": null, "text": "若加用幣\n帛用普供養明"}
{"id": null, "n": null, "target": null, "type": null, "text": "淨三業，三都被\n甲，如十八道"}
{"id": null, "n": null, "target": null, "type": null, "text": "持珠杵"}
{"id": null, "n": null, "target": null, "type": null, "text": "用辦事印明"}
{"id": null, "n": null, "target": null, "type": null, "text": "用堅實合掌"}
{"id": null, "n": null, "target": null, "type": null, "text": "三遍"}
{"id": null, "n": null, "target": null, "type": null, "text": "三反普印明"}
{"id": null, "n": null, "target": null, "type": null, "text": "三反"}
{"id": null, "n": null, "target": null, "type": null, "text": "取散杖誦闕伽明，於座前灑之三遍"}
{"id": null, "n": null, "target": null, "type": null, "text": "取一房花，誦花座明，置於座所，或亦用印明"}
{"id": null, "n": null, "target": null, "type": null, "text": "先菓子，次酒，次飲食"}
{"id": null, "n": null, "target": null, "type": null, "text": "或加用幣帛"}
{"id": null, "n": null, "target": null, "type": null, "text": "如十八道也"}
{"id": null, "n": null, "target": null, "type": null, "text": "用普諸天贊"}
{"id": null, "n": null, "target": null, "type": null, "text": "用普印"}
{"id": null, "n": null, "target": null, "type": null, "text": "用普印"}
{"id": null, "n": null, "target": null, "type": null, "text": "同印"}
{"id": null, "n": null, "target": null, "type": null, "text": "極少\n百遍"}
{"id": null, "n": null, "target": null, "type": null, "text": "如先"}
{"id": null, "n": null, "target": null, "type": null, "text": "用普印"}
{"id": null, "n": null, "target": null, "type": null, "text": "三部被甲如先"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "舉奠反，衣後也"}
{"id": null, "n": null, "target": null, "type": null, "text": "欺文反，裳也"}
{"id": null, "n": null, "target": null, "type": null, "text": "從軍反，訓云井左良比"}
{"id": null, "n": null, "target": null, "type": null, "text": "音裙，訓云古呂毛乃須祖，亦云古呂毛乃惠利"}
{"id": null, "n": "0355030", "target": null, "type": "orig", "text": "婆訶＝嚩呵ィ【原】"}
{"id": null, "n": "0355030", "target": null, "type": "mod", "text": "婆訶【大】，嚩呵【校異-原】"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合訶定行利垢"}
{"id": null, "n": null, "target": null, "type": null, "text": "行也"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": "0356059", "target": null, "type": "orig", "text": "〔訶〕－【甲】"}
{"id": null, "n": "0356059", "target": null, "type": "mod", "text": "訶【大】，〔－〕【甲】"}
{"id": null, "n": "0356060", "target": null, "type": "orig", "text": "羅＋（天大暗夜天又翻迦羅云云切云裾舉魚反衣後也君衣縣文反裳和名云臂復𮥒反俗之井佐良比又云裾裳釋名云上日裾唐云與群同學亦作君禮又云裙音居和名古呂毛乃頃曾又支奴乃之利摩訶迦羅天用普印攝大中云摩賀迦羅神摩賀迦羅娑縛賀二合）【甲】"}
{"id": null, "n": "0356060", "target": null, "type": "mod", "text": "羅【大】，羅天大暗夜天又翻迦羅云云切云裾舉魚反衣後也君衣縣文反裳和名云臂復𮥒反俗之井佐良比又云裾裳釋名云上日裾唐云與群同學亦作君禮又云裙音居和名古呂毛乃頃曾又支奴乃之利摩訶迦羅天用普印攝大中云摩賀迦羅神摩賀迦羅娑縛賀二合【甲】"}
{"id": null, "n": "0356061", "target": null, "type": "orig", "text": "神字以下甲本闕，甲本奧書云承曆四年九月十七日書了受了"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": null, "target": null, "type": null, "text": "若無者用茶"}
{"id": null, "n": null, "target": null, "type": null, "text": "若飯"}
{"id": null, "n": null, "target": null, "type": null, "text": "若加用幣帛用普供養明＝真言【乙】明【大】，真言【乙】明真言"}
{"id": null, "n": "0357008", "target": null, "type": "orig", "text": "明＝真言【乙】"}
{"id": null, "n": "0357008", "target": null, "type": "mod", "text": "明【大】，真言【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "淨三業，〔三都〕－【乙】三都【大】，〔－〕【乙】三都被甲，如十八道"}
{"id": null, "n": "0357011", "target": null, "type": "orig", "text": "〔三都〕－【乙】"}
{"id": null, "n": "0357011", "target": null, "type": "mod", "text": "三都【大】，〔－〕【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "取散杖誦闕伽明，於座前＝所【乙】前【大】，所【乙】前所灑之三遍＝反【乙】＊遍【大】＊，反【乙】＊遍反"}
{"id": null, "n": "0357043", "target": null, "type": "orig", "text": "前＝所【乙】"}
{"id": null, "n": "0357043", "target": null, "type": "mod", "text": "前【大】，所【乙】"}
{"id": null, "n": "0357044", "target": null, "type": "orig", "text": "遍＝反【乙】＊"}
{"id": null, "n": "0357044", "target": null, "type": "mod", "text": "遍【大】＊，反【乙】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "麁散杖誦闕伽明於座前灑之三遍"}
{"id": null, "n": null, "target": null, "type": null, "text": "用普印"}
{"id": null, "n": null, "target": null, "type": null, "text": "用普印"}
{"id": null, "n": null, "target": null, "type": null, "text": "七反"}
{"id": null, "n": null, "target": null, "type": null, "text": "真言"}
{"id": null, "n": null, "target": null, "type": null, "text": "七反"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": "0355005", "target": "#nkr_note_mod_0355005", "type": "mod", "text": "大【大】，胎藏界梵號集之摩訶迦羅天亦名大黑天神普印用三摩耶形青色三面六擘前左右橫執人頭取髮提也右手執鈕橫前次手執半把二次左右眾皮張皆後以髑髏為瓔珞也故本之黑淺色也大【甲】，【原】享和二年刊長谷寺藏本，【甲】承曆四年寫高山寺藏本，【乙】天承四年寫高山寺藏本"}
{"id": null, "n": "0355006", "target": "#nkr_note_mod_0355006", "type": "mod", "text": "天【大】，〔－〕【甲】"}
{"id": null, "n": "0355007", "target": "#nkr_note_mod_0355007", "type": "mod", "text": "吾【大】，吾唐【校異-原】，吾當【甲】【乙】"}
{"id": null, "n": "0355008", "target": "#nkr_note_mod_0355008", "type": "mod", "text": "天【大】，神【乙】"}
{"id": null, "n": "0355009", "target": "#nkr_note_mod_0355009", "type": "mod", "text": "飯【大】，食【校異-原】"}
{"id": null, "n": "0355010", "target": "#nkr_note_mod_0355010", "type": "mod", "text": "安置伽藍【大】，伽藍安置【校異-原】【甲】【乙】"}
{"id": null, "n": "0355011", "target": "#nkr_note_mod_0355011", "type": "mod", "text": "吾【大】，〔－〕【校異-原】，〔－〕【甲】"}
{"id": null, "n": "0355012", "target": "#nkr_note_mod_0355012", "type": "mod", "text": "貴【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0355013", "target": "#nkr_note_mod_0355013", "type": "mod", "text": "位【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0355014", "target": "#nkr_note_mod_0355014", "type": "mod", "text": "祿【大】，識祿【甲】【乙】"}
{"id": null, "n": "0355015", "target": "#nkr_note_mod_0355015", "type": "mod", "text": "悉【大】，志【甲】"}
{"id": null, "n": "0355016", "target": "#nkr_note_mod_0355016", "type": "mod", "text": "亦【大】，六【甲】"}
{"id": null, "n": "0355017", "target": "#nkr_note_mod_0355017", "type": "mod", "text": "得【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0355018", "target": "#nkr_note_mod_0355018", "type": "mod", "text": "子【大】，〔－〕【校異-原】"}
{"id": null, "n": "0355019", "target": "#nkr_note_mod_0355019", "type": "mod", "text": "右【大】，右背【乙】"}
{"id": null, "n": "0355020", "target": "#nkr_note_mod_0355020", "type": "mod", "text": "左【大】，右【甲】"}
{"id": null, "n": "0355021", "target": "#nkr_note_mod_0355021", "type": "mod", "text": "鼠【大】，鼠袋【校異-原】"}
{"id": null, "n": "0355022", "target": "#nkr_note_mod_0355022", "type": "mod", "text": "其【大】，其袋【校異-原】"}
{"id": null, "n": "0355023", "target": "#nkr_note_mod_0355023", "type": "mod", "text": "供【大】，供養【乙】"}
{"id": null, "n": "0355024", "target": "#nkr_note_mod_0355024", "type": "mod", "text": "又【大】，又吾呪【校異-原】，又吾呪【甲】【乙】"}
{"id": null, "n": "0355025", "target": "#nkr_note_mod_0355025", "type": "mod", "text": "吾呪【大】，〔－〕【校異-原】，〔－〕【甲】【乙】"}
{"id": null, "n": "0355026", "target": "#nkr_note_mod_0355026", "type": "mod", "text": "曰【大】，〔－〕【甲】"}
{"id": null, "n": "0355027", "target": "#nkr_note_mod_0355027", "type": "mod", "text": "隷【大】，齡二合【甲】，齡一合【乙】"}
{"id": null, "n": "0355028", "target": "#nkr_note_mod_0355028", "type": "mod", "text": "帝【大】，帝也【乙】"}
{"id": null, "n": "0355029", "target": "#nkr_note_mod_0355029", "type": "mod", "text": "娑婆訶【大】，沙呵【甲】【乙】"}
{"id": null, "n": "0355030", "target": "#nkr_note_mod_0355030", "type": "mod", "text": "婆訶【大】，嚩呵【校異-原】"}
{"id": null, "n": "0355031", "target": "#nkr_note_mod_0355031", "type": "mod", "text": "二【大】＊，〔－〕【甲】【乙】＊"}
{"id": null, "n": "0355032", "target": "#nkr_note_mod_0355032", "type": "mod", "text": "禮供【大】，東俗【甲】，來供【乙】"}
{"id": null, "n": "0355033", "target": "#nkr_note_mod_0355033", "type": "mod", "text": "久【大】，之【甲】"}
{"id": null, "n": "0355034", "target": "#nkr_note_mod_0355034", "type": "mod", "text": "當【大】，唐【甲】【乙】"}
{"id": null, "n": "0355035", "target": "#nkr_note_mod_0355035", "type": "mod", "text": "土【大】，古【甲】【乙】"}
{"id": null, "n": "0355036", "target": "#nkr_note_mod_0355036", "type": "mod", "text": "因【大】，自【乙】"}
{"id": null, "n": "0355037", "target": "#nkr_note_mod_0355037", "type": "mod", "text": "後【大】，彼【校異-原】"}
{"id": null, "n": "0355038", "target": "#nkr_note_mod_0355038", "type": "mod", "text": "輩【大】，背【乙】"}
{"id": null, "n": "0355039", "target": "#nkr_note_mod_0355039", "type": "mod", "text": "貽【大】，贈【乙】"}
{"id": null, "n": "0355040", "target": "#nkr_note_mod_0355040", "type": "mod", "text": "神【大】，〔－〕【甲】"}
{"id": null, "n": "0355041", "target": "#nkr_note_mod_0355041", "type": "mod", "text": "法【大】，法摩訶迦羅天用普印攝大中摩賀迦羅天摩迦賀羅野荷呵【乙】"}
{"id": null, "n": "0355042", "target": "#nkr_note_mod_0355042", "type": "mod", "text": "（師云…面）一千三百八十九字【大】，〔－〕【乙】"}
{"id": null, "n": "0355043", "target": "#nkr_note_mod_0355043", "type": "mod", "text": "此【大】，此法【校異-原】，此法【甲】"}
{"id": null, "n": "0355044", "target": "#nkr_note_mod_0355044", "type": "mod", "text": "弟子【大】，〔－〕【甲】"}
{"id": null, "n": "0355045", "target": "#nkr_note_mod_0355045", "type": "mod", "text": "傳【大】，令傳【校異-原】"}
{"id": null, "n": "0355046", "target": "#nkr_note_mod_0355046", "type": "mod", "text": "受【大】，授【甲】"}
{"id": null, "n": "0355047", "target": "#nkr_note_mod_0355047", "type": "mod", "text": "千金莫傳【大】，莫傳千金【甲】"}
{"id": null, "n": "0355048", "target": "#nkr_note_mod_0355048", "type": "mod", "text": "力【大】，力努力【甲】"}
{"id": null, "n": "0355049", "target": "#nkr_note_mod_0355049", "type": "mod", "text": "（讚天…也）八十七字【大】，〔－〕【甲】"}
{"id": null, "n": "0355050", "target": "#nkr_note_mod_0355050", "type": "mod", "text": "天【大】，諸天【校異-原】"}
{"id": null, "n": "0355051", "target": "#nkr_note_mod_0355051", "type": "mod", "text": "號【大】，號集【校異-原】"}
{"id": null, "n": "0355052", "target": "#nkr_note_mod_0355052", "type": "mod", "text": "手【大】，〔－〕【校異-原】"}
{"id": null, "n": "0355053", "target": "#nkr_note_mod_0355053", "type": "mod", "text": "髻【大】，鬘【校異-原】"}
{"id": null, "n": "0355054", "target": "#nkr_note_mod_0355054", "type": "mod", "text": "牝【大】，把【校異-原】"}
{"id": null, "n": "0355055", "target": "#nkr_note_mod_0355055", "type": "mod", "text": "右【大】，右手【校異-原】"}
{"id": null, "n": "0355056", "target": "#nkr_note_mod_0355056", "type": "mod", "text": "黑淺【大】，淺黑【校異-原】"}
{"id": null, "n": "0355057", "target": "#nkr_note_mod_0355057", "type": "mod", "text": "言【大】，〔－〕【甲】"}
{"id": null, "n": "0355058", "target": "#nkr_note_mod_0355058", "type": "mod", "text": "者此【大】，〔－〕【甲】"}
{"id": null, "n": "0355059", "target": "#nkr_note_mod_0355059", "type": "mod", "text": "嚮【大】，饗【甲】"}
{"id": null, "n": "0355060", "target": "#nkr_note_mod_0355060", "type": "mod", "text": "祀【大】，神祀【甲】"}
{"id": null, "n": "0356001", "target": "#nkr_note_mod_0356001", "type": "mod", "text": "筴【大】，夾【校異-原】"}
{"id": null, "n": "0356002", "target": "#nkr_note_mod_0356002", "type": "mod", "text": "王【大】，〔－〕【甲】"}
{"id": null, "n": "0356003", "target": "#nkr_note_mod_0356003", "type": "mod", "text": "城【大】，城之【校異-原】，城之【甲】"}
{"id": null, "n": "0356004", "target": "#nkr_note_mod_0356004", "type": "mod", "text": "橫【大】，廣【甲】"}
{"id": null, "n": "0356005", "target": "#nkr_note_mod_0356005", "type": "mod", "text": "藥【大】，〔－〕【甲】"}
{"id": null, "n": "0356006", "target": "#nkr_note_mod_0356006", "type": "mod", "text": "飛【大】，虛【甲】"}
{"id": null, "n": "0356007", "target": "#nkr_note_mod_0356007", "type": "mod", "text": "肉【大】，〔－〕【甲】"}
{"id": null, "n": "0356008", "target": "#nkr_note_mod_0356008", "type": "mod", "text": "約【大】，幻【甲】"}
{"id": null, "n": "0356009", "target": "#nkr_note_mod_0356009", "type": "mod", "text": "往【大】，往先【校異-原】，往先【甲】"}
{"id": null, "n": "0356010", "target": "#nkr_note_mod_0356010", "type": "mod", "text": "減【大】，咸【甲】"}
{"id": null, "n": "0356011", "target": "#nkr_note_mod_0356011", "type": "mod", "text": "身【大】，〔－〕【甲】"}
{"id": null, "n": "0356012", "target": "#nkr_note_mod_0356012", "type": "mod", "text": "貿【大】，貨【甲】"}
{"id": null, "n": "0356013", "target": "#nkr_note_mod_0356013", "type": "mod", "text": "嚮祀【大】，禮饗【甲】"}
{"id": null, "n": "0356014", "target": "#nkr_note_mod_0356014", "type": "mod", "text": "也【大】，〔－〕【校異-原】【甲】"}
{"id": null, "n": "0356015", "target": "#nkr_note_mod_0356015", "type": "mod", "text": "作【大】＊，化【甲】＊"}
{"id": null, "n": "0356016", "target": "#nkr_note_mod_0356016", "type": "mod", "text": "皆【大】，〔－〕【甲】"}
