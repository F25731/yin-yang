{"id": null, "n": null, "target": null, "type": null, "text": "七反"}
{"id": null, "n": "0357069", "target": "#nkr_note_mod_0357069", "type": "mod", "text": "是也【大】，〔－〕【乙】"}
{"id": null, "n": "0357070", "target": "#nkr_note_mod_0357070", "type": "mod", "text": "真言【大】，真言【乙】"}
