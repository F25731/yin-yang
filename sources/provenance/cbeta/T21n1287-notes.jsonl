{"id": null, "n": "0356046", "target": "#nkr_note_mod_0356046", "type": "mod", "text": "能【大】，〔－〕【甲】"}
{"id": null, "n": "0356047", "target": "#nkr_note_mod_0356047", "type": "mod", "text": "命【大】，今【甲】"}
{"id": null, "n": "0356048", "target": "#nkr_note_mod_0356048", "type": "mod", "text": "（唎二…垢）八字【大】，言引剃物也【甲】"}
{"id": null, "n": "0356049", "target": "#nkr_note_mod_0356049", "type": "mod", "text": "訶【大】，訶行也【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "行也"}
{"id": null, "n": "0356050", "target": "#nkr_note_mod_0356050", "type": "mod", "text": "除彼邪術之垢也七字甲本作本文"}
{"id": null, "n": "0356051", "target": "#nkr_note_mod_0356051", "type": "mod", "text": "三世降【大】，〔－〕【甲】"}
{"id": null, "n": "0356052", "target": "#nkr_note_mod_0356052", "type": "mod", "text": "迦羅【大】，〔－〕【甲】"}
{"id": null, "n": "0356053", "target": "#nkr_note_mod_0356053", "type": "mod", "text": "大日經【大】，仁王【甲】"}
{"id": null, "n": "0356054", "target": "#nkr_note_mod_0356054", "type": "mod", "text": "又云大闇夜天【大】，〔－〕【甲】"}
{"id": null, "n": "0356055", "target": "#nkr_note_mod_0356055", "type": "mod", "text": "以【大】，故以【甲】"}
{"id": null, "n": "0356056", "target": "#nkr_note_mod_0356056", "type": "mod", "text": "翻【大】，翻羅【甲】"}
{"id": null, "n": "0356057", "target": "#nkr_note_mod_0356057", "type": "mod", "text": "闇【大】，闇云云【甲】"}
