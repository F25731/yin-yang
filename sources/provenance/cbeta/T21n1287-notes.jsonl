{"id": null, "n": "0356043", "target": "#nkr_note_mod_0356043", "type": "mod", "text": "天【大】，人【校異-原】，〔－〕【甲】"}
{"id": null, "n": "0356044", "target": "#nkr_note_mod_0356044", "type": "mod", "text": "爭【大】，年【甲】"}
