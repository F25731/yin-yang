{"id": null, "n": "0357066", "target": "#nkr_note_mod_0357066", "type": "mod", "text": "惡【大】，惡印【乙】"}
{"id": null, "n": "0357067", "target": "#nkr_note_mod_0357067", "type": "mod", "text": "拜【大】，〔－〕【乙】"}
