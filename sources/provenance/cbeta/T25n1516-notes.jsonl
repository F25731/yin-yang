{"id": null, "n": "0898004", "target": "#nkr_note_mod_0898004", "type": "mod", "text": "邪【大】＊，耶【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0900001", "target": "#nkr_note_mod_0900001", "type": "mod", "text": "加【大】，跏【明】"}
{"id": null, "n": "0900002", "target": "#nkr_note_mod_0900002", "type": "mod", "text": "真【大】，者【明】"}
{"id": null, "n": "0900003", "target": "#nkr_note_mod_0900003", "type": "mod", "text": "者【大】，所【明】"}
