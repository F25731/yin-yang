{"id": null, "n": "0898001", "target": "#nkr_note_mod_0898001", "type": "mod", "text": "西天【大】＊，宋西天【明】＊"}
{"id": null, "n": "0898002", "target": "#nkr_note_mod_0898002", "type": "mod", "text": "譯經【大】＊，〔－〕【明】＊"}
