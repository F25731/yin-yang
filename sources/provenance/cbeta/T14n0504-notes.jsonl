{"id": null, "n": null, "target": null, "type": "cf1", "text": "K20n0873_p1246a15"}
{"id": null, "n": "0772001", "target": "#nkr_note_mod_0772001", "type": "mod", "text": "比【大】＊，佛說比【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0772002", "target": "#nkr_note_mod_0772002", "type": "mod", "text": "天竺三藏【大】，沙門竺【宋】【元】【明】【宮】"}
{"id": null, "n": "0772003", "target": "#nkr_note_mod_0772003", "type": "mod", "text": "到【大】，來到【元】【明】"}
{"id": null, "n": "0772004", "target": "#nkr_note_mod_0772004", "type": "mod", "text": "佛足【大】，匝佛【宋】【元】【明】【宮】"}
{"id": null, "n": "0772005", "target": "#nkr_note_mod_0772005", "type": "mod", "text": "若【大】，汝【元】【明】"}
{"id": null, "n": "0772006", "target": "#nkr_note_mod_0772006", "type": "mod", "text": "以知【大】，知以【元】【明】"}
{"id": null, "n": "0772007", "target": "#nkr_note_mod_0772007", "type": "mod", "text": "變【大】＊，戀【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0772008", "target": "#nkr_note_mod_0772008", "type": "mod", "text": "無【大】，不【明】"}
{"id": null, "n": "0772009", "target": "#nkr_note_mod_0772009", "type": "mod", "text": "如是若干從【大】，〔－〕【明】"}
{"id": null, "n": "0772010", "target": "#nkr_note_mod_0772010", "type": "mod", "text": "慷慨【大】＊，慷愾【宮】＊"}
{"id": null, "n": "0772011", "target": "#nkr_note_mod_0772011", "type": "mod", "text": "識【大】，色【明】"}
{"id": null, "n": "0772012a", "target": "#nkr_note_mod_0772012a", "type": "mod", "text": "寧彼有是無有【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0772012b", "target": "#nkr_note_mod_0772012b", "type": "mod", "text": "聽施言彼有是【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0772012c", "target": "#nkr_note_mod_0772012c", "type": "mod", "text": "佛言善哉善哉【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0772013", "target": "#nkr_note_mod_0772013", "type": "mod", "text": "往【大】，住【宋】【元】【明】【宮】"}
{"id": null, "n": "0772014", "target": "#nkr_note_mod_0772014", "type": "mod", "text": "稍便【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0772015", "target": "#nkr_note_mod_0772015", "type": "mod", "text": "下【大】，不【宮】"}
{"id": null, "n": "0772016", "target": "#nkr_note_mod_0772016", "type": "mod", "text": "欲【大】，恣【宋】【元】【明】【宮】"}
{"id": null, "n": "0772001", "target": "#nkr_note_orig_0772001", "type": "orig", "text": "（佛說）＋比【三】【宮】＊"}
{"id": null, "n": "0772002", "target": "#nkr_note_orig_0772002", "type": "orig", "text": "天竺三藏＝沙門竺【三】【宮】"}
{"id": null, "n": "0772003", "target": "#nkr_note_orig_0772003", "type": "orig", "text": "（來）＋到【元】【明】"}
{"id": null, "n": "0772004", "target": "#nkr_note_orig_0772004", "type": "orig", "text": "佛足＝匝佛【三】【宮】"}
{"id": null, "n": "0772005", "target": "#nkr_note_orig_0772005", "type": "orig", "text": "若＝汝【元】【明】"}
{"id": null, "n": "0772006", "target": "#nkr_note_orig_0772006", "type": "orig", "text": "以知＝知以【元】【明】"}
{"id": null, "n": "0772007", "target": "#nkr_note_orig_0772007", "type": "orig", "text": "變＝戀【三】【宮】＊"}
{"id": null, "n": "0772008", "target": "#nkr_note_orig_0772008", "type": "orig", "text": "無＝不【明】"}
{"id": null, "n": "0772009", "target": "#nkr_note_orig_0772009", "type": "orig", "text": "〔如是若干從〕－【明】"}
{"id": null, "n": "0772010", "target": "#nkr_note_orig_0772010", "type": "orig", "text": "慷慨＝慷愾【宮】＊"}
{"id": null, "n": "0772011", "target": "#nkr_note_orig_0772011", "type": "orig", "text": "識＝色【明】"}
{"id": null, "n": "0772012", "target": "#nkr_note_orig_0772012", "type": "orig", "text": "〔寧彼…善哉〕十八字－【三】【宮】"}
{"id": null, "n": "0772013", "target": "#nkr_note_orig_0772013", "type": "orig", "text": "往＝住【三】【宮】"}
{"id": null, "n": "0772014", "target": "#nkr_note_orig_0772014", "type": "orig", "text": "〔稍便〕－【三】【宮】"}
{"id": null, "n": "0772015", "target": "#nkr_note_orig_0772015", "type": "orig", "text": "下＝不【宮】"}
{"id": null, "n": "0772016", "target": "#nkr_note_orig_0772016", "type": "orig", "text": "欲＝恣【三】【宮】"}
{"id": null, "n": "0772c1801", "target": "#nkr_note_add_0772c1801", "type": "add", "text": "我【CB】【麗-CB】，者【大】"}
