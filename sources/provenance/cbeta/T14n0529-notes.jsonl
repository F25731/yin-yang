{"id": null, "n": "0804008", "target": "#nkr_note_mod_0804008", "type": "mod", "text": "佛說【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0804009", "target": "#nkr_note_mod_0804009", "type": "mod", "text": "（僧祐錄…漢錄）十三字【大】，後漢失譯【宋】【元】，後漢失譯人名【明】，失譯今附漢錄【宮】"}
{"id": null, "n": "0804010", "target": "#nkr_note_mod_0804010", "type": "mod", "text": "當【大】，〔－〕【宮】"}
{"id": null, "n": "0804011", "target": "#nkr_note_mod_0804011", "type": "mod", "text": "經【大】，徑【宮】"}
{"id": null, "n": "0804012", "target": "#nkr_note_mod_0804012", "type": "mod", "text": "已【大】＊，以【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0804013", "target": "#nkr_note_mod_0804013", "type": "mod", "text": "多【大】＊，幻【宮】＊"}
{"id": null, "n": "0804014", "target": "#nkr_note_mod_0804014", "type": "mod", "text": "來【大】，談【宮】"}
{"id": null, "n": "0804015", "target": "#nkr_note_mod_0804015", "type": "mod", "text": "香【大】，之【宮】"}
{"id": null, "n": "0804016", "target": "#nkr_note_mod_0804016", "type": "mod", "text": "極【大】，然【宋】"}
{"id": null, "n": "0804017", "target": "#nkr_note_mod_0804017", "type": "mod", "text": "飲【大】，食【宋】"}
{"id": null, "n": "0804018", "target": "#nkr_note_mod_0804018", "type": "mod", "text": "為【大】，為何【明】"}
{"id": null, "n": "0804019", "target": "#nkr_note_mod_0804019", "type": "mod", "text": "復【大】，〔－〕【宮】"}
{"id": null, "n": "0804020", "target": "#nkr_note_mod_0804020", "type": "mod", "text": "得【大】，所得【宋】【元】【明】【宮】"}
{"id": null, "n": "0804021", "target": "#nkr_note_mod_0804021", "type": "mod", "text": "言【大】，答言【宋】【元】【明】【宮】"}
{"id": null, "n": "0804022", "target": "#nkr_note_mod_0804022", "type": "mod", "text": "水【大】，〔－〕【明】【宮】"}
{"id": null, "n": "0804023", "target": "#nkr_note_mod_0804023", "type": "mod", "text": "飲【大】，飯【宋】【元】【明】【宮】"}
{"id": null, "n": "0804024", "target": "#nkr_note_mod_0804024", "type": "mod", "text": "虎魄【大】，琥珀【宋】【元】【明】【宮】"}
{"id": null, "n": "0804025", "target": "#nkr_note_mod_0804025", "type": "mod", "text": "如【大】，而【宮】"}
{"id": null, "n": "0804026", "target": "#nkr_note_mod_0804026", "type": "mod", "text": "呪【大】，祝【宋】【元】【明】"}
{"id": null, "n": "0804027", "target": "#nkr_note_mod_0804027", "type": "mod", "text": "琦【大】，珂【宮】"}
{"id": null, "n": "0804028", "target": "#nkr_note_mod_0804028", "type": "mod", "text": "不【大】，下【宮】"}
{"id": null, "n": "0805001", "target": "#nkr_note_mod_0805001", "type": "mod", "text": "飲【大】，飯【宮】"}
{"id": null, "n": "0805002", "target": "#nkr_note_mod_0805002", "type": "mod", "text": "瀾汗【大】，潘汁【宋】，𤄜汁【元】，瀋汁【明】，灡汁【宮】"}
{"id": null, "n": "0805003", "target": "#nkr_note_mod_0805003", "type": "mod", "text": "阿【大】，〔－〕【宮】"}
{"id": null, "n": "0805004", "target": "#nkr_note_mod_0805004", "type": "mod", "text": "杅【大】，盂【宮】"}
{"id": null, "n": "0805005", "target": "#nkr_note_mod_0805005", "type": "mod", "text": "央【大】，鞅【宋】【元】"}
{"id": null, "n": "0805006", "target": "#nkr_note_mod_0805006", "type": "mod", "text": "凡【大】，見【宋】"}
{"id": null, "n": "0805007", "target": "#nkr_note_mod_0805007", "type": "mod", "text": "世在【大】，在天【宋】【元】【明】【宮】"}
{"id": null, "n": "0804008", "target": "#nkr_note_orig_0804008", "type": "orig", "text": "〔佛說〕－【三】＊"}
{"id": null, "n": "0804009", "target": "#nkr_note_orig_0804009", "type": "orig", "text": "（僧祐錄…漢錄）十三字＝後漢失譯【宋】【元】，後漢失譯人名【明】，失譯今附漢錄【宮】"}
{"id": null, "n": "0804010", "target": "#nkr_note_orig_0804010", "type": "orig", "text": "〔當〕－【宮】"}
{"id": null, "n": "0804011", "target": "#nkr_note_orig_0804011", "type": "orig", "text": "經＝徑【宮】"}
{"id": null, "n": "0804012", "target": "#nkr_note_orig_0804012", "type": "orig", "text": "已＝以【三】【宮】＊"}
{"id": null, "n": "0804013", "target": "#nkr_note_orig_0804013", "type": "orig", "text": "多＝幻【宮】＊"}
{"id": null, "n": "0804014", "target": "#nkr_note_orig_0804014", "type": "orig", "text": "來＝談【宮】"}
{"id": null, "n": "0804015", "target": "#nkr_note_orig_0804015", "type": "orig", "text": "香＝之【宮】"}
{"id": null, "n": "0804016", "target": "#nkr_note_orig_0804016", "type": "orig", "text": "極＝然【宋】"}
{"id": null, "n": "0804017", "target": "#nkr_note_orig_0804017", "type": "orig", "text": "飲＝食【宋】"}
{"id": null, "n": "0804018", "target": "#nkr_note_orig_0804018", "type": "orig", "text": "為＋（何）【明】"}
{"id": null, "n": "0804019", "target": "#nkr_note_orig_0804019", "type": "orig", "text": "〔復〕－【宮】"}
{"id": null, "n": "0804020", "target": "#nkr_note_orig_0804020", "type": "orig", "text": "（所）＋得【三】【宮】"}
{"id": null, "n": "0804021", "target": "#nkr_note_orig_0804021", "type": "orig", "text": "（答）＋言【三】【宮】"}
{"id": null, "n": "0804022", "target": "#nkr_note_orig_0804022", "type": "orig", "text": "〔水〕－【明】【宮】"}
{"id": null, "n": "0804023", "target": "#nkr_note_orig_0804023", "type": "orig", "text": "飲＝飯【三】【宮】"}
{"id": null, "n": "0804024", "target": "#nkr_note_orig_0804024", "type": "orig", "text": "虎魄＝琥珀【三】【宮】"}
{"id": null, "n": "0804025", "target": "#nkr_note_orig_0804025", "type": "orig", "text": "如＝而【宮】"}
{"id": null, "n": "0804026", "target": "#nkr_note_orig_0804026", "type": "orig", "text": "呪＝祝【三】"}
{"id": null, "n": "0804027", "target": "#nkr_note_orig_0804027", "type": "orig", "text": "琦＝珂【宮】"}
{"id": null, "n": "0804028", "target": "#nkr_note_orig_0804028", "type": "orig", "text": "不＝下【宮】"}
{"id": null, "n": "0805001", "target": "#nkr_note_orig_0805001", "type": "orig", "text": "飲＝飯【宮】"}
{"id": null, "n": "0805002", "target": "#nkr_note_orig_0805002", "type": "orig", "text": "瀾汗＝潘汁【宋】，𤄜汁【元】，瀋汁【明】，灡汁【宮】"}
{"id": null, "n": "0805003", "target": "#nkr_note_orig_0805003", "type": "orig", "text": "〔阿〕－【宮】"}
{"id": null, "n": "0805004", "target": "#nkr_note_orig_0805004", "type": "orig", "text": "杅＝盂【宮】"}
{"id": null, "n": "0805005", "target": "#nkr_note_orig_0805005", "type": "orig", "text": "央＝鞅【宋】【元】"}
{"id": null, "n": "0805006", "target": "#nkr_note_orig_0805006", "type": "orig", "text": "凡＝見【宋】"}
{"id": null, "n": "0805007", "target": "#nkr_note_orig_0805007", "type": "orig", "text": "世在＝在天【三】【宮】"}
