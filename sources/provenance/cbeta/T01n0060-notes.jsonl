{"id": null, "n": "0856001", "target": "#nkr_note_mod_0856001", "type": "mod", "text": "宋【大】，劉宋【元】【明】"}
{"id": null, "n": "0856002", "target": "#nkr_note_mod_0856002", "type": "mod", "text": "唯【大】＊，惟【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0856003", "target": "#nkr_note_mod_0856003", "type": "mod", "text": "瞪【大】＊，𧄼【元】【明】＊"}
{"id": null, "n": "0856004", "target": "#nkr_note_mod_0856004", "type": "mod", "text": "曰【大】，言【宋】【元】【明】"}
{"id": null, "n": "0856005", "target": "#nkr_note_mod_0856005", "type": "mod", "text": "間【大】，門【宋】"}
{"id": null, "n": "0856006", "target": "#nkr_note_mod_0856006", "type": "mod", "text": "益【大】，饒益【元】【明】"}
{"id": null, "n": "0856007", "target": "#nkr_note_mod_0856007", "type": "mod", "text": "習【大】＊，集【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0856008", "target": "#nkr_note_mod_0856008", "type": "mod", "text": "具【大】，持【宋】【元】【明】"}
{"id": null, "n": "0857001", "target": "#nkr_note_mod_0857001", "type": "mod", "text": "毘尼【大】＊，鼻貳【宋】【元】＊"}
{"id": null, "n": "0857002", "target": "#nkr_note_mod_0857002", "type": "mod", "text": "於【大】，與【明】"}
{"id": null, "n": "0857003", "target": "#nkr_note_mod_0857003", "type": "mod", "text": "事【大】，承事【宋】【元】【明】"}
{"id": null, "n": "0857004", "target": "#nkr_note_mod_0857004", "type": "mod", "text": "匐【大】，蔔【宋】【元】【明】"}
{"id": null, "n": "0857005", "target": "#nkr_note_mod_0857005", "type": "mod", "text": "老【大】，耆【宋】【元】【明】"}
{"id": null, "n": "0857006", "target": "#nkr_note_mod_0857006", "type": "mod", "text": "今【大】，令【宋】【元】【明】"}
{"id": null, "n": "0857007", "target": "#nkr_note_mod_0857007", "type": "mod", "text": "止【大】，正【宋】【元】【明】"}
{"id": null, "n": "0857008", "target": "#nkr_note_mod_0857008", "type": "mod", "text": "難【大】，阿【宋】"}
{"id": null, "n": "0857009", "target": "#nkr_note_mod_0857009", "type": "mod", "text": "護【大】，惟【宋】"}
{"id": null, "n": "0857010", "target": "#nkr_note_mod_0857010", "type": "mod", "text": "奇【大】，受【宋】"}
{"id": null, "n": "0857011", "target": "#nkr_note_mod_0857011", "type": "mod", "text": "抱【大】，把【宋】【元】【明】"}
{"id": null, "n": "0857012", "target": "#nkr_note_mod_0857012", "type": "mod", "text": "安【大】，故【明】"}
{"id": null, "n": "0857013", "target": "#nkr_note_mod_0857013", "type": "mod", "text": "神【大】，神極有威神【宋】【元】【明】"}
