{"id": null, "n": "0896022", "target": "#nkr_note_mod_0896022", "type": "mod", "text": "於【大】下同，于【明】下同"}
{"id": null, "n": "0897001", "target": "#nkr_note_mod_0897001", "type": "mod", "text": "若【大】，諸【宋】【元】【明】【宮】"}
