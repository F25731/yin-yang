{"id": null, "n": "0897003", "target": "#nkr_note_mod_0897003", "type": "mod", "text": "苦【大】，若【宮】"}
{"id": null, "n": "0897004", "target": "#nkr_note_mod_0897004", "type": "mod", "text": "盤【大】＊，槃【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0897005", "target": "#nkr_note_mod_0897005", "type": "mod", "text": "滅【大】，靜【宋】【元】【明】【宮】"}
{"id": null, "n": "0898001", "target": "#nkr_note_mod_0898001", "type": "mod", "text": "是【大】，其【宋】【元】【明】【宮】"}
{"id": null, "n": "0898002", "target": "#nkr_note_mod_0898002", "type": "mod", "text": "耶【大】，邪【明】"}
{"id": null, "n": "0898003", "target": "#nkr_note_mod_0898003", "type": "mod", "text": "浮【大】，渡【明】"}
