{"id": null, "n": null, "target": null, "type": "cf1", "text": "AC6385_001_0001a08"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "《思溪藏》（中國國家圖書館藏第1522冊第26圖第7行）"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K11n0277_p0621a18"}
{"id": null, "n": "0779005", "target": "#nkr_note_mod_0779005", "type": "mod", "text": "西【大】，〔－〕【宋】"}
{"id": null, "n": "0779006", "target": "#nkr_note_mod_0779006", "type": "mod", "text": "月氏三藏【大】，三藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0779007", "target": "#nkr_note_mod_0779007", "type": "mod", "text": "乾【大】，犍【宋】【元】【明】【宮】"}
{"id": null, "n": "0779008", "target": "#nkr_note_mod_0779008", "type": "mod", "text": "立【大】，柱【宮】"}
{"id": null, "n": "0779009", "target": "#nkr_note_mod_0779009", "type": "mod", "text": "即【大】，即以【宋】【元】【明】"}
{"id": null, "n": "0779010", "target": "#nkr_note_mod_0779010", "type": "mod", "text": "鉢【CB】【金藏乙-CB】【思溪-CB】【宋】【元】【明】，飯【大】"}
{"id": null, "n": "0779011", "target": "#nkr_note_mod_0779011", "type": "mod", "text": "飯【大】，食【宋】【元】【明】【宮】"}
{"id": null, "n": "0779012", "target": "#nkr_note_mod_0779012", "type": "mod", "text": "啼【大】，涕【宋】【元】【明】【宮】"}
{"id": null, "n": "0779013", "target": "#nkr_note_mod_0779013", "type": "mod", "text": "神【大】，祈【宋】，祇【元】【明】"}
{"id": null, "n": "0779014", "target": "#nkr_note_mod_0779014", "type": "mod", "text": "為汝【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0779015", "target": "#nkr_note_mod_0779015", "type": "mod", "text": "罪障消除【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0779016", "target": "#nkr_note_mod_0779016", "type": "mod", "text": "於【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0779017", "target": "#nkr_note_mod_0779017", "type": "mod", "text": "錠爥【大】，挻燭【宋】，鋋燭【元】【明】【宮】"}
{"id": null, "n": "0779018", "target": "#nkr_note_mod_0779018", "type": "mod", "text": "或【大】，〔－〕【宮】"}
{"id": null, "n": "0779019", "target": "#nkr_note_mod_0779019", "type": "mod", "text": "或【大】，或在【元】【明】"}
{"id": null, "n": "0779020", "target": "#nkr_note_mod_0779020", "type": "mod", "text": "在【大】，世【宋】【元】【明】【宮】"}
{"id": null, "n": "0779021", "target": "#nkr_note_mod_0779021", "type": "mod", "text": "七世父母【大】，〔－〕【元】【明】"}
{"id": null, "n": "0779022", "target": "#nkr_note_mod_0779022", "type": "mod", "text": "六種親屬【大】，六親眷屬【宋】【元】【明】"}
{"id": null, "n": "0779023", "target": "#nkr_note_mod_0779023", "type": "mod", "text": "復有人【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0779024", "target": "#nkr_note_mod_0779024", "type": "mod", "text": "已亡【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0779025", "target": "#nkr_note_mod_0779025", "type": "mod", "text": "受無量快樂【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0779026", "target": "#nkr_note_mod_0779026", "type": "mod", "text": "先【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "0779027", "target": "#nkr_note_mod_0779027", "type": "mod", "text": "家【大】，〔－〕【宮】"}
{"id": null, "n": "0779028", "target": "#nkr_note_mod_0779028", "type": "mod", "text": "七【大】，願七【宋】【元】【明】"}
{"id": null, "n": "0779029", "target": "#nkr_note_mod_0779029", "type": "mod", "text": "盆【大】，食【宋】【元】【明】【宮】"}
{"id": null, "n": "0779030", "target": "#nkr_note_mod_0779030", "type": "mod", "text": "塔【大】，前塔寺中佛【宋】【元】【明】"}
{"id": null, "n": "0779031", "target": "#nkr_note_mod_0779031", "type": "mod", "text": "爾【大】＊，〔－〕【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0779032", "target": "#nkr_note_mod_0779032", "type": "mod", "text": "此大會【大】，〔－〕【宋】【元】【明】，此大眾【宮】"}
{"id": null, "n": "0779033", "target": "#nkr_note_mod_0779033", "type": "mod", "text": "而【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0779034", "target": "#nkr_note_mod_0779034", "type": "mod", "text": "是【大】，〔－〕【元】"}
{"id": null, "n": "0779035", "target": "#nkr_note_mod_0779035", "type": "mod", "text": "其【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0779036", "target": "#nkr_note_mod_0779036", "type": "mod", "text": "爾時【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0779037", "target": "#nkr_note_mod_0779037", "type": "mod", "text": "父【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0779038", "target": "#nkr_note_mod_0779038", "type": "mod", "text": "行孝順者【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0779039", "target": "#nkr_note_mod_0779039", "type": "mod", "text": "亦應【大】，應亦【宋】"}
{"id": null, "n": "0779040", "target": "#nkr_note_mod_0779040", "type": "mod", "text": "此【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0779041", "target": "#nkr_note_mod_0779041", "type": "mod", "text": "不【大】，否【宋】【元】【明】"}
{"id": null, "n": "0779042", "target": "#nkr_note_mod_0779042", "type": "mod", "text": "有【大】，〔－〕【明】"}
{"id": null, "n": "0779043", "target": "#nkr_note_mod_0779043", "type": "mod", "text": "王子【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0779044", "target": "#nkr_note_mod_0779044", "type": "mod", "text": "孝慈【大】，慈孝【宋】【元】【明】"}
{"id": null, "n": "0779045", "target": "#nkr_note_mod_0779045", "type": "mod", "text": "應【大】，應先【宋】【元】【明】"}
{"id": null, "n": "0779046", "target": "#nkr_note_mod_0779046", "type": "mod", "text": "飲【大】，飯【元】"}
{"id": null, "n": "0779047", "target": "#nkr_note_mod_0779047", "type": "mod", "text": "乞【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0779048", "target": "#nkr_note_mod_0779048", "type": "mod", "text": "便【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0779049", "target": "#nkr_note_mod_0779049", "type": "mod", "text": "得【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0779050", "target": "#nkr_note_mod_0779050", "type": "mod", "text": "天人【大】，人天【宋】【元】【明】"}
{"id": null, "n": "0779051", "target": "#nkr_note_mod_0779051", "type": "mod", "text": "福【大】，富【元】"}
{"id": null, "n": "0779052", "target": "#nkr_note_mod_0779052", "type": "mod", "text": "（佛告…人）九字【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0779053", "target": "#nkr_note_mod_0779053", "type": "mod", "text": "供養【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0779054", "target": "#nkr_note_mod_0779054", "type": "mod", "text": "常【大】，當【宋】【元】【明】"}
{"id": null, "n": "0779055", "target": "#nkr_note_mod_0779055", "type": "mod", "text": "順【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0779056", "target": "#nkr_note_mod_0779056", "type": "mod", "text": "乃至七世父母【大】，〔－〕【元】【明】"}
{"id": null, "n": "0779057", "target": "#nkr_note_mod_0779057", "type": "mod", "text": "聞佛所說【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0779005", "target": "#nkr_note_orig_0779005", "type": "orig", "text": "〔西〕－【宋】"}
{"id": null, "n": "0779006", "target": "#nkr_note_orig_0779006", "type": "orig", "text": "月氏三藏＝三藏法師【三】【宮】"}
{"id": null, "n": "0779007", "target": "#nkr_note_orig_0779007", "type": "orig", "text": "乾＝犍【三】【宮】"}
{"id": null, "n": "0779008", "target": "#nkr_note_orig_0779008", "type": "orig", "text": "立＝柱【宮】"}
{"id": null, "n": "0779009", "target": "#nkr_note_orig_0779009", "type": "orig", "text": "即＋（以）【三】"}
{"id": null, "n": "0779010", "target": "#nkr_note_orig_0779010", "type": "orig", "text": "飯＝鉢【三】"}
{"id": null, "n": "0779011", "target": "#nkr_note_orig_0779011", "type": "orig", "text": "飯＝食【三】【宮】"}
{"id": null, "n": "0779012", "target": "#nkr_note_orig_0779012", "type": "orig", "text": "啼＝涕【三】【宮】"}
{"id": null, "n": "0779013", "target": "#nkr_note_orig_0779013", "type": "orig", "text": "神＝祈【宋】，祇【元】【明】"}
{"id": null, "n": "0779014", "target": "#nkr_note_orig_0779014", "type": "orig", "text": "〔為汝〕－【三】【宮】"}
{"id": null, "n": "0779015", "target": "#nkr_note_orig_0779015", "type": "orig", "text": "〔罪障消除〕－【三】【宮】"}
{"id": null, "n": "0779016", "target": "#nkr_note_orig_0779016", "type": "orig", "text": "〔於〕－【三】【宮】"}
{"id": null, "n": "0779017", "target": "#nkr_note_orig_0779017", "type": "orig", "text": "錠爥＝挻燭【宋】，鋋燭【元】【明】【宮】"}
{"id": null, "n": "0779018", "target": "#nkr_note_orig_0779018", "type": "orig", "text": "〔或〕－【宮】"}
{"id": null, "n": "0779019", "target": "#nkr_note_orig_0779019", "type": "orig", "text": "或＋（在）【元】【明】"}
{"id": null, "n": "0779020", "target": "#nkr_note_orig_0779020", "type": "orig", "text": "在＝世【三】【宮】"}
{"id": null, "n": "0779021", "target": "#nkr_note_orig_0779021", "type": "orig", "text": "〔七世父母〕－【元】【明】"}
{"id": null, "n": "0779022", "target": "#nkr_note_orig_0779022", "type": "orig", "text": "六種親屬＝六親眷屬【三】"}
{"id": null, "n": "0779023", "target": "#nkr_note_orig_0779023", "type": "orig", "text": "〔復有人〕－【三】【宮】"}
{"id": null, "n": "0779024", "target": "#nkr_note_orig_0779024", "type": "orig", "text": "〔已亡〕－【三】【宮】"}
{"id": null, "n": "0779025", "target": "#nkr_note_orig_0779025", "type": "orig", "text": "〔受無量快樂〕－【三】【宮】"}
{"id": null, "n": "0779026", "target": "#nkr_note_orig_0779026", "type": "orig", "text": "〔先〕－【宋】【宮】"}
{"id": null, "n": "0779027", "target": "#nkr_note_orig_0779027", "type": "orig", "text": "〔家〕－【宮】"}
{"id": null, "n": "0779028", "target": "#nkr_note_orig_0779028", "type": "orig", "text": "（願）＋七【三】"}
{"id": null, "n": "0779029", "target": "#nkr_note_orig_0779029", "type": "orig", "text": "盆＝食【三】【宮】"}
{"id": null, "n": "0779030", "target": "#nkr_note_orig_0779030", "type": "orig", "text": "塔＝前塔寺中佛【三】"}
{"id": null, "n": "0779031", "target": "#nkr_note_orig_0779031", "type": "orig", "text": "〔爾〕－【三】【宮】＊"}
{"id": null, "n": "0779032", "target": "#nkr_note_orig_0779032", "type": "orig", "text": "〔此大會〕－【三】，此大會＝此大眾【宮】"}
{"id": null, "n": "0779033", "target": "#nkr_note_orig_0779033", "type": "orig", "text": "〔而〕－【三】"}
{"id": null, "n": "0779034", "target": "#nkr_note_orig_0779034", "type": "orig", "text": "〔是〕－【元】"}
{"id": null, "n": "0779035", "target": "#nkr_note_orig_0779035", "type": "orig", "text": "〔其〕－【三】"}
{"id": null, "n": "0779036", "target": "#nkr_note_orig_0779036", "type": "orig", "text": "〔爾時〕－【三】【宮】"}
{"id": null, "n": "0779037", "target": "#nkr_note_orig_0779037", "type": "orig", "text": "〔父〕－【三】"}
{"id": null, "n": "0779038", "target": "#nkr_note_orig_0779038", "type": "orig", "text": "〔行孝順者〕－【三】【宮】"}
{"id": null, "n": "0779039", "target": "#nkr_note_orig_0779039", "type": "orig", "text": "亦應＝應亦【宋】"}
{"id": null, "n": "0779040", "target": "#nkr_note_orig_0779040", "type": "orig", "text": "〔此〕－【三】【宮】"}
{"id": null, "n": "0779041", "target": "#nkr_note_orig_0779041", "type": "orig", "text": "不＝否【三】"}
{"id": null, "n": "0779042", "target": "#nkr_note_orig_0779042", "type": "orig", "text": "〔有〕－【明】"}
{"id": null, "n": "0779043", "target": "#nkr_note_orig_0779043", "type": "orig", "text": "〔王子〕－【三】"}
{"id": null, "n": "0779044", "target": "#nkr_note_orig_0779044", "type": "orig", "text": "孝慈＝慈孝【三】"}
{"id": null, "n": "0779045", "target": "#nkr_note_orig_0779045", "type": "orig", "text": "應＋（先）【三】"}
{"id": null, "n": "0779046", "target": "#nkr_note_orig_0779046", "type": "orig", "text": "飲＝飯【元】"}
{"id": null, "n": "0779047", "target": "#nkr_note_orig_0779047", "type": "orig", "text": "〔乞〕－【三】"}
{"id": null, "n": "0779048", "target": "#nkr_note_orig_0779048", "type": "orig", "text": "〔便〕－【三】【宮】"}
{"id": null, "n": "0779049", "target": "#nkr_note_orig_0779049", "type": "orig", "text": "〔得〕－【三】【宮】"}
{"id": null, "n": "0779050", "target": "#nkr_note_orig_0779050", "type": "orig", "text": "天人＝人天【三】"}
{"id": null, "n": "0779051", "target": "#nkr_note_orig_0779051", "type": "orig", "text": "福＝富【元】"}
{"id": null, "n": "0779052", "target": "#nkr_note_orig_0779052", "type": "orig", "text": "〔佛告…人〕九字－【三】【宮】"}
{"id": null, "n": "0779053", "target": "#nkr_note_orig_0779053", "type": "orig", "text": "〔供養〕－【三】"}
{"id": null, "n": "0779054", "target": "#nkr_note_orig_0779054", "type": "orig", "text": "常＝當【三】"}
{"id": null, "n": "0779055", "target": "#nkr_note_orig_0779055", "type": "orig", "text": "〔順〕－【三】"}
{"id": null, "n": "0779056", "target": "#nkr_note_orig_0779056", "type": "orig", "text": "〔乃至七世父母〕－【元】【明】"}
{"id": null, "n": "0779057", "target": "#nkr_note_orig_0779057", "type": "orig", "text": "〔聞佛所說〕－【三】【宮】"}
