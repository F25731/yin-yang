{"id": null, "n": "0236001", "target": "#nkr_note_orig_0236001", "type": "orig", "text": "昴疑昂"}
{"id": null, "n": "0237001", "target": "#nkr_note_orig_0237001", "type": "orig", "text": "補入麻字"}
{"id": null, "n": "0226c2401", "target": "#nkr_note_add_0226c2401", "type": "add", "text": "䗫【CB】，󱓄【卍續】"}
