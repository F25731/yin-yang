{"id": null, "n": "0232a0301", "target": "#nkr_note_add_0232a0301", "type": "add", "text": "刺【CB】，剌【卍續】"}
{"id": null, "n": "0232a1101", "target": "#nkr_note_add_0232a1101", "type": "add", "text": "鄧【CB】，㔁【卍續】"}
{"id": null, "n": "0232a2301", "target": "#nkr_note_add_0232a2301", "type": "add", "text": "已【CB】，巳【卍續】"}
{"id": null, "n": "0232b1201", "target": "#nkr_note_add_0232b1201", "type": "add", "text": "刺【CB】，剌【卍續】"}
{"id": null, "n": "0232c0801", "target": "#nkr_note_add_0232c0801", "type": "add", "text": "已【CB】，巳【卍續】"}
