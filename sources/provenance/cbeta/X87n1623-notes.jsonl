{"id": null, "n": "0233a1901", "target": "#nkr_note_add_0233a1901", "type": "add", "text": "己【CB】，已【卍續】"}
{"id": null, "n": "0234a0301", "target": "#nkr_note_add_0234a0301", "type": "add", "text": "筋【CB】，筯【卍續】"}
{"id": null, "n": "0234a1701", "target": "#nkr_note_add_0234a1701", "type": "add", "text": "于【CB】，干【卍續】"}
{"id": null, "n": "0234a1702", "target": "#nkr_note_add_0234a1702", "type": "add", "text": "已【CB】，巳【卍續】"}
