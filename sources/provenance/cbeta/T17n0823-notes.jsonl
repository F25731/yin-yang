{"id": null, "n": "0858003", "target": "#nkr_note_orig_0858003", "type": "orig", "text": "勇＝踊【宋】【宮】＊，涌【元】＊，湧【明】＊"}
{"id": null, "n": "0858004", "target": "#nkr_note_orig_0858004", "type": "orig", "text": "夏＝憂【三】【宮】"}
{"id": null, "n": "0858005", "target": "#nkr_note_orig_0858005", "type": "orig", "text": "〔乾〕－【聖】"}
{"id": null, "n": "0858006", "target": "#nkr_note_orig_0858006", "type": "orig", "text": "婆＋（婆）【聖】"}
{"id": null, "n": "0858007", "target": "#nkr_note_orig_0858007", "type": "orig", "text": "此下聖本有光明皇后願文"}
{"id": null, "n": "0858008", "target": "#nkr_note_orig_0858008", "type": "orig", "text": "〔丹本…經〕十字－【三】【宮】，〔丹本〕二字－【聖】"}
{"id": null, "n": "0858009", "target": "#nkr_note_orig_0858009", "type": "orig", "text": "〔一切…記〕十字－【三】【宮】，一切乃至記十字聖本在於卷初 cf. p. 852"}
{"id": null, "n": "0858010", "target": "#nkr_note_orig_0858010", "type": "orig", "text": "〔若夫…斯福〕百八十七字－【宮】"}
{"id": null, "n": "0858011", "target": "#nkr_note_orig_0858011", "type": "orig", "text": "梵＝胡【聖】"}
{"id": null, "n": "0858012", "target": "#nkr_note_orig_0858012", "type": "orig", "text": "客＝容【聖】"}
{"id": null, "n": "0858013", "target": "#nkr_note_orig_0858013", "type": "orig", "text": "大＝太【聖】"}
{"id": null, "n": "0855b1501", "target": "#nkr_note_add_0855b1501", "type": "add", "text": "己【CB】，已【大】"}
{"id": null, "n": "0858b2401", "target": "#nkr_note_add_0858b2401", "type": "add", "text": "異【CB】【麗-CB】，勇【大】"}
{"id": null, "n": "0852002", "target": "#nkr_note_rest_0852002", "type": "rest", "text": "卷末翻譯之記聖語藏在於卷初 cf. p. 356"}
{"id": null, "n": "0858009", "target": "#nkr_note_rest_0858009", "type": "rest", "text": "一切乃至記十字聖本在於卷初 cf. p. 852"}
