{"id": null, "n": null, "target": null, "type": null, "text": "此難俗有勝義即無"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂心顛倒於無謂有如見空花"}
{"id": null, "n": null, "target": null, "type": null, "text": "人稱為寶印手菩薩"}
{"id": null, "n": null, "target": null, "type": null, "text": "此云勝木舊云祇陀訛也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此云善施"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T09n0262_p0030a10"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T85n2733_p0022a10"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T85n2741_p0149c03"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T12n0374_p0442b09"}
{"id": null, "n": "0144001", "target": "#nkr_note_mod_0144001", "type": "mod", "text": "來【大】，〔－〕【考偽-大】"}
{"id": null, "n": "0144002", "target": "#nkr_note_mod_0144002", "type": "mod", "text": "如【大】，以【考偽-大】"}
{"id": null, "n": "0144003", "target": "#nkr_note_mod_0144003", "type": "mod", "text": "來【大】，是【考偽-大】"}
{"id": null, "n": "0144004", "target": "#nkr_note_mod_0144004", "type": "mod", "text": "多【大】，色【考偽-大】"}
{"id": null, "n": "0146001", "target": "#nkr_note_mod_0146001", "type": "mod", "text": "謂【大】，謂要悲愍一切有情四事業最勝謂【考偽-大】"}
{"id": null, "n": "0146002", "target": "#nkr_note_mod_0146002", "type": "mod", "text": "教【大】，散【考偽-大】"}
{"id": null, "n": "0146003", "target": "#nkr_note_mod_0146003", "type": "mod", "text": "流【大】，流通【考偽-大】"}
{"id": null, "n": "0146004", "target": "#nkr_note_mod_0146004", "type": "mod", "text": "教【大】，經【考偽-大】"}
{"id": null, "n": "0146005", "target": "#nkr_note_mod_0146005", "type": "mod", "text": "切【大】，一切【考偽-大】"}
{"id": null, "n": "0146006", "target": "#nkr_note_mod_0146006", "type": "mod", "text": "（惡性…住）三十九字【大】，〔－〕【考偽-大】"}
{"id": null, "n": "0147001", "target": "#nkr_note_mod_0147001", "type": "mod", "text": "度【大】，為能度【考偽-大】"}
{"id": null, "n": "0147002", "target": "#nkr_note_mod_0147002", "type": "mod", "text": "無【大】，為【考偽-大】"}
{"id": null, "n": "0147003", "target": "#nkr_note_mod_0147003", "type": "mod", "text": "一【大】，〔－〕【考偽-大】"}
{"id": null, "n": "0148001", "target": "#nkr_note_mod_0148001", "type": "mod", "text": "是【大】，〔－〕【考偽-大】"}
{"id": null, "n": "0148002", "target": "#nkr_note_mod_0148002", "type": "mod", "text": "示【大】，化【考偽-大】"}
{"id": null, "n": "0148003", "target": "#nkr_note_mod_0148003", "type": "mod", "text": "流【大】，深【考偽-大】"}
{"id": null, "n": "0148004", "target": "#nkr_note_mod_0148004", "type": "mod", "text": "唯可智【大】，准可知【考偽-大】"}
{"id": null, "n": "0148005", "target": "#nkr_note_mod_0148005", "type": "mod", "text": "世三【大】，三世【考偽-大】"}
{"id": null, "n": "0141002", "target": "#nkr_note_orig_0141002", "type": "orig", "text": "【原】佛蘭西國民圖書館藏燉煌本, P. 2330, 首題新加"}
{"id": null, "n": "0141003", "target": "#nkr_note_orig_0141003", "type": "orig", "text": "首闕"}
{"id": null, "n": "0144001", "target": "#nkr_note_orig_0144001", "type": "orig", "text": "〔來〕－？"}
{"id": null, "n": "0144002", "target": "#nkr_note_orig_0144002", "type": "orig", "text": "如＝以？"}
{"id": null, "n": "0144003", "target": "#nkr_note_orig_0144003", "type": "orig", "text": "來＝是？"}
{"id": null, "n": "0144004", "target": "#nkr_note_orig_0144004", "type": "orig", "text": "多＝色？"}
{"id": null, "n": "0146001", "target": "#nkr_note_orig_0146001", "type": "orig", "text": "謂＋（要悲愍一切有情四事業最勝謂）？"}
{"id": null, "n": "0146002", "target": "#nkr_note_orig_0146002", "type": "orig", "text": "教＝散？"}
{"id": null, "n": "0146003", "target": "#nkr_note_orig_0146003", "type": "orig", "text": "流＋（通）？"}
{"id": null, "n": "0146004", "target": "#nkr_note_orig_0146004", "type": "orig", "text": "教＝經？"}
{"id": null, "n": "0146005", "target": "#nkr_note_orig_0146005", "type": "orig", "text": "（一）＋切？"}
{"id": null, "n": "0146006", "target": "#nkr_note_orig_0146006", "type": "orig", "text": "〔惡性…住〕三十九字－？"}
{"id": null, "n": "0147001", "target": "#nkr_note_orig_0147001", "type": "orig", "text": "（為能）＋度？"}
{"id": null, "n": "0147002", "target": "#nkr_note_orig_0147002", "type": "orig", "text": "無＝為？"}
{"id": null, "n": "0147003", "target": "#nkr_note_orig_0147003", "type": "orig", "text": "〔一〕－？"}
{"id": null, "n": "0148001", "target": "#nkr_note_orig_0148001", "type": "orig", "text": "〔是〕－？"}
{"id": null, "n": "0148002", "target": "#nkr_note_orig_0148002", "type": "orig", "text": "示＝化？"}
{"id": null, "n": "0148003", "target": "#nkr_note_orig_0148003", "type": "orig", "text": "流＝深？"}
{"id": null, "n": "0148004", "target": "#nkr_note_orig_0148004", "type": "orig", "text": "唯可智＝准可知？"}
{"id": null, "n": "0148005", "target": "#nkr_note_orig_0148005", "type": "orig", "text": "世三＝三世？"}
{"id": null, "n": "0154001", "target": "#nkr_note_orig_0154001", "type": "orig", "text": "以下闕"}
{"id": null, "n": "0149b2301", "target": "#nkr_note_add_0149b2301", "type": "add", "text": "億【CB】，憶【大】"}
{"id": null, "n": "0149c0401", "target": "#nkr_note_add_0149c0401", "type": "add", "text": "常【CB】，當【大】"}
{"id": null, "n": "0149c1001", "target": "#nkr_note_add_0149c1001", "type": "add", "text": "恒【CB】，洹【大】"}
