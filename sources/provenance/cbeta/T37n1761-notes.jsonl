{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "萊茯讀為蘿蔔"}
{"id": null, "n": null, "target": null, "type": null, "text": "有云膝蓋大故"}
{"id": null, "n": null, "target": null, "type": null, "text": "音詩"}
{"id": null, "n": null, "target": null, "type": null, "text": "言其所證"}
{"id": null, "n": null, "target": null, "type": null, "text": "言其根性"}
{"id": null, "n": null, "target": null, "type": null, "text": "音秀"}
{"id": null, "n": null, "target": null, "type": null, "text": "音夙"}
{"id": null, "n": null, "target": null, "type": null, "text": "眾總三乘獨無緣覺，應以斷證同聲聞攝"}
{"id": null, "n": null, "target": null, "type": null, "text": "上是名下是姓"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T17n0839_p0908c28"}
{"id": null, "n": "0356004", "target": "#nkr_note_mod_0356004", "type": "mod", "text": "西【大】，宋西【甲】"}
{"id": null, "n": "0356005", "target": "#nkr_note_mod_0356005", "type": "mod", "text": "斆【大】，效【甲】"}
{"id": null, "n": "0357001", "target": "#nkr_note_mod_0357001", "type": "mod", "text": "如【大】，妙【甲】"}
{"id": null, "n": "0357002", "target": "#nkr_note_mod_0357002", "type": "mod", "text": "目【大】，自【甲】"}
{"id": null, "n": "0358001", "target": "#nkr_note_mod_0358001", "type": "mod", "text": "是【大】，〔－〕【甲】"}
{"id": null, "n": "0358002", "target": "#nkr_note_mod_0358002", "type": "mod", "text": "上是據姓【大】，上是名下是姓（夾註）【甲】"}
{"id": null, "n": "0359001", "target": "#nkr_note_mod_0359001", "type": "mod", "text": "（智論…法王子）二十二字【大】，〔－〕【甲】"}
{"id": null, "n": "0359002", "target": "#nkr_note_mod_0359002", "type": "mod", "text": "正【大】，正二舍利下別釋依正初中【甲】"}
{"id": null, "n": "0359003", "target": "#nkr_note_mod_0359003", "type": "mod", "text": "舍利下【大】，〔－〕【甲】"}
{"id": null, "n": "0359004", "target": "#nkr_note_mod_0359004", "type": "mod", "text": "退【大】，逕【甲】"}
{"id": null, "n": "0361001", "target": "#nkr_note_mod_0361001", "type": "mod", "text": "初【大】，初中初【甲】"}
{"id": null, "n": "0362001", "target": "#nkr_note_mod_0362001", "type": "mod", "text": "占【CB】【甲】，瞻【大】"}
{"id": null, "n": "0362002", "target": "#nkr_note_mod_0362002", "type": "mod", "text": "方【大】，方中【甲】"}
{"id": null, "n": "0356003", "target": "#nkr_note_orig_0356003", "type": "orig", "text": "【原】承應二年刊龍谷大學藏本，【甲】光緒二十四年刊大谷大學藏本"}
