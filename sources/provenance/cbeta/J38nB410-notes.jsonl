{"id": null, "n": null, "target": null, "type": null, "text": "用石屋禪師韻"}
{"id": null, "n": null, "target": null, "type": null, "text": "有羅漢洞"}
{"id": null, "n": null, "target": null, "type": null, "text": "有峽石"}
{"id": null, "n": null, "target": null, "type": null, "text": "有石\n窗"}
{"id": null, "n": null, "target": null, "type": null, "text": "有天台橋"}
{"id": null, "n": null, "target": null, "type": null, "text": "時有客過訪，旋即歸掉。"}
{"id": null, "n": null, "target": null, "type": null, "text": "樹神曾於宋朝試中狀元，名曰章榕"}
{"id": null, "n": null, "target": null, "type": null, "text": "即臘梅"}
{"id": null, "n": null, "target": null, "type": null, "text": "次黃十華居士韻"}
{"id": null, "n": null, "target": null, "type": null, "text": "康熙三十一年三月，板送嘉興\n　　　　楞嚴寺般若堂大藏流通。"}
