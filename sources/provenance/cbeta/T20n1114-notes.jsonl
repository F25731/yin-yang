{"id": null, "n": "0501002", "target": "#nkr_note_mod_0501002", "type": "mod", "text": "西天譯經【大】，宋西天【明】"}
{"id": null, "n": "0501003", "target": "#nkr_note_mod_0501003", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0501004", "target": "#nkr_note_mod_0501004", "type": "mod", "text": "仙【大】＊，僊【明】＊"}
{"id": null, "n": "0501005", "target": "#nkr_note_mod_0501005", "type": "mod", "text": "引【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0501006", "target": "#nkr_note_mod_0501006", "type": "mod", "text": "上【大】＊，上聲【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0501007", "target": "#nkr_note_mod_0501007", "type": "mod", "text": "引仁臧切【大】，仁臧切引【明】"}
{"id": null, "n": "0501008", "target": "#nkr_note_mod_0501008", "type": "mod", "text": "三【大】，二【明】"}
{"id": null, "n": "0501009", "target": "#nkr_note_mod_0501009", "type": "mod", "text": "三【大】，二【宋】【元】【明】"}
{"id": null, "n": "0501010", "target": "#nkr_note_mod_0501010", "type": "mod", "text": "訖【大】，記【明】"}
{"id": null, "n": "0501011", "target": "#nkr_note_mod_0501011", "type": "mod", "text": "𪾼【大】，曀【宋】【元】【明】"}
{"id": null, "n": "0502001", "target": "#nkr_note_mod_0502001", "type": "mod", "text": "涱【大】，長【宋】【元】，漲【明】"}
{"id": null, "n": "0502002", "target": "#nkr_note_mod_0502002", "type": "mod", "text": "界【大】，界佛說此經已一切世間天人阿修羅等聞佛所說皆大歡喜信受奉行【宋】【元】【明】"}
{"id": null, "n": "0501001", "target": "#nkr_note_orig_0501001", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0501002", "target": "#nkr_note_orig_0501002", "type": "orig", "text": "西天譯經＝宋西天【明】"}
{"id": null, "n": "0501003", "target": "#nkr_note_orig_0501003", "type": "orig", "text": "〔臣〕－【明】"}
{"id": null, "n": "0501004", "target": "#nkr_note_orig_0501004", "type": "orig", "text": "仙＝僊【明】＊"}
{"id": null, "n": "0501005", "target": "#nkr_note_orig_0501005", "type": "orig", "text": "〔引〕－【三】"}
{"id": null, "n": "0501006", "target": "#nkr_note_orig_0501006", "type": "orig", "text": "上＋（聲）【三】＊"}
{"id": null, "n": "0501007", "target": "#nkr_note_orig_0501007", "type": "orig", "text": "引仁臧切＝仁臧切引【明】"}
{"id": null, "n": "0501008", "target": "#nkr_note_orig_0501008", "type": "orig", "text": "三＝二【明】"}
{"id": null, "n": "0501009", "target": "#nkr_note_orig_0501009", "type": "orig", "text": "三＝二【三】"}
{"id": null, "n": "0501010", "target": "#nkr_note_orig_0501010", "type": "orig", "text": "訖＝記【明】"}
{"id": null, "n": "0501011", "target": "#nkr_note_orig_0501011", "type": "orig", "text": "𪾼＝曀【三】"}
{"id": null, "n": "0502001", "target": "#nkr_note_orig_0502001", "type": "orig", "text": "涱＝長【宋】【元】，漲【明】"}
{"id": null, "n": "0502002", "target": "#nkr_note_orig_0502002", "type": "orig", "text": "界＋（佛說此經已一切世間天人阿修羅等聞佛所說皆大歡喜信受奉行）二十七字【三】"}
