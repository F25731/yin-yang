{"id": null, "n": "0423062", "target": "#nkr_note_mod_0423062", "type": "mod", "text": "世【大】＊，在【甲】＊"}
{"id": null, "n": "0423063", "target": "#nkr_note_mod_0423063", "type": "mod", "text": "白言【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0423064", "target": "#nkr_note_mod_0423064", "type": "mod", "text": "而為【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0423065", "target": "#nkr_note_mod_0423065", "type": "mod", "text": "於【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0424002", "target": "#nkr_note_mod_0424002", "type": "mod", "text": "跢【大】，跢曩【甲】【乙】"}
{"id": null, "n": "0424003", "target": "#nkr_note_mod_0424003", "type": "mod", "text": "伴【大】，半【甲】"}
{"id": null, "n": "0424004", "target": "#nkr_note_mod_0424004", "type": "mod", "text": "明【大】，相【甲】【乙】"}
{"id": null, "n": "0424005", "target": "#nkr_note_mod_0424005", "type": "mod", "text": "七【大】，八【甲】"}
{"id": null, "n": "0424006", "target": "#nkr_note_mod_0424006", "type": "mod", "text": "品【大】，品勿妄宣傳為極祕密【甲】，品口云曼殊八葉【乙】"}
{"id": null, "n": "0424007", "target": "#nkr_note_mod_0424007", "type": "mod", "text": "等言【大】，星等【甲】"}
{"id": null, "n": "0424008", "target": "#nkr_note_mod_0424008", "type": "mod", "text": "是【大】，此【甲】"}
{"id": null, "n": "0424009", "target": "#nkr_note_mod_0424009", "type": "mod", "text": "呪【大】，呪者【甲】"}
{"id": null, "n": "0424010", "target": "#nkr_note_mod_0424010", "type": "mod", "text": "女【大】，星【甲】"}
{"id": null, "n": "0424011", "target": "#nkr_note_mod_0424011", "type": "mod", "text": "呪【大】，呪汝等【校異-原】，呪三七遍【甲】"}
{"id": null, "n": "0424012", "target": "#nkr_note_mod_0424012", "type": "mod", "text": "業【大】，業障【甲】【乙】"}
{"id": null, "n": "0424013", "target": "#nkr_note_mod_0424013", "type": "mod", "text": "設【大】，若【甲】"}
{"id": null, "n": "0424014", "target": "#nkr_note_mod_0424014", "type": "mod", "text": "百八【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0424015", "target": "#nkr_note_mod_0424015", "type": "mod", "text": "遍【大】，切【乙】"}
{"id": null, "n": "0424016", "target": "#nkr_note_mod_0424016", "type": "mod", "text": "力【大】，力手【校異-原】"}
{"id": null, "n": "0424017", "target": "#nkr_note_mod_0424017", "type": "mod", "text": "諸【大】，法【甲】"}
{"id": null, "n": "0424018", "target": "#nkr_note_mod_0424018", "type": "mod", "text": "眾【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0424019", "target": "#nkr_note_mod_0424019", "type": "mod", "text": "鬼【大】，鬼神【甲】"}
{"id": null, "n": "0424020", "target": "#nkr_note_mod_0424020", "type": "mod", "text": "若【大】，若有【甲】【乙】"}
{"id": null, "n": "0424021", "target": "#nkr_note_mod_0424021", "type": "mod", "text": "寂靜【大】，〔－〕【乙】，靜【甲】"}
{"id": null, "n": "0424022", "target": "#nkr_note_mod_0424022", "type": "mod", "text": "養【大】，〔－〕【乙】"}
{"id": null, "n": "0424023", "target": "#nkr_note_mod_0424023", "type": "mod", "text": "八【大】，北斗八【甲】"}
{"id": null, "n": "0424024", "target": "#nkr_note_mod_0424024", "type": "mod", "text": "惹位【大】，羅惹即王位【校異-原】，若求惹位【甲】，若惹位【乙】"}
{"id": null, "n": "0424025", "target": "#nkr_note_mod_0424025", "type": "mod", "text": "少【大】，小【乙】"}
{"id": null, "n": "0424026", "target": "#nkr_note_mod_0424026", "type": "mod", "text": "命【大】，命者【甲】"}
{"id": null, "n": "0424027", "target": "#nkr_note_mod_0424027", "type": "mod", "text": "宮【大】，官【甲】"}
{"id": null, "n": "0424028", "target": "#nkr_note_mod_0424028", "type": "mod", "text": "羅【大】，利【甲】"}
{"id": null, "n": "0424029", "target": "#nkr_note_mod_0424029", "type": "mod", "text": "故【大】，〔－〕【甲】"}
{"id": null, "n": "0424030", "target": "#nkr_note_mod_0424030", "type": "mod", "text": "人【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0424031", "target": "#nkr_note_mod_0424031", "type": "mod", "text": "眼【大】，〔－〕【甲】"}
{"id": null, "n": "0424032", "target": "#nkr_note_mod_0424032", "type": "mod", "text": "提【大】，提北斗七星念誦法略半【甲】"}
{"id": null, "n": "0423061", "target": "#nkr_note_orig_0423061", "type": "orig", "text": "【原】享保年間刊豐山大學藏本，【甲】久安五年寫東寺三密藏本，【乙】天永四年寫高野山寶壽院藏本"}
{"id": null, "n": "0423062", "target": "#nkr_note_orig_0423062", "type": "orig", "text": "世＝在【甲】＊"}
{"id": null, "n": "0423063", "target": "#nkr_note_orig_0423063", "type": "orig", "text": "〔白言〕－【甲】【乙】"}
{"id": null, "n": "0423064", "target": "#nkr_note_orig_0423064", "type": "orig", "text": "〔而為〕－【甲】【乙】"}
{"id": null, "n": "0423065", "target": "#nkr_note_orig_0423065", "type": "orig", "text": "〔於〕－【甲】【乙】"}
{"id": null, "n": "0424001", "target": "#nkr_note_orig_0424001", "type": "orig", "text": "甲乙二本梵字闕"}
{"id": null, "n": "0424002", "target": "#nkr_note_orig_0424002", "type": "orig", "text": "跢＋（曩）【甲】【乙】"}
{"id": null, "n": "0424003", "target": "#nkr_note_orig_0424003", "type": "orig", "text": "伴＝半【甲】"}
{"id": null, "n": "0424004", "target": "#nkr_note_orig_0424004", "type": "orig", "text": "明＝相【甲】【乙】"}
{"id": null, "n": "0424005", "target": "#nkr_note_orig_0424005", "type": "orig", "text": "七＝八【甲】"}
{"id": null, "n": "0424006", "target": "#nkr_note_orig_0424006", "type": "orig", "text": "品＋（勿妄宣傳為極祕密）【甲】，（口云曼殊八葉）【乙】"}
{"id": null, "n": "0424007", "target": "#nkr_note_orig_0424007", "type": "orig", "text": "等言＝星等【甲】"}
{"id": null, "n": "0424008", "target": "#nkr_note_orig_0424008", "type": "orig", "text": "是＝此【甲】"}
{"id": null, "n": "0424009", "target": "#nkr_note_orig_0424009", "type": "orig", "text": "呪＋（者）【甲】"}
{"id": null, "n": "0424010", "target": "#nkr_note_orig_0424010", "type": "orig", "text": "女＝星【甲】"}
{"id": null, "n": "0424011", "target": "#nkr_note_orig_0424011", "type": "orig", "text": "呪＋（汝等）ィ【原】，（三七遍）【甲】"}
{"id": null, "n": "0424012", "target": "#nkr_note_orig_0424012", "type": "orig", "text": "業＋（障）【甲】【乙】"}
{"id": null, "n": "0424013", "target": "#nkr_note_orig_0424013", "type": "orig", "text": "設＝若【甲】"}
{"id": null, "n": "0424014", "target": "#nkr_note_orig_0424014", "type": "orig", "text": "〔百八〕－【甲】【乙】"}
{"id": null, "n": "0424015", "target": "#nkr_note_orig_0424015", "type": "orig", "text": "遍＝切【乙】"}
{"id": null, "n": "0424016", "target": "#nkr_note_orig_0424016", "type": "orig", "text": "力＋（手）ィ【原】"}
{"id": null, "n": "0424017", "target": "#nkr_note_orig_0424017", "type": "orig", "text": "諸＝法【甲】"}
{"id": null, "n": "0424018", "target": "#nkr_note_orig_0424018", "type": "orig", "text": "〔眾〕－【甲】【乙】"}
{"id": null, "n": "0424019", "target": "#nkr_note_orig_0424019", "type": "orig", "text": "鬼＋（神）【甲】"}
{"id": null, "n": "0424020", "target": "#nkr_note_orig_0424020", "type": "orig", "text": "若＋（有）【甲】【乙】"}
{"id": null, "n": "0424021", "target": "#nkr_note_orig_0424021", "type": "orig", "text": "〔寂〕－【甲】，〔寂靜〕－【乙】"}
{"id": null, "n": "0424022", "target": "#nkr_note_orig_0424022", "type": "orig", "text": "〔養〕－【乙】"}
{"id": null, "n": "0424023", "target": "#nkr_note_orig_0424023", "type": "orig", "text": "（北斗）＋八【甲】"}
{"id": null, "n": "0424024", "target": "#nkr_note_orig_0424024", "type": "orig", "text": "惹位＝羅惹即王位ィ【原】，若求惹位【甲】，若惹位【乙】"}
{"id": null, "n": "0424025", "target": "#nkr_note_orig_0424025", "type": "orig", "text": "少＝小【乙】"}
{"id": null, "n": "0424026", "target": "#nkr_note_orig_0424026", "type": "orig", "text": "命＋（者）【甲】"}
{"id": null, "n": "0424027", "target": "#nkr_note_orig_0424027", "type": "orig", "text": "宮＝官【甲】"}
{"id": null, "n": "0424028", "target": "#nkr_note_orig_0424028", "type": "orig", "text": "羅＝利【甲】"}
{"id": null, "n": "0424029", "target": "#nkr_note_orig_0424029", "type": "orig", "text": "〔故〕－【甲】"}
{"id": null, "n": "0424030", "target": "#nkr_note_orig_0424030", "type": "orig", "text": "〔人〕－【甲】【乙】"}
{"id": null, "n": "0424031", "target": "#nkr_note_orig_0424031", "type": "orig", "text": "〔眼〕－【甲】"}
{"id": null, "n": "0424032", "target": "#nkr_note_orig_0424032", "type": "orig", "text": "提＋（北斗七星念誦法略半）【甲】"}
{"id": null, "n": "0424033", "target": "#nkr_note_orig_0424033", "type": "orig", "text": "此下甲本奧書云一校了久安五年七月一日書了賢覺，乙本奧書云以高野後僧正御持本展轉書了天永四年二月一日於性德院書之僧念範之本（朱）同日入寺御房奉受了"}
