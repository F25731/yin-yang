{"id": null, "n": "0708002", "target": "#nkr_note_orig_0708002", "type": "orig", "text": "歘＝欻【甲】＊"}
{"id": null, "n": "0708003", "target": "#nkr_note_orig_0708003", "type": "orig", "text": "鑒＝鑑【甲】"}
