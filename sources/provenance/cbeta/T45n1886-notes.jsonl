{"id": null, "n": "0709009", "target": "#nkr_note_orig_0709009", "type": "orig", "text": "指＝措【甲】"}
{"id": null, "n": "0709010", "target": "#nkr_note_orig_0709010", "type": "orig", "text": "寐＝寤【甲】"}
{"id": null, "n": "0709011", "target": "#nkr_note_orig_0709011", "type": "orig", "text": "差別＝別差【甲】"}
{"id": null, "n": "0709012", "target": "#nkr_note_orig_0709012", "type": "orig", "text": "徧＝偏【甲】"}
{"id": null, "n": "0709013", "target": "#nkr_note_orig_0709013", "type": "orig", "text": "〔之〕－【甲】"}
{"id": null, "n": "0710001", "target": "#nkr_note_orig_0710001", "type": "orig", "text": "境＝鏡【甲】"}
{"id": null, "n": "0710002", "target": "#nkr_note_orig_0710002", "type": "orig", "text": "依＝因【甲】"}
{"id": null, "n": "0710003", "target": "#nkr_note_orig_0710003", "type": "orig", "text": "以＝已【甲】"}
{"id": null, "n": "0710004", "target": "#nkr_note_orig_0710004", "type": "orig", "text": "相＝想【甲】"}
{"id": null, "n": "0710005", "target": "#nkr_note_orig_0710005", "type": "orig", "text": "返＝反【甲】"}
{"id": null, "n": "0710006", "target": "#nkr_note_orig_0710006", "type": "orig", "text": "說＝談【甲】"}
{"id": null, "n": "0710007", "target": "#nkr_note_orig_0710007", "type": "orig", "text": "令＝本【甲】"}
{"id": null, "n": "0710008", "target": "#nkr_note_orig_0710008", "type": "orig", "text": "知＝之【甲】"}
{"id": null, "n": "0710009", "target": "#nkr_note_orig_0710009", "type": "orig", "text": "所＝此【甲】"}
{"id": null, "n": "0710010", "target": "#nkr_note_orig_0710010", "type": "orig", "text": "此＋（之）【甲】"}
