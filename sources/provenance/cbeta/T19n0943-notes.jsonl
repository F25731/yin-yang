{"id": null, "n": "0098002", "target": "#nkr_note_mod_0098002", "type": "mod", "text": "西【大】，宋西【明】"}
{"id": null, "n": "0098003", "target": "#nkr_note_mod_0098003", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0098004", "target": "#nkr_note_mod_0098004", "type": "mod", "text": "合【大】＊，合反【宋】【元】＊"}
{"id": null, "n": "0098005", "target": "#nkr_note_mod_0098005", "type": "mod", "text": "反【大】＊，切【明】＊"}
{"id": null, "n": "0098006", "target": "#nkr_note_mod_0098006", "type": "mod", "text": "摩【大】，麼【宋】【元】【明】"}
{"id": null, "n": "0099001", "target": "#nkr_note_mod_0099001", "type": "mod", "text": "二合【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0099002", "target": "#nkr_note_mod_0099002", "type": "mod", "text": "攃【大】，捺【宋】【元】【明】"}
{"id": null, "n": "0099003", "target": "#nkr_note_mod_0099003", "type": "mod", "text": "引【大】，入【宋】【元】【明】"}
{"id": null, "n": "0099004", "target": "#nkr_note_mod_0099004", "type": "mod", "text": "幡【大】，幡王如來【明】"}
