{"id": null, "n": null, "target": null, "type": null, "text": "上聲"}
{"id": null, "n": "0504019", "target": "#nkr_note_mod_0504019", "type": "mod", "text": "波【大】＊，婆【元】【明】＊"}
{"id": null, "n": "0504020", "target": "#nkr_note_mod_0504020", "type": "mod", "text": "炬【大】＊，矩【元】【明】＊"}
{"id": null, "n": "0504021", "target": "#nkr_note_mod_0504021", "type": "mod", "text": "於【大】，於此【元】【明】"}
{"id": null, "n": "0504022", "target": "#nkr_note_mod_0504022", "type": "mod", "text": "沙【大】，莎【宋】【元】【明】"}
{"id": null, "n": "0504023", "target": "#nkr_note_mod_0504023", "type": "mod", "text": "梨【大】，利【元】【明】"}
{"id": null, "n": "0504024", "target": "#nkr_note_mod_0504024", "type": "mod", "text": "實【大】，真實【宋】【元】【明】"}
{"id": null, "n": "0505001", "target": "#nkr_note_mod_0505001", "type": "mod", "text": "嚕【大】，魯【宋】【元】【明】"}
{"id": null, "n": "0505002", "target": "#nkr_note_mod_0505002", "type": "mod", "text": "其【大】，具【明】"}
{"id": null, "n": "0505003", "target": "#nkr_note_mod_0505003", "type": "mod", "text": "雷【大】，電【元】【明】"}
{"id": null, "n": "0505004", "target": "#nkr_note_mod_0505004", "type": "mod", "text": "莎波【大】，娑婆【宋】【元】，莎婆【明】"}
{"id": null, "n": "0505005", "target": "#nkr_note_mod_0505005", "type": "mod", "text": "羅【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0506001", "target": "#nkr_note_mod_0506001", "type": "mod", "text": "梨【大】，利【宋】【元】【明】"}
{"id": null, "n": "0506002", "target": "#nkr_note_mod_0506002", "type": "mod", "text": "旃【大】，栴【宋】"}
{"id": null, "n": "0506003", "target": "#nkr_note_mod_0506003", "type": "mod", "text": "數【大】，𣯫【宋】【元】【明】"}
