{"id": null, "n": "0500017", "target": "#nkr_note_mod_0500017", "type": "mod", "text": "大【大】，佛說大【明】，【原】麗本"}
{"id": null, "n": "0500018", "target": "#nkr_note_mod_0500018", "type": "mod", "text": "（經請…四）八字【大】＊，請雨經【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0500019", "target": "#nkr_note_mod_0500019", "type": "mod", "text": "（周…譯）十三字【大】，隋天竺三藏法師闍那崛多等譯【宋】【元】【明】"}
{"id": null, "n": "0500020", "target": "#nkr_note_mod_0500020", "type": "mod", "text": "峯仗【大】，峯伏【宋】，鋒仗【元】【明】"}
{"id": null, "n": "0500021", "target": "#nkr_note_mod_0500021", "type": "mod", "text": "頂【大】，項【元】【明】"}
{"id": null, "n": "0501001", "target": "#nkr_note_mod_0501001", "type": "mod", "text": "琉【大】，瑠【宋】【元】【明】"}
{"id": null, "n": "0501002", "target": "#nkr_note_mod_0501002", "type": "mod", "text": "火【大】，大【宋】【元】【明】"}
{"id": null, "n": "0501003", "target": "#nkr_note_mod_0501003", "type": "mod", "text": "德【大】，瞋【元】【明】"}
{"id": null, "n": "0501004", "target": "#nkr_note_mod_0501004", "type": "mod", "text": "生【大】，蓋【元】【明】"}
{"id": null, "n": "0501005", "target": "#nkr_note_mod_0501005", "type": "mod", "text": "礫【大】，磤【元】【明】"}
{"id": null, "n": "0501006", "target": "#nkr_note_mod_0501006", "type": "mod", "text": "擊【大】，繫【宋】"}
{"id": null, "n": "0501007", "target": "#nkr_note_mod_0501007", "type": "mod", "text": "過【大】，遍【宋】【元】【明】"}
{"id": null, "n": "0502001", "target": "#nkr_note_mod_0502001", "type": "mod", "text": "識【大】，議【宋】【元】"}
{"id": null, "n": "0502002", "target": "#nkr_note_mod_0502002", "type": "mod", "text": "欄【大】，蘭【宋】"}
{"id": null, "n": "0502003", "target": "#nkr_note_mod_0502003", "type": "mod", "text": "珞【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0502004", "target": "#nkr_note_mod_0502004", "type": "mod", "text": "瓔珞【大】＊，纓絡【宋】＊"}
{"id": null, "n": "0502005", "target": "#nkr_note_mod_0502005", "type": "mod", "text": "琉【大】，瑠【明】"}
{"id": null, "n": "0502006", "target": "#nkr_note_mod_0502006", "type": "mod", "text": "大【大】，天【明】"}
{"id": null, "n": "0503001", "target": "#nkr_note_mod_0503001", "type": "mod", "text": "刃【大】，刀【宋】【元】【明】"}
{"id": null, "n": "0503002", "target": "#nkr_note_mod_0503002", "type": "mod", "text": "悟【大】，寤【元】【明】"}
{"id": null, "n": "0503004", "target": "#nkr_note_mod_0503004", "type": "mod", "text": "也【大】，也反【元】，也切【明】"}
{"id": null, "n": "0503005", "target": "#nkr_note_mod_0503005", "type": "mod", "text": "反【大】＊，切【明】＊"}
{"id": null, "n": "0503006", "target": "#nkr_note_mod_0503006", "type": "mod", "text": "羅【大】，薩【宋】【元】【明】"}
{"id": null, "n": "0503007", "target": "#nkr_note_mod_0503007", "type": "mod", "text": "𡄵【大】，𭌣【宋】【元】【明】"}
{"id": null, "n": "0503008", "target": "#nkr_note_mod_0503008", "type": "mod", "text": "顯【大】，頭【宋】，頤【元】【明】"}
{"id": null, "n": "0503009", "target": "#nkr_note_mod_0503009", "type": "mod", "text": "持【大】，特【宋】"}
{"id": null, "n": "0503010", "target": "#nkr_note_mod_0503010", "type": "mod", "text": "當【大】，常【宋】【元】【明】"}
{"id": null, "n": "0503011", "target": "#nkr_note_mod_0503011", "type": "mod", "text": "性【大】，姓【元】【明】"}
{"id": null, "n": "0503012", "target": "#nkr_note_mod_0503012", "type": "mod", "text": "乘【大】，垂【宋】【元】【明】"}
{"id": null, "n": "0503013", "target": "#nkr_note_mod_0503013", "type": "mod", "text": "踊【大】，涌【元】【明】"}
{"id": null, "n": "0503014", "target": "#nkr_note_mod_0503014", "type": "mod", "text": "惟【大】＊，唯【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0503015", "target": "#nkr_note_mod_0503015", "type": "mod", "text": "厲【大】，癘【宋】【元】【明】"}
{"id": null, "n": "0503016", "target": "#nkr_note_mod_0503016", "type": "mod", "text": "能【大】，復能【宋】【元】【明】"}
{"id": null, "n": "0504001", "target": "#nkr_note_mod_0504001", "type": "mod", "text": "健【大】，律【宋】【元】【明】"}
{"id": null, "n": "0504002", "target": "#nkr_note_mod_0504002", "type": "mod", "text": "姪【大】＊，絰【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0504003", "target": "#nkr_note_mod_0504003", "type": "mod", "text": "泥【大】，埿【宋】【元】【明】"}
{"id": null, "n": "0504004", "target": "#nkr_note_mod_0504004", "type": "mod", "text": "塞【大】＊，寒【宋】【元】＊"}
{"id": null, "n": "0504005", "target": "#nkr_note_mod_0504005", "type": "mod", "text": "兮【大】＊，子【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0504006", "target": "#nkr_note_mod_0504006", "type": "mod", "text": "藪【大】，素上【宋】【元】，素上聲【明】"}
{"id": null, "n": "0504007", "target": "#nkr_note_mod_0504007", "type": "mod", "text": "利【大】，賖婆利【宋】【元】【明】"}
{"id": null, "n": "0504008", "target": "#nkr_note_mod_0504008", "type": "mod", "text": "唎【大】＊，梨【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0504009", "target": "#nkr_note_mod_0504009", "type": "mod", "text": "唎【大】，利【宋】【元】【明】"}
{"id": null, "n": "0504010", "target": "#nkr_note_mod_0504010", "type": "mod", "text": "杜【大】＊，社【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0504011", "target": "#nkr_note_mod_0504011", "type": "mod", "text": "闍【大】，閉【宋】【元】【明】"}
{"id": null, "n": "0504012", "target": "#nkr_note_mod_0504012", "type": "mod", "text": "邏【大】，羅【宋】【元】【明】"}
{"id": null, "n": "0504013", "target": "#nkr_note_mod_0504013", "type": "mod", "text": "奴【大】，呶【宋】【元】【明】"}
{"id": null, "n": "0504014", "target": "#nkr_note_mod_0504014", "type": "mod", "text": "去【大】，上聲【明】"}
{"id": null, "n": "0504015", "target": "#nkr_note_mod_0504015", "type": "mod", "text": "菩弭反【大】，善弭【宋】【元】【明】"}
{"id": null, "n": "0504016", "target": "#nkr_note_mod_0504016", "type": "mod", "text": "梨【大】，𠼝【明】"}
{"id": null, "n": "0504017", "target": "#nkr_note_mod_0504017", "type": "mod", "text": "丹本意【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0504018", "target": "#nkr_note_mod_0504018", "type": "mod", "text": "瞿【大】，瞿上【宋】【元】，瞿上聲【明】"}
