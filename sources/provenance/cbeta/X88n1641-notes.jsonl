{"id": null, "n": null, "target": null, "type": null, "text": "江西養智禪人\n說"}
{"id": null, "n": null, "target": null, "type": null, "text": "舟中嘉興人說"}
{"id": null, "n": null, "target": null, "type": null, "text": "吳江鑒空師說"}
{"id": null, "n": null, "target": null, "type": null, "text": "王元建居士親知其事"}
{"id": null, "n": null, "target": null, "type": null, "text": "洪江亦予在家時善友"}
{"id": null, "n": null, "target": null, "type": null, "text": "九華空如老人說"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上四事並程智用親見故說"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上二事釋成泰說"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上六事俱釋隆仁說"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": "0026001", "target": "#nkr_note_orig_0026001", "type": "orig", "text": "㹀疑牸"}
