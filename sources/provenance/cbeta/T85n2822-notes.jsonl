{"id": null, "n": null, "target": null, "type": null, "text": "喻真妄"}
{"id": null, "n": null, "target": null, "type": null, "text": "見心\n生"}
{"id": null, "n": null, "target": null, "type": null, "text": "獸中王"}
{"id": null, "n": null, "target": null, "type": null, "text": "識微細種子喻菩薩能斷第八識斷集"}
{"id": null, "n": null, "target": null, "type": null, "text": "滅前六識不見第七八識"}
{"id": null, "n": null, "target": null, "type": null, "text": "靜慮"}
{"id": null, "n": null, "target": null, "type": null, "text": "莬毛"}
{"id": null, "n": null, "target": null, "type": null, "text": "仁王云。波羅蜜非似虛空常住"}
{"id": null, "n": null, "target": null, "type": null, "text": "似莬角柏不諦不是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "如□"}
{"id": null, "n": null, "target": null, "type": null, "text": "初心人心雖覺却"}
{"id": null, "n": null, "target": null, "type": null, "text": "心起利心復起不礙放喻起覺"}
{"id": null, "n": null, "target": null, "type": null, "text": "喻第六意識兼前五識。喻中六賊禪師。喻恚人滅第六意識不行前五識"}
{"id": null, "n": null, "target": null, "type": null, "text": "喻五蘊五根名平王"}
{"id": null, "n": null, "target": null, "type": null, "text": "眼等貪者著名之為欲。即此欲者便是漏"}
{"id": null, "n": null, "target": null, "type": null, "text": "畜等者不了法人色聲觸著便礙。了人色聲芽是等"}
{"id": null, "n": null, "target": null, "type": null, "text": "難陀世尊訶喻阿"}
{"id": null, "n": null, "target": null, "type": null, "text": "第六心"}
{"id": null, "n": null, "target": null, "type": null, "text": "保"}
{"id": null, "n": null, "target": null, "type": null, "text": "喻心"}
{"id": null, "n": null, "target": null, "type": null, "text": "心若不起各別故不一。體同故不異"}
{"id": null, "n": null, "target": null, "type": null, "text": "喻無情"}
{"id": null, "n": null, "target": null, "type": null, "text": "喻有情"}
{"id": null, "n": null, "target": null, "type": null, "text": "相"}
{"id": null, "n": null, "target": null, "type": null, "text": "相違者有起時覺不立。不相\n違者即覺去即不立二相。五法名相分別正智如"}
{"id": null, "n": null, "target": null, "type": null, "text": "此是聞"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿難陀心是覺"}
{"id": null, "n": null, "target": null, "type": null, "text": "不是無始煩惱"}
{"id": null, "n": null, "target": null, "type": null, "text": "不知夜見㗛鬼蛇形無鬼地"}
{"id": null, "n": null, "target": null, "type": null, "text": "不悟不依心所得"}
{"id": null, "n": null, "target": null, "type": null, "text": "悟離依心得"}
{"id": null, "n": null, "target": null, "type": null, "text": "不悟分別悟不分別。住無為心"}
{"id": null, "n": null, "target": null, "type": null, "text": "喻眾生"}
{"id": null, "n": null, "target": null, "type": null, "text": "戒定惠"}
{"id": null, "n": null, "target": null, "type": null, "text": "一覺者豈則是覺"}
{"id": null, "n": null, "target": null, "type": null, "text": "本覺者不生不滅。悟理由同也"}
{"id": null, "n": null, "target": null, "type": null, "text": "去處則覺者即是本所用。自身中得金錢也"}
{"id": null, "n": null, "target": null, "type": null, "text": "非是他人得"}
{"id": null, "n": null, "target": null, "type": null, "text": "空者是覺。大覺者是佛"}
{"id": null, "n": null, "target": null, "type": null, "text": "大覺從空中約大海浮藻發眼耳等六種"}
{"id": null, "n": null, "target": null, "type": null, "text": "微塵者色聲六種"}
{"id": null, "n": null, "target": null, "type": null, "text": "皆從空等者並從妄念中生"}
{"id": null, "n": null, "target": null, "type": null, "text": "諸三有者地微等有時即無"}
{"id": null, "n": null, "target": null, "type": null, "text": "法正生時令滅無見"}
{"id": null, "n": null, "target": null, "type": null, "text": "若法滅時令滅有見。無見自生然不生"}
{"id": null, "n": null, "target": null, "type": null, "text": "心者去也。性者清淨性。緣者六塵境界。真淨者不生滅理也"}
{"id": null, "n": null, "target": null, "type": null, "text": "性者悟法之人不可滅心數法"}
{"id": null, "n": null, "target": null, "type": null, "text": "真金者心心等"}
{"id": null, "n": null, "target": null, "type": null, "text": "習者煩惱。心者性也。即氣不離心。心共習等亦\n不是一習氣縛纏"}
{"id": null, "n": null, "target": null, "type": null, "text": "眾生心者清淨性"}
{"id": null, "n": null, "target": null, "type": null, "text": "結者解也。即繩礙中解"}
{"id": null, "n": null, "target": null, "type": null, "text": "不悟者聖凡路別。悟者即凡\n聖是一。修門人有時不有未犯五蘊有地虛"}
{"id": null, "n": null, "target": null, "type": null, "text": "主方便蘇去說覺。覺不堅忍堅。悟覺任倒"}
{"id": null, "n": null, "target": null, "type": null, "text": "猶如椽木父國林緣必竟滅"}
{"id": null, "n": null, "target": null, "type": null, "text": "異"}
{"id": null, "n": null, "target": null, "type": null, "text": "相成"}
{"id": null, "n": null, "target": null, "type": null, "text": "譬如虛空中"}
{"id": null, "n": null, "target": null, "type": null, "text": "見生死喧雜。涅槃寂靜。見\n生死不喧雜。涅槃不靜"}
{"id": null, "n": null, "target": null, "type": null, "text": "所"}
{"id": null, "n": null, "target": null, "type": null, "text": "亡"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T85n2822_p1206c13"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X05n0229_p0229a17"}
{"id": null, "n": "1205002", "target": "#nkr_note_orig_1205002", "type": "orig", "text": "【原】大英博物館藏燉煌本, S. 985"}
{"id": null, "n": "1206b1901", "target": "#nkr_note_add_1206b1901", "type": "add", "text": "縛【CB】，縳【大】"}
{"id": null, "n": "1206c0501", "target": "#nkr_note_add_1206c0501", "type": "add", "text": "清【CB】，青【大】"}
{"id": null, "n": "1206c0502", "target": "#nkr_note_add_1206c0502", "type": "add", "text": "水【CB】，氷【大】"}
