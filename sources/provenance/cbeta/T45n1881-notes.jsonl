{"id": null, "n": "0669054", "target": "#nkr_note_mod_0669054", "type": "mod", "text": "小【大】，一【甲】"}
{"id": null, "n": "0669055", "target": "#nkr_note_mod_0669055", "type": "mod", "text": "大法【大】，多法小法中有大法【甲】"}
{"id": null, "n": "0669056", "target": "#nkr_note_mod_0669056", "type": "mod", "text": "頓現【大】，顯現也【甲】"}
{"id": null, "n": "0669057", "target": "#nkr_note_mod_0669057", "type": "mod", "text": "多【大】，一橫多多【甲】"}
{"id": null, "n": "0669058", "target": "#nkr_note_mod_0669058", "type": "mod", "text": "礙【大】，閡也【甲】"}
{"id": null, "n": "0669059", "target": "#nkr_note_mod_0669059", "type": "mod", "text": "之天珠故【大】，天珠【甲】"}
{"id": null, "n": "0669060", "target": "#nkr_note_mod_0669060", "type": "mod", "text": "門【大】，門清涼云若兩鏡互照交耀相寫迭出無盡【甲】"}
{"id": null, "n": "0669061", "target": "#nkr_note_mod_0669061", "type": "mod", "text": "若【大】，即此師子【甲】"}
{"id": null, "n": "0669062", "target": "#nkr_note_mod_0669062", "type": "mod", "text": "相【大】，〔－〕【甲】"}
{"id": null, "n": "0669063", "target": "#nkr_note_mod_0669063", "type": "mod", "text": "純【大】，雜亦【甲】"}
{"id": null, "n": "0669064", "target": "#nkr_note_mod_0669064", "type": "mod", "text": "雜【大】，純【甲】"}
{"id": null, "n": "0669065", "target": "#nkr_note_mod_0669065", "type": "mod", "text": "門【大】，門清涼云譬如北辰所居眾星拱之【甲】"}
{"id": null, "n": "0670001", "target": "#nkr_note_mod_0670001", "type": "mod", "text": "以金【大】，全【甲】"}
{"id": null, "n": "0670002", "target": "#nkr_note_mod_0670002", "type": "mod", "text": "法【大】，謂法【甲】"}
{"id": null, "n": "0670003", "target": "#nkr_note_mod_0670003", "type": "mod", "text": "無礙無障【大】，等無障無閡【甲】"}
{"id": null, "n": "0670004", "target": "#nkr_note_mod_0670004", "type": "mod", "text": "九【大】，相【甲】"}
{"id": null, "n": "0670005", "target": "#nkr_note_mod_0670005", "type": "mod", "text": "門【大】，門清涼云如金與金色二不相離【甲】"}
{"id": null, "n": "0670006", "target": "#nkr_note_mod_0670006", "type": "mod", "text": "或隱或顯【大】，或顯或隱【甲】"}
{"id": null, "n": "0670007", "target": "#nkr_note_mod_0670007", "type": "mod", "text": "然【大】，然也【甲】"}
{"id": null, "n": "0670008", "target": "#nkr_note_mod_0670008", "type": "mod", "text": "輝【大】，耀【甲】"}
{"id": null, "n": "0670009", "target": "#nkr_note_mod_0670009", "type": "mod", "text": "辦【大】，雜【甲】"}
{"id": null, "n": "0670010", "target": "#nkr_note_mod_0670010", "type": "mod", "text": "門【大】，門清涼云如琉璃壺盛多芥子【甲】"}
{"id": null, "n": "0670011", "target": "#nkr_note_mod_0670011", "type": "mod", "text": "此【大】，〔－〕【甲】"}
{"id": null, "n": "0670012", "target": "#nkr_note_mod_0670012", "type": "mod", "text": "真【大】，謂真【甲】"}
{"id": null, "n": "0670013", "target": "#nkr_note_mod_0670013", "type": "mod", "text": "不實【大】，遷變不停【甲】"}
{"id": null, "n": "0670014", "target": "#nkr_note_mod_0670014", "type": "mod", "text": "有【大】，〔－〕【甲】"}
{"id": null, "n": "0670015", "target": "#nkr_note_mod_0670015", "type": "mod", "text": "三際【大】，〔－〕【甲】"}
{"id": null, "n": "0670016", "target": "#nkr_note_mod_0670016", "type": "mod", "text": "壞【大】，壞一【甲】"}
{"id": null, "n": "0670017", "target": "#nkr_note_mod_0670017", "type": "mod", "text": "量【大】，盡【甲】"}
{"id": null, "n": "0670018", "target": "#nkr_note_mod_0670018", "type": "mod", "text": "各【大】，〔－〕【甲】"}
{"id": null, "n": "0670019", "target": "#nkr_note_mod_0670019", "type": "mod", "text": "有隔不同【大】，各各有隔【甲】"}
{"id": null, "n": "0670020", "target": "#nkr_note_mod_0670020", "type": "mod", "text": "門【大】，門清涼云若一夕夢翱翔百年【甲】"}
{"id": null, "n": "0670021", "target": "#nkr_note_mod_0670021", "type": "mod", "text": "立【大】，有立【甲】"}
{"id": null, "n": "0670022", "target": "#nkr_note_mod_0670022", "type": "mod", "text": "門【大】，門清涼云如一尺之鏡見千里之象【甲】"}
{"id": null, "n": "0670023", "target": "#nkr_note_mod_0670023", "type": "mod", "text": "表【大】，以表【甲】"}
{"id": null, "n": "0670024", "target": "#nkr_note_mod_0670024", "type": "mod", "text": "覩【大】，視【甲】"}
{"id": null, "n": "0670025", "target": "#nkr_note_mod_0670025", "type": "mod", "text": "淨【大】，靜【甲】"}
{"id": null, "n": "0670026", "target": "#nkr_note_mod_0670026", "type": "mod", "text": "門【大】，門清涼云立像竪辟觸目皆道也【甲】"}
{"id": null, "n": "0670027", "target": "#nkr_note_mod_0670027", "type": "mod", "text": "是【大】，為【甲】"}
{"id": null, "n": "0670028", "target": "#nkr_note_mod_0670028", "type": "mod", "text": "共【大】，共成【甲】"}
{"id": null, "n": "0670029", "target": "#nkr_note_mod_0670029", "type": "mod", "text": "到是為【大】，知是【甲】"}
{"id": null, "n": "0670030", "target": "#nkr_note_mod_0670030", "type": "mod", "text": "合【大】，共【甲】"}
{"id": null, "n": "0670031", "target": "#nkr_note_mod_0670031", "type": "mod", "text": "相【大】，法【甲】"}
{"id": null, "n": "0670032", "target": "#nkr_note_mod_0670032", "type": "mod", "text": "集【大】，奪無【甲】"}
{"id": null, "n": "0670033", "target": "#nkr_note_mod_0670033", "type": "mod", "text": "法【大】，法也【甲】"}
{"id": null, "n": "0670034", "target": "#nkr_note_mod_0670034", "type": "mod", "text": "道也覺也【大】，覺也道也【甲】"}
{"id": null, "n": "0670035", "target": "#nkr_note_mod_0670035", "type": "mod", "text": "說【大】，就【甲】"}
{"id": null, "n": "0670036", "target": "#nkr_note_mod_0670036", "type": "mod", "text": "一【大】，即一【甲】"}
{"id": null, "n": "0670037", "target": "#nkr_note_mod_0670037", "type": "mod", "text": "諸【大】，之【甲】"}
{"id": null, "n": "0670038", "target": "#nkr_note_mod_0670038", "type": "mod", "text": "師【大】，如師【甲】"}
{"id": null, "n": "0670039", "target": "#nkr_note_mod_0670039", "type": "mod", "text": "可【大】，待【甲】"}
{"id": null, "n": "0670040", "target": "#nkr_note_mod_0670040", "type": "mod", "text": "覩【大】，規【甲】"}
{"id": null, "n": "0670041", "target": "#nkr_note_mod_0670041", "type": "mod", "text": "子【大】，子之【甲】"}
{"id": null, "n": "0670042", "target": "#nkr_note_mod_0670042", "type": "mod", "text": "生【大】，生之【甲】"}
{"id": null, "n": "0670043", "target": "#nkr_note_mod_0670043", "type": "mod", "text": "實有名之【大】，有實故名【甲】"}
{"id": null, "n": "0670044", "target": "#nkr_note_mod_0670044", "type": "mod", "text": "成【大】，成無一法而不了無一行而不圓無一智而不具無一理而不證【甲】"}
{"id": null, "n": "0670045", "target": "#nkr_note_mod_0670045", "type": "mod", "text": "物【大】，法【甲】"}
{"id": null, "n": "0670046", "target": "#nkr_note_mod_0670046", "type": "mod", "text": "能【大】，〔－〕【甲】"}
{"id": null, "n": "0670047", "target": "#nkr_note_mod_0670047", "type": "mod", "text": "中【大】，於中【甲】"}
{"id": null, "n": "0670048", "target": "#nkr_note_mod_0670048", "type": "mod", "text": "住【大】，住也【甲】"}
{"id": null, "n": "0670049", "target": "#nkr_note_mod_0670049", "type": "mod", "text": "為【大】，〔－〕【甲】"}
{"id": null, "n": "0670050", "target": "#nkr_note_mod_0670050", "type": "mod", "text": "妄【大】，妄想都【甲】"}
{"id": null, "n": "0670051", "target": "#nkr_note_mod_0670051", "type": "mod", "text": "真【大】，真理【甲】"}
{"id": null, "n": "0670052", "target": "#nkr_note_mod_0670052", "type": "mod", "text": "奪【大】，〔－〕【甲】"}
{"id": null, "n": "0670053", "target": "#nkr_note_mod_0670053", "type": "mod", "text": "無【大】，〔－〕【甲】"}
{"id": null, "n": "0670054", "target": "#nkr_note_mod_0670054", "type": "mod", "text": "常【大】，〔－〕【甲】"}
{"id": null, "n": "0670055", "target": "#nkr_note_mod_0670055", "type": "mod", "text": "而【大】，〔－〕【甲】"}
{"id": null, "n": "0670056", "target": "#nkr_note_mod_0670056", "type": "mod", "text": "初【大】，劫【甲】"}
{"id": null, "n": "0670057", "target": "#nkr_note_mod_0670057", "type": "mod", "text": "故【大】，〔－〕【甲】"}
{"id": null, "n": "0670058", "target": "#nkr_note_mod_0670058", "type": "mod", "text": "理【大】，詮【甲】"}
{"id": null, "n": "0670059", "target": "#nkr_note_mod_0670059", "type": "mod", "text": "經【大】，故經【甲】"}
{"id": null, "n": "0670060", "target": "#nkr_note_mod_0670060", "type": "mod", "text": "界【大】，性【甲】"}
{"id": null, "n": "0670061", "target": "#nkr_note_mod_0670061", "type": "mod", "text": "矣【大】，故也又經云能隨染淨緣道分十法界【甲】"}
{"id": null, "n": "0670062", "target": "#nkr_note_mod_0670062", "type": "mod", "text": "大方廣佛華嚴經【大】，註【甲】"}
{"id": null, "n": "0670063", "target": "#nkr_note_mod_0670063", "type": "mod", "text": "卷【大】，卷終【甲】"}
{"id": null, "n": "0667001", "target": "#nkr_note_orig_0667001", "type": "orig", "text": "【原】宋紹聖三年刊宮內省圖書寮藏本，【甲】大日本續藏經，校者曰此序者依甲本載之"}
{"id": null, "n": "0668001", "target": "#nkr_note_orig_0668001", "type": "orig", "text": "大方廣佛華嚴經金師子章＝註金師子章一卷【甲】"}
{"id": null, "n": "0668002", "target": "#nkr_note_orig_0668002", "type": "orig", "text": "此前甲本有唐崇福寺沙門法藏述九字"}
{"id": null, "n": "0668003", "target": "#nkr_note_orig_0668003", "type": "orig", "text": "（華嚴經）＋金【甲】"}
{"id": null, "n": "0668004", "target": "#nkr_note_orig_0668004", "type": "orig", "text": "〔法〕－【甲】"}
{"id": null, "n": "0668005", "target": "#nkr_note_orig_0668005", "type": "orig", "text": "〔元〕－【甲】"}
{"id": null, "n": "0668006", "target": "#nkr_note_orig_0668006", "type": "orig", "text": "有＝巨【甲】"}
{"id": null, "n": "0668007", "target": "#nkr_note_orig_0668007", "type": "orig", "text": "則天聖帝＝天帝【甲】"}
{"id": null, "n": "0668008", "target": "#nkr_note_orig_0668008", "type": "orig", "text": "以示大經厥＝示華嚴經【甲】"}
{"id": null, "n": "0668009", "target": "#nkr_note_orig_0668009", "type": "orig", "text": "華嚴＝大經【甲】"}
{"id": null, "n": "0668010", "target": "#nkr_note_orig_0668010", "type": "orig", "text": "（今則…得）十四字∞（理事…矣）九字【甲】"}
{"id": null, "n": "0668011", "target": "#nkr_note_orig_0668011", "type": "orig", "text": "故得＝一明緣起【甲】"}
{"id": null, "n": "0668012", "target": "#nkr_note_orig_0668012", "type": "orig", "text": "（今則…得）十四字∞（理事…矣）九字【甲】"}
{"id": null, "n": "0668013", "target": "#nkr_note_orig_0668013", "type": "orig", "text": "礙矣＝閡【甲】"}
{"id": null, "n": "0668014", "target": "#nkr_note_orig_0668014", "type": "orig", "text": "〔唐崇…述〕十一字－【甲】"}
{"id": null, "n": "0668015", "target": "#nkr_note_orig_0668015", "type": "orig", "text": "〔初明緣起〕－【甲】"}
{"id": null, "n": "0668016", "target": "#nkr_note_orig_0668016", "type": "orig", "text": "萬＝物【甲】"}
{"id": null, "n": "0668017", "target": "#nkr_note_orig_0668017", "type": "orig", "text": "設＝立【甲】"}
{"id": null, "n": "0668018", "target": "#nkr_note_orig_0668018", "type": "orig", "text": "勒＝勤【甲】"}
{"id": null, "n": "0668019", "target": "#nkr_note_orig_0668019", "type": "orig", "text": "重重＝無盡【甲】"}
{"id": null, "n": "0668020", "target": "#nkr_note_orig_0668020", "type": "orig", "text": "露＝顯【甲】"}
{"id": null, "n": "0668021", "target": "#nkr_note_orig_0668021", "type": "orig", "text": "即＝如【甲】"}
{"id": null, "n": "0668022", "target": "#nkr_note_orig_0668022", "type": "orig", "text": "槃＋（大緣起萬有有必顯於多門無性一宗宗蓋彰於眾德分其體用卷舒之趣易明覽其玄網理事之門方曉今就所喻之法略明緣起之理也）五十四字【甲】"}
{"id": null, "n": "0668023", "target": "#nkr_note_orig_0668023", "type": "orig", "text": "〔第〕－【甲】＊"}
{"id": null, "n": "0668024", "target": "#nkr_note_orig_0668024", "type": "orig", "text": "起＝生【甲】＊"}
{"id": null, "n": "0668025", "target": "#nkr_note_orig_0668025", "type": "orig", "text": "〔以〕－【甲】＊"}
{"id": null, "n": "0668026", "target": "#nkr_note_orig_0668026", "type": "orig", "text": "〔喻〕－【甲】＊"}
{"id": null, "n": "0668027", "target": "#nkr_note_orig_0668027", "type": "orig", "text": "〔也〕－【甲】＊"}
{"id": null, "n": "0668028", "target": "#nkr_note_orig_0668028", "type": "orig", "text": "（工）＋巧【甲】"}
{"id": null, "n": "0668029", "target": "#nkr_note_orig_0668029", "type": "orig", "text": "子＋（之）【甲】"}
{"id": null, "n": "0668030", "target": "#nkr_note_orig_0668030", "type": "orig", "text": "理＝如【甲】"}
{"id": null, "n": "0668031", "target": "#nkr_note_orig_0668031", "type": "orig", "text": "〔結〕－【甲】"}
{"id": null, "n": "0668032", "target": "#nkr_note_orig_0668032", "type": "orig", "text": "〔即〕－【甲】"}
{"id": null, "n": "0668033", "target": "#nkr_note_orig_0668033", "type": "orig", "text": "（理）＋性【甲】"}
{"id": null, "n": "0668034", "target": "#nkr_note_orig_0668034", "type": "orig", "text": "〔相〕－【甲】"}
{"id": null, "n": "0668035", "target": "#nkr_note_orig_0668035", "type": "orig", "text": "〔故〕－【甲】＊"}
{"id": null, "n": "0668036", "target": "#nkr_note_orig_0668036", "type": "orig", "text": "邊＋（也）【甲】"}
{"id": null, "n": "0668037", "target": "#nkr_note_orig_0668037", "type": "orig", "text": "辯之智＝辨教【甲】"}
{"id": null, "n": "0668038", "target": "#nkr_note_orig_0668038", "type": "orig", "text": "了＋（也）【甲】"}
{"id": null, "n": "0668039", "target": "#nkr_note_orig_0668039", "type": "orig", "text": "空＋（是）【甲】"}
{"id": null, "n": "0668040", "target": "#nkr_note_orig_0668040", "type": "orig", "text": "緣起＝從緣【甲】"}
{"id": null, "n": "0668041", "target": "#nkr_note_orig_0668041", "type": "orig", "text": "真＝實【甲】"}
{"id": null, "n": "0668042", "target": "#nkr_note_orig_0668042", "type": "orig", "text": "礙幻存故名＝閡幻有名為【甲】"}
{"id": null, "n": "0668043", "target": "#nkr_note_orig_0668043", "type": "orig", "text": "（謂）＋真【甲】"}
{"id": null, "n": "0668044", "target": "#nkr_note_orig_0668044", "type": "orig", "text": "明＋（之）【甲】"}
{"id": null, "n": "0668045", "target": "#nkr_note_orig_0668045", "type": "orig", "text": "亡＝云【甲】"}
{"id": null, "n": "0668046", "target": "#nkr_note_orig_0668046", "type": "orig", "text": "〔空〕－【甲】"}
{"id": null, "n": "0668047", "target": "#nkr_note_orig_0668047", "type": "orig", "text": "天＋（之）【甲】"}
{"id": null, "n": "0668048", "target": "#nkr_note_orig_0668048", "type": "orig", "text": "像＝象【甲】＊"}
{"id": null, "n": "0668049", "target": "#nkr_note_orig_0668049", "type": "orig", "text": "然＋（也）【甲】"}
{"id": null, "n": "0668050", "target": "#nkr_note_orig_0668050", "type": "orig", "text": "〔依他〕－【甲】"}
{"id": null, "n": "0668051", "target": "#nkr_note_orig_0668051", "type": "orig", "text": "成＋（性也）【甲】"}
{"id": null, "n": "0668052", "target": "#nkr_note_orig_0668052", "type": "orig", "text": "遍＝偏【甲】＊"}
{"id": null, "n": "0668053", "target": "#nkr_note_orig_0668053", "type": "orig", "text": "枉＝拙【甲】"}
{"id": null, "n": "0668054", "target": "#nkr_note_orig_0668054", "type": "orig", "text": "妄＋（現）【甲】"}
{"id": null, "n": "0668055", "target": "#nkr_note_orig_0668055", "type": "orig", "text": "生＋（也）【甲】"}
{"id": null, "n": "0668056", "target": "#nkr_note_orig_0668056", "type": "orig", "text": "號＝名【甲】"}
{"id": null, "n": "0668057", "target": "#nkr_note_orig_0668057", "type": "orig", "text": "隨殊變釋曰法＝壞謂【甲】"}
{"id": null, "n": "0668058", "target": "#nkr_note_orig_0668058", "type": "orig", "text": "性＝生【甲】"}
{"id": null, "n": "0668059", "target": "#nkr_note_orig_0668059", "type": "orig", "text": "〔自〕－【甲】"}
{"id": null, "n": "0668060", "target": "#nkr_note_orig_0668060", "type": "orig", "text": "性也＝生【甲】"}
{"id": null, "n": "0668061", "target": "#nkr_note_orig_0668061", "type": "orig", "text": "法＋（也）【甲】"}
{"id": null, "n": "0668062", "target": "#nkr_note_orig_0668062", "type": "orig", "text": "〔諸法而〕－【甲】"}
{"id": null, "n": "0668063", "target": "#nkr_note_orig_0668063", "type": "orig", "text": "心＝之【甲】"}
{"id": null, "n": "0668064", "target": "#nkr_note_orig_0668064", "type": "orig", "text": "〔者〕－【甲】"}
{"id": null, "n": "0668065", "target": "#nkr_note_orig_0668065", "type": "orig", "text": "事＋（也）【甲】"}
{"id": null, "n": "0668066", "target": "#nkr_note_orig_0668066", "type": "orig", "text": "子＋（相）【甲】"}
{"id": null, "n": "0668067", "target": "#nkr_note_orig_0668067", "type": "orig", "text": "虛＋（也）【甲】"}
{"id": null, "n": "0668068", "target": "#nkr_note_orig_0668068", "type": "orig", "text": "釋曰離真理＝謂真【甲】"}
{"id": null, "n": "0668069", "target": "#nkr_note_orig_0668069", "type": "orig", "text": "盡＋（也）【甲】"}
{"id": null, "n": "0668070", "target": "#nkr_note_orig_0668070", "type": "orig", "text": "生＋（也）【甲】"}
{"id": null, "n": "0669001", "target": "#nkr_note_orig_0669001", "type": "orig", "text": "生＋（之）【甲】"}
{"id": null, "n": "0669002", "target": "#nkr_note_orig_0669002", "type": "orig", "text": "釋曰今＝謂金【甲】"}
{"id": null, "n": "0669003", "target": "#nkr_note_orig_0669003", "type": "orig", "text": "〔生〕－【甲】"}
{"id": null, "n": "0669004", "target": "#nkr_note_orig_0669004", "type": "orig", "text": "生死性＝無【甲】"}
{"id": null, "n": "0669005", "target": "#nkr_note_orig_0669005", "type": "orig", "text": "名達＝故名【甲】"}
{"id": null, "n": "0669006", "target": "#nkr_note_orig_0669006", "type": "orig", "text": "（（一聲…第一））二十六字＝（（者一愚法））四字【甲】"}
{"id": null, "n": "0669007", "target": "#nkr_note_orig_0669007", "type": "orig", "text": "緣生＝因緣【甲】"}
{"id": null, "n": "0669008", "target": "#nkr_note_orig_0669008", "type": "orig", "text": "（謂）＋一【甲】"}
{"id": null, "n": "0669009", "target": "#nkr_note_orig_0669009", "type": "orig", "text": "息＋（也）【甲】"}
{"id": null, "n": "0669010", "target": "#nkr_note_orig_0669010", "type": "orig", "text": "故名＝名愚法【甲】"}
{"id": null, "n": "0669011", "target": "#nkr_note_orig_0669011", "type": "orig", "text": "有＝無【甲】"}
{"id": null, "n": "0669012", "target": "#nkr_note_orig_0669012", "type": "orig", "text": "空＋（也）【甲】"}
{"id": null, "n": "0669013", "target": "#nkr_note_orig_0669013", "type": "orig", "text": "者謂此師子＝謂即此【甲】"}
{"id": null, "n": "0669014", "target": "#nkr_note_orig_0669014", "type": "orig", "text": "（謂）＋師【甲】"}
{"id": null, "n": "0669015", "target": "#nkr_note_orig_0669015", "type": "orig", "text": "假＝似【甲】"}
{"id": null, "n": "0669016", "target": "#nkr_note_orig_0669016", "type": "orig", "text": "顯＋（也）【甲】"}
{"id": null, "n": "0669017", "target": "#nkr_note_orig_0669017", "type": "orig", "text": "謂此師子雖然＝雖復【甲】"}
{"id": null, "n": "0669018", "target": "#nkr_note_orig_0669018", "type": "orig", "text": "礙＝閡【甲】＊"}
{"id": null, "n": "0669019", "target": "#nkr_note_orig_0669019", "type": "orig", "text": "故名＝名為【甲】"}
{"id": null, "n": "0669020", "target": "#nkr_note_orig_0669020", "type": "orig", "text": "〔謂〕－【甲】＊"}
{"id": null, "n": "0669021", "target": "#nkr_note_orig_0669021", "type": "orig", "text": "顯＋（也）【甲】"}
{"id": null, "n": "0669022", "target": "#nkr_note_orig_0669022", "type": "orig", "text": "辯＝辨【甲】"}
{"id": null, "n": "0669023", "target": "#nkr_note_orig_0669023", "type": "orig", "text": "〔喻〕－【甲】"}
{"id": null, "n": "0669024", "target": "#nkr_note_orig_0669024", "type": "orig", "text": "寄＋（也）【甲】"}
{"id": null, "n": "0669025", "target": "#nkr_note_orig_0669025", "type": "orig", "text": "〔故〕－【甲】＊"}
{"id": null, "n": "0669026", "target": "#nkr_note_orig_0669026", "type": "orig", "text": "〔師子〕－【甲】"}
{"id": null, "n": "0669027", "target": "#nkr_note_orig_0669027", "type": "orig", "text": "渾＝混【甲】"}
{"id": null, "n": "0669028", "target": "#nkr_note_orig_0669028", "type": "orig", "text": "（謂）＋師【甲】"}
{"id": null, "n": "0669029", "target": "#nkr_note_orig_0669029", "type": "orig", "text": "現前＝露現也【甲】"}
{"id": null, "n": "0669030", "target": "#nkr_note_orig_0669030", "type": "orig", "text": "全＝金【甲】"}
{"id": null, "n": "0669031", "target": "#nkr_note_orig_0669031", "type": "orig", "text": "（如）＋師【甲】"}
{"id": null, "n": "0669032", "target": "#nkr_note_orig_0669032", "type": "orig", "text": "金＋（也）【甲】"}
{"id": null, "n": "0669033", "target": "#nkr_note_orig_0669033", "type": "orig", "text": "紜＝然【甲】"}
{"id": null, "n": "0669034", "target": "#nkr_note_orig_0669034", "type": "orig", "text": "各＋（各）【甲】"}
{"id": null, "n": "0669035", "target": "#nkr_note_orig_0669035", "type": "orig", "text": "位＋（也）【甲】"}
{"id": null, "n": "0669036", "target": "#nkr_note_orig_0669036", "type": "orig", "text": "力＝方【甲】"}
{"id": null, "n": "0669037", "target": "#nkr_note_orig_0669037", "type": "orig", "text": "門＝者【甲】"}
{"id": null, "n": "0669038", "target": "#nkr_note_orig_0669038", "type": "orig", "text": "〔二一…具足門〕七十九字－【甲】"}
{"id": null, "n": "0669039", "target": "#nkr_note_orig_0669039", "type": "orig", "text": "法＋（雖於一法）【甲】"}
{"id": null, "n": "0669040", "target": "#nkr_note_orig_0669040", "type": "orig", "text": "造＝迭【甲】"}
{"id": null, "n": "0669041", "target": "#nkr_note_orig_0669041", "type": "orig", "text": "也＝矣【甲】"}
{"id": null, "n": "0669042", "target": "#nkr_note_orig_0669042", "type": "orig", "text": "此下甲本有清涼云如海一滴具百川味十一字"}
{"id": null, "n": "0669043", "target": "#nkr_note_orig_0669043", "type": "orig", "text": "〔者〕－【甲】"}
{"id": null, "n": "0669044", "target": "#nkr_note_orig_0669044", "type": "orig", "text": "或＋（一或）【甲】"}
{"id": null, "n": "0669045", "target": "#nkr_note_orig_0669045", "type": "orig", "text": "此下甲本有清涼云若一室之千燈光光即涉也十四字"}
{"id": null, "n": "0669046", "target": "#nkr_note_orig_0669046", "type": "orig", "text": "（如）＋事【甲】"}
{"id": null, "n": "0669047", "target": "#nkr_note_orig_0669047", "type": "orig", "text": "理＋（也）【甲】"}
{"id": null, "n": "0669048", "target": "#nkr_note_orig_0669048", "type": "orig", "text": "唯＋（見）【甲】"}
{"id": null, "n": "0669049", "target": "#nkr_note_orig_0669049", "type": "orig", "text": "（如）＋理【甲】"}
{"id": null, "n": "0669050", "target": "#nkr_note_orig_0669050", "type": "orig", "text": "顯＝隱【甲】"}
{"id": null, "n": "0669051", "target": "#nkr_note_orig_0669051", "type": "orig", "text": "故名＝名為【甲】＊"}
{"id": null, "n": "0669052", "target": "#nkr_note_orig_0669052", "type": "orig", "text": "此下甲本有清涼云若片月澄空晦明相並十二字"}
{"id": null, "n": "0669053", "target": "#nkr_note_orig_0669053", "type": "orig", "text": "〔者謂〕－【甲】"}
{"id": null, "n": "0669054", "target": "#nkr_note_orig_0669054", "type": "orig", "text": "小＝一【甲】"}
{"id": null, "n": "0669055", "target": "#nkr_note_orig_0669055", "type": "orig", "text": "大法＝多法小法中有大法【甲】"}
{"id": null, "n": "0669056", "target": "#nkr_note_orig_0669056", "type": "orig", "text": "頓現＝顯現也【甲】"}
{"id": null, "n": "0669057", "target": "#nkr_note_orig_0669057", "type": "orig", "text": "（一橫多）＋多【甲】"}
{"id": null, "n": "0669058", "target": "#nkr_note_orig_0669058", "type": "orig", "text": "礙＝閡也【甲】"}
{"id": null, "n": "0669059", "target": "#nkr_note_orig_0669059", "type": "orig", "text": "之天珠故＝天珠【甲】"}
{"id": null, "n": "0669060", "target": "#nkr_note_orig_0669060", "type": "orig", "text": "此下甲本有清涼云若兩鏡互照交耀相寫迭出無盡十六字"}
{"id": null, "n": "0669061", "target": "#nkr_note_orig_0669061", "type": "orig", "text": "若＝即此師子【甲】"}
{"id": null, "n": "0669062", "target": "#nkr_note_orig_0669062", "type": "orig", "text": "〔相〕－【甲】"}
{"id": null, "n": "0669063", "target": "#nkr_note_orig_0669063", "type": "orig", "text": "純＝雜亦【甲】"}
{"id": null, "n": "0669064", "target": "#nkr_note_orig_0669064", "type": "orig", "text": "雜＝純【甲】"}
{"id": null, "n": "0669065", "target": "#nkr_note_orig_0669065", "type": "orig", "text": "此下甲本有清涼云譬如北辰所居眾星拱之十三字"}
{"id": null, "n": "0670001", "target": "#nkr_note_orig_0670001", "type": "orig", "text": "以金＝全【甲】"}
{"id": null, "n": "0670002", "target": "#nkr_note_orig_0670002", "type": "orig", "text": "（謂）＋法【甲】"}
{"id": null, "n": "0670003", "target": "#nkr_note_orig_0670003", "type": "orig", "text": "無礙無障＝等無障無閡【甲】"}
{"id": null, "n": "0670004", "target": "#nkr_note_orig_0670004", "type": "orig", "text": "九＝相【甲】"}
{"id": null, "n": "0670005", "target": "#nkr_note_orig_0670005", "type": "orig", "text": "此下甲本有清涼云如金與金色二不相離十二字"}
{"id": null, "n": "0670006", "target": "#nkr_note_orig_0670006", "type": "orig", "text": "或隱或顯＝或顯或隱【甲】"}
{"id": null, "n": "0670007", "target": "#nkr_note_orig_0670007", "type": "orig", "text": "然＋（也）【甲】"}
{"id": null, "n": "0670008", "target": "#nkr_note_orig_0670008", "type": "orig", "text": "輝＝耀【甲】"}
{"id": null, "n": "0670009", "target": "#nkr_note_orig_0670009", "type": "orig", "text": "辦＝雜【甲】"}
{"id": null, "n": "0670010", "target": "#nkr_note_orig_0670010", "type": "orig", "text": "此下甲本有清涼云如琉璃壺盛多芥子十一字"}
{"id": null, "n": "0670011", "target": "#nkr_note_orig_0670011", "type": "orig", "text": "〔此〕－【甲】"}
{"id": null, "n": "0670012", "target": "#nkr_note_orig_0670012", "type": "orig", "text": "（謂）＋真【甲】"}
{"id": null, "n": "0670013", "target": "#nkr_note_orig_0670013", "type": "orig", "text": "不實＝遷變不停【甲】"}
{"id": null, "n": "0670014", "target": "#nkr_note_orig_0670014", "type": "orig", "text": "〔有〕－【甲】"}
{"id": null, "n": "0670015", "target": "#nkr_note_orig_0670015", "type": "orig", "text": "〔三際〕－【甲】"}
{"id": null, "n": "0670016", "target": "#nkr_note_orig_0670016", "type": "orig", "text": "壞＋（一）【甲】"}
{"id": null, "n": "0670017", "target": "#nkr_note_orig_0670017", "type": "orig", "text": "量＝盡【甲】"}
{"id": null, "n": "0670018", "target": "#nkr_note_orig_0670018", "type": "orig", "text": "〔各〕－【甲】"}
{"id": null, "n": "0670019", "target": "#nkr_note_orig_0670019", "type": "orig", "text": "有隔不同＝各各有隔【甲】"}
{"id": null, "n": "0670020", "target": "#nkr_note_orig_0670020", "type": "orig", "text": "此下甲本有清涼云若一夕夢翱翔百年十一字"}
{"id": null, "n": "0670021", "target": "#nkr_note_orig_0670021", "type": "orig", "text": "（有）＋立【甲】"}
{"id": null, "n": "0670022", "target": "#nkr_note_orig_0670022", "type": "orig", "text": "此下甲本有清涼云如一尺之鏡見千里之象十三字"}
{"id": null, "n": "0670023", "target": "#nkr_note_orig_0670023", "type": "orig", "text": "（以）＋表【甲】"}
{"id": null, "n": "0670024", "target": "#nkr_note_orig_0670024", "type": "orig", "text": "覩＝視【甲】"}
{"id": null, "n": "0670025", "target": "#nkr_note_orig_0670025", "type": "orig", "text": "淨＝靜【甲】"}
{"id": null, "n": "0670026", "target": "#nkr_note_orig_0670026", "type": "orig", "text": "此下甲本有清涼云立像竪辟觸目皆道也十二字"}
{"id": null, "n": "0670027", "target": "#nkr_note_orig_0670027", "type": "orig", "text": "是＝為【甲】"}
{"id": null, "n": "0670028", "target": "#nkr_note_orig_0670028", "type": "orig", "text": "共＋（成）【甲】"}
{"id": null, "n": "0670029", "target": "#nkr_note_orig_0670029", "type": "orig", "text": "到是為＝知是【甲】"}
{"id": null, "n": "0670030", "target": "#nkr_note_orig_0670030", "type": "orig", "text": "合＝共【甲】"}
{"id": null, "n": "0670031", "target": "#nkr_note_orig_0670031", "type": "orig", "text": "相＝法【甲】"}
{"id": null, "n": "0670032", "target": "#nkr_note_orig_0670032", "type": "orig", "text": "集＝奪無【甲】"}
{"id": null, "n": "0670033", "target": "#nkr_note_orig_0670033", "type": "orig", "text": "法＋（也）【甲】"}
{"id": null, "n": "0670034", "target": "#nkr_note_orig_0670034", "type": "orig", "text": "道也覺也＝覺也道也【甲】"}
{"id": null, "n": "0670035", "target": "#nkr_note_orig_0670035", "type": "orig", "text": "說＝就【甲】"}
{"id": null, "n": "0670036", "target": "#nkr_note_orig_0670036", "type": "orig", "text": "（即）＋一【甲】"}
{"id": null, "n": "0670037", "target": "#nkr_note_orig_0670037", "type": "orig", "text": "諸＝之【甲】"}
{"id": null, "n": "0670038", "target": "#nkr_note_orig_0670038", "type": "orig", "text": "（如）＋師【甲】"}
{"id": null, "n": "0670039", "target": "#nkr_note_orig_0670039", "type": "orig", "text": "可＝待【甲】"}
{"id": null, "n": "0670040", "target": "#nkr_note_orig_0670040", "type": "orig", "text": "覩＝規【甲】"}
{"id": null, "n": "0670041", "target": "#nkr_note_orig_0670041", "type": "orig", "text": "子＋（之）【甲】"}
{"id": null, "n": "0670042", "target": "#nkr_note_orig_0670042", "type": "orig", "text": "生＋（之）【甲】"}
{"id": null, "n": "0670043", "target": "#nkr_note_orig_0670043", "type": "orig", "text": "實有名之＝有實故名【甲】"}
{"id": null, "n": "0670044", "target": "#nkr_note_orig_0670044", "type": "orig", "text": "成＋（無一法而不了無一行而不圓無一智而不具無一理而不證）【甲】"}
{"id": null, "n": "0670045", "target": "#nkr_note_orig_0670045", "type": "orig", "text": "物＝法【甲】"}
{"id": null, "n": "0670046", "target": "#nkr_note_orig_0670046", "type": "orig", "text": "〔能〕－【甲】"}
{"id": null, "n": "0670047", "target": "#nkr_note_orig_0670047", "type": "orig", "text": "（於）＋中【甲】"}
{"id": null, "n": "0670048", "target": "#nkr_note_orig_0670048", "type": "orig", "text": "住＋（也）【甲】"}
{"id": null, "n": "0670049", "target": "#nkr_note_orig_0670049", "type": "orig", "text": "〔為〕－【甲】"}
{"id": null, "n": "0670050", "target": "#nkr_note_orig_0670050", "type": "orig", "text": "妄＋（想都）【甲】"}
{"id": null, "n": "0670051", "target": "#nkr_note_orig_0670051", "type": "orig", "text": "真＋（理）【甲】"}
{"id": null, "n": "0670052", "target": "#nkr_note_orig_0670052", "type": "orig", "text": "〔奪〕－【甲】"}
{"id": null, "n": "0670053", "target": "#nkr_note_orig_0670053", "type": "orig", "text": "〔無〕－【甲】"}
{"id": null, "n": "0670054", "target": "#nkr_note_orig_0670054", "type": "orig", "text": "〔常〕－【甲】"}
{"id": null, "n": "0670055", "target": "#nkr_note_orig_0670055", "type": "orig", "text": "〔而〕－【甲】"}
{"id": null, "n": "0670056", "target": "#nkr_note_orig_0670056", "type": "orig", "text": "初＝劫【甲】"}
{"id": null, "n": "0670057", "target": "#nkr_note_orig_0670057", "type": "orig", "text": "〔故〕－【甲】"}
{"id": null, "n": "0670058", "target": "#nkr_note_orig_0670058", "type": "orig", "text": "理＝詮【甲】"}
{"id": null, "n": "0670059", "target": "#nkr_note_orig_0670059", "type": "orig", "text": "（故）＋經【甲】"}
{"id": null, "n": "0670060", "target": "#nkr_note_orig_0670060", "type": "orig", "text": "界＝性【甲】"}
{"id": null, "n": "0670061", "target": "#nkr_note_orig_0670061", "type": "orig", "text": "矣＝故也又經云能隨染淨緣道分十法界【甲】"}
{"id": null, "n": "0670062", "target": "#nkr_note_orig_0670062", "type": "orig", "text": "大方廣佛華嚴經＝註【甲】"}
{"id": null, "n": "0670063", "target": "#nkr_note_orig_0670063", "type": "orig", "text": "卷＋（終）【甲】"}
{"id": null, "n": "0669a1201", "target": "#nkr_note_add_0669a1201", "type": "add", "text": "圓【CB】，圖【大】"}
