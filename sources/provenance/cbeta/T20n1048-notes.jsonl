{"id": null, "n": "0044007", "target": "#nkr_note_mod_0044007", "type": "mod", "text": "西【大】，宋西【明】"}
{"id": null, "n": "0044008", "target": "#nkr_note_mod_0044008", "type": "mod", "text": "（中印…門）二十一字【大】，（譯經三藏朝散大丈試鴻臚少傳教大師）十七字【宋】【元】【明】"}
{"id": null, "n": "0044009", "target": "#nkr_note_mod_0044009", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0044010", "target": "#nkr_note_mod_0044010", "type": "mod", "text": "捫【大】＊，門【明】＊"}
{"id": null, "n": "0045001", "target": "#nkr_note_mod_0045001", "type": "mod", "text": "殃【大】，央【明】"}
{"id": null, "n": "0045002", "target": "#nkr_note_mod_0045002", "type": "mod", "text": "反【大】，切【明】"}
{"id": null, "n": "0045003", "target": "#nkr_note_mod_0045003", "type": "mod", "text": "母【大】，母嚕【明】"}
{"id": null, "n": "0045004", "target": "#nkr_note_mod_0045004", "type": "mod", "text": "底【大】，底彌【明】"}
{"id": null, "n": "0045005", "target": "#nkr_note_mod_0045005", "type": "mod", "text": "哩【大】，哩哩【明】"}
{"id": null, "n": "0045006", "target": "#nkr_note_mod_0045006", "type": "mod", "text": "彌哩【大】，〔－〕【明】"}
{"id": null, "n": "0045007", "target": "#nkr_note_mod_0045007", "type": "mod", "text": "由【大】＊，猶【元】【明】＊"}
{"id": null, "n": "0045008", "target": "#nkr_note_mod_0045008", "type": "mod", "text": "反【大】，切【明】"}
{"id": null, "n": "0045009", "target": "#nkr_note_mod_0045009", "type": "mod", "text": "㫐【大】，里【明】"}
{"id": null, "n": "0045010", "target": "#nkr_note_mod_0045010", "type": "mod", "text": "釋【大】，擇【明】"}
{"id": null, "n": "0046001", "target": "#nkr_note_mod_0046001", "type": "mod", "text": "喻【大】，俞【明】"}
{"id": null, "n": "0046002", "target": "#nkr_note_mod_0046002", "type": "mod", "text": "詞【大】，辭【明】"}
{"id": null, "n": "0046003", "target": "#nkr_note_mod_0046003", "type": "mod", "text": "成【大】，咸【明】"}
{"id": null, "n": "0044006", "target": "#nkr_note_orig_0044006", "type": "orig", "text": "【原】麗本"}
