{"id": null, "n": "0707018", "target": "#nkr_note_mod_0707018", "type": "mod", "text": "經【大】＊，一卷【宋】【元】【宮】＊，〔－〕【明】＊"}
{"id": null, "n": "0707019", "target": "#nkr_note_mod_0707019", "type": "mod", "text": "宋天竺三藏求那跋陀羅譯【大】，宋文帝代求那跋陀羅於楊都譯【宋】【元】【宮】，宋求那跋陀羅譯【明】"}
{"id": null, "n": "0707020", "target": "#nkr_note_mod_0707020", "type": "mod", "text": "純【大】，純行【宋】【元】【明】【宮】"}
{"id": null, "n": "0707021", "target": "#nkr_note_mod_0707021", "type": "mod", "text": "欲【大】，俗【宋】【元】【明】【聖】"}
{"id": null, "n": "0707022", "target": "#nkr_note_mod_0707022", "type": "mod", "text": "又【大】，又有【宋】【元】【明】【宮】"}
{"id": null, "n": "0707023", "target": "#nkr_note_mod_0707023", "type": "mod", "text": "歸【大】，所護【宋】【元】【明】【宮】"}
{"id": null, "n": "0708001", "target": "#nkr_note_mod_0708001", "type": "mod", "text": "名【大】，者【宋】【元】【明】【宮】"}
{"id": null, "n": "0708002", "target": "#nkr_note_mod_0708002", "type": "mod", "text": "弓【大】，卷【宋】【元】【明】【宮】"}
{"id": null, "n": "0708003", "target": "#nkr_note_mod_0708003", "type": "mod", "text": "侍【大】，特【宮】"}
{"id": null, "n": "0708004", "target": "#nkr_note_mod_0708004", "type": "mod", "text": "罪【大】，地獄罪【宋】【元】【明】【宮】"}
{"id": null, "n": "0708005", "target": "#nkr_note_mod_0708005", "type": "mod", "text": "德【大】，後【宋】【元】【明】【宮】"}
{"id": null, "n": "0708007", "target": "#nkr_note_mod_0708007", "type": "mod", "text": "常【大】，當【宋】【元】【宮】"}
{"id": null, "n": "0708008", "target": "#nkr_note_mod_0708008", "type": "mod", "text": "（何當…懈）九字【大】，〔－〕【宮】"}
{"id": null, "n": "0708009", "target": "#nkr_note_mod_0708009", "type": "mod", "text": "者【大】，是【宋】【元】【宮】"}
{"id": null, "n": "0707018", "target": "#nkr_note_orig_0707018", "type": "orig", "text": "經＝一卷【宋】【元】【宮】＊，〔經〕－【明】＊"}
{"id": null, "n": "0707019", "target": "#nkr_note_orig_0707019", "type": "orig", "text": "宋天竺三藏求那跋陀羅譯＝宋文帝代求那跋陀羅於楊都譯【宋】【元】【宮】，宋求那跋陀羅譯【明】"}
{"id": null, "n": "0707020", "target": "#nkr_note_orig_0707020", "type": "orig", "text": "純＋（行）【三】【宮】"}
{"id": null, "n": "0707021", "target": "#nkr_note_orig_0707021", "type": "orig", "text": "欲＝俗【三】【聖】"}
{"id": null, "n": "0707022", "target": "#nkr_note_orig_0707022", "type": "orig", "text": "又＋（有）【三】【宮】"}
{"id": null, "n": "0707023", "target": "#nkr_note_orig_0707023", "type": "orig", "text": "歸＝所護【三】【宮】"}
{"id": null, "n": "0708001", "target": "#nkr_note_orig_0708001", "type": "orig", "text": "名＝者【三】【宮】"}
{"id": null, "n": "0708002", "target": "#nkr_note_orig_0708002", "type": "orig", "text": "弓＝卷【三】【宮】"}
{"id": null, "n": "0708003", "target": "#nkr_note_orig_0708003", "type": "orig", "text": "侍＝特【宮】"}
{"id": null, "n": "0708004", "target": "#nkr_note_orig_0708004", "type": "orig", "text": "（地獄）＋罪【三】【宮】"}
{"id": null, "n": "0708005", "target": "#nkr_note_orig_0708005", "type": "orig", "text": "德＝後【三】【宮】"}
{"id": null, "n": "0708006", "target": "#nkr_note_orig_0708006", "type": "orig", "text": "脫下三本及宮本有若失乃至戒號四百十五字今附載卷末以宋元宮本對校明本"}
{"id": null, "n": "0708007", "target": "#nkr_note_orig_0708007", "type": "orig", "text": "常＝當【宋】【元】【宮】"}
{"id": null, "n": "0708008", "target": "#nkr_note_orig_0708008", "type": "orig", "text": "〔何當…懈〕九字－【宮】"}
{"id": null, "n": "0708009", "target": "#nkr_note_orig_0708009", "type": "orig", "text": "者＝是【宋】【元】【宮】"}
