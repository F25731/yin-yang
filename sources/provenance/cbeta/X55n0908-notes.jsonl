{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": "0666001", "target": "#nkr_note_orig_0666001", "type": "orig", "text": "正疑止"}
{"id": null, "n": "0666002", "target": "#nkr_note_orig_0666002", "type": "orig", "text": "眼疑眠"}
{"id": null, "n": "0667001", "target": "#nkr_note_orig_0667001", "type": "orig", "text": "󴋇疑也"}
{"id": null, "n": "0668001", "target": "#nkr_note_orig_0668001", "type": "orig", "text": "令疑今下同"}
{"id": null, "n": "0667a0301", "target": "#nkr_note_add_0667a0301", "type": "add", "text": "孔【CB】，吼【卍續】"}
{"id": null, "n": "0667a1901", "target": "#nkr_note_add_0667a1901", "type": "add", "text": "諂【CB】，謟【卍續】"}
{"id": null, "n": "0667c0301", "target": "#nkr_note_add_0667c0301", "type": "add", "text": "已【CB】，巳【卍續】"}
{"id": null, "n": "0667c1601", "target": "#nkr_note_add_0667c1601", "type": "add", "text": "益【CB】，盖【卍續】"}
{"id": null, "n": "0667c1701", "target": "#nkr_note_add_0667c1701", "type": "add", "text": "止【CB】，［－］【卍續】"}
{"id": null, "n": "0667c2301", "target": "#nkr_note_add_0667c2301", "type": "add", "text": "［－］【CB】，若【卍續】"}
{"id": null, "n": "0668a0801", "target": "#nkr_note_add_0668a0801", "type": "add", "text": "已【CB】，巳【卍續】"}
