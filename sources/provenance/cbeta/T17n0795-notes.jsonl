{"id": null, "n": "0740005", "target": "#nkr_note_orig_0740005", "type": "orig", "text": "他＋（他）【宮】"}
{"id": null, "n": "0740006", "target": "#nkr_note_orig_0740006", "type": "orig", "text": "故＋（教）【三】"}
