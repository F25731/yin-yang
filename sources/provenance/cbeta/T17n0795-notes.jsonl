{"id": null, "n": "0739036", "target": "#nkr_note_mod_0739036", "type": "mod", "text": "佛【大】，佛說佛【宋】【元】【宮】"}
{"id": null, "n": "0739037", "target": "#nkr_note_mod_0739037", "type": "mod", "text": "人名【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0740001", "target": "#nkr_note_mod_0740001", "type": "mod", "text": "中【大】，中人【宋】【元】【明】"}
{"id": null, "n": "0740002", "target": "#nkr_note_mod_0740002", "type": "mod", "text": "（一人…如勝）十七字【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0740003", "target": "#nkr_note_mod_0740003", "type": "mod", "text": "正【大】，政【宋】【元】【明】【宮】"}
{"id": null, "n": "0740004", "target": "#nkr_note_mod_0740004", "type": "mod", "text": "隨【大】，墮【宮】"}
{"id": null, "n": "0740005", "target": "#nkr_note_mod_0740005", "type": "mod", "text": "他【大】，他他【宮】"}
{"id": null, "n": "0740006", "target": "#nkr_note_mod_0740006", "type": "mod", "text": "故【大】，故教【宋】【元】【明】"}
{"id": null, "n": "0739036", "target": "#nkr_note_orig_0739036", "type": "orig", "text": "（佛說）＋佛【宋】【元】【宮】"}
{"id": null, "n": "0739037", "target": "#nkr_note_orig_0739037", "type": "orig", "text": "〔人名〕－【宋】【元】【宮】"}
