{"id": null, "n": null, "target": null, "type": null, "text": "我所有"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X01n0027_p0443b09"}
{"id": null, "n": "0441001", "target": "#nkr_note_orig_0441001", "type": "orig", "text": "目錄新作"}
{"id": null, "n": "0442001", "target": "#nkr_note_orig_0442001", "type": "orig", "text": "絕下絕文然見句語則似無缺文也"}
{"id": null, "n": "0442002", "target": "#nkr_note_orig_0442002", "type": "orig", "text": "量下疑脫劫字"}
{"id": null, "n": "0442003", "target": "#nkr_note_orig_0442003", "type": "orig", "text": "法下缺文然按一連"}
{"id": null, "n": "0442004", "target": "#nkr_note_orig_0442004", "type": "orig", "text": "今下缺文然是一連"}
{"id": null, "n": "0443001", "target": "#nkr_note_orig_0443001", "type": "orig", "text": "已下字傍有"}
{"id": null, "n": "0443002", "target": "#nkr_note_orig_0443002", "type": "orig", "text": "者係字存半而補之"}
{"id": null, "n": "0443003", "target": "#nkr_note_orig_0443003", "type": "orig", "text": "言等一段書于片紙不知可置何處"}
{"id": null, "n": "0443004", "target": "#nkr_note_orig_0443004", "type": "orig", "text": "白等一段疑錯簡"}
{"id": null, "n": "0443005", "target": "#nkr_note_orig_0443005", "type": "orig", "text": "父等一段疑與次上一連文"}
{"id": null, "n": "0444001", "target": "#nkr_note_orig_0444001", "type": "orig", "text": "今下一有空處"}
{"id": null, "n": "0444002", "target": "#nkr_note_orig_0444002", "type": "orig", "text": "眾下疑脫生字"}
{"id": null, "n": "0444003", "target": "#nkr_note_orig_0444003", "type": "orig", "text": "天等七字更勘"}
{"id": null, "n": "0445001", "target": "#nkr_note_orig_0445001", "type": "orig", "text": "之疑本"}
{"id": null, "n": "0445002", "target": "#nkr_note_orig_0445002", "type": "orig", "text": "骨下一有母字"}
{"id": null, "n": "0448001", "target": "#nkr_note_orig_0448001", "type": "orig", "text": "示疑亦"}
{"id": null, "n": "0451001", "target": "#nkr_note_orig_0451001", "type": "orig", "text": "忘疑惡或妄"}
{"id": null, "n": "0451002", "target": "#nkr_note_orig_0451002", "type": "orig", "text": "不疑去"}
{"id": null, "n": "0452001", "target": "#nkr_note_orig_0452001", "type": "orig", "text": "便疑變"}
{"id": null, "n": "0452002", "target": "#nkr_note_orig_0452002", "type": "orig", "text": "三已下佚失五百四十六字"}
{"id": null, "n": "0453001", "target": "#nkr_note_orig_0453001", "type": "orig", "text": "乎疑平"}
{"id": null, "n": "0454001", "target": "#nkr_note_orig_0454001", "type": "orig", "text": "大疑六"}
