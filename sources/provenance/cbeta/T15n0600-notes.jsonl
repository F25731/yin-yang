{"id": null, "n": "0158004", "target": "#nkr_note_orig_0158004", "type": "orig", "text": "〔即〕－【三】【宮】"}
{"id": null, "n": "0158005", "target": "#nkr_note_orig_0158005", "type": "orig", "text": "〔物〕－【宮】"}
{"id": null, "n": "0158006", "target": "#nkr_note_orig_0158006", "type": "orig", "text": "〔能〕－【三】【宮】"}
{"id": null, "n": "0158007", "target": "#nkr_note_orig_0158007", "type": "orig", "text": "得＋（佛）【三】【宮】"}
{"id": null, "n": "0158008", "target": "#nkr_note_orig_0158008", "type": "orig", "text": "唯＝惟【宮】"}
{"id": null, "n": "0158009", "target": "#nkr_note_orig_0158009", "type": "orig", "text": "直＝貞【三】【宮】"}
{"id": null, "n": "0158010", "target": "#nkr_note_orig_0158010", "type": "orig", "text": "慧＝惠【三】【宮】"}
{"id": null, "n": "0159001", "target": "#nkr_note_orig_0159001", "type": "orig", "text": "忘＝妄【三】【宮】"}
