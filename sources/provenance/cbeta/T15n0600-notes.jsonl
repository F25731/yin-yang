{"id": null, "n": "0157020", "target": "#nkr_note_mod_0157020", "type": "mod", "text": "十【大】＊，佛說十【明】＊"}
{"id": null, "n": "0157021", "target": "#nkr_note_mod_0157021", "type": "mod", "text": "大【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0157022", "target": "#nkr_note_mod_0157022", "type": "mod", "text": "藏【大】，藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0157023", "target": "#nkr_note_mod_0157023", "type": "mod", "text": "奉制【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0157024", "target": "#nkr_note_mod_0157024", "type": "mod", "text": "莫【大】，豈【宋】【元】【明】【宮】"}
{"id": null, "n": "0157025", "target": "#nkr_note_mod_0157025", "type": "mod", "text": "集【大】，習【宋】【元】【明】【宮】"}
{"id": null, "n": "0157026", "target": "#nkr_note_mod_0157026", "type": "mod", "text": "當【大】，常【宋】【元】【明】【宮】"}
{"id": null, "n": "0158001", "target": "#nkr_note_mod_0158001", "type": "mod", "text": "而【大】，不【宋】【元】【明】【宮】"}
{"id": null, "n": "0158002", "target": "#nkr_note_mod_0158002", "type": "mod", "text": "覺【大】，興【宮】"}
{"id": null, "n": "0158003", "target": "#nkr_note_mod_0158003", "type": "mod", "text": "者【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0158004", "target": "#nkr_note_mod_0158004", "type": "mod", "text": "即【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0158005", "target": "#nkr_note_mod_0158005", "type": "mod", "text": "物【大】，〔－〕【宮】"}
{"id": null, "n": "0158006", "target": "#nkr_note_mod_0158006", "type": "mod", "text": "能【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0158007", "target": "#nkr_note_mod_0158007", "type": "mod", "text": "得【大】，得佛【宋】【元】【明】【宮】"}
{"id": null, "n": "0158008", "target": "#nkr_note_mod_0158008", "type": "mod", "text": "唯【大】，惟【宮】"}
{"id": null, "n": "0158009", "target": "#nkr_note_mod_0158009", "type": "mod", "text": "直【大】，貞【宋】【元】【明】【宮】"}
{"id": null, "n": "0158010", "target": "#nkr_note_mod_0158010", "type": "mod", "text": "慧【大】，惠【宋】【元】【明】【宮】"}
{"id": null, "n": "0159001", "target": "#nkr_note_mod_0159001", "type": "mod", "text": "忘【大】，妄【宋】【元】【明】【宮】"}
{"id": null, "n": "0157020", "target": "#nkr_note_orig_0157020", "type": "orig", "text": "（佛說）＋十【明】"}
