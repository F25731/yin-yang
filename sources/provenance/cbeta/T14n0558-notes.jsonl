{"id": null, "n": "0910007", "target": "#nkr_note_mod_0910007", "type": "mod", "text": "月氏三藏【大】，三藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0910008", "target": "#nkr_note_mod_0910008", "type": "mod", "text": "以【大】＊，已【元】【明】＊"}
{"id": null, "n": "0910009", "target": "#nkr_note_mod_0910009", "type": "mod", "text": "蜚【大】，飛【宋】【元】【明】【宮】"}
{"id": null, "n": "0910010", "target": "#nkr_note_mod_0910010", "type": "mod", "text": "收【大】，抆【宋】【元】【明】【宮】"}
{"id": null, "n": "0910011", "target": "#nkr_note_mod_0910011", "type": "mod", "text": "婬妷【大】，淫泆【宋】【元】【明】【宮】"}
{"id": null, "n": "0910012", "target": "#nkr_note_mod_0910012", "type": "mod", "text": "岐【大】，枝【宋】【元】【明】"}
{"id": null, "n": "0910013", "target": "#nkr_note_mod_0910013", "type": "mod", "text": "上【大】，處【宋】【元】【明】【宮】"}
{"id": null, "n": "0910014", "target": "#nkr_note_mod_0910014", "type": "mod", "text": "惡【大】，害【宋】【元】【明】【宮】"}
{"id": null, "n": "0911001", "target": "#nkr_note_mod_0911001", "type": "mod", "text": "所【大】，〔－〕【元】【明】"}
{"id": null, "n": "0911002", "target": "#nkr_note_mod_0911002", "type": "mod", "text": "端【大】，號【元】【明】"}
{"id": null, "n": "0911003", "target": "#nkr_note_mod_0911003", "type": "mod", "text": "菩提【大】，菩薩【宋】【元】【明】【宮】"}
{"id": null, "n": "0911004", "target": "#nkr_note_mod_0911004", "type": "mod", "text": "虛【大】，如【宮】"}
{"id": null, "n": "0911005", "target": "#nkr_note_mod_0911005", "type": "mod", "text": "怖驚【大】，驚怖【宋】【元】【明】【宮】"}
{"id": null, "n": "0911006", "target": "#nkr_note_mod_0911006", "type": "mod", "text": "前【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0911007", "target": "#nkr_note_mod_0911007", "type": "mod", "text": "所【大】，〔－〕【宋】【元】【明】【宮】"}
