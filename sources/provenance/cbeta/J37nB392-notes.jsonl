{"id": null, "n": null, "target": null, "type": null, "text": "語"}
{"id": null, "n": null, "target": null, "type": null, "text": "轉功就位"}
{"id": null, "n": null, "target": null, "type": null, "text": "轉位就功"}
{"id": null, "n": null, "target": null, "type": null, "text": "功位齊彰"}
{"id": null, "n": null, "target": null, "type": null, "text": "功位俱隱"}
{"id": null, "n": null, "target": null, "type": null, "text": "賓中賓"}
{"id": null, "n": null, "target": null, "type": null, "text": "賓中主"}
{"id": null, "n": null, "target": null, "type": null, "text": "主中賓"}
{"id": null, "n": null, "target": null, "type": null, "text": "主中主"}
{"id": null, "n": null, "target": null, "type": null, "text": "類　隨　尊貴"}
{"id": null, "n": null, "target": null, "type": null, "text": "奪人"}
{"id": null, "n": null, "target": null, "type": null, "text": "奪境"}
{"id": null, "n": null, "target": null, "type": null, "text": "俱奪"}
{"id": null, "n": null, "target": null, "type": null, "text": "俱不奪"}
{"id": null, "n": null, "target": null, "type": null, "text": "先照後用"}
{"id": null, "n": null, "target": null, "type": null, "text": "先用後照"}
{"id": null, "n": null, "target": null, "type": null, "text": "照用同時"}
{"id": null, "n": null, "target": null, "type": null, "text": "照用不同時"}
{"id": null, "n": null, "target": null, "type": null, "text": "金剛寶劍"}
{"id": null, "n": null, "target": null, "type": null, "text": "踞地獅子"}
{"id": null, "n": null, "target": null, "type": null, "text": "探竿影艸"}
{"id": null, "n": null, "target": null, "type": null, "text": "不作喝用"}
{"id": null, "n": null, "target": null, "type": null, "text": "想生"}
{"id": null, "n": null, "target": null, "type": null, "text": "相生"}
{"id": null, "n": null, "target": null, "type": null, "text": "流注生"}
{"id": null, "n": null, "target": null, "type": null, "text": "弟子成睿發心，備資敬刻\n　方丈和尚語錄第十四卷。奉為多生父\n　　　母，神遊淨域悟真常；歷代師承，記\n　　　授一生圓十地。"}
{"id": null, "n": null, "target": null, "type": null, "text": "老人曾有二十年再來善權之語。"}
{"id": null, "n": null, "target": null, "type": null, "text": "弟子德　備資敬刻\n　方丈和尚語錄第十五卷。所願滄溟浪\n　　　裏，同乘般若之舟；功德林中，共結\n　　　菩提之果。"}
{"id": null, "n": null, "target": null, "type": null, "text": "青龍石刻"}
{"id": null, "n": null, "target": null, "type": null, "text": "青龍石刻"}
{"id": null, "n": null, "target": null, "type": null, "text": "青龍石刻"}
{"id": null, "n": null, "target": null, "type": null, "text": "青龍石刻"}
{"id": null, "n": null, "target": null, "type": null, "text": "至囑"}
{"id": null, "n": null, "target": null, "type": null, "text": "附丁未冬來書"}
{"id": null, "n": null, "target": null, "type": null, "text": "癸丑九月十九日"}
{"id": null, "n": null, "target": null, "type": null, "text": "癸丑十月十五日"}
{"id": null, "n": null, "target": null, "type": null, "text": "甲寅九月十九日"}
{"id": null, "n": null, "target": null, "type": null, "text": "乙卯正月初十日"}
{"id": null, "n": null, "target": null, "type": null, "text": "乙卯三月十五日"}
{"id": null, "n": null, "target": null, "type": null, "text": "弟子德　備資敬刻\n　方丈和尚語錄第十六卷。惟冀現前緇\n　　　素，生生悟自性圓明；法界含靈，各\n　　　各獲常光瑩徹。"}
{"id": null, "n": null, "target": null, "type": null, "text": "青龍石刻"}
{"id": null, "n": null, "target": null, "type": null, "text": "龍華常住請"}
{"id": null, "n": null, "target": null, "type": null, "text": "白雲常住請"}
{"id": null, "n": null, "target": null, "type": null, "text": "天瑞麟請"}
{"id": null, "n": null, "target": null, "type": null, "text": "秀也實請"}
{"id": null, "n": null, "target": null, "type": null, "text": "古璞玉請"}
{"id": null, "n": null, "target": null, "type": null, "text": "子了英請"}
{"id": null, "n": null, "target": null, "type": null, "text": "剖塵靜主請"}
{"id": null, "n": null, "target": null, "type": null, "text": "青龍常住請"}
{"id": null, "n": null, "target": null, "type": null, "text": "子青昊西堂請"}
{"id": null, "n": null, "target": null, "type": null, "text": "珂月璨參頭請"}
{"id": null, "n": null, "target": null, "type": null, "text": "慧慈現知載請"}
{"id": null, "n": null, "target": null, "type": null, "text": "古璞玉侍者請　騎虎"}
{"id": null, "n": null, "target": null, "type": null, "text": "善權常住請"}
{"id": null, "n": null, "target": null, "type": null, "text": "存善卷　禮菴"}
{"id": null, "n": null, "target": null, "type": null, "text": "鑄"}
{"id": null, "n": null, "target": null, "type": null, "text": "煉"}
{"id": null, "n": null, "target": null, "type": null, "text": "淬"}
{"id": null, "n": null, "target": null, "type": null, "text": "拭"}
{"id": null, "n": null, "target": null, "type": null, "text": "佩"}
{"id": null, "n": null, "target": null, "type": null, "text": "光"}
{"id": null, "n": null, "target": null, "type": null, "text": "鳴"}
{"id": null, "n": null, "target": null, "type": null, "text": "躍"}
{"id": null, "n": null, "target": null, "type": null, "text": "擲"}
{"id": null, "n": null, "target": null, "type": null, "text": "藏"}
{"id": null, "n": null, "target": null, "type": null, "text": "和宋天封佛慈禪師韻"}
{"id": null, "n": null, "target": null, "type": null, "text": "尋牛"}
{"id": null, "n": null, "target": null, "type": null, "text": "見跡"}
{"id": null, "n": null, "target": null, "type": null, "text": "見牛"}
{"id": null, "n": null, "target": null, "type": null, "text": "得牛"}
{"id": null, "n": null, "target": null, "type": null, "text": "牧牛"}
{"id": null, "n": null, "target": null, "type": null, "text": "騎牛歸家"}
{"id": null, "n": null, "target": null, "type": null, "text": "忘牛存人"}
{"id": null, "n": null, "target": null, "type": null, "text": "人牛雙忘"}
{"id": null, "n": null, "target": null, "type": null, "text": "返本還源"}
{"id": null, "n": null, "target": null, "type": null, "text": "入廛垂手"}
{"id": null, "n": null, "target": null, "type": null, "text": "青龍石刻"}
{"id": null, "n": null, "target": null, "type": null, "text": "原版存吳江今收入全錄卷第十八"}
{"id": null, "n": null, "target": null, "type": null, "text": "號隱翁，百愚老人法嗣，住青龍、善權、白雲、寶嚴、安樂、禮菴、弁山。"}
{"id": null, "n": null, "target": null, "type": null, "text": "即青龍十二景"}
{"id": null, "n": null, "target": null, "type": null, "text": "昔王可交成仙處"}
{"id": null, "n": null, "target": null, "type": null, "text": "昔韓世忠勞軍處"}
{"id": null, "n": null, "target": null, "type": null, "text": "即隆福人詠"}
{"id": null, "n": null, "target": null, "type": null, "text": "寒"}
{"id": null, "n": null, "target": null, "type": null, "text": "時"}
{"id": null, "n": null, "target": null, "type": null, "text": "寒"}
{"id": null, "n": null, "target": null, "type": null, "text": "時"}
{"id": null, "n": null, "target": null, "type": null, "text": "寒"}
{"id": null, "n": null, "target": null, "type": null, "text": "時"}
{"id": null, "n": null, "target": null, "type": null, "text": "有引"}
{"id": null, "n": null, "target": null, "type": null, "text": "鳳庫神薛機，橫天馬崑，是謂九峰"}
{"id": null, "n": null, "target": null, "type": null, "text": "三泖者，大泖、園泖、長泖也，一名谷水"}
{"id": null, "n": null, "target": null, "type": null, "text": "澱山在澱湖之上"}
{"id": null, "n": null, "target": null, "type": null, "text": "海門，橋名。諸海門公獨建，因名"}
{"id": null, "n": null, "target": null, "type": null, "text": "潭在泮宮中，有小洲，今為放生池"}
{"id": null, "n": null, "target": null, "type": null, "text": "聖裔孔禎，隋時宦于吳，葬玉環衣冠，地饒梅竹"}
{"id": null, "n": null, "target": null, "type": null, "text": "邑有三江五浦"}
{"id": null, "n": null, "target": null, "type": null, "text": "王可交飛昇處"}
{"id": null, "n": null, "target": null, "type": null, "text": "橋在北關內，傍有寶月、願豐兩寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "隆福寺在青龍鎮，整麗甲於一邑"}
{"id": null, "n": null, "target": null, "type": null, "text": "英華，茂倫巢名。"}
{"id": null, "n": null, "target": null, "type": null, "text": "乾一同人放生於此"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "原版藏吳江今收入全錄卷第十九"}
{"id": null, "n": null, "target": null, "type": null, "text": "已下俱和韻"}
{"id": null, "n": null, "target": null, "type": null, "text": "顧茂倫曰：「三星閣出自御學，不向家園供嘯傲，深得徐文\n貞晚年心事。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "徐介白曰：「東海風流如見。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "趙之曰：「興致悠然。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "王咸平曰：「自是道人本色語，莫錯會。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "顧茂倫曰：「山月俞先生為方正學門人，保方氏孤。初冒險\n姓，後更為余萬脣。時橋延筠督學南幾，疏請復方姓，山月其讀書齋也。弔古之什，玅在不實寫其事。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "王雙白曰：「大為拒霜花生色。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "殳山夫曰：「即埋甕樹下，摘樹葉書之，滿甕更見他甕，所謂\n輟耕錄處。詩有遠神，使人尋味不到。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "包明成曰：「詠鳳凰而獨舉明月，匪夷所思。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "王咸平曰：「方伯，謂莫公中江也。人品書法，俱能一筆寫出。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "姚文初曰：「壁下有拜石堂，堂去面壁存，讀起一句，想見振\n衣千仞之。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "倪天章曰：「單公如在，呼之欲出。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "葛瑞五曰：「只恐寶惜不住，奈何？」"}
{"id": null, "n": null, "target": null, "type": null, "text": "顧樵水曰：「只舉明月鳳自來遊，此意甚深旨。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "王咸平曰：「感慨。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "金孝章曰：「苦拈漁釣，未免失卻磯字。此為得之。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "殳山夫曰：「鶴為仙人之騏驥，方發得洗鶴意。透士衡河橋\n之歎，正未夢見在。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "顧茂倫曰：「道著多少名人病處、悔恨處，真是度世慈雲。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "周安節曰：「吳時陸氏藏寶處，曰陸寶山。後人爭發其寶，山\n遂夷為平壤。藏寶誰留去後名一語，冷極。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "程石門曰：「老杜哀壑無光留戶庭，不及此起句之深遠。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "顧茂倫曰：「大青、小青，聰道人所留二虎名。客來不訪道人，\n面訪二青，卻似當頭一棒。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "安大己曰：「此之者，道人六月賣松風句，更勝一籌。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "徐嚮芝曰：「別有悟入處。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "丘嶼雪曰：「昔有人上抱犢山，見日出，散髮大叫，宿疑頓盡。\n亦是此意。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "王咸平曰：「晚鐘，晚鐘詩多，午鐘詩少，此作居然獨步。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "陳長發曰：「如身立赤城之巔，與五百應真相往來，無一字\n經人道過。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "張九臨曰：「唐子百山靜似太古，日長如小年，不知誰為第。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "領樵水曰：「曾同山夫、雨七醉臥其處，讀此詩情境俱真，何\n必向羅浮遊也。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "徐禎起曰：「有空山無人，水流花留之致。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "周其凝曰：「他處曉鐘移易不得。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "湯兩七曰：「與前作風格相同。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "濮澹軒曰：「眼界大放淡，令香嚴海性，不止為仙家點綴。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "錢礎日曰：「千偈漏觸，不如一句道破。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "殳山夫曰：「彭素雲，元時人。洪武初，遣中使召之，忽化去。其\n仙跡甚多，于嘗有山中人導觀仙塚長句，頗為同人嗟賞。讀此，自覺形穢矣。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "殳山夫曰：「此元夏義士樁也。碑臥荒艸中，山中陸俟菴欲\n策亭覆之，當鐫此詩子亭中，亦一勝事。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "俞無殊曰：「宵然仙境。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "趙砥之日：「滴紙寒香。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "華漁石曰：「色聲香味俱足。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "包朗威日：「米顛呼石為丈，後人繪圖傳之，此詩亦可畫也。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "王咸平曰：「偏寫得不寂寞。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "黃敘九曰：「水光花色是一是二，會心處正不在遠。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "徐介白曰：「字字飲飛。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "顧茂倫曰：「亭為諸乾一所染。二沈學士翰墨風流，千載如\n新。詩中有圖，分明一幅學士亭圖。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "安大己曰：「便有最陵高臥之思。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "戴耘野曰：「苦節先生，二沈學士之父也。碑為風雨剝蝕，得\n此詩如珠光劍氣，不復可。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "陳長發曰：「林下何曾見一人，曹時中自堪不朽，詩足配之。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "徐禎起曰：「唐人風調。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "周安節曰：「喚醒多少？」"}
{"id": null, "n": null, "target": null, "type": null, "text": "王咸平曰：「只落落寫大意自好，實發赤鹿便俗。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "歸元功曰：「士衡十年閉戶讀書，即此地也。俯仰之間，便成\n今古詩，能引人著勝也。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "陸孝山曰：「以音聲作佛事。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "金孝章曰：「從白鷺入想，幽極異極，通首輕雋，回風舞雪，不\n足喻其萬一。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "程石門曰：「弔古興哀，覽宋沈遼詩尚淺。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "戴耘野曰：「山石固奇，詩亦筆飛墨舞。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "周安節曰：「橫雲山多奇石，見于山夫贈山石序，又復見之\n寒和尚詩。諸篇奇玅，獨此更稱奇絕。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "王咸平曰：「正復不慵。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "倪天章曰：「溫潤中饒有異光熊熊。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "吳海序曰：「一往破的。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "徐介白曰：「列子御風行後，重見此詩。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "沈偶僧曰：「謾謾如松下風。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "李膚公曰：「似謫仙人句。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "顧茂倫曰：「每于無可著想處，得最異之想，大奇大奇！」"}
{"id": null, "n": null, "target": null, "type": null, "text": "孫無言曰：「弔二陸者，多貶刺之辭，此作不失忠厚和平之\n遺。平原兄弟有靈，當復空山夜哭。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "顧茂倫曰：「楊廉夫、錢思復為寓公，陸宅之乃郡人，太守林\n公慶同葬之于山。人奇事奇，三百年後又得此詩。嘻，何多奇也！」"}
{"id": null, "n": null, "target": null, "type": null, "text": "畢西臨曰：「詩思堅挺，如勁艸之受疾風。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "金亦陶曰：「氣格高渾。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "顧樵水曰，「指月拈花，無處無玅悟。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "王雙白曰：「是說劍不是說劍，憑人築著築不著，莫負此老\n婆心。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "李膚公曰：「峰頭笙鶴，儼然未散。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "葛瑞五曰：「千錘萬煉，絕不露半分斧鑿痕。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "王咸平曰：「詩以秀出，以秀入。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "殳山夫曰：「婉孌堂為陳徵君初隱之地，後移居東佘白石。\n起二句正指其實事，更得虛步。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "徐電發曰：「後二句用事化，用意沉。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "陳長發曰：「竹枝詞無此清麗，采蓮歌無此靜遠。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "顧庶其曰：「絕句推青蓮、龍標第一，此作彷彿似之。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "丘興雪曰：「徵君自詠，乃有此神境。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "顧茂倫曰：「陶煉洗剝，如仙人之三反毛，五伐髓，疑有龍伯\n泛濤吹鐵笛至也。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "俞無殊曰：「清老中娟姿躍出。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "趙砥之曰：「玅在無意中說出。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "俞非指曰：「鳳凰山為九峰之冠，此詩亦可以冠九詠。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "顧賓臣曰：「幽興。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "周長康曰：「為子瞻只緣身在此山中句作一喝，宛然如遊\n廬岳矣。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "徐行之曰：「絕去拖泥帶水。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "吳聞瑋曰：「玉屏在九峰中為最高峰，近來種梅萬株，\n吟與詩尤清遠。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "顧英白曰：「如聞琴韻，在古松流水之間。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "陳集生曰：「高人題詠，勝于麗秋時，應有此嘆。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "顧始菴曰：「瀟灑家風。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "趙山子曰：「九峰倡和詩，盈星充棟，推凌山英先生九絕為\n壓卷。今得寒大師九詠，數百年後，重為山靈增色。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "陶九成隱地，有陳仲醇來儀堂。"}
{"id": null, "n": null, "target": null, "type": null, "text": "沈二聞曰：「作是\n題者多矣，高言落落，所謂支通一義，四座莫不厭心者。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "厙公，秦時人。有《亢桑子》三卷，埋于山下。"}
{"id": null, "n": null, "target": null, "type": null, "text": "俞犀月曰：「拔新\n領異，胸懷所及，正自佳。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "陳徵君眉公隱處，丐為東漢佘將軍封地。"}
{"id": null, "n": null, "target": null, "type": null, "text": "馬橋菴曰：「兩山\n煙雨一聯，足為隱君壯士千古生色。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "彭仙翁素雲棲此，有丹井蒲龕，一名細林。"}
{"id": null, "n": null, "target": null, "type": null, "text": "趙又呂曰：「近讀\n玉峰歸子遊細林諸詩，羨其才筆高奇。三復吾師之作，寫情使事，工麗而閒適，留連不能已。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "一名玉屏山，薛道約煉丹處。"}
{"id": null, "n": null, "target": null, "type": null, "text": "許竹隱曰：「春老、\n玉屏二語鍊而淨，直是唐人警句。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "一名大陸山，陸士衡生此。有平原村。"}
{"id": null, "n": null, "target": null, "type": null, "text": "舊名雲山，陸士龍居些。有黃子久宅。"}
{"id": null, "n": null, "target": null, "type": null, "text": "陳白筆曰：「英氣\n逸情，筆端鼓舞而出。二陸風流，庶幾不墜。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "千將鑄劍處，一名千山"}
{"id": null, "n": null, "target": null, "type": null, "text": "沈聲遠曰：「一結\n闊合有情致。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "二陸讀書處，世稱崑岡雙璧。"}
{"id": null, "n": null, "target": null, "type": null, "text": "王吉士曰：「清言\n瀟灑，所謂溈水著地，正復縱橫流漫，使讀者自有名通之目。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "附　著名赤壁，錢公鶴題為第十峰。"}
{"id": null, "n": null, "target": null, "type": null, "text": "沈五玉曰：「山光\n木色，靜氣逸情，披雜詠之，互有映發。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "前見赤壁題廿三峰，開今增山，改曰廿四峰。"}
{"id": null, "n": null, "target": null, "type": null, "text": "周芝士曰：「清詞\n麗句，競秀爭奇，使人飄飄有登勝之想。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "程坦如曰：「通章\n奇絕異絕，人境俱奪，玅在一結。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "原版藏禮菴今收入全錄卷第二十"}
{"id": null, "n": null, "target": null, "type": null, "text": "居徑山特作"}
{"id": null, "n": null, "target": null, "type": null, "text": "剩一子出家"}
{"id": null, "n": null, "target": null, "type": null, "text": "三絕"}
{"id": null, "n": null, "target": null, "type": null, "text": "菴為師所築，退居守百老人塔"}
{"id": null, "n": null, "target": null, "type": null, "text": "梁武帝祈雨處"}
{"id": null, "n": null, "target": null, "type": null, "text": "即百老人窣堵坡"}
{"id": null, "n": null, "target": null, "type": null, "text": "寶嚴出名，即雲際寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "山形如蓮，前臨溪水"}
{"id": null, "n": null, "target": null, "type": null, "text": "即蓮心，師塔建此"}
{"id": null, "n": null, "target": null, "type": null, "text": "崇禎癸未，薙髮桐城地藏關，七日即遍參。康熙癸亥，過此感賦。"}
{"id": null, "n": null, "target": null, "type": null, "text": "母氏夢僧借寓，產時聞香。"}
{"id": null, "n": null, "target": null, "type": null, "text": "甲戌民變，家君救方氏數十人，報千金不受，咸以義士稱之。"}
{"id": null, "n": null, "target": null, "type": null, "text": "明季寇亂，父傷母溺，遍覓無音，代酬夙志。"}
{"id": null, "n": null, "target": null, "type": null, "text": "晉謁廿餘知識，末後脫穎弁山記莂，時年已廿七矣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "即香爐寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "寺名"}
{"id": null, "n": null, "target": null, "type": null, "text": "尋師塔址，數卜名山，吉壞難求，仍遵遺命。"}
{"id": null, "n": null, "target": null, "type": null, "text": "寺占塔荒，不遑居處，暫赴兩山為權守之計。"}
{"id": null, "n": null, "target": null, "type": null, "text": "廬名"}
{"id": null, "n": null, "target": null, "type": null, "text": "時憶再來之識，築室獨居，頻辭外請。"}
{"id": null, "n": null, "target": null, "type": null, "text": "塔事告竣，命僧代守，歸憩白雲。"}
{"id": null, "n": null, "target": null, "type": null, "text": "《傳燈》載：祖塔三峰巷後，明人依葬，片石僅存，瞻禮感賦。"}
{"id": null, "n": null, "target": null, "type": null, "text": "得南無十二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
