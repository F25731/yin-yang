{"id": null, "n": "0177028", "target": "#nkr_note_mod_0177028", "type": "mod", "text": "半【大】，峯【乙】"}
{"id": null, "n": "0177029", "target": "#nkr_note_mod_0177029", "type": "mod", "text": "池【大】，地【甲】"}
{"id": null, "n": "0178001", "target": "#nkr_note_mod_0178001", "type": "mod", "text": "嘗【大】，當【甲】【乙】"}
{"id": null, "n": "0178002", "target": "#nkr_note_mod_0178002", "type": "mod", "text": "窟【大】，室【甲】【乙】"}
