{"id": null, "n": "0178004", "target": "#nkr_note_mod_0178004", "type": "mod", "text": "撰【大】，擇【校異-甲】"}
{"id": null, "n": "0178005", "target": "#nkr_note_mod_0178005", "type": "mod", "text": "明【大】，〔－〕【乙】"}
{"id": null, "n": "0178006", "target": "#nkr_note_mod_0178006", "type": "mod", "text": "言【大】，言真言【乙】"}
