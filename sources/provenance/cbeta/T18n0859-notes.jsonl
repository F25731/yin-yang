{"id": null, "n": "0178031", "target": "#nkr_note_mod_0178031", "type": "mod", "text": "履【大】，𭌆【甲】"}
{"id": null, "n": "0178032", "target": "#nkr_note_mod_0178032", "type": "mod", "text": "三【大】，五【甲】"}
{"id": null, "n": "0178033", "target": "#nkr_note_mod_0178033", "type": "mod", "text": "當【大】，此當【甲】【乙】"}
