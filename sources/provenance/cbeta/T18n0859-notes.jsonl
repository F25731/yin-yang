{"id": null, "n": "0178027", "target": "#nkr_note_mod_0178027", "type": "mod", "text": "上【大】，下【甲】"}
{"id": null, "n": "0178028", "target": "#nkr_note_mod_0178028", "type": "mod", "text": "耶【大】，耶相【甲】【乙】"}
