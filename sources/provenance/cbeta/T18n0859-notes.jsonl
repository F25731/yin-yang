{"id": null, "n": "0178014", "target": "#nkr_note_mod_0178014", "type": "mod", "text": "旋【大】，施【乙】"}
{"id": null, "n": "0178015", "target": "#nkr_note_mod_0178015", "type": "mod", "text": "諸【大】，謂【乙】"}
{"id": null, "n": "0178016", "target": "#nkr_note_mod_0178016", "type": "mod", "text": "揣【大】，擩【甲】【乙】"}
{"id": null, "n": "0178017", "target": "#nkr_note_mod_0178017", "type": "mod", "text": "南麼三曼多勃馱喃【大】＊，歸命【甲】＊，〔南麼…遍〕十三字－【乙】"}
{"id": null, "n": "0178018", "target": "#nkr_note_mod_0178018", "type": "mod", "text": "世【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0178019", "target": "#nkr_note_mod_0178019", "type": "mod", "text": "風【大】，風轉【甲】【乙】"}
{"id": null, "n": "0178021", "target": "#nkr_note_mod_0178021", "type": "mod", "text": "若【大】，者【乙】"}
{"id": null, "n": "0178022", "target": "#nkr_note_mod_0178022", "type": "mod", "text": "東【大】，東西【甲】【乙】"}
