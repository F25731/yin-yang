{"id": null, "n": "0310001", "target": "#nkr_note_orig_0310001", "type": "orig", "text": "「觀」，碑刻漫漶，依稀可辨。"}
{"id": null, "n": "0310002", "target": "#nkr_note_orig_0310002", "type": "orig", "text": "「切」，碑刻漫漶，依稀可辨。"}
{"id": null, "n": "0311001", "target": "#nkr_note_orig_0311001", "type": "orig", "text": "「此」，碑刻漫漶，依稀可辨。"}
{"id": null, "n": "0311002", "target": "#nkr_note_orig_0311002", "type": "orig", "text": "「彼國」，碑刻漫漶，依稀可辨。"}
{"id": null, "n": "0311003", "target": "#nkr_note_orig_0311003", "type": "orig", "text": "「觀音」，碑刻漫漶，依稀可辨。"}
{"id": null, "n": "0311004", "target": "#nkr_note_orig_0311004", "type": "orig", "text": "「世……執」五字，碑刻漫漶，依稀可辨。"}
{"id": null, "n": "0312001", "target": "#nkr_note_orig_0312001", "type": "orig", "text": "「一念」，原文作「念一」，據文意改。"}
{"id": null, "n": "0312002", "target": "#nkr_note_orig_0312002", "type": "orig", "text": "「極樂世」，今泐滅，據五十年代記錄補。"}
{"id": null, "n": "0312003", "target": "#nkr_note_orig_0312003", "type": "orig", "text": "「大藏佛言，上品下生」，漫漶難辨，據文意及本文體例補。"}
{"id": null, "n": "0319001", "target": "#nkr_note_orig_0319001", "type": "orig", "text": "「議」，原文殘，據上下文意補。"}
{"id": null, "n": "0319002", "target": "#nkr_note_orig_0319002", "type": "orig", "text": "「茫」，原文作「忙」，據文意改。"}
