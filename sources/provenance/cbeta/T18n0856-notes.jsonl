{"id": null, "n": "0174006", "target": "#nkr_note_mod_0174006", "type": "mod", "text": "（開府…譯）四十六字【大】，唐北天竺三藏沙門大廣智不空奉詔譯【明】【甲】【乙】"}
{"id": null, "n": "0174007", "target": "#nkr_note_mod_0174007", "type": "mod", "text": "俱密【CB】【麗-CB】，俱蜜【大】，密俱【明】【甲】"}
{"id": null, "n": "0174008", "target": "#nkr_note_mod_0174008", "type": "mod", "text": "唵引【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0174009", "target": "#nkr_note_mod_0174009", "type": "mod", "text": "引【大】，引二【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": "0174010", "target": "#nkr_note_mod_0174010", "type": "mod", "text": "二【大】，〔－〕【明】"}
{"id": null, "n": "0174011", "target": "#nkr_note_mod_0174011", "type": "mod", "text": "二【大】，一【明】"}
{"id": null, "n": "0174012", "target": "#nkr_note_mod_0174012", "type": "mod", "text": "四【大】，〔－〕【明】"}
{"id": null, "n": "0174013", "target": "#nkr_note_mod_0174013", "type": "mod", "text": "賀引【大】，訶【明】"}
{"id": null, "n": "0174014", "target": "#nkr_note_mod_0174014", "type": "mod", "text": "齊【大】，臍【明】"}
{"id": null, "n": "0174015", "target": "#nkr_note_mod_0174015", "type": "mod", "text": "幖【大】，標【明】【甲】【乙】"}
{"id": null, "n": "0174016", "target": "#nkr_note_mod_0174016", "type": "mod", "text": "磨【大】，麼【明】【甲】【乙】"}
{"id": null, "n": "0174017", "target": "#nkr_note_mod_0174017", "type": "mod", "text": "聲【大】，聲引【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0174018", "target": "#nkr_note_mod_0174018", "type": "mod", "text": "引【大】＊，〔－〕【明】＊"}
{"id": null, "n": "0174019", "target": "#nkr_note_mod_0174019", "type": "mod", "text": "暏【大】，覩【明】【甲】【乙】"}
{"id": null, "n": "0175001", "target": "#nkr_note_mod_0175001", "type": "mod", "text": "憾【大】，憾二【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": "0175002", "target": "#nkr_note_mod_0175002", "type": "mod", "text": "親【大】，覩【明】"}
{"id": null, "n": "0175003", "target": "#nkr_note_mod_0175003", "type": "mod", "text": "聖【大】，尊【甲】【乙】"}
{"id": null, "n": "0175004", "target": "#nkr_note_mod_0175004", "type": "mod", "text": "嚧【大】，噓【明】"}
{"id": null, "n": "0175005", "target": "#nkr_note_mod_0175005", "type": "mod", "text": "音【大】，音引二【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引二"}
{"id": null, "n": "0175006", "target": "#nkr_note_mod_0175006", "type": "mod", "text": "耶【大】，耶三【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": "0175007", "target": "#nkr_note_mod_0175007", "type": "mod", "text": "呼【大】，四【明】"}
{"id": null, "n": "0175008", "target": "#nkr_note_mod_0175008", "type": "mod", "text": "引【大】＊，引五【明】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "五"}
{"id": null, "n": "0175009", "target": "#nkr_note_mod_0175009", "type": "mod", "text": "加【大】，如【明】"}
{"id": null, "n": "0175010", "target": "#nkr_note_mod_0175010", "type": "mod", "text": "引【大】，引一【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": "0175011", "target": "#nkr_note_mod_0175011", "type": "mod", "text": "惡引【大】，阿去急呼【甲】【乙】"}
{"id": null, "n": "0175012", "target": "#nkr_note_mod_0175012", "type": "mod", "text": "引【大】，引二【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": "0175013", "target": "#nkr_note_mod_0175013", "type": "mod", "text": "反【大】，切【明】"}
{"id": null, "n": "0175014", "target": "#nkr_note_mod_0175014", "type": "mod", "text": "帝【大】，帝三【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": "0175015", "target": "#nkr_note_mod_0175015", "type": "mod", "text": "黨【大】，哆【明】"}
{"id": null, "n": "0175016", "target": "#nkr_note_mod_0175016", "type": "mod", "text": "捨【大】，舍【明】【甲】【乙】"}
{"id": null, "n": "0175017", "target": "#nkr_note_mod_0175017", "type": "mod", "text": "竪【大】，堅【甲】【乙】"}
{"id": null, "n": "0175018", "target": "#nkr_note_mod_0175018", "type": "mod", "text": "現【大】，視【甲】【乙】"}
{"id": null, "n": "0175019", "target": "#nkr_note_mod_0175019", "type": "mod", "text": "日【大】，已【明】【甲】【乙】"}
{"id": null, "n": "0175020", "target": "#nkr_note_mod_0175020", "type": "mod", "text": "（娜莫…喃引）十一字【大】，曩莫薩嚩怛他蘖帝驃尾濕嚩目契弊【甲】【乙】"}
{"id": null, "n": "0175021", "target": "#nkr_note_mod_0175021", "type": "mod", "text": "去【大】，去聲【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "聲"}
{"id": null, "n": "0175022", "target": "#nkr_note_mod_0175022", "type": "mod", "text": "引【大】＊，引一【明】＊"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": "0175023", "target": "#nkr_note_mod_0175023", "type": "mod", "text": "合【大】，合引三【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引三"}
{"id": null, "n": "0175024", "target": "#nkr_note_mod_0175024", "type": "mod", "text": "聲【大】，馨【明】"}
{"id": null, "n": "0175025", "target": "#nkr_note_mod_0175025", "type": "mod", "text": "引【大】，引四【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "四"}
{"id": null, "n": "0175026", "target": "#nkr_note_mod_0175026", "type": "mod", "text": "娑【大】，莎【甲】【乙】"}
{"id": null, "n": "0175027", "target": "#nkr_note_mod_0175027", "type": "mod", "text": "賀【大】，賀引五【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引五"}
{"id": null, "n": "0175028", "target": "#nkr_note_mod_0175028", "type": "mod", "text": "即【大】，既【甲】【乙】"}
{"id": null, "n": "0175029", "target": "#nkr_note_mod_0175029", "type": "mod", "text": "引【大】，引二【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": "0175030", "target": "#nkr_note_mod_0175030", "type": "mod", "text": "本【大】，布【甲】"}
{"id": null, "n": "0175031", "target": "#nkr_note_mod_0175031", "type": "mod", "text": "支【大】，肢【明】"}
{"id": null, "n": "0175032", "target": "#nkr_note_mod_0175032", "type": "mod", "text": "跏【大】，加【明】"}
{"id": null, "n": "0175033", "target": "#nkr_note_mod_0175033", "type": "mod", "text": "色【大】，貌【明】【甲】【乙】"}
{"id": null, "n": "0175034", "target": "#nkr_note_mod_0175034", "type": "mod", "text": "念持【大】，持念【明】"}
{"id": null, "n": "0175035", "target": "#nkr_note_mod_0175035", "type": "mod", "text": "聖【大】，世【明】【甲】【乙】"}
{"id": null, "n": "0175036", "target": "#nkr_note_mod_0175036", "type": "mod", "text": "力【大】，刀【甲】【乙】"}
{"id": null, "n": "0175037", "target": "#nkr_note_mod_0175037", "type": "mod", "text": "飾【大】，拭【明】【甲】【乙】"}
{"id": null, "n": "0176001", "target": "#nkr_note_mod_0176001", "type": "mod", "text": "伽【大】，祇【明】【甲】【乙】"}
{"id": null, "n": "0176002", "target": "#nkr_note_mod_0176002", "type": "mod", "text": "那【大】，那成佛神變加持【明】【甲】【乙】"}
{"id": null, "n": "0176003", "target": "#nkr_note_mod_0176003", "type": "mod", "text": "儀軌法一卷【大】，隨行法經【明】【甲】【乙】"}
{"id": null, "n": "0174005", "target": "#nkr_note_orig_0174005", "type": "orig", "text": "【原】麗本，【甲】黃檗板淨嚴等校訂加筆本塚本賢曉氏藏，【乙】縮冊大藏經"}
{"id": null, "n": "0174006", "target": "#nkr_note_orig_0174006", "type": "orig", "text": "（（開府…譯））四十六字＝（（唐北天竺三藏沙門大廣智不空奉詔譯））十六字【明】【甲】【乙】"}
{"id": null, "n": "0174007", "target": "#nkr_note_orig_0174007", "type": "orig", "text": "俱蜜＝密俱【明】【甲】"}
{"id": null, "n": "0174008", "target": "#nkr_note_orig_0174008", "type": "orig", "text": "〔唵引〕－【甲】【乙】"}
{"id": null, "n": "0174009", "target": "#nkr_note_orig_0174009", "type": "orig", "text": "引＋（二）細註【明】"}
{"id": null, "n": "0174010", "target": "#nkr_note_orig_0174010", "type": "orig", "text": "〔二〕－【明】"}
{"id": null, "n": "0174011", "target": "#nkr_note_orig_0174011", "type": "orig", "text": "二＝一【明】"}
