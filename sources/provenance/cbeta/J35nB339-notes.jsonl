{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "師注：真妄同源，形名未垂"}
{"id": null, "n": null, "target": null, "type": null, "text": "師注：塵塵\n有路，不滯偏方"}
{"id": null, "n": null, "target": null, "type": null, "text": "師注：蕩盡諸緣，炤體獨立"}
{"id": null, "n": null, "target": null, "type": null, "text": "師注：卷舒絕待，炤用齊行"}
{"id": null, "n": null, "target": null, "type": null, "text": "師注：正位方彰，大功無問"}
{"id": null, "n": null, "target": null, "type": null, "text": "師注：混然忘跡，凡聖迥超"}
{"id": null, "n": null, "target": null, "type": null, "text": "師注：自古自今，可憑可據"}
{"id": null, "n": null, "target": null, "type": null, "text": "師注：逼塞虛空，古今無間"}
{"id": null, "n": null, "target": null, "type": null, "text": "師注：同風敲唱，識者還稀"}
{"id": null, "n": null, "target": null, "type": null, "text": "師注：玅應臨時，全忘啐啄"}
{"id": null, "n": null, "target": null, "type": null, "text": "師注：縱擒錯互，不落尋嘗"}
{"id": null, "n": null, "target": null, "type": null, "text": "師注：換象\n抽爻，突出難辨"}
{"id": null, "n": null, "target": null, "type": null, "text": "師注：鋒輪並運，殺活齊施"}
{"id": null, "n": null, "target": null, "type": null, "text": "師注：殊道同歸，不資餘力"}
{"id": null, "n": null, "target": null, "type": null, "text": "師注：化機絕朕，尊貴無方"}
{"id": null, "n": null, "target": null, "type": null, "text": "師注：從前汗馬無人識，秖要重論蓋代功"}
{"id": null, "n": null, "target": null, "type": null, "text": "師注并敘"}
{"id": null, "n": null, "target": null, "type": null, "text": "師云：塞卻鼻孔"}
{"id": null, "n": null, "target": null, "type": null, "text": "師云：拄卻舌頭"}
{"id": null, "n": null, "target": null, "type": null, "text": "師云：突出難辨"}
{"id": null, "n": null, "target": null, "type": null, "text": "師云：豈涉繁詞"}
{"id": null, "n": null, "target": null, "type": null, "text": "師云：知音者誰"}
{"id": null, "n": null, "target": null, "type": null, "text": "師云：動還翳目"}
{"id": null, "n": null, "target": null, "type": null, "text": "師云：個中無路"}
{"id": null, "n": null, "target": null, "type": null, "text": "師云：孰辨奴郎"}
{"id": null, "n": null, "target": null, "type": null, "text": "師云：此意須明"}
{"id": null, "n": null, "target": null, "type": null, "text": "師云：幾成獨立"}
{"id": null, "n": null, "target": null, "type": null, "text": "師云：不妨奇特"}
{"id": null, "n": null, "target": null, "type": null, "text": "師云：可知禮也"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "靈雲"}
{"id": null, "n": null, "target": null, "type": null, "text": "香巖"}
{"id": null, "n": null, "target": null, "type": null, "text": "牛頭"}
{"id": null, "n": null, "target": null, "type": null, "text": "船子"}
{"id": null, "n": null, "target": null, "type": null, "text": "趙州"}
{"id": null, "n": null, "target": null, "type": null, "text": "文殊"}
{"id": null, "n": null, "target": null, "type": null, "text": "玄沙"}
{"id": null, "n": null, "target": null, "type": null, "text": "善財"}
{"id": null, "n": null, "target": null, "type": null, "text": "石鞏"}
{"id": null, "n": null, "target": null, "type": null, "text": "普門"}
{"id": null, "n": null, "target": null, "type": null, "text": "和宋慈受深禪師原韻"}
{"id": null, "n": null, "target": null, "type": null, "text": "和宋天封佛慈禪師原韻"}
{"id": null, "n": null, "target": null, "type": null, "text": "和靈嵒僧首師原韻"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "來偈附"}
{"id": null, "n": null, "target": null, "type": null, "text": "師著語云：有些子"}
{"id": null, "n": null, "target": null, "type": null, "text": "甚處\n得這消息來"}
{"id": null, "n": null, "target": null, "type": null, "text": "莫辨來蹤"}
{"id": null, "n": null, "target": null, "type": null, "text": "更事多矣"}
{"id": null, "n": null, "target": null, "type": null, "text": "天下人無出氣分"}
{"id": null, "n": null, "target": null, "type": null, "text": "費力不少"}
{"id": null, "n": null, "target": null, "type": null, "text": "賺殺旁觀"}
{"id": null, "n": null, "target": null, "type": null, "text": "古今扶不起"}
{"id": null, "n": null, "target": null, "type": null, "text": "道什麼"}
{"id": null, "n": null, "target": null, "type": null, "text": "枉喫許多粥飯"}
{"id": null, "n": null, "target": null, "type": null, "text": "別有長處，何妨拈出"}
{"id": null, "n": null, "target": null, "type": null, "text": "惜取口喫飯"}
{"id": null, "n": null, "target": null, "type": null, "text": "只恐跳不出"}
{"id": null, "n": null, "target": null, "type": null, "text": "果然"}
{"id": null, "n": null, "target": null, "type": null, "text": "苦屈之辭，不妨難吐"}
{"id": null, "n": null, "target": null, "type": null, "text": "可知也"}
{"id": null, "n": null, "target": null, "type": null, "text": "少者由他少，老者出他老"}
{"id": null, "n": null, "target": null, "type": null, "text": "素非鴨類"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿誰下手"}
{"id": null, "n": null, "target": null, "type": null, "text": "居士\n用心良苦"}
{"id": null, "n": null, "target": null, "type": null, "text": "三十年後有人舉在"}
{"id": null, "n": null, "target": null, "type": null, "text": "舊與師同參"}
{"id": null, "n": null, "target": null, "type": null, "text": "士善岐黃"}
{"id": null, "n": null, "target": null, "type": null, "text": "臨江仙"}
{"id": null, "n": null, "target": null, "type": null, "text": "生苦"}
{"id": null, "n": null, "target": null, "type": null, "text": "老苦"}
{"id": null, "n": null, "target": null, "type": null, "text": "病苦"}
{"id": null, "n": null, "target": null, "type": null, "text": "死苦"}
{"id": null, "n": null, "target": null, "type": null, "text": "鉛山有石並立，其狀如人偶語，故云。"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
