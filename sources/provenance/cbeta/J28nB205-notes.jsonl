{"id": null, "n": null, "target": null, "type": null, "text": "附掛鐘板　齋單"}
{"id": null, "n": null, "target": null, "type": null, "text": "是日上堂時忽大雪"}
{"id": null, "n": null, "target": null, "type": null, "text": "謝詞不錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "忽雨復晴"}
{"id": null, "n": null, "target": null, "type": null, "text": "是日直雨"}
{"id": null, "n": null, "target": null, "type": null, "text": "是日大雨"}
{"id": null, "n": null, "target": null, "type": null, "text": "附"}
{"id": null, "n": null, "target": null, "type": null, "text": "附"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "時陞座漸有微雨"}
{"id": null, "n": null, "target": null, "type": null, "text": "是把"}
{"id": null, "n": null, "target": null, "type": null, "text": "舊號道覺"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "即如如菴"}
{"id": null, "n": null, "target": null, "type": null, "text": "師見燈花爆悟道，居五臺，後笑祖以笠覆為記云。"}
{"id": null, "n": null, "target": null, "type": null, "text": "號物如天童蜜祖披剃"}
{"id": null, "n": null, "target": null, "type": null, "text": "習蓮宗"}
{"id": null, "n": null, "target": null, "type": null, "text": "時圓寂天童"}
{"id": null, "n": null, "target": null, "type": null, "text": "號祥光"}
{"id": null, "n": null, "target": null, "type": null, "text": "有石勒梅子熟也四字，匾曰正目堂"}
{"id": null, "n": null, "target": null, "type": null, "text": "菴在水中，有白蓮衛護"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱世泰"}
{"id": null, "n": null, "target": null, "type": null, "text": "又"}
{"id": null, "n": null, "target": null, "type": null, "text": "呸"}
{"id": null, "n": null, "target": null, "type": null, "text": "號清源"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱本榮"}
{"id": null, "n": null, "target": null, "type": null, "text": "即龍\n池佛殿前"}
{"id": null, "n": null, "target": null, "type": null, "text": "即天童寺山名"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱有譽"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱貞默"}
{"id": null, "n": null, "target": null, "type": null, "text": "戊子望日於禹門曼殊室中為斷疑公作"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "荊璧記室請"}
{"id": null, "n": null, "target": null, "type": null, "text": "劉進柱居士請"}
{"id": null, "n": null, "target": null, "type": null, "text": "宮妝"}
{"id": null, "n": null, "target": null, "type": null, "text": "有引"}
{"id": null, "n": null, "target": null, "type": null, "text": "有引"}
{"id": null, "n": null, "target": null, "type": null, "text": "有周倉持刀倚背"}
{"id": null, "n": null, "target": null, "type": null, "text": "畫有松枝上懸一葫蘆"}
{"id": null, "n": null, "target": null, "type": null, "text": "師缺一門牙"}
{"id": null, "n": null, "target": null, "type": null, "text": "侍祖堂燈火"}
{"id": null, "n": null, "target": null, "type": null, "text": "孫三摩請"}
{"id": null, "n": null, "target": null, "type": null, "text": "弟紋菴求"}
{"id": null, "n": null, "target": null, "type": null, "text": "像坐石頭上"}
{"id": null, "n": null, "target": null, "type": null, "text": "即京蟄前一日，師徒同寂，\n湛云：「吾欲先去。」尚含笑，冰已去。"}
{"id": null, "n": null, "target": null, "type": null, "text": "辰值至節後一日"}
{"id": null, "n": null, "target": null, "type": null, "text": "字石麒"}
{"id": null, "n": null, "target": null, "type": null, "text": "寺建自梁有六景記焉"}
{"id": null, "n": null, "target": null, "type": null, "text": "并引"}
{"id": null, "n": null, "target": null, "type": null, "text": "在大冶縣西南四十里"}
{"id": null, "n": null, "target": null, "type": null, "text": "田"}
{"id": null, "n": null, "target": null, "type": null, "text": "哲"}
{"id": null, "n": null, "target": null, "type": null, "text": "師"}
{"id": null, "n": null, "target": null, "type": null, "text": "田"}
{"id": null, "n": null, "target": null, "type": null, "text": "師有青獅翁別號"}
{"id": null, "n": null, "target": null, "type": null, "text": "師未辭世，預作偈，有鵝毛雪兒滿空飛之句。"}
{"id": null, "n": null, "target": null, "type": null, "text": "并引"}
{"id": null, "n": null, "target": null, "type": null, "text": "做墳之家俱寥落"}
{"id": null, "n": null, "target": null, "type": null, "text": "昔始皇命李斯篆碑立此"}
{"id": null, "n": null, "target": null, "type": null, "text": "別號傘居"}
{"id": null, "n": null, "target": null, "type": null, "text": "別號響忍"}
{"id": null, "n": null, "target": null, "type": null, "text": "楚人"}
{"id": null, "n": null, "target": null, "type": null, "text": "堪字不在韻"}
{"id": null, "n": null, "target": null, "type": null, "text": "有推蓬室尚在"}
{"id": null, "n": null, "target": null, "type": null, "text": "即薛崖孟諱宷"}
{"id": null, "n": null, "target": null, "type": null, "text": "內有千佛嶺、昭明太子塔、珍珠泉、玉沙泉、雙澗、主峰，即攝山。"}
{"id": null, "n": null, "target": null, "type": null, "text": "時來將燈上"}
{"id": null, "n": null, "target": null, "type": null, "text": "并引"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃額名也"}
{"id": null, "n": null, "target": null, "type": null, "text": "號龍吟，即徒孫也"}
{"id": null, "n": null, "target": null, "type": null, "text": "是日雨下"}
{"id": null, "n": null, "target": null, "type": null, "text": "有二鵲抱松枝，開口相向"}
{"id": null, "n": null, "target": null, "type": null, "text": "是歲元旦，在北\n有異夢焉"}
{"id": null, "n": null, "target": null, "type": null, "text": "附原韻"}
{"id": null, "n": null, "target": null, "type": null, "text": "有祖道松十三株記\n\n碑。"}
{"id": null, "n": null, "target": null, "type": null, "text": "雷抽心木為梁"}
{"id": null, "n": null, "target": null, "type": null, "text": "源師三賜帝號，五住大剎，仍退此終焉。"}
{"id": null, "n": null, "target": null, "type": null, "text": "并引"}
{"id": null, "n": null, "target": null, "type": null, "text": "山名"}
{"id": null, "n": null, "target": null, "type": null, "text": "即祝氏墓也，故云祝陵埠"}
{"id": null, "n": null, "target": null, "type": null, "text": "建自孫權時"}
{"id": null, "n": null, "target": null, "type": null, "text": "有雷書偃柏之蹟尚在。"}
{"id": null, "n": null, "target": null, "type": null, "text": "諱瑞，出山日於夜忽驟雨"}
{"id": null, "n": null, "target": null, "type": null, "text": "敬亭昔黃檗客寓，裴相國見壁上畫聖僧真引，問師云云，即此。"}
{"id": null, "n": null, "target": null, "type": null, "text": "乾巽向"}
{"id": null, "n": null, "target": null, "type": null, "text": "有雙雀一啼一宿"}
{"id": null, "n": null, "target": null, "type": null, "text": "上有三十六洞"}
{"id": null, "n": null, "target": null, "type": null, "text": "有引"}
{"id": null, "n": null, "target": null, "type": null, "text": "嵋山有放光石"}
{"id": null, "n": null, "target": null, "type": null, "text": "方山乃金陵幹龍也"}
{"id": null, "n": null, "target": null, "type": null, "text": "有引"}
{"id": null, "n": null, "target": null, "type": null, "text": "與予同庚"}
{"id": null, "n": null, "target": null, "type": null, "text": "古柏二株名龍虎"}
{"id": null, "n": null, "target": null, "type": null, "text": "又名鳳皇橋，系宛陵通要"}
{"id": null, "n": null, "target": null, "type": null, "text": "并引"}
{"id": null, "n": null, "target": null, "type": null, "text": "菴東向"}
{"id": null, "n": null, "target": null, "type": null, "text": "有引"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "公嗣法古南，向居越州，恢復寶掌別業。適歸南麻明慶寺，有楚行之\n意，而靈松首座者，系公法胤，因省敬，故作此寄以為贈。"}
{"id": null, "n": null, "target": null, "type": null, "text": "同門有三十三人"}
{"id": null, "n": null, "target": null, "type": null, "text": "公五男一女，二三子在庠"}
{"id": null, "n": null, "target": null, "type": null, "text": "虞山頂玄帝宮前有河，一似龜，五似鶴飛朝，故有龜去鶴來之景云"}
{"id": null, "n": null, "target": null, "type": null, "text": "有九株剔牙松，甚奇"}
{"id": null, "n": null, "target": null, "type": null, "text": "恰安定知客請"}
{"id": null, "n": null, "target": null, "type": null, "text": "靈岩亦名象山，形勢儼然，故鼻峰建亭，曰「落紅」"}
{"id": null, "n": null, "target": null, "type": null, "text": "子振寰請"}
{"id": null, "n": null, "target": null, "type": null, "text": "卻迷知藏請"}
{"id": null, "n": null, "target": null, "type": null, "text": "抱真請"}
{"id": null, "n": null, "target": null, "type": null, "text": "寺居臥龍街西首，百花洲之東"}
{"id": null, "n": null, "target": null, "type": null, "text": "并引"}
{"id": null, "n": null, "target": null, "type": null, "text": "即舜山全居士"}
{"id": null, "n": null, "target": null, "type": null, "text": "永濟融長老請"}
{"id": null, "n": null, "target": null, "type": null, "text": "覺幻監院請"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "J39nB445_p0350a03"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "J33nB280_p0296c15"}
