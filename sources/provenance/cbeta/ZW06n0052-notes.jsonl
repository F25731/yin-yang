{"id": null, "n": "0228001", "target": "#nkr_note_orig_0228001", "type": "orig", "text": "「策」，底本作「榮」，據文意改。"}
{"id": null, "n": "0228002", "target": "#nkr_note_orig_0228002", "type": "orig", "text": "「毋」，底本作「母」，據文意改。"}
{"id": null, "n": "0229001", "target": "#nkr_note_orig_0229001", "type": "orig", "text": "「法」，底本作「海」，據本科儀《提綱》改。"}
{"id": null, "n": "0229002", "target": "#nkr_note_orig_0229002", "type": "orig", "text": "「神通」，底本無，據實叉難陀譯《地藏菩薩本願經》卷上補。"}
{"id": null, "n": "0229003", "target": "#nkr_note_orig_0229003", "type": "orig", "text": "「身」，底本作「為」，據實叉難陀譯《地藏菩薩本願經》卷上改。"}
{"id": null, "n": "0229004", "target": "#nkr_note_orig_0229004", "type": "orig", "text": "「感」，底本作「惑」，據文意改。"}
{"id": null, "n": "0230001", "target": "#nkr_note_orig_0230001", "type": "orig", "text": "「生」，底本作「子」，據本科儀《提綱》改。"}
{"id": null, "n": "0230002", "target": "#nkr_note_orig_0230002", "type": "orig", "text": "「證」，底本作「登」，據文意改。"}
{"id": null, "n": "0230003", "target": "#nkr_note_orig_0230003", "type": "orig", "text": "「勝」，本科儀《提綱》作「法」。"}
{"id": null, "n": "0231001", "target": "#nkr_note_orig_0231001", "type": "orig", "text": "「密語」，本科儀《提綱》作「秘密」。"}
{"id": null, "n": "0231002", "target": "#nkr_note_orig_0231002", "type": "orig", "text": "「一念迷真失本宗」，甲本作「一念纔興失本蹤」。"}
{"id": null, "n": "0232001", "target": "#nkr_note_orig_0232001", "type": "orig", "text": "「障雲無點翳」，甲本作「漫天雲霧捲」。「翳」字底本作「移」，據文意改。"}
{"id": null, "n": "0232002", "target": "#nkr_note_orig_0232002", "type": "orig", "text": "「常」，甲本作「當」。"}
{"id": null, "n": "0232003", "target": "#nkr_note_orig_0232003", "type": "orig", "text": "「文儀」，底本作「儀文」，據文意改。"}
{"id": null, "n": "0233001", "target": "#nkr_note_orig_0233001", "type": "orig", "text": "「恁」，甲本作「任」。"}
{"id": null, "n": "0235001", "target": "#nkr_note_orig_0235001", "type": "orig", "text": "「真如實際」，甲本作「真空佛寶」。"}
{"id": null, "n": "0235002", "target": "#nkr_note_orig_0235002", "type": "orig", "text": "「下」，底本作「不」，據甲本改。"}
{"id": null, "n": "0235003", "target": "#nkr_note_orig_0235003", "type": "orig", "text": "「宣」，甲本作「敷」。"}
{"id": null, "n": "0235004", "target": "#nkr_note_orig_0235004", "type": "orig", "text": "「聲聞」，甲本作「真空」。"}
{"id": null, "n": "0235005", "target": "#nkr_note_orig_0235005", "type": "orig", "text": "「長」，甲本作「場」。"}
{"id": null, "n": "0236001", "target": "#nkr_note_orig_0236001", "type": "orig", "text": "「皈」，甲本作「歸」。下同。"}
{"id": null, "n": "0237001", "target": "#nkr_note_orig_0237001", "type": "orig", "text": "「規」，甲本作「龜」。"}
{"id": null, "n": "0237002", "target": "#nkr_note_orig_0237002", "type": "orig", "text": "「元照為提綱」，甲本作「地藏為提航」。底本「綱」字作「剛」，據文意改。"}
{"id": null, "n": "0237003", "target": "#nkr_note_orig_0237003", "type": "orig", "text": "「行孝」，底本作「孝行」，據甲本改。"}
{"id": null, "n": "0239001", "target": "#nkr_note_orig_0239001", "type": "orig", "text": "「遂發」，底本作「逐法」，據文意改。"}
{"id": null, "n": "0240001", "target": "#nkr_note_orig_0240001", "type": "orig", "text": "「法」，底本無，據文意補。"}
{"id": null, "n": "0242001", "target": "#nkr_note_orig_0242001", "type": "orig", "text": "「槃」，底本作「盤」，據文意改。"}
{"id": null, "n": "0242002", "target": "#nkr_note_orig_0242002", "type": "orig", "text": "「劫」，乙本作「界」。"}
{"id": null, "n": "0243001", "target": "#nkr_note_orig_0243001", "type": "orig", "text": "「輪」，乙本作「門」。"}
{"id": null, "n": "0243002", "target": "#nkr_note_orig_0243002", "type": "orig", "text": "「垂」，乙本作「抒」。"}
{"id": null, "n": "0243003", "target": "#nkr_note_orig_0243003", "type": "orig", "text": "「誓」，甲本作「深」。"}
{"id": null, "n": "0243004", "target": "#nkr_note_orig_0243004", "type": "orig", "text": "「莊嚴」，乙本作「如來」。"}
{"id": null, "n": "0243005", "target": "#nkr_note_orig_0243005", "type": "orig", "text": "「正」，底、甲、乙本作「證」，據文意改。"}
{"id": null, "n": "0243006", "target": "#nkr_note_orig_0243006", "type": "orig", "text": "「自在」，乙本作「定自在」。"}
{"id": null, "n": "0244001", "target": "#nkr_note_orig_0244001", "type": "orig", "text": "「扃」，底本作「局」，據甲、乙本改。"}
{"id": null, "n": "0244002", "target": "#nkr_note_orig_0244002", "type": "orig", "text": "「興」，底本作「與」，據甲、乙本改。"}
{"id": null, "n": "0244003", "target": "#nkr_note_orig_0244003", "type": "orig", "text": "「行」，底本作「依」，據甲、乙本改。"}
{"id": null, "n": "0244004", "target": "#nkr_note_orig_0244004", "type": "orig", "text": "「六道」，底本作「濁世」，據甲、乙本改。"}
{"id": null, "n": "0244005", "target": "#nkr_note_orig_0244005", "type": "orig", "text": "「導」，底、乙本作「道」，據甲本改。"}
{"id": null, "n": "0245001", "target": "#nkr_note_orig_0245001", "type": "orig", "text": "「地藏慈悲救苦薦福利生道場儀文下」，底本無，據上文行文補。"}
{"id": null, "n": "0246001", "target": "#nkr_note_orig_0246001", "type": "orig", "text": "「心」，底本作「誠」，據甲本改。"}
{"id": null, "n": "0246002", "target": "#nkr_note_orig_0246002", "type": "orig", "text": "「聖」，底本作「眾」，據甲本改。"}
{"id": null, "n": "0247001", "target": "#nkr_note_orig_0247001", "type": "orig", "text": "「規」，甲本作「龜」。"}
{"id": null, "n": "0247002", "target": "#nkr_note_orig_0247002", "type": "orig", "text": "「元照為提綱」，甲本作「地藏為提航」。"}
{"id": null, "n": "0247003", "target": "#nkr_note_orig_0247003", "type": "orig", "text": "「行孝」，底本作「孝行」，據甲本改。"}
{"id": null, "n": "0249001", "target": "#nkr_note_orig_0249001", "type": "orig", "text": "「慈」，甲本作「深」。"}
{"id": null, "n": "0249002", "target": "#nkr_note_orig_0249002", "type": "orig", "text": "「明珠」，甲本作「心殊」。"}
{"id": null, "n": "0249003", "target": "#nkr_note_orig_0249003", "type": "orig", "text": "「故」，甲本作「顧」。"}
{"id": null, "n": "0249004", "target": "#nkr_note_orig_0249004", "type": "orig", "text": "「分」，底本作「與」，據甲本改。"}
{"id": null, "n": "0249005", "target": "#nkr_note_orig_0249005", "type": "orig", "text": "「惟稱」，甲本作「能除」。"}
{"id": null, "n": "0249006", "target": "#nkr_note_orig_0249006", "type": "orig", "text": "「化」，甲本作「作」。"}
{"id": null, "n": "0250001", "target": "#nkr_note_orig_0250001", "type": "orig", "text": "「巡」，甲本作「旋」，本科儀《提綱》作「流」。"}
{"id": null, "n": "0250002", "target": "#nkr_note_orig_0250002", "type": "orig", "text": "「善」，甲本作「上」。"}
{"id": null, "n": "0250003", "target": "#nkr_note_orig_0250003", "type": "orig", "text": "「奈」，底本作「柰」，據甲本改。"}
{"id": null, "n": "0250004", "target": "#nkr_note_orig_0250004", "type": "orig", "text": "「天」，甲本作「王」。"}
{"id": null, "n": "0250005", "target": "#nkr_note_orig_0250005", "type": "orig", "text": "「生」，底本作「應生」，據甲本刪。"}
{"id": null, "n": "0250006", "target": "#nkr_note_orig_0250006", "type": "orig", "text": "「君」，底本作「王」，據甲本改。"}
{"id": null, "n": "0250007", "target": "#nkr_note_orig_0250007", "type": "orig", "text": "「名」，甲本作「佛」。"}
{"id": null, "n": "0251001", "target": "#nkr_note_orig_0251001", "type": "orig", "text": "「蓋」，甲本作「現」。"}
{"id": null, "n": "0251002", "target": "#nkr_note_orig_0251002", "type": "orig", "text": "「恒」，底本作「河」，據甲本改。"}
