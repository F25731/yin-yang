{"id": null, "n": "0303002", "target": "#nkr_note_orig_0303002", "type": "orig", "text": "「常」，底、甲本作「長」，據文意改。"}
{"id": null, "n": "0303003", "target": "#nkr_note_orig_0303003", "type": "orig", "text": "「悔」，底本作「除」，據甲本改。"}
{"id": null, "n": "0304001", "target": "#nkr_note_orig_0304001", "type": "orig", "text": "「句」，底本作「力」，據甲本改。"}
{"id": null, "n": "0305001", "target": "#nkr_note_orig_0305001", "type": "orig", "text": "「拘」，甲本作「俱」。"}
{"id": null, "n": "0305002", "target": "#nkr_note_orig_0305002", "type": "orig", "text": "「薩」，甲本作「娑」。"}
{"id": null, "n": "0305003", "target": "#nkr_note_orig_0305003", "type": "orig", "text": "「薰」，底本作「重」，據甲本改。"}
{"id": null, "n": "0306001", "target": "#nkr_note_orig_0306001", "type": "orig", "text": "「真言」，底本作「咒」，據甲本改。"}
{"id": null, "n": "0307001", "target": "#nkr_note_orig_0307001", "type": "orig", "text": "「此」，底本作「慈」，據甲本改。"}
{"id": null, "n": "0307002", "target": "#nkr_note_orig_0307002", "type": "orig", "text": "「知」，甲本作「伽」。"}
{"id": null, "n": "0309001", "target": "#nkr_note_orig_0309001", "type": "orig", "text": "「宣」，甲本作「憑」。"}
{"id": null, "n": "0309002", "target": "#nkr_note_orig_0309002", "type": "orig", "text": "「障」，底本作「業」，據甲本改。"}
{"id": null, "n": "0309003", "target": "#nkr_note_orig_0309003", "type": "orig", "text": "「罪」，甲本作「悔」。"}
{"id": null, "n": "0310001", "target": "#nkr_note_orig_0310001", "type": "orig", "text": "「莊」，甲本作「端」。"}
{"id": null, "n": "0311001", "target": "#nkr_note_orig_0311001", "type": "orig", "text": "「曩謨」，甲本作「南無」。"}
{"id": null, "n": "0311002", "target": "#nkr_note_orig_0311002", "type": "orig", "text": "「訶帝」，底本作「帝訶」，據甲本改。"}
{"id": null, "n": "0311003", "target": "#nkr_note_orig_0311003", "type": "orig", "text": "底本「時」字後有「提剛」二字，據文意刪。"}
{"id": null, "n": "0313001", "target": "#nkr_note_orig_0313001", "type": "orig", "text": "尾題前有「時大清康熙三十七年歲在戊寅年造」的題記。"}
