{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "丁酉"}
{"id": null, "n": "0659002", "target": "#nkr_note_mod_0659002", "type": "mod", "text": "教【大】，〔－〕【校異-原】"}
{"id": null, "n": "0659003", "target": "#nkr_note_mod_0659003", "type": "mod", "text": "誰【大】＊，准【考偽-大】＊"}
{"id": null, "n": "0659004", "target": "#nkr_note_mod_0659004", "type": "mod", "text": "亦【大】，爾【考偽-大】"}
{"id": null, "n": "0659005", "target": "#nkr_note_mod_0659005", "type": "mod", "text": "以【大】，以為【考偽-大】"}
{"id": null, "n": "0659006", "target": "#nkr_note_mod_0659006", "type": "mod", "text": "百【大】，百品【考偽-大】"}
{"id": null, "n": "0660001", "target": "#nkr_note_mod_0660001", "type": "mod", "text": "然【大】，亦然【考偽-大】"}
{"id": null, "n": "0660002", "target": "#nkr_note_mod_0660002", "type": "mod", "text": "者本也【大】，〔－〕【校異-原】"}
{"id": null, "n": "0660003", "target": "#nkr_note_mod_0660003", "type": "mod", "text": "具【大】，且【考偽-大】"}
{"id": null, "n": "0660004", "target": "#nkr_note_mod_0660004", "type": "mod", "text": "有【大】，〔－〕【考偽-大】"}
{"id": null, "n": "0660005", "target": "#nkr_note_mod_0660005", "type": "mod", "text": "者【大】＊，常【校異-原】＊"}
{"id": null, "n": "0660006", "target": "#nkr_note_mod_0660006", "type": "mod", "text": "為【大】，為一【考偽-大】"}
{"id": null, "n": "0660007", "target": "#nkr_note_mod_0660007", "type": "mod", "text": "合【大】，含【考偽-大】"}
{"id": null, "n": "0660008", "target": "#nkr_note_mod_0660008", "type": "mod", "text": "不【大】，分【校異-原】"}
{"id": null, "n": "0661001", "target": "#nkr_note_mod_0661001", "type": "mod", "text": "存【大】，在【校異-原】"}
{"id": null, "n": "0661002", "target": "#nkr_note_mod_0661002", "type": "mod", "text": "進【大】，進修【考偽-大】"}
{"id": null, "n": "0661003", "target": "#nkr_note_mod_0661003", "type": "mod", "text": "相【大】，相故【校異-原】"}
{"id": null, "n": "0661004", "target": "#nkr_note_mod_0661004", "type": "mod", "text": "融【大】，行融【校異-原】"}
{"id": null, "n": "0661005", "target": "#nkr_note_mod_0661005", "type": "mod", "text": "所【大】，以【考偽-大】"}
{"id": null, "n": "0662001", "target": "#nkr_note_mod_0662001", "type": "mod", "text": "之【大】，〔－〕【考偽-大】"}
{"id": null, "n": "0662002", "target": "#nkr_note_mod_0662002", "type": "mod", "text": "教【大】，故【校異-原】"}
{"id": null, "n": "0662003", "target": "#nkr_note_mod_0662003", "type": "mod", "text": "逢【大】，望【校異-原】"}
{"id": null, "n": "0662004", "target": "#nkr_note_mod_0662004", "type": "mod", "text": "具【大】，其【考偽-大】"}
{"id": null, "n": "0659001", "target": "#nkr_note_orig_0659001", "type": "orig", "text": "【原】鎌倉時代凝然寫，小野玄妙氏藏本"}
{"id": null, "n": "0659002", "target": "#nkr_note_orig_0659002", "type": "orig", "text": "〔教〕ィ－【原】"}
{"id": null, "n": "0659003", "target": "#nkr_note_orig_0659003", "type": "orig", "text": "誰＝准？＊"}
{"id": null, "n": "0659004", "target": "#nkr_note_orig_0659004", "type": "orig", "text": "亦＝爾？"}
{"id": null, "n": "0659005", "target": "#nkr_note_orig_0659005", "type": "orig", "text": "以＋（為）？"}
{"id": null, "n": "0659006", "target": "#nkr_note_orig_0659006", "type": "orig", "text": "百＋（品）？"}
{"id": null, "n": "0660001", "target": "#nkr_note_orig_0660001", "type": "orig", "text": "（亦）＋然？"}
{"id": null, "n": "0660002", "target": "#nkr_note_orig_0660002", "type": "orig", "text": "〔者本也〕ィ－【原】"}
{"id": null, "n": "0660003", "target": "#nkr_note_orig_0660003", "type": "orig", "text": "具＝且？"}
{"id": null, "n": "0660004", "target": "#nkr_note_orig_0660004", "type": "orig", "text": "〔有〕－？"}
{"id": null, "n": "0660005", "target": "#nkr_note_orig_0660005", "type": "orig", "text": "者＝常ィ【原】＊"}
{"id": null, "n": "0660006", "target": "#nkr_note_orig_0660006", "type": "orig", "text": "為＋（一）？"}
{"id": null, "n": "0660007", "target": "#nkr_note_orig_0660007", "type": "orig", "text": "合＝含？"}
{"id": null, "n": "0660008", "target": "#nkr_note_orig_0660008", "type": "orig", "text": "不＝分ィ【原】"}
{"id": null, "n": "0661001", "target": "#nkr_note_orig_0661001", "type": "orig", "text": "存＝在ィ【原】"}
{"id": null, "n": "0661002", "target": "#nkr_note_orig_0661002", "type": "orig", "text": "進＋（修）？"}
{"id": null, "n": "0661003", "target": "#nkr_note_orig_0661003", "type": "orig", "text": "相＋（故）ィ【原】"}
{"id": null, "n": "0661004", "target": "#nkr_note_orig_0661004", "type": "orig", "text": "（行）ィ＋融【原】"}
{"id": null, "n": "0661005", "target": "#nkr_note_orig_0661005", "type": "orig", "text": "所＝以？"}
{"id": null, "n": "0662001", "target": "#nkr_note_orig_0662001", "type": "orig", "text": "〔之〕－？"}
{"id": null, "n": "0662002", "target": "#nkr_note_orig_0662002", "type": "orig", "text": "教＝故ィ【原】"}
{"id": null, "n": "0662003", "target": "#nkr_note_orig_0662003", "type": "orig", "text": "逢＝望ィ【原】"}
{"id": null, "n": "0662004", "target": "#nkr_note_orig_0662004", "type": "orig", "text": "具＝其？"}
