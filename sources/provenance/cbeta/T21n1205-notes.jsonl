{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": null, "target": null, "type": null, "text": "右手執獨古、左手\n押腰，眼忿怒，牙上下出，色青色。若人欲得求官位呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右手執鉾、左押腰，天\n王形，赤色也。若人欲得求富貴者呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右左\n持鉢，恭敬形也，赤色形也。若人欲求得敬愛者呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右手\n持箭、左持弓，立石上，黑色形也，眼嗔怒形也。若人欲得求解脫智慧者呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右持杖、左押腰，赤色髮竪形。若人欲得求一切意願者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右手\n用大刀、左手押腰，黑色形也。若人欲得大智者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右手用錫杖、左\n押腰，赤色形也。若人欲得國王大臣愛念者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右用索、左拳押腰，\n赤色形也。若人欲得王后采女者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "黑色右執刀、左\n押腰。若人欲得大臣公卿愛者此呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右手用枚、左押腰，狗打形，赤色形也。若人欲得大福官者此呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右手用輪、左押腰，黑色形。若人欲得勝人者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "左右手合掌，赤色形。\n若人欲得遂一切所望世間者呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右手持經、\n左手劍印押腰，赤色形。若人欲得示化人大靈驗者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "左手押腰、右手持寶\n珠掌心居，黑色形。若人欲得驗利此呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右手持金剛杵、左手押腰，赤色形也。若人欲得一切人愛念者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "左持縛沙羅、右押腰，赤色形也。若人欲得勝論議者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右手持三古、左押腰，赤色形。若人欲得惡人降伏者此呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右持蓮華、左押腰，赤色形。若人欲得止熱病者此呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右持大刀、左押腰，赤色形也。若人欲得止疫病者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右持塔、左持大刀，赤色衣形也。若人欲得官位者此呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右持弓、左持加利摩多，赤色形。若欲得成一切法師王者此呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右持繩縛沙羅、左押腰，赤色形。若欲得諸富人者此呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "左右手金剛合掌印，忿怒形，二目嗔怒面赤狀黑色形。若欲得天狐結縛者此呼使者。已上左使者二十四人也，\n是發心修行義。右二十四人使者，烈呵立形也，是修果成佛義"}
{"id": null, "n": null, "target": null, "type": null, "text": "左脇獨古用右\n左合掌印，黑色形也。欲得惡靈邪氣結縛者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右持杖、左押腰，赤色形也。欲得除滅一切鬼神縛礙者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右手持蓮華、左\n押腰，白色形也，或赤色形。欲得諸人決定業障除滅者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "左持鈴、右執劍，黑色形也。欲得諸小兒短命央壽消除者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右手用錫杖、左持袈裟形。欲得一切女人難產生者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右手持杖逆、左押腰。赤色形也。欲得止一切惡魔鬼神顛狂者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右持經卷、左手持念珠。赤色形也。若欲得一切人財物者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右執塔、左執大刀，赤色形也。欲得高貴婦人者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右執髑髏、左手拳押\n腰，眼瞋怒形也，黑色形。欲得返惡人呪咀者此呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右左手金剛合掌印，赤色形也。欲得止一切災難者此呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "欲得勝軍陳者此呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右持獨古、左拳押腰，黑色也。欲得除病流行災者此呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右持杖、左押腰，赤色形也。欲得極樂往生上品上生者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右用三古杵、左持索，黑色形。欲得其七世父母者觀一切眾生地獄苦者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右持劍、左押腰，赤色形。欲得夫婦愛相者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右執獨古、左押\n腰，黑色形。欲得止一切聾瘂病者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右持\n念珠、左押腰，白色形。欲得令夫婦相離惡是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右執如意珠、左\n押腰，赤色形。欲得一切物者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右執大刀、左手\n執索押腰，赤色，五須如天王。欲得除盜人難者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右手持鏡、左押腰，白色。欲得從者他所返者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右手執劍、左持索，眼瞋怒，黑色形。欲得牛馬迯遊者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右持鉾、左押腰，\n赤色形。欲得田畠返者此呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右持三古杵、左\n作劍印押腰，黑色形。欲得師長愛敬者是呼使者"}
{"id": null, "n": null, "target": null, "type": null, "text": "右執五古鈴、左\n押腰，赤色衣，眼瞋怒形。欲得一切諸佛愛護者是呼使者必成就"}
{"id": null, "n": null, "target": null, "type": null, "text": "二種印口傳可聞者"}
{"id": null, "n": null, "target": null, "type": null, "text": "墨筆"}
{"id": null, "n": null, "target": null, "type": null, "text": "朱筆"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T21n1246_p0219c22"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T20n1149_p0608b02"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T20n1149_p0608b02"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X12n0275_p0317a22"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T21n1201_p0014a25"}
{"id": null, "n": "0033005", "target": "#nkr_note_mod_0033005", "type": "mod", "text": "國【大】，〔－〕【校異Ｂ-原】"}
{"id": null, "n": "0033006", "target": "#nkr_note_mod_0033006", "type": "mod", "text": "集【大】，譯【校異Ｂ-原】"}
{"id": null, "n": "0033007", "target": "#nkr_note_mod_0033007", "type": "mod", "text": "炎【大】＊，光【校異Ａ-原】＊"}
{"id": null, "n": "0033008", "target": "#nkr_note_mod_0033008", "type": "mod", "text": "娑【大】，婆【校異Ｂ-原】"}
{"id": null, "n": "0033009", "target": "#nkr_note_mod_0033009", "type": "mod", "text": "疫【大】，痠【校異Ａ-原】"}
{"id": null, "n": "0033010", "target": "#nkr_note_mod_0033010", "type": "mod", "text": "皆【大】，智【校異Ｂ-原】"}
{"id": null, "n": "0033011", "target": "#nkr_note_mod_0033011", "type": "mod", "text": "常【大】，等【校異Ｂ-原】"}
{"id": null, "n": "0033012", "target": "#nkr_note_mod_0033012", "type": "mod", "text": "撻【大】，闥【校異Ｂ-原】"}
{"id": null, "n": "0033013", "target": "#nkr_note_mod_0033013", "type": "mod", "text": "世界焚火【大】，焚火世界【校異Ｂ-原】"}
{"id": null, "n": "0033014", "target": "#nkr_note_mod_0033014", "type": "mod", "text": "但𭲈【大】，俱湊【校異Ａ-原】"}
{"id": null, "n": "0033015", "target": "#nkr_note_mod_0033015", "type": "mod", "text": "一切有情【大】，〔－〕【校異Ａ-原】"}
{"id": null, "n": "0033016", "target": "#nkr_note_mod_0033016", "type": "mod", "text": "五【大】，五智【校異Ｂ-原】"}
{"id": null, "n": "0033017", "target": "#nkr_note_mod_0033017", "type": "mod", "text": "說【大】，設說【校異Ｂ-原】"}
{"id": null, "n": "0033018", "target": "#nkr_note_mod_0033018", "type": "mod", "text": "辟除令身無垢清淨【大】，無垢身令清淨辟除【校異Ｂ-原】"}
{"id": null, "n": "0033019", "target": "#nkr_note_mod_0033019", "type": "mod", "text": "已【大】，〔－〕【校異Ｂ-原】"}
{"id": null, "n": "0033020", "target": "#nkr_note_mod_0033020", "type": "mod", "text": "道【大】，〔－〕【校異Ｂ-原】"}
{"id": null, "n": "0033021", "target": "#nkr_note_mod_0033021", "type": "mod", "text": "少少【大】，世出【校異Ａ-原】"}
{"id": null, "n": "0033022", "target": "#nkr_note_mod_0033022", "type": "mod", "text": "東【大】，東立【校異Ａ-原】"}
{"id": null, "n": "0033023", "target": "#nkr_note_mod_0033023", "type": "mod", "text": "蛇龜【大】，蚊虻【校異Ｂ-原】"}
{"id": null, "n": "0033024", "target": "#nkr_note_mod_0033024", "type": "mod", "text": "損【大】，損耳【校異Ａ-原】，損則【校異Ａ-原】"}
{"id": null, "n": "0033025", "target": "#nkr_note_mod_0033025", "type": "mod", "text": "常【大】，當【校異Ｂ-原】"}
{"id": null, "n": "0033026", "target": "#nkr_note_mod_0033026", "type": "mod", "text": "斫【大】，折【校異Ａ-原】"}
{"id": null, "n": "0033027", "target": "#nkr_note_mod_0033027", "type": "mod", "text": "飲【大】，蝕【校異Ａ-原】"}
{"id": null, "n": "0033028", "target": "#nkr_note_mod_0033028", "type": "mod", "text": "祈【大】，新【考偽-原】"}
{"id": null, "n": "0034001", "target": "#nkr_note_mod_0034001", "type": "mod", "text": "棕【大】，悖【考偽-原】"}
{"id": null, "n": "0034002", "target": "#nkr_note_mod_0034002", "type": "mod", "text": "施【大】，旋【校異Ａ-原】"}
{"id": null, "n": "0034003", "target": "#nkr_note_mod_0034003", "type": "mod", "text": "於【大】，施【校異Ｂ-原】"}
{"id": null, "n": "0034004", "target": "#nkr_note_mod_0034004", "type": "mod", "text": "湛【大】，堪【校異Ａ-原】"}
{"id": null, "n": "0034005", "target": "#nkr_note_mod_0034005", "type": "mod", "text": "且【大】，亦【校異Ｂ-原】"}
{"id": null, "n": "0034006", "target": "#nkr_note_mod_0034006", "type": "mod", "text": "伏【大】，無【校異Ｂ-原】"}
{"id": null, "n": "0034007", "target": "#nkr_note_mod_0034007", "type": "mod", "text": "等【大】，守【校異Ｂ-原】"}
{"id": null, "n": "0034008", "target": "#nkr_note_mod_0034008", "type": "mod", "text": "更【大】，受【校異Ｂ-原】"}
{"id": null, "n": "0034009", "target": "#nkr_note_mod_0034009", "type": "mod", "text": "地【大】，掘地【校異Ｂ-原】"}
{"id": null, "n": "0034010", "target": "#nkr_note_mod_0034010", "type": "mod", "text": "以【大】，一【校異Ｂ-原】"}
{"id": null, "n": "0034011", "target": "#nkr_note_mod_0034011", "type": "mod", "text": "令【大】，今【校異Ａ-原】"}
{"id": null, "n": "0034012", "target": "#nkr_note_mod_0034012", "type": "mod", "text": "有【大】，亦有【校異Ａ-原】"}
{"id": null, "n": "0034013", "target": "#nkr_note_mod_0034013", "type": "mod", "text": "向【大】，百【校異Ａ-原】"}
{"id": null, "n": "0034014", "target": "#nkr_note_mod_0034014", "type": "mod", "text": "䊒【大】，雖【校異Ａ-原】"}
{"id": null, "n": "0034015", "target": "#nkr_note_mod_0034015", "type": "mod", "text": "可【大】，自可【校異Ａ-原】"}
{"id": null, "n": "0034016", "target": "#nkr_note_mod_0034016", "type": "mod", "text": "燒二【大】，二燒【校異Ｂ-原】"}
{"id": null, "n": "0034017", "target": "#nkr_note_mod_0034017", "type": "mod", "text": "所【大】，所能【校異Ａ-原】"}
{"id": null, "n": "0034018", "target": "#nkr_note_mod_0034018", "type": "mod", "text": "圓【大】，國【校異Ａ-原】"}
{"id": null, "n": "0034019", "target": "#nkr_note_mod_0034019", "type": "mod", "text": "萬一【大】，一萬【校異Ｂ-原】"}
{"id": null, "n": "0034020", "target": "#nkr_note_mod_0034020", "type": "mod", "text": "之【大】，〔－〕【校異Ｂ-原】"}
{"id": null, "n": "0034021", "target": "#nkr_note_mod_0034021", "type": "mod", "text": "推【大】，摧【校異Ｂ-原】"}
{"id": null, "n": "0034022", "target": "#nkr_note_mod_0034022", "type": "mod", "text": "緣【大】，緣神【校異Ａ-原】"}
{"id": null, "n": "0034023", "target": "#nkr_note_mod_0034023", "type": "mod", "text": "瞋【大】，瞋目【校異Ａ-原】"}
{"id": null, "n": "0034024", "target": "#nkr_note_mod_0034024", "type": "mod", "text": "者【大】，者上【校異Ｂ-原】"}
{"id": null, "n": "0034025", "target": "#nkr_note_mod_0034025", "type": "mod", "text": "長【大】，取豇豆萁長【考偽-原】"}
{"id": null, "n": "0034026", "target": "#nkr_note_mod_0034026", "type": "mod", "text": "刊【大】，㓨【校異Ｂ-原】"}
{"id": null, "n": "0034027", "target": "#nkr_note_mod_0034027", "type": "mod", "text": "當【大】，常【校異Ａ-原】"}
{"id": null, "n": "0034028", "target": "#nkr_note_mod_0034028", "type": "mod", "text": "園【大】，〔－〕【校異Ｂ-原】"}
{"id": null, "n": "0034029", "target": "#nkr_note_mod_0034029", "type": "mod", "text": "必死【大】，母施叉【校異Ｂ-原】"}
{"id": null, "n": "0034030", "target": "#nkr_note_mod_0034030", "type": "mod", "text": "尊【大】，尊種子也【校異Ｂ-原】"}
{"id": null, "n": "0034031", "target": "#nkr_note_mod_0034031", "type": "mod", "text": "阿潔【大】，智火【考偽-原】"}
