{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": null, "target": null, "type": null, "text": "頂，其色如虛空"}
{"id": null, "n": null, "target": null, "type": null, "text": "眉間，其色如火"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合，兩肩，其色如火"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合，心上，其色如乳圓，目眸安於明，咽喉如肩法，月色如黃金"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
