{"id": null, "n": "0737003", "target": "#nkr_note_mod_0737003", "type": "mod", "text": "經【大】＊，經鈔【宋】【元】＊"}
{"id": null, "n": "0737004", "target": "#nkr_note_mod_0737004", "type": "mod", "text": "天竺【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0737005", "target": "#nkr_note_mod_0737005", "type": "mod", "text": "譯【大】，譯出【宋】【元】"}
{"id": null, "n": "0737006", "target": "#nkr_note_mod_0737006", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0737007", "target": "#nkr_note_mod_0737007", "type": "mod", "text": "興【大】，與【宋】【元】【明】"}
{"id": null, "n": "0737008", "target": "#nkr_note_mod_0737008", "type": "mod", "text": "泆【大】，妷【宋】"}
{"id": null, "n": "0737009", "target": "#nkr_note_mod_0737009", "type": "mod", "text": "以【大】，已【宋】【元】【明】"}
{"id": null, "n": "0737010", "target": "#nkr_note_mod_0737010", "type": "mod", "text": "飯【大】，飯者【宋】【元】【明】"}
{"id": null, "n": "0737011", "target": "#nkr_note_mod_0737011", "type": "mod", "text": "妄念【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0737012", "target": "#nkr_note_mod_0737012", "type": "mod", "text": "入【大】，入里【宋】【元】【明】"}
{"id": null, "n": "0737013", "target": "#nkr_note_mod_0737013", "type": "mod", "text": "可【大】，為可【宋】【元】【明】"}
{"id": null, "n": "0737014", "target": "#nkr_note_mod_0737014", "type": "mod", "text": "狾【大】，狡【宋】【元】【明】"}
{"id": null, "n": "0737015", "target": "#nkr_note_mod_0737015", "type": "mod", "text": "亦【大】，亦餘【宋】【元】【明】"}
{"id": null, "n": "0737016", "target": "#nkr_note_mod_0737016", "type": "mod", "text": "及【大】，乃【宋】【元】【明】"}
{"id": null, "n": "0737017", "target": "#nkr_note_mod_0737017", "type": "mod", "text": "惱【大】，腦【宋】【元】【明】"}
{"id": null, "n": "0737018", "target": "#nkr_note_mod_0737018", "type": "mod", "text": "焚【大】，燒【宋】【元】【明】"}
{"id": null, "n": "0738001", "target": "#nkr_note_mod_0738001", "type": "mod", "text": "得【大】，復【宋】【元】【明】"}
{"id": null, "n": "0738002", "target": "#nkr_note_mod_0738002", "type": "mod", "text": "隨【大】，墮【宋】【元】【明】"}
{"id": null, "n": "0738003", "target": "#nkr_note_mod_0738003", "type": "mod", "text": "天【大】，夭【明】"}
{"id": null, "n": "0738004", "target": "#nkr_note_mod_0738004", "type": "mod", "text": "施【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0738005", "target": "#nkr_note_mod_0738005", "type": "mod", "text": "賈【大】，價【宋】【元】【明】"}
{"id": null, "n": "0738006", "target": "#nkr_note_mod_0738006", "type": "mod", "text": "黠【大】，點【元】【明】"}
{"id": null, "n": "0738007", "target": "#nkr_note_mod_0738007", "type": "mod", "text": "搖【大】，採【元】【明】"}
{"id": null, "n": "0738008", "target": "#nkr_note_mod_0738008", "type": "mod", "text": "佛說【大】，〔－〕【宋】【元】"}
{"id": null, "n": "0737003", "target": "#nkr_note_orig_0737003", "type": "orig", "text": "經＋（鈔）【宋】【元】＊"}
{"id": null, "n": "0737004", "target": "#nkr_note_orig_0737004", "type": "orig", "text": "〔天竺〕－【三】"}
{"id": null, "n": "0737005", "target": "#nkr_note_orig_0737005", "type": "orig", "text": "譯＋（出）【宋】【元】"}
{"id": null, "n": "0737006", "target": "#nkr_note_orig_0737006", "type": "orig", "text": "〔有〕－【三】"}
{"id": null, "n": "0737007", "target": "#nkr_note_orig_0737007", "type": "orig", "text": "興＝與【三】"}
{"id": null, "n": "0737008", "target": "#nkr_note_orig_0737008", "type": "orig", "text": "泆＝妷【宋】"}
{"id": null, "n": "0737009", "target": "#nkr_note_orig_0737009", "type": "orig", "text": "以＝已【三】"}
{"id": null, "n": "0737010", "target": "#nkr_note_orig_0737010", "type": "orig", "text": "飯＋（者）【三】"}
{"id": null, "n": "0737011", "target": "#nkr_note_orig_0737011", "type": "orig", "text": "〔妄念〕－【三】"}
{"id": null, "n": "0737012", "target": "#nkr_note_orig_0737012", "type": "orig", "text": "入＋（里）【三】"}
{"id": null, "n": "0737013", "target": "#nkr_note_orig_0737013", "type": "orig", "text": "（為）＋可【三】"}
{"id": null, "n": "0737014", "target": "#nkr_note_orig_0737014", "type": "orig", "text": "狾＝狡【三】"}
{"id": null, "n": "0737015", "target": "#nkr_note_orig_0737015", "type": "orig", "text": "亦＋（餘）【三】"}
{"id": null, "n": "0737016", "target": "#nkr_note_orig_0737016", "type": "orig", "text": "及＝乃【三】"}
{"id": null, "n": "0737017", "target": "#nkr_note_orig_0737017", "type": "orig", "text": "惱＝腦【三】"}
{"id": null, "n": "0737018", "target": "#nkr_note_orig_0737018", "type": "orig", "text": "焚＝燒【三】"}
{"id": null, "n": "0738001", "target": "#nkr_note_orig_0738001", "type": "orig", "text": "得＝復【三】"}
{"id": null, "n": "0738002", "target": "#nkr_note_orig_0738002", "type": "orig", "text": "隨＝墮【三】"}
{"id": null, "n": "0738003", "target": "#nkr_note_orig_0738003", "type": "orig", "text": "天＝夭【明】"}
{"id": null, "n": "0738004", "target": "#nkr_note_orig_0738004", "type": "orig", "text": "〔施〕－【三】"}
{"id": null, "n": "0738005", "target": "#nkr_note_orig_0738005", "type": "orig", "text": "賈＝價【三】"}
{"id": null, "n": "0738006", "target": "#nkr_note_orig_0738006", "type": "orig", "text": "黠＝點【元】【明】"}
{"id": null, "n": "0738007", "target": "#nkr_note_orig_0738007", "type": "orig", "text": "搖＝採【元】【明】"}
