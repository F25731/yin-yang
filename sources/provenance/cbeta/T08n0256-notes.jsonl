{"id": null, "n": "0851c1701", "target": "#nkr_note_add_0851c1701", "type": "add", "text": "卅【CB】，［－］【大】"}
{"id": null, "n": "0851c2001", "target": "#nkr_note_add_0851c2001", "type": "add", "text": "CBETA 按：依萬金川查核原抄本之研究成果，「野(乃)嚩(至)㘃囉(老)麼囉喃(無)(卅五)」至「曩(無)尾儞也(明)乞叉喻(盡)(卅四)」之間訛誤甚多，原抄本於此段前後有直角標記作廢棄段，並於下文再續抄寫，惟《大正藏》編纂者未察而重複錄入正文。（萬金川〈石室《心經》音寫抄本校釋初稿之二，《圓光佛學學報》9（2004）第60頁。）"}
{"id": null, "n": "0851c2601", "target": "#nkr_note_add_0851c2601", "type": "add", "text": "罣【CB】，早【大】"}
{"id": null, "n": "0851c2801", "target": "#nkr_note_add_0851c2801", "type": "add", "text": "囉至曩無【CB】，囉至曩無【大】"}
{"id": null, "n": null, "target": null, "type": null, "text": "至"}
{"id": null, "n": null, "target": null, "type": null, "text": "無"}
{"id": null, "n": null, "target": null, "type": null, "text": "囉至曩無"}
{"id": null, "n": "0852a1701", "target": "#nkr_note_add_0852a1701", "type": "add", "text": "呪五十八阿無【CB】，呪阿無五十八【大】"}
{"id": null, "n": null, "target": null, "type": null, "text": "呪"}
{"id": null, "n": null, "target": null, "type": null, "text": "五十八"}
{"id": null, "n": null, "target": null, "type": null, "text": "無"}
{"id": null, "n": null, "target": null, "type": null, "text": "呪阿無"}
{"id": null, "n": null, "target": null, "type": null, "text": "五十八"}
{"id": null, "n": "0852a2101", "target": "#nkr_note_add_0852a2101", "type": "add", "text": "也【CB】，也【大】"}
{"id": null, "n": null, "target": null, "type": null, "text": "也"}
{"id": null, "n": "0852a2102", "target": "#nkr_note_add_0852a2102", "type": "add", "text": "六十三【CB】，［－］【大】"}
{"id": null, "n": null, "target": null, "type": null, "text": "六十三"}
{"id": null, "n": "0852a2103", "target": "#nkr_note_add_0852a2103", "type": "add", "text": "誐【CB】【房山】，諦【大】"}
