{"id": null, "n": "0386064", "target": null, "type": "orig", "text": "痛＝疾【元】【明】"}
{"id": null, "n": "0386064", "target": null, "type": "mod", "text": "痛【大】，疾【元】【明】"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K14n0506_p0032a19"}
{"id": null, "n": "0386001", "target": "#nkr_note_mod_0386001", "type": "mod", "text": "長壽【大】，佛說長壽【元】【明】"}
{"id": null, "n": "0386002", "target": "#nkr_note_mod_0386002", "type": "mod", "text": "僧祐…西晉錄【大】，失譯【宋】，開元錄云安祐二錄並失譯師今附西晉第二出【元】【明】"}
{"id": null, "n": "0386003", "target": "#nkr_note_mod_0386003", "type": "mod", "text": "是【大】，爾【明】"}
{"id": null, "n": "0386004", "target": "#nkr_note_mod_0386004", "type": "mod", "text": "昔【大】，昔者【宋】【元】【明】"}
{"id": null, "n": "0386005", "target": "#nkr_note_mod_0386005", "type": "mod", "text": "治國以政【大】，以正法治國無【宋】【元】【明】"}
{"id": null, "n": "0386006", "target": "#nkr_note_mod_0386006", "type": "mod", "text": "熟【大】，饒【宋】【元】【明】"}
{"id": null, "n": "0386007", "target": "#nkr_note_mod_0386007", "type": "mod", "text": "治【大】，法【宋】【元】【明】"}
{"id": null, "n": "0386008", "target": "#nkr_note_mod_0386008", "type": "mod", "text": "豐【大】，富【宋】【元】【明】"}
{"id": null, "n": "0386009", "target": "#nkr_note_mod_0386009", "type": "mod", "text": "往彼【大】，今往【宋】【元】【明】"}
{"id": null, "n": "0386010", "target": "#nkr_note_mod_0386010", "type": "mod", "text": "行【大】，來【宋】【元】【明】"}
{"id": null, "n": "0386011", "target": "#nkr_note_mod_0386011", "type": "mod", "text": "曰【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0386012", "target": "#nkr_note_mod_0386012", "type": "mod", "text": "唯願備豫【大】，惟願豫願【宋】【元】【明】"}
{"id": null, "n": "0386013", "target": "#nkr_note_mod_0386013", "type": "mod", "text": "召其【大】，即召【宋】【元】【明】"}
{"id": null, "n": "0386014", "target": "#nkr_note_mod_0386014", "type": "mod", "text": "彼【大】，子【宋】"}
{"id": null, "n": "0386015", "target": "#nkr_note_mod_0386015", "type": "mod", "text": "傷【大】，傷害【宋】【元】【明】"}
{"id": null, "n": "0386016", "target": "#nkr_note_mod_0386016", "type": "mod", "text": "距【大】＊，拒【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0386017", "target": "#nkr_note_mod_0386017", "type": "mod", "text": "長壽王…太子【大】，王告太子長生【宋】【元】【明】"}
{"id": null, "n": "0386018", "target": "#nkr_note_mod_0386018", "type": "mod", "text": "彼貪我國故來攻我【大】，〔－〕【宋】"}
{"id": null, "n": "0386019", "target": "#nkr_note_mod_0386019", "type": "mod", "text": "而【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0386020", "target": "#nkr_note_mod_0386020", "type": "mod", "text": "言【大】＊，曰【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0386021", "target": "#nkr_note_mod_0386021", "type": "mod", "text": "共【大】，〔－〕【宋】"}
{"id": null, "n": "0386022", "target": "#nkr_note_mod_0386022", "type": "mod", "text": "萬【大】，萬雖能得者【宋】【元】【明】"}
{"id": null, "n": "0386023", "target": "#nkr_note_mod_0386023", "type": "mod", "text": "也【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0386024", "target": "#nkr_note_mod_0386024", "type": "mod", "text": "婆羅門【大】，婆羅門曰【宋】【元】【明】"}
{"id": null, "n": "0386025", "target": "#nkr_note_mod_0386025", "type": "mod", "text": "之【大】，至【宋】【元】【明】"}
{"id": null, "n": "0386026", "target": "#nkr_note_mod_0386026", "type": "mod", "text": "國【大】，方【宋】【元】【明】"}
{"id": null, "n": "0386027", "target": "#nkr_note_mod_0386027", "type": "mod", "text": "士【大】，士也【元】【明】"}
{"id": null, "n": "0386028", "target": "#nkr_note_mod_0386028", "type": "mod", "text": "周救【大】，賑極【宋】，賑拯【元】【明】"}
{"id": null, "n": "0386029", "target": "#nkr_note_mod_0386029", "type": "mod", "text": "羸【大】，窮【宋】【元】【明】"}
{"id": null, "n": "0386030", "target": "#nkr_note_mod_0386030", "type": "mod", "text": "國【大】，國中【宋】【元】【明】"}
{"id": null, "n": "0386031", "target": "#nkr_note_mod_0386031", "type": "mod", "text": "也王默自念【大】，王為【宋】，王默念自念【元】【明】"}
{"id": null, "n": "0386032", "target": "#nkr_note_mod_0386032", "type": "mod", "text": "故【大】，快【宋】【元】【明】"}
{"id": null, "n": "0386033", "target": "#nkr_note_mod_0386033", "type": "mod", "text": "可哀【大】，哀可【宋】"}
{"id": null, "n": "0386034", "target": "#nkr_note_mod_0386034", "type": "mod", "text": "垂淚【大】，涕泣【宋】【元】【明】"}
{"id": null, "n": "0386035", "target": "#nkr_note_mod_0386035", "type": "mod", "text": "謂婆羅門【大】，〔－〕【宋】"}
{"id": null, "n": "0386036", "target": "#nkr_note_mod_0386036", "type": "mod", "text": "亡【大】，亡來【宋】【元】【明】"}
{"id": null, "n": "0386037", "target": "#nkr_note_mod_0386037", "type": "mod", "text": "藏【大】，〔－〕【宋】"}
{"id": null, "n": "0386038", "target": "#nkr_note_mod_0386038", "type": "mod", "text": "聞【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0386039", "target": "#nkr_note_mod_0386039", "type": "mod", "text": "空窮【大】，困乏【宋】【元】【明】"}
{"id": null, "n": "0386040", "target": "#nkr_note_mod_0386040", "type": "mod", "text": "咽【大】＊，噎【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0386041", "target": "#nkr_note_mod_0386041", "type": "mod", "text": "啼泣【大】，涕淚【宋】"}
{"id": null, "n": "0386042", "target": "#nkr_note_mod_0386042", "type": "mod", "text": "慕【大】，募【宋】【元】【明】"}
{"id": null, "n": "0386043", "target": "#nkr_note_mod_0386043", "type": "mod", "text": "以【大】，可取【宋】【元】【明】"}
{"id": null, "n": "0386044", "target": "#nkr_note_mod_0386044", "type": "mod", "text": "賞【大】，償【宋】【元】"}
{"id": null, "n": "0386045", "target": "#nkr_note_mod_0386045", "type": "mod", "text": "曰【大】，言【宋】【元】【明】"}
{"id": null, "n": "0386046", "target": "#nkr_note_mod_0386046", "type": "mod", "text": "遙【大】，我遙【宋】【元】【明】"}
{"id": null, "n": "0386047", "target": "#nkr_note_mod_0386047", "type": "mod", "text": "遇【大】，值【宋】【元】【明】"}
{"id": null, "n": "0386048", "target": "#nkr_note_mod_0386048", "type": "mod", "text": "乏【大】，窮【宋】【元】【明】"}
{"id": null, "n": "0386049", "target": "#nkr_note_mod_0386049", "type": "mod", "text": "吾等當死願【大】，〔－〕【元】【明】"}
{"id": null, "n": "0386050", "target": "#nkr_note_mod_0386050", "type": "mod", "text": "以身相惠【大】，以相與【宋】"}
{"id": null, "n": "0386051", "target": "#nkr_note_mod_0386051", "type": "mod", "text": "為【大】，〔－〕【宋】"}
{"id": null, "n": "0386052", "target": "#nkr_note_mod_0386052", "type": "mod", "text": "也【大】，〔－〕【宋】"}
{"id": null, "n": "0386053", "target": "#nkr_note_mod_0386053", "type": "mod", "text": "也【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0386054", "target": "#nkr_note_mod_0386054", "type": "mod", "text": "外【大】，前【宋】【元】【明】"}
{"id": null, "n": "0386055", "target": "#nkr_note_mod_0386055", "type": "mod", "text": "雇【大】，酬【宋】【元】【明】"}
{"id": null, "n": "0386056", "target": "#nkr_note_mod_0386056", "type": "mod", "text": "當【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0386057", "target": "#nkr_note_mod_0386057", "type": "mod", "text": "在【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0386058", "target": "#nkr_note_mod_0386058", "type": "mod", "text": "所【大】，因【明】"}
{"id": null, "n": "0386059", "target": "#nkr_note_mod_0386059", "type": "mod", "text": "佯【大】，徉【宋】【元】【明】"}
{"id": null, "n": "0386060", "target": "#nkr_note_mod_0386060", "type": "mod", "text": "樵【大】，樵薪【宋】【元】【明】"}
{"id": null, "n": "0386061", "target": "#nkr_note_mod_0386061", "type": "mod", "text": "父【大】，〔－〕【元】"}
{"id": null, "n": "0386062", "target": "#nkr_note_mod_0386062", "type": "mod", "text": "住【大】，立【元】【明】"}
{"id": null, "n": "0386063", "target": "#nkr_note_mod_0386063", "type": "mod", "text": "（觀見…悲痛）九字【大】，〔－〕【宋】"}
{"id": null, "n": "0386064", "target": "#nkr_note_mod_0386064", "type": "mod", "text": "痛【大】，疾【元】【明】"}
{"id": null, "n": "0386065", "target": "#nkr_note_mod_0386065", "type": "mod", "text": "太【大】，歎【宋】【元】【明】"}
{"id": null, "n": "0386066", "target": "#nkr_note_mod_0386066", "type": "mod", "text": "死【大】，樂死【元】【明】"}
{"id": null, "n": "0386067", "target": "#nkr_note_mod_0386067", "type": "mod", "text": "不【大】，不懷【元】【明】"}
{"id": null, "n": "0386068", "target": "#nkr_note_mod_0386068", "type": "mod", "text": "恨【大】，憂者【宋】"}
{"id": null, "n": "0386069", "target": "#nkr_note_mod_0386069", "type": "mod", "text": "莫【大】，無【宋】【元】【明】"}
{"id": null, "n": "0386070", "target": "#nkr_note_mod_0386070", "type": "mod", "text": "父報【大】，報父【宋】"}
{"id": null, "n": "0386071", "target": "#nkr_note_mod_0386071", "type": "mod", "text": "也即【大】，則【宋】【元】【明】"}
{"id": null, "n": "0386072", "target": "#nkr_note_mod_0386072", "type": "mod", "text": "憂【大】，憂也【宋】【元】【明】"}
{"id": null, "n": "0386073", "target": "#nkr_note_mod_0386073", "type": "mod", "text": "言【大】，言而【宋】【元】【明】"}
{"id": null, "n": "0386074", "target": "#nkr_note_mod_0386074", "type": "mod", "text": "見【大】，視【宋】【元】【明】"}
{"id": null, "n": "0386075", "target": "#nkr_note_mod_0386075", "type": "mod", "text": "自【大】，思【宋】【元】【明】"}
{"id": null, "n": "0386076", "target": "#nkr_note_mod_0386076", "type": "mod", "text": "園【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0386077", "target": "#nkr_note_mod_0386077", "type": "mod", "text": "見【大】，問【宋】【元】【明】"}
{"id": null, "n": "0386078", "target": "#nkr_note_mod_0386078", "type": "mod", "text": "問言【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0386079", "target": "#nkr_note_mod_0386079", "type": "mod", "text": "耶對【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0386080", "target": "#nkr_note_mod_0386080", "type": "mod", "text": "使【大】，便使【宋】【元】【明】"}
{"id": null, "n": "0386081", "target": "#nkr_note_mod_0386081", "type": "mod", "text": "食【大】，食飲食【宋】【元】【明】"}
{"id": null, "n": "0386082", "target": "#nkr_note_mod_0386082", "type": "mod", "text": "王【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0386083", "target": "#nkr_note_mod_0386083", "type": "mod", "text": "食【大】，飲食【宋】【元】【明】"}
{"id": null, "n": "0387001", "target": "#nkr_note_mod_0387001", "type": "mod", "text": "甘【大】，甚【宋】【元】【明】"}
{"id": null, "n": "0387002", "target": "#nkr_note_mod_0387002", "type": "mod", "text": "因【大】，王因【宋】【元】【明】"}
{"id": null, "n": "0387003", "target": "#nkr_note_mod_0387003", "type": "mod", "text": "臣【大】，大臣【宋】【元】【明】"}
{"id": null, "n": "0387004", "target": "#nkr_note_mod_0387004", "type": "mod", "text": "臣前賃【大】，前賃得【宋】【元】【明】"}
{"id": null, "n": "0387005", "target": "#nkr_note_mod_0387005", "type": "mod", "text": "呼【大】，呼現長生錄【宋】，呼錄【元】【明】"}
{"id": null, "n": "0387006", "target": "#nkr_note_mod_0387006", "type": "mod", "text": "宮【大】，官中【元】，宮中【明】"}
{"id": null, "n": "0387007", "target": "#nkr_note_mod_0387007", "type": "mod", "text": "王【大】，〔－〕【宋】【元】"}
{"id": null, "n": "0387008", "target": "#nkr_note_mod_0387008", "type": "mod", "text": "以【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0387009", "target": "#nkr_note_mod_0387009", "type": "mod", "text": "置【大】，著【宋】"}
{"id": null, "n": "0387010", "target": "#nkr_note_mod_0387010", "type": "mod", "text": "我【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0387011", "target": "#nkr_note_mod_0387011", "type": "mod", "text": "幸【大】，卿幸【宋】【元】【明】"}
{"id": null, "n": "0387012", "target": "#nkr_note_mod_0387012", "type": "mod", "text": "王【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0387013", "target": "#nkr_note_mod_0387013", "type": "mod", "text": "好【大】，好射【宋】【元】【明】"}
{"id": null, "n": "0387014", "target": "#nkr_note_mod_0387014", "type": "mod", "text": "少【大】，少小【宋】【元】【明】"}
{"id": null, "n": "0387015", "target": "#nkr_note_mod_0387015", "type": "mod", "text": "出行【大】，行遊【宋】【元】【明】"}
{"id": null, "n": "0387016", "target": "#nkr_note_mod_0387016", "type": "mod", "text": "惑【大】，或【宋】【元】【明】"}
{"id": null, "n": "0387017", "target": "#nkr_note_mod_0387017", "type": "mod", "text": "不能得出【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0387018", "target": "#nkr_note_mod_0387018", "type": "mod", "text": "日【大】，日不得出【宋】，日不得出路【元】【明】"}
{"id": null, "n": "0387019", "target": "#nkr_note_mod_0387019", "type": "mod", "text": "因【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0387020", "target": "#nkr_note_mod_0387020", "type": "mod", "text": "子【大】，方【宋】【元】【明】"}
{"id": null, "n": "0387021", "target": "#nkr_note_mod_0387021", "type": "mod", "text": "思惟【大】，念【宋】【元】【明】"}
{"id": null, "n": "0387022", "target": "#nkr_note_mod_0387022", "type": "mod", "text": "死【大】，死之【宋】【元】【明】"}
{"id": null, "n": "0387023", "target": "#nkr_note_mod_0387023", "type": "mod", "text": "懇懇【大】，慇懃【宋】【元】【明】"}
{"id": null, "n": "0387024", "target": "#nkr_note_mod_0387024", "type": "mod", "text": "絕歿之教【大】，之教非孝之也【宋】【元】【明】"}
{"id": null, "n": "0387025", "target": "#nkr_note_mod_0387025", "type": "mod", "text": "悟【大】＊，寤【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0387026", "target": "#nkr_note_mod_0387026", "type": "mod", "text": "問長生曰【大】，告曰【宋】【元】【明】"}
{"id": null, "n": "0387027", "target": "#nkr_note_mod_0387027", "type": "mod", "text": "是【大】，此【宋】【元】【明】"}
{"id": null, "n": "0387028", "target": "#nkr_note_mod_0387028", "type": "mod", "text": "還得【大】，即還【宋】【元】【明】"}
{"id": null, "n": "0387029", "target": "#nkr_note_mod_0387029", "type": "mod", "text": "思【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0387030", "target": "#nkr_note_mod_0387030", "type": "mod", "text": "曰【大】，言【宋】【元】【明】"}
{"id": null, "n": "0387031", "target": "#nkr_note_mod_0387031", "type": "mod", "text": "故【大】＊，〔－〕【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0387032", "target": "#nkr_note_mod_0387032", "type": "mod", "text": "復【大】，〔－〕【宋】"}
{"id": null, "n": "0387033", "target": "#nkr_note_mod_0387033", "type": "mod", "text": "畏【大】，畏懼【宋】【元】【明】"}
{"id": null, "n": "0387034", "target": "#nkr_note_mod_0387034", "type": "mod", "text": "我【大】，〔－〕【元】【明】"}
{"id": null, "n": "0387035", "target": "#nkr_note_mod_0387035", "type": "mod", "text": "赦【大】，意【宋】【元】【明】"}
{"id": null, "n": "0387036", "target": "#nkr_note_mod_0387036", "type": "mod", "text": "長生【大】，長生也【宋】【元】【明】"}
{"id": null, "n": "0387037", "target": "#nkr_note_mod_0387037", "type": "mod", "text": "實故【大】，故實【宋】【元】【明】"}
{"id": null, "n": "0387038", "target": "#nkr_note_mod_0387038", "type": "mod", "text": "怨【大】，讐耳【宋】【元】【明】"}
{"id": null, "n": "0387039", "target": "#nkr_note_mod_0387039", "type": "mod", "text": "死【大】，死之【宋】【元】【明】"}
{"id": null, "n": "0387040", "target": "#nkr_note_mod_0387040", "type": "mod", "text": "欲【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0387041", "target": "#nkr_note_mod_0387041", "type": "mod", "text": "教也【大】，之教【宋】【元】【明】"}
{"id": null, "n": "0387042", "target": "#nkr_note_mod_0387042", "type": "mod", "text": "斷絕也【大】，絕斷【宋】【元】【明】"}
{"id": null, "n": "0387043", "target": "#nkr_note_mod_0387043", "type": "mod", "text": "惟憶父言【大】，〔－〕【宋】"}
{"id": null, "n": "0387044", "target": "#nkr_note_mod_0387044", "type": "mod", "text": "厚【大】，淳【宋】【元】【明】"}
{"id": null, "n": "0387045", "target": "#nkr_note_mod_0387045", "type": "mod", "text": "也【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0387046", "target": "#nkr_note_mod_0387046", "type": "mod", "text": "怨【大】，讐【宋】【元】【明】"}
{"id": null, "n": "0387047", "target": "#nkr_note_mod_0387047", "type": "mod", "text": "我【大】，悟【宋】"}
{"id": null, "n": "0387048", "target": "#nkr_note_mod_0387048", "type": "mod", "text": "我【大】，〔－〕【元】【明】"}
{"id": null, "n": "0387049", "target": "#nkr_note_mod_0387049", "type": "mod", "text": "從今日始【大】，自今以後【宋】【元】【明】"}
{"id": null, "n": "0387050", "target": "#nkr_note_mod_0387050", "type": "mod", "text": "率【大】，引率【宋】【元】【明】"}
{"id": null, "n": "0387051", "target": "#nkr_note_mod_0387051", "type": "mod", "text": "物【大】，珍【宋】【元】【明】"}
{"id": null, "n": "0387052", "target": "#nkr_note_mod_0387052", "type": "mod", "text": "今【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0387053", "target": "#nkr_note_mod_0387053", "type": "mod", "text": "心【大】，意【宋】【元】【明】"}
{"id": null, "n": "0387054", "target": "#nkr_note_mod_0387054", "type": "mod", "text": "故【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0387055", "target": "#nkr_note_mod_0387055", "type": "mod", "text": "（佛為海船師…敬受頭面禮）四百字【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0388001", "target": "#nkr_note_mod_0388001", "type": "mod", "text": "長【大】，佛說長【元】【明】"}
{"id": null, "n": "0386001", "target": "#nkr_note_orig_0386001", "type": "orig", "text": "（佛說）＋長壽【元】【明】"}
{"id": null, "n": "0386002", "target": "#nkr_note_orig_0386002", "type": "orig", "text": "僧祐…西晉錄＝失譯【宋】，開元錄云安祐二錄並失譯師今附西晉第二出【元】【明】"}
{"id": null, "n": "0386003", "target": "#nkr_note_orig_0386003", "type": "orig", "text": "是＝爾【明】"}
{"id": null, "n": "0386004", "target": "#nkr_note_orig_0386004", "type": "orig", "text": "昔＋（者）【三】"}
{"id": null, "n": "0386005", "target": "#nkr_note_orig_0386005", "type": "orig", "text": "治國以政＝以正法治國無【三】"}
{"id": null, "n": "0386006", "target": "#nkr_note_orig_0386006", "type": "orig", "text": "熟＝饒【三】"}
{"id": null, "n": "0386007", "target": "#nkr_note_orig_0386007", "type": "orig", "text": "治＝法【三】"}
{"id": null, "n": "0386008", "target": "#nkr_note_orig_0386008", "type": "orig", "text": "豐＝富【三】"}
{"id": null, "n": "0386009", "target": "#nkr_note_orig_0386009", "type": "orig", "text": "往彼＝今往【三】"}
{"id": null, "n": "0386010", "target": "#nkr_note_orig_0386010", "type": "orig", "text": "行＝來【三】"}
{"id": null, "n": "0386011", "target": "#nkr_note_orig_0386011", "type": "orig", "text": "〔曰〕－【三】"}
{"id": null, "n": "0386012", "target": "#nkr_note_orig_0386012", "type": "orig", "text": "唯願備豫＝惟願豫願【三】"}
{"id": null, "n": "0386013", "target": "#nkr_note_orig_0386013", "type": "orig", "text": "召其＝即召【三】"}
{"id": null, "n": "0386014", "target": "#nkr_note_orig_0386014", "type": "orig", "text": "彼＝子【宋】"}
{"id": null, "n": "0386015", "target": "#nkr_note_orig_0386015", "type": "orig", "text": "傷＋（害）【三】"}
{"id": null, "n": "0386016", "target": "#nkr_note_orig_0386016", "type": "orig", "text": "距＝拒【三】＊"}
{"id": null, "n": "0386017", "target": "#nkr_note_orig_0386017", "type": "orig", "text": "長壽王…太子＝王告太子長生【三】"}
{"id": null, "n": "0386018", "target": "#nkr_note_orig_0386018", "type": "orig", "text": "〔彼貪我國故來攻我〕－【宋】"}
{"id": null, "n": "0386019", "target": "#nkr_note_orig_0386019", "type": "orig", "text": "〔而〕－【三】"}
{"id": null, "n": "0386020", "target": "#nkr_note_orig_0386020", "type": "orig", "text": "言＝曰【三】＊"}
{"id": null, "n": "0386021", "target": "#nkr_note_orig_0386021", "type": "orig", "text": "〔共〕－【宋】"}
{"id": null, "n": "0386022", "target": "#nkr_note_orig_0386022", "type": "orig", "text": "萬＋（雖能得者）【三】"}
{"id": null, "n": "0386023", "target": "#nkr_note_orig_0386023", "type": "orig", "text": "〔也〕－【三】"}
{"id": null, "n": "0386024", "target": "#nkr_note_orig_0386024", "type": "orig", "text": "婆羅門＋（曰）【三】"}
{"id": null, "n": "0386025", "target": "#nkr_note_orig_0386025", "type": "orig", "text": "之＝至【三】"}
{"id": null, "n": "0386026", "target": "#nkr_note_orig_0386026", "type": "orig", "text": "國＝方【三】"}
{"id": null, "n": "0386027", "target": "#nkr_note_orig_0386027", "type": "orig", "text": "士＋（也）【元】【明】"}
{"id": null, "n": "0386028", "target": "#nkr_note_orig_0386028", "type": "orig", "text": "周救＝賑極【宋】，賑拯【元】【明】"}
{"id": null, "n": "0386029", "target": "#nkr_note_orig_0386029", "type": "orig", "text": "羸＝窮【三】"}
{"id": null, "n": "0386030", "target": "#nkr_note_orig_0386030", "type": "orig", "text": "國＋（中）【三】"}
{"id": null, "n": "0386031", "target": "#nkr_note_orig_0386031", "type": "orig", "text": "也王默自念＝王為【宋】，王默念自念【元】【明】"}
{"id": null, "n": "0386032", "target": "#nkr_note_orig_0386032", "type": "orig", "text": "故＝快【三】"}
{"id": null, "n": "0386033", "target": "#nkr_note_orig_0386033", "type": "orig", "text": "可哀＝哀可【宋】"}
{"id": null, "n": "0386034", "target": "#nkr_note_orig_0386034", "type": "orig", "text": "垂淚＝涕泣【三】"}
{"id": null, "n": "0386035", "target": "#nkr_note_orig_0386035", "type": "orig", "text": "〔謂婆羅門〕－【宋】"}
{"id": null, "n": "0386036", "target": "#nkr_note_orig_0386036", "type": "orig", "text": "亡＋（來）【三】"}
{"id": null, "n": "0386037", "target": "#nkr_note_orig_0386037", "type": "orig", "text": "〔藏〕－【宋】"}
{"id": null, "n": "0386038", "target": "#nkr_note_orig_0386038", "type": "orig", "text": "〔聞〕－【三】"}
{"id": null, "n": "0386039", "target": "#nkr_note_orig_0386039", "type": "orig", "text": "空窮＝困乏【三】"}
{"id": null, "n": "0386040", "target": "#nkr_note_orig_0386040", "type": "orig", "text": "咽＝噎【三】＊"}
{"id": null, "n": "0386041", "target": "#nkr_note_orig_0386041", "type": "orig", "text": "啼泣＝涕淚【宋】"}
{"id": null, "n": "0386042", "target": "#nkr_note_orig_0386042", "type": "orig", "text": "慕＝募【三】"}
{"id": null, "n": "0386043", "target": "#nkr_note_orig_0386043", "type": "orig", "text": "以＝可取【三】"}
{"id": null, "n": "0386044", "target": "#nkr_note_orig_0386044", "type": "orig", "text": "賞＝償【宋】【元】"}
{"id": null, "n": "0386045", "target": "#nkr_note_orig_0386045", "type": "orig", "text": "曰＝言【三】"}
{"id": null, "n": "0386046", "target": "#nkr_note_orig_0386046", "type": "orig", "text": "（我）＋遙【三】"}
{"id": null, "n": "0386047", "target": "#nkr_note_orig_0386047", "type": "orig", "text": "遇＝值【三】"}
{"id": null, "n": "0386048", "target": "#nkr_note_orig_0386048", "type": "orig", "text": "乏＝窮【三】"}
{"id": null, "n": "0386049", "target": "#nkr_note_orig_0386049", "type": "orig", "text": "〔吾等當死願〕－【元】【明】"}
{"id": null, "n": "0386050", "target": "#nkr_note_orig_0386050", "type": "orig", "text": "以身相惠＝以相與【宋】"}
{"id": null, "n": "0386051", "target": "#nkr_note_orig_0386051", "type": "orig", "text": "〔為〕－【宋】"}
{"id": null, "n": "0386052", "target": "#nkr_note_orig_0386052", "type": "orig", "text": "〔也〕－【宋】"}
{"id": null, "n": "0386053", "target": "#nkr_note_orig_0386053", "type": "orig", "text": "〔也〕－【三】"}
{"id": null, "n": "0386054", "target": "#nkr_note_orig_0386054", "type": "orig", "text": "外＝前【三】"}
{"id": null, "n": "0386055", "target": "#nkr_note_orig_0386055", "type": "orig", "text": "雇＝酬【三】"}
{"id": null, "n": "0386056", "target": "#nkr_note_orig_0386056", "type": "orig", "text": "〔當〕－【三】"}
{"id": null, "n": "0386057", "target": "#nkr_note_orig_0386057", "type": "orig", "text": "〔在〕－【三】"}
{"id": null, "n": "0386058", "target": "#nkr_note_orig_0386058", "type": "orig", "text": "所＝因【明】"}
{"id": null, "n": "0386059", "target": "#nkr_note_orig_0386059", "type": "orig", "text": "佯＝徉【三】"}
{"id": null, "n": "0386060", "target": "#nkr_note_orig_0386060", "type": "orig", "text": "樵＋（薪）【三】"}
{"id": null, "n": "0386061", "target": "#nkr_note_orig_0386061", "type": "orig", "text": "〔父〕－【元】"}
{"id": null, "n": "0386062", "target": "#nkr_note_orig_0386062", "type": "orig", "text": "住＝立【元】【明】"}
{"id": null, "n": "0386063", "target": "#nkr_note_orig_0386063", "type": "orig", "text": "〔觀見…悲痛〕九字－【宋】"}
{"id": null, "n": "0386064", "target": "#nkr_note_orig_0386064", "type": "orig", "text": "痛＝疾【元】【明】"}
{"id": null, "n": "0386065", "target": "#nkr_note_orig_0386065", "type": "orig", "text": "太＝歎【三】"}
{"id": null, "n": "0386066", "target": "#nkr_note_orig_0386066", "type": "orig", "text": "（樂）＋死【元】【明】"}
{"id": null, "n": "0386067", "target": "#nkr_note_orig_0386067", "type": "orig", "text": "不＋（懷）【元】【明】"}
{"id": null, "n": "0386068", "target": "#nkr_note_orig_0386068", "type": "orig", "text": "太＝憂者【宋】"}
{"id": null, "n": "0386069", "target": "#nkr_note_orig_0386069", "type": "orig", "text": "莫＝無【三】"}
{"id": null, "n": "0386070", "target": "#nkr_note_orig_0386070", "type": "orig", "text": "父報＝報父【宋】"}
{"id": null, "n": "0386071", "target": "#nkr_note_orig_0386071", "type": "orig", "text": "也即＝則【三】"}
{"id": null, "n": "0386072", "target": "#nkr_note_orig_0386072", "type": "orig", "text": "憂＋（也）【三】"}
{"id": null, "n": "0386073", "target": "#nkr_note_orig_0386073", "type": "orig", "text": "言＋（而）【三】"}
{"id": null, "n": "0386074", "target": "#nkr_note_orig_0386074", "type": "orig", "text": "見＝視【三】"}
{"id": null, "n": "0386075", "target": "#nkr_note_orig_0386075", "type": "orig", "text": "自＝思【三】"}
{"id": null, "n": "0386076", "target": "#nkr_note_orig_0386076", "type": "orig", "text": "〔園〕－【三】"}
{"id": null, "n": "0386077", "target": "#nkr_note_orig_0386077", "type": "orig", "text": "見＝問【三】"}
{"id": null, "n": "0386078", "target": "#nkr_note_orig_0386078", "type": "orig", "text": "〔問言〕－【三】"}
{"id": null, "n": "0386079", "target": "#nkr_note_orig_0386079", "type": "orig", "text": "〔耶對〕－【三】"}
{"id": null, "n": "0386080", "target": "#nkr_note_orig_0386080", "type": "orig", "text": "（便）＋使【三】"}
{"id": null, "n": "0386081", "target": "#nkr_note_orig_0386081", "type": "orig", "text": "食＋（飲食）【三】"}
{"id": null, "n": "0386082", "target": "#nkr_note_orig_0386082", "type": "orig", "text": "〔王〕－【三】"}
{"id": null, "n": "0386083", "target": "#nkr_note_orig_0386083", "type": "orig", "text": "（飲）＋食【三】"}
{"id": null, "n": "0387001", "target": "#nkr_note_orig_0387001", "type": "orig", "text": "甘＝甚【三】"}
{"id": null, "n": "0387002", "target": "#nkr_note_orig_0387002", "type": "orig", "text": "（王）＋因【三】"}
{"id": null, "n": "0387003", "target": "#nkr_note_orig_0387003", "type": "orig", "text": "（大）＋臣【三】"}
{"id": null, "n": "0387004", "target": "#nkr_note_orig_0387004", "type": "orig", "text": "臣前賃＝前賃得【三】"}
{"id": null, "n": "0387005", "target": "#nkr_note_orig_0387005", "type": "orig", "text": "呼＋（現長生錄）【宋】，（錄）【元】【明】"}
{"id": null, "n": "0387006", "target": "#nkr_note_orig_0387006", "type": "orig", "text": "宮＝官中【元】，宮中【明】"}
{"id": null, "n": "0387007", "target": "#nkr_note_orig_0387007", "type": "orig", "text": "〔王〕－【宋】【元】"}
{"id": null, "n": "0387008", "target": "#nkr_note_orig_0387008", "type": "orig", "text": "〔以〕－【三】"}
{"id": null, "n": "0387009", "target": "#nkr_note_orig_0387009", "type": "orig", "text": "置＝著【宋】"}
{"id": null, "n": "0387010", "target": "#nkr_note_orig_0387010", "type": "orig", "text": "〔我〕－【三】"}
{"id": null, "n": "0387011", "target": "#nkr_note_orig_0387011", "type": "orig", "text": "（卿）＋幸【三】"}
{"id": null, "n": "0387012", "target": "#nkr_note_orig_0387012", "type": "orig", "text": "〔王〕－【三】"}
{"id": null, "n": "0387013", "target": "#nkr_note_orig_0387013", "type": "orig", "text": "好＋（射）【三】"}
{"id": null, "n": "0387014", "target": "#nkr_note_orig_0387014", "type": "orig", "text": "少＋（小）【三】"}
{"id": null, "n": "0387015", "target": "#nkr_note_orig_0387015", "type": "orig", "text": "出行＝行遊【三】"}
{"id": null, "n": "0387016", "target": "#nkr_note_orig_0387016", "type": "orig", "text": "惑＝或【三】"}
{"id": null, "n": "0387017", "target": "#nkr_note_orig_0387017", "type": "orig", "text": "〔不能得出〕－【三】"}
{"id": null, "n": "0387018", "target": "#nkr_note_orig_0387018", "type": "orig", "text": "日＋（不得出）【宋】，（不得出路）【元】【明】"}
{"id": null, "n": "0387019", "target": "#nkr_note_orig_0387019", "type": "orig", "text": "〔因〕－【三】"}
{"id": null, "n": "0387020", "target": "#nkr_note_orig_0387020", "type": "orig", "text": "子＝方【三】"}
{"id": null, "n": "0387021", "target": "#nkr_note_orig_0387021", "type": "orig", "text": "思惟＝念【三】"}
{"id": null, "n": "0387022", "target": "#nkr_note_orig_0387022", "type": "orig", "text": "死＋（之）【三】"}
{"id": null, "n": "0387023", "target": "#nkr_note_orig_0387023", "type": "orig", "text": "懇懇＝慇懃【三】"}
{"id": null, "n": "0387024", "target": "#nkr_note_orig_0387024", "type": "orig", "text": "絕歿之教＝之教非孝之也【三】"}
{"id": null, "n": "0387025", "target": "#nkr_note_orig_0387025", "type": "orig", "text": "悟＝寤【三】＊"}
{"id": null, "n": "0387026", "target": "#nkr_note_orig_0387026", "type": "orig", "text": "問長生曰＝告曰【三】"}
{"id": null, "n": "0387027", "target": "#nkr_note_orig_0387027", "type": "orig", "text": "是＝此【三】"}
{"id": null, "n": "0387028", "target": "#nkr_note_orig_0387028", "type": "orig", "text": "還得＝即還【三】"}
{"id": null, "n": "0387029", "target": "#nkr_note_orig_0387029", "type": "orig", "text": "〔思〕－【三】"}
{"id": null, "n": "0387030", "target": "#nkr_note_orig_0387030", "type": "orig", "text": "曰＝言【三】"}
{"id": null, "n": "0387031", "target": "#nkr_note_orig_0387031", "type": "orig", "text": "〔故〕－【三】＊"}
{"id": null, "n": "0387032", "target": "#nkr_note_orig_0387032", "type": "orig", "text": "〔復〕－【宋】"}
