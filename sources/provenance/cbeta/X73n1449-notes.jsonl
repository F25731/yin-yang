{"id": null, "n": null, "target": null, "type": null, "text": "劉誼翁請師住持疏附"}
{"id": null, "n": null, "target": null, "type": null, "text": "頃刻下雨"}
{"id": null, "n": null, "target": null, "type": null, "text": "字𫎇老"}
{"id": null, "n": null, "target": null, "type": null, "text": "野翁謁師偈附"}
{"id": null, "n": null, "target": null, "type": null, "text": "玅庵主詞附"}
{"id": null, "n": null, "target": null, "type": null, "text": "果然托生餘杭。"}
{"id": null, "n": null, "target": null, "type": null, "text": "𫎇老赴官晉陵別師詩附"}
{"id": null, "n": null, "target": null, "type": null, "text": "丁大夫呈師頌附"}
{"id": null, "n": null, "target": null, "type": null, "text": "單解元入山上師偈附"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本云：闍棃無可布施，施肚為汝作\n棺材。"}
