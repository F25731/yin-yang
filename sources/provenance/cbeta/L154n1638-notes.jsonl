{"id": null, "n": null, "target": null, "type": null, "text": "着"}
{"id": null, "n": null, "target": null, "type": null, "text": "着"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "去例切音𡳅息也"}
{"id": null, "n": null, "target": null, "type": null, "text": "虛嬌切音囂虛也"}
{"id": null, "n": null, "target": null, "type": null, "text": "徒刀切音陶如鼓而小持\n其柄搖之兩耳還自擊"}
{"id": null, "n": null, "target": null, "type": null, "text": "虛訝切音嚇缶燒善裂也"}
{"id": null, "n": null, "target": null, "type": null, "text": "側八切音札纏束也"}
{"id": null, "n": null, "target": null, "type": null, "text": "詩車切音奢火種也"}
{"id": null, "n": null, "target": null, "type": null, "text": "附"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "古委切音軌以表度日也"}
{"id": null, "n": null, "target": null, "type": null, "text": "株倫切音屯窀穸下棺也"}
{"id": null, "n": null, "target": null, "type": null, "text": "與倐同"}
{"id": null, "n": null, "target": null, "type": null, "text": "楚禁切㞚去聲前定徵兆之言也"}
{"id": null, "n": null, "target": null, "type": null, "text": "都念切音店士卑不得作但于室中為土\n坫以𢇮食"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡千切音賢𮈔絃也"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "J25nB170_p0494b05"}
