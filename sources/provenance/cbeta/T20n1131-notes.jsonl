{"id": null, "n": "0569004", "target": "#nkr_note_mod_0569004", "type": "mod", "text": "（西天…臣）十九字【大】，三藏大師【宋】【元】，宋三藏法師【明】"}
{"id": null, "n": "0570001", "target": "#nkr_note_mod_0570001", "type": "mod", "text": "提【大】，是【元】"}
{"id": null, "n": "0570002", "target": "#nkr_note_mod_0570002", "type": "mod", "text": "引【大】，引一【宋】【元】"}
{"id": null, "n": "0570003", "target": "#nkr_note_mod_0570003", "type": "mod", "text": "引【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0570004", "target": "#nkr_note_mod_0570004", "type": "mod", "text": "引【大】，〔－〕【元】【明】"}
{"id": null, "n": "0570005", "target": "#nkr_note_mod_0570005", "type": "mod", "text": "半【大】，二【明】"}
{"id": null, "n": "0570006", "target": "#nkr_note_mod_0570006", "type": "mod", "text": "二【大】，三【明】"}
{"id": null, "n": "0570007", "target": "#nkr_note_mod_0570007", "type": "mod", "text": "合【大】，合一【宋】【元】【明】"}
{"id": null, "n": "0570008", "target": "#nkr_note_mod_0570008", "type": "mod", "text": "引【大】，〔－〕【明】"}
{"id": null, "n": "0570009", "target": "#nkr_note_mod_0570009", "type": "mod", "text": "囉【大】，囉二合【宋】【元】【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0570010", "target": "#nkr_note_mod_0570010", "type": "mod", "text": "引【大】，〔－〕【元】【明】，引字宋本空白"}
{"id": null, "n": "0570011", "target": "#nkr_note_mod_0570011", "type": "mod", "text": "嚩【大】，嚩嚩【元】【明】"}
{"id": null, "n": "0570012", "target": "#nkr_note_mod_0570012", "type": "mod", "text": "上同【大】，〔－〕【明】"}
{"id": null, "n": "0570013", "target": "#nkr_note_mod_0570013", "type": "mod", "text": "二【大】，一【宋】"}
{"id": null, "n": "0570014", "target": "#nkr_note_mod_0570014", "type": "mod", "text": "𭔞【大】，𩕳【宋】【元】【明】"}
{"id": null, "n": "0570015", "target": "#nkr_note_mod_0570015", "type": "mod", "text": "當【大】，當引四【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引四"}
{"id": null, "n": "0570016", "target": "#nkr_note_mod_0570016", "type": "mod", "text": "切【大】，反【元】"}
{"id": null, "n": "0569003", "target": "#nkr_note_orig_0569003", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0569004", "target": "#nkr_note_orig_0569004", "type": "orig", "text": "（西天…臣）十九字＝（三藏大師）四字【宋】【元】，（宋三藏法師）五字【明】"}
{"id": null, "n": "0570001", "target": "#nkr_note_orig_0570001", "type": "orig", "text": "提＝是【元】"}
{"id": null, "n": "0570002", "target": "#nkr_note_orig_0570002", "type": "orig", "text": "引＋（一）【宋】【元】"}
{"id": null, "n": "0570003", "target": "#nkr_note_orig_0570003", "type": "orig", "text": "〔引〕－【三】"}
{"id": null, "n": "0570004", "target": "#nkr_note_orig_0570004", "type": "orig", "text": "〔引〕－【元】【明】"}
{"id": null, "n": "0570005", "target": "#nkr_note_orig_0570005", "type": "orig", "text": "半＝二【明】"}
{"id": null, "n": "0570006", "target": "#nkr_note_orig_0570006", "type": "orig", "text": "二＝三【明】"}
{"id": null, "n": "0570007", "target": "#nkr_note_orig_0570007", "type": "orig", "text": "合＋（一）【三】"}
{"id": null, "n": "0570008", "target": "#nkr_note_orig_0570008", "type": "orig", "text": "〔引〕－【明】"}
{"id": null, "n": "0570009", "target": "#nkr_note_orig_0570009", "type": "orig", "text": "囉＋（二合）夾註【三】"}
{"id": null, "n": "0570010", "target": "#nkr_note_orig_0570010", "type": "orig", "text": "〔引〕－【元】【明】，宋空白"}
{"id": null, "n": "0570011", "target": "#nkr_note_orig_0570011", "type": "orig", "text": "嚩＋（嚩）【元】【明】"}
{"id": null, "n": "0570012", "target": "#nkr_note_orig_0570012", "type": "orig", "text": "〔上同〕－【明】"}
{"id": null, "n": "0570013", "target": "#nkr_note_orig_0570013", "type": "orig", "text": "二＝一【宋】"}
{"id": null, "n": "0570014", "target": "#nkr_note_orig_0570014", "type": "orig", "text": "𭔞＝𩕳【三】"}
{"id": null, "n": "0570015", "target": "#nkr_note_orig_0570015", "type": "orig", "text": "當＋（引四）夾註【明】"}
{"id": null, "n": "0570016", "target": "#nkr_note_orig_0570016", "type": "orig", "text": "切＝反【元】"}
