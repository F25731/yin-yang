{"id": null, "n": "0427003", "target": "#nkr_note_mod_0427003", "type": "mod", "text": "描【CB】，苗【卍續】，苗與描通"}
{"id": null, "n": "0428001", "target": "#nkr_note_mod_0428001", "type": "mod", "text": "病【CB】，痛【卍續】，痛或病歟"}
{"id": null, "n": "0428002", "target": "#nkr_note_mod_0428002", "type": "mod", "text": "網【CB】，肋【卍續】，肋字原本不明"}
{"id": null, "n": "0428005", "target": "#nkr_note_mod_0428005", "type": "mod", "text": "興【CB】，與【卍續】，與疑興下同"}
{"id": null, "n": "0428006", "target": "#nkr_note_mod_0428006", "type": "mod", "text": "月【CB】，目【卍續】，目疑月"}
{"id": null, "n": "0429001", "target": "#nkr_note_mod_0429001", "type": "mod", "text": "國【CB】，因【卍續】，因原本書體不明或國歟"}
{"id": null, "n": "0429002", "target": "#nkr_note_mod_0429002", "type": "mod", "text": "［－］【CB】，收【卍續】，收字疑剩"}
{"id": null, "n": "0429003", "target": "#nkr_note_mod_0429003", "type": "mod", "text": "懷【CB】，壞【卍續】，壤疑懷"}
{"id": null, "n": "0430002", "target": "#nkr_note_mod_0430002", "type": "mod", "text": "而去【CB】，而者【卍續】，而者二字更勘者或去歟"}
{"id": null, "n": "0430004", "target": "#nkr_note_mod_0430004", "type": "mod", "text": "無【CB】，［－］【卍續】，際上疑脫無字"}
{"id": null, "n": "0431003", "target": "#nkr_note_mod_0431003", "type": "mod", "text": "以【CB】，沙【卍續】，沙疑諸或以"}
{"id": null, "n": "0431004", "target": "#nkr_note_mod_0431004", "type": "mod", "text": "［－］【CB】，逆【卍續】，逆字疑剩"}
{"id": null, "n": "0432001", "target": "#nkr_note_mod_0432001", "type": "mod", "text": "小【CB】，水【卍續】，水字更勘"}
{"id": null, "n": "0432002", "target": "#nkr_note_mod_0432002", "type": "mod", "text": "愚【CB】，盡【卍續】，盡疑愚"}
{"id": null, "n": "0432003", "target": "#nkr_note_mod_0432003", "type": "mod", "text": "知【CB】，智【卍續】，智疑知"}
{"id": null, "n": "0433001", "target": "#nkr_note_mod_0433001", "type": "mod", "text": "［－］【CB】，仗【卍續】，仗疑天耳"}
{"id": null, "n": "0433002", "target": "#nkr_note_mod_0433002", "type": "mod", "text": "杼栩又時諸反"}
{"id": null, "n": "0433003", "target": "#nkr_note_mod_0433003", "type": "mod", "text": "改【CB】，段【卍續】，段字更勘"}
{"id": null, "n": "0433007", "target": "#nkr_note_mod_0433007", "type": "mod", "text": "競【CB】，竟【卍續】，竟通競"}
{"id": null, "n": "0434001A", "target": "#nkr_note_mod_0434001A", "type": "mod", "text": "未【CB】，［－］【卍續】，歸字更勘"}
{"id": null, "n": "0434001B", "target": "#nkr_note_mod_0434001B", "type": "mod", "text": "恩【CB】，思【卍續】，思字更勘"}
{"id": null, "n": "0434002", "target": "#nkr_note_mod_0434002", "type": "mod", "text": "奔【CB】，本【卍續】，本疑奔"}
{"id": null, "n": "0434003", "target": "#nkr_note_mod_0434003", "type": "mod", "text": "妙【CB】，砂【卍續】，砂疑妙"}
{"id": null, "n": "0434005", "target": "#nkr_note_mod_0434005", "type": "mod", "text": "掌【CB】，甞【卍續】，甞疑掌下同"}
{"id": null, "n": "0434006", "target": "#nkr_note_mod_0434006", "type": "mod", "text": "［－］【CB】，視【卍續】，補入視字"}
{"id": null, "n": "0435002", "target": "#nkr_note_mod_0435002", "type": "mod", "text": "滅【CB】，減【卍續】，減疑滅"}
{"id": null, "n": "0436005", "target": "#nkr_note_mod_0436005", "type": "mod", "text": "列【CB】，別【卍續】，別疑列"}
{"id": null, "n": "0436008", "target": "#nkr_note_mod_0436008", "type": "mod", "text": "薩【CB】，提【卍續】，提疑薩更勘"}
{"id": null, "n": "0436010", "target": "#nkr_note_mod_0436010", "type": "mod", "text": "洹【CB】，源【卍續】，源疑洹"}
{"id": null, "n": "0437002", "target": "#nkr_note_mod_0437002", "type": "mod", "text": "縻【CB】，麼【卍續】，麼疑縻"}
