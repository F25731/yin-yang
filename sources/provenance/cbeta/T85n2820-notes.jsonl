{"id": null, "n": "1199001", "target": "#nkr_note_mod_1199001", "type": "mod", "text": "行【大】，如來等無二行禪定菩提眾生如來等無二行【考偽-大】"}
{"id": null, "n": "1200001", "target": "#nkr_note_mod_1200001", "type": "mod", "text": "障【大】，障碍【考偽-大】"}
{"id": null, "n": "1200002", "target": "#nkr_note_mod_1200002", "type": "mod", "text": "我【大】，亂【考偽-大】"}
{"id": null, "n": "1200003", "target": "#nkr_note_mod_1200003", "type": "mod", "text": "持【大】，持戒【考偽-大】"}
{"id": null, "n": "1200004", "target": "#nkr_note_mod_1200004", "type": "mod", "text": "法【大】，對治法【考偽-大】"}
{"id": null, "n": "1201001", "target": "#nkr_note_mod_1201001", "type": "mod", "text": "天【大】，天等【考偽-大】"}
{"id": null, "n": "1201002", "target": "#nkr_note_mod_1201002", "type": "mod", "text": "離【大】，淨【考偽-大】"}
{"id": null, "n": "1201003", "target": "#nkr_note_mod_1201003", "type": "mod", "text": "作【大】，作是【考偽-大】"}
{"id": null, "n": "1201004", "target": "#nkr_note_mod_1201004", "type": "mod", "text": "一【大】，於【考偽-大】"}
{"id": null, "n": "1201005", "target": "#nkr_note_mod_1201005", "type": "mod", "text": "薩【大】，薩作是念【考偽-大】"}
{"id": null, "n": "1201006", "target": "#nkr_note_mod_1201006", "type": "mod", "text": "二【大】，不【考偽-大】"}
{"id": null, "n": "1201007", "target": "#nkr_note_mod_1201007", "type": "mod", "text": "精【大】，精進【考偽-大】"}
{"id": null, "n": "1202001", "target": "#nkr_note_mod_1202001", "type": "mod", "text": "言【大】，觀【考偽-大】"}
{"id": null, "n": "1202002", "target": "#nkr_note_mod_1202002", "type": "mod", "text": "常【大】，永【考偽-大】"}
{"id": null, "n": "1202003", "target": "#nkr_note_mod_1202003", "type": "mod", "text": "在【大】，莊【考偽-大】"}
{"id": null, "n": "1202004", "target": "#nkr_note_mod_1202004", "type": "mod", "text": "解【大】，善解【考偽-大】"}
{"id": null, "n": "1202005", "target": "#nkr_note_mod_1202005", "type": "mod", "text": "諸【大】，諸經論【考偽-大】"}
{"id": null, "n": "1204001", "target": "#nkr_note_mod_1204001", "type": "mod", "text": "能【大】，不能【考偽-大】"}
{"id": null, "n": "1197004", "target": "#nkr_note_orig_1197004", "type": "orig", "text": "【原】大谷大學藏燉煌本，首題新加"}
{"id": null, "n": "1197005", "target": "#nkr_note_orig_1197005", "type": "orig", "text": "首缺"}
{"id": null, "n": "1199001", "target": "#nkr_note_orig_1199001", "type": "orig", "text": "（如來等無二行禪定菩提眾生如來等無二）＋行？"}
{"id": null, "n": "1200001", "target": "#nkr_note_orig_1200001", "type": "orig", "text": "障＋（碍）？"}
{"id": null, "n": "1200002", "target": "#nkr_note_orig_1200002", "type": "orig", "text": "我＝亂？"}
{"id": null, "n": "1200003", "target": "#nkr_note_orig_1200003", "type": "orig", "text": "持＋（戒）？"}
{"id": null, "n": "1200004", "target": "#nkr_note_orig_1200004", "type": "orig", "text": "（對治）＋法？"}
{"id": null, "n": "1201001", "target": "#nkr_note_orig_1201001", "type": "orig", "text": "天＋（等）？"}
{"id": null, "n": "1201002", "target": "#nkr_note_orig_1201002", "type": "orig", "text": "離＝淨？"}
{"id": null, "n": "1201003", "target": "#nkr_note_orig_1201003", "type": "orig", "text": "作＋（是）？"}
{"id": null, "n": "1201004", "target": "#nkr_note_orig_1201004", "type": "orig", "text": "一＝於？"}
{"id": null, "n": "1201005", "target": "#nkr_note_orig_1201005", "type": "orig", "text": "薩＋（作是念）？"}
{"id": null, "n": "1201006", "target": "#nkr_note_orig_1201006", "type": "orig", "text": "二＝不？"}
{"id": null, "n": "1201007", "target": "#nkr_note_orig_1201007", "type": "orig", "text": "精＋（進）？"}
{"id": null, "n": "1202001", "target": "#nkr_note_orig_1202001", "type": "orig", "text": "言＝觀？"}
{"id": null, "n": "1202002", "target": "#nkr_note_orig_1202002", "type": "orig", "text": "常＝永？"}
{"id": null, "n": "1202003", "target": "#nkr_note_orig_1202003", "type": "orig", "text": "在＝莊？"}
{"id": null, "n": "1202004", "target": "#nkr_note_orig_1202004", "type": "orig", "text": "（善）＋解？"}
{"id": null, "n": "1202005", "target": "#nkr_note_orig_1202005", "type": "orig", "text": "諸＋（經論）？"}
{"id": null, "n": "1204001", "target": "#nkr_note_orig_1204001", "type": "orig", "text": "（不）＋能？"}
{"id": null, "n": "1201b2201", "target": "#nkr_note_add_1201b2201", "type": "add", "text": "師【CB】，歸【大】"}
{"id": null, "n": "1202a1701", "target": "#nkr_note_add_1202a1701", "type": "add", "text": "輕【CB】，經【大】"}
