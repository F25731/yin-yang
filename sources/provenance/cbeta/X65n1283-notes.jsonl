{"id": null, "n": null, "target": null, "type": null, "text": "洞山文"}
{"id": null, "n": null, "target": null, "type": null, "text": "即七覺八正等"}
{"id": null, "n": null, "target": null, "type": null, "text": "見天然昱語錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "三山來云：人指學者。"}
{"id": null, "n": null, "target": null, "type": null, "text": "三山云：指師家法。"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦名金針\n雙鎖"}
{"id": null, "n": null, "target": null, "type": null, "text": "古轍作挾"}
{"id": null, "n": null, "target": null, "type": null, "text": "有作暗"}
{"id": null, "n": null, "target": null, "type": null, "text": "一"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "三"}
{"id": null, "n": null, "target": null, "type": null, "text": "四"}
{"id": null, "n": null, "target": null, "type": null, "text": "五"}
{"id": null, "n": null, "target": null, "type": null, "text": "放"}
{"id": null, "n": null, "target": null, "type": null, "text": "收"}
{"id": null, "n": null, "target": null, "type": null, "text": "明"}
{"id": null, "n": null, "target": null, "type": null, "text": "瞎"}
{"id": null, "n": null, "target": null, "type": null, "text": "音幹"}
{"id": null, "n": null, "target": null, "type": null, "text": "二打謂打克符普化"}
{"id": null, "n": null, "target": null, "type": null, "text": "臨濟三聖大覺"}
{"id": null, "n": null, "target": null, "type": null, "text": "高峰聖云：春風猶未至，先綻一枝梅。"}
{"id": null, "n": null, "target": null, "type": null, "text": "聖云：雲收霧卷青天碧，腦後雷轟過九洲。"}
{"id": null, "n": null, "target": null, "type": null, "text": "聖云：換去乾上九畫，長坤下畫。"}
{"id": null, "n": null, "target": null, "type": null, "text": "聖云：紅日纔舒影，青\n雲隨後遮。"}
{"id": null, "n": null, "target": null, "type": null, "text": "或作\n意"}
{"id": null, "n": null, "target": null, "type": null, "text": "起時"}
{"id": null, "n": null, "target": null, "type": null, "text": "聲味"}
{"id": null, "n": null, "target": null, "type": null, "text": "邊全"}
{"id": null, "n": null, "target": null, "type": null, "text": "言積習"}
{"id": null, "n": null, "target": null, "type": null, "text": "以"}
{"id": null, "n": null, "target": null, "type": null, "text": "根對"}
{"id": null, "n": null, "target": null, "type": null, "text": "境了"}
{"id": null, "n": null, "target": null, "type": null, "text": "而"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
