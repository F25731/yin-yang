{"id": null, "n": null, "target": null, "type": null, "text": "從《無相論》出"}
{"id": null, "n": null, "target": null, "type": null, "text": "義疏九識第三合簡文義有兩：一明識體、二明識用。一識體者，出《唯\n識論》"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K17n0611_p0494a14"}
{"id": null, "n": "0878010", "target": "#nkr_note_mod_0878010", "type": "mod", "text": "一卷【大】，〔－〕【明】"}
{"id": null, "n": "0878011", "target": "#nkr_note_mod_0878011", "type": "mod", "text": "真諦三藏【大】，陳天竺三藏法師真諦【宋】【元】【明】【宮】"}
{"id": null, "n": "0878013", "target": "#nkr_note_mod_0878013", "type": "mod", "text": "輪轉【大】，轉輪【宋】【元】【明】【宮】"}
{"id": null, "n": "0879001", "target": "#nkr_note_mod_0879001", "type": "mod", "text": "品【大】，種【宋】【元】【明】【宮】"}
{"id": null, "n": "0879002", "target": "#nkr_note_mod_0879002", "type": "mod", "text": "大【大】，一【宮】"}
{"id": null, "n": "0879003", "target": "#nkr_note_mod_0879003", "type": "mod", "text": "乖【大】，乘【元】【明】【宮】"}
{"id": null, "n": "0879004", "target": "#nkr_note_mod_0879004", "type": "mod", "text": "熏【大】，勳【宋】【元】【明】【宮】"}
{"id": null, "n": "0879005", "target": "#nkr_note_mod_0879005", "type": "mod", "text": "五【大】，亦【宋】【元】【明】"}
{"id": null, "n": "0880001", "target": "#nkr_note_mod_0880001", "type": "mod", "text": "是故【大】，故是【宋】【元】【明】【宮】"}
{"id": null, "n": "0880002", "target": "#nkr_note_mod_0880002", "type": "mod", "text": "是【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0880003", "target": "#nkr_note_mod_0880003", "type": "mod", "text": "貪【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0880004", "target": "#nkr_note_mod_0880004", "type": "mod", "text": "自【大】，正【宋】【元】【明】【宮】"}
{"id": null, "n": "0880005", "target": "#nkr_note_mod_0880005", "type": "mod", "text": "直【大】，真【宋】【元】【明】"}
{"id": null, "n": "0880006", "target": "#nkr_note_mod_0880006", "type": "mod", "text": "二【大】，三【宋】【元】【明】【宮】"}
{"id": null, "n": "0880007", "target": "#nkr_note_mod_0880007", "type": "mod", "text": "變【大】，二者變【宋】【元】【明】【宮】"}
{"id": null, "n": "0880008", "target": "#nkr_note_mod_0880008", "type": "mod", "text": "唯【大】，唯有【宋】【元】【明】【宮】"}
{"id": null, "n": "0880009", "target": "#nkr_note_mod_0880009", "type": "mod", "text": "雜【大】，離【宋】【元】【明】"}
{"id": null, "n": "0880010", "target": "#nkr_note_mod_0880010", "type": "mod", "text": "顯【大】，顯現【宋】【元】【明】【宮】"}
{"id": null, "n": "0880011", "target": "#nkr_note_mod_0880011", "type": "mod", "text": "塵【大】，塵塵【宋】【元】【明】【宮】"}
{"id": null, "n": "0880012", "target": "#nkr_note_mod_0880012", "type": "mod", "text": "祇【大】，耆【宋】【元】【明】【宮】"}
{"id": null, "n": "0880013", "target": "#nkr_note_mod_0880013", "type": "mod", "text": "斗【大】，汁【宮】"}
{"id": null, "n": "0880014", "target": "#nkr_note_mod_0880014", "type": "mod", "text": "洛【大】，活【宋】【元】【明】【宮】"}
{"id": null, "n": "0880015", "target": "#nkr_note_mod_0880015", "type": "mod", "text": "鬚【大】＊，鬘【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0881001", "target": "#nkr_note_mod_0881001", "type": "mod", "text": "同【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0881002", "target": "#nkr_note_mod_0881002", "type": "mod", "text": "慾【大】，欲【宋】【元】【明】【宮】"}
{"id": null, "n": "0881003", "target": "#nkr_note_mod_0881003", "type": "mod", "text": "不得是有故【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0881004", "target": "#nkr_note_mod_0881004", "type": "mod", "text": "生【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0881005", "target": "#nkr_note_mod_0881005", "type": "mod", "text": "生【大】，是生【宋】【元】【明】【宮】"}
{"id": null, "n": "0881006", "target": "#nkr_note_mod_0881006", "type": "mod", "text": "境【大】，界【宋】【元】【明】【宮】"}
{"id": null, "n": "0881007", "target": "#nkr_note_mod_0881007", "type": "mod", "text": "生【大】，吐【宮】"}
{"id": null, "n": "0881008", "target": "#nkr_note_mod_0881008", "type": "mod", "text": "阿【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0881009", "target": "#nkr_note_mod_0881009", "type": "mod", "text": "以【大】，二【宋】【元】【明】"}
{"id": null, "n": "0881010", "target": "#nkr_note_mod_0881010", "type": "mod", "text": "故【大】，故故【宋】【元】【明】【宮】"}
{"id": null, "n": "0881011", "target": "#nkr_note_mod_0881011", "type": "mod", "text": "二【大】，二者【宋】【元】【明】【宮】"}
{"id": null, "n": "0881012", "target": "#nkr_note_mod_0881012", "type": "mod", "text": "則【大】，即【宋】【元】【明】【宮】"}
{"id": null, "n": "0881013", "target": "#nkr_note_mod_0881013", "type": "mod", "text": "熏習【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0881014", "target": "#nkr_note_mod_0881014", "type": "mod", "text": "名【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0881015", "target": "#nkr_note_mod_0881015", "type": "mod", "text": "緣【大】，起【宋】【元】【明】【宮】"}
{"id": null, "n": "0882001", "target": "#nkr_note_mod_0882001", "type": "mod", "text": "備修【大】，修此【宋】【元】【明】【宮】"}
{"id": null, "n": "0882002", "target": "#nkr_note_mod_0882002", "type": "mod", "text": "生【大】，生者【宋】【元】【明】【宮】"}
{"id": null, "n": "0882003", "target": "#nkr_note_mod_0882003", "type": "mod", "text": "沙【大】，法【明】"}
{"id": null, "n": "0882004", "target": "#nkr_note_mod_0882004", "type": "mod", "text": "坌【大】，墳【宮】"}
{"id": null, "n": "0882005", "target": "#nkr_note_mod_0882005", "type": "mod", "text": "若【大】，善【宋】【元】【明】【宮】"}
{"id": null, "n": "0882006", "target": "#nkr_note_mod_0882006", "type": "mod", "text": "也【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0882007", "target": "#nkr_note_mod_0882007", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0882008", "target": "#nkr_note_mod_0882008", "type": "mod", "text": "（今言…為語）十字【大】，〔－〕【宮】"}
{"id": null, "n": "0882009", "target": "#nkr_note_mod_0882009", "type": "mod", "text": "也【大】，也顯識竟【宮】"}
{"id": null, "n": "0878010", "target": "#nkr_note_orig_0878010", "type": "orig", "text": "〔一卷〕－【明】"}
{"id": null, "n": "0878011", "target": "#nkr_note_orig_0878011", "type": "orig", "text": "真諦三藏＝陳天竺三藏法師真諦【三】【宮】"}
{"id": null, "n": "0878012", "target": "#nkr_note_orig_0878012", "type": "orig", "text": "一切前行宋元明宮本俱有顯識品之三字"}
{"id": null, "n": "0878013", "target": "#nkr_note_orig_0878013", "type": "orig", "text": "輪轉＝轉輪【三】【宮】"}
{"id": null, "n": "0879001", "target": "#nkr_note_orig_0879001", "type": "orig", "text": "品＝種【三】【宮】"}
{"id": null, "n": "0879002", "target": "#nkr_note_orig_0879002", "type": "orig", "text": "大＝一【宮】"}
{"id": null, "n": "0879003", "target": "#nkr_note_orig_0879003", "type": "orig", "text": "乖＝乘【元】【明】【宮】"}
{"id": null, "n": "0879004", "target": "#nkr_note_orig_0879004", "type": "orig", "text": "熏＝勳【三】【宮】"}
{"id": null, "n": "0879005", "target": "#nkr_note_orig_0879005", "type": "orig", "text": "五＝亦【三】"}
{"id": null, "n": "0880001", "target": "#nkr_note_orig_0880001", "type": "orig", "text": "是故＝故是【三】【宮】"}
{"id": null, "n": "0880002", "target": "#nkr_note_orig_0880002", "type": "orig", "text": "〔是〕－【三】【宮】"}
{"id": null, "n": "0880003", "target": "#nkr_note_orig_0880003", "type": "orig", "text": "〔貪〕－【三】【宮】"}
{"id": null, "n": "0880004", "target": "#nkr_note_orig_0880004", "type": "orig", "text": "自＝正【三】【宮】"}
{"id": null, "n": "0880005", "target": "#nkr_note_orig_0880005", "type": "orig", "text": "直＝真【三】"}
{"id": null, "n": "0880006", "target": "#nkr_note_orig_0880006", "type": "orig", "text": "二＝三【三】【宮】"}
{"id": null, "n": "0880007", "target": "#nkr_note_orig_0880007", "type": "orig", "text": "（二者）＋變【三】【宮】"}
{"id": null, "n": "0880008", "target": "#nkr_note_orig_0880008", "type": "orig", "text": "唯＋（有）【三】【宮】"}
{"id": null, "n": "0880009", "target": "#nkr_note_orig_0880009", "type": "orig", "text": "雜＝離【三】"}
{"id": null, "n": "0880010", "target": "#nkr_note_orig_0880010", "type": "orig", "text": "顯＋（現）【三】【宮】"}
{"id": null, "n": "0880011", "target": "#nkr_note_orig_0880011", "type": "orig", "text": "塵＋（塵）【三】【宮】"}
{"id": null, "n": "0880012", "target": "#nkr_note_orig_0880012", "type": "orig", "text": "祇＝耆【三】【宮】"}
{"id": null, "n": "0880013", "target": "#nkr_note_orig_0880013", "type": "orig", "text": "斗＝汁【宮】"}
{"id": null, "n": "0880014", "target": "#nkr_note_orig_0880014", "type": "orig", "text": "洛＝活【三】【宮】"}
{"id": null, "n": "0880015", "target": "#nkr_note_orig_0880015", "type": "orig", "text": "鬚＝鬘【三】【宮】＊"}
{"id": null, "n": "0881001", "target": "#nkr_note_orig_0881001", "type": "orig", "text": "〔同〕－【三】"}
{"id": null, "n": "0881002", "target": "#nkr_note_orig_0881002", "type": "orig", "text": "慾＝欲【三】【宮】"}
{"id": null, "n": "0881003", "target": "#nkr_note_orig_0881003", "type": "orig", "text": "〔不得是有故〕－【三】【宮】"}
{"id": null, "n": "0881004", "target": "#nkr_note_orig_0881004", "type": "orig", "text": "〔生〕－【三】【宮】"}
{"id": null, "n": "0881005", "target": "#nkr_note_orig_0881005", "type": "orig", "text": "（是）＋生【三】【宮】"}
{"id": null, "n": "0881006", "target": "#nkr_note_orig_0881006", "type": "orig", "text": "境＝界【三】【宮】"}
{"id": null, "n": "0881007", "target": "#nkr_note_orig_0881007", "type": "orig", "text": "生＝吐【宮】"}
{"id": null, "n": "0881008", "target": "#nkr_note_orig_0881008", "type": "orig", "text": "〔阿〕－【三】【宮】"}
{"id": null, "n": "0881009", "target": "#nkr_note_orig_0881009", "type": "orig", "text": "以＝二【三】"}
{"id": null, "n": "0881010", "target": "#nkr_note_orig_0881010", "type": "orig", "text": "故＋（故）【三】【宮】"}
{"id": null, "n": "0881011", "target": "#nkr_note_orig_0881011", "type": "orig", "text": "二＋（者）【三】【宮】"}
{"id": null, "n": "0881012", "target": "#nkr_note_orig_0881012", "type": "orig", "text": "則＝即【三】【宮】"}
{"id": null, "n": "0881013", "target": "#nkr_note_orig_0881013", "type": "orig", "text": "〔熏習〕－【三】【宮】"}
{"id": null, "n": "0881014", "target": "#nkr_note_orig_0881014", "type": "orig", "text": "〔名〕－【三】【宮】"}
{"id": null, "n": "0881015", "target": "#nkr_note_orig_0881015", "type": "orig", "text": "緣＝起【三】【宮】"}
{"id": null, "n": "0882001", "target": "#nkr_note_orig_0882001", "type": "orig", "text": "備修＝修此【三】【宮】"}
{"id": null, "n": "0882002", "target": "#nkr_note_orig_0882002", "type": "orig", "text": "生＋（者）【三】【宮】"}
{"id": null, "n": "0882003", "target": "#nkr_note_orig_0882003", "type": "orig", "text": "沙＝法【明】"}
{"id": null, "n": "0882004", "target": "#nkr_note_orig_0882004", "type": "orig", "text": "坌＝墳【宮】"}
{"id": null, "n": "0882005", "target": "#nkr_note_orig_0882005", "type": "orig", "text": "若＝善【三】【宮】"}
{"id": null, "n": "0882006", "target": "#nkr_note_orig_0882006", "type": "orig", "text": "〔也〕－【三】【宮】"}
{"id": null, "n": "0882007", "target": "#nkr_note_orig_0882007", "type": "orig", "text": "〔有〕－【三】【宮】"}
{"id": null, "n": "0882008", "target": "#nkr_note_orig_0882008", "type": "orig", "text": "〔今言…為語〕十字－【宮】"}
{"id": null, "n": "0882009", "target": "#nkr_note_orig_0882009", "type": "orig", "text": "也＋（顯識竟）【宮】"}
{"id": null, "n": "0880c2401", "target": "#nkr_note_add_0880c2401", "type": "add", "text": "失【大】，朱【麗-CB】"}
