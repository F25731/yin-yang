{"id": null, "n": "0080004", "target": "#nkr_note_mod_0080004", "type": "mod", "text": "西天譯經【大】，〔－〕【宋】【元】，宋西天譯經【明】"}
{"id": null, "n": "0080005", "target": "#nkr_note_mod_0080005", "type": "mod", "text": "（朝散…臣）十三字【大】，法師【宋】【元】"}
{"id": null, "n": "0080006", "target": "#nkr_note_mod_0080006", "type": "mod", "text": "於【大】＊，于【明】＊"}
{"id": null, "n": "0080007", "target": "#nkr_note_mod_0080007", "type": "mod", "text": "志【大】，至【元】【明】"}
{"id": null, "n": "0080008", "target": "#nkr_note_mod_0080008", "type": "mod", "text": "婆【大】＊，媻【明】＊"}
{"id": null, "n": "0080003", "target": "#nkr_note_orig_0080003", "type": "orig", "text": "【原】麗本"}
{"id": null, "n": "0080004", "target": "#nkr_note_orig_0080004", "type": "orig", "text": "〔西天譯經〕－【宋】【元】，（宋）＋西【明】"}
{"id": null, "n": "0080005", "target": "#nkr_note_orig_0080005", "type": "orig", "text": "（朝散…臣）十三字＝（法師）二字【宋】【元】"}
{"id": null, "n": "0080006", "target": "#nkr_note_orig_0080006", "type": "orig", "text": "於＝于【明】＊"}
