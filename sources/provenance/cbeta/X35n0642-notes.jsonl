{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "上皆輔行"}
{"id": null, "n": null, "target": null, "type": null, "text": "即北方多聞天王之室也"}
{"id": null, "n": null, "target": null, "type": null, "text": "逝宮即梵王宮，外道計彼為常，\n佛為破彼，故稱逝宮"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T34n1726_p0878b12"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "U219n1398_p0349a07"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "U219n1398_p0372a02"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "T34n1727_p0920c10"}
{"id": null, "n": "0061001A", "target": "#nkr_note_mod_0061001A", "type": "mod", "text": "大字依論補訂"}
{"id": null, "n": "0061001B", "target": "#nkr_note_mod_0061001B", "type": "mod", "text": "穀字依論補訂"}
{"id": null, "n": "0027001", "target": "#nkr_note_orig_0027001", "type": "orig", "text": "他疑地"}
{"id": null, "n": "0028001", "target": "#nkr_note_orig_0028001", "type": "orig", "text": "永有有存舊補不永寂東春作不乖寂"}
{"id": null, "n": "0028002", "target": "#nkr_note_orig_0028002", "type": "orig", "text": "涯東春作害"}
{"id": null, "n": "0028003", "target": "#nkr_note_orig_0028003", "type": "orig", "text": "趣東春作輒"}
{"id": null, "n": "0028004", "target": "#nkr_note_orig_0028004", "type": "orig", "text": "阿下一有利字東春同又評之"}
{"id": null, "n": "0029001", "target": "#nkr_note_orig_0029001", "type": "orig", "text": "心東春作文章"}
{"id": null, "n": "0029002", "target": "#nkr_note_orig_0029002", "type": "orig", "text": "故下舊有稱字"}
{"id": null, "n": "0030001", "target": "#nkr_note_orig_0030001", "type": "orig", "text": "乘以人法舊作不以人法記釋玅顯"}
{"id": null, "n": "0033001", "target": "#nkr_note_orig_0033001", "type": "orig", "text": "出經在生上有不字人經乘"}
{"id": null, "n": "0033002", "target": "#nkr_note_orig_0033002", "type": "orig", "text": "別一作後"}
{"id": null, "n": "0036001", "target": "#nkr_note_orig_0036001", "type": "orig", "text": "此二二字原本脫今依一本復"}
{"id": null, "n": "0036002", "target": "#nkr_note_orig_0036002", "type": "orig", "text": "無常二字原本脫今本依古補"}
{"id": null, "n": "0036003", "target": "#nkr_note_orig_0036003", "type": "orig", "text": "愛下原本有得多二字今依古除"}
{"id": null, "n": "0039001", "target": "#nkr_note_orig_0039001", "type": "orig", "text": "謂緣緣論作諸四論因"}
{"id": null, "n": "0040001", "target": "#nkr_note_orig_0040001", "type": "orig", "text": "惱經作慳"}
{"id": null, "n": "0040002", "target": "#nkr_note_orig_0040002", "type": "orig", "text": "此經作諸"}
{"id": null, "n": "0047001", "target": "#nkr_note_orig_0047001", "type": "orig", "text": "緣因原因緣今依舊訂"}
{"id": null, "n": "0048001", "target": "#nkr_note_orig_0048001", "type": "orig", "text": "畢上經有憂字"}
{"id": null, "n": "0049001", "target": "#nkr_note_orig_0049001", "type": "orig", "text": "苦者原作若名今從舊"}
{"id": null, "n": "0051001", "target": "#nkr_note_orig_0051001", "type": "orig", "text": "故原本後今依一復"}
{"id": null, "n": "0053001", "target": "#nkr_note_orig_0053001", "type": "orig", "text": "附恐紨錯"}
{"id": null, "n": "0056001", "target": "#nkr_note_orig_0056001", "type": "orig", "text": "空相恐寫倒"}
{"id": null, "n": "0058001", "target": "#nkr_note_orig_0058001", "type": "orig", "text": "意原音今依舊改"}
{"id": null, "n": "0058002", "target": "#nkr_note_orig_0058002", "type": "orig", "text": "偏局偏原徧今依和"}
{"id": null, "n": "0059001", "target": "#nkr_note_orig_0059001", "type": "orig", "text": "智下二原三今依古改"}
{"id": null, "n": "0060001", "target": "#nkr_note_orig_0060001", "type": "orig", "text": "初下應有或可下約四字"}
{"id": null, "n": "0061001A", "target": "#nkr_note_orig_0061001A", "type": "orig", "text": "大穀二字依論補訂"}
{"id": null, "n": "0061001B", "target": "#nkr_note_orig_0061001B", "type": "orig", "text": "大穀二字依論補訂"}
{"id": null, "n": "0061002", "target": "#nkr_note_orig_0061002", "type": "orig", "text": "六上恐脫字或行或加"}
{"id": null, "n": "0066001", "target": "#nkr_note_orig_0066001", "type": "orig", "text": "二如是之上疑脫科應有二如是下重提譬顯法初提譬或記對釋之本無上二句"}
{"id": null, "n": "0066002", "target": "#nkr_note_orig_0066002", "type": "orig", "text": "減疑滅"}
{"id": null, "n": "0066003", "target": "#nkr_note_orig_0066003", "type": "orig", "text": "別字依一補成"}
{"id": null, "n": "0069001", "target": "#nkr_note_orig_0069001", "type": "orig", "text": "空如原如空今依經并記訂"}
{"id": null, "n": "0070001", "target": "#nkr_note_orig_0070001", "type": "orig", "text": "在一作存次行在同"}
{"id": null, "n": "0072001", "target": "#nkr_note_orig_0072001", "type": "orig", "text": "慈悲慈原心依東春訂"}
{"id": null, "n": "0079001", "target": "#nkr_note_orig_0079001", "type": "orig", "text": "普字取東春引成文"}
{"id": null, "n": "0079002", "target": "#nkr_note_orig_0079002", "type": "orig", "text": "切下東春有種智二字"}
{"id": null, "n": "0080001", "target": "#nkr_note_orig_0080001", "type": "orig", "text": "慧舊本作惠"}
{"id": null, "n": "0080002", "target": "#nkr_note_orig_0080002", "type": "orig", "text": "來原脫今依古"}
{"id": null, "n": "0082001", "target": "#nkr_note_orig_0082001", "type": "orig", "text": "故下一有須字"}
{"id": null, "n": "0083001", "target": "#nkr_note_orig_0083001", "type": "orig", "text": "所應下恐脫而字"}
{"id": null, "n": "0085001", "target": "#nkr_note_orig_0085001", "type": "orig", "text": "傳下一有弘字東春作弘"}
{"id": null, "n": "0085002", "target": "#nkr_note_orig_0085002", "type": "orig", "text": "師上一有法字東春同"}
{"id": null, "n": "0085003", "target": "#nkr_note_orig_0085003", "type": "orig", "text": "開顯權實東春作開權顯實"}
{"id": null, "n": "0085004", "target": "#nkr_note_orig_0085004", "type": "orig", "text": "是一作示東春同"}
{"id": null, "n": "0085005", "target": "#nkr_note_orig_0085005", "type": "orig", "text": "實東春作體"}
