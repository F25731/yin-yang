{"id": null, "n": null, "target": null, "type": null, "text": "同師安公，先居西林"}
{"id": null, "n": null, "target": null, "type": null, "text": "遠師同母弟"}
{"id": null, "n": null, "target": null, "type": null, "text": "並羅什門弟"}
{"id": null, "n": null, "target": null, "type": null, "text": "並遠師門人"}
{"id": null, "n": null, "target": null, "type": null, "text": "此云覺明，罽賓國人"}
{"id": null, "n": null, "target": null, "type": null, "text": "此云覺賢，迦維衛國人"}
{"id": null, "n": null, "target": null, "type": null, "text": "號遺民"}
{"id": null, "n": null, "target": null, "type": null, "text": "義熙八年先逝"}
