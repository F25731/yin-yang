{"id": null, "n": null, "target": null, "type": null, "text": "〔一義云自、他、共〕"}
{"id": null, "n": null, "target": null, "type": null, "text": "細註"}
{"id": null, "n": null, "target": null, "type": null, "text": "細註"}
{"id": null, "n": null, "target": null, "type": null, "text": "此註時也"}
{"id": null, "n": null, "target": null, "type": null, "text": "遍許承稟"}
{"id": null, "n": null, "target": null, "type": null, "text": "不問"}
{"id": null, "n": null, "target": null, "type": null, "text": "如前問答，故略之。"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔此解不好〕"}
{"id": null, "n": null, "target": null, "type": null, "text": "更思"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃至"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃至"}
{"id": null, "n": null, "target": null, "type": null, "text": "現量"}
{"id": null, "n": null, "target": null, "type": null, "text": "所別不成"}
{"id": null, "n": null, "target": null, "type": null, "text": "能別、所別俱不成也"}
{"id": null, "n": null, "target": null, "type": null, "text": "〔付後〕"}
{"id": null, "n": null, "target": null, "type": null, "text": "更問"}
{"id": null, "n": null, "target": null, "type": null, "text": "更問"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T49n2034_p0102a23"}
{"id": null, "n": "0870001", "target": "#nkr_note_mod_0870001", "type": "mod", "text": "也已下佚失"}
{"id": null, "n": "0842001", "target": "#nkr_note_orig_0842001", "type": "orig", "text": "一等疑係後人所加"}
{"id": null, "n": "0845001", "target": "#nkr_note_orig_0845001", "type": "orig", "text": "至能一作主張"}
{"id": null, "n": "0847001", "target": "#nkr_note_orig_0847001", "type": "orig", "text": "徧疑偏"}
{"id": null, "n": "0849001", "target": "#nkr_note_orig_0849001", "type": "orig", "text": "同一作因"}
{"id": null, "n": "0849002", "target": "#nkr_note_orig_0849002", "type": "orig", "text": "三一作二"}
{"id": null, "n": "0852001", "target": "#nkr_note_orig_0852001", "type": "orig", "text": "說疑訖"}
{"id": null, "n": "0852002", "target": "#nkr_note_orig_0852002", "type": "orig", "text": "者字疑剩"}
{"id": null, "n": "0852003", "target": "#nkr_note_orig_0852003", "type": "orig", "text": "失疑定"}
{"id": null, "n": "0856001", "target": "#nkr_note_orig_0856001", "type": "orig", "text": "宗下一有因喻方能有立六字"}
{"id": null, "n": "0856002", "target": "#nkr_note_orig_0856002", "type": "orig", "text": "車一作牛"}
{"id": null, "n": "0858001", "target": "#nkr_note_orig_0858001", "type": "orig", "text": "悉疑恚"}
{"id": null, "n": "0858002", "target": "#nkr_note_orig_0858002", "type": "orig", "text": "此等四字疑後人所加"}
{"id": null, "n": "0858003", "target": "#nkr_note_orig_0858003", "type": "orig", "text": "有自比他共量一作有自比有他比有共比量"}
{"id": null, "n": "0858004", "target": "#nkr_note_orig_0858004", "type": "orig", "text": "遵起者筭也五字未詳"}
{"id": null, "n": "0858005", "target": "#nkr_note_orig_0858005", "type": "orig", "text": "緣下一有所緣二字"}
{"id": null, "n": "0858006", "target": "#nkr_note_orig_0858006", "type": "orig", "text": "喚等二十六字義不通"}
{"id": null, "n": "0860001", "target": "#nkr_note_orig_0860001", "type": "orig", "text": "此疑比"}
{"id": null, "n": "0861001", "target": "#nkr_note_orig_0861001", "type": "orig", "text": "被疑彼"}
{"id": null, "n": "0861002", "target": "#nkr_note_orig_0861002", "type": "orig", "text": "有疑在"}
{"id": null, "n": "0861003", "target": "#nkr_note_orig_0861003", "type": "orig", "text": "斷一作結"}
{"id": null, "n": "0864001", "target": "#nkr_note_orig_0864001", "type": "orig", "text": "付後一為麁字"}
{"id": null, "n": "0864002", "target": "#nkr_note_orig_0864002", "type": "orig", "text": "聲恐響"}
{"id": null, "n": "0864003", "target": "#nkr_note_orig_0864003", "type": "orig", "text": "差一作果"}
{"id": null, "n": "0864004", "target": "#nkr_note_orig_0864004", "type": "orig", "text": "答下一有于微量筆二微許大不可與共一父一母計大若同父微等不二十四字恐衍文"}
{"id": null, "n": "0865001", "target": "#nkr_note_orig_0865001", "type": "orig", "text": "此牒文與現疏文少異"}
{"id": null, "n": "0867001", "target": "#nkr_note_orig_0867001", "type": "orig", "text": "闕作開"}
{"id": null, "n": "0867002", "target": "#nkr_note_orig_0867002", "type": "orig", "text": "現行本無常字"}
{"id": null, "n": "0868001", "target": "#nkr_note_orig_0868001", "type": "orig", "text": "此牒文與現疏異"}
{"id": null, "n": "0869001", "target": "#nkr_note_orig_0869001", "type": "orig", "text": "識下一有定非第八四字"}
{"id": null, "n": "0870001", "target": "#nkr_note_orig_0870001", "type": "orig", "text": "也巳下佚失"}
