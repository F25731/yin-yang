{"id": null, "n": "0055001", "target": "#nkr_note_orig_0055001", "type": "orig", "text": "「起」，底本作「寄」，據尾題改。"}
{"id": null, "n": "0055002", "target": "#nkr_note_orig_0055002", "type": "orig", "text": "此文獻題目前、題目下、題目後，有關於「佛先法先」之論義四行，似為本文獻漏抄之內容，參見第66頁註釋。茲錄文於下，以供參考：「未審佛先？法先？佛若在先，佛稟何教（原文此處衍『何教』兩字）成？法先，何人說？答：若論文字法，佛先法後；若論寂滅法，法先佛後。經云：『諸佛之師，以為法也。』以法常故，諸佛亦常。稟何教而成道？經云：『所說眾生，有師智、自然智』，任運證寂滅法。於佛轉教眾生，眾生求佛，得成正覺。」"}
{"id": null, "n": "0055003", "target": "#nkr_note_orig_0055003", "type": "orig", "text": "「慧」，底本作「惠」，據文意改。下同。"}
{"id": null, "n": "0055004", "target": "#nkr_note_orig_0055004", "type": "orig", "text": "「知」，底本無，據文意補。"}
{"id": null, "n": "0055005", "target": "#nkr_note_orig_0055005", "type": "orig", "text": "「相」，底本作「想」，據文意改。"}
{"id": null, "n": "0055006", "target": "#nkr_note_orig_0055006", "type": "orig", "text": "「生天人，皆牢達」中疑有錯漏。「牢」，疑為「罕」之誤。"}
{"id": null, "n": "0055007", "target": "#nkr_note_orig_0055007", "type": "orig", "text": "「相」，底本作「想」，據文意改。"}
{"id": null, "n": "0056001", "target": "#nkr_note_orig_0056001", "type": "orig", "text": "「談」前疑漏一字。"}
{"id": null, "n": "0056002", "target": "#nkr_note_orig_0056002", "type": "orig", "text": "「何」，底本作「訶」，據文意改。"}
{"id": null, "n": "0056003", "target": "#nkr_note_orig_0056003", "type": "orig", "text": "「怖」，底本作「悕」，據文意改。"}
{"id": null, "n": "0056004", "target": "#nkr_note_orig_0056004", "type": "orig", "text": "「居」，底本抄錯後在旁邊錯注作「君」，又該原錯字改作「居」，但未將「君」字點去。"}
{"id": null, "n": "0056005", "target": "#nkr_note_orig_0056005", "type": "orig", "text": "「殊」前疑漏二字。"}
{"id": null, "n": "0056006", "target": "#nkr_note_orig_0056006", "type": "orig", "text": "「測」，底本作「側」，據文意改。"}
{"id": null, "n": "0056007", "target": "#nkr_note_orig_0056007", "type": "orig", "text": "此字不清，疑作「立」。"}
{"id": null, "n": "0056008", "target": "#nkr_note_orig_0056008", "type": "orig", "text": "「至」，疑或作「志」。"}
{"id": null, "n": "0056009", "target": "#nkr_note_orig_0056009", "type": "orig", "text": "「辨」，底本作「辯」，據文意改。"}
{"id": null, "n": "0056010", "target": "#nkr_note_orig_0056010", "type": "orig", "text": "「測」，底本作「惻」，據文意改。"}
{"id": null, "n": "0056011", "target": "#nkr_note_orig_0056011", "type": "orig", "text": "「起世」，底本作「奇」，據尾題改。"}
{"id": null, "n": "0057001", "target": "#nkr_note_orig_0057001", "type": "orig", "text": "「妄」，底本無，據文意補。"}
{"id": null, "n": "0058001", "target": "#nkr_note_orig_0058001", "type": "orig", "text": "「原」，底本作「元」，據文意改。"}
{"id": null, "n": "0058002", "target": "#nkr_note_orig_0058002", "type": "orig", "text": "「原」，底本作「元」，據文意改。"}
{"id": null, "n": "0058003", "target": "#nkr_note_orig_0058003", "type": "orig", "text": "「原」，底本作「元」，據文意改。"}
{"id": null, "n": "0058004", "target": "#nkr_note_orig_0058004", "type": "orig", "text": "「原」，底本作「元」，據文意改。"}
{"id": null, "n": "0059001", "target": "#nkr_note_orig_0059001", "type": "orig", "text": "「原」，底本作「元」，據文意改。"}
{"id": null, "n": "0059002", "target": "#nkr_note_orig_0059002", "type": "orig", "text": "「幼」，底本作「幻」，據文意改。"}
{"id": null, "n": "0059003", "target": "#nkr_note_orig_0059003", "type": "orig", "text": "「仁」，底本作「人」，據文意改。"}
{"id": null, "n": "0059004", "target": "#nkr_note_orig_0059004", "type": "orig", "text": "「不分」，底本作「分不」，據文意改。"}
{"id": null, "n": "0059005", "target": "#nkr_note_orig_0059005", "type": "orig", "text": "「壞」，底本作「懷」，據文意改。"}
{"id": null, "n": "0059006", "target": "#nkr_note_orig_0059006", "type": "orig", "text": "「壞」，底本作「懷」，據文意改。"}
{"id": null, "n": "0060001", "target": "#nkr_note_orig_0060001", "type": "orig", "text": "「導」，底本作「道」，據文意改。"}
{"id": null, "n": "0060002", "target": "#nkr_note_orig_0060002", "type": "orig", "text": "「相」，底本作「想」，據文意改。"}
{"id": null, "n": "0060003", "target": "#nkr_note_orig_0060003", "type": "orig", "text": "「經說」，底本作「說經」，據文意改。"}
{"id": null, "n": "0060004", "target": "#nkr_note_orig_0060004", "type": "orig", "text": "「何」，底本作「何不」，據文意刪。"}
{"id": null, "n": "0061001", "target": "#nkr_note_orig_0061001", "type": "orig", "text": "「說三乘？為當未來」，底本無，據文意補。"}
{"id": null, "n": "0061002", "target": "#nkr_note_orig_0061002", "type": "orig", "text": "「異」，底本作「異乎」，據文意刪。"}
{"id": null, "n": "0062001", "target": "#nkr_note_orig_0062001", "type": "orig", "text": "「幾」，底本作「機」，據文意改。"}
{"id": null, "n": "0062002", "target": "#nkr_note_orig_0062002", "type": "orig", "text": "「原」，底本作「無」，據文意改。"}
{"id": null, "n": "0062003", "target": "#nkr_note_orig_0062003", "type": "orig", "text": "「學」，底本似作「覺」，據文意改。"}
{"id": null, "n": "0062004", "target": "#nkr_note_orig_0062004", "type": "orig", "text": "「瞋」，底本作「真」，據文意改。"}
{"id": null, "n": "0062005", "target": "#nkr_note_orig_0062005", "type": "orig", "text": "「邪」，底本作「耶」，據文意改。"}
{"id": null, "n": "0063001", "target": "#nkr_note_orig_0063001", "type": "orig", "text": "「菩」，底本作「菩菩」，據文意刪。"}
{"id": null, "n": "0064001", "target": "#nkr_note_orig_0064001", "type": "orig", "text": "「得」，底本作「德」，據文意改。"}
{"id": null, "n": "0064002", "target": "#nkr_note_orig_0064002", "type": "orig", "text": "「大」，底本作「代」，據文意改。"}
{"id": null, "n": "0064003", "target": "#nkr_note_orig_0064003", "type": "orig", "text": "「嫌」或為「賺」之誤。"}
{"id": null, "n": "0064004", "target": "#nkr_note_orig_0064004", "type": "orig", "text": "「慢」，底本作「漫」，據文意改。"}
{"id": null, "n": "0064005", "target": "#nkr_note_orig_0064005", "type": "orig", "text": "「是」，底本作「是見證見聖，即是」，疑重文衍，據文意刪。"}
{"id": null, "n": "0065001", "target": "#nkr_note_orig_0065001", "type": "orig", "text": "此字不清，原文照錄。"}
{"id": null, "n": "0065002", "target": "#nkr_note_orig_0065002", "type": "orig", "text": "「佛」，底本作「佛佛」，據文意刪。"}
{"id": null, "n": "0065003", "target": "#nkr_note_orig_0065003", "type": "orig", "text": "「問」，底本無，據文意補。"}
{"id": null, "n": "0065004", "target": "#nkr_note_orig_0065004", "type": "orig", "text": "「解」，疑或為「修」之誤。"}
{"id": null, "n": "0066001", "target": "#nkr_note_orig_0066001", "type": "orig", "text": "此處論「佛先法先」，首題下所抄文字恐乃從此處脫漏。參見首題校記。"}
{"id": null, "n": "0066002", "target": "#nkr_note_orig_0066002", "type": "orig", "text": "「會」，底本作「會會」，據文意刪。"}
{"id": null, "n": "0067001", "target": "#nkr_note_orig_0067001", "type": "orig", "text": "「何」，底本作「河」，據文意改。"}
{"id": null, "n": "0067002", "target": "#nkr_note_orig_0067002", "type": "orig", "text": "「又」，底本無，據文意補。"}
{"id": null, "n": "0067003", "target": "#nkr_note_orig_0067003", "type": "orig", "text": "「不」，底本作「一」，據文意改。"}
{"id": null, "n": "0067004", "target": "#nkr_note_orig_0067004", "type": "orig", "text": "此答前似漏一問。"}
{"id": null, "n": "0067005", "target": "#nkr_note_orig_0067005", "type": "orig", "text": "「惡」，底本作「要」，據文意改。"}
{"id": null, "n": "0067006", "target": "#nkr_note_orig_0067006", "type": "orig", "text": "「無」，底本無，據文意補。"}
{"id": null, "n": "0067007", "target": "#nkr_note_orig_0067007", "type": "orig", "text": "「寂」，底本作「家」，據文意改。"}
{"id": null, "n": "0068001", "target": "#nkr_note_orig_0068001", "type": "orig", "text": "「答」，底本作「答：實無心可印」，疑重文衍，據文意刪。"}
{"id": null, "n": "0068002", "target": "#nkr_note_orig_0068002", "type": "orig", "text": "「黠」，底本作「點」，據文意改。"}
{"id": null, "n": "0068003", "target": "#nkr_note_orig_0068003", "type": "orig", "text": "「容」，底本作「融」，據文意改。"}
{"id": null, "n": "0068004", "target": "#nkr_note_orig_0068004", "type": "orig", "text": "「演」，底本作「演演」，據文意刪。"}
{"id": null, "n": "0068005", "target": "#nkr_note_orig_0068005", "type": "orig", "text": "「期」，底本作「其」，據文意改。"}
{"id": null, "n": "0069001", "target": "#nkr_note_orig_0069001", "type": "orig", "text": "「曰」，底本作「月」，據文意改。"}
