{"id": null, "n": "0671a2301", "target": "#nkr_note_add_0671a2301", "type": "add", "text": "已【CB】，巳【卍續】"}
{"id": null, "n": "0672a1701", "target": "#nkr_note_add_0672a1701", "type": "add", "text": "已【CB】，巳【卍續】"}
{"id": null, "n": "0672b1801", "target": "#nkr_note_add_0672b1801", "type": "add", "text": "已【CB】，巳【卍續】"}
{"id": null, "n": "0673c1401", "target": "#nkr_note_add_0673c1401", "type": "add", "text": "已【CB】，巳【卍續】"}
