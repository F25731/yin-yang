{"id": null, "n": "0510003", "target": "#nkr_note_mod_0510003", "type": "mod", "text": "佛說【大】，〔－〕【元】"}
{"id": null, "n": "0510004", "target": "#nkr_note_mod_0510004", "type": "mod", "text": "天竺三藏【大】，三藏法師【宋】【宮】，北天竺三藏法師【元】【明】"}
{"id": null, "n": "0510005", "target": "#nkr_note_mod_0510005", "type": "mod", "text": "流【大】，留【宋】【元】【明】【宮】"}
{"id": null, "n": "0510006", "target": "#nkr_note_mod_0510006", "type": "mod", "text": "晡【CB】【宋】【元】【明】【宮】，脯【大】"}
{"id": null, "n": "0510007", "target": "#nkr_note_mod_0510007", "type": "mod", "text": "可【大】，所【宋】【元】【明】【宮】"}
{"id": null, "n": "0511001", "target": "#nkr_note_mod_0511001", "type": "mod", "text": "是【大】，見【宋】【元】【明】【宮】"}
{"id": null, "n": "0511002", "target": "#nkr_note_mod_0511002", "type": "mod", "text": "後【大】，復【宋】【元】【明】【宮】"}
{"id": null, "n": "0511003", "target": "#nkr_note_mod_0511003", "type": "mod", "text": "叫喚【大】，喚叫【宋】【元】【明】，喚【宮】"}
{"id": null, "n": "0511004", "target": "#nkr_note_mod_0511004", "type": "mod", "text": "二【大】，此【明】"}
