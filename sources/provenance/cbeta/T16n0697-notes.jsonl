{"id": null, "n": "0799005", "target": "#nkr_note_orig_0799005", "type": "orig", "text": "頌＝偈【宮】"}
{"id": null, "n": "0799006", "target": "#nkr_note_orig_0799006", "type": "orig", "text": "唯＝惟【元】【明】"}
{"id": null, "n": "0799007", "target": "#nkr_note_orig_0799007", "type": "orig", "text": "〔甘〕－【宋】【宮】"}
