{"id": null, "n": "0798023", "target": "#nkr_note_mod_0798023", "type": "mod", "text": "大【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0798024", "target": "#nkr_note_mod_0798024", "type": "mod", "text": "藏【大】，藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0798025", "target": "#nkr_note_mod_0798025", "type": "mod", "text": "功【大】，功德【宋】【元】【明】【宮】"}
{"id": null, "n": "0798026", "target": "#nkr_note_mod_0798026", "type": "mod", "text": "佛【大】，〔－〕【宋】【元】【宮】"}
{"id": null, "n": "0799001", "target": "#nkr_note_mod_0799001", "type": "mod", "text": "福德【大】，功德【宋】【元】【明】【宮】"}
{"id": null, "n": "0799002", "target": "#nkr_note_mod_0799002", "type": "mod", "text": "慧【大】，智慧【宋】【明】【宮】"}
{"id": null, "n": "0799003", "target": "#nkr_note_mod_0799003", "type": "mod", "text": "淨【大】，清淨【宋】【元】【明】【宮】"}
{"id": null, "n": "0799004", "target": "#nkr_note_mod_0799004", "type": "mod", "text": "漫陀羅【大】，曼荼羅【元】【明】"}
{"id": null, "n": "0799005", "target": "#nkr_note_mod_0799005", "type": "mod", "text": "頌【大】，偈【宮】"}
{"id": null, "n": "0799006", "target": "#nkr_note_mod_0799006", "type": "mod", "text": "唯【大】，惟【元】【明】"}
{"id": null, "n": "0799007", "target": "#nkr_note_mod_0799007", "type": "mod", "text": "甘【大】，〔－〕【宋】【宮】"}
{"id": null, "n": "0799008", "target": "#nkr_note_mod_0799008", "type": "mod", "text": "周【大】，用【宮】"}
{"id": null, "n": "0799009", "target": "#nkr_note_mod_0799009", "type": "mod", "text": "即從座而起【大】，〔－〕【元】【明】"}
{"id": null, "n": "0799010", "target": "#nkr_note_mod_0799010", "type": "mod", "text": "難【大】，難即從座而起【元】【明】"}
{"id": null, "n": "0798023", "target": "#nkr_note_orig_0798023", "type": "orig", "text": "〔大〕－【三】【宮】"}
