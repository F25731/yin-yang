{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": "0830002A", "target": "#nkr_note_mod_0830002A", "type": "mod", "text": "無也字"}
{"id": null, "n": "0830002B", "target": "#nkr_note_mod_0830002B", "type": "mod", "text": "無也字"}
{"id": null, "n": "0831006", "target": "#nkr_note_mod_0831006", "type": "mod", "text": "焉作已"}
{"id": null, "n": "0830001", "target": "#nkr_note_orig_0830001", "type": "orig", "text": "佛說至所立題箋釋一本作世尊所說傳心之常法也心本空洞無物而六根總屬一心心惟無主令六根紛乘互用日用纏縛"}
{"id": null, "n": "0830002A", "target": "#nkr_note_orig_0830002A", "type": "orig", "text": "無二也字"}
{"id": null, "n": "0830002B", "target": "#nkr_note_orig_0830002B", "type": "orig", "text": "無二也字"}
{"id": null, "n": "0830003", "target": "#nkr_note_orig_0830003", "type": "orig", "text": "觀於作見觀"}
{"id": null, "n": "0830004", "target": "#nkr_note_orig_0830004", "type": "orig", "text": "其下有以字"}
{"id": null, "n": "0830005", "target": "#nkr_note_orig_0830005", "type": "orig", "text": "行深作觀照自性"}
{"id": null, "n": "0830006", "target": "#nkr_note_orig_0830006", "type": "orig", "text": "焉作也觀照之能事盡"}
{"id": null, "n": "0830007", "target": "#nkr_note_orig_0830007", "type": "orig", "text": "無也字"}
{"id": null, "n": "0830008", "target": "#nkr_note_orig_0830008", "type": "orig", "text": "也下有世人多向色外覓空豈知空色一體十四字"}
{"id": null, "n": "0830009", "target": "#nkr_note_orig_0830009", "type": "orig", "text": "矣下有我所說空即是說色空之外無色矣至於受想行識何莫不然二十四字"}
{"id": null, "n": "0830010", "target": "#nkr_note_orig_0830010", "type": "orig", "text": "也下有則可見於色外覓空者皆斷滅空而非真空也十八字"}
{"id": null, "n": "0830011", "target": "#nkr_note_orig_0830011", "type": "orig", "text": "是故作纔說色外無空世人又向空中覓色不知"}
{"id": null, "n": "0831001", "target": "#nkr_note_orig_0831001", "type": "orig", "text": "四等九字作十二因緣空矣苦集滅道四諦空矣直至智證之菩薩云菩薩法一切掃盡方顯真空真相"}
{"id": null, "n": "0831002", "target": "#nkr_note_orig_0831002", "type": "orig", "text": "則上有言菩薩則人人一矣無聖凡也言三世則古今一矣無先後也二十四字"}
{"id": null, "n": "0831003", "target": "#nkr_note_orig_0831003", "type": "orig", "text": "也下有末說密語以讚之正般若不可思議處十五字"}
{"id": null, "n": "0831004", "target": "#nkr_note_orig_0831004", "type": "orig", "text": "無我等三字"}
{"id": null, "n": "0831005", "target": "#nkr_note_orig_0831005", "type": "orig", "text": "然則觀作通章特揭般若以顯諸佛之心法詳明真空以破世人之幻相學"}
{"id": null, "n": "0831006", "target": "#nkr_note_orig_0831006", "type": "orig", "text": "焉作巳"}
{"id": null, "n": "0831007", "target": "#nkr_note_orig_0831007", "type": "orig", "text": "無故言至奈之何三十字"}
{"id": null, "n": "0831008", "target": "#nkr_note_orig_0831008", "type": "orig", "text": "無者眾二字"}
