{"id": null, "n": "1088007", "target": "#nkr_note_mod_1088007", "type": "mod", "text": "䗍【大】，螺【宮】"}
{"id": null, "n": "1088008", "target": "#nkr_note_mod_1088008", "type": "mod", "text": "欲【大】，〔－〕【宮】"}
{"id": null, "n": "1088009", "target": "#nkr_note_mod_1088009", "type": "mod", "text": "德【大】，德善【宋】【元】【明】【宮】"}
{"id": null, "n": "1089001", "target": "#nkr_note_mod_1089001", "type": "mod", "text": "眾【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1089002", "target": "#nkr_note_mod_1089002", "type": "mod", "text": "是故【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1089003", "target": "#nkr_note_mod_1089003", "type": "mod", "text": "先【大】，前【宋】【元】【明】【宮】"}
