{"id": null, "n": "1089005", "target": "#nkr_note_mod_1089005", "type": "mod", "text": "當【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1089006", "target": "#nkr_note_mod_1089006", "type": "mod", "text": "乾【大】，揵【宋】【元】【明】【宮】"}
