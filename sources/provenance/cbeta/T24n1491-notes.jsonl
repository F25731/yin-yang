{"id": null, "n": "1086005", "target": "#nkr_note_mod_1086005", "type": "mod", "text": "（梁扶…譯）十字【大】，梁天監年扶南國沙門僧伽婆羅於楊州譯【宋】【元】【宮】，梁扶南國沙門僧伽婆羅譯【明】"}
{"id": null, "n": "1087001", "target": "#nkr_note_mod_1087001", "type": "mod", "text": "磨【大】，摩【宋】【元】【明】【宮】"}
{"id": null, "n": "1087002", "target": "#nkr_note_mod_1087002", "type": "mod", "text": "（上方…高）八字【大】，〔－〕【明】"}
{"id": null, "n": "1087003", "target": "#nkr_note_mod_1087003", "type": "mod", "text": "言【大】，告【宋】【元】【明】【宮】"}
{"id": null, "n": "1087004", "target": "#nkr_note_mod_1087004", "type": "mod", "text": "謌【大】，訶【宋】【元】【明】【宮】"}
{"id": null, "n": "1087005", "target": "#nkr_note_mod_1087005", "type": "mod", "text": "旃【大】，栴【宋】【元】【宮】"}
{"id": null, "n": "1087006", "target": "#nkr_note_mod_1087006", "type": "mod", "text": "說【大】，說法【宋】【元】【明】【宮】"}
{"id": null, "n": "1087007", "target": "#nkr_note_mod_1087007", "type": "mod", "text": "主【大】，王【宋】【元】【明】【宮】"}
{"id": null, "n": "1087008", "target": "#nkr_note_mod_1087008", "type": "mod", "text": "備起【大】，起備【宋】【元】【明】【宮】"}
{"id": null, "n": "1087009", "target": "#nkr_note_mod_1087009", "type": "mod", "text": "制【大】，教【宋】【元】【明】【宮】"}
{"id": null, "n": "1087010", "target": "#nkr_note_mod_1087010", "type": "mod", "text": "和上【大】，和尚【宋】【元】【明】【宮】"}
{"id": null, "n": "1087011", "target": "#nkr_note_mod_1087011", "type": "mod", "text": "梨【大】，黎【明】"}
{"id": null, "n": "1087012", "target": "#nkr_note_mod_1087012", "type": "mod", "text": "發【大】，啟【宮】"}
{"id": null, "n": "1087013", "target": "#nkr_note_mod_1087013", "type": "mod", "text": "懺悔品竟【大】，〔－〕【明】"}
{"id": null, "n": "1088001", "target": "#nkr_note_mod_1088001", "type": "mod", "text": "今【大】，令【宋】【元】【明】"}
{"id": null, "n": "1088002", "target": "#nkr_note_mod_1088002", "type": "mod", "text": "行【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "1088003", "target": "#nkr_note_mod_1088003", "type": "mod", "text": "阿耨【大】，阿耨多羅三藐【宋】【元】【明】【宮】"}
