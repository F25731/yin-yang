{"id": null, "n": "0384014", "target": "#nkr_note_orig_0384014", "type": "orig", "text": "（便）＋被【甲】"}
{"id": null, "n": "0384015", "target": "#nkr_note_orig_0384015", "type": "orig", "text": "（有）＋一【甲】"}
{"id": null, "n": "0384016", "target": "#nkr_note_orig_0384016", "type": "orig", "text": "差別＝異耳【甲】"}
