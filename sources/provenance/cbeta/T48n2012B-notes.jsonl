{"id": null, "n": null, "target": null, "type": "cf1", "text": "T48n2023_p1075a06"}
{"id": null, "n": "0384009", "target": "#nkr_note_mod_0384009", "type": "mod", "text": "若【大】，如【甲】"}
{"id": null, "n": "0384010", "target": "#nkr_note_mod_0384010", "type": "mod", "text": "行【大】，數行【甲】"}
{"id": null, "n": "0384011", "target": "#nkr_note_mod_0384011", "type": "mod", "text": "貞【大】，真【甲】"}
{"id": null, "n": "0384012", "target": "#nkr_note_mod_0384012", "type": "mod", "text": "達摩【大】＊，達磨【甲】＊"}
{"id": null, "n": "0384013", "target": "#nkr_note_mod_0384013", "type": "mod", "text": "作【大】，纔作【甲】"}
{"id": null, "n": "0384014", "target": "#nkr_note_mod_0384014", "type": "mod", "text": "被【大】，便被【甲】"}
{"id": null, "n": "0384015", "target": "#nkr_note_mod_0384015", "type": "mod", "text": "一【大】，有一【甲】"}
{"id": null, "n": "0384016", "target": "#nkr_note_mod_0384016", "type": "mod", "text": "差別【大】，異耳【甲】"}
{"id": null, "n": "0384017", "target": "#nkr_note_mod_0384017", "type": "mod", "text": "共【大】，同【甲】"}
{"id": null, "n": "0385001", "target": "#nkr_note_mod_0385001", "type": "mod", "text": "唯有【大】，惟指【甲】"}
{"id": null, "n": "0385002", "target": "#nkr_note_mod_0385002", "type": "mod", "text": "彌勒【CB】【卍續-CB】【甲】，彌彌【大】"}
{"id": null, "n": "0385003", "target": "#nkr_note_mod_0385003", "type": "mod", "text": "等閑【CB】【甲】，等間【大】"}
{"id": null, "n": "0385004", "target": "#nkr_note_mod_0385004", "type": "mod", "text": "強【大】＊，彊【甲】＊"}
{"id": null, "n": "0385005", "target": "#nkr_note_mod_0385005", "type": "mod", "text": "如意【大】，喜【甲】"}
{"id": null, "n": "0385006", "target": "#nkr_note_mod_0385006", "type": "mod", "text": "即不如意【大】，生瞋【甲】"}
{"id": null, "n": "0385007", "target": "#nkr_note_mod_0385007", "type": "mod", "text": "者【大】，這【甲】"}
{"id": null, "n": "0385008", "target": "#nkr_note_mod_0385008", "type": "mod", "text": "謾【大】，漫【甲】"}
{"id": null, "n": "0385009", "target": "#nkr_note_mod_0385009", "type": "mod", "text": "是【大】，即【甲】"}
{"id": null, "n": "0385010", "target": "#nkr_note_mod_0385010", "type": "mod", "text": "將謂【大】，謂將【甲】"}
{"id": null, "n": "0385011", "target": "#nkr_note_mod_0385011", "type": "mod", "text": "佛【大】，佛道【甲】"}
{"id": null, "n": "0385012", "target": "#nkr_note_mod_0385012", "type": "mod", "text": "秖【大】，祇【甲】"}
{"id": null, "n": "0386001", "target": "#nkr_note_mod_0386001", "type": "mod", "text": "無【大】，有【甲】"}
{"id": null, "n": "0386002", "target": "#nkr_note_mod_0386002", "type": "mod", "text": "會【大】，心【甲】"}
{"id": null, "n": "0386003", "target": "#nkr_note_mod_0386003", "type": "mod", "text": "便【大】，即便【甲】"}
{"id": null, "n": "0386004", "target": "#nkr_note_mod_0386004", "type": "mod", "text": "生【大】，不息生【甲】"}
{"id": null, "n": "0386005", "target": "#nkr_note_mod_0386005", "type": "mod", "text": "志【大】＊，誌【甲】＊"}
{"id": null, "n": "0386006", "target": "#nkr_note_mod_0386006", "type": "mod", "text": "今【大】，人【甲】"}
{"id": null, "n": "0386007", "target": "#nkr_note_mod_0386007", "type": "mod", "text": "墮【大】，墜【甲】"}
{"id": null, "n": "0386008", "target": "#nkr_note_mod_0386008", "type": "mod", "text": "金【大】，金錢【甲】"}
{"id": null, "n": "0386009", "target": "#nkr_note_mod_0386009", "type": "mod", "text": "區區【大】，驅馳【甲】"}
{"id": null, "n": "0386010", "target": "#nkr_note_mod_0386010", "type": "mod", "text": "并【大】，秖是并【甲】"}
{"id": null, "n": "0386011", "target": "#nkr_note_mod_0386011", "type": "mod", "text": "即【大】，秖【甲】"}
{"id": null, "n": "0387001", "target": "#nkr_note_mod_0387001", "type": "mod", "text": "䊀【大】，粘【甲】"}
{"id": null, "n": "0387002", "target": "#nkr_note_mod_0387002", "type": "mod", "text": "無【大】，是無【甲】"}
{"id": null, "n": "0387003", "target": "#nkr_note_mod_0387003", "type": "mod", "text": "重【大】，重黃檗斷際禪師宛陵錄終【甲】"}
{"id": null, "n": "0384008", "target": "#nkr_note_orig_0384008", "type": "orig", "text": "【原】增上寺報恩藏明本，【甲】寬文十三年刊宗教大學藏本"}
