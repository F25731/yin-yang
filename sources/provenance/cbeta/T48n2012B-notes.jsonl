{"id": null, "n": "0385001", "target": "#nkr_note_orig_0385001", "type": "orig", "text": "唯有＝惟指【甲】"}
{"id": null, "n": "0385002", "target": "#nkr_note_orig_0385002", "type": "orig", "text": "彌彌＝彌勒【甲】"}
{"id": null, "n": "0385003", "target": "#nkr_note_orig_0385003", "type": "orig", "text": "等間＝等閑【甲】"}
{"id": null, "n": "0385004", "target": "#nkr_note_orig_0385004", "type": "orig", "text": "強＝彊【甲】＊"}
{"id": null, "n": "0385005", "target": "#nkr_note_orig_0385005", "type": "orig", "text": "如意＝喜【甲】"}
{"id": null, "n": "0385006", "target": "#nkr_note_orig_0385006", "type": "orig", "text": "即不如意＝生瞋【甲】"}
{"id": null, "n": "0385007", "target": "#nkr_note_orig_0385007", "type": "orig", "text": "者＝這【甲】"}
{"id": null, "n": "0385008", "target": "#nkr_note_orig_0385008", "type": "orig", "text": "謾＝漫【甲】"}
{"id": null, "n": "0385009", "target": "#nkr_note_orig_0385009", "type": "orig", "text": "是＝即【甲】"}
{"id": null, "n": "0385010", "target": "#nkr_note_orig_0385010", "type": "orig", "text": "將謂＝謂將【甲】"}
{"id": null, "n": "0385011", "target": "#nkr_note_orig_0385011", "type": "orig", "text": "佛＋（道）【甲】"}
{"id": null, "n": "0385012", "target": "#nkr_note_orig_0385012", "type": "orig", "text": "秖＝祇【甲】"}
{"id": null, "n": "0386001", "target": "#nkr_note_orig_0386001", "type": "orig", "text": "無＝有【甲】"}
{"id": null, "n": "0386002", "target": "#nkr_note_orig_0386002", "type": "orig", "text": "會＝心【甲】"}
{"id": null, "n": "0386003", "target": "#nkr_note_orig_0386003", "type": "orig", "text": "（即）＋便【甲】"}
{"id": null, "n": "0386004", "target": "#nkr_note_orig_0386004", "type": "orig", "text": "（不息）＋生【甲】"}
{"id": null, "n": "0386005", "target": "#nkr_note_orig_0386005", "type": "orig", "text": "志＝誌【甲】＊"}
{"id": null, "n": "0386006", "target": "#nkr_note_orig_0386006", "type": "orig", "text": "今＝人【甲】"}
{"id": null, "n": "0386007", "target": "#nkr_note_orig_0386007", "type": "orig", "text": "墮＝墜【甲】"}
{"id": null, "n": "0386008", "target": "#nkr_note_orig_0386008", "type": "orig", "text": "金＋（錢）【甲】"}
{"id": null, "n": "0386009", "target": "#nkr_note_orig_0386009", "type": "orig", "text": "區區＝驅馳【甲】"}
{"id": null, "n": "0386010", "target": "#nkr_note_orig_0386010", "type": "orig", "text": "（秖是）＋並【甲】"}
{"id": null, "n": "0386011", "target": "#nkr_note_orig_0386011", "type": "orig", "text": "即＝秖【甲】"}
{"id": null, "n": "0387001", "target": "#nkr_note_orig_0387001", "type": "orig", "text": "粘＝粘【甲】"}
{"id": null, "n": "0387002", "target": "#nkr_note_orig_0387002", "type": "orig", "text": "（是）＋無【甲】"}
