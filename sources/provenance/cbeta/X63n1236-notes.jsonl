{"id": null, "n": "0207003", "target": "#nkr_note_orig_0207003", "type": "orig", "text": "挾疑妙"}
{"id": null, "n": "0207004", "target": "#nkr_note_orig_0207004", "type": "orig", "text": "兼中至一作偏中正"}
{"id": null, "n": "0208001", "target": "#nkr_note_orig_0208001", "type": "orig", "text": "客一作主"}
{"id": null, "n": "0208002", "target": "#nkr_note_orig_0208002", "type": "orig", "text": "釋恐揀"}
{"id": null, "n": "0209001", "target": "#nkr_note_orig_0209001", "type": "orig", "text": "位字似剩"}
{"id": null, "n": "0210001", "target": "#nkr_note_orig_0210001", "type": "orig", "text": "之字疑剩"}
{"id": null, "n": "0211001", "target": "#nkr_note_orig_0211001", "type": "orig", "text": "奧字更勘"}
{"id": null, "n": "0211002", "target": "#nkr_note_orig_0211002", "type": "orig", "text": "麼疑底"}
{"id": null, "n": "0211003", "target": "#nkr_note_orig_0211003", "type": "orig", "text": "表疑來"}
{"id": null, "n": "0211004", "target": "#nkr_note_orig_0211004", "type": "orig", "text": "惑疑忒"}
{"id": null, "n": "0212001", "target": "#nkr_note_orig_0212001 #note_star_1", "type": "orig", "text": "準疑雙次同"}
{"id": null, "n": "0212002", "target": "#nkr_note_orig_0212002", "type": "orig", "text": "喻一作預"}
{"id": null, "n": "0213001", "target": "#nkr_note_orig_0213001", "type": "orig", "text": "末字更勘"}
{"id": null, "n": "0213002", "target": "#nkr_note_orig_0213002", "type": "orig", "text": "舊於是為卷下．從此至終抽於月師合註中"}
{"id": null, "n": "0213003", "target": "#nkr_note_orig_0213003", "type": "orig", "text": "墮疑隨或類墮乎"}
{"id": null, "n": "0213004", "target": "#nkr_note_orig_0213004", "type": "orig", "text": "報一作執"}
{"id": null, "n": "0214001", "target": "#nkr_note_orig_0214001", "type": "orig", "text": "皆一作背"}
{"id": null, "n": "0214002", "target": "#nkr_note_orig_0214002", "type": "orig", "text": "又作父"}
{"id": null, "n": "0215001", "target": "#nkr_note_orig_0215001", "type": "orig", "text": "莫通暮"}
