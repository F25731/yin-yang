{"id": null, "n": null, "target": null, "type": null, "text": "并"}
{"id": null, "n": null, "target": null, "type": null, "text": "揀釋補○附六借"}
{"id": null, "n": null, "target": null, "type": null, "text": "并"}
{"id": null, "n": null, "target": null, "type": null, "text": "是至下閑居士曹洞贊附例"}
{"id": null, "n": null, "target": null, "type": null, "text": "附百文三句"}
{"id": null, "n": null, "target": null, "type": null, "text": "即九峰也"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "此問正位中事。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此問偏中事。"}
{"id": null, "n": null, "target": null, "type": null, "text": "補曰：傳燈\n作宣州，恐此錄誤矣。盖宣、冥、溟三寫之訛。"}
{"id": null, "n": null, "target": null, "type": null, "text": "舊本欠此也二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "一作此"}
{"id": null, "n": null, "target": null, "type": null, "text": "一作遵"}
{"id": null, "n": null, "target": null, "type": null, "text": "或本作稅又銳"}
{"id": null, "n": null, "target": null, "type": null, "text": "補曰：學論：優婆夷者，取處塵不染之意，言隨染大悲大行。"}
{"id": null, "n": null, "target": null, "type": null, "text": "一本莾鹵下云：夫問答兩家，語勢相報，皆不出五位也。但\n語有麤細，答有淺深，所以先師於非言句中強以言，皆為對緣而設斯要耳。"}
{"id": null, "n": null, "target": null, "type": null, "text": "并"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云。此與白眉序同"}
{"id": null, "n": null, "target": null, "type": null, "text": "新補"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "新補，舊無註，要易說聽，今夾岫師註。"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "󳴤人，趙康文，字周臣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "以上卷上終"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "疑非全文乎"}
{"id": null, "n": null, "target": null, "type": null, "text": "庚申"}
{"id": null, "n": "0197001", "target": "#nkr_note_orig_0197001", "type": "orig", "text": "（便宜上，表題ヲ附ス。󴦒）"}
{"id": null, "n": "0198001", "target": "#nkr_note_orig_0198001", "type": "orig", "text": "起疑超下同"}
{"id": null, "n": "0199001", "target": "#nkr_note_orig_0199001", "type": "orig", "text": "乘疑乖次同"}
{"id": null, "n": "0201001", "target": "#nkr_note_orig_0201001", "type": "orig", "text": "徵當作微"}
{"id": null, "n": "0201002", "target": "#nkr_note_orig_0201002", "type": "orig", "text": "劫當作却"}
{"id": null, "n": "0201003", "target": "#nkr_note_orig_0201003", "type": "orig", "text": "樂當作藥"}
{"id": null, "n": "0203001", "target": "#nkr_note_orig_0203001", "type": "orig", "text": "烏當作鳥"}
{"id": null, "n": "0203002", "target": "#nkr_note_orig_0203002", "type": "orig", "text": "靈一作虛"}
{"id": null, "n": "0203003", "target": "#nkr_note_orig_0203003", "type": "orig", "text": "五位一作兩意"}
{"id": null, "n": "0205001", "target": "#nkr_note_orig_0205001", "type": "orig", "text": "膽當作瞻"}
{"id": null, "n": "0205002", "target": "#nkr_note_orig_0205002", "type": "orig", "text": "里疑黑"}
{"id": null, "n": "0205003", "target": "#nkr_note_orig_0205003", "type": "orig", "text": "古疑舌"}
{"id": null, "n": "0206001", "target": "#nkr_note_orig_0206001", "type": "orig", "text": "休當作什"}
{"id": null, "n": "0206002", "target": "#nkr_note_orig_0206002", "type": "orig", "text": "央疑失"}
{"id": null, "n": "0206003", "target": "#nkr_note_orig_0206003", "type": "orig", "text": "金疑寶"}
{"id": null, "n": "0207001", "target": "#nkr_note_orig_0207001", "type": "orig", "text": "問疑開"}
