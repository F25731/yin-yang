{"id": null, "n": "0503007", "target": "#nkr_note_mod_0503007", "type": "mod", "text": "西【大】，宋西【明】"}
{"id": null, "n": "0503008", "target": "#nkr_note_mod_0503008", "type": "mod", "text": "法【大】，教【明】"}
{"id": null, "n": "0503009", "target": "#nkr_note_mod_0503009", "type": "mod", "text": "臣【大】，〔－〕【明】"}
{"id": null, "n": "0503010", "target": "#nkr_note_mod_0503010", "type": "mod", "text": "尚【大】，上【明】"}
{"id": null, "n": "0503011", "target": "#nkr_note_mod_0503011", "type": "mod", "text": "旃【大】＊，栴【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0503012", "target": "#nkr_note_mod_0503012", "type": "mod", "text": "檐【大】，擔【宋】【元】【明】"}
{"id": null, "n": "0503013", "target": "#nkr_note_mod_0503013", "type": "mod", "text": "喻【大】，踰【明】"}
{"id": null, "n": "0503014", "target": "#nkr_note_mod_0503014", "type": "mod", "text": "臂【大】，寶臂【宋】【元】【明】"}
{"id": null, "n": "0503015", "target": "#nkr_note_mod_0503015", "type": "mod", "text": "既【大】，即【宋】【元】【明】"}
{"id": null, "n": "0503016", "target": "#nkr_note_mod_0503016", "type": "mod", "text": "昨【大】，日【明】"}
{"id": null, "n": "0504001", "target": "#nkr_note_mod_0504001", "type": "mod", "text": "酥【大】，蘇【宋】【元】"}
{"id": null, "n": "0504002", "target": "#nkr_note_mod_0504002", "type": "mod", "text": "娑【大】，婆【明】"}
{"id": null, "n": "0505001", "target": "#nkr_note_mod_0505001", "type": "mod", "text": "三【大】，二【宋】【元】【明】"}
{"id": null, "n": "0505002", "target": "#nkr_note_mod_0505002", "type": "mod", "text": "尼【大】，尾【宋】【元】【明】"}
{"id": null, "n": "0505003", "target": "#nkr_note_mod_0505003", "type": "mod", "text": "引【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0505004", "target": "#nkr_note_mod_0505004", "type": "mod", "text": "結【大】，潔【明】"}
{"id": null, "n": "0505005", "target": "#nkr_note_mod_0505005", "type": "mod", "text": "拇【大】，母【明】"}
{"id": null, "n": "0505006", "target": "#nkr_note_mod_0505006", "type": "mod", "text": "罪【大】，非【明】"}
{"id": null, "n": "0505007", "target": "#nkr_note_mod_0505007", "type": "mod", "text": "如【大】，於【明】"}
{"id": null, "n": "0505008", "target": "#nkr_note_mod_0505008", "type": "mod", "text": "大【大】，人【元】"}
{"id": null, "n": "0505009", "target": "#nkr_note_mod_0505009", "type": "mod", "text": "減【大】，欲【元】【明】，減字宋本白闕"}
{"id": null, "n": "0505010", "target": "#nkr_note_mod_0505010", "type": "mod", "text": "當【大】，常【宋】【元】【明】"}
{"id": null, "n": "0506001", "target": "#nkr_note_mod_0506001", "type": "mod", "text": "仗【大】，依【明】"}
