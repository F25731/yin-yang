{"id": null, "n": null, "target": null, "type": null, "text": "左踏大天，右踏天后"}
{"id": null, "n": "0577009", "target": "#nkr_note_mod_0577009", "type": "mod", "text": "特【大】，恃【校異-原】"}
{"id": null, "n": "0577010", "target": "#nkr_note_mod_0577010", "type": "mod", "text": "言【大】，言曰【校異-原】"}
{"id": null, "n": "0577008", "target": "#nkr_note_orig_0577008", "type": "orig", "text": "【原】享和元年刊長谷寺藏本"}
{"id": null, "n": "0577009", "target": "#nkr_note_orig_0577009", "type": "orig", "text": "特＝恃ィ【原】"}
{"id": null, "n": "0577010", "target": "#nkr_note_orig_0577010", "type": "orig", "text": "言＋（曰）ィ【原】"}
