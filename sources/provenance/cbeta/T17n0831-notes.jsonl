{"id": null, "n": "0877007", "target": "#nkr_note_mod_0877007", "type": "mod", "text": "反【大】下同，切【明】下同"}
{"id": null, "n": "0877008", "target": "#nkr_note_mod_0877008", "type": "mod", "text": "是【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0877009", "target": "#nkr_note_mod_0877009", "type": "mod", "text": "何【大】，阿【宋】【元】【明】【宮】"}
