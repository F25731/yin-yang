{"id": null, "n": "0877003", "target": "#nkr_note_mod_0877003", "type": "mod", "text": "伽【大】，迦【元】【明】"}
{"id": null, "n": "0877004", "target": "#nkr_note_mod_0877004", "type": "mod", "text": "于【大】，污【宋】【元】【明】"}
{"id": null, "n": "0877005", "target": "#nkr_note_mod_0877005", "type": "mod", "text": "集【大】，習【宋】【元】【明】【宮】"}
