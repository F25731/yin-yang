{"id": null, "n": "0876001", "target": "#nkr_note_mod_0876001", "type": "mod", "text": "謗【大】＊，佛說謗【元】【明】＊"}
{"id": null, "n": "0876002", "target": "#nkr_note_mod_0876002", "type": "mod", "text": "三藏【大】，三藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0876003", "target": "#nkr_note_mod_0876003", "type": "mod", "text": "流【大】，留【宋】【元】【明】【宮】"}
{"id": null, "n": "0876004", "target": "#nkr_note_mod_0876004", "type": "mod", "text": "師子【大】，師子座【宋】【元】【明】【宮】"}
{"id": null, "n": "0876005", "target": "#nkr_note_mod_0876005", "type": "mod", "text": "音【大】，奇【元】"}
{"id": null, "n": "0876006", "target": "#nkr_note_mod_0876006", "type": "mod", "text": "年【大】，千【宮】"}
{"id": null, "n": "0876007", "target": "#nkr_note_mod_0876007", "type": "mod", "text": "智【大】，種【宋】【元】【明】【宮】"}
{"id": null, "n": "0876008", "target": "#nkr_note_mod_0876008", "type": "mod", "text": "廂【大】，相【宋】【元】【明】"}
{"id": null, "n": "0876009", "target": "#nkr_note_mod_0876009", "type": "mod", "text": "有【大】，智【宋】【元】【明】"}
