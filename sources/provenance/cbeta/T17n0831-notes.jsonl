{"id": null, "n": "0876011", "target": "#nkr_note_mod_0876011", "type": "mod", "text": "曰【大】，日【宋】【宮】"}
{"id": null, "n": "0876012", "target": "#nkr_note_mod_0876012", "type": "mod", "text": "有【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0876013", "target": "#nkr_note_mod_0876013", "type": "mod", "text": "逕【大】，經【宋】【元】【明】【宮】"}
{"id": null, "n": "0877001", "target": "#nkr_note_mod_0877001", "type": "mod", "text": "分【大】，分中【宋】【元】【明】【宮】"}
