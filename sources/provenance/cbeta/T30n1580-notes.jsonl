{"id": null, "n": null, "target": null, "type": "cf1", "text": "《福州藏》（日本宮內庁書陵部藏大藏經db2第2514帖第17圖第5行）"}
{"id": null, "n": "0883001", "target": "#nkr_note_mod_0883001", "type": "mod", "text": "一卷【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0883002", "target": "#nkr_note_mod_0883002", "type": "mod", "text": "三【大】，唐三【明】"}
{"id": null, "n": "0883003", "target": "#nkr_note_mod_0883003", "type": "mod", "text": "種姓【大】，種性【明】"}
{"id": null, "n": "0883004", "target": "#nkr_note_mod_0883004", "type": "mod", "text": "謂【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0884001", "target": "#nkr_note_mod_0884001", "type": "mod", "text": "辨【大】下同，辯【宋】【元】【明】【宮】下同"}
{"id": null, "n": "0884002", "target": "#nkr_note_mod_0884002", "type": "mod", "text": "止【大】，正【宋】【元】【明】【宮】"}
{"id": null, "n": "0884003", "target": "#nkr_note_mod_0884003", "type": "mod", "text": "論【大】，詮【宋】【元】【明】【宮】"}
{"id": null, "n": "0884004", "target": "#nkr_note_mod_0884004", "type": "mod", "text": "行【大】，共行【宋】【元】【明】【宮】"}
{"id": null, "n": "0884005", "target": "#nkr_note_mod_0884005", "type": "mod", "text": "白【大】＊，自【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0885001", "target": "#nkr_note_mod_0885001", "type": "mod", "text": "芽【大】，牙【宋】【宮】"}
{"id": null, "n": "0885002", "target": "#nkr_note_mod_0885002", "type": "mod", "text": "門【大】，問【宋】【元】【明】【宮】"}
{"id": null, "n": "0887001", "target": "#nkr_note_mod_0887001", "type": "mod", "text": "所有【大】，有所【明】"}
{"id": null, "n": "0887002", "target": "#nkr_note_mod_0887002", "type": "mod", "text": "多【CB】【宮-CB】【宋】【元】【明】【宮】，哆【大】"}
{"id": null, "n": "0887003", "target": "#nkr_note_mod_0887003", "type": "mod", "text": "種性【大】，種姓【宋】【元】【宮】"}
{"id": null, "n": "0887004", "target": "#nkr_note_mod_0887004", "type": "mod", "text": "憂【大】，受【宋】【元】"}
{"id": null, "n": "0888001", "target": "#nkr_note_mod_0888001", "type": "mod", "text": "瑜伽師地論釋一卷【大】，〔－〕【明】"}
{"id": null, "n": "0883001", "target": "#nkr_note_orig_0883001", "type": "orig", "text": "〔一卷〕－【三】【宮】"}
{"id": null, "n": "0883002", "target": "#nkr_note_orig_0883002", "type": "orig", "text": "（唐）＋三【明】"}
{"id": null, "n": "0883003", "target": "#nkr_note_orig_0883003", "type": "orig", "text": "種姓＝種性【明】"}
{"id": null, "n": "0883004", "target": "#nkr_note_orig_0883004", "type": "orig", "text": "〔謂〕－【三】【宮】"}
{"id": null, "n": "0884001", "target": "#nkr_note_orig_0884001", "type": "orig", "text": "辨＝辯【三】【宮】下同"}
{"id": null, "n": "0884002", "target": "#nkr_note_orig_0884002", "type": "orig", "text": "止＝正【三】【宮】"}
{"id": null, "n": "0884003", "target": "#nkr_note_orig_0884003", "type": "orig", "text": "論＝詮【三】【宮】"}
{"id": null, "n": "0884004", "target": "#nkr_note_orig_0884004", "type": "orig", "text": "（共）＋行【三】【宮】"}
{"id": null, "n": "0884005", "target": "#nkr_note_orig_0884005", "type": "orig", "text": "白＝自【三】【宮】＊"}
{"id": null, "n": "0885001", "target": "#nkr_note_orig_0885001", "type": "orig", "text": "芽＝牙【宋】【宮】"}
{"id": null, "n": "0885002", "target": "#nkr_note_orig_0885002", "type": "orig", "text": "門＝問【三】【宮】"}
{"id": null, "n": "0887001", "target": "#nkr_note_orig_0887001", "type": "orig", "text": "所有＝有所【明】"}
{"id": null, "n": "0887002", "target": "#nkr_note_orig_0887002", "type": "orig", "text": "哆＝多【三】【宮】"}
{"id": null, "n": "0887003", "target": "#nkr_note_orig_0887003", "type": "orig", "text": "種性＝種姓【宋】【元】【宮】"}
{"id": null, "n": "0887004", "target": "#nkr_note_orig_0887004", "type": "orig", "text": "憂＝受【宋】【元】"}
{"id": null, "n": "0888001", "target": "#nkr_note_orig_0888001", "type": "orig", "text": "〔瑜伽師地論釋一卷〕－【明】"}
{"id": null, "n": "0883b0701", "target": "#nkr_note_add_0883b0701", "type": "add", "text": "姓【CB】【麗-CB】，性【大】"}
{"id": null, "n": "0884b0401", "target": "#nkr_note_add_0884b0401", "type": "add", "text": "倒【大】，到【麗-CB】"}
{"id": null, "n": "0887a0901", "target": "#nkr_note_add_0887a0901", "type": "add", "text": "多【大】，哆【麗-CB】"}
