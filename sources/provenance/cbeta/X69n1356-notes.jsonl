{"id": null, "n": null, "target": null, "type": null, "text": "因李昭文施財鑄鐘作"}
{"id": null, "n": null, "target": null, "type": null, "text": "以手指鍾，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "良久，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "遂拈鍾鎚，驀顧視大眾，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "遂擊一鎚，放下鍾鎚，云："}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
