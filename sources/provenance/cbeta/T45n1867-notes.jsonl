{"id": null, "n": null, "target": null, "type": null, "text": "法然而不\n\n空。空相法然而不空，故生死涅槃而下一"}
{"id": null, "n": null, "target": null, "type": null, "text": "空故，緣起之法無性即空。問：是無耶？答：不也，即有故，以緣起之法即由無\n始得有故。問：也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即不得入一切珠也。何以故？\n離此珠內無別珠故。問：若離此珠內無一切珠者，此網即但"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": "0509004", "target": "#nkr_note_mod_0509004", "type": "mod", "text": "執我【大】，〔－〕【校異-原】"}
{"id": null, "n": "0509005", "target": "#nkr_note_mod_0509005", "type": "mod", "text": "（即為…色）六字【大】，〔－〕【校異-原】"}
{"id": null, "n": "0509006", "target": "#nkr_note_mod_0509006", "type": "mod", "text": "識【大】，〔－〕【校異-原】"}
{"id": null, "n": "0510001", "target": "#nkr_note_mod_0510001", "type": "mod", "text": "色種【大】，〔－〕【校異-原】"}
{"id": null, "n": "0510002", "target": "#nkr_note_mod_0510002", "type": "mod", "text": "脫【大】，〔－〕【校異-原】"}
{"id": null, "n": "0510003", "target": "#nkr_note_mod_0510003", "type": "mod", "text": "將【大】，將作【校異-原】"}
{"id": null, "n": "0510004", "target": "#nkr_note_mod_0510004", "type": "mod", "text": "素【大】，索【校異-原】"}
{"id": null, "n": "0511001", "target": "#nkr_note_mod_0511001", "type": "mod", "text": "沈淪於【大】，汎論於一【校異-原】"}
{"id": null, "n": "0511002", "target": "#nkr_note_mod_0511002", "type": "mod", "text": "懸差別【大】，妄懸差【校異-原】"}
{"id": null, "n": "0511003", "target": "#nkr_note_mod_0511003", "type": "mod", "text": "二見【大】，無二【校異-原】"}
{"id": null, "n": "0511004", "target": "#nkr_note_mod_0511004", "type": "mod", "text": "以不攝生【大】，〔－〕【校異-原】"}
{"id": null, "n": "0511005", "target": "#nkr_note_mod_0511005", "type": "mod", "text": "不【大】，〔－〕【校異-原】"}
{"id": null, "n": "0511006", "target": "#nkr_note_mod_0511006", "type": "mod", "text": "恒【大】，不【校異-原】"}
{"id": null, "n": "0512001", "target": "#nkr_note_mod_0512001", "type": "mod", "text": "礙【大】，〔－〕【校異-原】"}
{"id": null, "n": "0512002", "target": "#nkr_note_mod_0512002", "type": "mod", "text": "住【大】，〔－〕【校異-原】"}
{"id": null, "n": "0512003", "target": "#nkr_note_mod_0512003", "type": "mod", "text": "相【大】，〔－〕【校異-原】"}
{"id": null, "n": "0512004", "target": "#nkr_note_mod_0512004", "type": "mod", "text": "是【大】，是有【考偽-原】"}
{"id": null, "n": "0512005", "target": "#nkr_note_mod_0512005", "type": "mod", "text": "同【大】，同時【校異-原】"}
{"id": null, "n": "0513001", "target": "#nkr_note_mod_0513001", "type": "mod", "text": "緣【大】，緣起【校異-原】"}
{"id": null, "n": "0513002", "target": "#nkr_note_mod_0513002", "type": "mod", "text": "別【大】，割【校異-原】"}
{"id": null, "n": "0513003", "target": "#nkr_note_mod_0513003", "type": "mod", "text": "故【大】，故全收此為彼【考偽-原】"}
{"id": null, "n": "0513004", "target": "#nkr_note_mod_0513004", "type": "mod", "text": "此【大】，此一【校異-原】"}
{"id": null, "n": "0513005", "target": "#nkr_note_mod_0513005", "type": "mod", "text": "有邊【大】，〔－〕【校異-原】"}
{"id": null, "n": "0513006", "target": "#nkr_note_mod_0513006", "type": "mod", "text": "高【大】，顯【考偽-原】"}
{"id": null, "n": "0513007", "target": "#nkr_note_mod_0513007", "type": "mod", "text": "坐【大】，坐著【校異-原】"}
{"id": null, "n": "0513008", "target": "#nkr_note_mod_0513008", "type": "mod", "text": "即【大】，即坐【校異-原】"}
{"id": null, "n": "0513009", "target": "#nkr_note_mod_0513009", "type": "mod", "text": "始【大】，〔－〕【校異-原】"}
{"id": null, "n": "0513010", "target": "#nkr_note_mod_0513010", "type": "mod", "text": "（華嚴…云云）四十八字【大】，〔－〕【校異-原】"}
{"id": null, "n": "0514001", "target": "#nkr_note_mod_0514001", "type": "mod", "text": "却【大】，却至【校異-原】"}
{"id": null, "n": "0514002", "target": "#nkr_note_mod_0514002", "type": "mod", "text": "上【大】，且【考偽-原】"}
{"id": null, "n": "0514003", "target": "#nkr_note_mod_0514003", "type": "mod", "text": "鼓【大】，鼓聲【校異-原】"}
