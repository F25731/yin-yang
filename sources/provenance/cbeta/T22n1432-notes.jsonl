{"id": null, "n": "1041007", "target": "#nkr_note_mod_1041007", "type": "mod", "text": "磨【大】，磨卷上【明】"}
{"id": null, "n": "1041008", "target": "#nkr_note_mod_1041008", "type": "mod", "text": "四分【大】，四五分【宋】【元】【宮】，〔－〕【明】"}
{"id": null, "n": "1041009", "target": "#nkr_note_mod_1041009", "type": "mod", "text": "曹【大】，前【宋】【元】【明】【宮】"}
{"id": null, "n": "1041010", "target": "#nkr_note_mod_1041010", "type": "mod", "text": "戒【大】，界【宋】【元】【明】【宮】"}
{"id": null, "n": "1041011", "target": "#nkr_note_mod_1041011", "type": "mod", "text": "相【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1041012", "target": "#nkr_note_mod_1041012", "type": "mod", "text": "界【大】，戒【宋】【元】【明】【宮】"}
{"id": null, "n": "1041013", "target": "#nkr_note_mod_1041013", "type": "mod", "text": "戒【大】，界【宋】【元】【明】【宮】"}
{"id": null, "n": "1041014", "target": "#nkr_note_mod_1041014", "type": "mod", "text": "用【大】，周【宮】"}
{"id": null, "n": "1041015", "target": "#nkr_note_mod_1041015", "type": "mod", "text": "欲【大】，〔－〕【宮】"}
{"id": null, "n": "1041016", "target": "#nkr_note_mod_1041016", "type": "mod", "text": "村村【大】，材材【宮】"}
{"id": null, "n": "1041017", "target": "#nkr_note_mod_1041017", "type": "mod", "text": "結【大】，給【元】"}
{"id": null, "n": "1041018", "target": "#nkr_note_mod_1041018", "type": "mod", "text": "渡【大】，流【宮】"}
{"id": null, "n": "1042001", "target": "#nkr_note_mod_1042001", "type": "mod", "text": "膝【大】，脚【宋】【元】【宮】"}
{"id": null, "n": "1042002", "target": "#nkr_note_mod_1042002", "type": "mod", "text": "上【大】＊，尚【宋】【元】【明】【宮】＊"}
{"id": null, "n": "1042003", "target": "#nkr_note_mod_1042003", "type": "mod", "text": "答【大】＊，報【宋】【元】【宮】＊"}
{"id": null, "n": "1042004", "target": "#nkr_note_mod_1042004", "type": "mod", "text": "盜【大】，婬【宮】"}
{"id": null, "n": "1042005", "target": "#nkr_note_mod_1042005", "type": "mod", "text": "婬【大】，盜【宮】"}
{"id": null, "n": "1042006", "target": "#nkr_note_mod_1042006", "type": "mod", "text": "油【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1042007", "target": "#nkr_note_mod_1042007", "type": "mod", "text": "高【大】，高廣【宋】【元】【明】【宮】"}
{"id": null, "n": "1042008", "target": "#nkr_note_mod_1042008", "type": "mod", "text": "像【CB】【磧-CB】【元】【明】，象【大】，象【麗-CB】"}
{"id": null, "n": "1042009", "target": "#nkr_note_mod_1042009", "type": "mod", "text": "嚴飾【大】，金銀【明】"}
{"id": null, "n": "1042010", "target": "#nkr_note_mod_1042010", "type": "mod", "text": "乾痟【大】＊，𤴲痁【宮】＊"}
{"id": null, "n": "1042011", "target": "#nkr_note_mod_1042011", "type": "mod", "text": "癲【大】，顛【宋】【元】【明】【宮】"}
{"id": null, "n": "1042012", "target": "#nkr_note_mod_1042012", "type": "mod", "text": "手【大】，乎【元】"}
{"id": null, "n": "1042013", "target": "#nkr_note_mod_1042013", "type": "mod", "text": "已【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1042014", "target": "#nkr_note_mod_1042014", "type": "mod", "text": "二【大】，三【宮】"}
{"id": null, "n": "1042015", "target": "#nkr_note_mod_1042015", "type": "mod", "text": "四【大】，曰【宮】"}
{"id": null, "n": "1042016", "target": "#nkr_note_mod_1042016", "type": "mod", "text": "今【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1042017", "target": "#nkr_note_mod_1042017", "type": "mod", "text": "與【大】，於【明】"}
{"id": null, "n": "1043001", "target": "#nkr_note_mod_1043001", "type": "mod", "text": "斫【大】＊，破【宋】【元】【明】【宮】＊"}
{"id": null, "n": "1043002", "target": "#nkr_note_mod_1043002", "type": "mod", "text": "破【大】＊，斫【宋】【元】【明】【宮】＊"}
{"id": null, "n": "1043003", "target": "#nkr_note_mod_1043003", "type": "mod", "text": "天【大】，天已【宋】【元】【明】【宮】"}
{"id": null, "n": "1043004", "target": "#nkr_note_mod_1043004", "type": "mod", "text": "食【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1043005", "target": "#nkr_note_mod_1043005", "type": "mod", "text": "酥【大】＊，蘇【宋】【宮】＊"}
{"id": null, "n": "1043006", "target": "#nkr_note_mod_1043006", "type": "mod", "text": "功【大】，功德【宋】【元】【明】【宮】"}
{"id": null, "n": "1043007", "target": "#nkr_note_mod_1043007", "type": "mod", "text": "失【大】，父【宮】"}
{"id": null, "n": "1043008", "target": "#nkr_note_mod_1043008", "type": "mod", "text": "餘【大】，徐【元】【明】"}
{"id": null, "n": "1043009", "target": "#nkr_note_mod_1043009", "type": "mod", "text": "者【大】，〔－〕【宮】"}
{"id": null, "n": "1043010", "target": "#nkr_note_mod_1043010", "type": "mod", "text": "一二【大】，三【宮】"}
{"id": null, "n": "1043011", "target": "#nkr_note_mod_1043011", "type": "mod", "text": "白【大】，曰【宮】"}
{"id": null, "n": "1043012", "target": "#nkr_note_mod_1043012", "type": "mod", "text": "未【大】，朱【宮】"}
{"id": null, "n": "1043013", "target": "#nkr_note_mod_1043013", "type": "mod", "text": "今【大】，令【宮】"}
{"id": null, "n": "1044001", "target": "#nkr_note_mod_1044001", "type": "mod", "text": "受【大】，笑【宮】"}
{"id": null, "n": "1044002", "target": "#nkr_note_mod_1044002", "type": "mod", "text": "此【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "1044003", "target": "#nkr_note_mod_1044003", "type": "mod", "text": "今【大】，今捨【宋】【元】【明】【宮】"}
{"id": null, "n": "1044004", "target": "#nkr_note_mod_1044004", "type": "mod", "text": "若【大】，苦【明】"}
{"id": null, "n": "1044005", "target": "#nkr_note_mod_1044005", "type": "mod", "text": "言【大】，說【宋】【元】【明】【宮】"}
{"id": null, "n": "1044006", "target": "#nkr_note_mod_1044006", "type": "mod", "text": "犯【大】，犯罪【宋】【元】【明】【宮】"}
