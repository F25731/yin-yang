{"id": null, "n": null, "target": null, "type": null, "text": "棲着語低\n聲低聲"}
{"id": null, "n": null, "target": null, "type": null, "text": "解也學也"}
{"id": null, "n": null, "target": null, "type": null, "text": "溪深路滑"}
{"id": null, "n": null, "target": null, "type": null, "text": "春色滿園關不住"}
{"id": null, "n": null, "target": null, "type": null, "text": "爭似寸絲\n不掛"}
{"id": null, "n": null, "target": null, "type": null, "text": "成顛亦不惡"}
{"id": null, "n": null, "target": null, "type": null, "text": "胡餅裏詞\n汁"}
{"id": null, "n": null, "target": null, "type": null, "text": "夏行冬令寒暑不正"}
{"id": null, "n": null, "target": null, "type": null, "text": "性海無波\n下一撓，千華覆頂伴漁樵，林間散誕成蓮社，石上提撕好掛瓢。昔日衣冠懸碧漢，今朝杖履渡溪橋，法門得入\n多生幸，拈出摩尼破寂寥。"}
