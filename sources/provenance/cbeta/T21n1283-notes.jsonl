{"id": null, "n": "0343008", "target": "#nkr_note_mod_0343008", "type": "mod", "text": "西【大】＊，宋西【明】＊"}
{"id": null, "n": "0343009", "target": "#nkr_note_mod_0343009", "type": "mod", "text": "譯經【大】＊，〔－〕【明】＊"}
{"id": null, "n": "0343010", "target": "#nkr_note_mod_0343010", "type": "mod", "text": "傳【大】，明【宋】【元】"}
{"id": null, "n": "0343011", "target": "#nkr_note_mod_0343011", "type": "mod", "text": "臣【大】＊，〔－〕【明】＊"}
{"id": null, "n": "0343012", "target": "#nkr_note_mod_0343012", "type": "mod", "text": "達【大】，闥【明】"}
{"id": null, "n": "0343013", "target": "#nkr_note_mod_0343013", "type": "mod", "text": "晨【大】，辰【宋】"}
{"id": null, "n": "0343014", "target": "#nkr_note_mod_0343014", "type": "mod", "text": "囉【大】，嚕【明】"}
{"id": null, "n": "0344001", "target": "#nkr_note_mod_0344001", "type": "mod", "text": "言如【大】，夜叉【明】"}
{"id": null, "n": "0344002", "target": "#nkr_note_mod_0344002", "type": "mod", "text": "賀【大】，賀引【宋】【元】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0344003", "target": "#nkr_note_mod_0344003", "type": "mod", "text": "盤【大】，槃【宋】【元】【明】"}
{"id": null, "n": "0344004", "target": "#nkr_note_mod_0344004", "type": "mod", "text": "合【大】，合引【宋】【元】【明】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0344005", "target": "#nkr_note_mod_0344005", "type": "mod", "text": "三【大】，二【宋】【元】【明】"}
{"id": null, "n": "0345001", "target": "#nkr_note_mod_0345001", "type": "mod", "text": "引【大】，〔－〕【宋】【元】【明】"}
{"id": null, "n": "0345002", "target": "#nkr_note_mod_0345002", "type": "mod", "text": "馱【大】，陀【宋】【元】【明】"}
{"id": null, "n": "0345003", "target": "#nkr_note_mod_0345003", "type": "mod", "text": "獲【大】，護【明】"}
{"id": null, "n": "0345004", "target": "#nkr_note_mod_0345004", "type": "mod", "text": "弟【大】，第【宋】【元】【明】"}
{"id": null, "n": "0345005", "target": "#nkr_note_mod_0345005", "type": "mod", "text": "闍【大】，闊【宋】"}
{"id": null, "n": "0345006", "target": "#nkr_note_mod_0345006", "type": "mod", "text": "志【大】，至【元】【明】"}
{"id": null, "n": "0345007", "target": "#nkr_note_mod_0345007", "type": "mod", "text": "淨【大】，清淨【宋】【元】【明】"}
{"id": null, "n": "0345008", "target": "#nkr_note_mod_0345008", "type": "mod", "text": "次【大】，作【宋】【元】【明】"}
{"id": null, "n": "0345009", "target": "#nkr_note_mod_0345009", "type": "mod", "text": "憂【大】＊，優【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0345010", "target": "#nkr_note_mod_0345010", "type": "mod", "text": "拼【大】，絣【明】"}
{"id": null, "n": "0345011", "target": "#nkr_note_mod_0345011", "type": "mod", "text": "尾【大】，尼【明】"}
