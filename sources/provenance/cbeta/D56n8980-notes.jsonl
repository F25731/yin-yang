{"id": null, "n": null, "target": null, "type": null, "text": "興嗣"}
{"id": null, "n": null, "target": null, "type": null, "text": "祖心"}
{"id": null, "n": null, "target": null, "type": null, "text": "心是名也"}
{"id": null, "n": null, "target": null, "type": null, "text": "知是心也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "舉功能義用而問之"}
{"id": null, "n": null, "target": null, "type": null, "text": "舉名荅之"}
{"id": null, "n": null, "target": null, "type": null, "text": "徵其體也"}
{"id": null, "n": null, "target": null, "type": null, "text": "尅體指也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此舉功能義用問也"}
{"id": null, "n": null, "target": null, "type": null, "text": "舉名荅也"}
{"id": null, "n": null, "target": null, "type": null, "text": "徵其體也"}
{"id": null, "n": null, "target": null, "type": null, "text": "指其體也"}
{"id": null, "n": null, "target": null, "type": null, "text": "達磨云。指一言以直示。即是知字一言。若言即心是佛此乃四言矣。"}
{"id": null, "n": null, "target": null, "type": null, "text": "祖心"}
{"id": null, "n": null, "target": null, "type": null, "text": "推破云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "祖心"}
{"id": null, "n": null, "target": null, "type": null, "text": "何履踐。荅。教誰履踐。問。莫"}
{"id": null, "n": null, "target": null, "type": null, "text": "道樞"}
{"id": null, "n": null, "target": null, "type": null, "text": "宗建識于恱生齋中"}
