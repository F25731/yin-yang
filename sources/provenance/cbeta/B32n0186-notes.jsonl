{"id": null, "n": null, "target": null, "type": null, "text": "舍利弗七日得\n羅漢。目連十五日得羅漢。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "舊云六百年間。"}
{"id": null, "n": null, "target": null, "type": null, "text": "或二十卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦云北魏。亦云後魏。"}
{"id": null, "n": null, "target": null, "type": null, "text": "取意。"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦云元魏。亦云北魏。"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋論之中具牒本論。"}
{"id": null, "n": null, "target": null, "type": null, "text": "欽明"}
{"id": null, "n": null, "target": null, "type": null, "text": "敏達"}
{"id": null, "n": null, "target": null, "type": null, "text": "第一僧正同寺觀勒。"}
{"id": null, "n": null, "target": null, "type": null, "text": "或作觀字。"}
{"id": null, "n": null, "target": null, "type": null, "text": "古老傳云。結庵八十日住。"}
{"id": null, "n": null, "target": null, "type": null, "text": "但勝賢一代唯密宗。"}
{"id": null, "n": null, "target": null, "type": null, "text": "皇極重祚"}
{"id": null, "n": null, "target": null, "type": null, "text": "或遇玄奘慈恩學習宗旨者。然二師入滅經年序。"}
{"id": null, "n": null, "target": null, "type": null, "text": "或經救大僧都"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "即東大寺羂索堂也。名法華堂。"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上"}
{"id": null, "n": null, "target": null, "type": null, "text": "後任僧正。"}
{"id": null, "n": null, "target": null, "type": null, "text": "興福寺最初別當"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上取意。"}
{"id": null, "n": null, "target": null, "type": null, "text": "甲午"}
{"id": null, "n": null, "target": null, "type": null, "text": "甲午"}
{"id": null, "n": null, "target": null, "type": null, "text": "從天台取。若從南岳取者是第五世。"}
{"id": null, "n": null, "target": null, "type": null, "text": "已上"}
