{"id": null, "n": "0467022", "target": "#nkr_note_orig_0467022", "type": "orig", "text": "〔即〕－【甲】"}
{"id": null, "n": "0467023", "target": "#nkr_note_orig_0467023", "type": "orig", "text": "〔真言〕－【甲】＊"}
{"id": null, "n": "0467024", "target": "#nkr_note_orig_0467024", "type": "orig", "text": "〔立〕－【甲】"}
{"id": null, "n": "0467025", "target": "#nkr_note_orig_0467025", "type": "orig", "text": "蘇＋（上）夾註【甲】"}
{"id": null, "n": "0467026", "target": "#nkr_note_orig_0467026", "type": "orig", "text": "頗也＝播也二合去一【甲】"}
{"id": null, "n": "0467027", "target": "#nkr_note_orig_0467027", "type": "orig", "text": "也＋（二）夾註【甲】"}
{"id": null, "n": "0467028", "target": "#nkr_note_orig_0467028", "type": "orig", "text": "儞也他唵蘇＝姪嬭也反他去三唵四蘇二合【甲】"}
{"id": null, "n": "0467029", "target": "#nkr_note_orig_0467029", "type": "orig", "text": "蘇嚕＝蘇上嚕五【甲】"}
{"id": null, "n": "0467030", "target": "#nkr_note_orig_0467030", "type": "orig", "text": "鉢＝跋【甲】＊"}
{"id": null, "n": "0467031", "target": "#nkr_note_orig_0467031", "type": "orig", "text": "嚕＋（六）夾註【甲】"}
{"id": null, "n": "0467032", "target": "#nkr_note_orig_0467032", "type": "orig", "text": "嚕＋（七）夾註【甲】"}
{"id": null, "n": "0467033", "target": "#nkr_note_orig_0467033", "type": "orig", "text": "嚩＝縛【甲】"}
{"id": null, "n": "0467034", "target": "#nkr_note_orig_0467034", "type": "orig", "text": "賀＝訶【甲】"}
{"id": null, "n": "0467035", "target": "#nkr_note_orig_0467035", "type": "orig", "text": "〔呪〕－ヵ【原】"}
{"id": null, "n": "0467036", "target": "#nkr_note_orig_0467036", "type": "orig", "text": "〔喫〕－【甲】"}
{"id": null, "n": "0467037", "target": "#nkr_note_orig_0467037", "type": "orig", "text": "〔印〕－【甲】"}
{"id": null, "n": "0467038", "target": "#nkr_note_orig_0467038", "type": "orig", "text": "於＝以【甲】"}
{"id": null, "n": "0467039", "target": "#nkr_note_orig_0467039", "type": "orig", "text": "〔八〕－【甲】"}
{"id": null, "n": "0467040", "target": "#nkr_note_orig_0467040", "type": "orig", "text": "〔呪曰〕－ヵ【原】"}
{"id": null, "n": "0467041", "target": "#nkr_note_orig_0467041", "type": "orig", "text": "〔曰誦〕－【甲】"}
{"id": null, "n": "0467042", "target": "#nkr_note_orig_0467042", "type": "orig", "text": "〔鑁〕－【甲】"}
{"id": null, "n": "0467043", "target": "#nkr_note_orig_0467043", "type": "orig", "text": "滿多＝漫多一【甲】"}
{"id": null, "n": "0467044", "target": "#nkr_note_orig_0467044", "type": "orig", "text": "沒＝勃【甲】"}
{"id": null, "n": "0467045", "target": "#nkr_note_orig_0467045", "type": "orig", "text": "喃鑁去＝喃二縛𤙖二合三【甲】"}
{"id": null, "n": "0467046", "target": "#nkr_note_orig_0467046", "type": "orig", "text": "〔曩謨…也〕二十字－【甲】"}
{"id": null, "n": "0467047", "target": "#nkr_note_orig_0467047", "type": "orig", "text": "曩謨＝南無【甲】＊"}
{"id": null, "n": "0467048", "target": "#nkr_note_orig_0467048", "type": "orig", "text": "除慳乃至滿八字甲本作細註"}
{"id": null, "n": "0467049", "target": "#nkr_note_orig_0467049", "type": "orig", "text": "貪＝悋【甲】"}
{"id": null, "n": "0467050", "target": "#nkr_note_orig_0467050", "type": "orig", "text": "（得）＋福【甲】"}
{"id": null, "n": "0467051", "target": "#nkr_note_orig_0467051", "type": "orig", "text": "滿＋（也）【甲】"}
{"id": null, "n": "0467052", "target": "#nkr_note_orig_0467052", "type": "orig", "text": "〔曩謨…也〕十六字－【甲】"}
{"id": null, "n": "0467053", "target": "#nkr_note_orig_0467053", "type": "orig", "text": "破醜陋形四字甲本作細註"}
{"id": null, "n": "0467054", "target": "#nkr_note_orig_0467054", "type": "orig", "text": "〔相好圓滿〕－【甲】"}
{"id": null, "n": "0467055", "target": "#nkr_note_orig_0467055", "type": "orig", "text": "〔曩謨…耶〕十九字－【甲】"}
{"id": null, "n": "0467056", "target": "#nkr_note_orig_0467056", "type": "orig", "text": "灌法乃至樂八字甲本作細註"}
{"id": null, "n": "0467057", "target": "#nkr_note_orig_0467057", "type": "orig", "text": "樂＋（也）【甲】"}
{"id": null, "n": "0467058", "target": "#nkr_note_orig_0467058", "type": "orig", "text": "〔曩謨…也〕二十一字－【甲】"}
{"id": null, "n": "0467059", "target": "#nkr_note_orig_0467059", "type": "orig", "text": "咽喉寬大四字甲本作細註"}
{"id": null, "n": "0467060", "target": "#nkr_note_orig_0467060", "type": "orig", "text": "〔受妙味〕－【甲】"}
{"id": null, "n": "0468001", "target": "#nkr_note_orig_0468001", "type": "orig", "text": "〔曩謨…耶〕二十字－【甲】"}
{"id": null, "n": "0468002", "target": "#nkr_note_orig_0468002", "type": "orig", "text": "恐怖乃至趣八字甲本作細註"}
{"id": null, "n": "0468003", "target": "#nkr_note_orig_0468003", "type": "orig", "text": "〔誦〕－【甲】"}
{"id": null, "n": "0468004", "target": "#nkr_note_orig_0468004", "type": "orig", "text": "遍＋（出金剛大道場大明呪經）【甲】"}
{"id": null, "n": "0468005", "target": "#nkr_note_orig_0468005", "type": "orig", "text": "〔印合掌也〕－【甲】"}
{"id": null, "n": "0468006", "target": "#nkr_note_orig_0468006", "type": "orig", "text": "摩＝昧【甲】"}
{"id": null, "n": "0468007", "target": "#nkr_note_orig_0468007", "type": "orig", "text": "梵＝𭊃婆𤙖反【甲】"}
{"id": null, "n": "0468008", "target": "#nkr_note_orig_0468008", "type": "orig", "text": "曰＝云是解脫金剛明誦之度厄也呪曰【甲】"}
{"id": null, "n": "0468009", "target": "#nkr_note_orig_0468009", "type": "orig", "text": "嚩日囉目乞灑＝麼惹羅二合慕羯叉二合【甲】"}
{"id": null, "n": "0468010", "target": "#nkr_note_orig_0468010", "type": "orig", "text": "呪＝手ヵ【原】，〔呪〕－【甲】"}
{"id": null, "n": "0468011", "target": "#nkr_note_orig_0468011", "type": "orig", "text": "啟＝契ヵ【原】"}
{"id": null, "n": "0468012", "target": "#nkr_note_orig_0468012", "type": "orig", "text": "〔者〕－【甲】"}
{"id": null, "n": "0468013", "target": "#nkr_note_orig_0468013", "type": "orig", "text": "〔而〕－【甲】"}
{"id": null, "n": "0468014", "target": "#nkr_note_orig_0468014", "type": "orig", "text": "〔是〕－【甲】"}
{"id": null, "n": "0468015", "target": "#nkr_note_orig_0468015", "type": "orig", "text": "以下甲本無"}
