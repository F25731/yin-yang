{"id": null, "n": null, "target": null, "type": null, "text": "註：勿作蓮花臺上舍那法身，難解也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "注不當經"}
{"id": null, "n": null, "target": null, "type": null, "text": "注：欲降魔\n思慮。"}
{"id": null, "n": null, "target": null, "type": null, "text": "注：魔言廣也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "注：正\n眼妙心暗故。"}
{"id": null, "n": null, "target": null, "type": null, "text": "注：別可深解也"}
{"id": null, "n": null, "target": null, "type": null, "text": "注：認奴勿作郎"}
{"id": null, "n": null, "target": null, "type": null, "text": "注：有知得理者煩惱"}
{"id": null, "n": null, "target": null, "type": null, "text": "大尾"}
{"id": null, "n": null, "target": null, "type": null, "text": "時七十八歲"}
{"id": null, "n": null, "target": null, "type": null, "text": "全軸分為二本"}
{"id": null, "n": null, "target": null, "type": null, "text": "乃載卷首"}
{"id": null, "n": null, "target": null, "type": null, "text": "秀衡廟所經堂，今存"}
{"id": null, "n": null, "target": null, "type": null, "text": "天台古剎"}
{"id": null, "n": null, "target": null, "type": null, "text": "能忍舊跡，今作洞宗"}
{"id": null, "n": null, "target": null, "type": null, "text": "號阿名寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "斯藏非守護金森許容，不能輙窺"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T12n0374_p0405b22"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K09n0105_p0057b07"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T12n0374_p0403b26"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X01n0026_p0423c11"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "X01n0026_p0426c02"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "見《漢語大詞典》第三卷第435"}
{"id": null, "n": "0418001", "target": "#nkr_note_mod_0418001", "type": "mod", "text": "大龍已下一葉半餘脫"}
{"id": null, "n": "0426003", "target": "#nkr_note_mod_0426003", "type": "mod", "text": "魔【CB】，麾【卍續】，麾一作魔"}
{"id": null, "n": "0430001", "target": "#nkr_note_mod_0430001", "type": "mod", "text": "已下依涅槃經題文叚句體有四十餘行脫"}
{"id": null, "n": "0433001", "target": "#nkr_note_mod_0433001", "type": "mod", "text": "註者不知仍舊存之已下傚之"}
{"id": null, "n": "0417003", "target": "#nkr_note_orig_0417003", "type": "orig", "text": "傍有小圈者字存半而補之者也"}
{"id": null, "n": "0418001", "target": "#nkr_note_orig_0418001", "type": "orig", "text": "大龍巳下一葉半餘脫"}
{"id": null, "n": "0419001", "target": "#nkr_note_orig_0419001", "type": "orig", "text": "語疑意"}
{"id": null, "n": "0420001", "target": "#nkr_note_orig_0420001", "type": "orig", "text": "出下疑脫胎字"}
{"id": null, "n": "0422001", "target": "#nkr_note_orig_0422001", "type": "orig", "text": "受疑愛"}
{"id": null, "n": "0422002", "target": "#nkr_note_orig_0422002", "type": "orig", "text": "隨疑墮"}
{"id": null, "n": "0424001", "target": "#nkr_note_orig_0424001", "type": "orig", "text": "光一作充"}
{"id": null, "n": "0425001", "target": "#nkr_note_orig_0425001", "type": "orig", "text": "具一作異"}
{"id": null, "n": "0425002", "target": "#nkr_note_orig_0425002", "type": "orig", "text": "亦等十一字衍文乎"}
{"id": null, "n": "0425003", "target": "#nkr_note_orig_0425003", "type": "orig", "text": "知下一有恒字"}
{"id": null, "n": "0426001", "target": "#nkr_note_orig_0426001", "type": "orig", "text": "怒疑可作恕"}
{"id": null, "n": "0426002", "target": "#nkr_note_orig_0426002", "type": "orig", "text": "無等六字疑剩"}
{"id": null, "n": "0426003", "target": "#nkr_note_orig_0426003", "type": "orig", "text": "麾一作魔"}
{"id": null, "n": "0430001", "target": "#nkr_note_orig_0430001", "type": "orig", "text": "巳下依涅槃經題文叚句體有四十餘行脫"}
{"id": null, "n": "0430002", "target": "#nkr_note_orig_0430002", "type": "orig", "text": "光疑先"}
{"id": null, "n": "0430003", "target": "#nkr_note_orig_0430003", "type": "orig", "text": "當品末章依涅槃經照見脫紙五六帖餘也"}
{"id": null, "n": "0430004", "target": "#nkr_note_orig_0430004", "type": "orig", "text": "此一章亦復脫紙二帖餘也五十餘行脫"}
{"id": null, "n": "0431001", "target": "#nkr_note_orig_0431001", "type": "orig", "text": "有一作在"}
{"id": null, "n": "0431002", "target": "#nkr_note_orig_0431002", "type": "orig", "text": "能一作思下同"}
{"id": null, "n": "0432001", "target": "#nkr_note_orig_0432001", "type": "orig", "text": "此略說三寶四字脫歟"}
{"id": null, "n": "0432002", "target": "#nkr_note_orig_0432002", "type": "orig", "text": "世上下恐有脫文"}
{"id": null, "n": "0433001", "target": "#nkr_note_orig_0433001", "type": "orig", "text": "註者不知仍舊存之巳下傚之"}
{"id": null, "n": "0435001", "target": "#nkr_note_orig_0435001", "type": "orig", "text": "非上疑脫一句"}
{"id": null, "n": "0436001", "target": "#nkr_note_orig_0436001", "type": "orig", "text": "＊着疑若（＊印ノ字ハ本文ト異ナル。󴦒）"}
{"id": null, "n": "0436002", "target": "#nkr_note_orig_0436002", "type": "orig", "text": "此處恐有脫簡歟"}
{"id": null, "n": "0436003", "target": "#nkr_note_orig_0436003", "type": "orig", "text": "感疑作惑"}
{"id": null, "n": "0436004", "target": "#nkr_note_orig_0436004", "type": "orig", "text": "冀一作異"}
{"id": null, "n": "0440001", "target": "#nkr_note_orig_0440001", "type": "orig", "text": "此下三行滅"}
{"id": null, "n": "0417c1001", "target": "#nkr_note_add_0417c1001", "type": "add", "text": "［－］【CB】，一【卍續】"}
