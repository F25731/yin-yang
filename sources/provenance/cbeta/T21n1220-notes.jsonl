{"id": null, "n": "0098047", "target": "#nkr_note_orig_0098047", "type": "orig", "text": "少＝小【乙】"}
{"id": null, "n": "0098048", "target": "#nkr_note_orig_0098048", "type": "orig", "text": "（惡）＋人【甲】【乙】"}
{"id": null, "n": "0098049", "target": "#nkr_note_orig_0098049", "type": "orig", "text": "（令）＋甦【甲】"}
{"id": null, "n": "0098050", "target": "#nkr_note_orig_0098050", "type": "orig", "text": "谷＝各ィ【原】"}
{"id": null, "n": "0098051", "target": "#nkr_note_orig_0098051", "type": "orig", "text": "大＋（慈）【乙】"}
{"id": null, "n": "0098052", "target": "#nkr_note_orig_0098052", "type": "orig", "text": "𠳿婆＝尾波【甲】，比波【乙】"}
{"id": null, "n": "0098053", "target": "#nkr_note_orig_0098053", "type": "orig", "text": "賀＋（引）細註【甲】"}
{"id": null, "n": "0098054", "target": "#nkr_note_orig_0098054", "type": "orig", "text": "〔誠〕－【甲】"}
{"id": null, "n": "0098055", "target": "#nkr_note_orig_0098055", "type": "orig", "text": "安居不安立＝居不立【甲】，居安不立【乙】"}
{"id": null, "n": "0098056", "target": "#nkr_note_orig_0098056", "type": "orig", "text": "〔而〕－【甲】【乙】"}
{"id": null, "n": "0098057", "target": "#nkr_note_orig_0098057", "type": "orig", "text": "叉＋（藥叉）【甲】"}
{"id": null, "n": "0098058", "target": "#nkr_note_orig_0098058", "type": "orig", "text": "〔就〕－【甲】【乙】"}
{"id": null, "n": "0098059", "target": "#nkr_note_orig_0098059", "type": "orig", "text": "禱＝魅【甲】【乙】"}
{"id": null, "n": "0098060", "target": "#nkr_note_orig_0098060", "type": "orig", "text": "言＋（曰）【甲】【乙】"}
{"id": null, "n": "0098061", "target": "#nkr_note_orig_0098061", "type": "orig", "text": "自是呪至儀軌十一字甲本作本文"}
{"id": null, "n": "0098062", "target": "#nkr_note_orig_0098062", "type": "orig", "text": "密故＝深故【甲】，祕密也【乙】"}
{"id": null, "n": "0098063", "target": "#nkr_note_orig_0098063", "type": "orig", "text": "不得＝得不ィ【原】"}
{"id": null, "n": "0098064", "target": "#nkr_note_orig_0098064", "type": "orig", "text": "呪印＝呪印有ィ【原】，但印呪在【甲】，但印呪【乙】"}
{"id": null, "n": "0098065", "target": "#nkr_note_orig_0098065", "type": "orig", "text": "命＝依【甲】"}
{"id": null, "n": "0098066", "target": "#nkr_note_orig_0098066", "type": "orig", "text": "囉＝羅【甲】【乙】"}
{"id": null, "n": "0099001", "target": "#nkr_note_orig_0099001", "type": "orig", "text": "尾＋（蘇）【乙】"}
{"id": null, "n": "0099002", "target": "#nkr_note_orig_0099002", "type": "orig", "text": "吒＝咤【甲】"}
{"id": null, "n": "0099003", "target": "#nkr_note_orig_0099003", "type": "orig", "text": "莎＝娑【甲】"}
{"id": null, "n": "0099004", "target": "#nkr_note_orig_0099004", "type": "orig", "text": "甲本自奉座至一切七百四十九字缺之"}
