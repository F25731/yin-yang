{"id": null, "n": null, "target": null, "type": null, "text": "引九感入十"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0098002", "target": "#nkr_note_mod_0098002", "type": "mod", "text": "王【大】，〔－〕【甲】"}
{"id": null, "n": "0098003", "target": "#nkr_note_mod_0098003", "type": "mod", "text": "右【大】，一【甲】【乙】"}
{"id": null, "n": "0098004", "target": "#nkr_note_mod_0098004", "type": "mod", "text": "器【大】，〔－〕【甲】"}
{"id": null, "n": "0098005", "target": "#nkr_note_mod_0098005", "type": "mod", "text": "等令我【大】，世間不令我進【甲】"}
{"id": null, "n": "0098006", "target": "#nkr_note_mod_0098006", "type": "mod", "text": "多退【大】，進退多【乙】"}
{"id": null, "n": "0098007", "target": "#nkr_note_mod_0098007", "type": "mod", "text": "佛言【大】，〔－〕【甲】"}
{"id": null, "n": "0098008", "target": "#nkr_note_mod_0098008", "type": "mod", "text": "曰願【大】，白佛言【甲】"}
{"id": null, "n": "0098009", "target": "#nkr_note_mod_0098009", "type": "mod", "text": "自心【大】，息災【甲】"}
{"id": null, "n": "0098010", "target": "#nkr_note_mod_0098010", "type": "mod", "text": "哉【大】，哉善哉【甲】【乙】"}
{"id": null, "n": "0098011", "target": "#nkr_note_mod_0098011", "type": "mod", "text": "仁【大】，仁者【乙】"}
{"id": null, "n": "0098012", "target": "#nkr_note_mod_0098012", "type": "mod", "text": "為【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0098013", "target": "#nkr_note_mod_0098013", "type": "mod", "text": "如【大】，如盛【校異-原】"}
{"id": null, "n": "0098014", "target": "#nkr_note_mod_0098014", "type": "mod", "text": "象【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0098015", "target": "#nkr_note_mod_0098015", "type": "mod", "text": "持行【大】，行持【甲】"}
{"id": null, "n": "0098016", "target": "#nkr_note_mod_0098016", "type": "mod", "text": "縛【大】＊，嚩【甲】＊"}
{"id": null, "n": "0098017", "target": "#nkr_note_mod_0098017", "type": "mod", "text": "羽【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0098018", "target": "#nkr_note_mod_0098018", "type": "mod", "text": "引【大】，引【甲】【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0098019", "target": "#nkr_note_mod_0098019", "type": "mod", "text": "五【大】，第五【甲】【乙】"}
{"id": null, "n": "0098020", "target": "#nkr_note_mod_0098020", "type": "mod", "text": "辟【大】，臂【甲】"}
{"id": null, "n": "0098021", "target": "#nkr_note_mod_0098021", "type": "mod", "text": "合【大】，令【校異-原】"}
{"id": null, "n": "0098022", "target": "#nkr_note_mod_0098022", "type": "mod", "text": "明【大】，〔－〕【乙】"}
{"id": null, "n": "0098023", "target": "#nkr_note_mod_0098023", "type": "mod", "text": "南【大】＊，喃【甲】＊"}
{"id": null, "n": "0098024", "target": "#nkr_note_mod_0098024", "type": "mod", "text": "嚩【大】，縛【甲】"}
{"id": null, "n": "0098025", "target": "#nkr_note_mod_0098025", "type": "mod", "text": "嚀【大】＊，寧【甲】【乙】＊"}
{"id": null, "n": "0098026", "target": "#nkr_note_mod_0098026", "type": "mod", "text": "尾【大】，〔－〕【甲】"}
{"id": null, "n": "0098027", "target": "#nkr_note_mod_0098027", "type": "mod", "text": "二合【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0098028", "target": "#nkr_note_mod_0098028", "type": "mod", "text": "九【大】，〔－〕【甲】"}
{"id": null, "n": "0098029", "target": "#nkr_note_mod_0098029", "type": "mod", "text": "八【大】，〔－〕【甲】"}
{"id": null, "n": "0098030", "target": "#nkr_note_mod_0098030", "type": "mod", "text": "入引九【大】，八【甲】"}
{"id": null, "n": "0098031", "target": "#nkr_note_mod_0098031", "type": "mod", "text": "引十感入十一【大】，引九感入十【甲】"}
{"id": null, "n": "0098032", "target": "#nkr_note_mod_0098032", "type": "mod", "text": "祖【大】，𭉷【甲】"}
{"id": null, "n": "0098033", "target": "#nkr_note_mod_0098033", "type": "mod", "text": "咄【大】，咄𠽁【甲】"}
{"id": null, "n": "0098034", "target": "#nkr_note_mod_0098034", "type": "mod", "text": "十三【大】，十一【甲】"}
{"id": null, "n": "0098035", "target": "#nkr_note_mod_0098035", "type": "mod", "text": "羅【大】＊，〔－〕【甲】＊"}
{"id": null, "n": "0098036", "target": "#nkr_note_mod_0098036", "type": "mod", "text": "十三【大】，十二【宋】【元】【明】"}
{"id": null, "n": "0098037", "target": "#nkr_note_mod_0098037", "type": "mod", "text": "以下此真言中甲本無記數"}
{"id": null, "n": "0098038", "target": "#nkr_note_mod_0098038", "type": "mod", "text": "引二合【大】，二合引【甲】"}
{"id": null, "n": "0098039", "target": "#nkr_note_mod_0098039", "type": "mod", "text": "佛【大】，金剛藥叉王【校異-原】【乙】"}
{"id": null, "n": "0098040", "target": "#nkr_note_mod_0098040", "type": "mod", "text": "大【大】，天【甲】【乙】"}
{"id": null, "n": "0098041", "target": "#nkr_note_mod_0098041", "type": "mod", "text": "穩【大】，隱【甲】"}
{"id": null, "n": "0098042", "target": "#nkr_note_mod_0098042", "type": "mod", "text": "令【大】，今【甲】【乙】"}
{"id": null, "n": "0098043", "target": "#nkr_note_mod_0098043", "type": "mod", "text": "樂【大】，安樂【甲】【乙】"}
{"id": null, "n": "0098044", "target": "#nkr_note_mod_0098044", "type": "mod", "text": "王【大】，王等【甲】【乙】"}
{"id": null, "n": "0098045", "target": "#nkr_note_mod_0098045", "type": "mod", "text": "擾惱【大】，惱擾【甲】【乙】"}
{"id": null, "n": "0098046", "target": "#nkr_note_mod_0098046", "type": "mod", "text": "意【大】，心【乙】"}
{"id": null, "n": "0098047", "target": "#nkr_note_mod_0098047", "type": "mod", "text": "少【大】，小【乙】"}
{"id": null, "n": "0098048", "target": "#nkr_note_mod_0098048", "type": "mod", "text": "人【大】，惡人【甲】【乙】"}
{"id": null, "n": "0098049", "target": "#nkr_note_mod_0098049", "type": "mod", "text": "甦【大】，令甦【甲】"}
{"id": null, "n": "0098050", "target": "#nkr_note_mod_0098050", "type": "mod", "text": "谷【大】，各【校異-原】"}
{"id": null, "n": "0098051", "target": "#nkr_note_mod_0098051", "type": "mod", "text": "大【大】，大慈【乙】"}
{"id": null, "n": "0098052", "target": "#nkr_note_mod_0098052", "type": "mod", "text": "𠳿婆【大】，尾波【甲】，比波【乙】"}
{"id": null, "n": "0098053", "target": "#nkr_note_mod_0098053", "type": "mod", "text": "賀【大】，賀引【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "引"}
{"id": null, "n": "0098054", "target": "#nkr_note_mod_0098054", "type": "mod", "text": "誠【大】，〔－〕【甲】"}
{"id": null, "n": "0098055", "target": "#nkr_note_mod_0098055", "type": "mod", "text": "安居不安立【大】，居不立【甲】，居安不立【乙】"}
{"id": null, "n": "0098056", "target": "#nkr_note_mod_0098056", "type": "mod", "text": "而【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0098057", "target": "#nkr_note_mod_0098057", "type": "mod", "text": "叉【大】，叉藥叉【甲】"}
{"id": null, "n": "0098058", "target": "#nkr_note_mod_0098058", "type": "mod", "text": "就【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0098059", "target": "#nkr_note_mod_0098059", "type": "mod", "text": "禱【大】，魅【甲】【乙】"}
{"id": null, "n": "0098060", "target": "#nkr_note_mod_0098060", "type": "mod", "text": "言【大】，言曰【甲】【乙】"}
{"id": null, "n": "0098061", "target": "#nkr_note_mod_0098061", "type": "mod", "text": "自是呪至儀軌十一字甲本作本文"}
{"id": null, "n": "0098062", "target": "#nkr_note_mod_0098062", "type": "mod", "text": "密故【大】，深故【甲】，祕密也【乙】"}
{"id": null, "n": "0098063", "target": "#nkr_note_mod_0098063", "type": "mod", "text": "不得【大】，得不【校異-原】"}
{"id": null, "n": "0098064", "target": "#nkr_note_mod_0098064", "type": "mod", "text": "呪印【大】，呪印有【校異-原】，但印呪在【甲】，但印呪【乙】"}
{"id": null, "n": "0098065", "target": "#nkr_note_mod_0098065", "type": "mod", "text": "命【大】，依【甲】"}
{"id": null, "n": "0098066", "target": "#nkr_note_mod_0098066", "type": "mod", "text": "囉【大】，羅【甲】【乙】"}
{"id": null, "n": "0099001", "target": "#nkr_note_mod_0099001", "type": "mod", "text": "尾【大】，尾蘇【乙】"}
{"id": null, "n": "0099002", "target": "#nkr_note_mod_0099002", "type": "mod", "text": "吒【大】，咤【甲】"}
{"id": null, "n": "0099003", "target": "#nkr_note_mod_0099003", "type": "mod", "text": "莎【大】，娑【甲】"}
{"id": null, "n": "0099004", "target": "#nkr_note_mod_0099004", "type": "mod", "text": "（奉座…一切）七百四十八字【大】，〔－〕【甲】"}
{"id": null, "n": "0099005", "target": "#nkr_note_mod_0099005", "type": "mod", "text": "牟【大】，平入【乙】"}
{"id": null, "n": "0099006", "target": "#nkr_note_mod_0099006", "type": "mod", "text": "矩【大】，舍【乙】"}
{"id": null, "n": "0099007", "target": "#nkr_note_mod_0099007", "type": "mod", "text": "何【大】，伺【乙】"}
{"id": null, "n": "0099008", "target": "#nkr_note_mod_0099008", "type": "mod", "text": "灑【大】，麗【考偽-原】"}
{"id": null, "n": "0099009", "target": "#nkr_note_mod_0099009", "type": "mod", "text": "畫人【大】，書彼人【乙】"}
{"id": null, "n": "0099010", "target": "#nkr_note_mod_0099010", "type": "mod", "text": "中【大】，中調【校異-原】"}
{"id": null, "n": "0099011", "target": "#nkr_note_mod_0099011", "type": "mod", "text": "嚗噁【大】，暴惡【乙】"}
{"id": null, "n": "0099012", "target": "#nkr_note_mod_0099012", "type": "mod", "text": "呪【大】，加持【考偽-原】"}
{"id": null, "n": "0099013", "target": "#nkr_note_mod_0099013", "type": "mod", "text": "打【大】，打人像【乙】"}
{"id": null, "n": "0099014", "target": "#nkr_note_mod_0099014", "type": "mod", "text": "斃【大】，卒死【乙】"}
{"id": null, "n": "0099015", "target": "#nkr_note_mod_0099015", "type": "mod", "text": "解免【大】，解脫此【校異-原】"}
{"id": null, "n": "0099016", "target": "#nkr_note_mod_0099016", "type": "mod", "text": "明【大】，真言【乙】"}
{"id": null, "n": "0099017", "target": "#nkr_note_mod_0099017", "type": "mod", "text": "生【大】，〔－〕【乙】"}
{"id": null, "n": "0099018", "target": "#nkr_note_mod_0099018", "type": "mod", "text": "見【大】，見麁惡【乙】"}
{"id": null, "n": "0099019", "target": "#nkr_note_mod_0099019", "type": "mod", "text": "皮【大】，葉【乙】"}
{"id": null, "n": "0099020", "target": "#nkr_note_mod_0099020", "type": "mod", "text": "白啟【大】，迫啟白【乙】"}
{"id": null, "n": "0099021", "target": "#nkr_note_mod_0099021", "type": "mod", "text": "意不【大】，心非【乙】"}
{"id": null, "n": "0099022", "target": "#nkr_note_mod_0099022", "type": "mod", "text": "跉來【大】，來極【乙】"}
{"id": null, "n": "0099023", "target": "#nkr_note_mod_0099023", "type": "mod", "text": "非【大】，不【乙】"}
{"id": null, "n": "0099024", "target": "#nkr_note_mod_0099024", "type": "mod", "text": "夫【大】，妻【乙】"}
{"id": null, "n": "0099025", "target": "#nkr_note_mod_0099025", "type": "mod", "text": "俱【大】，〔－〕【乙】"}
{"id": null, "n": "0099026", "target": "#nkr_note_mod_0099026", "type": "mod", "text": "人矣【大】，〔－〕【乙】"}
{"id": null, "n": "0099027", "target": "#nkr_note_mod_0099027", "type": "mod", "text": "真言【大】，呪【乙】"}
{"id": null, "n": "0099028", "target": "#nkr_note_mod_0099028", "type": "mod", "text": "（則作…就）八字【大】，〔－〕【乙】"}
{"id": null, "n": "0099029", "target": "#nkr_note_mod_0099029", "type": "mod", "text": "修行【大】，作【校異-原】"}
{"id": null, "n": "0099030", "target": "#nkr_note_mod_0099030", "type": "mod", "text": "雜【大】，種【乙】"}
{"id": null, "n": "0099031", "target": "#nkr_note_mod_0099031", "type": "mod", "text": "怒【大】，怒王【乙】"}
{"id": null, "n": "0099032", "target": "#nkr_note_mod_0099032", "type": "mod", "text": "莫起惡【大】，勿不善【校異-原】，勿起惡【乙】"}
{"id": null, "n": "0099033", "target": "#nkr_note_mod_0099033", "type": "mod", "text": "損【大】，自損損【乙】"}
{"id": null, "n": "0099034", "target": "#nkr_note_mod_0099034", "type": "mod", "text": "耎【大】，柔【乙】"}
{"id": null, "n": "0099035", "target": "#nkr_note_mod_0099035", "type": "mod", "text": "人【大】，者【乙】"}
{"id": null, "n": "0099036", "target": "#nkr_note_mod_0099036", "type": "mod", "text": "而得自順順他【大】，未年滿足者得自損損他【乙】"}
{"id": null, "n": "0099037", "target": "#nkr_note_mod_0099037", "type": "mod", "text": "隨【大】，墮落【乙】"}
{"id": null, "n": "0099038", "target": "#nkr_note_mod_0099038", "type": "mod", "text": "過【大】，咎【校異-原】"}
{"id": null, "n": "0099039", "target": "#nkr_note_mod_0099039", "type": "mod", "text": "悲【大】，愍【宋】【元】【明】"}
{"id": null, "n": "0099040", "target": "#nkr_note_mod_0099040", "type": "mod", "text": "而【大】，〔－〕【乙】"}
{"id": null, "n": "0099041", "target": "#nkr_note_mod_0099041", "type": "mod", "text": "住【大】，必住【乙】"}
{"id": null, "n": "0099042", "target": "#nkr_note_mod_0099042", "type": "mod", "text": "叉【大】，叉瞋怒息災大威神驗【甲】"}
{"id": null, "n": "0098001", "target": "#nkr_note_orig_0098001", "type": "orig", "text": "【原】享保年間刊豐山大學藏本，【甲】寬治四年寫仁和寺藏本，【乙】東寺三密藏古寫本"}
{"id": null, "n": "0098002", "target": "#nkr_note_orig_0098002", "type": "orig", "text": "〔王〕－【甲】"}
{"id": null, "n": "0098003", "target": "#nkr_note_orig_0098003", "type": "orig", "text": "右＝一【甲】【乙】"}
{"id": null, "n": "0098004", "target": "#nkr_note_orig_0098004", "type": "orig", "text": "〔器〕－【甲】"}
{"id": null, "n": "0098005", "target": "#nkr_note_orig_0098005", "type": "orig", "text": "等令我＝世間不令我進【甲】"}
{"id": null, "n": "0098006", "target": "#nkr_note_orig_0098006", "type": "orig", "text": "多退＝進退多【乙】"}
{"id": null, "n": "0098007", "target": "#nkr_note_orig_0098007", "type": "orig", "text": "〔佛言〕－【甲】"}
{"id": null, "n": "0098008", "target": "#nkr_note_orig_0098008", "type": "orig", "text": "曰願＝白佛言【甲】"}
{"id": null, "n": "0098009", "target": "#nkr_note_orig_0098009", "type": "orig", "text": "自心＝息災【甲】"}
{"id": null, "n": "0098010", "target": "#nkr_note_orig_0098010", "type": "orig", "text": "哉＋（善哉）【甲】【乙】"}
{"id": null, "n": "0098011", "target": "#nkr_note_orig_0098011", "type": "orig", "text": "仁＋（者）【乙】"}
{"id": null, "n": "0098012", "target": "#nkr_note_orig_0098012", "type": "orig", "text": "〔為〕－【甲】【乙】"}
{"id": null, "n": "0098013", "target": "#nkr_note_orig_0098013", "type": "orig", "text": "如＋（盛）ィ【原】"}
{"id": null, "n": "0098014", "target": "#nkr_note_orig_0098014", "type": "orig", "text": "〔象〕－【甲】【乙】"}
{"id": null, "n": "0098015", "target": "#nkr_note_orig_0098015", "type": "orig", "text": "持行＝行持【甲】"}
{"id": null, "n": "0098016", "target": "#nkr_note_orig_0098016", "type": "orig", "text": "縛＝嚩【甲】＊"}
{"id": null, "n": "0098017", "target": "#nkr_note_orig_0098017", "type": "orig", "text": "〔羽〕－【甲】【乙】"}
{"id": null, "n": "0098018", "target": "#nkr_note_orig_0098018", "type": "orig", "text": "引字甲乙兩本作細註"}
{"id": null, "n": "0098019", "target": "#nkr_note_orig_0098019", "type": "orig", "text": "（第）＋五【甲】【乙】"}
{"id": null, "n": "0098020", "target": "#nkr_note_orig_0098020", "type": "orig", "text": "辟＝臂【甲】"}
{"id": null, "n": "0098021", "target": "#nkr_note_orig_0098021", "type": "orig", "text": "合＝令ィ【原】"}
{"id": null, "n": "0098022", "target": "#nkr_note_orig_0098022", "type": "orig", "text": "〔明〕－【乙】"}
{"id": null, "n": "0098023", "target": "#nkr_note_orig_0098023", "type": "orig", "text": "南＝喃【甲】＊"}
{"id": null, "n": "0098024", "target": "#nkr_note_orig_0098024", "type": "orig", "text": "嚩＝縛【甲】"}
{"id": null, "n": "0098025", "target": "#nkr_note_orig_0098025", "type": "orig", "text": "嚀＝寧【甲】【乙】＊"}
{"id": null, "n": "0098026", "target": "#nkr_note_orig_0098026", "type": "orig", "text": "〔尾〕－【甲】"}
{"id": null, "n": "0098027", "target": "#nkr_note_orig_0098027", "type": "orig", "text": "〔二合〕－【甲】【乙】"}
{"id": null, "n": "0098028", "target": "#nkr_note_orig_0098028", "type": "orig", "text": "〔九〕－【甲】"}
{"id": null, "n": "0098029", "target": "#nkr_note_orig_0098029", "type": "orig", "text": "〔八〕－【甲】"}
{"id": null, "n": "0098030", "target": "#nkr_note_orig_0098030", "type": "orig", "text": "入引九＝八【甲】"}
{"id": null, "n": "0098031", "target": "#nkr_note_orig_0098031", "type": "orig", "text": "引十感入十一＝引九感入十【甲】"}
{"id": null, "n": "0098032", "target": "#nkr_note_orig_0098032", "type": "orig", "text": "祖＝𭉷【甲】"}
{"id": null, "n": "0098033", "target": "#nkr_note_orig_0098033", "type": "orig", "text": "咄＋（𠽁）【甲】"}
{"id": null, "n": "0098034", "target": "#nkr_note_orig_0098034", "type": "orig", "text": "十三＝十一【甲】"}
{"id": null, "n": "0098035", "target": "#nkr_note_orig_0098035", "type": "orig", "text": "〔羅〕－【甲】＊"}
{"id": null, "n": "0098036", "target": "#nkr_note_orig_0098036", "type": "orig", "text": "十三＝十二【三】"}
{"id": null, "n": "0098037", "target": "#nkr_note_orig_0098037", "type": "orig", "text": "以下此真言中甲本無記數"}
{"id": null, "n": "0098038", "target": "#nkr_note_orig_0098038", "type": "orig", "text": "引二合＝二合引【甲】"}
{"id": null, "n": "0098039", "target": "#nkr_note_orig_0098039", "type": "orig", "text": "佛＝金剛藥叉王ィ【原】【乙】"}
{"id": null, "n": "0098040", "target": "#nkr_note_orig_0098040", "type": "orig", "text": "大＝天【甲】【乙】"}
{"id": null, "n": "0098041", "target": "#nkr_note_orig_0098041", "type": "orig", "text": "穩＝隱【甲】"}
{"id": null, "n": "0098042", "target": "#nkr_note_orig_0098042", "type": "orig", "text": "令＝今【甲】【乙】"}
{"id": null, "n": "0098043", "target": "#nkr_note_orig_0098043", "type": "orig", "text": "（安）＋樂【甲】【乙】"}
