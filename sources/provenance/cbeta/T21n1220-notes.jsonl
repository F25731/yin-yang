{"id": null, "n": "0099007", "target": "#nkr_note_orig_0099007", "type": "orig", "text": "何＝伺【乙】"}
{"id": null, "n": "0099008", "target": "#nkr_note_orig_0099008", "type": "orig", "text": "灑＝麗ヵ【原】"}
{"id": null, "n": "0099009", "target": "#nkr_note_orig_0099009", "type": "orig", "text": "畫人＝書彼人【乙】"}
{"id": null, "n": "0099010", "target": "#nkr_note_orig_0099010", "type": "orig", "text": "中＋（調）ィ【原】"}
{"id": null, "n": "0099011", "target": "#nkr_note_orig_0099011", "type": "orig", "text": "嚗噁＝暴惡【乙】"}
{"id": null, "n": "0099012", "target": "#nkr_note_orig_0099012", "type": "orig", "text": "呪＝加持ヵ【原】"}
{"id": null, "n": "0099013", "target": "#nkr_note_orig_0099013", "type": "orig", "text": "打＋（人像）【乙】"}
{"id": null, "n": "0099014", "target": "#nkr_note_orig_0099014", "type": "orig", "text": "斃＝卒死【乙】"}
{"id": null, "n": "0099015", "target": "#nkr_note_orig_0099015", "type": "orig", "text": "解免＝解脫此ィ【原】"}
{"id": null, "n": "0099016", "target": "#nkr_note_orig_0099016", "type": "orig", "text": "明＝真言【乙】"}
{"id": null, "n": "0099017", "target": "#nkr_note_orig_0099017", "type": "orig", "text": "〔生〕－【乙】"}
{"id": null, "n": "0099018", "target": "#nkr_note_orig_0099018", "type": "orig", "text": "見＋（麁惡）【乙】"}
{"id": null, "n": "0099019", "target": "#nkr_note_orig_0099019", "type": "orig", "text": "皮＝葉【乙】"}
{"id": null, "n": "0099020", "target": "#nkr_note_orig_0099020", "type": "orig", "text": "白啟＝迫啟白【乙】"}
{"id": null, "n": "0099021", "target": "#nkr_note_orig_0099021", "type": "orig", "text": "意不＝心非【乙】"}
{"id": null, "n": "0099022", "target": "#nkr_note_orig_0099022", "type": "orig", "text": "跉來＝來極【乙】"}
{"id": null, "n": "0099023", "target": "#nkr_note_orig_0099023", "type": "orig", "text": "非＝不【乙】"}
{"id": null, "n": "0099024", "target": "#nkr_note_orig_0099024", "type": "orig", "text": "夫＝妻【乙】"}
{"id": null, "n": "0099025", "target": "#nkr_note_orig_0099025", "type": "orig", "text": "〔俱〕－【乙】"}
{"id": null, "n": "0099026", "target": "#nkr_note_orig_0099026", "type": "orig", "text": "〔人矣〕－【乙】"}
{"id": null, "n": "0099027", "target": "#nkr_note_orig_0099027", "type": "orig", "text": "真言＝呪【乙】"}
{"id": null, "n": "0099028", "target": "#nkr_note_orig_0099028", "type": "orig", "text": "〔則作…就〕八字－【乙】"}
{"id": null, "n": "0099029", "target": "#nkr_note_orig_0099029", "type": "orig", "text": "修行＝作ィ【原】"}
{"id": null, "n": "0099030", "target": "#nkr_note_orig_0099030", "type": "orig", "text": "雜＝種【乙】"}
{"id": null, "n": "0099031", "target": "#nkr_note_orig_0099031", "type": "orig", "text": "怒＋（王）【乙】"}
{"id": null, "n": "0099032", "target": "#nkr_note_orig_0099032", "type": "orig", "text": "莫起惡＝勿不善ィ【原】，勿起惡【乙】"}
{"id": null, "n": "0099033", "target": "#nkr_note_orig_0099033", "type": "orig", "text": "（自損）＋損【乙】"}
{"id": null, "n": "0099034", "target": "#nkr_note_orig_0099034", "type": "orig", "text": "耎＝柔【乙】"}
{"id": null, "n": "0099035", "target": "#nkr_note_orig_0099035", "type": "orig", "text": "人＝者【乙】"}
{"id": null, "n": "0099036", "target": "#nkr_note_orig_0099036", "type": "orig", "text": "而得自順順他＝未年滿足者得自損損他【乙】"}
{"id": null, "n": "0099037", "target": "#nkr_note_orig_0099037", "type": "orig", "text": "隨＝墮落【乙】"}
{"id": null, "n": "0099038", "target": "#nkr_note_orig_0099038", "type": "orig", "text": "過＝咎ィ【原】"}
{"id": null, "n": "0099039", "target": "#nkr_note_orig_0099039", "type": "orig", "text": "悲＝愍【三】"}
{"id": null, "n": "0099040", "target": "#nkr_note_orig_0099040", "type": "orig", "text": "〔而〕－【乙】"}
{"id": null, "n": "0099041", "target": "#nkr_note_orig_0099041", "type": "orig", "text": "（必）＋住【乙】"}
{"id": null, "n": "0099042", "target": "#nkr_note_orig_0099042", "type": "orig", "text": "叉＋（瞋怒息災大威神驗）【甲】"}
{"id": null, "n": "0099043", "target": "#nkr_note_orig_0099043", "type": "orig", "text": "此下甲本奧書曰寬治四年三月二十一日於仁和寺喜多院酉時許書寫畢，嘉保二年四月十七日於高野奧院東菴室大僧都奉受了"}
