{"id": null, "n": "0869033", "target": "#nkr_note_mod_0869033", "type": "mod", "text": "塞【大】，賽【元】【明】"}
{"id": null, "n": "0869034", "target": "#nkr_note_mod_0869034", "type": "mod", "text": "由【大】，猶【元】【明】"}
{"id": null, "n": "0869035", "target": "#nkr_note_mod_0869035", "type": "mod", "text": "所【大】，〔－〕【宋】"}
