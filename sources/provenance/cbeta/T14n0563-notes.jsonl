{"id": null, "n": null, "target": null, "type": "cf3", "text": "T14n0562_p0913c17"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "K11n0232_p0453b11"}
{"id": null, "n": "0914004", "target": "#nkr_note_mod_0914004", "type": "mod", "text": "佛說【大】＊，〔－〕【宋】【元】【宮】＊"}
{"id": null, "n": "0914005", "target": "#nkr_note_mod_0914005", "type": "mod", "text": "北【大】，〔－〕【宋】"}
{"id": null, "n": "0914006", "target": "#nkr_note_mod_0914006", "type": "mod", "text": "藏【大】，藏法師【宋】【元】【明】【宮】"}
{"id": null, "n": "0914007", "target": "#nkr_note_mod_0914007", "type": "mod", "text": "讖【大】，讖第三【元】【明】"}
{"id": null, "n": "0914008", "target": "#nkr_note_mod_0914008", "type": "mod", "text": "爾【大】，耳【宋】【元】【明】，〔－〕【宮】"}
{"id": null, "n": "0914009", "target": "#nkr_note_mod_0914009", "type": "mod", "text": "裝挍【大】＊，莊校【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0914010", "target": "#nkr_note_mod_0914010", "type": "mod", "text": "薩【大】，薩身【宋】【元】【明】【宮】"}
{"id": null, "n": "0914011", "target": "#nkr_note_mod_0914011", "type": "mod", "text": "南【大】，有【宋】"}
{"id": null, "n": "0914012", "target": "#nkr_note_mod_0914012", "type": "mod", "text": "之【大】，衣【宋】【元】【明】【宮】"}
{"id": null, "n": "0914013", "target": "#nkr_note_mod_0914013", "type": "mod", "text": "梟【大】，鷠【宮】"}
{"id": null, "n": "0914014", "target": "#nkr_note_mod_0914014", "type": "mod", "text": "晝【大】，盡【宮】"}
{"id": null, "n": "0915001", "target": "#nkr_note_mod_0915001", "type": "mod", "text": "雨【大】，而【宋】【元】【明】【宮】"}
{"id": null, "n": "0915002", "target": "#nkr_note_mod_0915002", "type": "mod", "text": "已【大】，以【宋】【元】【明】【宮】"}
{"id": null, "n": "0914004", "target": "#nkr_note_orig_0914004", "type": "orig", "text": "〔佛說〕－【宋】【元】【宮】＊"}
{"id": null, "n": "0914005", "target": "#nkr_note_orig_0914005", "type": "orig", "text": "〔北〕－【宋】"}
{"id": null, "n": "0914006", "target": "#nkr_note_orig_0914006", "type": "orig", "text": "藏＋（法師）【三】【宮】"}
{"id": null, "n": "0914007", "target": "#nkr_note_orig_0914007", "type": "orig", "text": "讖＋（第三）【元】【明】"}
{"id": null, "n": "0914008", "target": "#nkr_note_orig_0914008", "type": "orig", "text": "爾＝耳【三】，〔爾〕－【宮】"}
{"id": null, "n": "0914009", "target": "#nkr_note_orig_0914009", "type": "orig", "text": "裝挍＝莊校【三】【宮】＊"}
{"id": null, "n": "0914010", "target": "#nkr_note_orig_0914010", "type": "orig", "text": "薩＋（身）【三】【宮】"}
{"id": null, "n": "0914011", "target": "#nkr_note_orig_0914011", "type": "orig", "text": "南＝有【宋】"}
{"id": null, "n": "0914012", "target": "#nkr_note_orig_0914012", "type": "orig", "text": "之＝衣【三】【宮】"}
{"id": null, "n": "0914013", "target": "#nkr_note_orig_0914013", "type": "orig", "text": "梟＝鷠【宮】"}
{"id": null, "n": "0914014", "target": "#nkr_note_orig_0914014", "type": "orig", "text": "晝＝盡【宮】"}
{"id": null, "n": "0915001", "target": "#nkr_note_orig_0915001", "type": "orig", "text": "雨＝而【三】【宮】"}
{"id": null, "n": "0915002", "target": "#nkr_note_orig_0915002", "type": "orig", "text": "已＝以【三】【宮】"}
{"id": null, "n": "0914b2101", "target": "#nkr_note_add_0914b2101", "type": "add", "text": "以何【CB】【麗-CB】，何以【大】"}
{"id": null, "n": "0914c1001", "target": "#nkr_note_add_0914c1001", "type": "add", "text": "肅【CB】【麗-CB】，蕭【大】"}
