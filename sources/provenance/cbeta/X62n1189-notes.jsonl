{"id": null, "n": null, "target": null, "type": null, "text": "四十八願九品觀章"}
{"id": null, "n": null, "target": null, "type": null, "text": "附"}
{"id": null, "n": null, "target": null, "type": null, "text": "至"}
{"id": null, "n": null, "target": null, "type": null, "text": "贊曰：說理圓頓之極。"}
{"id": null, "n": null, "target": null, "type": null, "text": "至"}
{"id": null, "n": null, "target": null, "type": null, "text": "贊曰：說事剴切之至。"}
{"id": null, "n": null, "target": null, "type": null, "text": "至"}
{"id": null, "n": null, "target": null, "type": null, "text": "贊曰：說信願堅固云云。"}
{"id": null, "n": null, "target": null, "type": null, "text": "至"}
{"id": null, "n": null, "target": null, "type": null, "text": "贊曰：說因果同時云云。"}
{"id": null, "n": null, "target": null, "type": null, "text": "至"}
{"id": null, "n": null, "target": null, "type": null, "text": "贊曰：旦淨染判悟迷云云。"}
{"id": null, "n": null, "target": null, "type": null, "text": "至"}
{"id": null, "n": null, "target": null, "type": null, "text": "贊曰：禪淨分難易云云。"}
{"id": null, "n": null, "target": null, "type": null, "text": "附"}
{"id": null, "n": null, "target": null, "type": null, "text": "附"}
{"id": null, "n": null, "target": null, "type": null, "text": "因每每出聲念佛，胸頭微痛"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
