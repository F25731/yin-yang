{"id": null, "n": "0325005", "target": "#nkr_note_mod_0325005", "type": "mod", "text": "□【大】，起【考偽-大】"}
{"id": null, "n": "0326001", "target": "#nkr_note_mod_0326001", "type": "mod", "text": "五【大】，說五【考偽-大】"}
{"id": null, "n": "0327001", "target": "#nkr_note_mod_0327001", "type": "mod", "text": "上【大】，上故【考偽-大】"}
{"id": null, "n": "0327002", "target": "#nkr_note_mod_0327002", "type": "mod", "text": "󰢷【大】，緣【考偽-大】"}
{"id": null, "n": "0328001", "target": "#nkr_note_mod_0328001", "type": "mod", "text": "日【大】，々【考偽-大】"}
{"id": null, "n": "0325004", "target": "#nkr_note_orig_0325004", "type": "orig", "text": "佛蘭西巴里國民圖書館藏燉煌本 P. No. 3196"}
{"id": null, "n": "0325005", "target": "#nkr_note_orig_0325005", "type": "orig", "text": "□＝起？"}
{"id": null, "n": "0326001", "target": "#nkr_note_orig_0326001", "type": "orig", "text": "（說）＋五？"}
{"id": null, "n": "0327001", "target": "#nkr_note_orig_0327001", "type": "orig", "text": "上＋（故）？"}
{"id": null, "n": "0327002", "target": "#nkr_note_orig_0327002", "type": "orig", "text": "󰢷＝緣？"}
{"id": null, "n": "0328001", "target": "#nkr_note_orig_0328001", "type": "orig", "text": "日＝々？"}
