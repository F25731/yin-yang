{"id": null, "n": null, "target": null, "type": null, "text": "惣二萬八千偈"}
{"id": null, "n": null, "target": null, "type": null, "text": "唐言安惠"}
{"id": null, "n": null, "target": null, "type": null, "text": "此是眼耳鼻舌身意也說諸心"}
{"id": null, "n": null, "target": null, "type": null, "text": "說六識"}
