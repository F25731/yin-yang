{"id": null, "n": null, "target": null, "type": null, "text": "此是草本俟後重廣如有漏略觀者恕之"}
{"id": null, "n": null, "target": null, "type": null, "text": "世稱光緣"}
{"id": null, "n": null, "target": null, "type": null, "text": "或四卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "慧遠述辯相續修"}
{"id": null, "n": null, "target": null, "type": null, "text": "或十三卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "法詵創造正覺再修"}
{"id": null, "n": null, "target": null, "type": null, "text": "本十九卷今開第二"}
{"id": null, "n": null, "target": null, "type": null, "text": "或開為四十卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或開為六十卷徑山寫本八十卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "本是八卷今開第五卷并宗要均作十卷也"}
{"id": null, "n": null, "target": null, "type": null, "text": "或五卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "賢昱略清涼大疏注於經下"}
{"id": null, "n": null, "target": null, "type": null, "text": "淨源移清涼大疏注於經下"}
{"id": null, "n": null, "target": null, "type": null, "text": "志寧將通玄論注於經下"}
{"id": null, "n": null, "target": null, "type": null, "text": "前分四十卷流通訖餘未見"}
{"id": null, "n": null, "target": null, "type": null, "text": "旋澓頌附"}
{"id": null, "n": null, "target": null, "type": null, "text": "俗姓杜氏世稱杜順"}
{"id": null, "n": null, "target": null, "type": null, "text": "或一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "食肉有罪無罪附"}
{"id": null, "n": null, "target": null, "type": null, "text": "世云五十要問答是"}
{"id": null, "n": null, "target": null, "type": null, "text": "又有一本題云十玄無礙義者疑後人所述"}
{"id": null, "n": null, "target": null, "type": null, "text": "三性章附"}
{"id": null, "n": null, "target": null, "type": null, "text": "三寶章流轉章法界緣起章圓音章法身章十世章玄義章"}
{"id": null, "n": null, "target": null, "type": null, "text": "或二卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "問明淨行賢首是也"}
{"id": null, "n": null, "target": null, "type": null, "text": "仲希移本疏注於經下"}
{"id": null, "n": null, "target": null, "type": null, "text": "宗密述仲希治定"}
{"id": null, "n": null, "target": null, "type": null, "text": "僧傳云錐穴問答是"}
{"id": null, "n": null, "target": null, "type": null, "text": "僧傳云道身章是"}
{"id": null, "n": null, "target": null, "type": null, "text": "或六卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或三卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "與行狀亦有不同待勘"}
{"id": null, "n": null, "target": null, "type": null, "text": "或二卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "但云潤述不見上字"}
{"id": null, "n": null, "target": null, "type": null, "text": "灌頂述湛然再治"}
{"id": null, "n": null, "target": null, "type": null, "text": "或七卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或四卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "本文題下不見人名目錄云僧叡述待勘"}
{"id": null, "n": null, "target": null, "type": null, "text": "或十卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或八卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "但云開公述不見上字"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦他人述"}
{"id": null, "n": null, "target": null, "type": null, "text": "有云菩提留支講釋亡名記待勘"}
{"id": null, "n": null, "target": null, "type": null, "text": "有云唐三藏述或云陟法師解應是安國寺利陟所述待勘"}
{"id": null, "n": null, "target": null, "type": null, "text": "全寫經文隨科贊釋與六卷本大同"}
{"id": null, "n": null, "target": null, "type": null, "text": "標舉科節者略經文或三卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或云搜微"}
{"id": null, "n": null, "target": null, "type": null, "text": "或三卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或十三卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或二卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或六卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "科附"}
{"id": null, "n": null, "target": null, "type": null, "text": "或六卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或作道由述待勘"}
{"id": null, "n": null, "target": null, "type": null, "text": "近從日本國流通云是天台所說待勘"}
{"id": null, "n": null, "target": null, "type": null, "text": "或一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "宗密述子󱈜治定"}
{"id": null, "n": null, "target": null, "type": null, "text": "子󱈜述道觀重脩"}
{"id": null, "n": null, "target": null, "type": null, "text": "或作玄待勘"}
{"id": null, "n": null, "target": null, "type": null, "text": "公哲述志蘊刪補"}
{"id": null, "n": null, "target": null, "type": null, "text": "僧肇等四注"}
{"id": null, "n": null, "target": null, "type": null, "text": "解唐三藏新譯"}
{"id": null, "n": null, "target": null, "type": null, "text": "岳師云後人偽撰待勘"}
{"id": null, "n": null, "target": null, "type": null, "text": "疑是後人偽撰待勘"}
{"id": null, "n": null, "target": null, "type": null, "text": "或一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "淨澄述澄或作隆令安刪定"}
{"id": null, "n": null, "target": null, "type": null, "text": "或三卷僧傳云造疏五卷後有翻經三藏改之為論云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "大經第十會"}
{"id": null, "n": null, "target": null, "type": null, "text": "大經第三十會"}
{"id": null, "n": null, "target": null, "type": null, "text": "或二卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "淨土總料簡附"}
{"id": null, "n": null, "target": null, "type": null, "text": "但云震述不見上字"}
{"id": null, "n": null, "target": null, "type": null, "text": "雖釋三經總為一部"}
{"id": null, "n": null, "target": null, "type": null, "text": "淨源移本疏注於經下"}
{"id": null, "n": null, "target": null, "type": null, "text": "釋門正統第三　統紀第十四　通載第十九　稽古略第四"}
{"id": null, "n": null, "target": null, "type": null, "text": "十重戒序附"}
{"id": null, "n": null, "target": null, "type": null, "text": "下云略說者題目不同耳"}
{"id": null, "n": null, "target": null, "type": null, "text": "傳奧述仲希錄疏注於經文之下"}
{"id": null, "n": null, "target": null, "type": null, "text": "遇榮集應及刪補"}
{"id": null, "n": null, "target": null, "type": null, "text": "慧雲述或云浮雲居土述待勘"}
{"id": null, "n": null, "target": null, "type": null, "text": "但云嶽法師述不見上字"}
{"id": null, "n": null, "target": null, "type": null, "text": "或二卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或三卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "資持記主以為南山所撰近勘此方古本云憬興述興是唐初海東之人\n廣有著述"}
{"id": null, "n": null, "target": null, "type": null, "text": "入大藏"}
{"id": null, "n": null, "target": null, "type": null, "text": "或四卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或一卷或二卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或四卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "僧璩或云僧述待勘"}
{"id": null, "n": null, "target": null, "type": null, "text": "題下云隨青山集義記釋海東疏採大原章教江州福願曹溪等文\n記"}
{"id": null, "n": null, "target": null, "type": null, "text": "題下云起信論依海東疏科文"}
{"id": null, "n": null, "target": null, "type": null, "text": "或三卷或二卷宗密將藏疏注於論文之下"}
{"id": null, "n": null, "target": null, "type": null, "text": "慧遍述或云曠師述待勘"}
{"id": null, "n": null, "target": null, "type": null, "text": "或四卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "與曉公宗要不同"}
{"id": null, "n": null, "target": null, "type": null, "text": "或十卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或六卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或十四卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "從式集澹凝刪補"}
{"id": null, "n": null, "target": null, "type": null, "text": "或五卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或十卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或二卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或三卷或二卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "景猷述慧涉刪補"}
{"id": null, "n": null, "target": null, "type": null, "text": "或七卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或有九卷之本與此亦有不同"}
{"id": null, "n": null, "target": null, "type": null, "text": "但云上國沙門達述不見上字或云達瑜伽是"}
{"id": null, "n": null, "target": null, "type": null, "text": "或一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或八卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "法常述或云道證述待勘"}
{"id": null, "n": null, "target": null, "type": null, "text": "中百門是"}
{"id": null, "n": null, "target": null, "type": null, "text": "但云衍法師述不見上字應是曇衍待勘"}
{"id": null, "n": null, "target": null, "type": null, "text": "或五卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或十卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或十卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "乾廣述或云崇廣待勘"}
{"id": null, "n": null, "target": null, "type": null, "text": "亡名或云行滿述待勘"}
{"id": null, "n": null, "target": null, "type": null, "text": "亡名或云立許述待勘"}
{"id": null, "n": null, "target": null, "type": null, "text": "亡名或云叡法師注待勘"}
{"id": null, "n": null, "target": null, "type": null, "text": "或十四卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或七卷或十卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或五卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "或十一卷或三十卷開合而已"}
{"id": null, "n": null, "target": null, "type": null, "text": "或有十二卷本開合而已"}
{"id": null, "n": null, "target": null, "type": null, "text": "或一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "融會章附"}
{"id": null, "n": null, "target": null, "type": null, "text": "或一卷"}
{"id": null, "n": null, "target": null, "type": null, "text": "舊名詮明"}
{"id": null, "n": "1165015", "target": "#nkr_note_mod_1165015", "type": "mod", "text": "精【大】，擇【甲】"}
{"id": null, "n": "1166001", "target": "#nkr_note_mod_1166001", "type": "mod", "text": "十【大】，十八【甲】"}
{"id": null, "n": "1166002", "target": "#nkr_note_mod_1166002", "type": "mod", "text": "訖【大】，說【甲】"}
{"id": null, "n": "1167001", "target": "#nkr_note_mod_1167001", "type": "mod", "text": "定【大】，宗【甲】"}
{"id": null, "n": "1168001", "target": "#nkr_note_mod_1168001", "type": "mod", "text": "卷【大】，卷或四十卷【甲】"}
{"id": null, "n": "1168002", "target": "#nkr_note_mod_1168002", "type": "mod", "text": "（隨疏…述）十字【大】∞（後分…述）九字【甲】"}
{"id": null, "n": "1168003", "target": "#nkr_note_mod_1168003", "type": "mod", "text": "（後分…述）九字【大】∞（隨疏…述）十字【甲】"}
{"id": null, "n": "1168004", "target": "#nkr_note_mod_1168004", "type": "mod", "text": "密【大】，密鈔【甲】"}
{"id": null, "n": "1169001", "target": "#nkr_note_mod_1169001", "type": "mod", "text": "熏聞【大】，聞熏【甲】"}
{"id": null, "n": "1170001", "target": "#nkr_note_mod_1170001", "type": "mod", "text": "垂【大】，乘【甲】"}
{"id": null, "n": "1171001", "target": "#nkr_note_mod_1171001", "type": "mod", "text": "卷【大】，卷科一卷【甲】"}
{"id": null, "n": "1171002", "target": "#nkr_note_mod_1171002", "type": "mod", "text": "昭【大】，照【甲】"}
{"id": null, "n": "1171003", "target": "#nkr_note_mod_1171003", "type": "mod", "text": "述【大】，注【甲】"}
{"id": null, "n": "1172001", "target": "#nkr_note_mod_1172001", "type": "mod", "text": "逐【大】，遂【甲】"}
{"id": null, "n": "1172002", "target": "#nkr_note_mod_1172002", "type": "mod", "text": "遁【大】，道【校異-甲】"}
{"id": null, "n": "1172003", "target": "#nkr_note_mod_1172003", "type": "mod", "text": "日【大】，田【校異-甲】"}
{"id": null, "n": "1174001", "target": "#nkr_note_mod_1174001", "type": "mod", "text": "擇【大】，釋【甲】"}
{"id": null, "n": "1175001", "target": "#nkr_note_mod_1175001", "type": "mod", "text": "遁【大】＊，道【甲】＊"}
{"id": null, "n": "1176001", "target": "#nkr_note_mod_1176001", "type": "mod", "text": "述【大】，述惠沼續【甲】"}
{"id": null, "n": "1176002", "target": "#nkr_note_mod_1176002", "type": "mod", "text": "惠沼續【大】，〔－〕【甲】"}
{"id": null, "n": "1177001", "target": "#nkr_note_mod_1177001", "type": "mod", "text": "藏【大】，雜【甲】"}
{"id": null, "n": "1177002", "target": "#nkr_note_mod_1177002", "type": "mod", "text": "科【大】，利【甲】"}
{"id": null, "n": "1178001", "target": "#nkr_note_mod_1178001", "type": "mod", "text": "該【大】，說【甲】"}
{"id": null, "n": "1178002", "target": "#nkr_note_mod_1178002", "type": "mod", "text": "景雅【大】，〔－〕【甲】"}
{"id": null, "n": "1178003", "target": "#nkr_note_mod_1178003", "type": "mod", "text": "寫了【大】，之【甲】"}
{"id": null, "n": "1178004", "target": "#nkr_note_mod_1178004", "type": "mod", "text": "此次行甲本有以他本校合了六字並花押（CBETA 按：大正藏校勘欄有「04 此次行甲本有以他本校合了六字並花押」之校勘條目，但此頁內文中缺相對應之校勘符號[04]，故將此校勘條目置於本頁內文最後。）"}
{"id": null, "n": "1165014", "target": "#nkr_note_orig_1165014", "type": "orig", "text": "【原】元錄六年刊大谷大學藏本，【甲】高山寺藏安元二年寫本，此序甲本無"}
{"id": null, "n": "1165015", "target": "#nkr_note_orig_1165015", "type": "orig", "text": "精＝擇【甲】"}
{"id": null, "n": "1166001", "target": "#nkr_note_orig_1166001", "type": "orig", "text": "十＋（八）【甲】"}
{"id": null, "n": "1166002", "target": "#nkr_note_orig_1166002", "type": "orig", "text": "訖＝說【甲】"}
{"id": null, "n": "1167001", "target": "#nkr_note_orig_1167001", "type": "orig", "text": "定＝宗【甲】"}
{"id": null, "n": "1168001", "target": "#nkr_note_orig_1168001", "type": "orig", "text": "卷＋（或四十卷）【甲】"}
{"id": null, "n": "1168002", "target": "#nkr_note_orig_1168002", "type": "orig", "text": "（隋疏…述）十字∞（後分…述）九字【甲】"}
{"id": null, "n": "1168003", "target": "#nkr_note_orig_1168003", "type": "orig", "text": "（隋疏…述）十字∞（後分…述）九字【甲】"}
{"id": null, "n": "1168004", "target": "#nkr_note_orig_1168004", "type": "orig", "text": "密＋（鈔）【甲】"}
{"id": null, "n": "1169001", "target": "#nkr_note_orig_1169001", "type": "orig", "text": "熏聞＝聞熏【甲】"}
{"id": null, "n": "1170001", "target": "#nkr_note_orig_1170001", "type": "orig", "text": "垂＝乘【甲】"}
{"id": null, "n": "1171001", "target": "#nkr_note_orig_1171001", "type": "orig", "text": "卷＋（科一卷）【甲】"}
{"id": null, "n": "1171002", "target": "#nkr_note_orig_1171002", "type": "orig", "text": "昭＝照【甲】"}
{"id": null, "n": "1171003", "target": "#nkr_note_orig_1171003", "type": "orig", "text": "述＝注【甲】"}
{"id": null, "n": "1172001", "target": "#nkr_note_orig_1172001", "type": "orig", "text": "逐＝遂【甲】"}
{"id": null, "n": "1172002", "target": "#nkr_note_orig_1172002", "type": "orig", "text": "遁＝道ィ【甲】"}
{"id": null, "n": "1172003", "target": "#nkr_note_orig_1172003", "type": "orig", "text": "日＝田ィ【甲】"}
{"id": null, "n": "1173001", "target": "#nkr_note_orig_1173001", "type": "orig", "text": "甲本奧書云安元二年丙申五月晦日以仁和寺花嚴院法橋景雅御本書寫了明空"}
{"id": null, "n": "1173002", "target": "#nkr_note_orig_1173002", "type": "orig", "text": "此傳甲本無之"}
