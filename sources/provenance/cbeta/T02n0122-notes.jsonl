{"id": null, "n": "0545001", "target": "#nkr_note_mod_0545001", "type": "mod", "text": "佛說【大】，〔－〕【宋】【元】"}
{"id": null, "n": "0545002", "target": "#nkr_note_mod_0545002", "type": "mod", "text": "沙門【大】，三藏法師【宋】【元】【明】"}
{"id": null, "n": "0545003", "target": "#nkr_note_mod_0545003", "type": "mod", "text": "娑【大】＊，婆【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0545004", "target": "#nkr_note_mod_0545004", "type": "mod", "text": "地【大】＊，土地【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0545005", "target": "#nkr_note_mod_0545005", "type": "mod", "text": "死【大】，是【元】【明】"}
{"id": null, "n": "0545006", "target": "#nkr_note_mod_0545006", "type": "mod", "text": "果【大】，業【宋】【元】【明】"}
{"id": null, "n": "0545007", "target": "#nkr_note_mod_0545007", "type": "mod", "text": "力【大】，〔－〕【明】"}
{"id": null, "n": "0545008", "target": "#nkr_note_mod_0545008", "type": "mod", "text": "身【大】，身心【宋】【元】【明】"}
{"id": null, "n": "0546001", "target": "#nkr_note_mod_0546001", "type": "mod", "text": "坐【大】，座【宋】【元】【明】"}
{"id": null, "n": "0545001", "target": "#nkr_note_orig_0545001", "type": "orig", "text": "〔佛說〕－【宋】【元】"}
{"id": null, "n": "0545002", "target": "#nkr_note_orig_0545002", "type": "orig", "text": "沙門＝三藏法師【三】"}
{"id": null, "n": "0545003", "target": "#nkr_note_orig_0545003", "type": "orig", "text": "娑＝婆【三】＊"}
{"id": null, "n": "0545004", "target": "#nkr_note_orig_0545004", "type": "orig", "text": "（土）＋地【三】＊"}
{"id": null, "n": "0545005", "target": "#nkr_note_orig_0545005", "type": "orig", "text": "死＝是【元】【明】"}
{"id": null, "n": "0545006", "target": "#nkr_note_orig_0545006", "type": "orig", "text": "果＝業【三】"}
{"id": null, "n": "0545007", "target": "#nkr_note_orig_0545007", "type": "orig", "text": "〔力〕－【明】"}
{"id": null, "n": "0545008", "target": "#nkr_note_orig_0545008", "type": "orig", "text": "身＋（心）【三】"}
{"id": null, "n": "0546001", "target": "#nkr_note_orig_0546001", "type": "orig", "text": "坐＝座【三】"}
