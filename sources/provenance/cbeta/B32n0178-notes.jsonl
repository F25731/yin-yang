{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】前恐衍"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】續疑違歟"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】三下恐脫生字"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】中下恐脫大字"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】甚恐勘"}
{"id": null, "n": null, "target": null, "type": null, "text": "清辨菩薩釋"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】得下恐脫對字"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】成慶案。此以下可一箇緣。然者上清辯建立唯境與無第八識文束之可為第二條歟。"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】中因二字恐因中"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】此傳文作世"}
{"id": null, "n": null, "target": null, "type": null, "text": "言。什前止北涼。而韜智未曜也"}
{"id": null, "n": null, "target": null, "type": null, "text": "當遜興初永安元年。"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】今案此者付第〔【考】第下恐脫一字〕未決章疏故故十條耳"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "【考】世下恐脫實有二字"}
{"id": null, "n": null, "target": null, "type": null, "text": "并"}
