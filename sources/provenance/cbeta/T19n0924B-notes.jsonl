{"id": null, "n": "0030028", "target": null, "type": "orig", "text": "〔念誦〕－【乙】"}
{"id": null, "n": "0030028", "target": null, "type": "mod", "text": "念誦【大】，〔－〕【乙】"}
{"id": null, "n": "0030002", "target": "#nkr_note_mod_0030002", "type": "mod", "text": "音樂【大】，樂音【甲】"}
{"id": null, "n": "0030003", "target": "#nkr_note_mod_0030003", "type": "mod", "text": "三【大】，大菩薩三【校異-原】"}
{"id": null, "n": "0030004", "target": "#nkr_note_mod_0030004", "type": "mod", "text": "丘【大】，丘八萬【校異-原】"}
{"id": null, "n": "0030005", "target": "#nkr_note_mod_0030005", "type": "mod", "text": "即名【大】，名即【甲】【乙】"}
{"id": null, "n": "0030006", "target": "#nkr_note_mod_0030006", "type": "mod", "text": "社【大】，耶【乙】"}
{"id": null, "n": "0030007", "target": "#nkr_note_mod_0030007", "type": "mod", "text": "喝【大】，羯【甲】【乙】"}
{"id": null, "n": "0030008", "target": "#nkr_note_mod_0030008", "type": "mod", "text": "多【大】，多耶阿羅歇帝三藐三勃陀耶【乙】"}
{"id": null, "n": "0030009", "target": "#nkr_note_mod_0030009", "type": "mod", "text": "逝【大】，逝鞞殺逝【乙】"}
{"id": null, "n": "0030010", "target": "#nkr_note_mod_0030010", "type": "mod", "text": "三沒【大】，沒哩【乙】"}
{"id": null, "n": "0030011", "target": "#nkr_note_mod_0030011", "type": "mod", "text": "婆【大】，沙【甲】【乙】"}
{"id": null, "n": "0030012", "target": "#nkr_note_mod_0030012", "type": "mod", "text": "塗【大】，途【甲】【乙】"}
{"id": null, "n": "0030013", "target": "#nkr_note_mod_0030013", "type": "mod", "text": "苦【大】，苦七佛經并陀羅尼集經有此三字【乙】"}
{"id": null, "n": "0030014", "target": "#nkr_note_mod_0030014", "type": "mod", "text": "手【大】，〔－〕【乙】"}
{"id": null, "n": "0030015", "target": "#nkr_note_mod_0030015", "type": "mod", "text": "叉【大】，〔－〕【甲】"}
{"id": null, "n": "0030016", "target": "#nkr_note_mod_0030016", "type": "mod", "text": "哩【大】，哩二合【乙】"}
{"id": null, "n": null, "target": null, "type": null, "text": "二合"}
{"id": null, "n": "0030017", "target": "#nkr_note_mod_0030017", "type": "mod", "text": "娑【大】，沙【甲】"}
{"id": null, "n": "0030018", "target": "#nkr_note_mod_0030018", "type": "mod", "text": "次【大】，〔－〕【甲】"}
{"id": null, "n": "0030019", "target": "#nkr_note_mod_0030019", "type": "mod", "text": "護【大】，〔－〕【乙】"}
{"id": null, "n": "0030020", "target": "#nkr_note_mod_0030020", "type": "mod", "text": "薩【大】，曩莫薩【甲】"}
{"id": null, "n": "0030021", "target": "#nkr_note_mod_0030021", "type": "mod", "text": "曩【大】，奈【乙】"}
{"id": null, "n": "0030022", "target": "#nkr_note_mod_0030022", "type": "mod", "text": "引【大】，〔－〕【甲】"}
{"id": null, "n": "0030023", "target": "#nkr_note_mod_0030023", "type": "mod", "text": "存【大】，在【甲】【乙】"}
{"id": null, "n": "0030024", "target": "#nkr_note_mod_0030024", "type": "mod", "text": "怛【大】，入縛羅怛【甲】【乙】"}
{"id": null, "n": "0030025", "target": "#nkr_note_mod_0030025", "type": "mod", "text": "多麼訶捺【大】，哆訶摩捨【乙】"}
{"id": null, "n": "0030026", "target": "#nkr_note_mod_0030026", "type": "mod", "text": "成【大】，辯才成【甲】【乙】"}
{"id": null, "n": "0030027", "target": "#nkr_note_mod_0030027", "type": "mod", "text": "如來念誦【大】，〔－〕【甲】"}
{"id": null, "n": "0030028", "target": "#nkr_note_mod_0030028", "type": "mod", "text": "念誦【大】，〔－〕【乙】"}
{"id": null, "n": "0030029", "target": "#nkr_note_mod_0030029", "type": "mod", "text": "一卷【大】，〔－〕【甲】"}
{"id": null, "n": "0030001", "target": "#nkr_note_orig_0030001", "type": "orig", "text": "【原】享保年間刊豐山大學藏本，【甲】保延三年寫高山寺藏本，【乙】高山寺藏古寫本"}
