{"id": null, "n": null, "target": null, "type": null, "text": "菩提場第一會，說六品經，至第五卷　世主妙嚴品第一"}
{"id": null, "n": null, "target": null, "type": null, "text": "如來現相品第二"}
{"id": null, "n": null, "target": null, "type": null, "text": "普賢三昧品第三、世界成就品第四"}
{"id": null, "n": null, "target": null, "type": null, "text": "世界成就品、華藏世界品第五"}
{"id": null, "n": null, "target": null, "type": null, "text": "至第十一卷　毘盧舍那品第六"}
{"id": null, "n": null, "target": null, "type": null, "text": "普光明殿第二會，說六品經　佛名號品第七、四聖諦品第八"}
{"id": null, "n": null, "target": null, "type": null, "text": "光明覺品第九、菩薩問明品第十"}
{"id": null, "n": null, "target": null, "type": null, "text": "淨行品第十一、賢首品第十二"}
{"id": null, "n": null, "target": null, "type": null, "text": "賢首品"}
{"id": null, "n": null, "target": null, "type": null, "text": "忉利天宮第三會，說六品經　昇須彌頂品第十三、偈讚品第十四、十住品第十五"}
{"id": null, "n": null, "target": null, "type": null, "text": "梵行品第十六、初發心功德品第十七"}
{"id": null, "n": null, "target": null, "type": null, "text": "明法品第十八"}
{"id": null, "n": null, "target": null, "type": null, "text": "夜摩天宮第四會，說四品經　昇夜摩天宮品第十九、偈讚品第二十、十行品第二十一"}
{"id": null, "n": null, "target": null, "type": null, "text": "十行品"}
{"id": null, "n": null, "target": null, "type": null, "text": "十無盡藏品第二十二"}
{"id": null, "n": null, "target": null, "type": null, "text": "都率天宮第五會，說三品經　昇都率天宮品第二十三"}
{"id": null, "n": null, "target": null, "type": null, "text": "偈讚品第二十四"}
{"id": null, "n": null, "target": null, "type": null, "text": "至三十三卷　十迴向品第二十五"}
{"id": null, "n": null, "target": null, "type": null, "text": "他化天宮第六會，說一品經，至三十九卷　十地品第二十六"}
{"id": null, "n": null, "target": null, "type": null, "text": "三禪天，第七會闕文"}
{"id": null, "n": null, "target": null, "type": null, "text": "重會普光第八會，說十一品經，至四十三卷　十定品第二十七"}
{"id": null, "n": null, "target": null, "type": null, "text": "十通品第二十八、十忍品第二十九"}
{"id": null, "n": null, "target": null, "type": null, "text": "阿僧祇品第三十、壽量品第三十一、菩薩住處品第三十二"}
{"id": null, "n": null, "target": null, "type": null, "text": "至四十七卷　不思議法品第三十三"}
{"id": null, "n": null, "target": null, "type": null, "text": "如來十身相海品第三十四、隨好光明功德品第三十五"}
{"id": null, "n": null, "target": null, "type": null, "text": "普賢行品第三十六"}
{"id": null, "n": null, "target": null, "type": null, "text": "至五十二卷　如來出現品第三十七"}
{"id": null, "n": null, "target": null, "type": null, "text": "三重普光第九會，說一品經，至五十九卷　離世間品第三十八"}
{"id": null, "n": null, "target": null, "type": null, "text": "祇洹重閣第十會，說一品經，至八十卷　入法界品第三十九"}
{"id": null, "n": null, "target": null, "type": null, "text": "四十七"}
