{"id": null, "n": null, "target": null, "type": null, "text": "烏故切"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "此是標舉\n發願之文"}
{"id": null, "n": null, "target": null, "type": null, "text": "此是第二禮足請師，正是表宣\n\n所欲之文"}
{"id": null, "n": null, "target": null, "type": null, "text": "此是第三生殷淨心，供養只是\n為生淨心，故不別言，意合在此。專念長養，此是後段"}
{"id": null, "n": null, "target": null, "type": null, "text": "此是正授"}
{"id": null, "n": null, "target": null, "type": null, "text": "某甲某甲"}
{"id": null, "n": null, "target": null, "type": null, "text": "一也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "二也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "三也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "四也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "五也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "六也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "七也。"}
{"id": null, "n": null, "target": null, "type": null, "text": "八也。此後三句八法皆有。"}
{"id": null, "n": null, "target": null, "type": null, "text": "此稱三箇\n受戒人名，下准集玄有解，此中稱和尚名非也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此處方稱和尚之名"}
{"id": null, "n": null, "target": null, "type": null, "text": "云云"}
{"id": null, "n": null, "target": null, "type": null, "text": "一也，取恒犯義"}
{"id": null, "n": null, "target": null, "type": null, "text": "二也，取全犯四"}
{"id": null, "n": null, "target": null, "type": null, "text": "三也"}
{"id": null, "n": null, "target": null, "type": null, "text": "扇𢮎．半擇迦二"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "乙未"}
{"id": null, "n": null, "target": null, "type": null, "text": "胎生六十一歲"}
{"id": null, "n": null, "target": null, "type": null, "text": "戒五十七，年六十九"}
{"id": null, "n": "0216001", "target": "#nkr_note_orig_0216001", "type": "orig", "text": "更上一有時字"}
{"id": null, "n": "0216002", "target": "#nkr_note_orig_0216002", "type": "orig", "text": "不字疑剩"}
{"id": null, "n": "0216003", "target": "#nkr_note_orig_0216003", "type": "orig", "text": "餘一作除"}
{"id": null, "n": "0216004", "target": "#nkr_note_orig_0216004", "type": "orig", "text": "意一作應"}
{"id": null, "n": "0217001", "target": "#nkr_note_orig_0217001", "type": "orig", "text": "諸一作者"}
{"id": null, "n": "0217002", "target": "#nkr_note_orig_0217002", "type": "orig", "text": "雖一作可"}
{"id": null, "n": "0217003", "target": "#nkr_note_orig_0217003", "type": "orig", "text": "是字疑剩"}
{"id": null, "n": "0217004", "target": "#nkr_note_orig_0217004", "type": "orig", "text": "一無眾字"}
{"id": null, "n": "0217005", "target": "#nkr_note_orig_0217005", "type": "orig", "text": "出下一有家字"}
{"id": null, "n": "0217006", "target": "#nkr_note_orig_0217006", "type": "orig", "text": "中此作此中"}
{"id": null, "n": "0217007", "target": "#nkr_note_orig_0217007", "type": "orig", "text": "此一作品"}
{"id": null, "n": "0218001", "target": "#nkr_note_orig_0218001", "type": "orig", "text": "根一作相"}
{"id": null, "n": "0218002", "target": "#nkr_note_orig_0218002", "type": "orig", "text": "意一作字"}
{"id": null, "n": "0218003", "target": "#nkr_note_orig_0218003", "type": "orig", "text": "一無後字"}
{"id": null, "n": "0218004", "target": "#nkr_note_orig_0218004", "type": "orig", "text": "共疑其"}
{"id": null, "n": "0218005", "target": "#nkr_note_orig_0218005", "type": "orig", "text": "不一作所"}
{"id": null, "n": "0218006", "target": "#nkr_note_orig_0218006", "type": "orig", "text": "所作於"}
{"id": null, "n": "0218007", "target": "#nkr_note_orig_0218007", "type": "orig", "text": "此一作何"}
{"id": null, "n": "0219001", "target": "#nkr_note_orig_0219001", "type": "orig", "text": "此一作比"}
{"id": null, "n": "0219002", "target": "#nkr_note_orig_0219002", "type": "orig", "text": "當曰一作魚目"}
{"id": null, "n": "0219003", "target": "#nkr_note_orig_0219003", "type": "orig", "text": "無上一有等字"}
{"id": null, "n": "0220001", "target": "#nkr_note_orig_0220001", "type": "orig", "text": "等一作菩提下同"}
{"id": null, "n": "0220002", "target": "#nkr_note_orig_0220002", "type": "orig", "text": "身上一有其發二字"}
{"id": null, "n": "0220003", "target": "#nkr_note_orig_0220003", "type": "orig", "text": "于疑互"}
{"id": null, "n": "0221001", "target": "#nkr_note_orig_0221001", "type": "orig", "text": "一無受字"}
{"id": null, "n": "0221002", "target": "#nkr_note_orig_0221002", "type": "orig", "text": "眾下一有多字次同"}
{"id": null, "n": "0222001", "target": "#nkr_note_orig_0222001", "type": "orig", "text": "云下疑脫云字"}
{"id": null, "n": "0222002", "target": "#nkr_note_orig_0222002", "type": "orig", "text": "現疑親"}
{"id": null, "n": "0222003", "target": "#nkr_note_orig_0222003", "type": "orig", "text": "者一作言"}
{"id": null, "n": "0222004", "target": "#nkr_note_orig_0222004", "type": "orig", "text": "熏一作重"}
{"id": null, "n": "0222005", "target": "#nkr_note_orig_0222005", "type": "orig", "text": "者疑故"}
{"id": null, "n": "0223001", "target": "#nkr_note_orig_0223001", "type": "orig", "text": "別一作利"}
{"id": null, "n": "0223002", "target": "#nkr_note_orig_0223002", "type": "orig", "text": "一無此段"}
{"id": null, "n": "0223003", "target": "#nkr_note_orig_0223003", "type": "orig", "text": "名初攝受一作各攝初受"}
{"id": null, "n": "0223004", "target": "#nkr_note_orig_0223004", "type": "orig", "text": "十下一有支善二字"}
{"id": null, "n": "0223005", "target": "#nkr_note_orig_0223005", "type": "orig", "text": "攝一作引"}
{"id": null, "n": "0224001", "target": "#nkr_note_orig_0224001", "type": "orig", "text": "一無戒字"}
{"id": null, "n": "0225001", "target": "#nkr_note_orig_0225001", "type": "orig", "text": "違一作達"}
{"id": null, "n": "0225002", "target": "#nkr_note_orig_0225002", "type": "orig", "text": "時疑特"}
{"id": null, "n": "0225003", "target": "#nkr_note_orig_0225003", "type": "orig", "text": "卜一作也"}
{"id": null, "n": "0225004", "target": "#nkr_note_orig_0225004", "type": "orig", "text": "示一作亦"}
{"id": null, "n": "0225005", "target": "#nkr_note_orig_0225005", "type": "orig", "text": "罪疑果"}
{"id": null, "n": "0226001", "target": "#nkr_note_orig_0226001", "type": "orig", "text": "自下疑脫在字"}
{"id": null, "n": "0226002", "target": "#nkr_note_orig_0226002", "type": "orig", "text": "漏疑滿"}
{"id": null, "n": "0226003", "target": "#nkr_note_orig_0226003", "type": "orig", "text": "有一作亦"}
{"id": null, "n": "0227001", "target": "#nkr_note_orig_0227001", "type": "orig", "text": "願上一有本字"}
{"id": null, "n": "0227002", "target": "#nkr_note_orig_0227002", "type": "orig", "text": "丘下一有尼字"}
{"id": null, "n": "0227003", "target": "#nkr_note_orig_0227003", "type": "orig", "text": "受一作授"}
{"id": null, "n": "0227004", "target": "#nkr_note_orig_0227004", "type": "orig", "text": "諍一作淨"}
{"id": null, "n": "0227005", "target": "#nkr_note_orig_0227005", "type": "orig", "text": "不一作可"}
{"id": null, "n": "0228001", "target": "#nkr_note_orig_0228001 #note_star_1", "type": "orig", "text": "審一作番次同"}
{"id": null, "n": "0228002", "target": "#nkr_note_orig_0228002", "type": "orig", "text": "為一作將"}
{"id": null, "n": "0228003", "target": "#nkr_note_orig_0228003", "type": "orig", "text": "斧疑齊次同"}
{"id": null, "n": "0228004", "target": "#nkr_note_orig_0228004", "type": "orig", "text": "方一作立"}
{"id": null, "n": "0228005", "target": "#nkr_note_orig_0228005", "type": "orig", "text": "唯章作又"}
{"id": null, "n": "0229001", "target": "#nkr_note_orig_0229001", "type": "orig", "text": "前一作行"}
{"id": null, "n": "0229002", "target": "#nkr_note_orig_0229002", "type": "orig", "text": "修一作候"}
{"id": null, "n": "0229003", "target": "#nkr_note_orig_0229003", "type": "orig", "text": "同一作因"}
{"id": null, "n": "0230001", "target": "#nkr_note_orig_0230001", "type": "orig", "text": "人一作及"}
{"id": null, "n": "0230002", "target": "#nkr_note_orig_0230002", "type": "orig", "text": "善一作前"}
{"id": null, "n": "0230003", "target": "#nkr_note_orig_0230003 #note_star_2", "type": "orig", "text": "審一作番下同"}
{"id": null, "n": "0230004", "target": "#nkr_note_orig_0230004", "type": "orig", "text": "入一作人"}
{"id": null, "n": "0231001", "target": "#nkr_note_orig_0231001", "type": "orig", "text": "受下一有也字"}
{"id": null, "n": "0231002", "target": "#nkr_note_orig_0231002", "type": "orig", "text": "入一作人"}
{"id": null, "n": "0231003", "target": "#nkr_note_orig_0231003", "type": "orig", "text": "諺一作彰"}
{"id": null, "n": "0231004", "target": "#nkr_note_orig_0231004", "type": "orig", "text": "俱疑但"}
{"id": null, "n": "0231005", "target": "#nkr_note_orig_0231005", "type": "orig", "text": "舍一作捨"}
{"id": null, "n": "0231006", "target": "#nkr_note_orig_0231006", "type": "orig", "text": "以一作次"}
{"id": null, "n": "0231007", "target": "#nkr_note_orig_0231007", "type": "orig", "text": "相一作根"}
{"id": null, "n": "0231008", "target": "#nkr_note_orig_0231008", "type": "orig", "text": "少一作収"}
