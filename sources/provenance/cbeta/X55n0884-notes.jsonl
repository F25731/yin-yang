{"id": null, "n": "0231010", "target": "#nkr_note_orig_0231010", "type": "orig", "text": "順作損"}
{"id": null, "n": "0232001", "target": "#nkr_note_orig_0232001", "type": "orig", "text": "審一作翻"}
{"id": null, "n": "0232002", "target": "#nkr_note_orig_0232002", "type": "orig", "text": "靈字更勘"}
{"id": null, "n": "0232003", "target": "#nkr_note_orig_0232003", "type": "orig", "text": "數一作類"}
{"id": null, "n": "0232004", "target": "#nkr_note_orig_0232004", "type": "orig", "text": "世一作也"}
{"id": null, "n": "0232005", "target": "#nkr_note_orig_0232005", "type": "orig", "text": "便作使"}
{"id": null, "n": "0232006", "target": "#nkr_note_orig_0232006", "type": "orig", "text": "梵疑焚"}
{"id": null, "n": "0232007", "target": "#nkr_note_orig_0232007", "type": "orig", "text": "一無添字"}
{"id": null, "n": "0232008", "target": "#nkr_note_orig_0232008", "type": "orig", "text": "意一作表"}
