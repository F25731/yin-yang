{"id": null, "n": "0234002", "target": "#nkr_note_orig_0234002", "type": "orig", "text": "者下一有品者二字"}
{"id": null, "n": "0234003", "target": "#nkr_note_orig_0234003", "type": "orig", "text": "番通翻下同"}
{"id": null, "n": "0234004", "target": "#nkr_note_orig_0234004", "type": "orig", "text": "施一作攝"}
