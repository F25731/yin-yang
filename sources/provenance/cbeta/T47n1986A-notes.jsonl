{"id": null, "n": null, "target": null, "type": null, "text": "道明禪師"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦云隱山"}
{"id": null, "n": null, "target": null, "type": null, "text": "偈頌至下記志"}
{"id": null, "n": null, "target": null, "type": null, "text": "同安\n顯別云：不知"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲居代曰：「某甲道得不是賓中主。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "亦曰太湖"}
{"id": null, "n": null, "target": null, "type": null, "text": "第二世住亦云中洞山"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "三首"}
{"id": null, "n": null, "target": null, "type": null, "text": "竝攝曹山揀註故今不載于此"}
{"id": null, "n": null, "target": null, "type": null, "text": "本則既已出上"}
{"id": null, "n": null, "target": null, "type": null, "text": "向"}
{"id": null, "n": null, "target": null, "type": null, "text": "奉"}
{"id": null, "n": null, "target": null, "type": null, "text": "功"}
{"id": null, "n": null, "target": null, "type": null, "text": "共功"}
{"id": null, "n": null, "target": null, "type": null, "text": "功功"}
{"id": null, "n": null, "target": null, "type": null, "text": "二首"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "屬者予遊于山陰，得書讀之，皆祖語也。間有予未甞採者，雖片玉出崑岡，故附後"}
{"id": null, "n": null, "target": null, "type": null, "text": "勅諡弘覺禪師，塔曰圓寂洞山上足"}
{"id": null, "n": null, "target": null, "type": null, "text": "勅諡\n元證禪師，塔曰福圓"}
{"id": null, "n": null, "target": null, "type": null, "text": "第二世中洞山"}
{"id": null, "n": null, "target": null, "type": null, "text": "勅諡寶智大師，無為之塔住華嚴寺"}
{"id": null, "n": null, "target": null, "type": null, "text": "第三世後洞山，號青林和尚"}
{"id": null, "n": null, "target": null, "type": null, "text": "先住蘇州寶華山"}
{"id": null, "n": null, "target": null, "type": null, "text": "住北院勅，\n諡證真大師"}
{"id": null, "n": null, "target": null, "type": null, "text": "師本朝高僧傳曰：「航海入唐，參洞山价禪師，親承法印。」"}
{"id": null, "n": null, "target": null, "type": null, "text": "大尾"}
{"id": null, "n": null, "target": null, "type": null, "text": "曹山後聞乃云一子親得"}
{"id": null, "n": null, "target": null, "type": null, "text": "保福云洞山自是一家乃別云覓得幾人"}
{"id": null, "n": null, "target": null, "type": null, "text": "法眼代云恁麼則弟子不註"}
{"id": null, "n": null, "target": null, "type": null, "text": "此語諸本誤改易文字還作混尊卑語又開粥下加飯字最不可也"}
{"id": null, "n": null, "target": null, "type": null, "text": "長慶云既知有為甚麼恁麼道又云養子方知父慈"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲居代云恁麼則不見和尚本來師也僧問長慶如何是年牙相似者慶云古人恁麼道闍黎又向這裏覓箇甚麼"}
{"id": null, "n": null, "target": null, "type": null, "text": "後僧問曹山如何是一老山云不扶持云如何是一不老山云枯木僧又舉似逍遙忠忠云三從六義"}
{"id": null, "n": null, "target": null, "type": null, "text": "偈頌至下記志"}
{"id": null, "n": null, "target": null, "type": null, "text": "曹山曰如今人如佛味祖味盡為滯著"}
{"id": null, "n": null, "target": null, "type": null, "text": "保福別云佛非雲門云名不得狀不得所以言非法眼別云方便呼為佛"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲門云拄杖但喚作拄杖一切但喚作一切"}
{"id": null, "n": null, "target": null, "type": null, "text": "僧問曹山先師道吾常於此切意作麼生山云要頭便斫去又問雪峯峯以拄杖劈口打云我亦曾到洞山來"}
{"id": null, "n": null, "target": null, "type": null, "text": "東禪齊拈云此還有疑訛也無若有且道甚麼處不得若無他又道最苦是新羅還點檢出麼他道行則不無有覺即乖却令再問是其麼行又道佛行那僧是會了問不會了問請斷看"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T47n1986Bp0523b15"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T47n1986Bp0523b15"}
{"id": null, "n": null, "target": null, "type": null, "text": "法眼別云和尚若去某甲提笠子"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲居云行時無說路說時無行路不說不行時合行什麼路樂普云行說俱不到即本事在"}
{"id": null, "n": null, "target": null, "type": "cf1", "text": "T47n1986Bp0525b14"}
{"id": null, "n": null, "target": null, "type": "cf2", "text": "X66n1297_p0620b14"}
{"id": null, "n": null, "target": null, "type": null, "text": "師沒廬於塔傍至中和始乃辭塔北遊"}
{"id": null, "n": null, "target": null, "type": null, "text": "時號钁頭通"}
{"id": null, "n": null, "target": null, "type": null, "text": "法眼云不盡師意不易承嗣得他"}
{"id": null, "n": null, "target": null, "type": null, "text": "先雲居云待某甲有口即道長慶云與麼則某甲謹退雲居徵云秖如雪峰與麼道是入門語不是入門語"}
{"id": null, "n": null, "target": null, "type": null, "text": "琅瑘覺云巖頭無人問著不妨奇特纔被洞山腦後一錐直得瓦解氷消"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲居錫云上座具道雲巖路絕不絕崇壽稠云古人打此一棒意作麼生"}
{"id": null, "n": "0514013", "target": null, "type": "orig", "text": "也＋（雲居錫云上座具道雲巖路絕不絕崇壽稠云古人打此一棒意作麼生）夾註【甲】"}
{"id": null, "n": "0514013", "target": null, "type": "mod", "text": "也【大】，也雲居錫云上座具道雲巖路絕不絕崇壽稠云古人打此一棒意作麼生【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲居錫云上座具道雲巖路絕不絕崇壽稠云古人打此一棒意作麼生"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲居錫云上座具道雲巖路絕不絕崇壽稠云古人打此一棒意作麼生"}
{"id": null, "n": null, "target": null, "type": null, "text": "同安顯代曰。恁麼則雲巖一枝不墜也"}
{"id": null, "n": null, "target": null, "type": null, "text": "石霜云無人得他肯雲居云若有間名非吾先師曹山云從古至今無人辯得疎山云龍有出水之機無人辨得"}
{"id": null, "n": null, "target": null, "type": null, "text": "師昔在𭰤潭尋繹大藏纂出大乘經要一卷并激勵道俗偈頌誡等流布諸方"}
{"id": null, "n": null, "target": null, "type": null, "text": "向"}
{"id": null, "n": null, "target": null, "type": null, "text": "奉"}
{"id": null, "n": null, "target": null, "type": null, "text": "功"}
{"id": null, "n": null, "target": null, "type": null, "text": "共功"}
{"id": null, "n": null, "target": null, "type": null, "text": "功功"}
{"id": null, "n": "0507003", "target": "#nkr_note_mod_0507003", "type": "mod", "text": "曰【大】＊，〔－〕【甲】＊"}
{"id": null, "n": "0507004", "target": "#nkr_note_mod_0507004", "type": "mod", "text": "日【大】，月【校異-原】【甲】"}
{"id": null, "n": "0507005", "target": "#nkr_note_mod_0507005", "type": "mod", "text": "特【大】，犢【校異-甲】"}
{"id": null, "n": "0507006", "target": "#nkr_note_mod_0507006", "type": "mod", "text": "自是和尚【大】，何以【甲】"}
{"id": null, "n": "0508001", "target": "#nkr_note_mod_0508001", "type": "mod", "text": "近前曰【大】，問【甲】"}
{"id": null, "n": "0508002", "target": "#nkr_note_mod_0508002", "type": "mod", "text": "一尼【大】，尼眾【甲】"}
{"id": null, "n": "0508003", "target": "#nkr_note_mod_0508003", "type": "mod", "text": "這【大】，這箇【甲】"}
{"id": null, "n": "0508004", "target": "#nkr_note_mod_0508004", "type": "mod", "text": "良久【大】，沈吟【甲】"}
{"id": null, "n": "0508005", "target": "#nkr_note_mod_0508005", "type": "mod", "text": "細【大】，細師猶涉疑【甲】"}
{"id": null, "n": "0508006", "target": "#nkr_note_mod_0508006", "type": "mod", "text": "（師侍…出）三十六字【大】，〔－〕【甲】"}
{"id": null, "n": "0508007", "target": "#nkr_note_mod_0508007", "type": "mod", "text": "合【大】，〔－〕【甲】"}
{"id": null, "n": "0508008", "target": "#nkr_note_mod_0508008", "type": "mod", "text": "（曹山…親得）十字【大】，曹山後聞乃云一子親得【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "曹山後聞乃云一子親得"}
{"id": null, "n": "0508009", "target": "#nkr_note_mod_0508009", "type": "mod", "text": "師【大】，師初【甲】"}
{"id": null, "n": "0508010", "target": "#nkr_note_mod_0508010", "type": "mod", "text": "它且【大】，渠【甲】"}
{"id": null, "n": "0508011", "target": "#nkr_note_mod_0508011", "type": "mod", "text": "它亦【大】，渠【甲】"}
{"id": null, "n": "0508012", "target": "#nkr_note_mod_0508012", "type": "mod", "text": "（保福…幾人）十六字【大】，保福云洞山自是一家乃別云覓得幾人【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "保福云洞山自是一家乃別云覓得幾人"}
{"id": null, "n": "0508013", "target": "#nkr_note_mod_0508013", "type": "mod", "text": "山【大】，薯【甲】"}
{"id": null, "n": "0508014", "target": "#nkr_note_mod_0508014", "type": "mod", "text": "山【大】＊，龍【甲】＊"}
{"id": null, "n": "0509001", "target": "#nkr_note_mod_0509001", "type": "mod", "text": "似【大】，次【校異-原】"}
{"id": null, "n": "0509002", "target": "#nkr_note_mod_0509002", "type": "mod", "text": "（法眼…不註）十一字【大】，法眼代云恁麼則弟子不註【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "法眼代云恁麼則弟子不註"}
{"id": null, "n": "0509003", "target": "#nkr_note_mod_0509003", "type": "mod", "text": "柏巖【大】，百顏【甲】"}
{"id": null, "n": "0509004", "target": "#nkr_note_mod_0509004", "type": "mod", "text": "巖【大】＊，顏【甲】＊"}
{"id": null, "n": "0509005", "target": "#nkr_note_mod_0509005", "type": "mod", "text": "夏【大】，夏此語諸本誤改易文字還作混尊卑語又開粥下加飯字最不可也【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "此語諸本誤改易文字還作混尊卑語又開粥下加飯字最不可也"}
{"id": null, "n": "0509007", "target": "#nkr_note_mod_0509007", "type": "mod", "text": "洎【大】，幾【甲】"}
{"id": null, "n": "0509008", "target": "#nkr_note_mod_0509008", "type": "mod", "text": "（長慶…父慈）二十字【大】，長慶云既知有為甚麼恁麼道又云養子方知父慈【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "長慶云既知有為甚麼恁麼道又云養子方知父慈"}
{"id": null, "n": "0509009", "target": "#nkr_note_mod_0509009", "type": "mod", "text": "佛【大】，亦不為佛【甲】"}
{"id": null, "n": "0509010", "target": "#nkr_note_mod_0509010", "type": "mod", "text": "牙【大】，涯【校異-甲】"}
{"id": null, "n": "0509011", "target": "#nkr_note_mod_0509011", "type": "mod", "text": "（雲居…甚麼）四十四字【大】，雲居代云恁麼則不見和尚本來師也僧問長慶如何是年牙相似者慶云古人恁麼道闍黎又向這裏覓箇甚麼【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲居代云恁麼則不見和尚本來師也僧問長慶如何是年牙相似者慶云古人恁麼道闍黎又向這裏覓箇甚麼"}
{"id": null, "n": "0509012", "target": "#nkr_note_mod_0509012", "type": "mod", "text": "（因有…不會）六十四字【大】，〔－〕【甲】"}
{"id": null, "n": "0509013", "target": "#nkr_note_mod_0509013", "type": "mod", "text": "佛言教【大】，教佛教【甲】"}
{"id": null, "n": "0510001", "target": "#nkr_note_mod_0510001", "type": "mod", "text": "玄旨【大】，〔－〕【甲】"}
{"id": null, "n": "0510002", "target": "#nkr_note_mod_0510002", "type": "mod", "text": "（後僧…六義）三十九字【大】，後僧問曹山如何是一老山云不扶持云如何是一不老山云枯木僧又舉似逍遙忠忠云三從六義【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "後僧問曹山如何是一老山云不扶持云如何是一不老山云枯木僧又舉似逍遙忠忠云三從六義"}
{"id": null, "n": "0510003", "target": "#nkr_note_mod_0510003", "type": "mod", "text": "大【大】，別云大【甲】"}
{"id": null, "n": "0510004", "target": "#nkr_note_mod_0510004", "type": "mod", "text": "（後明安…地）十五字【大】，〔－〕【甲】"}
{"id": null, "n": "0510005", "target": "#nkr_note_mod_0510005", "type": "mod", "text": "（又曰…飢）十二字【大】，〔－〕【甲】"}
{"id": null, "n": "0510006", "target": "#nkr_note_mod_0510006", "type": "mod", "text": "（又曰…人）十二字【大】，〔－〕【甲】"}
{"id": null, "n": "0510007", "target": "#nkr_note_mod_0510007", "type": "mod", "text": "（又曰…閒）十二字【大】，〔－〕【甲】"}
{"id": null, "n": "0510008", "target": "#nkr_note_mod_0510008", "type": "mod", "text": "（又曰…居）十二字【大】，〔－〕【甲】"}
{"id": null, "n": "0510009", "target": "#nkr_note_mod_0510009", "type": "mod", "text": "（又曰…志）十八字【大】，〔－〕【甲】"}
{"id": null, "n": "0510010", "target": "#nkr_note_mod_0510010", "type": "mod", "text": "齋【大】，齋曹山曰如今人如佛味祖味盡為滯著【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "曹山曰如今人如佛味祖味盡為滯著"}
{"id": null, "n": "0510011", "target": "#nkr_note_mod_0510011", "type": "mod", "text": "（保福…為佛）二十八字【大】，保福別云佛非雲門云名不得狀不得所以言非法眼別云方便呼為佛【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "保福別云佛非雲門云名不得狀不得所以言非法眼別云方便呼為佛"}
{"id": null, "n": "0510012", "target": "#nkr_note_mod_0510012", "type": "mod", "text": "師【大】，〔－〕【甲】"}
{"id": null, "n": "0510013", "target": "#nkr_note_mod_0510013", "type": "mod", "text": "（雲門…一切）十七字【大】，雲門云拄杖但喚作拄杖一切但喚作一切【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲門云拄杖但喚作拄杖一切但喚作一切"}
{"id": null, "n": "0510014", "target": "#nkr_note_mod_0510014", "type": "mod", "text": "僧【大】＊，〔－〕【甲】＊"}
{"id": null, "n": "0510015", "target": "#nkr_note_mod_0510015", "type": "mod", "text": "（僧問…來）四十二字【大】，僧問曹山先師道吾常於此切意作麼生山云要頭便斫去又問雪峯峯以拄杖劈口打云我亦曾到洞山來【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "僧問曹山先師道吾常於此切意作麼生山云要頭便斫去又問雪峯峯以拄杖劈口打云我亦曾到洞山來"}
{"id": null, "n": "0511001", "target": "#nkr_note_mod_0511001", "type": "mod", "text": "節【大】，夜【校異-甲】"}
{"id": null, "n": "0511002", "target": "#nkr_note_mod_0511002", "type": "mod", "text": "泰首座【大】，太長老【校異-甲】"}
{"id": null, "n": "0511003", "target": "#nkr_note_mod_0511003", "type": "mod", "text": "原本註曰宏智錄互作顧＊"}
{"id": null, "n": "0511005", "target": "#nkr_note_mod_0511005", "type": "mod", "text": "（師示眾…不違）百五十七字【大】∞（有庵主…莖茆）八十二字【甲】"}
{"id": null, "n": "0511006", "target": "#nkr_note_mod_0511006", "type": "mod", "text": "私【大】，絲【校異-原】"}
{"id": null, "n": "0511007", "target": "#nkr_note_mod_0511007", "type": "mod", "text": "無對趙州代僧【大】，〔－〕【甲】"}
{"id": null, "n": "0511008", "target": "#nkr_note_mod_0511008", "type": "mod", "text": "若【大】，〔－〕【甲】"}
{"id": null, "n": "0511009", "target": "#nkr_note_mod_0511009", "type": "mod", "text": "（有庵主…莖茆）八十二字【大】∞（師示眾…不違）百五十七字【甲】"}
{"id": null, "n": "0511010", "target": "#nkr_note_mod_0511010", "type": "mod", "text": "山【大】，山之【甲】"}
{"id": null, "n": "0511011", "target": "#nkr_note_mod_0511011", "type": "mod", "text": "（意上座…重他）二百六十六字【大】，〔－〕【甲】"}
{"id": null, "n": "0511012", "target": "#nkr_note_mod_0511012", "type": "mod", "text": "羅【大】，羅東禪齊拈云此還有疑訛也無若有且道甚麼處不得若無他又道最苦是新羅還點檢出麼他道行則不無有覺即乖却令再問是其麼行又道佛行那僧是會了問不會了問請斷看【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "東禪齊拈云此還有疑訛也無若有且道甚麼處不得若無他又道最苦是新羅還點檢出麼他道行則不無有覺即乖却令再問是其麼行又道佛行那僧是會了問不會了問請斷看"}
{"id": null, "n": "0512001", "target": "#nkr_note_mod_0512001", "type": "mod", "text": "便【大】，便即【甲】"}
{"id": null, "n": "0512002", "target": "#nkr_note_mod_0512002", "type": "mod", "text": "僧【大】，師因僧【甲】"}
{"id": null, "n": "0512003", "target": "#nkr_note_mod_0512003", "type": "mod", "text": "（法眼…笠子）十三字【大】，法眼別云和尚若去某甲提笠子【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "法眼別云和尚若去某甲提笠子"}
{"id": null, "n": "0512004", "target": "#nkr_note_mod_0512004", "type": "mod", "text": "（雲居…在）三十五字【大】，雲居云行時無說路說時無行路不說不行時合行什麼路樂普云行說俱不到即本事在【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲居云行時無說路說時無行路不說不行時合行什麼路樂普云行說俱不到即本事在"}
{"id": null, "n": "0512005", "target": "#nkr_note_mod_0512005", "type": "mod", "text": "師【大】，〔－〕【甲】"}
{"id": null, "n": "0512006", "target": "#nkr_note_mod_0512006", "type": "mod", "text": "（道吾…地）十二字【大】，〔－〕【甲】"}
{"id": null, "n": "0512007", "target": "#nkr_note_mod_0512007", "type": "mod", "text": "舉【大】，舉示眾曰【甲】"}
{"id": null, "n": "0512008", "target": "#nkr_note_mod_0512008", "type": "mod", "text": "在【大】，在舉無著和尚因日勉遂問文殊云擬投一宿得否殊云爾有執心在不得此宿著云某甲無執心殊云爾受戒否著云受戒久矣殊云爾若無執心何用受戒著遂辭遏均提童子送著出著云適來和尚道前三三後三三是多少童子召云大德著回首童子云是多少師曰欲觀其父先觀其子【甲】"}
{"id": null, "n": "0512009", "target": "#nkr_note_mod_0512009", "type": "mod", "text": "（師示眾…在）二十六字【大】∞（舉文殊…何物）九十九字【甲】"}
{"id": null, "n": "0512010", "target": "#nkr_note_mod_0512010", "type": "mod", "text": "（舉文殊…何物）九十九字【大】∞（師示眾…在）二十六字【甲】"}
{"id": null, "n": "0512011", "target": "#nkr_note_mod_0512011", "type": "mod", "text": "著【大】，著曰【甲】"}
{"id": null, "n": "0512012", "target": "#nkr_note_mod_0512012", "type": "mod", "text": "否【大】，否石霜因僧問咫尺之間為甚不覩師顏霜曰我道遍界不曾藏僧後問雪峰遍界不曾藏意旨如何峰云什麼處不是石霜僧回舉似霜霜曰這老漢有什麼死急師聞曰笑殺土地西園一日自開俗次僧問何不使沙彌園乃撫掌三下師曰一種是時節因緣就中西園精妙【甲】"}
{"id": null, "n": "0512013", "target": "#nkr_note_mod_0512013", "type": "mod", "text": "山【大】，山寶積禪師【甲】"}
{"id": null, "n": "0512014", "target": "#nkr_note_mod_0512014", "type": "mod", "text": "舉【大】，〔－〕【甲】"}
{"id": null, "n": "0512015", "target": "#nkr_note_mod_0512015", "type": "mod", "text": "（雲巖…非佛）十一字【大】，〔－〕【甲】"}
{"id": null, "n": "0512016", "target": "#nkr_note_mod_0512016", "type": "mod", "text": "瀧【大】，霜【校異-甲】"}
{"id": null, "n": "0512017", "target": "#nkr_note_mod_0512017", "type": "mod", "text": "几【大】，向【校異-甲】"}
{"id": null, "n": "0512018", "target": "#nkr_note_mod_0512018", "type": "mod", "text": "太【大】，大【甲】"}
{"id": null, "n": "0513001", "target": "#nkr_note_mod_0513001", "type": "mod", "text": "山【大】，生【校異-原】【甲】"}
{"id": null, "n": "0513002", "target": "#nkr_note_mod_0513002", "type": "mod", "text": "（自爾…袖）十字【大】，〔－〕【甲】"}
{"id": null, "n": "0513003", "target": "#nkr_note_mod_0513003", "type": "mod", "text": "謁【大】，謁師【甲】"}
{"id": null, "n": "0513004", "target": "#nkr_note_mod_0513004", "type": "mod", "text": "山【大】，曹【甲】"}
{"id": null, "n": "0513005", "target": "#nkr_note_mod_0513005", "type": "mod", "text": "曰古佛【大】，深肯之【甲】"}
{"id": null, "n": "0513006", "target": "#nkr_note_mod_0513006", "type": "mod", "text": "云【大】＊，曹云【甲】＊"}
{"id": null, "n": "0513007", "target": "#nkr_note_mod_0513007", "type": "mod", "text": "問【大】，問師【甲】"}
{"id": null, "n": "0513008", "target": "#nkr_note_mod_0513008", "type": "mod", "text": "僧舉【大】，〔－〕【甲】"}
{"id": null, "n": "0513009", "target": "#nkr_note_mod_0513009", "type": "mod", "text": "問【大】，有僧舉問【甲】"}
{"id": null, "n": "0513010", "target": "#nkr_note_mod_0513010", "type": "mod", "text": "又舉某甲日前【大】，〔－〕【甲】"}
{"id": null, "n": "0513011", "target": "#nkr_note_mod_0513011", "type": "mod", "text": "近前曰㘞【大】，〔－〕【甲】"}
{"id": null, "n": "0513012", "target": "#nkr_note_mod_0513012", "type": "mod", "text": "笑【大】，笑牙後參師舉前語【甲】"}
{"id": null, "n": "0514001", "target": "#nkr_note_mod_0514001", "type": "mod", "text": "逆【大】，泝【校異-原】【甲】"}
{"id": null, "n": "0514002", "target": "#nkr_note_mod_0514002", "type": "mod", "text": "見【大】，見師【甲】"}
{"id": null, "n": "0514003", "target": "#nkr_note_mod_0514003", "type": "mod", "text": "士【大】，士師沒廬於塔傍至中和始乃辭塔北遊【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "師沒廬於塔傍至中和始乃辭塔北遊"}
{"id": null, "n": "0514004", "target": "#nkr_note_mod_0514004", "type": "mod", "text": "長長【大】，青青【校異-原】"}
{"id": null, "n": "0514005", "target": "#nkr_note_mod_0514005", "type": "mod", "text": "青【大】，荒【校異-原】"}
{"id": null, "n": "0514006", "target": "#nkr_note_mod_0514006", "type": "mod", "text": "時號钁頭通【大】，時號钁頭通【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "時號钁頭通"}
{"id": null, "n": "0514007", "target": "#nkr_note_mod_0514007", "type": "mod", "text": "（法眼…他）十三字【大】，法眼云不盡師意不易承嗣得他【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "法眼云不盡師意不易承嗣得他"}
{"id": null, "n": "0514008", "target": "#nkr_note_mod_0514008", "type": "mod", "text": "閉【大】，開【校異-甲】"}
{"id": null, "n": "0514010", "target": "#nkr_note_mod_0514010", "type": "mod", "text": "（雲居…道）十字【大】，先雲居云待某甲有口即道長慶云與麼則某甲謹退雲居徵云秖如雪峰與麼道是入門語不是入門語【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "先雲居云待某甲有口即道長慶云與麼則某甲謹退雲居徵云秖如雪峰與麼道是入門語不是入門語"}
{"id": null, "n": "0514011", "target": "#nkr_note_mod_0514011", "type": "mod", "text": "琅瑘覺云巖頭無人問著不妨奇特纔被洞山腦後一錐直得瓦解氷消【大】，琅瑘覺云巖頭無人問著不妨奇特纔被洞山腦後一錐直得瓦解氷消【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "琅瑘覺云巖頭無人問著不妨奇特纔被洞山腦後一錐直得瓦解氷消"}
{"id": null, "n": "0514012", "target": "#nkr_note_mod_0514012", "type": "mod", "text": "（同安顯…也）十五字【大】，（同安顯代曰。恁麼則雲巖一枝不墜也）十五字【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "同安顯代曰。恁麼則雲巖一枝不墜也"}
{"id": null, "n": "0514013", "target": "#nkr_note_mod_0514013", "type": "mod", "text": "也【大】，也雲居錫云上座具道雲巖路絕不絕崇壽稠云古人打此一棒意作麼生【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲居錫云上座具道雲巖路絕不絕崇壽稠云古人打此一棒意作麼生"}
{"id": null, "n": "0514014", "target": "#nkr_note_mod_0514014", "type": "mod", "text": "（石霜…辨得）四十三字【大】，石霜云無人得他肯雲居云若有間名非吾先師曹山云從古至今無人辯得疎山云龍有出水之機無人辨得【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "石霜云無人得他肯雲居云若有間名非吾先師曹山云從古至今無人辯得疎山云龍有出水之機無人辨得"}
{"id": null, "n": "0515001", "target": "#nkr_note_mod_0515001", "type": "mod", "text": "復【大】，〔－〕【甲】"}
{"id": null, "n": "0515002", "target": "#nkr_note_mod_0515002", "type": "mod", "text": "覺【大】，覺師昔在𭰤潭尋繹大藏纂出大乘經要一卷并激勵道俗偈頌誡等流布諸方【甲】"}
{"id": null, "n": null, "target": null, "type": null, "text": "師昔在𭰤潭尋繹大藏纂出大乘經要一卷并激勵道俗偈頌誡等流布諸方"}
{"id": null, "n": "0515004", "target": "#nkr_note_mod_0515004", "type": "mod", "text": "重【大】，如【校異-甲】"}
{"id": null, "n": "0516002", "target": "#nkr_note_mod_0516002", "type": "mod", "text": "五位【大】，〔－〕【甲】"}
{"id": null, "n": "0516003", "target": "#nkr_note_mod_0516003", "type": "mod", "text": "本則既已出上【大】，異本作上堂次示問話僧頌【甲】"}
{"id": null, "n": "0516005", "target": "#nkr_note_mod_0516005", "type": "mod", "text": "向【大】，〔－〕【甲】"}
{"id": null, "n": "0516007", "target": "#nkr_note_mod_0516007", "type": "mod", "text": "奉【大】，〔－〕【甲】"}
{"id": null, "n": "0516009", "target": "#nkr_note_mod_0516009", "type": "mod", "text": "功【大】，〔－〕【甲】"}
{"id": null, "n": "0516011", "target": "#nkr_note_mod_0516011", "type": "mod", "text": "共功【大】，〔－〕【甲】"}
