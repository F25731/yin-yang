{"id": null, "n": "0262b2201", "target": "#nkr_note_add_0262b2201", "type": "add", "text": "已【CB】，巳【卍續】"}
{"id": null, "n": "0264a2101", "target": "#nkr_note_add_0264a2101", "type": "add", "text": "己【CB】，已【卍續】"}
{"id": null, "n": "0264b1001", "target": "#nkr_note_add_0264b1001", "type": "add", "text": "已【CB】，巳【卍續】"}
{"id": null, "n": "0264c0601", "target": "#nkr_note_add_0264c0601", "type": "add", "text": "已【CB】，巳【卍續】"}
{"id": null, "n": "0264c1201", "target": "#nkr_note_add_0264c1201", "type": "add", "text": "已【CB】，巳【卍續】"}
{"id": null, "n": "0265a2001", "target": "#nkr_note_add_0265a2001", "type": "add", "text": "已【CB】，巳【卍續】"}
{"id": null, "n": "0265b0201", "target": "#nkr_note_add_0265b0201", "type": "add", "text": "已【CB】，巳【卍續】"}
{"id": null, "n": "0266c0701", "target": "#nkr_note_add_0266c0701", "type": "add", "text": "已【CB】，巳【卍續】"}
{"id": null, "n": "0270b1901", "target": "#nkr_note_add_0270b1901", "type": "add", "text": "己【CB】，巳【卍續】"}
