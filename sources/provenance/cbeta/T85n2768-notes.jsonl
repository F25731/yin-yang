{"id": null, "n": "0329001", "target": "#nkr_note_orig_0329001", "type": "orig", "text": "【原】大英博物館藏燉煌本, S. 2106, 首題新加"}
{"id": null, "n": "0329002", "target": "#nkr_note_orig_0329002", "type": "orig", "text": "首闕"}
{"id": null, "n": "0329003", "target": "#nkr_note_orig_0329003", "type": "orig", "text": "觀＝歡？"}
{"id": null, "n": "0329004", "target": "#nkr_note_orig_0329004", "type": "orig", "text": "傍註曰交有而"}
{"id": null, "n": "0330001", "target": "#nkr_note_orig_0330001", "type": "orig", "text": "或＝惑？"}
{"id": null, "n": "0330002", "target": "#nkr_note_orig_0330002", "type": "orig", "text": "財＝時？＊"}
{"id": null, "n": "0330003", "target": "#nkr_note_orig_0330003", "type": "orig", "text": "道外＝外道？"}
{"id": null, "n": "0331001", "target": "#nkr_note_orig_0331001", "type": "orig", "text": "被＝依？"}
{"id": null, "n": "0331002", "target": "#nkr_note_orig_0331002", "type": "orig", "text": "幾＝機？"}
{"id": null, "n": "0331003", "target": "#nkr_note_orig_0331003", "type": "orig", "text": "〔無〕－？"}
{"id": null, "n": "0331004", "target": "#nkr_note_orig_0331004", "type": "orig", "text": "云＝之？"}
{"id": null, "n": "0331005", "target": "#nkr_note_orig_0331005", "type": "orig", "text": "幾＝機？"}
{"id": null, "n": "0332001", "target": "#nkr_note_orig_0332001", "type": "orig", "text": "過＋（去）？"}
{"id": null, "n": "0333001", "target": "#nkr_note_orig_0333001", "type": "orig", "text": "明＝有？"}
{"id": null, "n": "0333002", "target": "#nkr_note_orig_0333002", "type": "orig", "text": "客＋（塵）？"}
{"id": null, "n": "0333003", "target": "#nkr_note_orig_0333003", "type": "orig", "text": "幾＝譏？"}
{"id": null, "n": "0334001", "target": "#nkr_note_orig_0334001", "type": "orig", "text": "違＝遣？"}
{"id": null, "n": "0336001", "target": "#nkr_note_orig_0336001", "type": "orig", "text": "〔所如〕－？"}
{"id": null, "n": "0338001", "target": "#nkr_note_orig_0338001", "type": "orig", "text": "聞＝同？"}
{"id": null, "n": "0338002", "target": "#nkr_note_orig_0338002", "type": "orig", "text": "傍註曰亦上不盡有為"}
{"id": null, "n": "0339001", "target": "#nkr_note_orig_0339001", "type": "orig", "text": "致＝教？"}
{"id": null, "n": "0339002", "target": "#nkr_note_orig_0339002", "type": "orig", "text": "問＝閦？"}
{"id": null, "n": "0331b0901", "target": "#nkr_note_add_0331b0901", "type": "add", "text": "諂【CB】，謟【大】"}
{"id": null, "n": "0334b0501", "target": "#nkr_note_add_0334b0501", "type": "add", "text": "八【CB】，【大】"}
{"id": null, "n": "0335a2301", "target": "#nkr_note_add_0335a2301", "type": "add", "text": "倒【CB】，到【大】"}
{"id": null, "n": "0336a2901", "target": "#nkr_note_add_0336a2901", "type": "add", "text": "壤【CB】，壞【大】"}
