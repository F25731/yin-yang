{"id": null, "n": "0330003", "target": "#nkr_note_mod_0330003", "type": "mod", "text": "道外【大】，外道【考偽-大】"}
{"id": null, "n": "0331001", "target": "#nkr_note_mod_0331001", "type": "mod", "text": "被【大】，依【考偽-大】"}
{"id": null, "n": "0331002", "target": "#nkr_note_mod_0331002", "type": "mod", "text": "幾【大】，機【考偽-大】"}
{"id": null, "n": "0331003", "target": "#nkr_note_mod_0331003", "type": "mod", "text": "無【大】，〔－〕【考偽-大】"}
{"id": null, "n": "0331004", "target": "#nkr_note_mod_0331004", "type": "mod", "text": "云【大】，之【考偽-大】"}
{"id": null, "n": "0331005", "target": "#nkr_note_mod_0331005", "type": "mod", "text": "幾【大】，機【考偽-大】"}
{"id": null, "n": "0332001", "target": "#nkr_note_mod_0332001", "type": "mod", "text": "過【大】，過去【考偽-大】"}
{"id": null, "n": "0333001", "target": "#nkr_note_mod_0333001", "type": "mod", "text": "明【大】，有【考偽-大】"}
{"id": null, "n": "0333002", "target": "#nkr_note_mod_0333002", "type": "mod", "text": "客【大】，客塵【考偽-大】"}
{"id": null, "n": "0333003", "target": "#nkr_note_mod_0333003", "type": "mod", "text": "幾【大】，譏【考偽-大】"}
{"id": null, "n": "0334001", "target": "#nkr_note_mod_0334001", "type": "mod", "text": "違【大】，遣【考偽-大】"}
