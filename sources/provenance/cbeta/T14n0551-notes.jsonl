{"id": null, "n": "0895001", "target": "#nkr_note_mod_0895001", "type": "mod", "text": "佛說【大】＊，〔－〕【宋】【明】【宮】＊，cf. Śārdūlakarṇa-avadāna. 摩登伽經，舍頭諫太子二十八宿經參照"}
{"id": null, "n": "0895002", "target": "#nkr_note_mod_0895002", "type": "mod", "text": "安息國三藏【大】，三藏法師【元】【明】【宮】"}
{"id": null, "n": "0895003", "target": "#nkr_note_mod_0895003", "type": "mod", "text": "乞【大】，匃【宮】"}
{"id": null, "n": "0895004", "target": "#nkr_note_mod_0895004", "type": "mod", "text": "問何字名【大】，隨問名名曰【元】【明】，問阿隨字【宮】"}
{"id": null, "n": "0895005", "target": "#nkr_note_mod_0895005", "type": "mod", "text": "有【大】，生【元】【明】【宮】"}
{"id": null, "n": "0895006", "target": "#nkr_note_mod_0895006", "type": "mod", "text": "知【大】，知女【元】【明】"}
{"id": null, "n": "0895007", "target": "#nkr_note_mod_0895007", "type": "mod", "text": "即【大】，佛即【元】【明】【宮】"}
{"id": null, "n": "0895008", "target": "#nkr_note_mod_0895008", "type": "mod", "text": "於【大】，〔－〕【宮】"}
{"id": null, "n": "0895009", "target": "#nkr_note_mod_0895009", "type": "mod", "text": "如兄【大】，如兄【元】【明】"}
{"id": null, "n": "0895010", "target": "#nkr_note_mod_0895010", "type": "mod", "text": "弟如【大】，如弟【宮】，如弟如【元】【明】"}
{"id": null, "n": "0895001", "target": "#nkr_note_orig_0895001", "type": "orig", "text": "〔佛說〕－【宋】【明】【宮】＊，cf. Śārdūlakarṇa-avadāna. 摩登伽經，舍頭諫太子二十八宿經參照"}
{"id": null, "n": "0895002", "target": "#nkr_note_orig_0895002", "type": "orig", "text": "安息國三藏＝三藏法師【元】【明】【宮】"}
{"id": null, "n": "0895003", "target": "#nkr_note_orig_0895003", "type": "orig", "text": "乞＝匃【宮】"}
{"id": null, "n": "0895004", "target": "#nkr_note_orig_0895004", "type": "orig", "text": "問何字名＝隨問名名曰【元】【明】，問阿隨字【宮】"}
{"id": null, "n": "0895005", "target": "#nkr_note_orig_0895005", "type": "orig", "text": "有＝生【元】【明】【宮】"}
{"id": null, "n": "0895006", "target": "#nkr_note_orig_0895006", "type": "orig", "text": "知＋（女）【元】【明】"}
{"id": null, "n": "0895007", "target": "#nkr_note_orig_0895007", "type": "orig", "text": "（佛）＋即【元】【明】【宮】"}
{"id": null, "n": "0895008", "target": "#nkr_note_orig_0895008", "type": "orig", "text": "〔於〕－【宮】"}
{"id": null, "n": "0895009", "target": "#nkr_note_orig_0895009", "type": "orig", "text": "如兄弟＝如兄如弟【元】【明】"}
{"id": null, "n": "0895010", "target": "#nkr_note_orig_0895010", "type": "orig", "text": "弟如＝如弟【宮】"}
{"id": null, "n": "0895a2501", "target": "#nkr_note_add_0895a2501", "type": "add", "text": "飾【CB】，飯【大】"}
{"id": null, "n": "0895b0701", "target": "#nkr_note_add_0895b0701", "type": "add", "text": "匃【CB】，勾【大】"}
{"id": null, "n": "0895001", "target": "#nkr_note_cf._0895001", "type": "cf.", "text": "cf. Śārdūlakarṇa-avadāna. 摩登伽經，舍頭諫太子二十八宿經參照"}
