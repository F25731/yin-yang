{"id": null, "n": "0019008", "target": "#nkr_note_mod_0019008", "type": "mod", "text": "（開府…門）四十一字【大】，特進試鴻臚卿大興善寺三藏沙門大廣智【宋】【元】【甲】【乙】，唐三藏沙門大廣智【明】"}
{"id": null, "n": "0019009", "target": "#nkr_note_mod_0019009", "type": "mod", "text": "摩訶薩【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0019010", "target": "#nkr_note_mod_0019010", "type": "mod", "text": "受【大】，授【甲】【乙】"}
{"id": null, "n": "0019011", "target": "#nkr_note_mod_0019011", "type": "mod", "text": "切【大】，切大智【宋】【元】【明】，切大切【甲】【乙】"}
{"id": null, "n": "0019012", "target": "#nkr_note_mod_0019012", "type": "mod", "text": "祕【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0019013", "target": "#nkr_note_mod_0019013", "type": "mod", "text": "聞【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0019014", "target": "#nkr_note_mod_0019014", "type": "mod", "text": "（焰炬…地）十字【大】，〔－〕【甲】【乙】"}
{"id": null, "n": "0019015", "target": "#nkr_note_mod_0019015", "type": "mod", "text": "開【大】，聞【宋】"}
{"id": null, "n": "0019016", "target": "#nkr_note_mod_0019016", "type": "mod", "text": "之【大】，〔－〕【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0019017", "target": "#nkr_note_mod_0019017", "type": "mod", "text": "間【大】，聞【宋】"}
{"id": null, "n": "0019018", "target": "#nkr_note_mod_0019018", "type": "mod", "text": "唯【大】，惟【宋】【元】【明】"}
{"id": null, "n": "0019019", "target": "#nkr_note_mod_0019019", "type": "mod", "text": "荼【大】＊，茶【宋】【元】【甲】＊"}
{"id": null, "n": "0020002", "target": "#nkr_note_mod_0020002", "type": "mod", "text": "合【大】，合二【宋】【元】【明】【甲】【乙】"}
{"id": null, "n": "0020003", "target": "#nkr_note_mod_0020003", "type": "mod", "text": "引【大】＊，〔－〕【乙】＊"}
{"id": null, "n": "0020004", "target": "#nkr_note_mod_0020004", "type": "mod", "text": "耶【大】，耶三【宋】【元】【明】【甲】【乙】"}
