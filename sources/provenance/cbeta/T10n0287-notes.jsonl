{"id": null, "n": "0535006", "target": "#nkr_note_mod_0535006", "type": "mod", "text": "金剛藏 Vajragarbha."}
{"id": null, "n": "0535007", "target": "#nkr_note_mod_0535007", "type": "mod", "text": "大乘光明 Mahāyānaprabhāva."}
{"id": null, "n": "0536015", "target": "#nkr_note_mod_0536015", "type": "mod", "text": "解脫月 Vimukticanra."}
{"id": null, "n": "0537001", "target": "#nkr_note_mod_0537001", "type": "mod", "text": "照菩薩力 Bodhisattvavalālokā."}
{"id": null, "n": "0542002", "target": "#nkr_note_mod_0542002", "type": "mod", "text": "意樂 Śayatā."}
{"id": null, "n": "0542003", "target": "#nkr_note_mod_0542003", "type": "mod", "text": "正直 Ārjava."}
{"id": null, "n": "0542004", "target": "#nkr_note_mod_0542004", "type": "mod", "text": "柔軟 Mṛḍā."}
{"id": null, "n": "0542005", "target": "#nkr_note_mod_0542005", "type": "mod", "text": "堪能 Karmanyā."}
{"id": null, "n": "0542006", "target": "#nkr_note_mod_0542006", "type": "mod", "text": "調伏 Damā."}
{"id": null, "n": "0542007", "target": "#nkr_note_mod_0542007", "type": "mod", "text": "寂滅 Śanā."}
{"id": null, "n": "0542008", "target": "#nkr_note_mod_0542008", "type": "mod", "text": "賢善 Kalyāṇā."}
{"id": null, "n": "0542009", "target": "#nkr_note_mod_0542009", "type": "mod", "text": "不雜 Asaṃsṛṣṭā."}
{"id": null, "n": "0542010", "target": "#nkr_note_mod_0542010", "type": "mod", "text": "無顧戀 Anāpakṣā."}
{"id": null, "n": "0542011", "target": "#nkr_note_mod_0542011", "type": "mod", "text": "勝妙 Udārā."}
{"id": null, "n": "0542012", "target": "#nkr_note_mod_0542012", "type": "mod", "text": "廣大 Māhātmyā."}
{"id": null, "n": "0545002", "target": "#nkr_note_mod_0545002", "type": "mod", "text": "心之意樂作意 Cittāśayamanaskāra."}
{"id": null, "n": "0545003", "target": "#nkr_note_mod_0545003", "type": "mod", "text": "清淨 Śuddha."}
{"id": null, "n": "0545004", "target": "#nkr_note_mod_0545004", "type": "mod", "text": "安住 Sthira."}
{"id": null, "n": "0545005", "target": "#nkr_note_mod_0545005", "type": "mod", "text": "厭離 Nirviṇṇa."}
{"id": null, "n": "0545006", "target": "#nkr_note_mod_0545006", "type": "mod", "text": "離欲 Virāga."}
{"id": null, "n": "0545007", "target": "#nkr_note_mod_0545007", "type": "mod", "text": "不退 Avivarta."}
{"id": null, "n": "0545008", "target": "#nkr_note_mod_0545008", "type": "mod", "text": "堅固 Dṛḥa."}
{"id": null, "n": "0545009", "target": "#nkr_note_mod_0545009", "type": "mod", "text": "熾然 Uttapta."}
{"id": null, "n": "0545010", "target": "#nkr_note_mod_0545010", "type": "mod", "text": "勇健 Tṛpta(?)."}
{"id": null, "n": "0545011", "target": "#nkr_note_mod_0545011", "type": "mod", "text": "勝妙 Udāra."}
{"id": null, "n": "0545012", "target": "#nkr_note_mod_0545012", "type": "mod", "text": "廣大 Māhātmya."}
{"id": null, "n": "0547002", "target": "#nkr_note_mod_0547002", "type": "mod", "text": "法明 Dharmalokpraveśa."}
{"id": null, "n": "0547003", "target": "#nkr_note_mod_0547003", "type": "mod", "text": "有情界思察 Sattvadhātu-vicāraṇa."}
{"id": null, "n": "0549002", "target": "#nkr_note_mod_0549002", "type": "mod", "text": "薩迦邪見 Satkāyadṛṣṭi."}
{"id": null, "n": "0550001", "target": "#nkr_note_mod_0550001", "type": "mod", "text": "平等 Samatā."}
{"id": null, "n": "0551001", "target": "#nkr_note_mod_0551001", "type": "mod", "text": "書．論．印璽．算計。Lipi-śāstra-mudrā-saṃkhyā-gaṇanā-nikṣepa."}
{"id": null, "n": "0551002", "target": "#nkr_note_mod_0551002", "type": "mod", "text": "金性等論．諸醫方論。Nānādhātutantra cikitsātantrāni."}
{"id": null, "n": "0551003", "target": "#nkr_note_mod_0551003", "type": "mod", "text": "療乾痟 Śoṣa."}
{"id": null, "n": "0551004", "target": "#nkr_note_mod_0551004", "type": "mod", "text": "癲癎 Apasmāra."}
{"id": null, "n": "0551005", "target": "#nkr_note_mod_0551005", "type": "mod", "text": "鬼魅 Bhūta-graha."}
{"id": null, "n": "0551006", "target": "#nkr_note_mod_0551006", "type": "mod", "text": "蠱毒 Viṣa."}
{"id": null, "n": "0551007", "target": "#nkr_note_mod_0551007", "type": "mod", "text": "起屍鬼 Vetāḍa(Vetāla)."}
{"id": null, "n": "0551008", "target": "#nkr_note_mod_0551008", "type": "mod", "text": "呪詛和合 Prayogapratighātaka."}
{"id": null, "n": "0551009", "target": "#nkr_note_mod_0551009", "type": "mod", "text": "文筆讚詠歌舞妓樂戲笑談說喜樂 Kāvyanāṭhakākhyānagāndharvetihāsasampraharṣaṇa."}
{"id": null, "n": "0552002", "target": "#nkr_note_mod_0552002", "type": "mod", "text": "法平等性 Dharmasamatā."}
{"id": null, "n": "0556001", "target": "#nkr_note_mod_0556001", "type": "mod", "text": "妙方便慧所引不共進道勝行 Upāyaprajñā-jñānābhinirhṛta-mārgāntarārambha-viśeṣa."}
{"id": null, "n": "0535002", "target": "#nkr_note_orig_0535002", "type": "orig", "text": "Daśabhūmīśvara."}
