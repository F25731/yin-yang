{"id": null, "n": "0544005", "target": "#nkr_note_orig_0544005", "type": "orig", "text": "Gocara."}
{"id": null, "n": "0545001", "target": "#nkr_note_orig_0545001", "type": "orig", "text": "3. Prabhākarī-bodhisattvabhūmi."}
{"id": null, "n": "0545002", "target": "#nkr_note_orig_0545002", "type": "orig", "text": "心之意樂作意. Cittāśayamanaskāra."}
{"id": null, "n": "0545003", "target": "#nkr_note_orig_0545003", "type": "orig", "text": "清淨. Śuddha."}
{"id": null, "n": "0545004", "target": "#nkr_note_orig_0545004", "type": "orig", "text": "安住. Sthira."}
{"id": null, "n": "0545005", "target": "#nkr_note_orig_0545005", "type": "orig", "text": "厭離. Nirviṇṇa."}
{"id": null, "n": "0545006", "target": "#nkr_note_orig_0545006", "type": "orig", "text": "離欲. Virāga."}
{"id": null, "n": "0545007", "target": "#nkr_note_orig_0545007", "type": "orig", "text": "不退. Avivarta."}
{"id": null, "n": "0545008", "target": "#nkr_note_orig_0545008", "type": "orig", "text": "堅固. Dṛḥa."}
{"id": null, "n": "0545009", "target": "#nkr_note_orig_0545009", "type": "orig", "text": "熾然. Uttapta."}
{"id": null, "n": "0545010", "target": "#nkr_note_orig_0545010", "type": "orig", "text": "勇健. Tṛpta(?)."}
{"id": null, "n": "0545011", "target": "#nkr_note_orig_0545011", "type": "orig", "text": "勝妙. Udāra."}
{"id": null, "n": "0545012", "target": "#nkr_note_orig_0545012", "type": "orig", "text": "廣大. Māhātmya."}
{"id": null, "n": "0547001", "target": "#nkr_note_orig_0547001", "type": "orig", "text": "4. Arciṣmatī-bohisattvabhūmi."}
{"id": null, "n": "0547002", "target": "#nkr_note_orig_0547002", "type": "orig", "text": "法明. Dharmalokpraveśa."}
{"id": null, "n": "0547003", "target": "#nkr_note_orig_0547003", "type": "orig", "text": "有情界思察. Sattvadhātu-vicāraṇa."}
{"id": null, "n": "0547004", "target": "#nkr_note_orig_0547004", "type": "orig", "text": "Lokadhātu-."}
{"id": null, "n": "0547005", "target": "#nkr_note_orig_0547005", "type": "orig", "text": "Dharmadhātu-."}
