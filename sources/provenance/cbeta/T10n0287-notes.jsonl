{"id": null, "n": "0547012", "target": "#nkr_note_orig_0547012", "type": "orig", "text": "Māhātmyāśayāvimuktidhātu-."}
{"id": null, "n": "0549001", "target": "#nkr_note_orig_0549001", "type": "orig", "text": "Suyāma."}
{"id": null, "n": "0549002", "target": "#nkr_note_orig_0549002", "type": "orig", "text": "薩迦邪見. Satkāyadṛṣṭi."}
{"id": null, "n": "0549003", "target": "#nkr_note_orig_0549003", "type": "orig", "text": "5. Sudurjayā-bodhisattvabhūmi."}
{"id": null, "n": "0550001", "target": "#nkr_note_orig_0550001", "type": "orig", "text": "平等. Samatā."}
{"id": null, "n": "0551001", "target": "#nkr_note_orig_0551001", "type": "orig", "text": "書．論．印璽．算計。Lipi-śāstra-mudrā-saṃkhyā-gaṇanā-nikṣepa."}
{"id": null, "n": "0551002", "target": "#nkr_note_orig_0551002", "type": "orig", "text": "金性等。諸醫方論。Nānādhātutantra cikitsātantrāni."}
{"id": null, "n": "0551003", "target": "#nkr_note_orig_0551003", "type": "orig", "text": "療乾痟. Śoṣa."}
{"id": null, "n": "0551004", "target": "#nkr_note_orig_0551004", "type": "orig", "text": "癲癎. Apasmāra."}
{"id": null, "n": "0551005", "target": "#nkr_note_orig_0551005", "type": "orig", "text": "鬼魅. Bhūta-graha."}
{"id": null, "n": "0551006", "target": "#nkr_note_orig_0551006", "type": "orig", "text": "蠱毒. Viṣa."}
{"id": null, "n": "0551007", "target": "#nkr_note_orig_0551007", "type": "orig", "text": "起屍鬼. Vetāḍa(Vetāla)."}
{"id": null, "n": "0551008", "target": "#nkr_note_orig_0551008", "type": "orig", "text": "呪詛和合. Prayogapratighātaka."}
{"id": null, "n": "0551009", "target": "#nkr_note_orig_0551009", "type": "orig", "text": "文筆讚詠歌舞妓樂戲笑談說喜樂. Kāvyanāṭhakākhyānagāndharvetihāsasampraharṣaṇa."}
{"id": null, "n": "0552001", "target": "#nkr_note_orig_0552001", "type": "orig", "text": "6. Abhimukhī-bodhisattvabhūmi."}
{"id": null, "n": "0552002", "target": "#nkr_note_orig_0552002", "type": "orig", "text": "法平等性. Dharmasamatā."}
{"id": null, "n": "0555001", "target": "#nkr_note_orig_0555001", "type": "orig", "text": "7. Dūraṅgamā-bodhisattvabhūmi."}
{"id": null, "n": "0556001", "target": "#nkr_note_orig_0556001", "type": "orig", "text": "妙方便慧所引不共進道勝行. Upāyaprajñā-jñānābhinirhṛta-mārgāntarārambha-viśeṣa."}
{"id": null, "n": "0559001", "target": "#nkr_note_orig_0559001", "type": "orig", "text": "8. Acalā-bodhisattvabhūmi."}
