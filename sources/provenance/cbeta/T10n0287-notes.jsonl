{"id": null, "n": null, "target": null, "type": null, "text": "1. Śraddhā. 2. Karuṇa. 3. Maitrī. 4. Trāga. 5. Aparikhinna. 6. Śāstrajñā. 7. Lokajñā. 8. Hrirpatāpya. 9. Dhṛtibalādhāna. 10. Tathāgatapūjitopsasthāna."}
{"id": null, "n": "0541001", "target": "#nkr_note_orig_0541001", "type": "orig", "text": "Pañcabhaya（1. 不活. 2. 惡名. Akīrti. 3. 死. Maraṇa. 4. 惡趣. Durgati. 5. 處. Parṣad.）"}
{"id": null, "n": "0542001", "target": "#nkr_note_orig_0542001", "type": "orig", "text": "2. Vimalā-bodhisattvabhūmi."}
{"id": null, "n": "0542002", "target": "#nkr_note_orig_0542002", "type": "orig", "text": "意樂. Śayatā."}
{"id": null, "n": "0542003", "target": "#nkr_note_orig_0542003", "type": "orig", "text": "正直. Ārjava."}
{"id": null, "n": "0542004", "target": "#nkr_note_orig_0542004", "type": "orig", "text": "柔軟. Mṛḍā."}
{"id": null, "n": "0542005", "target": "#nkr_note_orig_0542005", "type": "orig", "text": "堪能. Karmanyā."}
{"id": null, "n": "0542006", "target": "#nkr_note_orig_0542006", "type": "orig", "text": "調伏. Damā."}
{"id": null, "n": "0542007", "target": "#nkr_note_orig_0542007", "type": "orig", "text": "寂滅. Śanā."}
{"id": null, "n": "0542008", "target": "#nkr_note_orig_0542008", "type": "orig", "text": "賢善. Kalyāṇā."}
{"id": null, "n": "0542009", "target": "#nkr_note_orig_0542009", "type": "orig", "text": "不雜. Asaṃsṛṣṭā."}
{"id": null, "n": "0542010", "target": "#nkr_note_orig_0542010", "type": "orig", "text": "無顧戀. Anāpakṣā."}
{"id": null, "n": "0542011", "target": "#nkr_note_orig_0542011", "type": "orig", "text": "勝妙. Udārā."}
{"id": null, "n": "0542012", "target": "#nkr_note_orig_0542012", "type": "orig", "text": "廣大意. Māhātmyā."}
{"id": null, "n": "0543001", "target": "#nkr_note_orig_0543001", "type": "orig", "text": "Prayāṇa."}
{"id": null, "n": "0543002", "target": "#nkr_note_orig_0543002", "type": "orig", "text": "Niraya."}
{"id": null, "n": "0543003", "target": "#nkr_note_orig_0543003", "type": "orig", "text": "Yamaloka."}
{"id": null, "n": "0543004", "target": "#nkr_note_orig_0543004", "type": "orig", "text": "Samacitta（視若自己之意）"}
{"id": null, "n": "0543005", "target": "#nkr_note_orig_0543005", "type": "orig", "text": "Ācarya-citta."}
{"id": null, "n": "0543006", "target": "#nkr_note_orig_0543006", "type": "orig", "text": "Śāstṛcitta."}
