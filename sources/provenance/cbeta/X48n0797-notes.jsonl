{"id": null, "n": null, "target": null, "type": "cf1", "text": "據「滅或」於前一段內文出現4次，且「或」字旁皆有黑點，故疑前人之黑點標註位置有誤。"}
{"id": null, "n": null, "target": null, "type": "star", "text": ""}
{"id": null, "n": "0159001", "target": "#nkr_note_orig_0159001", "type": "orig", "text": "釋真諦譯中邊分別論"}
{"id": null, "n": "0159002", "target": "#nkr_note_orig_0159002", "type": "orig", "text": "論卷下"}
{"id": null, "n": "0159003", "target": "#nkr_note_orig_0159003", "type": "orig", "text": "□疑初"}
{"id": null, "n": "0159004", "target": "#nkr_note_orig_0159004", "type": "orig", "text": "說字原本字體未詳"}
{"id": null, "n": "0159005", "target": "#nkr_note_orig_0159005", "type": "orig", "text": "成字疑剩"}
{"id": null, "n": "0159006", "target": "#nkr_note_orig_0159006 #note_star_1 #note_star_2 #note_star_3 #note_star_4 #note_star_5 #note_star_7 #note_star_8", "type": "orig", "text": "脩疑循下同"}
{"id": null, "n": "0159007", "target": "#nkr_note_orig_0159007 #note_star_6 #note_star_c #note_star_1a #note_star_1b #note_star_1c #note_star_1d", "type": "orig", "text": "耶邪通用下同"}
{"id": null, "n": "0160001", "target": "#nkr_note_orig_0160001", "type": "orig", "text": "心下疑脫住字"}
{"id": null, "n": "0160002", "target": "#nkr_note_orig_0160002", "type": "orig", "text": "樂疑閑"}
{"id": null, "n": "0161001", "target": "#nkr_note_orig_0161001", "type": "orig", "text": "第疑等"}
{"id": null, "n": "0161002", "target": "#nkr_note_orig_0161002", "type": "orig", "text": "人疑入"}
{"id": null, "n": "0161003", "target": "#nkr_note_orig_0161003", "type": "orig", "text": "東字疑衍"}
{"id": null, "n": "0162001", "target": "#nkr_note_orig_0162001", "type": "orig", "text": "相字疑剩"}
{"id": null, "n": "0162002", "target": "#nkr_note_orig_0162002", "type": "orig", "text": "真疑其"}
{"id": null, "n": "0163001", "target": "#nkr_note_orig_0163001 #note_star_9 #note_star_d", "type": "orig", "text": "或通惑下同"}
{"id": null, "n": "0163002", "target": "#nkr_note_orig_0163002 #note_star_a", "type": "orig", "text": "劣疑聚次同"}
{"id": null, "n": "0164001", "target": "#nkr_note_orig_0164001", "type": "orig", "text": "者疑於"}
{"id": null, "n": "0164002", "target": "#nkr_note_orig_0164002", "type": "orig", "text": "□□疑斷若"}
{"id": null, "n": "0164003", "target": "#nkr_note_orig_0164003 #note_star_b", "type": "orig", "text": "知疑如下同"}
{"id": null, "n": "0164004", "target": "#nkr_note_orig_0164004", "type": "orig", "text": "海疑誨或顯"}
{"id": null, "n": "0165001", "target": "#nkr_note_orig_0165001", "type": "orig", "text": "□疑亦"}
{"id": null, "n": "0165002", "target": "#nkr_note_orig_0165002", "type": "orig", "text": "勝疑牒"}
{"id": null, "n": "0166001", "target": "#nkr_note_orig_0166001", "type": "orig", "text": "根疑粮"}
{"id": null, "n": "0166002", "target": "#nkr_note_orig_0166002", "type": "orig", "text": "無疑為"}
{"id": null, "n": "0166003", "target": "#nkr_note_orig_0166003", "type": "orig", "text": "明上疑脫以字"}
{"id": null, "n": "0167001", "target": "#nkr_note_orig_0167001", "type": "orig", "text": "□□疑怯畏"}
{"id": null, "n": "0167002", "target": "#nkr_note_orig_0167002", "type": "orig", "text": "中字疑剩"}
{"id": null, "n": "0167003", "target": "#nkr_note_orig_0167003 #note_star_e", "type": "orig", "text": "亭疑停下同"}
{"id": null, "n": "0167004", "target": "#nkr_note_orig_0167004", "type": "orig", "text": "來一作成"}
{"id": null, "n": "0167005", "target": "#nkr_note_orig_0167005", "type": "orig", "text": "是疑足"}
{"id": null, "n": "0168001", "target": "#nkr_note_orig_0168001", "type": "orig", "text": "聖疑望"}
{"id": null, "n": "0168002", "target": "#nkr_note_orig_0168002", "type": "orig", "text": "是字疑剩"}
{"id": null, "n": "0168003", "target": "#nkr_note_orig_0168003", "type": "orig", "text": "若疑差"}
{"id": null, "n": "0168004", "target": "#nkr_note_orig_0168004 #note_star_f #note_star_10 #note_star_11 #note_star_12 #note_star_13 #note_star_14 #note_star_15 #note_star_16 #note_star_17 #note_star_18 #note_star_19 #note_star_1e #note_star_1f #note_star_20 #note_star_21 #note_star_22 #note_star_23 #note_star_24 #note_star_25 #note_star_26 #note_star_27 #note_star_28 #note_star_29", "type": "orig", "text": "或通惑下同"}
{"id": null, "n": "0169001", "target": "#nkr_note_orig_0169001", "type": "orig", "text": "菩疑若"}
{"id": null, "n": "0169002", "target": "#nkr_note_orig_0169002", "type": "orig", "text": "知疑殷"}
{"id": null, "n": "0169003", "target": "#nkr_note_orig_0169003", "type": "orig", "text": "汎疑沈"}
{"id": null, "n": "0170001", "target": "#nkr_note_orig_0170001", "type": "orig", "text": "後下疑脫之字"}
{"id": null, "n": "0170002", "target": "#nkr_note_orig_0170002", "type": "orig", "text": "乃字疑剩"}
{"id": null, "n": "0170003", "target": "#nkr_note_orig_0170003", "type": "orig", "text": "有字疑衍"}
{"id": null, "n": "0171001", "target": "#nkr_note_orig_0171001", "type": "orig", "text": "封疑對"}
{"id": null, "n": "0172001", "target": "#nkr_note_orig_0172001", "type": "orig", "text": "一字疑剩或有脫文歟"}
{"id": null, "n": "0172002", "target": "#nkr_note_orig_0172002", "type": "orig", "text": "富疑當"}
{"id": null, "n": "0172003", "target": "#nkr_note_orig_0172003 #note_star_2a #note_star_2b #note_star_2c #note_star_2d #note_star_2e #note_star_2f", "type": "orig", "text": "集疑釋下同"}
{"id": null, "n": "0172004", "target": "#nkr_note_orig_0172004", "type": "orig", "text": "滅疑減"}
