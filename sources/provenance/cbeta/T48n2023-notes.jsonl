{"id": null, "n": null, "target": null, "type": null, "text": "并\n序"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "六"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "即隋煬帝"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "二"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "并序"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "師古曰。狐棭下之皮。輕柔難得。萬雋作掖"}
{"id": null, "n": null, "target": null, "type": null, "text": "道法師箋本於直指人心下削本今依舊本補入"}
{"id": null, "n": null, "target": null, "type": null, "text": "則見祖懷究竟指歸唯在了義"}
{"id": null, "n": null, "target": null, "type": null, "text": "性空通大小也"}
{"id": null, "n": null, "target": null, "type": null, "text": "涅槃云依法者即是法性不依人者即是聲聞緣覺"}
{"id": null, "n": null, "target": null, "type": null, "text": "化猶變也"}
{"id": null, "n": null, "target": null, "type": null, "text": "莊子云目擊而道存"}
{"id": null, "n": null, "target": null, "type": null, "text": "上明義假語顯見義捨語也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上謂得義忘言仍須遣義無有也"}
{"id": null, "n": null, "target": null, "type": null, "text": "上明六識妄念人畜共依\n故有淪墜已下令依佛智即唯識觀今損過漸明也"}
{"id": null, "n": null, "target": null, "type": null, "text": "五百之言乃出智論與律不同故問決之"}
{"id": null, "n": null, "target": null, "type": null, "text": "約即略也"}
{"id": null, "n": null, "target": null, "type": null, "text": "律中佛姨母大愛道尼同五百女人心佛出家"}
{"id": null, "n": null, "target": null, "type": null, "text": "謂從大僧一眾邊受"}
{"id": null, "n": null, "target": null, "type": null, "text": "此翻功德鎧"}
{"id": null, "n": null, "target": null, "type": null, "text": "秦言堅誓"}
{"id": null, "n": null, "target": null, "type": null, "text": "坐具也"}
{"id": null, "n": null, "target": null, "type": null, "text": "三衣也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此一制也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此二制也"}
{"id": null, "n": null, "target": null, "type": null, "text": "此三制也"}
{"id": null, "n": null, "target": null, "type": null, "text": "達即至也"}
{"id": null, "n": null, "target": null, "type": null, "text": "今須準此乍可挑著左肩若垂臂肘定判非法步步結罪\n舊云今在左臂為正但不得垂尖角者非也"}
{"id": null, "n": null, "target": null, "type": null, "text": "吒革"}
{"id": null, "n": null, "target": null, "type": null, "text": "悲敬二田"}
{"id": null, "n": null, "target": null, "type": null, "text": "犯盜"}
{"id": null, "n": null, "target": null, "type": null, "text": "慳食獨啖餓鬼之業是謂大迷"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼云捨身非沙門所為等"}
{"id": null, "n": null, "target": null, "type": null, "text": "彼云經中所明事存通俗"}
{"id": null, "n": null, "target": null, "type": null, "text": "知事差僧及法食會集等"}
{"id": null, "n": null, "target": null, "type": null, "text": "天屬即父母也"}
{"id": null, "n": null, "target": null, "type": null, "text": "即七略經史等"}
{"id": null, "n": null, "target": null, "type": null, "text": "梵語一修多羅二祇夜三和伽那四伽陀五優陀那六尼陀那七阿波陀那八伊帝目多伽九\n闍陀伽十毘佛略十一阿浮達摩十二優波提舍唐言一契經二重頌三授記四孤起五無問六因緣七譬喻八本事九\n本生十方廣十一未曾有十二論議"}
{"id": null, "n": null, "target": null, "type": null, "text": "聞思修也"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "出輔行記"}
{"id": null, "n": null, "target": null, "type": null, "text": "壽無量本大同小異"}
{"id": null, "n": null, "target": null, "type": null, "text": "語錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "語錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "鼻獄"}
{"id": null, "n": null, "target": null, "type": null, "text": "樂國"}
{"id": null, "n": null, "target": null, "type": null, "text": "因果"}
{"id": null, "n": null, "target": null, "type": null, "text": "壞身"}
{"id": null, "n": null, "target": null, "type": null, "text": "明藏"}
{"id": null, "n": null, "target": null, "type": null, "text": "菩薩"}
{"id": null, "n": null, "target": null, "type": null, "text": "阮戶部外集"}
{"id": null, "n": null, "target": null, "type": null, "text": "出長慶集"}
{"id": null, "n": null, "target": null, "type": null, "text": "湖隱石刻"}
{"id": null, "n": null, "target": null, "type": null, "text": "傳燈"}
{"id": null, "n": null, "target": null, "type": null, "text": "語錄"}
{"id": null, "n": null, "target": null, "type": null, "text": "準薩婆多中三衣長五肘廣三肘每肘一尺八寸準姬周尺長九尺廣五尺四寸"}
{"id": null, "n": null, "target": null, "type": null, "text": "嘗參月林鐵鞭諸大老"}
{"id": null, "n": null, "target": null, "type": null, "text": "靈岩石刻"}
{"id": null, "n": null, "target": null, "type": null, "text": "法雲圓通禪師常戒學徒\n不得洗麪"}
{"id": null, "n": null, "target": null, "type": null, "text": "雲居舜和尚制常住及諸\n莊並不令洗麪"}
{"id": null, "n": null, "target": null, "type": null, "text": "禪月集"}
{"id": null, "n": null, "target": null, "type": null, "text": "時住夾山"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
{"id": null, "n": null, "target": null, "type": null, "text": "即隋煬帝"}
{"id": null, "n": null, "target": null, "type": null, "text": "王嚫戒師衣物五十八事親書\n龍魚飛白諸篆四十餘字"}
{"id": null, "n": null, "target": null, "type": null, "text": "高僧傳"}
{"id": null, "n": null, "target": null, "type": null, "text": "嘗住吳之北禪號東屏"}
{"id": null, "n": null, "target": null, "type": null, "text": "終"}
