{"id": null, "n": "0356001", "target": "#nkr_note_orig_0356001", "type": "orig", "text": "「地藏菩薩」，乙、丙、丁本作「地藏菩薩經」。因而《敦煌寶藏》將斯5892號誤定名為《地藏菩薩經》。"}
{"id": null, "n": "0356002", "target": "#nkr_note_orig_0356002", "type": "orig", "text": "「日」，丁本無。"}
{"id": null, "n": "0356003", "target": "#nkr_note_orig_0356003", "type": "orig", "text": "「童」，丙本作「章」。"}
{"id": null, "n": "0356004", "target": "#nkr_note_orig_0356004", "type": "orig", "text": "「佛」，底、甲、乙、丁本無，據丙本補。"}
{"id": null, "n": "0356005", "target": "#nkr_note_orig_0356005", "type": "orig", "text": "「墮」，底、甲、乙本作「塗」，據丙、丁本改。"}
{"id": null, "n": "0356006", "target": "#nkr_note_orig_0356006", "type": "orig", "text": "「持齋」，丁本無。"}
{"id": null, "n": "0356007", "target": "#nkr_note_orig_0356007", "type": "orig", "text": "「除」，丙本作「持」。"}
{"id": null, "n": "0356008", "target": "#nkr_note_orig_0356008", "type": "orig", "text": "「十」,乙本作「千」。"}
{"id": null, "n": "0356009", "target": "#nkr_note_orig_0356009", "type": "orig", "text": "「師」，丁本無。"}
{"id": null, "n": "0356010", "target": "#nkr_note_orig_0356010", "type": "orig", "text": "「墮」，底、甲、乙本作「塗」，據丙、丁本改。"}
{"id": null, "n": "0356011", "target": "#nkr_note_orig_0356011", "type": "orig", "text": "「持齋」，丁本無。"}
{"id": null, "n": "0356012", "target": "#nkr_note_orig_0356012", "type": "orig", "text": "「三十」，乙本無，丙本作「三萬」。"}
{"id": null, "n": "0356013", "target": "#nkr_note_orig_0356013", "type": "orig", "text": "「下」，丙本作「不」。"}
{"id": null, "n": "0356014", "target": "#nkr_note_orig_0356014", "type": "orig", "text": "「千」，乙本無。"}
{"id": null, "n": "0356015", "target": "#nkr_note_orig_0356015", "type": "orig", "text": "「墮」，底、甲、乙本作「塗」，據丙、丁本改。"}
{"id": null, "n": "0356016", "target": "#nkr_note_orig_0356016", "type": "orig", "text": "「持齋除」，丁本為「滅」。"}
{"id": null, "n": "0357001", "target": "#nkr_note_orig_0357001", "type": "orig", "text": "「道」，甲本作「道神」。"}
{"id": null, "n": "0357002", "target": "#nkr_note_orig_0357002", "type": "orig", "text": "「下」，丙本作「不」。"}
{"id": null, "n": "0357003", "target": "#nkr_note_orig_0357003", "type": "orig", "text": "「持齋除」，丁本為「滅」。"}
{"id": null, "n": "0357004", "target": "#nkr_note_orig_0357004", "type": "orig", "text": "「音」，乙本無。"}
{"id": null, "n": "0357005", "target": "#nkr_note_orig_0357005", "type": "orig", "text": "「持齋除」，甲本無，丁本作「滅」。"}
{"id": null, "n": "0357006", "target": "#nkr_note_orig_0357006", "type": "orig", "text": "「劫」，乙本至此止。"}
{"id": null, "n": "0357007", "target": "#nkr_note_orig_0357007", "type": "orig", "text": "「天」，底、甲、乙、丁本無，據丙本補。"}
{"id": null, "n": "0357008", "target": "#nkr_note_orig_0357008", "type": "orig", "text": "「墮」，甲本無。"}
{"id": null, "n": "0357009", "target": "#nkr_note_orig_0357009", "type": "orig", "text": "「持齋除」，丁本作「滅」。"}
{"id": null, "n": "0357010", "target": "#nkr_note_orig_0357010", "type": "orig", "text": "「府君」，丙本作「王將軍」，丁本作「府軍」。"}
{"id": null, "n": "0357011", "target": "#nkr_note_orig_0357011", "type": "orig", "text": "「地藏」，甲本作「地獄」。《大正藏》第85卷將底本的「地藏」錄為「地獄」。"}
{"id": null, "n": "0357012", "target": "#nkr_note_orig_0357012", "type": "orig", "text": "「斫」，丙本作「錐」。"}
{"id": null, "n": "0357013", "target": "#nkr_note_orig_0357013", "type": "orig", "text": "「持齋除」，丁本作「滅」。"}
{"id": null, "n": "0357014", "target": "#nkr_note_orig_0357014", "type": "orig", "text": "「帝」，丙本作「天帝」。"}
{"id": null, "n": "0357015", "target": "#nkr_note_orig_0357015", "type": "orig", "text": "「鋸」，甲本無。"}
{"id": null, "n": "0357016", "target": "#nkr_note_orig_0357016", "type": "orig", "text": "「持齋除」，丁本作「滅」，丙本作「持齋墮」。"}
{"id": null, "n": "0358001", "target": "#nkr_note_orig_0358001", "type": "orig", "text": "「藥王藥上」,底、甲、乙、丁本作「藥師上」，據丙本改。"}
{"id": null, "n": "0358002", "target": "#nkr_note_orig_0358002", "type": "orig", "text": "「磨」，底本作「摩」字，據諸校本改。"}
{"id": null, "n": "0358003", "target": "#nkr_note_orig_0358003", "type": "orig", "text": "「除」，丁本作「滅」。"}
{"id": null, "n": "0358004", "target": "#nkr_note_orig_0358004", "type": "orig", "text": "「梵」，丙、丁本作「大梵」。"}
{"id": null, "n": "0358005", "target": "#nkr_note_orig_0358005", "type": "orig", "text": "「除」，丁本作「滅」。"}
