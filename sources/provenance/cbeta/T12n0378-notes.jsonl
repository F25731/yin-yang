{"id": null, "n": "0912006", "target": "#nkr_note_mod_0912006", "type": "mod", "text": "月氏【大】＊，〔－〕【宋】【明】＊【宮】，泰始年【元】＊"}
{"id": null, "n": "0912007", "target": "#nkr_note_mod_0912007", "type": "mod", "text": "三藏【大】＊，三藏法師【宋】＊【元】＊【明】＊【宮】"}
{"id": null, "n": "0912008", "target": "#nkr_note_mod_0912008", "type": "mod", "text": "譯【大】＊，初譯【元】＊"}
{"id": null, "n": "0912009", "target": "#nkr_note_mod_0912009", "type": "mod", "text": "世【CB】【宋】【元】【明】【宮】，山【大】"}
{"id": null, "n": "0912010", "target": "#nkr_note_mod_0912010", "type": "mod", "text": "蔭【大】，陰【宋】【元】【明】【宮】"}
{"id": null, "n": "0912011", "target": "#nkr_note_mod_0912011", "type": "mod", "text": "猶【大】，又【宋】【元】【明】【宮】"}
{"id": null, "n": "0912012", "target": "#nkr_note_mod_0912012", "type": "mod", "text": "曰【大】，洹【元】【明】"}
{"id": null, "n": "0912013", "target": "#nkr_note_mod_0912013", "type": "mod", "text": "鎧【大】，燈【宋】【元】【明】【宮】"}
{"id": null, "n": "0912014", "target": "#nkr_note_mod_0912014", "type": "mod", "text": "洹【大】，曰【宋】【元】【明】【宮】"}
{"id": null, "n": "0912015", "target": "#nkr_note_mod_0912015", "type": "mod", "text": "奇【大】，琦【宋】【元】【明】【宮】"}
{"id": null, "n": "0912016", "target": "#nkr_note_mod_0912016", "type": "mod", "text": "者阿那【大】，老阿難【宮】"}
{"id": null, "n": "0912017", "target": "#nkr_note_mod_0912017", "type": "mod", "text": "令【大】，今【宋】【宮】"}
{"id": null, "n": "0912018", "target": "#nkr_note_mod_0912018", "type": "mod", "text": "尊者【大】，尊老【宮】"}
{"id": null, "n": "0913001", "target": "#nkr_note_mod_0913001", "type": "mod", "text": "任【大】＊，住【宋】＊"}
{"id": null, "n": "0913002", "target": "#nkr_note_mod_0913002", "type": "mod", "text": "老【大】，者【宋】【元】【明】"}
{"id": null, "n": "0913003", "target": "#nkr_note_mod_0913003", "type": "mod", "text": "懅【大】，懼【宋】【元】【明】【宮】"}
{"id": null, "n": "0913004", "target": "#nkr_note_mod_0913004", "type": "mod", "text": "偈【大】，偈言【宋】【元】【明】【宮】"}
{"id": null, "n": "0913005", "target": "#nkr_note_mod_0913005", "type": "mod", "text": "其處空虛【大】，其虛空處【宋】【元】【明】【宮】"}
{"id": null, "n": "0913006", "target": "#nkr_note_mod_0913006", "type": "mod", "text": "如【大】，好【宋】【元】【明】【宮】"}
{"id": null, "n": "0913007", "target": "#nkr_note_mod_0913007", "type": "mod", "text": "逸【大】，泆【宋】【宮】"}
{"id": null, "n": "0913008", "target": "#nkr_note_mod_0913008", "type": "mod", "text": "通【大】，勇【宋】【元】【明】【宮】"}
{"id": null, "n": "0913009", "target": "#nkr_note_mod_0913009", "type": "mod", "text": "芬【大】，芥【宋】【宮】"}
{"id": null, "n": "0913010", "target": "#nkr_note_mod_0913010", "type": "mod", "text": "薰【大】，熏【宋】【元】【明】【宮】"}
{"id": null, "n": "0913011", "target": "#nkr_note_mod_0913011", "type": "mod", "text": "剎【大】，裂【元】【明】"}
{"id": null, "n": "0913012", "target": "#nkr_note_mod_0913012", "type": "mod", "text": "邪【大】，那【宋】【元】【明】【宮】"}
{"id": null, "n": "0913013", "target": "#nkr_note_mod_0913013", "type": "mod", "text": "揵【大】，犍【明】"}
{"id": null, "n": "0913014", "target": "#nkr_note_mod_0913014", "type": "mod", "text": "和【大】，惒【宋】【元】【明】【宮】"}
{"id": null, "n": "0913015", "target": "#nkr_note_mod_0913015", "type": "mod", "text": "頰【大】，貌【宋】【元】【明】【宮】"}
{"id": null, "n": "0913016", "target": "#nkr_note_mod_0913016", "type": "mod", "text": "肥【大】，肌【宋】【元】【明】【宮】"}
{"id": null, "n": "0913017", "target": "#nkr_note_mod_0913017", "type": "mod", "text": "困【大】，面【宋】【元】【明】【宮】"}
{"id": null, "n": "0913018", "target": "#nkr_note_mod_0913018", "type": "mod", "text": "蹟【大】，跡【宋】【元】【明】，跤【宮】"}
{"id": null, "n": "0913019", "target": "#nkr_note_mod_0913019", "type": "mod", "text": "擗【大】，躄【宋】【元】【明】【宮】"}
{"id": null, "n": "0913020", "target": "#nkr_note_mod_0913020", "type": "mod", "text": "䠒【大】，互【元】【明】"}
{"id": null, "n": "0914001", "target": "#nkr_note_mod_0914001", "type": "mod", "text": "蒸【大】，承【宋】【元】【明】【宮】"}
{"id": null, "n": "0914002", "target": "#nkr_note_mod_0914002", "type": "mod", "text": "無不【大】，元元【宮】"}
{"id": null, "n": "0914003", "target": "#nkr_note_mod_0914003", "type": "mod", "text": "為【大】，與【明】"}
{"id": null, "n": "0914004", "target": "#nkr_note_mod_0914004", "type": "mod", "text": "當【大】，等【宋】【元】【明】【宮】"}
{"id": null, "n": "0914005", "target": "#nkr_note_mod_0914005", "type": "mod", "text": "雙【大】，嚴【宋】【元】【明】【宮】"}
{"id": null, "n": "0914006", "target": "#nkr_note_mod_0914006", "type": "mod", "text": "今【大】，令【明】"}
{"id": null, "n": "0914007", "target": "#nkr_note_mod_0914007", "type": "mod", "text": "憎【大】，增【宋】【元】【明】【宮】"}
{"id": null, "n": "0914008", "target": "#nkr_note_mod_0914008", "type": "mod", "text": "四【大】＊，佛說方等般泥洹經四【宋】【元】【宮】＊"}
{"id": null, "n": "0914009", "target": "#nkr_note_mod_0914009", "type": "mod", "text": "童【大】＊，童子【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0914010", "target": "#nkr_note_mod_0914010", "type": "mod", "text": "嚮【大】＊，響【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0914011", "target": "#nkr_note_mod_0914011", "type": "mod", "text": "佛【大】，諸佛【宋】【元】【明】【宮】"}
{"id": null, "n": "0914012", "target": "#nkr_note_mod_0914012", "type": "mod", "text": "加【大】，跏【宋】【元】【明】【宮】"}
{"id": null, "n": "0914013", "target": "#nkr_note_mod_0914013", "type": "mod", "text": "當【大】，尚【宋】【元】【明】【宮】"}
{"id": null, "n": "0914014", "target": "#nkr_note_mod_0914014", "type": "mod", "text": "無【大】，莫【宋】【元】【明】【宮】"}
{"id": null, "n": "0915001", "target": "#nkr_note_mod_0915001", "type": "mod", "text": "受彼【大】，彼受【宋】【元】【明】【宮】"}
{"id": null, "n": "0915002", "target": "#nkr_note_mod_0915002", "type": "mod", "text": "雖【大】，難【宋】【元】【明】【宮】"}
{"id": null, "n": "0915003", "target": "#nkr_note_mod_0915003", "type": "mod", "text": "種【大】，積【宋】【宮】"}
{"id": null, "n": "0915004", "target": "#nkr_note_mod_0915004", "type": "mod", "text": "唯【大】＊，惟【宋】＊【元】＊【明】＊【宮】"}
{"id": null, "n": "0916001", "target": "#nkr_note_mod_0916001", "type": "mod", "text": "悉【大】，志【宋】【元】【明】【宮】"}
{"id": null, "n": "0916002", "target": "#nkr_note_mod_0916002", "type": "mod", "text": "神【大】，鬼神【宋】【元】【明】【宮】"}
{"id": null, "n": "0916003", "target": "#nkr_note_mod_0916003", "type": "mod", "text": "詣【大】，詣於【宋】【元】【明】【宮】"}
{"id": null, "n": "0916004", "target": "#nkr_note_mod_0916004", "type": "mod", "text": "智【大】，知【宋】【元】【明】【宮】"}
{"id": null, "n": "0916005", "target": "#nkr_note_mod_0916005", "type": "mod", "text": "道【大】，導【宋】【元】【明】【宮】"}
{"id": null, "n": "0916006", "target": "#nkr_note_mod_0916006", "type": "mod", "text": "學【大】，覺【明】"}
{"id": null, "n": "0916007", "target": "#nkr_note_mod_0916007", "type": "mod", "text": "已【大】＊，以【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0916008", "target": "#nkr_note_mod_0916008", "type": "mod", "text": "殖【大】＊，植【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0916009", "target": "#nkr_note_mod_0916009", "type": "mod", "text": "尊【大】，遵【宋】【元】【明】【宮】"}
{"id": null, "n": "0916010", "target": "#nkr_note_mod_0916010", "type": "mod", "text": "主【大】，王【宋】【元】【明】"}
{"id": null, "n": "0917001", "target": "#nkr_note_mod_0917001", "type": "mod", "text": "善【大】，着【宮】"}
{"id": null, "n": "0917002", "target": "#nkr_note_mod_0917002", "type": "mod", "text": "象【大】，像【宋】【元】【明】【宮】"}
{"id": null, "n": "0917003", "target": "#nkr_note_mod_0917003", "type": "mod", "text": "絃【大】，弦【宋】【元】【明】【宮】"}
{"id": null, "n": "0917004", "target": "#nkr_note_mod_0917004", "type": "mod", "text": "想【大】，根【宋】【元】【明】【宮】"}
{"id": null, "n": "0917005", "target": "#nkr_note_mod_0917005", "type": "mod", "text": "誡【大】，戒【宋】【元】【明】【宮】"}
{"id": null, "n": "0917006", "target": "#nkr_note_mod_0917006", "type": "mod", "text": "利【大】，剎【明】"}
{"id": null, "n": "0917007", "target": "#nkr_note_mod_0917007", "type": "mod", "text": "洹【大】＊，曰【宋】【元】【明】【宮】＊"}
{"id": null, "n": "0917008", "target": "#nkr_note_mod_0917008", "type": "mod", "text": "定【大】，審【宮】"}
{"id": null, "n": "0918001", "target": "#nkr_note_mod_0918001", "type": "mod", "text": "與【大】，典【宋】【元】【明】【宮】"}
{"id": null, "n": "0918002", "target": "#nkr_note_mod_0918002", "type": "mod", "text": "諍【大】，爭【宋】【元】【明】【宮】"}
{"id": null, "n": "0918003", "target": "#nkr_note_mod_0918003", "type": "mod", "text": "我【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0918004", "target": "#nkr_note_mod_0918004", "type": "mod", "text": "相【大】，想【宋】【元】【明】【宮】"}
{"id": null, "n": "0918005", "target": "#nkr_note_mod_0918005", "type": "mod", "text": "真【大】，甄【宋】【元】【宮】"}
{"id": null, "n": "0918006", "target": "#nkr_note_mod_0918006", "type": "mod", "text": "審【大】，當【宋】【元】【明】【宮】"}
{"id": null, "n": "0918007", "target": "#nkr_note_mod_0918007", "type": "mod", "text": "揣【大】，摶【宋】【元】【明】【宮】"}
{"id": null, "n": "0918008", "target": "#nkr_note_mod_0918008", "type": "mod", "text": "及【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0918009", "target": "#nkr_note_mod_0918009", "type": "mod", "text": "秖【大】，祇【宋】【元】【明】【宮】"}
{"id": null, "n": "0918010", "target": "#nkr_note_mod_0918010", "type": "mod", "text": "曰【大】，洹【宋】【元】【明】【宮】"}
{"id": null, "n": "0918011", "target": "#nkr_note_mod_0918011", "type": "mod", "text": "罷【大】，疲【宋】【元】【明】【宮】"}
{"id": null, "n": "0918012", "target": "#nkr_note_mod_0918012", "type": "mod", "text": "淨信【大】，信淨【宋】【元】【明】【宮】"}
{"id": null, "n": "0919001", "target": "#nkr_note_mod_0919001", "type": "mod", "text": "預【大】，豫【宋】【元】【明】【宮】"}
{"id": null, "n": "0919002", "target": "#nkr_note_mod_0919002", "type": "mod", "text": "種【大】，積【宋】【元】【明】【宮】"}
{"id": null, "n": "0919003", "target": "#nkr_note_mod_0919003", "type": "mod", "text": "也【大】，〔－〕【宋】【元】【明】【宮】"}
{"id": null, "n": "0919004", "target": "#nkr_note_mod_0919004", "type": "mod", "text": "叵俄【大】，駊騀【宋】【元】【明】【宮】"}
{"id": null, "n": "0919005", "target": "#nkr_note_mod_0919005", "type": "mod", "text": "往【大】，住【元】【明】"}
{"id": null, "n": "0919006", "target": "#nkr_note_mod_0919006", "type": "mod", "text": "安【大】，安隱【宋】【元】【明】【宮】"}
{"id": null, "n": "0919007", "target": "#nkr_note_mod_0919007", "type": "mod", "text": "得【大】，德【宋】【元】【明】【宮】"}
{"id": null, "n": "0919008", "target": "#nkr_note_mod_0919008", "type": "mod", "text": "說【大】，乘【宋】【元】【明】【宮】"}
{"id": null, "n": "0919009", "target": "#nkr_note_mod_0919009", "type": "mod", "text": "塵勞【大】，勞塵【宋】【元】【明】【宮】"}
{"id": null, "n": "0919010", "target": "#nkr_note_mod_0919010", "type": "mod", "text": "娛【大】，好【宋】【元】【明】【宮】"}
{"id": null, "n": "0919011", "target": "#nkr_note_mod_0919011", "type": "mod", "text": "碯【大】，腦【宋】【元】【明】【宮】"}
{"id": null, "n": "0919012", "target": "#nkr_note_mod_0919012", "type": "mod", "text": "青【大】，染【宋】【元】【明】【宮】"}
