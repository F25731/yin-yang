{"id": null, "n": null, "target": null, "type": "cf1", "text": "K11n0286_p0639a03"}
{"id": null, "n": "0075010", "target": "#nkr_note_mod_0075010", "type": "mod", "text": "八吉祥【大】＊，佛說八吉祥【元】【明】＊"}
{"id": null, "n": "0075011", "target": "#nkr_note_mod_0075011", "type": "mod", "text": "是【大】，日【宋】【元】【明】【宮】"}
{"id": null, "n": "0075012", "target": "#nkr_note_mod_0075012", "type": "mod", "text": "樂聞【大】，聞說【宋】【元】【明】【宮】"}
{"id": null, "n": "0075013", "target": "#nkr_note_mod_0075013", "type": "mod", "text": "者【大】，相【宮】"}
{"id": null, "n": "0075014", "target": "#nkr_note_mod_0075014", "type": "mod", "text": "惟【大】，唯【宋】【元】【明】【宮】"}
{"id": null, "n": "0075010", "target": "#nkr_note_orig_0075010", "type": "orig", "text": "（佛說）＋八吉祥【元】【明】＊"}
{"id": null, "n": "0075011", "target": "#nkr_note_orig_0075011", "type": "orig", "text": "是＝日【三】【宮】"}
{"id": null, "n": "0075012", "target": "#nkr_note_orig_0075012", "type": "orig", "text": "樂聞＝聞說【三】【宮】"}
{"id": null, "n": "0075013", "target": "#nkr_note_orig_0075013", "type": "orig", "text": "者＝相【宮】"}
{"id": null, "n": "0075014", "target": "#nkr_note_orig_0075014", "type": "orig", "text": "惟＝唯【三】【宮】"}
{"id": null, "n": "0075a2501", "target": "#nkr_note_add_0075a2501", "type": "add", "text": "祇【CB】【麗-CB】，祗【大】"}
