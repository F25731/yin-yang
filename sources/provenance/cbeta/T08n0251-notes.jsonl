{"id": null, "n": "0848002", "target": "#nkr_note_mod_0848002", "type": "mod", "text": "唐【大】，〔－〕【宋】"}
{"id": null, "n": "0848003", "target": "#nkr_note_mod_0848003", "type": "mod", "text": "奘【大】，奘奉詔【宋】【元】【明】"}
{"id": null, "n": "0848005", "target": "#nkr_note_mod_0848005", "type": "mod", "text": "帝【大】＊，諦【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0848006", "target": "#nkr_note_mod_0848006", "type": "mod", "text": "般【大】＊，波【宋】＊【元】＊【明】＊"}
{"id": null, "n": "0848007", "target": "#nkr_note_mod_0848007", "type": "mod", "text": "莎婆【CB】【房山-CB】，僧莎【大】，薩婆【宋】【元】【明】"}
{"id": null, "n": "0848001", "target": "#nkr_note_orig_0848001", "type": "orig", "text": "Prajñāpāramitā hṛdaya（A.小）."}
{"id": null, "n": "0848002", "target": "#nkr_note_orig_0848002", "type": "orig", "text": "〔唐〕－【宋】"}
{"id": null, "n": "0848003", "target": "#nkr_note_orig_0848003", "type": "orig", "text": "奘＋（奉詔）【三】"}
{"id": null, "n": "0848004", "target": "#nkr_note_orig_0848004", "type": "orig", "text": "呪文 Gate gate pāragate pārasaṃgate bodhi Svāhā."}
